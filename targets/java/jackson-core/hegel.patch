+        }
+    }
+
+    /** The escaping table: the default one, or the three write features drawn. */
+    record Table(boolean slash, boolean nonAscii, boolean upperHex) {}
+
+    static final Generator<Table> TABLE = weighted(v(40, new Table(false, false, true)),
+            w(60, tuples(chance(30), chance(30), chance(70)).map(t -> new Table(t.value1(), t.value2(), t.value3()))));
+
+    static final Generator<Cfg> CFG = tuples(chance(50), TABLE, chance(30), chance(30), chance(80))
+            .map(t -> new Cfg(t.value1(), t.value2().slash(), t.value2().nonAscii(), t.value2().upperHex(), t.value3(), t.value4(), t.value5()));
+
+    /** The Number class a lexeme is written through; a class that does not hold the value exactly falls back to the next. */
+    enum NumForm { RAW, INT, LONG, BIG_INTEGER, DOUBLE, BIG_DECIMAL }
+
+    static final Generator<NumForm> NUM_FORM = weighted(v(15, NumForm.RAW), v(15, NumForm.INT), v(15, NumForm.LONG), v(15, NumForm.BIG_INTEGER),
+            v(25, NumForm.DOUBLE), v(15, NumForm.BIG_DECIMAL));
+
+    static final Generator<List<NumForm>> NUM_FORMS = many(NUM_FORM, 0, 8);
+
+    /** A Number for the lexeme of the asked class when it holds the value exactly, and the lexeme it will be written as. */
+    static Ev numberEvent(Ref.Num num, NumForm form, Cfg c) {
+        String lex = num.text();
+        BigDecimal exact = num.value();
+        if (exact == null) {
+            return new Ev("number", lex, lex); // writeNumber(String): raw
+        }
+        boolean integral = exact.signum() == 0 || exact.stripTrailingZeros().scale() <= 0;
+        BigInteger bi = integral ? exact.toBigIntegerExact() : null;
+        double d = Double.parseDouble(lex);
+        boolean exactDouble = Double.isFinite(d) && new BigDecimal(d).compareTo(exact) == 0;
+        switch (form) {
+            case INT:
+                if (integral && bi.bitLength() < 32) {
+                    return new Ev("number", bi.intValue(), bi.toString());
+                }
+                // fall through
+            case LONG:
+                if (integral && bi.bitLength() < 64) {
+                    return new Ev("number", bi.longValue(), bi.toString());
+                }
+                // fall through
+            case BIG_INTEGER:
+                if (integral) {
+                    return new Ev("number", bi, bi.toString());
+                }
+                // fall through
+            case DOUBLE:
+                if (exactDouble) {
+                    return new Ev("number", d, Double.toString(d));
+                }
+                // fall through
+            case BIG_DECIMAL:
+                BigDecimal bd = new BigDecimal(lex);
+                return new Ev("number", bd, c.plainBig() ? bd.toPlainString() : bd.toString());
+            default:
+                return new Ev("number", lex, lex);
+        }
+    }
+
+    /** The events of a value; the k-th number is written through the k-th form of the tape. */
+    static List<Ev> events(Object v, List<NumForm> forms, Cfg c) {
+        List<Ev> out = new ArrayList<>();
+        events(v, forms, c, out, new int[1]);
+        return out;
+    }
+
+    private static void events(Object v, List<NumForm> forms, Cfg c, List<Ev> out, int[] k) {
+        if (v == Ref.NULL) {
+            out.add(new Ev("null", null, null));
+        } else if (v instanceof Boolean b) {
+            out.add(new Ev("bool", b, null));
+        } else if (v instanceof String s) {
+            out.add(new Ev("string", s, null));
+        } else if (v instanceof Ref.Num num) {
+            out.add(numberEvent(num, tape(forms, k[0]++, NumForm.RAW), c));
+        } else if (v instanceof List<?> l) {
+            out.add(new Ev("[", null, null));
+            for (Object x : l) {
+                events(x, forms, c, out, k);
+            }
+            out.add(new Ev("]", null, null));
+        } else {
+            out.add(new Ev("{", null, null));
+            for (Map.Entry<?, ?> en : ((Map<?, ?>) v).entrySet()) {
+                out.add(new Ev("name", en.getKey(), null));
+                events(en.getValue(), forms, c, out, k);
+            }
+            out.add(new Ev("}", null, null));
+        }
+    }
+
+    /** Compact text of an event list, per the documented escaping. */
+    static String compact(List<Ev> evs, Ref.Escaping esc) {
+        StringBuilder sb = new StringBuilder();
+        List<Boolean> firstInScope = new ArrayList<>();
+        boolean afterName = false;
+        for (Ev e : evs) {
+            boolean value = !e.kind().equals("]") && !e.kind().equals("}");
+            if (value && !afterName && !firstInScope.isEmpty()) {
+                if (!firstInScope.get(firstInScope.size() - 1)) {
+                    sb.append(',');
+                }
+                firstInScope.set(firstInScope.size() - 1, false);
+            }
+            afterName = false;
+            switch (e.kind()) {
+                case "null" -> sb.append("null");
+                case "bool" -> sb.append(e.arg());
+                case "string" -> Ref.quote((String) e.arg(), esc, sb);
+                case "number" -> sb.append(e.lexeme());
+                case "[" -> {
+                    sb.append('[');
+                    firstInScope.add(true);
+                }
+                case "{" -> {
+                    sb.append('{');
+                    firstInScope.add(true);
+                }
+                case "]" -> {
+                    sb.append(']');
+                    firstInScope.remove(firstInScope.size() - 1);
+                }
+                case "}" -> {
+                    sb.append('}');
+                    firstInScope.remove(firstInScope.size() - 1);
+                }
+                case "name" -> {
+                    Ref.quote((String) e.arg(), esc, sb);
+                    sb.append(':');
+                    afterName = true;
+                }
+                default -> throw new IllegalStateException(e.kind());
+            }
+        }
+        return sb.toString();
+    }
+
+    /** The value the events denote, with numbers as their written lexemes. */
+    static Object denoted(List<Ev> evs) {
+        return Ref.parse(compact(evs, Ref.PLAIN));
+    }
+
+    /** The generator method a string goes through. */
+    enum StrWay { STRING, CHARS, READER, READER_SIZED, SERIALIZED }
+
+    /** How one event is written: the string method, a pre-encoded name, the sized start-container method, a lexeme as char[]. */
+    record Way(StrWay str, boolean serializedName, boolean sizedStart, boolean numChars) {}
+
+    static final Way PLAIN_WAY = new Way(StrWay.STRING, false, false, false);
+
+    static final Generator<StrWay> STR_WAY = weighted(v(50, StrWay.STRING), v(20, StrWay.CHARS), v(8, StrWay.READER), v(7, StrWay.READER_SIZED),
+            v(15, StrWay.SERIALIZED));
+
+    static final Generator<Way> WAY = tuples(STR_WAY, chance(30), chance(50), chance(50))
+            .map(t -> new Way(t.value1(), t.value2(), t.value3(), t.value4()));
+
+    static final Generator<List<Way>> WAYS = many(WAY, 0, 12);
+
+    /** Writes a string by the way's generator method (the pre-encoded ones only with the default table). */
+    static void writeString(JsonGenerator g, String s, Cfg c, Way way) {
+        StrWay how = way.str();
+        if (how == StrWay.SERIALIZED && !c.plainTable()) {
+            how = StrWay.STRING; // a pre-encoded string carries the default table's escapes (documented)
+        }
+        if (Zoo.NO_KNOWN && how == StrWay.SERIALIZED && c.utf8() && hasLoneSurrogate(s)) {
+            Zoo.count("not drawn: writeString(SerializedString) with a lone surrogate (jackson-core/8)");
+            how = StrWay.STRING;
+        }
+        if (Zoo.NO_KNOWN && (how == StrWay.READER || how == StrWay.READER_SIZED) && c.utf8() && pairAtReadBoundary(s)) {
+            Zoo.count("not drawn: writeString(Reader) with a surrogate pair across a 4000-char read (jackson-core/7)");
+            how = StrWay.STRING;
+        }
+        switch (how) {
+            case CHARS -> {
+                char[] cs = ("xx" + s + "y").toCharArray();
+                g.writeString(cs, 2, s.length());
+            }
+            case READER -> g.writeString(new StringReader(s), -1);
+            case READER_SIZED -> g.writeString(new StringReader(s), s.length());
+            case SERIALIZED -> g.writeString(new SerializedString(s));
+            default -> g.writeString(s);
+        }
+    }
+
+    static void writeName(JsonGenerator g, String s, Cfg c, Way way) {
+        boolean serialized = way.serializedName() && c.plainTable();
+        if (Zoo.NO_KNOWN && serialized && c.utf8() && hasLoneSurrogate(s)) {
+            Zoo.count("not drawn: writeName(SerializedString) with a lone surrogate (jackson-core/8)");
+            serialized = false;
+        }
+        if (serialized) {
+            g.writeName(new SerializedString(s));
+        } else {
+            g.writeName(s);
+        }
+    }
+
+    static void write(JsonGenerator g, Ev e, Cfg c, Way way) {
+        switch (e.kind()) {
+            case "null" -> g.writeNull();
+            case "bool" -> g.writeBoolean((boolean) e.arg());
+            case "string" -> writeString(g, (String) e.arg(), c, way);
+            case "number" -> {
+                Object a = e.arg();
+                if (a instanceof Integer i) {
+                    g.writeNumber(i.intValue());
+                } else if (a instanceof Long l) {
+                    g.writeNumber(l.longValue());
+                } else if (a instanceof BigInteger bi) {
+                    g.writeNumber(bi);
+                } else if (a instanceof Double d) {
+                    g.writeNumber(d.doubleValue());
+                } else if (a instanceof BigDecimal bd) {
+                    g.writeNumber(bd);
+                } else if (way.numChars()) {
+                    char[] cs = ((String) a).toCharArray();
+                    g.writeNumber(cs, 0, cs.length);
+                } else {
+                    g.writeNumber((String) a);
+                }
+            }
+            case "[" -> {
+                if (way.sizedStart()) {
+                    g.writeStartArray(null, 0);
+                } else {
+                    g.writeStartArray();
+                }
+            }
+            case "]" -> g.writeEndArray();
+            case "{" -> {
+                if (way.sizedStart()) {
+                    g.writeStartObject(null);
+                } else {
+                    g.writeStartObject();
+                }
+            }
+            case "}" -> g.writeEndObject();
+            case "name" -> writeName(g, (String) e.arg(), c, way);
+            default -> throw new IllegalStateException(e.kind());
+        }
+    }
+
+    /** Generate the events into text with the configuration, the k-th event by the k-th way; null if the generator threw (reported). */
+    static String generate(List<Ev> evs, List<Way> ways, boolean flush, Cfg c, PrettyPrinter pp) {
+        JsonFactory f = c.factory();
+        ObjectWriteContext ctx = pp == null ? ObjectWriteContext.empty() : new ObjectWriteContext.Base() {
+            @Override
+            public PrettyPrinter getPrettyPrinter() {
+                return pp;
+            }
+        };
+        try {
+            if (c.utf8()) {
+                ByteArrayOutputStream out = new ByteArrayOutputStream();
+                try (JsonGenerator g = f.createGenerator(ctx, out)) {
+                    for (int i = 0; i < evs.size(); i++) {
+                        write(g, evs.get(i), c, tape(ways, i, PLAIN_WAY));
+                    }
+                    if (flush) {
+                        g.flush();
+                    }
+                }
+                return out.toString(StandardCharsets.UTF_8);
+            }
+            StringWriter sw = new StringWriter();
+            try (JsonGenerator g = f.createGenerator(ctx, sw)) {
+                for (int i = 0; i < evs.size(); i++) {
+                    write(g, evs.get(i), c, tape(ways, i, PLAIN_WAY));
+                }
+            }
+            return sw.toString();
+        } catch (JacksonException | IllegalArgumentException e) {
+            fail("generator (" + c + ") threw " + e + " for " + evs);
+            return null;
+        }
+    }
+
+    /** The documented pathAsPointer() model: array frames with a started element, object frames with a name. */
+    static final class PathModel {
+        private final List<Object> frames = new ArrayList<>(); // Integer (index of the current element, -1 none) or String[] {name}
+
+        void start(boolean array) {
+            value();
+            frames.add(array ? (Object) Integer.valueOf(-1) : new String[] {null});
+        }
+
+        void name(String n) {
+            ((String[]) frames.get(frames.size() - 1))[0] = n;
+        }
+
+        /** A value (scalar or the start of a container) begins in the current frame. */
+        void value() {
+            if (!frames.isEmpty() && frames.get(frames.size() - 1) instanceof Integer i) {
+                frames.set(frames.size() - 1, i + 1);
+            }
+        }
+
+        void end() {
+            frames.remove(frames.size() - 1);
+        }
+
+        String pointer() {
+            StringBuilder sb = new StringBuilder();
+            for (Object f : frames) {
+                if (f instanceof Integer i) {
+                    if (i < 0) {
+                        break;
+                    }
+                    sb.append('/').append(i);
+                } else {
+                    String name = ((String[]) f)[0];
+                    if (name == null) {
+                        break;
+                    }
+                    sb.append('/').append(name.replace("~", "~0").replace("/", "~1"));
+                }
+            }
+            return sb.toString();
+        }
+    }
+
+    static NumberType numberType(String lex) {
+        if (lex.indexOf('.') >= 0 || lex.indexOf('e') >= 0 || lex.indexOf('E') >= 0) {
+            return NumberType.DOUBLE;
+        }
+        BigInteger v = new BigInteger(lex);
+        if (v.bitLength() < 32) {
+            return NumberType.INT;
+        }
+        return v.bitLength() < 64 ? NumberType.LONG : NumberType.BIG_INTEGER;
+    }
+
+    /** Read the events back from the text with the parser kind, checking every token, value, path and number type. */
+    static void readBack(JsonFactory f, Src src, Feed feed, String text, List<Ev> want, String what) {
+        PathModel pm = new PathModel();
+        int idx = 0;
+        try (Tokens t = new Tokens(f, src, text, feed)) {
+            JsonParser p = t.p;
+            while (true) {
+                JsonToken tok = t.next();
+                if (tok == null) {
+                    break;
+                }
+                if (idx >= want.size()) {
+                    fail(what + " " + src + ": more tokens than events, " + tok + " at " + idx + " in " + show(text));
+                    return;
+                }
+                Ev e = want.get(idx++);
+                final int i = idx - 1;
+                switch (tok) {
+                    case START_ARRAY -> {
+                        check(e.kind().equals("["), () -> what + " " + src + " event " + i + ": START_ARRAY, expected " + e);
+                        pm.start(true);
+                    }
+                    case END_ARRAY -> {
+                        check(e.kind().equals("]"), () -> what + " " + src + " event " + i + ": END_ARRAY, expected " + e);
+                        pm.end();
+                    }
+                    case START_OBJECT -> {
+                        check(e.kind().equals("{"), () -> what + " " + src + " event " + i + ": START_OBJECT, expected " + e);
+                        pm.start(false);
+                    }
+                    case END_OBJECT -> {
+                        check(e.kind().equals("}"), () -> what + " " + src + " event " + i + ": END_OBJECT, expected " + e);
+                        pm.end();
+                    }
+                    case PROPERTY_NAME -> {
+                        String name = p.currentName();
+                        check(e.kind().equals("name") && name.equals(e.arg()), () -> what + " " + src + " event " + i + ": name " + show(name) + ", expected " + e);
+                        check(name.equals(p.getString()), () -> what + " " + src + ": getString() for a name is " + show(p.getString()) + " not " + show(name));
+                        pm.name(name);
+                    }
+                    case VALUE_STRING -> {
+                        String s = p.getString();
+                        check(e.kind().equals("string") && s.equals(e.arg()), () -> what + " " + src + " event " + i + ": string " + show(s) + ", expected " + e);
+                        pm.value();
+                    }
+                    case VALUE_NUMBER_INT, VALUE_NUMBER_FLOAT -> {
+                        String s = p.getString();
+                        boolean minusZero = Zoo.NO_KNOWN && src == Src.ASYNC && "-0".equals(e.lexeme());
+                        if (minusZero) {
+                            Zoo.count("not checked: the lexeme of -0 in the non-blocking parser (jackson-core/4)");
+                        }
+                        check(e.kind().equals("number") && (s.equals(e.lexeme()) || minusZero), () -> what + " " + src + " event " + i + ": number lexeme " + s + ", expected " + e);
+                        if (e.kind().equals("number")) {
+                            NumberType nt = numberType(e.lexeme());
+                            check((tok == JsonToken.VALUE_NUMBER_FLOAT) == (nt == NumberType.DOUBLE), () -> what + " " + src + ": token " + tok + " for " + s);
+                            check(p.getNumberType() == nt, () -> what + " " + src + ": getNumberType " + p.getNumberType() + " for " + s + ", expected " + nt);
+                        }
+                        pm.value();
+                    }
+                    case VALUE_TRUE, VALUE_FALSE -> {
+                        check(e.kind().equals("bool") && e.arg().equals(tok == JsonToken.VALUE_TRUE), () -> what + " " + src + " event " + i + ": " + tok + ", expected " + e);
+                        pm.value();
+                    }
+                    case VALUE_NULL -> {
+                        check(e.kind().equals("null"), () -> what + " " + src + " event " + i + ": null, expected " + e);
+                        pm.value();
+                    }
+                    default -> fail(what + " " + src + ": unexpected token " + tok);
+                }
+                String ptr = p.streamReadContext().pathAsPointer().toString();
+                check(ptr.equals(pm.pointer()), () -> what + " " + src + " after event " + i + " " + e + ": pathAsPointer " + ptr + " expected " + pm.pointer() + " in " + show(text));
+            }
+            final int consumed = idx;
+            check(consumed == want.size(), () -> what + " " + src + ": parser stopped after " + consumed + " of " + want.size() + " events for " + show(text));
+            check(p.streamReadContext().inRoot(), () -> what + " " + src + ": not in root at the end: " + p.streamReadContext());
+        } catch (JacksonException | IllegalStateException e) {
+            fail(what + " " + src + ": parser threw " + e + " at event " + idx + " reading " + show(text));
+        }
+    }
+
+    /** Generates the events with the configuration and checks the text against the escaping model; null when the generator threw. */
+    static String checkGenerated(List<Ev> evs, List<Way> ways, boolean flush, Cfg c) {
+        String text = generate(evs, ways, flush, c, null);
+        if (text == null) {
+            return null;
+        }
+        String expected = compact(evs, c.escaping());
+        check(text.equals(expected), () -> "generator (" + c + ") wrote " + show(text) + " expected " + show(expected) + " (" + firstDifference(text, expected) + ")");
+        return text;
+    }
+
+    /** A written case: the configuration and source first, since bytes cannot carry the lone surrogates the Writer-based generator passes through. */
+    record Written(Cfg cfg, Src src, Object value, List<NumForm> forms, List<Way> ways, boolean flush, boolean fastParser, Feed feed) {
+        JsonFactory parserFactory() {
+            return JsonFactory.builder().configure(StreamReadFeature.USE_FAST_DOUBLE_PARSER, fastParser).build();
+        }
+    }
+
+    static final Generator<Written> WRITTEN = tuples(CFG, SRC).flatMap(cs -> {
+        Cfg c = cs.value1();
+        Src src = cs.value2();
+        boolean lone = !src.bytes() || c.escapesLoneSurrogates();
+        return tuples(Ref.value(4, lone), NUM_FORMS, WAYS, chance(30), chance(50), FEED)
+                .map(t -> new Written(c, src, t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6()));
+    });
