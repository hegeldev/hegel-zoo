+
+    // ------------------------------------------------------------------ 1. generator -> text -> every parser
+
+    /** One generator event; the parsers must see it back. {@code lexeme} is what the number is written as. */
+    record Ev(String kind, Object arg, String lexeme) {}
+
+    /** The generator configuration of a case. */
+    record Cfg(boolean utf8, boolean slash, boolean nonAscii, boolean upperHex, boolean plainBig, boolean fastDouble, boolean nanStrings) {
+        Ref.Escaping escaping() {
+            return new Ref.Escaping(slash, nonAscii, upperHex, utf8);
+        }
+
+        boolean plainTable() {
+            return !slash && !nonAscii && upperHex;
+        }
+
+        /** Whether the generator writes a lone surrogate as an escape (so that bytes can carry the text). */
+        boolean escapesLoneSurrogates() {
