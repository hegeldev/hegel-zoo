+    /** A text to read: a value, its spelling, the edits that corrupt it (none for half the cases), the source and its feeding. */
+    record Reading(Src src, Object value, Ref.Spelling spelling, List<Ref.Edit> edits, Feed feed) {
+        String doc() {
+            return Ref.mutate(spelling.text(value), edits);
+        }
+    }
+
+    static final Generator<List<Ref.Edit>> EDITS = maybe(50, List.<Ref.Edit>of(), many(Ref.EDIT, 1, 2));
+
+    static final Generator<Reading> READING = SRC.flatMap(src -> tuples(Ref.value(4, !src.bytes()), Ref.SPELLING, EDITS, FEED)
+            .map(t -> new Reading(src, t.value1(), t.value2(), t.value3(), t.value4())));
