+    // ------------------------------------------------------------------ 2. strict parsers vs the reference
+
+    @Test
+    void parsersAgreeWithTheReference() {
+        Hegel.test(tc -> {
+            Object v = Ref.gen(tc, 4);
+            String text = Ref.text(tc, v);
+            boolean mutated = chance(tc, 50);
+            if (mutated) {
+                text = Ref.mutate(tc, text);
+            }
+            final String doc = text;
+            List<Object> want;
+            String why = null;
+            try {
+                want = Ref.parseRoots(doc);
+            } catch (Ref.Bad e) {
+                want = null;
+                why = e.getMessage();
+            }
+            final String reason = why;
+            final List<Object> expected = want;
+            Src src = src(tc);
+            if (src.bytes() && (hasLoneSurrogate(doc) || doc.startsWith("\ufeff"))) {
+                return; // bytes cannot carry a lone surrogate; a leading BOM is skipped by the byte parsers (documented)
+            }
+            if (src == Src.ASYNC && !doc.isEmpty() && !Character.isWhitespace(doc.charAt(doc.length() - 1)) && chance(tc, 50)) {
+                return; // keep some cases: a root number at the very end is completed only by endOfInput
+            }
+            if (src == Src.DATA_INPUT && endsInBareScalar(doc)) {
+                return; // jackson-core/1
+            }
+            if (src.bytes() && hasSurrogateEscape(doc)) {
+                return; // jackson-core/3 (a lone surrogate spelled as an escape in a name) and /11
+            }
+            JsonFactory f = new JsonFactory();
+            List<Object> got = new ArrayList<>();
+            String error = null;
+            try (Tokens t = new Tokens(tc, f, src, doc, chunk(tc))) {
+                while (true) {
+                    JsonToken tok = t.next();
+                    if (tok == null) {
+                        break;
+                    }
+                    got.add(value(t, tok));
+                }
+            } catch (JacksonException | IllegalStateException | StackOverflowError e) {
+                error = e.toString();
+            }
+            final String err = error;
+            if (expected != null) {
+                check(err == null, () -> src + " rejects valid " + show(doc) + ": " + err);
+                if (err == null) {
+                    check(Ref.same(got, expected, true), () -> src + " reads " + show(doc) + " as " + Ref.show(got) + " expected " + Ref.show(expected));
+                }
+            } else {
+                check(err != null, () -> src + " accepts invalid " + show(doc) + " (" + reason + ") as " + Ref.show(got));
+            }
+        }, Zoo.settings("parsersAgreeWithTheReference"));
+    }
