+package zoo;
+
+import static zoo.Zoo.chance;
+import static zoo.Zoo.check;
+import static zoo.Zoo.fail;
+import static zoo.Zoo.n;
+import static zoo.Zoo.pick;
+import static zoo.Zoo.show;
+
+import dev.hegel.Hegel;
+import dev.hegel.TestCase;
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.DataInputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.Reader;
+import java.io.StringReader;
+import java.io.StringWriter;
+import java.math.BigDecimal;
+import java.math.BigInteger;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.Map;
+import org.junit.jupiter.api.Assertions;
+import org.junit.jupiter.api.Test;
+import tools.jackson.core.Base64Variant;
+import tools.jackson.core.Base64Variants;
+import tools.jackson.core.JacksonException;
+import tools.jackson.core.JsonGenerator;
+import tools.jackson.core.JsonParser;
+import tools.jackson.core.JsonParser.NumberType;
+import tools.jackson.core.JsonPointer;
+import tools.jackson.core.JsonToken;
+import tools.jackson.core.ObjectReadContext;
+import tools.jackson.core.ObjectWriteContext;
+import tools.jackson.core.PrettyPrinter;
+import tools.jackson.core.StreamReadFeature;
+import tools.jackson.core.StreamWriteFeature;
+import tools.jackson.core.async.ByteArrayFeeder;
+import tools.jackson.core.exc.InputCoercionException;
+import tools.jackson.core.exc.StreamConstraintsException;
+import tools.jackson.core.io.SerializedString;
+import tools.jackson.core.json.JsonFactory;
+import tools.jackson.core.json.JsonFactoryBuilder;
+import tools.jackson.core.json.JsonReadFeature;
+import tools.jackson.core.json.JsonWriteFeature;
+import tools.jackson.core.util.DefaultIndenter;
+import tools.jackson.core.util.DefaultPrettyPrinter;
+import tools.jackson.core.util.Separators;
+
+/**
+ * Hegel zoo: jackson-core's streaming JSON generator and parsers against a reference reader/writer
+ * ({@link Ref}) and the models its Javadoc documents (escaping table, number coercions,
+ * root-value separation, JsonPointer, DefaultPrettyPrinter layout, Base64 variants).
+ */
+class JacksonCoreTest {
+
+    // ------------------------------------------------------------------ parsers of every kind
+
+    /** The input paths a text can take into a parser. */
+    enum Src {
+        STRING, CHARS, READER, READER_THROTTLED, BYTES, STREAM, STREAM_THROTTLED, DATA_INPUT, ASYNC;
+
+        boolean bytes() {
+            return this != STRING && this != CHARS && this != READER && this != READER_THROTTLED;
+        }
+    }
+
+    static final Src[] SRCS = Src.values();
+
+    /** A Reader handing out at most {@code max} chars per read. */
+    static final class ThrottledReader extends Reader {
+        private final Reader in;
+        private final int max;
+
+        ThrottledReader(Reader in, int max) {
+            this.in = in;
+            this.max = max;
+        }
+
+        @Override
+        public int read(char[] cbuf, int off, int len) throws IOException {
+            return in.read(cbuf, off, Math.min(len, max));
+        }
+
+        @Override
+        public void close() throws IOException {
+            in.close();
+        }
+    }
+
+    /** An InputStream handing out at most {@code max} bytes per read. */
+    static final class ThrottledStream extends InputStream {
+        private final InputStream in;
+        private final int max;
+
+        ThrottledStream(InputStream in, int max) {
+            this.in = in;
+            this.max = max;
+        }
+
+        @Override
+        public int read() throws IOException {
+            return in.read();
+        }
+
+        @Override
+        public int read(byte[] b, int off, int len) throws IOException {
+            return in.read(b, off, Math.min(len, max));
+        }
+    }
+
+    /** A parser over a text, feeding the non-blocking one in random chunks so NOT_AVAILABLE is hidden. */
+    static final class Tokens implements AutoCloseable {
+        final JsonParser p;
+        final Src src;
+        private final byte[] async;
+        private int fed;
+        private final int chunk;
+        private final TestCase tc;
+        private boolean ended;
+
+        Tokens(TestCase tc, JsonFactory f, Src src, String text, int chunk) {
+            this.src = src;
+            this.tc = tc;
+            this.chunk = chunk;
+            ObjectReadContext ctx = ObjectReadContext.empty();
+            byte[] bytes = src.bytes() ? text.getBytes(StandardCharsets.UTF_8) : null;
+            switch (src) {
+                case STRING -> {
+                    p = f.createParser(ctx, text);
+                    async = null;
+                }
+                case CHARS -> {
+                    p = f.createParser(ctx, text.toCharArray());
+                    async = null;
+                }
+                case READER -> {
+                    p = f.createParser(ctx, new StringReader(text));
+                    async = null;
+                }
+                case READER_THROTTLED -> {
+                    p = f.createParser(ctx, new ThrottledReader(new StringReader(text), chunk));
+                    async = null;
+                }
+                case BYTES -> {
+                    p = f.createParser(ctx, bytes);
+                    async = null;
+                }
+                case STREAM -> {
+                    p = f.createParser(ctx, new ByteArrayInputStream(bytes));
+                    async = null;
+                }
+                case STREAM_THROTTLED -> {
+                    p = f.createParser(ctx, new ThrottledStream(new ByteArrayInputStream(bytes), chunk));
+                    async = null;
+                }
+                case DATA_INPUT -> {
+                    p = f.createParser(ctx, (java.io.DataInput) new DataInputStream(new ByteArrayInputStream(bytes)));
+                    async = null;
+                }
+                case ASYNC -> {
+                    p = f.createNonBlockingByteArrayParser(ctx);
+                    async = bytes;
+                }
+                default -> throw new IllegalStateException();
+            }
+        }
+
+        JsonToken next() {
+            while (true) {
+                JsonToken t = p.nextToken();
+                if (t != JsonToken.NOT_AVAILABLE) {
+                    return t;
+                }
+                ByteArrayFeeder feeder = (ByteArrayFeeder) p;
+                if (fed >= async.length) {
+                    if (ended) {
+                        throw new IllegalStateException("async parser keeps asking for input after the end");
+                    }
+                    feeder.endOfInput();
+                    ended = true;
+                } else {
+                    int end = Math.min(async.length, fed + n(tc, 1, chunk));
+                    feeder.feedInput(async, fed, end);
+                    fed = end;
+                }
+            }
+        }
+
+        @Override
+        public void close() {
+            p.close();
+        }
+    }
+
+    static Src src(TestCase tc) {
+        return pick(tc, SRCS);
+    }
+
+    static int chunk(TestCase tc) {
+        return pick(tc, 1, 2, 3, 5, 7, 16, 64, 1000, 4096);
+    }
+
+    /** True when the text ends with a digit or letter (a root number or literal with nothing after it) or is empty. */
+    static boolean endsInBareScalar(String text) {
+        return text.isEmpty() || Character.isLetterOrDigit(text.charAt(text.length() - 1));
+    }
+
+    /** True when the text spells a surrogate as a backslash-u escape. */
+    static boolean hasSurrogateEscape(String text) {
+        return text.toLowerCase().matches("(?s).*\\\\ud[89a-f].*");
+    }
+
+    static boolean nameHasLoneSurrogate(List<Ev> evs) {
+        for (Ev e : evs) {
+            if (e.kind().equals("name") && hasLoneSurrogate((String) e.arg())) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    static boolean hasSurrogate(String s) {
+        for (int i = 0; i < s.length(); i++) {
+            if (Character.isSurrogate(s.charAt(i))) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    static boolean hasLoneSurrogate(String s) {
+        for (int i = 0; i < s.length(); i++) {
+            char c = s.charAt(i);
+            if (Character.isHighSurrogate(c)) {
+                if (i + 1 < s.length() && Character.isLowSurrogate(s.charAt(i + 1))) {
+                    i++;
+                } else {
+                    return true;
+                }
+            } else if (Character.isLowSurrogate(c)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    /** Read one value from the token stream (the current token is its first). */
+    static Object value(Tokens t, JsonToken tok) {
+        JsonParser p = t.p;
+        switch (tok) {
+            case START_ARRAY -> {
+                List<Object> out = new ArrayList<>();
+                while (true) {
+                    JsonToken x = t.next();
+                    if (x == JsonToken.END_ARRAY) {
+                        return out;
+                    }
+                    out.add(value(t, x));
+                }
+            }
+            case START_OBJECT -> {
+                Map<String, Object> out = new java.util.LinkedHashMap<>();
+                while (true) {
+                    JsonToken x = t.next();
+                    if (x == JsonToken.END_OBJECT) {
+                        return out;
+                    }
+                    if (x != JsonToken.PROPERTY_NAME) {
+                        throw new IllegalStateException("expected a name, got " + x);
+                    }
+                    String name = p.currentName();
+                    if (!name.equals(p.getString())) {
+                        throw new IllegalStateException("currentName " + show(name) + " != getString " + show(p.getString()));
+                    }
+                    out.put(name, value(t, t.next()));
+                }
+            }
+            case VALUE_STRING -> {
+                return p.getString();
+            }
+            case VALUE_NUMBER_INT, VALUE_NUMBER_FLOAT -> {
+                return Ref.Num.of(p.getString());
+            }
+            case VALUE_TRUE -> {
+                return Boolean.TRUE;
+            }
+            case VALUE_FALSE -> {
+                return Boolean.FALSE;
+            }
+            case VALUE_NULL -> {
+                return Ref.NULL;
+            }
+            default -> throw new IllegalStateException("unexpected token " + tok);
+        }
+    }
+
+    // ------------------------------------------------------------------ 1. generator -> text -> every parser
+
+    /** One generator event; the parsers must see it back. {@code lexeme} is what the number is written as. */
+    record Ev(String kind, Object arg, String lexeme) {}
+
+    /** The generator configuration of a case. */
+    record Cfg(boolean utf8, boolean slash, boolean nonAscii, boolean upperHex, boolean plainBig, boolean fastDouble, boolean nanStrings) {
+        Ref.Escaping escaping() {
+            return new Ref.Escaping(slash, nonAscii, upperHex, utf8);
+        }
+
+        boolean plainTable() {
+            return !slash && !nonAscii && upperHex;
+        }
+
+        JsonFactory factory() {
+            JsonFactoryBuilder b = JsonFactory.builder();
+            b.configure(JsonWriteFeature.ESCAPE_FORWARD_SLASHES, slash);
+            b.configure(JsonWriteFeature.ESCAPE_NON_ASCII, nonAscii);
+            b.configure(JsonWriteFeature.WRITE_HEX_UPPER_CASE, upperHex);
+            b.configure(JsonWriteFeature.WRITE_NAN_AS_STRINGS, nanStrings);
+            b.configure(StreamWriteFeature.WRITE_BIGDECIMAL_AS_PLAIN, plainBig);
+            b.configure(StreamWriteFeature.USE_FAST_DOUBLE_WRITER, fastDouble);
+            return b.build();
+        }
+    }
+
+    static Cfg cfg(TestCase tc) {
+        boolean plain = chance(tc, 40);
+        return new Cfg(chance(tc, 50), !plain && chance(tc, 30), !plain && chance(tc, 30), plain || chance(tc, 70),
+                chance(tc, 30), chance(tc, 30), chance(tc, 80));
+    }
+
+    /** A Number for the lexeme, of a random class that holds it exactly, and the lexeme it will be written as. */
+    static Ev numberEvent(TestCase tc, Ref.Num num, Cfg c) {
+        String lex = num.text();
+        BigDecimal exact = num.value();
+        if (exact == null) {
+            return new Ev("number", lex, lex); // writeNumber(String): raw
+        }
+        boolean integral = exact.signum() == 0 || exact.stripTrailingZeros().scale() <= 0;
+        int r = n(tc, 0, 99);
+        if (integral && r < 45) {
+            BigInteger bi = exact.toBigIntegerExact();
+            if (bi.bitLength() < 32 && chance(tc, 50)) {
+                return new Ev("number", bi.intValue(), bi.toString());
+            }
+            if (bi.bitLength() < 64 && chance(tc, 50)) {
+                return new Ev("number", bi.longValue(), bi.toString());
+            }
+            return new Ev("number", bi, bi.toString());
+        }
+        if (r < 70) {
+            double d = Double.parseDouble(lex);
+            if (Double.isFinite(d) && new BigDecimal(d).compareTo(exact) == 0) {
+                return new Ev("number", d, Double.toString(d));
+            }
+        }
+        if (r < 85) {
+            return new Ev("number", lex, lex);
+        }
+        BigDecimal bd = new BigDecimal(lex);
+        return new Ev("number", bd, c.plainBig() ? bd.toPlainString() : bd.toString());
+    }
+
+    static List<Ev> events(TestCase tc, Object v, Cfg c, List<Ev> out) {
+        if (v == Ref.NULL) {
+            out.add(new Ev("null", null, null));
+        } else if (v instanceof Boolean b) {
+            out.add(new Ev("bool", b, null));
+        } else if (v instanceof String s) {
+            out.add(new Ev("string", s, null));
+        } else if (v instanceof Ref.Num num) {
+            out.add(numberEvent(tc, num, c));
+        } else if (v instanceof List<?> l) {
+            out.add(new Ev("[", null, null));
+            for (Object x : l) {
+                events(tc, x, c, out);
+            }
+            out.add(new Ev("]", null, null));
+        } else {
+            out.add(new Ev("{", null, null));
+            for (Map.Entry<?, ?> en : ((Map<?, ?>) v).entrySet()) {
+                out.add(new Ev("name", en.getKey(), null));
+                events(tc, en.getValue(), c, out);
+            }
+            out.add(new Ev("}", null, null));
+        }
+        return out;
+    }
+
+    /** Compact text of an event list, per the documented escaping. */
+    static String compact(List<Ev> evs, Ref.Escaping esc) {
+        StringBuilder sb = new StringBuilder();
+        List<Boolean> firstInScope = new ArrayList<>();
+        boolean afterName = false;
+        for (Ev e : evs) {
+            boolean value = !e.kind().equals("]") && !e.kind().equals("}");
+            if (value && !afterName && !firstInScope.isEmpty()) {
+                if (!firstInScope.get(firstInScope.size() - 1)) {
+                    sb.append(',');
+                }
+                firstInScope.set(firstInScope.size() - 1, false);
+            }
+            afterName = false;
+            switch (e.kind()) {
+                case "null" -> sb.append("null");
+                case "bool" -> sb.append(e.arg());
+                case "string" -> Ref.quote((String) e.arg(), esc, sb);
+                case "number" -> sb.append(e.lexeme());
+                case "[" -> {
+                    sb.append('[');
+                    firstInScope.add(true);
+                }
+                case "{" -> {
+                    sb.append('{');
+                    firstInScope.add(true);
+                }
+                case "]" -> {
+                    sb.append(']');
+                    firstInScope.remove(firstInScope.size() - 1);
+                }
+                case "}" -> {
+                    sb.append('}');
+                    firstInScope.remove(firstInScope.size() - 1);
+                }
+                case "name" -> {
+                    Ref.quote((String) e.arg(), esc, sb);
+                    sb.append(':');
+                    afterName = true;
+                }
+                default -> throw new IllegalStateException(e.kind());
+            }
+        }
+        return sb.toString();
+    }
+
+    /** The value the events denote, with numbers as their written lexemes. */
+    static Object denoted(List<Ev> evs) {
+        return Ref.parse(compact(evs, Ref.PLAIN));
+    }
+
+    /** Writes a string by one of the generator's string methods (the pre-encoded ones only with the default table). */
+    static void writeString(TestCase tc, JsonGenerator g, String s, Cfg c) {
+        int r = n(tc, 0, 99);
+        if (r < 50) {
+            g.writeString(s);
+        } else if (r < 70) {
+            char[] cs = ("xx" + s + "y").toCharArray();
+            g.writeString(cs, 2, s.length());
+        } else if (r < 85 && !hasLoneSurrogate(s) && !(s.length() >= 4000 && hasSurrogate(s))) {
+            g.writeString(new StringReader(s), chance(tc, 50) ? -1 : s.length()); // jackson-core/7 excluded
+        } else if (c.plainTable() && !hasLoneSurrogate(s)) {
+            g.writeString(new SerializedString(s)); // a lone surrogate: jackson-core/8
+        } else {
+            g.writeString(s);
+        }
+    }
+
+    static void writeName(TestCase tc, JsonGenerator g, String s, Cfg c) {
+        if (c.plainTable() && !hasLoneSurrogate(s) && chance(tc, 30)) {
+            g.writeName(new SerializedString(s));
+        } else {
+            g.writeName(s);
+        }
+    }
+
+    static void write(TestCase tc, JsonGenerator g, Ev e, Cfg c) {
+        switch (e.kind()) {
+            case "null" -> g.writeNull();
+            case "bool" -> g.writeBoolean((boolean) e.arg());
+            case "string" -> writeString(tc, g, (String) e.arg(), c);
+            case "number" -> {
+                Object a = e.arg();
+                if (a instanceof Integer i) {
+                    g.writeNumber(i.intValue());
+                } else if (a instanceof Long l) {
+                    g.writeNumber(l.longValue());
+                } else if (a instanceof BigInteger bi) {
+                    g.writeNumber(bi);
+                } else if (a instanceof Double d) {
+                    g.writeNumber(d.doubleValue());
+                } else if (a instanceof BigDecimal bd) {
+                    g.writeNumber(bd);
+                } else if (chance(tc, 50)) {
+                    g.writeNumber((String) a);
+                } else {
+                    char[] cs = ((String) a).toCharArray();
+                    g.writeNumber(cs, 0, cs.length);
+                }
+            }
+            case "[" -> {
+                if (chance(tc, 50)) {
+                    g.writeStartArray();
+                } else {
+                    g.writeStartArray(null, 0);
+                }
+            }
+            case "]" -> g.writeEndArray();
+            case "{" -> {
+                if (chance(tc, 50)) {
+                    g.writeStartObject();
+                } else {
+                    g.writeStartObject(null);
+                }
+            }
+            case "}" -> g.writeEndObject();
+            case "name" -> writeName(tc, g, (String) e.arg(), c);
+            default -> throw new IllegalStateException(e.kind());
+        }
+    }
+
+    /** Generate the events into text with the configuration; null if the generator threw (reported). */
+    static String generate(TestCase tc, List<Ev> evs, Cfg c, PrettyPrinter pp) {
+        JsonFactory f = c.factory();
+        ObjectWriteContext ctx = pp == null ? ObjectWriteContext.empty() : new ObjectWriteContext.Base() {
+            @Override
+            public PrettyPrinter getPrettyPrinter() {
+                return pp;
+            }
+        };
+        try {
+            if (c.utf8()) {
+                ByteArrayOutputStream out = new ByteArrayOutputStream();
+                try (JsonGenerator g = f.createGenerator(ctx, out)) {
+                    for (Ev e : evs) {
+                        write(tc, g, e, c);
+                    }
+                    if (chance(tc, 30)) {
+                        g.flush();
+                    }
+                }
+                return out.toString(StandardCharsets.UTF_8);
+            }
+            StringWriter sw = new StringWriter();
+            try (JsonGenerator g = f.createGenerator(ctx, sw)) {
+                for (Ev e : evs) {
+                    write(tc, g, e, c);
+                }
+            }
+            return sw.toString();
+        } catch (JacksonException e) {
+            fail("generator (" + c + ") threw " + e + " for " + evs);
+            return null;
+        }
+    }
+
+    /** The documented pathAsPointer() model: array frames with a started element, object frames with a name. */
+    static final class PathModel {
+        private final List<Object> frames = new ArrayList<>(); // Integer (index of the current element, -1 none) or String[] {name}
+
+        void start(boolean array) {
+            value();
+            frames.add(array ? (Object) Integer.valueOf(-1) : new String[] {null});
+        }
+
+        void name(String n) {
+            ((String[]) frames.get(frames.size() - 1))[0] = n;
+        }
+
+        /** A value (scalar or the start of a container) begins in the current frame. */
+        void value() {
+            if (!frames.isEmpty() && frames.get(frames.size() - 1) instanceof Integer i) {
+                frames.set(frames.size() - 1, i + 1);
+            }
+        }
+
+        void end() {
+            frames.remove(frames.size() - 1);
+        }
+
+        String pointer() {
+            StringBuilder sb = new StringBuilder();
+            for (Object f : frames) {
+                if (f instanceof Integer i) {
+                    if (i < 0) {
+                        break;
+                    }
+                    sb.append('/').append(i);
+                } else {
+                    String name = ((String[]) f)[0];
+                    if (name == null) {
+                        break;
+                    }
+                    sb.append('/').append(name.replace("~", "~0").replace("/", "~1"));
+                }
+            }
+            return sb.toString();
+        }
+    }
+
+    static NumberType numberType(String lex) {
+        if (lex.indexOf('.') >= 0 || lex.indexOf('e') >= 0 || lex.indexOf('E') >= 0) {
+            return NumberType.DOUBLE;
+        }
+        BigInteger v = new BigInteger(lex);
+        if (v.bitLength() < 32) {
+            return NumberType.INT;
+        }
+        return v.bitLength() < 64 ? NumberType.LONG : NumberType.BIG_INTEGER;
+    }
+
+    /** Read the events back from the text with the parser kind, checking every token, value, path and number type. */
+    static void readBack(TestCase tc, JsonFactory f, Src src, String text, List<Ev> want, String what) {
+        PathModel pm = new PathModel();
+        int idx = 0;
+        try (Tokens t = new Tokens(tc, f, src, text, chunk(tc))) {
+            JsonParser p = t.p;
+            while (true) {
+                JsonToken tok = t.next();
+                if (tok == null) {
+                    break;
+                }
+                if (idx >= want.size()) {
+                    fail(what + " " + src + ": more tokens than events, " + tok + " at " + idx + " in " + show(text));
+                    return;
+                }
+                Ev e = want.get(idx++);
+                final int i = idx - 1;
+                switch (tok) {
+                    case START_ARRAY -> {
+                        check(e.kind().equals("["), () -> what + " " + src + " event " + i + ": START_ARRAY, expected " + e);
+                        pm.start(true);
+                    }
+                    case END_ARRAY -> {
+                        check(e.kind().equals("]"), () -> what + " " + src + " event " + i + ": END_ARRAY, expected " + e);
+                        pm.end();
+                    }
+                    case START_OBJECT -> {
+                        check(e.kind().equals("{"), () -> what + " " + src + " event " + i + ": START_OBJECT, expected " + e);
+                        pm.start(false);
+                    }
+                    case END_OBJECT -> {
+                        check(e.kind().equals("}"), () -> what + " " + src + " event " + i + ": END_OBJECT, expected " + e);
+                        pm.end();
+                    }
+                    case PROPERTY_NAME -> {
+                        String name = p.currentName();
+                        check(e.kind().equals("name") && name.equals(e.arg()), () -> what + " " + src + " event " + i + ": name " + show(name) + ", expected " + e);
+                        check(name.equals(p.getString()), () -> what + " " + src + ": getString() for a name is " + show(p.getString()) + " not " + show(name));
+                        pm.name(name);
+                    }
+                    case VALUE_STRING -> {
+                        String s = p.getString();
+                        check(e.kind().equals("string") && s.equals(e.arg()), () -> what + " " + src + " event " + i + ": string " + show(s) + ", expected " + e);
+                        pm.value();
+                    }
+                    case VALUE_NUMBER_INT, VALUE_NUMBER_FLOAT -> {
+                        String s = p.getString();
+                        boolean minusZero = src == Src.ASYNC && "-0".equals(e.lexeme()); // jackson-core/4
+                        check(e.kind().equals("number") && (s.equals(e.lexeme()) || minusZero), () -> what + " " + src + " event " + i + ": number lexeme " + s + ", expected " + e);
+                        if (e.kind().equals("number")) {
+                            NumberType nt = numberType(e.lexeme());
+                            check((tok == JsonToken.VALUE_NUMBER_FLOAT) == (nt == NumberType.DOUBLE), () -> what + " " + src + ": token " + tok + " for " + s);
+                            check(p.getNumberType() == nt, () -> what + " " + src + ": getNumberType " + p.getNumberType() + " for " + s + ", expected " + nt);
+                        }
+                        pm.value();
+                    }
+                    case VALUE_TRUE, VALUE_FALSE -> {
+                        check(e.kind().equals("bool") && e.arg().equals(tok == JsonToken.VALUE_TRUE), () -> what + " " + src + " event " + i + ": " + tok + ", expected " + e);
+                        pm.value();
+                    }
+                    case VALUE_NULL -> {
+                        check(e.kind().equals("null"), () -> what + " " + src + " event " + i + ": null, expected " + e);
+                        pm.value();
+                    }
+                    default -> fail(what + " " + src + ": unexpected token " + tok);
+                }
+                String ptr = p.streamReadContext().pathAsPointer().toString();
+                check(ptr.equals(pm.pointer()), () -> what + " " + src + " after event " + i + " " + e + ": pathAsPointer " + ptr + " expected " + pm.pointer() + " in " + show(text));
+            }
+            final int consumed = idx;
+            check(consumed == want.size(), () -> what + " " + src + ": parser stopped after " + consumed + " of " + want.size() + " events for " + show(text));
+            check(p.streamReadContext().inRoot(), () -> what + " " + src + ": not in root at the end: " + p.streamReadContext());
+        } catch (JacksonException | IllegalStateException e) {
+            fail(what + " " + src + ": parser threw " + e + " at event " + idx + " reading " + show(text));
+        }
+    }
+
+    @Test
+    void generatorEventsReadBackThroughEveryParser() {
+        Hegel.test(tc -> {
+            Cfg c = cfg(tc);
+            Object v = Ref.gen(tc, 4);
+            List<Ev> evs = events(tc, v, c, new ArrayList<>());
+            String text = generate(tc, evs, c, null);
+            if (text == null) {
+                return;
+            }
+            String expected = compact(evs, c.escaping());
+            check(text.equals(expected), () -> "generator (" + c + ") wrote " + show(text) + " expected " + show(expected));
+            // the reference reads the text as the denoted value
+            Object parsed;
+            try {
+                parsed = Ref.parse(text);
+            } catch (Ref.Bad e) {
+                fail("generator (" + c + ") produced invalid JSON " + show(text) + ": " + e.getMessage());
+                return;
+            }
+            Object want = denoted(evs);
+            check(Ref.same(parsed, want, true), () -> "text " + show(text) + " denotes " + Ref.show(parsed) + " expected " + Ref.show(want));
+            // every parser kind reads the events back
+            boolean lone = hasLoneSurrogate(text);
+            JsonFactory f = JsonFactory.builder().configure(StreamReadFeature.USE_FAST_DOUBLE_PARSER, chance(tc, 50)).build();
+            for (Src src : SRCS) {
+                if (lone && src.bytes()) {
+                    continue;
+                }
+                if (src == Src.DATA_INPUT && endsInBareScalar(text)) {
+                    continue; // jackson-core/1: the DataInput parser fails on a root number or literal at the very end
+                }
+                if (src.bytes() && (c.utf8() || c.nonAscii()) && nameHasLoneSurrogate(evs)) {
+                    continue; // jackson-core/3: the byte parsers reject the lone-surrogate escape the UTF-8 generator (or ESCAPE_NON_ASCII) writes in a name
+                }
+                if (src == Src.ASYNC && hasSurrogateEscape(text)) {
+                    continue; // jackson-core/11: an escaped surrogate pair in a name split between feeds stalls the non-blocking parser
+                }
+                readBack(tc, f, src, text, evs, "cfg " + c);
+            }
+        }, Zoo.settings("generatorEventsReadBackThroughEveryParser"));
+    }
