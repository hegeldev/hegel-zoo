+    // ------------------------------------------------------------------ 7. DefaultPrettyPrinter layout
+
+    /** An indenter choice: "default" = DefaultIndenter(indent, eol); "fixed" = FixedSpaceIndenter; "nop" = NopIndenter. */
+    record Ind(String kind, String indent, String eol) {
+        boolean inline() {
+            return !kind.equals("default");
+        }
+
+        DefaultPrettyPrinter.Indenter make() {
+            return switch (kind) {
+                case "fixed" -> DefaultPrettyPrinter.FixedSpaceIndenter.instance();
+                case "nop" -> DefaultPrettyPrinter.NopIndenter.instance();
+                default -> new DefaultIndenter(indent, eol);
+            };
+        }
+
+        void write(StringBuilder sb, int level) {
+            switch (kind) {
+                case "fixed" -> sb.append(' ');
+                case "nop" -> {
+                }
+                default -> {
+                    sb.append(eol);
+                    for (int i = 0; i < level; i++) {
+                        sb.append(indent);
+                    }
+                }
+            }
+        }
+    }
+
+    static final Generator<Ind> IND = weighted(v(2, new Ind("fixed", null, null)), v(1, new Ind("nop", null, null)),
+            w(7, tuples(pick("", " ", "  ", "\t", "    ", "   "), pick("\n", "\r\n", "\n", "\r")).map(t -> new Ind("default", t.value1(), t.value2()))));
+
+    static final Generator<Separators.Spacing> SPACING = pick(Separators.Spacing.values());
+
+    /** The separators of a printer; {@code standard} keeps the JSON punctuation and only draws the spacing and empty-container fillers. */
+    record Seps(String root, char nameValue, Separators.Spacing nameValueSpacing, char entry, Separators.Spacing entrySpacing, String objectEmpty,
+            char element, Separators.Spacing elementSpacing, String arrayEmpty) {
+        Separators make(boolean standard) {
+            return new Separators(root.equals("none") ? null : root, standard ? ':' : nameValue, nameValueSpacing, standard ? ',' : entry, entrySpacing,
+                    objectEmpty, standard ? ',' : element, elementSpacing, arrayEmpty);
+        }
+    }
+
+    static final Generator<Seps> SEPS = tuples(pick(" ", "", "\n", "none"), tuples(pick(':', '='), SPACING), tuples(pick(',', ';'), SPACING, pick("", " ", "  ")),
+            tuples(pick(',', '|'), SPACING, pick("", " ", "\n")))
+            .map(t -> new Seps(t.value1(), t.value2().value1(), t.value2().value2(), t.value3().value1(), t.value3().value2(), t.value3().value3(),
+                    t.value4().value1(), t.value4().value2(), t.value4().value3()));
+
+    /** The printer: the defaults, or drawn separators and indenters. */
+    record Printer(boolean defaults, boolean standard, Seps seps, Ind obj, Ind arr) {
+        DefaultPrettyPrinter make() {
+            return defaults ? new DefaultPrettyPrinter() : new DefaultPrettyPrinter(seps.make(standard)).withObjectIndenter(obj.make()).withArrayIndenter(arr.make());
+        }
+
+        Layout layout() {
+            return defaults
+                    ? new Layout(new Ind("default", "  ", System.lineSeparator()), new Ind("fixed", null, null), Separators.createDefaultInstance())
+                    : new Layout(obj, arr, seps.make(standard));
+        }
+
+        String describe() {
+            Separators sep = seps.make(standard);
+            return defaults ? "defaults" : obj + " " + arr + " " + sep.getObjectNameValueSpacing() + "/" + sep.getObjectEntrySpacing() + "/" + sep.getArrayElementSpacing();
+        }
+    }
+
+    static final Generator<Printer> PRINTER = tuples(chance(20), chance(70), SEPS, IND, IND)
+            .map(t -> new Printer(t.value1(), t.value2(), t.value3(), t.value4(), t.value5()));
+
+    /** A pretty-printing case: the value, how its numbers and events are written, the generator, the printer and the root count. */
+    record Pretty(Object value, List<NumForm> forms, List<Way> ways, boolean utf8, Printer printer, int roots) {
+        Cfg cfg() {
+            return new Cfg(utf8, false, false, true, false, false, true);
+        }
+    }
+
+    static final Generator<Pretty> PRETTY = tuples(Ref.VALUE, NUM_FORMS, WAYS, chance(50), PRINTER, weighted(v(70, 1), w(30, ints(2, 3))))
+            .map(t -> new Pretty(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6()));
+
+    /** The DefaultPrettyPrinter layout model. */
+    static final class Layout {
+        final Ind obj;
+        final Ind arr;
+        final Separators sep;
+        final StringBuilder sb = new StringBuilder();
+        int nesting;
+
+        Layout(Ind obj, Ind arr, Separators sep) {
+            this.obj = obj;
+            this.arr = arr;
+            this.sep = sep;
+        }
+
+        @SuppressWarnings("unchecked")
+        void value(Object v, Ref.Escaping esc) {
+            if (v instanceof List<?> l) {
+                if (!arr.inline()) {
+                    nesting++;
+                }
+                sb.append('[');
+                if (l.isEmpty()) {
+                    if (!arr.inline()) {
+                        nesting--;
+                    }
+                    sb.append(sep.getArrayEmptySeparator());
+                } else {
+                    for (int i = 0; i < l.size(); i++) {
+                        if (i == 0) {
+                            arr.write(sb, nesting);
+                        } else {
+                            sb.append(sep.getArrayElementSpacing().apply(sep.getArrayElementSeparator()));
+                            arr.write(sb, nesting);
+                        }
+                        value(l.get(i), esc);
+                    }
+                    if (!arr.inline()) {
+                        nesting--;
+                    }
+                    arr.write(sb, nesting);
+                }
+                sb.append(']');
+            } else if (v instanceof Map<?, ?> m) {
+                sb.append('{');
+                if (!obj.inline()) {
+                    nesting++;
+                }
+                if (m.isEmpty()) {
+                    if (!obj.inline()) {
+                        nesting--;
+                    }
+                    sb.append(sep.getObjectEmptySeparator());
+                } else {
+                    boolean first = true;
+                    for (Map.Entry<String, Object> e : ((Map<String, Object>) m).entrySet()) {
+                        if (first) {
+                            obj.write(sb, nesting);
+                        } else {
+                            sb.append(sep.getObjectEntrySpacing().apply(sep.getObjectEntrySeparator()));
+                            obj.write(sb, nesting);
+                        }
+                        first = false;
+                        Ref.quote(e.getKey(), esc, sb);
+                        sb.append(sep.getObjectNameValueSpacing().apply(sep.getObjectNameValueSeparator()));
+                        value(e.getValue(), esc);
+                    }
+                    if (!obj.inline()) {
+                        nesting--;
+                    }
+                    obj.write(sb, nesting);
+                }
+                sb.append('}');
+            } else if (v instanceof String s) {
+                Ref.quote(s, esc, sb);
+            } else if (v instanceof Ref.Num num) {
+                sb.append(num.text());
+            } else {
+                sb.append(v == Ref.NULL ? "null" : v.toString());
+            }
+        }
+    }
+
+    @Test
+    void prettyPrinterLayoutIsExact() {
+        Zoo.run("prettyPrinterLayoutIsExact", tc -> {
+            Pretty pc = tc.draw(PRETTY);
+            Cfg c = pc.cfg();
+            List<Ev> evs = events(pc.value(), pc.forms(), c);
+            Object denoted = denoted(evs);
+            Printer printer = pc.printer();
+            DefaultPrettyPrinter pp = printer.make();
+            Layout model = printer.layout();
+            model.value(denoted, c.escaping());
+            String expected = model.sb.toString();
+            // several root values exercise the root separator
+            int roots = pc.roots();
+            List<Ev> all = new ArrayList<>();
+            StringBuilder want = new StringBuilder();
+            for (int i = 0; i < roots; i++) {
+                all.addAll(evs);
+                if (i > 0) {
+                    String rs = model.sep.getRootSeparator();
+                    want.append(rs == null ? "" : rs);
+                }
+                want.append(expected);
+            }
+            String text = generate(all, pc.ways(), false, c, pp);
+            if (text == null) {
+                return;
+            }
+            String description = printer.describe();
+            check(text.equals(want.toString()), () -> "pretty (" + description + ") " + firstDifference(text, want.toString()) + " for " + Ref.show(denoted)
+                    + " got " + show(text) + " want " + show(want.toString()));
+            if (printer.standard() || printer.defaults()) {
+                String rs = model.sep.getRootSeparator();
+                boolean wsOnly = (rs == null || rs.isBlank()) && model.sep.getObjectEmptySeparator().isBlank() && model.sep.getArrayEmptySeparator().isBlank();
+                boolean scalarWord = denoted instanceof Ref.Num || denoted instanceof Boolean || denoted == Ref.NULL;
+                boolean rootsSeparated = roots == 1 || !scalarWord || (rs != null && !rs.isEmpty());
+                if (wsOnly && rootsSeparated) {
+                    try {
+                        List<Object> back = Ref.parseRoots(text);
+                        check(back.size() == roots && Ref.same(back.get(0), denoted, true), () -> "pretty text " + show(text) + " reads back as " + Ref.show(back));
+                    } catch (Ref.Bad e) {
+                        fail("pretty text " + show(text) + " is not valid JSON: " + e.getMessage());
+                    }
+                }
+            }
+        });
+    }
+
+    // ------------------------------------------------------------------ 8. lenient read features
+
+    static final JsonReadFeature[] LENIENT = {JsonReadFeature.ALLOW_JAVA_COMMENTS, JsonReadFeature.ALLOW_YAML_COMMENTS, JsonReadFeature.ALLOW_SINGLE_QUOTES,
+        JsonReadFeature.ALLOW_UNQUOTED_PROPERTY_NAMES, JsonReadFeature.ALLOW_UNESCAPED_CONTROL_CHARS, JsonReadFeature.ALLOW_BACKSLASH_ESCAPING_ANY_CHARACTER,
+        JsonReadFeature.ALLOW_LEADING_ZEROS_FOR_NUMBERS, JsonReadFeature.ALLOW_LEADING_PLUS_SIGN_FOR_NUMBERS, JsonReadFeature.ALLOW_LEADING_DECIMAL_POINT_FOR_NUMBERS,
+        JsonReadFeature.ALLOW_TRAILING_DECIMAL_POINT_FOR_NUMBERS, JsonReadFeature.ALLOW_TRAILING_COMMA};
+
+    static final Generator<JsonReadFeature> FEATURE = pick(LENIENT);
+
+    /** The escaped body of a one-char string, per the reference (no surrounding quotes). */
+    static String escaped(char ch) {
+        String q = Ref.quote(String.valueOf(ch), Ref.PLAIN);
+        return q.substring(1, q.length() - 1);
+    }
+
+    static final String IDENTIFIER = "[A-Za-z_$][A-Za-z0-9_$]*";
+
+    static final String LEADING_POINT_SHAPE = "-?0\\.[0-9]+([eE][-+]?[0-9]+)?";
+
+    /** True when the char may take a backslash under ALLOW_BACKSLASH_ESCAPING_ANY_CHARACTER without changing the value (the pair's first half for a pair). */
+    static boolean escapable(String s, int i) {
+        char ch = s.charAt(i);
+        if (ch == '"' || ch == '\\' || ch < 0x20 || "ubfnrt/".indexOf(ch) >= 0) {
+            return false;
+        }
+        return !Character.isSurrogate(ch) || (Character.isHighSurrogate(ch) && i + 1 < s.length() && Character.isLowSurrogate(s.charAt(i + 1)));
+    }
+
+    /**
+     * How a value is spelled with one lenient feature: {@code uses} says at each site whether the feature's spelling
+     * is used (the first site always is), {@code escapes} which escapable characters take a backslash (the first
+     * always does), {@code alts} the alternative spellings, {@code picks} the comment texts and leading-zero counts.
+     */
+    record LenientSpelling(List<Boolean> uses, List<Boolean> escapes, List<Boolean> alts, List<Integer> picks) {
+        String text(Object v, JsonReadFeature f) {
+            StringBuilder sb = new StringBuilder();
+            write(v, f, sb, new int[4]);
+            return sb.toString();
+        }
+
+        private boolean use(int[] at) {
+            int k = at[0]++;
+            return k == 0 || tape(uses, k, false);
+        }
+
+        private boolean escape(int[] at) {
+            int k = at[1]++;
+            return k == 0 || tape(escapes, k, false);
+        }
+
+        private boolean alt(int[] at) {
+            return tape(alts, at[2]++, false);
+        }
+
+        private int pick(int[] at, int n) {
+            return Math.floorMod(tape(picks, at[3]++, 0), n);
+        }
+
+        @SuppressWarnings("unchecked")
+        private void write(Object v, JsonReadFeature f, StringBuilder sb, int[] at) {
+            if (f == JsonReadFeature.ALLOW_JAVA_COMMENTS && use(at)) {
+                sb.append(List.of("/*c*/", "//c\n", "/**/", "/* * / */").get(pick(at, 4)));
+            }
+            if (f == JsonReadFeature.ALLOW_YAML_COMMENTS && use(at)) {
+                sb.append(List.of("#c\n", "#\n", "# a b\r\n").get(pick(at, 3)));
+            }
+            if (v == Ref.NULL || v instanceof Boolean) {
+                sb.append(v);
+            } else if (v instanceof Ref.Num num) {
+                String lex = num.text();
+                if (f == JsonReadFeature.ALLOW_LEADING_PLUS_SIGN_FOR_NUMBERS && !lex.startsWith("-") && use(at)) {
+                    lex = "+" + lex;
+                }
+                if (f == JsonReadFeature.ALLOW_LEADING_ZEROS_FOR_NUMBERS && use(at)) {
+                    String zeros = "0".repeat(1 + pick(at, 3));
+                    lex = lex.startsWith("-") ? "-" + zeros + lex.substring(1) : zeros + lex;
+                }
+                if (f == JsonReadFeature.ALLOW_TRAILING_DECIMAL_POINT_FOR_NUMBERS && lex.matches("-?[0-9]+") && use(at)) {
+                    lex = lex + ".";
+                }
+                if (f == JsonReadFeature.ALLOW_LEADING_DECIMAL_POINT_FOR_NUMBERS && lex.matches(LEADING_POINT_SHAPE) && use(at)) {
+                    lex = lex.startsWith("-") ? "-" + lex.substring(2) : lex.substring(1);
+                }
+                sb.append(lex);
+            } else if (v instanceof String s) {
+                if (f == JsonReadFeature.ALLOW_SINGLE_QUOTES && use(at)) {
+                    sb.append('\'');
+                    for (int i = 0; i < s.length(); i++) {
+                        char ch = s.charAt(i);
+                        if (ch == '\'') {
+                            sb.append(alt(at) ? "\\u0027" : "\\'");
+                        } else if (ch == '"') {
+                            sb.append(alt(at) ? "\\\"" : "\"");
+                        } else {
+                            sb.append(escaped(ch));
+                        }
+                    }
+                    sb.append('\'');
+                } else if (f == JsonReadFeature.ALLOW_UNESCAPED_CONTROL_CHARS && use(at)) {
+                    sb.append('"');
+                    for (int i = 0; i < s.length(); i++) {
+                        char ch = s.charAt(i);
+                        if (ch == '"' || ch == '\\') {
+                            sb.append('\\').append(ch);
+                        } else {
+                            sb.append(ch); // control characters raw
+                        }
+                    }
+                    sb.append('"');
+                } else if (f == JsonReadFeature.ALLOW_BACKSLASH_ESCAPING_ANY_CHARACTER && use(at)) {
+                    sb.append('"');
+                    for (int i = 0; i < s.length(); i++) {
+                        char ch = s.charAt(i);
+                        if (ch == '"' || ch == '\\' || ch < 0x20) {
+                            sb.append(escaped(ch));
+                        } else if (escapable(s, i) && (!Zoo.NO_KNOWN || ch < 0x80) && escape(at)) {
+                            sb.append('\\').append(ch);
+                        } else {
+                            sb.append(ch);
+                        }
+                    }
+                    sb.append('"');
+                } else {
+                    Ref.quote(s, Ref.PLAIN, sb);
+                }
+            } else if (v instanceof List<?> l) {
+                sb.append('[');
+                for (int i = 0; i < l.size(); i++) {
+                    if (i > 0) {
+                        sb.append(',');
+                    }
+                    write(l.get(i), f, sb, at);
+                }
+                if (f == JsonReadFeature.ALLOW_TRAILING_COMMA && !l.isEmpty() && use(at)) {
+                    sb.append(',');
+                }
+                sb.append(']');
+            } else {
+                sb.append('{');
+                boolean first = true;
+                for (Map.Entry<String, Object> e : ((Map<String, Object>) v).entrySet()) {
+                    if (!first) {
+                        sb.append(',');
+                    }
+                    first = false;
+                    String k = e.getKey();
+                    if (f == JsonReadFeature.ALLOW_UNQUOTED_PROPERTY_NAMES && k.matches(IDENTIFIER) && use(at)) {
+                        sb.append(k);
+                    } else if (f == JsonReadFeature.ALLOW_SINGLE_QUOTES && alt(at)) {
+                        write(k, f, sb, at);
+                    } else {
+                        Ref.quote(k, Ref.PLAIN, sb);
+                    }
+                    sb.append(':');
+                    write(e.getValue(), f, sb, at);
+                }
+                if (f == JsonReadFeature.ALLOW_TRAILING_COMMA && !((Map<?, ?>) v).isEmpty() && use(at)) {
+                    sb.append(',');
+                }
+                sb.append('}');
+            }
+        }
+    }
+
+    static final Generator<LenientSpelling> LENIENT_SPELLING = tuples(many(chance(60), 0, 12), many(chance(30), 0, 16), many(chance(50), 0, 16), many(ints(0, 11), 0, 8))
+            .map(t -> new LenientSpelling(t.value1(), t.value2(), t.value3(), t.value4()));
+
+    /** A string with a control character in it (a site for ALLOW_UNESCAPED_CONTROL_CHARS). */
+    static Generator<String> controlString(boolean lone) {
+        return tuples(Ref.string(lone), pick("\u0000", "\u0001", "\u001f", "\n", "\t", "\r", "\b", "\f"), Ref.string(lone))
+                .map(t -> t.value1() + t.value2() + t.value3());
+    }
+
+    /** A string with a character a backslash may precede (a site for ALLOW_BACKSLASH_ESCAPING_ANY_CHARACTER). */
+    static Generator<String> escapableString(boolean lone) {
+        return tuples(Ref.string(lone), pick("a", "1", " ", "<", "'", "\u00e9", "\u65e5", "\ud83d\ude00"), Ref.string(lone))
+                .map(t -> t.value1() + t.value2() + t.value3());
+    }
+
+    /** A number with a leading zero and a fraction: 0.5, -0.25e3 (a site for ALLOW_LEADING_DECIMAL_POINT_FOR_NUMBERS). */
+    static final Generator<Object> LEADING_POINT_NUMBER = tuples(chance(30), word(Ref.DIGITS, 1, 12), opt(30, Ref.EXPONENT))
+            .map(t -> Ref.Num.of((t.value1() ? "-" : "") + "0." + t.value2() + t.value3()));
+
+    /** A value the feature has a site in: a number, a string, a non-empty container or an identifier-named entry. */
+    static Generator<Object> seed(JsonReadFeature f, boolean lone) {
+        Generator<Object> scalar = Ref.scalar(lone);
+        return switch (f) {
+            case ALLOW_LEADING_ZEROS_FOR_NUMBERS -> Ref.NUMBER.map(Ref.Num::of);
+            case ALLOW_LEADING_PLUS_SIGN_FOR_NUMBERS -> Ref.NUMBER.map(lex -> Ref.Num.of(lex.startsWith("-") ? lex.substring(1) : lex));
+            case ALLOW_TRAILING_DECIMAL_POINT_FOR_NUMBERS -> Ref.INTEGER_LEXEME.map(Ref.Num::of);
+            case ALLOW_LEADING_DECIMAL_POINT_FOR_NUMBERS -> LEADING_POINT_NUMBER;
+            case ALLOW_SINGLE_QUOTES -> Ref.string(lone).map(s -> s);
+            case ALLOW_UNESCAPED_CONTROL_CHARS -> controlString(lone).map(s -> s);
+            case ALLOW_BACKSLASH_ESCAPING_ANY_CHARACTER -> escapableString(lone).map(s -> s);
+            case ALLOW_TRAILING_COMMA -> Gen.<Object>weighted(w(1, many(scalar, 1, 3).map(l -> (Object) new ArrayList<>(l))),
+                    w(1, many(tuples(Ref.string(lone), scalar), 1, 3).map(Ref::toMap)));
+            case ALLOW_UNQUOTED_PROPERTY_NAMES -> tuples(word("abcXYZ_$", 1, 1), word("abcXYZ_$019", 0, 4), scalar)
+                    .map(t -> Ref.toMap(List.of(new dev.hegel.Tuple2<>(t.value1() + t.value2(), t.value3()))));
+            default -> Ref.value(3, lone);
+        };
+    }
+
+    /** The seed at the root, first in a list, or as the first value of an object, so that the feature's first site is the seed's. */
+    static Generator<Object> host(Generator<Object> seed, boolean lone) {
+        Generator<Object> filler = Ref.value(2, lone);
+        return Gen.<Object>weighted(w(50, seed),
+                w(25, tuples(seed, many(filler, 0, 3)).map(t -> {
+                    List<Object> out = new ArrayList<>();
+                    out.add(t.value1());
+                    out.addAll(t.value2());
+                    return out;
+                })),
+                w(25, tuples(Ref.string(lone), seed, many(tuples(Ref.string(lone), filler), 0, 3)).map(t -> {
+                    List<dev.hegel.Tuple2<String, Object>> entries = new ArrayList<>();
+                    entries.add(new dev.hegel.Tuple2<>(t.value1(), t.value2()));
+                    entries.addAll(t.value3());
+                    return Ref.toMap(entries);
+                })));
+    }
+
+    /** A lenient case: the feature, a value with a site for it, its lenient spelling, the source and its feeding. */
+    record Lenient(JsonReadFeature feature, Src src, Object value, LenientSpelling spelling, Feed feed) {
+        String lenient() {
+            return spelling.text(value, feature);
+        }
+
+        String strict() {
+            return Ref.write(value, Ref.PLAIN);
+        }
+    }
+
+    static final Generator<Lenient> LENIENT_CASE = tuples(FEATURE, SRC).flatMap(fs -> {
+        JsonReadFeature f = fs.value1();
+        Src src = fs.value2();
+        boolean lone = !src.bytes();
+        return tuples(host(seed(f, lone), lone), LENIENT_SPELLING, FEED).map(t -> new Lenient(f, src, t.value1(), t.value2(), t.value3()));
+    });
+
+    /** True when a backslash precedes a non-ASCII character somewhere in the text. */
+    static boolean escapesNonAscii(String text) {
+        for (int i = 0; i + 1 < text.length(); i++) {
+            if (text.charAt(i) == '\\' && text.charAt(i + 1) > 0x7f) {
+                return true;
+            }
+            if (text.charAt(i) == '\\') {
+                i++;
+            }
+        }
+        return false;
+    }
+
+    static boolean numeric(JsonReadFeature f) {
+        return f == JsonReadFeature.ALLOW_LEADING_ZEROS_FOR_NUMBERS || f == JsonReadFeature.ALLOW_LEADING_PLUS_SIGN_FOR_NUMBERS
+                || f == JsonReadFeature.ALLOW_TRAILING_DECIMAL_POINT_FOR_NUMBERS || f == JsonReadFeature.ALLOW_LEADING_DECIMAL_POINT_FOR_NUMBERS;
+    }
+
+    /** The feature reads the lenient text as the strict value; without the feature the strict parser rejects it. */
+    static void checkLenient(TestCase tc, Lenient lc) {
+        JsonReadFeature feature = lc.feature();
+        Src src = lc.src();
+        String lenient = lc.lenient();
+        String strict = lc.strict();
+        Zoo.assume(tc, !lenient.equals(strict), "the lenient spelling equals the strict one");
+        Zoo.assume(tc, !(src.bytes() && hasLoneSurrogate(lenient)), "bytes cannot carry a lone surrogate");
+        if (Zoo.NO_KNOWN) {
+            Zoo.assume(tc, !(src.bytes() && feature == JsonReadFeature.ALLOW_BACKSLASH_ESCAPING_ANY_CHARACTER && escapesNonAscii(lenient)),
+                    "a backslash before a multi-byte character for the byte parsers (jackson-core/9, /10)");
+            Zoo.assume(tc, !(src.bytes() && lenient.startsWith("\"\u0000")), "a quote and NUL at the start of the bytes (jackson-core/5)");
+        }
+        Object want = Ref.parse(strict);
+        if (numeric(feature)) {
+            want = numbersByValue(want);
+        }
+        final Object expected = want;
+        JsonFactory on = JsonFactory.builder().enable(feature).build();
+        List<Object> got = new ArrayList<>();
+        try (Tokens t = new Tokens(on, src, lenient + " ", lc.feed())) {
+            JsonToken tok;
+            while ((tok = t.next()) != null) {
+                got.add(value(t, tok));
+            }
+            check(got.size() == 1 && Ref.same(numeric(feature) ? numbersByValue(got.get(0)) : got.get(0), expected, true),
+                    () -> feature + " " + src + ": " + show(lenient) + " read as " + Ref.show(got) + " expected " + Ref.show(expected));
+        } catch (JacksonException | IllegalStateException e) {
+            fail(feature + " " + src + ": rejects " + show(lenient) + ": " + e.getMessage());
+        }
+        // and the strict parser rejects the lenient text
+        if (Zoo.NO_KNOWN && src == Src.ASYNC && feature == JsonReadFeature.ALLOW_TRAILING_COMMA) {
+            Zoo.count("not checked: the strict non-blocking parser on a trailing comma fed in pieces (jackson-core/12)");
+            return;
+        }
+        checkStrictRejects(src, lc.feed(), lenient, feature + " " + src);
+    }
+
+    static void checkStrictRejects(Src src, Feed feed, String lenient, String what) {
+        JsonFactory off = new JsonFactory();
+        try (Tokens t = new Tokens(off, src, lenient + " ", feed)) {
+            List<Object> read = new ArrayList<>();
+            JsonToken tok;
+            while ((tok = t.next()) != null) {
+                read.add(value(t, tok));
+            }
+            fail(what + ": the strict parser accepts " + show(lenient) + " as " + Ref.show(read));
+        } catch (JacksonException | IllegalStateException e) {
+            // expected
+        }
+    }
+
+    @Test
+    void lenientFeaturesReadTheirSpellingsAsTheStrictValue() {
+        Zoo.run("lenientFeaturesReadTheirSpellingsAsTheStrictValue", tc -> checkLenient(tc, tc.draw(LENIENT_CASE)));
+    }
+
+    /** Numbers replaced by their canonical value text, so lenient spellings compare equal. */
+    @SuppressWarnings("unchecked")
+    static Object numbersByValue(Object v) {
+        if (v instanceof Ref.Num num) {
+            return num.value() == null ? num : Ref.Num.of(num.value().stripTrailingZeros().toPlainString());
+        }
+        if (v instanceof List<?> l) {
+            List<Object> out = new ArrayList<>();
+            for (Object x : l) {
+                out.add(numbersByValue(x));
+            }
+            return out;
+        }
+        if (v instanceof Map<?, ?> m) {
+            Map<String, Object> out = new java.util.LinkedHashMap<>();
+            for (Map.Entry<String, Object> e : ((Map<String, Object>) m).entrySet()) {
+                out.put(e.getKey(), numbersByValue(e.getValue()));
+            }
+            return out;
+        }
+        return v;
+    }
+
+    // ------------------------------------------------------------------ pins
+
+    static final JsonFactory F = new JsonFactory();
+    static final ObjectReadContext CTX = ObjectReadContext.empty();
+
+    static JsonParser dataInput(String doc) {
+        return F.createParser(CTX, (java.io.DataInput) new DataInputStream(new ByteArrayInputStream(doc.getBytes(StandardCharsets.UTF_8))));
+    }
+
+    static String utf8Text(java.util.function.Consumer<JsonGenerator> body) {
+        ByteArrayOutputStream out = new ByteArrayOutputStream();
+        try (JsonGenerator g = F.createGenerator(ObjectWriteContext.empty(), out)) {
+            body.accept(g);
+        }
+        return out.toString(StandardCharsets.UTF_8);
+    }
+
+    /** jackson-core/1: a root-level literal or number at the very end of a DataInput fails with an EOF. */
+    @Test
+    void pinDataInputRootValueAtEndOfInput() {
+        try (JsonParser p = dataInput("true")) {
+            Assertions.assertEquals(JsonToken.VALUE_TRUE, p.nextToken());
+            Assertions.assertNull(p.nextToken());
+        }
+        try (JsonParser p = dataInput("15")) {
+            Assertions.assertEquals(JsonToken.VALUE_NUMBER_INT, p.nextToken());
+            Assertions.assertEquals(15, p.getIntValue());
+        }
+        try (JsonParser p = dataInput("")) {
+            Assertions.assertNull(p.nextToken());
+        }
+    }
+
+    /** jackson-core/2: getNumberValueExact() is exact only if no other accessor was called first. */
+    @Test
+    void pinNumberValueExactAfterNumberType() {
+        try (JsonParser p = F.createParser(CTX, "123456789.123456789")) {
+            p.nextToken();
+            Assertions.assertEquals(NumberType.DOUBLE, p.getNumberType());
+            Assertions.assertEquals(new BigDecimal("123456789.123456789"), p.getNumberValueExact());
+        }
+    }
+
+    /** jackson-core/3: the byte-based parsers reject a lone-surrogate escape in a property name; the UTF-8 generator writes one. */
+    @Test
+    void pinByteParsersReadLoneSurrogateEscapeInName() {
+        String text = utf8Text(g -> g.writeStartObject().writeName("a\udc00").writeNumber(1).writeEndObject());
+        Assertions.assertEquals("{\"a\\uDC00\":1}", text);
+        try (JsonParser p = F.createParser(CTX, text.getBytes(StandardCharsets.UTF_8))) {
+            Assertions.assertEquals(JsonToken.START_OBJECT, p.nextToken());
+            Assertions.assertEquals(JsonToken.PROPERTY_NAME, p.nextToken());
+            Assertions.assertEquals("a\udc00", p.currentName());
+        }
+    }
+
+    /** jackson-core/4: the non-blocking parser drops the sign of -0. */
+    @Test
+    void pinAsyncParserKeepsTheSignOfMinusZero() {
+        JsonParser p = F.createNonBlockingByteArrayParser(CTX);
+        byte[] doc = "[-0]".getBytes(StandardCharsets.UTF_8);
+        ((ByteArrayFeeder) p).feedInput(doc, 0, doc.length);
+        Assertions.assertEquals(JsonToken.START_ARRAY, p.nextToken());
+        Assertions.assertEquals(JsonToken.VALUE_NUMBER_INT, p.nextToken());
+        Assertions.assertEquals("-0", p.getString());
+    }
+
+    /** jackson-core/5: with unescaped control characters allowed, a document starting with a quote and NUL is sniffed as UTF-16. */
+    @Test
+    void pinUnescapedNulAtDocumentStart() {
+        JsonFactory lenient = JsonFactory.builder().enable(JsonReadFeature.ALLOW_UNESCAPED_CONTROL_CHARS).build();
+        byte[] doc = "\"\u0000a\"".getBytes(StandardCharsets.UTF_8);
+        try (JsonParser p = lenient.createParser(CTX, doc)) {
+            Assertions.assertEquals(JsonToken.VALUE_STRING, p.nextToken());
+            Assertions.assertEquals("\u0000a", p.getString());
+        }
+    }
+
+    /** jackson-core/6: a floating-point lexeme whose double is 2^63 passes the long range check and saturates. */
+    @Test
+    void pinLongValueSaturatesAtTwoToThe63() {
+        try (JsonParser p = F.createParser(CTX, "9223372036854775808.5")) {
+            p.nextToken();
+            Assertions.assertThrows(InputCoercionException.class, p::getLongValue);
+        }
+    }
+
+    /** jackson-core/7: writeString(Reader) splits a surrogate pair at its 4000-char read and writes both halves as escapes. */
+    @Test
+    void pinWriteStringFromReaderKeepsPairsTogether() {
+        String s = "a".repeat(3999) + "😀";
+        String text = utf8Text(g -> g.writeString(new StringReader(s), -1));
+        Assertions.assertEquals("\"" + s + "\"", text);
+    }
+
+    /** jackson-core/8: writeString(SerializableString) on the UTF-8 generator throws for an unpaired surrogate that writeString(String) escapes. */
+    @Test
+    void pinSerializedStringWithLoneSurrogate() {
+        Assertions.assertEquals("\"a\\uD800b\"", utf8Text(g -> g.writeString("a\ud800b")));
+        Assertions.assertEquals("\"a\\uD800b\"", utf8Text(g -> g.writeString(new SerializedString("a\ud800b"))));
+    }
+
+    /** jackson-core/9: with any character escapable, the byte parsers truncate an escaped 4-byte character to one char. */
+    @Test
+    void pinByteParsersEscapedFourByteCharacter() {
+        JsonFactory lenient = JsonFactory.builder().enable(JsonReadFeature.ALLOW_BACKSLASH_ESCAPING_ANY_CHARACTER).build();
+        byte[] doc = "\"\\😀\"".getBytes(StandardCharsets.UTF_8);
+        try (JsonParser p = lenient.createParser(CTX, doc)) {
+            Assertions.assertEquals(JsonToken.VALUE_STRING, p.nextToken());
+            Assertions.assertEquals("😀", p.getString());
+        }
+    }
+
+    /** jackson-core/10: with any character escapable, the non-blocking parser fails on an escaped multi-byte character. */
+    @Test
+    void pinAsyncParserEscapedMultiByteCharacter() {
+        JsonFactory lenient = JsonFactory.builder().enable(JsonReadFeature.ALLOW_BACKSLASH_ESCAPING_ANY_CHARACTER).build();
+        JsonParser p = lenient.createNonBlockingByteArrayParser(CTX);
+        byte[] doc = "\"\\é\"".getBytes(StandardCharsets.UTF_8);
+        ((ByteArrayFeeder) p).feedInput(doc, 0, doc.length);
+        Assertions.assertEquals(JsonToken.VALUE_STRING, p.nextToken());
+        Assertions.assertEquals("é", p.getString());
+    }
+
+    /** jackson-core/12: the non-blocking parser accepts a trailing comma in an object when the brace arrives in a later feed. */
+    @Test
+    void pinAsyncParserRejectsTrailingCommaAcrossFeeds() {
+        JsonParser p = F.createNonBlockingByteArrayParser(CTX);
+        ByteArrayFeeder feeder = (ByteArrayFeeder) p;
+        byte[] doc = "{\"a\":1,}".getBytes(StandardCharsets.UTF_8);
+        Assertions.assertThrows(JacksonException.class, () -> {
+            int fed = 0;
+            while (true) {
+                JsonToken t = p.nextToken();
+                if (t == JsonToken.NOT_AVAILABLE) {
+                    if (fed >= doc.length) {
+                        feeder.endOfInput();
+                    } else {
+                        feeder.feedInput(doc, fed, fed + 1);
+                        fed++;
+                    }
+                } else if (t == null) {
+                    return;
+                }
+            }
+        });
+    }
+
+    /** jackson-core/13: the DataInput parser skips control characters between tokens instead of rejecting them. */
+    @Test
+    void pinDataInputRejectsControlCharsBetweenTokens() {
+        byte[] doc = {0x01, ' ', '[', ']'};
+        Assertions.assertThrows(JacksonException.class, () -> {
+            try (JsonParser p = F.createParser(CTX, (java.io.DataInput) new DataInputStream(new ByteArrayInputStream(doc)))) {
+                while (p.nextToken() != null) {
+                    // drain: 0x01 before the first token must be reported, as every other parser does
+                }
+            }
+        });
+        // and between root values
+        byte[] doc2 = {'[', ']', ' ', 0x01, ' ', '[', ']'};
+        Assertions.assertThrows(JacksonException.class, () -> {
+            try (JsonParser p = F.createParser(CTX, (java.io.DataInput) new DataInputStream(new ByteArrayInputStream(doc2)))) {
+                while (p.nextToken() != null) {
+                    // drain
+                }
+            }
+        });
+    }
+
+    /** jackson-core/11: an escaped surrogate pair in a name split between feeds: NOT_AVAILABLE although needMoreInput() is false. */
+    @Test
+    void pinAsyncParserSurrogateEscapeSplitInName() {
+        JsonParser p = F.createNonBlockingByteArrayParser(CTX);
+        ByteArrayFeeder feeder = (ByteArrayFeeder) p;
+        byte[] doc = "{\"\\uD83D\\uDE00\":1}".getBytes(StandardCharsets.UTF_8);
+        feeder.feedInput(doc, 0, 9); // up to and including the high surrogate's escape
+        Assertions.assertEquals(JsonToken.START_OBJECT, p.nextToken());
+        JsonToken t = p.nextToken();
+        Assertions.assertTrue(t != JsonToken.NOT_AVAILABLE || feeder.needMoreInput(), "NOT_AVAILABLE although needMoreInput() is false");
+        feeder.feedInput(doc, 9, doc.length);
+        Assertions.assertEquals(JsonToken.PROPERTY_NAME, p.nextToken());
+        Assertions.assertEquals("😀", p.currentName());
+    }
+
+    /** jackson-core/14: the non-blocking parser accepts a root integer directly followed by another root value when both arrive in one feed. */
+    @Test
+    void pinAsyncParserRejectsAdjacentRootValuesInOneFeed() {
+        JsonParser p = F.createNonBlockingByteArrayParser(CTX);
+        ByteArrayFeeder feeder = (ByteArrayFeeder) p;
+        byte[] doc = "1-40".getBytes(StandardCharsets.UTF_8);
+        Assertions.assertThrows(JacksonException.class, () -> {
+            boolean fed = false;
+            while (true) {
+                JsonToken t = p.nextToken();
+                if (t == JsonToken.NOT_AVAILABLE) {
+                    if (fed) {
+                        feeder.endOfInput();
+                    } else {
+                        feeder.feedInput(doc, 0, doc.length);
+                        fed = true;
+                    }
+                } else if (t == null) {
+                    return;
+                }
+            }
+        });
+    }
