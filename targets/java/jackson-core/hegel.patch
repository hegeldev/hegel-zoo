+    /** Parses the whole text with the source and checks acceptance and values against the reference's root model. */
+    static void checkAgrees(TestCase tc, JsonFactory f, Src src, Feed feed, String doc) {
+        List<Object> want;
+        Ref.Bad bad = null;
+        try {
+            want = Ref.parseRoots(doc);
+        } catch (Ref.Bad e) {
+            want = null;
+            bad = e;
+        }
+        if (Zoo.NO_KNOWN) {
+            Zoo.assume(tc, !(src == Src.ASYNC && bad != null && bad.getMessage().startsWith("expected space separating root-level values") && integerRunsIntoTheNextRootValue(doc, bad.at)),
+                    "a root integer running into the next root value in one feed of the non-blocking parser (jackson-core/14)");
+        }
+        final String reason = bad == null ? null : bad.getMessage();
+        final List<Object> expected = want;
+        List<Object> got = new ArrayList<>();
+        String error = null;
+        try (Tokens t = new Tokens(f, src, doc, feed)) {
+            while (true) {
+                JsonToken tok = t.next();
+                if (tok == null) {
+                    break;
+                }
+                got.add(value(t, tok));
+            }
+        } catch (JacksonException | IllegalStateException | StackOverflowError e) {
+            error = e.toString();
+        }
+        final String err = error;
+        if (expected != null) {
+            check(err == null, () -> src + " rejects valid " + show(doc) + ": " + err);
+            if (err == null) {
+                check(Ref.same(got, expected, true), () -> src + " reads " + show(doc) + " as " + Ref.show(got) + " expected " + Ref.show(expected));
+            }
+        } else {
+            check(err != null, () -> src + " accepts invalid " + show(doc) + " (" + reason + ") as " + Ref.show(got));
+        }
+    }
