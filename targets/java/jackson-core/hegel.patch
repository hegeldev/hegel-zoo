+    // ------------------------------------------------------------------ 8. lenient read features
+
+    /** The escaped body of a one-char string, per the reference (no surrounding quotes). */
+    static String escaped(char ch) {
+        String q = Ref.quote(String.valueOf(ch), Ref.PLAIN);
+        return q.substring(1, q.length() - 1);
+    }
+
+    static String lenientText(TestCase tc, Object v, JsonReadFeature f) {
+        StringBuilder sb = new StringBuilder();
+        text(tc, v, f, sb);
+        return sb.toString();
+    }
+
+    @SuppressWarnings("unchecked")
+    private static void text(TestCase tc, Object v, JsonReadFeature f, StringBuilder sb) {
+        if (f == JsonReadFeature.ALLOW_JAVA_COMMENTS && chance(tc, 25)) {
+            sb.append(pick(tc, "/*c*/", "//c\n", "/**/", "/* * / */"));
+        }
+        if (f == JsonReadFeature.ALLOW_YAML_COMMENTS && chance(tc, 25)) {
+            sb.append(pick(tc, "#c\n", "#\n", "# a b\r\n"));
+        }
+        if (v == Ref.NULL || v instanceof Boolean) {
+            sb.append(v);
+        } else if (v instanceof Ref.Num num) {
+            String lex = num.text();
+            if (f == JsonReadFeature.ALLOW_LEADING_PLUS_SIGN_FOR_NUMBERS && !lex.startsWith("-") && chance(tc, 60)) {
+                lex = "+" + lex;
+            }
+            if (f == JsonReadFeature.ALLOW_LEADING_ZEROS_FOR_NUMBERS && chance(tc, 60)) {
+                lex = lex.startsWith("-") ? "-" + "0".repeat(n(tc, 1, 3)) + lex.substring(1) : "0".repeat(n(tc, 1, 3)) + lex;
+            }
+            if (f == JsonReadFeature.ALLOW_TRAILING_DECIMAL_POINT_FOR_NUMBERS && lex.matches("-?[0-9]+") && chance(tc, 60)) {
+                lex = lex + ".";
+            }
+            if (f == JsonReadFeature.ALLOW_LEADING_DECIMAL_POINT_FOR_NUMBERS && lex.matches("-?0\\.[0-9]+([eE][-+]?[0-9]+)?") && chance(tc, 60)) {
+                lex = lex.startsWith("-") ? "-" + lex.substring(2) : lex.substring(1);
+            }
+            sb.append(lex);
+        } else if (v instanceof String s) {
+            if (f == JsonReadFeature.ALLOW_SINGLE_QUOTES && chance(tc, 60)) {
+                sb.append('\'');
+                for (int i = 0; i < s.length(); i++) {
+                    char ch = s.charAt(i);
+                    if (ch == '\'') {
+                        sb.append(chance(tc, 50) ? "\\'" : "\\u0027");
+                    } else if (ch == '"') {
+                        sb.append(chance(tc, 50) ? "\"" : "\\\"");
+                    } else {
+                        sb.append(escaped(ch));
+                    }
+                }
+                sb.append('\'');
+            } else if (f == JsonReadFeature.ALLOW_UNESCAPED_CONTROL_CHARS && chance(tc, 60)) {
+                sb.append('"');
+                for (int i = 0; i < s.length(); i++) {
+                    char ch = s.charAt(i);
+                    if (ch == '"' || ch == '\\') {
+                        sb.append('\\').append(ch);
+                    } else {
+                        sb.append(ch); // control characters raw
+                    }
+                }
+                sb.append('"');
+            } else if (f == JsonReadFeature.ALLOW_BACKSLASH_ESCAPING_ANY_CHARACTER && chance(tc, 60)) {
+                sb.append('"');
+                for (int i = 0; i < s.length(); i++) {
+                    char ch = s.charAt(i);
+                    if (ch == '"' || ch == '\\' || ch < 0x20) {
+                        sb.append(escaped(ch));
+                    } else if (!Character.isSurrogate(ch) && "ubfnrt/".indexOf(ch) < 0 && chance(tc, 30)) {
+                        sb.append('\\').append(ch);
+                    } else {
+                        sb.append(ch);
+                    }
+                }
+                sb.append('"');
+            } else {
+                Ref.quote(s, Ref.PLAIN, sb);
+            }
+        } else if (v instanceof List<?> l) {
+            sb.append('[');
+            for (int i = 0; i < l.size(); i++) {
+                if (i > 0) {
+                    sb.append(',');
+                }
+                text(tc, l.get(i), f, sb);
+            }
+            if (f == JsonReadFeature.ALLOW_TRAILING_COMMA && !l.isEmpty() && chance(tc, 60)) {
+                sb.append(',');
+            }
+            sb.append(']');
+        } else {
+            sb.append('{');
+            boolean first = true;
+            for (Map.Entry<String, Object> e : ((Map<String, Object>) v).entrySet()) {
+                if (!first) {
+                    sb.append(',');
+                }
+                first = false;
+                String k = e.getKey();
+                if (f == JsonReadFeature.ALLOW_UNQUOTED_PROPERTY_NAMES && !k.isEmpty() && k.matches("[A-Za-z_$][A-Za-z0-9_$]*") && chance(tc, 70)) {
+                    sb.append(k);
+                } else if (f == JsonReadFeature.ALLOW_SINGLE_QUOTES && chance(tc, 50)) {
+                    text(tc, k, f, sb);
+                } else {
+                    Ref.quote(k, Ref.PLAIN, sb);
+                }
+                sb.append(':');
+                text(tc, e.getValue(), f, sb);
+            }
+            if (f == JsonReadFeature.ALLOW_TRAILING_COMMA && !((Map<?, ?>) v).isEmpty() && chance(tc, 60)) {
+                sb.append(',');
+            }
+            sb.append('}');
+        }
+    }
+
+    static final JsonReadFeature[] LENIENT = {JsonReadFeature.ALLOW_JAVA_COMMENTS, JsonReadFeature.ALLOW_YAML_COMMENTS, JsonReadFeature.ALLOW_SINGLE_QUOTES,
+        JsonReadFeature.ALLOW_UNQUOTED_PROPERTY_NAMES, JsonReadFeature.ALLOW_UNESCAPED_CONTROL_CHARS, JsonReadFeature.ALLOW_BACKSLASH_ESCAPING_ANY_CHARACTER,
+        JsonReadFeature.ALLOW_LEADING_ZEROS_FOR_NUMBERS, JsonReadFeature.ALLOW_LEADING_PLUS_SIGN_FOR_NUMBERS, JsonReadFeature.ALLOW_LEADING_DECIMAL_POINT_FOR_NUMBERS,
+        JsonReadFeature.ALLOW_TRAILING_DECIMAL_POINT_FOR_NUMBERS, JsonReadFeature.ALLOW_TRAILING_COMMA};
+
+    /** True when a backslash precedes a non-ASCII character somewhere in the text. */
+    static boolean escapesNonAscii(String text) {
+        for (int i = 0; i + 1 < text.length(); i++) {
+            if (text.charAt(i) == '\\' && text.charAt(i + 1) > 0x7f) {
+                return true;
+            }
+            if (text.charAt(i) == '\\') {
+                i++;
+            }
+        }
+        return false;
+    }
+
+    static boolean numeric(JsonReadFeature f) {
+        return f == JsonReadFeature.ALLOW_LEADING_ZEROS_FOR_NUMBERS || f == JsonReadFeature.ALLOW_LEADING_PLUS_SIGN_FOR_NUMBERS
+                || f == JsonReadFeature.ALLOW_TRAILING_DECIMAL_POINT_FOR_NUMBERS || f == JsonReadFeature.ALLOW_LEADING_DECIMAL_POINT_FOR_NUMBERS;
+    }
+
+    @Test
+    void lenientFeaturesReadTheirSpellingsAsTheStrictValue() {
+        Hegel.test(tc -> {
+            Object v = Ref.gen(tc, 3);
+            JsonReadFeature feature = pick(tc, LENIENT);
+            String lenient = lenientText(tc, v, feature);
+            String strict = Ref.write(v, Ref.PLAIN);
+            if (lenient.equals(strict)) {
+                return;
+            }
+            Src src = src(tc);
+            if (src.bytes() && hasLoneSurrogate(lenient)) {
+                return;
+            }
+            if (src.bytes() && feature == JsonReadFeature.ALLOW_BACKSLASH_ESCAPING_ANY_CHARACTER && escapesNonAscii(lenient)) {
+                return; // jackson-core/9 and /10: the byte-based parsers mis-decode a backslash before a multi-byte character
+            }
+            if (src.bytes() && lenient.startsWith("\"\u0000")) {
+                return; // jackson-core/5: the byte parsers sniff a quote followed by NUL as UTF-16
+            }
+            Object want = Ref.parse(strict);
+            if (numeric(feature)) {
+                want = numbersByValue(want);
+            }
+            final Object expected = want;
+            // the feature reads the lenient text as the strict value
+            JsonFactory on = JsonFactory.builder().enable(feature).build();
+            List<Object> got = new ArrayList<>();
+            try (Tokens t = new Tokens(tc, on, src, lenient + " ", chunk(tc))) {
+                JsonToken tok;
+                while ((tok = t.next()) != null) {
+                    got.add(value(t, tok));
+                }
+                check(got.size() == 1 && Ref.same(numeric(feature) ? numbersByValue(got.get(0)) : got.get(0), expected, true),
+                        () -> feature + " " + src + ": " + show(lenient) + " read as " + Ref.show(got) + " expected " + Ref.show(expected));
+            } catch (JacksonException | IllegalStateException e) {
+                fail(feature + " " + src + ": rejects " + show(lenient) + ": " + e.getMessage());
+            }
+            // and the strict parser rejects the lenient text
+            if (src == Src.ASYNC && feature == JsonReadFeature.ALLOW_TRAILING_COMMA) {
+                return; // jackson-core/12: the non-blocking parser accepts an object's trailing comma split from its brace
+            }
+            JsonFactory off = new JsonFactory();
+            try (Tokens t = new Tokens(tc, off, src, lenient + " ", chunk(tc))) {
+                List<Object> read = new ArrayList<>();
+                JsonToken tok;
+                while ((tok = t.next()) != null) {
+                    read.add(value(t, tok));
+                }
+                fail(feature + " " + src + ": the strict parser accepts " + show(lenient) + " as " + Ref.show(read));
+            } catch (JacksonException | IllegalStateException e) {
+                // expected
+            }
+        }, Zoo.settings("lenientFeaturesReadTheirSpellingsAsTheStrictValue"));
+    }
+
+    /** Numbers replaced by their canonical value text, so lenient spellings compare equal. */
+    @SuppressWarnings("unchecked")
+    static Object numbersByValue(Object v) {
+        if (v instanceof Ref.Num num) {
+            return num.value() == null ? num : Ref.Num.of(num.value().stripTrailingZeros().toPlainString());
+        }
+        if (v instanceof List<?> l) {
+            List<Object> out = new ArrayList<>();
+            for (Object x : l) {
+                out.add(numbersByValue(x));
+            }
+            return out;
+        }
+        if (v instanceof Map<?, ?> m) {
+            Map<String, Object> out = new java.util.LinkedHashMap<>();
+            for (Map.Entry<String, Object> e : ((Map<String, Object>) m).entrySet()) {
+                out.put(e.getKey(), numbersByValue(e.getValue()));
+            }
+            return out;
+        }
+        return v;
+    }
+
+    // ------------------------------------------------------------------ pins
+
+    static final JsonFactory F = new JsonFactory();
+    static final ObjectReadContext CTX = ObjectReadContext.empty();
+
+    static JsonParser dataInput(String doc) {
+        return F.createParser(CTX, (java.io.DataInput) new DataInputStream(new ByteArrayInputStream(doc.getBytes(StandardCharsets.UTF_8))));
+    }
+
+    static String utf8Text(java.util.function.Consumer<JsonGenerator> body) {
+        ByteArrayOutputStream out = new ByteArrayOutputStream();
+        try (JsonGenerator g = F.createGenerator(ObjectWriteContext.empty(), out)) {
+            body.accept(g);
+        }
+        return out.toString(StandardCharsets.UTF_8);
+    }
+
+    /** jackson-core/1: a root-level literal or number at the very end of a DataInput fails with an EOF. */
+    @Test
+    void pinDataInputRootValueAtEndOfInput() {
+        try (JsonParser p = dataInput("true")) {
+            Assertions.assertEquals(JsonToken.VALUE_TRUE, p.nextToken());
+            Assertions.assertNull(p.nextToken());
+        }
+        try (JsonParser p = dataInput("15")) {
+            Assertions.assertEquals(JsonToken.VALUE_NUMBER_INT, p.nextToken());
+            Assertions.assertEquals(15, p.getIntValue());
+        }
+        try (JsonParser p = dataInput("")) {
+            Assertions.assertNull(p.nextToken());
+        }
+    }
+
+    /** jackson-core/2: getNumberValueExact() is exact only if no other accessor was called first. */
+    @Test
+    void pinNumberValueExactAfterNumberType() {
+        try (JsonParser p = F.createParser(CTX, "123456789.123456789")) {
+            p.nextToken();
+            Assertions.assertEquals(NumberType.DOUBLE, p.getNumberType());
+            Assertions.assertEquals(new BigDecimal("123456789.123456789"), p.getNumberValueExact());
+        }
+    }
+
+    /** jackson-core/3: the byte-based parsers reject a lone-surrogate escape in a property name; the UTF-8 generator writes one. */
+    @Test
+    void pinByteParsersReadLoneSurrogateEscapeInName() {
+        String text = utf8Text(g -> g.writeStartObject().writeName("a\udc00").writeNumber(1).writeEndObject());
+        Assertions.assertEquals("{\"a\\uDC00\":1}", text);
+        try (JsonParser p = F.createParser(CTX, text.getBytes(StandardCharsets.UTF_8))) {
+            Assertions.assertEquals(JsonToken.START_OBJECT, p.nextToken());
+            Assertions.assertEquals(JsonToken.PROPERTY_NAME, p.nextToken());
+            Assertions.assertEquals("a\udc00", p.currentName());
+        }
+    }
+
+    /** jackson-core/4: the non-blocking parser drops the sign of -0. */
+    @Test
+    void pinAsyncParserKeepsTheSignOfMinusZero() {
+        JsonParser p = F.createNonBlockingByteArrayParser(CTX);
+        byte[] doc = "[-0]".getBytes(StandardCharsets.UTF_8);
+        ((ByteArrayFeeder) p).feedInput(doc, 0, doc.length);
+        Assertions.assertEquals(JsonToken.START_ARRAY, p.nextToken());
+        Assertions.assertEquals(JsonToken.VALUE_NUMBER_INT, p.nextToken());
+        Assertions.assertEquals("-0", p.getString());
+    }
+
+    /** jackson-core/5: with unescaped control characters allowed, a document starting with a quote and NUL is sniffed as UTF-16. */
+    @Test
+    void pinUnescapedNulAtDocumentStart() {
+        JsonFactory lenient = JsonFactory.builder().enable(JsonReadFeature.ALLOW_UNESCAPED_CONTROL_CHARS).build();
+        byte[] doc = "\"\u0000a\"".getBytes(StandardCharsets.UTF_8);
+        try (JsonParser p = lenient.createParser(CTX, doc)) {
+            Assertions.assertEquals(JsonToken.VALUE_STRING, p.nextToken());
+            Assertions.assertEquals("\u0000a", p.getString());
+        }
+    }
+
+    /** jackson-core/6: a floating-point lexeme whose double is 2^63 passes the long range check and saturates. */
+    @Test
+    void pinLongValueSaturatesAtTwoToThe63() {
+        try (JsonParser p = F.createParser(CTX, "9223372036854775808.5")) {
+            p.nextToken();
+            Assertions.assertThrows(InputCoercionException.class, p::getLongValue);
+        }
+    }
+
+    /** jackson-core/7: writeString(Reader) splits a surrogate pair at its 4000-char read and writes both halves as escapes. */
+    @Test
+    void pinWriteStringFromReaderKeepsPairsTogether() {
+        String s = "a".repeat(3999) + "😀";
+        String text = utf8Text(g -> g.writeString(new StringReader(s), -1));
+        Assertions.assertEquals("\"" + s + "\"", text);
+    }
+
+    /** jackson-core/8: writeString(SerializableString) on the UTF-8 generator throws for an unpaired surrogate that writeString(String) escapes. */
+    @Test
+    void pinSerializedStringWithLoneSurrogate() {
+        Assertions.assertEquals("\"a\\uD800b\"", utf8Text(g -> g.writeString("a\ud800b")));
+        Assertions.assertEquals("\"a\\uD800b\"", utf8Text(g -> g.writeString(new SerializedString("a\ud800b"))));
+    }
+
+    /** jackson-core/9: with any character escapable, the byte parsers truncate an escaped 4-byte character to one char. */
+    @Test
+    void pinByteParsersEscapedFourByteCharacter() {
+        JsonFactory lenient = JsonFactory.builder().enable(JsonReadFeature.ALLOW_BACKSLASH_ESCAPING_ANY_CHARACTER).build();
+        byte[] doc = "\"\\😀\"".getBytes(StandardCharsets.UTF_8);
+        try (JsonParser p = lenient.createParser(CTX, doc)) {
+            Assertions.assertEquals(JsonToken.VALUE_STRING, p.nextToken());
+            Assertions.assertEquals("😀", p.getString());
+        }
+    }
+
+    /** jackson-core/10: with any character escapable, the non-blocking parser fails on an escaped multi-byte character. */
+    @Test
+    void pinAsyncParserEscapedMultiByteCharacter() {
+        JsonFactory lenient = JsonFactory.builder().enable(JsonReadFeature.ALLOW_BACKSLASH_ESCAPING_ANY_CHARACTER).build();
+        JsonParser p = lenient.createNonBlockingByteArrayParser(CTX);
+        byte[] doc = "\"\\é\"".getBytes(StandardCharsets.UTF_8);
+        ((ByteArrayFeeder) p).feedInput(doc, 0, doc.length);
+        Assertions.assertEquals(JsonToken.VALUE_STRING, p.nextToken());
+        Assertions.assertEquals("é", p.getString());
+    }
+
+    /** jackson-core/12: the non-blocking parser accepts a trailing comma in an object when the brace arrives in a later feed. */
+    @Test
+    void pinAsyncParserRejectsTrailingCommaAcrossFeeds() {
+        JsonParser p = F.createNonBlockingByteArrayParser(CTX);
+        ByteArrayFeeder feeder = (ByteArrayFeeder) p;
+        byte[] doc = "{\"a\":1,}".getBytes(StandardCharsets.UTF_8);
+        Assertions.assertThrows(JacksonException.class, () -> {
+            int fed = 0;
+            while (true) {
+                JsonToken t = p.nextToken();
+                if (t == JsonToken.NOT_AVAILABLE) {
+                    if (fed >= doc.length) {
+                        feeder.endOfInput();
+                    } else {
+                        feeder.feedInput(doc, fed, fed + 1);
+                        fed++;
+                    }
+                } else if (t == null) {
+                    return;
+                }
+            }
+        });
+    }
+
+    /** jackson-core/11: an escaped surrogate pair in a name split between feeds: NOT_AVAILABLE although needMoreInput() is false. */
+    @Test
+    void pinAsyncParserSurrogateEscapeSplitInName() {
+        JsonParser p = F.createNonBlockingByteArrayParser(CTX);
+        ByteArrayFeeder feeder = (ByteArrayFeeder) p;
+        byte[] doc = "{\"\\uD83D\\uDE00\":1}".getBytes(StandardCharsets.UTF_8);
+        feeder.feedInput(doc, 0, 9); // up to and including the high surrogate's escape
+        Assertions.assertEquals(JsonToken.START_OBJECT, p.nextToken());
+        JsonToken t = p.nextToken();
+        Assertions.assertTrue(t != JsonToken.NOT_AVAILABLE || feeder.needMoreInput(), "NOT_AVAILABLE although needMoreInput() is false");
+        feeder.feedInput(doc, 9, doc.length);
+        Assertions.assertEquals(JsonToken.PROPERTY_NAME, p.nextToken());
+        Assertions.assertEquals("😀", p.currentName());
+    }
+}
