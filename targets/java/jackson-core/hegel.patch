+package zoo;
+
+import static dev.hegel.Generators.booleans;
+import static dev.hegel.Generators.tuples;
+import static zoo.Gen.INDEX;
+import static zoo.Gen.chance;
+import static zoo.Gen.many;
+import static zoo.Gen.maybe;
+import static zoo.Gen.opt;
+import static zoo.Gen.pick;
+import static zoo.Gen.tape;
+import static zoo.Gen.v;
+import static zoo.Gen.w;
+import static zoo.Gen.weighted;
+import static zoo.Gen.word;
+
+import dev.hegel.Generator;
+import dev.hegel.Tuple2;
+import java.math.BigDecimal;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Hegel zoo: a reference for RFC 8259 JSON on plain Java values, written from the grammar and
+ * independent of jackson-core. Values are {@link Map} (LinkedHashMap, insertion order), {@link List},
+ * {@link String}, {@link Num} (the lexeme and its exact value), {@link Boolean} and {@link #NULL}.
+ * Also the generators: random trees, spellings (whitespace and escape choices as tapes rendered by a
+ * pure function) and edits that make a text (almost always) invalid.
+ */
+final class Ref {
+    private Ref() {}
+
+    /** JSON null (Java null means "absent"). */
+    static final Object NULL = new Object() {
+        @Override
+        public String toString() {
+            return "null";
+        }
+    };
+
+    /**
+     * A JSON number: the lexeme as written and its exact value; equal by value. A lexeme the
+     * grammar accepts but BigDecimal cannot hold (an exponent beyond the int range) has a null
+     * value and is equal by text only.
+     */
+    record Num(String text, BigDecimal value) {
+        static Num of(String text) {
+            try {
+                return new Num(text, new BigDecimal(text));
+            } catch (NumberFormatException e) {
+                return new Num(text, null);
+            }
+        }
+
+        @Override
+        public boolean equals(Object o) {
+            if (!(o instanceof Num n)) {
+                return false;
+            }
+            if (value == null || n.value == null) {
+                return text.equals(n.text);
+            }
+            return value.compareTo(n.value) == 0;
+        }
+
+        @Override
+        public int hashCode() {
+            return value == null ? text.hashCode() : value.signum() == 0 ? 0 : value.stripTrailingZeros().hashCode();
+        }
+
+        @Override
+        public String toString() {
+            return text;
+        }
+    }
+
+    /** Invalid JSON, with the offset of the offending character. */
+    static final class Bad extends RuntimeException {
+        final int at;
+
+        Bad(String msg, int at) {
+            super(msg + " at " + at);
+            this.at = at;
+        }
+    }
+
+    // ------------------------------------------------------------------ parser
+
+    /** Parse a whole text: one value with optional whitespace (space, tab, LF, CR) around it. */
+    static Object parse(String s) {
+        Parser p = new Parser(s);
+        p.ws();
+        Object v = p.value();
+        p.ws();
+        if (p.i != s.length()) {
+            throw p.bad("trailing content");
+        }
+        return v;
+    }
+
+    private static final class Parser {
+        final String s;
+        int i;
+
+        Parser(String s) {
+            this.s = s;
+        }
+
+        Bad bad(String msg) {
+            return new Bad(msg, i);
+        }
+
+        void ws() {
+            while (i < s.length()) {
+                char c = s.charAt(i);
+                if (c == ' ' || c == '\t' || c == '\n' || c == '\r') {
+                    i++;
+                } else {
+                    break;
+                }
+            }
+        }
+
+        char peek() {
+            if (i >= s.length()) {
+                throw bad("unexpected end");
+            }
+            return s.charAt(i);
+        }
+
+        void expect(char c) {
+            if (peek() != c) {
+                throw bad("expected '" + c + "'");
+            }
+            i++;
+        }
+
+        Object value() {
+            char c = peek();
+            switch (c) {
+                case '{':
+                    return object();
+                case '[':
+                    return array();
+                case '"':
+                    return string();
+                case 't':
+                    literal("true");
+                    return Boolean.TRUE;
+                case 'f':
+                    literal("false");
+                    return Boolean.FALSE;
+                case 'n':
+                    literal("null");
+                    return NULL;
+                default:
+                    if (c == '-' || (c >= '0' && c <= '9')) {
+                        return number();
+                    }
+                    throw bad("unexpected character");
+            }
+        }
+
+        void literal(String word) {
+            if (!s.startsWith(word, i)) {
+                throw bad("bad literal");
+            }
+            i += word.length();
+        }
+
+        Num number() {
+            int start = i;
+            if (peek() == '-') {
+                i++;
+            }
+            char c = peek();
+            if (c == '0') {
+                i++;
+            } else if (c >= '1' && c <= '9') {
+                digits();
+            } else {
+                throw bad("bad number");
+            }
+            if (i < s.length() && s.charAt(i) == '.') {
+                i++;
+                if (i >= s.length() || !isDigit(s.charAt(i))) {
+                    throw bad("bad fraction");
+                }
+                digits();
+            }
+            if (i < s.length() && (s.charAt(i) == 'e' || s.charAt(i) == 'E')) {
+                i++;
+                if (i < s.length() && (s.charAt(i) == '+' || s.charAt(i) == '-')) {
+                    i++;
+                }
+                if (i >= s.length() || !isDigit(s.charAt(i))) {
+                    throw bad("bad exponent");
+                }
+                digits();
+            }
+            return Num.of(s.substring(start, i));
+        }
+
+        void digits() {
+            while (i < s.length() && isDigit(s.charAt(i))) {
+                i++;
+            }
+        }
+
+        String string() {
+            expect('"');
+            StringBuilder sb = new StringBuilder();
+            while (true) {
+                char c = peek();
+                if (c == '"') {
+                    i++;
+                    return sb.toString();
+                }
+                if (c < 0x20) {
+                    throw bad("control character in string");
+                }
+                if (c == '\\') {
+                    i++;
+                    char e = peek();
+                    i++;
+                    switch (e) {
+                        case '"':
+                            sb.append('"');
+                            break;
+                        case '\\':
+                            sb.append('\\');
+                            break;
+                        case '/':
+                            sb.append('/');
+                            break;
+                        case 'b':
+                            sb.append('\b');
+                            break;
+                        case 'f':
+                            sb.append('\f');
+                            break;
+                        case 'n':
+                            sb.append('\n');
+                            break;
+                        case 'r':
+                            sb.append('\r');
+                            break;
+                        case 't':
+                            sb.append('\t');
+                            break;
+                        case 'u':
+                            if (i + 4 > s.length()) {
+                                throw bad("short \\u escape");
+                            }
+                            int v = 0;
+                            for (int k = 0; k < 4; k++) {
+                                int d = Character.digit(s.charAt(i + k), 16);
+                                if (d < 0) {
+                                    throw bad("bad \\u escape");
+                                }
+                                v = v * 16 + d;
+                            }
+                            i += 4;
+                            sb.append((char) v);
+                            break;
+                        default:
+                            i--;
+                            throw bad("bad escape");
+                    }
+                } else {
+                    sb.append(c);
+                    i++;
+                }
+            }
+        }
+
+        List<Object> array() {
+            expect('[');
+            List<Object> out = new ArrayList<>();
+            ws();
+            if (peek() == ']') {
+                i++;
+                return out;
+            }
+            while (true) {
+                ws();
+                out.add(value());
+                ws();
+                char c = peek();
+                i++;
+                if (c == ']') {
+                    return out;
+                }
+                if (c != ',') {
+                    i--;
+                    throw bad("expected ',' or ']'");
+                }
+            }
+        }
+
+        Map<String, Object> object() {
+            expect('{');
+            Map<String, Object> out = new LinkedHashMap<>();
+            ws();
+            if (peek() == '}') {
+                i++;
+                return out;
+            }
+            while (true) {
+                ws();
+                if (peek() != '"') {
+                    throw bad("expected a name");
+                }
+                String name = string();
+                ws();
+                expect(':');
+                ws();
+                out.put(name, value()); // a repeated name: the last value wins (RFC 8259 leaves it open)
+                ws();
+                char c = peek();
+                i++;
+                if (c == '}') {
+                    return out;
+                }
+                if (c != ',') {
+                    i--;
+                    throw bad("expected ',' or '}'");
+                }
+            }
+        }
+    }
+
+    /**
+     * jackson-core's root model: several root values in one text, separated by whitespace, where
+     * a number must be followed by whitespace (space, tab, CR, LF) or the end, a literal must not
+     * be followed by a Java identifier character, and strings and containers need no separator.
+     */
+    static List<Object> parseRoots(String s) {
+        Parser p = new Parser(s);
+        List<Object> out = new ArrayList<>();
+        p.ws();
+        while (p.i < s.length()) {
+            char first = s.charAt(p.i);
+            Object v = p.value();
+            if (p.i < s.length()) {
+                char next = s.charAt(p.i);
+                if (v instanceof Num && !(next == ' ' || next == '\t' || next == '\r' || next == '\n')) {
+                    throw p.bad("expected space separating root-level values");
+                }
+                if ((first == 't' || first == 'f' || first == 'n') && Character.isJavaIdentifierPart(next)) {
+                    throw p.bad("unrecognized token");
+                }
+            }
+            out.add(v);
+            p.ws();
+        }
+        return out;
+    }
+
+    private static boolean isDigit(char c) {
+        return c >= '0' && c <= '9';
+    }
+
+    // ------------------------------------------------------------------ writer
+
+    /**
+     * How jackson-core escapes strings: the JSON minimum always; {@code slash} adds {@code \/}
+     * (JsonWriteFeature.ESCAPE_FORWARD_SLASHES), {@code nonAscii} escapes every char above 0x7F as
+     * a backslash-u escape, one per UTF-16 char (ESCAPE_NON_ASCII), {@code upperHex} is the hex
+     * digit case (WRITE_HEX_UPPER_CASE, on by default), {@code loneSurrogates} escapes an unpaired
+     * surrogate (what the UTF-8 generator does; the Writer-based one passes it through).
+     */
+    record Escaping(boolean slash, boolean nonAscii, boolean upperHex, boolean loneSurrogates) {}
+
+    static final Escaping PLAIN = new Escaping(false, false, true, false);
+
+    /** Compact text: no whitespace, numbers as their lexemes, strings per {@code esc}. */
+    static String write(Object v, Escaping esc) {
+        StringBuilder sb = new StringBuilder();
+        write(v, esc, sb);
+        return sb.toString();
+    }
+
+    @SuppressWarnings("unchecked")
+    private static void write(Object v, Escaping esc, StringBuilder sb) {
+        if (v == NULL || v == null) {
+            sb.append("null");
+        } else if (v instanceof Boolean || v instanceof Num) {
+            sb.append(v);
+        } else if (v instanceof String s) {
+            quote(s, esc, sb);
+        } else if (v instanceof List<?> l) {
+            sb.append('[');
+            boolean first = true;
+            for (Object e : l) {
+                if (!first) {
+                    sb.append(',');
+                }
+                first = false;
+                write(e, esc, sb);
+            }
+            sb.append(']');
+        } else if (v instanceof Map<?, ?> m) {
+            sb.append('{');
+            boolean first = true;
+            for (Map.Entry<String, Object> e : ((Map<String, Object>) m).entrySet()) {
+                if (!first) {
+                    sb.append(',');
+                }
+                first = false;
+                quote(e.getKey(), esc, sb);
+                sb.append(':');
+                write(e.getValue(), esc, sb);
+            }
+            sb.append('}');
+        } else {
+            throw new IllegalArgumentException("not a JSON value: " + v.getClass());
+        }
+    }
+
+    static String quote(String s, Escaping esc) {
+        StringBuilder sb = new StringBuilder();
+        quote(s, esc, sb);
+        return sb.toString();
+    }
+
+    /**
+     * jackson-core's escaping table: {@code "} and {@code \} escaped, the control characters as
+     * {@code \b \f \n \r \t} or backslash-u00XX (0x7F, U+2028 and U+2029 are not escaped), plus
+     * the options of {@link Escaping}.
+     */
+    static void quote(String s, Escaping esc, StringBuilder sb) {
+        sb.append('"');
+        for (int i = 0; i < s.length(); i++) {
+            char c = s.charAt(i);
+            switch (c) {
+                case '"' -> sb.append("\\\"");
+                case '\\' -> sb.append("\\\\");
+                case '\b' -> sb.append("\\b");
+                case '\f' -> sb.append("\\f");
+                case '\n' -> sb.append("\\n");
+                case '\r' -> sb.append("\\r");
+                case '\t' -> sb.append("\\t");
+                case '/' -> sb.append(esc.slash() ? "\\/" : "/");
+                default -> {
+                    boolean surrogate = Character.isSurrogate(c);
+                    boolean lone = surrogate && !(Character.isHighSurrogate(c) && i + 1 < s.length() && Character.isLowSurrogate(s.charAt(i + 1))
+                            || Character.isLowSurrogate(c) && i > 0 && Character.isHighSurrogate(s.charAt(i - 1)));
+                    if (c < 0x20 || (esc.nonAscii() && c > 0x7f) || (esc.loneSurrogates() && lone)) {
+                        sb.append(String.format(esc.upperHex() ? "\\u%04X" : "\\u%04x", (int) c));
+                    } else {
+                        sb.append(c);
+                    }
+                }
+            }
+        }
+        sb.append('"');
+    }
+
+    /** Deep equality; maps compared in order when {@code ordered}, as sets of entries otherwise. */
+    @SuppressWarnings("unchecked")
+    static boolean same(Object a, Object b, boolean ordered) {
+        if (a == NULL || b == NULL || a == null || b == null) {
+            return (a == NULL || a == null) && (b == NULL || b == null);
+        }
+        if (a instanceof List<?> la && b instanceof List<?> lb) {
+            if (la.size() != lb.size()) {
+                return false;
+            }
+            for (int i = 0; i < la.size(); i++) {
+                if (!same(la.get(i), lb.get(i), ordered)) {
+                    return false;
+                }
+            }
+            return true;
+        }
+        if (a instanceof Map<?, ?> ma && b instanceof Map<?, ?> mb) {
+            if (ma.size() != mb.size()) {
+                return false;
+            }
+            if (ordered) {
+                var ia = ((Map<String, Object>) ma).entrySet().iterator();
+                var ib = ((Map<String, Object>) mb).entrySet().iterator();
+                while (ia.hasNext()) {
+                    var ea = ia.next();
+                    var eb = ib.next();
+                    if (!ea.getKey().equals(eb.getKey()) || !same(ea.getValue(), eb.getValue(), true)) {
+                        return false;
+                    }
+                }
+                return true;
+            }
+            for (Map.Entry<String, Object> e : ((Map<String, Object>) ma).entrySet()) {
+                if (!mb.containsKey(e.getKey()) || !same(e.getValue(), mb.get(e.getKey()), false)) {
+                    return false;
+                }
+            }
+            return true;
+        }
+        if (a instanceof List || a instanceof Map || b instanceof List || b instanceof Map) {
+            return false;
+        }
+        return a.equals(b);
+    }
+
+    static String show(Object v) {
+        return write(v, PLAIN);
+    }
+
+
+    // ------------------------------------------------------------------ generators
+
+    static final String[] KEYS = {
+        "", "a", "b", "c", "key", "1", "0", "-1", "a b", "é", "null", "true", "__proto__", "constructor",
+        "with\"quote", "back\\slash", "new\nline", "tab\t", "日本", "<b>&'=", "😀", "A", "aa",
+    };
+
+    static final String[] NUMBERS = {
+        "0", "-0", "1", "-1", "7", "10", "42", "255", "256", "65535", "2147483647", "2147483648", "-2147483648",
+        "-2147483649", "4294967295", "9007199254740992", "9007199254740993", "9223372036854775807",
+        "9223372036854775808", "-9223372036854775808", "-9223372036854775809", "18446744073709551616",
+        "123456789012345678901234567890", "0.0", "-0.0", "1.0", "1.5", "0.1", "0.2", "0.30000000000000004",
+        "2.5", "-2.5", "3.14159", "1e2", "1E2", "1e+2", "1e-2", "1.5e3", "1E-7", "1e22", "1e23", "1e308",
+        "1.7976931348623157e308", "1e309", "1e400", "1e-400", "4.9e-324", "2.2250738585072014E-308",
+        "123456789.123456789", "0.000001", "1e-6", "100000000000000000000", "1E+2", "0e0", "0E-5",
+        "9007199254740993.0", "1.00000000000000011102230246251565404236316680908203125",
+    };
+
+    static final String STRING_ALPHABET =
+            "ab1 _/\"\\\n\t\r\b\f\u0001\u001f\u007fé日<>&='\u2028\u2029\u00a0\ufeff\u0000";
+
+    static final String DIGITS = "0123456789";
+
+    /** Surrogates: pairs, and the lone ones a Java string can hold but UTF-8 bytes cannot carry. */
+    static final Generator<String> SURROGATES = pick("😀", "a😀b", "\ud800", "\udc00", "x\ud83dy", "😀😀");
+
+    static final Generator<String> PAIRED_SURROGATES = pick("\ud83d\ude00", "a\ud83d\ude00b", "\ud83d\ude00\ud83d\ude00");
+
+    /** A random string: mostly short words over the alphabet of the characters JSON cares about, some keys, some surrogates. */
+    static Generator<String> string(boolean lone) {
+        return weighted(w(75, word(STRING_ALPHABET, 0, 8)), w(15, pick(KEYS)), w(10, lone ? SURROGATES : PAIRED_SURROGATES));
+    }
+
+    static final Generator<String> STRING = string(true);
+
+    /** A random integer lexeme: an optional sign, then 0 or a digit run without a leading zero. */
+    static final Generator<String> INTEGER_LEXEME = tuples(chance(30),
+            weighted(v(20, "0"), w(80, tuples(word("123456789", 1, 1), word(DIGITS, 0, 18)).map(t -> t.value1() + t.value2()))))
+            .map(t -> (t.value1() ? "-" : "") + t.value2());
+
+    static final Generator<String> EXPONENT = tuples(pick("e", "E"), pick("", "+", "-"), word(DIGITS, 1, 3))
+            .map(t -> t.value1() + t.value2() + t.value3());
+
+    /** A random number lexeme from the grammar: an integer, an optional fraction, an optional exponent. */
+    static final Generator<String> RANDOM_NUMBER = tuples(INTEGER_LEXEME, opt(40, word(DIGITS, 1, 12).map(d -> "." + d)), opt(30, EXPONENT))
+            .map(t -> t.value1() + t.value2() + t.value3());
+
+    static final Generator<String> NUMBER = weighted(w(70, pick(NUMBERS)), w(30, RANDOM_NUMBER));
+
+    /** A scalar: null, a boolean, a number, a string (the plainest first). */
+    static Generator<Object> scalar(boolean lone) {
+        return Gen.<Object>weighted(v(8, NULL), w(7, booleans()), w(20, NUMBER.map(Num::of)), w(20, string(lone)));
+    }
+
+    /** A random JSON value; containers up to {@code depth} deep with 0..5 children; {@code lone} allows lone surrogates in strings. */
+    static Generator<Object> value(int depth, boolean lone) {
+        Generator<Object> scalar = scalar(lone);
+        if (depth == 0) {
+            return scalar;
+        }
+        Generator<Object> inner = value(depth - 1, lone);
+        Generator<Object> list = many(inner, 0, 5).map(l -> (Object) new ArrayList<>(l));
+        Generator<Object> map = many(tuples(string(lone), inner), 0, 5).map(Ref::toMap);
+        return Gen.<Object>weighted(w(55, scalar), w(20, list), w(25, map));
+    }
+
+    static final Generator<Object> VALUE = value(4, true);
+
+    static Object toMap(List<Tuple2<String, Object>> entries) {
+        Map<String, Object> out = new LinkedHashMap<>();
+        for (Tuple2<String, Object> e : entries) {
+            out.put(e.value1(), e.value2());
+        }
+        return out;
+    }
+
+    // ------------------------------------------------------------------ texts
+
+    /** The escape choice for one character of a string: escape it although it need not be, and take the alternative spelling. */
+    record Esc(boolean any, boolean alt) {}
+
+    static final Esc PLAIN_ESC = new Esc(false, false);
+
+    static final Generator<Esc> ESC = tuples(chance(10), chance(50)).map(t -> new Esc(t.value1(), t.value2()));
+
+    /** The whitespace at one gap between tokens: mostly none. */
+    static final Generator<String> GAP = weighted(v(70, ""), w(30, pick(" ", "  ", "\t", "\n", "\r\n", " \n\t ")));
+
+    /**
+     * How a value is spelled as valid text: a tape of whitespace for the gaps around tokens and a tape of
+     * escape choices for the characters of strings, both read cyclically; empty tapes give the compact text.
+     */
+    record Spelling(List<String> gaps, List<Esc> escapes) {
+        String text(Object v) {
+            StringBuilder sb = new StringBuilder();
+            write(v, sb, new int[2]);
+            return sb.toString();
+        }
+
+        private void gap(StringBuilder sb, int[] at) {
+            sb.append(tape(gaps, at[0]++, ""));
+        }
+
+        @SuppressWarnings("unchecked")
+        private void write(Object v, StringBuilder sb, int[] at) {
+            gap(sb, at);
+            if (v == NULL) {
+                sb.append("null");
+            } else if (v instanceof Boolean || v instanceof Num) {
+                sb.append(v);
+            } else if (v instanceof String s) {
+                quote(s, sb, at);
+            } else if (v instanceof List<?> l) {
+                sb.append('[');
+                boolean first = true;
+                for (Object e : l) {
+                    if (!first) {
+                        gap(sb, at);
+                        sb.append(',');
+                    }
+                    first = false;
+                    write(e, sb, at);
+                }
+                gap(sb, at);
+                sb.append(']');
+            } else {
+                sb.append('{');
+                boolean first = true;
+                for (Map.Entry<String, Object> e : ((Map<String, Object>) v).entrySet()) {
+                    if (!first) {
+                        gap(sb, at);
+                        sb.append(',');
+                    }
+                    first = false;
+                    gap(sb, at);
+                    quote(e.getKey(), sb, at);
+                    gap(sb, at);
+                    sb.append(':');
+                    write(e.getValue(), sb, at);
+                }
+                gap(sb, at);
+                sb.append('}');
+            }
+            gap(sb, at);
+        }
+
+        /** A valid quoting: the required escapes, plus backslash-u escapes for any character and escaped slashes where the tape says so. */
+        private void quote(String s, StringBuilder sb, int[] at) {
+            sb.append('"');
+            for (int i = 0; i < s.length(); i++) {
+                char c = s.charAt(i);
+                Esc e = tape(escapes, at[1]++, PLAIN_ESC);
+                boolean must = c == '"' || c == '\\' || c < 0x20;
+                if (must || e.any()) {
+                    switch (c) {
+                        case '"' -> sb.append(e.alt() ? "\\u0022" : "\\\"");
+                        case '\\' -> sb.append(e.alt() ? "\\u005c" : "\\\\");
+                        case '/' -> sb.append(e.alt() ? "\\u002f" : "\\/");
+                        case '\n' -> sb.append(e.alt() ? "\\u000a" : "\\n");
+                        case '\t' -> sb.append(e.alt() ? "\\u0009" : "\\t");
+                        case '\r' -> sb.append("\\r");
+                        case '\b' -> sb.append("\\b");
+                        case '\f' -> sb.append("\\f");
+                        default -> sb.append(String.format(e.alt() ? "\\u%04X" : "\\u%04x", (int) c));
+                    }
+                } else {
+                    sb.append(c);
+                }
+            }
+            sb.append('"');
+        }
+    }
+
+    static final Generator<Spelling> SPELLING = tuples(maybe(60, List.<String>of(), many(GAP, 1, 12)), maybe(60, List.<Esc>of(), many(ESC, 1, 16)))
+            .map(t -> new Spelling(t.value1(), t.value2()));
+
+    static final String[] JUNK = {
+        ",", "]", "}", "{", "[", ":", "\"", "'", "//c\n", "/*c*/", "#x\n", "NaN", "Infinity", "-Infinity", "01", "+1",
+        ".5", "1.", "1e", "1e+", "0x1F", "TRUE", "True", "nul", "None", "undefined", ";", "=", "=>", "\\x41", "\\u12",
+        "\\U0041", "\\'", "\\a", "\\0", "\u0001", "\u0000", "\u007f", "\f", "\u00a0", "\u2028", "\ufeff", "-", "--1",
+        "1 2", "a", "[,]", "{,}", "[1,]", "{\"a\":1,}", "{\"a\"}", "{\"a\":}", "{1:2}", "{a:1}", "[1 2]", "\"\n\"",
+        "\"\t\"", "\"\\", "true false", "é", "1_000", "1,000",
+    };
+
+    /** An edit of a text that (nearly always) breaks it; positions are taken modulo the live length. */
+    sealed interface Edit permits Insert, Delete, Truncate, Replace {
+        String apply(String text);
+    }
+
+    record Insert(int at, String junk) implements Edit {
+        @Override
+        public String apply(String text) {
+            int i = Math.floorMod(at, text.length() + 1);
+            return text.substring(0, i) + junk + text.substring(i);
+        }
+    }
+
+    record Delete(int at) implements Edit {
+        @Override
+        public String apply(String text) {
+            if (text.isEmpty()) {
+                return text;
+            }
+            int i = Math.floorMod(at, text.length());
+            return text.substring(0, i) + text.substring(i + 1);
+        }
+    }
+
+    record Truncate(int at) implements Edit {
+        @Override
+        public String apply(String text) {
+            return text.isEmpty() ? text : text.substring(0, Math.floorMod(at, text.length()));
+        }
+    }
+
+    record Replace(int at, String with) implements Edit {
+        @Override
+        public String apply(String text) {
+            if (text.isEmpty()) {
+                return text;
+            }
+            int i = Math.floorMod(at, text.length());
+            return text.substring(0, i) + with + text.substring(i + 1);
+        }
+    }
+
+    static final Generator<Edit> EDIT = Gen.<Edit>weighted(
+            w(55, tuples(INDEX, pick(JUNK)).map(t -> new Insert(t.value1(), t.value2()))),
+            w(20, INDEX.map(Delete::new)),
+            w(15, INDEX.map(Truncate::new)),
+            w(10, tuples(INDEX, pick("a", "1", "\"", "\\", ",", " ", "\u0000", "\u00a0")).map(t -> new Replace(t.value1(), t.value2()))));
+
+    /** The text after the edits, applied in order. */
+    static String mutate(String text, List<Edit> edits) {
+        for (Edit e : edits) {
+            text = e.apply(text);
+        }
+        return text;
+    }
+}
