+        });
+    }
+
+    // ------------------------------------------------------------------ jackson-core/13
+
+    static final Generator<String> CONTROL = pick("\u0001", "\u0000", "\u0002", "\u0008", "\u000b", "\u000c", "\u000e", "\u001f");
+
+    /** A control character before the first root value or between two, for the DataInput parser; the neighbour is the byte-array parser. */
+    record ControlBetween(String control, boolean between, Object first, Object second, Ref.Spelling spelling) {
+        String doc() {
+            String a = spelling.text(first);
+            String b = spelling.text(second);
+            return (between ? a + " " + control + " " + b : control + " " + a) + " ";
+        }
+    }
+
+    static final Generator<ControlBetween> CONTROL_BETWEEN = tuples(CONTROL, chance(50), Ref.value(2, false), Ref.value(2, false), Ref.SPELLING)
+            .map(t -> new ControlBetween(t.value1(), t.value2(), t.value3(), t.value4(), t.value5()));
+
+    @Test
+    void dataInputParserRejectsControlCharactersBetweenTokens() {
+        Zoo.run("jackson-core.dataInputParserRejectsControlCharactersBetweenTokens", tc -> {
