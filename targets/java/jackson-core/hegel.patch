+ * ({@link Ref}) and the models its Javadoc documents (escaping table, number coercions,
+ * root-value separation, JsonPointer, DefaultPrettyPrinter layout, Base64 variants).
+ *
+ * <p>Every case is drawn as one record (a value tree, how it is spelled or written, the parser
+ * source and how it is fed) rendered by pure functions. The shapes of the recorded bugs are drawn
+ * by default and make the wide properties fail; {@code HEGEL_NO_KNOWN=1} switches them off.
+ */
+class JacksonCoreTest {
+
+    // ------------------------------------------------------------------ parsers of every kind
+
+    /** The input paths a text can take into a parser. */
+    enum Src {
+        STRING, CHARS, READER, READER_THROTTLED, BYTES, STREAM, STREAM_THROTTLED, DATA_INPUT, ASYNC;
+
+        boolean bytes() {
+            return this != STRING && this != CHARS && this != READER && this != READER_THROTTLED;
+        }
+    }
+
+    static final Generator<Src> SRC = pick(Src.values());
+
+    /** The byte sources other than the non-blocking parser. */
+    static final Generator<Src> BLOCKING_BYTES = pick(Src.BYTES, Src.STREAM, Src.STREAM_THROTTLED, Src.DATA_INPUT);
+
+    /**
+     * How the throttled and non-blocking sources are fed: at most {@code chunk} units per read; the
+     * non-blocking parser's feeds end at drawn cut positions, taken modulo what is left (an empty
+     * tape feeds whole chunks).
+     */
+    record Feed(int chunk, List<Integer> cuts) {
+        /** The size of feed {@code k} when {@code remaining} bytes are left: 1..min(chunk, remaining). */
+        int size(int k, int remaining) {
+            int cap = Math.min(chunk, remaining);
+            return cuts.isEmpty() ? cap : 1 + Math.floorMod(at(cuts, k), cap);
+        }
+    }
+
+    static final Generator<Integer> CHUNK = pick(1, 2, 3, 5, 7, 16, 64, 1000, 4096);
+
+    static final Generator<Feed> FEED = tuples(CHUNK, many(INDEX, 0, 8)).map(t -> new Feed(t.value1(), t.value2()));
+
+    /** Feeds of a few bytes, so that a split lands inside most tokens. */
+    static final Generator<Feed> SMALL_FEED = tuples(pick(1, 2, 3), many(INDEX, 0, 8)).map(t -> new Feed(t.value1(), t.value2()));
+
+    /** A Reader handing out at most {@code max} chars per read. */
+    static final class ThrottledReader extends Reader {
+        private final Reader in;
+        private final int max;
+
+        ThrottledReader(Reader in, int max) {
+            this.in = in;
+            this.max = max;
+        }
+
+        @Override
+        public int read(char[] cbuf, int off, int len) throws IOException {
+            return in.read(cbuf, off, Math.min(len, max));
+        }
+
+        @Override
+        public void close() throws IOException {
+            in.close();
+        }
+    }
+
+    /** An InputStream handing out at most {@code max} bytes per read. */
+    static final class ThrottledStream extends InputStream {
+        private final InputStream in;
+        private final int max;
+
+        ThrottledStream(InputStream in, int max) {
+            this.in = in;
+            this.max = max;
+        }
+
+        @Override
+        public int read() throws IOException {
+            return in.read();
+        }
+
+        @Override
+        public int read(byte[] b, int off, int len) throws IOException {
+            return in.read(b, off, Math.min(len, max));
+        }
+    }
+
+    /** A parser over a text, feeding the non-blocking one at the drawn cuts so NOT_AVAILABLE is hidden. */
+    static final class Tokens implements AutoCloseable {
+        final JsonParser p;
+        final Src src;
+        private final byte[] async;
+        private final Feed feed;
+        private int fed;
+        private int feeds;
+        private boolean ended;
+
+        Tokens(JsonFactory f, Src src, String text, Feed feed) {
+            this.src = src;
+            this.feed = feed;
+            ObjectReadContext ctx = ObjectReadContext.empty();
+            byte[] bytes = src.bytes() ? text.getBytes(StandardCharsets.UTF_8) : null;
+            switch (src) {
+                case STRING -> {
+                    p = f.createParser(ctx, text);
+                    async = null;
+                }
+                case CHARS -> {
+                    p = f.createParser(ctx, text.toCharArray());
+                    async = null;
+                }
+                case READER -> {
+                    p = f.createParser(ctx, new StringReader(text));
+                    async = null;
+                }
+                case READER_THROTTLED -> {
+                    p = f.createParser(ctx, new ThrottledReader(new StringReader(text), feed.chunk()));
+                    async = null;
+                }
+                case BYTES -> {
+                    p = f.createParser(ctx, bytes);
+                    async = null;
+                }
+                case STREAM -> {
+                    p = f.createParser(ctx, new ByteArrayInputStream(bytes));
+                    async = null;
+                }
+                case STREAM_THROTTLED -> {
+                    p = f.createParser(ctx, new ThrottledStream(new ByteArrayInputStream(bytes), feed.chunk()));
+                    async = null;
+                }
+                case DATA_INPUT -> {
+                    p = f.createParser(ctx, (java.io.DataInput) new DataInputStream(new ByteArrayInputStream(bytes)));
+                    async = null;
+                }
+                case ASYNC -> {
+                    p = f.createNonBlockingByteArrayParser(ctx);
