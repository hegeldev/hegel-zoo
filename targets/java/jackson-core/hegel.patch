+    // ------------------------------------------------------------------ 4. long strings across the buffers
+
+    static final String[] PIECES = {"a", "b", " ", "\"", "\\", "\n", "\t", "\u0001", "\u007f", "é", "日", "\u2028", "😀", "/", "<"};
+
+    /** A string of about {@code len} chars from the pieces, with a surrogate pair placed at {@code at} when asked. */
+    static String longString(TestCase tc, int len, int at) {
+        StringBuilder sb = new StringBuilder();
+        boolean ascii = chance(tc, 50);
+        while (sb.length() < len) {
+            if (at >= 0 && sb.length() == at) {
+                sb.append("😀");
+            } else if (ascii && chance(tc, 90)) {
+                sb.append((char) ('a' + n(tc, 0, 25)));
+            } else {
+                sb.append(pick(tc, PIECES));
+            }
+        }
+        return sb.toString();
+    }
+
+    @Test
+    void longStringsCrossTheBufferBoundaries() {
+        Hegel.test(tc -> {
+            int base = pick(tc, 200, 500, 1000, 4000, 8000, 199, 999, 1001, 3999, 7999, n(tc, 0, 9000));
+            int len = base + n(tc, -2, 2);
+            int at = chance(tc, 50) ? Math.max(0, base + n(tc, -3, 1)) : -1;
+            String s = longString(tc, Math.max(0, len), at);
+            Cfg c = cfg(tc);
+            boolean asName = chance(tc, 30);
+            List<Ev> evs = asName
+                    ? List.of(new Ev("{", null, null), new Ev("name", s, null), new Ev("number", 1, "1"), new Ev("}", null, null))
+                    : List.of(new Ev("[", null, null), new Ev("string", s, null), new Ev("]", null, null));
+            String text = generate(tc, evs, c, null);
+            if (text == null) {
+                return;
+            }
+            String expected = compact(evs, c.escaping());
+            check(text.equals(expected), () -> "generator (" + c + ") wrote a " + s.length() + "-char string differently: " + firstDifference(text, expected));
+            Src src = src(tc);
+            if (src.bytes() && (hasLoneSurrogate(text) || (asName && (c.utf8() || c.nonAscii()) && hasLoneSurrogate(s)))) {
+                return; // bytes cannot carry a lone surrogate; jackson-core/3 for the escaped one in a name
+            }
+            if (src == Src.ASYNC && hasSurrogateEscape(text)) {
+                return; // jackson-core/11
+            }
+            JsonFactory f = new JsonFactory();
+            try (Tokens t = new Tokens(tc, f, src, text, chunk(tc))) {
+                JsonParser p = t.p;
+                t.next();
+                JsonToken tok = t.next();
+                if (asName) {
+                    check(tok == JsonToken.PROPERTY_NAME && p.currentName().equals(s), () -> src + ": name of " + s.length() + " chars read back differently: " + firstDifference(p.currentName(), s));
+                    check(p.getString().equals(s), () -> src + ": getString of the name differs: " + firstDifference(p.getString(), s));
+                } else {
+                    check(tok == JsonToken.VALUE_STRING, () -> src + ": token " + tok);
+                    int r = n(tc, 0, 3);
+                    if (r == 0) {
+                        String got = p.getString();
+                        check(got.equals(s), () -> src + ": getString of " + s.length() + " chars differs: " + firstDifference(got, s));
+                    } else if (r == 1) {
+                        char[] cs = p.getStringCharacters();
+                        String got = new String(cs, p.getStringOffset(), p.getStringLength());
+                        check(got.equals(s), () -> src + ": getStringCharacters/Offset/Length of " + s.length() + " chars differs: " + firstDifference(got, s));
+                    } else if (r == 2) {
+                        StringWriter w = new StringWriter();
+                        int count = p.getString(w);
+                        check(count == s.length() && w.toString().equals(s), () -> src + ": getString(Writer) wrote " + count + " chars: " + firstDifference(w.toString(), s));
+                    } else if (src != Src.ASYNC) {
+                        StringWriter w = new StringWriter();
+                        long count = p.readString(w);
+                        check(count == s.length() && w.toString().equals(s), () -> src + ": readString(Writer) wrote " + count + " chars: " + firstDifference(w.toString(), s));
+                    }
+                }
+                while (t.next() != null) {
+                    // drain
+                }
+            } catch (JacksonException | IllegalStateException e) {
+                fail(src + ": threw " + e + " for a " + s.length() + "-char string (cfg " + c + ")");
+            }
+        }, Zoo.settings("longStringsCrossTheBufferBoundaries"));
+    }
+
+    static String firstDifference(String got, String want) {
+        if (got == null) {
+            return "got null";
+        }
+        int i = 0;
+        while (i < got.length() && i < want.length() && got.charAt(i) == want.charAt(i)) {
+            i++;
+        }
+        return "lengths " + got.length() + " vs " + want.length() + ", first difference at " + i + ": got " + show(got.substring(i, Math.min(got.length(), i + 12)))
+                + " expected " + show(want.substring(i, Math.min(want.length(), i + 12)));
+    }
