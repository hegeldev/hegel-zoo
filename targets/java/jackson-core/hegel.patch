+    @Test
+    void binaryRoundTripsThroughEveryBase64Variant() {
+        Hegel.test(tc -> {
+            int len = pick(tc, n(tc, 0, 20), n(tc, 0, 200), pick(tc, 56, 57, 58, 2999, 3000, 3001, 4000), n(tc, 0, 6000));
+            byte[] data = new byte[len];
+            for (int i = 0; i < len; i++) {
+                data[i] = (byte) n(tc, 0, 255);
+            }
+            Base64Variant bv = pick(tc, VARIANTS);
+            boolean utf8 = chance(tc, 50);
+            String encoded = bv.encode(data, false);
+            // the variant round-trips on its own
+            check(Arrays.equals(bv.decode(bv.encode(data, false, "\n")), data), () -> bv + ": decode(encode) differs for " + len + " bytes");
+            // the generator writes exactly the variant's encoding (line feeds JSON-escaped)
+            JsonFactory f = new JsonFactory();
+            String text;
+            try {
+                if (utf8) {
+                    ByteArrayOutputStream out = new ByteArrayOutputStream();
+                    try (JsonGenerator g = f.createGenerator(ObjectWriteContext.empty(), out)) {
+                        g.writeStartArray();
+                        writeBinary(tc, g, bv, data);
+                        g.writeEndArray();
+                    }
+                    text = out.toString(StandardCharsets.UTF_8);
+                } else {
+                    StringWriter sw = new StringWriter();
+                    try (JsonGenerator g = f.createGenerator(ObjectWriteContext.empty(), sw)) {
+                        g.writeStartArray();
+                        writeBinary(tc, g, bv, data);
+                        g.writeEndArray();
+                    }
+                    text = sw.toString();
+                }
+            } catch (JacksonException | IOException e) {
+                fail(bv + ": generator threw " + e + " for " + len + " bytes");
+                return;
+            }
+            final String doc = text;
+            String want = "[\"" + encoded + "\"]";
+            check(doc.equals(want), () -> bv + (utf8 ? " utf8" : " writer") + ": wrote " + firstDifference(doc, want));
+            // and every parser decodes it back
+            Src src = src(tc);
+            try (Tokens t = new Tokens(tc, f, src, doc, chunk(tc))) {
+                JsonParser p = t.p;
+                t.next();
+                JsonToken tok = t.next();
+                check(tok == JsonToken.VALUE_STRING, () -> src + ": token " + tok);
+                if (chance(tc, 50) || src == Src.ASYNC) {
+                    byte[] got = p.getBinaryValue(bv);
+                    check(Arrays.equals(got, data), () -> bv + " " + src + ": getBinaryValue gives " + got.length + " bytes, expected " + len + (got.length == len ? " (content differs)" : ""));
+                } else {
+                    ByteArrayOutputStream out = new ByteArrayOutputStream();
+                    int count = p.readBinaryValue(bv, out);
+                    check(count == len && Arrays.equals(out.toByteArray(), data), () -> bv + " " + src + ": readBinaryValue gives " + count + " bytes, expected " + len);
+                }
+                check(t.next() == JsonToken.END_ARRAY, () -> src + ": no END_ARRAY after the binary value");
+            } catch (JacksonException | IllegalStateException e) {
+                fail(bv + " " + src + ": parser threw " + e + " for " + len + " bytes");
+            }
+        }, Zoo.settings("binaryRoundTripsThroughEveryBase64Variant"));
+    }
+
+    static void writeBinary(TestCase tc, JsonGenerator g, Base64Variant bv, byte[] data) throws IOException {
+        int r = n(tc, 0, 3);
+        if (r == 0) {
+            g.writeBinary(bv, data, 0, data.length);
+        } else if (r == 1) {
+            byte[] padded = new byte[data.length + 5];
+            System.arraycopy(data, 0, padded, 3, data.length);
+            g.writeBinary(bv, padded, 3, data.length);
+        } else if (r == 2) {
+            g.writeBinary(bv, new ByteArrayInputStream(data), data.length);
+        } else if (bv == Base64Variants.MIME_NO_LINEFEEDS) {
+            g.writeBinary(data);
+        } else {
+            g.writeBinary(bv, new ThrottledStream(new ByteArrayInputStream(data), pick(tc, 1, 3, 7, 100)), data.length);
+        }
+    }
