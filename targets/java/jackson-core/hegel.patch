+
+    // ------------------------------------------------------------------ jackson-core/12
+
+    /** A non-empty object with a trailing comma, fed to the strict non-blocking parser in small pieces; the neighbour feeds it whole. */
+    record TrailingComma(List<Tuple2<String, Object>> entries, String gap, Feed feed) {
+        String doc() {
+            String text = Ref.write(Ref.toMap(entries), Ref.PLAIN);
+            return text.substring(0, text.length() - 1) + "," + gap + "}";
+        }
+    }
+
+    static final Generator<TrailingComma> TRAILING_COMMA = tuples(many(tuples(Ref.string(false), Ref.value(2, false)), 1, 3), pick("", " ", "\n"), Zoo.NO_KNOWN ? WHOLE_FEED : SMALL_FEED)
+            .map(t -> new TrailingComma(t.value1(), t.value2(), t.value3()));
+
