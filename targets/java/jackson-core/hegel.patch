+        });
+    }
+
+    // ------------------------------------------------------------------ jackson-core/14
+
+    /** A root integer directly followed by another root value, in one feed of the non-blocking parser; the neighbour gives the integer a fraction. */
+    record AdjacentRoots(String integer, String fraction, String second) {
+        String doc() {
+            return integer + fraction + second;
+        }
+    }
+
+    /** A second root value that does not continue the integer's digits: a literal, a string, an array or a negative number. */
+    static final Generator<String> SECOND_ROOT = weighted(w(30, pick("null", "true", "false")), w(30, Ref.string(false).map(s -> Ref.write(s, Ref.PLAIN))),
+            w(25, Ref.value(1, false).map(v -> Ref.write(java.util.Collections.singletonList(v), Ref.PLAIN))),
+            w(15, Ref.INTEGER_LEXEME.map(l -> l.startsWith("-") ? l : "-" + l)));
+
+    static final Generator<AdjacentRoots> ADJACENT_ROOTS = tuples(Ref.INTEGER_LEXEME, Zoo.NO_KNOWN ? word("0123456789", 1, 3).map(d -> "." + d) : just(""), SECOND_ROOT)
+            .map(t -> new AdjacentRoots(t.value1(), t.value2(), t.value3()));
+
+    @Test
+    void asyncParserRejectsAnIntegerRunningIntoTheNextRootValue() {
+        Zoo.run("jackson-core.asyncParserRejectsAnIntegerRunningIntoTheNextRootValue", tc -> {
+            AdjacentRoots ar = tc.draw(ADJACENT_ROOTS);
+            checkAgrees(tc, new JsonFactory(), Src.ASYNC, WHOLE, ar.doc());
+        });
+    }
+}
