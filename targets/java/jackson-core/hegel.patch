+    // ------------------------------------------------------------------ 3. numbers
+
+    static String digits(TestCase tc, int len) {
+        StringBuilder sb = new StringBuilder();
+        for (int i = 0; i < len; i++) {
+            sb.append((char) ('0' + n(tc, i == 0 ? 1 : 0, 9)));
+        }
+        return sb.toString();
+    }
+
+    /** A number lexeme: the pool, random ones, and ones at the 1000-digit constraint. */
+    static String lexeme(TestCase tc) {
+        int r = n(tc, 0, 99);
+        if (r < 50) {
+            return Ref.number(tc);
+        }
+        if (r < 65) {
+            // near the int/long boundaries
+            long base = pick(tc, 2147483647L, 2147483648L, -2147483648L, -2147483649L, 999999999L, 1000000000L, 9999999999L,
+                    999999999999999999L, 1000000000000000000L, Long.MAX_VALUE, Long.MIN_VALUE, 9007199254740992L, 127L, 128L, 255L, 256L, 32767L, 32768L, 65535L);
+            String s = Long.toString(base);
+            if (chance(tc, 30)) {
+                s = s + pick(tc, ".0", ".5", "e0", "E1", ".00", ".999", "e-1");
+            }
+            if (chance(tc, 20)) {
+                s = s.startsWith("-") ? s.substring(1) : "-" + s;
+            }
+            return s;
+        }
+        if (r < 80) {
+            // huge integer or fraction digit counts around the number-length constraint
+            int len = pick(tc, 998, 999, 1000, 1001, 1002, 50, 400);
+            boolean fp = chance(tc, 40);
+            if (!fp) {
+                return (chance(tc, 30) ? "-" : "") + digits(tc, len);
+            }
+            int intLen = n(tc, 1, Math.min(len, 20));
+            int expLen = chance(tc, 50) ? n(tc, 1, 3) : 0;
+            int fracLen = Math.max(1, len - intLen - expLen);
+            String s = digits(tc, intLen) + "." + digits(tc, fracLen);
+            if (expLen > 0) {
+                s += pick(tc, "e", "E") + pick(tc, "", "+", "-") + digits(tc, expLen);
+            }
+            return (chance(tc, 30) ? "-" : "") + s;
+        }
+        // random double's shortest form, or a random BigDecimal's
+        if (chance(tc, 50)) {
+            double d = Double.longBitsToDouble(tc.draw(dev.hegel.Generators.longs()));
+            if (Double.isFinite(d)) {
+                return Double.toString(d);
+            }
+        }
+        return new BigDecimal(new BigInteger(digits(tc, n(tc, 1, 25))), n(tc, -30, 30)).toString();
+    }
+
+    static int digitCount(String lex) {
+        int count = 0;
+        for (int i = 0; i < lex.length(); i++) {
+            if (Character.isDigit(lex.charAt(i))) {
+                count++;
+            }
+        }
+        return count;
+    }
+
+    static boolean bitsEqual(double a, double b) {
+        return Double.doubleToLongBits(a) == Double.doubleToLongBits(b);
+    }
+
+    @Test
+    void numbersDecodeExactlyInEveryParser() {
+        Hegel.test(tc -> {
+            String lex = lexeme(tc);
+            boolean inArray = chance(tc, 50);
+            String text = inArray ? "[" + lex + "]" : lex + pick(tc, " ", "\n", "\t", "\r\n");
+            Src src = src(tc);
+            boolean fast = chance(tc, 50);
+            JsonFactory f = JsonFactory.builder().configure(StreamReadFeature.USE_FAST_DOUBLE_PARSER, fast)
+                    .configure(StreamReadFeature.USE_FAST_BIG_NUMBER_PARSER, chance(tc, 50)).build();
+            NumberType nt = numberType(lex);
+            boolean fp = nt == NumberType.DOUBLE;
+            boolean tooLong = digitCount(lex) > 1000;
+            BigDecimal exact = new BigDecimal(lex);
+            String what = src + (fast ? " fast" : " jdk") + " " + (lex.length() > 60 ? lex.substring(0, 60) + "...(" + lex.length() + ")" : lex);
+            try (Tokens t = new Tokens(tc, f, src, text, chunk(tc))) {
+                JsonParser p = t.p;
+                JsonToken tok = t.next();
+                if (inArray) {
+                    final JsonToken first = tok;
+                    check(first == JsonToken.START_ARRAY, () -> what + ": first token " + first);
+                    tok = t.next();
+                }
+                final JsonToken numTok = tok;
+                if (tooLong) {
+                    fail(what + ": a number with " + digitCount(lex) + " digits was accepted as " + numTok + " (maxNumberLength 1000)");
+                    return;
+                }
+                check(numTok == (fp ? JsonToken.VALUE_NUMBER_FLOAT : JsonToken.VALUE_NUMBER_INT), () -> what + ": token " + numTok);
+                if (src == Src.ASYNC && lex.equals("-0")) {
+                    return; // jackson-core/4: the non-blocking parser drops the sign of -0
+                }
+                check(p.getString().equals(lex), () -> what + ": getString " + p.getString());
+                int which = n(tc, 0, 9);
+                if (which != 1) {
+                    // jackson-core/2: getNumberType() first makes getNumberValueExact() lossy, so case 1 asks the exact value first
+                    check(p.getNumberType() == nt, () -> what + ": getNumberType " + p.getNumberType() + " expected " + nt);
+                }
+                check(!p.isNaN(), () -> what + ": isNaN");
+                switch (which) {
+                    case 0 -> {
+                        // getNumberValue: Integer / Long / BigInteger / Double
+                        Number nv = p.getNumberValue();
+                        Class<?> cls = switch (nt) {
+                            case INT -> Integer.class;
+                            case LONG -> Long.class;
+                            case BIG_INTEGER -> BigInteger.class;
+                            default -> Double.class;
+                        };
+                        check(nv.getClass() == cls, () -> what + ": getNumberValue is a " + nv.getClass().getSimpleName() + " expected " + cls.getSimpleName());
+                        if (fp) {
+                            check(bitsEqual(nv.doubleValue(), Double.parseDouble(lex)), () -> what + ": getNumberValue " + nv + " expected " + Double.parseDouble(lex));
+                        } else {
+                            check(new BigDecimal(nv.toString()).compareTo(exact) == 0, () -> what + ": getNumberValue " + nv);
+                        }
+                    }
+                    case 1 -> {
+                        Number ne = p.getNumberValueExact();
+                        check(fp ? ne instanceof BigDecimal : !(ne instanceof BigDecimal), () -> what + ": getNumberValueExact is a " + ne.getClass().getSimpleName());
+                        check(new BigDecimal(ne.toString()).compareTo(exact) == 0, () -> what + ": getNumberValueExact " + ne + " expected " + exact);
+                    }
+                    case 2 -> {
+                        double d = p.getDoubleValue();
+                        double want = Double.parseDouble(lex);
+                        check(fp ? bitsEqual(d, want) : d == want, () -> what + ": getDoubleValue " + d + " expected " + want);
+                    }
+                    case 3 -> {
+                        float fl = p.getFloatValue();
+                        float want = Float.parseFloat(lex);
+                        check(fp ? Float.floatToIntBits(fl) == Float.floatToIntBits(want) : fl == want, () -> what + ": getFloatValue " + fl + " expected " + want);
+                    }
+                    case 4 -> {
+                        BigDecimal bd = p.getDecimalValue();
+                        check(bd.compareTo(exact) == 0, () -> what + ": getDecimalValue " + bd + " expected " + exact);
+                    }
+                    case 5 -> {
+                        BigInteger bi = p.getBigIntegerValue();
+                        BigInteger want = exact.toBigInteger();
+                        check(bi.equals(want), () -> what + ": getBigIntegerValue " + bi + " expected " + want);
+                    }
+                    case 6, 7 -> {
+                        // int: exact ints; a floating-point lexeme is truncated through its double
+                        boolean ok;
+                        long want = 0;
+                        if (fp) {
+                            double d = Double.parseDouble(lex);
+                            ok = !(d < Integer.MIN_VALUE || d > Integer.MAX_VALUE);
+                            want = (long) (int) d;
+                        } else {
+                            BigInteger bi = exact.toBigIntegerExact();
+                            ok = bi.bitLength() < 32;
+                            want = ok ? bi.longValue() : 0;
+                        }
+                        final boolean fits = ok;
+                        final long expectedInt = want;
+                        try {
+                            int i = which == 6 ? p.getIntValue() : p.getValueAsInt();
+                            check(fits, () -> what + ": getIntValue accepted an out-of-range value as " + i);
+                            check(!fits || i == expectedInt, () -> what + ": getIntValue " + i + " expected " + expectedInt);
+                        } catch (InputCoercionException e) {
+                            check(!fits, () -> what + ": getIntValue threw " + e.getMessage() + " for a value that fits: " + expectedInt);
+                        }
+                    }
+                    case 8 -> {
+                        boolean ok;
+                        long want = 0;
+                        if (fp) {
+                            double d = Double.parseDouble(lex);
+                            ok = !(d < Long.MIN_VALUE || d > Long.MAX_VALUE);
+                            want = (long) d;
+                            if (ok && exact.abs().compareTo(new BigDecimal(Long.MAX_VALUE)) > 0) {
+                                return; // jackson-core/6: 2^63 as a double passes the range check and getLongValue saturates
+                            }
+                        } else {
+                            BigInteger bi = exact.toBigIntegerExact();
+                            ok = bi.bitLength() < 64;
+                            want = ok ? bi.longValue() : 0;
+                        }
+                        final boolean fits = ok;
+                        final long expectedLong = want;
+                        try {
+                            long l = p.getLongValue();
+                            check(fits, () -> what + ": getLongValue accepted an out-of-range value as " + l);
+                            check(!fits || l == expectedLong, () -> what + ": getLongValue " + l + " expected " + expectedLong);
+                        } catch (InputCoercionException e) {
+                            check(!fits, () -> what + ": getLongValue threw " + e.getMessage() + " for a value that fits: " + expectedLong);
+                        }
+                    }
+                    default -> {
+                        // short and byte: byte allows -128..255 (documented)
+                        if (!fp) {
+                            BigInteger bi = exact.toBigIntegerExact();
+                            boolean fitsShort = bi.bitLength() < 16;
+                            boolean fitsByte = bi.compareTo(BigInteger.valueOf(-128)) >= 0 && bi.compareTo(BigInteger.valueOf(255)) <= 0;
+                            try {
+                                short s = p.getShortValue();
+                                check(fitsShort && s == bi.shortValue(), () -> what + ": getShortValue " + s);
+                            } catch (InputCoercionException e) {
+                                check(!fitsShort, () -> what + ": getShortValue threw " + e.getMessage());
+                            }
+                            try {
+                                byte b = p.getByteValue();
+                                check(fitsByte && b == bi.byteValue(), () -> what + ": getByteValue " + b);
+                            } catch (InputCoercionException e) {
+                                check(!fitsByte, () -> what + ": getByteValue threw " + e.getMessage());
+                            }
+                        }
+                    }
+                }
+                if (inArray) {
+                    JsonToken end = t.next();
+                    check(end == JsonToken.END_ARRAY, () -> what + ": after the number " + end);
+                }
+                JsonToken eof = t.next();
+                check(eof == null, () -> what + ": trailing token " + eof);
+            } catch (StreamConstraintsException e) {
+                check(tooLong, () -> what + ": constraint exception for a " + digitCount(lex) + "-digit number: " + e.getMessage());
+            } catch (JacksonException | IllegalStateException e) {
+                fail(what + ": threw " + e);
+            }
+        }, Zoo.settings("numbersDecodeExactlyInEveryParser"));
+    }
