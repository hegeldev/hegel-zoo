+    // ------------------------------------------------------------------ 6. JsonPointer
+
+    static final String[] SEGMENTS = {"", "a", "b", "~", "/", "~0", "~1", "~2", "a/b", "a~b", "0", "1", "01", "00", "-", "10", "2147483647",
+        "2147483648", "9999999999", "99999999999", "1e0", "-1", " ", "a b", "é", "😀", "x\"y", "\\", "\n"};
+
+    static String escapeSegment(String s) {
+        return s.replace("~", "~0").replace("/", "~1");
+    }
+
+    /** The documented index parse: digits only, no leading zero, at most 10 chars, within int range; else -1. */
+    static int indexOf(String seg) {
+        if (seg.isEmpty() || seg.length() > 10) {
+            return -1;
+        }
+        for (int i = 0; i < seg.length(); i++) {
+            if (seg.charAt(i) < '0' || seg.charAt(i) > '9') {
+                return -1;
+            }
+        }
+        if (seg.length() > 1 && seg.charAt(0) == '0') {
+            return -1;
+        }
+        long v = Long.parseLong(seg);
+        return v > Integer.MAX_VALUE ? -1 : (int) v;
+    }
+
+    @Test
+    void jsonPointersFollowTheDocumentedModel() {
+        Hegel.test(tc -> {
+            int count = n(tc, 0, 6);
+            List<String> segs = new ArrayList<>();
+            for (int i = 0; i < count; i++) {
+                segs.add(chance(tc, 70) ? pick(tc, SEGMENTS) : Zoo.word(tc, "ab~/01 ", 0, 4));
+            }
+            StringBuilder sb = new StringBuilder();
+            for (String s : segs) {
+                sb.append('/').append(escapeSegment(s));
+            }
+            String expr = sb.toString();
+            JsonPointer ptr = JsonPointer.compile(expr);
+            check(ptr.toString().equals(expr), () -> "compile(" + show(expr) + ").toString() = " + show(ptr.toString()));
+            check(ptr.length() == expr.length(), () -> "length of " + show(expr) + " = " + ptr.length());
+            check(ptr.matches() == segs.isEmpty(), () -> show(expr) + ".matches() = " + ptr.matches());
+            check(JsonPointer.compile(expr).equals(ptr) && JsonPointer.compile(expr).hashCode() == ptr.hashCode(), () -> "equals/hashCode for " + show(expr));
+            // built by appending, the same pointer
+            JsonPointer built = JsonPointer.empty();
+            for (String s : segs) {
+                int idx = indexOf(s);
+                built = idx >= 0 && chance(tc, 50) ? built.appendIndex(idx) : built.appendProperty(s);
+            }
+            final JsonPointer b = built;
+            check(b.equals(ptr) && b.toString().equals(expr), () -> "appended " + show(b.toString()) + " expected " + show(expr));
+            // walking the segments
+            JsonPointer cur = ptr;
+            for (int i = 0; i < segs.size(); i++) {
+                String s = segs.get(i);
+                final JsonPointer here = cur;
+                final int i2 = i;
+                check(!here.matches(), () -> "segment " + i2 + " of " + show(expr) + ": matches() early");
+                check(s.equals(here.getMatchingProperty()), () -> "segment " + i2 + " of " + show(expr) + ": property " + show(here.getMatchingProperty()) + " expected " + show(s));
+                check(here.getMatchingIndex() == indexOf(s), () -> "segment " + i2 + " of " + show(expr) + ": index " + here.getMatchingIndex() + " expected " + indexOf(s));
+                check(here.mayMatchProperty(), () -> "segment " + i2 + " of " + show(expr) + ": mayMatchProperty false");
+                check(here.mayMatchElement() == (indexOf(s) >= 0), () -> "segment " + i2 + " of " + show(expr) + ": mayMatchElement " + here.mayMatchElement());
+                check(here.matchesProperty(s), () -> "segment " + i2 + " of " + show(expr) + ": matchesProperty(" + show(s) + ") false");
+                check(here.matchesElement(indexOf(s)) == (indexOf(s) >= 0), () -> "segment " + i2 + " of " + show(expr) + ": matchesElement(" + indexOf(s) + ")");
+                String other = s + "x";
+                check(!here.matchesProperty(other) && here.matchProperty(other) == null, () -> "segment " + i2 + " of " + show(expr) + ": matches " + show(other));
+                JsonPointer tail = here.tail();
+                JsonPointer viaMatch = here.matchProperty(s);
+                check(tail != null && tail.equals(viaMatch), () -> "segment " + i2 + " of " + show(expr) + ": tail " + tail + " vs matchProperty " + viaMatch);
+                String tailExpr = expr.substring(expr.length() - tail.length());
+                check(tail.toString().equals(tailExpr), () -> "segment " + i2 + " of " + show(expr) + ": tail " + show(tail.toString()) + " expected " + show(tailExpr));
+                cur = tail;
+            }
+            final JsonPointer end = cur;
+            check(end.matches() && end.toString().isEmpty(), () -> "after the segments of " + show(expr) + ": " + end);
+            // head and last
+            if (!segs.isEmpty()) {
+                JsonPointer head = ptr.head();
+                String headExpr = expr.substring(0, expr.length() - 1 - escapeSegment(segs.get(segs.size() - 1)).length());
+                check(head != null && head.toString().equals(headExpr), () -> "head of " + show(expr) + " = " + head + " expected " + show(headExpr));
+                JsonPointer last = ptr.last();
+                String lastExpr = "/" + escapeSegment(segs.get(segs.size() - 1));
+                check(last != null && last.toString().equals(lastExpr) && last.getMatchingProperty().equals(segs.get(segs.size() - 1)),
+                        () -> "last of " + show(expr) + " = " + last + " expected " + show(lastExpr));
+                check(head.append(last).equals(ptr), () -> "head.append(last) of " + show(expr) + " = " + head.append(last));
+                check(ptr.startsWith(head), () -> show(expr) + " does not startsWith its head " + head);
+            } else {
+                check(ptr.head() == null && ptr.last() == null, () -> "head/last of the empty pointer: " + ptr.head() + " / " + ptr.last());
+            }
+            // append of an arbitrary tail
+            JsonPointer extra = JsonPointer.compile("/" + escapeSegment(pick(tc, SEGMENTS)));
+            check(ptr.append(extra).toString().equals(expr + extra), () -> show(expr) + ".append(" + extra + ") = " + ptr.append(extra));
+            check(ptr.append(JsonPointer.empty()).equals(ptr) && JsonPointer.empty().append(ptr).equals(ptr), () -> "append(empty) for " + show(expr));
+        }, Zoo.settings("jsonPointersFollowTheDocumentedModel"));
+    }
