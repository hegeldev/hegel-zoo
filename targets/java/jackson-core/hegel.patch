+    /** A lexeme near the int/long boundaries, with an optional fraction or exponent and the sign flipped for some. */
+    static final Generator<String> BOUNDARY_LEXEME = tuples(
+            pick(2147483647L, 2147483648L, -2147483648L, -2147483649L, 999999999L, 1000000000L, 9999999999L, 999999999999999999L,
+                    1000000000000000000L, Long.MAX_VALUE, Long.MIN_VALUE, 9007199254740992L, 127L, 128L, 255L, 256L, 32767L, 32768L, 65535L),
+            opt(30, pick(".0", ".5", "e0", "E1", ".00", ".999", "e-1")), chance(20))
+            .map(t -> {
+                String s = Long.toString(t.value1()) + t.value2();
+                return t.value3() ? (s.startsWith("-") ? s.substring(1) : "-" + s) : s;
+            });
+
+    /** A digit run of exactly {@code len} digits, the first one not zero. */
+    static Generator<String> digits(int len) {
+        return len <= 0 ? just("") : tuples(word("123456789", 1, 1), word(Ref.DIGITS, len - 1, len - 1)).map(t -> t.value1() + t.value2());
+    }
+
+    /** How a lexeme of a given digit count is laid out: an integer, or int part, fraction and optional exponent. */
+    record LongShape(int len, boolean neg, boolean fp, int intLen, int expLen, String e, String expSign) {
+        Generator<String> lexeme() {
+            String sign = neg ? "-" : "";
+            if (!fp) {
+                return digits(len).map(ds -> sign + ds);
+            }
+            int ip = Math.min(intLen, len);
+            int fracLen = Math.max(1, len - ip - expLen);
+            return tuples(digits(ip), word(Ref.DIGITS, fracLen, fracLen), digits(expLen))
+                    .map(t -> sign + t.value1() + "." + t.value2() + (expLen > 0 ? e + expSign + t.value3() : ""));
+        }
+    }
+
+    /** Lexemes with 998..1002 digits around the number-length constraint (and some shorter ones). */
+    static final Generator<String> LONG_LEXEME = tuples(pick(998, 999, 1000, 1001, 1002, 50, 400), chance(30), chance(40), ints(1, 20), maybe(50, 0, ints(1, 3)),
+            pick("e", "E"), pick("", "+", "-"))
+            .map(t -> new LongShape(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6(), t.value7()))
+            .flatMap(LongShape::lexeme);
+
+    /** A random double's shortest form. */
+    static final Generator<String> RANDOM_DOUBLE = longs().map(Double::longBitsToDouble).filter(Double::isFinite).map(d -> Double.toString(d));
+
+    /** A random BigDecimal's form: 1..25 digits at a scale of -30..30. */
+    static final Generator<String> RANDOM_DECIMAL = tuples(ints(1, 25), ints(-30, 30))
+            .flatMap(t -> word(Ref.DIGITS, t.value1(), t.value1()).map(ds -> new BigDecimal(new BigInteger(ds), t.value2()).toString()));
+
+    /** A number lexeme: the pool and random ones, the boundaries, the 1000-digit constraint, doubles and decimals. */
+    static final Generator<String> LEXEME = weighted(w(50, Ref.NUMBER), w(15, BOUNDARY_LEXEME), w(15, LONG_LEXEME), w(10, RANDOM_DOUBLE), w(10, RANDOM_DECIMAL));
+
+    /** The accessor a number case asks after the token, getString and getNumberType. */
+    enum Acc { NUMBER_VALUE, EXACT, DOUBLE, FLOAT, DECIMAL, BIG_INTEGER, INT, VALUE_AS_INT, LONG, SHORT_AND_BYTE }
+
+    /** A number case: the lexeme in an array or at the root followed by whitespace, the parsers, the source and the accessor. */
+    record NumCase(String lex, boolean inArray, String trailer, boolean fast, boolean fastBig, Acc acc, Src src, Feed feed) {
+        String text() {
+            return inArray ? "[" + lex + "]" : lex + trailer;
+        }
+
+        JsonFactory factory() {
+            return JsonFactory.builder().configure(StreamReadFeature.USE_FAST_DOUBLE_PARSER, fast)
+                    .configure(StreamReadFeature.USE_FAST_BIG_NUMBER_PARSER, fastBig).build();
+        }
+
+        String what() {
+            return src + (fast ? " fast" : " jdk") + " " + acc + " " + (lex.length() > 60 ? lex.substring(0, 60) + "...(" + lex.length() + ")" : lex);
+        }
+    }
+
+    static final Generator<NumCase> NUM_CASE = tuples(LEXEME, chance(50), pick(" ", "\n", "\t", "\r\n"), chance(50), chance(50), pick(Acc.values()), SRC, FEED)
+            .map(t -> new NumCase(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6(), t.value7(), t.value8()));
+
+    static int digitCount(String lex) {
+        int count = 0;
+        for (int i = 0; i < lex.length(); i++) {
+            if (Character.isDigit(lex.charAt(i))) {
+                count++;
+            }
+        }
+        return count;
+    }
+
+    static boolean bitsEqual(double a, double b) {
+        return Double.doubleToLongBits(a) == Double.doubleToLongBits(b);
+    }
+
+    /** True when a floating-point lexeme's double lies within the long range, so the truncation is expected. */
+    static boolean doubleInLongRange(double d) {
+        return !(d < Long.MIN_VALUE || d > Long.MAX_VALUE);
+    }
+
+    /**
+     * Reads the number of the case and checks the token, getString, getNumberType, isNaN and the accessor
+     * ({@code exactFirst} asks getNumberValueExact before getNumberType, the neighbouring order of jackson-core/2).
+     */
+    static void checkNumber(TestCase tc, NumCase nc, boolean exactFirst) {
+        String lex = nc.lex();
+        Src src = nc.src();
+        NumberType nt = numberType(lex);
+        boolean fp = nt == NumberType.DOUBLE;
+        boolean tooLong = digitCount(lex) > 1000;
+        BigDecimal exact = new BigDecimal(lex);
+        String what = nc.what();
+        if (Zoo.NO_KNOWN) {
+            Zoo.assume(tc, !(src == Src.ASYNC && lex.equals("-0")), "-0 in the non-blocking parser (jackson-core/4)");
+        }
+        try (Tokens t = new Tokens(nc.factory(), src, nc.text(), nc.feed())) {
+            JsonParser p = t.p;
+            JsonToken tok = t.next();
+            if (nc.inArray()) {
+                final JsonToken first = tok;
+                check(first == JsonToken.START_ARRAY, () -> what + ": first token " + first);
+                tok = t.next();
+            }
+            final JsonToken numTok = tok;
+            if (tooLong) {
+                fail(what + ": a number with " + digitCount(lex) + " digits was accepted as " + numTok + " (maxNumberLength 1000)");
+                return;
+            }
+            check(numTok == (fp ? JsonToken.VALUE_NUMBER_FLOAT : JsonToken.VALUE_NUMBER_INT), () -> what + ": token " + numTok);
+            check(p.getString().equals(lex), () -> what + ": getString " + p.getString());
+            if (Zoo.NO_KNOWN && nc.acc() == Acc.EXACT && !exactFirst) {
+                Zoo.count("not checked: getNumberType before getNumberValueExact (jackson-core/2)");
+            } else if (!exactFirst) {
+                check(p.getNumberType() == nt, () -> what + ": getNumberType " + p.getNumberType() + " expected " + nt);
+            }
+            check(!p.isNaN(), () -> what + ": isNaN");
+            switch (nc.acc()) {
+                case NUMBER_VALUE -> {
+                    // getNumberValue: Integer / Long / BigInteger / Double
+                    Number nv = p.getNumberValue();
+                    Class<?> cls = switch (nt) {
+                        case INT -> Integer.class;
+                        case LONG -> Long.class;
+                        case BIG_INTEGER -> BigInteger.class;
+                        default -> Double.class;
+                    };
+                    check(nv.getClass() == cls, () -> what + ": getNumberValue is a " + nv.getClass().getSimpleName() + " expected " + cls.getSimpleName());
+                    if (fp) {
+                        check(bitsEqual(nv.doubleValue(), Double.parseDouble(lex)), () -> what + ": getNumberValue " + nv + " expected " + Double.parseDouble(lex));
+                    } else {
+                        check(new BigDecimal(nv.toString()).compareTo(exact) == 0, () -> what + ": getNumberValue " + nv);
+                    }
+                }
+                case EXACT -> {
+                    Number ne = p.getNumberValueExact();
+                    check(fp ? ne instanceof BigDecimal : !(ne instanceof BigDecimal), () -> what + ": getNumberValueExact is a " + ne.getClass().getSimpleName());
+                    check(new BigDecimal(ne.toString()).compareTo(exact) == 0, () -> what + ": getNumberValueExact " + ne + " expected " + exact);
+                    // getNumberType() afterwards reports BIG_DECIMAL, the most precise representation parsed so far (by design)
+                }
+                case DOUBLE -> {
+                    double d = p.getDoubleValue();
+                    double want = Double.parseDouble(lex);
+                    check(fp ? bitsEqual(d, want) : d == want, () -> what + ": getDoubleValue " + d + " expected " + want);
+                }
+                case FLOAT -> {
+                    float fl = p.getFloatValue();
+                    float want = Float.parseFloat(lex);
+                    check(fp ? Float.floatToIntBits(fl) == Float.floatToIntBits(want) : fl == want, () -> what + ": getFloatValue " + fl + " expected " + want);
+                }
+                case DECIMAL -> {
+                    BigDecimal bd = p.getDecimalValue();
+                    check(bd.compareTo(exact) == 0, () -> what + ": getDecimalValue " + bd + " expected " + exact);
+                }
+                case BIG_INTEGER -> {
+                    BigInteger bi = p.getBigIntegerValue();
+                    BigInteger want = exact.toBigInteger();
+                    check(bi.equals(want), () -> what + ": getBigIntegerValue " + bi + " expected " + want);
+                }
+                case INT, VALUE_AS_INT -> {
+                    // int: exact ints; a floating-point lexeme is truncated through its double
+                    boolean ok;
+                    long want = 0;
+                    if (fp) {
+                        double d = Double.parseDouble(lex);
+                        ok = !(d < Integer.MIN_VALUE || d > Integer.MAX_VALUE);
+                        want = (long) (int) d;
+                    } else {
+                        BigInteger bi = exact.toBigIntegerExact();
+                        ok = bi.bitLength() < 32;
+                        want = ok ? bi.longValue() : 0;
+                    }
+                    final boolean fits = ok;
+                    final long expectedInt = want;
+                    try {
+                        int i = nc.acc() == Acc.INT ? p.getIntValue() : p.getValueAsInt();
+                        check(fits, () -> what + ": getIntValue accepted an out-of-range value as " + i);
+                        check(!fits || i == expectedInt, () -> what + ": getIntValue " + i + " expected " + expectedInt);
+                    } catch (InputCoercionException e) {
+                        check(!fits, () -> what + ": getIntValue threw " + e.getMessage() + " for a value that fits: " + expectedInt);
+                    }
+                }
+                case LONG -> {
+                    // long: exact longs; a floating-point lexeme is truncated through its double, and must lie within the long range
+                    boolean ok;
+                    long want = 0;
+                    if (fp) {
+                        double d = Double.parseDouble(lex);
+                        boolean inRange = exact.toBigInteger().bitLength() < 64;
+                        ok = doubleInLongRange(d) && inRange;
+                        want = (long) d;
+                        if (Zoo.NO_KNOWN && doubleInLongRange(d) && !inRange) {
+                            Zoo.count("not checked: getLongValue of a value beyond the long range whose double is 2^63 (jackson-core/6)");
+                            break;
+                        }
+                    } else {
+                        BigInteger bi = exact.toBigIntegerExact();
+                        ok = bi.bitLength() < 64;
+                        want = ok ? bi.longValue() : 0;
+                    }
+                    final boolean fits = ok;
+                    final long expectedLong = want;
+                    try {
+                        long l = p.getLongValue();
+                        check(fits, () -> what + ": getLongValue accepted an out-of-range value as " + l);
+                        check(!fits || l == expectedLong, () -> what + ": getLongValue " + l + " expected " + expectedLong);
+                    } catch (InputCoercionException e) {
+                        check(!fits, () -> what + ": getLongValue threw " + e.getMessage() + " for a value that fits: " + expectedLong);
+                    }
+                }
+                default -> {
+                    // short and byte: byte allows -128..255 (documented)
+                    if (!fp) {
+                        BigInteger bi = exact.toBigIntegerExact();
+                        boolean fitsShort = bi.bitLength() < 16;
+                        boolean fitsByte = bi.compareTo(BigInteger.valueOf(-128)) >= 0 && bi.compareTo(BigInteger.valueOf(255)) <= 0;
+                        try {
+                            short s = p.getShortValue();
+                            check(fitsShort && s == bi.shortValue(), () -> what + ": getShortValue " + s);
+                        } catch (InputCoercionException e) {
+                            check(!fitsShort, () -> what + ": getShortValue threw " + e.getMessage());
+                        }
+                        try {
+                            byte b = p.getByteValue();
+                            check(fitsByte && b == bi.byteValue(), () -> what + ": getByteValue " + b);
+                        } catch (InputCoercionException e) {
+                            check(!fitsByte, () -> what + ": getByteValue threw " + e.getMessage());
+                        }
+                    }
+                }
+            }
+            if (nc.inArray()) {
+                JsonToken end = t.next();
+                check(end == JsonToken.END_ARRAY, () -> what + ": after the number " + end);
+            }
+            JsonToken eof = t.next();
+            check(eof == null, () -> what + ": trailing token " + eof);
+        } catch (StreamConstraintsException e) {
+            check(tooLong, () -> what + ": constraint exception for a " + digitCount(lex) + "-digit number: " + e.getMessage());
+        } catch (JacksonException | IllegalStateException e) {
+            fail(what + ": threw " + e);
+        }
+    }
+
+    @Test
+    void numbersDecodeExactlyInEveryParser() {
+        Zoo.run("numbersDecodeExactlyInEveryParser", tc -> checkNumber(tc, tc.draw(NUM_CASE), false));
+    }
+
+    // ------------------------------------------------------------------ 4. long strings across the buffers
+
+    static final String[] PIECES = {"a", "b", " ", "\"", "\\", "\n", "\t", "\u0001", "\u007f", "é", "日", "\u2028", "😀", "/", "<"};
+
+    static final String LETTERS = "abcdefghijklmnopqrstuvwxyz";
+
+    /** The pieces a long string is made of, read cyclically: mostly letters with some special pieces, or the special pieces only. */
+    static final Generator<List<String>> LONG_TAPE = weighted(
+            w(50, many(weighted(w(90, chars(LETTERS)), w(10, pick(PIECES))), 1, 40)),
+            w(50, many(pick(PIECES), 1, 40)));
+
+    /** A string of about base + delta chars from the tape, with a surrogate pair placed at base + pairOffset when asked. */
+    record LongStr(int base, int delta, Integer pairOffset, List<String> tape) {
+        String render() {
+            int len = Math.max(0, base + delta);
+            int at = pairOffset == null ? -1 : Math.max(0, base + pairOffset);
+            StringBuilder sb = new StringBuilder();
+            for (int k = 0; sb.length() < len; k++) {
+                if (at >= 0 && sb.length() == at) {
+                    sb.append("😀");
+                } else {
+                    sb.append(at(tape, k));
+                }
+            }
+            return sb.toString();
+        }
+    }
+
+    static final Generator<Integer> LONG_BASE = weighted(v(1, 200), v(1, 500), v(1, 1000), v(1, 4000), v(1, 8000), v(1, 199), v(1, 999), v(1, 1001), v(1, 3999),
+            v(1, 7999), w(1, ints(0, 9000)));
+
+    static final Generator<LongStr> LONG_STR = tuples(LONG_BASE, ints(-2, 2), maybe(50, (Integer) null, ints(-3, 1)), LONG_TAPE)
+            .map(t -> new LongStr(t.value1(), t.value2(), t.value3(), t.value4()));
+
+    /** The string accessor asked for a long value (readString is not offered by the non-blocking parser: getString instead). */
+    enum StrAcc { GET_STRING, CHARACTERS, WRITER, READ_STRING }
+
+    /** A long string written as a value or a name, then read back by one accessor through one source. */
+    record LongCase(LongStr str, Cfg cfg, boolean asName, List<Way> ways, StrAcc acc, Src src, Feed feed) {
+        List<Ev> events(String s) {
+            return asName
+                    ? List.of(new Ev("{", null, null), new Ev("name", s, null), new Ev("number", 1, "1"), new Ev("}", null, null))
+                    : List.of(new Ev("[", null, null), new Ev("string", s, null), new Ev("]", null, null));
+        }
+    }
+
+    static final Generator<LongCase> LONG_CASE = tuples(LONG_STR, CFG, chance(30), WAYS, pick(StrAcc.values()), SRC, FEED)
+            .map(t -> new LongCase(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6(), t.value7()));
+
+    /** Reads the long string back through the source with the accessor. */
+    static void checkLongString(TestCase tc, LongCase lc, String s, String text) {
+        Src src = lc.src();
+        Cfg c = lc.cfg();
+        Zoo.assume(tc, !(src.bytes() && hasLoneSurrogate(text)), "bytes cannot carry a lone surrogate");
+        if (Zoo.NO_KNOWN) {
+            Zoo.assume(tc, !(src.bytes() && lc.asName() && c.escapesLoneSurrogates() && hasLoneSurrogate(s)), "a lone-surrogate escape in a name for the byte parsers (jackson-core/3)");
+            Zoo.assume(tc, !(src == Src.ASYNC && hasSurrogateEscape(text)), "a surrogate escape fed in pieces to the non-blocking parser (jackson-core/11)");
+        }
+        JsonFactory f = new JsonFactory();
+        try (Tokens t = new Tokens(f, src, text, lc.feed())) {
+            JsonParser p = t.p;
+            t.next();
+            JsonToken tok = t.next();
+            if (lc.asName()) {
+                check(tok == JsonToken.PROPERTY_NAME && p.currentName().equals(s), () -> src + ": name of " + s.length() + " chars read back differently: " + firstDifference(p.currentName(), s));
+                check(p.getString().equals(s), () -> src + ": getString of the name differs: " + firstDifference(p.getString(), s));
+            } else {
+                check(tok == JsonToken.VALUE_STRING, () -> src + ": token " + tok);
+                StrAcc acc = lc.acc() == StrAcc.READ_STRING && src == Src.ASYNC ? StrAcc.GET_STRING : lc.acc();
+                switch (acc) {
+                    case CHARACTERS -> {
+                        char[] cs = p.getStringCharacters();
+                        String got = new String(cs, p.getStringOffset(), p.getStringLength());
+                        check(got.equals(s), () -> src + ": getStringCharacters/Offset/Length of " + s.length() + " chars differs: " + firstDifference(got, s));
+                    }
+                    case WRITER -> {
+                        StringWriter w = new StringWriter();
+                        int count = p.getString(w);
+                        check(count == s.length() && w.toString().equals(s), () -> src + ": getString(Writer) wrote " + count + " chars: " + firstDifference(w.toString(), s));
+                    }
+                    case READ_STRING -> {
+                        StringWriter w = new StringWriter();
+                        long count = p.readString(w);
+                        check(count == s.length() && w.toString().equals(s), () -> src + ": readString(Writer) wrote " + count + " chars: " + firstDifference(w.toString(), s));
+                    }
+                    default -> {
+                        String got = p.getString();
+                        check(got.equals(s), () -> src + ": getString of " + s.length() + " chars differs: " + firstDifference(got, s));
+                    }
+                }
+            }
+            while (t.next() != null) {
+                // drain
+            }
+        } catch (JacksonException | IllegalStateException e) {
+            fail(src + ": threw " + e + " for a " + s.length() + "-char string (cfg " + c + ")");
+        }
+    }
+
+    @Test
+    void longStringsCrossTheBufferBoundaries() {
+        Zoo.run("longStringsCrossTheBufferBoundaries", tc -> {
+            LongCase lc = tc.draw(LONG_CASE);
+            String s = lc.str().render();
+            List<Ev> evs = lc.events(s);
+            String text = checkGenerated(evs, lc.ways(), false, lc.cfg());
+            if (text == null) {
+                return;
+            }
+            checkLongString(tc, lc, s, text);
+        });
+    }
+
+    static String firstDifference(String got, String want) {
+        if (got == null) {
+            return "got null";
+        }
+        int i = 0;
+        while (i < got.length() && i < want.length() && got.charAt(i) == want.charAt(i)) {
+            i++;
+        }
+        return "lengths " + got.length() + " vs " + want.length() + ", first difference at " + i + ": got " + show(got.substring(i, Math.min(got.length(), i + 12)))
+                + " expected " + show(want.substring(i, Math.min(want.length(), i + 12)));
+    }
+
+    // ------------------------------------------------------------------ 5. base64
+
+    static final Generator<Base64Variant> VARIANT = pick(Base64Variants.MIME, Base64Variants.MIME_NO_LINEFEEDS, Base64Variants.PEM, Base64Variants.MODIFIED_FOR_URL);
+
+    /** Bytes: a few, some, exactly at the line-feed and buffer boundaries, or up to 6000. */
+    static final Generator<byte[]> DATA = weighted(w(1, binary().maxSize(20)), w(1, binary().maxSize(200)),
+            w(1, pick(56, 57, 58, 2999, 3000, 3001, 4000).flatMap(n -> binary().minSize(n).maxSize(n))), w(1, binary().maxSize(6000)));
+
+    /** The writeBinary method: the array, an offset into a padded copy, a stream, a throttled stream, the default variant's method. */
+    enum BinWay { ARRAY, OFFSET, STREAM, THROTTLED, DEFAULT }
+
+    /** A binary case: the bytes, the variant, the generator, how it is written and how the parser reads it back. */
+    record Bin(byte[] data, Base64Variant variant, boolean utf8, BinWay way, int throttle, boolean viaGet, Src src, Feed feed) {}
+
+    static final Generator<Bin> BIN = tuples(DATA, VARIANT, chance(50), pick(BinWay.values()), pick(1, 3, 7, 100), chance(50), SRC, FEED)
+            .map(t -> new Bin(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6(), t.value7(), t.value8()));
+
+    static void writeBinary(JsonGenerator g, Bin b) throws IOException {
+        byte[] data = b.data();
+        Base64Variant bv = b.variant();
+        BinWay way = b.way() == BinWay.DEFAULT && bv != Base64Variants.MIME_NO_LINEFEEDS ? BinWay.ARRAY : b.way(); // writeBinary(byte[]) uses the default variant
+        switch (way) {
+            case OFFSET -> {
+                byte[] padded = new byte[data.length + 5];
+                System.arraycopy(data, 0, padded, 3, data.length);
+                g.writeBinary(bv, padded, 3, data.length);
+            }
+            case STREAM -> g.writeBinary(bv, new ByteArrayInputStream(data), data.length);
+            case THROTTLED -> g.writeBinary(bv, new ThrottledStream(new ByteArrayInputStream(data), b.throttle()), data.length);
+            case DEFAULT -> g.writeBinary(data);
+            default -> g.writeBinary(bv, data, 0, data.length);
+        }
+    }
+
+    @Test
+    void binaryRoundTripsThroughEveryBase64Variant() {
+        Zoo.run("binaryRoundTripsThroughEveryBase64Variant", tc -> {
+            Bin b = tc.draw(BIN);
+            byte[] data = b.data();
+            int len = data.length;
+            Base64Variant bv = b.variant();
+            String encoded = bv.encode(data, false);
+            // the variant round-trips on its own
+            check(Arrays.equals(bv.decode(bv.encode(data, false, "\n")), data), () -> bv + ": decode(encode) differs for " + len + " bytes");
+            // the generator writes exactly the variant's encoding (line feeds JSON-escaped)
+            JsonFactory f = new JsonFactory();
+            String text;
+            try {
+                if (b.utf8()) {
+                    ByteArrayOutputStream out = new ByteArrayOutputStream();
+                    try (JsonGenerator g = f.createGenerator(ObjectWriteContext.empty(), out)) {
+                        g.writeStartArray();
+                        writeBinary(g, b);
+                        g.writeEndArray();
+                    }
+                    text = out.toString(StandardCharsets.UTF_8);
+                } else {
+                    StringWriter sw = new StringWriter();
+                    try (JsonGenerator g = f.createGenerator(ObjectWriteContext.empty(), sw)) {
+                        g.writeStartArray();
+                        writeBinary(g, b);
+                        g.writeEndArray();
+                    }
+                    text = sw.toString();
+                }
+            } catch (JacksonException | IOException e) {
+                fail(bv + ": generator threw " + e + " for " + len + " bytes");
+                return;
+            }
+            final String doc = text;
+            String want = "[\"" + encoded + "\"]";
+            check(doc.equals(want), () -> bv + (b.utf8() ? " utf8" : " writer") + ": wrote " + firstDifference(doc, want));
+            // and the drawn parser decodes it back
+            Src src = b.src();
+            try (Tokens t = new Tokens(f, src, doc, b.feed())) {
+                JsonParser p = t.p;
+                t.next();
+                JsonToken tok = t.next();
+                check(tok == JsonToken.VALUE_STRING, () -> src + ": token " + tok);
+                if (b.viaGet() || src == Src.ASYNC) {
+                    byte[] got = p.getBinaryValue(bv);
+                    check(Arrays.equals(got, data), () -> bv + " " + src + ": getBinaryValue gives " + got.length + " bytes, expected " + len + (got.length == len ? " (content differs)" : ""));
+                } else {
+                    ByteArrayOutputStream out = new ByteArrayOutputStream();
+                    int count = p.readBinaryValue(bv, out);
+                    check(count == len && Arrays.equals(out.toByteArray(), data), () -> bv + " " + src + ": readBinaryValue gives " + count + " bytes, expected " + len);
+                }
+                check(t.next() == JsonToken.END_ARRAY, () -> src + ": no END_ARRAY after the binary value");
+            } catch (JacksonException | IllegalStateException e) {
+                fail(bv + " " + src + ": parser threw " + e + " for " + len + " bytes");
+            }
+        });
+    }
+
+    // ------------------------------------------------------------------ 6. JsonPointer
+
+    static final String[] SEGMENTS = {"", "a", "b", "~", "/", "~0", "~1", "~2", "a/b", "a~b", "0", "1", "01", "00", "-", "10", "2147483647",
+        "2147483648", "9999999999", "99999999999", "1e0", "-1", " ", "a b", "é", "😀", "x\"y", "\\", "\n"};
+
+    static final Generator<String> SEGMENT = weighted(w(70, pick(SEGMENTS)), w(30, word("ab~/01 ", 0, 4)));
+
+    /** A pointer case: the segments, which of the numeric ones are appended as indexes, and a segment to append. */
+    record Ptr(List<String> segs, List<Boolean> byIndex, String extra) {}
+
+    static final Generator<Ptr> PTR = tuples(many(SEGMENT, 0, 6), many(chance(50), 0, 6), pick(SEGMENTS)).map(t -> new Ptr(t.value1(), t.value2(), t.value3()));
+
+    static String escapeSegment(String s) {
+        return s.replace("~", "~0").replace("/", "~1");
+    }
+
+    /** The documented index parse: digits only, no leading zero, at most 10 chars, within int range; else -1. */
+    static int indexOf(String seg) {
+        if (seg.isEmpty() || seg.length() > 10) {
+            return -1;
+        }
+        for (int i = 0; i < seg.length(); i++) {
+            if (seg.charAt(i) < '0' || seg.charAt(i) > '9') {
+                return -1;
+            }
+        }
+        if (seg.length() > 1 && seg.charAt(0) == '0') {
+            return -1;
+        }
+        long v = Long.parseLong(seg);
+        return v > Integer.MAX_VALUE ? -1 : (int) v;
+    }
+
+    @Test
+    void jsonPointersFollowTheDocumentedModel() {
+        Zoo.run("jsonPointersFollowTheDocumentedModel", tc -> {
+            Ptr pc = tc.draw(PTR);
+            List<String> segs = pc.segs();
+            StringBuilder sb = new StringBuilder();
+            for (String s : segs) {
+                sb.append('/').append(escapeSegment(s));
+            }
+            String expr = sb.toString();
+            JsonPointer ptr = JsonPointer.compile(expr);
+            check(ptr.toString().equals(expr), () -> "compile(" + show(expr) + ").toString() = " + show(ptr.toString()));
+            check(ptr.length() == expr.length(), () -> "length of " + show(expr) + " = " + ptr.length());
+            check(ptr.matches() == segs.isEmpty(), () -> show(expr) + ".matches() = " + ptr.matches());
+            check(JsonPointer.compile(expr).equals(ptr) && JsonPointer.compile(expr).hashCode() == ptr.hashCode(), () -> "equals/hashCode for " + show(expr));
+            // built by appending, the same pointer
+            JsonPointer built = JsonPointer.empty();
+            for (int i = 0; i < segs.size(); i++) {
+                String s = segs.get(i);
+                int idx = indexOf(s);
+                built = idx >= 0 && tape(pc.byIndex(), i, false) ? built.appendIndex(idx) : built.appendProperty(s);
+            }
+            final JsonPointer b = built;
+            check(b.equals(ptr) && b.toString().equals(expr), () -> "appended " + show(b.toString()) + " expected " + show(expr));
+            // walking the segments
+            JsonPointer cur = ptr;
+            for (int i = 0; i < segs.size(); i++) {
+                String s = segs.get(i);
+                final JsonPointer here = cur;
+                final int i2 = i;
+                check(!here.matches(), () -> "segment " + i2 + " of " + show(expr) + ": matches() early");
+                check(s.equals(here.getMatchingProperty()), () -> "segment " + i2 + " of " + show(expr) + ": property " + show(here.getMatchingProperty()) + " expected " + show(s));
+                check(here.getMatchingIndex() == indexOf(s), () -> "segment " + i2 + " of " + show(expr) + ": index " + here.getMatchingIndex() + " expected " + indexOf(s));
+                check(here.mayMatchProperty(), () -> "segment " + i2 + " of " + show(expr) + ": mayMatchProperty false");
+                check(here.mayMatchElement() == (indexOf(s) >= 0), () -> "segment " + i2 + " of " + show(expr) + ": mayMatchElement " + here.mayMatchElement());
+                check(here.matchesProperty(s), () -> "segment " + i2 + " of " + show(expr) + ": matchesProperty(" + show(s) + ") false");
+                check(here.matchesElement(indexOf(s)) == (indexOf(s) >= 0), () -> "segment " + i2 + " of " + show(expr) + ": matchesElement(" + indexOf(s) + ")");
+                String other = s + "x";
+                check(!here.matchesProperty(other) && here.matchProperty(other) == null, () -> "segment " + i2 + " of " + show(expr) + ": matches " + show(other));
+                JsonPointer tail = here.tail();
+                JsonPointer viaMatch = here.matchProperty(s);
+                check(tail != null && tail.equals(viaMatch), () -> "segment " + i2 + " of " + show(expr) + ": tail " + tail + " vs matchProperty " + viaMatch);
+                String tailExpr = expr.substring(expr.length() - tail.length());
+                check(tail.toString().equals(tailExpr), () -> "segment " + i2 + " of " + show(expr) + ": tail " + show(tail.toString()) + " expected " + show(tailExpr));
+                cur = tail;
+            }
+            final JsonPointer end = cur;
+            check(end.matches() && end.toString().isEmpty(), () -> "after the segments of " + show(expr) + ": " + end);
+            // head and last
+            if (!segs.isEmpty()) {
+                JsonPointer head = ptr.head();
+                String headExpr = expr.substring(0, expr.length() - 1 - escapeSegment(segs.get(segs.size() - 1)).length());
+                check(head != null && head.toString().equals(headExpr), () -> "head of " + show(expr) + " = " + head + " expected " + show(headExpr));
+                JsonPointer last = ptr.last();
+                String lastExpr = "/" + escapeSegment(segs.get(segs.size() - 1));
+                check(last != null && last.toString().equals(lastExpr) && last.getMatchingProperty().equals(segs.get(segs.size() - 1)),
+                        () -> "last of " + show(expr) + " = " + last + " expected " + show(lastExpr));
+                check(head.append(last).equals(ptr), () -> "head.append(last) of " + show(expr) + " = " + head.append(last));
+                check(ptr.startsWith(head), () -> show(expr) + " does not startsWith its head " + head);
+            } else {
+                check(ptr.head() == null && ptr.last() == null, () -> "head/last of the empty pointer: " + ptr.head() + " / " + ptr.last());
+            }
+            // append of an arbitrary tail
+            JsonPointer extra = JsonPointer.compile("/" + escapeSegment(pc.extra()));
+            check(ptr.append(extra).toString().equals(expr + extra), () -> show(expr) + ".append(" + extra + ") = " + ptr.append(extra));
+            check(ptr.append(JsonPointer.empty()).equals(ptr) && JsonPointer.empty().append(ptr).equals(ptr), () -> "append(empty) for " + show(expr));
+        });
+    }
