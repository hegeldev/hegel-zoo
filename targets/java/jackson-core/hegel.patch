+    // ------------------------------------------------------------------ 2. strict parsers vs the reference
+
+    /**
+     * True when the character at {@code at} directly follows a one-digit root number ({@code 1-40}, {@code -1[]}, {@code 0"a"}):
+     * the non-blocking parser accepts a second root value there without the separating space every blocking parser demands.
+     */
+    /** Whether the root value ending at {@code at} is an integer lexeme (no fraction or exponent) that the next value follows directly. */
+    static boolean integerRunsIntoTheNextRootValue(String doc, int at) {
+        int i = at;
+        while (i > 0 && "0123456789.eE+-".indexOf(doc.charAt(i - 1)) >= 0) {
+            i--;
+        }
+        return doc.substring(i, at).matches("-?[0-9]+");
+    }
