+            String text = generate(tc, all, c, pp);
+            if (text == null) {
+                return;
+            }
+            String description = defaults ? "defaults" : obj + " " + arr + " " + sep.getObjectNameValueSpacing() + "/" + sep.getObjectEntrySpacing() + "/" + sep.getArrayElementSpacing();
+            check(text.equals(want.toString()), () -> "pretty (" + description + ") " + firstDifference(text, want.toString()) + " for " + Ref.show(denoted)
+                    + " got " + show(text) + " want " + show(want.toString()));
+            if (standard || defaults) {
