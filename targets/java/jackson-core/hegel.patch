diff --git a/hegel/pom.xml b/hegel/pom.xml
new file mode 100644
index 0000000..2a4e4bf
--- /dev/null
+++ b/hegel/pom.xml
@@ -0,0 +1,67 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<!-- Hegel zoo: property-based tests for jackson-core against the library built from this checkout
+     (`mvn -DskipTests install` at the root first; see targets/java/jackson-core in the zoo). -->
+<project xmlns="http://maven.apache.org/POM/4.0.0"
+         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
+         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
+  <modelVersion>4.0.0</modelVersion>
+  <groupId>dev.hegel.zoo</groupId>
+  <artifactId>jackson-core-hegel</artifactId>
+  <version>0</version>
+  <packaging>jar</packaging>
+
+  <properties>
+    <maven.compiler.release>22</maven.compiler.release>
+    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
+    <jackson.version>3.3.0-SNAPSHOT</jackson.version>
+    <hegel.version>0.6.0</hegel.version>
+    <junit.version>5.11.4</junit.version>
+  </properties>
+
+  <dependencies>
+    <dependency>
+      <groupId>tools.jackson.core</groupId>
+      <artifactId>jackson-core</artifactId>
+      <version>${jackson.version}</version>
+    </dependency>
+    <dependency>
+      <groupId>dev.hegel</groupId>
+      <artifactId>hegel</artifactId>
+      <version>${hegel.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.jupiter</groupId>
+      <artifactId>junit-jupiter</artifactId>
+      <version>${junit.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.platform</groupId>
+      <artifactId>junit-platform-launcher</artifactId>
+      <version>1.11.4</version>
+      <scope>test</scope>
+    </dependency>
+  </dependencies>
+
+  <build>
+    <plugins>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-compiler-plugin</artifactId>
+        <version>3.13.0</version>
+      </plugin>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-surefire-plugin</artifactId>
+        <version>3.5.2</version>
+        <configuration>
+          <argLine>--enable-native-access=ALL-UNNAMED</argLine>
+          <trimStackTrace>false</trimStackTrace>
+          <!-- every test's `ZOO …` line is what the zoo judges; Maven's exit code is not -->
+          <testFailureIgnore>true</testFailureIgnore>
+        </configuration>
+      </plugin>
+    </plugins>
+  </build>
+</project>
diff --git a/hegel/src/test/java/zoo/Gen.java b/hegel/src/test/java/zoo/Gen.java
new file mode 100644
index 0000000..6302163
--- /dev/null
+++ b/hegel/src/test/java/zoo/Gen.java
@@ -0,0 +1,145 @@
+package zoo;
+
+import static dev.hegel.Generators.integers;
+import static dev.hegel.Generators.just;
+import static dev.hegel.Generators.lists;
+import static dev.hegel.Generators.sampledFrom;
+import static dev.hegel.Generators.tuples;
+
+import dev.hegel.Generator;
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * The combinators the binding lacks: weighted choice, a biased coin, an optional with a probability, int ranges,
+ * bounded lists, words over an alphabet, a tuple of any arity, and positions taken modulo a live size.
+ */
+final class Gen {
+    private Gen() {}
+
+    /** A weighted alternative for {@link #weighted}; the generator may produce a subtype of the choice's type. */
+    record Choice<T>(int weight, Generator<? extends T> gen) {}
+
+    static <T> Choice<T> w(int weight, Generator<? extends T> gen) {
+        return new Choice<>(weight, gen);
+    }
+
+    /** A constant alternative. */
+    static <T> Choice<T> v(int weight, T value) {
+        return new Choice<>(weight, just(value));
+    }
+
+    /** All the generators, in order, as one list (a tuple of any arity). */
+    static <T> Generator<List<T>> all(List<Generator<T>> gens) {
+        Generator<List<T>> acc = just(List.of());
+        for (Generator<T> g : gens) {
+            acc = tuples(acc, g).map(t -> {
+                List<T> out = new ArrayList<>(t.value1());
+                out.add(t.value2());
+                return out;
+            });
+        }
+        return acc;
+    }
+
+    /** One of the generators, chosen in proportion to the weights; one draw, shrinks towards the first. */
+    @SafeVarargs
+    static <T> Generator<T> weighted(Choice<T>... choices) {
+        return weighted(List.of(choices));
+    }
+
+    static <T> Generator<T> weighted(List<Choice<T>> cs) {
+        int total = 0;
+        for (Choice<T> c : cs) {
+            total += c.weight();
+        }
+        return ints(0, total - 1).flatMap(i -> {
+            int acc = 0;
+            for (Choice<T> c : cs) {
+                acc += c.weight();
+                if (i < acc) {
+                    return widen(c.gen());
+                }
+            }
+            throw new IllegalStateException("weighted: " + i + " beyond " + acc);
+        });
+    }
+
+    /** A generator of a subtype is a generator of the supertype: it only ever produces values. */
+    @SuppressWarnings("unchecked")
+    static <T> Generator<T> widen(Generator<? extends T> g) {
+        return (Generator<T>) g;
+    }
+
+    /** True with probability pct/100; shrinks to false. */
+    static Generator<Boolean> chance(int pct) {
+        return ints(0, 99).map(x -> x >= 100 - pct);
+    }
+
+    /** {@code absent} (weight 100 - pct), or a value of {@code present} (weight pct); shrinks to absent. */
+    static <T> Generator<T> maybe(int pct, T absent, Generator<? extends T> present) {
+        return weighted(w(100 - pct, just(absent)), w(pct, present));
+    }
+
+    /** The empty string, or a value of {@code present} with probability pct/100. */
+    static Generator<String> opt(int pct, Generator<String> present) {
+        return maybe(pct, "", present);
+    }
+
+    /** A value of the generator, or null with probability pct/100; shrinks to the generator's first value. */
+    static <T> Generator<T> orNull(int pct, Generator<? extends T> g) {
+        return weighted(w(100 - pct, g), v(pct, (T) null));
+    }
+
+    /** One of the values, equally likely; shrinks to the first. */
+    @SafeVarargs
+    static <T> Generator<T> pick(T... xs) {
+        return sampledFrom(xs);
+    }
+
+    /** An int in [lo, hi]; shrinks to lo. */
+    static Generator<Integer> ints(int lo, int hi) {
+        return integers().min(lo).max(hi);
+    }
+
+    /** A position, taken modulo the live size where it is used. */
+    static final Generator<Integer> INDEX = ints(0, 999);
+
+    /** lo..hi values of the generator. */
+    static <T> Generator<List<T>> many(Generator<T> g, int lo, int hi) {
+        return lists(g).minSize(lo).maxSize(hi);
+    }
+
+    /** One UTF-16 unit of the alphabet, as a string. */
+    static Generator<String> chars(String alphabet) {
+        List<String> cs = new ArrayList<>();
+        for (int i = 0; i < alphabet.length(); i++) {
+            cs.add(String.valueOf(alphabet.charAt(i)));
+        }
+        return sampledFrom(cs);
+    }
+
+    /** A string of lo..hi units drawn from the alphabet; shrinks to lo units of the first. */
+    static Generator<String> word(String alphabet, int lo, int hi) {
+        return many(chars(alphabet), lo, hi).map(Gen::join);
+    }
+
+    static String join(List<String> parts) {
+        return String.join("", parts);
+    }
+
+    /** The element of the list at a drawn position, modulo its size (the list must not be empty). */
+    static <T> T at(List<T> xs, int index) {
+        return xs.get(Math.floorMod(index, xs.size()));
+    }
+
+    /** The element of a tape at a position, modulo its length; {@code plain} when the tape is empty. */
+    static <T> T tape(List<T> xs, int index, T plain) {
+        return xs.isEmpty() ? plain : at(xs, index);
+    }
+
+    /** A drawn position mapped into [lo, hi] (lo when the range is empty). */
+    static int into(int index, int lo, int hi) {
+        return hi < lo ? lo : lo + Math.floorMod(index, hi - lo + 1);
+    }
+}
diff --git a/hegel/src/test/java/zoo/JacksonCoreShapesTest.java b/hegel/src/test/java/zoo/JacksonCoreShapesTest.java
new file mode 100644
index 0000000..e7c23c3
--- /dev/null
+++ b/hegel/src/test/java/zoo/JacksonCoreShapesTest.java
@@ -0,0 +1,372 @@
+package zoo;
+
+import static dev.hegel.Generators.booleans;
+import static dev.hegel.Generators.just;
+import static dev.hegel.Generators.tuples;
+import static zoo.Gen.chance;
+import static zoo.Gen.ints;
+import static zoo.Gen.many;
+import static zoo.Gen.opt;
+import static zoo.Gen.pick;
+import static zoo.Gen.v;
+import static zoo.Gen.w;
+import static zoo.Gen.weighted;
+import static zoo.Gen.word;
+import static zoo.JacksonCoreTest.BLOCKING_BYTES;
+import static zoo.JacksonCoreTest.CFG;
+import static zoo.JacksonCoreTest.FEED;
+import static zoo.JacksonCoreTest.NUM_FORMS;
+import static zoo.JacksonCoreTest.SMALL_FEED;
+import static zoo.JacksonCoreTest.SRC;
+import static zoo.JacksonCoreTest.checkAgrees;
+import static zoo.JacksonCoreTest.checkGenerated;
+import static zoo.JacksonCoreTest.checkLenient;
+import static zoo.JacksonCoreTest.checkLongString;
+import static zoo.JacksonCoreTest.checkNumber;
+import static zoo.JacksonCoreTest.events;
+import static zoo.JacksonCoreTest.readBack;
+
+import dev.hegel.Generator;
+import dev.hegel.Tuple2;
+import java.math.BigInteger;
+import java.util.List;
+import org.junit.jupiter.api.Test;
+import tools.jackson.core.json.JsonFactory;
+import tools.jackson.core.json.JsonReadFeature;
+import zoo.JacksonCoreTest.Acc;
+import zoo.JacksonCoreTest.Cfg;
+import zoo.JacksonCoreTest.Ev;
+import zoo.JacksonCoreTest.Feed;
+import zoo.JacksonCoreTest.Lenient;
+import zoo.JacksonCoreTest.LenientSpelling;
+import zoo.JacksonCoreTest.LongCase;
+import zoo.JacksonCoreTest.LongStr;
+import zoo.JacksonCoreTest.NumCase;
+import zoo.JacksonCoreTest.Src;
+import zoo.JacksonCoreTest.StrAcc;
+import zoo.JacksonCoreTest.StrWay;
+import zoo.JacksonCoreTest.Way;
+
+/**
+ * Hegel zoo: one narrow property per recorded jackson-core bug. Each draws random contents over the
+ * bug's shape region and judges them by the wide properties' oracles; under {@code HEGEL_NO_KNOWN=1}
+ * it draws the neighbouring region instead, which must pass.
+ */
+class JacksonCoreShapesTest {
+
+    /** The feeding of the blocking sources, where it does not matter. */
+    static final Feed WHOLE = new Feed(4096, List.of());
+
+    static final Generator<Feed> WHOLE_FEED = just(WHOLE);
+
+    static final Generator<String> LONE_SURROGATE = pick("\ud800", "\udc00", "\ud83d");
+
+    static final Generator<String> PAIR = pick("\ud83d\ude00", "\ud800\udc00", "\udbff\udfff");
+
+    /** A string with the middle piece in it. */
+    static Generator<String> around(Generator<String> middle, boolean lone) {
+        return tuples(Ref.string(lone), middle, Ref.string(lone)).map(t -> t.value1() + t.value2() + t.value3());
+    }
+
+    static Object entry(String name, Object value) {
+        return Ref.toMap(List.of(new Tuple2<>(name, value)));
+    }
+
+    // ------------------------------------------------------------------ jackson-core/1
+
+    static final Generator<Object> ROOT_SCALAR = Gen.<Object>weighted(v(1, Ref.NULL), w(1, booleans()), w(2, Ref.NUMBER.map(Ref.Num::of)));
+
+    /** A root number or literal with nothing after it (or the empty document); the neighbour has trailing whitespace. */
+    static final Generator<String> BARE_ROOT = Gen.<String>weighted(v(10, ""),
+            w(90, tuples(opt(50, pick(" ", "\n", "\t")), ROOT_SCALAR.map(Ref::show)).map(t -> t.value1() + t.value2())))
+            .map(doc -> Zoo.NO_KNOWN ? doc + " " : doc);
+
+    @Test
+    void dataInputParserReadsARootValueAtTheEndOfInput() {
+        Zoo.run("jackson-core.dataInputParserReadsARootValueAtTheEndOfInput", tc -> checkAgrees(tc, new JsonFactory(), Src.DATA_INPUT, WHOLE, tc.draw(BARE_ROOT)));
+    }
+
+    // ------------------------------------------------------------------ jackson-core/2
+
+    static final Generator<String> FP_LEXEME = JacksonCoreTest.LEXEME.filter(lex -> JacksonCoreTest.numberType(lex) == tools.jackson.core.JsonParser.NumberType.DOUBLE
+            && JacksonCoreTest.digitCount(lex) <= 1000);
+
+    /** A floating-point number asked for getNumberType and then getNumberValueExact; the neighbour asks in the other order. */
+    static final Generator<NumCase> EXACT_CASE = tuples(FP_LEXEME, chance(50), pick(" ", "\n", "\t", "\r\n"), chance(50), chance(50), SRC, FEED)
+            .map(t -> new NumCase(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), Acc.EXACT, t.value6(), t.value7()));
+
+    @Test
+    void numberValueExactIsExactAfterNumberType() {
+        Zoo.run("jackson-core.numberValueExactIsExactAfterNumberType", tc -> checkNumber(tc, tc.draw(EXACT_CASE), Zoo.NO_KNOWN));
+    }
+
+    // ------------------------------------------------------------------ jackson-core/3
+
+    /** An object whose name holds a lone surrogate, written by a generator that escapes it; the neighbour holds it in a value. */
+    record LoneName(Cfg cfg, String name, String other, Object value, List<Object> rest, Src src) {
+        Object object() {
+            List<Tuple2<String, Object>> entries = new java.util.ArrayList<>();
+            entries.add(Zoo.NO_KNOWN ? new Tuple2<>(other, (Object) name) : new Tuple2<>(name, value));
+            for (Object r : rest) {
+                entries.add(new Tuple2<>(other + entries.size(), r));
+            }
+            return Ref.toMap(entries);
+        }
+    }
+
+    static final Generator<LoneName> LONE_NAME = tuples(CFG.filter(Cfg::escapesLoneSurrogates), around(LONE_SURROGATE, false), Ref.string(false),
+            Ref.scalar(false), many(Ref.scalar(false), 0, 3), BLOCKING_BYTES)
+            .map(t -> new LoneName(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6()));
+
+    @Test
+    void byteParsersReadALoneSurrogateEscapeInAName() {
+        Zoo.run("jackson-core.byteParsersReadALoneSurrogateEscapeInAName", tc -> {
+            LoneName ln = tc.draw(LONE_NAME);
+            List<Ev> evs = events(ln.object(), List.of(), ln.cfg());
+            String text = checkGenerated(evs, List.of(), false, ln.cfg());
+            if (text != null) {
+                readBack(new JsonFactory(), ln.src(), WHOLE, text, evs, "cfg " + ln.cfg());
+            }
+        });
+    }
+
+    // ------------------------------------------------------------------ jackson-core/4
+
+    /** -0 in an array or followed by whitespace in the non-blocking parser; the neighbour reads -0.0 or 0. */
+    static final Generator<NumCase> MINUS_ZERO = tuples(Zoo.NO_KNOWN ? pick("-0.0", "0", "-0e0") : just("-0"), chance(50), pick(" ", "\n", "\t", "\r\n"), chance(50), chance(50),
+            pick(Acc.NUMBER_VALUE, Acc.DOUBLE, Acc.DECIMAL, Acc.INT, Acc.LONG), FEED)
+            .map(t -> new NumCase(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6(), Src.ASYNC, t.value7()));
+
+    @Test
+    void asyncParserKeepsTheSignOfMinusZero() {
+        Zoo.run("jackson-core.asyncParserKeepsTheSignOfMinusZero", tc -> checkNumber(tc, tc.draw(MINUS_ZERO), false));
+    }
+
+    // ------------------------------------------------------------------ jackson-core/5
+
+    /** A root string starting with NUL, spelled raw for the byte parsers; the neighbour has a character before the NUL. */
+    static final Generator<Lenient> NUL_FIRST = tuples(Zoo.NO_KNOWN ? word("ab1 ", 1, 3) : just(""), Ref.string(false), JacksonCoreTest.LENIENT_SPELLING, BLOCKING_BYTES)
+            .map(t -> new Lenient(JsonReadFeature.ALLOW_UNESCAPED_CONTROL_CHARS, t.value4(), t.value1() + "\u0000" + t.value2(), t.value3(), WHOLE));
+
+    @Test
+    void unescapedNulAtTheStartOfADocumentIsAString() {
+        Zoo.run("jackson-core.unescapedNulAtTheStartOfADocumentIsAString", tc -> checkLenient(tc, tc.draw(NUL_FIRST)));
+    }
+
+    // ------------------------------------------------------------------ jackson-core/6
+
+    static final BigInteger TWO_63 = BigInteger.ONE.shiftLeft(63);
+
+    /** A fraction just beyond the long range whose double is 2^63; the neighbour is just inside it. */
+    static final Generator<String> BEYOND_LONG = tuples(chance(20), ints(0, 1000), word(Ref.DIGITS, 1, 6)).map(t -> {
+        boolean neg = t.value1();
+        int k = neg ? Math.max(1, t.value2()) : t.value2();
+        BigInteger magnitude = Zoo.NO_KNOWN ? TWO_63.subtract(BigInteger.valueOf(1 + k)) : TWO_63.add(BigInteger.valueOf(k));
+        return (neg ? "-" : "") + magnitude + "." + t.value3();
+    });
+
+    static final Generator<NumCase> LONG_EDGE = tuples(BEYOND_LONG, chance(50), pick(" ", "\n", "\t", "\r\n"), chance(50), chance(50), SRC, FEED)
+            .map(t -> new NumCase(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), Acc.LONG, t.value6(), t.value7()));
+
+    @Test
+    void longValueRejectsAFractionBeyondTheLongRange() {
+        Zoo.run("jackson-core.longValueRejectsAFractionBeyondTheLongRange", tc -> checkNumber(tc, tc.draw(LONG_EDGE), false));
+    }
+
+    // ------------------------------------------------------------------ jackson-core/7
+
+    /** A surrogate pair straddling a 4000-char read of writeString(Reader); the neighbour places it inside a read. */
+    static final Generator<LongStr> PAIR_AT_READ = tuples(pick(4000, 8000), ints(0, 30), Zoo.NO_KNOWN ? pick(-20, -2, 5) : just(-1), JacksonCoreTest.LONG_TAPE)
+            .map(t -> new LongStr(t.value1(), t.value2(), t.value3(), t.value4()));
+
+    static final Generator<Way> READER_WAY = tuples(pick(StrWay.READER, StrWay.READER_SIZED), chance(30), chance(50), chance(50))
+            .map(t -> new Way(t.value1(), t.value2(), t.value3(), t.value4()));
+
+    static final Generator<LongCase> READER_CASE = tuples(PAIR_AT_READ, CFG, READER_WAY, pick(StrAcc.values()), SRC, FEED)
+            .map(t -> new LongCase(t.value1(), t.value2(), false, List.of(JacksonCoreTest.PLAIN_WAY, t.value3()), t.value4(), t.value5(), t.value6()));
+
+    @Test
+    void writeStringFromAReaderKeepsSurrogatePairsTogether() {
+        Zoo.run("jackson-core.writeStringFromAReaderKeepsSurrogatePairsTogether", tc -> {
+            LongCase lc = tc.draw(READER_CASE);
+            String s = lc.str().render();
+            List<Ev> evs = lc.events(s);
+            String text = checkGenerated(evs, lc.ways(), false, lc.cfg());
+            if (text != null) {
+                checkLongString(tc, lc, s, text);
+            }
+        });
+    }
+
+    // ------------------------------------------------------------------ jackson-core/8
+
+    /** The UTF-8 generator with the default table (the only one pre-encoded strings are written with). */
+    static final Generator<Cfg> UTF8_PLAIN = tuples(chance(30), chance(30), chance(80)).map(t -> new Cfg(true, false, false, true, t.value1(), t.value2(), t.value3()));
+
+    /** A string with a lone surrogate written as a SerializedString value or name; the neighbour's surrogates are paired. */
+    record Serialized(Cfg cfg, String s, boolean asName, Object value, boolean sizedStart) {
+        List<Ev> events() {
+            return asName
+                    ? List.of(new Ev("{", null, null), new Ev("name", s, null), new Ev("string", value, null), new Ev("}", null, null))
+                    : List.of(new Ev("[", null, null), new Ev("string", s, null), new Ev("string", value, null), new Ev("]", null, null));
+        }
+
+        List<Way> ways() {
+            return List.of(new Way(StrWay.STRING, false, sizedStart, false), new Way(StrWay.SERIALIZED, true, false, false));
+        }
+    }
+
+    static final Generator<Serialized> SERIALIZED = tuples(UTF8_PLAIN, around(Zoo.NO_KNOWN ? PAIR : LONE_SURROGATE, true), chance(50), Ref.string(false), chance(50))
+            .map(t -> new Serialized(t.value1(), t.value2(), t.value3(), t.value4(), t.value5()));
+
+    @Test
+    void serializedStringWithALoneSurrogateIsEscaped() {
+        Zoo.run("jackson-core.serializedStringWithALoneSurrogateIsEscaped", tc -> {
+            Serialized sc = tc.draw(SERIALIZED);
+            checkGenerated(sc.events(), sc.ways(), false, sc.cfg());
+        });
+    }
+
+    // ------------------------------------------------------------------ jackson-core/9 and /10
+
+    static final Generator<String> ASCII_FIRST = pick("a", "1", "<", "'", " ", "=");
+
+    static final Generator<String> MULTI_BYTE_FIRST = pick("\u00e9", "\u65e5", "\u2029", "\u00a0", "\ud83d\ude00");
+
+    /** A string starting with the character a backslash goes before, hosted anywhere, with the lenient spelling. */
+    static Generator<Lenient> backslashCase(Generator<String> first, Generator<Src> src) {
+        Generator<Object> seed = tuples(first, Ref.string(false)).map(t -> (Object) (t.value1() + t.value2()));
+        return tuples(src, JacksonCoreTest.host(seed, false), JacksonCoreTest.LENIENT_SPELLING, SMALL_FEED)
+                .map(t -> new Lenient(JsonReadFeature.ALLOW_BACKSLASH_ESCAPING_ANY_CHARACTER, t.value1(), t.value2(), t.value3(), t.value4()));
+    }
+
+    /** A backslash before a 4-byte character for the blocking byte parsers; the neighbour escapes an ASCII character. */
+    static final Generator<Lenient> FOUR_BYTE_ESCAPE = backslashCase(Zoo.NO_KNOWN ? ASCII_FIRST : PAIR, BLOCKING_BYTES);
+
+    @Test
+    void byteParsersReadAnEscapedFourByteCharacter() {
+        Zoo.run("jackson-core.byteParsersReadAnEscapedFourByteCharacter", tc -> checkLenient(tc, tc.draw(FOUR_BYTE_ESCAPE)));
+    }
+
+    /** A backslash before a multi-byte character for the non-blocking parser; the neighbour escapes an ASCII character. */
+    static final Generator<Lenient> MULTI_BYTE_ESCAPE = backslashCase(Zoo.NO_KNOWN ? ASCII_FIRST : MULTI_BYTE_FIRST, just(Src.ASYNC));
+
+    @Test
+    void asyncParserReadsAnEscapedMultiByteCharacter() {
+        Zoo.run("jackson-core.asyncParserReadsAnEscapedMultiByteCharacter", tc -> checkLenient(tc, tc.draw(MULTI_BYTE_ESCAPE)));
+    }
+
+    // ------------------------------------------------------------------ jackson-core/11
+
+    /**
+     * An object whose name spells a surrogate pair as two escapes, fed to the non-blocking parser with a feed
+     * ending inside the low surrogate's escape (1..5 bytes after its backslash); the neighbour's feed ends
+     * just before or just after the escape.
+     */
+    record EscapedPairName(String before, String pair, String after, Object value, int offset, List<Integer> moreCuts) {
+        String doc() {
+            String head = Ref.quote(before, Ref.PLAIN);
+            return "{" + head.substring(0, head.length() - 1) + escape() + Ref.quote(after, Ref.PLAIN).substring(1) + ":" + Ref.write(value, Ref.PLAIN) + "}";
+        }
+
+        String escape() {
+            return String.format("\\u%04X\\u%04X", (int) pair.charAt(0), (int) pair.charAt(1));
+        }
+
+        /** The byte position of the low surrogate's backslash. */
+        int lowEscapeAt() {
+            String head = Ref.quote(before, Ref.PLAIN);
