+    @Test
+    void generatorEventsReadBackThroughEveryParser() {
+        Zoo.run("generatorEventsReadBackThroughEveryParser", tc -> {
+            Written w = tc.draw(WRITTEN);
+            Cfg c = w.cfg();
+            List<Ev> evs = events(w.value(), w.forms(), c);
+            String text = checkGenerated(evs, w.ways(), w.flush(), c);
+            if (text == null) {
+                return;
+            }
+            // the reference reads the text as the denoted value
+            Object parsed;
+            try {
+                parsed = Ref.parse(text);
+            } catch (Ref.Bad e) {
+                fail("generator (" + c + ") produced invalid JSON " + show(text) + ": " + e.getMessage());
+                return;
+            }
+            Object want = denoted(evs);
+            check(Ref.same(parsed, want, true), () -> "text " + show(text) + " denotes " + Ref.show(parsed) + " expected " + Ref.show(want));
+            // the drawn parser kind reads the events back
+            Src src = w.src();
+            Zoo.assume(tc, !(src.bytes() && hasLoneSurrogate(text)), "bytes cannot carry a lone surrogate");
+            if (Zoo.NO_KNOWN) {
+                Zoo.assume(tc, !(src == Src.DATA_INPUT && endsInBareScalar(text)), "a root number or literal at the end of a DataInput (jackson-core/1)");
+                Zoo.assume(tc, !(src.bytes() && c.escapesLoneSurrogates() && nameHasLoneSurrogate(evs)), "a lone-surrogate escape in a name for the byte parsers (jackson-core/3)");
+                Zoo.assume(tc, !(src == Src.ASYNC && hasSurrogateEscape(text)), "a surrogate escape fed in pieces to the non-blocking parser (jackson-core/11)");
+            }
+            readBack(w.parserFactory(), src, w.feed(), text, evs, "cfg " + c);
+        });
+    }
