+        /** The first feed ends offset bytes after the low escape's backslash (a cut is 1 + its value); the rest follow the drawn cuts. */
+        Feed feed() {
+            List<Integer> cuts = new java.util.ArrayList<>();
+            cuts.add(lowEscapeAt() + offset - 1);
+            cuts.addAll(moreCuts);
+            return new Feed(4096, cuts);
+        }
+    }
+
+    static final Generator<EscapedPairName> ESCAPED_PAIR_NAME = tuples(Ref.string(false), PAIR, Ref.string(false), Ref.value(2, false),
+            Zoo.NO_KNOWN ? pick(0, 6) : ints(1, 5), many(Gen.INDEX, 0, 4))
