+    /** IsValidOp agrees with the exact SFS rules on polygons with a touching or crossing hole and on two-part multipolygons. */
+    @Test
+    void validityIsExact() {
+        Hegel.test(tc -> {
+            GeoGen g = new GeoGen(tc);
+            LinearRing shell = g.simpleRing();
+            P[] sp = Exact.ring(shell);
+            LinearRing other = g.nearRing(shell);
+            P[] op = Exact.ring(other);
+            if (chance(tc, 50)) {
+                Polygon poly = GF.createPolygon(shell, new LinearRing[] {other});
+                Boolean e = exactValid(sp, op);
+                if (e != null) {
+                    boolean valid = poly.isValid();
+                    check(valid == e, () -> "isValid(" + wkt(poly) + ") = " + valid + ", exactly " + e + (valid ? "" : ": " + new IsValidOp(poly).getValidationError()));
+                    if (valid) {
+                        Geometry fixed = GeometryFixer.fix(poly);
+                        check(Exact.close(fixed.getArea(), Exact.area(poly).toDouble(), 1e-9), () -> "GeometryFixer changes the valid " + wkt(poly) + " into " + wkt(fixed));
+                        double areaE = Exact.area(poly).toDouble();
+                        check(Exact.close(poly.getArea(), areaE, 1e-9), () -> "getArea of " + wkt(poly) + " = " + poly.getArea() + ", exactly " + areaE);
+                    }
+                }
+            } else {
+                Polygon p1 = GF.createPolygon(shell);
+                Polygon p2 = GF.createPolygon(other);
+                MultiPolygon mp = GF.createMultiPolygon(new Polygon[] {p1, p2});
+                Boolean e = exactValidMulti(sp, op);
+                if (e != null) {
+                    boolean valid = mp.isValid();
+                    check(valid == e, () -> "isValid(" + wkt(mp) + ") = " + valid + ", exactly " + e + (valid ? "" : ": " + new IsValidOp(mp).getValidationError()));
+                    if (e) {
+                        double areaE = Exact.area(p1).add(Exact.area(p2)).toDouble();
+                        check(Exact.close(mp.getArea(), areaE, 1e-9), () -> "getArea of " + wkt(mp) + " = " + mp.getArea() + ", exactly " + areaE);
+                        Geometry u = mp.union();
+                        check(Exact.close(u.getArea(), areaE, 1e-9 * Math.max(1, g.range) * Math.max(1, g.range)), () -> "union() of the valid " + wkt(mp) + " has area " + u.getArea() + ", the parts sum to " + areaE + ": " + wkt(u));
+                        // the two parts touch at most at points: relate is FF2F01212 (touching) or FF2FF1212 (disjoint)
+                        IntersectionMatrix im = p1.relate(p2);
+                        check(im.matches("FF2F*1212"), () -> "relate of the parts of the valid " + wkt(mp) + " is " + im);
