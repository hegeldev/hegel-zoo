+            check(prepNg.evaluate(b).toString().equals(ng.toString()), () -> "RelateNG.prepare(a).evaluate(b) = " + prepNg.evaluate(b) + ", RelateNG.relate = " + ng + " for " + pair);
+
+            // exact intersects and distance
+            boolean exInt = exactIntersects(a, b);
+            check(a.intersects(b) == exInt, () -> "intersects = " + a.intersects(b) + ", exactly " + exInt + " for " + pair + " (matrix " + old + ")");
+            double dist = a.distance(b);
+            double distE = exactDistance(a, b);
+            check(Exact.close(dist, distE, 1e-9), () -> "distance = " + dist + ", exactly " + distE + " for " + pair);
+            Coordinate[] near = DistanceOp.nearestPoints(a, b);
+            double nd = near[0].distance(near[1]);
+            check(Exact.close(nd, distE, 1e-9), () -> "DistanceOp.nearestPoints gives " + near[0] + " and " + near[1] + " at " + nd + ", the distance is " + distE + " for " + pair);
+            if (da < 2 && db < 2) {
