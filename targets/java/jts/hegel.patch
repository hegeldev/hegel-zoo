+<?xml version="1.0" encoding="UTF-8"?>
+<!-- Hegel property tests for the JTS Topology Suite, added by the Hegel zoo (targets/java/jts). Runs against the
+     org.locationtech.jts:jts-core and jts-io-common artifacts that `[run] setup` installs from this checkout into
+     the local Maven repository; exact rational arithmetic (BigInteger) and JTS's own alternative algorithms
+     (RelateOp/RelateNG, OverlayOp/OverlayNG, prepared geometries) are the oracles. -->
+<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
+         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
+  <modelVersion>4.0.0</modelVersion>
+
+  <groupId>dev.hegel.zoo</groupId>
+  <artifactId>jts-hegel</artifactId>
+  <version>0</version>
+  <packaging>jar</packaging>
+
+  <properties>
+    <maven.compiler.release>22</maven.compiler.release>
+    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
+    <jts.version>1.21.0-SNAPSHOT</jts.version>
+    <hegel.version>0.6.0</hegel.version>
+    <junit.version>5.11.4</junit.version>
+  </properties>
+
+  <dependencies>
+    <dependency>
+      <groupId>org.locationtech.jts</groupId>
+      <artifactId>jts-core</artifactId>
+      <version>${jts.version}</version>
+    </dependency>
+    <dependency>
+      <groupId>org.locationtech.jts.io</groupId>
+      <artifactId>jts-io-common</artifactId>
+      <version>${jts.version}</version>
+    </dependency>
+    <dependency>
+      <groupId>dev.hegel</groupId>
+      <artifactId>hegel</artifactId>
+      <version>${hegel.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.jupiter</groupId>
+      <artifactId>junit-jupiter</artifactId>
+      <version>${junit.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.platform</groupId>
+      <artifactId>junit-platform-launcher</artifactId>
+      <version>1.11.4</version>
+      <scope>test</scope>
+    </dependency>
+  </dependencies>
+
+  <build>
+    <plugins>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-compiler-plugin</artifactId>
+        <version>3.13.0</version>
+      </plugin>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-surefire-plugin</artifactId>
+        <version>3.5.2</version>
+        <configuration>
+          <argLine>-XX:-OmitStackTraceInFastThrow -Xmx1g -Xss4m</argLine>
+          <testFailureIgnore>true</testFailureIgnore>
+          <trimStackTrace>false</trimStackTrace>
+        </configuration>
+      </plugin>
+    </plugins>
+  </build>
+</project>
diff --git a/hegel/src/test/java/zoo/Exact.java b/hegel/src/test/java/zoo/Exact.java
new file mode 100644
index 0000000..11c085a
--- /dev/null
+++ b/hegel/src/test/java/zoo/Exact.java
@@ -0,0 +1,542 @@
+package zoo;
+
+import java.math.BigDecimal;
+import java.math.BigInteger;
+import java.math.MathContext;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import org.locationtech.jts.geom.Coordinate;
+import org.locationtech.jts.geom.LinearRing;
+import org.locationtech.jts.geom.Polygon;
+
+/**
+ * Exact planar geometry over rationals: every double is converted exactly ({@code new BigDecimal(double)}), so
+ * orientation, intersection, point location, area, length and distance are computed without rounding. This is the
+ * oracle for JTS's robust predicates and measures.
+ */
+final class Exact {
+    private Exact() {}
+
+    static final int EXTERIOR = 2;
+    static final int BOUNDARY = 1;
+    static final int INTERIOR = 0;
+
+    /** A rational number num/den with den > 0 in lowest terms. */
+    static final class Q implements Comparable<Q> {
+        static final Q ZERO = new Q(BigInteger.ZERO, BigInteger.ONE);
+        static final Q ONE = new Q(BigInteger.ONE, BigInteger.ONE);
+        final BigInteger num;
+        final BigInteger den;
+
+        private Q(BigInteger num, BigInteger den) {
+            this.num = num;
+            this.den = den;
+        }
+
+        static Q of(BigInteger num, BigInteger den) {
+            if (den.signum() == 0) {
+                throw new ArithmeticException("zero denominator");
+            }
+            if (den.signum() < 0) {
+                num = num.negate();
+                den = den.negate();
+            }
+            BigInteger g = num.gcd(den);
+            if (!g.equals(BigInteger.ONE) && g.signum() != 0) {
+                num = num.divide(g);
+                den = den.divide(g);
+            }
+            return new Q(num, den);
+        }
+
+        static Q of(long n) {
+            return new Q(BigInteger.valueOf(n), BigInteger.ONE);
+        }
+
+        static Q of(double d) {
+            if (Double.isNaN(d) || Double.isInfinite(d)) {
+                throw new ArithmeticException("not finite: " + d);
+            }
+            BigDecimal bd = new BigDecimal(d);
+            BigInteger unscaled = bd.unscaledValue();
+            int scale = bd.scale();
+            if (scale >= 0) {
+                return of(unscaled, BigInteger.TEN.pow(scale));
+            }
+            return of(unscaled.multiply(BigInteger.TEN.pow(-scale)), BigInteger.ONE);
+        }
+
+        Q add(Q o) {
+            return of(num.multiply(o.den).add(o.num.multiply(den)), den.multiply(o.den));
+        }
+
+        Q sub(Q o) {
+            return of(num.multiply(o.den).subtract(o.num.multiply(den)), den.multiply(o.den));
+        }
+
+        Q mul(Q o) {
+            return of(num.multiply(o.num), den.multiply(o.den));
+        }
+
+        Q div(Q o) {
+            return of(num.multiply(o.den), den.multiply(o.num));
+        }
+
+        Q neg() {
+            return new Q(num.negate(), den);
+        }
+
+        Q abs() {
+            return num.signum() < 0 ? neg() : this;
+        }
+
+        int signum() {
+            return num.signum();
+        }
+
+        boolean isZero() {
+            return num.signum() == 0;
+        }
+
+        Q min(Q o) {
+            return compareTo(o) <= 0 ? this : o;
+        }
+
+        Q max(Q o) {
+            return compareTo(o) >= 0 ? this : o;
+        }
+
+        @Override
+        public int compareTo(Q o) {
+            return num.multiply(o.den).compareTo(o.num.multiply(den));
+        }
+
+        @Override
+        public boolean equals(Object o) {
+            return o instanceof Q q && num.equals(q.num) && den.equals(q.den);
+        }
+
+        @Override
+        public int hashCode() {
+            return num.hashCode() * 31 + den.hashCode();
+        }
+
+        double toDouble() {
+            return new BigDecimal(num).divide(new BigDecimal(den), MathContext.DECIMAL128).doubleValue();
+        }
+
+        /** sqrt as a double, correctly rounded to about 1e-30 relative before the final rounding. */
+        double sqrt() {
+            if (signum() < 0) {
+                throw new ArithmeticException("sqrt of negative");
+            }
+            return new BigDecimal(num).divide(new BigDecimal(den), MathContext.DECIMAL128).sqrt(MathContext.DECIMAL128).doubleValue();
+        }
+
+        @Override
+        public String toString() {
+            return den.equals(BigInteger.ONE) ? num.toString() : num + "/" + den;
+        }
+    }
+
+    /** An exact point. */
+    record P(Q x, Q y) {
+        static P of(Coordinate c) {
+            return new P(Q.of(c.x), Q.of(c.y));
+        }
+
+        static P of(double x, double y) {
+            return new P(Q.of(x), Q.of(y));
+        }
+
+        P sub(P o) {
+            return new P(x.sub(o.x), y.sub(o.y));
+        }
+
+        Q cross(P o) {
+            return x.mul(o.y).sub(y.mul(o.x));
+        }
+
+        Q dot(P o) {
+            return x.mul(o.x).add(y.mul(o.y));
+        }
+
+        Q distSq(P o) {
+            P d = sub(o);
+            return d.dot(d);
+        }
+
+        Coordinate toCoordinate() {
+            return new Coordinate(x.toDouble(), y.toDouble());
+        }
+
+        @Override
+        public String toString() {
+            return "(" + x + ", " + y + ")";
+        }
+    }
+
+    static P[] points(Coordinate[] cs) {
+        P[] ps = new P[cs.length];
+        for (int i = 0; i < cs.length; i++) {
+            ps[i] = P.of(cs[i]);
+        }
+        return ps;
+    }
+
+    /** Sign of the turn a -> b -> c: +1 counter-clockwise (c left of a->b), -1 clockwise, 0 collinear. */
+    static int orient(P a, P b, P c) {
+        return b.sub(a).cross(c.sub(a)).signum();
+    }
+
+    /** p lies on the closed segment ab. */
+    static boolean onSegment(P p, P a, P b) {
+        if (orient(a, b, p) != 0) {
+            return false;
+        }
+        return p.x.compareTo(a.x.min(b.x)) >= 0 && p.x.compareTo(a.x.max(b.x)) <= 0
+            && p.y.compareTo(a.y.min(b.y)) >= 0 && p.y.compareTo(a.y.max(b.y)) <= 0;
+    }
+
+    /** Exact segment intersection: kind NONE (no points), POINT (one point) or COLLINEAR (one or two points). */
+    record SegInt(int kind, List<P> points, boolean proper) {
+        static final int NONE = 0;
+        static final int POINT = 1;
+        static final int COLLINEAR = 2;
+    }
+
+    static SegInt intersect(P a, P b, P c, P d) {
+        int o1 = orient(a, b, c);
+        int o2 = orient(a, b, d);
+        int o3 = orient(c, d, a);
+        int o4 = orient(c, d, b);
+        if (o1 == 0 && o2 == 0) {
+            // collinear (or one segment degenerate on the other's line): overlap of the projections
+            List<P> pts = new ArrayList<>();
+            for (P p : new P[] {a, b, c, d}) {
+                if (onSegment(p, a, b) && onSegment(p, c, d) && !pts.contains(p)) {
+                    pts.add(p);
+                }
+            }
+            if (pts.isEmpty()) {
+                return new SegInt(SegInt.NONE, pts, false);
+            }
+            if (pts.size() == 1) {
+                return new SegInt(SegInt.POINT, pts, false);
+            }
+            return new SegInt(SegInt.COLLINEAR, pts, false);
+        }
+        if (o1 * o2 <= 0 && o3 * o4 <= 0) {
+            if (o1 != 0 && o2 != 0 && o3 != 0 && o4 != 0) {
+                return new SegInt(SegInt.POINT, List.of(lineIntersection(a, b, c, d)), true);
+            }
+            // an endpoint lies on the other segment
+            for (P p : new P[] {a, b}) {
+                if (onSegment(p, c, d)) {
+                    return new SegInt(SegInt.POINT, List.of(p), false);
+                }
+            }
+            for (P p : new P[] {c, d}) {
+                if (onSegment(p, a, b)) {
+                    return new SegInt(SegInt.POINT, List.of(p), false);
+                }
+            }
+            // the orientation tests said the segments meet but no endpoint lies on the other: a degenerate
+            // segment (a == b) off the other segment's line, which is disjoint
+            return new SegInt(SegInt.NONE, List.of(), false);
+        }
+        return new SegInt(SegInt.NONE, List.of(), false);
+    }
+
+    /** Intersection of the lines through ab and cd (they must not be parallel). */
+    static P lineIntersection(P a, P b, P c, P d) {
+        P r = b.sub(a);
+        P s = d.sub(c);
+        Q denom = r.cross(s);
+        Q t = c.sub(a).cross(s).div(denom);
+        return new P(a.x.add(r.x.mul(t)), a.y.add(r.y.mul(t)));
+    }
+
+    /** The lines through ab and cd are parallel (or one is degenerate). */
+    static boolean parallel(P a, P b, P c, P d) {
+        return b.sub(a).cross(d.sub(c)).isZero();
+    }
+
+    static boolean segmentsIntersect(P a, P b, P c, P d) {
+        return intersect(a, b, c, d).kind != SegInt.NONE;
+    }
+
+    /** Locates p in a closed ring (first == last): INTERIOR, BOUNDARY or EXTERIOR, by exact crossing count. */
+    static int locateInRing(P p, P[] ring) {
+        int crossings = 0;
+        for (int i = 0; i + 1 < ring.length; i++) {
+            P a = ring[i];
+            P b = ring[i + 1];
+            if (onSegment(p, a, b)) {
+                return BOUNDARY;
+            }
+            boolean aAbove = a.y.compareTo(p.y) > 0;
+            boolean bAbove = b.y.compareTo(p.y) > 0;
+            if (aAbove != bAbove) {
+                // the edge straddles the horizontal line through p: is the crossing to the right of p?
+                int o = orient(a, b, p);
+                if ((bAbove && o > 0) || (!bAbove && o < 0)) {
+                    crossings++;
+                }
+            }
+        }
+        return (crossings % 2 == 1) ? INTERIOR : EXTERIOR;
+    }
+
+    /** Locates p in a polygon given as shell + holes (all closed rings). */
+    static int locateInPolygon(P p, P[] shell, List<P[]> holes) {
+        int loc = locateInRing(p, shell);
+        if (loc != INTERIOR) {
+            return loc;
+        }
+        for (P[] h : holes) {
+            int hl = locateInRing(p, h);
+            if (hl == BOUNDARY) {
+                return BOUNDARY;
+            }
+            if (hl == INTERIOR) {
+                return EXTERIOR;
+            }
+        }
+        return INTERIOR;
+    }
+
+    static int locateInPolygon(P p, Polygon poly) {
+        return locateInPolygon(p, points(poly.getExteriorRing().getCoordinates()), holes(poly));
+    }
+
+    static List<P[]> holes(Polygon poly) {
+        List<P[]> hs = new ArrayList<>();
+        for (int i = 0; i < poly.getNumInteriorRing(); i++) {
+            hs.add(points(poly.getInteriorRingN(i).getCoordinates()));
+        }
+        return hs;
+    }
+
+    /** Twice the signed area of a closed ring (positive when counter-clockwise). */
+    static Q signedArea2(P[] ring) {
+        Q s = Q.ZERO;
+        for (int i = 0; i + 1 < ring.length; i++) {
+            s = s.add(ring[i].cross(ring[i + 1]));
+        }
+        return s;
+    }
+
+    static Q area(Polygon poly) {
+        Q a = signedArea2(points(poly.getExteriorRing().getCoordinates())).abs();
+        for (P[] h : holes(poly)) {
+            a = a.sub(signedArea2(h).abs());
+        }
+        return a.div(Q.of(2));
+    }
+
+    /** Exact squared length would be irrational in general; the length is the sum of square roots as doubles. */
+    static double length(P[] line) {
+        double s = 0;
+        for (int i = 0; i + 1 < line.length; i++) {
+            s += line[i].distSq(line[i + 1]).sqrt();
+        }
+        return s;
+    }
+
+    /** Squared distance from p to the closed segment ab. */
+    static Q distSq(P p, P a, P b) {
+        P ab = b.sub(a);
+        Q len2 = ab.dot(ab);
+        if (len2.isZero()) {
+            return p.distSq(a);
+        }
+        Q t = p.sub(a).dot(ab).div(len2);
+        if (t.signum() <= 0) {
+            return p.distSq(a);
+        }
+        if (t.compareTo(Q.ONE) >= 0) {
+            return p.distSq(b);
+        }
+        P proj = new P(a.x.add(ab.x.mul(t)), a.y.add(ab.y.mul(t)));
+        return p.distSq(proj);
+    }
+
+    /** Squared distance between the closed segments ab and cd. */
+    static Q segDistSq(P a, P b, P c, P d) {
+        if (segmentsIntersect(a, b, c, d)) {
+            return Q.ZERO;
+        }
+        Q m = distSq(a, c, d).min(distSq(b, c, d));
+        m = m.min(distSq(c, a, b)).min(distSq(d, a, b));
+        return m;
+    }
+
+    /** Exact area-weighted centroid of a polygon (null for zero area). */
+    static P centroid(Polygon poly) {
+        Q cx = Q.ZERO;
+        Q cy = Q.ZERO;
+        Q a2 = Q.ZERO;
+        List<P[]> rings = new ArrayList<>();
+        rings.add(points(poly.getExteriorRing().getCoordinates()));
+        rings.addAll(holes(poly));
+        for (int r = 0; r < rings.size(); r++) {
+            P[] ring = rings.get(r);
+            Q sign = signedArea2(ring).signum() >= 0 ? Q.ONE : Q.ONE.neg();
+            if (r > 0) {
+                sign = sign.neg(); // holes subtract
+            }
+            for (int i = 0; i + 1 < ring.length; i++) {
+                Q c = ring[i].cross(ring[i + 1]).mul(sign);
+                a2 = a2.add(c);
+                cx = cx.add(ring[i].x.add(ring[i + 1].x).mul(c));
+                cy = cy.add(ring[i].y.add(ring[i + 1].y).mul(c));
+            }
+        }
+        if (a2.isZero()) {
+            return null;
+        }
+        Q k = Q.of(3).mul(a2);
+        return new P(cx.div(k), cy.div(k));
+    }
+
+    /** The ring (closed, first == last) is simple: edges meet only at shared endpoints of adjacent edges. */
+    static boolean ringSimple(P[] ring0) {
+        P[] ring = dedupe(ring0);
+        int n = ring.length - 1; // edges
+        if (n < 3) {
+            return false;
+        }
+        for (int i = 0; i < n; i++) {
+            for (int j = i + 1; j < n; j++) {
+                SegInt s = intersect(ring[i], ring[i + 1], ring[j], ring[j + 1]);
+                if (s.kind == SegInt.NONE) {
+                    continue;
+                }
+                boolean adjacent = j == i + 1 || (i == 0 && j == n - 1);
+                if (!adjacent) {
+                    return false;
+                }
+                if (s.kind != SegInt.POINT) {
+                    return false;
+                }
+                P shared = (j == i + 1) ? ring[j] : ring[0];
+                if (!s.points.get(0).equals(shared)) {
+                    return false;
+                }
+            }
+        }
+        return true;
+    }
+
+    /** An open polyline is simple: edges meet only at shared endpoints of adjacent edges (a closed one may also meet at its ends). */
+    static boolean lineSimple(P[] line0) {
+        P[] line = dedupe(line0);
+        int n = line.length - 1;
+        if (n < 1) {
+            return true;
+        }
+        boolean closed = line[0].equals(line[n]);
+        for (int i = 0; i < n; i++) {
+            for (int j = i + 1; j < n; j++) {
+                SegInt s = intersect(line[i], line[i + 1], line[j], line[j + 1]);
+                if (s.kind == SegInt.NONE) {
+                    continue;
+                }
+                boolean adjacent = j == i + 1;
+                boolean ends = closed && i == 0 && j == n - 1;
+                if (!adjacent && !ends) {
+                    return false;
+                }
+                if (s.kind != SegInt.POINT) {
+                    return false;
+                }
+                P shared = adjacent ? line[j] : line[0];
+                if (!s.points.get(0).equals(shared)) {
+                    return false;
+                }
+            }
+        }
+        return true;
+    }
+
+    /** Consecutive repeated points removed (JTS ignores them in validity and simplicity). */
+    static P[] dedupe(P[] pts) {
+        List<P> out = new ArrayList<>();
+        for (P p : pts) {
+            if (out.isEmpty() || !out.get(out.size() - 1).equals(p)) {
+                out.add(p);
+            }
+        }
+        return out.toArray(new P[0]);
+    }
+
+    /** Convex hull (Andrew's monotone chain), counter-clockwise, no collinear points, no duplicates; 1 or 2 points for degenerate sets. */
+    static List<P> hull(P[] pts) {
+        P[] s = Arrays.copyOf(pts, pts.length);
+        Arrays.sort(s, (p, q) -> {
+            int c = p.x.compareTo(q.x);
+            return c != 0 ? c : p.y.compareTo(q.y);
+        });
+        List<P> u = new ArrayList<>();
+        for (P p : s) {
+            if (!u.isEmpty() && u.get(u.size() - 1).equals(p)) {
+                continue;
+            }
+            u.add(p);
+        }
+        if (u.size() <= 2) {
+            return u;
+        }
+        List<P> lower = new ArrayList<>();
+        for (P p : u) {
+            while (lower.size() >= 2 && orient(lower.get(lower.size() - 2), lower.get(lower.size() - 1), p) <= 0) {
+                lower.remove(lower.size() - 1);
+            }
+            lower.add(p);
+        }
+        List<P> upper = new ArrayList<>();
+        for (int i = u.size() - 1; i >= 0; i--) {
+            P p = u.get(i);
+            while (upper.size() >= 2 && orient(upper.get(upper.size() - 2), upper.get(upper.size() - 1), p) <= 0) {
+                upper.remove(upper.size() - 1);
+            }
+            upper.add(p);
+        }
+        lower.remove(lower.size() - 1);
+        upper.remove(upper.size() - 1);
+        lower.addAll(upper);
+        return lower;
+    }
+
+    /**
+     * In-circle test: for a counter-clockwise triangle abc, positive when d is strictly inside the circumcircle,
+     * zero on it, negative outside.
+     */
+    static int inCircle(P a, P b, P c, P d) {
+        P ad = a.sub(d);
+        P bd = b.sub(d);
+        P cd = c.sub(d);
+        Q a2 = ad.dot(ad);
+        Q b2 = bd.dot(bd);
+        Q c2 = cd.dot(cd);
+        Q det = ad.x.mul(bd.y.mul(c2).sub(b2.mul(cd.y)))
+            .sub(ad.y.mul(bd.x.mul(c2).sub(b2.mul(cd.x))))
+            .add(a2.mul(bd.x.mul(cd.y).sub(bd.y.mul(cd.x))));
+        return det.signum();
+    }
+
+    static P[] ring(LinearRing r) {
+        return points(r.getCoordinates());
+    }
+
+    /** Approximate equality of doubles: absolute or relative within eps. */
+    static boolean close(double a, double b, double eps) {
+        if (a == b) {
+            return true;
+        }
+        double d = Math.abs(a - b);
+        return d <= eps || d <= eps * Math.max(Math.abs(a), Math.abs(b));
+    }
+}
diff --git a/hegel/src/test/java/zoo/GeoGen.java b/hegel/src/test/java/zoo/GeoGen.java
new file mode 100644
index 0000000..154419f
--- /dev/null
+++ b/hegel/src/test/java/zoo/GeoGen.java
@@ -0,0 +1,380 @@
+package zoo;
+
+import static zoo.Zoo.chance;
+import static zoo.Zoo.n;
+import static zoo.Zoo.pick;
+
+import dev.hegel.TestCase;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import org.locationtech.jts.geom.Coordinate;
+import org.locationtech.jts.geom.Geometry;
+import org.locationtech.jts.geom.GeometryFactory;
+import org.locationtech.jts.geom.LineString;
+import org.locationtech.jts.geom.LinearRing;
+import org.locationtech.jts.geom.MultiPolygon;
+import org.locationtech.jts.geom.Point;
+import org.locationtech.jts.geom.Polygon;
+import zoo.Exact.P;
+
+/**
+ * Random geometries with exactly known properties: coordinates on an integer grid, a fine dyadic grid or with
+ * three decimals (all exact in {@link Exact}); simple rings (checked exactly), valid polygons with holes (exactly
+ * disjoint, hole vertices strictly inside), multipolygons of exactly disjoint polygons.
+ */
+final class GeoGen {
+    static final GeometryFactory GF = new GeometryFactory();
+
+    final TestCase tc;
+    /** Coordinate scheme: 0 = integers in [-range, range], 1 = eighths, 2 = thousandths. */
+    final int scheme;
+    final int range;
+
+    GeoGen(TestCase tc) {
+        this.tc = tc;
+        this.scheme = n(tc, 0, 9) < 6 ? 0 : (chance(tc, 50) ? 1 : 2);
+        this.range = pick(tc, 3, 5, 10, 10, 100, 1000);
+    }
+
+    double ordinate() {
+        return ordinate(range);
+    }
+
+    double ordinate(int r) {
+        switch (scheme) {
+            case 0:
+                return n(tc, -r, r);
+            case 1:
+                return n(tc, -8 * r, 8 * r) / 8.0;
+            default:
+                return n(tc, -1000 * r, 1000 * r) / 1000.0;
+        }
+    }
+
+    /** The smallest positive step of the coordinate scheme. */
+    double step() {
+        return scheme == 0 ? 1 : scheme == 1 ? 0.125 : 0.001;
+    }
+
+    Coordinate coord() {
+        return new Coordinate(ordinate(), ordinate());
+    }
+
+    Coordinate coordIn(double x0, double y0, int r) {
+        return new Coordinate(x0 + ordinate(r), y0 + ordinate(r));
+    }
+
+    Coordinate[] coords(int lo, int hi) {
+        int k = n(tc, lo, hi);
+        Coordinate[] cs = new Coordinate[k];
+        for (int i = 0; i < k; i++) {
+            cs[i] = coord();
+        }
+        return cs;
+    }
+
+    Point point() {
+        return GF.createPoint(coord());
+    }
+
+    /**
+     * A line string of 2..8 points, possibly self-intersecting or with repeated points: one line in ten gets a vertex
+     * replaced by a copy of another, half the time of its predecessor (a repeated interior vertex, jts/2's shape).
+     */
+    LineString line() {
+        Coordinate[] cs = coords(2, 8);
+        if (cs.length > 2 && chance(tc, 10)) {
+            int i = n(tc, 1, cs.length - 1);
+            cs[i] = cs[chance(tc, 50) ? i - 1 : n(tc, 0, cs.length - 1)].copy();
+        }
+        return GF.createLineString(cs);
+    }
+
+    /** A simple open polyline: a simple ring minus its closing edge (checked exactly). */
+    LineString simpleLine() {
+        for (int attempt = 0; attempt < 20; attempt++) {
+            Coordinate[] ring = simpleRingCoords(3, 8);
+            if (ring == null) {
+                continue;
+            }
+            Coordinate[] open = Arrays.copyOf(ring, ring.length - 1);
+            if (open.length >= 2 && Exact.lineSimple(Exact.points(open))) {
+                return GF.createLineString(open);
+            }
+        }
+        return GF.createLineString(new Coordinate[] {new Coordinate(0, 0), new Coordinate(1, 1)});
+    }
+
+    /**
+     * Coordinates of a simple closed ring with k..m distinct vertices: random points sorted by angle around their
+     * mean, kept only when exactly simple; null when no attempt succeeded.
+     */
+    Coordinate[] simpleRingCoords(int lo, int hi) {
+        for (int attempt = 0; attempt < 12; attempt++) {
+            Coordinate[] pts = coords(lo, hi);
+            Coordinate[] ring = starOrder(pts);
+            if (ring != null && Exact.ringSimple(Exact.points(ring))) {
+                return ring;
+            }
+            // fall back to the convex hull of the points
+            List<P> hull = Exact.hull(Exact.points(pts));
+            if (hull.size() >= 3) {
+                Coordinate[] hc = new Coordinate[hull.size() + 1];
+                for (int i = 0; i < hull.size(); i++) {
+                    hc[i] = hull.get(i).toCoordinate();
+                }
+                hc[hull.size()] = hc[0].copy();
+                if (chance(tc, 50)) {
+                    return hc;
+                }
+            }
+        }
+        return null;
+    }
+
+    /** Points sorted by angle around their mean, closed; null when fewer than 3 distinct directions remain. */
+    static Coordinate[] starOrder(Coordinate[] pts) {
+        double mx = 0;
+        double my = 0;
+        for (Coordinate c : pts) {
+            mx += c.x;
+            my += c.y;
+        }
+        final double cx = mx / pts.length;
+        final double cy = my / pts.length;
+        Coordinate[] s = pts.clone();
+        Arrays.sort(s, (a, b) -> Double.compare(Math.atan2(a.y - cy, a.x - cx), Math.atan2(b.y - cy, b.x - cx)));
+        List<Coordinate> out = new ArrayList<>();
+        for (Coordinate c : s) {
+            if (out.isEmpty() || !out.get(out.size() - 1).equals2D(c)) {
+                out.add(c);
+            }
+        }
+        if (out.size() < 3) {
+            return null;
+        }
+        out.add(out.get(0).copy());
+        return out.toArray(new Coordinate[0]);
+    }
+
+    LinearRing simpleRing() {
+        Coordinate[] cs = simpleRingCoords(3, 8);
+        if (cs == null) {
+            cs = new Coordinate[] {new Coordinate(0, 0), new Coordinate(1, 0), new Coordinate(0, 1), new Coordinate(0, 0)};
+        }
+        return GF.createLinearRing(cs);
+    }
+
+    /** Any closed ring of 3..7 random points: usually self-intersecting. */
+    LinearRing anyRing() {
+        Coordinate[] cs = coords(3, 7);
+        Coordinate[] closed = Arrays.copyOf(cs, cs.length + 1);
+        closed[cs.length] = cs[0].copy();
+        return GF.createLinearRing(closed);
+    }
+
+    /**
+     * A simple ring near another one: its points are the other's vertices, edge midpoints, points shifted by a
+     * step or two, or random, so it touches, crosses, nests or misses the other in every way.
+     */
+    LinearRing nearRing(LinearRing base) {
+        Coordinate[] bc = base.getCoordinates();
+        for (int attempt = 0; attempt < 12; attempt++) {
+            int k = n(tc, 3, 6);
+            Coordinate[] pts = new Coordinate[k];
+            for (int i = 0; i < k; i++) {
+                int how = n(tc, 0, 9);
+                int j = n(tc, 0, bc.length - 2);
+                if (how < 3) {
+                    pts[i] = bc[j].copy();
+                } else if (how < 5) {
+                    pts[i] = new Coordinate((bc[j].x + bc[j + 1].x) / 2, (bc[j].y + bc[j + 1].y) / 2);
+                } else if (how < 8) {
+                    pts[i] = new Coordinate(bc[j].x + step() * n(tc, -2, 2), bc[j].y + step() * n(tc, -2, 2));
+                } else {
+                    pts[i] = coord();
+                }
+            }
+            Coordinate[] ring = starOrder(pts);
+            if (ring != null && Exact.ringSimple(Exact.points(ring))) {
+                return GF.createLinearRing(ring);
+            }
+        }
+        return simpleRing();
+    }
+
+    /** A valid polygon: a simple shell with 0..2 holes strictly inside and exactly disjoint from each other. */
+    Polygon polygon() {
+        LinearRing shell = simpleRing();
+        P[] shellPts = Exact.ring(shell);
+        List<LinearRing> holes = new ArrayList<>();
+        List<P[]> holePts = new ArrayList<>();
+        int wanted = chance(tc, 40) ? n(tc, 1, 2) : 0;
+        for (int h = 0; h < wanted; h++) {
+            for (int attempt = 0; attempt < 8; attempt++) {
+                // a small ring near a random shell-interior spot
+                Coordinate seed = coord();
+                int r = Math.max(1, range / pick(tc, 2, 4, 8));
+                Coordinate[] pts = new Coordinate[n(tc, 3, 6)];
+                for (int i = 0; i < pts.length; i++) {
+                    pts[i] = coordIn(seed.x, seed.y, r);
+                }
+                Coordinate[] ring = starOrder(pts);
+                if (ring == null) {
+                    continue;
+                }
+                P[] rp = Exact.points(ring);
+                if (!Exact.ringSimple(rp) || !holeFits(rp, shellPts, holePts)) {
+                    continue;
+                }
+                holes.add(GF.createLinearRing(ring));
+                holePts.add(rp);
+                break;
+            }
+        }
+        return GF.createPolygon(shell, holes.toArray(new LinearRing[0]));
+    }
+
+    /** Every vertex of the hole strictly inside the shell and outside the other holes; no edge meets another ring's edge. */
+    static boolean holeFits(P[] hole, P[] shell, List<P[]> others) {
+        for (P p : hole) {
+            if (Exact.locateInRing(p, shell) != Exact.INTERIOR) {
+                return false;
+            }
+            for (P[] o : others) {
+                if (Exact.locateInRing(p, o) != Exact.EXTERIOR) {
+                    return false;
+                }
+            }
+        }
+        for (P[] o : others) {
+            for (P p : o) {
+                if (Exact.locateInRing(p, hole) != Exact.EXTERIOR) {
+                    return false;
+                }
+            }
+        }
+        List<P[]> rings = new ArrayList<>(others);
+        rings.add(shell);
+        for (P[] o : rings) {
+            for (int i = 0; i + 1 < hole.length; i++) {
+                for (int j = 0; j + 1 < o.length; j++) {
+                    if (Exact.segmentsIntersect(hole[i], hole[i + 1], o[j], o[j + 1])) {
+                        return false;
+                    }
+                }
+            }
+        }
+        return true;
+    }
+
+    /** A valid multipolygon of 1..3 polygons placed in separate cells, so exactly disjoint. */
+    MultiPolygon multiPolygon() {
+        int k = n(tc, 1, 3);
+        Polygon[] ps = new Polygon[k];
+        double cell = 2.0 * range + 4 * step();
+        for (int i = 0; i < k; i++) {
+            Polygon p = polygon();
+            if (k > 1) {
+                double dx = i * cell;
+                p = (Polygon) translate(p, dx, chance(tc, 50) ? cell * n(tc, 0, 1) : 0);
+            }
+            ps[i] = p;
+        }
+        return GF.createMultiPolygon(ps);
+    }
+
+    static Geometry translate(Geometry g, double dx, double dy) {
+        Geometry c = g.copy();
+        c.apply((org.locationtech.jts.geom.CoordinateFilter) coord -> {
+            coord.x += dx;
+            coord.y += dy;
+        });
+        c.geometryChanged();
+        return c;
+    }
+
+    /** A random valid geometry of any type (empties included now and then). */
+    Geometry any() {
+        int k = n(tc, 0, 99);
+        if (k < 5) {
+            return empty();
+        }
+        if (k < 15) {
+            return point();
+        }
+        if (k < 22) {
+            return GF.createMultiPointFromCoords(coords(1, 5));
+        }
+        if (k < 40) {
+            return chance(tc, 60) ? simpleLine() : line();
+        }
+        if (k < 48) {
+            LineString[] ls = new LineString[n(tc, 1, 3)];
+            for (int i = 0; i < ls.length; i++) {
+                ls[i] = chance(tc, 60) ? simpleLine() : line();
+            }
+            return GF.createMultiLineString(ls);
+        }
+        if (k < 80) {
+            return polygon();
+        }
+        if (k < 92) {
+            return multiPolygon();
+        }
+        Geometry[] gs = new Geometry[n(tc, 1, 3)];
+        for (int i = 0; i < gs.length; i++) {
+            gs[i] = any();
+        }
+        return GF.createGeometryCollection(gs);
+    }
+
+    /** An empty geometry of a random type. */
+    Geometry empty() {
+        switch (n(tc, 0, 6)) {
+            case 0:
+                return GF.createPoint();
+            case 1:
+                return GF.createLineString();
+            case 2:
+                return GF.createPolygon();
+            case 3:
+                return GF.createMultiPoint();
+            case 4:
+                return GF.createMultiLineString();
+            case 5:
+                return GF.createMultiPolygon();
+            default:
+                return GF.createGeometryCollection();
+        }
+    }
+
+    /** A polygonal geometry: a polygon or a multipolygon. */
+    Geometry polygonal() {
+        return chance(tc, 70) ? polygon() : multiPolygon();
+    }
+
+    /** A valid geometry of dimension 0, 1 or 2 without collections: for predicates and overlay. */
+    Geometry simpleTyped() {
+        int k = n(tc, 0, 99);
+        if (k < 15) {
+            return point();
+        }
+        if (k < 22) {
+            return GF.createMultiPointFromCoords(coords(1, 4));
+        }
+        if (k < 45) {
+            return chance(tc, 70) ? simpleLine() : line();
+        }
+        if (k < 85) {
+            return polygon();
+        }
+        return multiPolygon();
+    }
+
+    static String wkt(Geometry g) {
+        String s = g.toText();
+        return s.length() > 600 ? s.substring(0, 600) + "…" : s;
+    }
+}
diff --git a/hegel/src/test/java/zoo/JtsPinsTest.java b/hegel/src/test/java/zoo/JtsPinsTest.java
new file mode 100644
index 0000000..0b4a1f6
--- /dev/null
+++ b/hegel/src/test/java/zoo/JtsPinsTest.java
@@ -0,0 +1,109 @@
+package zoo;
+
+import static zoo.Zoo.check;
+
+import org.junit.jupiter.api.Test;
+import org.locationtech.jts.geom.Coordinate;
+import org.locationtech.jts.geom.Geometry;
+import org.locationtech.jts.geom.GeometryFactory;
+import org.locationtech.jts.geom.LineString;
+import org.locationtech.jts.geom.Point;
+import org.locationtech.jts.io.ParseException;
+import org.locationtech.jts.algorithm.MinimumBoundingCircle;
+import org.locationtech.jts.io.WKTReader;
+import org.locationtech.jts.operation.relate.RelateOp;
+import org.locationtech.jts.operation.relateng.RelateNG;
+import org.locationtech.jts.operation.valid.IsSimpleOp;
+
+/**
+ * Pins for the bugs in bugs.toml: each asserts the correct behaviour and fails while the bug exists (see
+ * target.toml [expected_failures]).
+ */
+class JtsPinsTest {
+
+    static final GeometryFactory GF = new GeometryFactory();
+
+    static Geometry read(String wkt) {
+        try {
+            return new WKTReader(GF).read(wkt);
+        } catch (ParseException e) {
+            throw new AssertionError(e);
+        }
+    }
+
+    /**
+     * bug wktLosesSmallOrdinates: the floating precision model is full double precision, but WKTWriter prints at most
+     * 16 fraction digits, so ordinates below 1 that need 17 significant digits (and any ordinate below 1e-16) do not
+     * read back as the same double.
+     */
+    @Test
+    void pin_wktLosesSmallOrdinates() {
+        for (double v : new double[] {1.0 / 7, 1.0 / 3000, 1.2345678901234567e-5, 1e-17}) {
+            Point p = GF.createPoint(new Coordinate(v, 0));
+            String text = p.toText();
+            Geometry back = read(text);
+            check(back.getCoordinate().x == v, () -> "POINT (" + v + " 0) prints as " + text + ", which reads back as " + back.getCoordinate().x);
+        }
+    }
+
+    /**
+     * bug relateOpCountsACrossingOnTheBoundaryAsALine: the boundary of the square meets the line's interior at the two
+     * points (3 4) and (4 3) - dimension 0 - where the line's diagonals cross on the top edge; RelateOp reports 1
+     * there (1021F1102), RelateNG 0 (1020F1102).
+     */
+    @Test
+    void pin_relateOpCountsACrossingOnTheBoundaryAsALine() {
+        Geometry square = read("POLYGON ((0 0, 4 0, 4 4, 0 4, 0 0))");
+        Geometry line = read("LINESTRING (1 2, 5 6, 5 2, 1 6)");
+        String old = RelateOp.relate(square, line).toString();
+        String ng = RelateNG.relate(square, line).toString();
+        check(old.equals("1020F1102"), () -> "RelateOp gives " + old + " for " + square + " and " + line + ", RelateNG " + ng + "; boundary(A) meets B in " + square.getBoundary().intersection(line));
+    }
+
+    /**
+     * bug relateOpAlongASegmentOfASelfCrossingLine: the second line is the first's last segment, so their interiors
+     * meet along a line and the first covers the second (RelateNG: 101F00FF2); RelateOp reports 001F001F2 - the
+     * interiors meeting in a point and the second line partly outside - when the crossing of the first line's
+     * segments, here (1/3, -1/3), is not exactly representable.
+     */
+    @Test
+    void pin_relateOpAlongASegmentOfASelfCrossingLine() {
+        Geometry bow = read("LINESTRING (0 0, 1 -1, 0 -1, 1 1)");
+        Geometry along = read("LINESTRING (0 -1, 1 1)");
+        String old = RelateOp.relate(bow, along).toString();
+        String ng = RelateNG.relate(bow, along).toString();
+        check(old.equals("101F00FF2"), () -> "RelateOp gives " + old + " for " + bow + " and " + along + ", RelateNG " + ng);
+        check(bow.covers(along), () -> bow + " does not cover its own segment " + along);
+    }
+
+    /**
+     * bug boundingCircleOfCoincidentPoints: getCentre() is documented to be null only for empty input; a MULTIPOINT of
+     * two equal points is not empty and its bounding circle is the point with radius 0 (as it is for one point).
+     */
+    @Test
+    void pin_boundingCircleOfCoincidentPoints() {
+        Geometry two = read("MULTIPOINT ((1 1), (1 1))");
+        MinimumBoundingCircle mbc = new MinimumBoundingCircle(two);
+        check(mbc.getCentre() != null && mbc.getCentre().equals2D(new Coordinate(1, 1)), () -> "centre of the bounding circle of " + two + " is " + mbc.getCentre() + ", extremal points " + java.util.Arrays.toString(mbc.getExtremalPoints()));
+        check(mbc.getRadius() == 0, () -> "radius of the bounding circle of " + two + " is " + mbc.getRadius());
+        Geometry line = read("LINESTRING (2 3, 2 3)");
+        MinimumBoundingCircle mbcLine = new MinimumBoundingCircle(line);
+        check(mbcLine.getCentre() != null && mbcLine.getCircle().getCoordinate() != null, () -> "centre of the bounding circle of " + line + " is " + mbcLine.getCentre() + ", circle " + mbcLine.getCircle());
+    }
+
+    /**
+     * bug repeatedPointNotSimple: a repeated interior vertex is a zero-length segment, not a self-intersection;
+     * IsSimpleOp trims repeated end points and calls a LinearRing with the same repetition simple.
+     */
+    @Test
+    void pin_repeatedPointNotSimple() {
+        LineString line = (LineString) read("LINESTRING (0 0, 1 1, 1 1, 2 0)");
+        check(line.isSimple(), () -> line + " is reported non-simple at " + IsSimpleOp.getNonSimpleLocation(line));
+        Geometry ring = read("LINEARRING (2 -1, -4 0, 0 1, 0 1, 2 -1)");
+        check(ring.isSimple(), () -> ring + " is reported non-simple at " + IsSimpleOp.getNonSimpleLocation(ring));
+        // for comparison, both of these are (rightly) simple: the ends are trimmed, and this ring's repetition happens to pass
+        Geometry ring2 = read("LINEARRING (0 0, 1 0, 1 0, 1 1, 0 0)");
+        Geometry ends = read("LINESTRING (0 0, 0 0, 2 0, 2 0)");
+        check(ring2.isSimple() && ends.isSimple(), () -> "the ring is simple: " + ring2.isSimple() + ", the line with repeated ends: " + ends.isSimple());
+    }
+}
diff --git a/hegel/src/test/java/zoo/JtsShapesTest.java b/hegel/src/test/java/zoo/JtsShapesTest.java
new file mode 100644
index 0000000..b4d48e1
--- /dev/null
+++ b/hegel/src/test/java/zoo/JtsShapesTest.java
@@ -0,0 +1,185 @@
+package zoo;
+
+import static zoo.Zoo.chance;
+import static zoo.Zoo.n;
+
+import dev.hegel.Generators;
+import dev.hegel.Hegel;
+import dev.hegel.TestCase;
+import org.junit.jupiter.api.Test;
+import org.locationtech.jts.geom.Coordinate;
+import org.locationtech.jts.geom.Geometry;
+import org.locationtech.jts.geom.GeometryFactory;
+import org.locationtech.jts.geom.LineString;
+import org.locationtech.jts.geom.Polygon;
+import org.locationtech.jts.operation.relate.RelateOp;
+import org.locationtech.jts.operation.relateng.RelateNG;
+
+/**
+ * One narrow property per recorded bug (bugs.toml): a generator over the bug's shape region with random contents,
+ * checked by the same oracle as the wide property of {@link JtsTest} that found it. They fail while the bugs exist and
+ * are the expected failures beside the pins. Under {@code HEGEL_NO_KNOWN=1} ({@link Zoo#NO_KNOWN}) each draws the
+ * neighbouring shape the library handles (short decimals, a repeated end point, a second distinct point) and passes.
+ */
+class JtsShapesTest {
+
+    static final GeometryFactory GF = GeoGen.GF;
+
+    /**
+     * An ordinate of magnitude below 1: a fraction p/q with q up to a million, one in five scaled down by up to 20
+     * powers of ten - most need 17 significant digits, and below 1e-16 the 16-fraction-digit writer prints 0. Under
+     * HEGEL_NO_KNOWN a decimal of at most 15 fraction digits, which always reads back.
+     */
+    static double ordinateBelowOne(TestCase tc) {
+        double sign = chance(tc, 30) ? -1 : 1;
+        if (Zoo.NO_KNOWN) {
+            long scale = (long) Math.pow(10, n(tc, 1, 15));
+            return sign * tc.draw(Generators.longs().min(0).max(scale - 1)) / scale;
+        }
+        int q = n(tc, 2, 1_000_000);
+        double v = (double) n(tc, 1, q - 1) / q;
+        if (chance(tc, 20)) {
+            v /= Math.pow(10, n(tc, 1, 20));
+        }
+        return sign * v;
+    }
+
+    /** A point, a multipoint of 1..4 points or a line of 2..5 points whose ordinates are all below 1. */
+    static Geometry belowOne(TestCase tc) {
+        int kind = n(tc, 0, 2);
+        Coordinate[] cs = new Coordinate[kind == 0 ? 1 : kind == 1 ? n(tc, 1, 4) : n(tc, 2, 5)];
+        for (int i = 0; i < cs.length; i++) {
+            cs[i] = new Coordinate(ordinateBelowOne(tc), ordinateBelowOne(tc));
+        }
+        return kind == 0 ? GF.createPoint(cs[0]) : kind == 1 ? GF.createMultiPointFromCoords(cs) : GF.createLineString(cs);
+    }
+
+    /** jts/1: the floating precision model is full double precision, so WKT of ordinates below 1 reads back exactly. */
+    @Test
+    void ordinatesBelowOneRoundTripThroughWKT() {
+        Hegel.test(tc -> JtsTest.checkWktRoundTrip(belowOne(tc)), Zoo.settings("jts.ordinatesBelowOneRoundTripThroughWKT"));
+    }
+
+    /**
+     * jts/2: a simple line or ring with one interior vertex repeated (a zero-length segment, not a self-intersection)
+     * is still simple, as the exact oracle says. Under HEGEL_NO_KNOWN the repeated vertex is an end point, which
+     * IsSimpleOp trims.
+     */
+    @Test
+    void repeatedInteriorVerticesAreSimple() {
+        Hegel.test(tc -> {
+            GeoGen g = new GeoGen(tc);
+            boolean ring = chance(tc, 50);
+            Coordinate[] cs = ring ? g.simpleRing().getCoordinates() : g.simpleLine().getCoordinates();
+            tc.assume(cs.length >= 3); // simpleLine falls back to a two-point line when no simple polyline was found
+            int at = Zoo.NO_KNOWN ? (chance(tc, 50) ? cs.length - 1 : 0) : n(tc, 1, cs.length - 2);
+            Coordinate[] repeated = new Coordinate[cs.length + 1];
+            System.arraycopy(cs, 0, repeated, 0, at + 1);
+            repeated[at + 1] = cs[at].copy();
+            System.arraycopy(cs, at + 1, repeated, at + 2, cs.length - at - 1);
+            if (ring) {
+                JtsTest.checkRingSimple(GF.createLinearRing(repeated), Exact.points(repeated));
+            } else {
+                JtsTest.checkLineSimple(GF.createLineString(repeated), Exact.points(repeated));
+            }
+        }, Zoo.settings("jts.repeatedInteriorVerticesAreSimple"));
+    }
+
+    /** Eight pairwise non-parallel grid directions for the two segments through the crossing. */
+    static final int[][] DIRECTIONS = {{1, 0}, {0, 1}, {1, 1}, {1, -1}, {2, 1}, {1, 2}, {3, 1}, {1, 3}};
+
+    /**
+     * jts/4: RelateOp (Geometry.relate's default) and RelateNG agree on a polygon and a line two of whose segments
+     * cross each other at a point in the interior of one of the polygon's edges; the boundary of the polygon meets
+     * the line's interior in points, so the matrix entry is 0. The polygon is a generated one on the integer or
+     * eighths grid (where midpoints and offsets are exact), the crossing sits at the midpoint of a random shell edge
+     * and the line runs through it along two different grid directions; under HEGEL_NO_KNOWN the crossing is moved
+     * off the boundary.
+     */
+    @Test
+    void relateAgreesWhenALineCrossesItselfOnABoundary() {
+        Hegel.test(tc -> {
+            GeoGen g = new GeoGen(tc);
+            while (g.scheme == 2) { // thousandths are not exact under addition: the crossing would slip off the edge
+                g = new GeoGen(tc);
+            }
+            Polygon a = g.polygon();
+            Coordinate[] shell = a.getExteriorRing().getCoordinates();
+            int e = n(tc, 0, shell.length - 2);
+            Coordinate p = shell[e];
+            Coordinate q = shell[e + 1];
+            double mx = (p.x + q.x) / 2;
+            double my = (p.y + q.y) / 2;
+            if (Zoo.NO_KNOWN) {
+                mx += g.step() * n(tc, 1, 3);
+                my += g.step() * n(tc, 1, 3);
+            }
+            int i = n(tc, 0, DIRECTIONS.length - 1);
+            int[] u = DIRECTIONS[i];
+            int[] v = DIRECTIONS[(i + n(tc, 1, DIRECTIONS.length - 1)) % DIRECTIONS.length];
+            double dx = q.x - p.x;
+            double dy = q.y - p.y;
+            tc.assume(u[0] * dy != u[1] * dx && v[0] * dy != v[1] * dx); // neither segment along the edge
+            double k = n(tc, 1, 4) * g.step();
+            LineString b = GF.createLineString(new Coordinate[] {
+                new Coordinate(mx + k * u[0], my + k * u[1]), new Coordinate(mx - k * u[0], my - k * u[1]),
+                new Coordinate(mx + k * v[0], my + k * v[1]), new Coordinate(mx - k * v[0], my - k * v[1])});
+            tc.assume(JtsTest.selfCrossingOn(b, a) != Zoo.NO_KNOWN);
+            JtsTest.checkRelateAgree(RelateOp.relate(a, b), RelateNG.relate(a, b), GeoGen.wkt(a) + " and " + GeoGen.wkt(b));
+        }, Zoo.settings("jts.relateAgreesWhenALineCrossesItselfOnABoundary"));
+    }
+
+    /**
+     * jts/5: RelateOp and RelateNG agree on a self-crossing line (four random points whose first and last segments
+     * cross properly) and a line collinear with its last segment through the crossing - the segment itself, reversed,
+     * or extended past its end - whose interiors meet along a line; RelateOp reports them meeting in a point when the
+     * crossing point is not exactly representable. Under HEGEL_NO_KNOWN the second line is the middle segment,
+     * which the crossing does not touch.
+     */
+    @Test
+    void relateAgreesAlongASegmentOfASelfCrossingLine() {
+        Hegel.test(tc -> {
+            GeoGen g = new GeoGen(tc);
+            Coordinate[] cs = g.coords(4, 4);
+            Exact.P[] ps = Exact.points(cs);
+            tc.assume(Exact.intersect(ps[0], ps[1], ps[2], ps[3]).proper());
+            LineString a = GF.createLineString(cs);
+            Coordinate[] along;
+            if (Zoo.NO_KNOWN) {
+                along = new Coordinate[] {cs[1].copy(), cs[2].copy()};
+            } else {
+                switch (n(tc, 0, 2)) {
+                    case 0 -> along = new Coordinate[] {cs[2].copy(), cs[3].copy()};
+                    case 1 -> along = new Coordinate[] {cs[3].copy(), cs[2].copy()};
+                    default -> {
+                        int k = n(tc, 1, 3);
+                        along = new Coordinate[] {cs[2].copy(), new Coordinate(cs[3].x + k * (cs[3].x - cs[2].x), cs[3].y + k * (cs[3].y - cs[2].y))};
+                    }
+                }
+            }
+            LineString b = GF.createLineString(along);
+            JtsTest.checkRelateAgree(RelateOp.relate(a, b), RelateNG.relate(a, b), GeoGen.wkt(a) + " and " + GeoGen.wkt(b));
+        }, Zoo.settings("jts.relateAgreesAlongASegmentOfASelfCrossingLine"));
+    }
+
+    /**
+     * jts/3: the minimum bounding circle of 2..8 coincident points (a multipoint or a line) has a centre - the point -
+     * and radius 0, as for a single point. Under HEGEL_NO_KNOWN one of the points is moved a grid step away.
+     */
+    @Test
+    void boundingCircleOfCoincidentPointsHasACentre() {
+        Hegel.test(tc -> {
+            GeoGen g = new GeoGen(tc);
+            Coordinate p = g.coord();
+            Coordinate[] cs = new Coordinate[n(tc, 2, 8)];
+            for (int i = 0; i < cs.length; i++) {
+                cs[i] = p.copy();
+            }
+            if (Zoo.NO_KNOWN) {
+                cs[n(tc, 0, cs.length - 1)] = new Coordinate(p.x + g.step(), p.y);
+            }
+            Geometry geom = chance(tc, 50) ? GF.createLineString(cs) : GF.createMultiPointFromCoords(cs);
+            JtsTest.checkBoundingCircle(geom, cs, 1e-9 * Math.max(1, g.range));
+        }, Zoo.settings("jts.boundingCircleOfCoincidentPointsHasACentre"));
+    }
+}
