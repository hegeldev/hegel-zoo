+    /** Offset curves, coverage operations, the snap-rounding noder, WKT text variants, overlapping unions, normal form. */
+    @Test
+    void newerOperationsKeepInvariants() {
+        Hegel.test(tc -> {
+            GeoGen g = new GeoGen(tc);
+            double scale = Math.max(1, g.range);
+            switch (n(tc, 0, 4)) {
+                case 0 -> offsetCurve(tc, g, scale);
+                case 1 -> coverage(tc, g, scale);
+                case 2 -> noder(tc, g, scale);
+                case 3 -> wktVariants(tc, g);
+                default -> unionsAndNormalForm(tc, g, scale);
+            }
+        }, Zoo.settings("jts.newerOperationsKeepInvariants"));
+    }
