+    static void polygonizerAndMerger(TestCase tc, GeoGen g, double scale) {
+        Geometry a = g.polygonal();
+        // polygonize the boundary: the same polygons come back
+        Polygonizer pz = new Polygonizer(true);
+        pz.add(a.getBoundary());
+        Geometry polys = pz.getGeometry();
+        check(polys.getNumGeometries() == a.getNumGeometries(), () -> "Polygonizer of the boundary of " + wkt(a) + " gives " + polys.getNumGeometries() + " polygons: " + wkt(polys));
+        check(Exact.close(polys.getArea(), a.getArea(), 1e-9 * scale * scale), () -> "Polygonizer of the boundary of " + wkt(a) + " has area " + polys.getArea() + ", the input " + a.getArea() + ": " + wkt(polys));
+        check(polys.norm().equalsExact(a.norm()) || polys.equalsTopo(a), () -> "Polygonizer of the boundary of " + wkt(a) + " gives " + wkt(polys));
+        check(pz.getDangles().isEmpty() && pz.getCutEdges().isEmpty() && pz.getInvalidRingLines().isEmpty(), () -> "Polygonizer reports dangles/cut edges/invalid rings for the boundary of " + wkt(a));
+        // merge the split edges of a simple line back together
+        LineString line = g.simpleLine();
+        Coordinate[] cs = line.getCoordinates();
+        List<LineString> pieces = new ArrayList<>();
+        for (int i = 0; i + 1 < cs.length; i++) {
+            Coordinate[] seg = chance(tc, 50) ? new Coordinate[] {cs[i].copy(), cs[i + 1].copy()} : new Coordinate[] {cs[i + 1].copy(), cs[i].copy()};
+            pieces.add(GF.createLineString(seg));
+        }
+        java.util.Collections.shuffle(pieces, new java.util.Random(n(tc, 0, 1000)));
+        LineMerger lm = new LineMerger();
+        lm.add(pieces);
+        List<?> merged = new ArrayList<>(lm.getMergedLineStrings());
+        check(merged.size() == 1, () -> "LineMerger merges the " + pieces.size() + " pieces of " + wkt(line) + " into " + merged.size() + " lines: " + merged);
+        if (merged.size() == 1) {
+            LineString m = (LineString) merged.get(0);
+            check(m.equalsExact(line) || m.equalsExact(line.reverse()), () -> "LineMerger gives " + wkt(m) + " for the pieces of " + wkt(line));
+        }
+        // a line merged with itself split at a vertex: one line
+        Geometry union = line.union(line);
+        check(Exact.close(union.getLength(), line.getLength(), 1e-9 * scale), () -> "L ∪ L has length " + union.getLength() + ", L " + line.getLength() + " for " + wkt(line));
+    }
