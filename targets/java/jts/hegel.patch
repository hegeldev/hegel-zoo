+    // -------------------------------------------------------------------------------------------------- validity
+
+    /**
+     * Exact validity of a polygon with at most one hole, or of a two-polygon multipolygon, as far as the SFS rules
+     * decide it without interior-connectivity questions: null when the exact model does not decide.
+     */
+    static Boolean exactValid(P[] shell, P[] hole) {
+        if (!Exact.ringSimple(shell)) {
+            return false;
+        }
+        if (hole == null) {
+            return true;
+        }
+        if (!Exact.ringSimple(hole)) {
+            return false;
+        }
+        // the hole lies inside the shell: no vertex outside, no proper crossings, no collinear overlaps
+        for (P p : hole) {
+            if (Exact.locateInRing(p, shell) == Exact.EXTERIOR) {
+                return false;
+            }
+        }
+        for (P p : shell) {
+            if (Exact.locateInRing(p, hole) == Exact.INTERIOR) {
+                return false;
+            }
+        }
+        Set<P> touches = new HashSet<>();
+        for (int i = 0; i + 1 < hole.length; i++) {
+            for (int j = 0; j + 1 < shell.length; j++) {
+                SegInt si = Exact.intersect(hole[i], hole[i + 1], shell[j], shell[j + 1]);
+                if (si.kind() == SegInt.NONE) {
+                    continue;
+                }
+                if (si.kind() == SegInt.COLLINEAR || si.proper()) {
+                    return false;
+                }
+                touches.addAll(si.points());
+            }
+        }
+        // no piece of the hole runs outside the shell, no piece of the shell runs inside the hole
+        if (!noPieceIn(hole, shell, Exact.EXTERIOR) || !noPieceIn(shell, hole, Exact.INTERIOR)) {
+            return false;
+        }
+        // one touching point keeps the interior connected; more may not
+        if (touches.size() > 1) {
+            return null;
+        }
+        return true;
+    }
+
+    /**
+     * The edges of r1, split at every point where they meet r2, have no piece whose midpoint lies in r2's `side`
+     * (INTERIOR or EXTERIOR); pieces along r2's boundary are excluded by the collinear check done before.
+     */
+    static boolean noPieceIn(P[] r1, P[] r2, int side) {
+        for (int i = 0; i + 1 < r1.length; i++) {
+            P a = r1[i];
+            P b = r1[i + 1];
+            List<Q> ts = new ArrayList<>();
+            ts.add(Q.ZERO);
+            ts.add(Q.ONE);
+            P ab = b.sub(a);
+            Q len2 = ab.dot(ab);
+            if (len2.isZero()) {
+                continue;
+            }
+            for (int j = 0; j + 1 < r2.length; j++) {
+                SegInt si = Exact.intersect(a, b, r2[j], r2[j + 1]);
+                for (P x : si.points()) {
+                    ts.add(x.sub(a).dot(ab).div(len2));
+                }
+            }
+            java.util.Collections.sort(ts);
+            for (int k = 0; k + 1 < ts.size(); k++) {
+                if (ts.get(k).equals(ts.get(k + 1))) {
+                    continue;
+                }
+                Q t = ts.get(k).add(ts.get(k + 1)).div(Q.of(2));
+                P mid = new P(a.x().add(ab.x().mul(t)), a.y().add(ab.y().mul(t)));
+                if (Exact.locateInRing(mid, r2) == side) {
+                    return false;
+                }
+            }
+        }
+        return true;
+    }
+
+    static Boolean exactValidMulti(P[] r1, P[] r2) {
+        if (!Exact.ringSimple(r1) || !Exact.ringSimple(r2)) {
+            return false;
+        }
+        for (P p : r1) {
+            if (Exact.locateInRing(p, r2) == Exact.INTERIOR) {
+                return false;
+            }
+        }
+        for (P p : r2) {
+            if (Exact.locateInRing(p, r1) == Exact.INTERIOR) {
+                return false;
+            }
+        }
+        for (int i = 0; i + 1 < r1.length; i++) {
+            for (int j = 0; j + 1 < r2.length; j++) {
+                SegInt si = Exact.intersect(r1[i], r1[i + 1], r2[j], r2[j + 1]);
+                if (si.kind() == SegInt.COLLINEAR || si.proper()) {
+                    return false;
+                }
+            }
+        }
+        // no piece of either boundary runs through the other's interior (interiors are disjoint)
+        if (!noPieceIn(r1, r2, Exact.INTERIOR) || !noPieceIn(r2, r1, Exact.INTERIOR)) {
+            return false;
+        }
+        return true;
+    }
