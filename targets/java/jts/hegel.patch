+    /** Exact circumcentre of a non-degenerate triangle. */
+    static P circumcentre(P a, P b, P c) {
+        Q ax = a.x(), ay = a.y(), bx = b.x(), by = b.y(), cx = c.x(), cy = c.y();
+        Q d = Q.of(2).mul(ax.mul(by.sub(cy)).add(bx.mul(cy.sub(ay))).add(cx.mul(ay.sub(by))));
+        Q a2 = ax.mul(ax).add(ay.mul(ay));
+        Q b2 = bx.mul(bx).add(by.mul(by));
+        Q c2 = cx.mul(cx).add(cy.mul(cy));
+        Q ux = a2.mul(by.sub(cy)).add(b2.mul(cy.sub(ay))).add(c2.mul(ay.sub(by))).div(d);
+        Q uy = a2.mul(cx.sub(bx)).add(b2.mul(ax.sub(cx))).add(c2.mul(bx.sub(ax))).div(d);
+        return new P(ux, uy);
+    }
