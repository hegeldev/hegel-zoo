+    static void linearReferencing(TestCase tc, GeoGen g, double scale) {
+        LineString line = chance(tc, 70) ? g.simpleLine() : g.line();
+        LengthIndexedLine lil = new LengthIndexedLine(line);
+        double len = line.getLength();
+        check(lil.getStartIndex() == 0 && Exact.close(lil.getEndIndex(), len, 1e-9), () -> "LengthIndexedLine indices " + lil.getStartIndex() + ".." + lil.getEndIndex() + " for a line of length " + len);
+        Coordinate[] cs = line.getCoordinates();
+        double cum = 0;
+        for (int i = 0; i < cs.length; i++) {
+            if (i > 0) {
+                cum += cs[i - 1].distance(cs[i]);
+            }
+            final Coordinate v = cs[i];
+            Coordinate at = lil.extractPoint(cum);
+            final double idx = cum;
+            check(at.distance(v) <= 1e-7 * scale, () -> "extractPoint(" + idx + ") = " + at + " but vertex " + v + " is at that length along " + wkt(line));
+            double back = lil.indexOf(v);
+            Coordinate again = lil.extractPoint(back);
+            check(again.distance(v) <= 1e-7 * scale, () -> "extractPoint(indexOf(" + v + ") = " + back + ") = " + again + " along " + wkt(line));
+            double proj = lil.project(v);
+            Coordinate pj = lil.extractPoint(proj);
+            check(pj.distance(v) <= 1e-7 * scale, () -> "extractPoint(project(" + v + ") = " + proj + ") = " + pj + " along " + wkt(line));
+        }
+        // a random index: the extracted point lies on the line; a sub-line has the right length
+        if (len > 0) {
+            double i1 = len * n(tc, 0, 100) / 100.0;
+            double i2 = len * n(tc, 0, 100) / 100.0;
+            Coordinate p = lil.extractPoint(i1);
+            double dd = line.distance(GF.createPoint(p));
+            check(dd <= 1e-7 * scale, () -> "extractPoint(" + i1 + ") = " + p + " is " + dd + " off " + wkt(line));
+            Geometry sub = lil.extractLine(Math.min(i1, i2), Math.max(i1, i2));
+            check(Exact.close(sub.getLength(), Math.abs(i1 - i2), 1e-7 * scale), () -> "extractLine(" + Math.min(i1, i2) + ", " + Math.max(i1, i2) + ") has length " + sub.getLength() + " along " + wkt(line) + ": " + wkt(sub));
+            double idx = lil.indexOf(p);
+            Coordinate p2 = lil.extractPoint(idx);
+            check(p2.distance(p) <= 1e-7 * scale, () -> "extractPoint(indexOf(" + p + ") = " + idx + ") = " + p2 + " along " + wkt(line));
+            // an off-line point projects to the nearest point
+            Coordinate off = g.coord();
+            double pi = lil.project(off);
+            Coordinate nearest = lil.extractPoint(pi);
+            double dn = nearest.distance(off);
+            double dl = line.distance(GF.createPoint(off));
+            check(Exact.close(dn, dl, 1e-7 * scale), () -> "project(" + off + ") = " + pi + " gives " + nearest + " at " + dn + ", the line is " + dl + " away: " + wkt(line));
+        }
+    }
