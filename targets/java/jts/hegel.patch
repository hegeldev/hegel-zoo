+    // ------------------------------------------------------------------------------------------------ predicates
+
+    /** Exact intersects/disjoint for two geometries: some vertex of one in/on the other, or two edges meet. */
+    static boolean exactIntersects(Geometry a, Geometry b) {
+        List<P[]> ea = edges(a);
+        List<P[]> eb = edges(b);
+        for (P[] s : ea) {
+            for (P[] t : eb) {
+                if (Exact.segmentsIntersect(s[0], s[1], t[0], t[1])) {
+                    return true;
+                }
+            }
+        }
+        for (Coordinate c : a.getCoordinates()) {
+            if (inArea(c, b)) {
+                return true;
+            }
+        }
+        for (Coordinate c : b.getCoordinates()) {
+            if (inArea(c, a)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    static boolean inArea(Coordinate c, Geometry g) {
+        for (int i = 0; i < g.getNumGeometries(); i++) {
+            Geometry part = g.getGeometryN(i);
+            if (part instanceof Polygon poly && Exact.locateInPolygon(P.of(c), poly) != Exact.EXTERIOR) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    /** Every edge of a geometry as a pair of points; points give degenerate edges. */
+    static List<P[]> edges(Geometry g) {
+        List<P[]> out = new ArrayList<>();
+        for (int i = 0; i < g.getNumGeometries(); i++) {
+            Geometry part = g.getGeometryN(i);
+            if (part instanceof Point pt) {
+                if (!pt.isEmpty()) {
+                    P p = P.of(pt.getCoordinate());
+                    out.add(new P[] {p, p});
+                }
+            } else if (part instanceof LineString ls) {
+                P[] ps = Exact.points(ls.getCoordinates());
+                for (int k = 0; k + 1 < ps.length; k++) {
+                    out.add(new P[] {ps[k], ps[k + 1]});
+                }
+            } else if (part instanceof Polygon poly) {
+                out.addAll(edges(poly.getExteriorRing()));
+                for (int k = 0; k < poly.getNumInteriorRing(); k++) {
+                    out.addAll(edges(poly.getInteriorRingN(k)));
+                }
+            } else {
+                out.addAll(edges(part));
+            }
+        }
+        return out;
+    }
+
+    /** Exact distance between two geometries: 0 when they intersect, else the minimum edge-edge distance. */
+    static double exactDistance(Geometry a, Geometry b) {
+        if (exactIntersects(a, b)) {
+            return 0;
+        }
+        Q best = null;
+        for (P[] s : edges(a)) {
+            for (P[] t : edges(b)) {
+                Q d = Exact.segDistSq(s[0], s[1], t[0], t[1]);
+                best = best == null ? d : best.min(d);
+            }
+        }
+        return best == null ? Double.NaN : best.sqrt();
+    }
+
+    /** RelateOp and RelateNG give the same matrix for the pair (jts/4's and jts/5's oracle, shared with JtsShapesTest). */
+    static void checkRelateAgree(IntersectionMatrix old, IntersectionMatrix ng, String pair) {
+        check(old.toString().equals(ng.toString()), () -> "RelateOp gives " + old + ", RelateNG gives " + ng + " for " + pair);
+    }
+
+    /**
+     * Two segments of the lineal geometry cross properly at a point on an edge of the other geometry: on a polygon's
+     * boundary (jts/4's shape) or on a line collinear with the crossing segment (jts/5's shape).
+     */
+    static boolean selfCrossingOn(Geometry lineal, Geometry other) {
+        if (lineal.getDimension() != 1 || other.getDimension() < 1) {
+            return false;
+        }
+        List<P[]> edges = edges(other);
+        List<P[]> segs = edges(lineal);
+        for (int i = 0; i < segs.size(); i++) {
+            for (int j = i + 1; j < segs.size(); j++) {
+                SegInt si = Exact.intersect(segs.get(i)[0], segs.get(i)[1], segs.get(j)[0], segs.get(j)[1]);
+                if (!si.proper()) {
+                    continue;
+                }
+                for (P[] edge : edges) {
+                    if (Exact.onSegment(si.points().get(0), edge[0], edge[1])) {
+                        return true;
+                    }
+                }
+            }
+        }
+        return false;
+    }
+
+    /** A non-empty lineal geometry (or collection with one) whose points are all equal: dimension 1 by type, a point in fact. */
+    static boolean zeroLength(Geometry g) {
+        for (int i = 0; i < g.getNumGeometries(); i++) {
+            Geometry part = g.getGeometryN(i);
+            if (part instanceof LineString ls && !ls.isEmpty() && ls.getLength() == 0) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    /** RelateOp, RelateNG and prepared geometries agree, the matrix obeys its laws, and intersects/distance are exact. */
+    @Test
+    void predicatesAgree() {
+        Hegel.test(tc -> {
+            GeoGen g = new GeoGen(tc);
+            Geometry a = g.simpleTyped();
+            // a zero-length line (all points equal) is invalid in JTS and relates as empty (RelateOp) or as
+            // one-dimensional (RelateNG): not judged (README, "What the generator avoids"); not a recorded bug
+            tc.assume(!zeroLength(a));
+            Geometry b;
+            int rel = n(tc, 0, 99);
+            if (rel < 15) {
+                b = a.copy();
+            } else if (rel < 25) {
+                b = a.reverse();
+            } else if (rel < 35) {
+                b = GeoGen.translate(a, g.step() * n(tc, -3, 3), g.step() * n(tc, -3, 3));
+            } else if (rel < 45 && a.getNumPoints() > 0) {
+                b = GF.createPoint(a.getCoordinates()[n(tc, 0, a.getNumPoints() - 1)].copy());
+            } else {
+                b = g.simpleTyped();
+            }
+            tc.assume(!zeroLength(b));
+            // jts/4: RelateOp gives dim(boundary(A) meets interior(B)) = 1 when two segments of the lineal B cross each
+            // other at a point of the polygonal A's boundary, e.g. POLYGON ((0 0, 4 0, 4 4, 0 4, 0 0)) and
+            // LINESTRING (1 2, 5 6, 5 2, 1 6): 1021F1102, where RelateNG (and the boundary's intersection with B, two
+            // points) gives 1020F1102; jts/5: a line collinear with a segment of a self-crossing line through a
+            // crossing point that is not exactly representable is related as mostly outside it (001F001F2 for
+            // LINESTRING (0 0, 1 -1, 0 -1, 1 1) and LINESTRING (0 -1, 1 1), RelateNG 101F00FF2). Both shapes are drawn
+            // and judged by default (JtsShapesTest carries each), under HEGEL_NO_KNOWN left out
+            if (Zoo.NO_KNOWN) {
+                tc.assume(!selfCrossingOn(a, b) && !selfCrossingOn(b, a));
+            }
+            String pair = wkt(a) + " and " + wkt(b);
+
+            IntersectionMatrix old = RelateOp.relate(a, b);
+            IntersectionMatrix ng = RelateNG.relate(a, b);
+            checkRelateAgree(old, ng, pair);
+            IntersectionMatrix back = RelateOp.relate(b, a);
+            check(back.toString().equals(new IntersectionMatrix(old).transpose().toString()), () -> "relate(b, a) = " + back + " is not the transpose of relate(a, b) = " + old + " for " + pair);
+            IntersectionMatrix backNg = RelateNG.relate(b, a);
+            check(backNg.toString().equals(new IntersectionMatrix(ng).transpose().toString()), () -> "RelateNG(b, a) = " + backNg + " is not the transpose of RelateNG(a, b) = " + ng + " for " + pair);
+
+            int da = a.getDimension();
+            int db = b.getDimension();
+            check(a.intersects(b) == old.isIntersects(), () -> "intersects = " + a.intersects(b) + " but the matrix " + old + " says " + old.isIntersects() + " for " + pair);
+            check(a.disjoint(b) == !a.intersects(b), () -> "disjoint = " + a.disjoint(b) + ", intersects = " + a.intersects(b) + " for " + pair);
+            check(a.contains(b) == old.isContains(), () -> "contains = " + a.contains(b) + " but the matrix " + old + " says " + old.isContains() + " for " + pair);
+            check(a.within(b) == old.isWithin(), () -> "within = " + a.within(b) + " but the matrix " + old + " says " + old.isWithin() + " for " + pair);
+            check(a.covers(b) == old.isCovers(), () -> "covers = " + a.covers(b) + " but the matrix " + old + " says " + old.isCovers() + " for " + pair);
+            check(a.coveredBy(b) == old.isCoveredBy(), () -> "coveredBy = " + a.coveredBy(b) + " but the matrix " + old + " says " + old.isCoveredBy() + " for " + pair);
+            check(a.touches(b) == old.isTouches(da, db), () -> "touches = " + a.touches(b) + " but the matrix " + old + " says " + old.isTouches(da, db) + " for " + pair);
+            check(a.crosses(b) == old.isCrosses(da, db), () -> "crosses = " + a.crosses(b) + " but the matrix " + old + " says " + old.isCrosses(da, db) + " for " + pair);
+            check(a.overlaps(b) == old.isOverlaps(da, db), () -> "overlaps = " + a.overlaps(b) + " but the matrix " + old + " says " + old.isOverlaps(da, db) + " for " + pair);
+            check(a.equalsTopo(b) == old.isEquals(da, db), () -> "equalsTopo = " + a.equalsTopo(b) + " but the matrix " + old + " says " + old.isEquals(da, db) + " for " + pair);
+            check(a.contains(b) == b.within(a), () -> "a.contains(b) = " + a.contains(b) + ", b.within(a) = " + b.within(a) + " for " + pair);
+            check(a.covers(b) == b.coveredBy(a), () -> "a.covers(b) = " + a.covers(b) + ", b.coveredBy(a) = " + b.coveredBy(a) + " for " + pair);
+            check(!a.contains(b) || a.covers(b), () -> "contains without covers for " + pair);
+            check(!(a.covers(b) && b.covers(a)) || a.equalsTopo(b), () -> "mutual covers without equalsTopo for " + pair);
+
+            // prepared geometry
+            PreparedGeometry pa = PreparedGeometryFactory.prepare(a);
+            check(pa.intersects(b) == a.intersects(b), () -> "prepared intersects = " + pa.intersects(b) + ", plain " + a.intersects(b) + " for " + pair);
+            check(pa.contains(b) == a.contains(b), () -> "prepared contains = " + pa.contains(b) + ", plain " + a.contains(b) + " for " + pair);
+            check(pa.covers(b) == a.covers(b), () -> "prepared covers = " + pa.covers(b) + ", plain " + a.covers(b) + " for " + pair);
+            check(pa.coveredBy(b) == a.coveredBy(b), () -> "prepared coveredBy = " + pa.coveredBy(b) + ", plain " + a.coveredBy(b) + " for " + pair);
+            check(pa.within(b) == a.within(b), () -> "prepared within = " + pa.within(b) + ", plain " + a.within(b) + " for " + pair);
+            check(pa.disjoint(b) == a.disjoint(b), () -> "prepared disjoint = " + pa.disjoint(b) + ", plain " + a.disjoint(b) + " for " + pair);
+            check(pa.touches(b) == a.touches(b), () -> "prepared touches = " + pa.touches(b) + ", plain " + a.touches(b) + " for " + pair);
+            check(pa.crosses(b) == a.crosses(b), () -> "prepared crosses = " + pa.crosses(b) + ", plain " + a.crosses(b) + " for " + pair);
+            check(pa.overlaps(b) == a.overlaps(b), () -> "prepared overlaps = " + pa.overlaps(b) + ", plain " + a.overlaps(b) + " for " + pair);
+            boolean cp = a.relate(b, "T**FF*FF*");
+            check(pa.containsProperly(b) == cp, () -> "prepared containsProperly = " + pa.containsProperly(b) + ", relate T**FF*FF* = " + cp + " for " + pair);
+            // RelateNG prepared
