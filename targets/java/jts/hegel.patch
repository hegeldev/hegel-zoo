+    // ----------------------------------------------------------------------------------------------- constructions
+
+    /** Buffer, simplifiers, densifier, precision reducer, fixer, Delaunay/Voronoi, polygonizer, merger, linear referencing. */
+    @Test
+    void constructionsKeepInvariants() {
+        Hegel.test(tc -> {
+            GeoGen g = new GeoGen(tc);
+            double scale = Math.max(1, g.range);
+            int kind = n(tc, 0, 6);
+            switch (kind) {
+                case 0 -> bufferInvariants(tc, g, scale);
+                case 1 -> simplifierInvariants(tc, g, scale);
+                case 2 -> triangulationInvariants(tc, g, scale);
+                case 3 -> fixerInvariants(tc, g, scale);
+                case 4 -> polygonizerAndMerger(tc, g, scale);
+                case 5 -> linearReferencing(tc, g, scale);
+                default -> affineInvariants(tc, g, scale);
+            }
+        }, Zoo.settings("jts.constructionsKeepInvariants"));
+    }
+
+    static void bufferInvariants(TestCase tc, GeoGen g, double scale) {
+        Geometry a = chance(tc, 60) ? g.polygonal() : (chance(tc, 50) ? g.simpleLine() : g.point());
+        double d = pick(tc, 0.5, 1.0, 2.0, 0.125, 3.0) * Math.max(1, g.range / 10.0);
+        int quad = pick(tc, 1, 2, 8, 8, 16);
+        Geometry buf = a.buffer(d, quad);
+        check(buf.isValid(), () -> "buffer(" + d + ", " + quad + ") of " + wkt(a) + " is invalid: " + wkt(buf) + " (" + new IsValidOp(buf).getValidationError() + ")");
+        check(buf.getArea() >= a.getArea() - 1e-9, () -> "buffer(" + d + ") of " + wkt(a) + " has area " + buf.getArea() + " < " + a.getArea());
+        // covers the input: every input vertex lies inside
+        for (Coordinate c : a.getCoordinates()) {
+            int l = exactLocate(c, buf instanceof Polygon || buf instanceof MultiPolygon ? buf : GF.createPolygon());
+            check(l == Exact.INTERIOR, () -> "buffer(" + d + ", " + quad + ") of " + wkt(a) + " does not strictly contain the input vertex " + c + " (" + loc(l) + "): " + wkt(buf));
+        }
+        // every boundary vertex is at distance d from the input, within the approximation
+        // the offset curve approximates circles by quadrantSegments chords (vertices on the circle, so their crossings
+        // may lie inside by the chord sagitta) and simplifies the input by BufferParameters.DEFAULT_SIMPLIFY_FACTOR (1 %)
+        double simp = BufferParameters.DEFAULT_SIMPLIFY_FACTOR * d;
+        // a fillet has round(angle / quantum) segments with quantum = pi / (2 quad), so one chord spans up to 1.5 quanta
+        double lower = d * Math.cos(0.75 * Math.PI / (2.0 * quad)) - 3 * simp - 1e-6 * Math.max(1, d);
+        double upper = d + simp + 1e-6 * Math.max(1, d);
+        for (Coordinate c : buf.getCoordinates()) {
+            double dd = a.distance(GF.createPoint(c));
+            check(dd <= upper, () -> "buffer(" + d + ", " + quad + ") boundary vertex " + c + " is " + dd + " from " + wkt(a) + " (> " + d + ")");
+            check(dd >= lower, () -> "buffer(" + d + ", " + quad + ") boundary vertex " + c + " is only " + dd + " from " + wkt(a) + " (< " + lower + ")");
+        }
+        // monotone in the distance
+        Geometry buf2 = a.buffer(2 * d, quad);
+        check(buf2.getArea() >= buf.getArea() - 1e-9, () -> "buffer(" + 2 * d + ") has area " + buf2.getArea() + " < buffer(" + d + ") area " + buf.getArea() + " for " + wkt(a));
+        // buffer(0) of a valid polygonal geometry keeps it
+        if (a.getDimension() == 2) {
+            Geometry z = a.buffer(0);
+            check(Exact.close(z.getArea(), a.getArea(), 1e-9 * scale * scale), () -> "buffer(0) of " + wkt(a) + " has area " + z.getArea() + ", the input " + a.getArea());
+            check(z.equalsTopo(a), () -> "buffer(0) of " + wkt(a) + " is " + wkt(z) + ", not topologically equal");
+            Geometry z2 = BufferOp.bufferByZero(a, false);
+            check(Exact.close(z2.getArea(), a.getArea(), 1e-9 * scale * scale), () -> "bufferByZero of " + wkt(a) + " has area " + z2.getArea() + ", the input " + a.getArea());
+            // negative buffer: within the input, boundary vertices at distance d from the input boundary
+            Geometry neg = a.buffer(-d, quad);
+            check(neg.isValid(), () -> "buffer(" + -d + ") of " + wkt(a) + " is invalid: " + wkt(neg));
+            check(neg.getArea() <= a.getArea() + 1e-9, () -> "buffer(" + -d + ") of " + wkt(a) + " has area " + neg.getArea() + " > " + a.getArea());
+            Geometry boundary = a.getBoundary();
+            for (Coordinate c : neg.getCoordinates()) {
+                int l = exactLocate(c, a);
+                check(l == Exact.INTERIOR, () -> "buffer(" + -d + ") vertex " + c + " lies in the " + loc(l) + " of " + wkt(a) + ": " + wkt(neg));
+                double dd = boundary.distance(GF.createPoint(c));
+                check(dd >= lower && dd <= upper, () -> "buffer(" + -d + ", " + quad + ") boundary vertex " + c + " is " + dd + " from the boundary of " + wkt(a) + " (expected " + lower + ".." + upper + ")");
+            }
+        }
+        // end cap styles for lines: flat and square caps have smaller/larger area than the round one
+        if (a.getDimension() == 1) {
+            Geometry flat = a.buffer(d, quad, BufferParameters.CAP_FLAT);
+            Geometry square = a.buffer(d, quad, BufferParameters.CAP_SQUARE);
+            check(flat.isValid() && square.isValid(), () -> "flat/square buffers of " + wkt(a) + " invalid: " + wkt(flat) + " / " + wkt(square));
+            check(flat.getArea() <= buf.getArea() + 1e-9, () -> "flat-cap buffer area " + flat.getArea() + " exceeds the round one " + buf.getArea() + " for " + wkt(a));
+            check(square.getArea() >= buf.getArea() - 1e-9, () -> "square-cap buffer area " + square.getArea() + " is below the round one " + buf.getArea() + " for " + wkt(a));
+        }
+    }
