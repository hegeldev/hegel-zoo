+    static void fixerInvariants(TestCase tc, GeoGen g, double scale) {
+        Geometry a;
+        int k = n(tc, 0, 99);
+        if (k < 40) {
+            a = GF.createPolygon(g.anyRing());
+        } else if (k < 55) {
+            a = GF.createPolygon(g.anyRing(), new LinearRing[] {g.anyRing()});
+        } else if (k < 70) {
+            a = GF.createMultiPolygon(new Polygon[] {g.polygon(), GF.createPolygon(g.anyRing())});
+        } else if (k < 85) {
+            a = g.polygon();
+        } else {
+            a = g.line();
+        }
+        boolean valid = a.isValid();
+        Geometry fixed;
+        try {
+            fixed = GeometryFixer.fix(a);
+        } catch (RuntimeException e) {
+            check(false, "GeometryFixer.fix throws " + e + " for " + wkt(a));
+            return;
+        }
+        check(fixed.isValid(), () -> "GeometryFixer.fix(" + wkt(a) + ") = " + wkt(fixed) + " is invalid: " + new IsValidOp(fixed).getValidationError());
+        if (valid) {
+            check(fixed.equalsTopo(a) || (a.getDimension() == 2 && Exact.close(fixed.getArea(), a.getArea(), 1e-9 * scale * scale)), () -> "GeometryFixer changes the valid " + wkt(a) + " into " + wkt(fixed));
+        }
+        // the fix of a polygon covers... at least keeps every vertex on or inside for a self-intersecting ring? not guaranteed. Area: the fixed area is at most the ring's absolute area sum
+        if (a.getDimension() == 2) {
+            check(fixed.getDimension() == 2 || fixed.isEmpty(), () -> "GeometryFixer turns the area " + wkt(a) + " into " + wkt(fixed));
+            Geometry buf0 = a.buffer(0);
+            check(buf0.isValid(), () -> "buffer(0) of " + wkt(a) + " is invalid: " + wkt(buf0));
+            // IsValidOp reports a location for invalid inputs, and the location is on the geometry
+            if (!valid) {
+                IsValidOp op = new IsValidOp(a);
+                check(op.getValidationError() != null, () -> "isValid is false but getValidationError is null for " + wkt(a));
+                if (op.getValidationError() != null && op.getValidationError().getCoordinate() != null) {
+                    Coordinate ec = op.getValidationError().getCoordinate();
+                    double dd = a.getBoundary().distance(GF.createPoint(ec));
+                    check(dd <= 1e-6 * scale || a.getBoundary().isEmpty(), () -> "the validation error " + op.getValidationError() + " of " + wkt(a) + " is " + dd + " away from the geometry");
+                }
+            }
+        }
+        // isSimple agrees between the Geometry method and IsSimpleOp
+        check(a.isSimple() == IsSimpleOp.isSimple(a), () -> "isSimple = " + a.isSimple() + " but IsSimpleOp.isSimple = " + IsSimpleOp.isSimple(a) + " for " + wkt(a));
+        check(IsValidOp.isValid(a) == valid, () -> "IsValidOp.isValid = " + IsValidOp.isValid(a) + " but isValid = " + valid + " for " + wkt(a));
+    }
