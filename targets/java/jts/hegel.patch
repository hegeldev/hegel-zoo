+                int l3 = new PointLocator().locate(p, poly);
+                check(l1 == le2, () -> "SimplePointInAreaLocator.locate(" + p + ", " + wkt(poly) + ") = " + loc(l1) + ", exactly " + loc(le2));
+                check(l2 == le2, () -> "IndexedPointInAreaLocator.locate(" + p + ", " + wkt(poly) + ") = " + loc(l2) + ", exactly " + loc(le2));
+                check(l3 == le2, () -> "PointLocator.locate(" + p + ", " + wkt(poly) + ") = " + loc(l3) + ", exactly " + loc(le2));
+                Point pt = GF.createPoint(p);
+                check(poly.contains(pt) == (le2 == Exact.INTERIOR), () -> "contains(" + pt + ") = " + poly.contains(pt) + " for " + wkt(poly) + ", the point is in the " + loc(le2));
+                check(poly.covers(pt) == (le2 != Exact.EXTERIOR), () -> "covers(" + pt + ") = " + poly.covers(pt) + " for " + wkt(poly) + ", the point is in the " + loc(le2));
+                check(poly.intersects(pt) == (le2 != Exact.EXTERIOR), () -> "intersects(" + pt + ") = " + poly.intersects(pt) + " for " + wkt(poly) + ", the point is in the " + loc(le2));
+                check(poly.touches(pt) == (le2 == Exact.BOUNDARY), () -> "touches(" + pt + ") = " + poly.touches(pt) + " for " + wkt(poly) + ", the point is in the " + loc(le2));
