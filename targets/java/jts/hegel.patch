+                Envelope envE = new Envelope(minX, maxX, minY, maxY);
+                check(env.equals(envE), () -> "getEnvelopeInternal of " + wkt(poly) + " = " + env + ", exactly " + envE);
+                // point location in the polygon three ways
+                Coordinate p = chance(tc, 40) ? poly.getCoordinates()[n(tc, 0, poly.getNumPoints() - 1)].copy() : g.coord();
+                int le2 = exactLocate(p, poly);
