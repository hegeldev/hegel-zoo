+    static void offsetCurve(TestCase tc, GeoGen g, double scale) {
+        LineString line = chance(tc, 70) ? g.simpleLine() : g.line();
+        double d = pick(tc, -2.0, -1.0, -0.5, 0.5, 1.0, 2.0) * Math.max(1, g.range / 10.0);
+        int quad = pick(tc, 4, 8, 8, 16);
+        Geometry curve;
+        try {
+            curve = OffsetCurve.getCurve(line, d, quad, BufferParameters.JOIN_ROUND, BufferParameters.DEFAULT_MITRE_LIMIT);
+        } catch (RuntimeException e) {
+            check(false, "OffsetCurve.getCurve(" + wkt(line) + ", " + d + ") throws " + e);
+            return;
+        }
+        check(curve.getDimension() == 1 || curve.isEmpty(), () -> "OffsetCurve.getCurve(" + wkt(line) + ", " + d + ") = " + wkt(curve));
+        double ad = Math.abs(d);
+        double simp = BufferParameters.DEFAULT_SIMPLIFY_FACTOR * ad;
+        double lower = ad * Math.cos(0.75 * Math.PI / (2.0 * quad)) - 3 * simp - 1e-6 * Math.max(1, ad);
+        double upper = ad + simp + 1e-6 * Math.max(1, ad);
+        for (Coordinate c : curve.getCoordinates()) {
+            double dd = line.distance(GF.createPoint(c));
+            check(dd >= lower && dd <= upper, () -> "OffsetCurve.getCurve(" + wkt(line) + ", " + d + ", " + quad + ") vertex " + c + " is " + dd + " from the line (expected " + lower + ".." + upper + "): " + wkt(curve));
+        }
+        // (the curve is not compared with the buffer boundary: the buffer simplifies its input by 1 % of d, which a
+        // sharp inside turn amplifies to several per cent between the two outlines)
+        Geometry joined = OffsetCurve.getCurveJoined(line, d);
+        for (Coordinate c : joined.getCoordinates()) {
+            double dd = line.distance(GF.createPoint(c));
+            check(dd <= ad + simp + 1e-6 * Math.max(1, ad), () -> "OffsetCurve.getCurveJoined(" + wkt(line) + ", " + d + ") vertex " + c + " is " + dd + " from the line: " + wkt(joined));
+        }
+        Coordinate[] raw = OffsetCurve.rawOffset(line, d);
+        // on the inside of its turns the raw curve collapses to a point when the distance is at least as long as every segment
+        double longest = 0;
+        for (P[] e : edges(line)) {
+            longest = Math.max(longest, e[0].distSq(e[1]).sqrt());
+        }
+        final double longestSegment = longest;
+        check(raw.length >= 2 || ad >= longestSegment, () -> "OffsetCurve.rawOffset(" + wkt(line) + ", " + d + ") has " + raw.length + " points (longest segment " + longestSegment + ")");
+    }
+
+    /** Splits a polygonal geometry with a vertical line into two exactly edge-matched pieces. */
+    static Geometry[] split(Geometry poly, double x) {
+        Envelope e = poly.getEnvelopeInternal();
+        Geometry left = GF.toGeometry(new Envelope(e.getMinX() - 1, x, e.getMinY() - 1, e.getMaxY() + 1));
+        Geometry right = GF.toGeometry(new Envelope(x, e.getMaxX() + 1, e.getMinY() - 1, e.getMaxY() + 1));
+        return new Geometry[] {OverlayNGRobust.overlay(poly, left, OverlayNG.INTERSECTION), OverlayNGRobust.overlay(poly, right, OverlayNG.INTERSECTION)};
+    }
+
+    static void coverage(TestCase tc, GeoGen g, double scale) {
+        Geometry poly = g.polygonal();
+        Envelope env = poly.getEnvelopeInternal();
+        if (env.getWidth() == 0) {
+            return;
+        }
+        double x0 = env.getMinX() + env.getWidth() * n(tc, 1, 9) / 10.0;
+        final double x = g.scheme == 0 ? Math.rint(x0) : x0;
+        Geometry[] parts = split(poly, x);
+        List<Geometry> cov = new ArrayList<>();
+        for (Geometry part : parts) {
+            for (int i = 0; i < part.getNumGeometries(); i++) {
+                if (part.getGeometryN(i) instanceof Polygon p && !p.isEmpty()) {
+                    cov.add(p);
+                }
+            }
+        }
+        if (cov.isEmpty()) {
+            return;
+        }
+        Geometry[] coverage = cov.toArray(new Geometry[0]);
+        String desc = wkt(poly) + " split at x = " + x;
+        boolean valid = CoverageValidator.isValid(coverage);
+        check(valid, () -> "CoverageValidator rejects the split coverage of " + desc + ": " + Arrays.toString(CoverageValidator.validate(coverage)));
+        Geometry union;
+        try {
+            union = CoverageUnion.union(coverage);
+        } catch (RuntimeException e) {
+            check(false, "CoverageUnion.union throws " + e + " for " + desc);
+            return;
+        }
+        double areaTol = 1e-7 * scale * scale;
+        check(Exact.close(union.getArea(), poly.getArea(), areaTol), () -> "CoverageUnion of " + desc + " has area " + union.getArea() + ", the input " + poly.getArea() + ": " + wkt(union));
+        check(union.isValid(), () -> "CoverageUnion of " + desc + " is invalid: " + wkt(union));
+        double sum0 = 0;
+        for (Geometry c : coverage) {
+            sum0 += c.getArea();
+        }
+        final double sum = sum0;
+        check(Exact.close(sum, poly.getArea(), areaTol), () -> "the split parts of " + desc + " have areas summing to " + sum + ", the input " + poly.getArea());
+        // simplification keeps a valid coverage of the same size, and the total area within reason
+        double tol = pick(tc, 0.0, 0.5, 1.0) * Math.max(1, g.range / 10.0);
+        Geometry[] simp;
+        try {
+            simp = CoverageSimplifier.simplify(coverage, tol);
+        } catch (RuntimeException e) {
+            check(false, "CoverageSimplifier.simplify(" + tol + ") throws " + e + " for " + desc);
+            return;
+        }
+        check(simp.length == coverage.length, () -> "CoverageSimplifier.simplify(" + tol + ") of " + desc + " returns " + simp.length + " geometries for " + coverage.length);
+        check(CoverageValidator.isValid(simp), () -> "CoverageSimplifier.simplify(" + tol + ") of " + desc + " gives an invalid coverage: " + Arrays.toString(simp));
+        for (int i = 0; i < simp.length; i++) {
+            final int k = i;
+            check(simp[i].isValid(), () -> "CoverageSimplifier.simplify(" + tol + ") of " + desc + " gives the invalid part " + wkt(simp[k]));
+            check(simp[i].getNumPoints() <= coverage[i].getNumPoints(), () -> "CoverageSimplifier.simplify(" + tol + ") adds vertices to part " + k + " of " + desc + ": " + wkt(simp[k]));
+            if (tol == 0) {
+                check(simp[i].equalsTopo(coverage[i]) || Exact.close(simp[i].getArea(), coverage[i].getArea(), areaTol), () -> "CoverageSimplifier.simplify(0) changes part " + k + " of " + desc + " into " + wkt(simp[k]));
+            }
+        }
+        Geometry simpUnion = CoverageUnion.union(simp);
+        if (tol == 0) {
+            check(Exact.close(simpUnion.getArea(), poly.getArea(), areaTol), () -> "CoverageSimplifier.simplify(0) of " + desc + " changes the total area to " + simpUnion.getArea() + " from " + poly.getArea());
+        }
+        // gaps: a split coverage without holes has none (a narrow hole of the input is, rightly, a gap of the coverage)
+        boolean holes = false;
+        for (int i = 0; i < poly.getNumGeometries(); i++) {
+            holes |= ((Polygon) poly.getGeometryN(i)).getNumInteriorRing() > 0;
+        }
+        Geometry gaps = CoverageGapFinder.findGaps(coverage, Math.max(1, g.range / 10.0));
+        check(holes || gaps.isEmpty(), () -> "CoverageGapFinder finds gaps in the split coverage of " + desc + ": " + wkt(gaps));
+        // a translated copy overlapping the first part is not a valid coverage
+        if (coverage.length >= 1 && coverage[0].getArea() > 0) {
+            Geometry moved = GeoGen.translate(coverage[0], g.step(), 0);
+            Geometry[] bad = {coverage[0], moved};
+            boolean badValid = CoverageValidator.isValid(bad);
+            boolean overlap = coverage[0].overlaps(moved) || coverage[0].equalsTopo(moved) || coverage[0].contains(moved) || moved.contains(coverage[0]);
+            // (touching along part of an edge is also invalid, since coverage edges must match vertex for vertex)
+            check(!overlap || !badValid, () -> "CoverageValidator.isValid = " + badValid + " for " + wkt(coverage[0]) + " and its overlapping copy shifted by " + g.step());
+        }
+    }
+
+    static void noder(TestCase tc, GeoGen g, double scale) {
+        List<Geometry> lines = new ArrayList<>();
+        int k = n(tc, 1, 4);
+        for (int i = 0; i < k; i++) {
+            lines.add(chance(tc, 50) ? g.simpleLine() : g.line());
+        }
+        double gridScale = pick(tc, 1.0, 2.0, 8.0);
+        PrecisionModel pm = new PrecisionModel(gridScale);
+        GeometryNoder noder = new GeometryNoder(pm);
+        List<?> noded;
+        try {
+            noded = noder.node(lines);
+        } catch (RuntimeException e) {
+            check(false, "GeometryNoder(" + gridScale + ") throws " + e + " for " + lines);
+            return;
+        }
+        List<P[]> segs = new ArrayList<>();
+        for (Object o : noded) {
+            LineString ls = (LineString) o;
+            Coordinate[] cs = ls.getCoordinates();
+            for (Coordinate c : cs) {
+                check(c.x * gridScale == Math.rint(c.x * gridScale) && c.y * gridScale == Math.rint(c.y * gridScale), () -> "GeometryNoder(" + gridScale + ") leaves " + c + " off the grid for " + lines + ": " + noded);
+            }
+            P[] ps = Exact.points(cs);
+            for (int i = 0; i + 1 < ps.length; i++) {
+                if (!ps[i].equals(ps[i + 1])) {
+                    segs.add(new P[] {ps[i], ps[i + 1]});
+                }
+            }
+        }
+        // fully noded: no two segments meet except at shared endpoints
+        for (int i = 0; i < segs.size(); i++) {
+            for (int j = i + 1; j < segs.size(); j++) {
+                P[] s1 = segs.get(i);
+                P[] s2 = segs.get(j);
+                SegInt si = Exact.intersect(s1[0], s1[1], s2[0], s2[1]);
+                if (si.kind() == SegInt.NONE) {
+                    continue;
+                }
+                boolean ok = si.kind() == SegInt.POINT && !si.proper();
+                if (ok) {
+                    P x = si.points().get(0);
+                    ok = (x.equals(s1[0]) || x.equals(s1[1])) && (x.equals(s2[0]) || x.equals(s2[1]));
+                }
+                // coincident segments (from different lines, or a line revisiting an edge) stay separate: noded at both ends
+                if (si.kind() == SegInt.COLLINEAR && ((s1[0].equals(s2[0]) && s1[1].equals(s2[1])) || (s1[0].equals(s2[1]) && s1[1].equals(s2[0])))) {
+                    ok = true;
+                }
+                final boolean fine = ok;
+                check(fine, () -> "GeometryNoder(" + gridScale + ") output is not noded: " + s1[0] + "-" + s1[1] + " meets " + s2[0] + "-" + s2[1] + " at " + si.points() + " (collinear: " + (si.kind() == SegInt.COLLINEAR) + ") for " + lines);
+            }
+        }
+        // every input vertex is within a snap distance of the output, except those of a line whose vertices all snap
+        // to one grid point: snap-rounding drops such a collapsed line (a zero-length line is invalid in JTS anyway)
+        Geometry out = GF.buildGeometry(new ArrayList<>(noded));
+        double snap = Math.sqrt(2) / (2 * gridScale) + 1e-9 * scale;
+        for (Geometry l : lines) {
+            if (collapses(l, pm)) {
+                continue;
+            }
+            for (Coordinate c : l.getCoordinates()) {
+                double dd = out.isEmpty() ? 0 : out.distance(GF.createPoint(c));
+                check(dd <= snap, () -> "GeometryNoder(" + gridScale + ") moves the input vertex " + c + " by " + dd + " for " + lines + ": " + noded);
+            }
+        }
+    }
+
+    /** All vertices of the line round to the same point of the precision model's grid. */
+    static boolean collapses(Geometry line, PrecisionModel pm) {
+        Coordinate first = null;
+        for (Coordinate c : line.getCoordinates()) {
+            Coordinate s = c.copy();
+            pm.makePrecise(s);
+            if (first == null) {
+                first = s;
+            } else if (!first.equals2D(s)) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    static void wktVariants(TestCase tc, GeoGen g) {
+        Geometry a = g.any();
+        String text = a.toText();
+        StringBuilder sb = new StringBuilder();
+        java.util.regex.Matcher m = java.util.regex.Pattern.compile("[A-Za-z]+|-?\\d+(?:\\.\\d+)?|[(),]").matcher(text);
+        boolean prevNumber = false;
+        boolean prevWord = false;
+        while (m.find()) {
+            String tok = m.group();
+            boolean number = tok.matches("-?\\d.*");
+            boolean word = Character.isLetter(tok.charAt(0));
+            if (chance(tc, 30) || (prevNumber && number) || (prevWord && word)) {
+                sb.append(pick(tc, " ", "  ", "\t", "\n", " \r\n "));
+            }
+            prevNumber = number;
+            prevWord = word;
+            if (Character.isLetter(tok.charAt(0))) {
+                sb.append(chance(tc, 50) ? tok : chance(tc, 50) ? tok.toLowerCase() : mixedCase(tc, tok));
+            } else if (tok.matches("-?\\d.*")) {
+                sb.append(numberVariant(tc, tok));
+            } else {
+                sb.append(tok);
+            }
+        }
+        String variant = sb.toString();
+        try {
+            // the oracle is the plain text's parse: a variant must read as the text it was made from (whether the text
+            // reads back as the geometry is readersInvertWriters' question, jts/1 included)
+            Geometry plain = WKT.read(text);
+            Geometry back = WKT.read(variant);
+            check(back.equalsExact(plain) && sameTypes(back, plain), () -> "WKT variant " + Zoo.show(variant) + " of " + text + " reads as " + wkt(back) + " with the coordinates " + Arrays.toString(back.getCoordinates()) + ", the text as " + Arrays.toString(plain.getCoordinates()));
+        } catch (ParseException | RuntimeException e) {
+            check(false, "WKTReader rejects the variant " + Zoo.show(variant) + " of " + text + ": " + e);
+        }
+    }
+
+    static String mixedCase(TestCase tc, String s) {
+        StringBuilder sb = new StringBuilder();
+        for (char c : s.toCharArray()) {
+            sb.append(chance(tc, 50) ? Character.toLowerCase(c) : Character.toUpperCase(c));
+        }
+        return sb.toString();
+    }
+
+    /** The same number written another way: exponent, explicit sign, leading/trailing zeros, no leading digit. */
+    static String numberVariant(TestCase tc, String tok) {
+        double v = Double.parseDouble(tok);
+        switch (n(tc, 0, 6)) {
+            case 0:
+                return tok;
+            case 1:
+                return v >= 0 && !tok.startsWith("-") ? "+" + tok : tok;
+            case 2:
+                return tok.contains(".") ? tok + "0" : tok + ".0";
+            case 3:
+                return tok.startsWith("-") ? "-0" + tok.substring(1) : "0" + tok;
+            case 4: {
+                // shift the decimal point by one and add an exponent
+                java.math.BigDecimal bd = new java.math.BigDecimal(tok);
+                java.math.BigDecimal shifted = bd.movePointLeft(1);
+                String s = shifted.toPlainString() + "e1";
+                return Double.parseDouble(s) == v ? s : tok;
+            }
+            case 5: {
+                java.math.BigDecimal bd = new java.math.BigDecimal(tok);
+                String s = bd.movePointRight(1).toPlainString() + "E-1";
+                return Double.parseDouble(s) == v ? s : tok;
+            }
+            default:
+                if (tok.startsWith("0.")) {
+                    return tok.substring(1);
+                }
+                if (tok.startsWith("-0.")) {
+                    return "-" + tok.substring(2);
+                }
+                return tok;
+        }
+    }
+
+    static void unionsAndNormalForm(TestCase tc, GeoGen g, double scale) {
+        // unary union of overlapping polygons equals the iterated binary union
+        int k = n(tc, 2, 4);
+        List<Geometry> polys = new ArrayList<>();
+        for (int i = 0; i < k; i++) {
+            polys.add(g.polygon());
+        }
+        Geometry iter = polys.get(0);
+        for (int i = 1; i < k; i++) {
+            iter = OverlayNGRobust.overlay(iter, polys.get(i), OverlayNG.UNION);
+        }
+        Geometry unary = UnaryUnionOp.union(polys);
+        Geometry cascaded = CascadedPolygonUnion.union(polys);
+        Geometry ngUnion = OverlayNGRobust.union(polys);
+        double areaTol = 1e-6 * scale * scale;
+        final Geometry it = iter;
+        check(Exact.close(unary.getArea(), iter.getArea(), areaTol), () -> "UnaryUnionOp of " + polys + " has area " + unary.getArea() + ", the iterated union " + it.getArea());
+        check(Exact.close(cascaded.getArea(), iter.getArea(), areaTol), () -> "CascadedPolygonUnion of " + polys + " has area " + cascaded.getArea() + ", the iterated union " + it.getArea());
+        check(Exact.close(ngUnion.getArea(), iter.getArea(), areaTol), () -> "OverlayNGRobust.union of " + polys + " has area " + ngUnion.getArea() + ", the iterated union " + it.getArea());
+        check(unary.isValid() && cascaded.isValid() && ngUnion.isValid(), () -> "an n-ary union of " + polys + " is invalid: " + wkt(unary) + " / " + wkt(cascaded) + " / " + wkt(ngUnion));
+        GeometryCollection gc = GF.createGeometryCollection(polys.toArray(new Geometry[0]));
+        Geometry gcUnion = gc.union();
+        check(Exact.close(gcUnion.getArea(), iter.getArea(), areaTol), () -> "GeometryCollection.union() of " + polys + " has area " + gcUnion.getArea() + ", the iterated union " + it.getArea());
+        // every input vertex is covered by the union
+        for (Geometry p : polys) {
+            for (Coordinate c : p.getCoordinates()) {
+                double dd = unary.distance(GF.createPoint(c));
+                check(dd <= 1e-7 * scale, () -> "UnaryUnionOp of " + polys + " misses the vertex " + c + " by " + dd + ": " + wkt(unary));
+            }
+        }
+        // normal form: shell clockwise, holes counter-clockwise, first point the minimum
+        Geometry a = g.any();
+        Geometry norm = a.norm();
+        for (int i = 0; i < norm.getNumGeometries(); i++) {
+            if (norm.getGeometryN(i) instanceof Polygon poly && !poly.isEmpty()) {
+                check(!Orientation.isCCW(poly.getExteriorRing().getCoordinates()), () -> "norm() leaves the shell counter-clockwise: " + wkt(poly));
+                for (int h = 0; h < poly.getNumInteriorRing(); h++) {
+                    final int hh = h;
+                    check(Orientation.isCCW(poly.getInteriorRingN(h).getCoordinates()), () -> "norm() leaves hole " + hh + " clockwise: " + wkt(poly));
+                }
+            }
+        }
+        check(norm.equalsExact(norm.norm()), () -> "norm() is not idempotent for " + wkt(a) + ": " + wkt(norm) + " then " + wkt(norm.norm()));
+        check(a.reverse().norm().equalsExact(norm), () -> "norm() of the reverse of " + wkt(a) + " is " + wkt(a.reverse().norm()) + ", not " + wkt(norm));
+        // isRectangle: exactly the axis-parallel 4-vertex polygons with positive area
+        if (a instanceof Polygon poly && !poly.isEmpty()) {
+            Coordinate[] cs = poly.getExteriorRing().getCoordinates();
+            boolean rectE = poly.getNumInteriorRing() == 0 && cs.length == 5 && poly.getArea() > 0 && cs.length == 5
+                && ((cs[0].x == cs[1].x && cs[1].y == cs[2].y && cs[2].x == cs[3].x && cs[3].y == cs[0].y) || (cs[0].y == cs[1].y && cs[1].x == cs[2].x && cs[2].y == cs[3].y && cs[3].x == cs[0].x));
+            check(poly.isRectangle() == rectE, () -> "isRectangle = " + poly.isRectangle() + " for " + wkt(poly) + ", exactly " + rectE);
+        }
+        Geometry envGeom = a.getEnvelope();
+        if (envGeom instanceof Polygon ep) {
+            check(ep.isRectangle(), () -> "getEnvelope() " + wkt(ep) + " of " + wkt(a) + " is not a rectangle");
+        }
+    }
+
+    static boolean closeToIdentity(AffineTransformation t) {
+        double[] m = t.getMatrixEntries();
+        double[] id = {1, 0, 0, 0, 1, 0};
+        for (int i = 0; i < 6; i++) {
+            if (!Exact.close(m[i], id[i], 1e-9)) {
+                return false;
+            }
+        }
+        return true;
+    }
+}
diff --git a/hegel/src/test/java/zoo/Zoo.java b/hegel/src/test/java/zoo/Zoo.java
new file mode 100644
index 0000000..17586e2
--- /dev/null
+++ b/hegel/src/test/java/zoo/Zoo.java
@@ -0,0 +1,120 @@
+package zoo;
+
+import dev.hegel.Database;
+import dev.hegel.Generators;
+import dev.hegel.Settings;
+import dev.hegel.TestCase;
+import java.util.LinkedHashSet;
+import java.util.Set;
+import java.util.function.Supplier;
+
+/**
+ * Hegel zoo harness. {@link #settings} reads {@code HEGEL_TEST_CASES} and {@code HEGEL_DATABASE}
+ * (hegel-java itself reads no environment variable); {@link #fail} throws, or under
+ * {@code ZOO_COLLECT=1} prints a {@code COLLECT <message>} line once per distinct message and
+ * lets the test case go on, so one run shows every kind of mismatch at once.
+ */
+final class Zoo {
+    private Zoo() {}
+
+    static final boolean COLLECT = notEmpty(System.getenv("ZOO_COLLECT"));
+    /**
+     * Off by default: the properties draw the recorded bugs' shapes (bugs.toml) and fail on them, and are the expected
+     * failures beside the pins. {@code HEGEL_NO_KNOWN=1} switches the shapes off, for a run that looks past the known bugs.
+     */
+    static final boolean NO_KNOWN = notEmpty(System.getenv("HEGEL_NO_KNOWN"));
+    private static final Set<String> SEEN = new LinkedHashSet<>();
+
+    static Settings settings(String name) {
+        Settings s = new Settings().name(name).testCases(testCases());
+        String db = System.getenv("HEGEL_DATABASE");
+        if (notEmpty(db)) {
+            s = s.database(Database.path(db));
+        }
+        return s;
+    }
+
+    static long testCases() {
+        String n = System.getenv("HEGEL_TEST_CASES");
+        return notEmpty(n) ? Long.parseLong(n.trim()) : 100;
+    }
+
+    static void fail(String msg) {
+        if (COLLECT) {
+            String key = msg.length() > 300 ? msg.substring(0, 300) : msg;
+            if (SEEN.add(key)) {
+                System.out.println("COLLECT " + msg.replace('\n', '\u23ce'));
+                System.out.flush();
+            }
+            return;
+        }
+        throw new AssertionError(msg);
+    }
+
+    static void check(boolean ok, Supplier<String> msg) {
+        if (!ok) {
+            fail(msg.get());
+        }
+    }
+
+    static void check(boolean ok, String msg) {
+        if (!ok) {
+            fail(msg);
+        }
+    }
+
+    /** An int in [lo, hi]. */
+    static int n(TestCase tc, int lo, int hi) {
+        return tc.draw(Generators.integers().min(lo).max(hi));
+    }
+
+    /** True with probability pct/100; shrinks to false (the draw shrinks to 0). */
+    static boolean chance(TestCase tc, int pct) {
+        return n(tc, 0, 99) >= 100 - pct;
+    }
+
+    @SafeVarargs
+    static <T> T pick(TestCase tc, T... xs) {
+        return tc.draw(Generators.sampledFrom(xs));
+    }
+
+    /** A string of lo..hi characters drawn from the alphabet. */
+    static String word(TestCase tc, String alphabet, int lo, int hi) {
+        int len = n(tc, lo, hi);
+        StringBuilder sb = new StringBuilder();
+        for (int i = 0; i < len; i++) {
+            sb.append(alphabet.charAt(n(tc, 0, alphabet.length() - 1)));
+        }
+        return sb.toString();
+    }
+
+    /** A readable rendering of a value: strings quoted with unprintables escaped, null as "null". */
+    static String show(Object o) {
+        if (o == null) {
+            return "null";
+        }
+        if (o instanceof String s) {
+            StringBuilder sb = new StringBuilder("\"");
+            for (int i = 0; i < s.length(); i++) {
+                char c = s.charAt(i);
+                if (c == '"' || c == '\\') {
+                    sb.append('\\').append(c);
+                } else if (c < 0x20 || c == 0x7f || (c >= 0xd800 && c <= 0xdfff) || c == '\u2028' || c == '\u2029') {
+                    sb.append(String.format("\\u%04x", (int) c));
+                } else {
+                    sb.append(c);
+                }
+            }
+            return sb.append('"').toString();
+        }
+        String s = o.toString();
+        if (o instanceof Number || o instanceof Boolean) {
+            return s + " (" + o.getClass().getSimpleName() + ")";
+        }
+        return s.length() > 400 ? s.substring(0, 400) + "…" : s;
+    }
+
+    private static boolean notEmpty(String s) {
+        return s != null && !s.isEmpty();
+    }
+}
diff --git a/hegel/src/test/java/zoo/ZooListener.java b/hegel/src/test/java/zoo/ZooListener.java
new file mode 100644
index 0000000..7e317bb
--- /dev/null
+++ b/hegel/src/test/java/zoo/ZooListener.java
@@ -0,0 +1,40 @@
+package zoo;
+
+import org.junit.platform.engine.TestExecutionResult;
+import org.junit.platform.engine.support.descriptor.MethodSource;
+import org.junit.platform.launcher.TestExecutionListener;
+import org.junit.platform.launcher.TestIdentifier;
+
+/**
+ * Hegel zoo: prints one {@code ZOO ok|FAILED|ignored <method>} line per test method on stdout;
+ * the zoo's judge reads these lines (registered in META-INF/services).
+ */
+public final class ZooListener implements TestExecutionListener {
+    private static String name(TestIdentifier id) {
+        return id.getSource()
+                .filter(s -> s instanceof MethodSource)
+                .map(s -> ((MethodSource) s).getMethodName())
+                .orElse(null);
+    }
+
+    @Override
+    public void executionFinished(TestIdentifier id, TestExecutionResult result) {
+        String n = name(id);
+        if (n == null || !id.isTest()) {
+            return;
+        }
+        String v = result.getStatus() == TestExecutionResult.Status.SUCCESSFUL ? "ok"
+                : result.getStatus() == TestExecutionResult.Status.ABORTED ? "ignored" : "FAILED";
+        System.out.println("ZOO " + v + " " + n);
+        System.out.flush();
+    }
+
+    @Override
+    public void executionSkipped(TestIdentifier id, String reason) {
+        String n = name(id);
+        if (n != null) {
+            System.out.println("ZOO ignored " + n);
+            System.out.flush();
+        }
+    }
+}
