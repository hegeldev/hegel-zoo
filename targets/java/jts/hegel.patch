+    static void triangulationInvariants(TestCase tc, GeoGen g, double scale) {
+        Coordinate[] cs = g.coords(1, 14);
+        Geometry sites = GF.createMultiPointFromCoords(cs);
+        // distinct sites
+        List<P> distinct = new ArrayList<>();
+        for (Coordinate c : cs) {
+            P p = P.of(c);
+            if (!distinct.contains(p)) {
+                distinct.add(p);
+            }
+        }
+        DelaunayTriangulationBuilder db = new DelaunayTriangulationBuilder();
+        db.setSites(sites);
+        Geometry tris;
+        try {
+            tris = db.getTriangles(GF);
+        } catch (RuntimeException e) {
+            check(false, "DelaunayTriangulationBuilder throws " + e + " for " + wkt(sites));
+            return;
+        }
+        List<P> hull = Exact.hull(distinct.toArray(new P[0]));
+        if (hull.size() < 3) {
+            check(tris.isEmpty(), () -> "Delaunay of collinear sites " + wkt(sites) + " gives " + wkt(tris));
+            return;
+        }
+        // every triangle: vertices are sites, counter-clockwise or clockwise but non-degenerate, empty circumcircle
+        Q hullArea2 = Q.ZERO;
+        Coordinate[] hc = new Coordinate[hull.size() + 1];
+        for (int i = 0; i < hull.size(); i++) {
+            hc[i] = hull.get(i).toCoordinate();
+        }
+        hc[hull.size()] = hc[0].copy();
+        hullArea2 = Exact.signedArea2(Exact.points(hc)).abs();
+        Q triArea2 = Q.ZERO;
+        int hullPts0 = 0;
+        for (P p : distinct) {
+            if (Exact.locateInRing(p, Exact.points(hc)) == Exact.BOUNDARY) {
+                hullPts0++;
+            }
+        }
+        final int hullPts = hullPts0;
+        for (int i = 0; i < tris.getNumGeometries(); i++) {
+            Polygon t = (Polygon) tris.getGeometryN(i);
+            Coordinate[] tcs = t.getCoordinates();
+            check(tcs.length == 4, () -> "Delaunay triangle with " + tcs.length + " coordinates: " + wkt(t) + " for " + wkt(sites));
+            P a = P.of(tcs[0]);
+            P b = P.of(tcs[1]);
+            P c = P.of(tcs[2]);
+            check(distinct.contains(a) && distinct.contains(b) && distinct.contains(c), () -> "Delaunay triangle " + wkt(t) + " has a vertex that is not a site of " + wkt(sites));
+            int o = Exact.orient(a, b, c);
+            check(o != 0, () -> "degenerate Delaunay triangle " + wkt(t) + " for " + wkt(sites));
+            if (o == 0) {
+                continue;
+            }
+            triArea2 = triArea2.add(Exact.signedArea2(new P[] {a, b, c, a}).abs());
+            P ca = o > 0 ? a : c;
+            P cc = o > 0 ? c : a;
+            for (P d : distinct) {
+                if (d.equals(a) || d.equals(b) || d.equals(c)) {
+                    continue;
+                }
+                int in = Exact.inCircle(ca, b, cc, d);
+                check(in <= 0, () -> "Delaunay triangle " + wkt(t) + " has the site " + d + " strictly inside its circumcircle for " + wkt(sites));
+            }
+        }
+        final Q ta = triArea2;
+        final Q ha = hullArea2;
+        check(triArea2.equals(hullArea2), () -> "Delaunay triangles cover an area of " + ta.div(Q.of(2)) + ", the hull has " + ha.div(Q.of(2)) + " for " + wkt(sites) + ": " + wkt(tris));
+        int expectedTris = 2 * distinct.size() - 2 - hullPts;
+        check(tris.getNumGeometries() == expectedTris, () -> "Delaunay of " + distinct.size() + " sites with " + hullPts + " on the hull gives " + tris.getNumGeometries() + " triangles, Euler says " + expectedTris + ": " + wkt(sites));
+        // Voronoi: one cell per site, each site inside its cell
+        VoronoiDiagramBuilder vb = new VoronoiDiagramBuilder();
+        vb.setSites(sites);
+        Geometry cells;
+        try {
+            cells = vb.getDiagram(GF);
+        } catch (RuntimeException e) {
+            check(false, "VoronoiDiagramBuilder throws " + e + " for " + wkt(sites));
+            return;
+        }
+        check(cells.getNumGeometries() == distinct.size(), () -> "Voronoi of " + distinct.size() + " distinct sites has " + cells.getNumGeometries() + " cells for " + wkt(sites));
+        for (int i = 0; i < cells.getNumGeometries(); i++) {
+            Polygon cell = (Polygon) cells.getGeometryN(i);
+            check(cell.isValid(), () -> "invalid Voronoi cell " + wkt(cell) + " for " + wkt(sites));
+            Coordinate site = (Coordinate) cell.getUserData();
+            if (site != null) {
+                int l = Exact.locateInPolygon(P.of(site), cell);
+                check(l == Exact.INTERIOR, () -> "Voronoi site " + site + " lies in the " + loc(l) + " of its cell " + wkt(cell) + " for " + wkt(sites));
+                // every other site is farther from any cell vertex than the cell's own site... check the vertices are equidistant-or-farther
+                for (Coordinate v : cell.getCoordinates()) {
+                    double own = v.distance(site);
+                    for (Coordinate other : cs) {
+                        double od = v.distance(other);
+                        check(od >= own - 1e-6 * scale, () -> "Voronoi cell vertex " + v + " of site " + site + " is closer to the site " + other + " (" + od + " < " + own + ") for " + wkt(sites));
+                    }
+                }
+            }
+        }
+        // maximum inscribed circle of a polygon: centre inside, radius = distance to the boundary
+        Polygon poly = g.polygon();
+        double tol = Math.max(1e-6, 1e-3 * scale);
+        MaximumInscribedCircle mic = new MaximumInscribedCircle(poly, tol);
+        Point centre = mic.getCenter();
+        int cl = exactLocate(centre.getCoordinate(), poly);
+        check(cl == Exact.INTERIOR, () -> "MaximumInscribedCircle centre " + centre + " lies in the " + loc(cl) + " of " + wkt(poly));
+        double radius = mic.getRadiusLine().getLength();
+        double toBoundary = poly.getBoundary().distance(centre);
+        check(Exact.close(radius, toBoundary, 1e-6 * scale), () -> "MaximumInscribedCircle radius " + radius + " but the centre " + centre + " is " + toBoundary + " from the boundary of " + wkt(poly));
+        check(mic.getRadiusPoint().distance(centre) <= radius + 1e-9 * scale, () -> "MaximumInscribedCircle radius point " + mic.getRadiusPoint() + " is farther than " + radius + " from " + centre);
+        // minimum rectangles of the sites: rectangles that cover every site
+        if (distinct.size() >= 2) {
+            for (Geometry rect : new Geometry[] {MinimumDiameter.getMinimumRectangle(sites), MinimumAreaRectangle.getMinimumRectangle(sites)}) {
+                String which = rect == null ? "" : "minimum rectangle";
+                check(rect.isValid(), () -> which + " " + wkt(rect) + " of " + wkt(sites) + " is invalid");
+                for (Coordinate c : cs) {
+                    double dd = rect.distance(GF.createPoint(c));
+                    check(dd <= 1e-7 * scale, () -> which + " " + wkt(rect) + " of " + wkt(sites) + " misses the site " + c + " by " + dd);
+                }
+                if (rect instanceof Polygon rp) {
+                    check(rp.getNumPoints() == 5, () -> which + " " + wkt(rect) + " of " + wkt(sites) + " is not a quadrilateral");
+                }
+            }
+            Geometry mar = MinimumAreaRectangle.getMinimumRectangle(sites);
+            check(mar.getArea() <= sites.getEnvelope().getArea() + 1e-7 * scale * scale, () -> "MinimumAreaRectangle " + wkt(mar) + " has area " + mar.getArea() + " but the envelope has " + sites.getEnvelope().getArea() + " for " + wkt(sites));
+            // concave hull: covers the sites, within the convex hull; ratio 1 is the convex hull
+            Geometry ch = ConcaveHull.concaveHullByLengthRatio(sites, pick(tc, 0.0, 0.3, 0.7, 1.0));
+            check(ch.isValid(), () -> "ConcaveHull " + wkt(ch) + " of " + wkt(sites) + " is invalid: " + new IsValidOp(ch).getValidationError());
+            for (Coordinate c : cs) {
+                double dd = ch.distance(GF.createPoint(c));
+                check(dd <= 1e-9 * scale, () -> "ConcaveHull " + wkt(ch) + " of " + wkt(sites) + " misses the site " + c + " by " + dd);
+            }
+            Geometry convex = sites.convexHull();
+            check(ch.getArea() <= convex.getArea() + 1e-9 * scale * scale, () -> "ConcaveHull " + wkt(ch) + " has area " + ch.getArea() + " but the convex hull has " + convex.getArea() + " for " + wkt(sites));
+            Geometry ch1 = ConcaveHull.concaveHullByLengthRatio(sites, 1.0);
+            check(Exact.close(ch1.getArea(), convex.getArea(), 1e-9 * scale * scale), () -> "ConcaveHull with ratio 1 is " + wkt(ch1) + ", the convex hull " + wkt(convex));
+            // largest empty circle among the sites: no site inside, centre inside the hull
+            if (hull.size() >= 3) {
+                LargestEmptyCircle lec = new LargestEmptyCircle(sites, convex, tol);
+                Point lc = lec.getCenter();
+                double lr = lec.getRadiusLine().getLength();
+                for (Coordinate c : cs) {
+                    check(c.distance(lc.getCoordinate()) >= lr - 1e-6 * scale, () -> "LargestEmptyCircle centre " + lc + " radius " + lr + " contains the site " + c + " for " + wkt(sites));
+                }
+                check(convex.distance(lc) <= 1e-6 * scale, () -> "LargestEmptyCircle centre " + lc + " is outside the boundary " + wkt(convex));
+            }
+        }
+    }
