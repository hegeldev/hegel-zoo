+    /**
+     * IsSimpleOp agrees with the exact simplicity of a ring (repeated points ignored). A ring whose points all coincide
+     * is degenerate either way (the oracle sees no ring, IsSimpleOp trims it to nothing) and is not judged.
+     */
+    static void checkRingSimple(LinearRing ring, P[] rp) {
+        boolean simpleE = Exact.ringSimple(rp);
+        boolean rsimple = ring.isSimple();
+        if (Exact.dedupe(rp).length > 1) {
+            check(rsimple == simpleE, () -> "isSimple(" + wkt(ring) + ") = " + rsimple + " but the ring is exactly " + (simpleE ? "simple" : "not simple") + (rsimple ? "" : " (non-simple location " + IsSimpleOp.getNonSimpleLocation(ring) + ")"));
+        }
+    }
+
+    /** IsSimpleOp agrees with the exact simplicity of a line (repeated points ignored). */
+    static void checkLineSimple(LineString line, P[] lp) {
+        boolean lsimpleE = Exact.lineSimple(lp);
+        boolean lsimple = line.isSimple();
+        check(lsimple == lsimpleE, () -> "isSimple(" + wkt(line) + ") = " + lsimple + ", exactly " + lsimpleE + " (non-simple location " + IsSimpleOp.getNonSimpleLocation(line) + ")");
+    }
+
+    /**
+     * The minimum bounding circle of a non-empty point set (cs are the points of geom) has a centre, covers every
+     * point, touches two of them (radius 0 when they all coincide) and has a radius between half the diameter and
+     * diameter/sqrt(3).
+     */
+    static void checkBoundingCircle(Geometry geom, Coordinate[] cs, double tol) {
+        MinimumBoundingCircle mbc = new MinimumBoundingCircle(geom);
+        Coordinate centre = mbc.getCentre();
+        double r = mbc.getRadius();
+        // jts/3: two or more coincident points give a null centre (documented to be null only for an empty input)
+        check(centre != null, () -> "MinimumBoundingCircle of the non-empty " + wkt(geom) + " has a null centre (radius " + r + ", extremal points " + Arrays.toString(mbc.getExtremalPoints()) + ", circle " + wkt(mbc.getCircle()) + ")");
+        if (centre == null) {
+            return; // collect mode
+        }
+        int onCircle = 0;
+        for (Coordinate c : cs) {
+            double dd = c.distance(centre);
+            check(dd <= r + tol, () -> "MinimumBoundingCircle of " + wkt(geom) + ": centre " + centre + " radius " + r + " but " + c + " is " + dd + " away");
+            if (Math.abs(dd - r) <= 1e-7 * Math.max(1, r)) {
+                onCircle++;
+            }
+        }
+        Set<String> distinct = new HashSet<>();
+        for (Coordinate c : cs) {
+            distinct.add(c.x + "," + c.y);
+        }
+        final int on = onCircle;
+        check(distinct.size() < 2 ? r == 0 : on >= 2, () -> "MinimumBoundingCircle of " + wkt(geom) + ": centre " + centre + " radius " + r + " touches " + on + " points");
+        // the radius is at least half the maximum pairwise distance and at most that distance / sqrt(3)
+        double maxD = 0;
+        for (Coordinate c1 : cs) {
+            for (Coordinate c2 : cs) {
+                maxD = Math.max(maxD, c1.distance(c2));
+            }
+        }
+        final double md = maxD;
+        check(r >= maxD / 2 - tol, () -> "MinimumBoundingCircle radius " + r + " is smaller than half the diameter " + md / 2 + " of " + wkt(geom));
+        check(r <= maxD / Math.sqrt(3) + tol, () -> "MinimumBoundingCircle radius " + r + " exceeds diameter/sqrt(3) = " + md / Math.sqrt(3) + " for " + wkt(geom));
+    }
+
+    static double distToBoundary(P p, Polygon poly) {
+        Q best = null;
+        List<P[]> rings = new ArrayList<>();
+        rings.add(Exact.ring(poly.getExteriorRing()));
+        rings.addAll(Exact.holes(poly));
+        for (P[] r : rings) {
+            for (int i = 0; i + 1 < r.length; i++) {
+                Q d = Exact.distSq(p, r[i], r[i + 1]);
+                best = best == null ? d : best.min(d);
+            }
+        }
+        return best == null ? Double.NaN : best.sqrt();
+    }
