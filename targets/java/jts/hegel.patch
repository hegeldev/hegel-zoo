+    static void affineInvariants(TestCase tc, GeoGen g, double scale) {
+        Geometry a = g.any();
+        // an integer matrix: areas scale by |det| exactly (small integers), lengths by the scale for similarities
+        int m00 = n(tc, -3, 3);
+        int m01 = n(tc, -3, 3);
+        int m10 = n(tc, -3, 3);
+        int m11 = n(tc, -3, 3);
+        double dx = g.ordinate();
+        double dy = g.ordinate();
+        AffineTransformation t = new AffineTransformation(m00, m01, dx, m10, m11, dy);
+        double det = m00 * m11 - m01 * m10;
+        check(t.getDeterminant() == det, () -> "getDeterminant = " + t.getDeterminant() + " for " + t + ", exactly " + det);
+        Geometry ta = t.transform(a);
+        check(ta.getNumPoints() == a.getNumPoints() && sameTypes(ta, a), () -> "transform changes the structure of " + wkt(a) + ": " + wkt(ta));
+        if (g.scheme == 0 && a.getDimension() == 2 && Math.abs(det) > 0) {
+            double ea = Math.abs(det) * a.getArea();
+            check(Exact.close(ta.getArea(), ea, 1e-9 * scale * scale * 10), () -> "the area of " + t + " applied to " + wkt(a) + " is " + ta.getArea() + ", |det| · area = " + ea);
+        }
+        if (det != 0) {
+            try {
+                AffineTransformation inv = t.getInverse();
+                Geometry back = inv.transform(ta);
+                Coordinate[] c1 = a.getCoordinates();
+                Coordinate[] c2 = back.getCoordinates();
+                for (int i = 0; i < c1.length; i++) {
+                    final int k = i;
+                    check(c1[i].distance(c2[i]) <= 1e-7 * scale * Math.max(1, Math.abs(m00) + Math.abs(m01) + Math.abs(m10) + Math.abs(m11)), () -> "inverse transform returns " + c2[k] + " for " + c1[k] + " under " + t);
+                }
+                AffineTransformation id = new AffineTransformation(t).compose(inv);
+                check(id.isIdentity() || closeToIdentity(id), () -> "t.compose(t.getInverse()) = " + id + " for " + t);
+            } catch (org.locationtech.jts.geom.util.NoninvertibleTransformationException e) {
+                check(false, "getInverse throws for det = " + det + ": " + t);
+            }
+        }
+        // a translation keeps everything exactly
+        Geometry moved = AffineTransformation.translationInstance(dx, dy).transform(a);
+        Geometry expected = GeoGen.translate(a, dx, dy);
+        check(moved.equalsExact(expected), () -> "translationInstance(" + dx + ", " + dy + ") gives " + wkt(moved) + ", coordinate arithmetic " + wkt(expected));
+        // rotation by a right angle keeps lengths and areas exactly on the integer grid
+        AffineTransformation rot = AffineTransformation.rotationInstance(pick(tc, 0.0, 1.0, -1.0), pick(tc, 0.0, 1.0, -1.0) == 0 ? 0.0 : 0.0);
+        Geometry r = AffineTransformation.rotationInstance(1.0, 0.0).transform(a); // sin 1 cos 0: 90 degrees
+        check(Exact.close(r.getArea(), a.getArea(), 1e-12) && Exact.close(r.getLength(), a.getLength(), 1e-12), () -> "a 90 degree rotation changes area/length of " + wkt(a) + ": " + r.getArea() + "/" + r.getLength() + " vs " + a.getArea() + "/" + a.getLength());
+        // reflection in the x axis: y negated exactly
+        Geometry refl = AffineTransformation.reflectionInstance(1, 0).transform(a);
+        Coordinate[] rc = refl.getCoordinates();
+        Coordinate[] ac = a.getCoordinates();
+        for (int i = 0; i < ac.length; i++) {
+            final int k = i;
+            check(rc[i].x == ac[i].x && rc[i].y == -ac[i].y, () -> "reflectionInstance(1, 0) maps " + ac[k] + " to " + rc[k]);
+        }
+    }
