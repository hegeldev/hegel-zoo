+    /** Exact.locateInRing constants equal JTS Location constants (INTERIOR 0, BOUNDARY 1, EXTERIOR 2). */
+    static int exactLocate(Coordinate p, Geometry g) {
+        P q = P.of(p);
+        if (g instanceof Polygon poly) {
+            return Exact.locateInPolygon(q, poly);
+        }
+        if (g instanceof MultiPolygon mp) {
+            for (int i = 0; i < mp.getNumGeometries(); i++) {
+                int l = Exact.locateInPolygon(q, (Polygon) mp.getGeometryN(i));
+                if (l != Exact.EXTERIOR) {
+                    return l;
+                }
+            }
+            return Exact.EXTERIOR;
+        }
+        throw new IllegalArgumentException(g.getGeometryType());
+    }
