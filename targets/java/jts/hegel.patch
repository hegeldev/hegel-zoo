+    /** Area, length, centroid, interior point, envelope, convex hull, validity and simplicity agree with exact arithmetic. */
+    @Test
+    void measuresAreExact() {
+        Hegel.test(tc -> {
+            GeoGen g = new GeoGen(tc);
+            int kind = n(tc, 0, 99);
+            if (kind < 55) {
+                Polygon poly = g.polygon();
+                double areaE = Exact.area(poly).toDouble();
+                check(Exact.close(poly.getArea(), areaE, 1e-9), () -> "getArea of " + wkt(poly) + " = " + poly.getArea() + ", exactly " + areaE);
+                double lenE = 0;
+                lenE += Exact.length(Exact.ring(poly.getExteriorRing()));
+                for (int i = 0; i < poly.getNumInteriorRing(); i++) {
+                    lenE += Exact.length(Exact.ring(poly.getInteriorRingN(i)));
+                }
+                final double le = lenE;
+                check(Exact.close(poly.getLength(), lenE, 1e-9), () -> "getLength of " + wkt(poly) + " = " + poly.getLength() + ", exactly " + le);
+                P cE = Exact.centroid(poly);
+                Point cen = poly.getCentroid();
+                if (cE != null) {
+                    double cx = cE.x().toDouble();
+                    double cy = cE.y().toDouble();
+                    double tol = 1e-9 * Math.max(1, g.range);
+                    check(Exact.close(cen.getX(), cx, tol) && Exact.close(cen.getY(), cy, tol), () -> "getCentroid of " + wkt(poly) + " = " + cen + ", exactly (" + cx + ", " + cy + ")");
+                }
+                Point ip = poly.getInteriorPoint();
+                int il = exactLocate(ip.getCoordinate(), poly);
+                check(il == Exact.INTERIOR, () -> "getInteriorPoint of " + wkt(poly) + " = " + ip + " lies in the " + loc(il));
+                check(poly.isValid(), () -> "a polygon built valid by construction is invalid: " + wkt(poly) + ": " + new IsValidOp(poly).getValidationError());
+                check(poly.isSimple(), () -> "a valid polygon is not simple: " + wkt(poly));
+                // envelope
+                Envelope env = poly.getEnvelopeInternal();
+                double minX = Double.POSITIVE_INFINITY;
+                double maxX = Double.NEGATIVE_INFINITY;
+                double minY = Double.POSITIVE_INFINITY;
+                double maxY = Double.NEGATIVE_INFINITY;
+                for (Coordinate c : poly.getCoordinates()) {
+                    minX = Math.min(minX, c.x);
+                    maxX = Math.max(maxX, c.x);
+                    minY = Math.min(minY, c.y);
+                    maxY = Math.max(maxY, c.y);
