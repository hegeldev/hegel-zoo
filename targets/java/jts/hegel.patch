+            // self relations
+            IntersectionMatrix self = RelateOp.relate(a, a);
+            check(self.matches("T*F**FFF*"), () -> "relate(a, a) = " + self + " for " + wkt(a));
+            check(a.equalsTopo(a.reverse()), () -> "a is not topologically equal to its reverse: " + wkt(a));
