+    // --------------------------------------------------------------------------------------------------- indexes
+
+    /** STRtree, HPRtree, Quadtree, KdTree and the interval R-tree return exactly what brute force does. */
+    @Test
+    void indexesMatchBruteForce() {
+        Hegel.test(tc -> {
+            GeoGen g = new GeoGen(tc);
+            int k = n(tc, 0, 30);
+            List<Envelope> envs = new ArrayList<>();
+            List<Object> items = new ArrayList<>();
+            STRtree str = new STRtree(pick(tc, 2, 4, 10));
+            HPRtree hpr = new HPRtree(pick(tc, 2, 4, 16));
+            Quadtree quad = new Quadtree();
+            for (int i = 0; i < k; i++) {
+                Coordinate c1 = g.coord();
+                Coordinate c2 = chance(tc, 20) ? c1.copy() : g.coord();
+                if (chance(tc, 10)) {
+                    c2 = new Coordinate(c2.x, c1.y); // zero height
+                }
+                Envelope e = new Envelope(c1, c2);
+                Object item = "item" + i;
+                envs.add(e);
+                items.add(item);
+                str.insert(e, item);
+                hpr.insert(e, item);
+                quad.insert(e, item);
+            }
+            int queries = n(tc, 1, 4);
+            for (int q = 0; q < queries; q++) {
+                Coordinate c1 = g.coord();
+                Coordinate c2 = chance(tc, 25) ? c1.copy() : g.coord();
+                Envelope qe = new Envelope(c1, c2);
+                Set<Object> expected = new HashSet<>();
+                for (int i = 0; i < k; i++) {
+                    if (envs.get(i).intersects(qe)) {
+                        expected.add(items.get(i));
+                    }
+                }
+                Set<Object> gotStr = new HashSet<>(str.query(qe));
+                check(gotStr.equals(expected), () -> "STRtree.query(" + qe + ") gives " + sorted(gotStr) + ", brute force " + sorted(expected) + " over " + envs);
+                Set<Object> gotHpr = new HashSet<>(hpr.query(qe));
+                check(gotHpr.equals(expected), () -> "HPRtree.query(" + qe + ") gives " + sorted(gotHpr) + ", brute force " + sorted(expected) + " over " + envs);
+                // Quadtree may return a superset (its documentation says so); the visitor form and the list must agree
+                Set<Object> gotQuad = new HashSet<>(quad.query(qe));
+                check(gotQuad.containsAll(expected), () -> "Quadtree.query(" + qe + ") gives " + sorted(gotQuad) + ", misses some of " + sorted(expected) + " over " + envs);
+                Set<Object> visited = new HashSet<>();
+                quad.query(qe, (ItemVisitor) visited::add);
+                check(visited.equals(gotQuad), () -> "Quadtree.query visitor gives " + sorted(visited) + ", the list " + sorted(gotQuad));
+                Set<Object> visitedStr = new HashSet<>();
+                str.query(qe, (ItemVisitor) visitedStr::add);
+                check(visitedStr.equals(gotStr), () -> "STRtree.query visitor gives " + sorted(visitedStr) + ", the list " + sorted(gotStr));
+            }
+            // nearest neighbour between the items of the tree and a query envelope
+            if (k > 0) {
+                Envelope qe = new Envelope(g.coord());
+                // anti-reflexive, as the documentation of nearestNeighbour(ItemDistance) requires for distinct pairs
+                ItemDistance dist = (i1, i2) -> i1.getItem() == i2.getItem() ? Double.MAX_VALUE : ((Envelope) i1.getBounds()).distance((Envelope) i2.getBounds());
+                Object nn = str.nearestNeighbour(qe, "query", dist);
+                double best = Double.POSITIVE_INFINITY;
+                for (Envelope e : envs) {
+                    best = Math.min(best, e.distance(qe));
+                }
+                double got = envs.get(items.indexOf(nn)).distance(qe);
+                final double b = best;
+                check(got == best, () -> "STRtree.nearestNeighbour(" + qe + ") = " + nn + " at " + got + ", the nearest is at " + b + " over " + envs);
+                Object[] pairNN = str.nearestNeighbour(dist);
+                if (k >= 2) {
+                    double bestPair = Double.POSITIVE_INFINITY;
+                    for (int i = 0; i < k; i++) {
+                        for (int j = i + 1; j < k; j++) {
+                            bestPair = Math.min(bestPair, envs.get(i).distance(envs.get(j)));
+                        }
+                    }
+                    double gotPair = envs.get(items.indexOf(pairNN[0])).distance(envs.get(items.indexOf(pairNN[1])));
+                    final double bp = bestPair;
+                    check(gotPair == bestPair, () -> "STRtree.nearestNeighbour pair " + pairNN[0] + "/" + pairNN[1] + " at " + gotPair + ", the closest pair is at " + bp + " over " + envs);
+                    check(pairNN[0] != pairNN[1], () -> "STRtree.nearestNeighbour pairs an item with itself: " + pairNN[0]);
+                }
+                // removal
+                int r = n(tc, 0, k - 1);
+                boolean removed = str.remove(envs.get(r), items.get(r));
+                check(removed, () -> "STRtree.remove of " + items.get(r) + " " + envs.get(r) + " returns false");
+                Set<Object> after = new HashSet<>(str.query(envs.get(r)));
+                check(!after.contains(items.get(r)), () -> "STRtree still returns " + items.get(r) + " after removing it");
+                check(str.size() == k - 1, () -> "STRtree.size() = " + str.size() + " after removing one of " + k);
+            }
+            // KdTree of distinct points (tolerance 0): query and counts
+            KdTree kd = new KdTree();
+            List<Coordinate> pts = new ArrayList<>();
+            int np = n(tc, 0, 20);
+            for (int i = 0; i < np; i++) {
+                Coordinate c = chance(tc, 20) && !pts.isEmpty() ? pts.get(n(tc, 0, pts.size() - 1)).copy() : g.coord();
+                pts.add(c);
+                kd.insert(c);
+            }
+            Envelope qe = new Envelope(g.coord(), g.coord());
+            Set<String> expected = new HashSet<>();
+            for (Coordinate c : pts) {
+                if (qe.covers(c)) {
+                    expected.add(c.x + "," + c.y);
+                }
+            }
+            Set<String> got = new HashSet<>();
+            for (KdNode node : kd.query(qe)) {
+                got.add(node.getX() + "," + node.getY());
+                final KdNode nd = node;
+                long count = pts.stream().filter(p -> p.x == nd.getX() && p.y == nd.getY()).count();
+                check(node.getCount() == count, () -> "KdTree node " + nd.getCoordinate() + " has count " + nd.getCount() + ", inserted " + count + " times");
+            }
+            check(got.equals(expected), () -> "KdTree.query(" + qe + ") gives " + got + ", brute force " + expected + " over " + pts);
+            Set<String> distinct = new HashSet<>();
+            for (Coordinate c : pts) {
+                distinct.add(c.x + "," + c.y);
+            }
+            check(kd.size() == distinct.size(), () -> "KdTree.size() = " + kd.size() + " for " + distinct.size() + " distinct points " + pts);
+            if (!pts.isEmpty()) {
+                Coordinate probe = chance(tc, 50) ? pts.get(n(tc, 0, pts.size() - 1)).copy() : g.coord();
+                KdNode found = kd.query(probe);
+                boolean present = distinct.contains(probe.x + "," + probe.y);
+                check((found != null) == present, () -> "KdTree.query(" + probe + ") = " + (found == null ? "null" : found.getCoordinate()) + " but the point is " + (present ? "present" : "absent") + " in " + pts);
+            }
+            // interval R-tree
+            SortedPackedIntervalRTree irt = new SortedPackedIntervalRTree();
+            int ni = n(tc, 1, 15);
+            double[][] ivs = new double[ni][2];
+            for (int i = 0; i < ni; i++) {
+                double x = g.ordinate();
+                double y = chance(tc, 20) ? x : g.ordinate();
+                ivs[i][0] = Math.min(x, y);
+                ivs[i][1] = Math.max(x, y);
+                irt.insert(ivs[i][0], ivs[i][1], "iv" + i);
+            }
+            double q0 = g.ordinate();
+            double q1 = chance(tc, 20) ? q0 : g.ordinate();
+            double lo = Math.min(q0, q1);
+            double hi = Math.max(q0, q1);
+            Set<Object> gotI = new HashSet<>();
+            irt.query(lo, hi, gotI::add);
+            Set<Object> expI = new HashSet<>();
+            for (int i = 0; i < ni; i++) {
+                if (ivs[i][0] <= hi && ivs[i][1] >= lo) {
+                    expI.add("iv" + i);
+                }
+            }
+            check(gotI.equals(expI), () -> "SortedPackedIntervalRTree.query(" + lo + ", " + hi + ") gives " + sorted(gotI) + ", brute force " + sorted(expI) + " over " + Arrays.deepToString(ivs));
+        }, Zoo.settings("jts.indexesMatchBruteForce"));
+    }
+
+    static List<String> sorted(Set<?> s) {
+        List<String> out = new ArrayList<>();
+        for (Object o : s) {
+            out.add(String.valueOf(o));
+        }
+        java.util.Collections.sort(out);
+        return out;
+    }
