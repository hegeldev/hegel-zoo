+    static void simplifierInvariants(TestCase tc, GeoGen g, double scale) {
+        Geometry a = chance(tc, 50) ? g.polygonal() : (chance(tc, 60) ? g.simpleLine() : g.line());
+        // a zero-length line (all points equal) is invalid in JTS, and no simplifier, densifier or reducer is
+        // expected to make a valid geometry of it: not judged (README, "What the generator avoids")
+        tc.assume(a.isValid());
+        double tol = pick(tc, 0.0, 0.5, 1.0, 2.0, 5.0) * Math.max(1, g.range / 10.0);
+        Geometry dp = DouglasPeuckerSimplifier.simplify(a, tol);
+        Geometry tp = TopologyPreservingSimplifier.simplify(a, tol);
+        Geometry vw = VWSimplifier.simplify(a, tol);
+        for (Geometry[] pair : new Geometry[][] {{dp, null}, {tp, null}, {vw, null}}) {
+            Geometry s = pair[0];
+            String name = s == dp ? "DouglasPeucker" : s == tp ? "TopologyPreserving" : "VW";
+            // validity is ensured for polygonal results (the simplifiers' contract, "lines can cross ... collapse"); DP and
+            // VW may collapse a closed line to a zero-length one, its coincident ends being all that is kept
+            boolean collapsedClosedLine = s != tp && a instanceof LineString l && l.isClosed() && s.getLength() == 0;
+            check(s.isValid() || collapsedClosedLine, () -> name + "Simplifier(" + tol + ") of " + wkt(a) + " is invalid: " + wkt(s) + " (" + new IsValidOp(s).getValidationError() + ")");
+            check(s.getDimension() == a.getDimension() || s.isEmpty(), () -> name + "Simplifier(" + tol + ") of " + wkt(a) + " changes the type to " + s.getGeometryType() + ": " + wkt(s));
+            check(s.getNumPoints() <= a.getNumPoints(), () -> name + "Simplifier(" + tol + ") of " + wkt(a) + " adds points: " + wkt(s));
+            if (tol == 0) {
+                check(s.equalsExact(a) || s.equalsTopo(a), () -> name + "Simplifier(0) changes " + wkt(a) + " to " + wkt(s));
+            }
+        }
+        // topology preserving: same number of components, vertices a subset of the input's
+        check(tp.getNumGeometries() == a.getNumGeometries() || (a.getNumGeometries() == 1 && tp.getNumGeometries() == 1), () -> "TopologyPreservingSimplifier(" + tol + ") of " + wkt(a) + " has " + tp.getNumGeometries() + " parts: " + wkt(tp));
+        Set<String> inputPts = new HashSet<>();
+        for (Coordinate c : a.getCoordinates()) {
+            inputPts.add(c.x + "," + c.y);
+        }
+        for (Coordinate c : tp.getCoordinates()) {
+            check(inputPts.contains(c.x + "," + c.y), () -> "TopologyPreservingSimplifier(" + tol + ") of " + wkt(a) + " invents the vertex " + c + ": " + wkt(tp));
+        }
+        if (a instanceof LineString line) {
+            for (Coordinate c : dp.getCoordinates()) {
+                check(inputPts.contains(c.x + "," + c.y), () -> "DouglasPeuckerSimplifier(" + tol + ") of " + wkt(a) + " invents the vertex " + c + ": " + wkt(dp));
+            }
+            for (Coordinate c : vw.getCoordinates()) {
+                check(inputPts.contains(c.x + "," + c.y), () -> "VWSimplifier(" + tol + ") of " + wkt(a) + " invents the vertex " + c + ": " + wkt(vw));
+            }
+            // endpoints kept, every input vertex within the tolerance of the DP result
+            if (!dp.isEmpty()) {
+                Coordinate[] dc = dp.getCoordinates();
+                check(dc[0].equals2D(line.getCoordinateN(0)) && dc[dc.length - 1].equals2D(line.getCoordinateN(line.getNumPoints() - 1)), () -> "DouglasPeuckerSimplifier(" + tol + ") of " + wkt(a) + " moves an endpoint: " + wkt(dp));
+                for (Coordinate c : line.getCoordinates()) {
+                    double dd = dp.distance(GF.createPoint(c));
+                    check(dd <= tol + 1e-9 * scale, () -> "DouglasPeuckerSimplifier(" + tol + ") of " + wkt(a) + " leaves the vertex " + c + " at " + dd + ": " + wkt(dp));
+                }
+            }
+        }
+        // densifier: no segment longer than the tolerance, the same shape and length/area
+        double dens = pick(tc, 0.5, 1.0, 2.5) * Math.max(1, g.range / 10.0);
+        Geometry dense = Densifier.densify(a, dens);
+        check(dense.isValid(), () -> "Densifier(" + dens + ") of " + wkt(a) + " is invalid: " + wkt(dense));
+        check(Exact.close(dense.getLength(), a.getLength(), 1e-9 * scale) && Exact.close(dense.getArea(), a.getArea(), 1e-9 * scale * scale), () -> "Densifier(" + dens + ") of " + wkt(a) + " changes length/area: " + dense.getLength() + "/" + dense.getArea() + " vs " + a.getLength() + "/" + a.getArea());
+        for (int i = 0; i < dense.getNumGeometries(); i++) {
+            for (P[] e : edges(dense.getGeometryN(i))) {
+                double len = e[0].distSq(e[1]).sqrt();
+                check(len <= dens + 1e-9 * scale, () -> "Densifier(" + dens + ") of " + wkt(a) + " leaves a segment of length " + len + ": " + wkt(dense));
+            }
+        }
+        for (Coordinate c : a.getCoordinates()) {
+            double dd = dense.distance(GF.createPoint(c));
+            check(dd <= 1e-9 * scale, () -> "Densifier(" + dens + ") of " + wkt(a) + " loses the vertex " + c + ": " + wkt(dense));
+        }
+        for (Coordinate c : dense.getCoordinates()) {
+            double dd = a.distance(GF.createPoint(c));
+            check(dd <= 1e-9 * scale, () -> "Densifier(" + dens + ") of " + wkt(a) + " puts the vertex " + c + " at " + dd + " from the input: " + wkt(dense));
+        }
+        check(dense.getNumGeometries() == a.getNumGeometries() && dense.getDimension() == a.getDimension(), () -> "Densifier(" + dens + ") of " + wkt(a) + " changes the structure: " + wkt(dense));
+        // precision reducer: coordinates on the grid, valid
+        double gridScale = pick(tc, 1.0, 2.0, 0.5, 10.0);
+        PrecisionModel pm = new PrecisionModel(gridScale);
+        Geometry reduced = GeometryPrecisionReducer.reduce(a, pm);
+        check(reduced.isValid(), () -> "GeometryPrecisionReducer(" + gridScale + ") of " + wkt(a) + " is invalid: " + wkt(reduced) + " (" + new IsValidOp(reduced).getValidationError() + ")");
+        for (Coordinate c : reduced.getCoordinates()) {
+            check(c.x * gridScale == Math.rint(c.x * gridScale) && c.y * gridScale == Math.rint(c.y * gridScale), () -> "GeometryPrecisionReducer(" + gridScale + ") of " + wkt(a) + " leaves " + c + " off the grid: " + wkt(reduced));
+        }
+        // snap-rounding moves nothing farther than a cell's half-diagonal, in either direction
+        double snap = Math.sqrt(2) / (2 * gridScale) + 1e-9 * scale;
+        if (!reduced.isEmpty()) {
+            for (Coordinate c : reduced.getCoordinates()) {
+                double dd = a.distance(GF.createPoint(c));
+                check(dd <= snap, () -> "GeometryPrecisionReducer(" + gridScale + ") of " + wkt(a) + " puts the vertex " + c + " at " + dd + " from the input: " + wkt(reduced));
+            }
+            // (the other direction does not hold: thin parts collapse and are removed, as documented)
+        }
+        Geometry pointwise = GeometryPrecisionReducer.reducePointwise(a, pm);
+        check(pointwise.getNumPoints() == a.getNumPoints(), () -> "reducePointwise changes the point count of " + wkt(a) + ": " + wkt(pointwise));
+    }
