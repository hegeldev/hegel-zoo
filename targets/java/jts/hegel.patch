+    // --------------------------------------------------------------------------------------------------- overlay
+
+    /** The polygonal parts of a geometry as a (Multi)Polygon. */
+    static Geometry areal(Geometry g) {
+        List<Polygon> polys = new ArrayList<>();
+        for (int i = 0; i < g.getNumGeometries(); i++) {
+            Geometry part = g.getGeometryN(i);
+            if (part instanceof Polygon poly) {
+                polys.add(poly);
+            } else if (part instanceof GeometryCollection) {
+                Geometry sub = areal(part);
+                for (int k = 0; k < sub.getNumGeometries(); k++) {
+                    polys.add((Polygon) sub.getGeometryN(k));
+                }
+            }
+        }
+        return GF.createMultiPolygon(polys.toArray(new Polygon[0]));
+    }
+
+    static Geometry ngOverlay(Geometry a, Geometry b, int op) {
+        return OverlayNGRobust.overlay(a, b, op);
+    }
+
+    static Geometry oldOverlay(Geometry a, Geometry b, int op) {
+        return OverlayOp.overlayOp(a, b, op);
+    }
+
+    /** OverlayOp and OverlayNG agree with each other and with the area/length identities; results are valid. */
+    @Test
+    void overlayIsConsistent() {
+        Hegel.test(tc -> {
+            GeoGen g = new GeoGen(tc);
+            boolean areal = chance(tc, 75);
+            Geometry a = areal ? g.polygonal() : (chance(tc, 50) ? g.simpleLine() : g.line());
+            Geometry b;
+            int rel = n(tc, 0, 99);
+            if (rel < 10) {
+                b = a.copy();
+            } else if (rel < 25) {
+                b = GeoGen.translate(a, g.step() * n(tc, -3, 3), g.step() * n(tc, -3, 3));
+            } else if (rel < 35) {
+                b = g.polygonal();
+            } else {
+                b = areal ? g.polygonal() : (chance(tc, 50) ? g.simpleLine() : g.line());
+            }
+            String pair = wkt(a) + " and " + wkt(b);
+            double scale = Math.max(1, g.range);
+            double areaTol = 1e-7 * scale * scale;
+
+            Geometry[] ng = new Geometry[5];
+            Geometry[] old = new Geometry[5];
+            String[] names = {"", "intersection", "union", "difference", "symDifference"};
+            for (int op = 1; op <= 4; op++) {
+                try {
+                    ng[op] = ngOverlay(a, b, op);
+                } catch (RuntimeException e) {
+                    check(false, "OverlayNGRobust " + names[op] + " throws " + e + " for " + pair);
+                    return;
+                }
+                try {
+                    old[op] = oldOverlay(a, b, op);
+                } catch (RuntimeException e) {
+                    // the original overlay is known to fail on robustness cases: report only when NG succeeded and the inputs are on the integer grid
+                    if (g.scheme == 0 && g.range <= 10) {
+                        check(false, "OverlayOp " + names[op] + " throws " + e + " for " + pair);
+                    }
+                    return;
+                }
+                final int o = op;
+                check(ng[op].isValid(), () -> "OverlayNG " + names[o] + " of " + pair + " is invalid: " + wkt(ng[o]) + " (" + new IsValidOp(ng[o]).getValidationError() + ")");
+                check(old[op].isValid(), () -> "OverlayOp " + names[o] + " of " + pair + " is invalid: " + wkt(old[o]) + " (" + new IsValidOp(old[o]).getValidationError() + ")");
+                if (areal) {
+                    check(Exact.close(ng[op].getArea(), old[op].getArea(), areaTol), () -> "OverlayNG " + names[o] + " has area " + ng[o].getArea() + ", OverlayOp " + old[o].getArea() + " for " + pair);
+                    if (ng[op].getArea() > 0 || old[op].getArea() > 0) {
+                        // OverlayNG refuses mixed-dimension collections (its documented limit): compare the areal parts
+                        Geometry sd = ngOverlay(areal(ng[op]), areal(old[op]), OverlayNG.SYMDIFFERENCE);
+                        check(sd.getArea() <= areaTol, () -> "OverlayNG and OverlayOp " + names[o] + " differ by an area of " + sd.getArea() + " for " + pair + ": " + wkt(ng[o]) + " vs " + wkt(old[o]));
+                    }
+                } else {
+                    check(Exact.close(ng[op].getLength(), old[op].getLength(), 1e-7 * scale), () -> "OverlayNG " + names[o] + " has length " + ng[o].getLength() + ", OverlayOp " + old[o].getLength() + " for " + pair);
+                }
+            }
+            if (areal) {
+                double aa = a.getArea();
+                double ab = b.getArea();
+                double ai = ng[1].getArea();
+                double au = ng[2].getArea();
+                double ad = ng[3].getArea();
+                double as = ng[4].getArea();
+                check(Exact.close(ai + au, aa + ab, areaTol), () -> "area(A ∩ B) + area(A ∪ B) = " + (ai + au) + " but area(A) + area(B) = " + (aa + ab) + " for " + pair);
+                check(Exact.close(ad + ai, aa, areaTol), () -> "area(A − B) + area(A ∩ B) = " + (ad + ai) + " but area(A) = " + aa + " for " + pair);
+                check(Exact.close(as + 2 * ai, aa + ab, areaTol), () -> "area(A ⊕ B) + 2 area(A ∩ B) = " + (as + 2 * ai) + " but area(A) + area(B) = " + (aa + ab) + " for " + pair);
+                check(ai <= Math.min(aa, ab) + areaTol, () -> "area(A ∩ B) = " + ai + " exceeds min(area A, area B) = " + Math.min(aa, ab) + " for " + pair);
+                check(au >= Math.max(aa, ab) - areaTol, () -> "area(A ∪ B) = " + au + " is below max(area A, area B) = " + Math.max(aa, ab) + " for " + pair);
+                // the union covers the inputs, the intersection lies within both (within a tolerance of the boundary)
+                for (Coordinate c : a.getCoordinates()) {
+                    double d = ng[2].distance(GF.createPoint(c));
+                    check(d <= 1e-7 * scale, () -> "the union " + wkt(ng[2]) + " misses vertex " + c + " of A by " + d + " for " + pair);
+                }
+                for (Coordinate c : ng[1].getCoordinates()) {
+                    double d1 = a.distance(GF.createPoint(c));
+                    double d2 = b.distance(GF.createPoint(c));
+                    check(d1 <= 1e-7 * scale && d2 <= 1e-7 * scale, () -> "the intersection vertex " + c + " is " + d1 + " / " + d2 + " outside A / B for " + pair);
+                }
+                // predicates agree with the overlay
+                boolean intersects = a.intersects(b);
+                boolean nonEmptyInt = !ng[1].isEmpty();
+                check(intersects == nonEmptyInt, () -> "intersects = " + intersects + " but the intersection is " + wkt(ng[1]) + " for " + pair);
+                if (a.contains(b)) {
+                    check(Exact.close(ai, ab, areaTol), () -> "A contains B but area(A ∩ B) = " + ai + " and area(B) = " + ab + " for " + pair);
+                }
+                // union of a geometry with itself and with the empty geometry
+                Geometry selfU = ngOverlay(a, a, OverlayNG.UNION);
+                check(selfU.equalsTopo(a) || Exact.close(selfU.getArea(), aa, areaTol), () -> "A ∪ A = " + wkt(selfU) + " for A = " + wkt(a));
+                Geometry emptyU = a.union(GF.createPolygon());
+                check(Exact.close(emptyU.getArea(), aa, areaTol), () -> "A ∪ ∅ = " + wkt(emptyU) + " for A = " + wkt(a));
+                // unary union of the parts
+                if (a instanceof MultiPolygon && a.getNumGeometries() > 1) {
+                    Geometry uu = UnaryUnionOp.union(a);
+                    check(Exact.close(uu.getArea(), aa, areaTol), () -> "UnaryUnionOp of disjoint polygons has area " + uu.getArea() + ", the parts sum to " + aa + " for " + wkt(a));
+                    List<Geometry> parts = new ArrayList<>();
+                    for (int i = 0; i < a.getNumGeometries(); i++) {
+                        parts.add(a.getGeometryN(i));
+                    }
+                    Geometry cu = CascadedPolygonUnion.union(parts);
+                    check(Exact.close(cu.getArea(), aa, areaTol), () -> "CascadedPolygonUnion of disjoint polygons has area " + cu.getArea() + ", the parts sum to " + aa + " for " + wkt(a));
+                    check(uu.getNumGeometries() == a.getNumGeometries(), () -> "UnaryUnionOp of " + a.getNumGeometries() + " disjoint polygons has " + uu.getNumGeometries() + " parts: " + wkt(uu));
+                }
+                // fixed precision: a snapped overlay is valid and its coordinates lie on the grid
+                if (g.scheme == 0 && chance(tc, 30)) {
+                    PrecisionModel pm = new PrecisionModel(1.0);
+                    Geometry fixed = OverlayNG.overlay(a, b, OverlayNG.INTERSECTION, pm);
+                    check(fixed.isValid(), () -> "OverlayNG intersection with PrecisionModel(1) is invalid: " + wkt(fixed) + " for " + pair);
+                    for (Coordinate c : fixed.getCoordinates()) {
+                        check(c.x == Math.rint(c.x) && c.y == Math.rint(c.y), () -> "OverlayNG with PrecisionModel(1) produced " + c + " for " + pair);
+                    }
+                    // on the integer grid the inputs' vertices are already precise, so the areas match closely
+                    check(Exact.close(fixed.getArea(), ai, 0.5 * (a.getNumPoints() + b.getNumPoints()) * scale), () -> "OverlayNG with PrecisionModel(1) has area " + fixed.getArea() + ", the floating intersection " + ai + " for " + pair);
+                }
+            } else {
+                double la = a.getLength();
+                double li = ng[1].getLength();
+                double ld = ng[3].getLength();
+                if (a.isSimple()) {
+                    check(Exact.close(li + ld, la, 1e-7 * scale), () -> "length(A ∩ B) + length(A − B) = " + (li + ld) + " but length(A) = " + la + " for " + pair);
+                } else {
+                    check(li + ld <= la + 1e-7 * scale, () -> "length(A ∩ B) + length(A − B) = " + (li + ld) + " exceeds length(A) = " + la + " for " + pair);
+                }
+                double lu = ng[2].getLength();
+                double lb = b.getLength();
+                check(lu <= la + lb + 1e-7 * scale, () -> "length(A ∪ B) = " + lu + " exceeds length(A) + length(B) = " + (la + lb) + " for " + pair);
+                check(li + lu <= la + lb + 1e-7 * scale, () -> "length(A ∩ B) + length(A ∪ B) = " + (li + lu) + " exceeds length(A) + length(B) = " + (la + lb) + " for " + pair);
+            }
+            // a line against a polygon: the parts inside and outside sum to the line
+            if (chance(tc, 40)) {
+                LineString line = chance(tc, 60) ? g.simpleLine() : g.line();
+                Geometry poly = g.polygonal();
+                Geometry in = ngOverlay(line, poly, OverlayNG.INTERSECTION);
+                Geometry out = ngOverlay(line, poly, OverlayNG.DIFFERENCE);
+                if (line.isSimple()) {
+                    check(Exact.close(in.getLength() + out.getLength(), line.getLength(), 1e-7 * scale), () -> "length(L ∩ P) + length(L − P) = " + (in.getLength() + out.getLength()) + " but length(L) = " + line.getLength() + " for " + wkt(line) + " and " + wkt(poly));
+                }
+                Geometry inOld = oldOverlay(line, poly, OverlayOp.INTERSECTION);
+                check(Exact.close(in.getLength(), inOld.getLength(), 1e-7 * scale), () -> "OverlayNG line ∩ polygon has length " + in.getLength() + ", OverlayOp " + inOld.getLength() + " for " + wkt(line) + " and " + wkt(poly));
+            }
+        }, Zoo.settings("jts.overlayIsConsistent"));
+    }
