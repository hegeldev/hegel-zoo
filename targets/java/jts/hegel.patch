+    /** WKB, WKT and GeoJSON readers invert the writers; copy, norm, reverse, equals/hashCode and compareTo laws. */
+    @Test
+    void readersInvertWriters() {
+        Hegel.test(tc -> {
+            GeoGen g = new GeoGen(tc);
+            Geometry geom = g.any();
+            if (chance(tc, 10) && geom.getDimension() < 2) {
+                geom = withStrangeOrdinates(tc, geom); // rings would lose their closure: points and lines only
+            }
+            final Geometry a = geom;
+            String text = a.toText();
+            check(text.equals(a.toString()), () -> "toText() = " + text + " but toString() = " + a);
+            check(text.equals(new WKTWriter().write(a)), () -> "toText() = " + text + " but WKTWriter.write = " + new WKTWriter().write(a));
+            // WKT; an ordinate below 1 whose 16-fraction-digit rendering does not read back is jts/1's shape, which
+            // under HEGEL_NO_KNOWN is left out (STRANGE then holds none, so this rejects nothing)
+            if (Zoo.NO_KNOWN) {
+                tc.assume(!hasShortFractionLoss(a));
+            }
+            checkWktRoundTrip(a);
+            // WKB, both byte orders, with and without SRID
+            int order = chance(tc, 50) ? 1 : 2; // ByteOrderValues.BIG_ENDIAN = 1, LITTLE_ENDIAN = 2
+            boolean srid = chance(tc, 30);
+            if (srid) {
+                a.setSRID(n(tc, 1, 99999));
+            }
+            WKBWriter ww = new WKBWriter(2, order, srid);
+            byte[] bytes = ww.write(a);
+            try {
+                Geometry back = new WKBReader(GF).read(bytes);
+                check(back.equalsExact(a) && sameTypes(back, a), () -> "WKB round trip (order " + order + ", srid " + srid + ") of " + wkt(a) + " gives " + wkt(back) + " (" + back.getGeometryType() + ")");
+                if (srid) {
+                    check(back.getSRID() == a.getSRID(), () -> "WKB round trip loses the SRID " + a.getSRID() + " -> " + back.getSRID() + " for " + wkt(a));
+                }
+                // as hex
+                String hex = WKBWriter.toHex(bytes);
+                byte[] fromHex = WKBReader.hexToBytes(hex);
+                check(Arrays.equals(bytes, fromHex), () -> "hexToBytes(toHex(bytes)) differs for " + wkt(a));
+                Geometry back2 = new WKBReader(GF).read(fromHex);
+                check(back2.equalsExact(a), () -> "WKB hex round trip of " + wkt(a) + " gives " + wkt(back2));
+            } catch (ParseException | RuntimeException e) {
+                check(false, "WKBReader rejects the WKB of " + text + ": " + e);
+            }
+            // GeoJSON (8 decimals by default: all of the generator's schemes are exact at that precision)
+            if (!hasStrangeOrdinates(a)) {
+                GeoJsonWriter jw = new GeoJsonWriter();
+                jw.setEncodeCRS(false);
+                try {
+                    String json = jw.write(a);
+                    Geometry back = new GeoJsonReader(GF).read(json);
+                    check(back.equalsExact(a) && sameTypes(back, a), () -> "GeoJSON round trip of " + wkt(a) + " gives " + wkt(back) + " (" + back.getGeometryType() + ") via " + json);
+                } catch (ParseException | RuntimeException e) {
+                    check(false, "GeoJSON round trip of " + text + " fails: " + e);
+                }
+            }
+            // copy, norm, reverse, equals/hashCode, compareTo
+            Geometry copy = a.copy();
+            check(copy.equalsExact(a) && copy != a, () -> "copy() of " + wkt(a) + " is " + wkt(copy));
+            check(a.equals((Object) copy) && a.hashCode() == copy.hashCode(), () -> "equals/hashCode differ between " + wkt(a) + " and its copy");
+            Geometry norm = a.norm();
+            check(norm.norm().equalsExact(norm), () -> "norm() is not idempotent for " + wkt(a) + ": " + wkt(norm) + " then " + wkt(norm.norm()));
+            check(a.equalsNorm(norm) && a.equalsNorm(a.reverse()), () -> "equalsNorm fails for " + wkt(a) + " against its norm " + wkt(norm) + " or reverse " + wkt(a.reverse()));
+            check(a.reverse().reverse().equalsExact(a), () -> "reverse().reverse() of " + wkt(a) + " is " + wkt(a.reverse().reverse()));
+            check(a.reverse().getNumPoints() == a.getNumPoints(), () -> "reverse() changes the point count of " + wkt(a));
+            check(a.compareTo(copy) == 0, () -> "compareTo(copy) = " + a.compareTo(copy) + " for " + wkt(a));
+            Geometry other = g.any();
+            int c1 = a.compareTo(other);
+            int c2 = other.compareTo(a);
+            check(Integer.signum(c1) == -Integer.signum(c2), () -> "compareTo is not antisymmetric: " + c1 + " and " + c2 + " for " + wkt(a) + " and " + wkt(other));
+            check((c1 == 0) == a.equalsExact(other), () -> "compareTo = " + c1 + " but equalsExact = " + a.equalsExact(other) + " for " + wkt(a) + " and " + wkt(other));
+            if (!a.isEmpty()) {
+                check(a.getNumPoints() == a.getCoordinates().length, () -> "getNumPoints = " + a.getNumPoints() + " but getCoordinates has " + a.getCoordinates().length + " for " + wkt(a));
+                Geometry env = a.getEnvelope();
+                check(env.getEnvelopeInternal().equals(a.getEnvelopeInternal()), () -> "getEnvelope() = " + wkt(env) + " but the internal envelope is " + a.getEnvelopeInternal() + " for " + wkt(a));
+            }
+            // boundary: the boundary of a boundary is empty; a polygon's boundary is its rings
+            if (a.getClass() != GeometryCollection.class) {
+            Geometry boundary = a.getBoundary();
+            check(boundary.getClass() == GeometryCollection.class || boundary.getBoundary().isEmpty(), () -> "the boundary of the boundary of " + wkt(a) + " is " + wkt(boundary.getBoundary()));
+            check(boundary.getDimension() == a.getBoundaryDimension() || boundary.isEmpty(), () -> "getBoundary().getDimension() = " + boundary.getDimension() + " but getBoundaryDimension() = " + a.getBoundaryDimension() + " for " + wkt(a));
+            if (a instanceof Polygon poly) {
+                check(boundary.getNumPoints() == poly.getNumPoints(), () -> "the boundary of " + wkt(poly) + " is " + wkt(boundary));
+            }
+            }
+        }, Zoo.settings("jts.readersInvertWriters"));
+    }
+
+    static boolean sameTypes(Geometry x, Geometry y) {
+        if (!x.getGeometryType().equals(y.getGeometryType()) || x.getNumGeometries() != y.getNumGeometries()) {
+            return false;
+        }
+        if (x instanceof GeometryCollection) {
+            for (int i = 0; i < x.getNumGeometries(); i++) {
+                if (!sameTypes(x.getGeometryN(i), y.getGeometryN(i))) {
+                    return false;
+                }
+            }
+        }
+        return true;
+    }
+
+    /** WKT, plain and formatted, reads back equalsExact with the same types. */
+    static void checkWktRoundTrip(Geometry a) {
+        String text = a.toText();
+        try {
+            Geometry back = WKT.read(text);
+            check(back.equalsExact(a) && sameTypes(back, a), () -> "WKT round trip of " + wkt(a) + " with the coordinates " + Arrays.toString(a.getCoordinates()) + " gives " + wkt(back) + " (" + back.getGeometryType() + ") with the coordinates " + Arrays.toString(back.getCoordinates()));
+            Geometry backF = WKT.read(new WKTWriter().writeFormatted(a));
+            check(backF.equalsExact(a), () -> "formatted WKT round trip of " + wkt(a) + " with the coordinates " + Arrays.toString(a.getCoordinates()) + " gives " + wkt(backF));
+        } catch (ParseException | RuntimeException e) {
+            check(false, "WKTReader rejects " + text + ": " + e);
+        }
+    }
+
+    /**
+     * Ordinates that stress the text formats: huge, tiny, negative zero, 17 significant digits above 1, and below 1 those
+     * needing 17 significant digits (1/7, 1/3000) or below 1e-16 (1e-17, 5e-324), which the floating WKTWriter's 16
+     * fraction digits lose (jts/1's shape). Under HEGEL_NO_KNOWN the pool holds only what reads back.
+     */
+    static final Double[] STRANGE = strangeOrdinates();
+
+    static Double[] strangeOrdinates() {
+        Double[] all = {1e15, -1e15, 1e-7, 123456789.123456789, 0.1, -0.0, 1.0 / 3, 1e300, Math.PI, Math.E, 1.0 / 7, 1.0 / 3000, 1e-17, 5e-324};
+        if (!Zoo.NO_KNOWN) {
+            return all;
+        }
+        List<Double> kept = new ArrayList<>();
+        for (Double v : all) {
+            if (!shortFractionLoss(v)) {
+                kept.add(v);
+            }
+        }
+        return kept.toArray(new Double[0]);
+    }
+
+    /** Some ordinates replaced by values from {@link #STRANGE}: text formats must keep them. */
+    static Geometry withStrangeOrdinates(TestCase tc, Geometry g) {
+        Geometry c = g.copy();
+        c.apply((org.locationtech.jts.geom.CoordinateFilter) coord -> {
+            if (chance(tc, 30)) {
+                coord.x = pick(tc, STRANGE);
+            }
+            if (chance(tc, 30)) {
+                coord.y = pick(tc, STRANGE);
+            }
+        });
+        c.geometryChanged();
+        return c;
+    }
+
+    /** The 16-fraction-digit decimal rendering of v does not read back to the same double (jts/1's shape). */
+    static boolean shortFractionLoss(double v) {
+        return v != 0 && Double.parseDouble(new java.math.BigDecimal(v).setScale(16, java.math.RoundingMode.HALF_EVEN).toPlainString()) != v;
+    }
+
+    /** Some ordinate of g has {@link #shortFractionLoss}. */
+    static boolean hasShortFractionLoss(Geometry g) {
+        for (Coordinate c : g.getCoordinates()) {
+            if (shortFractionLoss(c.x) || shortFractionLoss(c.y)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    static boolean hasStrangeOrdinates(Geometry g) {
+        for (Coordinate c : g.getCoordinates()) {
+            for (double v : new double[] {c.x, c.y}) {
+                if (Math.abs(v) > 1e9 || (v != 0 && Math.abs(v) < 1e-6) || v * 1000 != Math.rint(v * 1000)) {
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
