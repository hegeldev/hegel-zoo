+class RoaringMoreTest {
+
+    static final Comparator<Long> UNSIGNED = Long::compareUnsigned;
+
+    static String us(long x) {
+        return Long.toUnsignedString(x);
+    }
+
+    static String longs(long[] a, boolean signed) {
+        StringBuilder sb = new StringBuilder("{");
+        for (int i = 0; i < Math.min(a.length, 40); i++) {
+            if (i > 0) {
+                sb.append(',');
+            }
+            sb.append(signed ? Long.toString(a[i]) : us(a[i]));
+        }
+        if (a.length > 40) {
