+            public LongIterator reverseIterator() { return b.getReverseLongIterator(); }
+            public boolean isEmpty() { return b.isEmpty(); }
+            public void addRange(long lo, long hi) { b.addRange(lo, hi); }
+            public void flip(long x) { b.flip(x); }
+            public Object bitmap() { return b; }
+        };
+    }
+
+    static Impl wrap(Roaring64NavigableMap b, boolean signed) {
+        return wrap(b, signed, true);
+    }
+
+    static Impl wrap(Roaring64NavigableMap b, boolean signed, boolean cached) {
+        return new Impl() {
+            public String name() { return "Roaring64NavigableMap(" + (signed ? "signed" : "unsigned") + (cached ? "" : ", no cache") + ")"; }
+            public boolean signed() { return signed; }
+            public void add(long x) { b.addLong(x); }
+            public void remove(long x) { b.removeLong(x); }
+            public boolean contains(long x) { return b.contains(x); }
+            public long cardinality() { return b.getLongCardinality(); }
+            public long rank(long x) { return b.rankLong(x); }
+            public long select(long j) { return b.select(j); }
+            public long first() { return b.first(); }
+            public long last() { return b.last(); }
+            public long[] toArray() { return b.toArray(); }
+            public LongIterator iterator() { return b.getLongIterator(); }
+            public LongIterator reverseIterator() { return b.getReverseLongIterator(); }
+            public boolean isEmpty() { return b.isEmpty(); }
+            public void addRange(long lo, long hi) { b.addRange(lo, hi); }
+            public void flip(long x) { b.flip(x); }
+            public Object bitmap() { return b; }
+        };
+    }
+
+    /** The 64-bit class under test: Roaring64Bitmap, or Roaring64NavigableMap unsigned, signed, or without cached cardinalities. */
+    enum Kind {
+        ROARING64, UNSIGNED_MAP, SIGNED_MAP, UNCACHED_MAP;
+
+        Impl fresh() {
+            return switch (this) {
+                case ROARING64 -> wrap(new Roaring64Bitmap());
+                case UNSIGNED_MAP -> wrap(new Roaring64NavigableMap(), false);
+                case SIGNED_MAP -> wrap(new Roaring64NavigableMap(true), true);
+                case UNCACHED_MAP -> wrap(new Roaring64NavigableMap(false, false), false, false);
+            };
+        }
+    }
+
+    /** Whether a bucket of the map is an empty bitmap (the package-private accessor, by reflection). */
+    static boolean hasEmptyBucket(Roaring64NavigableMap nm) {
