@@ -0,0 +1,75 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<!-- Hegel zoo: property-based tests for RoaringBitmap. Upstream builds with Gradle, so this module
+     compiles the library's own sources (../roaringbitmap/src/main/java, minus module-info.java) as
+     its main sources and needs no installed artifact; see targets/java/roaringbitmap in the zoo. -->
+<project xmlns="http://maven.apache.org/POM/4.0.0"
+         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
+         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
+  <modelVersion>4.0.0</modelVersion>
+  <groupId>dev.hegel.zoo</groupId>
+  <artifactId>roaringbitmap-hegel</artifactId>
+  <version>0</version>
+  <packaging>jar</packaging>
+
+  <properties>
+    <maven.compiler.release>22</maven.compiler.release>
+    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
+    <hegel.version>0.6.0</hegel.version>
+    <junit.version>5.11.4</junit.version>
+  </properties>
+
+  <dependencies>
+    <dependency>
+      <groupId>dev.hegel</groupId>
+      <artifactId>hegel</artifactId>
+      <version>${hegel.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.jupiter</groupId>
+      <artifactId>junit-jupiter</artifactId>
+      <version>${junit.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.platform</groupId>
+      <artifactId>junit-platform-launcher</artifactId>
+      <version>1.11.4</version>
+      <scope>test</scope>
+    </dependency>
+  </dependencies>
+
+  <build>
+    <sourceDirectory>${project.basedir}/../roaringbitmap/src/main/java</sourceDirectory>
+    <plugins>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-compiler-plugin</artifactId>
+        <version>3.13.0</version>
+        <configuration>
+          <excludes>
+            <exclude>module-info.java</exclude>
+          </excludes>
+          <showWarnings>false</showWarnings>
+          <compilerArgs>
+            <arg>-Xlint:none</arg>
+          </compilerArgs>
+        </configuration>
+      </plugin>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-surefire-plugin</artifactId>
+        <version>3.5.2</version>
+        <configuration>
+          <argLine>--enable-native-access=ALL-UNNAMED -Xmx1g</argLine>
+          <!-- the library ships a module-info.java; run the tests on the class path so the
+               ZooListener registered in META-INF/services is picked up -->
+          <useModulePath>false</useModulePath>
+          <trimStackTrace>false</trimStackTrace>
+          <!-- every test's `ZOO …` line is what the zoo judges; Maven's exit code is not -->
+          <testFailureIgnore>true</testFailureIgnore>
+        </configuration>
+      </plugin>
+    </plugins>
+  </build>
+</project>
diff --git a/hegel/src/test/java/zoo/Gen.java b/hegel/src/test/java/zoo/Gen.java
new file mode 100644
index 0000000..2f3d1d6
--- /dev/null
+++ b/hegel/src/test/java/zoo/Gen.java
@@ -0,0 +1,73 @@
+package zoo;
+
+import static dev.hegel.Generators.integers;
+import static dev.hegel.Generators.just;
+import static dev.hegel.Generators.longs;
+
+import dev.hegel.Generator;
+import java.util.List;
+
+/**
+ * The combinators the binding lacks: weighted choice, a biased coin, an optional with a probability, and int and
+ * long ranges.
+ */
+final class Gen {
+    private Gen() {}
+
+    /** A weighted alternative for {@link #weighted}; the generator may produce a subtype of the choice's type. */
+    record Choice<T>(int weight, Generator<? extends T> gen) {}
+
+    static <T> Choice<T> w(int weight, Generator<? extends T> gen) {
+        return new Choice<>(weight, gen);
+    }
+
+    /** One of the generators, chosen in proportion to the weights; one draw, shrinks towards the first. */
+    @SafeVarargs
+    static <T> Generator<T> weighted(Choice<T>... choices) {
+        return weighted(List.of(choices));
+    }
+
+    static <T> Generator<T> weighted(List<Choice<T>> choices) {
+        List<Choice<T>> cs = List.copyOf(choices);
+        int total = 0;
+        for (Choice<T> c : cs) {
+            total += c.weight();
+        }
+        return ints(0, total - 1).flatMap(i -> {
+            int acc = 0;
+            for (Choice<T> c : cs) {
+                acc += c.weight();
+                if (i < acc) {
+                    return widen(c.gen());
+                }
+            }
+            throw new IllegalStateException("weighted: " + i + " beyond " + acc);
+        });
+    }
+
+    /** A generator of a subtype is a generator of the supertype: it only ever produces values. */
+    @SuppressWarnings("unchecked")
+    static <T> Generator<T> widen(Generator<? extends T> g) {
+        return (Generator<T>) g;
+    }
+
+    /** True with probability pct/100; shrinks to false. */
+    static Generator<Boolean> chance(int pct) {
+        return ints(0, 99).map(x -> x >= 100 - pct);
+    }
+
+    /** {@code absent} (weight 100 - pct), or a value of {@code present} (weight pct); shrinks to absent. */
+    static <T> Generator<T> maybe(int pct, T absent, Generator<? extends T> present) {
+        return weighted(w(100 - pct, just(absent)), w(pct, present));
+    }
+
+    /** An int in [lo, hi]; shrinks to lo. */
+    static Generator<Integer> ints(int lo, int hi) {
+        return integers().min(lo).max(hi);
+    }
+
+    /** A long in [lo, hi]; shrinks to lo. */
+    static Generator<Long> longRange(long lo, long hi) {
+        return longs().min(lo).max(hi);
+    }
+}
diff --git a/hegel/src/test/java/zoo/RoaringBitmapTest.java b/hegel/src/test/java/zoo/RoaringBitmapTest.java
new file mode 100644
index 0000000..6a11512
--- /dev/null
+++ b/hegel/src/test/java/zoo/RoaringBitmapTest.java
@@ -0,0 +1,1719 @@
+package zoo;
+
+import static dev.hegel.Generators.just;
+import static dev.hegel.Generators.lists;
+import static dev.hegel.Generators.sampledFrom;
+import static dev.hegel.Generators.tuples;
+import static zoo.Gen.chance;
+import static zoo.Gen.ints;
+import static zoo.Gen.maybe;
+import static zoo.Gen.w;
+import static zoo.Gen.weighted;
+import static zoo.Zoo.check;
+import static zoo.Zoo.fail;
+
+import dev.hegel.Generator;
+import dev.hegel.Generators;
+import dev.hegel.Hegel;
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.DataInputStream;
+import java.io.DataOutputStream;
+import java.io.ObjectInputStream;
+import java.io.ObjectOutputStream;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.BitSet;
+import java.util.Comparator;
+import java.util.List;
+import java.util.NavigableSet;
+import java.util.NoSuchElementException;
+import java.util.TreeSet;
+import java.util.function.Function;
+import org.junit.jupiter.api.Test;
+import org.roaringbitmap.BatchIterator;
+import org.roaringbitmap.BitSetUtil;
+import org.roaringbitmap.FastAggregation;
+import org.roaringbitmap.FastRankRoaringBitmap;
+import org.roaringbitmap.IntIterator;
+import org.roaringbitmap.ParallelAggregation;
+import org.roaringbitmap.PeekableIntIterator;
+import org.roaringbitmap.RoaringBitSet;
+import org.roaringbitmap.RoaringBitmap;
+import org.roaringbitmap.RoaringBitmapWriter;
+import org.roaringbitmap.buffer.BufferFastAggregation;
+import org.roaringbitmap.buffer.ImmutableRoaringBitmap;
+import org.roaringbitmap.buffer.MutableRoaringBitmap;
+
+/**
+ * RoaringBitmap (32-bit, unsigned) against a TreeSet of Integers ordered as unsigned values: point
+ * and range mutations, the queries, the iterators, the set algebra (including the buffer classes
+ * and the aggregation helpers), serialization and the BitSet bridge.
+ */
+class RoaringBitmapTest {
+
+    static final Comparator<Integer> UNSIGNED = Integer::compareUnsigned;
+    static final long TOP = 1L << 32;
+
+    static long ul(int x) {
+        return Integer.toUnsignedLong(x);
+    }
+
+    static NavigableSet<Integer> model() {
+        return new TreeSet<>(UNSIGNED);
+    }
+
+    static int[] arr(NavigableSet<Integer> m) {
+        int[] a = new int[m.size()];
+        int i = 0;
+        for (int x : m) {
+            a[i++] = x;
+        }
+        return a;
+    }
+
+    /** The model's element at the index taken modulo its size. */
+    static int nth(NavigableSet<Integer> m, int index) {
+        return arr(m)[index % m.size()];
+    }
+
+    static String uls(int[] a) {
+        StringBuilder sb = new StringBuilder("{");
+        for (int i = 0; i < a.length; i++) {
+            if (i > 0) {
+                sb.append(',');
+            }
+            sb.append(ul(a[i]));
+        }
+        return sb.append('}').toString();
+    }
+
+    // ------------------------------------------------------------------------------ values and ranges
+
+    /** A 16-bit container key: one of a few fixed ones (70%, so bitmaps share containers) or any. */
+    static final Generator<Integer> KEY = weighted(w(70, sampledFrom(0, 1, 2, 0x7fff, 0x8000, 0xfffe, 0xffff)), w(30, ints(0, 0xffff)));
+
+    /** The low 16 bits of a value: small (half the time) or any. */
+    static final Generator<Integer> LOW = weighted(w(1, ints(0, 300)), w(1, ints(0, 0xffff)));
+
+    /** A value: a key and low bits. */
+    static final Generator<Integer> VALUE = tuples(KEY, LOW).map(t -> (t.value1() << 16) | t.value2());
+
+    /** An index into a live collection, taken modulo its size when applied. */
+    static final Generator<Integer> INDEX = ints(0, 999);
+
+    /** The length of a range, given its start. */
+    sealed interface Len permits Fixed, ToContainerEnd, ToUniverseEnd {
+        long from(long lo);
+    }
+
+    record Fixed(long n) implements Len {
+        @Override
+        public long from(long lo) {
+            return n;
+        }
+    }
+
+    record ToContainerEnd() implements Len {
+        @Override
+        public long from(long lo) {
+            return 65536 - (lo & 0xffff);
+        }
+    }
+
+    record ToUniverseEnd() implements Len {
+        @Override
+        public long from(long lo) {
+            return TOP - lo;
+        }
+    }
+
+    /** A length: tiny, up to 300, 4000..9000, whole containers plus a remainder, to the end of the container, to 2^32, up to 70000. */
+    static final Generator<Len> LEN = weighted(
+        w(1, ints(0, 3).<Len>map(Fixed::new)),
+        w(1, ints(0, 300).<Len>map(Fixed::new)),
+        w(1, ints(4000, 9000).<Len>map(Fixed::new)),
+        w(1, tuples(ints(0, 3), ints(0, 0xffff)).<Len>map(t -> new Fixed(t.value1() * 65536L + t.value2()))),
+        w(1, Generators.<Len>just(new ToContainerEnd())),
+        w(1, Generators.<Len>just(new ToUniverseEnd())),
+        w(1, ints(0, 70000).<Len>map(Fixed::new)));
+
+    /** An unsigned range [lo, hi): a start in a container and a length; {@link #bounds} clips it to 2^32 and to a maximum length (ranges the TreeSet model has to enumerate). */
+    record Span(int key, int off, Len len) {
+        long[] bounds(long maxLen) {
+            long lo = ul(key << 16) + off;
+            long hi = Math.min(TOP, lo + len.from(lo));
+            if (hi - lo > maxLen) {
+                hi = lo + maxLen;
+            }
+            return new long[] {lo, hi};
+        }
+
+        long[] bounds() {
+            return bounds(Long.MAX_VALUE);
+        }
+    }
+
+    static final Generator<Span> SPAN = tuples(KEY, ints(0, 0xffff), LEN).map(t -> new Span(t.value1(), t.value2(), t.value3()));
+
+    // ------------------------------------------------------------------------------ a bitmap and its model
+
+    /** The content of one container, relative to its base. */
+    sealed interface Shape permits Points, Dense, Runs, Holey, Extremes {
+        void fill(long base, RoaringBitmap rb, NavigableSet<Integer> m);
+    }
+
+    /** Sparse points: one to forty low values. */
+    record Points(List<Integer> lows) implements Shape {
+        @Override
+        public void fill(long base, RoaringBitmap rb, NavigableSet<Integer> m) {
+            for (int low : lows) {
+                int v = (int) (base + low);
+                rb.add(v);
+                m.add(v);
+            }
+        }
+    }
+
+    /** One dense block [lo, lo + len), clipped to the container (a bitmap container once over 4096 values). */
+    record Dense(int lo, int len) implements Shape {
+        @Override
+        public void fill(long base, RoaringBitmap rb, NavigableSet<Integer> m) {
+            int n = Math.min(len, 65536 - lo);
+            rb.add(base + lo, base + lo + n);
+            addRange(m, base + lo, base + lo + n);
+        }
+    }
+
+    record Run(int lo, int len) {}
+
+    /** Several short runs. */
+    record Runs(List<Run> runs) implements Shape {
+        @Override
+        public void fill(long base, RoaringBitmap rb, NavigableSet<Integer> m) {
+            for (Run r : runs) {
+                rb.add(base + r.lo(), base + r.lo() + r.len());
+                addRange(m, base + r.lo(), base + r.lo() + r.len());
+            }
+        }
+    }
+
+    /** A run [lo, lo + len) with holes, each hole taken modulo the length. */
+    record Holey(int lo, int len, List<Integer> holes) implements Shape {
+        @Override
+        public void fill(long base, RoaringBitmap rb, NavigableSet<Integer> m) {
+            rb.add(base + lo, base + lo + len);
+            addRange(m, base + lo, base + lo + len);
+            for (int h : holes) {
+                int v = (int) (base + lo + h % len);
+                rb.remove(v);
+                m.remove(v);
+            }
+        }
+    }
+
+    /** The extremes of the container: its first, last, second and penultimate value, each present or not. */
+    record Extremes(boolean first, boolean last, boolean second, boolean penultimate) implements Shape {
+        @Override
+        public void fill(long base, RoaringBitmap rb, NavigableSet<Integer> m) {
+            boolean[] on = {first, last, second, penultimate};
+            int[] vs = {(int) base, (int) (base + 0xffff), (int) (base + 1), (int) (base + 0xfffe)};
+            for (int i = 0; i < vs.length; i++) {
+                if (on[i]) {
+                    rb.add(vs[i]);
+                    m.add(vs[i]);
+                }
+            }
+        }
+    }
+
+    static final Generator<Shape> SHAPE = weighted(
+        w(1, lists(ints(0, 0xffff)).minSize(1).maxSize(40).<Shape>map(Points::new)),
+        w(1, tuples(ints(0, 60000), ints(1, 9000)).<Shape>map(t -> new Dense(t.value1(), t.value2()))),
+        w(1, lists(tuples(ints(0, 65000), ints(1, 500)).map(t -> new Run(t.value1(), t.value2()))).minSize(1).maxSize(6).<Shape>map(Runs::new)),
+        w(1, tuples(ints(0, 30000), ints(1, 6000), lists(ints(0, 5999)).minSize(1).maxSize(20)).<Shape>map(t -> new Holey(t.value1(), t.value2(), t.value3()))),
+        w(1, tuples(chance(60), chance(60), chance(60), chance(60)).<Shape>map(t -> new Extremes(t.value1(), t.value2(), t.value3(), t.value4()))));
+
+    record Container(int key, Shape shape) {}
+
+    static final Generator<Container> CONTAINER = tuples(KEY, SHAPE).map(t -> new Container(t.value1(), t.value2()));
+
+    /** What is done to the containers' encoding after they are built. */
+    enum Compression { NONE, RUN_OPTIMIZE, REMOVE_RUN }
+
+    static final Generator<Compression> COMPRESSION = weighted(
+        w(35, just(Compression.NONE)), w(50, just(Compression.RUN_OPTIMIZE)), w(15, just(Compression.REMOVE_RUN)));
+
+    /** A bitmap and its model, built together. */
+    record Built(RoaringBitmap rb, NavigableSet<Integer> m) {}
+
+    /** A bitmap: up to four containers of mixed shapes, a full container 8% of the time, then run-optimised or run-decompressed. */
+    record Bitmap(List<Container> containers, Integer fullKey, Compression compression) {
+        Built build() {
+            RoaringBitmap rb = new RoaringBitmap();
+            NavigableSet<Integer> m = model();
+            for (Container c : containers) {
+                c.shape().fill(ul(c.key() << 16), rb, m);
+            }
+            if (fullKey != null) {
+                long base = ul(fullKey << 16);
+                rb.add(base, base + 65536);
+                addRange(m, base, base + 65536);
+            }
+            switch (compression) {
+                case RUN_OPTIMIZE -> rb.runOptimize();
+                case REMOVE_RUN -> rb.removeRunCompression();
+                case NONE -> { }
+            }
+            return new Built(rb, m);
+        }
+    }
+
+    /** A bitmap whose container keys come from the given generator. */
+    static Generator<Bitmap> bitmap(Generator<Integer> key) {
+        Generator<Container> container = tuples(key, SHAPE).map(t -> new Container(t.value1(), t.value2()));
+        return tuples(lists(container).maxSize(4), maybe(8, (Integer) null, key), COMPRESSION)
+            .map(t -> new Bitmap(t.value1(), t.value2(), t.value3()));
+    }
+
+    static final Generator<Bitmap> BITMAP = bitmap(KEY);
+
+    /** A key below 256, so every value is a non-negative int below 2^24: what java.util.BitSet can hold cheaply. */
+    static final Generator<Integer> SMALL_KEY = weighted(w(70, sampledFrom(0, 1, 2, 254, 255)), w(30, ints(0, 255)));
+
+    /** A bitmap for the BitSet bridge. */
+    static final Generator<Bitmap> SMALL_BITMAP = bitmap(SMALL_KEY);
+
+    static void addRange(NavigableSet<Integer> m, long lo, long hi) {
+        for (long x = lo; x < hi; x++) {
+            m.add((int) x);
+        }
+    }
+
+    static void removeRange(NavigableSet<Integer> m, long lo, long hi) {
+        if (hi <= lo) {
+            return;
+        }
+        m.subSet((int) lo, true, (int) (hi - 1), true).clear();
+    }
+
+    static void flipRange(NavigableSet<Integer> m, long lo, long hi) {
+        for (long x = lo; x < hi; x++) {
+            int v = (int) x;
+            if (!m.remove(v)) {
+                m.add(v);
+            }
+        }
+    }
+
+    static void same(String what, RoaringBitmap rb, NavigableSet<Integer> m) {
+        int[] got = rb.toArray();
+        int[] want = arr(m);
+        if (!Arrays.equals(got, want)) {
+            fail(what + ": toArray differs from the model: " + diff(got, want));
+        }
+        check(rb.getCardinality() == m.size(), () -> what + ": cardinality " + rb.getCardinality() + " != " + m.size());
+        check(rb.getLongCardinality() == m.size(), () -> what + ": long cardinality");
+        check(rb.isEmpty() == m.isEmpty(), () -> what + ": isEmpty " + rb.isEmpty());
+    }
+
+    static void sameArr(String what, int[] got, int[] want) {
+        if (!Arrays.equals(got, want)) {
+            fail(what + ": " + diff(got, want));
+        }
+    }
+
+    /** Whether m holds all 65536 values of some container with key >= key. */
+    static boolean hasFullContainerAtOrAbove(NavigableSet<Integer> m, long key) {
+        long current = -1, count = 0;
+        for (int x : m.tailSet((int) (key << 16), true)) {
+            long k = ul(x) >>> 16;
+            if (k != current) {
+                current = k;
+                count = 0;
+            }
+            if (++count == 65536) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    static String diff(int[] got, int[] want) {
+        NavigableSet<Integer> g = model(), w = model();
+        for (int x : got) {
+            g.add(x);
+        }
+        for (int x : want) {
+            w.add(x);
+        }
+        List<Long> extra = new ArrayList<>(), missing = new ArrayList<>();
+        for (int x : g) {
+            if (!w.contains(x)) {
+                extra.add(ul(x));
+            }
+        }
+        for (int x : w) {
+            if (!g.contains(x)) {
+                missing.add(ul(x));
+            }
+        }
+        int[] sorted = arr(g);
+        String order = Arrays.equals(got, sorted) ? "" : "; got is not in unsigned order or has duplicates (" + uls(Arrays.copyOf(got, Math.min(got.length, 12))) + ")";
+        return "got " + got.length + " values, want " + want.length + "; extra " + head(extra) + ", missing " + head(missing) + order;
+    }
+
+    static String head(List<Long> l) {
+        return l.size() > 12 ? l.subList(0, 12) + "… (" + l.size() + ")" : l.toString();
+    }
+
+    static int[] arrOf(Iterable<Integer> it) {
+        List<Integer> l = new ArrayList<>();
+        for (int x : it) {
+            l.add(x);
+        }
+        int[] a = new int[l.size()];
+        for (int i = 0; i < a.length; i++) {
+            a[i] = l.get(i);
+        }
+        return a;
+    }
+
+    static int[] drain(IntIterator it) {
+        List<Integer> l = new ArrayList<>();
+        int guard = 0;
+        while (it.hasNext()) {
+            l.add(it.next());
+            if (++guard > 400000) {
+                fail("iterator does not end");
+                break;
+            }
+        }
+        int[] a = new int[l.size()];
+        for (int i = 0; i < a.length; i++) {
+            a[i] = l.get(i);
+        }
+        return a;
+    }
+
+    static int[] reversed(int[] a) {
+        int[] r = new int[a.length];
+        for (int i = 0; i < a.length; i++) {
+            r[i] = a[a.length - 1 - i];
+        }
+        return r;
+    }
+
+    static long countIn(NavigableSet<Integer> m, long lo, long hi) {
+        if (hi <= lo) {
+            return 0;
+        }
+        return m.subSet((int) lo, true, (int) (hi - 1), true).size();
+    }
+
+    // ------------------------------------------------------------------------------ 1. mutations and queries
+
+    /** A point near the bitmap: a fresh value, or (index >= 0 and the bitmap not empty) the model's element at the index modulo its size, plus delta. */
+    record Probe(int value, int index, int delta) {
+        int at(NavigableSet<Integer> m) {
+            return index >= 0 && !m.isEmpty() ? nth(m, index) + delta : value;
+        }
+    }
+
+    /** A value for a point operation: a fresh one, or one of the bitmap's own half the time. */
+    static final Generator<Probe> PICK = tuples(VALUE, maybe(50, -1, INDEX)).map(t -> new Probe(t.value1(), t.value2(), 0));
+
+    static final Generator<Integer> NOTABLE = sampledFrom(0, 1, -1, -2, Integer.MAX_VALUE, Integer.MIN_VALUE, 0xffff, 0x10000);
+
+    /** A query point: a fresh (70%) or notable (30%) value, or one of the bitmap's own plus -1..1 half the time. */
+    static final Generator<Probe> PROBE = tuples(weighted(w(70, VALUE), w(30, NOTABLE)), maybe(50, -1, INDEX), sampledFrom(0, 1, -1))
+        .map(t -> new Probe(t.value1(), t.value2(), t.value3()));
+
+    /** A mutation of the bitmap and its model; ranges are clipped to 20000 values where the model enumerates them. */
+    sealed interface Op permits Add, Remove, Flip, CheckedAdd, CheckedRemove, AddRange, RemoveRange, FlipRange, StaticAdd, StaticRemove, StaticFlip,
+        AddMany, RunOptimize, RemoveRunCompression, Trim, OrWith {}
+
+    record Add(int v) implements Op {}
+
+    record Remove(int v) implements Op {}
+
+    record Flip(Probe at) implements Op {}
+
+    record CheckedAdd(Probe at) implements Op {}
+
+    record CheckedRemove(Probe at) implements Op {}
+
+    record AddRange(Span range) implements Op {}
+
+    record RemoveRange(Span range) implements Op {}
+
+    record FlipRange(Span range) implements Op {}
+
+    record StaticAdd(Span range) implements Op {}
+
+    record StaticRemove(Span range) implements Op {}
+
+    record StaticFlip(Span range) implements Op {}
+
+    /** add(int...) of the values, or (addN) addN of count values (modulo the size plus one) from offset (modulo what remains). */
+    record AddMany(List<Integer> values, int count, int offset, boolean addN) implements Op {}
+
+    record RunOptimize() implements Op {}
+
+    record RemoveRunCompression() implements Op {}
+
+    /** trim() on a clone. */
+    record Trim() implements Op {}
+
+    record OrWith(Bitmap other) implements Op {}
+
+    static final Generator<Op> OP = weighted(
+        w(1, VALUE.<Op>map(Add::new)),
+        w(1, VALUE.<Op>map(Remove::new)),
+        w(1, PICK.<Op>map(Flip::new)),
+        w(1, PICK.<Op>map(CheckedAdd::new)),
+        w(1, PICK.<Op>map(CheckedRemove::new)),
+        w(1, SPAN.<Op>map(AddRange::new)),
+        w(1, SPAN.<Op>map(RemoveRange::new)),
+        w(1, SPAN.<Op>map(FlipRange::new)),
+        w(1, SPAN.<Op>map(StaticAdd::new)),
+        w(1, SPAN.<Op>map(StaticRemove::new)),
+        w(1, SPAN.<Op>map(StaticFlip::new)),
+        w(1, tuples(lists(VALUE).maxSize(8), ints(0, 6), INDEX, chance(50)).<Op>map(t -> new AddMany(t.value1(), t.value2(), t.value3(), t.value4()))),
+        w(1, Generators.<Op>just(new RunOptimize())),
+        w(1, Generators.<Op>just(new RemoveRunCompression())),
+        w(1, Generators.<Op>just(new Trim())),
+        w(1, BITMAP.<Op>map(OrWith::new)));
+
+    /** Applies the operation to the bitmap and its model; returns the bitmap to go on with (the static operations return a new one). */
+    static RoaringBitmap apply(Op op, RoaringBitmap rb, NavigableSet<Integer> m) {
+        switch (op) {
+            case Add x -> {
+                rb.add(x.v());
+                m.add(x.v());
+            }
+            case Remove x -> {
+                rb.remove(x.v());
+                m.remove(x.v());
+            }
+            case Flip x -> {
+                int v = x.at().at(m);
+                rb.flip(v);
+                if (!m.remove(v)) {
+                    m.add(v);
+                }
+            }
+            case CheckedAdd x -> {
+                int v = x.at().at(m);
+                boolean want = !m.contains(v);
+                boolean got = rb.checkedAdd(v);
+                m.add(v);
+                check(got == want, () -> "checkedAdd(" + ul(v) + ") returned " + got + ", element was " + (want ? "absent" : "present"));
+            }
+            case CheckedRemove x -> {
+                int v = x.at().at(m);
+                boolean want = m.contains(v);
+                boolean got = rb.checkedRemove(v);
+                m.remove(v);
+                check(got == want, () -> "checkedRemove(" + ul(v) + ") returned " + got + ", element was " + (want ? "present" : "absent"));
+            }
+            case AddRange x -> {
+                long[] r = x.range().bounds(20000);
+                rb.add(r[0], r[1]);
+                addRange(m, r[0], r[1]);
+            }
+            case RemoveRange x -> {
+                long[] r = x.range().bounds();
+                rb.remove(r[0], r[1]);
+                removeRange(m, r[0], r[1]);
+            }
+            case FlipRange x -> {
+                long[] r = x.range().bounds(20000);
+                rb.flip(r[0], r[1]);
+                flipRange(m, r[0], r[1]);
+            }
+            case StaticAdd x -> {
+                long[] r = x.range().bounds(20000);
+                RoaringBitmap before = rb.clone();
+                RoaringBitmap res = RoaringBitmap.add(rb, r[0], r[1]);
+                check(rb.equals(before), () -> "static add modified its argument");
+                addRange(m, r[0], r[1]);
+                return res;
+            }
+            case StaticRemove x -> {
+                long[] r = x.range().bounds();
+                RoaringBitmap before = rb.clone();
+                RoaringBitmap res = RoaringBitmap.remove(rb, r[0], r[1]);
+                check(rb.equals(before), () -> "static remove modified its argument");
+                removeRange(m, r[0], r[1]);
+                return res;
+            }
+            case StaticFlip x -> {
+                long[] r = x.range().bounds(20000);
+                RoaringBitmap before = rb.clone();
+                RoaringBitmap res = RoaringBitmap.flip(rb, r[0], r[1]);
+                check(rb.equals(before), () -> "static flip modified its argument");
+                flipRange(m, r[0], r[1]);
+                return res;
+            }
+            case AddMany x -> {
+                int[] vs = x.values().stream().mapToInt(Integer::intValue).toArray();
+                int cnt = x.count() % (vs.length + 1);
+                int off = x.offset() % (vs.length - cnt + 1);
+                if (x.addN()) {
+                    rb.addN(vs, off, cnt);
+                    for (int j = off; j < off + cnt; j++) {
+                        m.add(vs[j]);
+                    }
+                } else {
+                    rb.add(vs);
+                    for (int v : vs) {
+                        m.add(v);
+                    }
+                }
+            }
+            case RunOptimize x -> rb.runOptimize();
+            case RemoveRunCompression x -> rb.removeRunCompression();
+            case Trim x -> {
+                RoaringBitmap t = rb.clone();
+                t.trim();
+                return t;
+            }
+            case OrWith x -> {
+                Built o = x.other().build();
+                rb.or(o.rb());
+                m.addAll(o.m());
+            }
+        }
+        return rb;
+    }
+
+    /** A range query: a span, or (index >= 0 and the bitmap not empty) a range hugging the model's element at the index: [a - before, a + after). */
+    record RangeProbe(Span span, int index, int before, int after) {
+        long[] bounds(NavigableSet<Integer> m) {
+            if (index >= 0 && !m.isEmpty()) {
+                long a = ul(nth(m, index));
+                return new long[] {Math.max(0, a - before), Math.min(TOP, a + after)};
+            }
+            return span.bounds();
+        }
+    }
+
+    static final Generator<RangeProbe> RANGE_PROBE = tuples(SPAN, maybe(40, -1, INDEX), ints(0, 2), ints(0, 3))
+        .map(t -> new RangeProbe(t.value1(), t.value2(), t.value3(), t.value4()));
+
+    /** The argument of limit(): a fixed count, or one taken modulo the cardinality plus three. */
+    sealed interface Limit permits Exactly, Around {
+        int of(int size);
+    }
+
+    record Exactly(int k) implements Limit {
+        @Override
+        public int of(int size) {
+            return k;
+        }
+    }
+
+    record Around(int k) implements Limit {
+        @Override
+        public int of(int size) {
+            return k % (size + 3);
+        }
+    }
+
+    static final Generator<Limit> LIMIT = weighted(
+        w(1, sampledFrom(0, 1, Integer.MAX_VALUE).<Limit>map(Exactly::new)),
+        w(1, INDEX.<Limit>map(Around::new)));
+
+    /** The argument of addOffset(): a notable offset (whole containers, the ends of the range, 2^31) or any up to 70000 either way. */
+    static final Generator<Long> OFFSET = weighted(
+        w(1, sampledFrom(0L, 65536L, -65536L, TOP - 1, -(TOP - 1), 1L << 31, -(1L << 31))),
+        w(1, ints(-70000, 70000).map(Integer::longValue)));
+
+    /**
+     * The queries after the mutations: the batch iterator's buffer size, twelve points, six ranks to select, eight ranges,
+     * a limit, an offset, the element whose next absent value makes a superset, and whether the equal rebuilt bitmap is
+     * compared run-optimised (else run-decompressed).
+     */
+    record Queries(int bufSize, List<Probe> points, List<Integer> selects, List<RangeProbe> ranges, Limit limit, long offset, int superset, boolean runOptimize) {}
+
+    static final Generator<Queries> QUERIES = tuples(
+            sampledFrom(1, 2, 3, 7, 64, 256, 1024), lists(PROBE).minSize(12).maxSize(12), lists(INDEX).minSize(6).maxSize(6),
+            lists(RANGE_PROBE).minSize(8).maxSize(8), LIMIT, OFFSET, INDEX, chance(50))
+        .map(t -> new Queries(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6(), t.value7(), t.value8()));
+
+    /** A bitmap, up to twelve mutations, and the queries after them. */
+    record MutationCase(Bitmap start, List<Op> ops, Queries queries) {}
+
+    static final Generator<MutationCase> MUTATION_CASE = tuples(BITMAP, lists(OP).maxSize(12), QUERIES).map(t -> new MutationCase(t.value1(), t.value2(), t.value3()));
+
+    /** Bugs roaringbitmap/2 and /27: forEach skips a run at key 0x8000 or runs away after a lone 0x7FFFFFFF in a run container. */
+    static boolean forEachBug(RoaringBitmap b, NavigableSet<Integer> m) {
+        boolean runawayShape = m.contains(0x7FFFFFFF) && !m.contains(0x7FFFFFFE);
+        return b.hasRunCompression() && (!sub(m, 0x80000000L, 0x80010000L).isEmpty() || runawayShape);
+    }
+
+    /** Bug roaringbitmap/7: contains(min, sup) with the supremum's container absent beyond the range's first key. */
+    static boolean supremumAbsent(NavigableSet<Integer> m, long lo, long hi) {
+        return hi < TOP && (hi & 0xFFFF) != 0 && (hi >>> 16) != (lo >>> 16) && countIn(m, (hi >>> 16) << 16, ((hi >>> 16) + 1) << 16) == 0;
+    }
+
+    @Test
+    void mutationsAndQueriesMatchAnUnsignedSetModel() {
+        Hegel.test(tc -> {
+            MutationCase c = tc.draw(MUTATION_CASE, "case");
+            Built start = c.start().build();
+            NavigableSet<Integer> m = start.m();
+            RoaringBitmap rb = start.rb();
+            for (Op op : c.ops()) {
+                rb = apply(op, rb, m);
+            }
+            final RoaringBitmap b = rb;
+            Queries q = c.queries();
+            same("after mutations", b, m);
+            int[] want = arr(m);
+
+            // iterators
+            sameArr("getIntIterator", drain(b.getIntIterator()), want);
+            sameArr("getReverseIntIterator", drain(b.getReverseIntIterator()), reversed(want));
+            sameArr("iterator()", arrOf(b), want);
+            int[] signed = want.clone();
+            Arrays.sort(signed);
+            sameArr("getSignedIntIterator", drain(b.getSignedIntIterator()), signed);
+            sameArr("stream()", b.stream().toArray(), want);
+            // bugs roaringbitmap/2 and /27: pinned; for those shapes forEach is checked on a run-decompressed copy instead
+            RoaringBitmap fb = b;
+            if (forEachBug(b, m)) {
+                fb = b.clone();
+                fb.removeRunCompression();
+            }
+            final RoaringBitmap forEachOf = fb;
+            {
+                List<Integer> fe = new ArrayList<>();
+                try {
+                    forEachOf.forEach((org.roaringbitmap.IntConsumer) x -> {
+                        if (fe.size() > 2 * want.length + 100) {
+                            throw new IllegalStateException("forEach emits far more values than the cardinality " + want.length + ": " + diff(arrOf(fe), want) + "; containers " + containers(forEachOf) + "; first emitted " + uls(arrOf(fe.subList(0, 12))));
+                        }
+                        fe.add(x);
+                    });
+                    sameArr("forEach", arrOf(fe), want);
+                } catch (IllegalStateException e) {
+                    fail(e.getMessage());
+                }
+            }
+            int bufSize = q.bufSize();
+            int[] buf = new int[bufSize];
+            List<Integer> batched = new ArrayList<>();
+            BatchIterator bi = b.getBatchIterator();
+            int guard = 0;
+            while (bi.hasNext()) {
+                int cnt = bi.nextBatch(buf);
+                check(cnt > 0 && cnt <= bufSize, () -> "nextBatch returned " + cnt + " for a buffer of " + bufSize);
+                for (int j = 0; j < cnt; j++) {
+                    batched.add(buf[j]);
+                }
+                if (++guard > 500000) {
+                    fail("batch iterator does not end");
+                    break;
+                }
+            }
+            sameArr("batch iterator (buffer " + bufSize + ")", arrOf(batched), want);
+
+            // scalar queries
+            check(b.cardinalityExceeds(m.size()) == false && (m.isEmpty() || b.cardinalityExceeds(m.size() - 1)),
+                    () -> "cardinalityExceeds around the cardinality " + m.size());
+            if (m.isEmpty()) {
+                try {
+                    int f = b.first();
+                    fail("first() of an empty bitmap returned " + f);
+                } catch (NoSuchElementException e) {
+                    // documented
+                }
+            } else {
+                check(b.first() == m.first(), () -> "first " + ul(b.first()) + " != " + ul(m.first()));
+                check(b.last() == m.last(), () -> "last " + ul(b.last()) + " != " + ul(m.last()));
+                check(b.firstSigned() == signed[0], () -> "firstSigned " + b.firstSigned() + " != " + signed[0]);
+                check(b.lastSigned() == signed[signed.length - 1], () -> "lastSigned " + b.lastSigned() + " != " + signed[signed.length - 1]);
+                check(b.getContainerCount() == m.stream().map(x -> x >>> 16).distinct().count(),
+                        () -> "getContainerCount " + b.getContainerCount());
+            }
+            for (Probe p : q.points()) {
+                final int fx = p.at(m);
+                int x = fx;
+                check(b.contains(x) == m.contains(x), () -> "contains(" + ul(fx) + ") " + b.contains(fx));
+                long rank = m.headSet(x, true).size();
+                check(b.rank(x) == rank, () -> "rank(" + ul(fx) + ") " + b.rank(fx) + " != " + rank);
+                check(b.rankLong(x) == rank, () -> "rankLong(" + ul(fx) + ") " + b.rankLong(fx) + " != " + rank);
+                Integer ceil = m.ceiling(x);
+                long nv = ceil == null ? -1 : ul(ceil);
+                check(b.nextValue(x) == nv, () -> "nextValue(" + ul(fx) + ") " + b.nextValue(fx) + " != " + nv);
+                Integer floor = m.floor(x);
+                long pv = floor == null ? -1 : ul(floor);
+                check(b.previousValue(x) == pv, () -> "previousValue(" + ul(fx) + ") " + b.previousValue(fx) + " != " + pv);
+                // bug roaringbitmap/1: nextAbsentValue/previousAbsentValue below a container with key >= 0x8000; pinned, skipped here
+                boolean signBoundary = x >= 0 && ceil != null && ceil < 0 && (ceil >>> 16) != (x >>> 16);
+                if (!signBoundary) {
+                    long na = ul(x);
+                    while (na < TOP && m.contains((int) na)) {
+                        na++;
+                    }
+                    long nav = na == TOP ? -1 : na;
+                    check(b.nextAbsentValue(x) == nav, () -> "nextAbsentValue(" + ul(fx) + ") " + b.nextAbsentValue(fx) + " != " + nav);
+                    long pa = ul(x);
+                    while (pa >= 0 && m.contains((int) pa)) {
+                        pa--;
+                    }
+                    final long pav = pa;
+                    // bug roaringbitmap/23: the library's own assertion rejects -1 when 0xFFFFFFFF is present; pinned, skipped here
+                    if (!(pav == -1 && m.contains(-1))) {
+                        try {
+                            check(b.previousAbsentValue(x) == pav, () -> "previousAbsentValue(" + ul(fx) + ") " + b.previousAbsentValue(fx) + " != " + pav);
+                        } catch (AssertionError e) {
+                            fail("previousAbsentValue(" + ul(fx) + ") failed the library's own assertion (" + e + "), expected " + pav + "; containers " + containers(b) + "; values " + uls(Arrays.copyOf(want, Math.min(want.length, 30))));
+                        }
+                    }
+                }
+                PeekableIntIterator pi = b.getIntIterator();
+                pi.advanceIfNeeded(x);
+                if (ceil == null) {
+                    check(!pi.hasNext(), () -> "advanceIfNeeded(" + ul(fx) + ") left values although none >= it");
+                } else {
+                    check(pi.hasNext() && pi.peekNext() == ceil, () -> "advanceIfNeeded(" + ul(fx) + ") peekNext " + (pi.hasNext() ? ul(pi.peekNext()) + "" : "none") + " != " + ul(ceil));
+                }
+                PeekableIntIterator ri = b.getReverseIntIterator();
+                ri.advanceIfNeeded(x);
+                if (floor == null) {
+                    check(!ri.hasNext(), () -> "reverse advanceIfNeeded(" + ul(fx) + ") left values although none <= it");
+                } else {
+                    check(ri.hasNext() && ri.peekNext() == floor, () -> "reverse advanceIfNeeded(" + ul(fx) + ") peekNext " + (ri.hasNext() ? ul(ri.peekNext()) + "" : "none") + " != " + ul(floor));
+                }
+            }
+            if (!m.isEmpty()) {
+                for (int idx : q.selects()) {
+                    int j = idx % m.size();
+                    check(b.select(j) == want[j], () -> "select(" + j + ") " + ul(b.select(j)) + " != " + ul(want[j]));
+                }
+            }
+            try {
+                int s = b.select(m.size());
+                fail("select(cardinality) returned " + ul(s) + " instead of throwing");
+            } catch (IllegalArgumentException e) {
+                // documented
+            }
+            // range queries
+            for (RangeProbe rp : q.ranges()) {
+                long[] r = rp.bounds(m);
+                long lo = r[0], hi = r[1];
+                long cnt = countIn(m, lo, hi);
+                check(b.rangeCardinality(lo, hi) == cnt, () -> "rangeCardinality(" + lo + ", " + hi + ") " + b.rangeCardinality(lo, hi) + " != " + cnt);
+                boolean full = hi > lo && cnt == hi - lo;
+                // bug roaringbitmap/7: contains(min, sup) for sup = 2^32 or an absent supremum container; pinned, skipped here
+                check(hi == TOP || supremumAbsent(m, lo, hi) || b.contains(lo, hi) == full, () -> "contains(" + lo + ", " + hi + ") " + b.contains(lo, hi) + " != " + full);
+                check(b.intersects(lo, hi) == (cnt > 0), () -> "intersects(" + lo + ", " + hi + ") " + b.intersects(lo, hi) + " != " + (cnt > 0));
+                RoaringBitmap sel = b.selectRange(lo, hi);
+                NavigableSet<Integer> ms = model();
+                if (hi > lo) {
+                    ms.addAll(m.subSet((int) lo, true, (int) (hi - 1), true));
+                }
+                same("selectRange(" + lo + ", " + hi + ")", sel, ms);
+                check(b.contains(sel), () -> "contains(selectRange) false");
+                // bug roaringbitmap/3: forEachInRange stops at 2^31; pinned, ranges across it are skipped here (and lengths beyond an int)
+                if (hi - lo <= Integer.MAX_VALUE && hi > lo && !(lo < (1L << 31) && hi >= (1L << 31))) {
+                    List<Integer> got = new ArrayList<>();
+                    b.forEachInRange((int) lo, (int) (hi - lo), (org.roaringbitmap.IntConsumer) got::add);
+                    sameArr("forEachInRange(" + lo + ", " + (hi - lo) + ")", arrOf(got), arr(ms));
+                }
+            }
+            // limit, addOffset, contains(subset), hamming, toString, equals/hashCode
+            int k = q.limit().of(m.size());
+            RoaringBitmap lim = b.limit(k);
+            sameArr("limit(" + k + ")", lim.toArray(), Arrays.copyOf(want, Math.min(k, want.length)));
+            check(b.contains(lim), () -> "contains(limit) false");
+            long off = q.offset();
+            NavigableSet<Integer> mo = model();
+            boolean drops = false;
+            for (int x : m) {
+                long y = ul(x) + off;
+                if (y >= 0 && y < TOP) {
+                    mo.add((int) y);
+                } else {
+                    drops = true;
+                }
+            }
+            // bug roaringbitmap/4: addOffset by whole containers wraps what falls outside; pinned, skipped here
+            if (!(off % 65536 == 0 && drops)) {
+                RoaringBitmap shifted = RoaringBitmap.addOffset(b, off);
+                same("addOffset(" + off + ")", shifted, mo);
+            }
+            if (!m.isEmpty()) {
+                RoaringBitmap extra = b.clone();
+                long absent = b.nextAbsentValue(nth(m, q.superset()));
+                if (absent >= 0) {
+                    extra.add((int) absent);
+                    check(!b.contains(extra), () -> "contains(superset) true");
+                    check(extra.contains(b), () -> "superset.contains(bitmap) false");
+                    check(b.isHammingSimilar(extra, 1) && !b.isHammingSimilar(extra, 0), () -> "isHammingSimilar for one differing bit");
+                }
+            }
+            check(b.isHammingSimilar(b, 0), () -> "isHammingSimilar(self, 0) false");
+            check(want.length > 40000 || b.toString().equals(uls(want)), () -> "toString differs: " + firstDiff(b.toString(), uls(want)));
+            RoaringBitmap rebuilt = RoaringBitmap.bitmapOf(want);
+            check(b.equals(rebuilt) && rebuilt.equals(b), () -> "equals(bitmapOf(toArray())) false");
+            if (q.runOptimize()) {
+                rebuilt.runOptimize();
+                b.runOptimize();
+            } else {
+                rebuilt.removeRunCompression();
+                b.removeRunCompression();
+            }
+            // bug roaringbitmap/8: equal run-optimised bitmaps whose containers tie between run and array form; pinned, tolerated here
+            check(b.hasRunCompression() != rebuilt.hasRunCompression() || containers(b).replace("ArrayContainer", "X").replace("RunContainer", "X").equals(containers(rebuilt).replace("ArrayContainer", "X").replace("RunContainer", "X")) && !containers(b).equals(containers(rebuilt)) || b.hashCode() == rebuilt.hashCode(), () -> "hashCode differs for equal bitmaps with the same run compression: " + b.hashCode() + " vs " + rebuilt.hashCode() + ", containers " + containers(b) + " vs " + containers(rebuilt) + ", equals " + b.equals(rebuilt) + ", " + uls(Arrays.copyOf(want, Math.min(want.length, 20))) + " (" + want.length + ")");
+            check(b.validate(), () -> "validate() false");
+        }, Zoo.settings("mutationsAndQueriesMatchAnUnsignedSetModel"));
+    }
+
+    static String containers(RoaringBitmap b) {
+        StringBuilder sb = new StringBuilder();
+        org.roaringbitmap.ContainerPointer p = b.getContainerPointer();
+        while (p.getContainer() != null) {
+            sb.append((int) p.key()).append(':').append(p.getContainer().getClass().getSimpleName()).append('/').append(p.getCardinality()).append(' ');
+            p.advance();
+        }
+        return sb.toString().trim();
+    }
+
+    static String firstDiff(String a, String b) {
+        int i = 0;
+        while (i < a.length() && i < b.length() && a.charAt(i) == b.charAt(i)) {
+            i++;
+        }
+        return "lengths " + a.length() + "/" + b.length() + ", first difference at " + i + ": …" + a.substring(Math.max(0, i - 30), Math.min(a.length(), i + 40)) + "… vs …" + b.substring(Math.max(0, i - 30), Math.min(b.length(), i + 40)) + "…";
+    }
+
+    static String bitsDiff(BitSet got, BitSet want) {
+        BitSet x = (BitSet) got.clone();
+        x.xor(want);
+        return "cardinalities " + got.cardinality() + "/" + want.cardinality() + ", lengths " + got.length() + "/" + want.length() + ", first differing bit " + x.nextSetBit(0) + (got.get(x.nextSetBit(0) < 0 ? 0 : x.nextSetBit(0)) ? " (extra)" : " (missing)");
+    }
+
