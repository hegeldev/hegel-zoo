+        long[] toArray();
+        LongIterator iterator();
+        LongIterator reverseIterator();
+        boolean isEmpty();
+        void addRange(long lo, long hi);
+        void flip(long x);
+        Object bitmap();
+    }
+
+    static Impl wrap(Roaring64Bitmap b) {
