+                    check(extra.contains(b), () -> "superset.contains(bitmap) false");
+                    check(b.isHammingSimilar(extra, 1) && !b.isHammingSimilar(extra, 0), () -> "isHammingSimilar for one differing bit");
+                }
+            }
+            check(b.isHammingSimilar(b, 0), () -> "isHammingSimilar(self, 0) false");
+            check(want.length > 40000 || b.toString().equals(uls(want)), () -> "toString differs: " + firstDiff(b.toString(), uls(want)));
