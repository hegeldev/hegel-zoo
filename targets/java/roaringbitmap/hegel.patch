+    /** The mask the appender keeps: the smallest 2^k - 1 at or above the maximum. */
+    static long rangeMask(long max) {
+        return max == Long.MAX_VALUE || max == -1 ? max : Long.highestOneBit(max | 1) * 2 - 1;
+    }
+
+    /** Bug roaringbitmap/25: every row at the mask with a container mask of 3 or 5 to 7 bytes makes the queries throw. */
+    static boolean allRowsAtTheMask(long max, long[] values) {
