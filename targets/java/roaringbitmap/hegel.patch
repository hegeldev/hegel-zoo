+    record Construction(Shuffle order, Span range, WriterConfig writer, Feed feed, List<RankProbe> ranks, int extra, int flip) {}
+
+    static final Generator<Construction> CONSTRUCTION = tuples(SHUFFLE, SPAN, sampledFrom(WriterConfig.values()), FEED, lists(RANK_PROBE).minSize(4).maxSize(4), VALUE, INDEX)
+        .map(t -> new Construction(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6(), t.value7()));
