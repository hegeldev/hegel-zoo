+    /** How the writer is fed: addMany of everything, add one by one, or addMany of the first cut values (modulo the count plus one), a flush, then add of the rest. */
+    sealed interface Feed permits Whole, OneByOne, Split {}
+
+    record Whole() implements Feed {}
+
+    record OneByOne() implements Feed {}
+
+    record Split(int cut) implements Feed {}
+
+    static final Generator<Feed> FEED = weighted(
+        w(1, Generators.<Feed>just(new Whole())),
+        w(1, Generators.<Feed>just(new OneByOne())),
+        w(1, INDEX.<Feed>map(Split::new)));
