+    // ------------------------------------------------------------------------------ 4. RoaringBitSet
+
+    static final int BITS = 300000;
+
+    /** A bit index: any below BITS, or (30%) a notable one around the word and container boundaries. */
+    static final Generator<Integer> IDX = weighted(
+        w(70, ints(0, BITS - 1)),
+        w(30, sampledFrom(0, 1, 63, 64, 65, 65535, 65536, 65537, 131071, 131072, BITS - 1)));
+
+    /** A run of bits from an index: its end is the index plus the length, clipped to BITS. */
+    static int endOf(int at, int len) {
+        return Math.min(BITS, at + len);
+    }
+
+    /** A piece of a second set: a single bit or a run of 1 to 5000. */
+    sealed interface Piece permits Bit, BitRun {}
+
+    record Bit(int at) implements Piece {}
+
+    record BitRun(int at, int len) implements Piece {}
+
+    /** A second set: a RoaringBitSet (else a plain BitSet) with up to five pieces. */
+    record SetSpec(boolean roaring, List<Piece> pieces) {
+        BitSet build() {
+            BitSet s = roaring ? new RoaringBitSet() : new BitSet();
+            for (Piece p : pieces) {
+                switch (p) {
+                    case Bit b -> s.set(b.at());
+                    case BitRun r -> s.set(r.at(), endOf(r.at(), r.len()));
+                }
+            }
+            return s;
+        }
+    }
+
+    static final Generator<SetSpec> SET_SPEC = tuples(chance(50), lists(weighted(
+            w(1, IDX.<Piece>map(Bit::new)),
+            w(1, tuples(IDX, ints(1, 5000)).<Piece>map(t -> new BitRun(t.value1(), t.value2()))))).maxSize(5))
+        .map(t -> new SetSpec(t.value1(), t.value2()));
+
+    /** An operation on the RoaringBitSet and the BitSet model; a range is [at, at + len) clipped to BITS. */
+    sealed interface BitOp permits SetBit, SetBitTo, SetBits, SetBitsTo, ClearBit, ClearBits, FlipBit, FlipBits, AndSet, OrSet, XorSet, AndNotSet, ClearAll {}
+
+    record SetBit(int at) implements BitOp {}
+
+    record SetBitTo(int at, boolean value) implements BitOp {}
+
+    record SetBits(int at, int len) implements BitOp {}
+
+    record SetBitsTo(int at, int len, boolean value) implements BitOp {}
+
+    record ClearBit(int at) implements BitOp {}
+
+    record ClearBits(int at, int len) implements BitOp {}
+
+    record FlipBit(int at) implements BitOp {}
+
+    record FlipBits(int at, int len) implements BitOp {}
+
+    record AndSet(SetSpec other) implements BitOp {}
+
+    record OrSet(SetSpec other) implements BitOp {}
+
+    record XorSet(SetSpec other) implements BitOp {}
+
+    record AndNotSet(SetSpec other) implements BitOp {}
+
+    record ClearAll() implements BitOp {}
+
+    static final Generator<Integer> RUN_LEN = ints(0, 5000);
+
+    static final Generator<BitOp> BIT_OP = weighted(
+        w(20, IDX.<BitOp>map(SetBit::new)),
+        w(20, tuples(IDX, chance(50)).<BitOp>map(t -> new SetBitTo(t.value1(), t.value2()))),
+        w(20, tuples(IDX, RUN_LEN).<BitOp>map(t -> new SetBits(t.value1(), t.value2()))),
+        w(20, tuples(IDX, RUN_LEN, chance(50)).<BitOp>map(t -> new SetBitsTo(t.value1(), t.value2(), t.value3()))),
+        w(20, IDX.<BitOp>map(ClearBit::new)),
+        w(20, tuples(IDX, RUN_LEN).<BitOp>map(t -> new ClearBits(t.value1(), t.value2()))),
+        w(20, IDX.<BitOp>map(FlipBit::new)),
+        w(20, tuples(IDX, RUN_LEN).<BitOp>map(t -> new FlipBits(t.value1(), t.value2()))),
+        w(20, SET_SPEC.<BitOp>map(AndSet::new)),
+        w(20, SET_SPEC.<BitOp>map(OrSet::new)),
+        w(20, SET_SPEC.<BitOp>map(XorSet::new)),
+        w(20, SET_SPEC.<BitOp>map(AndNotSet::new)),
+        w(4, Generators.<BitOp>just(new ClearAll())));
+
+    /** Applies the operation to the RoaringBitSet and to the plain BitSet (which cannot read a RoaringBitSet argument, bug roaringbitmap/19). */
+    static void apply(BitOp op, RoaringBitSet r, BitSet b) {
+        switch (op) {
+            case SetBit x -> {
+                r.set(x.at());
+                b.set(x.at());
+            }
+            case SetBitTo x -> {
+                r.set(x.at(), x.value());
+                b.set(x.at(), x.value());
+            }
+            case SetBits x -> {
+                r.set(x.at(), endOf(x.at(), x.len()));
+                b.set(x.at(), endOf(x.at(), x.len()));
+            }
+            case SetBitsTo x -> {
+                r.set(x.at(), endOf(x.at(), x.len()), x.value());
+                b.set(x.at(), endOf(x.at(), x.len()), x.value());
+            }
+            case ClearBit x -> {
+                r.clear(x.at());
+                b.clear(x.at());
+            }
+            case ClearBits x -> {
+                r.clear(x.at(), endOf(x.at(), x.len()));
+                b.clear(x.at(), endOf(x.at(), x.len()));
+            }
+            case FlipBit x -> {
+                r.flip(x.at());
+                b.flip(x.at());
+            }
+            case FlipBits x -> {
+                r.flip(x.at(), endOf(x.at(), x.len()));
+                b.flip(x.at(), endOf(x.at(), x.len()));
+            }
+            case AndSet x -> {
+                BitSet o = x.other().build();
+                r.and(o);
+                b.and(plain(o));
+            }
+            case OrSet x -> {
+                BitSet o = x.other().build();
+                r.or(o);
+                b.or(plain(o));
+            }
+            case XorSet x -> {
+                BitSet o = x.other().build();
+                r.xor(o);
+                b.xor(plain(o));
+            }
+            case AndNotSet x -> {
+                BitSet o = x.other().build();
+                r.andNot(o);
+                b.andNot(plain(o));
+            }
+            case ClearAll x -> {
+                r.clear();
+                b.clear();
+            }
+        }
+    }
+
+    /** A query index: a bit index, or (nth >= 0 and the set not empty) the nth set bit (modulo the cardinality) plus delta, at least 0; the range query runs to it plus len. */
+    record BitProbe(int at, int nth, int delta, int len) {
+        int index(BitSet b) {
+            if (nth >= 0 && !b.isEmpty()) {
+                return Math.max(0, b.stream().skip(nth % b.cardinality()).findFirst().orElse(0) + delta);
+            }
+            return at;
+        }
+    }
+
+    static final Generator<BitProbe> BIT_PROBE = tuples(IDX, maybe(50, -1, INDEX), sampledFrom(0, 1, -1), ints(0, 3000))
+        .map(t -> new BitProbe(t.value1(), t.value2(), t.value3(), t.value4()));
+
+    /** Up to ten operations, ten queries, a set to intersect with, and the bit flipped in the clone. */
+    record BitsCase(List<BitOp> ops, List<BitProbe> probes, SetSpec other, int flip) {}
+
+    static final Generator<BitsCase> BITS_CASE = tuples(lists(BIT_OP).maxSize(10), lists(BIT_PROBE).minSize(10).maxSize(10), SET_SPEC, IDX)
+        .map(t -> new BitsCase(t.value1(), t.value2(), t.value3(), t.value4()));
+
+    static String bits(BitSet s) {
+        int[] a = s.stream().toArray();
+        return a.length > 30 ? Arrays.toString(Arrays.copyOf(a, 30)) + "… (" + a.length + ")" : Arrays.toString(a);
+    }
+
+    static void sameBits(String what, BitSet got, BitSet want) {
+        if (!Arrays.equals(got.stream().toArray(), want.stream().toArray())) {
+            fail(what + ": " + bits(got) + " != " + bits(want));
+        }
+    }
+
+    @Test
+    void roaringBitSetIsADropInForBitSet() {
+        Hegel.test(tc -> {
+            BitsCase c = tc.draw(BITS_CASE, "case");
+            RoaringBitSet r = new RoaringBitSet();
+            BitSet b = new BitSet();
+            for (BitOp op : c.ops()) {
+                apply(op, r, b);
+            }
+            sameBits("after operations", r, b);
+            check(r.cardinality() == b.cardinality(), () -> "cardinality " + r.cardinality() + " != " + b.cardinality());
+            check(r.length() == b.length(), () -> "length " + r.length() + " != " + b.length());
+            check(r.isEmpty() == b.isEmpty(), () -> "isEmpty " + r.isEmpty());
+            check(r.size() >= r.length() && r.size() % 64 == 0, () -> "size " + r.size() + " for length " + r.length());
+            check(BitSet.valueOf(r.toLongArray()).equals(b), () -> "toLongArray does not decode to the same bits");
+            check(BitSet.valueOf(r.toByteArray()).equals(b), () -> "toByteArray does not decode to the same bits");
+            for (BitProbe p : c.probes()) {
+                int x = p.index(b);
+                check(r.get(x) == b.get(x), () -> "get(" + x + ") " + r.get(x));
+                check(r.nextSetBit(x) == b.nextSetBit(x), () -> "nextSetBit(" + x + ") " + r.nextSetBit(x) + " != " + b.nextSetBit(x));
+                check(r.nextClearBit(x) == b.nextClearBit(x), () -> "nextClearBit(" + x + ") " + r.nextClearBit(x) + " != " + b.nextClearBit(x));
+                check(r.previousSetBit(x) == b.previousSetBit(x), () -> "previousSetBit(" + x + ") " + r.previousSetBit(x) + " != " + b.previousSetBit(x));
+                check(r.previousClearBit(x) == b.previousClearBit(x), () -> "previousClearBit(" + x + ") " + r.previousClearBit(x) + " != " + b.previousClearBit(x));
+                int y = Math.min(BITS + 100, x + p.len());
+                sameBits("get(" + x + ", " + y + ")", r.get(x, y), b.get(x, y));
+                check(r.get(x, y).cardinality() == b.get(x, y).cardinality(), () -> "get(" + x + ", " + y + ").cardinality");
+            }
+            BitSet o = c.other().build();
+            check(r.intersects(o) == b.intersects(plain(o)), () -> "intersects " + r.intersects(o));
+            RoaringBitSet copy = (RoaringBitSet) r.clone();
+            check(copy.equals(r) && r.equals(copy) && copy.hashCode() == r.hashCode(), () -> "clone not equal / different hashCode");
+            sameBits("clone", copy, b);
+            copy.flip(c.flip());
+            check(!copy.equals(r), () -> "equals true after flipping a bit in the clone");
+        }, Zoo.settings("roaringBitSetIsADropInForBitSet"));
+    }
+
+    static String cut(String s) {
+        return s.length() > 120 ? s.substring(0, 120) + "…" : s;
+    }
+
+    /** A java.util.BitSet with the same bits (BitSet's own methods cannot read a RoaringBitSet argument). */
+    static BitSet plain(BitSet o) {
+        BitSet p = new BitSet();
+        o.stream().forEach(p::set);
+        return p;
+    }
+}
