+
+    static NavigableSet<Integer> and(NavigableSet<Integer> a, NavigableSet<Integer> b) {
+        NavigableSet<Integer> r = model();
+        for (int x : a) {
+            if (b.contains(x)) {
+                r.add(x);
+            }
+        }
+        return r;
+    }
+
+    static NavigableSet<Integer> or(NavigableSet<Integer> a, NavigableSet<Integer> b) {
+        NavigableSet<Integer> r = model();
+        r.addAll(a);
+        r.addAll(b);
+        return r;
+    }
+
+    static NavigableSet<Integer> xor(NavigableSet<Integer> a, NavigableSet<Integer> b) {
+        NavigableSet<Integer> r = model();
+        for (int x : a) {
+            if (!b.contains(x)) {
+                r.add(x);
+            }
+        }
+        for (int x : b) {
+            if (!a.contains(x)) {
+                r.add(x);
+            }
+        }
+        return r;
+    }
+
+    static NavigableSet<Integer> andNot(NavigableSet<Integer> a, NavigableSet<Integer> b) {
+        NavigableSet<Integer> r = model();
+        for (int x : a) {
+            if (!b.contains(x)) {
+                r.add(x);
+            }
