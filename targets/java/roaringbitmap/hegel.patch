+    /** Whether a bucket of the map is an empty bitmap (the package-private accessor, by reflection). */
+    static boolean hasEmptyBucket(Roaring64NavigableMap nm) {
+        try {
+            java.lang.reflect.Method g = Roaring64NavigableMap.class.getDeclaredMethod("getHighToBitmap");
+            g.setAccessible(true);
+            java.util.Map<?, ?> map = (java.util.Map<?, ?>) g.invoke(nm);
+            for (Object v : map.values()) {
+                if (((org.roaringbitmap.BitmapDataProvider) v).isEmpty()) {
+                    return true;
+                }
+            }
+            return false;
+        } catch (Exception e) {
+            throw new IllegalStateException("cannot inspect the buckets: " + e);
+        }
+    }
+
+    static long[] drain(LongIterator it) {
+        List<Long> l = new ArrayList<>();
+        int guard = 0;
+        while (it.hasNext()) {
+            l.add(it.next());
+            if (++guard > 500000) {
+                fail("long iterator does not end");
+                break;
+            }
+        }
+        long[] a = new long[l.size()];
+        for (int i = 0; i < a.length; i++) {
+            a[i] = l.get(i);
+        }
+        return a;
+    }
+
+    static long[] reversed(long[] a) {
+        long[] r = new long[a.length];
+        for (int i = 0; i < a.length; i++) {
+            r[i] = a[a.length - 1 - i];
+        }
+        return r;
+    }
