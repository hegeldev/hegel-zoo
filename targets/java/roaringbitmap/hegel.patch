+    // ------------------------------------------------------------------------------ 2. RangeBitmap
+
+    static RoaringBitmap rows(long[] values, java.util.function.LongPredicate p, RoaringBitmap context) {
+        RoaringBitmap r = new RoaringBitmap();
+        for (int i = 0; i < values.length; i++) {
+            if (p.test(values[i]) && (context == null || context.contains(i))) {
+                r.add(i);
+            }
+        }
+        return r;
+    }
+
+    static void sameRows(String what, RoaringBitmap got, RoaringBitmap want) {
+        if (!got.equals(want)) {
+            fail(what + ": " + cut(got.toString()) + " != " + cut(want.toString()));
+        }
+    }
+
+    /** The appender's maximum: for 1..62 bits, 2^bits - 1 or a value with that bit set (half each); 0 or 1 for no bits; Long.MAX_VALUE 10% of the time. */
+    static final Generator<Long> MAX = weighted(
+        w(90, ints(0, 62).flatMap(bits -> bits == 0
+            ? sampledFrom(0L, 1L)
+            : weighted(w(1, just((1L << bits) - 1)), w(1, ints(0, Integer.MAX_VALUE).map(r -> r | (1L << bits)))))),
+        w(10, just(Long.MAX_VALUE)));
+
+    /** A row's value, resolved against the maximum. */
+    sealed interface Row permits Zero, Top, NearZero, NearTop, Anywhere {
+        long at(long max);
+    }
+
+    record Zero() implements Row {
+        @Override
+        public long at(long max) {
+            return 0;
+        }
+    }
+
+    record Top() implements Row {
+        @Override
+        public long at(long max) {
+            return max;
+        }
+    }
+
+    record NearZero(int n) implements Row {
+        @Override
+        public long at(long max) {
+            return Math.min(max, n);
+        }
+    }
+
+    record NearTop(int n) implements Row {
+        @Override
+        public long at(long max) {
+            return Math.max(0, max - n);
+        }
+    }
+
+    /** A non-negative long taken modulo the maximum plus one. */
+    record Anywhere(long r) implements Row {
+        @Override
+        public long at(long max) {
+            return max == Long.MAX_VALUE ? r : r % (max + 1);
+        }
+    }
+
+    static final Generator<Long> NON_NEGATIVE = longRange(0, Long.MAX_VALUE);
+
+    static final Generator<Row> ROW = weighted(
+        w(1, Generators.<Row>just(new Zero())),
+        w(1, Generators.<Row>just(new Top())),
+        w(1, ints(0, 10).<Row>map(NearZero::new)),
+        w(1, ints(0, 10).<Row>map(NearTop::new)),
+        w(1, NON_NEGATIVE.<Row>map(Anywhere::new)));
+
+    /** The rows: up to three (20%), or a drawn count of up to 400. */
+    static final Generator<List<Row>> ROWS = weighted(
+        w(20, lists(ROW).maxSize(3)),
+        w(80, ints(0, 400).flatMap(n -> lists(ROW).minSize(n).maxSize(n))));
+
+    /** How the RangeBitmap is built from the appender: directly, through serialize and map, or into a supplied buffer. */
+    enum Build { DIRECT, SERIALIZE_AND_MAP, INTO_BUFFER }
+
+    /** A query threshold, resolved against the maximum and the rows. */
+    sealed interface Threshold permits AtZero, AtMax, NearRow, AboveMax, AtLongMax, Anyway {
+        long at(long max, long[] values);
+    }
+
+    record AtZero() implements Threshold {
+        @Override
+        public long at(long max, long[] values) {
+            return 0;
+        }
+    }
+
+    record AtMax() implements Threshold {
+        @Override
+        public long at(long max, long[] values) {
+            return max;
+        }
+    }
+
+    /** The row at the index (modulo the count) plus delta; delta alone when there are no rows. */
+    record NearRow(int index, int delta) implements Threshold {
+        @Override
+        public long at(long max, long[] values) {
+            return values.length > 0 ? values[index % values.length] + delta : Math.max(0, delta);
+        }
+    }
+
+    /** One to three above the maximum (the maximum itself for Long.MAX_VALUE). */
+    record AboveMax(int n) implements Threshold {
+        @Override
+        public long at(long max, long[] values) {
+            return max == Long.MAX_VALUE ? Long.MAX_VALUE : max + n;
+        }
+    }
+
+    record AtLongMax() implements Threshold {
+        @Override
+        public long at(long max, long[] values) {
+            return Long.MAX_VALUE;
+        }
+    }
+
+    /** A non-negative long taken modulo the maximum plus one. */
+    record Anyway(long r) implements Threshold {
+        @Override
+        public long at(long max, long[] values) {
+            return max == Long.MAX_VALUE ? r : r % (max + 1);
+        }
+    }
+
+    static final Generator<Threshold> THRESHOLD = weighted(
+        w(1, Generators.<Threshold>just(new AtZero())),
+        w(1, Generators.<Threshold>just(new AtMax())),
+        w(1, tuples(INDEX, sampledFrom(0, 1, -1)).<Threshold>map(t -> new NearRow(t.value1(), t.value2()))),
+        w(1, ints(1, 3).<Threshold>map(AboveMax::new)),
+        w(1, Generators.<Threshold>just(new AtLongMax())),
+        w(1, NON_NEGATIVE.<Threshold>map(Anyway::new)));
+
+    /** The upper bound of a between query, given the lower one: the same, a little above, near the maximum, or a row's value. */
+    sealed interface Upper permits Same, Plus, NearMax, AtRow {
+        long at(long lo, long max, long[] values);
+    }
+
+    record Same() implements Upper {
+        @Override
+        public long at(long lo, long max, long[] values) {
+            return lo;
+        }
+    }
+
+    record Plus(int n) implements Upper {
+        @Override
+        public long at(long lo, long max, long[] values) {
+            return lo + n;
+        }
+    }
+
+    record NearMax(int n) implements Upper {
+        @Override
+        public long at(long lo, long max, long[] values) {
+            return max == Long.MAX_VALUE ? Long.MAX_VALUE : Math.min(Long.MAX_VALUE, max + n);
+        }
+    }
+
+    record AtRow(int index) implements Upper {
+        @Override
+        public long at(long lo, long max, long[] values) {
+            return values.length > 0 ? values[index % values.length] : 0;
+        }
+    }
+
+    static final Generator<Upper> UPPER = weighted(
+        w(1, Generators.<Upper>just(new Same())),
+        w(1, ints(0, 5).<Upper>map(Plus::new)),
+        w(1, ints(0, 2).<Upper>map(NearMax::new)),
+        w(1, INDEX.<Upper>map(AtRow::new)));
+
+    /** A query: a threshold for the comparisons, the between interval's other bound (the two sorted), made empty (hi = lo - 1) 15% of the time. */
+    record Query(Threshold threshold, Upper upper, boolean empty) {}
+
+    static final Generator<Query> QUERY = tuples(THRESHOLD, UPPER, chance(15)).map(t -> new Query(t.value1(), t.value2(), t.value3()));
+
+    /**
+     * The appender's maximum, the rows, how the bitmap is built, the context bitmap's coins (null: no context; cycled over
+     * the rows), eight queries, and the row whose value the mapped copy is queried at.
+     */
+    record RangeCase(long max, List<Row> rows, Build build, List<Boolean> context, List<Query> queries, int mapped) {}
+
+    static final Generator<RangeCase> RANGE_CASE = tuples(
+            MAX, ROWS, sampledFrom(Build.values()), maybe(50, (List<Boolean>) null, lists(chance(50)).minSize(1).maxSize(16)),
+            lists(QUERY).minSize(8).maxSize(8), INDEX)
+        .map(t -> new RangeCase(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6()));
