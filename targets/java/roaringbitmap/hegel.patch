+    /** A query on the immutable view: a point and a range. */
+    record ViewProbe(Probe point, Span range) {}
+
+    /** The queries on the immutable view: six points with ranges, a rank to select (modulo the cardinality), a limit (modulo the cardinality plus two). */
+    record Views(List<ViewProbe> probes, int select, int limit) {}
+
+    static final Generator<Views> VIEWS = tuples(lists(tuples(PROBE, SPAN).map(t -> new ViewProbe(t.value1(), t.value2()))).minSize(6).maxSize(6), INDEX, INDEX)
+        .map(t -> new Views(t.value1(), t.value2(), t.value3()));
