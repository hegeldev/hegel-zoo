+    static NavigableSet<Integer> sub(NavigableSet<Integer> m, long lo, long hi) {
+        NavigableSet<Integer> s = model();
+        if (hi > lo) {
+            s.addAll(m.subSet((int) lo, true, (int) (hi - 1), true));
+        }
+        return s;
+    }
