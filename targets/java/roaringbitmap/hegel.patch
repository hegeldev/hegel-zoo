+    }
+
+    static long[] arr(NavigableSet<Long> m) {
+        long[] a = new long[m.size()];
+        int i = 0;
+        for (long x : m) {
+            a[i++] = x;
+        }
+        return a;
+    }
+
+    /** The model's element at the index taken modulo its size. */
+    static long nth(NavigableSet<Long> m, int index) {
+        return arr(m)[index % m.size()];
+    }
+
+    /** An index into a live collection, taken modulo its size when applied. */
+    static final Generator<Integer> INDEX = ints(0, 999);
+
+    // ------------------------------------------------------------------------------ 64-bit values and ranges
+
+    /** The high 32 bits: a few fixed ones (75%, so bitmaps share buckets), or any, doubled half the time to reach the upper half. */
+    static final Generator<Long> HIGH = weighted(
+        w(75, sampledFrom(0L, 1L, 2L, 0x7fffffffL, 0x80000000L, 0xfffffffeL, 0xffffffffL)),
+        w(25, tuples(ints(0, Integer.MAX_VALUE), chance(50)).map(t -> t.value1() * (t.value2() ? 2L : 1L))));
+
+    /** The low 32 bits: small (40%), up to 0xffff (30%), or any (30%). */
+    static final Generator<Long> LOW = weighted(
+        w(40, ints(0, 300).map(Integer::longValue)),
+        w(30, ints(0, 0xffff).map(Integer::longValue)),
+        w(30, ints(Integer.MIN_VALUE, Integer.MAX_VALUE).map(Integer::toUnsignedLong)));
+
+    static final Generator<Long> VALUE = tuples(HIGH, LOW).map(t -> (t.value1() << 32) | t.value2());
+
+    static final Generator<Long> NOTABLE = sampledFrom(0L, -1L, 1L, Long.MAX_VALUE, Long.MIN_VALUE, 0xffffffffL, 0x100000000L);
+
+    /** A range [lo, hi) in unsigned order; hi is -1 when lo + len wraps past 2^64. */
+    sealed interface Range permits Plain, NearBucketEnd {
+        long lo();
+
+        long len();
+
+        default long hi() {
+            long hi = lo() + len();
+            return Long.compareUnsigned(hi, lo()) <= 0 ? -1L : hi;
+        }
+    }
+
+    /** From a value, one of a few lengths. */
+    record Plain(long lo, long len) implements Range {}
+
+    /** From just below the end of the value's 32-bit bucket (back 0..200), 1 to 400 long, so the range may cross the bucket. */
+    record NearBucketEnd(long value, int back, long len) implements Range {
+        @Override
+        public long lo() {
+            return ((value >>> 32) << 32) + 0xffffffffL - back;
+        }
+    }
+
+    static final Generator<Range> RANGE = weighted(
+        w(70, tuples(VALUE, sampledFrom(1L, 2L, 300L, 5000L, 70000L)).<Range>map(t -> new Plain(t.value1(), t.value2()))),
+        w(30, tuples(VALUE, ints(0, 200), ints(1, 400)).<Range>map(t -> new NearBucketEnd(t.value1(), t.value2(), t.value3()))));
+
+    /** A value near the bitmap: a fresh one, or (index >= 0 and the bitmap not empty) the model's element at the index modulo its size, plus delta. */
+    record Near(long value, int index, int delta) {
+        long at(NavigableSet<Long> m) {
+            return index >= 0 && !m.isEmpty() ? nth(m, index) + delta : value;
+        }
+    }
+
+    /** A value for a point operation: a fresh one, or (pct%) one of the bitmap's own. */
+    static Generator<Near> near(int pct) {
+        return tuples(VALUE, maybe(pct, -1, INDEX)).map(t -> new Near(t.value1(), t.value2(), 0));
+    }
+
+    /** A query point: a fresh (70%) or notable (30%) value, or one of the bitmap's own plus -1..1 half the time. */
+    static final Generator<Near> PROBE = tuples(weighted(w(70, VALUE), w(30, NOTABLE)), maybe(50, -1, INDEX), sampledFrom(0, 1, -1))
+        .map(t -> new Near(t.value1(), t.value2(), t.value3()));
+
+    // ------------------------------------------------------------------------------ the implementations
+
+    interface Impl {
