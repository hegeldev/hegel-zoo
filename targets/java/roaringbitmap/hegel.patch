+                boolean full = hi > lo && cnt == hi - lo;
+                boolean supAbsent = hi < TOP && (hi & 0xFFFF) != 0 && (hi >>> 16) != (lo >>> 16) && countIn(m, (hi >>> 16) << 16, ((hi >>> 16) + 1) << 16) == 0;
