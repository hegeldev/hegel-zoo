+package zoo;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.DataInputStream;
+import java.io.DataOutputStream;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.util.BitSet;
+import java.util.concurrent.atomic.AtomicInteger;
+import org.junit.jupiter.api.Test;
+import org.roaringbitmap.FastAggregation;
+import org.roaringbitmap.IntConsumer;
+import org.roaringbitmap.RangeBitmap;
+import org.roaringbitmap.RoaringBitSet;
+import org.roaringbitmap.RoaringBitmap;
+import org.roaringbitmap.RoaringBitmapWriter;
+import org.roaringbitmap.longlong.PeekableLongIterator;
+import org.roaringbitmap.longlong.Roaring64Bitmap;
+import org.roaringbitmap.longlong.Roaring64NavigableMap;
+
+/**
+ * One pin per bug in bugs.toml: each asserts the documented (correct) behaviour and fails while the
+ * bug exists; `zoo` expects them to fail (target.toml `[expected_failures]`).
+ */
+class RoaringPinsTest {
+
+    @Test
+    void pinNextAbsentValueBelowAHighContainerIsTheValueItself() { // roaringbitmap/1
+        RoaringBitmap b = RoaringBitmap.bitmapOf(0x80000005);
+        assertEquals(100L, b.nextAbsentValue(100));
+        assertEquals(100L, b.previousAbsentValue(100));
+    }
+
+    @Test
+    void pinForEachVisitsARunStartingAtTwoToThe31() { // roaringbitmap/2
+        RoaringBitmap b = RoaringBitmap.bitmapOfRange(1L << 31, (1L << 31) + 10);
+        AtomicInteger n = new AtomicInteger();
+        b.forEach((IntConsumer) x -> n.incrementAndGet());
+        assertEquals(10, n.get());
+    }
+
+    @Test
+    void pinForEachStopsAtTheLastRunBeforeTwoToThe31() { // roaringbitmap/27
+        RoaringBitmap b = new RoaringBitmap();
+        b.add(0x7FFF0000L, 0x7FFF0010L);
+        b.add(0x7FFFFFFF);
+        AtomicInteger n = new AtomicInteger();
+        b.forEach((IntConsumer) x -> {
+            if (n.incrementAndGet() > 1000) {
+                throw new IllegalStateException("forEach ran far past the cardinality");
+            }
+        });
+        assertEquals(17, n.get());
+    }
+
+    @Test
+    void pinForEachInRangeReachesTwoToThe31() { // roaringbitmap/3
+        RoaringBitmap b = RoaringBitmap.bitmapOfRange(0x7FFF0000L, 1L << 31);
+        AtomicInteger n = new AtomicInteger();
+        b.forEachInRange(0x7FFF0000, 0x10000, (IntConsumer) x -> n.incrementAndGet());
+        assertEquals(0x10000, n.get());
+    }
+
+    @Test
+    void pinAddOffsetByWholeContainersDropsWhatFallsOutside() { // roaringbitmap/4
+        assertTrue(RoaringBitmap.addOffset(RoaringBitmap.bitmapOf(5), -65536).isEmpty());
+        assertEquals(RoaringBitmap.bitmapOf(65541), RoaringBitmap.addOffset(RoaringBitmap.bitmapOf(5, 0xFFFF0005), 65536));
+    }
+
+    @Test
+    void pinOrNotStaysWithinTheRange() { // roaringbitmap/5
+        assertEquals(RoaringBitmap.bitmapOf(0), RoaringBitmap.orNot(new RoaringBitmap(), RoaringBitmap.bitmapOf(1, 77), 1));
+    }
+
+    @Test
+    void pinOrNotKeepsTheRangeWhenTheOtherBitmapHasAFullContainerBeyondIt() { // roaringbitmap/24
+        RoaringBitmap full = RoaringBitmap.bitmapOfRange(65536, 131072);
+        assertEquals(RoaringBitmap.bitmapOfRange(0, 65536), RoaringBitmap.orNot(new RoaringBitmap(), full, 65536));
+    }
+
+    @Test
+    void pinHorizontalXorOfEqualBitmapsIsEmpty() { // roaringbitmap/6
+        RoaringBitmap x = FastAggregation.horizontal_xor(RoaringBitmap.bitmapOf(1), RoaringBitmap.bitmapOf(1));
+        assertTrue(x.isEmpty());
+        assertEquals(new RoaringBitmap(), x);
+    }
+
+    @Test
+    void pinContainsRangeHandlesTheSupremumsContainer() { // roaringbitmap/7
+        assertFalse(RoaringBitmap.bitmapOf(0xFFFEFFFF).contains(0xFFFEFFFFL, 0xFFFF0002L));
+        assertFalse(RoaringBitmap.bitmapOf(131071, 196608, 196609).contains(131071L, 131074L));
+        assertTrue(RoaringBitmap.bitmapOf(0xFFFFFFFF).contains(0xFFFFFFFFL, 1L << 32));
+    }
+
+    @Test
+    void pinEqualRunOptimisedBitmapsShareAHashCode() { // roaringbitmap/8
+        RoaringBitmap a = new RoaringBitmap();
+        a.add(15L, 18L);
+        a.add(65536L, 65536L + 2041);
+        RoaringBitmap b = RoaringBitmap.bitmapOf(15, 16, 17);
+        b.add(65536L, 65536L + 2041);
+        a.runOptimize();
+        b.runOptimize();
+        assertEquals(a, b);
+        assertTrue(a.hasRunCompression() && b.hasRunCompression());
+        assertEquals(a.hashCode(), b.hashCode());
+    }
+
+    @Test
+    void pinWriterAcceptsTheWholeRange() { // roaringbitmap/9
+        RoaringBitmapWriter<RoaringBitmap> w = RoaringBitmapWriter.writer().expectedRange(0, (1L << 32) - 1).get();
+        w.add(5);
+        w.flush();
+        assertEquals(RoaringBitmap.bitmapOf(5), w.get());
+    }
+
+    @Test
+    void pinAdvanceIfNeededPastTheLastBucketExhaustsTheIterator() { // roaringbitmap/10
+        PeekableLongIterator it = Roaring64Bitmap.bitmapOf(5L, 6L).getLongIterator();
+        it.advanceIfNeeded(1L << 40);
+        assertFalse(it.hasNext());
+    }
+
+    @Test
+    void pinRoaring64LimitIsImplemented() { // roaringbitmap/11
+        assertEquals(1L, Roaring64Bitmap.bitmapOf(5L, 6L).limit(1).getLongCardinality());
+        assertEquals(1L, Roaring64NavigableMap.bitmapOf(5L, 6L).limit(1).getLongCardinality());
+    }
+
+    @Test
+    void pinNavigableMapLastAfterAnAndThatEmptiesABucket() { // roaringbitmap/12
+        Roaring64NavigableMap m = Roaring64NavigableMap.bitmapOf(5L, (1L << 40) + 1);
+        m.and(Roaring64NavigableMap.bitmapOf(5L, (1L << 40) + 2));
+        assertEquals(5L, m.last());
+        assertEquals(Roaring64NavigableMap.bitmapOf(5L), m);
+    }
+
+    @Test
+    void pinSignedNavigableMapStaticsKeepTheSignedOrder() { // roaringbitmap/13
+        Roaring64NavigableMap a = new Roaring64NavigableMap(true);
+        a.addLong(-5L);
+        a.addLong(3L);
+        Roaring64NavigableMap b = new Roaring64NavigableMap(true);
+        b.addLong(-7L);
+        b.addLong(4L);
+        assertArrayEquals(new long[] {-7L, -5L, 3L, 4L}, Roaring64NavigableMap.or(a, b).toArray());
+        Roaring64NavigableMap c = new Roaring64NavigableMap(true);
+        c.addLong(-1L << 32);
+        c.addLong(7L);
+        c.addLong(1L << 32);
+        Roaring64NavigableMap d = new Roaring64NavigableMap(true);
+        d.addLong(-2L << 32);
+        d.addLong(1L << 32);
+        assertEquals(1L, Roaring64NavigableMap.andCardinality(c, d));
+    }
+
+    @Test
+    void pinUncachedNavigableMapRanksUnsigned() { // roaringbitmap/14
+        Roaring64NavigableMap m = new Roaring64NavigableMap(false, false);
+        m.addLong(5L);
+        assertEquals(1L, m.rankLong(-1L));
+    }
+
+    @Test
+    void pinDeserializePortableKeepsTheSignedOrder() throws Exception { // roaringbitmap/15
+        Roaring64NavigableMap a = new Roaring64NavigableMap(true);
+        a.addLong(-5L);
+        a.addLong(3L);
+        ByteArrayOutputStream bos = new ByteArrayOutputStream();
+        a.serializePortable(new DataOutputStream(bos));
+        Roaring64NavigableMap b = new Roaring64NavigableMap(true);
+        b.deserializePortable(new DataInputStream(new ByteArrayInputStream(bos.toByteArray())));
+        assertEquals(-5L, b.first());
+        assertArrayEquals(new long[] {-5L, 3L}, b.toArray());
+    }
+
+    @Test
+    void pinBetweenAboveTheRangeIsEmpty() { // roaringbitmap/16
+        RangeBitmap.Appender ap = RangeBitmap.appender(63);
+        for (int i = 0; i < 5; i++) {
+            ap.add(i * 10);
+        }
+        RangeBitmap rb = ap.build();
+        assertTrue(rb.between(64, 69).isEmpty());
+        assertEquals(0L, rb.betweenCardinality(64, 69));
+    }
+
+    @Test
+    void pinRangeBitmapOfRowsAtTheMaskAnswersQueries() { // roaringbitmap/25
+        RangeBitmap.Appender ap = RangeBitmap.appender(131071);
+        ap.add(131071);
+        RangeBitmap rb = ap.build();
+        assertTrue(rb.lte(0).isEmpty());
+        assertEquals(RoaringBitmap.bitmapOf(0), rb.lte(131071));
+    }
+
+    @Test
+    void pinValidateAcceptsARunSplitByRemove() { // roaringbitmap/26
+        RoaringBitmap b = new RoaringBitmap();
+        b.add(10L, 13L);
+        b.remove(11);
+        assertTrue(b.validate());
+    }
+
+    @Test
+    void pinAppenderRejectsValuesAboveTheMaximum() { // roaringbitmap/17
+        RangeBitmap.Appender ap = RangeBitmap.appender(10);
+        assertThrows(IllegalArgumentException.class, () -> ap.add(11));
+    }
+
+    @Test
+    void pinBuildHonoursTheBufferPosition() { // roaringbitmap/18
+        RangeBitmap.Appender ap = RangeBitmap.appender(100);
+        ap.add(1);
+        ap.add(50);
+        ap.add(100);
+        ByteBuffer buf = ByteBuffer.allocate(ap.serializedSizeInBytes() + 8).order(ByteOrder.LITTLE_ENDIAN);
+        buf.position(4);
+        RangeBitmap rb = ap.build(buf);
+        assertEquals(RoaringBitmap.bitmapOf(0, 1), rb.lte(50));
+    }
+
+    @Test
+    void pinRoaringBitSetInteroperatesWithBitSet() { // roaringbitmap/19
+        RoaringBitSet r = new RoaringBitSet();
+        BitSet b = new BitSet();
+        for (int i : new int[] {3, 64, 1000}) {
+            r.set(i);
+            b.set(i);
+        }
+        assertTrue(r.equals(b), "RoaringBitSet.equals(BitSet with the same bits)");
+        BitSet plain = new BitSet();
+        plain.or(r);
+        assertEquals(b, plain, "BitSet.or(RoaringBitSet)");
+    }
+
+    @Test
+    void pinRoaringBitSetArraysHaveBitSetsLengths() { // roaringbitmap/20
+        RoaringBitSet r = new RoaringBitSet();
+        r.set(3);
+        r.set(64);
+        r.set(1000);
+        assertEquals((r.length() + 7) / 8, r.toByteArray().length);
+        assertEquals((r.length() + 63) / 64, r.toLongArray().length);
+        RoaringBitSet small = new RoaringBitSet();
+        small.set(5);
+        assertEquals(1, small.toLongArray().length);
+    }
+
+    @Test
+    void pinRoaringBitSetToStringUsesBitSetsFormat() { // roaringbitmap/21
+        RoaringBitSet r = new RoaringBitSet();
+        r.set(3);
+        r.set(64);
+        r.set(1000);
+        assertEquals("{3, 64, 1000}", r.toString());
+    }
+
+    @Test
+    void pinPreviousAbsentValueOfNothingIsMinusOneEvenWithTheTopValuePresent() { // roaringbitmap/23 (needs -ea, surefire's default)
+        assertEquals(-1L, RoaringBitmap.bitmapOf(0, 0xFFFFFFFF).previousAbsentValue(0));
+    }
+
+    @Test
+    void pinPreviousSetBitOfMinusOneIsMinusOne() { // roaringbitmap/22
+        RoaringBitSet r = new RoaringBitSet();
+        r.set(7);
+        assertEquals(-1, r.previousSetBit(-1));
+    }
+}
