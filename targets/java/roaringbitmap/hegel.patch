--- /dev/null
+++ b/hegel/pom.xml
@@ -0,0 +1,75 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<!-- Hegel zoo: property-based tests for RoaringBitmap. Upstream builds with Gradle, so this module
+     compiles the library's own sources (../roaringbitmap/src/main/java, minus module-info.java) as
+     its main sources and needs no installed artifact; see targets/java/roaringbitmap in the zoo. -->
+<project xmlns="http://maven.apache.org/POM/4.0.0"
+         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
+         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
+  <modelVersion>4.0.0</modelVersion>
+  <groupId>dev.hegel.zoo</groupId>
+  <artifactId>roaringbitmap-hegel</artifactId>
+  <version>0</version>
+  <packaging>jar</packaging>
+
+  <properties>
+    <maven.compiler.release>22</maven.compiler.release>
+    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
+    <hegel.version>0.6.0</hegel.version>
+    <junit.version>5.11.4</junit.version>
+  </properties>
+
+  <dependencies>
+    <dependency>
+      <groupId>dev.hegel</groupId>
+      <artifactId>hegel</artifactId>
+      <version>${hegel.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.jupiter</groupId>
+      <artifactId>junit-jupiter</artifactId>
+      <version>${junit.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.platform</groupId>
+      <artifactId>junit-platform-launcher</artifactId>
+      <version>1.11.4</version>
+      <scope>test</scope>
+    </dependency>
+  </dependencies>
+
+  <build>
+    <sourceDirectory>${project.basedir}/../roaringbitmap/src/main/java</sourceDirectory>
+    <plugins>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-compiler-plugin</artifactId>
+        <version>3.13.0</version>
+        <configuration>
+          <excludes>
+            <exclude>module-info.java</exclude>
+          </excludes>
+          <showWarnings>false</showWarnings>
+          <compilerArgs>
+            <arg>-Xlint:none</arg>
+          </compilerArgs>
+        </configuration>
+      </plugin>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-surefire-plugin</artifactId>
+        <version>3.5.2</version>
+        <configuration>
+          <argLine>--enable-native-access=ALL-UNNAMED -Xmx1g</argLine>
+          <!-- the library ships a module-info.java; run the tests on the class path so the
+               ZooListener registered in META-INF/services is picked up -->
+          <useModulePath>false</useModulePath>
+          <trimStackTrace>false</trimStackTrace>
+          <!-- every test's `ZOO …` line is what the zoo judges; Maven's exit code is not -->
+          <testFailureIgnore>true</testFailureIgnore>
+        </configuration>
+      </plugin>
+    </plugins>
+  </build>
+</project>
diff --git a/hegel/src/test/java/zoo/RoaringBitmapTest.java b/hegel/src/test/java/zoo/RoaringBitmapTest.java
new file mode 100644
index 0000000..bc3c400
--- /dev/null
+++ b/hegel/src/test/java/zoo/RoaringBitmapTest.java
@@ -0,0 +1,1213 @@
+package zoo;
+
+import static zoo.Zoo.chance;
+import static zoo.Zoo.check;
+import static zoo.Zoo.fail;
+import static zoo.Zoo.n;
+import static zoo.Zoo.pick;
+
+import dev.hegel.Hegel;
+import dev.hegel.TestCase;
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.DataInputStream;
+import java.io.DataOutputStream;
+import java.io.ObjectInputStream;
+import java.io.ObjectOutputStream;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.BitSet;
+import java.util.Comparator;
+import java.util.Iterator;
+import java.util.List;
+import java.util.NavigableSet;
+import java.util.NoSuchElementException;
+import java.util.TreeSet;
+import java.util.function.Function;
+import org.junit.jupiter.api.Test;
+import org.roaringbitmap.BatchIterator;
+import org.roaringbitmap.BitSetUtil;
+import org.roaringbitmap.FastAggregation;
+import org.roaringbitmap.FastRankRoaringBitmap;
+import org.roaringbitmap.IntIterator;
+import org.roaringbitmap.ParallelAggregation;
+import org.roaringbitmap.PeekableIntIterator;
+import org.roaringbitmap.RoaringBitSet;
+import org.roaringbitmap.RoaringBitmap;
+import org.roaringbitmap.RoaringBitmapWriter;
+import org.roaringbitmap.buffer.BufferFastAggregation;
+import org.roaringbitmap.buffer.ImmutableRoaringBitmap;
+import org.roaringbitmap.buffer.MutableRoaringBitmap;
+
+/**
+ * RoaringBitmap (32-bit, unsigned) against a TreeSet of Integers ordered as unsigned values: point
+ * and range mutations, the queries, the iterators, the set algebra (including the buffer classes
+ * and the aggregation helpers), serialization and the BitSet bridge.
+ */
+class RoaringBitmapTest {
+
+    static final Comparator<Integer> UNSIGNED = Integer::compareUnsigned;
+    static final long TOP = 1L << 32;
+
+    static long ul(int x) {
+        return Integer.toUnsignedLong(x);
+    }
+
+    static NavigableSet<Integer> model() {
+        return new TreeSet<>(UNSIGNED);
+    }
+
+    static int[] arr(NavigableSet<Integer> m) {
+        int[] a = new int[m.size()];
+        int i = 0;
+        for (int x : m) {
+            a[i++] = x;
+        }
+        return a;
+    }
+
+    static String ints(int[] a) {
+        return a.length > 40 ? Arrays.toString(Arrays.copyOf(a, 40)) + "… (" + a.length + ")" : Arrays.toString(a);
+    }
+
+    static String uls(int[] a) {
+        StringBuilder sb = new StringBuilder("{");
+        for (int i = 0; i < a.length; i++) {
+            if (i > 0) {
+                sb.append(',');
+            }
+            sb.append(ul(a[i]));
+        }
+        return sb.append('}').toString();
+    }
+
+    /** A 16-bit container key: a few fixed ones (so bitmaps share containers) and random ones. */
+    static int key(TestCase tc) {
+        return chance(tc, 70) ? pick(tc, 0, 1, 2, 0x7fff, 0x8000, 0xfffe, 0xffff) : n(tc, 0, 0xffff);
+    }
+
+    static int value(TestCase tc) {
+        int k = key(tc);
+        int low = chance(tc, 50) ? n(tc, 0, 0xffff) : n(tc, 0, 300);
+        return (k << 16) | low;
+    }
+
+    /** An unsigned range [lo, hi) as longs, hi possibly 2^32, possibly empty. */
+    static long[] range(TestCase tc, boolean allowEmpty) {
+        return range(tc, allowEmpty, Long.MAX_VALUE);
+    }
+
+    /** The same, at most maxLen long (ranges the TreeSet model has to enumerate). */
+    static long[] range(TestCase tc, boolean allowEmpty, long maxLen) {
+        int k = key(tc);
+        long lo = (ul(k << 16)) + n(tc, 0, 0xffff);
+        long len;
+        switch (n(tc, 0, 6)) {
+            case 0: len = n(tc, 0, 3); break;
+            case 1: len = n(tc, 0, 300); break;
+            case 2: len = n(tc, 4000, 9000); break;
+            case 3: len = n(tc, 0, 3) * 65536L + n(tc, 0, 0xffff); break;
+            case 4: len = 65536 - (lo & 0xffff); break;   // to the end of the container
+            case 5: len = TOP - lo; break;                  // to the end of the universe
+            default: len = n(tc, 0, 70000); break;
+        }
+        long hi = Math.min(TOP, lo + len);
+        if (!allowEmpty && hi <= lo) {
+            hi = Math.min(TOP, lo + 1);
+        }
+        if (hi <= lo && !allowEmpty) {
+            lo = hi - 1;
+        }
+        if (hi - lo > maxLen) {
+            hi = lo + maxLen;
+        }
+        return new long[] {lo, hi};
+    }
+
+    static void addRange(NavigableSet<Integer> m, long lo, long hi) {
+        for (long x = lo; x < hi; x++) {
+            m.add((int) x);
+        }
+    }
+
+    static void removeRange(NavigableSet<Integer> m, long lo, long hi) {
+        if (hi <= lo) {
+            return;
+        }
+        m.subSet((int) lo, true, (int) (hi - 1), true).clear();
+    }
+
+    static void flipRange(NavigableSet<Integer> m, long lo, long hi) {
+        for (long x = lo; x < hi; x++) {
+            int v = (int) x;
+            if (!m.remove(v)) {
+                m.add(v);
+            }
+        }
+    }
+
+    /** A bitmap and its model, built from a handful of containers of mixed shapes. */
+    static RoaringBitmap gen(TestCase tc, NavigableSet<Integer> m) {
+        RoaringBitmap rb = new RoaringBitmap();
+        int containers = n(tc, 0, 4);
+        for (int c = 0; c < containers; c++) {
+            int k = key(tc);
+            long base = ul(k << 16);
+            switch (n(tc, 0, 4)) {
+                case 0: { // sparse points
+                    int cnt = n(tc, 1, 40);
+                    for (int i = 0; i < cnt; i++) {
+                        int v = (int) (base + n(tc, 0, 0xffff));
+                        rb.add(v);
+                        m.add(v);
+                    }
+                    break;
+                }
+                case 1: { // one dense block (bitmap container once > 4096 values)
+                    int lo = n(tc, 0, 60000);
+                    int len = n(tc, 1, Math.min(9000, 65536 - lo));
+                    rb.add(base + lo, base + lo + len);
+                    addRange(m, base + lo, base + lo + len);
+                    break;
+                }
+                case 2: { // several short runs
+                    int runs = n(tc, 1, 6);
+                    for (int i = 0; i < runs; i++) {
+                        int lo = n(tc, 0, 65000);
+                        int len = n(tc, 1, Math.min(500, 65536 - lo));
+                        rb.add(base + lo, base + lo + len);
+                        addRange(m, base + lo, base + lo + len);
+                    }
+                    break;
+                }
+                case 3: { // a run with holes
+                    int lo = n(tc, 0, 30000);
+                    int len = n(tc, 1, 6000);
+                    rb.add(base + lo, base + lo + len);
+                    addRange(m, base + lo, base + lo + len);
+                    int holes = n(tc, 1, 20);
+                    for (int i = 0; i < holes; i++) {
+                        int v = (int) (base + lo + n(tc, 0, len - 1));
+                        rb.remove(v);
+                        m.remove(v);
+                    }
+                    break;
+                }
+                default: { // the extremes of the container
+                    for (int v : new int[] {(int) base, (int) (base + 0xffff), (int) (base + 1), (int) (base + 0xfffe)}) {
+                        if (chance(tc, 60)) {
+                            rb.add(v);
+                            m.add(v);
+                        }
+                    }
+                }
+            }
+        }
+        if (chance(tc, 8)) { // a full container
+            int k = key(tc);
+            long base = ul(k << 16);
+            rb.add(base, base + 65536);
+            addRange(m, base, base + 65536);
+        }
+        if (chance(tc, 50)) {
+            rb.runOptimize();
+        } else if (chance(tc, 30)) {
+            rb.removeRunCompression();
+        }
+        return rb;
+    }
+
+    static void same(String what, RoaringBitmap rb, NavigableSet<Integer> m) {
+        int[] got = rb.toArray();
+        int[] want = arr(m);
+        if (!Arrays.equals(got, want)) {
+            fail(what + ": toArray differs from the model: " + diff(got, want));
+        }
+        check(rb.getCardinality() == m.size(), () -> what + ": cardinality " + rb.getCardinality() + " != " + m.size());
+        check(rb.getLongCardinality() == m.size(), () -> what + ": long cardinality");
+        check(rb.isEmpty() == m.isEmpty(), () -> what + ": isEmpty " + rb.isEmpty());
+    }
+
+    static void sameArr(String what, int[] got, int[] want) {
+        if (!Arrays.equals(got, want)) {
+            fail(what + ": " + diff(got, want));
+        }
+    }
+
+    /** Whether m holds all 65536 values of some container with key >= key. */
+    static boolean hasFullContainerAtOrAbove(NavigableSet<Integer> m, long key) {
+        long current = -1, count = 0;
+        for (int x : m.tailSet((int) (key << 16), true)) {
+            long k = ul(x) >>> 16;
+            if (k != current) {
+                current = k;
+                count = 0;
+            }
+            if (++count == 65536) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    static String diff(int[] got, int[] want) {
+        NavigableSet<Integer> g = model(), w = model();
+        for (int x : got) {
+            g.add(x);
+        }
+        for (int x : want) {
+            w.add(x);
+        }
+        List<Long> extra = new ArrayList<>(), missing = new ArrayList<>();
+        for (int x : g) {
+            if (!w.contains(x)) {
+                extra.add(ul(x));
+            }
+        }
+        for (int x : w) {
+            if (!g.contains(x)) {
+                missing.add(ul(x));
+            }
+        }
+        int[] sorted = arr(g);
+        String order = Arrays.equals(got, sorted) ? "" : "; got is not in unsigned order or has duplicates (" + uls(Arrays.copyOf(got, Math.min(got.length, 12))) + ")";
+        return "got " + got.length + " values, want " + want.length + "; extra " + head(extra) + ", missing " + head(missing) + order;
+    }
+
+    static String head(List<Long> l) {
+        return l.size() > 12 ? l.subList(0, 12) + "… (" + l.size() + ")" : l.toString();
+    }
+
+    static int[] arrOf(Iterable<Integer> it) {
+        List<Integer> l = new ArrayList<>();
+        for (int x : it) {
+            l.add(x);
+        }
+        int[] a = new int[l.size()];
+        for (int i = 0; i < a.length; i++) {
+            a[i] = l.get(i);
+        }
+        return a;
+    }
+
+    static int[] drain(IntIterator it) {
+        List<Integer> l = new ArrayList<>();
+        int guard = 0;
+        while (it.hasNext()) {
+            l.add(it.next());
+            if (++guard > 400000) {
+                fail("iterator does not end");
+                break;
+            }
+        }
+        int[] a = new int[l.size()];
+        for (int i = 0; i < a.length; i++) {
+            a[i] = l.get(i);
+        }
+        return a;
+    }
+
+    static int[] reversed(int[] a) {
+        int[] r = new int[a.length];
+        for (int i = 0; i < a.length; i++) {
+            r[i] = a[a.length - 1 - i];
+        }
+        return r;
+    }
+
+    static long countIn(NavigableSet<Integer> m, long lo, long hi) {
+        if (hi <= lo) {
+            return 0;
+        }
+        return m.subSet((int) lo, true, (int) (hi - 1), true).size();
+    }
+
+    // ---------------------------------------------------------------------------------------------
+
+    @Test
+    void mutationsAndQueriesMatchAnUnsignedSetModel() {
+        Hegel.test(tc -> {
+            NavigableSet<Integer> m = model();
+            RoaringBitmap rb = gen(tc, m);
+            int ops = n(tc, 0, 12);
+            for (int i = 0; i < ops; i++) {
+                int op = n(tc, 0, 15);
+                switch (op) {
+                    case 0: { int v = value(tc); rb.add(v); m.add(v); break; }
+                    case 1: { int v = value(tc); rb.remove(v); m.remove(v); break; }
+                    case 2: { int v = chance(tc, 50) && !m.isEmpty() ? pickFrom(tc, m) : value(tc); rb.flip(v); if (!m.remove(v)) { m.add(v); } break; }
+                    case 3: {
+                        int v = chance(tc, 50) && !m.isEmpty() ? pickFrom(tc, m) : value(tc);
+                        boolean want = !m.contains(v);
+                        boolean got = rb.checkedAdd(v);
+                        m.add(v);
+                        check(got == want, () -> "checkedAdd(" + ul(v) + ") returned " + got + ", element was " + (want ? "absent" : "present"));
+                        break;
+                    }
+                    case 4: {
+                        int v = chance(tc, 50) && !m.isEmpty() ? pickFrom(tc, m) : value(tc);
+                        boolean want = m.contains(v);
+                        boolean got = rb.checkedRemove(v);
+                        m.remove(v);
+                        check(got == want, () -> "checkedRemove(" + ul(v) + ") returned " + got + ", element was " + (want ? "present" : "absent"));
+                        break;
+                    }
+                    case 5: { long[] r = range(tc, true, 20000); rb.add(r[0], r[1]); addRange(m, r[0], r[1]); break; }
+                    case 6: { long[] r = range(tc, true); rb.remove(r[0], r[1]); removeRange(m, r[0], r[1]); break; }
+                    case 7: { long[] r = range(tc, true, 20000); if (r[1] - r[0] <= 70000) { rb.flip(r[0], r[1]); flipRange(m, r[0], r[1]); } break; }
+                    case 8: {
+                        long[] r = range(tc, true, 20000);
+                        RoaringBitmap before = rb.clone();
+                        RoaringBitmap res = RoaringBitmap.add(rb, r[0], r[1]);
+                        check(rb.equals(before), () -> "static add modified its argument");
+                        rb = res;
+                        addRange(m, r[0], r[1]);
+                        break;
+                    }
+                    case 9: {
+                        long[] r = range(tc, true);
+                        RoaringBitmap before = rb.clone();
+                        RoaringBitmap res = RoaringBitmap.remove(rb, r[0], r[1]);
+                        check(rb.equals(before), () -> "static remove modified its argument");
+                        rb = res;
+                        removeRange(m, r[0], r[1]);
+                        break;
+                    }
+                    case 10: {
+                        long[] r = range(tc, true, 20000);
+                        if (r[1] - r[0] <= 70000) {
+                            RoaringBitmap before = rb.clone();
+                            RoaringBitmap res = RoaringBitmap.flip(rb, r[0], r[1]);
+                            check(rb.equals(before), () -> "static flip modified its argument");
+                            rb = res;
+                            flipRange(m, r[0], r[1]);
+                        }
+                        break;
+                    }
+                    case 11: {
+                        int cnt = n(tc, 0, 6);
+                        int[] vs = new int[cnt + n(tc, 0, 2)];
+                        for (int j = 0; j < vs.length; j++) {
+                            vs[j] = value(tc);
+                        }
+                        int off = n(tc, 0, vs.length - cnt);
+                        if (chance(tc, 50)) {
+                            rb.addN(vs, off, cnt);
+                            for (int j = off; j < off + cnt; j++) {
+                                m.add(vs[j]);
+                            }
+                        } else {
+                            rb.add(vs);
+                            for (int v : vs) {
+                                m.add(v);
+                            }
+                        }
+                        break;
+                    }
+                    case 12: rb.runOptimize(); break;
+                    case 13: rb.removeRunCompression(); break;
+                    case 14: rb = rb.clone(); rb.trim(); break;
+                    default: {
+                        NavigableSet<Integer> m2 = model();
+                        RoaringBitmap other = gen(tc, m2);
+                        rb.or(other);
+                        m.addAll(m2);
+                    }
+                }
+            }
+            final RoaringBitmap b = rb;
+            same("after mutations", b, m);
+            int[] want = arr(m);
+
+            // iterators
+            sameArr("getIntIterator", drain(b.getIntIterator()), want);
+            sameArr("getReverseIntIterator", drain(b.getReverseIntIterator()), reversed(want));
+            sameArr("iterator()", arrOf(b), want);
+            int[] signed = want.clone();
+            Arrays.sort(signed);
+            sameArr("getSignedIntIterator", drain(b.getSignedIntIterator()), signed);
+            sameArr("stream()", b.stream().toArray(), want);
+            boolean runawayShape = m.contains(0x7FFFFFFF) && !m.contains(0x7FFFFFFE);
+            if (!(b.hasRunCompression() && (!sub(m, 0x80000000L, 0x80010000L).isEmpty() || runawayShape))) {
+                List<Integer> fe = new ArrayList<>();
+                try {
+                    b.forEach((org.roaringbitmap.IntConsumer) x -> {
+                        if (fe.size() > 2 * want.length + 100) {
+                            throw new IllegalStateException("forEach emits far more values than the cardinality " + want.length + ": " + diff(arrOf(fe), want) + "; containers " + containers(b) + "; first emitted " + uls(arrOf(fe.subList(0, 12))));
+                        }
+                        fe.add(x);
+                    });
+                    sameArr("forEach", arrOf(fe), want);
+                } catch (IllegalStateException e) {
+                    fail(e.getMessage());
+                }
+            }
+            int bufSize = pick(tc, 1, 2, 3, 7, 64, 256, 1024);
+            int[] buf = new int[bufSize];
+            List<Integer> batched = new ArrayList<>();
+            BatchIterator bi = b.getBatchIterator();
+            int guard = 0;
+            while (bi.hasNext()) {
+                int cnt = bi.nextBatch(buf);
+                check(cnt > 0 && cnt <= bufSize, () -> "nextBatch returned " + cnt + " for a buffer of " + bufSize);
+                for (int j = 0; j < cnt; j++) {
+                    batched.add(buf[j]);
+                }
+                if (++guard > 500000) {
+                    fail("batch iterator does not end");
+                    break;
+                }
+            }
+            sameArr("batch iterator (buffer " + bufSize + ")", arrOf(batched), want);
+
+            // scalar queries
+            check(b.cardinalityExceeds(m.size()) == false && (m.isEmpty() || b.cardinalityExceeds(m.size() - 1)),
+                    () -> "cardinalityExceeds around the cardinality " + m.size());
+            if (m.isEmpty()) {
+                try {
+                    int f = b.first();
+                    fail("first() of an empty bitmap returned " + f);
+                } catch (NoSuchElementException e) {
+                    // documented
+                }
+            } else {
+                check(b.first() == m.first(), () -> "first " + ul(b.first()) + " != " + ul(m.first()));
+                check(b.last() == m.last(), () -> "last " + ul(b.last()) + " != " + ul(m.last()));
+                check(b.firstSigned() == signed[0], () -> "firstSigned " + b.firstSigned() + " != " + signed[0]);
+                check(b.lastSigned() == signed[signed.length - 1], () -> "lastSigned " + b.lastSigned() + " != " + signed[signed.length - 1]);
+                check(b.getContainerCount() == m.stream().map(x -> x >>> 16).distinct().count(),
+                        () -> "getContainerCount " + b.getContainerCount());
+            }
+            for (int q = 0; q < 12; q++) {
+                int x;
+                if (!m.isEmpty() && chance(tc, 50)) {
+                    x = pickFrom(tc, m) + n(tc, -1, 1);
+                } else if (chance(tc, 30)) {
+                    x = pick(tc, 0, 1, -1, -2, Integer.MAX_VALUE, Integer.MIN_VALUE, 0xffff, 0x10000);
+                } else {
+                    x = value(tc);
+                }
+                final int fx = x;
+                check(b.contains(x) == m.contains(x), () -> "contains(" + ul(fx) + ") " + b.contains(fx));
+                long rank = m.headSet(x, true).size();
+                check(b.rank(x) == rank, () -> "rank(" + ul(fx) + ") " + b.rank(fx) + " != " + rank);
+                check(b.rankLong(x) == rank, () -> "rankLong(" + ul(fx) + ") " + b.rankLong(fx) + " != " + rank);
+                Integer ceil = m.ceiling(x);
+                long nv = ceil == null ? -1 : ul(ceil);
+                check(b.nextValue(x) == nv, () -> "nextValue(" + ul(fx) + ") " + b.nextValue(fx) + " != " + nv);
+                Integer floor = m.floor(x);
+                long pv = floor == null ? -1 : ul(floor);
+                check(b.previousValue(x) == pv, () -> "previousValue(" + ul(fx) + ") " + b.previousValue(fx) + " != " + pv);
+                boolean signBoundary = x >= 0 && ceil != null && ceil < 0 && (ceil >>> 16) != (x >>> 16);
+                if (!signBoundary) {
+                    long na = ul(x);
+                    while (na < TOP && m.contains((int) na)) {
+                        na++;
+                    }
+                    long nav = na == TOP ? -1 : na;
+                    check(b.nextAbsentValue(x) == nav, () -> "nextAbsentValue(" + ul(fx) + ") " + b.nextAbsentValue(fx) + " != " + nav);
+                    long pa = ul(x);
+                    while (pa >= 0 && m.contains((int) pa)) {
+                        pa--;
+                    }
+                    final long pav = pa;
+                    if (!(pav == -1 && m.contains(-1))) { // bug: the library's own assertion rejects -1 when 0xFFFFFFFF is present
+                        try {
+                        check(b.previousAbsentValue(x) == pav, () -> "previousAbsentValue(" + ul(fx) + ") " + b.previousAbsentValue(fx) + " != " + pav);
+                    } catch (AssertionError e) {
+                        fail("previousAbsentValue(" + ul(fx) + ") failed the library's own assertion (" + e + "), expected " + pav + "; containers " + containers(b) + "; values " + uls(Arrays.copyOf(want, Math.min(want.length, 30))));
+                    }
+                    }
+                }
+                PeekableIntIterator pi = b.getIntIterator();
+                pi.advanceIfNeeded(x);
+                if (ceil == null) {
+                    check(!pi.hasNext(), () -> "advanceIfNeeded(" + ul(fx) + ") left values although none >= it");
+                } else {
+                    check(pi.hasNext() && pi.peekNext() == ceil, () -> "advanceIfNeeded(" + ul(fx) + ") peekNext " + (pi.hasNext() ? ul(pi.peekNext()) + "" : "none") + " != " + ul(ceil));
+                }
+                PeekableIntIterator ri = b.getReverseIntIterator();
+                ri.advanceIfNeeded(x);
+                if (floor == null) {
+                    check(!ri.hasNext(), () -> "reverse advanceIfNeeded(" + ul(fx) + ") left values although none <= it");
