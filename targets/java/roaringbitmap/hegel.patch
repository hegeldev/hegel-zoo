+    /** Bug roaringbitmap/6: horizontal_xor leaves an empty container where a key's containers cancel out. */
+    static boolean cancels(NavigableSet<Integer> allOr, NavigableSet<Integer> allXor) {
+        NavigableSet<Integer> unionKeys = new TreeSet<>(), xorKeys = new TreeSet<>();
+        for (int x : allOr) {
+            unionKeys.add(x >>> 16);
+        }
+        for (int x : allXor) {
+            xorKeys.add(x >>> 16);
+        }
+        return !unionKeys.equals(xorKeys);
+    }
