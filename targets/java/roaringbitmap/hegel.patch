+    /** Bugs roaringbitmap/5 and /24: orNot with the other bitmap's values beyond the end in the last container this one lacks, or a full container of it at or beyond the last key. */
+    static boolean orNotBug(NavigableSet<Integer> ma, NavigableSet<Integer> mb, long end) {
+        long lastContainerEnd = end > 0 ? (((end - 1) >>> 16) + 1) << 16 : 0;
+        return end > 0 && (countIn(mb, end, lastContainerEnd) > 0 && countIn(ma, lastContainerEnd - 65536, lastContainerEnd) == 0
