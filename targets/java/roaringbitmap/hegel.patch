+    /** An input order for the constructors: a stable sort of the sorted values by the keys, cycled over the positions (no keys: the sorted order). */
+    record Shuffle(List<Integer> keys) {
+        int[] apply(int[] sorted) {
+            if (keys.isEmpty()) {
+                return sorted.clone();
+            }
+            Integer[] idx = new Integer[sorted.length];
+            for (int i = 0; i < idx.length; i++) {
+                idx[i] = i;
+            }
+            Arrays.sort(idx, Comparator.comparingInt(i -> keys.get(i % keys.size())));
+            int[] out = new int[sorted.length];
+            for (int i = 0; i < out.length; i++) {
+                out[i] = sorted[idx[i]];
+            }
+            return out;
+        }
+    }
+
+    static final Generator<Shuffle> SHUFFLE = lists(ints(0, 9)).maxSize(16).map(Shuffle::new);
+
+    /** A RoaringBitmapWriter configuration; the radix-sorting ones take unsorted data. */
+    enum WriterConfig {
+        DEFAULT(w -> w),
+        ARRAYS(w -> w.optimiseForArrays()),
+        RUNS(w -> w.optimiseForRuns()),
+        CONSTANT_MEMORY(w -> w.constantMemory()),
+        NO_RUN_COMPRESSION(w -> w.runCompress(false)),
+        RADIX_SORT(w -> w.doPartialRadixSort()),
+        CONSTANT_MEMORY_RADIX_SORT(w -> w.constantMemory().doPartialRadixSort()),
+        EXPECTED_RANGE(w -> w.expectedRange(0, 1L << 31).expectedDensity(0.1)),
+        INITIAL_CAPACITY(w -> w.initialCapacity(1).expectedValuesPerContainer(3));
+
+        final Function<RoaringBitmapWriter.Wizard<?, RoaringBitmap>, RoaringBitmapWriter.Wizard<?, RoaringBitmap>> configure;
+
+        WriterConfig(Function<RoaringBitmapWriter.Wizard<?, RoaringBitmap>, RoaringBitmapWriter.Wizard<?, RoaringBitmap>> configure) {
+            this.configure = configure;
+        }
+
+        boolean unordered() {
+            return this == RADIX_SORT || this == CONSTANT_MEMORY_RADIX_SORT;
+        }
+    }
