+                Roaring64NavigableMap x1 = (Roaring64NavigableMap) b.bitmap(), x2 = (Roaring64NavigableMap) o.bitmap();
+                Roaring64NavigableMap before1 = x1.clone(), before2 = x2.clone();
+                if (!b.signed()) {
+                    same("and", wrap(Roaring64NavigableMap.and(x1, x2), b.signed()), mAnd);
+                    same("or", wrap(Roaring64NavigableMap.or(x1, x2), b.signed()), mOr);
+                    same("andNot", wrap(Roaring64NavigableMap.andNot(x1, x2), b.signed()), mAndNot);
+                }
+                if (!b.signed()) {
+                    check(Roaring64NavigableMap.andCardinality(x1, x2) == mAnd.size(), () -> b.name() + " andCardinality " + Roaring64NavigableMap.andCardinality(x1, x2) + " != " + mAnd.size());
+                    check(Roaring64NavigableMap.intersects(x1, x2) == !mAnd.isEmpty(), () -> b.name() + " intersects " + Roaring64NavigableMap.intersects(x1, x2));
+                }
+                check(x1.equals(before1) && x2.equals(before2), () -> b.name() + " static operations modified an operand");
+                Roaring64NavigableMap c;
+                c = x1.clone(); c.and(x2); same("in-place and", wrap(c, b.signed()), mAnd);
+                c = x1.clone(); c.or(x2); same("in-place or", wrap(c, b.signed()), mOr);
+                c = x1.clone(); c.xor(x2); same("in-place xor", wrap(c, b.signed()), mXor);
+                c = x1.clone(); c.andNot(x2); same("in-place andNot", wrap(c, b.signed()), mAndNot);
+                c = x1.clone(); c.naivelazyor(x2); c.repairAfterLazy(); same("naivelazyor + repairAfterLazy", wrap(c, b.signed()), mOr);
+            }
+            boolean signedRendering = b.signed() || b.bitmap() instanceof Roaring64Bitmap;
+            check(b.bitmap().toString().equals(longs(want, signedRendering).replace(",… (" + want.length + ")", "")) || want.length > 40,
+                    () -> b.name() + " toString " + cut(b.bitmap().toString()) + " != " + longs(want, signedRendering));
+        }, Zoo.settings("sixtyFourBitBitmapsTrackATreeSetOfLongs"));
+    }
+
+    static String cut(String s) {
+        return s.length() > 160 ? s.substring(0, 160) + "…" : s;
+    }
+
+    // ---------------------------------------------------------------------------------------------
+
+    static RoaringBitmap rows(long[] values, java.util.function.LongPredicate p, RoaringBitmap context) {
+        RoaringBitmap r = new RoaringBitmap();
+        for (int i = 0; i < values.length; i++) {
+            if (p.test(values[i]) && (context == null || context.contains(i))) {
+                r.add(i);
+            }
+        }
+        return r;
+    }
+
+    static void sameRows(String what, RoaringBitmap got, RoaringBitmap want) {
+        if (!got.equals(want)) {
+            fail(what + ": " + cut(got.toString()) + " != " + cut(want.toString()));
+        }
+    }
+
+    @Test
+    void rangeBitmapQueriesMatchAScan() {
+        Hegel.test(tc -> {
+            int bits = n(tc, 0, 62);
+            long maxValue = bits == 0 ? pick(tc, 0L, 1L) : chance(tc, 50) ? (1L << bits) - 1 : n(tc, 0, Integer.MAX_VALUE) | (1L << bits);
+            if (chance(tc, 10)) {
+                maxValue = Long.MAX_VALUE;
+            }
+            final long max = maxValue;
+            int count = chance(tc, 20) ? n(tc, 0, 3) : n(tc, 0, 400);
+            long[] values = new long[count];
+            for (int i = 0; i < count; i++) {
+                switch (n(tc, 0, 4)) {
+                    case 0: values[i] = 0; break;
+                    case 1: values[i] = max; break;
+                    case 2: values[i] = Math.min(max, n(tc, 0, 10)); break;
+                    case 3: values[i] = Math.max(0, max - n(tc, 0, 10)); break;
+                    default: values[i] = max <= Integer.MAX_VALUE ? n(tc, 0, (int) max) : (((long) n(tc, 0, Integer.MAX_VALUE) << 31) | n(tc, 0, Integer.MAX_VALUE)) % (max + 1 == Long.MIN_VALUE ? Long.MAX_VALUE : max + 1);
+                }
+            }
+            RangeBitmap.Appender ap = RangeBitmap.appender(max);
+            for (long v : values) {
+                ap.add(v);
+            }
+            long nextPow = max == Long.MAX_VALUE ? -1 : Long.highestOneBit(max | 1) << 1; // the first power of two above max
+            if (max < Long.MAX_VALUE && nextPow > 0) {
+                RangeBitmap.Appender probe = RangeBitmap.appender(max);
+                try {
+                    probe.add(nextPow);
+                    fail("appender(" + max + ").add(" + nextPow + ") accepted");
+                } catch (IllegalArgumentException e) {
+                    // documented
+                }
+            }
+            RangeBitmap rb;
+            int variant = n(tc, 0, 2);
+            if (variant == 0) {
+                rb = ap.build();
+            } else if (variant == 1) {
+                int size = ap.serializedSizeInBytes();
+                ByteBuffer ser = ByteBuffer.allocate(size).order(ByteOrder.LITTLE_ENDIAN);
+                ap.serialize(ser);
+                check(ser.position() == size, () -> "Appender.serialize advanced the position by " + ser.position() + ", serializedSizeInBytes " + size);
+                ser.flip();
+                rb = RangeBitmap.map(ser);
+            } else {
+                int size = ap.serializedSizeInBytes();
+                ByteBuffer target = ByteBuffer.allocate(size + 16).order(ByteOrder.LITTLE_ENDIAN);
+                rb = ap.build(target);
+            }
+            final RangeBitmap range = rb;
+            long rangeMask = max == Long.MAX_VALUE || max == -1 ? max : Long.highestOneBit(max | 1) * 2 - 1;
+            int bytesPerMask = (64 - Long.numberOfLeadingZeros(rangeMask) + 7) / 8;
+            boolean allMask = count > 0 && Arrays.stream(values).allMatch(v -> v == rangeMask);
+            if (allMask && (bytesPerMask == 3 || bytesPerMask >= 5 && bytesPerMask <= 7)) {
+                return;
+            }
+            RoaringBitmap all = new RoaringBitmap();
+            all.add(0L, count);
+            RoaringBitmap context = null;
+            if (chance(tc, 50)) {
+                context = new RoaringBitmap();
+                for (int i = 0; i < count; i++) {
+                    if (chance(tc, 50)) {
+                        context.add(i);
+                    }
+                }
+            }
+            final RoaringBitmap ctx = context;
+            RoaringBitmap ctxIn = ctx == null ? null : RoaringBitmap.and(ctx, all);
+            for (int q = 0; q < 8; q++) {
+                long t;
+                switch (n(tc, 0, 5)) {
+                    case 0: t = 0; break;
+                    case 1: t = max; break;
+                    case 2: t = count > 0 ? values[n(tc, 0, count - 1)] + n(tc, -1, 1) : n(tc, 0, 10); break;
+                    case 3: t = max == Long.MAX_VALUE ? Long.MAX_VALUE : max + n(tc, 1, 3); break;
+                    case 4: t = Long.MAX_VALUE; break;
+                    default: t = max <= Integer.MAX_VALUE ? n(tc, 0, (int) max) : ((long) n(tc, 0, Integer.MAX_VALUE) << 20) % (max + 1);
+                }
+                if (t < 0) {
+                    t = 0;
+                }
+                final long th = t;
+                String tag = "(max " + max + ", " + count + " rows, threshold " + th + (ctx == null ? "" : ", with context") + ")";
+                try {
+                    sameRows("lte " + tag, ctx == null ? range.lte(th) : range.lte(th, ctx), rows(values, v -> v <= th, ctxIn));
+                    sameRows("lt " + tag, ctx == null ? range.lt(th) : range.lt(th, ctx), rows(values, v -> v < th, ctxIn));
+                    sameRows("gte " + tag, ctx == null ? range.gte(th) : range.gte(th, ctx), rows(values, v -> v >= th, ctxIn));
+                    sameRows("gt " + tag, ctx == null ? range.gt(th) : range.gt(th, ctx), rows(values, v -> v > th, ctxIn));
+                    sameRows("eq " + tag, ctx == null ? range.eq(th) : range.eq(th, ctx), rows(values, v -> v == th, ctxIn));
+                    sameRows("neq " + tag, ctx == null ? range.neq(th) : range.neq(th, ctx), rows(values, v -> v != th, ctxIn));
+                } catch (IndexOutOfBoundsException e) {
+                    fail("range query threw " + e + " " + tag + ", variant " + variant + ", serialized size " + ap.serializedSizeInBytes() + ", values " + Arrays.toString(Arrays.copyOf(values, Math.min(count, 12))));
+                }
+                check((ctx == null ? range.lteCardinality(th) : range.lteCardinality(th, ctx)) == rows(values, v -> v <= th, ctxIn).getCardinality(), () -> "lteCardinality " + tag);
+                check((ctx == null ? range.ltCardinality(th) : range.ltCardinality(th, ctx)) == rows(values, v -> v < th, ctxIn).getCardinality(), () -> "ltCardinality " + tag);
+                check((ctx == null ? range.gteCardinality(th) : range.gteCardinality(th, ctx)) == rows(values, v -> v >= th, ctxIn).getCardinality(), () -> "gteCardinality " + tag);
+                check((ctx == null ? range.gtCardinality(th) : range.gtCardinality(th, ctx)) == rows(values, v -> v > th, ctxIn).getCardinality(), () -> "gtCardinality " + tag);
+                check((ctx == null ? range.eqCardinality(th) : range.eqCardinality(th, ctx)) == rows(values, v -> v == th, ctxIn).getCardinality(), () -> "eqCardinality " + tag);
+                check((ctx == null ? range.neqCardinality(th) : range.neqCardinality(th, ctx)) == rows(values, v -> v != th, ctxIn).getCardinality(), () -> "neqCardinality " + tag);
+                long lo = th, hi;
+                switch (n(tc, 0, 3)) {
+                    case 0: hi = th; break;
+                    case 1: hi = th + n(tc, 0, 5); break;
+                    case 2: hi = max == Long.MAX_VALUE ? Long.MAX_VALUE : Math.min(Long.MAX_VALUE, max + n(tc, 0, 2)); break;
+                    default: hi = count > 0 ? values[n(tc, 0, count - 1)] : 0;
+                }
+                if (hi < lo) {
+                    long s = lo;
+                    lo = hi;
+                    hi = s;
+                }
+                if (chance(tc, 15) && lo > 0) {
+                    hi = lo - 1; // an empty interval
+                }
+                final long flo = lo, fhi = hi;
+                long mask = max == Long.MAX_VALUE ? Long.MAX_VALUE : (Long.highestOneBit(max | 1) << 1) - 1;
+                if (flo > mask) {
+                    continue; // bug: between(min, max) with min above the range is lte(max)
+                }
+                String btag = "(max " + max + ", " + count + " rows, [" + flo + ", " + fhi + "]" + (ctx == null ? "" : ", with context") + ")";
+                sameRows("between " + btag, ctx == null ? range.between(flo, fhi) : range.between(flo, fhi, ctx), rows(values, v -> v >= flo && v <= fhi, ctxIn));
+                check((ctx == null ? range.betweenCardinality(flo, fhi) : range.betweenCardinality(flo, fhi, ctx)) == rows(values, v -> v >= flo && v <= fhi, ctxIn).getCardinality(), () -> "betweenCardinality " + btag);
+            }
+            if (variant == 0 && count > 0) {
+                // the serialized form answers the same
+                RangeBitmap.Appender ap2 = RangeBitmap.appender(max);
+                for (long v : values) {
+                    ap2.add(v);
+                }
+                ByteBuffer buf = ByteBuffer.allocate(ap2.serializedSizeInBytes()).order(ByteOrder.LITTLE_ENDIAN);
+                ap2.serialize(buf);
+                buf.flip();
+                RangeBitmap mapped = RangeBitmap.map(buf);
+                long t = values[n(tc, 0, count - 1)];
+                sameRows("mapped lte " + t, mapped.lte(t), range.lte(t));
+                sameRows("mapped gt " + t, mapped.gt(t), range.gt(t));
+                ap2.clear();
+                ap2.add(Math.min(max, 1));
+                RangeBitmap again = ap2.build();
+                sameRows("appender reused after clear", again.lte(max), RoaringBitmap.bitmapOf(0));
+            }
+        }, Zoo.settings("rangeBitmapQueriesMatchAScan"));
+    }
+}
diff --git a/hegel/src/test/java/zoo/RoaringPinsTest.java b/hegel/src/test/java/zoo/RoaringPinsTest.java
