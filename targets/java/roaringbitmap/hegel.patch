+    static long orNotCard(NavigableSet<Integer> ma, NavigableSet<Integer> mb, NavigableSet<Integer> mAnd, long end) {
+        // |A ∪ ([0,end) \ B)| = |A| + (end - |B ∩ [0,end)|) - |A ∩ [0,end) \ B|
