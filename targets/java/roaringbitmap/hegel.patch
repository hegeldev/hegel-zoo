+        }
+    }
+
+    static long[] drain(LongIterator it) {
+        List<Long> l = new ArrayList<>();
+        int guard = 0;
+        while (it.hasNext()) {
+            l.add(it.next());
+            if (++guard > 500000) {
+                fail("long iterator does not end");
+                break;
+            }
+        }
+        long[] a = new long[l.size()];
+        for (int i = 0; i < a.length; i++) {
+            a[i] = l.get(i);
+        }
+        return a;
+    }
+
+    static long[] reversed(long[] a) {
+        long[] r = new long[a.length];
+        for (int i = 0; i < a.length; i++) {
+            r[i] = a[a.length - 1 - i];
+        }
+        return r;
+    }
+
+    static void same(String what, Impl b, NavigableSet<Long> m) {
+        long[] got = b.toArray();
+        long[] want = arr(m);
+        if (!Arrays.equals(got, want)) {
+            fail(b.name() + " " + what + ": toArray " + longs(got, b.signed()) + " != model " + longs(want, b.signed()));
+        }
+        check(b.cardinality() == m.size(), () -> b.name() + " " + what + ": cardinality " + b.cardinality() + " != " + m.size());
+        check(b.isEmpty() == m.isEmpty(), () -> b.name() + " " + what + ": isEmpty " + b.isEmpty());
+    }
+
+    static void addRange(NavigableSet<Long> m, long lo, long hi) {
+        for (long x = lo; Long.compareUnsigned(x, hi) < 0; x++) {
+            m.add(x);
+        }
+    }
+
+    // ------------------------------------------------------------------------------ 1. the 64-bit bitmaps
+
+    /** A mutation of the 64-bit bitmap and its model. */
+    sealed interface Op permits Add, Remove, Flip, AddRange, AddMany, RunOptimize, FlipRange, AddInt {}
+
+    record Add(long v) implements Op {}
+
+    /** removeLong of a fresh value, or (60%) one of the bitmap's own. */
+    record Remove(Near at) implements Op {}
+
+    /** flip of a fresh value, or (50%) one of the bitmap's own. */
+    record Flip(Near at) implements Op {}
+
+    /** addRange(lo, hi); a no-op when the range is empty or, for a signed map, crosses the sign boundary (rejected by design). */
+    record AddRange(Range range) implements Op {}
+
+    record AddMany(List<Long> values) implements Op {}
+
+    record RunOptimize() implements Op {}
+
+    /** Roaring64Bitmap only: flip(lo, hi), when at most 70000 long. */
+    record FlipRange(Range range) implements Op {}
+
+    record AddInt(int v) implements Op {}
+
+    static final Generator<Integer> ANY_INT = ints(Integer.MIN_VALUE, Integer.MAX_VALUE);
+
+    /** The operations of a kind: two in sixteen each add a value, remove, flip, add a range, add several, run-optimise; Roaring64Bitmap splits the last two between a range flip and addInt. */
+    static Generator<Op> op(Kind kind) {
+        List<Gen.Choice<Op>> choices = new ArrayList<>(List.of(
+            w(4, VALUE.<Op>map(Add::new)),
+            w(2, near(60).<Op>map(Remove::new)),
+            w(2, near(50).<Op>map(Flip::new)),
+            w(2, RANGE.<Op>map(AddRange::new)),
+            w(2, lists(VALUE).maxSize(5).<Op>map(AddMany::new)),
+            w(2, Generators.<Op>just(new RunOptimize()))));
+        if (kind == Kind.ROARING64) {
+            choices.add(w(1, RANGE.<Op>map(FlipRange::new)));
+            choices.add(w(1, ANY_INT.<Op>map(AddInt::new)));
+        } else {
+            choices.add(w(2, ANY_INT.<Op>map(AddInt::new)));
+        }
+        return weighted(choices);
+    }
+
+    static void apply(Op op, Impl b, NavigableSet<Long> m) {
+        switch (op) {
+            case Add x -> {
+                b.add(x.v());
+                m.add(x.v());
+            }
+            case Remove x -> {
+                long v = x.at().at(m);
+                b.remove(v);
+                m.remove(v);
+            }
+            case Flip x -> {
+                long v = x.at().at(m);
+                b.flip(v);
+                if (!m.remove(v)) {
+                    m.add(v);
+                }
+            }
+            case AddRange x -> {
+                long lo = x.range().lo(), hi = x.range().hi();
+                if (lo != hi && !(b.signed() && (lo < 0) != (hi < 0))) {
+                    b.addRange(lo, hi);
+                    addRange(m, lo, hi);
+                }
+            }
+            case AddMany x -> {
+                long[] vs = x.values().stream().mapToLong(Long::longValue).toArray();
+                m.addAll(x.values());
+                if (b.bitmap() instanceof Roaring64Bitmap rb) {
+                    rb.add(vs);
+                } else {
+                    ((Roaring64NavigableMap) b.bitmap()).add(vs);
+                }
+            }
+            case RunOptimize x -> {
+                if (b.bitmap() instanceof Roaring64Bitmap rb) {
+                    rb.runOptimize();
+                } else {
+                    ((Roaring64NavigableMap) b.bitmap()).runOptimize();
+                }
+            }
+            case FlipRange x -> {
+                long lo = x.range().lo(), hi = x.range().hi();
+                if (b.bitmap() instanceof Roaring64Bitmap rb && Long.compareUnsigned(hi - lo, 70000) <= 0) {
+                    rb.flip(lo, hi);
+                    for (long v = lo; Long.compareUnsigned(v, hi) < 0; v++) {
+                        if (!m.remove(v)) {
+                            m.add(v);
+                        }
+                    }
+                }
+            }
+            case AddInt x -> {
+                if (b.bitmap() instanceof Roaring64Bitmap rb) {
+                    rb.addInt(x.v());
+                } else {
+                    ((Roaring64NavigableMap) b.bitmap()).addInt(x.v());
+                }
+                m.add(Integer.toUnsignedLong(x.v()));
+            }
+        }
+    }
+
+    /** A second bitmap of the same kind: up to six values (40% from the first's model) and a range 40% of the time. */
+    record Other(List<Near> values, Range range) {}
+
+    static final Generator<Other> OTHER = tuples(lists(near(40)).maxSize(6), maybe(40, (Range) null, RANGE)).map(t -> new Other(t.value1(), t.value2()));
+
+    /** The class, up to fourteen operations, ten query points, five ranks to select (modulo the cardinality), and the second operand. */
+    record Case64(Kind kind, List<Op> ops, List<Near> probes, List<Integer> selects, Other other) {}
+
+    static final Generator<Case64> CASE64 = sampledFrom(Kind.values()).flatMap(kind ->
+        tuples(just(kind), lists(op(kind)).maxSize(14), lists(PROBE).minSize(10).maxSize(10), lists(INDEX).minSize(5).maxSize(5), OTHER)
+            .map(t -> new Case64(t.value1(), t.value2(), t.value3(), t.value4(), t.value5())));
+
+    /** Bugs roaringbitmap/2 and /27 through Roaring64NavigableMap.forEach: a value whose low 32 bits sit at key 0x8000 or are 0x7FFFFFFF. */
+    static boolean lowKey8000(NavigableSet<Long> m) {
+        return m.stream().anyMatch(v -> ((v >>> 16) & 0xFFFF) == 0x8000 || (v & 0xFFFFFFFFL) == 0x7FFFFFFFL);
+    }
+
+    /** Bug roaringbitmap/14: the uncached map ranks with a signed comparison of the high parts. */
+    static boolean noCacheSigns(Kind kind, long x, NavigableSet<Long> m) {
+        return kind == Kind.UNCACHED_MAP && ((x >>> 32) >= 0x80000000L || (!m.isEmpty() && (m.last() >>> 32) >= 0x80000000L));
+    }
+
+    @Test
+    void sixtyFourBitBitmapsTrackATreeSetOfLongs() {
+        Hegel.test(tc -> {
+            Case64 c = tc.draw(CASE64, "case");
+            Kind kind = c.kind();
+            Impl b = kind.fresh();
+            NavigableSet<Long> m = new TreeSet<>(b.signed() ? Comparator.naturalOrder() : UNSIGNED);
+            for (Op op : c.ops()) {
+                apply(op, b, m);
+            }
+            // bug roaringbitmap/12: the map's in-place operations leave empty buckets; pinned, first/last/equals are skipped after one
+            boolean emptyBucket = b.bitmap() instanceof Roaring64NavigableMap nm0 && hasEmptyBucket(nm0);
+            same("after mutations", b, m);
+            long[] want = arr(m);
+            check(Arrays.equals(drain(b.iterator()), want), () -> b.name() + " iterator " + longs(drain(b.iterator()), b.signed()) + " != " + longs(want, b.signed()));
+            check(Arrays.equals(drain(b.reverseIterator()), reversed(want)), () -> b.name() + " reverse iterator " + longs(drain(b.reverseIterator()), b.signed()));
+            List<Long> fe = new ArrayList<>();
+            // bugs roaringbitmap/2 and /27: pinned, the map's forEach is skipped where the low 32 bits hit them
+            boolean lowKey8000 = lowKey8000(m);
+            if (b.bitmap() instanceof Roaring64Bitmap rb) {
+                rb.forEach(fe::add);
+                check(fe.size() == want.length && Arrays.equals(fe.stream().mapToLong(Long::longValue).toArray(), want), () -> b.name() + " forEach differs: " + longs(fe.stream().mapToLong(Long::longValue).toArray(), b.signed()) + " vs " + longs(want, b.signed()));
+            } else if (!lowKey8000) {
+                ((Roaring64NavigableMap) b.bitmap()).forEach(fe::add);
+                check(fe.size() == want.length && Arrays.equals(fe.stream().mapToLong(Long::longValue).toArray(), want), () -> b.name() + " forEach differs: " + longs(fe.stream().mapToLong(Long::longValue).toArray(), b.signed()) + " vs " + longs(want, b.signed()));
+            }
+            if (m.isEmpty()) {
+                try {
+                    long f = b.first();
+                    fail(b.name() + " first() of an empty bitmap returned " + f);
+                } catch (NoSuchElementException e) {
+                    // documented for Roaring64Bitmap
+                }
+            } else if (!emptyBucket) {
+                check(b.first() == want[0], () -> b.name() + " first " + b.first() + " != " + want[0]);
+                check(b.last() == want[want.length - 1], () -> b.name() + " last " + b.last() + " != " + want[want.length - 1]);
+                for (int idx : c.selects()) {
+                    int j = idx % want.length;
+                    check(b.select(j) == want[j], () -> b.name() + " select(" + j + ") " + b.select(j) + " != " + want[j] + " in " + longs(want, b.signed()));
+                }
+            }
+            try {
+                long s = b.select(m.size());
+                fail(b.name() + " select(cardinality) returned " + s + " instead of throwing IllegalArgumentException");
+            } catch (IllegalArgumentException e) {
+                // documented
+            }
+            for (Near p : c.probes()) {
+                long x = p.at(m);
+                check(b.contains(x) == m.contains(x), () -> b.name() + " contains(" + x + ") " + b.contains(x));
+                long rank = m.headSet(x, true).size();
+                // bug roaringbitmap/14: pinned, rankLong of the uncached map is skipped across the sign
+                if (!noCacheSigns(kind, x, m)) {
+                    check(b.rank(x) == rank, () -> b.name() + " rankLong(" + x + ") " + b.rank(x) + " != " + rank + " in " + longs(want, b.signed()));
+                }
+                if (b.bitmap() instanceof Roaring64Bitmap rb) {
+                    Long ceil = m.ceiling(x);
+                    PeekableLongIterator it = rb.getLongIteratorFrom(x);
+                    if (ceil == null) {
+                        check(!it.hasNext(), () -> "getLongIteratorFrom(" + x + ") has values although none >= it");
+                    } else {
+                        check(it.hasNext() && it.next() == ceil, () -> "getLongIteratorFrom(" + x + ") starts at " + (it.hasNext() ? "?" : "nothing") + ", expected " + ceil);
+                    }
+                    // bug roaringbitmap/10: advanceIfNeeded past the last bucket leaves the iterator unmoved; pinned, only checked with a value ahead
+                    if (ceil != null) {
+                        PeekableLongIterator ad = rb.getLongIterator();
+                        ad.advanceIfNeeded(x);
+                        check(ad.hasNext() && ad.peekNext() == ceil, () -> "advanceIfNeeded(" + x + ") peekNext != " + ceil);
+                    }
+                    Long floor = m.floor(x);
+                    PeekableLongIterator rv = rb.getReverseLongIteratorFrom(x);
+                    if (floor == null) {
+                        check(!rv.hasNext(), () -> "getReverseLongIteratorFrom(" + x + ") has values although none <= it");
+                    } else {
+                        check(rv.hasNext() && rv.next() == floor, () -> "getReverseLongIteratorFrom(" + x + ") does not start at " + floor);
+                    }
+                }
+            }
+            // limit, clone, equals/hashCode, serialization
