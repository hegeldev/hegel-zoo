+    @Test
+    void fractionsFromDoublesMeetTheirBounds() {
+        property("fractionsFromDoublesMeetTheirBounds", tc -> {
+            double x;
+            int shape = n(tc, 0, 9);
+            if (shape < 5) {
+                x = G.in(tc, -1000, 1000);
+            } else if (shape < 8) {
+                x = Q.of(G.anyInt(tc), den(tc)).dbl();
+            } else {
+                x = G.finite(tc);
+            }
+            if (x == 0) {
+                x = 0.5;
+            }
+            BigDecimal xd = new BigDecimal(x);
+            String in = "x = " + x + " (" + Double.toHexString(x) + ")";
+
+            // BigFraction.from(double) is exact
+            BigFraction exact = BigFraction.from(x);
+            check(new BigDecimal(exact.getNumerator()).divide(new BigDecimal(exact.getDenominator()), MC).compareTo(xd.round(MC)) == 0
+                && exact.getDenominator().bitCount() == 1,
+                () -> "BigFraction.from(" + in + ") = " + exact + " is not the exact value");
+
+            // maximum denominator
+            int maxDen = chance(tc, 70) ? n(tc, 1, 100_000) : pick(tc, 1, 2, 3, Integer.MAX_VALUE, Integer.MIN_VALUE, -7, 10, 1 << 20);
+            BigInteger maxD = BigInteger.valueOf(maxDen).abs();
+            boolean intPartFits = xd.abs().compareTo(new BigDecimal(OVERFLOW.add(BigInteger.ONE))) < 0;
+            try {
+                Fraction f = Fraction.from(x, maxDen);
+                Q q = model(f);
+                check(intPartFits, () -> "Fraction.from(" + in + ", maxDen " + maxDen + ") = " + f + " although the integer part overflows");
+                check(q.den.compareTo(maxD) <= 0, () -> "Fraction.from(" + in + ", maxDen " + maxDen + ") = " + f + " exceeds the maximum denominator");
+                // a convergent p/q satisfies |x - p/q| < 1/q^2 (the search may also stop early when the next numerator
+                // would overflow an int, so the 1/(q*maxDen) bound of the ideal algorithm is not required)
+                BigDecimal err = xd.subtract(q.dec()).abs();
+                BigDecimal bound = BigDecimal.ONE.divide(new BigDecimal(q.den.multiply(q.den)), MC);
+                check(err.compareTo(bound) < 0 || err.signum() == 0,
+                    () -> "Fraction.from(" + in + ", maxDen " + maxDen + ") = " + f + " is not a convergent: error " + err + " bound " + bound);
+            } catch (ArithmeticException ex) {
+                check(!intPartFits, () -> "Fraction.from(" + in + ", maxDen " + maxDen + ") threw " + ex);
+            }
+            if (Known.BIG_FRACTION_FROM_IS_LIMITED_TO_INTS && !intPartFits) {
+                return; // commons-numbers/16: BigFraction.from(double, ...) approximations refuse |value| > 2^31
+            }
+            BigFraction bf = BigFraction.from(x, maxDen);
+            Q bq = model(bf);
+            check(bq.den.compareTo(maxD) <= 0, () -> "BigFraction.from(" + in + ", maxDen " + maxDen + ") = " + bf + " exceeds the maximum denominator");
+            BigDecimal berr = xd.subtract(bq.dec()).abs();
+            BigDecimal bbound = BigDecimal.ONE.divide(new BigDecimal(bq.den.multiply(bq.den)), MC);
+            check(berr.compareTo(bbound) < 0 || berr.signum() == 0,
+                () -> "BigFraction.from(" + in + ", maxDen " + maxDen + ") = " + bf + " is not a convergent: error " + berr + " bound " + bbound);
+
+            // epsilon and iterations
+            double eps = chance(tc, 70) ? G.logUniform(tc, -12, -1) : pick(tc, 1e-5, 0.5, 1.0, 1e-20, 1e-300, Double.MIN_VALUE, 10.0);
+            int maxIter = chance(tc, 70) ? n(tc, 1, 100) : pick(tc, 1, 2, 100, Integer.MAX_VALUE);
+            BigDecimal epsd = new BigDecimal(eps).multiply(BigDecimal.ONE.add(new BigDecimal("1e-9")));
+            if (Known.FROM_EPSILON_BELOW_ULP_IS_NOT_HONOURED && eps < Math.ulp(x)) {
+                return; // commons-numbers/17: the convergence test runs in double arithmetic
+            }
+            try {
+                Fraction f = Fraction.from(x, eps, maxIter);
+                Q q = model(f);
+                BigDecimal err = xd.subtract(q.dec()).abs();
+                check(err.compareTo(epsd) <= 0, () -> "Fraction.from(" + in + ", eps " + eps + ", " + maxIter + ") = " + f + " is off by " + err);
+            } catch (ArithmeticException ex) {
+                // failed to converge or overflow: allowed by the contract
+            }
+            try {
+                BigFraction f = BigFraction.from(x, eps, maxIter);
+                Q q = model(f);
+                BigDecimal err = xd.subtract(q.dec()).abs();
+                check(err.compareTo(epsd) <= 0, () -> "BigFraction.from(" + in + ", eps " + eps + ", " + maxIter + ") = " + f + " is off by " + err);
+            } catch (ArithmeticException ex) {
+                // failed to converge: allowed by the contract
+            }
+            if (Math.abs(x) < 1e6) {
+                try {
+                    Fraction f = Fraction.from(x);
+                    BigDecimal err = xd.subtract(model(f).dec()).abs();
+                    check(err.compareTo(new BigDecimal("1.000000001e-5")) <= 0, () -> "Fraction.from(" + in + ") = " + f + " is off by " + err);
+                } catch (ArithmeticException ex) {
+                    // failed to converge: allowed by the contract
+                }
+            }
+        });
+    }
