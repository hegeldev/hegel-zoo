+                check(ulpsApart(fdc.value(fn), fd) <= 1, () -> "FactorialDouble.withCache(" + cache + ").value(" + fn + ") = " + fdc.value(fn) + " expected " + fd);
+                LogFactorial lf = LogFactorial.create().withCache(cache);
+                double lfv = lf.value(fn);
+                // Known.LOG_FACTORIAL_DEPENDS_ON_THE_CACHE (commons-numbers/9): cached values come from a running sum of logs
+                if (!(Known.LOG_FACTORIAL_DEPENDS_ON_THE_CACHE && fn < cache)) {
+                    independentOfTheCache(fn, cache, lfv);
+                }
+                Oracle.Reply r = Oracle.call("logfact", fn);
+                check(r.ok() && Oracle.ulps(lfv, r.raw()[0]) <= 4 || fn <= 1 && lfv == 0,
+                    () -> "LogFactorial.withCache(" + cache + ").value(" + fn + ") = " + lfv + " mpmath " + (r.ok() ? r.raw()[0] : r.error()));
+            }
+        });
+    }
+
+    /** LogFactorial.value(n) is the same number whatever the cache size (the Javadoc describes the cache as precomputed values of the function). */
+    static void independentOfTheCache(int fn, int cache, double cached) {
+        double plain = LogFactorial.create().value(fn);
+        check(plain == cached, () -> "LogFactorial(" + fn + ") is " + plain + " without a cache and " + cached + " with cache " + cache);
+    }
+
+    /**
+     * LogFactorial.value(n) for n in [21, 500] with a cache that covers n against the uncached value, judged as
+     * combinatoricsAgreeWithBigInteger judges it: the cache is a running sum of logs, the uncached value LogGamma(n + 1)
+     * (commons-numbers/9). Beside it (HEGEL_NO_KNOWN) a cache that stops at or below n, where both are the uncached value.
+     */
+    @Test
+    void logFactorialWithACacheAgreesWithTheUncachedValue() {
+        property("logFactorialWithACacheAgreesWithTheUncachedValue", tc -> {
+            int fn = n(tc, 21, 500);
+            int cache = Known.LOG_FACTORIAL_DEPENDS_ON_THE_CACHE ? n(tc, 0, fn) : fn + n(tc, 1, 50);
+            independentOfTheCache(fn, cache, LogFactorial.create().withCache(cache).value(fn));
+        });
+    }
+
+    /**
+     * Combinations.of(n, k).comparator() for n in [1e4, 2^31) (log-uniform) and the smallest k, or the next, whose
+     * lexicographic norm n^(k - 1) exceeds a long, on two random k-subsets against the exact norm, judged as
+     * combinationsAreEnumeratedInOrder judges it: the comparator computes the norm in long arithmetic (commons-numbers/8).
+     * Beside it (HEGEL_NO_KNOWN) the largest k whose norm n^k stays below half of Long.MAX_VALUE, as that property's gate has it.
+     */
+    @Test
+    void comparatorOfALargeUniverseOrdersSubsets() {
+        property("comparatorOfALargeUniverseOrdersSubsets", tc -> {
+            int nn = (int) G.logUniform(tc, 4, 9.33);
+            BigInteger bn = BigInteger.valueOf(nn);
+            int smallest = 1;
+            while (bn.pow(smallest - 1).compareTo(LMAX) <= 0) {
+                smallest++;
+            }
+            int safe = 1;
+            while (bn.pow(safe + 1).compareTo(LMAX.shiftRight(1)) <= 0) {
+                safe++;
+            }
+            int kk = Known.COMPARATOR_OVERFLOWS ? safe : smallest + n(tc, 0, 1);
+            int[] x = subset(tc, nn, kk);
+            int[] y = subset(tc, nn, kk);
+            compares(Combinations.of(nn, kk).comparator(), nn, kk, x, y, lexNorm(x, bn).compareTo(lexNorm(y, bn)));
+        });
+    }
+
+    @Test
+    void combinationsAreEnumeratedInOrder() {
+        property("combinationsAreEnumeratedInOrder", tc -> {
+            if (chance(tc, 25)) {
+                largeCombinations(tc);
+                return;
+            }
+            int nn = n(tc, 0, 11);
+            int kk = n(tc, 0, nn);
+            Combinations comb = Combinations.of(nn, kk);
+            check(comb.getN() == nn && comb.getK() == kk, () -> "getN/getK of Combinations.of(" + nn + ", " + kk + ")");
+            Comparator<int[]> cmp = comb.comparator();
+            List<int[]> all = new ArrayList<>();
+            Iterator<int[]> it = comb.iterator();
+            long expected = binom(nn, kk).longValue();
+            while (it.hasNext() && all.size() <= expected) {
+                all.add(it.next().clone());
+            }
+            check(all.size() == expected, () -> "Combinations.of(" + nn + ", " + kk + ") produced " + all.size() + " arrays, expected " + expected);
+            check(!it.hasNext() && throwsA(NoSuchElementException.class, it::next), () -> "the exhausted iterator of Combinations.of(" + nn + ", " + kk + ") should throw");
+            for (int i = 0; i < all.size(); i++) {
+                int[] c = all.get(i);
+                final int idx = i;
+                check(c.length == kk, () -> "array " + idx + " of Combinations.of(" + nn + ", " + kk + ") has length " + c.length);
+                for (int j = 0; j < c.length; j++) {
+                    final int jj = j;
+                    check(c[j] >= 0 && c[j] < nn && (j == 0 || c[j] > c[j - 1]),
+                        () -> "array " + idx + " of Combinations.of(" + nn + ", " + kk + ") is not a sorted subset: " + Arrays.toString(c) + " at " + jj);
+                }
+                if (i > 0) {
+                    int[] prev = all.get(i - 1);
+                    check(cmp.compare(prev, c) < 0 && cmp.compare(c, prev) > 0 && cmp.compare(c, c) == 0,
+                        () -> "comparator order of Combinations.of(" + nn + ", " + kk + "): " + Arrays.toString(prev) + " then " + Arrays.toString(c));
+                    // lexicographic with significance from right to left: compare the last differing element
+                    int d = 0;
+                    for (int j = kk - 1; j >= 0; j--) {
+                        if (prev[j] != c[j]) {
+                            d = Integer.compare(prev[j], c[j]);
+                            break;
+                        }
+                    }
+                    check(d < 0, () -> "iteration order of Combinations.of(" + nn + ", " + kk + "): " + Arrays.toString(prev) + " before " + Arrays.toString(c));
+                }
+            }
+            if (kk > 0) {
+                int[] bad = all.get(0).clone();
+                bad[0] = pick(tc, -1, nn, nn + 5);
+                final int[] fbad = bad;
+                check(throwsA(IllegalArgumentException.class, () -> cmp.compare(fbad, all.get(0))), () -> "comparator should reject " + Arrays.toString(fbad));
+                int[] shorter = Arrays.copyOf(all.get(0), kk - 1);
+                check(throwsA(IllegalArgumentException.class, () -> cmp.compare(shorter, all.get(0))), () -> "comparator should reject a short array");
+            }
+        });
+    }
+
+    /** Large n, small k: the first arrays of the iteration against the comparator and an exact lexicographic norm. */
+    static void largeCombinations(TestCase tc) {
+        int nn = chance(tc, 50) ? n(tc, 12, 100_000) : pick(tc, 1_000_000, Integer.MAX_VALUE, 2_000_000_000, 65536, 4097);
+        int kk = n(tc, 1, 5);
+        Combinations comb = Combinations.of(nn, kk);
+        Comparator<int[]> cmp = comb.comparator();
+        BigInteger bn = BigInteger.valueOf(nn);
+        // Known.COMPARATOR_OVERFLOWS (commons-numbers/8): the lexicographic norm n^i overflows a long
+        boolean overflow = bn.pow(kk).compareTo(LMAX.shiftRight(1)) > 0;
+        Iterator<int[]> it = comb.iterator();
+        int[] prev = null;
+        for (int i = 0; i < 40 && it.hasNext(); i++) {
+            int[] c = it.next().clone();
+            for (int j = 0; j < c.length; j++) {
+                final int jj = j;
+                check(c[j] >= 0 && c[j] < nn && (j == 0 || c[j] > c[j - 1]),
+                    () -> "array " + Arrays.toString(c) + " of Combinations.of(" + nn + ", " + kk + ") is not a sorted subset at " + jj);
+            }
+            if (prev != null) {
+                final int[] fp = prev;
+                BigInteger np = lexNorm(prev, bn);
+                BigInteger nc = lexNorm(c, bn);
+                check(np.compareTo(nc) < 0, () -> "iteration order of Combinations.of(" + nn + ", " + kk + "): " + Arrays.toString(fp) + " before " + Arrays.toString(c));
+                if (!(Known.COMPARATOR_OVERFLOWS && overflow)) {
+                    compares(cmp, nn, kk, fp, c, -1);
+                }
+            }
+            prev = c;
+        }
+        // two random subsets, compared through the norm
+        if (!(Known.COMPARATOR_OVERFLOWS && overflow)) {
+            int[] x = subset(tc, nn, kk);
+            int[] y = subset(tc, nn, kk);
+            compares(cmp, nn, kk, x, y, lexNorm(x, bn).compareTo(lexNorm(y, bn)));
+        }
+    }
+
+    /** The comparator of Combinations.of(nn, kk) orders x against y as expected (and y against x the other way), without throwing. */
+    static void compares(Comparator<int[]> cmp, int nn, int kk, int[] x, int[] y, int expected) {
+        String in = "comparator of Combinations.of(" + nn + ", " + kk + ") on " + Arrays.toString(x) + " and " + Arrays.toString(y);
+        int got;
+        int back;
+        try {
+            got = cmp.compare(x, y);
+            back = cmp.compare(y, x);
+        } catch (ArithmeticException ex) {
+            check(false, () -> in + " threw " + ex);
+            return;
+        }
+        check(Integer.signum(got) == expected && Integer.signum(back) == -expected, () -> in + " gave " + got + " and " + back + " expected " + expected);
+    }
+
+    static int[] subset(TestCase tc, int nn, int kk) {
+        int[] s = new int[kk];
+        int lo = 0;
+        for (int i = 0; i < kk; i++) {
+            s[i] = n(tc, lo, nn - (kk - i));
+            lo = s[i] + 1;
+        }
+        return s;
+    }
+
+    static BigInteger lexNorm(int[] c, BigInteger bn) {
+        BigInteger r = BigInteger.ZERO;
+        for (int i = c.length - 1; i >= 0; i--) {
+            r = r.multiply(bn).add(BigInteger.valueOf(c[i]));
+        }
+        return r;
+    }
+
+    // -------------------------------------------------------------------------------------------------- primes
+
+    static boolean prime(int v) {
+        return v >= 2 && BigInteger.valueOf(v).isProbablePrime(64);
+    }
+
+    @Test
+    void primesAgreeWithBigInteger() {
+        property("primesAgreeWithBigInteger", tc -> {
+            int v;
+            int shape = n(tc, 0, 9);
+            if (shape < 4) {
+                v = n(tc, -10, 5000);
+            } else if (shape < 8) {
+                v = G.anyInt(tc);
+            } else {
+                v = pick(tc, 0, 1, 2, 3, 4, Integer.MAX_VALUE, Integer.MAX_VALUE - 1, 2147483629, 2147483587, 46337 * 46337, 46349 * 46337,
+                    65521 * 65521, 1 << 30, (1 << 30) + 1, 3 * 3 * 3 * 3 * 3 * 3 * 3 * 3 * 3 * 3 * 3 * 3 * 3 * 3 * 3 * 3 * 3 * 3 * 3);
+            }
+            final int x = v;
+            check(Primes.isPrime(x) == prime(x), () -> "isPrime(" + x + ") = " + Primes.isPrime(x));
+            if (x < 0) {
+                check(throwsA(IllegalArgumentException.class, () -> Primes.nextPrime(x)), () -> "nextPrime(" + x + ") should reject");
+            } else {
+                try {
+                    int np = Primes.nextPrime(x);
+                    check(np >= x && prime(np), () -> "nextPrime(" + x + ") = " + np + " is not a prime >= n");
+                    boolean gapClean = true;
+                    for (long y = x; y < np && gapClean; y++) {
+                        gapClean = !prime((int) y);
+                    }
+                    check(gapClean, () -> "nextPrime(" + x + ") = " + np + " skipped a prime");
+                } catch (ArithmeticException | IllegalArgumentException ex) {
+                    check(false, () -> "nextPrime(" + x + ") threw " + ex);
+                }
+            }
+            if (x < 2) {
+                check(throwsA(IllegalArgumentException.class, () -> Primes.primeFactors(x)), () -> "primeFactors(" + x + ") should reject");
+            } else {
+                List<Integer> fs = Primes.primeFactors(x);
+                BigInteger prod = BigInteger.ONE;
+                boolean allPrime = true;
+                boolean sorted = true;
+                for (int i = 0; i < fs.size(); i++) {
+                    prod = prod.multiply(BigInteger.valueOf(fs.get(i)));
+                    allPrime &= prime(fs.get(i));
+                    sorted &= i == 0 || fs.get(i) >= fs.get(i - 1);
+                }
+                final boolean ap = allPrime;
+                final boolean so = sorted;
+                final BigInteger pr = prod;
+                check(pr.equals(BigInteger.valueOf(x)) && ap, () -> "primeFactors(" + x + ") = " + fs);
+                check(so, () -> "primeFactors(" + x + ") = " + fs + " is not in ascending order");
+            }
+        });
+    }
+}
diff --git a/hegel/src/test/java/zoo/G.java b/hegel/src/test/java/zoo/G.java
new file mode 100644
index 0000000..2698270
--- /dev/null
+++ b/hegel/src/test/java/zoo/G.java
@@ -0,0 +1,119 @@
+package zoo;
+
+import static zoo.Zoo.chance;
+import static zoo.Zoo.ln;
+import static zoo.Zoo.n;
+import static zoo.Zoo.pick;
+
+import dev.hegel.Generators;
+import dev.hegel.TestCase;
+import java.math.BigInteger;
+
+/** Generators shared by the Commons Numbers properties. */
+final class G {
+    private G() {}
+
+    /** Any finite double: sign, exponent and mantissa drawn independently, biased towards ordinary magnitudes. */
+    static double finite(TestCase tc) {
+        int shape = n(tc, 0, 99);
+        if (shape < 50) {
+            return moderate(tc);
+        } else if (shape < 90) {
+            return bits(tc, 0, 2046);
+        } else if (shape < 97) {
+            return bits(tc, 0, 60);
+        }
+        return pick(tc, 0.0, -0.0, 1.0, -1.0, Double.MIN_VALUE, -Double.MIN_VALUE, Double.MIN_NORMAL,
+            Double.MAX_VALUE, -Double.MAX_VALUE, 0.5, 2.0, Math.PI, -Math.PI, Math.E, 1e-300, 1e300);
+    }
+
+    /** A finite double with exponent within about ±60 of 1 (values of everyday size). */
+    static double moderate(TestCase tc) {
+        return bits(tc, 1023 - 60, 1023 + 60);
+    }
+
+    /** A double whose biased exponent is drawn from [loExp, hiExp] (0 = subnormal). */
+    static double bits(TestCase tc, int loExp, int hiExp) {
+        long sign = chance(tc, 50) ? 1L << 63 : 0;
+        long exp = (long) n(tc, loExp, hiExp) << 52;
+        long mant = ln(tc, 0, (1L << 52) - 1);
+        if (chance(tc, 10)) {
+            mant = pick(tc, 0L, 1L, (1L << 52) - 1, 1L << 51);
+        }
+        return Double.longBitsToDouble(sign | exp | mant);
+    }
+
+    /** Any double, including the non-finite ones (about 6%). */
+    static double any(TestCase tc) {
+        if (chance(tc, 6)) {
+            return pick(tc, Double.NaN, Double.POSITIVE_INFINITY, Double.NEGATIVE_INFINITY);
+        }
+        return finite(tc);
+    }
+
+    /**
+     * A double in [lo, hi], with the bounds themselves 5% of the time. Hegel's double generator spreads the rest
+     * about evenly over the interval (the deciles get 9-13% each) and, when the interval spans zero, puts a quarter
+     * of the draws within 1e-6 of it; its long generator is magnitude-biased instead (96% of longs().min(0).max(2^53)
+     * fall in the first percent of the range), so a fraction scaled from one sat at lo nearly always.
+     */
+    static double in(TestCase tc, double lo, double hi) {
+        if (chance(tc, 5)) {
+            return chance(tc, 50) ? lo : hi;
+        }
+        return tc.draw(Generators.doubles().min(lo).max(hi).allowNan(false).allowInfinity(false));
+    }
+
+    /**
+     * A positive double, log-uniform between 10^lo and 10^hi: the exponent is drawn as an offset from lo, so the
+     * generator's cluster near zero falls on the lowest decade rather than on 1 when lo < 0 < hi.
+     */
+    static double logUniform(TestCase tc, double lo, double hi) {
+        double e = lo + in(tc, 0, hi - lo);
+        return Math.pow(10, Math.min(e, hi));
+    }
+
+    /** Any int, biased towards small values and the extremes. */
+    static int anyInt(TestCase tc) {
+        int shape = n(tc, 0, 9);
+        if (shape < 4) {
+            return n(tc, -100, 100);
+        } else if (shape < 7) {
+            return n(tc, -100_000, 100_000);
+        } else if (shape < 9) {
+            return n(tc, Integer.MIN_VALUE, Integer.MAX_VALUE);
+        }
+        return pick(tc, 0, 1, -1, Integer.MIN_VALUE, Integer.MAX_VALUE, Integer.MIN_VALUE + 1, Integer.MAX_VALUE - 1,
+            1 << 30, -(1 << 30), 46341, 65536, -65536, 3, -3, 2, -2);
+    }
+
+    /** Any long, biased towards small values and the extremes. */
+    static long anyLong(TestCase tc) {
+        int shape = n(tc, 0, 9);
+        if (shape < 3) {
+            return n(tc, -100, 100);
+        } else if (shape < 6) {
+            return ln(tc, -10_000_000_000L, 10_000_000_000L);
+        } else if (shape < 9) {
+            return ln(tc, Long.MIN_VALUE, Long.MAX_VALUE);
+        }
+        return pick(tc, 0L, 1L, -1L, Long.MIN_VALUE, Long.MAX_VALUE, Long.MIN_VALUE + 1, Long.MAX_VALUE - 1,
+            1L << 62, -(1L << 62), 3037000499L, 3037000500L, 1L << 32, -(1L << 32), (long) Integer.MIN_VALUE,
+            (long) Integer.MAX_VALUE);
+    }
+
+    /** A BigInteger of up to about 200 bits, biased small. */
+    static BigInteger big(TestCase tc) {
+        int shape = n(tc, 0, 9);
+        if (shape < 5) {
+            return BigInteger.valueOf(anyLong(tc));
+        }
+        int bits = n(tc, 1, shape < 8 ? 100 : 400);
+        BigInteger b = new BigInteger(Long.toUnsignedString(ln(tc, Long.MIN_VALUE, Long.MAX_VALUE)));
+        while (b.bitLength() < bits) {
+            b = b.shiftLeft(63).add(new BigInteger(Long.toUnsignedString(ln(tc, Long.MIN_VALUE, Long.MAX_VALUE))));
+        }
+        b = b.shiftRight(Math.max(0, b.bitLength() - bits));
+        return chance(tc, 50) ? b.negate() : b;
+    }
+}
diff --git a/hegel/src/test/java/zoo/GammaTest.java b/hegel/src/test/java/zoo/GammaTest.java
new file mode 100644
index 0000000..d8b2428
--- /dev/null
+++ b/hegel/src/test/java/zoo/GammaTest.java
@@ -0,0 +1,507 @@
+package zoo;
+
+import static zoo.Zoo.chance;
+import static zoo.Zoo.check;
+import static zoo.Zoo.n;
+import static zoo.Zoo.pick;
+import static zoo.Zoo.property;
+
+import dev.hegel.TestCase;
+import java.math.BigDecimal;
+import java.util.function.DoubleUnaryOperator;
+import org.apache.commons.numbers.gamma.Beta;
+import org.apache.commons.numbers.gamma.Digamma;
+import org.apache.commons.numbers.gamma.Erf;
+import org.apache.commons.numbers.gamma.Erfc;
+import org.apache.commons.numbers.gamma.Erfcx;
+import org.apache.commons.numbers.gamma.Gamma;
+import org.apache.commons.numbers.gamma.GammaRatio;
+import org.apache.commons.numbers.gamma.IncompleteBeta;
+import org.apache.commons.numbers.gamma.IncompleteGamma;
+import org.apache.commons.numbers.gamma.InverseErf;
+import org.apache.commons.numbers.gamma.InverseErfc;
+import org.apache.commons.numbers.gamma.LogBeta;
+import org.apache.commons.numbers.gamma.LogGamma;
+import org.apache.commons.numbers.gamma.RegularizedBeta;
+import org.apache.commons.numbers.gamma.RegularizedGamma;
+import org.apache.commons.numbers.gamma.Trigamma;
+import org.junit.jupiter.api.Test;
+
+/** The gamma and error functions against mpmath and against their own identities. */
+class GammaTest {
+
+    /** Gross-error bound in ulps for functions without a documented accuracy (Boost-derived code is within a few). */
+    static final double GROSS = 512;
+
+    static String hx(double x) {
+        return x + " (" + Double.toHexString(x) + ")";
+    }
+
+    /** A real argument for the gamma family: ordinary, near an integer, tiny, huge, or special. */
+    static double arg(TestCase tc) {
+        int shape = n(tc, 0, 99);
+        if (shape < 35) {
+            return G.in(tc, -30, 30);
+        } else if (shape < 50) {
+            return G.in(tc, -175, 175);
+        } else if (shape < 65) {
+            int k = n(tc, -20, 20);
+            return k + (chance(tc, 50) ? 1 : -1) * G.logUniform(tc, -16, -1);
+        } else if (shape < 75) {
+            return (chance(tc, 50) ? 1 : -1) * G.logUniform(tc, -300, 0);
+        } else if (shape < 90) {
+            return (chance(tc, 50) ? 1 : -1) * G.logUniform(tc, 2, 16);
+        }
+        return pick(tc, 0.0, -0.0, 0.5, -0.5, 1.0, 2.0, 3.0, -1.0, -2.0, 171.0, 171.5, 171.62, 172.0, -171.5, -0.5, 1e-300, -1e-300,
+            Double.MIN_VALUE, Double.MAX_VALUE, -Double.MAX_VALUE, Double.POSITIVE_INFINITY, Double.NEGATIVE_INFINITY, Double.NaN,
+            1e15 + 0.5, -1e15 - 0.5, -1e6 - 0.5, 4503599627370496.5, -4503599627370497.0);
+    }
+
+    static boolean isInteger(double x) {
+        return Double.isFinite(x) && x == Math.rint(x);
+    }
+
+    /** Compare a real function against the oracle: same non-finite class, or within {@code ulps} ulps / an absolute floor. */
+    static void agree(String what, double x, double got, String op, double ulps, double absFloor) {
+        Oracle.Reply r = Oracle.call(op, x);
+        agreeWith(what + "(" + hx(x) + ")", got, r, ulps, absFloor);
+    }
+
+    static void agreeWith(String in, double got, Oracle.Reply r, double ulps, double absFloor) {
+        if (!r.ok()) {
+            if (r.error().contains("Overflow")) {
+                return; // the oracle's own limit (float conversion of a huge argument)
+            }
+            // a pole or domain error: the library must not return a finite number
+            check(!Double.isFinite(got), () -> in + " = " + got + " but mpmath reports " + r.error());
+            return;
+        }
+        String raw = r.raw()[0];
+        BigDecimal e = r.exact(0);
+        if (e == null) {
+            double ed = Oracle.toDouble(raw);
+            check(Double.isNaN(ed) ? Double.isNaN(got) : got == ed, () -> in + " = " + got + " mpmath " + raw);
+            return;
+        }
+        double ed = e.doubleValue();
+        if (Double.isInfinite(ed)) {
+            check(got == ed, () -> in + " = " + got + " mpmath " + raw + " (overflows a double)");
+            return;
+        }
+        if (e.abs().compareTo(new BigDecimal("1e-300")) < 0) {
+            check(Math.abs(got) <= 1e-290, () -> in + " = " + got + " mpmath " + raw + " (underflow territory)");
+            return;
+        }
+        double u = Oracle.ulps(got, e);
+        double abs = Double.isFinite(got) ? new BigDecimal(got).subtract(e).abs().doubleValue() : Double.POSITIVE_INFINITY;
+        check(u <= ulps || abs <= absFloor, () -> in + " = " + got + " mpmath " + raw + " off by " + u + " ulps");
+    }
+
+    @Test
+    void gammaAndErrorFunctionsAgreeWithMpmath() {
+        property("gammaAndErrorFunctionsAgreeWithMpmath", tc -> {
+            double x = arg(tc);
+            boolean pole = isInteger(x) && x <= 0;
+
+            // Gamma: NaN at the poles (documented by LogGamma; Gamma says nothing, but a finite value would be wrong)
+            double g = Gamma.value(x);
+            if (pole) {
+                check(!Double.isFinite(g), () -> "Gamma(" + hx(x) + ") = " + g + " at a pole");
+            } else if (Double.isNaN(x)) {
+                check(Double.isNaN(g), () -> "Gamma(NaN) = " + g);
+            } else if (Double.isInfinite(x)) {
+                check(x > 0 ? g == Double.POSITIVE_INFINITY : Double.isNaN(g), () -> "Gamma(" + x + ") = " + g);
+            } else if (Math.abs(x) < 1e15) {
+                agree("Gamma", x, g, "gamma", GROSS, 0);
+            }
+
+            // LogGamma and its sign
+            int[] sign = new int[1];
+            double lg = LogGamma.value(x, sign);
+            double lg1 = LogGamma.value(x);
+            check(Double.doubleToLongBits(lg) == Double.doubleToLongBits(lg1), () -> "LogGamma(" + hx(x) + ") with and without sign differ: " + lg + " vs " + lg1);
+            if (pole || Double.isNaN(x) || x == Double.NEGATIVE_INFINITY) {
+                check(Double.isNaN(lg), () -> "LogGamma(" + hx(x) + ") = " + lg + " expected NaN (documented for non-positive integers)");
+            } else if (x == Double.POSITIVE_INFINITY) {
+                check(lg == Double.POSITIVE_INFINITY, () -> "LogGamma(inf) = " + lg);
+            } else {
+                if (Math.abs(x) < 1e15) {
+                    // near the zeros of log|Gamma| at 1 and 2 the relative error is unbounded: an absolute floor of 1e-15
+                    agree("LogGamma", x, lg, "lgamma", GROSS, 1e-15);
+                }
+                int expectedSign = x > 0 ? 1 : (((long) Math.floor(x)) % 2 == 0 ? 1 : -1);
+                check(sign[0] == expectedSign, () -> "LogGamma(" + hx(x) + ") sign " + sign[0] + " expected " + expectedSign);
+                if (Double.isFinite(g) && g != 0) {
+                    check(Math.signum(g) == sign[0], () -> "LogGamma sign " + sign[0] + " disagrees with Gamma(" + hx(x) + ") = " + g);
+                }
+            }
+
+            // Digamma and Trigamma: documented to 1e-8 relative or absolute
+            double dg = Digamma.value(x);
+            double tg = Trigamma.value(x);
+            if (pole) {
+                // Known.DIGAMMA_IGNORES_POLES (commons-numbers/6): Digamma is finite at the non-positive integers; with the
+                // switch on the half-integer 1/2 - x is checked instead
+                if (!Known.DIGAMMA_IGNORES_POLES) {
+                    check(!Double.isFinite(dg), () -> "Digamma(" + hx(x) + ") = " + dg + " at a pole");
+                } else if (Math.abs(x) < 0x1.0p52) {
+                    double y = 0.5 - x;
+                    digammaAndTrigammaWithinTheDocumentedAccuracy(y, Digamma.value(y), Trigamma.value(y));
+                }
+                check(!Double.isFinite(tg), () -> "Trigamma(" + hx(x) + ") = " + tg + " at a pole");
+            } else if (Double.isFinite(x) && Math.abs(x) < 1e16) {
+                // Known.REFLECTION_WITHOUT_ARGUMENT_REDUCTION (commons-numbers/7): the reflection formula evaluates
+                // sin/tan(pi x) from the rounded product pi*x, so the error grows with |x| and explodes near the poles;
+                // with the switch on -x is checked instead
+                boolean reflected = x < 0 && (Math.abs(x) > 1e5 || Math.abs(x - Math.rint(x)) < 1e-6 * Math.max(1, Math.abs(x)));
+                if (Known.REFLECTION_WITHOUT_ARGUMENT_REDUCTION && reflected) {
+                    digammaAndTrigammaWithinTheDocumentedAccuracy(-x, Digamma.value(-x), Trigamma.value(-x));
+                } else {
+                    digammaAndTrigammaWithinTheDocumentedAccuracy(x, dg, tg);
+                }
+            }
+
+            // the error functions and their contracts
+            double ef = Erf.value(x);
+            double efc = Erfc.value(x);
+            double efcx = Erfcx.value(x);
+            if (Double.isNaN(x)) {
+                check(Double.isNaN(ef) && Double.isNaN(efc) && Double.isNaN(efcx), () -> "Erf family of NaN: " + ef + " " + efc + " " + efcx);
+            } else {
+                check(ef >= -1 && ef <= 1, () -> "Erf(" + hx(x) + ") = " + ef + " outside [-1, 1]");
+                check(efc >= 0 && efc <= 2, () -> "Erfc(" + hx(x) + ") = " + efc + " outside [0, 2]");
+                if (Double.isFinite(x)) {
+                    agree("Erf", x, ef, "erf", GROSS, 0);
+                    agree("Erfc", x, efc, "erfc", GROSS, 0);
+                    if (x > -26 || x < -30) {
+                        agree("Erfcx", x, efcx, "erfcx", GROSS, 0);
+                    }
+                } else {
+                    check(ef == Math.signum(x) && efc == (x > 0 ? 0 : 2), () -> "Erf/Erfc(" + x + ") = " + ef + " " + efc);
+                    check(efcx == (x > 0 ? 0 : Double.POSITIVE_INFINITY), () -> "Erfcx(" + x + ") = " + efcx);
+                }
+            }
+
+            // inverses on their domains
+            double y = chance(tc, 70) ? G.in(tc, -1, 1) : pick(tc, 0.0, -0.0, 1.0, -1.0, Math.nextDown(1.0), Math.nextUp(-1.0), 1e-300, -1e-300, 0.5, -0.5, 1.5, -1.5, Double.NaN);
+            double ie = InverseErf.value(y);
+            if (Double.isNaN(y) || y < -1 || y > 1) {
+                check(Double.isNaN(ie), () -> "InverseErf(" + hx(y) + ") = " + ie);
+            } else if (Math.abs(y) == 1) {
+                check(ie == Math.copySign(Double.POSITIVE_INFINITY, y), () -> "InverseErf(" + y + ") = " + ie);
+            } else if (y == 0) {
+                check(ie == 0, () -> "InverseErf(" + hx(y) + ") = " + ie);
+            } else {
+                agree("InverseErf", y, ie, "erfinv", GROSS, 0);
+            }
+            double yc = chance(tc, 70) ? G.in(tc, 0, 2) : pick(tc, 0.0, 1.0, 2.0, Math.nextUp(0.0), Math.nextDown(2.0), 1e-300, 1e-20, 2 - 1e-15, 2.5, -0.5, Double.NaN);
+            double iec = InverseErfc.value(yc);
+            if (Double.isNaN(yc) || yc < 0 || yc > 2) {
+                check(Double.isNaN(iec), () -> "InverseErfc(" + hx(yc) + ") = " + iec);
+            } else if (yc == 0 || yc == 2) {
+                check(iec == (yc == 0 ? Double.POSITIVE_INFINITY : Double.NEGATIVE_INFINITY), () -> "InverseErfc(" + yc + ") = " + iec);
+            } else if (yc == 1) {
+                check(iec == 0, () -> "InverseErfc(1) = " + iec);
+            } else if (yc >= 1e-60) {
+                agree("InverseErfc", yc, iec, "erfcinv", GROSS, 0);
+            }
+        });
+    }
+
+    /** Digamma and Trigamma values at x against mpmath, to the documented 1e-8 relative or absolute. */
+    static void digammaAndTrigammaWithinTheDocumentedAccuracy(double x, double dg, double tg) {
+        Oracle.Reply r = Oracle.call("digamma", x);
+        Oracle.Reply r2 = Oracle.call("trigamma", x);
+        if (r.ok() && r.exact(0) != null) {
+            BigDecimal e = r.exact(0);
+            double err = Double.isFinite(dg) ? new BigDecimal(dg).subtract(e).abs().doubleValue() : Double.POSITIVE_INFINITY;
+            double tol = 1e-8 * Math.max(1, e.abs().doubleValue());
+            check(err <= tol, () -> "Digamma(" + hx(x) + ") = " + dg + " mpmath " + r.raw()[0] + " error " + err + " (1e-8 documented)");
+        }
+        if (r2.ok() && r2.exact(0) != null) {
+            BigDecimal e = r2.exact(0);
+            double ed = e.doubleValue();
+            if (Double.isInfinite(ed)) {
+                check(tg == ed, () -> "Trigamma(" + hx(x) + ") = " + tg + " mpmath " + r2.raw()[0]);
+            } else {
+                double err = Double.isFinite(tg) ? new BigDecimal(tg).subtract(e).abs().doubleValue() : Double.POSITIVE_INFINITY;
+                double tol = 1e-8 * Math.max(1, Math.abs(ed));
+                check(err <= tol, () -> "Trigamma(" + hx(x) + ") = " + tg + " mpmath " + r2.raw()[0] + " error " + err + " (1e-8 documented)");
+            }
+        }
+    }
+
+    /**
+     * Digamma at a negative integer -k, k in 1..1000: a pole, so no finite value (Trigamma returns +infinity there),
+     * judged as gammaAndErrorFunctionsAgreeWithMpmath judges a pole (commons-numbers/6: the reflection divides by the
+     * rounding residue of tan(pi k)). Beside it (HEGEL_NO_KNOWN) the half-integer 1/2 - k against mpmath.
+     */
+    @Test
+    void digammaHasNoFiniteValueAtTheNegativeIntegers() {
+        property("digammaHasNoFiniteValueAtTheNegativeIntegers", tc -> {
+            int k = n(tc, 1, 1000);
+            if (Known.DIGAMMA_IGNORES_POLES) {
+                double x = 0.5 - k;
+                digammaAndTrigammaWithinTheDocumentedAccuracy(x, Digamma.value(x), Trigamma.value(x));
+            } else {
+                double x = -k;
+                double dg = Digamma.value(x);
+                double tg = Trigamma.value(x);
+                check(!Double.isFinite(dg), () -> "Digamma(" + hx(x) + ") = " + dg + " at a pole");
+                check(!Double.isFinite(tg), () -> "Trigamma(" + hx(x) + ") = " + tg + " at a pole");
+            }
+        });
+    }
+
+    /**
+     * Digamma and Trigamma at a negative argument of magnitude 1e11 to 1e15 (log-uniform), or at a distance of k 1e-13.5
+     * to k 1e-10.5 (log-uniform, either side) from a negative integer -k, k in 2..170, against mpmath to the documented
+     * 1e-8, judged as gammaAndErrorFunctionsAgreeWithMpmath judges them: the reflection evaluates tan and sin of the
+     * rounded product pi x, whose error is about 3.5e-16 |x| (commons-numbers/7). Beside it (HEGEL_NO_KNOWN) the same
+     * magnitudes with the positive sign, where no reflection happens.
+     */
+    @Test
+    void digammaAndTrigammaReflectionKeepsTheDocumentedAccuracy() {
+        property("digammaAndTrigammaReflectionKeepsTheDocumentedAccuracy", tc -> {
+            boolean large = chance(tc, 50);
+            double magnitude;
+            if (large) {
+                magnitude = G.logUniform(tc, 11, 15);
+            } else {
+                int k = n(tc, 2, 170);
+                magnitude = k + (chance(tc, 50) ? 1 : -1) * k * G.logUniform(tc, -13.5, -10.5);
+            }
+            double x = (Known.REFLECTION_WITHOUT_ARGUMENT_REDUCTION ? 1 : -1) * magnitude;
+            digammaAndTrigammaWithinTheDocumentedAccuracy(x, Digamma.value(x), Trigamma.value(x));
+        });
+    }
+
+    /**
+     * The complement of the arcsine case, 1 - I_x(1/2, 1/2) = (2/pi) acos(sqrt(x)), for small x: the shape of
+     * commons-numbers/19, judged as incompleteGammaAndBetaAgreeWithMpmath judges it. The library's asin(sqrt(1 - x))
+     * returns exactly 1 below x = 2^-53 and loses up to ~1e-10 above it, so the identity fails across the range.
+     */
+    @Test
+    void arcsineBetaComplementAgreesWithMpmathForSmallX() {
+        property("arcsineBetaComplementAgreesWithMpmathForSmallX", tc -> {
+            double x = G.logUniform(tc, -27, -6);
+            // beside the shape under HEGEL_NO_KNOWN=1: a = b just off 1/2, where the arcsine shortcut is not taken
+            double ab = Known.ARCSINE_BETA_IS_INACCURATE_NEAR_THE_ENDS ? 0.5 + pick(tc, 1e-7, 1e-3, 0.1) : 0.5;
+            String bin = "(x = " + hx(x) + ", a = b = " + ab + ")";
+            double ib = RegularizedBeta.value(x, ab, ab);
+            double ibc = RegularizedBeta.complement(x, ab, ab);
+            check(Math.abs(ib + ibc - 1) <= 1e-15, () -> "RegularizedBeta value + complement" + bin + " = " + (ib + ibc));
+            agreeWith("RegularizedBeta.complement" + bin, ibc, Oracle.call("beta_reg_c", x, ab, ab), 4096, 1e-300);
+            agreeWith("IncompleteBeta.complement" + bin, IncompleteBeta.complement(x, ab, ab), Oracle.call("beta_inc_c", x, ab, ab), 4096, 1e-300);
+        });
+    }
