+            double v = G.in(tc, -1000, 1000);
+            int magnitude = Known.ROUND_THROWS_FOR_EXTREME_SCALES ? n(tc, 300, 1100) : n(tc, 720_000_000, Integer.MAX_VALUE);
+            int scale = chance(tc, 50) ? magnitude : magnitude == Integer.MAX_VALUE ? Integer.MIN_VALUE : -magnitude;
