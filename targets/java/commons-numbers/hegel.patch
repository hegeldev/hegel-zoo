+    // ---------------------------------------------------------------------------------------------- Sum, Norm
+
+    static double[] vector(TestCase tc, int lo, int hi) {
+        int len = n(tc, lo, hi);
+        double[] v = new double[len];
+        for (int i = 0; i < len; i++) {
+            v[i] = chance(tc, 85) ? G.moderate(tc) : G.finite(tc);
+            if (chance(tc, 5)) {
+                v[i] = pick(tc, 0.0, -0.0, 1.0, -1.0);
+            }
+        }
+        return v;
+    }
+
+    static BigDecimal exactSum(double[] v) {
+        BigDecimal s = BigDecimal.ZERO;
+        for (double d : v) {
+            s = s.add(new BigDecimal(d));
+        }
+        return s;
+    }
+
+    static boolean finite(double[] v) {
+        for (double d : v) {
+            if (!Double.isFinite(d)) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    static String show(double[] v) {
+        StringBuilder sb = new StringBuilder("[");
+        for (int i = 0; i < v.length; i++) {
+            sb.append(i > 0 ? ", " : "").append(Double.toHexString(v[i]));
+        }
+        return sb.append("]").toString();
+    }
+
+    static final BigDecimal MAX = new BigDecimal(Double.MAX_VALUE);
+    /** The round-to-nearest boundary between MAX_VALUE and infinity: MAX_VALUE + half an ulp. */
+    static final BigDecimal OVERFLOW = MAX.add(new BigDecimal(Math.ulp(Double.MAX_VALUE)).divide(BigDecimal.valueOf(2)));
+
+    /**
+     * Within {@code ulps} ulps of the exact value, or the right infinity when the exact value overflows
+     * (an exact value between MAX_VALUE and MAX_VALUE + ulp/2 rounds to MAX_VALUE, as IEEE 754 has it).
+     */
+    static void near(String in, double got, BigDecimal exact, double ulps) {
+        if (exact.abs().compareTo(OVERFLOW) >= 0) {
+            check(got == (exact.signum() > 0 ? Double.POSITIVE_INFINITY : Double.NEGATIVE_INFINITY), () -> in + " = " + got + " exact " + exact.round(new MathContext(20)) + " (overflows)");
+            return;
+        }
+        if (exact.abs().compareTo(MAX) > 0) {
+            check(Math.abs(got) == Double.MAX_VALUE && Math.signum(got) == exact.signum(), () -> in + " = " + got + " exact " + exact.round(new MathContext(20)) + " (rounds to MAX_VALUE)");
+            return;
+        }
+        if (exact.signum() != 0 && exact.abs().compareTo(new BigDecimal("1e-300")) < 0) {
+            return; // subnormal territory
+        }
+        double u = Oracle.ulps(got, exact);
+        check(u <= ulps, () -> in + " = " + hx(got) + " exact " + exact.round(new MathContext(25)) + " off by " + u + " ulps");
+    }
+
+    /** The IEEE 754 sum of the terms in order (the sign of a zero sum: -0.0 only when every term is -0.0). */
+    static double ieeeSum(double[] v) {
+        double ieee = 0;
+        boolean first = true;
+        for (double d : v) {
+            ieee = first ? d : ieee + d;
+            first = false;
+        }
+        return ieee;
+    }
+
+    /**
+     * Sum.of over one to eight terms that are all -0.0, or Sum.ofProducts over as many pairs whose every product is -0.0
+     * (a random factor against a zero of the opposite sign): the IEEE 754 rules the Javadoc cites give -0.0, judged as
+     * sumsAndNormsAreAccurate judges the sign of a zero sum (commons-numbers/13: the compensation term is +0.0). Beside
+     * it (HEGEL_NO_KNOWN) the same with +0.0, where the two agree.
+     */
+    @Test
+    void sumOfNegativeZerosIsNegativeZero() {
+        property("sumOfNegativeZerosIsNegativeZero", tc -> {
+            double zero = Known.SUM_DROPS_NEGATIVE_ZERO ? 0.0 : -0.0;
+            int len = n(tc, 1, 8);
+            boolean plain = chance(tc, 50);
+            double[] v = new double[len];
+            double[] w = new double[len];
+            double[] terms = new double[len];
+            for (int i = 0; i < len; i++) {
+                v[i] = plain ? zero : G.moderate(tc);
+                w[i] = plain ? zero : Math.copySign(zero, zero * v[i]);
+                terms[i] = plain ? zero : v[i] * w[i];
+            }
+            String in = plain ? "Sum.of(" + show(v) + ")" : "Sum.ofProducts(" + show(v) + ", " + show(w) + ")";
+            double s = plain ? Sum.of(v).getAsDouble() : Sum.ofProducts(v, w).getAsDouble();
+            double ieee = ieeeSum(terms);
+            check(Double.doubleToLongBits(s) == Double.doubleToLongBits(ieee), () -> in + " = " + hx(s) + " IEEE " + hx(ieee));
+        });
+    }
+
+    @Test
+    void sumsAndNormsAreAccurate() {
+        property("sumsAndNormsAreAccurate", tc -> {
+            double[] v = vector(tc, 1, 8);
+            double[] w = vector(tc, v.length, v.length);
+            String in = "Sum.of(" + show(v) + ")";
+            if (finite(v)) {
+                BigDecimal exact = exactSum(v);
+                double s = Sum.of(v).getAsDouble();
+                near(in, s, exact, 1);
+                // incremental construction gives the same value
+                Sum inc = Sum.create();
+                for (double d : v) {
+                    inc.add(d);
+                }
+                check(Double.doubleToLongBits(inc.getAsDouble()) == Double.doubleToLongBits(s) || exact.signum() == 0 && Known.SUM_DROPS_NEGATIVE_ZERO,
+                    () -> in + " = " + hx(s) + " but Sum.create().add(each) = " + hx(inc.getAsDouble()));
+                // IEEE sign of zero when the exact sum is zero (the documented IEEE 754 rules: -0 only when every term is -0);
+                // Known.SUM_DROPS_NEGATIVE_ZERO (commons-numbers/13): Sum never returns -0.0
+                if (exact.signum() == 0 && !Known.SUM_DROPS_NEGATIVE_ZERO) {
+                    double ieee = ieeeSum(v);
+                    check(Double.doubleToLongBits(s) == Double.doubleToLongBits(ieee), () -> in + " = " + hx(s) + " IEEE " + hx(ieee));
+                }
+                if (finite(w)) {
+                    BigDecimal dot = BigDecimal.ZERO;
+                    for (int i = 0; i < v.length; i++) {
+                        dot = dot.add(new BigDecimal(v[i]).multiply(new BigDecimal(w[i])));
+                    }
+                    near("Sum.ofProducts(" + show(v) + ", " + show(w) + ")", Sum.ofProducts(v, w).getAsDouble(), dot, 1);
+                    Sum both = Sum.of(v).add(Sum.of(w));
+                    near("Sum.of(v).add(Sum.of(w)) for " + show(v) + " and " + show(w), both.getAsDouble(), exact.add(exactSum(w)), 1);
+                    Sum diff = Sum.of(v).subtract(Sum.of(w));
+                    near("Sum.of(v).subtract(Sum.of(w)) for " + show(v) + " and " + show(w), diff.getAsDouble(), exact.subtract(exactSum(w)), 1);
+                }
+            }
+            check(throwsA(IllegalArgumentException.class, () -> Sum.ofProducts(v, new double[v.length + 1])), () -> "ofProducts with mismatched lengths should reject");
+
+            // norms
+            boolean anyNaN = false;
+            boolean anyInf = false;
+            BigDecimal l1 = BigDecimal.ZERO;
+            BigDecimal sq = BigDecimal.ZERO;
+            double linf = 0;
+            for (double d : v) {
+                anyNaN |= Double.isNaN(d);
+                anyInf |= Double.isInfinite(d);
+                if (Double.isFinite(d)) {
+                    BigDecimal bd = new BigDecimal(d);
+                    l1 = l1.add(bd.abs());
+                    sq = sq.add(bd.multiply(bd));
+                    linf = Math.max(linf, Math.abs(d));
+                }
+            }
+            String nin = "(" + show(v) + ")";
+            final double flinf = linf;
+            double n1 = Norm.L1.of(v);
+            double n2 = Norm.L2.of(v);
+            double ni = Norm.LINF.of(v);
+            if (anyNaN) {
+                check(Double.isNaN(n1) && Double.isNaN(n2) && Double.isNaN(ni), () -> "norms of a vector with NaN" + nin + " = " + n1 + ", " + n2 + ", " + ni);
+            } else if (anyInf) {
+                check(n1 == Double.POSITIVE_INFINITY && n2 == Double.POSITIVE_INFINITY && ni == Double.POSITIVE_INFINITY,
+                    () -> "norms of a vector with infinity" + nin + " = " + n1 + ", " + n2 + ", " + ni);
+            } else {
+                near("Norm.L1" + nin, n1, l1, 1);
+                near("Norm.L2" + nin, n2, sq.sqrt(MC), 1);
+                check(ni == flinf, () -> "Norm.LINF" + nin + " = " + ni + " expected " + flinf);
+                if (v.length == 2) {
+                    near("Norm.L1.of(x, y)" + nin, Norm.L1.of(v[0], v[1]), l1, 1);
+                    near("Norm.L2.of(x, y)" + nin, Norm.L2.of(v[0], v[1]), sq.sqrt(MC), 1);
+                    check(Norm.LINF.of(v[0], v[1]) == flinf, () -> "Norm.LINF.of(x, y)" + nin);
+                }
+                if (v.length == 3) {
+                    near("Norm.L1.of(x, y, z)" + nin, Norm.L1.of(v[0], v[1], v[2]), l1, 1);
+                    near("Norm.L2.of(x, y, z)" + nin, Norm.L2.of(v[0], v[1], v[2]), sq.sqrt(MC), 1);
+                    check(Norm.LINF.of(v[0], v[1], v[2]) == flinf, () -> "Norm.LINF.of(x, y, z)" + nin);
+                }
+            }
+            check(throwsA(IllegalArgumentException.class, () -> Norm.L2.of(new double[0])), () -> "Norm.L2 of an empty array should reject");
+        });
+    }
