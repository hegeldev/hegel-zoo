+                    check(de.lt(x, y) == (!eqD && x < y) && de.gt(x, y) == (!eqD && x > y), () -> "DoubleEquivalence(" + eps + ").lt/gt" + in);
+                    check(de.lte(x, y) == (eqD || x < y) && de.gte(x, y) == (eqD || x > y), () -> "DoubleEquivalence(" + eps + ").lte/gte" + in);
+                    int c = de.compare(x, y);
+                    check(c == (eqD ? 0 : x < y ? -1 : 1), () -> "DoubleEquivalence(" + eps + ").compare" + in + " = " + c);
+                    check(de.signum(x) == (Math.abs(x) <= eps ? 0 : x < 0 ? -1 : 1), () -> "DoubleEquivalence(" + eps + ").signum(" + hx(x) + ") = " + de.signum(x));
+                } else if (!Known.DOUBLE_EQUIVALENCE_NAN_ORDER) {
+                    int c = de.compare(x, y);
+                    check(c == Double.compare(x, y), () -> "DoubleEquivalence(" + eps + ").compare" + in + " with NaN = " + c + " (Javadoc: Double.compare semantics)");
+                }
+            }
+
+            // rounding on the decimal string
+            double v = chance(tc, 70) ? G.in(tc, -1000, 1000) : G.any(tc);
+            int scale = chance(tc, 80) ? n(tc, -5, 12) : pick(tc, 0, 15, 16, 17, 20, 300, -300, 400, -400, 1000, -1000, Integer.MIN_VALUE, Integer.MAX_VALUE, Integer.MIN_VALUE + 1);
+            RoundingMode mode = pick(tc, RoundingMode.values());
+            String rin = "round(" + hx(v) + ", " + scale + ", " + mode + ")";
+            if (Known.ROUND_THROWS_FOR_EXTREME_SCALES && Math.abs((long) scale) > 100_000) {
+                return;
+            }
+            if (!Double.isFinite(v)) {
+                check(Double.doubleToLongBits(Precision.round(v, scale, mode)) == Double.doubleToLongBits(v), () -> rin + " should return the argument");
+                return;
+            }
+            BigDecimal dec = new BigDecimal(Double.toString(v));
+            boolean needsRounding = dec.scale() > scale && dec.setScale(scale, RoundingMode.DOWN).compareTo(dec) != 0;
+            if (mode == RoundingMode.UNNECESSARY && needsRounding) {
+                check(throwsA(ArithmeticException.class, () -> Precision.round(v, scale, mode)), () -> rin + " should throw (documented)");
+                return;
+            }
+            double r = Precision.round(v, scale, mode);
+            BigDecimal expected = dec.setScale(scale, mode);
+            double ed = expected.doubleValue();
+            if (ed == 0) {
+                ed = Math.copySign(0.0, v);
+            }
+            final double fed = ed;
+            check(Double.doubleToLongBits(r) == Double.doubleToLongBits(fed), () -> rin + " = " + hx(r) + " expected " + hx(fed));
+            if (mode != RoundingMode.UNNECESSARY) {
+                check(Precision.round(r, scale, mode) == r, () -> rin + " = " + r + " is not idempotent: " + Precision.round(r, scale, mode));
+                check(Precision.round(v, scale) == Precision.round(v, scale, RoundingMode.HALF_UP) || mode != RoundingMode.HALF_UP, () -> "round(x, scale) is HALF_UP");
+                if (Math.abs(r) < 1e15 && r != 0) {
+                    BigDecimal rd = new BigDecimal(Double.toString(r)).stripTrailingZeros();
+                    check(rd.scale() <= Math.max(scale, 0) || scale < 0 && rd.scale() <= scale, () -> rin + " = " + r + " has more decimals than the scale");
+                }
+            }
+        });
+    }
