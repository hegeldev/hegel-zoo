+    static final BigInteger OVERFLOW = BigInteger.ONE.shiftLeft(31);
+
+    /**
+     * p/q is a convergent of x under the maximum denominator: q <= maxD and |x - p/q| < 1/q^2 (the search may also stop
+     * early when the next numerator would overflow an int, so the 1/(q maxDen) bound of the ideal algorithm is not required).
+     */
+    static void convergent(String in, Q q, BigDecimal xd, BigInteger maxD) {
+        check(q.den.compareTo(maxD) <= 0, () -> in + " exceeds the maximum denominator");
+        BigDecimal err = xd.subtract(q.dec()).abs();
+        BigDecimal bound = BigDecimal.ONE.divide(new BigDecimal(q.den.multiply(q.den)), MC);
+        check(err.compareTo(bound) < 0 || err.signum() == 0, () -> in + " is not a convergent: error " + err + " bound " + bound);
+    }
+
+    /** BigFraction.from(x, maxDen) returns (its parts are unbounded) a convergent under the maximum denominator. */
+    static void bigFractionConvergent(String in, double x, int maxDen) {
+        String what = "BigFraction.from(" + in + ", maxDen " + maxDen + ")";
+        BigFraction bf;
+        try {
+            bf = BigFraction.from(x, maxDen);
+        } catch (ArithmeticException ex) {
+            check(false, () -> what + " threw " + ex);
+            return;
+        }
+        convergent(what + " = " + bf, model(bf), new BigDecimal(x), BigInteger.valueOf(maxDen).abs());
+    }
+
+    /** from(x, eps, maxIter) of both types is within eps of x in exact arithmetic when it returns; a failure to converge is allowed. */
+    static void withinEpsilon(String in, double x, double eps, int maxIter) {
+        BigDecimal xd = new BigDecimal(x);
+        BigDecimal epsd = new BigDecimal(eps).multiply(BigDecimal.ONE.add(new BigDecimal("1e-9")));
+        try {
+            Fraction f = Fraction.from(x, eps, maxIter);
+            BigDecimal err = xd.subtract(model(f).dec()).abs();
+            check(err.compareTo(epsd) <= 0, () -> "Fraction.from(" + in + ", eps " + eps + ", " + maxIter + ") = " + f + " is off by " + err);
+        } catch (ArithmeticException ex) {
+            // failed to converge or overflow: allowed by the contract
+        }
+        try {
+            BigFraction f = BigFraction.from(x, eps, maxIter);
+            BigDecimal err = xd.subtract(model(f).dec()).abs();
+            check(err.compareTo(epsd) <= 0, () -> "BigFraction.from(" + in + ", eps " + eps + ", " + maxIter + ") = " + f + " is off by " + err);
+        } catch (ArithmeticException ex) {
+            // failed to converge: allowed by the contract
+        }
+    }
+
+    /** from(x, eps, maxIter) of both types rejects a non-positive eps with an IllegalArgumentException that names it (documented). */
+    static void rejectsEpsilon(String in, double x, double eps, int maxIter) {
+        String what = "from(" + in + ", eps " + eps + ", " + maxIter + ")";
+        try {
+            Fraction f = Fraction.from(x, eps, maxIter);
+            check(false, () -> "Fraction." + what + " = " + f + " accepted a non-positive epsilon");
+        } catch (IllegalArgumentException ex) {
+            check(String.valueOf(ex.getMessage()).contains(Double.toString(eps)), () -> "Fraction." + what + " does not name the epsilon: " + ex.getMessage());
+        } catch (ArithmeticException ex) {
+            check(false, () -> "Fraction." + what + " threw " + ex + " instead of IllegalArgumentException");
+        }
+        try {
+            BigFraction f = BigFraction.from(x, eps, maxIter);
+            check(false, () -> "BigFraction." + what + " = " + f + " accepted a non-positive epsilon");
+        } catch (IllegalArgumentException ex) {
+            check(String.valueOf(ex.getMessage()).contains(Double.toString(eps)), () -> "BigFraction." + what + " does not name the epsilon: " + ex.getMessage());
+        } catch (ArithmeticException ex) {
+            check(false, () -> "BigFraction." + what + " threw " + ex + " instead of IllegalArgumentException");
+        }
+    }
