+                Complex sq2 = w.pow(Complex.ofCartesian(2, 0));
+                double err2 = sq2.subtract(mul).abs() / mul.abs();
+                check(err2 <= 1e-13, () -> "pow(2+0i) of " + show(w) + " = " + show(sq2) + " vs multiply " + show(mul) + " rel err " + err2);
+                Complex half = w.pow(0.5);
+                Complex sqrt = w.sqrt();
+                double err3 = half.subtract(sqrt).abs() / sqrt.abs();
+                check(err3 <= 1e-13, () -> "pow(0.5) of " + show(w) + " = " + show(half) + " vs sqrt " + show(sqrt) + " rel err " + err3);
+                Complex q = w.divide(a);
+                if (a.isFinite() && a.getReal() != 0 && a.getImaginary() != 0 && q.isFinite() && a.abs() > 1e-100 && a.abs() < 1e100) {
+                    Complex round = q.multiply(a);
+                    double err4 = round.subtract(w).abs() / w.abs();
+                    check(err4 <= 1e-13, () -> "divide then multiply by " + show(a) + " of " + show(w) + " gave " + show(round) + " rel err " + err4);
+                }
+            }
+        });
+    }
