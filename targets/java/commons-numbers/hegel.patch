+    /** intValue and longValue are the floor (the Javadoc of both types: "the largest ... value that is not larger than this fraction"). */
+    static void floorOfIntAndLongValue(Fraction fa, BigFraction ba, Q a) {
+        BigInteger floor = a.floor();
+        check(BigInteger.valueOf(fa.intValue()).equals(floor.max(IMIN).min(IMAX)),
+            () -> "intValue (floor per the Javadoc): " + fa + " gave " + fa.intValue() + " floor " + floor);
+        check(BigInteger.valueOf(fa.longValue()).equals(floor),
+            () -> "longValue (floor per the Javadoc): " + fa + " gave " + fa.longValue() + " floor " + floor);
+        check(BigInteger.valueOf(ba.intValue()).equals(floor.max(IMIN).min(IMAX)),
+            () -> "BigFraction intValue: " + ba + " gave " + ba.intValue() + " floor " + floor);
+        check(BigInteger.valueOf(ba.longValue()).equals(floor),
+            () -> "BigFraction longValue: " + ba + " gave " + ba.longValue() + " floor " + floor);
+    }
+
+    /**
+     * A negative non-integer fraction (a random denominator above 1, a numerator that is not its multiple): intValue and
+     * longValue are the floor per the Javadoc, judged as fractionsAgreeWithBigIntegerRationals judges it (commons-numbers/1).
+     * Beside it (HEGEL_NO_KNOWN) the same fraction positive, where floor and truncation agree.
+     */
+    @Test
+    void intValueAndLongValueOfANegativeFractionAreTheFloor() {
+        property("intValueAndLongValueOfANegativeFractionAreTheFloor", tc -> {
+            int ad = n(tc, 2, 1_000_000);
+            int an = (Known.INT_VALUE_TRUNCATES ? 1 : -1) * (n(tc, 0, (Integer.MAX_VALUE - ad) / ad) * ad + n(tc, 1, ad - 1));
+            floorOfIntAndLongValue(Fraction.of(an, ad), BigFraction.of(an, ad), Q.of(an, ad));
+        });
+    }
+
+    interface Op<T> {
+        T run() throws Exception;
+    }
+
+    /** The shapes of commons-numbers/5: gcd(MIN_VALUE, MIN_VALUE) inside the reduction, or an overflowing numerator when the sign sits in the denominator. */
+    enum Spurious { MULTIPLY_INT, DIVIDE_INT, ADD, MULTIPLY, DIVIDE, ADD_INT, SUBTRACT_INT }
+
+    /** An odd int, so that a fraction with MIN_VALUE as its other part stays as given. */
+    static int odd(TestCase tc) {
+        return 2 * n(tc, -(1 << 30), (1 << 30) - 1) + 1;
+    }
+
+    /** {@link #arith} of an operation with an int argument (the second fraction is the first). */
+    static void intOp(String what, Fraction fa, BigFraction ba, Q expected, java.util.function.UnaryOperator<Fraction> f, java.util.function.UnaryOperator<BigFraction> bf) {
+        arith(what, fa, fa, ba, ba, expected, () -> f.apply(fa), () -> bf.apply(ba));
+    }
+
+    /**
+     * Fraction arithmetic whose exact result fits an int but whose reduction meets gcd(MIN_VALUE, MIN_VALUE) (an odd
+     * numerator or denominator next to MIN_VALUE on both sides of the operation) or whose intermediate numerator
+     * overflows because the sign sits in the denominator (k / -d plus or minus v with k + v d = 2^31, the value
+     * MIN_VALUE / d), judged by {@link #arith} as fractionsAgreeWithBigIntegerRationals judges it (commons-numbers/5).
+     * Beside it (HEGEL_NO_KNOWN) MAX_VALUE in place of MIN_VALUE and the sign in the numerator, where nothing overflows.
+     */
+    @Test
+    void fractionArithmeticWithMinValuePartsStaysRepresentable() {
+        property("fractionArithmeticWithMinValuePartsStaysRepresentable", tc -> {
+            Spurious shape = pick(tc, Spurious.values());
+            int min = Known.SPURIOUS_OVERFLOW ? Integer.MAX_VALUE : Integer.MIN_VALUE;
+            int k = odd(tc);
+            int j = odd(tc);
+            int d = 2 * n(tc, 0, 5000) + 1;
+            int sd = Known.SPURIOUS_OVERFLOW ? d : -d;
+            int v = n(tc, 1, Integer.MAX_VALUE / d);
+            int k2 = (int) ((1L << 31) - (long) v * d);
+            switch (shape) {
+                case MULTIPLY_INT -> intOp("multiply(int " + min + ")", Fraction.of(k, min), BigFraction.of(k, min), Q.of(k, min).mul(Q.ofInt(min)), x -> x.multiply(min), x -> x.multiply(min));
+                case DIVIDE_INT -> intOp("divide(int " + min + ")", Fraction.of(min, k), BigFraction.of(min, k), Q.of(min, k).div(Q.ofInt(min)), x -> x.divide(min), x -> x.divide(min));
+                case ADD -> {
+                    Fraction fa = Fraction.of(k, min);
+                    Fraction fb = Fraction.of(j, min);
+                    BigFraction ba = BigFraction.of(k, min);
+                    BigFraction bb = BigFraction.of(j, min);
+                    arith("add", fa, fb, ba, bb, Q.of(k, min).add(Q.of(j, min)), () -> fa.add(fb), () -> ba.add(bb));
+                }
+                case MULTIPLY -> {
+                    Fraction fa = Fraction.of(min, k);
+                    Fraction fb = Fraction.of(j, min);
+                    BigFraction ba = BigFraction.of(min, k);
+                    BigFraction bb = BigFraction.of(j, min);
+                    arith("multiply", fa, fb, ba, bb, Q.of(min, k).mul(Q.of(j, min)), () -> fa.multiply(fb), () -> ba.multiply(bb));
+                }
+                case DIVIDE -> {
+                    Fraction fa = Fraction.of(min, k);
+                    Fraction fb = Fraction.of(min, j);
+                    BigFraction ba = BigFraction.of(min, k);
+                    BigFraction bb = BigFraction.of(min, j);
+                    arith("divide", fa, fb, ba, bb, Q.of(min, k).div(Q.of(min, j)), () -> fa.divide(fb), () -> ba.divide(bb));
+                }
+                case ADD_INT -> intOp("add(int " + -v + ")", Fraction.of(k2, sd), BigFraction.of(k2, sd), Q.of(k2, sd).add(Q.ofInt(-v)), x -> x.add(-v), x -> x.add(-v));
+                case SUBTRACT_INT -> intOp("subtract(int " + v + ")", Fraction.of(k2, sd), BigFraction.of(k2, sd), Q.of(k2, sd).sub(Q.ofInt(v)), x -> x.subtract(v), x -> x.subtract(v));
+                default -> throw new IllegalStateException(shape.toString());
+            }
+        });
+    }
+
+    static void arith(String what, Fraction fa, Fraction fb, BigFraction ba, BigFraction bb, Q expected, Op<Fraction> f, Op<BigFraction> bf) {
+        String in = what + " on " + fa + " and " + fb;
+        if (expected.fitsInt()) {
+            Fraction r;
+            try {
+                r = f.run();
+            } catch (Exception ex) {
+                // Known.SPURIOUS_OVERFLOW (commons-numbers/5): gcd(MIN_VALUE, MIN_VALUE) inside the arithmetic, or a
+                // numerator overflowing because the sign sits in the denominator, throws for a representable result
+                boolean shape = Known.SPURIOUS_OVERFLOW && ex instanceof ArithmeticException
+                    && (fa.getDenominator() < 0 || fb.getDenominator() < 0 || fa.getNumerator() == Integer.MIN_VALUE
+                        || fb.getNumerator() == Integer.MIN_VALUE || what.contains("int " + Integer.MIN_VALUE));
+                if (!shape) {
+                    check(false, () -> in + " threw " + ex + " expected " + expected);
+                }
+                return;
+            }
+            check(model(r).equals(expected), () -> in + " gave " + r + " expected " + expected);
+        } else if (expected.fitsIntNegated()) {
+            negatedForm(in, expected, f);
+        } else {
+            check(throwsA(ArithmeticException.class, f::run), () -> in + " should overflow (expected " + expected + ")");
+        }
+        BigFraction br;
+        try {
+            br = bf.run();
+        } catch (Exception ex) {
+            check(false, () -> "BigFraction " + in + " threw " + ex);
+            return;
+        }
+        check(model(br).equals(expected), () -> "BigFraction " + in + " gave " + br + " expected " + expected);
+    }
+
+    /**
+     * A result representable only as -n / MIN_VALUE (see {@link Q#fitsInt}): the natural form overflows, so the
+     * operation may throw, or keep the sign in the denominator and return the value (negate and pow(1) of
+     * 1 / MIN_VALUE give -1 / -2147483648 and 1 / -2147483648, the reciprocal of MIN_VALUE / 3 gives 3 / -2147483648).
+     * Either is accepted.
+     */
+    static void negatedForm(String in, Q expected, Op<Fraction> f) {
+        try {
+            Fraction r = f.run();
+            check(model(r).equals(expected), () -> in + " gave " + r + " expected " + expected);
+        } catch (ArithmeticException ex) {
+            // overflow of the natural form; acceptable
+        } catch (Exception ex) {
+            check(false, () -> in + " threw " + ex + " expected " + expected + " or an ArithmeticException");
+        }
+    }
+
+    @Test
+    void fractionsFromDoublesMeetTheirBounds() {
