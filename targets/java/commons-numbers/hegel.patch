+    // --------------------------------------------------------------------------------------------- combinatorics
+
+    static BigInteger binom(int n, int k) {
+        BigInteger r = BigInteger.ONE;
+        for (int i = 1; i <= k; i++) {
+            r = r.multiply(BigInteger.valueOf(n - k + i)).divide(BigInteger.valueOf(i));
+        }
+        return r;
+    }
+
+    static BigInteger fact(int n) {
+        BigInteger r = BigInteger.ONE;
+        for (int i = 2; i <= n; i++) {
+            r = r.multiply(BigInteger.valueOf(i));
+        }
+        return r;
+    }
+
+    /** Signed Stirling numbers of the first kind s(n, k): s(n, k) = s(n-1, k-1) - (n-1) s(n-1, k). */
+    static BigInteger stirling1(int n, int k) {
+        BigInteger[] row = new BigInteger[n + 1];
+        Arrays.fill(row, BigInteger.ZERO);
+        row[0] = BigInteger.ONE;
+        for (int i = 1; i <= n; i++) {
+            for (int j = i; j >= 1; j--) {
+                row[j] = row[j - 1].subtract(BigInteger.valueOf(i - 1).multiply(row[j]));
+            }
+            row[0] = BigInteger.ZERO;
+        }
+        return row[k];
+    }
+
+    /** Stirling numbers of the second kind S(n, k) = k S(n-1, k) + S(n-1, k-1). */
+    static BigInteger stirling2(int n, int k) {
+        BigInteger[] row = new BigInteger[n + 1];
+        Arrays.fill(row, BigInteger.ZERO);
+        row[0] = BigInteger.ONE;
+        for (int i = 1; i <= n; i++) {
+            for (int j = i; j >= 1; j--) {
+                row[j] = BigInteger.valueOf(j).multiply(row[j]).add(row[j - 1]);
+            }
+            row[0] = BigInteger.ZERO;
+        }
+        return row[k];
+    }
+
+    static boolean fitsLong(BigInteger b) {
+        return b.compareTo(LMIN) >= 0 && b.compareTo(LMAX) <= 0;
+    }
