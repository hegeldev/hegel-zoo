+    // ---------------------------------------------------------------------------------------------------- DD
+
+    static BigDecimal value(DD d) {
+        return new BigDecimal(d.hi()).add(new BigDecimal(d.lo()));
+    }
+
+    /** A normalised double-double of ordinary magnitude. */
+    static DD dd(TestCase tc) {
+        double hi = chance(tc, 80) ? G.bits(tc, 1023 - 100, 1023 + 100) : pick(tc, 1.0, -1.0, 0.5, 2.0, 3.0, 1e100, 1e-100, 0.1, 10.0);
+        double lo = chance(tc, 80) ? hi * Math.scalb(G.in(tc, -1, 1), -53) : 0.0;
+        return DD.ofSum(hi, lo);
+    }
+
+    /** 2^e as an exact BigDecimal. */
+    static BigDecimal pow2(long e) {
+        BigDecimal p = new BigDecimal(java.math.BigInteger.ONE.shiftLeft((int) Math.abs(e)));
+        return e >= 0 ? p : BigDecimal.ONE.divide(p);
+    }
+
+    static void within(String in, DD got, BigDecimal exact, double epsMultiple) {
+        if (exact.abs().compareTo(MAX) > 0 || exact.signum() != 0 && exact.abs().compareTo(new BigDecimal("1e-290")) < 0) {
+            return; // overflow or underflow of the parts: not supported (isFinite documents the check)
+        }
+        if (!got.isFinite()) {
+            check(false, () -> in + " = " + got + " is not finite (exact " + exact.round(new MathContext(30)) + ")");
+            return;
+        }
+        BigDecimal v = value(got);
+        BigDecimal err = v.subtract(exact).abs();
+        if (exact.signum() == 0) {
+            check(err.signum() == 0, () -> in + " = " + got + " expected exactly 0");
+            return;
+        }
+        BigDecimal rel = err.divide(exact.abs(), MC);
+        BigDecimal bound = EPS106.multiply(BigDecimal.valueOf(epsMultiple));
+        check(rel.compareTo(bound) <= 0, () -> in + " = " + got + " relative error " + rel.round(new MathContext(5)) + " exceeds " + epsMultiple + " eps (2^-106); exact " + exact.round(new MathContext(40)));
+    }
+
+    @Test
+    void doubleDoubleArithmeticStaysWithinItsBounds() {
+        property("doubleDoubleArithmeticStaysWithinItsBounds", tc -> {
+            DD a = dd(tc);
+            DD b = dd(tc);
+            double y = chance(tc, 80) ? G.bits(tc, 1023 - 100, 1023 + 100) : pick(tc, 1.0, -1.0, 2.0, 0.5, 3.0, 0.0);
+            BigDecimal av = value(a);
+            BigDecimal bv = value(b);
+            BigDecimal yv = new BigDecimal(y);
+            String in = " of " + a + " (" + av.round(new MathContext(40)) + ")";
+
+            // exact factories
+            double p = a.hi();
+            double q = b.hi();
+            check(value(DD.ofSum(p, q)).compareTo(new BigDecimal(p).add(new BigDecimal(q))) == 0, () -> "ofSum(" + hx(p) + ", " + hx(q) + ") = " + DD.ofSum(p, q) + " is not exact");
+            check(value(DD.ofDifference(p, q)).compareTo(new BigDecimal(p).subtract(new BigDecimal(q))) == 0, () -> "ofDifference(" + hx(p) + ", " + hx(q) + ") is not exact");
+            check(value(DD.ofProduct(p, q)).compareTo(new BigDecimal(p).multiply(new BigDecimal(q))) == 0, () -> "ofProduct(" + hx(p) + ", " + hx(q) + ") = " + DD.ofProduct(p, q) + " is not exact");
+            check(value(DD.ofSquare(p)).compareTo(new BigDecimal(p).multiply(new BigDecimal(p))) == 0, () -> "ofSquare(" + hx(p) + ") is not exact");
+            if (q != 0) {
+                within("fromQuotient(" + hx(p) + ", " + hx(q) + ")", DD.fromQuotient(p, q), new BigDecimal(p).divide(new BigDecimal(q), MC), 1);
+            }
+            check(DD.of(p).add(q).equals(DD.ofSum(p, q)), () -> "DD.of(x).add(y) vs ofSum for " + hx(p) + ", " + hx(q) + ": " + DD.of(p).add(q) + " vs " + DD.ofSum(p, q));
+            check(DD.of(p).subtract(q).equals(DD.ofDifference(p, q)), () -> "DD.of(x).subtract(y) vs ofDifference for " + hx(p) + ", " + hx(q));
+            check(DD.of(p).multiply(q).equals(DD.ofProduct(p, q)), () -> "DD.of(x).multiply(y) vs ofProduct for " + hx(p) + ", " + hx(q) + ": " + DD.of(p).multiply(q) + " vs " + DD.ofProduct(p, q));
+            long l = G.anyLong(tc);
+            check(value(DD.of(l)).compareTo(new BigDecimal(l)) == 0, () -> "DD.of(" + l + "L) = " + DD.of(l));
+            check(value(DD.ofUnsigned(l)).compareTo(new BigDecimal(Long.toUnsignedString(l))) == 0, () -> "DD.ofUnsigned(" + l + "L) = " + DD.ofUnsigned(l));
+
+            // arithmetic within the documented eps multiples
+            within("add(DD " + b + ")" + in, a.add(b), av.add(bv), 4);
+            within("add(double " + hx(y) + ")" + in, a.add(y), av.add(yv), 4);
+            within("subtract(DD " + b + ")" + in, a.subtract(b), av.subtract(bv), 4);
+            within("subtract(double " + hx(y) + ")" + in, a.subtract(y), av.subtract(yv), 4);
+            within("multiply(DD " + b + ")" + in, a.multiply(b), av.multiply(bv), 4);
+            within("multiply(double " + hx(y) + ")" + in, a.multiply(y), av.multiply(yv), 4);
+            int k = n(tc, -1000, 1000);
+            within("multiply(int " + k + ")" + in, a.multiply(k), av.multiply(BigDecimal.valueOf(k)), 4);
+            within("square()" + in, a.square(), av.multiply(av), 4);
+            within("divide(DD " + b + ")" + in, a.divide(b), av.divide(bv, MC), 4);
+            if (y != 0) {
+                within("divide(double " + hx(y) + ")" + in, a.divide(y), av.divide(yv, MC), 4);
+            }
+            within("reciprocal()" + in, a.reciprocal(), BigDecimal.ONE.divide(av, MC), 4);
+            if (av.signum() > 0) {
+                within("sqrt()" + in, a.sqrt(), av.sqrt(MC), 4);
+            }
+            int e = n(tc, -6, 8);
+            BigDecimal pw = e >= 0 ? av.pow(e, MC) : BigDecimal.ONE.divide(av.pow(-e, MC), MC);
+            // intermediates of pow must stay clear of the split-safe limits (|x| < 6.7e299, parts above the subnormals)
+            if (pw.abs().compareTo(new BigDecimal("1e250")) < 0 && pw.abs().compareTo(new BigDecimal("1e-250")) > 0) {
+                within("pow(" + e + ")" + in, a.pow(e), pw, 16 * Math.max(1, Math.abs(e) - 1) + 4);
+                long[] exp = new long[1];
+                DD f = a.pow(e, exp);
+                BigDecimal scaled = value(f).multiply(pow2(exp[0]));
+                check(f.hi() != 0 || pw.signum() == 0, () -> "pow(" + e + ", exp)" + in + " gave a zero fraction");
+                BigDecimal rel = scaled.subtract(pw).abs().divide(pw.abs(), MC);
+                check(rel.compareTo(EPS106.multiply(BigDecimal.valueOf(16 * Math.max(1, Math.abs(e) - 1) + 4))) <= 0,
+                    () -> "pow(" + e + ", exp)" + in + " = " + f + " * 2^" + exp[0] + " relative error " + rel.round(new MathContext(5)));
+                double fa = Math.abs(f.hi() + f.lo());
