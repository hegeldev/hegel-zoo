+            arith("subtract(int " + c + ")", fa, fb, ba, bb, a.sub(qc), () -> fa.subtract(c), () -> ba.subtract(c));
+            arith("multiply(int " + c + ")", fa, fb, ba, bb, a.mul(qc), () -> fa.multiply(c), () -> ba.multiply(c));
+            if (c == 0) {
