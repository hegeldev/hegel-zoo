+            double fra = Math.abs(fr.hi() + fr.lo());
+            check(fra >= 0.5 && fra < 1 || Math.abs(fr.hi()) == 1 && fr.lo() != 0 && Math.signum(fr.hi()) != Math.signum(fr.lo()), () -> "frexp" + in + " fraction " + fr + " not in [0.5, 1)");
