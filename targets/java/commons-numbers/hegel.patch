+++ b/hegel/src/test/java/zoo/Known.java
@@ -0,0 +1,66 @@
+package zoo;
+
+/**
+ * Switches for the recorded bugs (bugs.toml). A property skips the shape a switch names while the switch is on; the
+ * pin for the bug (CommonsNumbersPinsTest) asserts the correct behaviour and fails until upstream fixes it.
+ */
+final class Known {
+    private Known() {}
+
+    /** commons-numbers/1: Fraction/BigFraction intValue and longValue truncate towards zero; the Javadoc promises the floor. */
+    static final boolean INT_VALUE_TRUNCATES = true;
+
+    /** commons-numbers/2: Complex.log and Complex.sqrt overflow to infinity when one part is huge and the other subnormal. */
+    static final boolean LOG_SQRT_OVERFLOW_WITH_SUBNORMAL_PART = true;
+
+    /** commons-numbers/3: Complex.exp returns infinity for a part whose exact value is finite when the real part exceeds 709. */
+    static final boolean EXP_OVERFLOWS_A_FINITE_PART = true;
+
+    /** commons-numbers/4: Complex.nthRoot(Integer.MIN_VALUE) returns an empty list. */
+    static final boolean NTH_ROOT_OF_MIN_VALUE_IS_EMPTY = true;
+
+    /** commons-numbers/5: Fraction arithmetic throws ArithmeticException for representable results (gcd(MIN, MIN), sign in the denominator). */
+    static final boolean SPURIOUS_OVERFLOW = true;
+
+    /** commons-numbers/6: Digamma has no pole handling at the negative integers. */
+    static final boolean DIGAMMA_IGNORES_POLES = true;
+
+    /** commons-numbers/7: Digamma and Trigamma lose their 1e-8 accuracy for large negative arguments (reflection without argument reduction). */
+    static final boolean REFLECTION_WITHOUT_ARGUMENT_REDUCTION = true;
+
+    /** commons-numbers/8: Combinations.comparator() overflows its lexicographic norm for large n. */
+    static final boolean COMPARATOR_OVERFLOWS = true;
+
+    /** commons-numbers/9: LogFactorial.value depends on the cache size. */
+    static final boolean LOG_FACTORIAL_DEPENDS_ON_THE_CACHE = true;
+
+    /** commons-numbers/10: Reduce returns values outside [0, period) (negative for large |x|, the period itself for tiny negative x). */
+    static final boolean REDUCE_LEAVES_ITS_INTERVAL = true;
+
+    /** commons-numbers/11: the Angle normalizers return values below the lower bound for large |x|. */
+    static final boolean NORMALIZER_BELOW_LOWER_BOUND = true;
+
+    /** commons-numbers/12: CosAngle does not scale the dot product (0 for tiny vectors, infinity for large ones). */
+    static final boolean COS_ANGLE_UNSCALED = true;
+
+    /** commons-numbers/13: Sum never returns -0.0. */
+    static final boolean SUM_DROPS_NEGATIVE_ZERO = true;
+
+    /** commons-numbers/14: Precision.round throws ArithmeticException for extreme scales. */
+    static final boolean ROUND_THROWS_FOR_EXTREME_SCALES = true;
+
+    /**
+     * Not a recorded bug: DoubleEquivalence.compare orders NaN with Double.compare semantics (as compareTo documents) while the
+     * interface Javadoc says "+1 if either value is NaN"; the property follows the implementation and Precision.compareTo.
+     */
+    static final boolean DOUBLE_EQUIVALENCE_NAN_ORDER = true;
+
+    /** commons-numbers/15: BigFraction.from(double, epsilon, maxIterations) and from(double, maxDenominator) refuse |value| > 2^31. */
+    static final boolean BIG_FRACTION_FROM_IS_LIMITED_TO_INTS = true;
+
+    /** commons-numbers/16: Fraction/BigFraction.from(value, 0.0, n) is accepted although the Javadoc promises an exception; the message prints maxIterations. */
+    static final boolean FROM_ACCEPTS_EPSILON_ZERO = true;
+
+    /** commons-numbers/17: from(value, epsilon, maxIterations) tests convergence in double arithmetic, so an epsilon below ulp(value) is not honoured. */
+    static final boolean FROM_EPSILON_BELOW_ULP_IS_NOT_HONOURED = true;
+}
diff --git a/hegel/src/test/java/zoo/Oracle.java b/hegel/src/test/java/zoo/Oracle.java
new file mode 100644
index 0000000..5427e97
--- /dev/null
+++ b/hegel/src/test/java/zoo/Oracle.java
@@ -0,0 +1,199 @@
+package zoo;
+
+import java.io.BufferedReader;
+import java.io.IOException;
+import java.io.InputStreamReader;
+import java.io.OutputStreamWriter;
+import java.io.Writer;
+import java.math.BigDecimal;
+import java.math.MathContext;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.Paths;
+
+/**
+ * The mpmath child process (hegel/oracle.py): arbitrary-precision reference values for the special functions and
+ * the complex elementary functions. Arguments travel as hex floats, results come back as 40-digit decimals.
+ */
+final class Oracle {
+    private Oracle() {}
+
+    /** A reply: the decimal strings, their double roundings, or an error text from the Python side. */
+    record Reply(String[] raw, double[] v, String error) {
+        boolean ok() {
+            return error == null;
+        }
+
+        BigDecimal exact(int i) {
+            return parse(raw[i]);
+        }
+
+        double d(int i) {
+            return v[i];
+        }
+    }
+
+    private static Process proc;
+    private static Writer in;
+    private static BufferedReader out;
+
+    private static synchronized void start() {
+        if (proc != null && proc.isAlive()) {
+            return;
+        }
+        String python = System.getenv("ZOO_PYTHON");
+        if (python == null || python.isEmpty() || !Files.isExecutable(Paths.get(python))) {
+            python = "python3";
+        }
+        Path script = Paths.get("oracle.py");
+        if (!Files.exists(script)) {
+            script = Paths.get("hegel", "oracle.py");
+        }
+        try {
+            proc = new ProcessBuilder(python, script.toAbsolutePath().toString())
+                .redirectError(ProcessBuilder.Redirect.INHERIT)
+                .start();
+            in = new OutputStreamWriter(proc.getOutputStream(), StandardCharsets.UTF_8);
+            out = new BufferedReader(new InputStreamReader(proc.getInputStream(), StandardCharsets.UTF_8));
+            in.write("ping\n");
+            in.flush();
+            String pong = out.readLine();
+            if (pong == null || !pong.startsWith("pong")) {
+                throw new IllegalStateException("oracle.py did not answer: " + pong);
+            }
+        } catch (IOException e) {
+            throw new IllegalStateException("cannot start " + python + " oracle.py", e);
+        }
+    }
+
+    static synchronized Reply call(String op, double... args) {
+        start();
+        StringBuilder sb = new StringBuilder(op);
+        for (double a : args) {
+            sb.append('\t').append(hex(a));
+        }
+        sb.append('\n');
+        try {
+            in.write(sb.toString());
+            in.flush();
+            String line = out.readLine();
+            if (line == null) {
+                throw new IllegalStateException("oracle.py died on " + sb);
+            }
+            if (line.startsWith("err")) {
+                return new Reply(new String[0], new double[0], line.substring(3).trim());
+            }
+            String[] raw = line.split("\t");
+            double[] v = new double[raw.length];
+            for (int i = 0; i < raw.length; i++) {
+                v[i] = toDouble(raw[i]);
+            }
+            return new Reply(raw, v, null);
+        } catch (IOException e) {
+            throw new IllegalStateException("oracle.py i/o", e);
+        }
+    }
+
+    /** One real result, correctly rounded to double. */
+    static double real(String op, double... args) {
+        Reply r = call(op, args);
+        if (!r.ok()) {
+            return Double.NaN;
+        }
+        return r.d(0);
+    }
+
+    static String hex(double a) {
+        if (Double.isNaN(a)) {
+            return "nan";
+        }
+        if (Double.isInfinite(a)) {
+            return a > 0 ? "inf" : "-inf";
+        }
+        return Double.toHexString(a);
+    }
+
+    static double toDouble(String s) {
+        switch (s) {
+            case "nan":
+                return Double.NaN;
+            case "inf":
+                return Double.POSITIVE_INFINITY;
+            case "-inf":
+                return Double.NEGATIVE_INFINITY;
+            default:
+                BigDecimal b = parse(s);
+                return b != null ? b.doubleValue() : hugeExponent(s);
+        }
+    }
+
+    /** A decimal whose exponent does not fit BigDecimal: the double it rounds to (zero or an infinity). */
+    static double hugeExponent(String s) {
+        boolean negative = s.startsWith("-");
+        int e = s.indexOf('e');
+        boolean tiny = e >= 0 && s.charAt(e + 1) == '-';
+        if (tiny) {
+            return negative ? -0.0 : 0.0;
+        }
+        return negative ? Double.NEGATIVE_INFINITY : Double.POSITIVE_INFINITY;
+    }
+
+    static BigDecimal parse(String s) {
+        switch (s) {
+            case "nan":
+            case "inf":
+            case "-inf":
+                return null;
+            default:
+                try {
+                    return new BigDecimal(s);
+                } catch (NumberFormatException ex) {
+                    double d = hugeExponent(s);
+                    return d == 0 ? new BigDecimal(d) : null;
+                }
+        }
+    }
+
+    /**
+     * Distance in ulps between an actual double and an exact expected value (ulps of the expected value's double
+     * rounding); infinite when one is finite and the other not, 0 when both are the same infinity.
+     */
+    static double ulps(double actual, String expectedRaw) {
+        BigDecimal e = parse(expectedRaw);
+        if (e == null) {
+            double ed = toDouble(expectedRaw);
+            if (Double.isNaN(ed)) {
+                return Double.isNaN(actual) ? 0 : Double.POSITIVE_INFINITY;
+            }
+            return actual == ed ? 0 : Double.POSITIVE_INFINITY;
+        }
+        return ulps(actual, e);
+    }
+
+    static double ulps(double actual, BigDecimal expected) {
+        if (Double.isNaN(actual) || Double.isInfinite(actual)) {
+            double ed = expected.doubleValue();
+            if (Double.isInfinite(ed) && ed == actual) {
+                return 0;
+            }
+            return Double.POSITIVE_INFINITY;
+        }
+        double ed = expected.doubleValue();
+        double ulp = Math.ulp(ed == 0 ? Double.MIN_VALUE : ed);
+        BigDecimal diff = new BigDecimal(actual).subtract(expected).abs();
+        return diff.divide(new BigDecimal(ulp), MathContext.DECIMAL64).doubleValue();
+    }
+
+    /** Relative error |actual - expected| / |expected| (absolute error when expected is 0). */
+    static double relErr(double actual, BigDecimal expected) {
+        if (Double.isNaN(actual) || Double.isInfinite(actual)) {
+            return Double.POSITIVE_INFINITY;
+        }
+        BigDecimal diff = new BigDecimal(actual).subtract(expected).abs();
+        if (expected.signum() == 0) {
+            return diff.doubleValue();
+        }
+        return diff.divide(expected.abs(), MathContext.DECIMAL64).doubleValue();
+    }
+}
diff --git a/hegel/src/test/java/zoo/Zoo.java b/hegel/src/test/java/zoo/Zoo.java
new file mode 100644
index 0000000..5174c6e
--- /dev/null
+++ b/hegel/src/test/java/zoo/Zoo.java
@@ -0,0 +1,162 @@
+package zoo;
+
+import dev.hegel.Database;
+import dev.hegel.Generators;
+import dev.hegel.Settings;
+import dev.hegel.TestCase;
+import java.util.LinkedHashSet;
+import java.util.Set;
+import java.util.function.Supplier;
+
+/**
+ * Hegel zoo harness. {@link #settings} reads {@code HEGEL_TEST_CASES} and {@code HEGEL_DATABASE}
+ * (hegel-java itself reads no environment variable); {@link #fail} throws, or under
+ * {@code ZOO_COLLECT=1} prints a {@code COLLECT <message>} line once per distinct message and
+ * lets the test case go on, so one run shows every kind of mismatch at once.
+ */
+final class Zoo {
+    private Zoo() {}
+
+    static final boolean COLLECT = notEmpty(System.getenv("ZOO_COLLECT"));
+    private static final Set<String> SEEN = new LinkedHashSet<>();
+
+    static Settings settings(String name) {
+        Settings s = new Settings().name(name).testCases(testCases());
+        String db = System.getenv("HEGEL_DATABASE");
+        if (notEmpty(db)) {
+            s = s.database(Database.path(db));
+        }
+        return s;
+    }
+
+    static long testCases() {
+        String n = System.getenv("HEGEL_TEST_CASES");
+        return notEmpty(n) ? Long.parseLong(n.trim()) : 100;
+    }
+
+    static void fail(String msg) {
+        if (COLLECT) {
+            String key = msg.length() > 300 ? msg.substring(0, 300) : msg;
+            if (SEEN.add(key)) {
+                System.out.println("COLLECT " + msg.replace('\n', '\u23ce'));
+                System.out.flush();
+            }
+            return;
+        }
+        throw new AssertionError(msg);
+    }
+
+    static void check(boolean ok, Supplier<String> msg) {
+        if (!ok) {
+            fail(msg.get());
+        }
+    }
+
+    static void check(boolean ok, String msg) {
+        if (!ok) {
+            fail(msg);
+        }
+    }
+
+    /** An int in [lo, hi]. */
+    static int n(TestCase tc, int lo, int hi) {
+        return tc.draw(Generators.integers().min(lo).max(hi));
+    }
+
+    /** A long in [lo, hi]. */
+    static long ln(TestCase tc, long lo, long hi) {
+        return tc.draw(Generators.longs().min(lo).max(hi));
+    }
+
+    static boolean chance(TestCase tc, int pct) {
+        return n(tc, 0, 99) < pct;
+    }
+
+    @SafeVarargs
+    static <T> T pick(TestCase tc, T... xs) {
+        return tc.draw(Generators.sampledFrom(xs));
+    }
+
+    /** A string of lo..hi characters drawn from the alphabet. */
+    static String word(TestCase tc, String alphabet, int lo, int hi) {
+        int len = n(tc, lo, hi);
+        StringBuilder sb = new StringBuilder();
+        for (int i = 0; i < len; i++) {
+            sb.append(alphabet.charAt(n(tc, 0, alphabet.length() - 1)));
+        }
+        return sb.toString();
+    }
+
+    /** A readable rendering of a value: strings quoted with unprintables escaped, null as "null". */
+    static String show(Object o) {
+        if (o == null) {
+            return "null";
+        }
+        if (o instanceof String s) {
+            StringBuilder sb = new StringBuilder("\"");
+            for (int i = 0; i < s.length(); i++) {
+                char c = s.charAt(i);
+                if (c == '"' || c == '\\') {
+                    sb.append('\\').append(c);
+                } else if (c < 0x20 || c == 0x7f || (c >= 0xd800 && c <= 0xdfff) || c == '\u2028' || c == '\u2029') {
+                    sb.append(String.format("\\u%04x", (int) c));
+                } else {
+                    sb.append(c);
+                }
+            }
+            return sb.append('"').toString();
+        }
+        String s = o.toString();
+        if (o instanceof Number || o instanceof Boolean) {
+            return s + " (" + o.getClass().getSimpleName() + ")";
+        }
+        return s.length() > 400 ? s.substring(0, 400) + "…" : s;
+    }
+
+    private static boolean notEmpty(String s) {
+        return s != null && !s.isEmpty();
+    }
+
+    /** Rethrows any throwable unchecked (for control-flow exceptions such as Hegel's that must not be swallowed). */
+    @SuppressWarnings("unchecked")
+    /** Broad catch blocks must let Hegel's own stop signal through. */
+    static void rethrowStop(Throwable t) {
+        if (t instanceof RuntimeException r && t.getClass().getName().equals("dev.hegel.StopTest")) {
+            throw r;
+        }
+    }
+
+    static <T extends Throwable> void sneaky(Throwable t) throws T {
+        throw (T) t;
+    }
+
+    /** A property body that may throw checked exceptions. */
+    interface Body {
+        void run(TestCase tc) throws Exception;
+    }
+
+    /** Runs {@code body} as a Hegel property named {@code name}; checked exceptions escape as they are. */
+    static void property(String name, Body body) {
+        dev.hegel.Hegel.test(tc -> {
+            try {
+                body.run(tc);
+            } catch (Exception e) {
+                Zoo.<RuntimeException>sneaky(e);
+            }
+        }, settings(name));
+    }
+
+    /** Whether {@code t} throws an instance of {@code type} (or, with {@code type} null, anything at all). */
+    static boolean throwsA(Class<? extends Throwable> type, Body0 t) {
+        try {
+            t.run();
+            return false;
+        } catch (Throwable e) {
+            return type == null || type.isInstance(e);
+        }
+    }
+
+    interface Body0 {
+        void run() throws Exception;
+    }
+}
diff --git a/hegel/src/test/java/zoo/ZooListener.java b/hegel/src/test/java/zoo/ZooListener.java
