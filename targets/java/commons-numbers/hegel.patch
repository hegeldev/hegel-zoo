+    @Test
+    void incompleteGammaAndBetaAgreeWithMpmath() {
+        property("incompleteGammaAndBetaAgreeWithMpmath", tc -> {
+            double a = chance(tc, 70) ? G.logUniform(tc, -3, 2.5) : pick(tc, 1.0, 2.0, 0.5, 1.5, 10.0, 100.0, 1e-10, 300.0, 0.25);
+            double x = chance(tc, 70) ? G.logUniform(tc, -3, 3) : pick(tc, 0.0, 1.0, a, a / 2, 2 * a, 1e-300, 700.0, 0.6, 1e-10);
+            String in = "(a = " + hx(a) + ", x = " + hx(x) + ")";
+            double p = RegularizedGamma.P.value(a, x);
+            double q = RegularizedGamma.Q.value(a, x);
+            check(p >= 0 && p <= 1 && q >= 0 && q <= 1, () -> "P/Q" + in + " = " + p + ", " + q + " outside [0, 1]");
+            check(Math.abs(p + q - 1) <= 4e-16 || Math.abs(p + q - 1) <= 1e-15, () -> "P + Q" + in + " = " + (p + q));
+            agreeWith("P" + in, p, Oracle.call("gamma_p", a, x), 4096, 1e-300);
+            agreeWith("Q" + in, q, Oracle.call("gamma_q", a, x), 4096, 1e-300);
+            double lower = IncompleteGamma.Lower.value(a, x);
+            double upper = IncompleteGamma.Upper.value(a, x);
+            agreeWith("IncompleteGamma.Lower" + in, lower, Oracle.call("gamma_lower", a, x), 4096, 1e-300);
+            agreeWith("IncompleteGamma.Upper" + in, upper, Oracle.call("gamma_upper", a, x), 4096, 1e-300);
+            double ga = Gamma.value(a);
+            if (Double.isFinite(ga) && ga > 1e-300 && ga < 1e300) {
+                double rel = Math.abs(lower + upper - ga) / ga;
+                check(rel <= 1e-13, () -> "lower + upper" + in + " = " + (lower + upper) + " vs Gamma(a) = " + ga);
+            }
+            double dp = RegularizedGamma.P.derivative(a, x);
+            double dq = RegularizedGamma.Q.derivative(a, x);
+            check(Double.doubleToLongBits(dp) == Double.doubleToLongBits(-dq) || dp == 0 && dq == 0, () -> "P' and Q'" + in + " = " + dp + ", " + dq);
+            agreeWith("P.derivative" + in, dp, Oracle.call("gamma_p_deriv", a, x), 4096, 1e-300);
+            // the epsilon/maxIterations overloads agree with the defaults for a generous budget
+            double p2 = RegularizedGamma.P.value(a, x, 1e-15, 100_000);
+            check(Math.abs(p2 - p) <= 1e-13 * Math.max(p, 1e-300) || Math.abs(p2 - p) <= 1e-300, () -> "P" + in + " with an explicit policy " + p2 + " vs " + p);
+
+            // beta family
+            double b = chance(tc, 70) ? G.logUniform(tc, -2, 2.5) : pick(tc, 1.0, 2.0, 0.5, a, 10.0, 100.0, 1e-8, 300.0);
+            double t0 = chance(tc, 70) ? G.in(tc, 0, 1) : pick(tc, 0.0, 1.0, 0.5, 1e-300, 1e-10, 1 - 1e-10, a / (a + b));
+            // commons-numbers/25's shape: a subnormal x (the Lanczos power terms round in the subnormal range); with
+            // Known.REGULARIZED_BETA_INACCURATE_FOR_SUBNORMAL_X on, the beta family is judged from 2^-1020
+            double t = Known.REGULARIZED_BETA_INACCURATE_FOR_SUBNORMAL_X && t0 > 0 && t0 < Double.MIN_NORMAL ? 0x1.0p-1020 : t0;
+            String bin = "(x = " + hx(t) + ", a = " + hx(a) + ", b = " + hx(b) + ")";
+            double ib = RegularizedBeta.value(t, a, b);
+            double ibc = RegularizedBeta.complement(t, a, b);
+            check(ib >= 0 && ib <= 1 && ibc >= 0 && ibc <= 1, () -> "RegularizedBeta" + bin + " = " + ib + ", " + ibc + " outside [0, 1]");
+            // a = b = 1/2 towards either end is commons-numbers/19's shape (the arcsine shortcut; its rounding error
+            // ~1.7e-16 / sqrt(min(x, 1 - x)) reaches the 1e-15 of the identity up to about 0.03): judged by default
+            boolean arcsineEnd = Known.ARCSINE_BETA_IS_INACCURATE_NEAR_THE_ENDS && a == 0.5 && b == 0.5 && Math.min(t, 1 - t) < 0.05;
+            if (!arcsineEnd) {
+                check(Math.abs(ib + ibc - 1) <= 1e-15, () -> "RegularizedBeta value + complement" + bin + " = " + (ib + ibc));
+                agreeWith("RegularizedBeta" + bin, ib, Oracle.call("beta_reg", t, a, b), 4096, 1e-300);
+                agreeWith("RegularizedBeta.complement" + bin, ibc, Oracle.call("beta_reg_c", t, a, b), 4096, 1e-300);
+            }
+            if (t > 0x1.0p-50 && t < 1 - 0x1.0p-50 && a >= 1 && b >= 1) { // well conditioned: 1 - t is inexact
+                // to the gross bound of the mpmath checks: Boost's incomplete beta is a few hundred ulps off for
+                // parameters of order 50 (I_x(59.35, 10) + I_(1-x)(10, 59.35) at the mean is 1 - 2e-13)
+                double swapped = RegularizedBeta.value(1 - t, b, a);
+                check(Math.abs(ib + swapped - 1) <= 4096 * Math.ulp(1.0), () -> "I_x(a,b) + I_(1-x)(b,a)" + bin + " = " + (ib + swapped));
+            }
+            double inc = IncompleteBeta.value(t, a, b);
+            double incc = IncompleteBeta.complement(t, a, b);
+            if (!arcsineEnd) {
+                agreeWith("IncompleteBeta" + bin, inc, Oracle.call("beta_inc", t, a, b), 4096, 1e-300);
+                agreeWith("IncompleteBeta.complement" + bin, incc, Oracle.call("beta_inc_c", t, a, b), 4096, 1e-300);
+            }
+            // commons-numbers/23's shape: x at or below 2^-1020, or x^a subnormal (a log2 x below -1000); with
+            // Known.BETA_DERIVATIVE_LOSES_ITS_RANGE_FOR_TINY_X on, the derivative is judged from 2^-1000 and 2^(-1000 / a)
+            boolean tinyX = t > 0 && (t <= 0x1.0p-1020 || a * Math.log(t) / Math.log(2) < -1000);
+            double td = Known.BETA_DERIVATIVE_LOSES_ITS_RANGE_FOR_TINY_X && tinyX ? Math.max(0x1.0p-1000, Math.pow(2, -1000 / a)) : t;
+            double dbeta = RegularizedBeta.derivative(td, a, b);
+            if (td > 0 && td < 1) {
+                String dbin = "(x = " + hx(td) + ", a = " + hx(a) + ", b = " + hx(b) + ")";
+                agreeWith("RegularizedBeta.derivative" + dbin, dbeta, Oracle.call("beta_deriv", td, a, b), 4096, 1e-300);
+            }
+            double bv = Beta.value(a, b);
+            double lb = LogBeta.value(a, b);
+            String ab = "(a = " + hx(a) + ", b = " + hx(b) + ")";
+            // Beta's Lanczos product raises ratios near 1 to powers of order a and b, so the rounding of each base is
+            // amplified by its exponent: the error grows about linearly, 825 ulps at a + b = 583 the worst of 4000
+            // samples, 206 below a + b = 200 (the library's own tests allow 200 ulps up to a, b = 100); LogBeta stays
+            // within an ulp. 4 (a + b) above GROSS leaves a threefold margin at every magnitude.
+            agreeWith("Beta" + ab, bv, Oracle.call("beta", a, b), GROSS + 4 * (a + b), 0);
+            agreeWith("LogBeta" + ab, lb, Oracle.call("lbeta", a, b), GROSS, 1e-14);
+            double lb2 = LogBeta.value(b, a);
+            check(lb == lb2 || Math.abs(lb - lb2) <= 4 * Math.ulp(lb), () -> "LogBeta" + ab + " = " + lb + " but swapped " + lb2);
+            if (Double.isFinite(bv) && bv > 1e-300) {
+                double rel = Math.abs(Math.log(bv) - lb) / Math.max(1, Math.abs(lb));
+                check(rel <= 1e-13, () -> "log(Beta)" + ab + " = " + Math.log(bv) + " vs LogBeta " + lb);
+            }
+            double gr = GammaRatio.value(a, b);
+            agreeWith("GammaRatio.value" + ab, gr, Oracle.call("gamma_ratio", a, b), GROSS, 0);
+            double d = chance(tc, 70) ? G.in(tc, -a / 2, 50) : pick(tc, 0.0, 1.0, -1.0, 0.5, 1e-10, 100.0);
+            if (a + d > 0) {
+                double grd = GammaRatio.delta(a, d);
+                // up to ~700 ulps observed for tiny deltas (the ratio is 1 - delta psi(a)); no accuracy is documented
+                agreeWith("GammaRatio.delta(a = " + hx(a) + ", delta = " + hx(d) + ")", grd, Oracle.call("gamma_ratio", a, a + d), 8 * GROSS, 0);
+            }
+        });
+    }
+
+    @Test
+    void specialFunctionIdentitiesHold() {
+        property("specialFunctionIdentitiesHold", tc -> {
+            double x = G.in(tc, -170, 170);
+            if (chance(tc, 30)) {
+                x = Math.rint(x) + (chance(tc, 50) ? 1 : -1) * G.logUniform(tc, -12, -1);
+            }
+            final double fx = x;
+            if (!isInteger(x) || x > 0) {
+                // recurrence: Gamma(x + 1) = x Gamma(x)
+                double g = Gamma.value(x);
+                double g1 = Gamma.value(x + 1);
+                if (Double.isFinite(g) && Double.isFinite(g1) && Math.abs(g) > 1e-290 && Math.abs(g1) > 1e-290 && x + 1 != x) {
+                    double rel = Math.abs(g1 - x * g) / Math.abs(g1);
+                    check(rel <= 1e-12 || Math.abs(x) < 1e-3, () -> "Gamma(x + 1) vs x Gamma(x) at " + hx(fx) + ": " + g1 + " vs " + fx * g);
+                }
+                // reflection: Gamma(x) Gamma(1 - x) = pi / sin(pi x) (away from the integers)
+                double g2 = Gamma.value(1 - x);
+                // sin(pi x) = (-1)^n sin(pi f) for x = n + f, |f| <= 1/2: the rounding of pi x itself would cost 1e-12
+                // relative at x = 7.9994 (sin(pi x) = -1.8e-3), which is the model's error, not the library's
+                double f = x - Math.rint(x);
+                double s = (((long) Math.rint(x)) % 2 == 0 ? 1 : -1) * Math.sin(Math.PI * f);
+                if (Double.isFinite(g) && Double.isFinite(g2) && Math.abs(g * g2) < 1e300 && Math.abs(s) > 1e-3 && Math.abs(x) < 20) {
+                    double rel = Math.abs(g * g2 - Math.PI / s) / Math.abs(Math.PI / s);
+                    check(rel <= 1e-12, () -> "reflection at " + hx(fx) + ": Gamma(x) Gamma(1 - x) = " + g * g2 + " vs pi / sin(pi x) = " + Math.PI / s);
+                }
+                // LogGamma vs Gamma
+                int[] sign = new int[1];
+                double lg = LogGamma.value(x, sign);
+                if (Double.isFinite(g) && g != 0 && Math.abs(g) < 1e300 && Math.abs(g) > 1e-300) {
+                    double diff = Math.abs(lg - Math.log(Math.abs(g)));
+                    check(diff <= 1e-12 * Math.max(1, Math.abs(lg)), () -> "LogGamma(" + hx(fx) + ") = " + lg + " vs log|Gamma| = " + Math.log(Math.abs(g)));
+                    check(sign[0] == (g > 0 ? 1 : -1), () -> "LogGamma sign at " + hx(fx) + " = " + sign[0] + " but Gamma = " + g);
+                }
+            }
+            // error functions
+            double e = G.in(tc, -30, 30);
+            if (chance(tc, 30)) {
+                e = G.logUniform(tc, -300, 1) * (chance(tc, 50) ? 1 : -1);
+            }
+            final double fe = e;
+            double erf = Erf.value(e);
+            double erfc = Erfc.value(e);
+            check(Math.abs(erf + erfc - 1) <= 2e-16 || Math.abs(erf + erfc - 1) <= 4 * Math.ulp(1.0), () -> "Erf + Erfc at " + hx(fe) + " = " + (erf + erfc));
+            if (Math.abs(e) < 26) {
+                double erfcx = Erfcx.value(e);
+                double ex = Math.exp(-e * e);
+                if (erfc > 1e-290 && erfc < 2) {
+                    double rel = Math.abs(erfcx * ex - erfc) / erfc;
+                    check(rel <= 1e-12 || Math.abs(e) < 1e-8, () -> "Erfcx exp(-x^2) vs Erfc at " + hx(fe) + ": " + erfcx * ex + " vs " + erfc);
+                }
+            }
+            double y = G.in(tc, -1, 1);
+            if (chance(tc, 30)) {
+                y = (chance(tc, 50) ? 1 : -1) * (1 - G.logUniform(tc, -16, -1));
+            }
+            final double fy = y;
+            double inv = InverseErf.value(y);
+            double back = Erf.value(inv);
+            check(Math.abs(back - y) <= 1e-15 || Math.abs(back - y) <= 8 * Math.ulp(y) || Math.abs(y) > 1 - 1e-12,
+                () -> "Erf(InverseErf(" + hx(fy) + ")) = " + back + " via " + inv);
+            double yc = 1 - y;
+            double invc = InverseErfc.value(yc);
+            double backc = Erfc.value(invc);
+            check(Math.abs(backc - yc) <= 1e-15 || Math.abs(backc - yc) <= 8 * Math.ulp(yc) || yc < 1e-12 || yc > 2 - 1e-12,
+                () -> "Erfc(InverseErfc(" + hx(yc) + ")) = " + backc + " via " + invc);
+            if (Math.abs(y) < 0.5) {
+                // InverseErfc(1 - y) = InverseErf(y) where 1 - y is exact enough
+                check(Math.abs(invc - inv) <= 1e-13 * Math.max(1, Math.abs(inv)) + 4 * Math.ulp(Math.max(1, Math.abs(inv))),
+                    () -> "InverseErfc(1 - y) vs InverseErf(y) at " + hx(fy) + ": " + invc + " vs " + inv);
+            }
+        });
+    }
+
+    static double evalOrNaN(DoubleUnaryOperator f, double x) {
+        try {
+            return f.applyAsDouble(x);
+        } catch (ArithmeticException ex) {
+            return Double.NaN;
+        }
+    }
+}
