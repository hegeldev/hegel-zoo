+    }
+
+    /** commons-numbers/17 */
+    @Test
+    void fromHonoursAnEpsilonBelowTheUlpOfTheValue() {
+        double x = 400000000.2;
+        BigFraction f = BigFraction.from(x, 1e-12, 100);
+        BigDecimal err = new BigDecimal(x).subtract(new BigDecimal(f.getNumerator()).divide(new BigDecimal(f.getDenominator()), MathContext.DECIMAL128)).abs();
+        assertTrue(err.compareTo(new BigDecimal("1e-12")) <= 0, "BigFraction.from(" + x + ", 1e-12, 100) = " + f + " is off by " + err);
+    }
+
+    /** commons-numbers/18 */
+    @Test
+    void powOfMinusTwoReachesTheMinimumValue() {
+        assertEquals(Integer.MIN_VALUE, assertDoesNotThrow(() -> ArithmeticUtils.pow(-2, 31)), "pow(-2, 31)");
+        assertEquals(Long.MIN_VALUE, assertDoesNotThrow(() -> ArithmeticUtils.pow(-2L, 63)), "pow(-2L, 63)");
+    }
+
+    /** commons-numbers/20 */
+    @Test
+    void doubleDoubleMultiplyStaysWithinFourEps() {
+        // high parts just above a power of two, low parts at half an ulp: Dekker's mul2 reaches its 5 eps
+        assertMultiplyWithinFourEps(DD.ofSum(0x1.0000000000068p-53, 0x1.fffffffffffffp-107), DD.ofSum(0x1.0000000000007p10, 0x1.fffffffffffffp-44));
+        assertMultiplyWithinFourEps(DD.ofSum(-7.893986620091577E-31, -8.752145102351626E-47), DD.ofSum(-7.888609052222323E-31, -8.758115402016577E-47));
+    }
+
+    private static void assertMultiplyWithinFourEps(DD x, DD y) {
+        BigDecimal exact = value(x).multiply(value(y));
+        DD r = x.multiply(y);
+        BigDecimal eps = value(r).subtract(exact).abs().divide(exact.abs(), MathContext.DECIMAL128).divide(new BigDecimal(Math.scalb(1.0, -106)), MathContext.DECIMAL128);
+        assertTrue(eps.compareTo(BigDecimal.valueOf(4)) <= 0, x + " * " + y + " = " + r + " is off by " + eps.round(new MathContext(5)) + " eps (2^-106); the Javadoc promises 4");
+    }
+
+    private static BigDecimal value(DD d) {
+        return new BigDecimal(d.hi()).add(new BigDecimal(d.lo()));
+    }
+
+    /** commons-numbers/21 */
+    @Test
+    void logWithASubnormalImaginaryPartIsAccurate() {
+        // |z| is the real part, so the real part of the log is Math.log of it (correctly rounded)
+        double l15 = Complex.ofCartesian(1.5, Double.MIN_VALUE).log().getReal();
+        assertEquals(Math.log(1.5), l15, 4 * Math.ulp(Math.log(1.5)), "log(1.5 + i MIN_VALUE).getReal() = " + l15);
+        double l025 = Complex.ofCartesian(0.25, Double.MIN_VALUE).log().getReal();
+        assertEquals(Math.log(0.25), l025, 4 * Math.ulp(Math.log(0.25)), "log(0.25 + i MIN_VALUE).getReal() = " + l025);
+    }
+
+    /** commons-numbers/19 */
+    @Test
+    void regularizedBetaComplementOfTheArcsineCaseIsAccurate() {
+        // 1 - I_x(1/2, 1/2) = (2/pi) acos(sqrt(x)): mpmath at 40 digits
+        assertEquals(0.99999363380227621808, RegularizedBeta.complement(1e-10, 0.5, 0.5), 1e-15, "RegularizedBeta.complement(1e-10, 0.5, 0.5)");
+        assertEquals(0.99999999993633802276, RegularizedBeta.complement(1e-20, 0.5, 0.5), 1e-15, "RegularizedBeta.complement(1e-20, 0.5, 0.5)");
+    }
+
+    /** commons-numbers/22 */
+    @Test
+    void longValueOfMinusOnePlusALowPartIsZero() {
+        // -1 + 1e-20 lies in (-1, 0): truncation towards zero, as documented, gives 0
+        DD a = DD.ofSum(-1.0, 1e-20);
+        assertEquals(0L, a.longValue(), "longValue() of " + a);
+        assertEquals(0, a.intValue(), "intValue() of " + a);
+    }
+
+    /** commons-numbers/23 */
+    @Test
+    void betaDerivativeAtATinyXIsFinite() {
+        // d/dx I_x(2, 2) = 6 x (1 - x); the prefix 1 / ((1 - x) x) overflows below 2^-1024 and the derivative comes back infinite
+        double d = RegularizedBeta.derivative(0x1.0p-1030, 2, 2);
+        assertEquals(6 * 0x1.0p-1030, d, 1e-320, "RegularizedBeta.derivative(2^-1030, 2, 2) = " + d);
+        double h = RegularizedBeta.derivative(0x1.0p-1030, 0.5, 2);
+        assertTrue(Double.isFinite(h), "RegularizedBeta.derivative(2^-1030, 0.5, 2) = " + h);
+        // x^a underflows while x^(a-1) does not: 0 against 1.6005586217473736e-31 (mpmath)
+        double z = RegularizedBeta.derivative(0x1.0p-990, 1.1, 0.1);
+        assertEquals(1.6005586217473736e-31, z, 1e-6 * 1.6005586217473736e-31, "RegularizedBeta.derivative(2^-990, 1.1, 0.1) = " + z);
+    }
+
+    /** commons-numbers/24 */
+    @Test
+    void divideOfATinyDividendIsAccurate() {
+        // (4e-320 + 0i) / (1e-200 + 0i) = 3.9999554687307321e-120 (BigDecimal): the quotient is formed at the dividend's subnormal magnitude
+        Complex q = Complex.ofCartesian(4e-320, 0).divide(Complex.ofCartesian(1e-200, 0));
+        assertEquals(3.9999554687307321e-120, q.getReal(), 4 * Math.ulp(3.9999554687307321e-120), "(4e-320 + 0i) / (1e-200 + 0i) = " + q);
+    }
+
+    /** commons-numbers/25 */
+    @Test
+    void regularizedBetaOfASubnormalXIsAccurate() {
+        // I_x(0.001, 2) at x = 2^-1060: mpmath at 40 digits 0.48011169172229482726; the library is 2.6e7 ulps off
+        double v = RegularizedBeta.value(0x1.0p-1060, 0.001, 2);
+        assertEquals(0.48011169172229483, v, 4096 * Math.ulp(0.48), "RegularizedBeta.value(2^-1060, 0.001, 2) = " + v);
+    }
