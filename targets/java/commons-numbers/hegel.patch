+package zoo;
+
+import static zoo.Zoo.chance;
+import static zoo.Zoo.check;
+import static zoo.Zoo.n;
+import static zoo.Zoo.pick;
+import static zoo.Zoo.property;
+import static zoo.Zoo.throwsA;
+
+import dev.hegel.TestCase;
+import java.math.BigDecimal;
+import java.math.BigInteger;
+import java.math.MathContext;
+import java.util.List;
+import java.util.function.UnaryOperator;
+import org.apache.commons.numbers.complex.Complex;
+import org.junit.jupiter.api.Test;
+
+/** Complex against mpmath, exact BigDecimal arithmetic and its own contracts. */
+class ComplexTest {
+
+    static final MathContext MC = new MathContext(60);
+    static final double EPS = 0x1.0p-53;
+
+    /** The elementary functions and their oracle operations. */
+    enum Fn {
+        EXP("cexp", Complex::exp), LOG("clog", Complex::log), SQRT("csqrt", Complex::sqrt),
+        SIN("csin", Complex::sin), COS("ccos", Complex::cos), TAN("ctan", Complex::tan),
+        ASIN("casin", Complex::asin), ACOS("cacos", Complex::acos), ATAN("catan", Complex::atan),
+        SINH("csinh", Complex::sinh), COSH("ccosh", Complex::cosh), TANH("ctanh", Complex::tanh),
+        ASINH("casinh", Complex::asinh), ACOSH("cacosh", Complex::acosh), ATANH("catanh", Complex::atanh);
+
+        final String op;
+        final UnaryOperator<Complex> f;
+
+        Fn(String op, UnaryOperator<Complex> f) {
+            this.op = op;
+            this.f = f;
+        }
+    }
+
+    /** A complex number with independently shaped parts: matched magnitudes, mixed magnitudes, or unit-ish. */
+    static Complex z(TestCase tc) {
+        int shape = n(tc, 0, 9);
+        double re;
+        double im;
+        if (shape < 4) {
+            re = G.in(tc, -10, 10);
+            im = G.in(tc, -10, 10);
+        } else if (shape < 6) {
+            re = G.moderate(tc);
+            im = G.moderate(tc);
+        } else if (shape < 8) {
+            re = G.finite(tc);
+            im = G.finite(tc);
+        } else {
+            re = G.in(tc, -2, 2);
+            im = G.in(tc, -2, 2);
+        }
+        return Complex.ofCartesian(re, im);
+    }
+
+    static String show(Complex c) {
+        return c + " [" + Double.toHexString(c.getReal()) + ", " + Double.toHexString(c.getImaginary()) + "]";
+    }
+
+    /** |a - e| for the exact e (BigDecimal parts), as a BigDecimal. */
+    static BigDecimal dist(Complex a, BigDecimal ere, BigDecimal eim) {
+        BigDecimal dr = new BigDecimal(a.getReal()).subtract(ere);
+        BigDecimal di = new BigDecimal(a.getImaginary()).subtract(eim);
+        return dr.multiply(dr).add(di.multiply(di)).sqrt(MC);
+    }
+
+    static BigDecimal mod(BigDecimal re, BigDecimal im) {
+        return re.multiply(re).add(im.multiply(im)).sqrt(MC);
+    }
+
+    /** The normwise relative error of {@code a} against the exact parts, in units of eps: |a - e| / (eps |e|). */
+    static double normwise(Complex a, BigDecimal ere, BigDecimal eim) {
+        return dist(a, ere, eim).divide(mod(ere, eim), MC).doubleValue() / EPS;
+    }
+
+    /**
+     * An exact part below every double (|e| < 1e-400) counts as zero. tan(1 + i 5e8) comes back from mpmath as
+     * 2.8e-434294482 + i 1.0, and any sum or difference of such a part with an ordinary one aligns the scales into a
+     * BigInteger of hundreds of millions of digits: minutes of work from about 1e7 digits, and ArithmeticException
+     * "BigInteger would overflow supported range" beyond about 6e8. Next to a part the modulus check lets through
+     * (>= 1e-290) such a term is far below the 60-digit arithmetic anyway, and alone it is underflow territory.
+     */
+    static BigDecimal flush(BigDecimal e) {
+        return e != null && e.abs().compareTo(FLUSH) < 0 ? BigDecimal.ZERO : e;
+    }
+
+    static final BigDecimal MAX = new BigDecimal(Double.MAX_VALUE);
+    static final BigDecimal TINY = new BigDecimal("1e-290");
+    static final BigDecimal FLUSH = new BigDecimal("1e-400");
+
+    /** |got - want| / |want|, 0 when the two are equal (both may have underflowed to zero). */
+    static double relErr(Complex got, Complex want) {
+        double d = got.subtract(want).abs();
+        return d == 0 ? 0 : d / want.abs();
+    }
+
+    @Test
+    void elementaryFunctionsAgreeWithMpmath() {
+        property("elementaryFunctionsAgreeWithMpmath", tc -> {
+            Complex z = z(tc);
+            if (z.getReal() == 0 || z.getImaginary() == 0) {
+                return; // mpmath has no signed zeros: the branch-cut and axis cases are C99 tables upstream tests already
+            }
+            Fn fn = pick(tc, Fn.values());
+            elementaryAgreesWithMpmath(fn, z);
+        });
+    }
+
+    /** fn(z) against mpmath: finite where the exact parts fit a double, normwise within 16 eps and componentwise within 64 ulps. */
+    static void elementaryAgreesWithMpmath(Fn fn, Complex z) {
+        Complex got = fn.f.apply(z);
+        Oracle.Reply r = Oracle.call(fn.op, z.getReal(), z.getImaginary());
+        String in = fn + "(" + show(z) + ") = " + show(got) + " mpmath " + (r.ok() ? r.raw()[0] + ", " + r.raw()[1] : r.error());
+        if (!r.ok()) {
+            return; // a pole or domain error on the oracle side
+        }
+        BigDecimal ere = flush(r.exact(0));
+        BigDecimal eim = flush(r.exact(1));
+        if (ere == null || eim == null) {
+            return; // non-finite exact value (mpmath overflow of the 80-digit arithmetic is not possible; inf/nan only)
+        }
+        // a part whose exact value is finite must come back finite; Known.LOG_SQRT_OVERFLOW_WITH_SUBNORMAL_PART
+        // (commons-numbers/2) and Known.EXP_OVERFLOWS_A_FINITE_PART (commons-numbers/3) are the overflow shapes
+        boolean reFits = ere.abs().compareTo(MAX) <= 0;
+        boolean imFits = eim.abs().compareTo(MAX) <= 0;
+        boolean overflowShape = Known.LOG_SQRT_OVERFLOW_WITH_SUBNORMAL_PART && (fn == Fn.LOG || fn == Fn.SQRT)
+            && Math.abs(z.getReal()) > 1e291 && Math.abs(z.getImaginary()) < Double.MIN_NORMAL
+            || Known.LOG_SQRT_OVERFLOW_WITH_SUBNORMAL_PART && fn == Fn.SQRT
+            && Math.abs(z.getImaginary()) > 1e291 && Math.abs(z.getReal()) < Double.MIN_NORMAL
+            || Known.EXP_OVERFLOWS_A_FINITE_PART && fn == Fn.EXP && Math.abs(z.getReal()) > 709 && (!reFits || !imFits);
+        if (overflowShape) {
+            return;
+        }
+        check(reFits == Double.isFinite(got.getReal()) || !reFits && Double.isInfinite(got.getReal()) || !imFits && Double.isNaN(got.getReal()),
+            () -> "real part finiteness: " + in);
+        check(imFits == Double.isFinite(got.getImaginary()) || !imFits && Double.isInfinite(got.getImaginary()) || !reFits && Double.isNaN(got.getImaginary()),
+            () -> "imaginary part finiteness: " + in);
+        if (!reFits || !imFits || !got.isFinite()) {
+            return;
+        }
+        BigDecimal modulus = mod(ere, eim);
+        if (modulus.compareTo(TINY) < 0) {
+            return; // underflow territory: the parts are subnormal or flushed
+        }
+        // log with a subnormal part and |z| outside the log1p window (0.5, sqrt 2) rescales by 2^54 and leaves the
+        // rounding of 54 ln 2 in the real part (commons-numbers/21): judged by default
+        double small = Math.min(Math.abs(z.getReal()), Math.abs(z.getImaginary()));
+        double big = Math.max(Math.abs(z.getReal()), Math.abs(z.getImaginary()));
+        if (Known.LOG_LOSES_ACCURACY_WITH_A_SUBNORMAL_PART && fn == Fn.LOG && small < Double.MIN_NORMAL && !(big > 0.5 && big < Math.sqrt(2))) {
+            return;
+        }
+        // normwise relative error: |got - exact| <= K eps |exact|
+        double rel = normwise(got, ere, eim);
+        check(rel <= 16, () -> "normwise error " + rel + " ulps-equivalent: " + in);
+        // componentwise: a part is accurate to a few ulps of its own unless it is tiny next to the other
+        double reUlps = Oracle.ulps(got.getReal(), ere);
+        double imUlps = Oracle.ulps(got.getImaginary(), eim);
+        boolean reSmall = ere.abs().compareTo(modulus.multiply(new BigDecimal("1e-6"))) < 0;
+        boolean imSmall = eim.abs().compareTo(modulus.multiply(new BigDecimal("1e-6"))) < 0;
+        check(reSmall || reUlps <= 64, () -> "real part off by " + reUlps + " ulps: " + in);
+        check(imSmall || imUlps <= 64, () -> "imaginary part off by " + imUlps + " ulps: " + in);
+    }
+
+    /** A subnormal of either sign (never zero). */
+    static double subnormal(TestCase tc) {
+        double s = G.bits(tc, 0, 0);
+        return s == 0 ? Double.MIN_VALUE : s;
+    }
+
+    static final double LOG10_E = Math.log10(Math.E);
+
+    /**
+     * log and sqrt of a huge real part (log-uniform between 1e292 and MAX_VALUE) beside a subnormal imaginary part of
+     * either sign, and sqrt of the two swapped, judged as elementaryFunctionsAgreeWithMpmath judges them: the rescaling
+     * of the subnormal part by 2^54 overflows the huge one, so a finite exact value comes back infinite
+     * (commons-numbers/2). Beside it (HEGEL_NO_KNOWN) huge parts between 1e200 and 1e291, where the rescaled part fits.
+     */
+    @Test
+    void logAndSqrtWithAHugeAndASubnormalPartAgreeWithMpmath() {
+        property("logAndSqrtWithAHugeAndASubnormalPartAgreeWithMpmath", tc -> {
+            Fn fn = pick(tc, Fn.LOG, Fn.SQRT);
+            double huge = Known.LOG_SQRT_OVERFLOW_WITH_SUBNORMAL_PART ? G.logUniform(tc, 200, 291) : G.logUniform(tc, 292, 308.25);
+            double tiny = subnormal(tc);
+            boolean imaginaryHuge = fn == Fn.SQRT && pick(tc, false, true);
+            elementaryAgreesWithMpmath(fn, imaginaryHuge ? Complex.ofCartesian(tiny, huge) : Complex.ofCartesian(huge, tiny));
+        });
+    }
+
+    /**
+     * exp of a real part in [710, 1000] with an imaginary part (log-uniform, either sign) small enough that the exact
+     * imaginary part e^re sin(im) stays below MAX_VALUE / 10 while the real part overflows, judged as
+     * elementaryFunctionsAgreeWithMpmath judges it: Math.exp(re) is infinite, and with it every part (commons-numbers/3).
+     * Beside it (HEGEL_NO_KNOWN) real parts in [600, 709], where both parts are finite.
+     */
+    @Test
+    void expOfARealPartPastTheOverflowKeepsItsFiniteImaginaryPart() {
+        property("expOfARealPartPastTheOverflowKeepsItsFiniteImaginaryPart", tc -> {
+            double re = Known.EXP_OVERFLOWS_A_FINITE_PART ? G.in(tc, 600, 709) : G.in(tc, 710, 1000);
+            double im = (chance(tc, 50) ? 1 : -1) * G.logUniform(tc, -300, Math.min(-1, 308.25 - re * LOG10_E - 1));
+            elementaryAgreesWithMpmath(Fn.EXP, Complex.ofCartesian(re, im));
+        });
+    }
+
+    /**
+     * log of a real part in [sqrt 2, 1.5] with a subnormal imaginary part, judged as elementaryFunctionsAgreeWithMpmath
+     * judges it (commons-numbers/21): the modulus is the real part itself, yet the rescaling of the subnormal part leaves
+     * the rounding of 54 ln 2 (about 3.6e-15) in ln|z| = 0.35..0.41, 45 ulps-equivalent in the median and above 16 in
+     * four cases of five.
+     */
+    @Test
+    void logWithASubnormalImaginaryPartAgreesWithMpmath() {
+        property("logWithASubnormalImaginaryPartAgreesWithMpmath", tc -> {
+            double re = G.in(tc, Math.sqrt(2), 1.5);
+            double im = G.bits(tc, 0, 0); // a subnormal of either sign
+            if (im == 0) {
+                im = Double.MIN_VALUE;
+            }
+            if (Known.LOG_LOSES_ACCURACY_WITH_A_SUBNORMAL_PART) {
+                // beside the shape: the smallest normal magnitudes, which take no rescaling
+                im = Math.copySign(Math.scalb(Double.MIN_NORMAL, (int) G.in(tc, 0, 800)), im);
+            }
+            Complex z = Complex.ofCartesian(re, im);
+            Complex got = z.log();
+            Oracle.Reply r = Oracle.call("clog", re, im);
+            String in = "LOG(" + show(z) + ") = " + show(got) + " mpmath " + r.raw()[0] + ", " + r.raw()[1];
+            double rel = normwise(got, r.exact(0), r.exact(1));
+            check(rel <= 16, () -> "normwise error " + rel + " ulps-equivalent: " + in);
+        });
+    }
+
+    @Test
+    void divideOfATinyDividendBySmallDivisorIsAccurate() {
+        property("divideOfATinyDividendBySmallDivisorIsAccurate", tc -> {
+            // dividend parts of magnitude 2^-1061..2^-1030 (the imaginary part zero three times in ten), divisor of
+            // magnitude about 2^-800..2^-110: a normal quotient that the C99 listing forms at the dividend's subnormal
+            // magnitude; beside the shape under HEGEL_NO_KNOWN=1 the dividend is lifted by 2^600, where no bits are lost
+            int lift = Known.DIVIDE_LOSES_A_SUBNORMAL_DIVIDEND ? 600 : 0;
+            double re = Math.scalb((chance(tc, 50) ? 1 : -1) * G.in(tc, 0.5, 1), lift - n(tc, 1030, 1060));
+            double im = chance(tc, 30) ? 0.0 : Math.scalb((chance(tc, 50) ? 1 : -1) * G.in(tc, 0.5, 1), lift - n(tc, 1030, 1060));
+            int k = n(tc, 110, 800);
+            double c = Math.scalb((chance(tc, 50) ? 1 : -1) * G.in(tc, 0.5, 1), -k);
+            double d = chance(tc, 30) ? 0.0 : Math.scalb((chance(tc, 50) ? 1 : -1) * G.in(tc, 0.5, 1), -k);
+            Complex a = Complex.ofCartesian(re, im);
+            Complex b = Complex.ofCartesian(c, d);
+            BigDecimal ar = new BigDecimal(re);
+            BigDecimal ai = new BigDecimal(im);
+            BigDecimal br = new BigDecimal(c);
+            BigDecimal bi = new BigDecimal(d);
+            BigDecimal den = br.multiply(br).add(bi.multiply(bi));
+            BigDecimal qr = ar.multiply(br).add(ai.multiply(bi)).divide(den, MC);
+            BigDecimal qi = ai.multiply(br).subtract(ar.multiply(bi)).divide(den, MC);
+            checkNormwise("divide", a, b, a.divide(b), qr, qi);
+        });
+    }
+
+    @Test
+    void arithmeticAndModulusAreAccurate() {
+        property("arithmeticAndModulusAreAccurate", tc -> {
+            Complex a = z(tc);
+            Complex b = z(tc);
+            BigDecimal ar = new BigDecimal(a.getReal());
+            BigDecimal ai = new BigDecimal(a.getImaginary());
+            BigDecimal br = new BigDecimal(b.getReal());
+            BigDecimal bi = new BigDecimal(b.getImaginary());
+
+            // abs: within 1 ulp of the exact result (documented)
+            BigDecimal am = mod(ar, ai);
+            double abs = a.abs();
+            if (am.compareTo(MAX) <= 0) {
+                double u = Oracle.ulps(abs, am);
+                check(u <= 1, () -> "abs(" + show(a) + ") = " + abs + " exact " + am + " ulps " + u);
+            } else {
+                check(abs == Double.POSITIVE_INFINITY, () -> "abs(" + show(a) + ") = " + abs + " should overflow");
+            }
+            // norm = x^2 + y^2 (may overflow)
+            BigDecimal nm = ar.multiply(ar).add(ai.multiply(ai));
+            double norm = a.norm();
+            check(nm.compareTo(MAX) > 0 ? norm == Double.POSITIVE_INFINITY : Oracle.ulps(norm, nm) <= 2,
+                () -> "norm(" + show(a) + ") = " + norm + " exact " + nm);
+            check(a.arg() == Math.atan2(a.getImaginary(), a.getReal()), () -> "arg(" + show(a) + ")");
+
+            // multiply and divide: normwise relative error against exact arithmetic
+            BigDecimal pr = ar.multiply(br).subtract(ai.multiply(bi));
+            BigDecimal pi = ar.multiply(bi).add(ai.multiply(br));
+            checkNormwise("multiply", a, b, a.multiply(b), pr, pi);
+            BigDecimal den = br.multiply(br).add(bi.multiply(bi));
+            if (den.signum() != 0) {
+                // commons-numbers/24's shape: a dividend of subnormal size over a divisor below 1 (the quotient is formed
+                // at the dividend's magnitude); with Known.DIVIDE_LOSES_A_SUBNORMAL_DIVIDEND on, judged with the dividend
+                // scaled up by 2^600
+                boolean tinyDividend = Math.max(Math.abs(a.getReal()), Math.abs(a.getImaginary())) < 0x1.0p-1020 && mod(br, bi).compareTo(BigDecimal.ONE) < 0;
+                Complex an = Known.DIVIDE_LOSES_A_SUBNORMAL_DIVIDEND && tinyDividend ? Complex.ofCartesian(Math.scalb(a.getReal(), 600), Math.scalb(a.getImaginary(), 600)) : a;
+                BigDecimal lift = an == a ? BigDecimal.ONE : new BigDecimal(BigInteger.ONE.shiftLeft(600));
+                BigDecimal qr = ar.multiply(br).add(ai.multiply(bi)).multiply(lift).divide(den, MC);
+                BigDecimal qi = ai.multiply(br).subtract(ar.multiply(bi)).multiply(lift).divide(den, MC);
+                checkNormwise("divide", an, b, an.divide(b), qr, qi);
+            }
+            BigDecimal sr = ar.add(br);
+            BigDecimal si = ai.add(bi);
+            Complex sum = a.add(b);
+            check(sum.getReal() == a.getReal() + b.getReal() && sum.getImaginary() == a.getImaginary() + b.getImaginary(),
+                () -> "add(" + show(a) + ", " + show(b) + ") = " + show(sum));
+            Complex diff = a.subtract(b);
+            check(diff.getReal() == a.getReal() - b.getReal() && diff.getImaginary() == a.getImaginary() - b.getImaginary(),
+                () -> "subtract(" + show(a) + ", " + show(b) + ") = " + show(diff));
+            double d = b.getReal();
+            Complex md = a.multiply(d);
+            check(md.getReal() == a.getReal() * d && md.getImaginary() == a.getImaginary() * d, () -> "multiply(double " + d + ") of " + show(a));
+            if (d != 0) {
+                Complex dd = a.divide(d);
+                check(dd.getReal() == a.getReal() / d && dd.getImaginary() == a.getImaginary() / d, () -> "divide(double " + d + ") of " + show(a));
+            }
+            Complex mi = a.multiplyImaginary(d);
+            check(mi.getReal() == -a.getImaginary() * d && mi.getImaginary() == a.getReal() * d, () -> "multiplyImaginary(" + d + ") of " + show(a) + " = " + show(mi));
+            check(a.conj().getReal() == a.getReal() && a.conj().getImaginary() == -a.getImaginary(), () -> "conj of " + show(a));
+            check(a.negate().getReal() == -a.getReal() && a.negate().getImaginary() == -a.getImaginary(), () -> "negate of " + show(a));
+            check(a.isFinite() == (Double.isFinite(a.getReal()) && Double.isFinite(a.getImaginary())), () -> "isFinite of " + show(a));
+            check(a.equals(Complex.ofCartesian(a.getReal(), a.getImaginary())) && a.hashCode() == Complex.ofCartesian(a.getReal(), a.getImaginary()).hashCode(),
+                () -> "equals/hashCode of a re-created " + show(a));
+            check(a.equals(b) == (Double.doubleToLongBits(a.getReal()) == Double.doubleToLongBits(b.getReal())
+                && Double.doubleToLongBits(a.getImaginary()) == Double.doubleToLongBits(b.getImaginary())), () -> "equals of " + show(a) + " and " + show(b));
+        });
+    }
+
+    static void checkNormwise(String what, Complex a, Complex b, Complex got, BigDecimal ere, BigDecimal eim) {
+        String in = what + "(" + show(a) + ", " + show(b) + ") = " + show(got) + " exact (" + ere.round(new MathContext(20)) + ", " + eim.round(new MathContext(20)) + ")";
+        BigDecimal modulus = mod(ere, eim);
+        if (modulus.compareTo(MAX) > 0 || modulus.compareTo(TINY) < 0) {
+            return; // overflow and underflow: the parts may be infinite or flushed
+        }
+        boolean reBig = ere.abs().compareTo(MAX) > 0;
+        boolean imBig = eim.abs().compareTo(MAX) > 0;
+        if (reBig || imBig) {
+            return;
+        }
+        if (!got.isFinite()) {
+            check(false, () -> "non-finite result: " + in);
+            return;
+        }
+        double rel = dist(got, ere, eim).divide(modulus, MC).doubleValue() / EPS;
+        check(rel <= 4, () -> "normwise error " + rel + " ulps-equivalent: " + in);
+    }
+
+    /**
+     * nthRoot(n) of w: n == 0 is rejected (documented); otherwise, for a w off the axes, |n| roots whose n-th power is w,
+     * the first of them the principal root (checked up to |n| = 64; for Integer.MIN_VALUE the |n| roots cannot be
+     * returned, so the documented IllegalArgumentException is the only valid outcome).
+     */
+    static void nthRoots(Complex w, int nn) {
+        if (nn == 0) {
+            check(throwsA(IllegalArgumentException.class, () -> w.nthRoot(0)), () -> "nthRoot(0) should reject");
+        } else if (w.getReal() != 0 && w.getImaginary() != 0) {
+            if (nn == Integer.MIN_VALUE) {
+                // Known.NTH_ROOT_OF_MIN_VALUE_IS_EMPTY (commons-numbers/4): the loop to Math.abs(n) runs zero times
+                if (!Known.NTH_ROOT_OF_MIN_VALUE_IS_EMPTY) {
+                    check(throwsA(IllegalArgumentException.class, () -> w.nthRoot(nn)),
+                        () -> "nthRoot(" + nn + ") of " + show(w) + " should reject (|n| roots cannot be returned), gave " + w.nthRoot(nn).size() + " roots");
+                }
+            } else if (Math.abs((long) nn) <= 64 && Math.pow(w.abs(), 1.0 / nn) < Double.MAX_VALUE / 4) { // a root's modulus can overflow (nthRoot(-1) of a subnormal w)
+                List<Complex> roots = w.nthRoot(nn);
+                check(roots.size() == Math.abs((long) nn), () -> "nthRoot(" + nn + ") of " + show(w) + " gave " + roots.size() + " roots");
+                for (Complex root : roots) {
+                    Complex back2 = root.pow(nn);
+                    double err = relErr(back2, w);
+                    check(err <= 1e-11 * Math.max(1, Math.abs(nn)), () -> "nthRoot(" + nn + ") of " + show(w) + ": root " + show(root) + " ^ n = " + show(back2) + " rel err " + err);
+                }
+                if (nn > 0) {
+                    // the first root is the principal one: pow(1/n) up to rounding. nthRoot is documented on the modulus
+                    // abs(), which sits on the subnormal grid when |w| is subnormal (nthRoot(2) of 1.5e-314 + 6e-320 i is
+                    // then 4e-12 from the exact root that pow(1/2) and sqrt give), so such a w is judged scaled by 2^600
+                    Complex wp = w.abs() < Double.MIN_NORMAL ? Complex.ofCartesian(Math.scalb(w.getReal(), 600), Math.scalb(w.getImaginary(), 600)) : w;
+                    Complex principal = wp.pow(1.0 / nn);
+                    Complex first = wp.nthRoot(nn).get(0);
+                    double err = principal.subtract(first).abs() / principal.abs();
+                    check(err <= 1e-12, () -> "nthRoot(" + nn + ") of " + show(wp) + ": first root " + show(first) + " vs pow(1/n) " + show(principal));
+                }
+            }
+        }
+    }
+
+    /**
+     * nthRoot(Integer.MIN_VALUE) of a random base off the axes, judged as textPolarRootsAndPowersAreConsistent judges it:
+     * the documented |n| roots cannot be returned, so the documented IllegalArgumentException is the only valid outcome,
+     * and the library returns an empty list (commons-numbers/4). Beside it (HEGEL_NO_KNOWN) n in [-64, -1].
+     */
+    @Test
+    void nthRootRejectsIntegerMinValueForAnyBase() {
+        property("nthRootRejectsIntegerMinValueForAnyBase", tc -> {
+            Complex w = Complex.ofCartesian(G.in(tc, -100, 100), G.in(tc, -100, 100));
+            int nn = Known.NTH_ROOT_OF_MIN_VALUE_IS_EMPTY ? -n(tc, 1, 64) : Integer.MIN_VALUE;
+            nthRoots(w, nn);
+        });
+    }
+
+    @Test
+    void textPolarRootsAndPowersAreConsistent() {
+        property("textPolarRootsAndPowersAreConsistent", tc -> {
+            Complex a = Complex.ofCartesian(G.any(tc), G.any(tc));
+            // toString -> parse is bit-exact (documented)
+            Complex back = Complex.parse(a.toString());
+            check(back.equals(a), () -> "parse(toString) of " + show(a) + " gave " + show(back));
+
+            // polar form: abs and arg within floating-point error (documented)
+            double rho = chance(tc, 80) ? G.logUniform(tc, -10, 10) : pick(tc, 0.0, 1.0, Double.MAX_VALUE, Double.MIN_NORMAL, 1e300);
+            double theta = chance(tc, 80) ? G.in(tc, -Math.PI, Math.PI) : pick(tc, 0.0, Math.PI, -Math.PI, Math.PI / 2, -Math.PI / 2, 1e-300, 3 * Math.PI);
+            Complex p = Complex.ofPolar(rho, theta);
+            if (rho > 1e-300 && rho < 1e300) {
+                double pa = p.abs();
+                check(Math.abs(pa - rho) <= 4 * Math.ulp(rho), () -> "ofPolar(" + rho + ", " + theta + ") = " + show(p) + " abs " + pa);
+                if (theta > -Math.PI && theta <= Math.PI && Math.abs(Math.abs(theta) - Math.PI) > 1e-9) {
+                    double parg = p.arg();
+                    check(Math.abs(parg - theta) <= 4 * Math.ulp(Math.max(1, Math.abs(theta))), () -> "ofPolar(" + rho + ", " + theta + ") = " + show(p) + " arg " + parg);
+                }
+            }
+            Complex cis = Complex.ofCis(theta);
+            check(cis.getReal() == Math.cos(theta) && cis.getImaginary() == Math.sin(theta), () -> "ofCis(" + theta + ") = " + show(cis));
+
+            // nth roots: |n| roots, each of which raised to the n-th power gives z back (finite, non-zero z)
+            Complex w = Complex.ofCartesian(G.in(tc, -100, 100), G.in(tc, -100, 100));
+            int nn = chance(tc, 80) ? n(tc, -6, 6) : pick(tc, 0, 1, -1, 2, Integer.MIN_VALUE, Integer.MAX_VALUE, 64, -64);
+            nthRoots(w, nn);
+            // integer powers agree with repeated multiplication to a few ulps (normwise); |w| from 2^-500 up keeps the
+            // products and quotients off the subnormal grid (pow(2) and multiply of a 1e-156-sized w differ by 1e-13 there)
+            if (w.getReal() != 0 && w.getImaginary() != 0 && w.abs() >= 0x1.0p-500) {
+                Complex sq = w.pow(2);
+                Complex mul = w.multiply(w);
+                double err = relErr(sq, mul);
+                check(err <= 1e-13, () -> "pow(2) of " + show(w) + " = " + show(sq) + " vs multiply " + show(mul) + " rel err " + err);
+                Complex sq2 = w.pow(Complex.ofCartesian(2, 0));
+                double err2 = relErr(sq2, mul);
+                check(err2 <= 1e-13, () -> "pow(2+0i) of " + show(w) + " = " + show(sq2) + " vs multiply " + show(mul) + " rel err " + err2);
+                Complex half = w.pow(0.5);
+                Complex sqrt = w.sqrt();
+                double err3 = relErr(half, sqrt);
+                check(err3 <= 1e-13, () -> "pow(0.5) of " + show(w) + " = " + show(half) + " vs sqrt " + show(sqrt) + " rel err " + err3);
+                Complex q = w.divide(a);
+                if (a.isFinite() && a.getReal() != 0 && a.getImaginary() != 0 && q.isFinite() && a.abs() > 1e-100 && a.abs() < 1e100) {
+                    Complex round = q.multiply(a);
+                    double err4 = relErr(round, w);
+                    check(err4 <= 1e-13, () -> "divide then multiply by " + show(a) + " of " + show(w) + " gave " + show(round) + " rel err " + err4);
+                }
+            }
+        });
+    }
+}
