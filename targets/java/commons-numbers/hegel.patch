@@ -0,0 +1,268 @@
+package zoo;
+
+import static org.junit.jupiter.api.Assertions.assertDoesNotThrow;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.math.BigDecimal;
+import java.math.MathContext;
+import org.apache.commons.numbers.angle.Angle;
+import org.apache.commons.numbers.angle.CosAngle;
+import org.apache.commons.numbers.angle.Reduce;
+import org.apache.commons.numbers.combinatorics.Combinations;
+import org.apache.commons.numbers.combinatorics.LogFactorial;
+import org.apache.commons.numbers.complex.Complex;
+import org.apache.commons.numbers.core.ArithmeticUtils;
+import org.apache.commons.numbers.core.DD;
+import org.apache.commons.numbers.core.Precision;
+import org.apache.commons.numbers.core.Sum;
+import org.apache.commons.numbers.fraction.BigFraction;
+import org.apache.commons.numbers.fraction.Fraction;
+import org.apache.commons.numbers.gamma.Digamma;
+import org.apache.commons.numbers.gamma.RegularizedBeta;
+import org.apache.commons.numbers.gamma.Trigamma;
+import org.junit.jupiter.api.Test;
+
+/**
+ * One pin per recorded bug (bugs.toml). Each asserts the correct behaviour and fails while the bug exists; the
+ * property skipping the shape is named by the Known switch of the same number.
+ */
+class CommonsNumbersPinsTest {
+
+    /** commons-numbers/1 */
+    @Test
+    void intValueIsTheFloor() {
+        assertEquals(-4, Fraction.of(-7, 2).intValue(), "Fraction.of(-7, 2).intValue()");
+        assertEquals(-4L, Fraction.of(-7, 2).longValue(), "Fraction.of(-7, 2).longValue()");
+        assertEquals(-4, BigFraction.of(-7, 2).intValue(), "BigFraction.of(-7, 2).intValue()");
+        assertEquals(-4L, BigFraction.of(-7, 2).longValue(), "BigFraction.of(-7, 2).longValue()");
+    }
+
+    /** commons-numbers/2 */
+    @Test
+    void logAndSqrtOfAHugeRealWithASubnormalImaginaryAreFinite() {
+        Complex z = Complex.ofCartesian(1e300, Double.MIN_VALUE);
+        Complex log = z.log();
+        assertEquals(Math.log(1e300), log.getReal(), 1e-9, "log(1e300 + i MIN_VALUE) = " + log);
+        Complex sqrt = z.sqrt();
+        assertEquals(Math.sqrt(1e300), sqrt.getReal(), Math.sqrt(1e300) * 1e-12, "sqrt(1e300 + i MIN_VALUE) = " + sqrt);
+        Complex sqrt2 = Complex.ofCartesian(Double.MIN_VALUE, 1e300).sqrt();
+        double half = Math.sqrt(1e300 / 2);
+        assertEquals(half, sqrt2.getReal(), half * 1e-12, "sqrt(MIN_VALUE + i 1e300) = " + sqrt2);
+    }
+
+    /** commons-numbers/3 */
+    @Test
+    void expKeepsTheFinitePartWhenTheOtherOverflows() {
+        Complex e = Complex.ofCartesian(1000, 1e-300).exp();
+        double expected = Math.exp(1000 + Math.log(1e-300));
+        assertTrue(Double.isFinite(e.getImaginary()), "exp(1000 + i 1e-300) = " + e);
+        assertEquals(expected, e.getImaginary(), expected * 1e-12, "exp(1000 + i 1e-300) = " + e);
+    }
+
+    /** commons-numbers/4 */
+    @Test
+    void nthRootOfIntegerMinValueIsRejected() {
+        assertThrows(IllegalArgumentException.class, () -> Complex.ONE.nthRoot(Integer.MIN_VALUE));
+    }
+
+    /** commons-numbers/5 */
+    @Test
+    void representableFractionResultsDoNotOverflow() {
+        assertEquals(Fraction.ONE, Fraction.of(1, Integer.MIN_VALUE).multiply(Integer.MIN_VALUE), "1/MIN * MIN");
+        assertEquals(Fraction.of(1, 3), Fraction.of(Integer.MIN_VALUE, 3).divide(Integer.MIN_VALUE), "MIN/3 / MIN");
+        assertEquals(Fraction.of(Integer.MIN_VALUE), Fraction.of(1, -1).add(Integer.MIN_VALUE + 1), "1/-1 + (MIN + 1)");
+    }
+
+    /** commons-numbers/6 */
+    @Test
+    void digammaHasPolesAtTheNegativeIntegers() {
+        assertFalse(Double.isFinite(Digamma.value(-3)), "Digamma(-3) = " + Digamma.value(-3));
+        assertFalse(Double.isFinite(Digamma.value(-1)), "Digamma(-1) = " + Digamma.value(-1));
+    }
+
+    /** commons-numbers/7 */
+    @Test
+    void digammaAndTrigammaKeepTheirAccuracyForLargeNegativeArguments() {
+        // psi(-N - 1/2) = psi(N + 3/2) and psi1(-N - 1/2) = pi^2 - psi1(N + 3/2): mpmath at 40 digits
+        double x = -1e15 - 0.5;
+        double digamma = 34.53877639491068626026987182026500478068;
+        double trigamma = 9.869604401089357618834490999876;
+        assertEquals(digamma, Digamma.value(x), 1e-8 * digamma, "Digamma(" + x + ")");
+        assertEquals(trigamma, Trigamma.value(x), 1e-8 * trigamma, "Trigamma(" + x + ")");
+        double y = -29.999999999999996;
+        // psi1(y) ~ 1 / (y + 30)^2 = 7.9e28 and psi(y) ~ -1 / (y + 30) = -2.8e14, both to 1e-8 relative
+        double d = y + 30;
+        assertEquals(1 / (d * d), Trigamma.value(y), 1e-6 / (d * d), "Trigamma(" + y + ") (near a pole)");
+        assertEquals(-1 / d, Digamma.value(y), 1e-6 / Math.abs(d), "Digamma(" + y + ") (near a pole)");
+    }
+
+    /** commons-numbers/8 */
+    @Test
+    void combinationsComparatorOrdersLargeUniverses() {
+        Combinations c = Combinations.of(100_000, 5);
+        int[] a = {0, 1, 2, 3, 4};
+        int[] b = {0, 1, 2, 3, 5};
+        int cmp = assertDoesNotThrow(() -> c.comparator().compare(a, b));
+        assertTrue(cmp < 0, "compare gave " + cmp);
+    }
+
+    /** commons-numbers/9 */
+    @Test
+    void logFactorialDoesNotDependOnTheCache() {
+        for (int n = 21; n <= 40; n++) {
+            assertEquals(LogFactorial.create().value(n), LogFactorial.create().withCache(n + 5).value(n), "LogFactorial(" + n + ")");
+        }
+    }
+
+    /** commons-numbers/10 */
+    @Test
+    void reduceStaysInsideItsInterval() {
+        Reduce r = new Reduce(0, 2 * Math.PI);
+        double tiny = r.applyAsDouble(-1e-30);
+        assertTrue(tiny >= 0 && tiny < 2 * Math.PI, "Reduce(0, 2 pi) of -1e-30 = " + tiny);
+        double large = r.applyAsDouble(-4.181732926389338E12);
+        assertTrue(large >= 0 && large < 2 * Math.PI, "Reduce(0, 2 pi) of -4.181732926389338E12 = " + large);
+    }
+
+    /** commons-numbers/11 */
+    @Test
+    void normalizersRespectTheLowerBound() {
+        double r = Angle.Rad.WITHIN_MINUS_PI_AND_PI.applyAsDouble(-2.809235633113163E13);
+        assertTrue(r >= -Math.PI && r < Math.PI, "WITHIN_MINUS_PI_AND_PI of -2.809235633113163E13 = " + r);
+    }
+
+    /** commons-numbers/12 */
+    @Test
+    void cosAngleIsScaleInvariant() {
+        double[] tiny = {1e-200, 1e-200};
+        double[] huge = {1e200, 1e200};
+        assertEquals(1.0, CosAngle.value(tiny, tiny), 1e-12, "cos of the angle between two equal tiny vectors");
+        assertEquals(1.0, CosAngle.value(huge, huge), 1e-12, "cos of the angle between two equal huge vectors");
+    }
+
+    /** commons-numbers/13 */
+    @Test
+    void sumFollowsTheIeeeSignOfZero() {
+        double s = Sum.of(-0.0, -0.0).getAsDouble();
+        assertEquals(Double.doubleToLongBits(-0.0), Double.doubleToLongBits(s), "Sum.of(-0.0, -0.0) = " + s);
+    }
+
+    /** commons-numbers/14 */
+    @Test
+    void roundAcceptsExtremeScales() {
+        assertEquals(1.5, assertDoesNotThrow(() -> Precision.round(1.5, Integer.MAX_VALUE)), "round(1.5, MAX_VALUE)");
+        assertEquals(0.0, assertDoesNotThrow(() -> Precision.round(1.5, Integer.MIN_VALUE)), "round(1.5, MIN_VALUE)");
+    }
+
+    /** commons-numbers/15 */
+    @Test
+    void bigFractionApproximationsAcceptValuesBeyondTheIntRange() {
+        BigFraction f = assertDoesNotThrow(() -> BigFraction.from(1e10, 100));
+        assertEquals(BigFraction.of(10_000_000_000L), f);
+        BigFraction g = assertDoesNotThrow(() -> BigFraction.from(1e10, 1e-5, 100));
+        assertEquals(BigFraction.of(10_000_000_000L), g);
+    }
+
+    /** commons-numbers/16 */
+    @Test
+    void fromRejectsANonPositiveEpsilonAndNamesIt() {
+        assertThrows(IllegalArgumentException.class, () -> Fraction.from(0.5, 0.0, 10), "epsilon 0 is not positive");
+        assertThrows(IllegalArgumentException.class, () -> BigFraction.from(0.5, 0.0, 10), "epsilon 0 is not positive");
