+/** Fractions, integer utilities, combinatorics and primes against exact BigInteger arithmetic. */
+class ExactTest {
+
+    static final BigInteger IMIN = BigInteger.valueOf(Integer.MIN_VALUE);
+    static final BigInteger IMAX = BigInteger.valueOf(Integer.MAX_VALUE);
+    static final BigInteger LMIN = BigInteger.valueOf(Long.MIN_VALUE);
+    static final BigInteger LMAX = BigInteger.valueOf(Long.MAX_VALUE);
+    static final MathContext MC = new MathContext(60);
+
+    /** A reduced rational with a positive denominator. */
+    record Q(BigInteger num, BigInteger den) {
+        static Q of(BigInteger n, BigInteger d) {
+            if (d.signum() == 0) {
+                throw new ArithmeticException("zero denominator");
+            }
+            if (d.signum() < 0) {
+                n = n.negate();
+                d = d.negate();
+            }
+            BigInteger g = n.gcd(d);
+            if (g.signum() == 0) {
+                return new Q(BigInteger.ZERO, BigInteger.ONE);
+            }
+            return new Q(n.divide(g), d.divide(g));
+        }
+
+        static Q of(long n, long d) {
+            return of(BigInteger.valueOf(n), BigInteger.valueOf(d));
+        }
+
+        static Q ofInt(long n) {
+            return new Q(BigInteger.valueOf(n), BigInteger.ONE);
+        }
+
+        Q add(Q o) {
+            return of(num.multiply(o.den).add(o.num.multiply(den)), den.multiply(o.den));
+        }
+
+        Q sub(Q o) {
+            return of(num.multiply(o.den).subtract(o.num.multiply(den)), den.multiply(o.den));
+        }
+
+        Q mul(Q o) {
+            return of(num.multiply(o.num), den.multiply(o.den));
+        }
+
+        Q div(Q o) {
+            return of(num.multiply(o.den), den.multiply(o.num));
+        }
+
+        Q neg() {
+            return new Q(num.negate(), den);
+        }
+
+        Q abs() {
+            return new Q(num.abs(), den);
+        }
+
+        Q pow(int e) {
+            if (e >= 0) {
+                return new Q(num.pow(e), den.pow(e));
+            }
+            return of(den.pow(-e), num.pow(-e));
+        }
+
+        int cmp(Q o) {
+            return num.multiply(o.den).compareTo(o.num.multiply(den));
+        }
+
+        /**
+         * Representable with 32-bit parts in the natural form (positive denominator). A value such as
+         * 1 / 2^31 is representable only as -1 / MIN_VALUE, a form the arithmetic never produces on
+         * its own (Fraction keeps a negative denominator only when given one), so it does not count;
+         * arith() accepts either an overflow or the right value for such results.
+         */
+        boolean fitsInt() {
+            return isInt(num) && isInt(den);
+        }
+
+        /** Representable only with the sign on both parts (denominator 2^31). */
+        boolean fitsIntNegated() {
+            return !fitsInt() && isInt(num.negate()) && isInt(den.negate());
+        }
+
+        static boolean isInt(BigInteger b) {
+            return b.compareTo(IMIN) >= 0 && b.compareTo(IMAX) <= 0;
+        }
+
+        BigDecimal dec() {
+            return new BigDecimal(num).divide(new BigDecimal(den), MC);
+        }
+
+        double dbl() {
+            return dec().doubleValue();
+        }
+
+        /** floor(num / den). */
+        BigInteger floor() {
+            BigInteger[] qr = num.divideAndRemainder(den);
+            return qr[1].signum() < 0 ? qr[0].subtract(BigInteger.ONE) : qr[0];
+        }
+
+        boolean same(Fraction f) {
+            return BigInteger.valueOf(f.getNumerator()).multiply(den)
+                .equals(num.multiply(BigInteger.valueOf(f.getDenominator())));
+        }
+
+        boolean same(BigFraction f) {
+            return f.getNumerator().multiply(den).equals(num.multiply(f.getDenominator()));
+        }
+
+        @Override
+        public String toString() {
+            return num + "/" + den;
+        }
+    }
+
+    static int den(TestCase tc) {
+        int d = G.anyInt(tc);
+        return d == 0 ? 1 : d;
+    }
+
+    static Q model(Fraction f) {
+        return Q.of(f.getNumerator(), f.getDenominator());
+    }
+
+    static Q model(BigFraction f) {
+        return Q.of(f.getNumerator(), f.getDenominator());
+    }
+
+    static long ulpsApart(double a, double b) {
+        if (Double.isNaN(a) || Double.isNaN(b)) {
+            return Long.MAX_VALUE;
+        }
+        long x = Double.doubleToLongBits(a);
+        long y = Double.doubleToLongBits(b);
+        if (x < 0) {
+            x = Long.MIN_VALUE - x;
+        }
+        if (y < 0) {
+            y = Long.MIN_VALUE - y;
+        }
+        return Math.abs(x - y);
+    }
