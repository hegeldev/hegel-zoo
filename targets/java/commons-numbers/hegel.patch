+    /**
+     * round(v, scale, mode) is the BigDecimal rounding of Double.toString(v) at that scale, with the sign of v on a zero,
+     * idempotent, and HALF_UP by default. Double.toString has at most 17 significant digits and |v| is below 10^400 / 2,
+     * so a scale above 1100 rounds nothing and a scale below -400 rounds everything to 0 or to the next power of ten,
+     * whatever the scale: the model clamps the scale, which keeps its own arithmetic small.
+     */
+    static void roundAgreesWithTheDecimalString(double v, int scale, RoundingMode mode) {
+        String rin = "round(" + hx(v) + ", " + scale + ", " + mode + ")";
+        if (!Double.isFinite(v)) {
+            check(Double.doubleToLongBits(Precision.round(v, scale, mode)) == Double.doubleToLongBits(v), () -> rin + " should return the argument");
+            return;
+        }
+        BigDecimal dec = new BigDecimal(Double.toString(v));
+        int ms = Math.max(-400, Math.min(1100, scale));
+        boolean needsRounding = dec.scale() > ms && dec.setScale(ms, RoundingMode.DOWN).compareTo(dec) != 0;
+        if (mode == RoundingMode.UNNECESSARY && needsRounding) {
+            check(throwsA(ArithmeticException.class, () -> Precision.round(v, scale, mode)), () -> rin + " should throw (documented)");
+            return;
+        }
+        double r;
+        try {
+            r = Precision.round(v, scale, mode);
+        } catch (ArithmeticException ex) {
+            check(false, () -> rin + " threw " + ex);
+            return;
+        }
+        BigDecimal expected = dec.setScale(ms, mode);
+        double ed = expected.doubleValue();
+        if (ed == 0) {
+            ed = Math.copySign(0.0, v);
+        }
+        final double fed = ed;
+        check(Double.doubleToLongBits(r) == Double.doubleToLongBits(fed), () -> rin + " = " + hx(r) + " expected " + hx(fed));
+        if (mode != RoundingMode.UNNECESSARY) {
+            check(Precision.round(r, scale, mode) == r, () -> rin + " = " + r + " is not idempotent: " + Precision.round(r, scale, mode));
+            check(Precision.round(v, scale) == Precision.round(v, scale, RoundingMode.HALF_UP) || mode != RoundingMode.HALF_UP, () -> "round(x, scale) is HALF_UP");
+            if (Math.abs(r) < 1e15 && r != 0) {
+                BigDecimal rd = new BigDecimal(Double.toString(r)).stripTrailingZeros();
+                check(rd.scale() <= Math.max(scale, 0) || scale < 0 && rd.scale() <= scale, () -> rin + " = " + r + " has more decimals than the scale");
+            }
+        }
+    }
+
+    /**
+     * round(v, scale, mode) for a random v in [-1000, 1000] and a scale beyond 7.2e8 in magnitude, where BigDecimal
+     * refuses the power of ten at once (between about 5.4e8 and 7.16e8 it computes it first, for minutes; below that it
+     * works), or Integer.MIN_VALUE, where its scale arithmetic underflows, judged as
+     * precisionComparisonsFollowTheirDefinitions judges it: the values are v and 0 (or the next power of ten), but the
+     * ArithmeticException escapes (commons-numbers/14). Beside it (HEGEL_NO_KNOWN) scales of 300 to 1100 in magnitude.
+     */
+    @Test
+    void roundWithAnExtremeScaleGivesTheDecimalRounding() {
