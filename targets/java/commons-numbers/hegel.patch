+    interface Op<T> {
+        T run() throws Exception;
+    }
+
+    static void arith(String what, Fraction fa, Fraction fb, BigFraction ba, BigFraction bb, Q expected, Op<Fraction> f, Op<BigFraction> bf) {
+        String in = what + " on " + fa + " and " + fb;
+        if (expected.fitsInt()) {
+            Fraction r;
+            try {
+                r = f.run();
+            } catch (Exception ex) {
+                // Known.SPURIOUS_OVERFLOW (commons-numbers/5): gcd(MIN_VALUE, MIN_VALUE) inside the arithmetic, or a
+                // numerator overflowing because the sign sits in the denominator, throws for a representable result
+                boolean shape = Known.SPURIOUS_OVERFLOW && ex instanceof ArithmeticException
+                    && (fa.getDenominator() < 0 || fb.getDenominator() < 0 || fa.getNumerator() == Integer.MIN_VALUE
+                        || fb.getNumerator() == Integer.MIN_VALUE || what.contains("int " + Integer.MIN_VALUE));
+                if (!shape) {
+                    check(false, () -> in + " threw " + ex + " expected " + expected);
+                }
+                return;
+            }
+            check(model(r).equals(expected), () -> in + " gave " + r + " expected " + expected);
+        } else {
+            check(throwsA(ArithmeticException.class, f::run), () -> in + " should overflow (expected " + expected + ")");
+        }
+        BigFraction br;
+        try {
+            br = bf.run();
+        } catch (Exception ex) {
+            check(false, () -> "BigFraction " + in + " threw " + ex);
+            return;
+        }
+        check(model(br).equals(expected), () -> "BigFraction " + in + " gave " + br + " expected " + expected);
+    }
