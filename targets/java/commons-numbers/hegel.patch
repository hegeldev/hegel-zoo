+                x = Math.rint(x) + (chance(tc, 50) ? 1 : -1) * G.logUniform(tc, -12, -1);
+            }
+            final double fx = x;
+            if (!isInteger(x) || x > 0) {
+                // recurrence: Gamma(x + 1) = x Gamma(x)
+                double g = Gamma.value(x);
+                double g1 = Gamma.value(x + 1);
+                if (Double.isFinite(g) && Double.isFinite(g1) && Math.abs(g) > 1e-290 && Math.abs(g1) > 1e-290 && x + 1 != x) {
+                    double rel = Math.abs(g1 - x * g) / Math.abs(g1);
+                    check(rel <= 1e-12 || Math.abs(x) < 1e-3, () -> "Gamma(x + 1) vs x Gamma(x) at " + hx(fx) + ": " + g1 + " vs " + fx * g);
+                }
+                // reflection: Gamma(x) Gamma(1 - x) = pi / sin(pi x) (away from the integers)
+                double g2 = Gamma.value(1 - x);
+                double s = Math.sin(Math.PI * x);
+                if (Double.isFinite(g) && Double.isFinite(g2) && Math.abs(g * g2) < 1e300 && Math.abs(s) > 1e-3 && Math.abs(x) < 20) {
+                    double rel = Math.abs(g * g2 - Math.PI / s) / Math.abs(Math.PI / s);
+                    check(rel <= 1e-12, () -> "reflection at " + hx(fx) + ": Gamma(x) Gamma(1 - x) = " + g * g2 + " vs pi / sin(pi x) = " + Math.PI / s);
+                }
+                // LogGamma vs Gamma
+                int[] sign = new int[1];
+                double lg = LogGamma.value(x, sign);
+                if (Double.isFinite(g) && g != 0 && Math.abs(g) < 1e300 && Math.abs(g) > 1e-300) {
+                    double diff = Math.abs(lg - Math.log(Math.abs(g)));
+                    check(diff <= 1e-12 * Math.max(1, Math.abs(lg)), () -> "LogGamma(" + hx(fx) + ") = " + lg + " vs log|Gamma| = " + Math.log(Math.abs(g)));
+                    check(sign[0] == (g > 0 ? 1 : -1), () -> "LogGamma sign at " + hx(fx) + " = " + sign[0] + " but Gamma = " + g);
+                }
+            }
+            // error functions
+            double e = G.in(tc, -30, 30);
+            if (chance(tc, 30)) {
+                e = G.logUniform(tc, -300, 1) * (chance(tc, 50) ? 1 : -1);
+            }
+            final double fe = e;
+            double erf = Erf.value(e);
+            double erfc = Erfc.value(e);
+            check(Math.abs(erf + erfc - 1) <= 2e-16 || Math.abs(erf + erfc - 1) <= 4 * Math.ulp(1.0), () -> "Erf + Erfc at " + hx(fe) + " = " + (erf + erfc));
+            if (Math.abs(e) < 26) {
+                double erfcx = Erfcx.value(e);
