+    static final MathContext MC = new MathContext(80);
+    static final BigDecimal PI = new BigDecimal("3.14159265358979323846264338327950288419716939937510582097494459230781640628620899");
+    static final BigDecimal TWO_PI = PI.multiply(BigDecimal.valueOf(2));
+    static final BigDecimal EPS106 = new BigDecimal(2).pow(106, MC).pow(-1, MC);
+
+    static String hx(double x) {
+        return x + " (" + Double.toHexString(x) + ")";
+    }
+
+    /** Signed ulp distance: the number of doubles between a and b (0 for +0/-0), Long.MAX_VALUE for NaN. */
+    static long ulpDistance(double a, double b) {
+        if (Double.isNaN(a) || Double.isNaN(b)) {
+            return Long.MAX_VALUE;
+        }
+        long x = Double.doubleToLongBits(a);
+        long y = Double.doubleToLongBits(b);
+        if (x < 0) {
+            x = Long.MIN_VALUE - x;
+        }
+        if (y < 0) {
+            y = Long.MIN_VALUE - y;
+        }
+        long d = x - y;
+        return d < 0 ? (d == Long.MIN_VALUE ? Long.MAX_VALUE : -d) : d;
+    }
+
+    // ----------------------------------------------------------------------------------------------- Precision
+
+    @Test
+    void precisionComparisonsFollowTheirDefinitions() {
+        property("precisionComparisonsFollowTheirDefinitions", tc -> {
+            double x = G.any(tc);
+            double y;
+            int shape = n(tc, 0, 9);
+            if (shape < 4) {
+                y = x;
+                int steps = n(tc, -4, 4);
+                for (int i = 0; i < Math.abs(steps); i++) {
+                    y = steps > 0 ? Math.nextUp(y) : Math.nextDown(y);
+                }
+            } else if (shape < 7) {
+                y = x + G.in(tc, -1, 1) * Math.ulp(x) * n(tc, 0, 1000);
+            } else {
+                y = G.any(tc);
+            }
+            final double fy = y;
+            boolean nan = Double.isNaN(x) || Double.isNaN(y);
+            long dist = ulpDistance(x, y);
+            int maxUlps = chance(tc, 80) ? n(tc, 0, 10) : pick(tc, 0, 1, 2, 100, Integer.MAX_VALUE);
+            String in = "(" + hx(x) + ", " + hx(fy) + ")";
+
+            boolean eq1 = !nan && dist <= 1;
+            check(Precision.equals(x, y) == eq1, () -> "equals" + in + " = " + Precision.equals(x, fy) + " expected " + eq1 + " (distance " + dist + ")");
+            boolean eqN = !nan && dist <= maxUlps;
+            check(Precision.equals(x, y, maxUlps) == eqN, () -> "equals" + in + " with " + maxUlps + " ulps = " + Precision.equals(x, fy, maxUlps) + " expected " + eqN + " (distance " + dist + ")");
+            check(Precision.equalsIncludingNaN(x, y, maxUlps) == (Double.isNaN(x) && Double.isNaN(y) || eqN),
+                () -> "equalsIncludingNaN" + in + " with " + maxUlps + " ulps");
+            check(Precision.equalsIncludingNaN(x, y) == (Double.isNaN(x) && Double.isNaN(y) || eq1), () -> "equalsIncludingNaN" + in);
+            int cmpN = Precision.compareTo(x, y, maxUlps);
