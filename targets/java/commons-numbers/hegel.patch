+                    () -> "pow(" + e + ", exp)" + in + " fraction " + f + " not in [0.5, 1)");
+            }
+            int sc = n(tc, -200, 200);
+            check(value(a.scalb(sc)).compareTo(av.multiply(pow2(sc))) == 0, () -> "scalb(" + sc + ")" + in + " = " + a.scalb(sc));
+            int[] ex = new int[1];
+            DD fr = a.frexp(ex);
