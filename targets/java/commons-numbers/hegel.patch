+    @Test
+    void brentSolverMeetsItsTolerance() {
+        property("brentSolverMeetsItsTolerance", tc -> {
+            double root = chance(tc, 80) ? G.in(tc, -100, 100) : pick(tc, 0.0, 1e-8, -1e-8, 1e6, -1e6, 0.5);
+            double rel = G.logUniform(tc, -15, -6);
+            double abs = G.logUniform(tc, -13, -6);
+            BrentSolver solver = new BrentSolver(rel, abs, 0);
+            DoubleUnaryOperator f = x -> {
+                double t = x - root;
+                return t * t * t + t;
+            };
+            double lo = root - G.logUniform(tc, -3, 2);
+            double hi = root + G.logUniform(tc, -3, 2);
+            String in = "BrentSolver(" + rel + ", " + abs + ", 0).findRoot(x -> (x - r)^3 + (x - r) with r = " + hx(root) + ", " + hx(lo) + ", " + hx(hi) + ")";
+            double found = solver.findRoot(f, lo, hi);
+            double bound = 2 * rel * Math.abs(found) + abs + Math.ulp(Math.max(Math.abs(lo), Math.abs(hi)));
+            check(Math.abs(found - root) <= bound, () -> in + " = " + hx(found) + " off by " + Math.abs(found - root) + " (allowed " + bound + ")");
+            double initial = G.in(tc, lo, hi);
+            double found2 = solver.findRoot(f, lo, initial, hi);
+            check(Math.abs(found2 - root) <= bound, () -> in + " with initial " + hx(initial) + " = " + hx(found2) + " off by " + Math.abs(found2 - root));
+            // contract: no bracketing, bad bounds
+            double lo2 = root + G.logUniform(tc, -3, 2);
+            check(throwsA(IllegalArgumentException.class, () -> solver.findRoot(f, lo2, lo2 + 1)), () -> "findRoot without a bracket should reject (" + lo2 + ")");
+            check(throwsA(IllegalArgumentException.class, () -> solver.findRoot(f, hi, lo)), () -> "findRoot with min > max should reject");
+            check(throwsA(IllegalArgumentException.class, () -> solver.findRoot(f, lo, hi + 1, hi)), () -> "findRoot with an initial outside the bracket should reject");
+            check(throwsA(IllegalArgumentException.class, () -> new BrentSolver(-1e-9, abs, 0)), () -> "a negative accuracy should reject");
+        });
+    }
+}
