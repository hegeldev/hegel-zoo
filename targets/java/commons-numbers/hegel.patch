+            boolean rad = chance(tc, 50);
+            double p = rad ? Angle.TWO_PI : 360.0;
+            int k = n(tc, 30, 50);
+            long q = (1L << k) + ln(tc, 0, (1L << k) / 5);
+            boolean positive = chance(tc, 50);
+            int m = n(tc, -4, 4);
+            double product;
+            double ulp;
+            for (int tries = 0;; tries++, q++) {
+                long factor = positive ? q + 1 : q;
+                product = factor * p;
+                ulp = Math.ulp(product);
+                // the rounding of the product in ulps, in [-0.5, 0.5], and the size past which the quotient rounds over
+                double e = new BigDecimal(product).subtract(new BigDecimal(factor).multiply(new BigDecimal(p))).doubleValue() / ulp;
