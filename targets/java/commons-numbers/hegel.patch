+#!/usr/bin/env python3
+"""mpmath oracle for the Commons Numbers Hegel tests.
+
+One request per line: an operation name and its arguments separated by tabs; each argument is a Python float hex
+string (Java's Double.toHexString output is accepted), or 'inf'/'-inf'/'nan'. The reply is one line: the results
+separated by tabs, each a decimal string with 40 significant digits (or inf/-inf/nan), or a line starting with
+'err' followed by the exception text. Complex operations take (re, im) pairs and return (re, im) pairs.
+"""
+import sys
+import mpmath
+from mpmath import mp, mpf, mpc
+
+mp.dps = 80
+
+
+def f(s):
+    if s in ('inf', 'Infinity'):
+        return mpf('inf')
+    if s in ('-inf', '-Infinity'):
+        return mpf('-inf')
+    if s == 'nan' or s == 'NaN':
+        return mpf('nan')
+    return mpf(float.fromhex(s))
+
+
+def out(v):
+    if isinstance(v, (mpc, complex)):
+        return out(v.real) + '\t' + out(v.imag)
+    v = mpf(v)
+    if mpmath.isnan(v):
+        return 'nan'
+    if mpmath.isinf(v):
+        return 'inf' if v > 0 else '-inf'
+    return mpmath.nstr(v, 40, min_fixed=-1, max_fixed=0)
+
+
+def lgamma_abs(x):
+    # log|Gamma(x)| for real x (mpmath's loggamma is complex for negative x)
+    return mpmath.log(abs(mpmath.gamma(x)))
+
+
+def erfcx(x):
+    return mpmath.exp(x * x) * mpmath.erfc(x)
+
+
+def erfcinv(x):
+    # erfc(y) = x  <=>  erf(y) = 1 - x, computed at the working precision
+    return mpmath.erfinv(1 - x)
+
+
+def gamma_p(a, x):
+    return mpmath.gammainc(a, 0, x, regularized=True)
+
+
+def gamma_q(a, x):
+    return mpmath.gammainc(a, x, mpmath.inf, regularized=True)
+
+
+def gamma_lower(a, x):
+    return mpmath.gammainc(a, 0, x)
+
+
+def gamma_upper(a, x):
+    return mpmath.gammainc(a, x, mpmath.inf)
+
+
+def beta_reg(x, a, b):
+    return mpmath.betainc(a, b, 0, x, regularized=True)
+
+
+def beta_tail(x, a, b, regularized):
+    # The integral over [x, 1] of t^(a-1) (1-t)^(b-1): B(a, b) - B_x(a, b) = B_(1-x)(b, a). mpmath's betainc(a, b, x, 1)
+    # is the difference of two integrals at the working precision, so a tail below about 1e-80 of B(a, b) comes back as
+    # rounding noise (x = 0.5, a = 0.001, b = 300: 2.0e-87 regularized for a true 3.3e-96). The swapped form has no
+    # subtraction and is exact as long as 1 - x is, which at 80 digits (269 bits) holds for every double x >= 2^-200.
+    # Below that 1 - x would round (to 1 for x < 2^-269), and the difference form is safe there: with a >= 1e-10 and
+    # b <= 320 the tail 1 - I_x(a, b) is at least a few 1e-9, far above the noise.
+    if x >= mpf(2) ** -200:
+        return mpmath.betainc(b, a, 0, 1 - x, regularized=regularized)
+    return mpmath.betainc(a, b, x, 1, regularized=regularized)
+
+
+def beta_reg_c(x, a, b):
+    return beta_tail(x, a, b, True)
+
+
+def beta_inc(x, a, b):
+    return mpmath.betainc(a, b, 0, x)
+
+
+def beta_inc_c(x, a, b):
+    return beta_tail(x, a, b, False)
+
+
+def lbeta(a, b):
+    return mpmath.log(mpmath.beta(a, b))
+
+
+def gamma_ratio(a, b):
+    return mpmath.gamma(a) / mpmath.gamma(b)
+
+
+def logbinom(n, k):
+    return lgamma_abs(n + 1) - lgamma_abs(k + 1) - lgamma_abs(n - k + 1)
+
+
+def logfact(n):
+    return lgamma_abs(n + 1)
+
+
+def _power_at_zero(exponent, rest):
+    # x^exponent * rest as x -> 0+: the limit, where log(0) would make the exp form nan
+    if exponent == 0:
+        return rest
+    return mpmath.mpf(0) if exponent > 0 else mpmath.inf
+
+
+def gamma_p_deriv(a, x):
+    # d/dx P(a, x) = x^(a-1) e^-x / Gamma(a)
+    if x == 0:
+        return _power_at_zero(a - 1, mpmath.exp(-mpmath.loggamma(a)))
+    return mpmath.exp((a - 1) * mpmath.log(x) - x - mpmath.loggamma(a))
+
+
+def beta_deriv(x, a, b):
+    # d/dx I_x(a, b) = x^(a-1) (1-x)^(b-1) / B(a, b)
+    if x == 0:
+        return _power_at_zero(a - 1, 1 / mpmath.beta(a, b))
+    if x == 1:
+        return _power_at_zero(b - 1, 1 / mpmath.beta(a, b))
+    return mpmath.exp((a - 1) * mpmath.log(x) + (b - 1) * mpmath.log(1 - x) - mpmath.log(mpmath.beta(a, b)))
+
+
+def loggamma1p(x):
+    return lgamma_abs(1 + x)
+
+
+def loggammasum(a, b):
+    return lgamma_abs(a + b)
+
+
+def trigamma(x):
+    # mpmath's polygamma(1, x) shifts a negative argument up by one per step (0.3 s at x = -1e5, 28 s at -1e7, never
+    # back from -1e14), so a negative argument is reflected: psi1(x) = pi^2 / sin^2(pi x) - psi1(1 - x), which agrees
+    # with the direct evaluation to the working precision; the poles are reported as polygamma does for digamma.
+    if x < 0:
+        if x == mpmath.floor(x):
+            raise ValueError('polygamma pole')
+        return mpmath.pi ** 2 / mpmath.sin(mpmath.pi * x) ** 2 - mpmath.polygamma(1, 1 - x)
+    return mpmath.polygamma(1, x)
+
+
+REAL = {
+    'gamma': mpmath.gamma,
+    'lgamma': lgamma_abs,
+    'lgamma1p': loggamma1p,
+    'logbinom': logbinom,
+    'logfact': logfact,
+    'lgammasum': loggammasum,
+    'digamma': mpmath.digamma,
+    'trigamma': trigamma,
+    'erf': mpmath.erf,
+    'erfc': mpmath.erfc,
+    'erfcx': erfcx,
+    'erfinv': mpmath.erfinv,
+    'erfcinv': erfcinv,
+    'beta': mpmath.beta,
+    'lbeta': lbeta,
+    'gamma_ratio': gamma_ratio,
+    'gamma_p': gamma_p,
+    'gamma_q': gamma_q,
+    'gamma_lower': gamma_lower,
+    'gamma_upper': gamma_upper,
+    'beta_reg': beta_reg,
+    'beta_reg_c': beta_reg_c,
+    'beta_inc': beta_inc,
+    'beta_inc_c': beta_inc_c,
+    'gamma_p_deriv': gamma_p_deriv,
+    'beta_deriv': beta_deriv,
+    'exp': mpmath.exp,
+    'log': mpmath.log,
+    'log1p': mpmath.log1p,
+    'expm1': mpmath.expm1,
+    'sqrt': mpmath.sqrt,
+    'cbrt': mpmath.cbrt,
+    'sin': mpmath.sin,
+    'cos': mpmath.cos,
+    'tan': mpmath.tan,
+    'atan2': mpmath.atan2,
+    'hypot': mpmath.hypot,
+    'pow': mpmath.power,
+    'mod2pi': lambda x: mpmath.fmod(x, 2 * mpmath.pi),
+}
+
+COMPLEX = {
+    'cexp': mpmath.exp,
+    'clog': mpmath.log,
+    'clog10': mpmath.log10,
+    'csqrt': mpmath.sqrt,
+    'csin': mpmath.sin,
+    'ccos': mpmath.cos,
+    'ctan': mpmath.tan,
+    'casin': mpmath.asin,
+    'cacos': mpmath.acos,
+    'catan': mpmath.atan,
+    'csinh': mpmath.sinh,
+    'ccosh': mpmath.cosh,
+    'ctanh': mpmath.tanh,
+    'casinh': mpmath.asinh,
+    'cacosh': mpmath.acosh,
+    'catanh': mpmath.atanh,
+    'cabs': lambda z: mpmath.mpf(abs(z)),
+    'carg': lambda z: mpmath.arg(z),
+    'cpow': mpmath.power,
+    'cmul': lambda a, b: a * b,
+    'cdiv': lambda a, b: a / b,
+}
+
+
+def extra_bits(zs):
+    # mpmath forms the inverse functions from log(1 -+ i z) (and sqrt(1 - z^2)) at the working precision, so a part
+    # below 2^-269 is lost there: atan(1e-100 + 1e-100 i) came back as 1e-100 + 1.6e-86 i, atanh(1e-200 - 2.5 i) with
+    # a real part of 0. Enough extra bits to hold 1 + part exactly for the smallest non-zero part keep the small parts
+    # of every function exact; ordinary arguments add nothing.
+    smallest = min((abs(p) for z in zs for p in (z.real, z.imag) if p != 0 and mpmath.isfinite(p)), default=mpf(1))
+    return max(0, -mpmath.mag(smallest))
+
+
+def main():
+    for line in sys.stdin:
+        line = line.rstrip('\n')
+        if not line:
+            continue
+        parts = line.split('\t')
+        op, args = parts[0], parts[1:]
+        try:
+            if op in REAL:
+                r = REAL[op](*[f(a) for a in args])
+                sys.stdout.write(out(r) + '\n')
+            elif op in COMPLEX:
+                zs = [mpc(f(args[i]), f(args[i + 1])) for i in range(0, len(args), 2)]
+                with mp.workprec(mp.prec + extra_bits(zs)):
+                    r = COMPLEX[op](*zs)
+                sys.stdout.write(out(r) + '\n')
+            elif op == 'ping':
+                sys.stdout.write('pong ' + mpmath.__version__ + '\n')
+            else:
+                sys.stdout.write('err unknown op ' + op + '\n')
+        except Exception as e:  # noqa: BLE001 - reported to the Java side
+            sys.stdout.write('err ' + type(e).__name__ + ': ' + str(e).replace('\n', ' ') + '\n')
+        sys.stdout.flush()
+
+
+if __name__ == '__main__':
+    main()
