+            if (eps <= 0) {
+                // Known.FROM_ACCEPTS_EPSILON_ZERO (commons-numbers/16): documented to be rejected, with the epsilon in the message
+                if (!Known.FROM_ACCEPTS_EPSILON_ZERO) {
+                    rejectsEpsilon(in, x, eps, maxIter);
+                }
+            } else {
+                // Known.FROM_EPSILON_BELOW_ULP_IS_NOT_HONOURED (commons-numbers/17): the convergence test runs in double
+                // arithmetic; with the switch on an epsilon below the ulp of x is raised to 2^30 ulps, above which the half
+                // ulp that test may overshoot by stays within the tolerance of withinEpsilon
+                double e = Known.FROM_EPSILON_BELOW_ULP_IS_NOT_HONOURED && eps < Math.ulp(x) ? Math.scalb(Math.ulp(x), 30) : eps;
+                withinEpsilon(in, x, e, maxIter);
+            }
+            if (Math.abs(x) < 1e6) {
+                try {
+                    Fraction f = Fraction.from(x);
+                    BigDecimal err = xd.subtract(model(f).dec()).abs();
+                    check(err.compareTo(new BigDecimal("1.000000001e-5")) <= 0, () -> "Fraction.from(" + in + ") = " + f + " is off by " + err);
+                } catch (ArithmeticException ex) {
+                    // failed to converge: allowed by the contract
+                }
+            }
+        });
+    }
