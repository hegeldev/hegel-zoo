+    @Test
+    void fractionsAgreeWithBigIntegerRationals() {
+        property("fractionsAgreeWithBigIntegerRationals", tc -> {
+            int an = G.anyInt(tc);
+            int ad = den(tc);
+            int bn = G.anyInt(tc);
+            int bd = den(tc);
+            Q a = Q.of(an, ad);
+            Q b = Q.of(bn, bd);
+            Fraction fa = Fraction.of(an, ad);
+            Fraction fb = Fraction.of(bn, bd);
+            BigFraction ba = BigFraction.of(an, ad);
+            BigFraction bb = BigFraction.of(bn, bd);
+            String in = "Fraction.of(" + an + ", " + ad + ") and of(" + bn + ", " + bd + ")";
+
+            // representation
+            check(a.same(fa) && b.same(fb), () -> "value: " + in + " gave " + fa + " and " + fb + " for " + a + ", " + b);
+            check(a.same(ba) && b.same(bb), () -> "BigFraction value: " + in + " gave " + ba + " and " + bb);
+            check(BigInteger.valueOf(fa.getNumerator()).gcd(BigInteger.valueOf(fa.getDenominator())).equals(BigInteger.ONE)
+                || (fa.getNumerator() == 0 && fa.getDenominator() == 1),
+                () -> "reduced: " + in + " gave " + fa.getNumerator() + "/" + fa.getDenominator());
+            check(fa.signum() == a.num.signum(), () -> "signum: " + fa + " " + fa.signum());
+            check(fa.isZero() == (a.num.signum() == 0) && fa.isOne() == (a.num.equals(BigInteger.ONE) && a.den.equals(BigInteger.ONE)),
+                () -> "isZero/isOne: " + fa);
+            check(model(fa.abs()).equals(a.abs()) && model(ba.abs()).equals(a.abs()), () -> "abs: " + fa.abs() + " " + ba.abs());
+            if (a.neg().fitsInt()) {
+                if (!(Known.SPURIOUS_OVERFLOW && (fa.getDenominator() < 0 || fa.getNumerator() == Integer.MIN_VALUE)
+                    && throwsA(ArithmeticException.class, fa::negate))) {
+                    check(model(fa.negate()).equals(a.neg()), () -> "negate: " + fa.negate());
+                }
+            } else if (a.neg().fitsIntNegated()) {
+                negatedForm("negate of " + fa, a.neg(), fa::negate);
+            } else {
+                check(throwsA(ArithmeticException.class, fa::negate), () -> "negate of " + fa + " should overflow");
+            }
+            check(model(ba.negate()).equals(a.neg()), () -> "BigFraction negate: " + ba.negate());
+            if (a.num.signum() == 0) {
+                check(throwsA(ArithmeticException.class, fa::reciprocal), () -> "reciprocal of zero should throw");
+                check(throwsA(ArithmeticException.class, ba::reciprocal), () -> "BigFraction reciprocal of zero should throw");
+            } else {
+                Q r = Q.of(a.den, a.num);
+                if (r.fitsInt()) {
+                    if (!(Known.SPURIOUS_OVERFLOW && (fa.getDenominator() < 0 || fa.getNumerator() == Integer.MIN_VALUE)
+                        && throwsA(ArithmeticException.class, fa::reciprocal))) {
+                        check(model(fa.reciprocal()).equals(r), () -> "reciprocal: " + fa.reciprocal());
+                    }
+                } else if (r.fitsIntNegated()) {
+                    negatedForm("reciprocal of " + fa, r, fa::reciprocal);
+                } else {
+                    check(throwsA(ArithmeticException.class, fa::reciprocal), () -> "reciprocal of " + fa + " should overflow");
+                }
+                check(model(ba.reciprocal()).equals(r), () -> "BigFraction reciprocal: " + ba.reciprocal());
+            }
+
+            // conversions
+            double exact = a.dbl();
+            check(ulpsApart(fa.doubleValue(), exact) <= 1, () -> "doubleValue: " + fa + " = " + fa.doubleValue() + " exact " + exact);
+            check(ulpsApart(ba.doubleValue(), exact) <= 1, () -> "BigFraction doubleValue: " + ba + " = " + ba.doubleValue() + " exact " + exact);
+            check((float) exact == fa.floatValue() || Math.abs(Float.floatToIntBits(fa.floatValue()) - Float.floatToIntBits((float) exact)) <= 1,
