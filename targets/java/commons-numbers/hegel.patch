+            // sign, rounding and conversions
+            check(value(a.negate()).compareTo(av.negate()) == 0 && value(a.abs()).compareTo(av.abs()) == 0, () -> "negate/abs" + in);
+            check(value(a.floor()).compareTo(av.setScale(0, RoundingMode.FLOOR)) == 0, () -> "floor()" + in + " = " + a.floor() + " expected " + av.setScale(0, RoundingMode.FLOOR));
+            check(value(a.ceil()).compareTo(av.setScale(0, RoundingMode.CEILING)) == 0, () -> "ceil()" + in + " = " + a.ceil() + " expected " + av.setScale(0, RoundingMode.CEILING));
+            BigDecimal trunc = av.setScale(0, RoundingMode.DOWN);
+            long expectedLong = trunc.compareTo(new BigDecimal(Long.MAX_VALUE)) > 0 ? Long.MAX_VALUE : trunc.compareTo(new BigDecimal(Long.MIN_VALUE)) < 0 ? Long.MIN_VALUE : trunc.longValue();
+            int expectedInt = trunc.compareTo(new BigDecimal(Integer.MAX_VALUE)) > 0 ? Integer.MAX_VALUE : trunc.compareTo(new BigDecimal(Integer.MIN_VALUE)) < 0 ? Integer.MIN_VALUE : trunc.intValue();
+            check(a.longValue() == expectedLong, () -> "longValue()" + in + " = " + a.longValue() + " expected " + expectedLong);
+            check(a.intValue() == expectedInt, () -> "intValue()" + in + " = " + a.intValue() + " expected " + expectedInt);
+            check(a.doubleValue() == a.hi() + a.lo(), () -> "doubleValue()" + in);
+            check(a.bigDecimalValue().compareTo(av) == 0, () -> "bigDecimalValue()" + in + " = " + a.bigDecimalValue());
+            DD back = DD.from(av);
+            within("from(bigDecimalValue())" + in, back, av, 1);
+            check(a.toString().equals("(" + a.hi() + "," + a.lo() + ")"), () -> "toString()" + in + " = " + a.toString());
+            check(a.equals(DD.ofSum(a.hi(), a.lo())) && a.hashCode() == DD.ofSum(a.hi(), a.lo()).hashCode(), () -> "equals/hashCode of a re-created value" + in);
+            check(a.isZero() == (av.signum() == 0) && a.isOne() == (av.compareTo(BigDecimal.ONE) == 0), () -> "isZero/isOne" + in);
+        });
+    }
