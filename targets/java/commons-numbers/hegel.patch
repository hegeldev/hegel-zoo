+    @Test
+    void betaDerivativeOfASubnormalXStaysFinite() {
+        property("betaDerivativeOfASubnormalXStaysFinite", tc -> {
+            // x in [2^-1074, 2^-1024], where the result is infinite, NaN or 0 for every a and b (beside the shape under
+            // HEGEL_NO_KNOWN=1: [2^-100, 2^-60], where x^a stays normal for a up to 10)
+            boolean beside = Known.BETA_DERIVATIVE_LOSES_ITS_RANGE_FOR_TINY_X;
+            double x = Math.scalb(G.in(tc, 0.5, 1), -n(tc, beside ? 61 : 1025, beside ? 100 : 1073));
+            // a and b away from 1 (the a = 1 and b = 1 branches are closed forms); a >= 1.1 keeps the exact value below 1
+            double a = G.in(tc, 1.1, 10);
+            double b = chance(tc, 50) ? G.in(tc, 1.1, 10) : G.in(tc, 0.1, 0.9);
+            String bin = "(x = " + hx(x) + ", a = " + hx(a) + ", b = " + hx(b) + ")";
+            double d = RegularizedBeta.derivative(x, a, b);
+            // the closed form x^(a-1) (1-x)^(b-1) / B(a, b) in logarithms: tiny or zero here, never above 1
+            double exact = Math.exp((a - 1) * Math.log(x) + (b - 1) * Math.log1p(-x) - LogBeta.value(a, b));
+            check(Double.isFinite(d) && d >= 0 && d <= 1, () -> "RegularizedBeta.derivative" + bin + " = " + d + " (exact about " + exact + ")");
+            check(exact < 1e-300 ? d < 1e-290 : Math.abs(d - exact) <= 1e-6 * exact, () -> "RegularizedBeta.derivative" + bin + " = " + d + " expected about " + exact);
+        });
+    }
