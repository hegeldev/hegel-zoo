+++ b/hegel/oracle.py
@@ -0,0 +1,215 @@
+#!/usr/bin/env python3
+"""mpmath oracle for the Commons Numbers Hegel tests.
+
+One request per line: an operation name and its arguments separated by tabs; each argument is a Python float hex
+string (Java's Double.toHexString output is accepted), or 'inf'/'-inf'/'nan'. The reply is one line: the results
+separated by tabs, each a decimal string with 40 significant digits (or inf/-inf/nan), or a line starting with
+'err' followed by the exception text. Complex operations take (re, im) pairs and return (re, im) pairs.
+"""
+import sys
+import mpmath
+from mpmath import mp, mpf, mpc
+
+mp.dps = 80
+
+
+def f(s):
+    if s in ('inf', 'Infinity'):
+        return mpf('inf')
+    if s in ('-inf', '-Infinity'):
+        return mpf('-inf')
+    if s == 'nan' or s == 'NaN':
+        return mpf('nan')
+    return mpf(float.fromhex(s))
+
+
+def out(v):
+    if isinstance(v, (mpc, complex)):
+        return out(v.real) + '\t' + out(v.imag)
+    v = mpf(v)
+    if mpmath.isnan(v):
+        return 'nan'
+    if mpmath.isinf(v):
+        return 'inf' if v > 0 else '-inf'
+    return mpmath.nstr(v, 40, min_fixed=-1, max_fixed=0)
+
+
+def lgamma_abs(x):
+    # log|Gamma(x)| for real x (mpmath's loggamma is complex for negative x)
+    return mpmath.log(abs(mpmath.gamma(x)))
+
+
+def erfcx(x):
+    return mpmath.exp(x * x) * mpmath.erfc(x)
+
+
+def erfcinv(x):
+    # erfc(y) = x  <=>  erf(y) = 1 - x, computed at the working precision
+    return mpmath.erfinv(1 - x)
+
+
+def gamma_p(a, x):
+    return mpmath.gammainc(a, 0, x, regularized=True)
+
+
+def gamma_q(a, x):
+    return mpmath.gammainc(a, x, mpmath.inf, regularized=True)
+
+
+def gamma_lower(a, x):
+    return mpmath.gammainc(a, 0, x)
+
+
+def gamma_upper(a, x):
+    return mpmath.gammainc(a, x, mpmath.inf)
+
+
+def beta_reg(x, a, b):
+    return mpmath.betainc(a, b, 0, x, regularized=True)
+
+
+def beta_reg_c(x, a, b):
+    # 1 - I_x(a, b) = I_(1-x)(b, a); mpmath's betainc(a, b, x, 1) cancels catastrophically near x = 1,
+    # while 1 - x rounds to 1 for tiny x, so each half of [0, 1] uses the form that stays exact
+    if x > 0.5:
+        return mpmath.betainc(b, a, 0, 1 - x, regularized=True)
+    return mpmath.betainc(a, b, x, 1, regularized=True)
+
+
+def beta_inc(x, a, b):
+    return mpmath.betainc(a, b, 0, x)
+
+
+def beta_inc_c(x, a, b):
+    if x > 0.5:
+        return mpmath.betainc(b, a, 0, 1 - x)
+    return mpmath.betainc(a, b, x, 1)
+
+
+def lbeta(a, b):
+    return mpmath.log(mpmath.beta(a, b))
+
+
+def gamma_ratio(a, b):
+    return mpmath.gamma(a) / mpmath.gamma(b)
+
+
+def logbinom(n, k):
+    return lgamma_abs(n + 1) - lgamma_abs(k + 1) - lgamma_abs(n - k + 1)
+
+
+def logfact(n):
+    return lgamma_abs(n + 1)
+
+
+def gamma_p_deriv(a, x):
+    # d/dx P(a, x) = x^(a-1) e^-x / Gamma(a)
+    return mpmath.exp((a - 1) * mpmath.log(x) - x - mpmath.loggamma(a))
+
+
+def beta_deriv(x, a, b):
+    # d/dx I_x(a, b) = x^(a-1) (1-x)^(b-1) / B(a, b)
+    return mpmath.exp((a - 1) * mpmath.log(x) + (b - 1) * mpmath.log(1 - x) - mpmath.log(mpmath.beta(a, b)))
+
+
+def loggamma1p(x):
+    return lgamma_abs(1 + x)
+
+
+def loggammasum(a, b):
+    return lgamma_abs(a + b)
+
+
+REAL = {
+    'gamma': mpmath.gamma,
+    'lgamma': lgamma_abs,
+    'lgamma1p': loggamma1p,
+    'logbinom': logbinom,
+    'logfact': logfact,
+    'lgammasum': loggammasum,
+    'digamma': mpmath.digamma,
+    'trigamma': lambda x: mpmath.polygamma(1, x),
+    'erf': mpmath.erf,
+    'erfc': mpmath.erfc,
+    'erfcx': erfcx,
+    'erfinv': mpmath.erfinv,
+    'erfcinv': erfcinv,
+    'beta': mpmath.beta,
+    'lbeta': lbeta,
+    'gamma_ratio': gamma_ratio,
+    'gamma_p': gamma_p,
+    'gamma_q': gamma_q,
+    'gamma_lower': gamma_lower,
+    'gamma_upper': gamma_upper,
+    'beta_reg': beta_reg,
+    'beta_reg_c': beta_reg_c,
+    'beta_inc': beta_inc,
+    'beta_inc_c': beta_inc_c,
+    'gamma_p_deriv': gamma_p_deriv,
+    'beta_deriv': beta_deriv,
+    'exp': mpmath.exp,
+    'log': mpmath.log,
+    'log1p': mpmath.log1p,
+    'expm1': mpmath.expm1,
+    'sqrt': mpmath.sqrt,
+    'cbrt': mpmath.cbrt,
+    'sin': mpmath.sin,
+    'cos': mpmath.cos,
+    'tan': mpmath.tan,
+    'atan2': mpmath.atan2,
+    'hypot': mpmath.hypot,
+    'pow': mpmath.power,
+    'mod2pi': lambda x: mpmath.fmod(x, 2 * mpmath.pi),
+}
+
+COMPLEX = {
+    'cexp': mpmath.exp,
+    'clog': mpmath.log,
+    'clog10': mpmath.log10,
+    'csqrt': mpmath.sqrt,
+    'csin': mpmath.sin,
+    'ccos': mpmath.cos,
+    'ctan': mpmath.tan,
+    'casin': mpmath.asin,
+    'cacos': mpmath.acos,
+    'catan': mpmath.atan,
+    'csinh': mpmath.sinh,
+    'ccosh': mpmath.cosh,
+    'ctanh': mpmath.tanh,
+    'casinh': mpmath.asinh,
+    'cacosh': mpmath.acosh,
+    'catanh': mpmath.atanh,
+    'cabs': lambda z: mpmath.mpf(abs(z)),
+    'carg': lambda z: mpmath.arg(z),
+    'cpow': mpmath.power,
+    'cmul': lambda a, b: a * b,
+    'cdiv': lambda a, b: a / b,
+}
+
+
+def main():
+    for line in sys.stdin:
+        line = line.rstrip('\n')
+        if not line:
+            continue
+        parts = line.split('\t')
+        op, args = parts[0], parts[1:]
+        try:
+            if op in REAL:
+                r = REAL[op](*[f(a) for a in args])
+                sys.stdout.write(out(r) + '\n')
+            elif op in COMPLEX:
+                zs = [mpc(f(args[i]), f(args[i + 1])) for i in range(0, len(args), 2)]
+                r = COMPLEX[op](*zs)
+                sys.stdout.write(out(r) + '\n')
+            elif op == 'ping':
+                sys.stdout.write('pong ' + mpmath.__version__ + '\n')
+            else:
+                sys.stdout.write('err unknown op ' + op + '\n')
+        except Exception as e:  # noqa: BLE001 - reported to the Java side
+            sys.stdout.write('err ' + type(e).__name__ + ': ' + str(e).replace('\n', ' ') + '\n')
+        sys.stdout.flush()
+
+
+if __name__ == '__main__':
+    main()
