+                    check(rel <= 1e-12 || Math.abs(e) < 1e-8, () -> "Erfcx exp(-x^2) vs Erfc at " + hx(fe) + ": " + erfcx * ex + " vs " + erfc);
+                }
+            }
+            double y = G.in(tc, -1, 1);
+            if (chance(tc, 30)) {
+                y = (chance(tc, 50) ? 1 : -1) * (1 - G.logUniform(tc, -16, -1));
+            }
+            final double fy = y;
+            double inv = InverseErf.value(y);
+            double back = Erf.value(inv);
+            check(Math.abs(back - y) <= 1e-15 || Math.abs(back - y) <= 8 * Math.ulp(y) || Math.abs(y) > 1 - 1e-12,
+                () -> "Erf(InverseErf(" + hx(fy) + ")) = " + back + " via " + inv);
+            double yc = 1 - y;
