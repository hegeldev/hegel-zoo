+    // ---------------------------------------------------------------------------------------------------- DD
+
+    static BigDecimal value(DD d) {
+        return new BigDecimal(d.hi()).add(new BigDecimal(d.lo()));
+    }
+
+    /** A normalised double-double of ordinary magnitude. */
+    static DD dd(TestCase tc) {
+        double hi = chance(tc, 80) ? G.bits(tc, 1023 - 100, 1023 + 100) : pick(tc, 1.0, -1.0, 0.5, 2.0, 3.0, 1e100, 1e-100, 0.1, 10.0);
+        double lo = chance(tc, 80) ? hi * Math.scalb(G.in(tc, -1, 1), -53) : 0.0;
+        return DD.ofSum(hi, lo);
+    }
+
+    /** 2^e as an exact BigDecimal. */
+    static BigDecimal pow2(long e) {
+        BigDecimal p = new BigDecimal(java.math.BigInteger.ONE.shiftLeft((int) Math.abs(e)));
+        return e >= 0 ? p : BigDecimal.ONE.divide(p);
+    }
+
+    static void within(String in, DD got, BigDecimal exact, double epsMultiple) {
+        if (exact.abs().compareTo(MAX) > 0 || exact.signum() != 0 && exact.abs().compareTo(new BigDecimal("1e-290")) < 0) {
+            return; // overflow or underflow of the parts: not supported (isFinite documents the check)
+        }
+        if (!got.isFinite()) {
+            check(false, () -> in + " = " + got + " is not finite (exact " + exact.round(new MathContext(30)) + ")");
+            return;
+        }
+        BigDecimal v = value(got);
+        BigDecimal err = v.subtract(exact).abs();
+        if (exact.signum() == 0) {
+            check(err.signum() == 0, () -> in + " = " + got + " expected exactly 0");
+            return;
+        }
+        BigDecimal rel = err.divide(exact.abs(), MC);
+        BigDecimal bound = EPS106.multiply(BigDecimal.valueOf(epsMultiple));
+        check(rel.compareTo(bound) <= 0, () -> in + " = " + got + " relative error " + rel.round(new MathContext(5)) + " exceeds " + epsMultiple + " eps (2^-106); exact " + exact.round(new MathContext(40)));
+    }
+
+    /**
+     * A double-double whose high part is (1 + j 2^-52) 2^e for j below 2^20, and whose low part lies an odd number of
+     * 2^-106 (relative) units below half an ulp, on the side of the high part: the operands on which Dekker's mul2
+     * reaches its 5 eps (an even number of units, or a low part against the high part, never exceeds 4).
+     */
+    static DD nearPowerOfTwoWithMaximalLow(TestCase tc) {
+        int e = n(tc, -60, 60);
+        double sign = chance(tc, 50) ? 1 : -1;
+        double hi = sign * Math.scalb(1 + Math.scalb((double) n(tc, 0, 1 << 20), -52), e);
+        double lo = sign * (Math.scalb(1.0, e - 53) - Math.scalb(2 * n(tc, 0, 15) + 1.0, e - 106));
+        return DD.ofSum(hi, lo);
+    }
+
+    /**
+     * multiply(DD) against its documented 4 eps on pairs of {@link #nearPowerOfTwoWithMaximalLow} operands
+     * (commons-numbers/20; the shape doubleDoubleArithmeticStaysWithinItsBounds reaches by chance). One pair in four
+     * exceeds 4 eps, so a case judges 12 pairs and a run of 100 cases fails with certainty.
+     */
+    @Test
+    void multiplyOfMaximalLowPartsStaysWithinFourEps() {
+        property("multiplyOfMaximalLowPartsStaysWithinFourEps", tc -> {
+            for (int i = 0; i < 12; i++) {
+                DD a = nearPowerOfTwoWithMaximalLow(tc);
+                DD b = nearPowerOfTwoWithMaximalLow(tc);
+                // under HEGEL_NO_KNOWN=1 the algorithm's own bound, 5 eps, as the wide property judges it
+                within("multiply(DD " + b + ") of " + a, a.multiply(b), value(a).multiply(value(b)), Known.DD_MULTIPLY_EXCEEDS_FOUR_EPS ? 5 : 4);
+            }
+        });
+    }
+
+    @Test
+    void conversionsOfAValueJustAboveMinusOneTruncateToZero() {
+        property("conversionsOfAValueJustAboveMinusOneTruncateToZero", tc -> {
+            // -1 + lo with lo in (0, 2^-54): a value in (-1, 0), whose truncation towards zero is 0
+            double lo = Math.scalb(Math.abs(G.bits(tc, 60, 1022)), -54);
+            // beside the shape under HEGEL_NO_KNOWN=1: the mirrored value 1 - lo, which truncates to 0 as documented
+            DD a = Known.LONG_VALUE_OF_MINUS_ONE_PLUS_A_LOW_PART ? DD.ofSum(1.0, -lo) : DD.ofSum(-1.0, lo);
+            String in = " of " + a + " (" + value(a).round(new MathContext(40)) + ")";
+            check(a.longValue() == 0, () -> "longValue()" + in + " = " + a.longValue() + " expected 0");
+            check(a.intValue() == 0, () -> "intValue()" + in + " = " + a.intValue() + " expected 0");
+        });
+    }
+
+    @Test
+    void doubleDoubleArithmeticStaysWithinItsBounds() {
+        property("doubleDoubleArithmeticStaysWithinItsBounds", tc -> {
+            DD a = dd(tc);
+            DD b = dd(tc);
