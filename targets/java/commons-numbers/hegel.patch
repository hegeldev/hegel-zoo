+    /** Two vectors of the dimension with entries in [-1, 1] times 2^scale1 and 2^scale2, the second parallel to the first in some entries. */
+    static double[][] vectors(TestCase tc, int dim, int scale1, int scale2) {
+        double[] v1 = new double[dim];
+        double[] v2 = new double[dim];
+        for (int i = 0; i < dim; i++) {
+            v1[i] = Math.scalb(G.in(tc, -1, 1), scale1);
+            v2[i] = chance(tc, 30) ? Math.scalb(v1[i], scale2 - scale1) * pick(tc, 1, -1, 3) : Math.scalb(G.in(tc, -1, 1), scale2);
+        }
+        return new double[][] {v1, v2};
+    }
+
+    /** CosAngle.value of the two vectors is the exact cosine to 8 eps (zero vectors are undocumented). */
+    static void cosAngleAgreesWithExact(double[][] v) {
+        double[] v1 = v[0];
+        double[] v2 = v[1];
+        BigDecimal dot = BigDecimal.ZERO;
+        BigDecimal n1 = BigDecimal.ZERO;
+        BigDecimal n2 = BigDecimal.ZERO;
+        for (int i = 0; i < v1.length; i++) {
+            BigDecimal p = new BigDecimal(v1[i]);
+            BigDecimal q = new BigDecimal(v2[i]);
+            dot = dot.add(p.multiply(q));
+            n1 = n1.add(p.multiply(p));
+            n2 = n2.add(q.multiply(q));
+        }
+        if (n1.signum() == 0 || n2.signum() == 0) {
+            return; // zero vectors: undocumented (NaN)
+        }
+        BigDecimal cos = dot.divide(n1.sqrt(MC).multiply(n2.sqrt(MC)), MC);
+        double got = CosAngle.value(v1, v2);
+        String cin = "CosAngle.value(" + show(v1) + ", " + show(v2) + ")";
+        // Known.COS_ANGLE_UNSCALED (commons-numbers/12): the dot product is not scaled like the norms
+        boolean unscaled = dot.abs().compareTo(new BigDecimal("1e290")) > 0 || dot.signum() != 0 && dot.abs().compareTo(new BigDecimal("1e-290")) < 0
+            || n1.compareTo(new BigDecimal("1e290")) > 0 || n2.compareTo(new BigDecimal("1e290")) > 0
+            || n1.compareTo(new BigDecimal("1e-290")) < 0 || n2.compareTo(new BigDecimal("1e-290")) < 0;
+        if (Known.COS_ANGLE_UNSCALED && unscaled) {
+            return;
+        }
+        check(Double.isFinite(got) && Math.abs(got) <= 1 + 4 * 0x1.0p-53, () -> cin + " = " + got + " is not a cosine");
+        double err = Double.isFinite(got) ? new BigDecimal(got).subtract(cos).abs().doubleValue() : Double.POSITIVE_INFINITY;
+        check(err <= 8 * 0x1.0p-53, () -> cin + " = " + got + " exact " + cos.round(new MathContext(20)) + " error " + err);
+    }
+
+    /**
+     * CosAngle.value of two vectors whose entries have binary exponents of 520 to 1000, or -540 to -1000, within ten of
