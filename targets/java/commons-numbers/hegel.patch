+            // Known.INT_VALUE_TRUNCATES: negative non-integers are truncated towards zero, not floored (commons-numbers/1);
+            // with the switch on their negation is checked instead
+            if (Known.INT_VALUE_TRUNCATES && a.num.signum() < 0 && !a.den.equals(BigInteger.ONE)) {
+                floorOfIntAndLongValue(fa.negate(), ba.negate(), a.neg());
+            } else {
