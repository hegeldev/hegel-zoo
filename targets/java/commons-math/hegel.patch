+++ b/hegel/src/test/java/zoo/PinsTest.java
@@ -0,0 +1,58 @@
+package zoo;
+
+import org.apache.commons.math4.legacy.analysis.polynomials.PolynomialFunction;
+import org.apache.commons.math4.legacy.analysis.solvers.SecantSolver;
+import org.apache.commons.math4.legacy.linear.Array2DRowRealMatrix;
+import org.apache.commons.math4.legacy.linear.EigenDecomposition;
+import org.apache.commons.math4.legacy.linear.RRQRDecomposition;
+import org.apache.commons.math4.legacy.linear.RealMatrix;
+import org.apache.commons.math4.legacy.linear.SingularValueDecomposition;
+import org.junit.jupiter.api.Assertions;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Hegel zoo: one plain test per recorded bug (bugs.toml). Each must fail while the bug is present
+ * and pass once it is fixed; target.toml lists them as expected failures.
+ */
+class PinsTest {
+
+    /**
+     * commons-math/1: EigenDecomposition.getDeterminant multiplies the real parts of the eigenvalues
+     * only, so a real matrix with complex eigenvalues gets the wrong determinant.
+     */
+    @Test
+    void pinEigenDeterminantIncludesComplexEigenvalues() {
+        // eigenvalues -3 +- i sqrt(31): the determinant is 40, the product of the real parts is 9
+        RealMatrix a = new Array2DRowRealMatrix(new double[][] {{-5, 5}, {-7, -1}});
+        EigenDecomposition eig = new EigenDecomposition(a);
+        Assertions.assertTrue(eig.hasComplexEigenvalues(), "the example has complex eigenvalues");
+        Assertions.assertEquals(40.0, eig.getDeterminant(), 1e-9, "getDeterminant of [[-5, 5], [-7, -1]]");
+    }
+
+    /** commons-math/2: RRQRDecomposition.getRank starts counting at 1, so the zero matrix has rank 1. */
+    @Test
+    void pinRrqrRankOfZeroMatrixIsZero() {
+        RealMatrix zero = new Array2DRowRealMatrix(new double[2][2]);
+        int svdRank = new SingularValueDecomposition(zero).getRank();
+        int rrqrRank = new RRQRDecomposition(zero).getRank(1e-10);
+        Assertions.assertEquals(0, svdRank, "SVD rank of the zero matrix");
+        Assertions.assertEquals(0, rrqrRank, "RRQR rank of the zero matrix");
+    }
+
+    /**
+     * commons-math/3: SecantSolver returns as soon as two successive iterates are within the absolute
+     * accuracy, without looking at the function value, so a near two-cycle of the iteration is reported
+     * as a root: for (x-1)(x-2)(x-6)(x-10) doubled, bracketed by [8, 12.5], it returns 8.705 where f = -362.
+     */
+    @Test
+    void pinSecantSolverDoesNotReportAFalseRoot() {
+        PolynomialFunction p = new PolynomialFunction(new double[] {240, -424, 220, -38, 2});
+        double x;
+        try {
+            x = new SecantSolver(1e-6).solve(1000, p, 8, 12.5);
+        } catch (org.apache.commons.math4.legacy.exception.MathIllegalStateException e) {
+            return; // not converging is an acceptable answer for the unbracketed secant method
+        }
+        Assertions.assertEquals(0.0, p.value(x), 1e-3, "f(" + x + ") for the reported root of (x-1)(x-2)(x-6)(x-10)");
+    }
+}
diff --git a/hegel/src/test/java/zoo/Rational.java b/hegel/src/test/java/zoo/Rational.java
new file mode 100644
index 0000000..a5d2b34
--- /dev/null
+++ b/hegel/src/test/java/zoo/Rational.java
@@ -0,0 +1,323 @@
+package zoo;
+
+import java.math.BigInteger;
+
+/** An exact rational number, the oracle's arithmetic (BigInteger numerator and positive denominator, reduced). */
+final class Rational implements Comparable<Rational> {
+    static final Rational ZERO = new Rational(BigInteger.ZERO, BigInteger.ONE);
+    static final Rational ONE = new Rational(BigInteger.ONE, BigInteger.ONE);
+
+    final BigInteger num;
+    final BigInteger den;
+
+    private Rational(BigInteger num, BigInteger den) {
+        this.num = num;
+        this.den = den;
+    }
+
+    static Rational of(long n) {
+        return new Rational(BigInteger.valueOf(n), BigInteger.ONE);
+    }
+
+    static Rational of(BigInteger n, BigInteger d) {
+        if (d.signum() == 0) {
+            throw new ArithmeticException("division by zero");
+        }
+        if (d.signum() < 0) {
+            n = n.negate();
+            d = d.negate();
+        }
+        BigInteger g = n.gcd(d);
+        if (!g.equals(BigInteger.ONE) && g.signum() != 0) {
+            n = n.divide(g);
+            d = d.divide(g);
+        }
+        return new Rational(n, d);
+    }
+
+    /** The exact value of a double (every finite double is a dyadic rational). */
+    static Rational of(double x) {
+        if (Double.isNaN(x) || Double.isInfinite(x)) {
+            throw new ArithmeticException("not finite: " + x);
+        }
+        if (x == 0) {
+            return ZERO;
+        }
+        long bits = Double.doubleToLongBits(x);
+        int sign = bits < 0 ? -1 : 1;
+        int exp = (int) ((bits >> 52) & 0x7ff);
+        long mant = bits & 0xfffffffffffffL;
+        if (exp == 0) {
+            exp = 1;
+        } else {
+            mant |= 1L << 52;
+        }
+        exp -= 1075;
+        BigInteger n = BigInteger.valueOf(sign * mant);
+        if (exp >= 0) {
+            return of(n.shiftLeft(exp), BigInteger.ONE);
+        }
+        return of(n, BigInteger.ONE.shiftLeft(-exp));
+    }
+
+    Rational add(Rational o) {
+        return of(num.multiply(o.den).add(o.num.multiply(den)), den.multiply(o.den));
+    }
+
+    Rational subtract(Rational o) {
+        return of(num.multiply(o.den).subtract(o.num.multiply(den)), den.multiply(o.den));
+    }
+
+    Rational multiply(Rational o) {
+        return of(num.multiply(o.num), den.multiply(o.den));
+    }
+
+    Rational multiply(long k) {
+        return of(num.multiply(BigInteger.valueOf(k)), den);
+    }
+
+    Rational divide(Rational o) {
+        return of(num.multiply(o.den), den.multiply(o.num));
+    }
+
+    Rational negate() {
+        return new Rational(num.negate(), den);
+    }
+
+    Rational abs() {
+        return num.signum() < 0 ? negate() : this;
+    }
+
+    int signum() {
+        return num.signum();
+    }
+
+    boolean isZero() {
+        return num.signum() == 0;
+    }
+
+    boolean isInteger() {
+        return den.equals(BigInteger.ONE);
+    }
+
+    double toDouble() {
+        return new java.math.BigDecimal(num).divide(new java.math.BigDecimal(den), java.math.MathContext.DECIMAL128).doubleValue();
+    }
+
+    @Override
+    public int compareTo(Rational o) {
+        return num.multiply(o.den).compareTo(o.num.multiply(den));
+    }
+
+    @Override
+    public boolean equals(Object o) {
+        return o instanceof Rational r && num.equals(r.num) && den.equals(r.den);
+    }
+
+    @Override
+    public int hashCode() {
+        return num.hashCode() * 31 + den.hashCode();
+    }
+
+    @Override
+    public String toString() {
+        return isInteger() ? num.toString() : num + "/" + den;
+    }
+
+    // ------------------------------------------------------------------ exact linear algebra
+
+    /** Row-reduces a copy of m; returns the rank. The pivots are recorded in pivotCols when given. */
+    static int rank(Rational[][] m) {
+        Rational[][] a = copy(m);
+        int rows = a.length;
+        int cols = rows == 0 ? 0 : a[0].length;
+        int r = 0;
+        for (int c = 0; c < cols && r < rows; c++) {
+            int p = -1;
+            for (int i = r; i < rows; i++) {
+                if (!a[i][c].isZero()) {
+                    p = i;
+                    break;
+                }
+            }
+            if (p < 0) {
+                continue;
+            }
+            Rational[] t = a[p];
+            a[p] = a[r];
+            a[r] = t;
+            for (int i = 0; i < rows; i++) {
+                if (i != r && !a[i][c].isZero()) {
+                    Rational f = a[i][c].divide(a[r][c]);
+                    for (int j = c; j < cols; j++) {
+                        a[i][j] = a[i][j].subtract(f.multiply(a[r][j]));
+                    }
+                }
+            }
+            r++;
+        }
+        return r;
+    }
+
+    /** The determinant of a square matrix by fraction-free elimination on rationals. */
+    static Rational determinant(Rational[][] m) {
+        Rational[][] a = copy(m);
+        int n = a.length;
+        Rational det = ONE;
+        for (int c = 0; c < n; c++) {
+            int p = -1;
+            for (int i = c; i < n; i++) {
+                if (!a[i][c].isZero()) {
+                    p = i;
+                    break;
+                }
+            }
+            if (p < 0) {
+                return ZERO;
+            }
+            if (p != c) {
+                Rational[] t = a[p];
+                a[p] = a[c];
+                a[c] = t;
+                det = det.negate();
+            }
+            det = det.multiply(a[c][c]);
+            for (int i = c + 1; i < n; i++) {
+                if (!a[i][c].isZero()) {
+                    Rational f = a[i][c].divide(a[c][c]);
+                    for (int j = c; j < n; j++) {
+                        a[i][j] = a[i][j].subtract(f.multiply(a[c][j]));
+                    }
+                }
+            }
+        }
+        return det;
+    }
+
+    /** The inverse of a nonsingular square matrix, or null when singular (Gauss-Jordan on [A | I]). */
+    static Rational[][] inverse(Rational[][] m) {
+        int n = m.length;
+        Rational[][] a = new Rational[n][2 * n];
+        for (int i = 0; i < n; i++) {
+            for (int j = 0; j < n; j++) {
+                a[i][j] = m[i][j];
+                a[i][n + j] = i == j ? ONE : ZERO;
+            }
+        }
+        for (int c = 0; c < n; c++) {
+            int p = -1;
+            for (int i = c; i < n; i++) {
+                if (!a[i][c].isZero()) {
+                    p = i;
+                    break;
+                }
+            }
+            if (p < 0) {
+                return null;
+            }
+            Rational[] t = a[p];
+            a[p] = a[c];
+            a[c] = t;
+            Rational inv = ONE.divide(a[c][c]);
+            for (int j = 0; j < 2 * n; j++) {
+                a[c][j] = a[c][j].multiply(inv);
+            }
+            for (int i = 0; i < n; i++) {
+                if (i != c && !a[i][c].isZero()) {
+                    Rational f = a[i][c];
+                    for (int j = 0; j < 2 * n; j++) {
+                        a[i][j] = a[i][j].subtract(f.multiply(a[c][j]));
+                    }
+                }
+            }
+        }
+        Rational[][] r = new Rational[n][n];
+        for (int i = 0; i < n; i++) {
+            System.arraycopy(a[i], n, r[i], 0, n);
+        }
+        return r;
+    }
+
+    static Rational[][] multiply(Rational[][] a, Rational[][] b) {
+        int n = a.length;
+        int k = b.length;
+        int m = b[0].length;
+        Rational[][] r = new Rational[n][m];
+        for (int i = 0; i < n; i++) {
+            for (int j = 0; j < m; j++) {
+                Rational s = ZERO;
+                for (int t = 0; t < k; t++) {
+                    s = s.add(a[i][t].multiply(b[t][j]));
+                }
+                r[i][j] = s;
+            }
+        }
+        return r;
+    }
+
+    static Rational[] multiply(Rational[][] a, Rational[] v) {
+        Rational[] r = new Rational[a.length];
+        for (int i = 0; i < a.length; i++) {
+            Rational s = ZERO;
+            for (int t = 0; t < v.length; t++) {
+                s = s.add(a[i][t].multiply(v[t]));
+            }
+            r[i] = s;
+        }
+        return r;
+    }
+
+    static Rational[][] transpose(Rational[][] a) {
+        int n = a.length;
+        int m = a[0].length;
+        Rational[][] r = new Rational[m][n];
+        for (int i = 0; i < n; i++) {
+            for (int j = 0; j < m; j++) {
+                r[j][i] = a[i][j];
+            }
+        }
+        return r;
+    }
+
+    static Rational[][] copy(Rational[][] m) {
+        Rational[][] a = new Rational[m.length][];
+        for (int i = 0; i < m.length; i++) {
+            a[i] = m[i].clone();
+        }
+        return a;
+    }
+
+    static Rational[][] fromDoubles(double[][] m) {
+        Rational[][] a = new Rational[m.length][];
+        for (int i = 0; i < m.length; i++) {
+            a[i] = new Rational[m[i].length];
+            for (int j = 0; j < m[i].length; j++) {
+                a[i][j] = of(m[i][j]);
+            }
+        }
+        return a;
+    }
+
+    static Rational[] fromDoubles(double[] v) {
+        Rational[] a = new Rational[v.length];
+        for (int j = 0; j < v.length; j++) {
+            a[j] = of(v[j]);
+        }
+        return a;
+    }
+
+    /** The maximum absolute column sum (the 1-norm). */
+    static Rational norm1(Rational[][] a) {
+        Rational best = ZERO;
+        for (int j = 0; j < a[0].length; j++) {
+            Rational s = ZERO;
+            for (Rational[] row : a) {
+                s = s.add(row[j].abs());
+            }
+            if (s.compareTo(best) > 0) {
+                best = s;
+            }
+        }
+        return best;
+    }
+}
diff --git a/hegel/src/test/java/zoo/StatTest.java b/hegel/src/test/java/zoo/StatTest.java
new file mode 100644
index 0000000..464cb6b
--- /dev/null
+++ b/hegel/src/test/java/zoo/StatTest.java
@@ -0,0 +1,703 @@
+package zoo;
+
+import static zoo.Zoo.chance;
+import static zoo.Zoo.count;
+import static zoo.Zoo.fail;
+import static zoo.Zoo.n;
+import static zoo.Zoo.pick;
+
+import dev.hegel.Hegel;
+import dev.hegel.TestCase;
+import java.math.BigInteger;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import org.apache.commons.math4.legacy.stat.Frequency;
+import org.apache.commons.math4.legacy.stat.StatUtils;
+import org.apache.commons.math4.legacy.stat.correlation.Covariance;
+import org.apache.commons.math4.legacy.stat.correlation.KendallsCorrelation;
+import org.apache.commons.math4.legacy.stat.correlation.PearsonsCorrelation;
+import org.apache.commons.math4.legacy.stat.correlation.SpearmansCorrelation;
+import org.apache.commons.math4.legacy.stat.descriptive.DescriptiveStatistics;
+import org.apache.commons.math4.legacy.stat.descriptive.SummaryStatistics;
+import org.apache.commons.math4.legacy.stat.regression.MillerUpdatingRegression;
+import org.apache.commons.math4.legacy.stat.regression.OLSMultipleLinearRegression;
+import org.apache.commons.math4.legacy.stat.regression.RegressionResults;
+import org.apache.commons.math4.legacy.stat.regression.SimpleRegression;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Hegel zoo: the descriptive statistics, correlations and regressions of Commons Math against exact
+ * rational arithmetic on small integer samples, and its containers against java.util models.
+ */
+class StatTest {
+
+    /** Known bugs, gated so the properties pass while the pins in PinsTest fail. */
+    static final class Known {
+    }
+
+    static double[] sample(TestCase tc, int lo, int hi) {
+        int m = n(tc, lo, hi);
+        double[] x = new double[m];
+        int range = pick(tc, 3, 9, 100);
+        for (int i = 0; i < m; i++) {
+            x[i] = chance(tc, 30) ? n(tc, -range, range) / 2.0 : n(tc, -range, range);
+        }
+        return x;
+    }
+
+    static Rational sum(double[] x) {
+        Rational s = Rational.ZERO;
+        for (double v : x) {
+            s = s.add(Rational.of(v));
+        }
+        return s;
+    }
+
+    static Rational mean(double[] x) {
+        return sum(x).divide(Rational.of(x.length));
+    }
+
+    /** Sum of (x - mean(x)) (y - mean(y)). */
+    static Rational crossSum(double[] x, double[] y) {
+        Rational mx = mean(x);
+        Rational my = mean(y);
+        Rational s = Rational.ZERO;
+        for (int i = 0; i < x.length; i++) {
+            s = s.add(Rational.of(x[i]).subtract(mx).multiply(Rational.of(y[i]).subtract(my)));
+        }
+        return s;
+    }
+
+    static boolean close(double a, double b, double tol) {
+        return Math.abs(a - b) <= tol;
+    }
+
+    static double sqrt(Rational r) {
+        return Math.sqrt(r.toDouble());
+    }
+
+    /** Average ranks with ties averaged (the natural ranking). */
+    static Rational[] ranks(double[] x) {
+        int m = x.length;
+        Rational[] r = new Rational[m];
+        for (int i = 0; i < m; i++) {
+            int less = 0;
+            int equal = 0;
+            for (int j = 0; j < m; j++) {
+                if (x[j] < x[i]) {
+                    less++;
+                } else if (x[j] == x[i]) {
+                    equal++;
+                }
+            }
+            // ranks less+1 .. less+equal averaged
+            r[i] = Rational.of(2L * less + equal + 1).divide(Rational.of(2));
+        }
+        return r;
+    }
+
+    static Rational pearson(Rational[] x, Rational[] y) {
+        int m = x.length;
+        Rational mx = Rational.ZERO;
+        Rational my = Rational.ZERO;
+        for (int i = 0; i < m; i++) {
+            mx = mx.add(x[i]);
+            my = my.add(y[i]);
+        }
+        mx = mx.divide(Rational.of(m));
+        my = my.divide(Rational.of(m));
+        Rational sxy = Rational.ZERO;
+        Rational sxx = Rational.ZERO;
+        Rational syy = Rational.ZERO;
+        for (int i = 0; i < m; i++) {
+            Rational dx = x[i].subtract(mx);
+            Rational dy = y[i].subtract(my);
+            sxy = sxy.add(dx.multiply(dy));
+            sxx = sxx.add(dx.multiply(dx));
+            syy = syy.add(dy.multiply(dy));
+        }
+        if (sxx.isZero() || syy.isZero()) {
+            return null;
+        }
+        return sxy.multiply(sxy).divide(sxx.multiply(syy)).multiply(Rational.of(sxy.signum())); // signed r^2
+    }
+
+    /** The signed correlation from the signed r^2. */
+    static double fromSignedSquare(Rational r2) {
+        return Math.signum(r2.toDouble()) * Math.sqrt(Math.abs(r2.toDouble()));
+    }
+
+    // ------------------------------------------------------------------ 1. univariate statistics
+
+    /**
+     * StatUtils, DescriptiveStatistics (with and without a window) and SummaryStatistics agree with
+     * exact rational sums, means, variances, extremes and the legacy percentile formula.
+     */
+    @Test
+    void hegelUnivariateStatisticsAreExact() {
+        Hegel.test(tc -> {
+            double[] x = sample(tc, 1, 12);
+            int m = x.length;
+            Rational s = sum(x);
+            Rational mu = mean(x);
+            Rational ss = Rational.ZERO;
+            Rational sq = Rational.ZERO;
+            double min = Double.POSITIVE_INFINITY;
+            double max = Double.NEGATIVE_INFINITY;
+            for (double v : x) {
+                Rational d = Rational.of(v).subtract(mu);
+                ss = ss.add(d.multiply(d));
+                sq = sq.add(Rational.of(v).multiply(Rational.of(v)));
+                min = Math.min(min, v);
+                max = Math.max(max, v);
+            }
+            double scale = Math.max(1, Math.abs(s.toDouble())) + sq.toDouble();
+            double tol = 1e-12 * scale;
+            Rational var = m > 1 ? ss.divide(Rational.of(m - 1)) : null;
+            Rational pvar = ss.divide(Rational.of(m));
+            // StatUtils
+            if (!close(StatUtils.sum(x), s.toDouble(), tol) || !close(StatUtils.mean(x), mu.toDouble(), tol) || !close(StatUtils.sumSq(x), sq.toDouble(), tol)
+                    || StatUtils.min(x) != min || StatUtils.max(x) != max) {
+                fail("StatUtils sum/mean/sumSq/min/max of " + Arrays.toString(x) + " = " + StatUtils.sum(x) + ", " + StatUtils.mean(x) + ", " + StatUtils.sumSq(x) + ", " + StatUtils.min(x) + ", " + StatUtils.max(x) + "; exact " + s + ", " + mu + ", " + sq + ", " + min + ", " + max);
+            }
+            if (!close(StatUtils.populationVariance(x), pvar.toDouble(), tol)) {
+                fail("populationVariance of " + Arrays.toString(x) + " = " + StatUtils.populationVariance(x) + ", exact " + pvar);
+            }
+            if (m > 1 && !close(StatUtils.variance(x), var.toDouble(), tol)) {
+                fail("variance of " + Arrays.toString(x) + " = " + StatUtils.variance(x) + ", exact " + var);
+            }
+            if (m == 1 && StatUtils.variance(x) != 0) {
+                fail("variance of a single value " + x[0] + " is " + StatUtils.variance(x));
+            }
+            // percentile: the legacy estimation (pos = p (n+1) / 100, linear between order statistics)
+            double p = pick(tc, 0.0, 1.0, 25.0, 50.0, 75.0, 90.0, 99.0, 100.0, n(tc, 1, 999) / 10.0);
+            double[] sorted = x.clone();
+            Arrays.sort(sorted);
+            Rational pos = Rational.of(p).multiply(Rational.of(m + 1)).divide(Rational.of(100));
+            double want;
+            if (m == 1) {
+                want = sorted[0];
+            } else if (pos.compareTo(Rational.ONE) < 0) {
+                want = sorted[0];
+            } else if (pos.compareTo(Rational.of(m)) >= 0) {
+                want = sorted[m - 1];
+            } else {
+                int lower = pos.num.divide(pos.den).intValue(); // floor, pos >= 1
+                Rational d = pos.subtract(Rational.of(lower));
+                Rational lo = Rational.of(sorted[lower - 1]);
+                Rational hi = Rational.of(sorted[lower]);
+                want = lo.add(d.multiply(hi.subtract(lo))).toDouble();
+            }
+            double got = StatUtils.percentile(x, p);
+            if (!close(got, want, 1e-12 * Math.max(1, Math.abs(want)))) {
+                fail("percentile(" + Arrays.toString(x) + ", " + p + ") = " + got + ", legacy formula gives " + want);
+            }
+            // mode
+            double[] mode = StatUtils.mode(x);
+            Map<Double, Integer> counts = new HashMap<>();
+            for (double v : x) {
+                counts.merge(v, 1, Integer::sum);
+            }
+            int best = counts.values().stream().max(Integer::compare).orElse(0);
+            List<Double> wantMode = new ArrayList<>();
+            for (Map.Entry<Double, Integer> e : counts.entrySet()) {
+                if (e.getValue() == best) {
+                    wantMode.add(e.getKey());
+                }
+            }
+            double[] wm = wantMode.stream().mapToDouble(Double::doubleValue).sorted().toArray();
+            if (!Arrays.equals(mode, wm)) {
+                fail("mode of " + Arrays.toString(x) + " = " + Arrays.toString(mode) + ", expected " + Arrays.toString(wm));
+            }
+            // product and normalize
+            Rational prod = Rational.ONE;
+            for (double v : x) {
+                prod = prod.multiply(Rational.of(v));
+            }
+            if (Math.abs(prod.toDouble()) < 1e15 && !close(StatUtils.product(x), prod.toDouble(), 1e-12 * Math.max(1, Math.abs(prod.toDouble())))) {
+                fail("product of " + Arrays.toString(x) + " = " + StatUtils.product(x) + ", exact " + prod);
+            }
+            if (m > 1 && !ss.isZero()) {
+                double[] z = StatUtils.normalize(x);
+                double sd = Math.sqrt(var.toDouble());
+                for (int i = 0; i < m; i++) {
+                    if (!close(z[i], (x[i] - mu.toDouble()) / sd, 1e-9)) {
+                        fail("normalize(" + Arrays.toString(x) + ") = " + Arrays.toString(z) + " at " + i);
+                        break;
+                    }
+                }
+            }
+            // DescriptiveStatistics and SummaryStatistics agree with the exact values
+            DescriptiveStatistics ds = new DescriptiveStatistics(x);
+            SummaryStatistics sum = new SummaryStatistics();
+            for (double v : x) {
+                sum.addValue(v);
+            }
+            if (ds.getN() != m || sum.getN() != m || !close(ds.getMean(), mu.toDouble(), tol) || !close(sum.getMean(), mu.toDouble(), tol)
+                    || !close(ds.getSum(), s.toDouble(), tol) || !close(sum.getSum(), s.toDouble(), tol) || ds.getMin() != min || sum.getMin() != min || ds.getMax() != max || sum.getMax() != max
+                    || !close(ds.getSumsq(), sq.toDouble(), tol)) {
+                fail("DescriptiveStatistics/SummaryStatistics basics differ from exact for " + Arrays.toString(x) + ": " + ds + " / " + sum);
+            }
+            if (m > 1 && (!close(ds.getVariance(), var.toDouble(), tol) || !close(sum.getVariance(), var.toDouble(), tol) || !close(ds.getStandardDeviation(), Math.sqrt(var.toDouble()), 1e-9 * Math.sqrt(scale)))) {
+                fail("variance of " + Arrays.toString(x) + ": DescriptiveStatistics " + ds.getVariance() + ", SummaryStatistics " + sum.getVariance() + ", exact " + var);
+            }
+            if (!close(ds.getPercentile(p == 0 ? 50 : p), StatUtils.percentile(x, p == 0 ? 50 : p), 1e-12 * scale)) {
+                fail("DescriptiveStatistics.getPercentile(" + p + ") = " + ds.getPercentile(p == 0 ? 50 : p) + " differs from StatUtils " + StatUtils.percentile(x, p == 0 ? 50 : p));
+            }
+            if (!close(ds.getQuadraticMean(), Math.sqrt(sq.divide(Rational.of(m)).toDouble()), 1e-9 * Math.sqrt(scale))) {
+                fail("quadratic mean of " + Arrays.toString(x) + " = " + ds.getQuadraticMean());
+            }
+            if (m > 1 && min > 0) {
+                double logSum = 0;
+                for (double v : x) {
+                    logSum += Math.log(v);
+                }
+                if (!close(ds.getGeometricMean(), Math.exp(logSum / m), 1e-9 * Math.exp(logSum / m))) {
+                    fail("geometric mean of " + Arrays.toString(x) + " = " + ds.getGeometricMean() + ", expected " + Math.exp(logSum / m));
+                }
+            }
+            if (!Arrays.equals(ds.getValues(), x) || !Arrays.equals(ds.getSortedValues(), sorted)) {
+                fail("getValues/getSortedValues differ from the input for " + Arrays.toString(x));
+            }
+            // a window keeps the last w values
+            int w = n(tc, 1, 6);
+            DescriptiveStatistics win = new DescriptiveStatistics(w);
+            List<Double> model = new ArrayList<>();
+            double[] more = sample(tc, 0, 10);
+            for (double v : more) {
+                int op = n(tc, 0, 9);
+                if (op < 7) {
+                    win.addValue(v);
+                    model.add(v);
+                    if (model.size() > w) {
+                        model.remove(0);
+                    }
+                } else if (op < 9) {
+                    if (model.isEmpty()) {
+                        try {
+                            win.replaceMostRecentValue(v);
+                            fail("replaceMostRecentValue on an empty window did not throw");
+                        } catch (org.apache.commons.math4.legacy.exception.MathIllegalStateException e) {
+                            count("replace on empty throws");
+                        }
+                    } else {
+                        double old = win.replaceMostRecentValue(v);
+                        if (old != model.get(model.size() - 1)) {
+                            fail("replaceMostRecentValue returned " + old + ", the most recent value was " + model.get(model.size() - 1));
+                        }
+                        model.set(model.size() - 1, v);
+                    }
+                } else {
+                    if (model.isEmpty()) {
+                        try {
+                            win.removeMostRecentValue();
+                            fail("removeMostRecentValue on an empty window did not throw");
+                        } catch (org.apache.commons.math4.legacy.exception.MathIllegalStateException e) {
+                            count("remove on empty throws");
+                        }
+                    } else {
+                        win.removeMostRecentValue();
+                        model.remove(model.size() - 1);
+                    }
+                }
+                double[] mv = model.stream().mapToDouble(Double::doubleValue).toArray();
+                if (win.getN() != mv.length || !Arrays.equals(win.getValues(), mv)) {
+                    fail("window " + w + " holds " + Arrays.toString(win.getValues()) + ", model " + Arrays.toString(mv));
+                    break;
+                }
+                if (mv.length > 0 && !close(win.getMean(), mean(mv).toDouble(), 1e-12 * scale)) {
+                    fail("window mean " + win.getMean() + " vs exact " + mean(mv) + " for " + Arrays.toString(mv));
+                }
+                if (win.getWindowSize() != w) {
+                    fail("window size changed to " + win.getWindowSize());
+                }
+            }
+            // copies and summaries
+            DescriptiveStatistics copy = ds.copy();
+            if (copy.getN() != ds.getN() || copy.getMean() != ds.getMean() || !Arrays.equals(copy.getValues(), ds.getValues())) {
+                fail("copy of DescriptiveStatistics differs");
+            }
+            SummaryStatistics scopy = sum.copy();
+            if (scopy.getN() != sum.getN() || scopy.getSum() != sum.getSum() || scopy.getMin() != sum.getMin() || scopy.getMax() != sum.getMax()
+                    || !(scopy.getMean() == sum.getMean() || Double.isNaN(sum.getMean())) || !(scopy.getVariance() == sum.getVariance() || Double.isNaN(sum.getVariance()))) {
+                fail("copy of SummaryStatistics is not equal to the original for " + Arrays.toString(x));
+            }
+        }, Zoo.settings("stat.univariate"));
+    }
+
+    // ------------------------------------------------------------------ 2. covariance and correlations
+
+    /**
+     * Covariance (bias-corrected and not), Pearson's, Spearman's (natural ranking, ties averaged)
+     * and Kendall's tau-b agree with the exact rational formulas on integer and half-integer samples.
+     */
+    @Test
+    void hegelCorrelationsAreExact() {
+        Hegel.test(tc -> {
+            int m = n(tc, 2, 12);
+            double[] x = sample(tc, m, m);
+            double[] y = chance(tc, 20) ? x.clone() : sample(tc, m, m);
+            if (chance(tc, 20)) {
+                for (int i = 0; i < m; i++) {
+                    y[i] = -x[i] + n(tc, -1, 1);
+                }
+            }
+            Rational sxy = crossSum(x, y);
+            Rational sxx = crossSum(x, x);
+            Rational syy = crossSum(y, y);
+            double scale = 1 + Math.abs(sxx.toDouble()) + Math.abs(syy.toDouble());
+            Covariance cov = new Covariance();
+            if (!close(cov.covariance(x, y), sxy.divide(Rational.of(m - 1)).toDouble(), 1e-12 * scale)
+                    || !close(cov.covariance(x, y, false), sxy.divide(Rational.of(m)).toDouble(), 1e-12 * scale)) {
+                fail("covariance of " + Arrays.toString(x) + " and " + Arrays.toString(y) + " = " + cov.covariance(x, y) + " / " + cov.covariance(x, y, false) + ", exact " + sxy.divide(Rational.of(m - 1)) + " / " + sxy.divide(Rational.of(m)));
+            }
+            double[][] data = new double[m][2];
+            for (int i = 0; i < m; i++) {
+                data[i][0] = x[i];
+                data[i][1] = y[i];
+            }
+            Covariance cm = new Covariance(data);
+            if (!close(cm.getCovarianceMatrix().getEntry(0, 1), sxy.divide(Rational.of(m - 1)).toDouble(), 1e-12 * scale) || cm.getN() != m
+                    || !close(cm.getCovarianceMatrix().getEntry(0, 0), sxx.divide(Rational.of(m - 1)).toDouble(), 1e-12 * scale)) {
+                fail("covariance matrix of the columns differs from the pairwise covariance for " + Arrays.toString(x) + ", " + Arrays.toString(y));
+            }
+            // Pearson
+            PearsonsCorrelation pc = new PearsonsCorrelation();
+            double r = pc.correlation(x, y);
+            if (sxx.isZero() || syy.isZero()) {
+                if (!Double.isNaN(r)) {
+                    fail("Pearson correlation with a constant sample is " + r + " for " + Arrays.toString(x) + ", " + Arrays.toString(y));
+                }
+                count("constant sample");
+            } else {
+                double want = sxy.toDouble() / Math.sqrt(sxx.toDouble() * syy.toDouble());
+                if (!close(r, want, 1e-10)) {
+                    fail("Pearson correlation of " + Arrays.toString(x) + " and " + Arrays.toString(y) + " = " + r + ", exact " + want);
+                }
+                if (!close(new PearsonsCorrelation(data).getCorrelationMatrix().getEntry(0, 1), want, 1e-10)) {
+                    fail("Pearson correlation matrix entry differs from the pairwise correlation");
+                }
+                // Spearman: Pearson of the averaged ranks
+                Rational r2 = pearson(ranks(x), ranks(y));
+                double rho = new SpearmansCorrelation().correlation(x, y);
+                double wantRho = fromSignedSquare(r2);
+                if (!close(rho, wantRho, 1e-10)) {
+                    fail("Spearman correlation of " + Arrays.toString(x) + " and " + Arrays.toString(y) + " = " + rho + ", exact " + wantRho + " (ranks " + Arrays.toString(ranks(x)) + ", " + Arrays.toString(ranks(y)) + ")");
+                }
+                // Kendall tau-b
+                long concordant = 0;
+                long discordant = 0;
+                long tiesX = 0;
+                long tiesY = 0;
+                for (int i = 0; i < m; i++) {
+                    for (int j = i + 1; j < m; j++) {
+                        double dx = Math.signum(x[i] - x[j]);
+                        double dy = Math.signum(y[i] - y[j]);
+                        if (dx == 0 && dy == 0) {
+                            continue; // tied in both: counts in neither n1 nor n2 corrections below... (n1, n2 count all ties)
+                        }
+                        if (dx == 0) {
+                            tiesX++;
+                        } else if (dy == 0) {
+                            tiesY++;
+                        } else if (dx * dy > 0) {
+                            concordant++;
+                        } else {
+                            discordant++;
+                        }
+                    }
+                }
+                // n1 = pairs tied in x (including tied in both), n2 = pairs tied in y
+                long n1 = 0;
+                long n2 = 0;
+                long both = 0;
+                for (int i = 0; i < m; i++) {
+                    for (int j = i + 1; j < m; j++) {
+                        boolean tx = x[i] == x[j];
+                        boolean ty = y[i] == y[j];
+                        if (tx) {
+                            n1++;
+                        }
+                        if (ty) {
+                            n2++;
+                        }
+                        if (tx && ty) {
+                            both++;
+                        }
+                    }
+                }
+                long n0 = (long) m * (m - 1) / 2;
+                double tau = new KendallsCorrelation().correlation(x, y);
+                if (n0 == n1 || n0 == n2) {
+                    if (!Double.isNaN(tau)) {
+                        fail("Kendall tau with all pairs tied is " + tau + " for " + Arrays.toString(x) + ", " + Arrays.toString(y));
+                    }
+                } else {
+                    double wantTau = (concordant - discordant) / Math.sqrt((double) (n0 - n1) * (n0 - n2));
+                    if (!close(tau, wantTau, 1e-10)) {
+                        fail("Kendall tau of " + Arrays.toString(x) + " and " + Arrays.toString(y) + " = " + tau + ", tau-b formula gives " + wantTau + " (concordant " + concordant + ", discordant " + discordant + ", n1 " + n1 + ", n2 " + n2 + ", both " + both + ")");
+                    }
+                }
+            }
+        }, Zoo.settings("stat.correlation"));
+    }
+
+    // ------------------------------------------------------------------ 3. regression
+
+    /**
+     * SimpleRegression (with and without intercept) gives the exact least-squares slope, intercept,
+     * sums of squares and R; OLSMultipleLinearRegression and MillerUpdatingRegression give the exact
+     * normal-equations solution for a full-rank integer design and agree with each other.
+     */
+    @Test
+    void hegelRegressionsAreExact() {
+        Hegel.test(tc -> {
+            int m = n(tc, 3, 10);
+            double[] x = sample(tc, m, m);
+            double[] y = sample(tc, m, m);
+            boolean intercept = chance(tc, 70);
+            SimpleRegression sr = new SimpleRegression(intercept);
+            for (int i = 0; i < m; i++) {
+                sr.addData(x[i], y[i]);
+            }
+            Rational sxx;
+            Rational sxy;
+            Rational slope;
+            Rational icpt;
+            if (intercept) {
+                sxx = crossSum(x, x);
+                sxy = crossSum(x, y);
+            } else {
+                sxx = Rational.ZERO;
+                sxy = Rational.ZERO;
+                for (int i = 0; i < m; i++) {
+                    sxx = sxx.add(Rational.of(x[i]).multiply(Rational.of(x[i])));
+                    sxy = sxy.add(Rational.of(x[i]).multiply(Rational.of(y[i])));
+                }
+            }
+            if (sxx.isZero()) {
+                count("degenerate x");
+                if (!Double.isNaN(sr.getSlope())) {
+                    fail("slope with constant x " + Arrays.toString(x) + " is " + sr.getSlope());
+                }
+                return;
+            }
+            slope = sxy.divide(sxx);
+            icpt = intercept ? mean(y).subtract(slope.multiply(mean(x))) : Rational.ZERO;
+            double scale = 1 + Math.abs(sxx.toDouble()) + Math.abs(sxy.toDouble());
+            if (!close(sr.getSlope(), slope.toDouble(), 1e-11 * scale) || !close(sr.getIntercept(), icpt.toDouble(), 1e-11 * scale)) {
+                fail("SimpleRegression(" + intercept + ") of " + Arrays.toString(x) + " -> " + Arrays.toString(y) + " gives slope " + sr.getSlope() + ", intercept " + sr.getIntercept() + "; exact " + slope + ", " + icpt);
+            }
+            if (sr.getN() != m || sr.hasIntercept() != intercept) {
+                fail("SimpleRegression n/hasIntercept wrong");
+            }
+            double xp = n(tc, -5, 5);
+            if (!close(sr.predict(xp), icpt.add(slope.multiply(Rational.of(xp))).toDouble(), 1e-10 * scale)) {
+                fail("predict(" + xp + ") = " + sr.predict(xp) + ", exact " + icpt.add(slope.multiply(Rational.of(xp))));
+            }
+            Rational sse = Rational.ZERO;
+            for (int i = 0; i < m; i++) {
+                Rational e = Rational.of(y[i]).subtract(icpt.add(slope.multiply(Rational.of(x[i]))));
+                sse = sse.add(e.multiply(e));
+            }
+            if (!close(sr.getSumSquaredErrors(), sse.toDouble(), 1e-9 * scale * scale)) {
+                fail("SSE " + sr.getSumSquaredErrors() + " vs exact " + sse + " for " + Arrays.toString(x) + " -> " + Arrays.toString(y) + " (intercept " + intercept + ")");
+            }
+            if (intercept && !close(sr.getXSumSquares(), sxx.toDouble(), 1e-11 * scale)) {
+                fail("getXSumSquares " + sr.getXSumSquares() + " vs exact " + sxx);
+            }
+            if (intercept) {
+                Rational syy = crossSum(y, y);
+                if (!syy.isZero()) {
+                    double want = sxy.toDouble() / Math.sqrt(sxx.toDouble() * syy.toDouble());
+                    if (!close(sr.getR(), want, 1e-9) || !close(sr.getRSquare(), want * want, 1e-9)) {
+                        fail("getR " + sr.getR() + " / getRSquare " + sr.getRSquare() + " vs exact " + want);
+                    }
+                    if (!close(sr.getTotalSumSquares(), syy.toDouble(), 1e-11 * scale)) {
+                        fail("total sum of squares " + sr.getTotalSumSquares() + " vs exact " + syy);
+                    }
+                }
+            }
+            // removing a point undoes adding it
+            int k = n(tc, 0, m - 1);
+            sr.removeData(x[k], y[k]);
+            SimpleRegression without = new SimpleRegression(intercept);
+            for (int i = 0; i < m; i++) {
+                if (i != k) {
+                    without.addData(x[i], y[i]);
+                }
+            }
+            if (sr.getN() != without.getN() || (!Double.isNaN(without.getSlope()) && !close(sr.getSlope(), without.getSlope(), 1e-9 * scale))) {
+                fail("removeData(" + x[k] + ", " + y[k] + ") leaves slope " + sr.getSlope() + ", a fresh regression gives " + without.getSlope());
+            }
+            // multiple regression against the exact normal equations
+            int p = n(tc, 1, 3);
+            if (m <= p + 1) {
+                return;
+            }
+            double[][] xs = new double[m][p];
+            for (int i = 0; i < m; i++) {
+                for (int j = 0; j < p; j++) {
+                    xs[i][j] = n(tc, -5, 5);
+                }
+            }
+            boolean noIntercept = chance(tc, 30);
+            int cols = noIntercept ? p : p + 1;
+            Rational[][] design = new Rational[m][cols];
+            for (int i = 0; i < m; i++) {
+                int c = 0;
+                if (!noIntercept) {
+                    design[i][c++] = Rational.ONE;
+                }
+                for (int j = 0; j < p; j++) {
+                    design[i][c++] = Rational.of(xs[i][j]);
+                }
+            }
+            Rational[][] xt = Rational.transpose(design);
+            Rational[][] xtx = Rational.multiply(xt, design);
+            Rational[][] inv = Rational.inverse(xtx);
+            if (inv == null) {
+                count("rank-deficient design");
+                return;
+            }
+            double cond = Rational.norm1(xtx).multiply(Rational.norm1(inv)).toDouble();
+            if (cond > 1e6) {
+                count("ill-conditioned design");
+                return;
+            }
+            Rational[] beta = Rational.multiply(inv, Rational.multiply(xt, Rational.fromDoubles(y)));
+            OLSMultipleLinearRegression ols = new OLSMultipleLinearRegression();
+            ols.setNoIntercept(noIntercept);
+            ols.newSampleData(y, xs);
+            double[] got = ols.estimateRegressionParameters();
+            double bmax = 1;
+            for (Rational b : beta) {
+                bmax = Math.max(bmax, Math.abs(b.toDouble()));
+            }
+            for (int j = 0; j < cols; j++) {
+                if (!close(got[j], beta[j].toDouble(), 1e-9 * cond * bmax)) {
+                    fail("OLS parameters " + Arrays.toString(got) + " vs exact " + Arrays.toString(beta) + " for y = " + Arrays.toString(y) + ", X = " + Arrays.deepToString(xs) + ", noIntercept " + noIntercept + " (cond " + cond + ")");
+                    break;
+                }
+            }
+            double[] res = ols.estimateResiduals();
+            Rational rss = Rational.ZERO;
+            for (int i = 0; i < m; i++) {
+                Rational fit = Rational.ZERO;
+                for (int j = 0; j < cols; j++) {
+                    fit = fit.add(design[i][j].multiply(beta[j]));
+                }
+                Rational e = Rational.of(y[i]).subtract(fit);
+                rss = rss.add(e.multiply(e));
+                if (!close(res[i], e.toDouble(), 1e-8 * cond * bmax * 10)) {
+                    fail("OLS residual " + i + " = " + res[i] + ", exact " + e);
+                    break;
+                }
+            }
+            if (!close(ols.calculateResidualSumOfSquares(), rss.toDouble(), 1e-7 * cond * bmax * bmax * 100)) {
+                fail("OLS residual sum of squares " + ols.calculateResidualSumOfSquares() + " vs exact " + rss);
+            }
+            // the updating regression reaches the same estimates
+            MillerUpdatingRegression mur = new MillerUpdatingRegression(p, !noIntercept);
+            mur.addObservations(xs, y);
+            RegressionResults rr;
+            try {
+                rr = mur.regress();
+            } catch (org.apache.commons.math4.legacy.stat.regression.ModelSpecificationException e) {
+                fail("MillerUpdatingRegression refuses the full-rank design " + Arrays.deepToString(xs) + ": " + e.getMessage());
+                return;
+            }
+            double[] est = rr.getParameterEstimates();
+            for (int j = 0; j < cols; j++) {
+                if (!close(est[j], beta[j].toDouble(), 1e-8 * cond * bmax)) {
+                    fail("MillerUpdatingRegression estimates " + Arrays.toString(est) + " vs exact " + Arrays.toString(beta) + " for y = " + Arrays.toString(y) + ", X = " + Arrays.deepToString(xs) + ", intercept " + !noIntercept);
+                    break;
+                }
+            }
+            if (rr.getN() != m || rr.getNumberOfParameters() != cols || rr.hasIntercept() == noIntercept) {
+                fail("RegressionResults n/parameters/intercept wrong: " + rr.getN() + ", " + rr.getNumberOfParameters() + ", " + rr.hasIntercept());
+            }
+            if (!close(rr.getErrorSumSquares(), rss.toDouble(), 1e-7 * cond * bmax * bmax * 100)) {
+                fail("MillerUpdatingRegression error sum of squares " + rr.getErrorSumSquares() + " vs exact " + rss);
+            }
+        }, Zoo.settings("stat.regression"));
+    }
+
+    // ------------------------------------------------------------------ 4. containers
+
+    /** Frequency against a HashMap of counts (ResizableDoubleArray is package-private in the legacy module). */
+    @Test
+    void hegelContainersFollowTheirModels() {
+        Hegel.test(tc -> {
+            // Frequency<Integer>
+            Frequency<Integer> f = new Frequency<>();
+            Map<Integer, Long> model = new HashMap<>();
+            int ops = n(tc, 0, 30);
+            for (int i = 0; i < ops; i++) {
+                int v = n(tc, -3, 5);
+                if (chance(tc, 70)) {
+                    f.addValue(v);
+                    model.merge(v, 1L, Long::sum);
+                } else {
+                    long k = n(tc, 0, 4);
+                    f.incrementValue(v, k);
+                    model.merge(v, k, Long::sum);
+                }
+            }
+            long total = model.values().stream().mapToLong(Long::longValue).sum();
+            if (f.getSumFreq() != total || f.getUniqueCount() != model.size()) {
+                fail("Frequency total " + f.getSumFreq() + "/unique " + f.getUniqueCount() + " vs model " + total + "/" + model.size() + ": " + model);
+            }
+            long best = model.values().stream().mapToLong(Long::longValue).max().orElse(0);
+            for (int v = -4; v <= 6; v++) {
+                long c = model.getOrDefault(v, 0L);
+                if (f.getCount(v) != c) {
+                    fail("Frequency count of " + v + " is " + f.getCount(v) + ", model " + c);
+                }
+                long cum = 0;
+                for (Map.Entry<Integer, Long> e : model.entrySet()) {
+                    if (e.getKey() <= v) {
+                        cum += e.getValue();
+                    }
+                }
+                if (f.getCumFreq(v) != cum) {
+                    fail("Frequency cumulative count up to " + v + " is " + f.getCumFreq(v) + ", model " + cum + " for " + model);
+                }
+                if (total > 0 && (!close(f.getPct(v), (double) c / total, 1e-15) || !close(f.getCumPct(v), (double) cum / total, 1e-15))) {
+                    fail("Frequency pct/cumPct of " + v + " = " + f.getPct(v) + "/" + f.getCumPct(v) + ", model " + (double) c / total + "/" + (double) cum / total);
+                }
+            }
+            if (total > 0) {
+                List<Integer> mode = f.getMode();
+                List<Integer> wantMode = new ArrayList<>();
+                for (Map.Entry<Integer, Long> e : model.entrySet()) {
+                    if (e.getValue() == best) {
+                        wantMode.add(e.getKey());
+                    }
+                }
+                wantMode.sort(null);
+                if (!mode.equals(wantMode)) {
+                    fail("Frequency mode " + mode + " vs model " + wantMode + " for " + model);
+                }
+            }
+            List<Integer> keys = new ArrayList<>();
+            f.valuesIterator().forEachRemaining(keys::add);
+            List<Integer> wantKeys = new ArrayList<>(model.keySet());
+            wantKeys.sort(null);
+            if (!keys.equals(wantKeys)) {
+                fail("Frequency values " + keys + " vs sorted model keys " + wantKeys);
+            }
+            Frequency<Integer> g = new Frequency<>();
+            g.addValue(n(tc, -3, 5));
+            Frequency<Integer> merged = new Frequency<>();
+            merged.merge(f);
+            merged.merge(g);
+            if (merged.getSumFreq() != f.getSumFreq() + g.getSumFreq()) {
+                fail("merge total " + merged.getSumFreq() + " != " + f.getSumFreq() + " + " + g.getSumFreq());
+            }
+        }, Zoo.settings("stat.containers"));
+    }
+}
diff --git a/hegel/src/test/java/zoo/TransformTest.java b/hegel/src/test/java/zoo/TransformTest.java
new file mode 100644
index 0000000..98807f0
--- /dev/null
+++ b/hegel/src/test/java/zoo/TransformTest.java
@@ -0,0 +1,271 @@
+package zoo;
+
+import static zoo.Zoo.chance;
+import static zoo.Zoo.count;
+import static zoo.Zoo.fail;
+import static zoo.Zoo.n;
+import static zoo.Zoo.pick;
+
+import dev.hegel.Hegel;
+import dev.hegel.TestCase;
+import java.util.Arrays;
+import org.apache.commons.math4.transform.FastCosineTransform;
+import org.apache.commons.math4.transform.FastFourierTransform;
+import org.apache.commons.math4.transform.FastHadamardTransform;
+import org.apache.commons.math4.transform.FastSineTransform;
+import org.apache.commons.numbers.complex.Complex;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Hegel zoo: the fast transforms of Commons Math against their O(n^2) definitions (the formulas of
+ * the class documentation) and against their own inverses.
+ */
+class TransformTest {
+
+    /** Known bugs, gated so the properties pass while the pins in PinsTest fail. */
+    static final class Known {
+    }
+
+    static double[] data(TestCase tc, int size) {
+        double[] x = new double[size];
+        for (int i = 0; i < size; i++) {
+            x[i] = chance(tc, 20) ? 0 : n(tc, -9, 9) / (chance(tc, 50) ? 1.0 : 4.0);
+        }
+        return x;
+    }
+
+    static double norm(double[] x) {
+        double s = 0;
+        for (double v : x) {
+            s += v * v;
+        }
+        return Math.sqrt(s);
+    }
+
+    static boolean close(double a, double b, double tol) {
+        return Math.abs(a - b) <= tol;
+    }
+
+    static String show(Complex[] c) {
+        StringBuilder sb = new StringBuilder("[");
+        for (int i = 0; i < c.length; i++) {
+            sb.append(i > 0 ? ", " : "").append(c[i].getReal()).append(c[i].getImaginary() < 0 ? "-" : "+").append(Math.abs(c[i].getImaginary())).append("i");
+        }
+        return sb.append("]").toString();
+    }
+
+    // ------------------------------------------------------------------ 1. FFT
+
+    /**
+     * The FFT of a real or complex vector of power-of-two length equals the discrete Fourier
+     * transform (X_k = sum x_n e^{-2 pi i k n / N}, divided by sqrt(N) in unitary mode), the inverse
+     * undoes it (with the 1/N or 1/sqrt(N) factor), Parseval holds, and other lengths are rejected.
+     */
+    @Test
+    void hegelFftMatchesTheDefinition() {
+        Hegel.test(tc -> {
+            int size = 1 << n(tc, 0, 6);
+            double[] re = data(tc, size);
+            double[] im = chance(tc, 50) ? new double[size] : data(tc, size);
+            boolean realInput = true;
+            for (double v : im) {
+                if (v != 0) {
+                    realInput = false;
+                }
+            }
+            FastFourierTransform.Norm norm = pick(tc, FastFourierTransform.Norm.STD, FastFourierTransform.Norm.UNIT);
+            FastFourierTransform fft = new FastFourierTransform(norm);
+            Complex[] input = new Complex[size];
+            for (int i = 0; i < size; i++) {
+                input[i] = Complex.ofCartesian(re[i], im[i]);
+            }
+            Complex[] out = realInput && chance(tc, 50) ? fft.apply(re) : fft.apply(input);
+            double scale = norm == FastFourierTransform.Norm.STD ? 1 : 1 / Math.sqrt(size);
+            double mag = Math.max(1, norm(re) + norm(im)) * Math.sqrt(size);
+            double tol = 1e-12 * mag * Math.max(1, Math.log(size) / Math.log(2));
+            for (int k = 0; k < size; k++) {
+                double sr = 0;
+                double si = 0;
+                for (int j = 0; j < size; j++) {
+                    double ang = -2 * Math.PI * k * j / size;
+                    double c = Math.cos(ang);
+                    double s = Math.sin(ang);
+                    sr += re[j] * c - im[j] * s;
+                    si += re[j] * s + im[j] * c;
+                }
+                if (!close(out[k].getReal(), sr * scale, tol) || !close(out[k].getImaginary(), si * scale, tol)) {
+                    fail("FFT(" + norm + ") of " + Arrays.toString(re) + " + i" + Arrays.toString(im) + " at " + k + " is " + out[k] + ", the DFT gives " + sr * scale + " + " + si * scale + "i");
+                    break;
+                }
+            }
+            // the inverse undoes the transform
+            FastFourierTransform inv = new FastFourierTransform(norm, true);
+            Complex[] back = inv.apply(out);
+            for (int i = 0; i < size; i++) {
+                if (!close(back[i].getReal(), re[i], tol) || !close(back[i].getImaginary(), im[i], tol)) {
+                    fail("inverse FFT(" + norm + ") does not return " + Arrays.toString(re) + " + i" + Arrays.toString(im) + ": " + show(back));
+                    break;
+                }
+            }
+            // Parseval
+            double energyIn = 0;
+            double energyOut = 0;
+            for (int i = 0; i < size; i++) {
+                energyIn += re[i] * re[i] + im[i] * im[i];
+                energyOut += out[i].getReal() * out[i].getReal() + out[i].getImaginary() * out[i].getImaginary();
+            }
+            double expect = norm == FastFourierTransform.Norm.STD ? energyIn * size : energyIn;
+            if (!close(energyOut, expect, 1e-11 * Math.max(1, expect) * size)) {
+                fail("Parseval fails for FFT(" + norm + ") of " + Arrays.toString(re) + " + i" + Arrays.toString(im) + ": " + energyOut + " vs " + expect);
+            }
+            // the in-place variant on the [re, im] pair
+            double[][] pair = {re.clone(), im.clone()};
+            fft.transformInPlace(pair);
+            for (int k = 0; k < size; k++) {
+                if (!close(pair[0][k], out[k].getReal(), tol) || !close(pair[1][k], out[k].getImaginary(), tol)) {
+                    fail("transformInPlace differs from apply at " + k + " for " + Arrays.toString(re) + " + i" + Arrays.toString(im));
+                    break;
+                }
+            }
+            // a function sampled on [a, b) gives the transform of the samples
+            if (size >= 2) {
+                double[] samples = new double[size];
+                double a = n(tc, -2, 2);
+                double b = a + n(tc, 1, 3);
+                double h = (b - a) / size;
+                for (int i = 0; i < size; i++) {
+                    samples[i] = Math.sin(a + i * h) + 0.5;
+                }
+                Complex[] fromF = fft.apply(x -> Math.sin(x) + 0.5, a, b, size);
+                Complex[] fromS = fft.apply(samples);
+                for (int k = 0; k < size; k++) {
+                    if (!close(fromF[k].getReal(), fromS[k].getReal(), 1e-11 * size) || !close(fromF[k].getImaginary(), fromS[k].getImaginary(), 1e-11 * size)) {
+                        fail("apply(function, " + a + ", " + b + ", " + size + ") differs from the transform of the samples at " + k);
+                        break;
+                    }
+                }
+            }
+            // non power-of-two lengths are rejected
+            int bad = size + n(tc, 1, 3);
+            if (Integer.bitCount(bad) != 1) {
+                try {
+                    fft.apply(new double[bad]);
+                    fail("FFT accepted a vector of length " + bad);
+                } catch (IllegalArgumentException e) {
+                    count("non power of two rejected");
+                }
+            }
+        }, Zoo.settings("transform.fft"));
+    }
+
+    // ------------------------------------------------------------------ 2. cosine, sine and Hadamard
+
+    /**
+     * DCT-I (length 2^k + 1), DST-I (length 2^k, first sample 0) and the Walsh-Hadamard transform
+     * (length 2^k) equal their definitions in both normalisations, and the inverses undo them.
+     */
+    @Test
+    void hegelRealTransformsMatchTheirDefinitions() {
+        Hegel.test(tc -> {
+            // DCT-I: F_k = 1/2 [f_0 + (-1)^k f_{N-1}] + sum_{n=1}^{N-2} f_n cos(pi n k / (N-1))
+            int size = (1 << n(tc, 0, 5)) + 1;
+            double[] f = data(tc, size);
+            FastCosineTransform.Norm cnorm = pick(tc, FastCosineTransform.Norm.STD, FastCosineTransform.Norm.ORTHO);
+            FastCosineTransform dct = new FastCosineTransform(cnorm);
+            double[] out = dct.apply(f);
+            double mag = Math.max(1, norm(f)) * Math.sqrt(size);
+            double tol = 1e-11 * mag;
+            double cscale = cnorm == FastCosineTransform.Norm.STD ? 1 : Math.sqrt(2.0 / (size - 1));
+            for (int k = 0; k < size; k++) {
+                double s = 0.5 * (f[0] + (k % 2 == 0 ? 1 : -1) * f[size - 1]);
+                for (int j = 1; j < size - 1; j++) {
+                    s += f[j] * Math.cos(Math.PI * j * k / (size - 1));
+                }
+                if (!close(out[k], s * cscale, tol)) {
+                    fail("DCT(" + cnorm + ") of " + Arrays.toString(f) + " at " + k + " is " + out[k] + ", the definition gives " + s * cscale);
+                    break;
+                }
+            }
+            double[] back = new FastCosineTransform(cnorm, true).apply(out);
+            for (int i = 0; i < size; i++) {
+                if (!close(back[i], f[i], tol)) {
+                    fail("inverse DCT(" + cnorm + ") does not return " + Arrays.toString(f) + ": " + Arrays.toString(back));
+                    break;
+                }
+            }
+            // DST-I: F_k = sum_{n=1}^{N-1} f_n sin(pi n k / N), f_0 = 0
+            int ssize = 1 << n(tc, 0, 6);
+            double[] g = data(tc, ssize);
+            g[0] = 0;
+            FastSineTransform.Norm snorm = pick(tc, FastSineTransform.Norm.STD, FastSineTransform.Norm.ORTHO);
+            FastSineTransform dst = new FastSineTransform(snorm);
+            double[] sout = dst.apply(g);
+            double sscale = snorm == FastSineTransform.Norm.STD ? 1 : Math.sqrt(2.0 / ssize);
+            double stol = 1e-11 * Math.max(1, norm(g)) * Math.sqrt(ssize);
+            for (int k = 0; k < ssize; k++) {
+                double s = 0;
+                for (int j = 1; j < ssize; j++) {
+                    s += g[j] * Math.sin(Math.PI * j * k / ssize);
+                }
+                if (!close(sout[k], s * sscale, stol)) {
+                    fail("DST(" + snorm + ") of " + Arrays.toString(g) + " at " + k + " is " + sout[k] + ", the definition gives " + s * sscale);
+                    break;
+                }
+            }
+            double[] sback = new FastSineTransform(snorm, true).apply(sout);
+            for (int i = 0; i < ssize; i++) {
+                if (!close(sback[i], g[i], stol)) {
+                    fail("inverse DST(" + snorm + ") does not return " + Arrays.toString(g) + ": " + Arrays.toString(sback));
+                    break;
+                }
+            }
+            if (ssize > 1) {
+                double[] bad = g.clone();
+                bad[0] = 1;
+                try {
+                    dst.apply(bad);
+                    fail("DST accepted a vector whose first element is not 0");
+                } catch (IllegalArgumentException e) {
+                    count("nonzero first element rejected");
+                }
+            }
+            // Walsh-Hadamard: y_i = sum_j (-1)^{popcount(i & j)} x_j; the inverse divides by N
+            int hsize = 1 << n(tc, 0, 6);
+            double[] h = data(tc, hsize);
+            FastHadamardTransform fht = new FastHadamardTransform();
+            double[] hout = fht.apply(h);
+            for (int i = 0; i < hsize; i++) {
+                double s = 0;
+                for (int j = 0; j < hsize; j++) {
+                    s += (Integer.bitCount(i & j) % 2 == 0 ? 1 : -1) * h[j];
+                }
+                if (!close(hout[i], s, 1e-12 * Math.max(1, norm(h)) * hsize)) {
+                    fail("Hadamard transform of " + Arrays.toString(h) + " at " + i + " is " + hout[i] + ", the definition gives " + s);
+                    break;
+                }
+            }
+            double[] hback = new FastHadamardTransform(true).apply(hout);
+            for (int i = 0; i < hsize; i++) {
+                if (!close(hback[i], h[i], 1e-12 * Math.max(1, norm(h)) * hsize)) {
+                    fail("inverse Hadamard does not return " + Arrays.toString(h) + ": " + Arrays.toString(hback));
+                    break;
+                }
+            }
+            int[] hi = new int[hsize];
+            for (int i = 0; i < hsize; i++) {
+                hi[i] = n(tc, -9, 9);
+            }
+            int[] hiout = fht.apply(hi);
+            for (int i = 0; i < hsize; i++) {
+                long s = 0;
+                for (int j = 0; j < hsize; j++) {
+                    s += (Integer.bitCount(i & j) % 2 == 0 ? 1 : -1) * hi[j];
+                }
+                if (hiout[i] != s) {
+                    fail("integer Hadamard transform of " + Arrays.toString(hi) + " at " + i + " is " + hiout[i] + ", exact " + s);
+                    break;
+                }
+            }
+        }, Zoo.settings("transform.real"));
+    }
+}
diff --git a/hegel/src/test/java/zoo/Zoo.java b/hegel/src/test/java/zoo/Zoo.java
new file mode 100644
index 0000000..3a4b425
--- /dev/null
+++ b/hegel/src/test/java/zoo/Zoo.java
@@ -0,0 +1,128 @@
+package zoo;
+
+import dev.hegel.Database;
+import dev.hegel.Generators;
+import dev.hegel.Settings;
+import dev.hegel.TestCase;
+import java.util.LinkedHashSet;
+import java.util.Set;
+import java.util.function.Supplier;
+
+/**
+ * Hegel zoo harness. {@link #settings} reads {@code HEGEL_TEST_CASES} and {@code HEGEL_DATABASE}
+ * (hegel-java itself reads no environment variable); {@link #fail} throws, or under
+ * {@code ZOO_COLLECT=1} prints a {@code COLLECT <message>} line once per distinct message and
+ * lets the test case go on, so one run shows every kind of mismatch at once.
+ */
+final class Zoo {
+    private Zoo() {}
+
+    static final boolean COLLECT = notEmpty(System.getenv("ZOO_COLLECT"));
+    private static final Set<String> SEEN = new LinkedHashSet<>();
+
+    static Settings settings(String name) {
+        Settings s = new Settings().name(name).testCases(testCases());
+        String db = System.getenv("HEGEL_DATABASE");
+        if (notEmpty(db)) {
+            s = s.database(Database.path(db));
+        }
+        return s;
+    }
+
+    static long testCases() {
+        String n = System.getenv("HEGEL_TEST_CASES");
+        return notEmpty(n) ? Long.parseLong(n.trim()) : 100;
+    }
+
+    static void fail(String msg) {
+        if (COLLECT) {
+            String key = msg.length() > 300 ? msg.substring(0, 300) : msg;
+            if (SEEN.add(key)) {
+                System.out.println("COLLECT " + msg.replace('\n', ' '));
+                System.out.flush();
+            }
+            return;
+        }
+        throw new AssertionError(msg);
+    }
+
+    static void check(boolean ok, Supplier<String> msg) {
+        if (!ok) {
+            fail(msg.get());
+        }
+    }
+
+    static void check(boolean ok, String msg) {
+        if (!ok) {
+            fail(msg);
+        }
+    }
+
+    private static final java.util.Map<String, Integer> STATS = new java.util.TreeMap<>();
+
+    /** Bumps a statistic; the counts are printed in collect mode (ZOO_COLLECT=1) via {@link #stats()}. */
+    static synchronized void count(String key) {
+        STATS.merge(key, 1, Integer::sum);
+    }
+
+    /** The statistics so far, cleared, as one line. */
+    static synchronized String stats() {
+        String s = STATS.toString();
+        STATS.clear();
+        return s;
+    }
+
+    /** An int in [lo, hi]. */
+    static int n(TestCase tc, int lo, int hi) {
+        return tc.draw(Generators.integers().min(lo).max(hi));
+    }
+
+    static boolean chance(TestCase tc, int pct) {
+        return n(tc, 0, 99) < pct;
+    }
+
+    @SafeVarargs
+    static <T> T pick(TestCase tc, T... xs) {
+        return tc.draw(Generators.sampledFrom(xs));
+    }
+
+    /** A string of lo..hi characters drawn from the alphabet. */
+    static String word(TestCase tc, String alphabet, int lo, int hi) {
+        int len = n(tc, lo, hi);
+        StringBuilder sb = new StringBuilder();
+        for (int i = 0; i < len; i++) {
+            sb.append(alphabet.charAt(n(tc, 0, alphabet.length() - 1)));
+        }
+        return sb.toString();
+    }
+
+    /** A readable rendering of a value: strings quoted with unprintables escaped, null as "null". */
+    static String show(Object o) {
+        if (o == null) {
+            return "null";
+        }
+        if (o instanceof String s) {
+            StringBuilder sb = new StringBuilder("\"");
+            for (int i = 0; i < s.length(); i++) {
+                char c = s.charAt(i);
+                if (c == '"' || c == '\\') {
+                    sb.append('\\').append(c);
+                } else if (c < 0x20 || c == 0x7f || (c >= 0xd800 && c <= 0xdfff) || c == '\u2028' || c == '\u2029') {
+                    sb.append(String.format("\\u%04x", (int) c));
+                } else {
+                    sb.append(c);
+                }
+            }
+            return sb.append('"').toString();
+        }
+        String s = o.toString();
+        if (o instanceof Number || o instanceof Boolean) {
+            return s + " (" + o.getClass().getSimpleName() + ")";
+        }
+        return s.length() > 400 ? s.substring(0, 400) + "…" : s;
+    }
+
+    private static boolean notEmpty(String s) {
+        return s != null && !s.isEmpty();
+    }
+}
diff --git a/hegel/src/test/java/zoo/ZooListener.java b/hegel/src/test/java/zoo/ZooListener.java
new file mode 100644
index 0000000..7e317bb
--- /dev/null
+++ b/hegel/src/test/java/zoo/ZooListener.java
@@ -0,0 +1,40 @@
+package zoo;
+
+import org.junit.platform.engine.TestExecutionResult;
+import org.junit.platform.engine.support.descriptor.MethodSource;
+import org.junit.platform.launcher.TestExecutionListener;
+import org.junit.platform.launcher.TestIdentifier;
+
+/**
+ * Hegel zoo: prints one {@code ZOO ok|FAILED|ignored <method>} line per test method on stdout;
+ * the zoo's judge reads these lines (registered in META-INF/services).
+ */
+public final class ZooListener implements TestExecutionListener {
+    private static String name(TestIdentifier id) {
+        return id.getSource()
+                .filter(s -> s instanceof MethodSource)
+                .map(s -> ((MethodSource) s).getMethodName())
+                .orElse(null);
+    }
+
+    @Override
+    public void executionFinished(TestIdentifier id, TestExecutionResult result) {
+        String n = name(id);
+        if (n == null || !id.isTest()) {
+            return;
+        }
+        String v = result.getStatus() == TestExecutionResult.Status.SUCCESSFUL ? "ok"
+                : result.getStatus() == TestExecutionResult.Status.ABORTED ? "ignored" : "FAILED";
+        System.out.println("ZOO " + v + " " + n);
+        System.out.flush();
+    }
+
+    @Override
