@@ -0,0 +1,664 @@
+package zoo;
+
+import static zoo.Zoo.chance;
+import static zoo.Zoo.count;
+import static zoo.Zoo.fail;
+import static zoo.Zoo.n;
+import static zoo.Zoo.pick;
+
+import dev.hegel.Hegel;
+import dev.hegel.TestCase;
+import java.util.Arrays;
+import org.apache.commons.math4.legacy.linear.Array2DRowRealMatrix;
+import org.apache.commons.math4.legacy.linear.ArrayRealVector;
+import org.apache.commons.math4.legacy.linear.BlockRealMatrix;
+import org.apache.commons.math4.legacy.linear.CholeskyDecomposition;
+import org.apache.commons.math4.legacy.linear.DecompositionSolver;
+import org.apache.commons.math4.legacy.linear.DiagonalMatrix;
+import org.apache.commons.math4.legacy.linear.EigenDecomposition;
+import org.apache.commons.math4.legacy.linear.LUDecomposition;
+import org.apache.commons.math4.legacy.linear.MatrixUtils;
+import org.apache.commons.math4.legacy.linear.OpenMapRealMatrix;
+import org.apache.commons.math4.legacy.linear.QRDecomposition;
+import org.apache.commons.math4.legacy.linear.RRQRDecomposition;
+import org.apache.commons.math4.legacy.linear.RealMatrix;
+import org.apache.commons.math4.legacy.linear.RealVector;
+import org.apache.commons.math4.legacy.linear.SingularMatrixException;
+import org.apache.commons.math4.legacy.linear.SingularValueDecomposition;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Hegel zoo: the dense linear algebra of Commons Math against exact rational arithmetic (small
+ * integer matrices, {@link Rational}) and against the algebraic identities each decomposition
+ * promises.
+ */
+class LinearTest {
+
+    static final double EPS = 0x1.0p-52;
+
+    /** Known bugs, gated so the properties pass while the pins in PinsTest fail. */
+    static final class Known {
+        /** commons-math/1: EigenDecomposition.getDeterminant multiplies the real parts of the eigenvalues only, so it is wrong whenever there are complex eigenvalues. */
+        static final boolean EIGEN_DETERMINANT_IGNORES_IMAGINARY_PARTS = true;
+        /** commons-math/2: RRQRDecomposition.getRank starts its count at 1, so a zero matrix has rank 1. */
+        static final boolean RRQR_RANK_OF_ZERO_MATRIX_IS_ONE = true;
+    }
+
+    // ------------------------------------------------------------------ generators
+
+    /** An integer matrix with entries in [-9, 9], sometimes sparse, sometimes with a repeated row. */
+    static double[][] intMatrix(TestCase tc, int rows, int cols) {
+        double[][] m = new double[rows][cols];
+        int sparsity = pick(tc, 0, 0, 30, 70);
+        for (int i = 0; i < rows; i++) {
+            for (int j = 0; j < cols; j++) {
+                m[i][j] = chance(tc, sparsity) ? 0 : n(tc, -9, 9);
+            }
+        }
+        if (rows > 1 && chance(tc, 15)) {
+            m[n(tc, 0, rows - 1)] = m[n(tc, 0, rows - 1)].clone(); // singular on purpose
+        }
+        return m;
+    }
+
+    static double[][] symmetric(TestCase tc, int size) {
+        double[][] m = intMatrix(tc, size, size);
+        for (int i = 0; i < size; i++) {
+            for (int j = 0; j < i; j++) {
+                m[i][j] = m[j][i];
+            }
+        }
+        return m;
+    }
+
+    /** A^T A + I: symmetric positive definite with integer entries. */
+    static double[][] spd(TestCase tc, int size) {
+        double[][] a = intMatrix(tc, size, size);
+        double[][] m = new double[size][size];
+        for (int i = 0; i < size; i++) {
+            for (int j = 0; j < size; j++) {
+                double s = i == j ? 1 : 0;
+                for (int k = 0; k < size; k++) {
+                    s += a[k][i] * a[k][j];
+                }
+                m[i][j] = s;
+            }
+        }
+        return m;
+    }
+
+    static double[] intVector(TestCase tc, int size) {
+        double[] v = new double[size];
+        for (int i = 0; i < size; i++) {
+            v[i] = n(tc, -9, 9);
+        }
+        return v;
+    }
+
+    static RealMatrix wrap(TestCase tc, double[][] m) {
+        switch (n(tc, 0, 2)) {
+            case 0: return new Array2DRowRealMatrix(m, true);
+            case 1: return new BlockRealMatrix(m);
+            default: {
+                OpenMapRealMatrix s = new OpenMapRealMatrix(m.length, m[0].length);
+                for (int i = 0; i < m.length; i++) {
+                    for (int j = 0; j < m[0].length; j++) {
+                        if (m[i][j] != 0) {
+                            s.setEntry(i, j, m[i][j]);
+                        }
+                    }
+                }
+                return s;
+            }
+        }
+    }
+
+    // ------------------------------------------------------------------ helpers
+
+    static String show(double[][] m) {
+        return Arrays.deepToString(m);
+    }
+
+    static String show(Rational[][] m) {
+        return Arrays.deepToString(m);
+    }
+
+    static double maxAbs(Rational[][] m) {
+        double best = 0;
+        for (Rational[] row : m) {
+            for (Rational x : row) {
+                best = Math.max(best, Math.abs(x.toDouble()));
+            }
+        }
+        return best;
+    }
+
+    /** |a - b| <= tol, with NaN never passing. */
+    static boolean close(double a, double b, double tol) {
+        return Math.abs(a - b) <= tol;
+    }
+
+    static double maxDiff(RealMatrix a, RealMatrix b) {
+        double d = 0;
+        for (int i = 0; i < a.getRowDimension(); i++) {
+            for (int j = 0; j < a.getColumnDimension(); j++) {
+                double x = Math.abs(a.getEntry(i, j) - b.getEntry(i, j));
+                d = Double.isNaN(x) ? Double.NaN : Math.max(d, x);
+                if (Double.isNaN(d)) {
+                    return d;
+                }
+            }
+        }
+        return d;
+    }
+
+    static double maxDiff(RealMatrix a, Rational[][] b) {
+        double d = 0;
+        for (int i = 0; i < a.getRowDimension(); i++) {
+            for (int j = 0; j < a.getColumnDimension(); j++) {
+                double x = Math.abs(a.getEntry(i, j) - b[i][j].toDouble());
+                if (Double.isNaN(x)) {
+                    return Double.NaN;
+                }
+                d = Math.max(d, x);
+            }
+        }
+        return d;
+    }
+
+    static double maxAbsEntry(RealMatrix a) {
+        double d = 0;
+        for (int i = 0; i < a.getRowDimension(); i++) {
+            for (int j = 0; j < a.getColumnDimension(); j++) {
+                d = Math.max(d, Math.abs(a.getEntry(i, j)));
+            }
+        }
+        return d;
+    }
+
+    static boolean orthonormal(RealMatrix q, double tol) {
+        RealMatrix p = q.transpose().multiply(q);
+        return maxDiff(p, MatrixUtils.createRealIdentityMatrix(p.getRowDimension())) <= tol;
+    }
+
+    // ------------------------------------------------------------------ 1. solvers against exact arithmetic
+
+    /**
+     * For a nonsingular integer matrix A, the LU, QR, SVD (and Cholesky when A is SPD) solvers
+     * return the exact solution of A x = b, the exact inverse and (LU) the exact determinant, to
+     * within a tolerance proportional to the exactly computed condition number; a singular A is
+     * reported singular.
+     */
+    @Test
+    void hegelSolversAgreeWithExactArithmetic() {
+        Hegel.test(tc -> {
+            int size = n(tc, 1, 5);
+            boolean posdef = chance(tc, 25);
+            double[][] m = posdef ? spd(tc, size) : intMatrix(tc, size, size);
+            RealMatrix a = wrap(tc, m);
+            Rational[][] ra = Rational.fromDoubles(m);
+            Rational det = Rational.determinant(ra);
+            LUDecomposition lu = new LUDecomposition(a);
+            if (det.isZero()) {
+                count("singular");
+                if (lu.getSolver().isNonSingular()) {
+                    fail("LU reports the singular matrix " + show(m) + " as nonsingular (det " + lu.getDeterminant() + ")");
+                }
+                if (Math.abs(lu.getDeterminant()) > 1e-9) {
+                    fail("LU determinant of the singular matrix " + show(m) + " is " + lu.getDeterminant());
+                }
+                return;
+            }
+            Rational[][] inv = Rational.inverse(ra);
+            double cond = Rational.norm1(ra).multiply(Rational.norm1(inv)).toDouble();
+            if (cond > 1e7) {
+                count("ill-conditioned (skipped)");
+                return;
+            }
+            count(posdef ? "spd" : "general");
+            double[] bv = intVector(tc, size);
+            Rational[] x = Rational.multiply(inv, Rational.fromDoubles(bv));
+            double xmax = 1;
+            for (Rational xi : x) {
+                xmax = Math.max(xmax, Math.abs(xi.toDouble()));
+            }
+            double tol = 1e-12 * cond * xmax * size;
+            // determinant
+            if (!close(lu.getDeterminant(), det.toDouble(), 1e-11 * cond * Math.max(1, Math.abs(det.toDouble())) * size)) {
+                fail("LU determinant " + lu.getDeterminant() + " vs exact " + det + " for " + show(m) + " (cond " + cond + ")");
+            }
+            java.util.List<Object[]> solvers = new java.util.ArrayList<>();
+            solvers.add(new Object[] {"LU", lu.getSolver()});
+            solvers.add(new Object[] {"QR", new QRDecomposition(a).getSolver()});
+            solvers.add(new Object[] {"SVD", new SingularValueDecomposition(a).getSolver()});
+            solvers.add(new Object[] {"RRQR", new RRQRDecomposition(a).getSolver()});
+            if (posdef) {
+                solvers.add(new Object[] {"Cholesky", new CholeskyDecomposition(a).getSolver()});
+                CholeskyDecomposition ch = new CholeskyDecomposition(a);
+                if (!close(ch.getDeterminant(), det.toDouble(), 1e-11 * cond * Math.abs(det.toDouble()) * size)) {
+                    fail("Cholesky determinant " + ch.getDeterminant() + " vs exact " + det + " for " + show(m));
+                }
+            }
+            for (Object[] s : solvers) {
+                String name = (String) s[0];
+                DecompositionSolver solver = (DecompositionSolver) s[1];
+                if (!solver.isNonSingular()) {
+                    fail(name + " reports " + show(m) + " (det " + det + ", cond " + cond + ") as singular");
+                    continue;
+                }
+                RealVector got = solver.solve(new ArrayRealVector(bv));
+                for (int i = 0; i < size; i++) {
+                    if (!close(got.getEntry(i), x[i].toDouble(), tol)) {
+                        fail(name + " solve gives x[" + i + "] = " + got.getEntry(i) + ", exact " + x[i] + " (" + x[i].toDouble() + ") for A = " + show(m) + ", b = " + Arrays.toString(bv) + ", cond " + cond);
+                        break;
+                    }
+                }
+                RealMatrix gotInv = solver.getInverse();
+                double invTol = 1e-12 * cond * Math.max(1, maxAbs(inv)) * size;
+                double d = maxDiff(gotInv, inv);
+                if (!(d <= invTol)) {
+                    fail(name + " inverse differs from the exact inverse by " + d + " (tolerance " + invTol + ") for " + show(m) + ": got " + gotInv + ", exact " + show(inv));
+                }
+                // solving for a matrix right-hand side agrees with the vector solve
+                RealMatrix bm = MatrixUtils.createColumnRealMatrix(bv);
+                RealMatrix gm = solver.solve(bm);
+                for (int i = 0; i < size; i++) {
+                    if (!close(gm.getEntry(i, 0), got.getEntry(i), tol)) {
+                        fail(name + " solve(matrix) differs from solve(vector) at " + i + ": " + gm.getEntry(i, 0) + " vs " + got.getEntry(i) + " for " + show(m));
+                        break;
+                    }
+                }
+            }
+            // MatrixUtils.inverse agrees too
+            double d = maxDiff(MatrixUtils.inverse(a), inv);
+            if (!(d <= 1e-12 * cond * Math.max(1, maxAbs(inv)) * size)) {
+                fail("MatrixUtils.inverse differs from the exact inverse by " + d + " for " + show(m));
+            }
+        }, Zoo.settings("linear.solvers"));
+    }
+
+    // ------------------------------------------------------------------ 2. matrix algebra is exact on integers
+
+    /**
+     * Products, sums, transposes, powers, traces and norms of small integer matrices are exact in
+     * double arithmetic, so every implementation (Array2DRow, Block, OpenMap sparse, Diagonal) must
+     * agree with the integer model to the last bit.
+     */
+    @Test
+    void hegelMatrixAlgebraIsExactOnIntegers() {
+        Hegel.test(tc -> {
+            int rows = n(tc, 1, 5);
+            int inner = n(tc, 1, 5);
+            int cols = n(tc, 1, 5);
+            double[][] am = intMatrix(tc, rows, inner);
+            double[][] bm = intMatrix(tc, inner, cols);
+            RealMatrix a = wrap(tc, am);
+            RealMatrix b = wrap(tc, bm);
+            Rational[][] ra = Rational.fromDoubles(am);
+            Rational[][] rb = Rational.fromDoubles(bm);
+            // product
+            RealMatrix p = a.multiply(b);
+            Rational[][] rp = Rational.multiply(ra, rb);
+            if (maxDiff(p, rp) != 0) {
+                fail("multiply " + show(am) + " * " + show(bm) + " = " + p + ", exact " + show(rp));
+            }
+            if (maxDiff(b.preMultiply(a), rp) != 0) {
+                fail("preMultiply disagrees with multiply for " + show(am) + " * " + show(bm));
+            }
+            // transpose of a product
+            if (maxDiff(p.transpose(), Rational.transpose(rp)) != 0) {
+                fail("transpose of " + p + " is " + p.transpose());
+            }
+            if (maxDiff(b.transpose().multiply(a.transpose()), Rational.transpose(rp)) != 0) {
+                fail("(AB)^T != B^T A^T for " + show(am) + ", " + show(bm));
+            }
+            // operate on a vector
+            double[] v = intVector(tc, inner);
+            double[] av = a.operate(v);
+            Rational[] rav = Rational.multiply(ra, Rational.fromDoubles(v));
+            for (int i = 0; i < rows; i++) {
+                if (av[i] != rav[i].toDouble()) {
+                    fail("operate " + show(am) + " * " + Arrays.toString(v) + " = " + Arrays.toString(av) + ", exact " + Arrays.toString(rav));
+                    break;
+                }
+            }
+            double[] va = a.preMultiply(intVector(tc, rows));
+            if (va.length != inner) {
+                fail("preMultiply(vector) has length " + va.length + " for a " + rows + "x" + inner + " matrix");
+            }
+            // sums and scalars
+            double[][] cm = intMatrix(tc, rows, inner);
+            RealMatrix c = wrap(tc, cm);
+            RealMatrix sum = a.add(c);
+            RealMatrix diff = a.subtract(c);
+            for (int i = 0; i < rows; i++) {
+                for (int j = 0; j < inner; j++) {
+                    if (sum.getEntry(i, j) != am[i][j] + cm[i][j] || diff.getEntry(i, j) != am[i][j] - cm[i][j]) {
+                        fail("add/subtract wrong at (" + i + "," + j + ") for " + show(am) + " and " + show(cm));
+                    }
+                    if (a.scalarMultiply(3).getEntry(i, j) != 3 * am[i][j] || a.scalarAdd(2).getEntry(i, j) != am[i][j] + 2) {
+                        fail("scalarMultiply/scalarAdd wrong at (" + i + "," + j + ") for " + show(am));
+                    }
+                }
+            }
+            // norms
+            double norm1 = a.getNorm();
+            double exactNorm1 = Rational.norm1(ra).toDouble();
+            if (norm1 != exactNorm1) {
+                fail("getNorm (max column sum) of " + show(am) + " is " + norm1 + ", expected " + exactNorm1);
+            }
+            long sq = 0;
+            for (double[] row : am) {
+                for (double x : row) {
+                    sq += (long) (x * x);
+                }
+            }
+            if (!close(a.getFrobeniusNorm(), Math.sqrt(sq), 4 * EPS * Math.sqrt(sq) + 1e-300)) {
+                fail("Frobenius norm of " + show(am) + " is " + a.getFrobeniusNorm() + ", expected sqrt(" + sq + ")");
+            }
+            // square matrices: trace and powers
+            if (rows == inner) {
+                Rational tr = Rational.ZERO;
+                for (int i = 0; i < rows; i++) {
+                    tr = tr.add(ra[i][i]);
+                }
+                if (a.getTrace() != tr.toDouble()) {
+                    fail("trace of " + show(am) + " is " + a.getTrace() + ", expected " + tr);
+                }
+                int k = n(tc, 0, 4);
+                Rational[][] pow = Rational.fromDoubles(MatrixUtils.createRealIdentityMatrix(rows).getData());
+                for (int i = 0; i < k; i++) {
+                    pow = Rational.multiply(pow, ra);
+                }
+                RealMatrix ak = a.power(k);
+                if (maxAbs(pow) < 1e15 && maxDiff(ak, pow) != 0) {
+                    fail("power(" + k + ") of " + show(am) + " = " + ak + ", exact " + show(pow));
+                }
+                // a diagonal matrix multiplies like its dense form
+                double[] dg = intVector(tc, rows);
+                DiagonalMatrix d = new DiagonalMatrix(dg);
+                RealMatrix dense = MatrixUtils.createRealDiagonalMatrix(dg);
+                if (maxDiff(d.multiply(a), new Array2DRowRealMatrix(dense.getData()).multiply(a)) != 0
+                        || maxDiff(a.multiply(d), a.multiply(new Array2DRowRealMatrix(dense.getData()))) != 0) {
+                    fail("DiagonalMatrix(" + Arrays.toString(dg) + ") products differ from the dense diagonal for " + show(am));
+                }
+            }
+            // copies, equality across implementations and getData
+            RealMatrix copy = a.copy();
+            if (!copy.equals(a) || !a.equals(new Array2DRowRealMatrix(am)) || !new BlockRealMatrix(am).equals(a) || a.hashCode() != new Array2DRowRealMatrix(am).hashCode()) {
+                fail("equals/hashCode differ between implementations for " + show(am) + " (" + a.getClass().getSimpleName() + ")");
+            }
+            if (!Arrays.deepEquals(a.getData(), am)) {
+                fail("getData of " + a.getClass().getSimpleName() + " gives " + show(a.getData()) + " for " + show(am));
+            }
+            // submatrix and row/column access
+            if (rows > 1 && inner > 1) {
+                int r0 = n(tc, 0, rows - 1);
+                int r1 = n(tc, r0, rows - 1);
+                int c0 = n(tc, 0, inner - 1);
+                int c1 = n(tc, c0, inner - 1);
+                RealMatrix sub = a.getSubMatrix(r0, r1, c0, c1);
+                for (int i = r0; i <= r1; i++) {
+                    for (int j = c0; j <= c1; j++) {
+                        if (sub.getEntry(i - r0, j - c0) != am[i][j]) {
+                            fail("getSubMatrix(" + r0 + "," + r1 + "," + c0 + "," + c1 + ") wrong for " + show(am));
+                        }
+                    }
+                }
+                int r = n(tc, 0, rows - 1);
+                if (!Arrays.equals(a.getRow(r), am[r]) || !Arrays.equals(a.getRowVector(r).toArray(), am[r]) || !Arrays.deepEquals(a.getRowMatrix(r).getData(), new double[][] {am[r]})) {
+                    fail("getRow(" + r + ") wrong for " + show(am));
+                }
+                int cc = n(tc, 0, inner - 1);
+                double[] col = new double[rows];
+                for (int i = 0; i < rows; i++) {
+                    col[i] = am[i][cc];
+                }
+                if (!Arrays.equals(a.getColumn(cc), col) || !Arrays.equals(a.getColumnVector(cc).toArray(), col)) {
+                    fail("getColumn(" + cc + ") wrong for " + show(am));
+                }
+            }
+        }, Zoo.settings("linear.algebra"));
+    }
+
+    // ------------------------------------------------------------------ 3. eigen decomposition
+
+    /**
+     * For a symmetric integer matrix: A V = V D, V is orthonormal, the eigenvalues sum to the trace
+     * and multiply to the exact determinant, getSolver inverts, and for SPD matrices the square root
+     * squares back to A. For a general matrix with real eigenvalues the same identities hold for
+     * the real eigen pairs, and with complex ones the trace/determinant identities still hold.
+     */
+    @Test
+    void hegelEigenDecompositionReconstructs() {
+        Hegel.test(tc -> {
+            int size = n(tc, 1, 5);
+            int kind = n(tc, 0, 2);
+            double[][] m = kind == 0 ? spd(tc, size) : kind == 1 ? symmetric(tc, size) : intMatrix(tc, size, size);
+            RealMatrix a = new Array2DRowRealMatrix(m);
+            Rational[][] ra = Rational.fromDoubles(m);
+            Rational det = Rational.determinant(ra);
+            EigenDecomposition ed;
+            try {
+                ed = new EigenDecomposition(a);
+            } catch (org.apache.commons.math4.legacy.exception.MaxCountExceededException e) {
+                count("eigen: no convergence");
+                return;
+            }
+            double scale = Math.max(1, maxAbsEntry(a));
+            double tol = 1e-9 * scale * size;
+            double[] re = ed.getRealEigenvalues();
+            double[] im = ed.getImagEigenvalues();
+            // trace and determinant
+            double trace = 0;
+            for (double x : re) {
+                trace += x;
+            }
+            if (!close(trace, a.getTrace(), tol)) {
+                fail("eigenvalues " + Arrays.toString(re) + " sum to " + trace + ", trace is " + a.getTrace() + " for " + show(m));
+            }
+            double pr = 1;
+            double pi = 0;
+            for (int i = 0; i < size; i++) {
+                double nr = pr * re[i] - pi * im[i];
+                double ni = pr * im[i] + pi * re[i];
+                pr = nr;
+                pi = ni;
+            }
+            double detTol = 1e-8 * Math.pow(scale, size) * size;
+            if (!close(pr, det.toDouble(), detTol) || !close(pi, 0, detTol)) {
+                fail("eigenvalues " + Arrays.toString(re) + " + i" + Arrays.toString(im) + " multiply to " + pr + " + " + pi + "i, exact determinant " + det + " for " + show(m));
+            }
+            if (!close(ed.getDeterminant(), det.toDouble(), detTol)) {
+                if (Known.EIGEN_DETERMINANT_IGNORES_IMAGINARY_PARTS && ed.hasComplexEigenvalues()) {
+                    count("known commons-math/1 getDeterminant with complex eigenvalues");
+                } else {
+                    fail("getDeterminant " + ed.getDeterminant() + " vs exact " + det + " for " + show(m));
+                }
+            }
+            if (kind < 2) {
+                count("symmetric");
+                if (ed.hasComplexEigenvalues()) {
+                    fail("symmetric " + show(m) + " reported with complex eigenvalues " + Arrays.toString(im));
+                    return;
+                }
+                RealMatrix v = ed.getV();
+                RealMatrix d = ed.getD();
+                if (maxDiff(a.multiply(v), v.multiply(d)) > tol) {
+                    fail("A V != V D for symmetric " + show(m) + ": V = " + v + ", D = " + d);
+                }
+                if (!orthonormal(v, 1e-10 * size)) {
+                    fail("V is not orthonormal for symmetric " + show(m) + ": V = " + v);
+                }
+                if (maxDiff(v.multiply(d).multiply(ed.getVT()), a) > tol) {
+                    fail("V D V^T != A for symmetric " + show(m));
+                }
+                for (int i = 0; i < size; i++) {
+                    RealVector ev = ed.getEigenvector(i);
+                    if (maxDiffVec(a.operate(ev), ev.mapMultiply(re[i])) > tol) {
+                        fail("eigenvector " + i + " (" + ev + ") of " + show(m) + " is not an eigenvector for " + re[i]);
+                    }
+                }
+                if (kind == 0) {
+                    RealMatrix sq = ed.getSquareRoot();
+                    if (maxDiff(sq.multiply(sq), a) > tol) {
+                        fail("square root squared != A for SPD " + show(m) + ": sqrt = " + sq);
+                    }
+                }
+                if (!det.isZero()) {
+                    Rational[][] inv = Rational.inverse(ra);
+                    double cond = Rational.norm1(ra).multiply(Rational.norm1(inv)).toDouble();
+                    if (cond < 1e7) {
+                        DecompositionSolver s = ed.getSolver();
+                        if (!s.isNonSingular()) {
+                            fail("eigen solver reports " + show(m) + " (det " + det + ") as singular");
+                        } else if (!(maxDiff(s.getInverse(), inv) <= 1e-10 * cond * Math.max(1, maxAbs(inv)) * size)) {
+                            fail("eigen solver inverse " + s.getInverse() + " vs exact " + show(inv) + " for " + show(m));
+                        }
+                    }
+                } else if (ed.getSolver().isNonSingular()) {
+                    fail("eigen solver reports the singular " + show(m) + " as nonsingular");
+                }
+            } else {
+                count(ed.hasComplexEigenvalues() ? "general: complex" : "general: real");
+                for (int i = 0; i < size; i++) {
+                    if (im[i] == 0) {
+                        RealVector ev = ed.getEigenvector(i);
+                        if (maxDiffVec(a.operate(ev), ev.mapMultiply(re[i])) > 1e-7 * scale * size * Math.max(1, ev.getLInfNorm())) {
+                            fail("real eigenvector " + i + " (" + ev + ", value " + re[i] + ") of " + show(m) + " is not an eigenvector: A v = " + a.operate(ev));
+                        }
+                    }
+                }
+            }
+        }, Zoo.settings("linear.eigen"));
+    }
+
+    static double maxDiffVec(RealVector a, RealVector b) {
+        double d = 0;
+        for (int i = 0; i < a.getDimension(); i++) {
+            double x = Math.abs(a.getEntry(i) - b.getEntry(i));
+            if (Double.isNaN(x)) {
+                return Double.NaN;
+            }
+            d = Math.max(d, x);
+        }
+        return d;
+    }
+
+    // ------------------------------------------------------------------ 4. SVD and QR
+
+    /**
+     * For an integer m x n matrix: U S V^T = A with orthonormal U and V and non-increasing singular
+     * values, the rank equals the exact rank, the 2-norm is the largest singular value, the
+     * pseudo-inverse solve of a full-column-rank least-squares problem equals the exact normal
+     * equations solution; Q R = A with orthonormal Q and upper triangular R, and RRQR finds the rank.
+     */
+    @Test
+    void hegelSvdAndQrFactorExactly() {
+        Hegel.test(tc -> {
+            int rows = n(tc, 1, 5);
+            int cols = n(tc, 1, 5);
+            double[][] m = intMatrix(tc, rows, cols);
+            RealMatrix a = wrap(tc, m);
+            Rational[][] ra = Rational.fromDoubles(m);
+            int rank = Rational.rank(ra);
+            double scale = Math.max(1, maxAbsEntry(a));
+            double tol = 1e-10 * scale * Math.max(rows, cols);
+            SingularValueDecomposition svd = new SingularValueDecomposition(a);
+            double[] s = svd.getSingularValues();
+            for (int i = 0; i < s.length; i++) {
+                if (s[i] < 0 || (i > 0 && s[i] > s[i - 1])) {
+                    fail("singular values " + Arrays.toString(s) + " are not non-increasing and non-negative for " + show(m));
+                    break;
+                }
+            }
+            if (maxDiff(svd.getU().multiply(svd.getS()).multiply(svd.getVT()), a) > tol) {
+                fail("U S V^T != A for " + show(m) + ": U = " + svd.getU() + ", S = " + svd.getS() + ", V = " + svd.getV());
+            }
+            if (!orthonormal(svd.getU(), 1e-10 * rows) || !orthonormal(svd.getV(), 1e-10 * cols)) {
+                fail("U or V not orthonormal for " + show(m) + ": U = " + svd.getU() + ", V = " + svd.getV());
+            }
+            if (svd.getRank() != rank) {
+                fail("SVD rank " + svd.getRank() + " vs exact rank " + rank + " for " + show(m) + " (singular values " + Arrays.toString(s) + ")");
+            }
+            if (svd.getNorm() != s[0]) {
+                fail("getNorm " + svd.getNorm() + " is not the largest singular value " + s[0]);
+            }
+            if (rank == Math.min(rows, cols) && s[s.length - 1] > 0) {
+                double cond = s[0] / s[s.length - 1];
+                if (!close(svd.getConditionNumber(), cond, 1e-9 * cond)) {
+                    fail("condition number " + svd.getConditionNumber() + " vs s_max/s_min " + cond);
+                }
+            }
+            // least squares through the pseudo-inverse
+            if (rank == cols && rows >= cols) {
+                Rational[][] at = Rational.transpose(ra);
+                Rational[][] ata = Rational.multiply(at, ra);
+                Rational[][] inv = Rational.inverse(ata);
+                double cond = Rational.norm1(ata).multiply(Rational.norm1(inv)).toDouble();
+                if (cond < 1e7) {
+                    double[] bv = intVector(tc, rows);
+                    Rational[] x = Rational.multiply(inv, Rational.multiply(at, Rational.fromDoubles(bv)));
+                    RealVector got = svd.getSolver().solve(new ArrayRealVector(bv));
+                    double xmax = 1;
+                    for (Rational xi : x) {
+                        xmax = Math.max(xmax, Math.abs(xi.toDouble()));
+                    }
+                    for (int i = 0; i < cols; i++) {
+                        if (!close(got.getEntry(i), x[i].toDouble(), 1e-9 * Math.sqrt(cond) * xmax * cols)) {
+                            fail("SVD least squares x[" + i + "] = " + got.getEntry(i) + ", exact " + x[i] + " for A = " + show(m) + ", b = " + Arrays.toString(bv) + " (cond(A^T A) " + cond + ")");
+                            break;
+                        }
+                    }
+                    // QR solves the same least-squares problem
+                    QRDecomposition qr = new QRDecomposition(a);
+                    RealVector gotQr = qr.getSolver().solve(new ArrayRealVector(bv));
+                    for (int i = 0; i < cols; i++) {
+                        if (!close(gotQr.getEntry(i), x[i].toDouble(), 1e-9 * Math.sqrt(cond) * xmax * cols)) {
+                            fail("QR least squares x[" + i + "] = " + gotQr.getEntry(i) + ", exact " + x[i] + " for A = " + show(m) + ", b = " + Arrays.toString(bv));
+                            break;
+                        }
+                    }
+                }
+            }
+            // QR factors
+            QRDecomposition qr = new QRDecomposition(a);
+            RealMatrix q = qr.getQ();
+            RealMatrix r = qr.getR();
+            if (maxDiff(q.multiply(r), a) > tol) {
+                fail("Q R != A for " + show(m) + ": Q = " + q + ", R = " + r);
+            }
+            if (!orthonormal(q, 1e-10 * rows)) {
+                fail("Q not orthonormal for " + show(m) + ": Q = " + q);
+            }
+            for (int i = 0; i < r.getRowDimension(); i++) {
+                for (int j = 0; j < Math.min(i, r.getColumnDimension()); j++) {
+                    if (r.getEntry(i, j) != 0) {
+                        fail("R is not upper triangular for " + show(m) + ": R = " + r);
+                    }
+                }
+            }
+            // the default singularity threshold is 0 (exact zeros on R's diagonal only), which rounding
+            // defeats for a rank-deficient matrix; a small threshold is the documented way to detect it
+            QRDecomposition qrt = new QRDecomposition(a, 1e-9 * Math.max(1, maxAbsEntry(a)));
+            if (rows == cols && qrt.getSolver().isNonSingular() != (rank == cols)) {
+                fail("QR(threshold) isNonSingular " + qrt.getSolver().isNonSingular() + " for " + show(m) + " of rank " + rank);
+            }
+            if (rows == cols && rank == cols && !qr.getSolver().isNonSingular()) {
+                fail("QR isNonSingular false for the full-rank " + show(m));
+            }
+            RRQRDecomposition rrqr = new RRQRDecomposition(a);
+            int rr = rrqr.getRank(1e-10);
+            if (rr != rank) {
+                if (Known.RRQR_RANK_OF_ZERO_MATRIX_IS_ONE && rank == 0 && rr == 1) {
+                    count("known commons-math/2 RRQR rank of a zero matrix");
+                } else {
+                    fail("RRQR rank " + rr + " vs exact rank " + rank + " for " + show(m));
+                }
+            }
+            if (maxDiff(rrqr.getQ().multiply(rrqr.getR()), a.multiply(rrqr.getP())) > tol) {
+                fail("Q R != A P for RRQR of " + show(m));
+            }
+        }, Zoo.settings("linear.svd"));
+    }
+}
