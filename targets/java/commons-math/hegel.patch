+package zoo;
+
+import static zoo.Zoo.chance;
+import static zoo.Zoo.count;
+import static zoo.Zoo.fail;
+import static zoo.Zoo.n;
+import static zoo.Zoo.pick;
+
+import dev.hegel.Hegel;
+import dev.hegel.TestCase;
+import java.math.BigInteger;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import org.apache.commons.math4.legacy.analysis.UnivariateFunction;
+import org.apache.commons.math4.legacy.analysis.differentiation.DerivativeStructure;
+import org.apache.commons.math4.legacy.analysis.integration.IterativeLegendreGaussIntegrator;
+import org.apache.commons.math4.legacy.analysis.integration.MidPointIntegrator;
+import org.apache.commons.math4.legacy.analysis.integration.RombergIntegrator;
+import org.apache.commons.math4.legacy.analysis.integration.SimpsonIntegrator;
+import org.apache.commons.math4.legacy.analysis.integration.TrapezoidIntegrator;
+import org.apache.commons.math4.legacy.analysis.integration.UnivariateIntegrator;
+import org.apache.commons.math4.legacy.analysis.interpolation.AkimaSplineInterpolator;
+import org.apache.commons.math4.legacy.analysis.interpolation.DividedDifferenceInterpolator;
+import org.apache.commons.math4.legacy.analysis.interpolation.HermiteInterpolator;
+import org.apache.commons.math4.legacy.analysis.interpolation.LinearInterpolator;
+import org.apache.commons.math4.legacy.analysis.interpolation.NevilleInterpolator;
+import org.apache.commons.math4.legacy.analysis.interpolation.SplineInterpolator;
+import org.apache.commons.math4.legacy.analysis.polynomials.PolynomialFunction;
+import org.apache.commons.math4.legacy.analysis.polynomials.PolynomialFunctionLagrangeForm;
+import org.apache.commons.math4.legacy.analysis.polynomials.PolynomialFunctionNewtonForm;
+import org.apache.commons.math4.legacy.analysis.polynomials.PolynomialSplineFunction;
+import org.apache.commons.math4.legacy.analysis.polynomials.PolynomialsUtils;
+import org.apache.commons.math4.legacy.analysis.solvers.AllowedSolution;
+import org.apache.commons.math4.legacy.analysis.solvers.BisectionSolver;
+import org.apache.commons.math4.legacy.analysis.solvers.BracketedUnivariateSolver;
+import org.apache.commons.math4.legacy.analysis.solvers.BracketingNthOrderBrentSolver;
+import org.apache.commons.math4.legacy.analysis.solvers.BrentSolver;
+import org.apache.commons.math4.legacy.analysis.solvers.IllinoisSolver;
+import org.apache.commons.math4.legacy.analysis.solvers.LaguerreSolver;
+import org.apache.commons.math4.legacy.analysis.solvers.MullerSolver;
+import org.apache.commons.math4.legacy.analysis.solvers.MullerSolver2;
+import org.apache.commons.math4.legacy.analysis.solvers.NewtonRaphsonSolver;
+import org.apache.commons.math4.legacy.analysis.solvers.PegasusSolver;
+import org.apache.commons.math4.legacy.analysis.solvers.RegulaFalsiSolver;
+import org.apache.commons.math4.legacy.analysis.solvers.RiddersSolver;
+import org.apache.commons.math4.legacy.analysis.solvers.SecantSolver;
+import org.apache.commons.math4.legacy.analysis.solvers.UnivariateSolver;
+import org.apache.commons.numbers.complex.Complex;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Hegel zoo: polynomials, automatic differentiation, integrators, root solvers and interpolators
+ * of Commons Math against exact integer polynomial arithmetic.
+ */
+class AnalysisTest {
+
+    /** Known bugs, gated so the properties pass while the pins in PinsTest fail. */
+    static final class Known {
+        /** commons-math/3: SecantSolver stops when two iterates happen to be close, wherever f is. */
+        static final boolean SECANT_STOPS_ON_A_SMALL_STEP_FAR_FROM_A_ROOT = true;
+    }
+
+    // ------------------------------------------------------------------ integer polynomial model
+
+    /** Coefficients c[0] + c[1] x + ..., BigInteger, trailing zeros stripped (the zero polynomial is [0]). */
+    static BigInteger[] poly(long... c) {
+        BigInteger[] r = new BigInteger[c.length];
+        for (int i = 0; i < c.length; i++) {
+            r[i] = BigInteger.valueOf(c[i]);
+        }
+        return strip(r);
+    }
+
+    static BigInteger[] strip(BigInteger[] c) {
+        int n = c.length;
+        while (n > 1 && c[n - 1].signum() == 0) {
+            n--;
+        }
+        return Arrays.copyOf(c, n);
+    }
+
+    static BigInteger[] add(BigInteger[] a, BigInteger[] b) {
+        BigInteger[] r = new BigInteger[Math.max(a.length, b.length)];
+        for (int i = 0; i < r.length; i++) {
+            r[i] = (i < a.length ? a[i] : BigInteger.ZERO).add(i < b.length ? b[i] : BigInteger.ZERO);
+        }
+        return strip(r);
+    }
+
+    static BigInteger[] negate(BigInteger[] a) {
+        BigInteger[] r = new BigInteger[a.length];
+        for (int i = 0; i < a.length; i++) {
+            r[i] = a[i].negate();
+        }
+        return r;
+    }
+
+    static BigInteger[] multiply(BigInteger[] a, BigInteger[] b) {
+        BigInteger[] r = new BigInteger[a.length + b.length - 1];
+        Arrays.fill(r, BigInteger.ZERO);
+        for (int i = 0; i < a.length; i++) {
+            for (int j = 0; j < b.length; j++) {
+                r[i + j] = r[i + j].add(a[i].multiply(b[j]));
+            }
+        }
+        return strip(r);
+    }
+
+    static BigInteger[] derivative(BigInteger[] a) {
+        if (a.length == 1) {
+            return poly(0);
+        }
+        BigInteger[] r = new BigInteger[a.length - 1];
+        for (int i = 1; i < a.length; i++) {
+            r[i - 1] = a[i].multiply(BigInteger.valueOf(i));
+        }
+        return strip(r);
+    }
+
+    static Rational value(BigInteger[] a, Rational x) {
+        Rational r = Rational.ZERO;
+        for (int i = a.length - 1; i >= 0; i--) {
+            r = r.multiply(x).add(Rational.of(a[i], BigInteger.ONE));
+        }
+        return r;
+    }
+
+    static BigInteger value(BigInteger[] a, long x) {
+        BigInteger r = BigInteger.ZERO;
+        BigInteger bx = BigInteger.valueOf(x);
+        for (int i = a.length - 1; i >= 0; i--) {
+            r = r.multiply(bx).add(a[i]);
+        }
+        return r;
+    }
+
+    /** The exact integral of a over [lo, hi]. */
+    static Rational integral(BigInteger[] a, long lo, long hi) {
+        Rational s = Rational.ZERO;
+        for (int i = 0; i < a.length; i++) {
+            BigInteger hp = BigInteger.valueOf(hi).pow(i + 1).subtract(BigInteger.valueOf(lo).pow(i + 1));
+            s = s.add(Rational.of(a[i].multiply(hp), BigInteger.valueOf(i + 1)));
+        }
+        return s;
+    }
+
+    static double[] toDoubles(BigInteger[] a) {
+        double[] r = new double[a.length];
+        for (int i = 0; i < a.length; i++) {
+            r[i] = a[i].doubleValue();
+        }
+        return r;
+    }
+
+    static BigInteger[] randomPoly(TestCase tc, int maxDegree) {
+        int deg = n(tc, 0, maxDegree);
+        long[] c = new long[deg + 1];
+        for (int i = 0; i <= deg; i++) {
+            c[i] = chance(tc, 20) ? 0 : n(tc, -9, 9);
+        }
+        if (deg > 0 && c[deg] == 0) {
+            c[deg] = pick(tc, -3L, 1L, 2L, 7L);
+        }
+        return poly(c);
+    }
+
+    /** prod (x - r_i) for the given integer roots. */
+    static BigInteger[] fromRoots(long[] roots) {
+        BigInteger[] p = poly(1);
+        for (long r : roots) {
+            p = multiply(p, poly(-r, 1));
+        }
+        return p;
+    }
+
+    static String show(BigInteger[] a) {
+        return Arrays.toString(a);
+    }
+
+    static boolean close(double a, double b, double tol) {
+        return Math.abs(a - b) <= tol;
+    }
+
+    /** A bound on the rounding error of evaluating a at x in double arithmetic (Horner, unit roundoff 2^-53). */
+    static double noise(BigInteger[] a, double x) {
+        double s = 0;
+        double ax = Math.abs(x);
+        double pw = 1;
+        for (BigInteger c : a) {
+            s += Math.abs(c.doubleValue()) * pw;
+            pw *= ax;
+        }
+        return 2 * a.length * 1.2e-16 * s;
+    }
+
+    /** Element-wise ==, so that -0.0 equals 0. */
+    static boolean sameDoubles(double[] a, double[] b) {
+        if (a.length != b.length) {
+            return false;
+        }
+        for (int i = 0; i < a.length; i++) {
+            if (a[i] != b[i]) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    // ------------------------------------------------------------------ 1. polynomial arithmetic and automatic differentiation
+
+    /**
+     * PolynomialFunction arithmetic, derivatives, values, coefficients and PolynomialsUtils.shift
+     * agree exactly with integer polynomial arithmetic (small integer coefficients keep every
+     * intermediate exactly representable); the Lagrange and Newton forms built from n+1 samples of
+     * a degree-n polynomial reproduce it; DerivativeStructure evaluation gives the exact derivatives
+     * of every order at integer points.
+     */
+    @Test
+    void hegelPolynomialsAreExactOnIntegers() {
+        Hegel.test(tc -> {
+            BigInteger[] a = randomPoly(tc, 5);
+            BigInteger[] b = randomPoly(tc, 5);
+            PolynomialFunction pa = new PolynomialFunction(toDoubles(a));
+            PolynomialFunction pb = new PolynomialFunction(toDoubles(b));
+            if (pa.degree() != a.length - 1) {
+                fail("degree of " + show(a) + " reported as " + pa.degree());
+            }
+            if (!sameDoubles(pa.getCoefficients(), toDoubles(a))) {
+                fail("coefficients of " + show(a) + " come back as " + Arrays.toString(pa.getCoefficients()));
+            }
+            checkPoly("add", pa.add(pb), add(a, b), a, b);
+            checkPoly("subtract", pa.subtract(pb), add(a, negate(b)), a, b);
+            checkPoly("multiply", pa.multiply(pb), multiply(a, b), a, b);
+            checkPoly("negate", pa.negate(), negate(a), a, b);
+            checkPoly("derivative", pa.polynomialDerivative(), derivative(a), a, b);
+            // equality follows the coefficients
+            if (!pa.equals(new PolynomialFunction(toDoubles(a))) || pa.hashCode() != new PolynomialFunction(toDoubles(a)).hashCode()) {
+                fail("equals/hashCode differ for two copies of " + show(a));
+            }
+            if (pa.equals(pb) != Arrays.equals(a, b)) {
+                fail("equals of " + show(a) + " and " + show(b) + " is " + pa.equals(pb));
+            }
+            // values at integers and half-integers
+            for (int k = 0; k < 4; k++) {
+                long x = n(tc, -6, 6);
+                double got = pa.value(x);
+                BigInteger want = value(a, x);
+                if (got != want.doubleValue()) {
+                    fail("value of " + show(a) + " at " + x + " is " + got + ", exact " + want);
+                }
+                Rational half = Rational.of(BigInteger.valueOf(2 * x + 1), BigInteger.TWO);
+                double goth = pa.value(half.toDouble());
+                double wanth = value(a, half).toDouble();
+                if (!close(goth, wanth, 1e-12 * Math.max(1, Math.abs(wanth)))) {
+                    fail("value of " + show(a) + " at " + half + " is " + goth + ", exact " + wanth);
+                }
+            }
+            // shift: p(x + h)
+            long h = n(tc, -4, 4);
+            double[] shifted = PolynomialsUtils.shift(toDoubles(a), h);
+            BigInteger[] want = poly(0);
+            // p(x+h) = sum a_i (x+h)^i
+            BigInteger[] xh = poly(h, 1);
+            BigInteger[] pw = poly(1);
+            for (int i = 0; i < a.length; i++) {
+                want = add(want, multiply(new BigInteger[] {a[i]}, pw));
+                pw = multiply(pw, xh);
+            }
+            if (!Arrays.equals(strip(toBig(shifted)), want)) {
+                fail("shift(" + show(a) + ", " + h + ") = " + Arrays.toString(shifted) + ", exact " + show(want));
+            }
+            // Lagrange and Newton forms through n+1 distinct integer points reproduce the polynomial
+            int deg = a.length - 1;
+            int m = deg + 1 + n(tc, 0, 2);
+            double[] xs = new double[m];
+            double[] ys = new double[m];
+            int start = n(tc, -6, 0);
+            for (int i = 0; i < m; i++) {
+                xs[i] = start + 2 * i + (chance(tc, 50) ? 1 : 0);
+                ys[i] = value(a, (long) xs[i]).doubleValue();
+            }
+            if (m >= 2) {
+                PolynomialFunctionLagrangeForm lf = new NevilleInterpolator().interpolate(xs, ys);
+                PolynomialFunctionNewtonForm nf = new DividedDifferenceInterpolator().interpolate(xs, ys);
+                double scale = 1;
+                for (BigInteger c : a) {
+                    scale = Math.max(scale, c.abs().doubleValue());
+                }
+                scale *= Math.pow(12, deg);
+                double[] lc = lf.getCoefficients();
+                double[] nc = nf.getCoefficients();
+                for (int i = 0; i <= deg; i++) {
+                    if (!close(lc[i], a[i].doubleValue(), 1e-9 * scale) || !close(nc[i], a[i].doubleValue(), 1e-9 * scale)) {
+                        fail("interpolating " + show(a) + " through " + Arrays.toString(xs) + " gives Lagrange coefficients " + Arrays.toString(lc) + ", Newton " + Arrays.toString(nc));
+                        break;
+                    }
+                }
+                double x = n(tc, -20, 20) / 4.0;
+                double exact = value(a, Rational.of(x)).toDouble();
+                if (!close(lf.value(x), exact, 1e-9 * scale * Math.max(1, Math.pow(Math.abs(x), deg))) || !close(nf.value(x), exact, 1e-9 * scale * Math.max(1, Math.pow(Math.abs(x), deg)))) {
+                    fail("interpolant of " + show(a) + " at " + x + " gives Lagrange " + lf.value(x) + ", Newton " + nf.value(x) + ", exact " + exact);
+                }
+            }
+            // automatic differentiation: all derivatives at an integer point
+            int order = n(tc, 0, 6);
+            long x0 = n(tc, -4, 4);
+            DerivativeStructure ds = pa.value(new DerivativeStructure(1, order, 0, x0));
+            BigInteger[] d = a;
+            for (int k = 0; k <= order; k++) {
+                double got = ds.getPartialDerivative(k);
+                BigInteger exact = value(d, x0);
+                if (got != exact.doubleValue()) {
+                    fail("derivative " + k + " of " + show(a) + " at " + x0 + " by DerivativeStructure is " + got + ", exact " + exact);
+                }
+                d = derivative(d);
+            }
+            if (ds.getValue() != value(a, x0).doubleValue() || ds.getReal() != ds.getValue()) {
+                fail("DerivativeStructure value of " + show(a) + " at " + x0 + " is " + ds.getValue());
+            }
+            // the product rule through DerivativeStructure arithmetic
+            DerivativeStructure x = new DerivativeStructure(1, Math.min(order, 3), 0, x0);
+            DerivativeStructure prod = pa.value(x).multiply(pb.value(x));
+            BigInteger[] ab = multiply(a, b);
+            d = ab;
+            for (int k = 0; k <= Math.min(order, 3); k++) {
+                double got = prod.getPartialDerivative(k);
+                BigInteger exact = value(d, x0);
+                if (Math.abs(exact.doubleValue()) < 1e15 && got != exact.doubleValue()) {
+                    fail("derivative " + k + " of the product " + show(a) + " * " + show(b) + " at " + x0 + " is " + got + ", exact " + exact);
+                }
+                d = derivative(d);
+            }
+        }, Zoo.settings("analysis.polynomials"));
+    }
+
+    static BigInteger[] toBig(double[] c) {
+        BigInteger[] r = new BigInteger[c.length];
+        for (int i = 0; i < c.length; i++) {
+            if (c[i] != Math.rint(c[i])) {
+                return new BigInteger[] {BigInteger.valueOf(Long.MIN_VALUE)}; // not an integer polynomial: never equal
+            }
+            r[i] = BigInteger.valueOf((long) c[i]);
+        }
+        return r;
+    }
+
+    static void checkPoly(String op, PolynomialFunction got, BigInteger[] want, BigInteger[] a, BigInteger[] b) {
+        if (!sameDoubles(got.getCoefficients(), toDoubles(want))) {
+            fail(op + " of " + show(a) + " and " + show(b) + " gives " + Arrays.toString(got.getCoefficients()) + ", exact " + show(want));
+        }
+    }
+
+    // ------------------------------------------------------------------ 2. integrators
+
+    /**
+     * Every integrator integrates a small-degree integer polynomial over an integer interval to
+     * within its declared accuracy (Simpson is exact for cubics and Gauss-Legendre with n points
+     * for degree 2n-1, so those also hold at the first iteration), and the evaluation/iteration
+     * counters stay within the configured limits.
+     */
+    @Test
+    void hegelIntegratorsIntegratePolynomials() {
+        Hegel.test(tc -> {
+            BigInteger[] a = randomPoly(tc, 6);
+            PolynomialFunction p = new PolynomialFunction(toDoubles(a));
+            long lo = n(tc, -3, 2);
+            long hi = lo + n(tc, 1, 4);
+            Rational exact = integral(a, lo, hi);
+            double want = exact.toDouble();
+            double rel = 1e-8;
+            double abs = 1e-12;
+            int maxEval = 100000;
+            List<Object[]> integrators = new ArrayList<>();
+            // at least 3 iterations: with fewer, two successive estimates of the O(h^2) rules can coincide
+            // by accident (the midpoint sums of a quartic over [-2, 1] with 1 and 3 points are equal)
+            integrators.add(new Object[] {"Simpson", new SimpsonIntegrator(rel, abs, 3, 30)});
+            integrators.add(new Object[] {"Romberg", new RombergIntegrator(rel, abs, 3, RombergIntegrator.ROMBERG_MAX_ITERATIONS_COUNT)});
+            // the O(h^2) rules get a looser tolerance and more evaluations
+            integrators.add(new Object[] {"Trapezoid", new TrapezoidIntegrator(1e-6, 1e-8, 3, 30)});
+            integrators.add(new Object[] {"MidPoint", new MidPointIntegrator(1e-6, 1e-8, 3, 39)});
+            int points = n(tc, 1, 5);
+            // one Legendre-Gauss point per interval is the midpoint rule, so it gets the O(h^2) settings too
+            integrators.add(new Object[] {"LegendreGauss(" + points + ")", points == 1 ? new IterativeLegendreGaussIntegrator(1, 1e-6, 1e-8, 3, 64) : new IterativeLegendreGaussIntegrator(points, rel, abs, 3, 64)});
+            double scale = 0;
+            for (BigInteger c : a) {
+                scale = Math.max(scale, c.abs().doubleValue());
+            }
+            scale *= Math.pow(Math.max(Math.abs(lo), Math.abs(hi)), a.length) * (hi - lo);
+            for (Object[] e : integrators) {
+                String name = (String) e[0];
+                UnivariateIntegrator integ = (UnivariateIntegrator) e[1];
+                double got;
+                try {
+                    got = integ.integrate(maxEval, p, lo, hi);
+                } catch (org.apache.commons.math4.legacy.exception.MaxCountExceededException ex) {
+                    // an integral that cancels to (nearly) zero leaves only the absolute tolerance, which the
+                    // O(h^2) rules cannot always reach within the evaluation budget: not the integrator's fault
+                    if (integ.getRelativeAccuracy() >= 1e-6 && Math.abs(want) < 1e-6 * scale) {
+                        count(name + " ran out of evaluations on a cancelling integral");
+                        continue;
+                    }
+                    fail(name + " did not converge on " + show(a) + " over [" + lo + ", " + hi + "]: " + ex.getMessage());
+                    continue;
+                }
+                double tol = 100 * (integ.getRelativeAccuracy() * Math.abs(want) + integ.getAbsoluteAccuracy()) + 1e-13 * scale;
+                if (!close(got, want, tol)) {
+                    fail(name + " gives " + got + " for the integral of " + show(a) + " over [" + lo + ", " + hi + "], exact " + exact + " (" + want + "), tolerance " + tol);
+                }
+                if (integ.getEvaluations() > maxEval) {
+                    fail(name + " used " + integ.getEvaluations() + " evaluations, more than the limit " + maxEval);
+                }
+                if (integ.getIterations() > integ.getMaximalIterationCount()) {
+                    fail(name + " used " + integ.getIterations() + " iterations, more than the limit " + integ.getMaximalIterationCount());
+                }
+            }
+            // exactness of the fixed rules: Simpson on degree <= 3 needs one iteration
+            if (a.length <= 4) {
+                SimpsonIntegrator s = new SimpsonIntegrator(rel, abs, 1, 30);
+                s.integrate(maxEval, p, lo, hi);
+                count("simpson iterations on a cubic: " + s.getIterations());
+            }
+            // a reversed interval is rejected (endpoints must be ordered)
+            SimpsonIntegrator s2 = new SimpsonIntegrator(rel, abs, 1, 30);
+            try {
+                double rev = s2.integrate(maxEval, p, hi, lo);
+                fail("Simpson over the reversed interval [" + hi + ", " + lo + "] gives " + rev + " instead of rejecting it");
+            } catch (org.apache.commons.math4.legacy.exception.NumberIsTooLargeException ex) {
+                count("reversed interval rejected");
+            }
+        }, Zoo.settings("analysis.integration"));
+    }
+
+    // ------------------------------------------------------------------ 3. root solvers
+
+    /**
+     * For a polynomial with distinct integer roots and a bracket around one of them, every
+     * bracketing solver returns that root to its absolute accuracy, the side-selecting solvers
+     * respect the requested side, the open methods return some root, and LaguerreSolver finds the
+     * whole set of roots.
+     */
+    @Test
+    void hegelSolversFindTheBracketedRoot() {
+        Hegel.test(tc -> {
+            int k = n(tc, 1, 4);
+            long[] roots = new long[k];
+            long r = n(tc, -8, -2);
+            for (int i = 0; i < k; i++) {
+                r += n(tc, 1, 4);
+                roots[i] = r;
+            }
+            BigInteger[] a = fromRoots(roots);
+            if (chance(tc, 50)) {
+                a = multiply(a, poly(pick(tc, -3L, -1L, 2L, 5L)));
+            }
+            PolynomialFunction p = new PolynomialFunction(toDoubles(a));
+            int which = n(tc, 0, k - 1);
+            double root = roots[which];
+            double left = which == 0 ? root - n(tc, 1, 3) - 0.5 : (roots[which - 1] + root) / 2.0 + (chance(tc, 50) ? 0.25 : 0);
+            double right = which == k - 1 ? root + n(tc, 1, 3) + 0.5 : (roots[which + 1] + root) / 2.0 - (chance(tc, 50) ? 0.25 : 0);
+            double acc = pick(tc, 1e-6, 1e-9, 1e-12);
+            int maxEval = 1000;
+            List<Object[]> bracketing = new ArrayList<>();
+            bracketing.add(new Object[] {"Bisection", new BisectionSolver(acc)});
+            bracketing.add(new Object[] {"Brent", new BrentSolver(acc)});
+            bracketing.add(new Object[] {"Ridders", new RiddersSolver(acc)});
+            bracketing.add(new Object[] {"Illinois", new IllinoisSolver(acc)});
+            bracketing.add(new Object[] {"Pegasus", new PegasusSolver(acc)});
+            bracketing.add(new Object[] {"RegulaFalsi", new RegulaFalsiSolver(acc)});
+            bracketing.add(new Object[] {"BracketingNthOrderBrent", new BracketingNthOrderBrentSolver(acc, 5)});
+            for (Object[] e : bracketing) {
+                String name = (String) e[0];
+                UnivariateSolver s = (UnivariateSolver) e[1];
+                double got;
+                try {
+                    got = s.solve(maxEval, p, left, right);
+                } catch (org.apache.commons.math4.legacy.exception.MathIllegalStateException ex) {
+                    if (name.equals("RegulaFalsi")) {
+                        count("regula falsi did not converge"); // documented: may converge very slowly or get stuck (ConvergenceException)
+                        continue;
+                    }
+                    fail(name + " did not converge on " + show(a) + " in [" + left + ", " + right + "]");
+                    continue;
+                }
+                double tol = Math.max(acc, s.getAbsoluteAccuracy()) * 10 + Math.abs(root) * s.getRelativeAccuracy() * 10;
+                if (!close(got, root, tol)) {
+                    // the function value accuracy also ends a search
+                    if (Math.abs(p.value(got)) <= s.getFunctionValueAccuracy() && close(got, root, 1e-3)) {
+                        count("stopped by the function value accuracy");
+                    } else {
+                        fail(name + " gives " + got + " for the root " + root + " of " + show(a) + " bracketed by [" + left + ", " + right + "], accuracy " + acc);
+                    }
+                }
+                if (got < left || got > right) {
+                    fail(name + " gives " + got + " outside the bracket [" + left + ", " + right + "]");
+                }
+                if (s.getEvaluations() > maxEval) {
+                    fail(name + " used " + s.getEvaluations() + " evaluations");
+                }
+            }
+            // side selection
+            List<Object[]> sided = new ArrayList<>();
+            sided.add(new Object[] {"Illinois", new IllinoisSolver(acc)});
+            sided.add(new Object[] {"Pegasus", new PegasusSolver(acc)});
+            sided.add(new Object[] {"BracketingNthOrderBrent", new BracketingNthOrderBrentSolver(acc, 5)});
+            AllowedSolution side = pick(tc, AllowedSolution.LEFT_SIDE, AllowedSolution.RIGHT_SIDE, AllowedSolution.BELOW_SIDE, AllowedSolution.ABOVE_SIDE, AllowedSolution.ANY_SIDE);
+            for (Object[] e : sided) {
+                String name = (String) e[0];
+                @SuppressWarnings("unchecked")
+                BracketedUnivariateSolver<UnivariateFunction> s = (BracketedUnivariateSolver<UnivariateFunction>) e[1];
+                double got;
+                try {
+                    got = s.solve(maxEval, p, left, right, side);
+                } catch (org.apache.commons.math4.legacy.exception.TooManyEvaluationsException ex) {
+                    fail(name + " with " + side + " did not converge on " + show(a) + " in [" + left + ", " + right + "]");
+                    continue;
+                }
+                double tol = acc * 10 + Math.abs(root) * 1e-13;
+                if (!close(got, root, tol) && !(Math.abs(p.value(got)) <= 1e-15 && close(got, root, 1e-3))) {
+                    fail(name + " with " + side + " gives " + got + " for the root " + root + " of " + show(a));
+                }
+                double fv = p.value(got);
+                // where the polynomial evaluates to rounding noise, the solver cannot tell the sides apart
+                boolean ok = Math.abs(fv) <= noise(a, got) || switch (side) {
+                    case LEFT_SIDE -> got <= root;
+                    case RIGHT_SIDE -> got >= root;
+                    case BELOW_SIDE -> fv <= 0;
+                    case ABOVE_SIDE -> fv >= 0;
+                    default -> true;
+                };
+                if (!ok) {
+                    fail(name + " with " + side + " gives " + got + " (f = " + fv + ") for the root " + root + " of " + show(a));
+                }
+            }
+            // open methods: any root of the polynomial will do
+            List<Object[]> open = new ArrayList<>();
+            open.add(new Object[] {"Secant", new SecantSolver(acc)});
+            open.add(new Object[] {"Muller", new MullerSolver(acc)});
+            open.add(new Object[] {"Muller2", new MullerSolver2(acc)});
+            for (Object[] e : open) {
+                String name = (String) e[0];
+                UnivariateSolver s = (UnivariateSolver) e[1];
+                double got;
+                try {
+                    got = s.solve(maxEval, p, left, right);
+                } catch (org.apache.commons.math4.legacy.exception.TooManyEvaluationsException ex) {
+                    count(name + " did not converge");
+                    continue;
+                } catch (org.apache.commons.math4.legacy.exception.NoBracketingException ex) {
+                    fail(name + " claims no bracketing for " + show(a) + " on [" + left + ", " + right + "] (f = " + p.value(left) + ", " + p.value(right) + ")");
+                    continue;
+                }
+                double best = Double.MAX_VALUE;
+                for (long rr : roots) {
+                    best = Math.min(best, Math.abs(got - rr));
+                }
+                if (best > acc * 100 && Math.abs(p.value(got)) > s.getFunctionValueAccuracy() * 100) {
+                    if (name.equals("Secant") && Known.SECANT_STOPS_ON_A_SMALL_STEP_FAR_FROM_A_ROOT) {
+                        count("secant stopped far from a root"); // commons-math/3
+                        continue;
+                    }
+                    fail(name + " gives " + got + " (f = " + p.value(got) + "), no root of " + show(a) + " is near (roots " + Arrays.toString(roots) + ")");
+                }
+            }
+            NewtonRaphsonSolver newton = new NewtonRaphsonSolver(acc);
+            double gotN = newton.solve(maxEval, p, left, right);
+            double bestN = Double.MAX_VALUE;
+            for (long rr : roots) {
+                bestN = Math.min(bestN, Math.abs(gotN - rr));
+            }
+            if (bestN > acc * 100 && Math.abs(p.value(gotN)) > 1e-9) {
+                fail("NewtonRaphson gives " + gotN + " (f = " + p.value(gotN) + ") for " + show(a) + " started in [" + left + ", " + right + "]");
+            }
+            // all roots at once
+            LaguerreSolver laguerre = new LaguerreSolver(acc);
+            Complex[] all = laguerre.solveAllComplex(toDoubles(a), n(tc, -10, 10));
+            if (all.length != k) {
+                fail("solveAllComplex finds " + all.length + " roots of " + show(a) + ", expected " + k);
+            } else {
+                double[] re = new double[k];
+                for (int i = 0; i < k; i++) {
+                    re[i] = all[i].getReal();
+                    if (Math.abs(all[i].getImaginary()) > 1e-6) {
+                        fail("solveAllComplex gives the complex root " + all[i] + " for " + show(a) + " with real roots " + Arrays.toString(roots));
+                    }
+                }
+                Arrays.sort(re);
+                for (int i = 0; i < k; i++) {
+                    if (!close(re[i], roots[i], 1e-6)) {
+                        fail("solveAllComplex roots " + Arrays.toString(re) + " vs " + Arrays.toString(roots) + " for " + show(a));
+                        break;
+                    }
+                }
+            }
+        }, Zoo.settings("analysis.solvers"));
+    }
+
+    // ------------------------------------------------------------------ 4. interpolators
+
+    /**
+     * Every univariate interpolator reproduces its samples at the knots; the linear one is the
+     * chord between knots; the spline is C2 with zero end curvature (natural spline); Akima and
+     * the spline agree with the data on the knot getters; Neville and divided differences agree
+     * with each other everywhere; Hermite reproduces values and prescribed derivatives.
+     */
+    @Test
+    void hegelInterpolatorsReproduceTheirSamples() {
+        Hegel.test(tc -> {
+            int m = n(tc, 5, 9);
+            double[] xs = new double[m];
+            double[] ys = new double[m];
+            double x = n(tc, -6, 0);
+            for (int i = 0; i < m; i++) {
+                x += chance(tc, 50) ? 1 : n(tc, 1, 3) / 2.0;
+                xs[i] = x;
+                ys[i] = n(tc, -9, 9);
+            }
+            double scale = 10;
+            PolynomialSplineFunction lin = new LinearInterpolator().interpolate(xs, ys);
+            PolynomialSplineFunction spl = new SplineInterpolator().interpolate(xs, ys);
+            PolynomialSplineFunction aki = new AkimaSplineInterpolator().interpolate(xs, ys);
+            PolynomialFunctionLagrangeForm nev = new NevilleInterpolator().interpolate(xs, ys);
+            PolynomialFunctionNewtonForm dd = new DividedDifferenceInterpolator().interpolate(xs, ys);
+            HermiteInterpolator herm = new HermiteInterpolator();
+            double[] slopes = new double[m];
+            for (int i = 0; i < m; i++) {
+                slopes[i] = n(tc, -3, 3);
+                herm.addSamplePoint(xs[i], new double[] {ys[i]}, new double[] {slopes[i]});
+            }
+            for (int i = 0; i < m; i++) {
+                double tol = 1e-9 * scale;
+                if (!close(lin.value(xs[i]), ys[i], tol)) {
+                    fail("linear interpolant at knot " + xs[i] + " gives " + lin.value(xs[i]) + ", sample " + ys[i]);
+                }
+                if (!close(spl.value(xs[i]), ys[i], tol)) {
+                    fail("spline at knot " + xs[i] + " gives " + spl.value(xs[i]) + ", sample " + ys[i] + " (xs " + Arrays.toString(xs) + ", ys " + Arrays.toString(ys) + ")");
+                }
+                if (!close(aki.value(xs[i]), ys[i], tol)) {
+                    fail("Akima spline at knot " + xs[i] + " gives " + aki.value(xs[i]) + ", sample " + ys[i]);
+                }
+                double polyTol = 1e-6 * Math.pow(m, 3) * scale;
+                if (!close(nev.value(xs[i]), ys[i], polyTol)) {
+                    fail("Neville at knot " + xs[i] + " gives " + nev.value(xs[i]) + ", sample " + ys[i] + " (xs " + Arrays.toString(xs) + ", ys " + Arrays.toString(ys) + ")");
+                }
+                if (!close(dd.value(xs[i]), ys[i], polyTol)) {
+                    fail("divided differences at knot " + xs[i] + " gives " + dd.value(xs[i]) + ", sample " + ys[i]);
+                }
+                double[] hv = herm.value(xs[i]);
+                if (!close(hv[0], ys[i], polyTol)) {
+                    fail("Hermite at knot " + xs[i] + " gives " + hv[0] + ", sample " + ys[i]);
+                }
+                DerivativeStructure hd = herm.value(new DerivativeStructure(1, 1, 0, xs[i]))[0];
+                if (!close(hd.getPartialDerivative(1), slopes[i], polyTol * 10)) {
+                    fail("Hermite slope at knot " + xs[i] + " is " + hd.getPartialDerivative(1) + ", prescribed " + slopes[i]);
+                }
+            }
+            // between knots
+            int seg = n(tc, 0, m - 2);
+            double t = n(tc, 1, 9) / 10.0;
+            double xm = xs[seg] + t * (xs[seg + 1] - xs[seg]);
+            double chord = ys[seg] + t * (ys[seg + 1] - ys[seg]);
+            if (!close(lin.value(xm), chord, 1e-9 * scale)) {
+                fail("linear interpolant at " + xm + " gives " + lin.value(xm) + ", chord " + chord);
+            }
+            if (!close(nev.value(xm), dd.value(xm), 1e-6 * Math.max(1, Math.abs(nev.value(xm)))) ) {
+                fail("Neville " + nev.value(xm) + " and divided differences " + dd.value(xm) + " differ at " + xm + " for xs " + Arrays.toString(xs) + ", ys " + Arrays.toString(ys));
+            }
+            // knots and pieces
+            if (!Arrays.equals(spl.getKnots(), xs) || spl.getN() != m - 1 || spl.getPolynomials().length != m - 1) {
+                fail("spline knots/pieces do not match the samples: knots " + Arrays.toString(spl.getKnots()) + ", n " + spl.getN());
+            }
+            if (spl.isValidPoint(xs[0] - 1) || !spl.isValidPoint(xm) || !spl.isValidPoint(xs[m - 1])) {
+                fail("isValidPoint wrong around " + Arrays.toString(xs));
+            }
+            // C2 continuity and natural end conditions of the cubic spline
+            PolynomialSplineFunction d1 = spl.polynomialSplineDerivative();
+            PolynomialSplineFunction d2 = d1.polynomialSplineDerivative();
+            PolynomialFunction[] pieces = spl.getPolynomials();
+            for (int i = 1; i < m - 1; i++) {
+                double h = xs[i] - xs[i - 1];
+                double leftV = pieces[i - 1].value(h);
+                double leftD = pieces[i - 1].polynomialDerivative().value(h);
+                double leftDD = pieces[i - 1].polynomialDerivative().polynomialDerivative().value(h);
+                double rightV = pieces[i].value(0);
+                double rightD = pieces[i].polynomialDerivative().value(0);
+                double rightDD = pieces[i].polynomialDerivative().polynomialDerivative().value(0);
+                if (!close(leftV, rightV, 1e-8 * scale) || !close(leftD, rightD, 1e-7 * scale) || !close(leftDD, rightDD, 1e-6 * scale)) {
+                    fail("spline is not C2 at knot " + xs[i] + ": " + leftV + "/" + rightV + ", " + leftD + "/" + rightD + ", " + leftDD + "/" + rightDD);
+                }
+            }
+            double endLeft = pieces[0].polynomialDerivative().polynomialDerivative().value(0);
+            double endRight = pieces[m - 2].polynomialDerivative().polynomialDerivative().value(xs[m - 1] - xs[m - 2]);
+            if (!close(endLeft, 0, 1e-7 * scale) || !close(endRight, 0, 1e-7 * scale)) {
+                fail("natural spline has end curvatures " + endLeft + " and " + endRight + " for xs " + Arrays.toString(xs) + ", ys " + Arrays.toString(ys));
+            }
+            if (!close(d2.value(xm), pieces[seg].polynomialDerivative().polynomialDerivative().value(xm - xs[seg]), 1e-8 * scale)) {
+                fail("polynomialSplineDerivative twice disagrees with the piece's second derivative at " + xm);
+            }
+            // the spline of a straight line is that line
+            double[] lineY = new double[m];
+            double slope = n(tc, -3, 3);
+            for (int i = 0; i < m; i++) {
+                lineY[i] = slope * xs[i] + 1;
+            }
+            PolynomialSplineFunction lineS = new SplineInterpolator().interpolate(xs, lineY);
+            PolynomialSplineFunction lineA = new AkimaSplineInterpolator().interpolate(xs, lineY);
+            if (!close(lineS.value(xm), slope * xm + 1, 1e-9 * scale) || !close(lineA.value(xm), slope * xm + 1, 1e-9 * scale)) {
+                fail("splines of the line " + slope + "x+1 give " + lineS.value(xm) + " and " + lineA.value(xm) + " at " + xm);
+            }
+        }, Zoo.settings("analysis.interpolation"));
+    }
+}
diff --git a/hegel/src/test/java/zoo/LinearTest.java b/hegel/src/test/java/zoo/LinearTest.java
