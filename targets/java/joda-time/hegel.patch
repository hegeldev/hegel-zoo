+    /** A step of up to 100 000 units (70%) or a quarter of the int range. */
+    static final Generator<Integer> TIME_STEP = weighted(w(70, ints(-100_000, 100_000)), w(30, ints(Integer.MIN_VALUE / 4, Integer.MAX_VALUE / 4)));
