+++ b/hegel/src/test/java/zoo/PeriodTest.java
@@ -0,0 +1,520 @@
+package zoo;
+
+import static dev.hegel.Generators.just;
+import static dev.hegel.Generators.lists;
+import static dev.hegel.Generators.sampledFrom;
+import static dev.hegel.Generators.tuples;
+import static zoo.Gen.chance;
+import static zoo.Gen.ints;
+import static zoo.Gen.maybe;
+import static zoo.Gen.w;
+import static zoo.Gen.weighted;
+import static zoo.Zoo.check;
+import static zoo.Zoo.show;
+
+import dev.hegel.Generator;
+import dev.hegel.Generators;
+import java.math.BigDecimal;
+import java.math.BigInteger;
+import java.math.RoundingMode;
+import java.util.List;
+import org.joda.time.Days;
+import org.joda.time.Duration;
+import org.joda.time.Hours;
+import org.joda.time.Interval;
+import org.joda.time.Minutes;
+import org.joda.time.Months;
+import org.joda.time.Period;
+import org.joda.time.PeriodType;
+import org.joda.time.Seconds;
+import org.joda.time.Weeks;
+import org.joda.time.Years;
+import org.joda.time.chrono.ISOChronology;
+import org.junit.jupiter.api.Test;
+
+/** Periods, durations, single-field periods and intervals against exact arithmetic and [start, end) models. */
+class PeriodTest {
+
+    static final long WEEK = 7 * Gen.DAY;
+    static final long MINUTE = 60_000L;
+
+    /** A period field: tiny (50%), moderate (30%), any int (10%) or an edge (10%). */
+    static final Generator<Integer> FIELD = weighted(
+            w(50, ints(-5, 5)),
+            w(30, ints(-100_000, 100_000)),
+            w(10, ints(Integer.MIN_VALUE, Integer.MAX_VALUE)),
+            w(10, sampledFrom(0, Integer.MIN_VALUE, Integer.MAX_VALUE, -1, 1)));
+
+    /** A standard period with eight independently drawn fields. */
+    static final Generator<Period> PERIOD = tuples(FIELD, FIELD, FIELD, FIELD, FIELD, FIELD, FIELD, FIELD)
+            .map(t -> new Period(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6(), t.value7(), t.value8()));
+
+    /** Whether seconds*1000+millis fits an int, i.e. the ISO printer (joda-time/7) prints the period faithfully. */
+    static boolean secondsFitAnInt(Period p) {
+        long combined = p.getSeconds() * 1000L + p.getMillis();
+        return combined == (int) combined;
+    }
+
+    static final Generator<PeriodType> PERIOD_TYPE = sampledFrom(
+            PeriodType.standard(), PeriodType.yearMonthDayTime(), PeriodType.yearWeekDayTime(), PeriodType.yearDayTime(), PeriodType.dayTime(), PeriodType.time());
+
+    static final Generator<Integer> MULTIPLIER = Generators.<Integer>oneOf(ints(-3, 3), ints(-1000, 1000), just(Integer.MIN_VALUE), just(Integer.MAX_VALUE));
+
+    record NormCase(Period p, PeriodType type, Period other, int k) {}
+
+    static final Generator<NormCase> NORM_CASE = tuples(PERIOD, PERIOD_TYPE, PERIOD, MULTIPLIER)
+            .map(t -> new NormCase(t.value1(), t.value2(), t.value3(), t.value4()));
+
+    /** The total millisecond duration of the day-and-below fields, exactly. */
+    static BigInteger dayMillis(Period p) {
+        return BigInteger.valueOf(p.getWeeks()).multiply(BigInteger.valueOf(WEEK))
+            .add(BigInteger.valueOf(p.getDays()).multiply(BigInteger.valueOf(Gen.DAY)))
+            .add(BigInteger.valueOf(p.getHours()).multiply(BigInteger.valueOf(Gen.HOUR)))
+            .add(BigInteger.valueOf(p.getMinutes()).multiply(BigInteger.valueOf(MINUTE)))
+            .add(BigInteger.valueOf(p.getSeconds()).multiply(BigInteger.valueOf(1000)))
+            .add(BigInteger.valueOf(p.getMillis()));
+    }
+
+    static boolean fitsLong(BigInteger b) {
+        return b.bitLength() < 64;
+    }
+
+    static boolean fitsInt(BigInteger b) {
+        return b.bitLength() < 32;
+    }
+
+    @Test
+    void periodNormalisationAndStandardConversionsAreExact() {
+        Zoo.property("periodNormalisationAndStandardConversionsAreExact", tc -> {
+            NormCase c = tc.draw(NORM_CASE, "case");
+            Period p = c.p();
+            String at = "period " + p;
+            BigInteger months = BigInteger.valueOf(p.getYears()).multiply(BigInteger.valueOf(12)).add(BigInteger.valueOf(p.getMonths()));
+            BigInteger ms = dayMillis(p);
+            // toStandardDuration and friends: exact or ArithmeticException; years/months refused unless zero
+            boolean ym = p.getYears() != 0 || p.getMonths() != 0;
+            Duration dur = null;
+            try {
+                dur = p.toStandardDuration();
+            } catch (UnsupportedOperationException e) {
+                check(ym, () -> at + ": toStandardDuration refused a period without years or months: " + e.getMessage());
+            } catch (ArithmeticException e) {
+                check(!ym && !fitsLong(ms), () -> at + ": toStandardDuration overflowed for a total of " + ms);
+            }
+            if (dur != null) {
+                Duration fd = dur;
+                check(!ym && fitsLong(ms) && fd.getMillis() == ms.longValueExact(), () -> at + ": toStandardDuration " + fd.getMillis() + " vs " + ms);
+            }
+            boolean mixedSigns = false;
+            int sgn = 0;
+            for (int v : new int[] {p.getWeeks(), p.getDays(), p.getHours(), p.getMinutes(), p.getSeconds(), p.getMillis()}) {
+                if (v != 0) {
+                    if (sgn != 0 && Integer.signum(v) != sgn) {
+                        mixedSigns = true;
+                    }
+                    sgn = Integer.signum(v);
+                }
+            }
+            for (String unit : new String[] {"weeks", "days", "hours", "minutes", "seconds"}) {
+                if (mixedSigns && Known.TO_STANDARD_UNITS_TRUNCATE_BEFORE_ADDING_THE_WHOLE_FIELD) {
+                    break;
+                }
+                long size = switch (unit) {
+                    case "weeks" -> WEEK;
+                    case "days" -> Gen.DAY;
+                    case "hours" -> Gen.HOUR;
+                    case "minutes" -> MINUTE;
+                    default -> 1000L;
+                };
+                BigInteger want = ms.divide(BigInteger.valueOf(size)); // truncation towards zero, as BigInteger does
+                Integer got = null;
+                String err = null;
+                try {
+                    got = switch (unit) {
+                        case "weeks" -> p.toStandardWeeks().getWeeks();
+                        case "days" -> p.toStandardDays().getDays();
+                        case "hours" -> p.toStandardHours().getHours();
+                        case "minutes" -> p.toStandardMinutes().getMinutes();
+                        default -> p.toStandardSeconds().getSeconds();
+                    };
+                } catch (UnsupportedOperationException e) {
+                    err = "UOE";
+                } catch (ArithmeticException e) {
+                    err = "AE";
+                }
+                Integer g = got;
+                String e = err;
+                if (ym) {
+                    check("UOE".equals(e), () -> at + ": toStandard" + unit + " with years/months gave " + (e != null ? e : g));
+                } else if (!fitsInt(want)) {
+                    check("AE".equals(e), () -> at + ": toStandard" + unit + " gave " + (e != null ? e : g) + " for " + want);
+                } else {
+                    check(g != null && g == want.intValueExact(), () -> at + ": toStandard" + unit + " gave " + (e != null ? e : g) + " vs " + want);
+                }
+            }
+            // normalisation: months into years, the day-and-below total redistributed, never crossing into months
+            PeriodType type = c.type();
+            Period norm = null;
+            String err = null;
+            try {
+                norm = p.normalizedStandard(type);
+            } catch (UnsupportedOperationException e) {
+                err = "UOE";
+            } catch (ArithmeticException e) {
+                err = "AE";
+            }
+            String ne = err;
+            // normalizedStandard refuses only a non-zero months total (P1Y-12M normalises to a day-time type)
+            boolean needsYears = months.signum() != 0 && !type.isSupported(org.joda.time.DurationFieldType.years()) && !type.isSupported(org.joda.time.DurationFieldType.months());
+            boolean needsMonthsOnly = ym && type.isSupported(org.joda.time.DurationFieldType.years()) && !type.isSupported(org.joda.time.DurationFieldType.months()) && months.mod(BigInteger.valueOf(12)).signum() != 0;
+            boolean splitOverflows = !fitsLong(ms);
+            if (!splitOverflows) {
+                long rem = ms.longValueExact();
+                long[] sizes = {WEEK, Gen.DAY, Gen.HOUR, MINUTE, 1000L, 1L};
+                org.joda.time.DurationFieldType[] types = {org.joda.time.DurationFieldType.weeks(), org.joda.time.DurationFieldType.days(), org.joda.time.DurationFieldType.hours(),
+                    org.joda.time.DurationFieldType.minutes(), org.joda.time.DurationFieldType.seconds(), org.joda.time.DurationFieldType.millis()};
+                for (int i = 0; i < sizes.length; i++) {
+                    if (type.isSupported(types[i])) {
+                        long v = rem / sizes[i];
+                        splitOverflows |= v != (int) v;
+                        rem -= v * sizes[i];
+                    }
+                }
+                splitOverflows |= ym && type.isSupported(org.joda.time.DurationFieldType.years()) && !fitsInt(months.divide(BigInteger.valueOf(12)));
+                splitOverflows |= ym && !type.isSupported(org.joda.time.DurationFieldType.years()) && type.isSupported(org.joda.time.DurationFieldType.months()) && !fitsInt(months);
+            }
+            if (splitOverflows) {
+                check("AE".equals(ne), () -> at + ": normalizedStandard(" + type + ") gave " + (ne != null ? ne : "a period") + " though a field overflows (total " + ms + " ms, months " + months + ")");
+            } else if (needsYears || needsMonthsOnly) {
+                check("UOE".equals(ne), () -> at + ": normalizedStandard(" + type + ") gave " + (ne != null ? ne : "a period") + " for months " + months);
+            } else if (norm != null) {
+                Period q = norm;
+                BigInteger qm = BigInteger.valueOf(q.getYears()).multiply(BigInteger.valueOf(12)).add(BigInteger.valueOf(q.getMonths()));
+                check(qm.equals(months), () -> at + ": normalizedStandard(" + type + ") = " + q + " changed the months total " + months + " to " + qm);
+                check(dayMillis(q).equals(ms), () -> at + ": normalizedStandard(" + type + ") = " + q + " changed the day-and-below total " + ms + " to " + dayMillis(q));
+                check(Math.abs(q.getMonths()) < 12 || !type.isSupported(org.joda.time.DurationFieldType.years()), () -> at + ": normalizedStandard(" + type + ") left " + q.getMonths() + " months");
+                check(q.getYears() == 0 || q.getMonths() == 0 || Integer.signum(q.getYears()) == Integer.signum(q.getMonths()), () -> at + ": normalizedStandard(" + type + ") = " + q + " mixes signs in years/months");
+                // the day-and-below fields are a greedy split of the total, all of one sign, each below the next unit's size
+                long rem = ms.longValueExact();
+                int sign = Long.signum(rem);
+                int[] vals = {q.getWeeks(), q.getDays(), q.getHours(), q.getMinutes(), q.getSeconds(), q.getMillis()};
+                long[] sizes = {WEEK, Gen.DAY, Gen.HOUR, MINUTE, 1000L, 1L};
+                org.joda.time.DurationFieldType[] types = {org.joda.time.DurationFieldType.weeks(), org.joda.time.DurationFieldType.days(), org.joda.time.DurationFieldType.hours(),
+                    org.joda.time.DurationFieldType.minutes(), org.joda.time.DurationFieldType.seconds(), org.joda.time.DurationFieldType.millis()};
+                for (int i = 0; i < vals.length; i++) {
+                    if (type.isSupported(types[i])) {
+                        long want = rem / sizes[i];
+                        int fi = i;
+                        check(vals[i] == want, () -> at + ": normalizedStandard(" + type + ") = " + q + ": " + types[fi] + " " + q.get(types[fi]) + " vs " + want);
+                        rem -= want * sizes[i];
+                    } else {
+                        int fi = i;
+                        check(vals[i] == 0, () -> at + ": normalizedStandard(" + type + ") = " + q + " has an unsupported " + types[fi]);
+                    }
+                }
+                check(q.getPeriodType().equals(type), () -> at + ": normalizedStandard(" + type + ") has type " + q.getPeriodType());
+                check(sign == 0 || dayMillis(q).signum() == sign, () -> at + ": normalizedStandard sign");
+            } else {
+                check(false, () -> at + ": normalizedStandard(" + type + ") threw " + ne + " for months " + months + ", total " + ms + " ms");
+            }
+            // plus/minus/negated/multipliedBy: field-wise with overflow checks
+            Period o = c.other();
+            Period sum = null;
+            try {
+                sum = p.plus(o);
+            } catch (ArithmeticException e) {
+                boolean overflow = false;
+                for (int fi = 0; fi < PeriodType.standard().size(); fi++) {
+                    org.joda.time.DurationFieldType t = PeriodType.standard().getFieldType(fi);
+                    long v = (long) p.get(t) + o.get(t);
+                    overflow |= v != (int) v;
+                }
+                boolean ov = overflow;
+                check(ov, () -> at + " plus " + o + ": ArithmeticException without an overflowing field");
+            }
+            if (sum != null) {
+                for (int fi = 0; fi < PeriodType.standard().size(); fi++) {
+                    org.joda.time.DurationFieldType t = PeriodType.standard().getFieldType(fi);
+                    long v = (long) p.get(t) + o.get(t);
+                    check(v == sum.get(t), () -> at + " plus " + o + ": " + t + " " + v);
+                }
+            }
+            int k = c.k();
+            Period mul = null;
+            try {
+                mul = p.multipliedBy(k);
+            } catch (ArithmeticException e) {
+                boolean overflow = false;
+                for (int fi = 0; fi < PeriodType.standard().size(); fi++) {
+                    org.joda.time.DurationFieldType t = PeriodType.standard().getFieldType(fi);
+                    long v = (long) p.get(t) * k;
+                    overflow |= v != (int) v;
+                }
+                boolean ov = overflow;
+                check(ov, () -> at + " multipliedBy(" + k + "): ArithmeticException without an overflowing field");
+            }
+            if (mul != null) {
+                for (int fi = 0; fi < PeriodType.standard().size(); fi++) {
+                    org.joda.time.DurationFieldType t = PeriodType.standard().getFieldType(fi);
+                    long v = (long) p.get(t) * k;
+                    check(v == mul.get(t), () -> at + " multipliedBy(" + k + "): " + t + " " + v);
+                }
+            }
+            // equality and text
+            Period same = new Period(p.getYears(), p.getMonths(), p.getWeeks(), p.getDays(), p.getHours(), p.getMinutes(), p.getSeconds(), p.getMillis());
+            check(p.equals(same) && p.hashCode() == same.hashCode(), () -> at + ": equals/hashCode of an identical period");
+            if (!Known.ISO_PERIOD_PRINTER_WRAPS_SECONDS || secondsFitAnInt(p)) {
+                Period parsed = Period.parse(p.toString());
+                check(parsed.getYears() == p.getYears() && parsed.getMonths() == p.getMonths() && parsed.getWeeks() == p.getWeeks() && parsed.getDays() == p.getDays()
+                    && parsed.getHours() == p.getHours() && parsed.getMinutes() == p.getMinutes()
+                    && parsed.getSeconds() * 1000L + parsed.getMillis() == p.getSeconds() * 1000L + p.getMillis(),
+                    () -> at + ": Period.parse(toString) " + show(p.toString()) + " -> " + parsed);
+            }
+        });
+    }
+
+    /** What is added to a duration: a billion milliseconds either way (50%) or any instant-sized value. */
+    static final Generator<Long> ADDEND = weighted(w(50, Gen.longs(-1_000_000_000L, 1_000_000_000L)), w(50, Gen.MILLIS));
+
+    static final Generator<Integer> SCALAR = Generators.<Integer>oneOf(ints(-3, 3), ints(-100_000, 100_000), just(Integer.MIN_VALUE), just(Integer.MAX_VALUE));
+
+    static final Generator<Long> DIVISOR = Generators.<Long>oneOf(
+            Gen.longs(-5, 5), Gen.longs(-100_000, 100_000), just(Long.MIN_VALUE), just(Long.MAX_VALUE), just(-1L), just(1L), just(0L));
+
+    static final Generator<RoundingMode> MODE = sampledFrom(
+            RoundingMode.UP, RoundingMode.DOWN, RoundingMode.CEILING, RoundingMode.FLOOR, RoundingMode.HALF_UP, RoundingMode.HALF_DOWN, RoundingMode.HALF_EVEN);
+
+    /** A single-field period's value. */
+    static final Generator<Integer> SINGLE = Generators.<Integer>oneOf(
+            ints(-5, 5), ints(-1_000_000, 1_000_000), just(Integer.MIN_VALUE), just(Integer.MAX_VALUE), just(Integer.MIN_VALUE + 1));
+
+    /** The other operand of a single-field period's arithmetic. */
+    static final Generator<Integer> OPERAND = Generators.<Integer>oneOf(
+            ints(-5, 5), ints(-1_000_000, 1_000_000), just(Integer.MIN_VALUE), just(Integer.MAX_VALUE), just(-1), just(1), just(2), just(0));
+
+    record DurationCase(long a, long b, int k, long div, RoundingMode mode, int x, int y) {}
+
+    static final Generator<DurationCase> DURATION_CASE = tuples(Gen.MILLIS, ADDEND, SCALAR, DIVISOR, MODE, SINGLE, OPERAND)
+            .map(t -> new DurationCase(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6(), t.value7()));
+
+    @Test
