+            // and java.time parses what Joda prints
+            check(java.time.OffsetDateTime.parse(dt.toString()).toInstant().toEpochMilli() == t, () -> at + ": java.time cannot read " + dt);
+            check(java.time.Instant.parse(dt.toInstant().toString()).toEpochMilli() == t, () -> at + ": java.time cannot read the Instant " + dt.toInstant());
+            // basic and no-millis variants round trip within Joda (the basic offset has no seconds)
+            if (z.joda().getOffset(t) % 60_000 == 0) {
+                check(ISODateTimeFormat.basicDateTime().withOffsetParsed().parseDateTime(ISODateTimeFormat.basicDateTime().print(dt)).getMillis() == t, () -> at + ": basicDateTime() round trip " + ISODateTimeFormat.basicDateTime().print(dt));
+            }
+            check(ISODateTimeFormat.dateTimeNoMillis().withOffsetParsed().parseDateTime(ISODateTimeFormat.dateTimeNoMillis().print(dt)).getMillis() == t - Math.floorMod(t, 1000), () -> at + ": dateTimeNoMillis() round trip " + ISODateTimeFormat.dateTimeNoMillis().print(dt));
+            check(ISODateTimeFormat.weekDateTime().withOffsetParsed().parseDateTime(ISODateTimeFormat.weekDateTime().print(dt)).getMillis() == t, () -> at + ": weekDateTime() round trip " + ISODateTimeFormat.weekDateTime().print(dt));
+            check(ISODateTimeFormat.ordinalDateTime().withOffsetParsed().parseDateTime(ISODateTimeFormat.ordinalDateTime().print(dt)).getMillis() == t, () -> at + ": ordinalDateTime() round trip " + ISODateTimeFormat.ordinalDateTime().print(dt));
+            // partials
+            LocalDate ld = dt.toLocalDate();
+            YearMonth ym = new YearMonth(ld.getYear(), ld.getMonthOfYear());
+            MonthDay md = new MonthDay(ld.getMonthOfYear(), ld.getDayOfMonth());
+            check(YearMonth.parse(ym.toString()).equals(ym) && ym.toString().equals(zdt.format(DateTimeFormatter.ofPattern("uuuu-MM"))), () -> at + ": YearMonth " + ym);
+            check(MonthDay.parse(md.toString()).equals(md) && md.toString().equals(zdt.format(DateTimeFormatter.ofPattern("--MM-dd"))), () -> at + ": MonthDay " + md);
+            check(ISODateTimeFormat.localDateOptionalTimeParser().parseLocalDateTime(ld.toString()).equals(ld.toLocalDateTime(LocalTime.MIDNIGHT)), () -> at + ": localDateOptionalTimeParser on a date");
+            check(ISODateTimeFormat.dateOptionalTimeParser().withOffsetParsed().parseDateTime(dt.toString()).getMillis() == t, () -> at + ": dateOptionalTimeParser on a full date-time");
+        });
+    }
+
+    /**
+     * A period whose ISO text is exact (while joda-time/7 stands, one whose seconds and millis combine within an int;
+     * the wrapped ones are left to the pin) and a duration in millis.
+     */
+    record PeriodFormatCase(Period p, long millis) {}
+
+    static final Generator<Period> PRINTABLE_PERIOD = PeriodTest.PERIOD.filter(p -> !Known.ISO_PERIOD_PRINTER_WRAPS_SECONDS || PeriodTest.secondsFitAnInt(p));
+
+    static final Generator<PeriodFormatCase> PERIOD_FORMAT_CASE = tuples(PRINTABLE_PERIOD, Gen.MILLIS).map(t -> new PeriodFormatCase(t.value1(), t.value2()));
+
+    @Test
+    void periodFormatsRoundTrip() {
+        Zoo.property("periodFormatsRoundTrip", tc -> {
+            PeriodFormatCase c = tc.draw(PERIOD_FORMAT_CASE, "case");
+            Period p = c.p();
+            String at = "period " + p;
+            String iso = ISOPeriodFormat.standard().print(p);
+            Period back = ISOPeriodFormat.standard().parsePeriod(iso);
+            check(sameButSeconds(p, back), () -> at + ": ISOPeriodFormat.standard " + show(iso) + " -> " + back);
+            check(iso.equals(p.toString()), () -> at + ": toString " + show(p.toString()) + " vs standard format " + show(iso));
+            String words = PeriodFormat.getDefault().print(p);
+            Period back2 = PeriodFormat.getDefault().parsePeriod(words);
+            check(sameButSeconds(p, back2), () -> at + ": PeriodFormat.getDefault " + show(words) + " -> " + back2);
+            String alt = ISOPeriodFormat.alternateExtended().print(p);
+            if (p.getYears() >= 0 && p.getMonths() >= 0 && p.getWeeks() == 0 && p.getDays() >= 0 && p.getHours() >= 0 && p.getMinutes() >= 0 && p.getSeconds() >= 0 && p.getMillis() >= 0
+                && p.getYears() <= 9999 && p.getMonths() <= 99 && p.getDays() <= 99 && p.getHours() <= 99 && p.getMinutes() <= 99 && p.getSeconds() <= 99 && p.getMillis() <= 999) {
+                Period back3 = ISOPeriodFormat.alternateExtended().parsePeriod(alt);
+                check(sameButSeconds(p, back3), () -> at + ": ISOPeriodFormat.alternateExtended " + show(alt) + " -> " + back3);
+            }
+            // a java.time Period of the same years/months/days is printed the same way when nothing else is set
+            if (p.getWeeks() == 0 && p.getHours() == 0 && p.getMinutes() == 0 && p.getSeconds() == 0 && p.getMillis() == 0 && !(p.getYears() == 0 && p.getMonths() == 0 && p.getDays() == 0)) {
+                String jp = java.time.Period.of(p.getYears(), p.getMonths(), p.getDays()).toString();
+                check(iso.equals(jp), () -> at + ": ISO text " + show(iso) + " vs java.time " + show(jp));
+            }
+            Duration d = new Duration(c.millis());
+            String js = java.time.Duration.ofMillis(d.getMillis()).toString();
+            if (js.matches("PT-?\\d+(\\.\\d+)?S")) {
+                // Joda's Duration.parse reads the PTn.nS form only (documented)
+                Duration fromJava = Duration.parse(js);
+                check(fromJava.equals(d), () -> "Duration.parse(" + show(js) + ") = " + fromJava + " vs " + d.getMillis());
+            }
+            check(java.time.Duration.parse(d.toString()).toMillis() == d.getMillis(), () -> "java.time cannot read Duration " + d);
+        });
+    }
+
+    static boolean sameButSeconds(Period a, Period b) {
+        return a.getYears() == b.getYears() && a.getMonths() == b.getMonths() && a.getWeeks() == b.getWeeks() && a.getDays() == b.getDays()
+            && a.getHours() == b.getHours() && a.getMinutes() == b.getMinutes() && a.getSeconds() * 1000L + a.getMillis() == b.getSeconds() * 1000L + b.getMillis();
+    }
+}
diff --git a/hegel/src/test/java/zoo/Gen.java b/hegel/src/test/java/zoo/Gen.java
new file mode 100644
index 0000000..057604e
--- /dev/null
+++ b/hegel/src/test/java/zoo/Gen.java
@@ -0,0 +1,184 @@
+package zoo;
+
+import static dev.hegel.Generators.integers;
+import static dev.hegel.Generators.just;
+import static dev.hegel.Generators.sampledFrom;
+import static dev.hegel.Generators.tuples;
+
+import dev.hegel.Generator;
+import dev.hegel.Generators;
+import java.time.ZoneId;
+import java.time.ZoneOffset;
+import java.time.zone.ZoneRules;
+import java.util.ArrayList;
+import java.util.List;
+import org.joda.time.DateTimeZone;
+
+/**
+ * The combinators the binding lacks (weighted choice, a biased coin, an optional with a probability, int and long
+ * ranges) and the generators shared by the Joda-Time properties: zones, instants, epoch days and years.
+ */
+final class Gen {
+    private Gen() {}
+
+    // ---- combinators -------------------------------------------------------------------------------------------
+
+    /** A weighted alternative for {@link #weighted}. */
+    record Choice<T>(int weight, Generator<T> gen) {}
+
+    static <T> Choice<T> w(int weight, Generator<T> gen) {
+        return new Choice<>(weight, gen);
+    }
+
+    /** One of the generators, chosen in proportion to the weights; one draw, shrinks towards the first. */
+    @SafeVarargs
+    static <T> Generator<T> weighted(Choice<T>... choices) {
+        return weighted(List.of(choices));
+    }
+
+    static <T> Generator<T> weighted(List<Choice<T>> choices) {
+        int total = 0;
+        for (Choice<T> c : choices) {
+            total += c.weight();
+        }
+        return integers().min(0).max(total - 1).flatMap(i -> {
+            int acc = 0;
+            for (Choice<T> c : choices) {
+                acc += c.weight();
+                if (i < acc) {
+                    return c.gen();
+                }
+            }
+            throw new IllegalStateException("weighted: " + i + " beyond " + acc);
+        });
+    }
+
+    /** True with probability pct/100; shrinks to false. */
+    static Generator<Boolean> chance(int pct) {
+        return integers().min(0).max(99).map(x -> x >= 100 - pct);
+    }
+
+    /** {@code absent} (weight 100 - pct), or a value of {@code present} (weight pct); shrinks to absent. */
+    static <T> Generator<T> maybe(int pct, T absent, Generator<T> present) {
+        return weighted(w(100 - pct, just(absent)), w(pct, present));
+    }
+
+    /** An int in [lo, hi]; shrinks to lo. */
+    static Generator<Integer> ints(int lo, int hi) {
+        return integers().min(lo).max(hi);
+    }
+
+    /** A long in [lo, hi]; shrinks to lo. */
+    static Generator<Long> longs(long lo, long hi) {
+        return Generators.longs().min(lo).max(hi);
+    }
+
+    // ---- the domain --------------------------------------------------------------------------------------------
+
+    static final long DAY = 86_400_000L;
+    static final long HOUR = 3_600_000L;
+
+    /** 1900-01-01T00:00Z and 2038-01-01T00:00Z: the range over which the zone tables below were checked to agree. */
+    static final long ZONE_LO = -2_208_988_800_000L;
+    static final long ZONE_HI = 2_145_916_800_000L;
+
+    /**
+     * Region zones whose offsets and transitions agree between Joda's 2026d tables and the JDK's 2026b tables over
+     * 1900..2037 (checked once for every id both know; these were picked from the 263 that agree for their shapes:
+     * negative DST, half- and quarter-hour offsets, southern-hemisphere DST, date-line jumps, offsets past +12).
+     */
+    static final String[] REGION_ZONES = {
+        "Europe/Berlin", "Europe/Dublin", "Europe/Athens", "Europe/Madrid", "Europe/Kyiv", "Europe/Zurich",
+        "Europe/Chisinau", "Europe/Gibraltar", "Africa/Cairo", "Africa/Johannesburg", "Africa/Juba",
+        "Africa/Monrovia", "America/Sao_Paulo", "America/Santiago", "America/Havana", "America/Mexico_City",
+        "America/Phoenix", "America/Caracas", "America/Nuuk", "America/Miquelon", "America/Santo_Domingo",
+        "America/Guyana", "America/Port-au-Prince", "Asia/Kolkata", "Asia/Kathmandu", "Asia/Tokyo",
+        "Asia/Shanghai", "Asia/Jerusalem", "Asia/Beirut", "Asia/Dubai", "Asia/Kabul", "Asia/Yangon",
+        "Asia/Hong_Kong", "Asia/Colombo", "Asia/Ulaanbaatar", "Australia/Sydney", "Australia/Adelaide",
+        "Australia/Lord_Howe", "Australia/Eucla", "Australia/Brisbane", "Australia/Hobart", "Pacific/Chatham",
+        "Pacific/Apia", "Pacific/Kiritimati", "Pacific/Tongatapu", "Pacific/Norfolk", "Pacific/Fiji",
+        "Pacific/Kwajalein", "Antarctica/Casey", "Antarctica/Macquarie", "Atlantic/Canary", "Indian/Mauritius",
+        "Etc/GMT+12", "Etc/GMT-14", "UTC", "CET", "EET", "MET",
+    };
+
+    static final List<String> ALL_ZONES = new ArrayList<>(DateTimeZone.getAvailableIDs());
+
+    /** A zone whose tables agree with the JDK's, with its JDK twin. */
+    record Zone(DateTimeZone joda, ZoneRules jdk, String id, ZoneId jid) {
+        @Override
+        public String toString() {
+            return id;
+        }
+    }
+
+    static Zone region(String id) {
+        return new Zone(DateTimeZone.forID(id), ZoneId.of(id).getRules(), id, ZoneId.of(id));
+    }
+
+    static Zone fixed(int offsetMillis) {
+        DateTimeZone z = DateTimeZone.forOffsetMillis(offsetMillis);
+        ZoneOffset o = ZoneOffset.ofTotalSeconds(offsetMillis / 1000);
+        return new Zone(z, o.getRules(), z.getID(), o);
+    }
+
+    /** A fixed offset in whole seconds between -12:00 and +14:00, or (30%) in whole minutes between -18:00 and +18:00. */
+    static final Generator<Integer> FIXED_OFFSET_MILLIS = weighted(
+            w(70, ints(-12 * 3600, 14 * 3600).map(s -> s * 1000)),
+            w(30, ints(-18 * 60, 18 * 60).map(m -> m * 60_000)));
+
+    /** A zone whose tables agree with the JDK's: a fixed offset (10%) or a region zone. */
+    static final Generator<Zone> AGREED_ZONE = weighted(
+            w(10, FIXED_OFFSET_MILLIS.map(Gen::fixed)),
+            w(90, sampledFrom(REGION_ZONES).map(Gen::region)));
+
+    /** Any zone Joda knows (no JDK twin needed): a fixed offset in whole seconds (8%) or one of the available ids. */
+    static final Generator<DateTimeZone> ANY_ZONE = weighted(
+            w(8, ints(-12 * 3600, 14 * 3600).map(s -> DateTimeZone.forOffsetMillis(s * 1000))),
+            w(92, sampledFrom(ALL_ZONES).map(DateTimeZone::forID)));
+
+    /**
+     * An instant in 1900..2037 as drawn (50%), or moved to within three hours (35%) or two milliseconds (15%) of
+     * the zone's next transition after it; left where it was when no transition follows before 2038.
+     */
+    static Generator<Long> zoneInstant(DateTimeZone z) {
+        return tuples(longs(ZONE_LO, ZONE_HI - 1), maybe(50, (Long) null, weighted(w(70, longs(-3 * HOUR, 3 * HOUR)), w(30, longs(-2, 2)))))
+                .map(t -> nearTransition(z, t.value1(), t.value2()));
+    }
+
+    static long nearTransition(DateTimeZone z, long t, Long nudge) {
+        if (nudge == null) {
+            return t;
+        }
+        long nt = z.nextTransition(t);
+        return nt != t && nt < ZONE_HI ? nt + nudge : t;
+    }
+
+    /** The first and last days of years 0 and 1 (ISO), 1970 and the maximum ISO year, and the GJ cutover. */
+    static final List<Long> EPOCH_DAY_EDGES = List.of(-719_528L, -719_529L, -719_162L, -719_163L, 0L, -1L, 2_932_896L, 2_932_897L, -678_941L);
+
+    /** An epoch day: within a few centuries of 1970 (70%), tens of millennia away (20%), enormous (7%) or at an edge (3%). */
+    static final Generator<Long> EPOCH_DAY = weighted(
+            w(70, longs(-150_000, 150_000)),
+            w(20, longs(-4_000_000, 4_000_000)),
+            w(7, longs(-100_000_000L, 100_000_000L)),
+            w(3, sampledFrom(EPOCH_DAY_EDGES)));
+
+    /** An ISO year: 1800..2100 (60%), -999..9999 (30%) or a notable year (10%). */
+    static final Generator<Integer> YEAR = weighted(
+            w(60, ints(1800, 2100)),
+            w(30, ints(-999, 9999)),
+            w(10, sampledFrom(0, 1, -1, 4, 100, 400, 1582, 1583, 1600, 1900, 2000, 2100, 9999, -9999, 1970, 1969)));
+
+    /** An instant in millis: 1900..2037 (60%), within 100 000 days of 1970 (25%), within three billion days (12%), or an extreme (3%). */
+    static final Generator<Long> MILLIS = weighted(
+            w(60, longs(ZONE_LO, ZONE_HI)),
+            w(25, longs(-100_000L * DAY, 100_000L * DAY)),
+            w(12, longs(-3_000_000_000L * DAY / 1000, 3_000_000_000L * DAY / 1000)),
+            w(3, sampledFrom(0L, -1L, 1L, Long.MIN_VALUE, Long.MAX_VALUE, Long.MIN_VALUE + 1, Long.MAX_VALUE - 1,
+                    -62_135_596_800_000L, 253_402_300_799_999L, -12_219_292_800_000L)));
+
+    /** A millisecond of the day, or (10%) one of its edges. */
+    static final Generator<Integer> MILLIS_OF_DAY = weighted(
+            w(90, ints(0, 86_399_999)),
+            w(10, sampledFrom(0, 1, 86_399_999, 43_200_000, 3_600_000, 3_599_999)));
+}
