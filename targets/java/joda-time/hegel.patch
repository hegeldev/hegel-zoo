+            check(parsed.getMillis() == t && parsed.getZone().getOffset(t) == z.joda().getOffset(t), () -> at + ": DateTime.parse(toString) " + parsed + " (" + parsed.getMillis() + ")");
+            check(dt.withZone(DateTimeZone.UTC).getMillis() == t && dt.toInstant().getMillis() == t, () -> at + ": withZone(UTC) changes the instant");
+            check(z.joda().isStandardOffset(t) == !z.jdk().isDaylightSavings(java.time.Instant.ofEpochMilli(t)), () -> at + ": isStandardOffset " + z.joda().isStandardOffset(t));
+            check(z.joda().getStandardOffset(t) == z.jdk().getStandardOffset(java.time.Instant.ofEpochMilli(t)).getTotalSeconds() * 1000, () -> at + ": standard offset " + z.joda().getStandardOffset(t));
+            // transitions
+            long nt = z.joda().nextTransition(t);
+            java.time.zone.ZoneOffsetTransition jnt = z.jdk().nextTransition(java.time.Instant.ofEpochMilli(t));
+            if (jnt != null && jnt.getInstant().toEpochMilli() < Gen.ZONE_HI) {
