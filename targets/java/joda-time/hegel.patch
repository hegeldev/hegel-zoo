+    interface LongOp {
+        long run();
+    }
+
+    interface IntOp {
+        int run();
+    }
+
+    static void checkLong(String at, BigInteger want, LongOp op) {
+        try {
+            long got = op.run();
+            check(fitsLong(want) && want.longValueExact() == got, () -> at + " = " + got + " vs " + want);
+        } catch (ArithmeticException e) {
+            check(!fitsLong(want), () -> at + " threw ArithmeticException for " + want);
+        }
+    }
+
+    static void checkInt(String at, long want, IntOp op) {
+        try {
+            int got = op.run();
+            check(want == (int) want && want == got, () -> at + " = " + got + " vs " + want);
+        } catch (ArithmeticException e) {
+            check(want != (int) want, () -> at + " threw ArithmeticException for " + want);
+        }
+    }
+
+    /** Which end of the first interval the second one is snapped to. */
+    enum End { START, END }
+
+    /** Where the probe instant sits relative to the first interval. */
+    enum Probe { START, END, BEFORE_START, BEFORE_END, AFTER_END, NEAR_BASE }
+
+    /** The instant the interval end points cluster around: 1900..2037 (80%) or a quarter of any instant. */
+    static final Generator<Long> BASE = weighted(w(80, Gen.longs(Gen.ZONE_LO, Gen.ZONE_HI)), w(20, Gen.MILLIS.map(t -> t / 4)));
+
+    /** An end point's distance from the base: a few milliseconds (30%) or up to ten days either way. */
+    static final Generator<Long> OFFSET = weighted(w(30, Gen.longs(-3, 3)), w(70, Gen.longs(-10 * Gen.DAY, 10 * Gen.DAY)));
+
+    record IntervalCase(long base, List<Long> offsets, boolean empty, End snapStart, End snapEnd, Probe probe, int nearBase) {}
+
+    static final Generator<IntervalCase> INTERVAL_CASE = tuples(
+            BASE, lists(OFFSET).minSize(4).maxSize(4), chance(20),
+            maybe(20, (End) null, sampledFrom(End.values())), maybe(20, (End) null, sampledFrom(End.values())),
+            sampledFrom(Probe.values()), ints(-1000, 1000))
+            .map(t -> new IntervalCase(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6(), t.value7()));
+
+    @Test
+    void intervalsFollowTheHalfOpenModel() {
+        Zoo.property("intervalsFollowTheHalfOpenModel", tc -> {
+            IntervalCase c = tc.draw(INTERVAL_CASE, "case");
+            long base = c.base();
+            long[] pts = new long[4];
+            for (int i = 0; i < 4; i++) {
+                pts[i] = base + c.offsets().get(i);
+            }
+            long s1 = Math.min(pts[0], pts[1]);
+            long ee1 = Math.max(pts[0], pts[1]);
+            long ss2 = Math.min(pts[2], pts[3]);
+            long ee2 = Math.max(pts[2], pts[3]);
+            if (c.empty()) {
+                ee1 = s1;
+            }
+            if (c.snapStart() != null) {
+                ss2 = c.snapStart() == End.START ? s1 : ee1;
+                ee2 = Math.max(ss2, ee2);
+            }
+            if (c.snapEnd() != null) {
+                ee2 = c.snapEnd() == End.START ? s1 : ee1;
+                ss2 = Math.min(ss2, ee2);
+            }
+            final long e1 = ee1;
+            final long s2 = ss2;
+            final long e2 = ee2;
+            Interval a = new Interval(s1, e1);
+            Interval b = new Interval(s2, e2);
+            String at = "[" + s1 + ", " + e1 + ") vs [" + s2 + ", " + e2 + ")";
+            long t = switch (c.probe()) {
+                case START -> s1;
+                case END -> e1;
+                case BEFORE_START -> s1 - 1;
+                case BEFORE_END -> e1 - 1;
+                case AFTER_END -> e1 + 1;
+                case NEAR_BASE -> base + c.nearBase();
+            };
+            check(a.contains(t) == (s1 <= t && t < e1), () -> at + ": contains(" + t + ") " + a.contains(t));
+            check(a.isBefore(t) == (e1 <= t) && a.isAfter(t) == (t < s1), () -> at + ": isBefore/isAfter(" + t + ") " + a.isBefore(t) + "/" + a.isAfter(t));
+            boolean abuts = e2 == s1 || e1 == s2;
+            boolean overlaps = s1 < e2 && s2 < e1;
+            check(a.abuts(b) == abuts, () -> at + ": abuts " + a.abuts(b));
+            check(a.overlaps(b) == overlaps, () -> at + ": overlaps " + a.overlaps(b));
+            check(a.contains(b) == (s1 <= s2 && s2 < e1 && e2 <= e1), () -> at + ": contains(interval) " + a.contains(b));
+            check(a.isBefore(b) == (e1 <= s2) && a.isAfter(b) == (e2 <= s1), () -> at + ": isBefore/isAfter(interval) " + a.isBefore(b) + "/" + a.isAfter(b));
+            Interval ov = a.overlap(b);
+            if (overlaps) {
+                check(ov != null && ov.getStartMillis() == Math.max(s1, s2) && ov.getEndMillis() == Math.min(e1, e2), () -> at + ": overlap " + ov);
+            } else {
+                check(ov == null, () -> at + ": overlap of non-overlapping intervals " + ov);
+            }
+            Interval gap = a.gap(b);
+            if (!overlaps && !abuts) {
+                long gs = Math.min(e1, e2);
+                long ge = Math.max(s1, s2);
+                check(gap != null && gap.getStartMillis() == gs && gap.getEndMillis() == ge, () -> at + ": gap " + gap + " vs [" + gs + ", " + ge + ")");
+            } else {
+                check(gap == null, () -> at + ": gap of overlapping or abutting intervals " + gap);
+            }
+            check(a.toDurationMillis() == e1 - s1 && a.toDuration().getMillis() == e1 - s1, () -> at + ": toDurationMillis " + a.toDurationMillis());
+            check(a.equals(new Interval(s1, e1)) && a.hashCode() == new Interval(s1, e1).hashCode() && a.equals(b) == (s1 == s2 && e1 == e2), () -> at + ": equals");
+            check(a.withStartMillis(s2 <= e1 ? s2 : s1).getStartMillis() == (s2 <= e1 ? s2 : s1), () -> at + ": withStartMillis");
+            check(Zoo.throwsA(IllegalArgumentException.class, () -> new Interval(e1 + 1, e1)), () -> at + ": an interval ending before it starts was accepted");
+            check(a.withDurationAfterStart(new Duration(e2 - s2)).getEndMillis() == s1 + (e2 - s2), () -> at + ": withDurationAfterStart");
+            check(a.withDurationBeforeEnd(new Duration(e2 - s2)).getStartMillis() == e1 - (e2 - s2), () -> at + ": withDurationBeforeEnd");
+            check(Days.daysIn(a).getDays() == (e1 - s1) / Gen.DAY && Hours.hoursIn(a).getHours() == (e1 - s1) / Gen.HOUR, () -> at + ": daysIn/hoursIn " + Days.daysIn(a).getDays());
+            if (Math.abs(s1) < 100_000L * Gen.DAY && Math.abs(e1) < 100_000L * Gen.DAY) {
+                Interval parsed = Interval.parse(a.toString());
+                check(parsed.getStartMillis() == s1 && parsed.getEndMillis() == e1, () -> at + ": Interval.parse(toString) " + show(a.toString()) + " -> " + parsed);
+                Period p = a.toPeriod();
+                check(a.getStart().plus(p).getMillis() == e1, () -> at + ": toPeriod " + p + " added to the start gives " + a.getStart().plus(p).getMillis());
+                Period pd = a.toPeriod(PeriodType.days());
+                check(pd.getDays() == (e1 - s1) / Gen.DAY, () -> at + ": toPeriod(days) " + pd);
+                check(a.getChronology().equals(ISOChronology.getInstanceUTC()), () -> at + ": chronology " + a.getChronology());
+            }
+        });
+    }
+}
