+    static final java.time.format.DateTimeFormatter ISO_MILLIS = java.time.format.DateTimeFormatter.ofPattern("uuuu-MM-dd'T'HH:mm:ss.SSSXXXXX");
+
+    /** A step of the zoned arithmetic: within three units, four hundred, or twenty thousand. */
+    static final Generator<Integer> ZONE_STEP = Generators.<Integer>oneOf(ints(-3, 3), ints(-400, 400), ints(-20000, 20000));
+
+    /** The zone, an instant in it, the minutes by which the local time is moved for the gap/overlap checks, and the step and operation of the arithmetic. */
+    record ZonedCase(Gen.Zone z, long t, int minutes, int k, String op) {}
+
+    static final Generator<ZonedCase> ZONED_CASE = Gen.AGREED_ZONE.flatMap(z -> tuples(
+            Gen.zoneInstant(z.joda()), ints(-180, 180), ZONE_STEP, sampledFrom("plusDays", "plusMonths", "plusYears", "plusWeeks", "plusHours", "plusMinutes"))
+        .map(t -> new ZonedCase(z, t.value1(), t.value2(), t.value3(), t.value4())));
+
+    @Test
+    void zonedDateTimesAgreeWithJavaTime() {
