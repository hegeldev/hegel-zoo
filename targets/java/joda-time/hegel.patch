+    /** {@link Gen#MILLIS} folded into the 100 000 000 days either side of 1970 that java.time's LocalDateTime covers. */
+    static final Generator<Long> LOCAL_MILLIS = Gen.MILLIS.map(ms ->
+            ms < -100_000_000L * Gen.DAY || ms > 100_000_000L * Gen.DAY ? Math.floorMod(ms, 4_000_000L * Gen.DAY) - 2_000_000L * Gen.DAY : ms);
