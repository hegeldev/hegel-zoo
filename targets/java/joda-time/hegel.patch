+
+import dev.hegel.Generator;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import org.joda.time.DateTimeZone;
+import org.joda.time.IllegalInstantException;
+import org.joda.time.LocalDateTime;
+import org.junit.jupiter.api.Test;
+
+/** DateTimeZone laws that need no oracle: transitions, local/UTC conversions, fixed offsets. */
+class ZoneTest {
+
+    static String ofs(DateTimeZone z, long t) {
+        return z.getOffset(t) + "/" + z.getStandardOffset(t) + "/" + z.getNameKey(t);
+    }
+
+    /** {@code r} folded into [lo, hi) (hi > lo; modular arithmetic, so the range may straddle the long extremes). */
+    static long within(long lo, long hi, long r) {
+        return lo + Long.remainderUnsigned(r, hi - lo);
+    }
+
+    /** Three years: the stretch before Long.MAX_VALUE where a DST tail rule's recurrences can no longer be computed. */
+    static final long LAST_YEARS = 3 * 366 * Gen.DAY;
+
+    /** Whether the zone keeps changing after 2038, i.e. has a DST tail rule rather than a final precalculated offset. */
+    static boolean hasTailRule(DateTimeZone z) {
+        return z.nextTransition(Gen.ZONE_HI) != Gen.ZONE_HI;
+    }
+
+    /** A zone, an instant (near one of its transitions or anywhere), and the raw positions of two probes folded into live ranges. */
+    record ZoneCase(DateTimeZone z, long t, long beforeNext, long afterPrevious) {}
+
+    static final Generator<ZoneCase> ZONE_CASE = Gen.ANY_ZONE.flatMap(z -> tuples(
+            weighted(w(80, Gen.zoneInstant(z)), w(20, Gen.MILLIS)),
+            Gen.longs(0, Long.MAX_VALUE), Gen.longs(0, Long.MAX_VALUE))
+            .map(t -> new ZoneCase(z, t.value1(), t.value2(), t.value3())));
+
+    @Test
+    void transitionsAndOffsetsAreConsistent() {
+        Zoo.property("transitionsAndOffsetsAreConsistent", tc -> {
+            ZoneCase c = tc.draw(ZONE_CASE, "case");
+            DateTimeZone z = c.z();
+            long t = c.t();
+            tc.assume(!(Known.NEXT_TRANSITION_AT_THE_LONG_EXTREME_GOES_BACKWARDS && t >= Long.MAX_VALUE - 1 && z.nextTransition(t) < t));
+            tc.assume(!(Known.PREVIOUS_TRANSITION_AT_LONG_MAX_WRAPS && t == Long.MAX_VALUE && z.previousTransition(t) != z.previousTransition(t - 1)));
+            tc.assume(!(Known.TAIL_RULE_OFFSETS_ARE_WRONG_IN_THE_LAST_YEARS_BEFORE_LONG_MAX && t > Long.MAX_VALUE - LAST_YEARS && hasTailRule(z)));
+            String at = z.getID() + " @ " + t;
+            long nt = z.nextTransition(t);
+            check(nt >= t, () -> at + ": nextTransition went backwards to " + nt);
+            long pt = z.previousTransition(t);
+            check(pt <= t, () -> at + ": previousTransition went forwards to " + pt);
+            if (nt != t) {
+                check(!ofs(z, nt).equals(ofs(z, t)), () -> at + ": nothing changes at nextTransition " + nt + ": " + ofs(z, t));
+                long u = within(t, nt, c.beforeNext());
+                check(ofs(z, u).equals(ofs(z, t)), () -> at + ": offset/name changed at " + u + " before nextTransition " + nt + ": " + ofs(z, u) + " vs " + ofs(z, t));
+                check(z.nextTransition(u) == nt, () -> at + ": nextTransition(" + u + ") = " + z.nextTransition(u) + " but nextTransition(" + t + ") = " + nt);
+                long back = z.previousTransition(nt);
+                // t - 1 wraps at Long.MIN_VALUE, where every instant is "from the start"
+                boolean fromStart = t == Long.MIN_VALUE || back >= t - 1;
+                boolean atStart = t != Long.MIN_VALUE && back == t - 1;
+                check(back < nt && fromStart && z.nextTransition(back) == nt || atStart && z.nextTransition(back + 1) == nt,
+                    () -> at + ": previousTransition(nextTransition) = " + back);
+                check(!z.isFixed(), () -> at + ": fixed zone with a transition");
+            }
+            if (pt != t) {
+                long u = within(pt + 1, t + 1, c.afterPrevious());
+                check(ofs(z, u).equals(ofs(z, t)), () -> at + ": offset/name changed at " + u + " after previousTransition " + pt + ": " + ofs(z, u) + " vs " + ofs(z, t));
+                check(!ofs(z, pt).equals(ofs(z, pt + 1)), () -> at + ": nothing changes right after previousTransition " + pt + ": " + ofs(z, pt));
+            }
+            check(z.isStandardOffset(t) == (z.getOffset(t) == z.getStandardOffset(t)), () -> at + ": isStandardOffset " + z.isStandardOffset(t) + " with " + ofs(z, t));
+            check(z.isFixed() == (z.nextTransition(t) == t && z.previousTransition(t) == t) || !z.isFixed(), () -> at + ": fixed zone reports a transition");
+            // local conversions (documented to overflow at the long extremes)
+            tc.assume(t >= -Long.MAX_VALUE / 2 && t <= Long.MAX_VALUE / 2);
+            int off = z.getOffset(t);
+            long local = z.convertUTCToLocal(t);
+            check(local == t + off, () -> at + ": convertUTCToLocal " + local + " vs " + (t + off));
+            long backLenient = z.convertLocalToUTC(local, false);
+            check(backLenient + z.getOffset(backLenient) == local, () -> at + ": convertLocalToUTC(lenient) " + backLenient + " has offset " + z.getOffset(backLenient) + ", local " + local);
+            long backStrict = z.convertLocalToUTC(local, true);
+            check(backStrict == backLenient, () -> at + ": strict and lenient conversions differ for an existing local time: " + backStrict + " vs " + backLenient);
+            long preferred = z.convertLocalToUTC(local, true, t);
+            check(preferred == t, () -> at + ": convertLocalToUTC(local, strict, original=" + t + ") = " + preferred);
+            int fromLocal = z.getOffsetFromLocal(local);
+            long viaField = local - fromLocal;
+            check(viaField + z.getOffset(viaField) == local, () -> at + ": getOffsetFromLocal " + fromLocal + " gives " + viaField + " whose offset is " + z.getOffset(viaField));
+            if (!Known.CONVERT_LOCAL_TO_UTC_OVERLAP_DEPENDS_ON_HEMISPHERE) {
+                check(viaField == backLenient, () -> at + ": getOffsetFromLocal " + fromLocal + " disagrees with convertLocalToUTC " + backLenient);
+            }
+            // an overlap that crosses the date line westwards (Pacific/Kwajalein 1969) is resolved to the later instant
+            tc.assume(!(Known.OVERLAP_INTO_A_NEGATIVE_OFFSET_RESOLVES_TO_THE_LATER_INSTANT && viaField != t && z.getOffset(t) > 0 && z.getOffset(viaField) < 0));
+            if (viaField != t) {
+                // an overlap: getOffsetFromLocal picks the offset before the transition, i.e. the earlier instant
+                check(viaField < t, () -> at + ": overlap resolved to the later instant " + viaField + " by getOffsetFromLocal");
+                if (t - viaField <= 3 * Gen.HOUR) {
+                    // adjustOffset looks three hours either side ("non-pathological cases"); longer historical overlaps are outside its design
+                    check(z.adjustOffset(viaField, true) == t && z.adjustOffset(t, false) == viaField, () -> at + ": adjustOffset does not flip between " + viaField + " and " + t);
+                }
+                check(z.convertLocalToUTC(local, false, viaField) == viaField && z.convertLocalToUTC(local, false, t) == t, () -> at + ": convertLocalToUTC with an original instant does not keep it");
+            }
+            check(!z.isLocalDateTimeGap(new LocalDateTime(local, DateTimeZone.UTC)), () -> at + ": an existing local time is reported as a gap");
+            // names
+            check(z.getName(t) != null && z.getShortName(t) != null, () -> at + ": null name");
+            check(DateTimeZone.forID(z.getID()).equals(z) && DateTimeZone.forID(z.getID()).hashCode() == z.hashCode(), () -> at + ": forID(getID()) differs");
+            check(z.toTimeZone().getOffset(t) == off || !z.getID().matches("[+-].*"), () -> at + ": toTimeZone offset " + z.toTimeZone().getOffset(t) + " vs " + off);
+        });
+    }
+
+    /** A transition at {@code at} where the offset grows from {@code before} to {@code after}: local times in between do not exist. */
+    record Gap(long at, int before, int after) {}
+
+    /** Every gap of every zone Joda knows between 1900 and 2038, walked once via nextTransition. */
+    static Map<String, List<Gap>> gaps() {
+        Map<String, List<Gap>> m = new LinkedHashMap<>();
+        for (String id : Gen.ALL_ZONES) {
+            DateTimeZone z = DateTimeZone.forID(id);
+            List<Gap> gs = new ArrayList<>();
+            long t = Gen.ZONE_LO;
+            while (true) {
+                long nt = z.nextTransition(t);
+                if (nt == t || nt >= Gen.ZONE_HI) {
+                    break;
+                }
+                int before = z.getOffset(nt - 1);
+                int after = z.getOffset(nt);
+                if (after > before) {
+                    gs.add(new Gap(nt, before, after));
+                }
+                t = nt;
+            }
+            if (!gs.isEmpty()) {
+                m.put(id, gs);
+            }
+        }
+        return m;
+    }
+
+    static final Map<String, List<Gap>> GAPS = gaps();
+    static final List<String> ZONES_WITH_GAPS = new ArrayList<>(GAPS.keySet());
+
+    /** Which side of the gap the edge probe sits on. */
+    enum Edge { BEFORE, AFTER }
+
+    record GapCase(String id, Gap gap, long inside, Edge edge) {}
+
+    static final Generator<GapCase> GAP_CASE = sampledFrom(ZONES_WITH_GAPS).flatMap(id -> sampledFrom(GAPS.get(id)).flatMap(g ->
+            tuples(Gen.longs(0, g.after() - g.before() - 1), sampledFrom(Edge.values()))
+                .map(t -> new GapCase(id, g, t.value1(), t.value2()))));
+
+    @Test
+    void gapsAreReportedAndResolvedAsDocumented() {
+        Zoo.property("gapsAreReportedAndResolvedAsDocumented", tc -> {
+            GapCase c = tc.draw(GAP_CASE, "case");
+            DateTimeZone z = DateTimeZone.forID(c.id());
+            long nt = c.gap().at();
+            int before = c.gap().before();
+            int after = c.gap().after();
+            // local times in [nt + before, nt + after) do not exist
+            long local = nt + before + c.inside();
+            String at = z.getID() + " gap at " + nt + " (" + before + " -> " + after + ") local " + local;
+            LocalDateTime ldt = new LocalDateTime(local, DateTimeZone.UTC);
+            check(z.isLocalDateTimeGap(ldt), () -> at + ": isLocalDateTimeGap false for " + ldt);
+            check(Zoo.throwsA(IllegalInstantException.class, () -> z.convertLocalToUTC(local, true)), () -> at + ": strict conversion did not throw");
+            long lenient = z.convertLocalToUTC(local, false);
+            check(lenient == local - before, () -> at + ": lenient conversion " + lenient + " vs " + (local - before) + " (offset before the gap)");
+            check(z.getOffsetFromLocal(local) == before, () -> at + ": getOffsetFromLocal " + z.getOffsetFromLocal(local) + " vs " + before);
+            check(Zoo.throwsA(IllegalInstantException.class, () -> ldt.toDateTime(z)), () -> at + ": LocalDateTime.toDateTime in a gap did not throw: " + ldt.toDateTime(z));
+            // just outside the gap everything exists
+            long edge = c.edge() == Edge.BEFORE ? nt + before - 1 : nt + after;
+            check(!z.isLocalDateTimeGap(new LocalDateTime(edge, DateTimeZone.UTC)), () -> at + ": local " + edge + " at the edge of the gap reported as a gap");
+            long r = z.convertLocalToUTC(edge, true);
+            check(r + z.getOffset(r) == edge, () -> at + ": edge local " + edge + " converts to " + r + " with offset " + z.getOffset(r));
+        });
+    }
+
+    record FixedCase(int h, int m, int s, long t, String prefix) {}
+
+    static final Generator<FixedCase> FIXED_CASE = tuples(ints(-23, 23), ints(-59, 59), maybe(30, 0, ints(0, 59)), Gen.MILLIS, sampledFrom("", "UTC", "GMT", "UT"))
+            .map(t -> new FixedCase(t.value1(), t.value2(), t.value3(), t.value4(), t.value5()));
+
+    @Test
+    void fixedOffsetZonesRoundTrip() {
+        Zoo.property("fixedOffsetZonesRoundTrip", tc -> {
+            FixedCase c = tc.draw(FIXED_CASE, "case");
+            int h = c.h();
+            int m = c.m();
+            int s = c.s();
+            int total = (h == 0 ? (m < 0 ? -1 : 1) : Integer.signum(h)) * ((Math.abs(h) * 60 + Math.abs(m)) * 60 + s) * 1000;
+            String at = "offset " + h + "h " + m + "m " + s + "s = " + total + " ms";
+            DateTimeZone z = DateTimeZone.forOffsetMillis(total);
+            long t = c.t();
+            check(z.isFixed() && z.getOffset(t) == total && z.getStandardOffset(t) == total && z.nextTransition(t) == t && z.previousTransition(t) == t,
+                () -> at + ": forOffsetMillis zone " + z + " offset " + z.getOffset(t) + " next " + z.nextTransition(t));
+            if (t > -Long.MAX_VALUE / 2 && t < Long.MAX_VALUE / 2) {
+                check(z.getOffsetFromLocal(t) == total && z.convertLocalToUTC(t, true) == t - total, () -> at + ": local conversions on a fixed zone");
+            }
+            String id = z.getID();
+            String want = total == 0 ? "UTC" : String.format("%s%02d:%02d", total < 0 ? "-" : "+", Math.abs(h), Math.abs(m)) + (s != 0 ? String.format(":%02d", s) : "");
+            check(id.equals(want), () -> at + ": id " + show(id) + " vs " + show(want));
+            check(DateTimeZone.forID(id).equals(z) && DateTimeZone.forID(id).getOffset(0) == total, () -> at + ": forID(" + show(id) + ") = " + DateTimeZone.forID(id));
+            if (s == 0) {
+                boolean allowed = !(h > 0 && m < 0);
+                DateTimeZone hm = null;
+                try {
+                    hm = DateTimeZone.forOffsetHoursMinutes(h, m);
+                } catch (IllegalArgumentException e) {
+                    check(!allowed, () -> at + ": forOffsetHoursMinutes rejected: " + e.getMessage());
+                }
+                if (hm != null) {
+                    DateTimeZone fhm = hm;
+                    check(allowed, () -> at + ": forOffsetHoursMinutes accepted positive hours with negative minutes");
+                    check(fhm.getOffset(0) == total, () -> at + ": forOffsetHoursMinutes offset " + fhm.getOffset(0) + " (" + fhm + ")");
+                }
+                String prefixed = c.prefix() + String.format("%s%02d:%02d", total < 0 ? "-" : "+", Math.abs(h), Math.abs(m));
+                DateTimeZone p = DateTimeZone.forID(prefixed);
+                check(p.getOffset(0) == total, () -> at + ": forID(" + show(prefixed) + ") offset " + p.getOffset(0) + " (" + p + ")");
+                java.util.TimeZone tz = java.util.TimeZone.getTimeZone("GMT" + String.format("%s%02d:%02d", total < 0 ? "-" : "+", Math.abs(h), Math.abs(m)));
+                DateTimeZone ftz = DateTimeZone.forTimeZone(tz);
+                check(ftz.getOffset(0) == total, () -> at + ": forTimeZone(" + tz.getID() + ") offset " + ftz.getOffset(0) + " (" + ftz + ")");
+            }
+            check(z.toTimeZone().getOffset(t) == total, () -> at + ": toTimeZone offset " + z.toTimeZone().getOffset(t) + " (" + z.toTimeZone().getID() + ")");
+        });
+    }
+}
diff --git a/hegel/src/test/java/zoo/Zoo.java b/hegel/src/test/java/zoo/Zoo.java
new file mode 100644
index 0000000..d66b7ba
--- /dev/null
+++ b/hegel/src/test/java/zoo/Zoo.java
@@ -0,0 +1,132 @@
+package zoo;
+
+import dev.hegel.Database;
+import dev.hegel.Settings;
+import dev.hegel.TestCase;
+import java.util.LinkedHashSet;
+import java.util.Set;
+import java.util.function.Supplier;
+
+/**
+ * Hegel zoo harness. {@link #settings} reads {@code HEGEL_TEST_CASES} and {@code HEGEL_DATABASE}
+ * (hegel-java itself reads no environment variable); {@link #fail} throws, or under
+ * {@code ZOO_COLLECT=1} prints a {@code COLLECT <message>} line once per distinct message and
+ * lets the test case go on, so one run shows every kind of mismatch at once.
+ */
+final class Zoo {
+    private Zoo() {}
+
+    static final boolean COLLECT = notEmpty(System.getenv("ZOO_COLLECT"));
+    private static final Set<String> SEEN = new LinkedHashSet<>();
+
+    static Settings settings(String name) {
+        Settings s = new Settings().name(name).testCases(testCases());
+        String db = System.getenv("HEGEL_DATABASE");
+        if (notEmpty(db)) {
+            s = s.database(Database.path(db));
+        }
+        return s;
+    }
+
+    static long testCases() {
+        String n = System.getenv("HEGEL_TEST_CASES");
+        return notEmpty(n) ? Long.parseLong(n.trim()) : 100;
+    }
+
+    static void fail(String msg) {
+        if (COLLECT) {
+            String key = msg.length() > 300 ? msg.substring(0, 300) : msg;
+            if (SEEN.add(key)) {
+                System.out.println("COLLECT " + msg.replace('\n', '\u23ce'));
+                System.out.flush();
+            }
+            return;
+        }
+        throw new AssertionError(msg);
+    }
+
+    static void check(boolean ok, Supplier<String> msg) {
+        if (!ok) {
+            fail(msg.get());
+        }
+    }
+
+    static void check(boolean ok, String msg) {
+        if (!ok) {
+            fail(msg);
+        }
+    }
+
+    /** A readable rendering of a value: strings quoted with unprintables escaped, null as "null". */
+    static String show(Object o) {
+        if (o == null) {
+            return "null";
+        }
+        if (o instanceof String s) {
+            StringBuilder sb = new StringBuilder("\"");
+            for (int i = 0; i < s.length(); i++) {
+                char c = s.charAt(i);
+                if (c == '"' || c == '\\') {
+                    sb.append('\\').append(c);
+                } else if (c < 0x20 || c == 0x7f || (c >= 0xd800 && c <= 0xdfff) || c == '\u2028' || c == '\u2029') {
+                    sb.append(String.format("\\u%04x", (int) c));
+                } else {
+                    sb.append(c);
+                }
+            }
+            return sb.append('"').toString();
+        }
+        String s = o.toString();
+        if (o instanceof Number || o instanceof Boolean) {
+            return s + " (" + o.getClass().getSimpleName() + ")";
+        }
+        return s.length() > 400 ? s.substring(0, 400) + "…" : s;
+    }
+
+    private static boolean notEmpty(String s) {
+        return s != null && !s.isEmpty();
+    }
+
+    /** Broad catch blocks must let Hegel's own stop signal through (dev.hegel.StopTest is package-private). */
+    static void rethrowStop(Throwable t) {
+        if (t instanceof RuntimeException r && t.getClass().getName().equals("dev.hegel.StopTest")) {
+            throw r;
+        }
+    }
+
+    /** Rethrows any throwable unchecked (for control-flow exceptions such as Hegel's that must not be swallowed). */
+    @SuppressWarnings("unchecked")
+    static <T extends Throwable> void sneaky(Throwable t) throws T {
+        throw (T) t;
+    }
+
+    /** A property body that may throw checked exceptions. */
+    interface Body {
+        void run(TestCase tc) throws Exception;
+    }
+
+    /** Runs {@code body} as a Hegel property named {@code name}; checked exceptions escape as they are (Hegel.test takes a Consumer). */
+    static void property(String name, Body body) {
+        dev.hegel.Hegel.test(tc -> {
+            try {
+                body.run(tc);
+            } catch (Exception e) {
+                Zoo.<RuntimeException>sneaky(e);
+            }
+        }, settings(name));
+    }
+
+    /** Whether {@code t} throws an instance of {@code type} (or, with {@code type} null, anything at all). */
+    static boolean throwsA(Class<? extends Throwable> type, Body0 t) {
+        try {
+            t.run();
+            return false;
+        } catch (Throwable e) {
+            return type == null || type.isInstance(e);
+        }
+    }
+
+    interface Body0 {
+        void run() throws Exception;
+    }
+}
diff --git a/hegel/src/test/java/zoo/ZooListener.java b/hegel/src/test/java/zoo/ZooListener.java
