@@ -0,0 +1,333 @@
+package zoo;
+
+import static dev.hegel.Generators.sampledFrom;
+import static dev.hegel.Generators.tuples;
+import static zoo.Gen.ints;
+import static zoo.Gen.w;
+import static zoo.Gen.weighted;
+import static zoo.Zoo.check;
+import static zoo.Zoo.show;
+
+import dev.hegel.Generator;
+import dev.hegel.Generators;
+import java.time.ZoneOffset;
+import java.time.ZonedDateTime;
+import java.time.temporal.ChronoUnit;
+import java.time.temporal.IsoFields;
+import java.time.temporal.TemporalAdjusters;
+import java.time.temporal.ValueRange;
+import java.util.List;
+import org.joda.time.DateTime;
+import org.joda.time.DateTimeConstants;
+import org.joda.time.DateTimeZone;
+import org.joda.time.Days;
+import org.joda.time.IllegalInstantException;
+import org.joda.time.LocalDate;
+import org.joda.time.LocalDateTime;
+import org.joda.time.LocalTime;
+import org.joda.time.Months;
+import org.joda.time.Period;
+import org.joda.time.PeriodType;
+import org.joda.time.Weeks;
+import org.joda.time.Years;
+import org.joda.time.chrono.ISOChronology;
+import org.junit.jupiter.api.Test;
+
+/** The ISO chronology (dates, times, zoned date-times) against java.time. */
+class IsoTest {
+
+    static final ISOChronology UTC = ISOChronology.getInstanceUTC();
+
+    static java.time.LocalDate jd(LocalDate d) {
+        return java.time.LocalDate.of(d.getYear(), d.getMonthOfYear(), d.getDayOfMonth());
+    }
+
+    static void sameDate(String where, LocalDate a, java.time.LocalDate b) {
+        check(a.getYear() == b.getYear() && a.getMonthOfYear() == b.getMonthValue() && a.getDayOfMonth() == b.getDayOfMonth(),
+            () -> where + ": joda " + a + " vs java.time " + b);
+    }
+
+    /** Joda's whole months between two dates: the largest m with a.plusMonths(m) not past b (plusMonths clamps the day). */
+    static long monthsModel(java.time.LocalDate a, java.time.LocalDate b) {
+        if (a.isAfter(b)) {
+            return -monthsModel(b, a);
+        }
+        long m = (b.getYear() * 12L + b.getMonthValue()) - (a.getYear() * 12L + a.getMonthValue());
+        while (m > 0 && a.plusMonths(m).isAfter(b)) {
+            m--;
+        }
+        return m;
+    }
+
+    static long yearsModel(java.time.LocalDate a, java.time.LocalDate b) {
+        if (a.isAfter(b)) {
+            return -yearsModel(b, a);
+        }
+        long y = b.getYear() - a.getYear();
+        while (y > 0 && a.plusYears(y).isAfter(b)) {
+            y--;
+        }
+        return y;
+    }
+
+    // ---- the cases ---------------------------------------------------------------------------------------------
+
+    /** A step of up to 800 days (70%) or three million. */
+    static final Generator<Integer> DAY_STEP = weighted(w(70, ints(-800, 800)), w(30, ints(-3_000_000, 3_000_000)));
+
+    /**
+     * A date as an epoch day; a month and a day of month to build in its year; the step of the arithmetic; a month, a
+     * year, a day of week and a day of year to set; and a second date (within 100 000 days 70% of the time) for the differences.
+     */
+    record DateCase(long ed, int month, int dom, int step, int month2, int year2, int dow, int doy, long ed2) {}
+
+    static final Generator<DateCase> DATE_CASE = Gen.EPOCH_DAY.flatMap(ed -> tuples(
+            ints(1, 12), ints(1, 31), DAY_STEP, ints(1, 12), Gen.YEAR, ints(1, 7),
+            ints(1, java.time.LocalDate.ofEpochDay(ed).lengthOfYear()),
+            weighted(w(70, ints(-100_000, 100_000).map(d -> ed + d)), w(30, Gen.EPOCH_DAY)))
+        .map(t -> new DateCase(ed, t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6(), t.value7(), t.value8())));
+
+    @Test
+    void localDateFieldsAgreeWithJavaTime() {
+        Zoo.property("localDateFieldsAgreeWithJavaTime", tc -> {
+            DateCase c = tc.draw(DATE_CASE, "case");
+            long ed = c.ed();
+            java.time.LocalDate j = java.time.LocalDate.ofEpochDay(ed);
+            LocalDate d = new LocalDate(ed * Gen.DAY, UTC);
+            String at = "epoch day " + ed + " (" + j + ")";
+            sameDate(at, d, j);
+            check(d.getDayOfWeek() == j.getDayOfWeek().getValue(), () -> at + ": dayOfWeek " + d.getDayOfWeek() + " vs " + j.getDayOfWeek());
+            check(d.getDayOfYear() == j.getDayOfYear(), () -> at + ": dayOfYear " + d.getDayOfYear() + " vs " + j.getDayOfYear());
+            check(d.getWeekyear() == j.get(IsoFields.WEEK_BASED_YEAR), () -> at + ": weekyear " + d.getWeekyear() + " vs " + j.get(IsoFields.WEEK_BASED_YEAR));
+            check(d.getWeekOfWeekyear() == j.get(IsoFields.WEEK_OF_WEEK_BASED_YEAR), () -> at + ": weekOfWeekyear " + d.getWeekOfWeekyear() + " vs " + j.get(IsoFields.WEEK_OF_WEEK_BASED_YEAR));
+            ValueRange wr = IsoFields.WEEK_OF_WEEK_BASED_YEAR.rangeRefinedBy(j);
+            check(d.weekOfWeekyear().getMaximumValue() == wr.getMaximum(), () -> at + ": weeks in weekyear " + d.weekOfWeekyear().getMaximumValue() + " vs " + wr.getMaximum());
+            int era = j.getYear() > 0 ? DateTimeConstants.AD : DateTimeConstants.BC;
+            int yoe = j.getYear() > 0 ? j.getYear() : 1 - j.getYear();
+            check(d.getEra() == era && d.getYearOfEra() == yoe, () -> at + ": era/yearOfEra " + d.getEra() + "/" + d.getYearOfEra() + " vs " + era + "/" + yoe);
+            int ay = Math.abs(j.getYear());
+            check(d.getCenturyOfEra() == ay / 100 && d.getYearOfCentury() == ay % 100, () -> at + ": century " + d.getCenturyOfEra() + "/" + d.getYearOfCentury() + " vs " + ay / 100 + "/" + ay % 100);
+            check(d.dayOfMonth().getMaximumValue() == j.lengthOfMonth(), () -> at + ": month length " + d.dayOfMonth().getMaximumValue() + " vs " + j.lengthOfMonth());
+            check(d.dayOfYear().getMaximumValue() == j.lengthOfYear(), () -> at + ": year length " + d.dayOfYear().getMaximumValue() + " vs " + j.lengthOfYear());
+            check(d.year().isLeap() == j.isLeapYear(), () -> at + ": isLeap " + d.year().isLeap() + " vs " + j.isLeapYear());
+            check(d.toDateTimeAtStartOfDay(DateTimeZone.UTC).getMillis() == ed * Gen.DAY, () -> at + ": toDateTimeAtStartOfDay(UTC) " + d.toDateTimeAtStartOfDay(DateTimeZone.UTC).getMillis());
+            LocalDate back = LocalDate.parse(d.toString());
+            check(back.equals(d), () -> at + ": parse(toString) " + show(d.toString()) + " -> " + back);
+            if (Math.abs(j.getYear()) <= 9999) {
+                check(d.toString().equals(j.toString()), () -> at + ": toString " + show(d.toString()) + " vs " + show(j.toString()));
+            }
+            // the constructor accepts exactly the dates java.time accepts
+            int y = j.getYear();
+            int m = c.month();
+            int dom = c.dom();
+            boolean javaOk = dom <= java.time.YearMonth.of(y, m).lengthOfMonth();
+            boolean jodaOk = !Zoo.throwsA(IllegalArgumentException.class, () -> new LocalDate(y, m, dom));
+            check(javaOk == jodaOk, () -> "new LocalDate(" + y + ", " + m + ", " + dom + ") accepted=" + jodaOk + ", java.time " + javaOk);
+            // arithmetic
+            int k = c.step();
+            sameDate(at + " plusDays(" + k + ")", d.plusDays(k), j.plusDays(k));
+            sameDate(at + " plusWeeks(" + k + ")", d.plusWeeks(k), j.plusWeeks(k));
+            sameDate(at + " plusMonths(" + k + ")", d.plusMonths(k), j.plusMonths(k));
