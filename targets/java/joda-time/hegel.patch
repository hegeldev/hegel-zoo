+import org.junit.jupiter.api.Test;
+
+/**
+ * One pin per recorded bug (bugs.toml). Each asserts the correct behaviour and therefore fails while the bug exists;
+ * target.toml lists them as expected failures.
+ */
+class JodaTimePinsTest {
+
+    @Test
+    void convertLocalToUTCResolvesOverlapsLikeGetOffsetFromLocal() {
+        // joda-time/1: Berlin, 2023-10-29 02:30 local is ambiguous; getOffsetFromLocal picks the offset before the
+        // transition (00:30Z), convertLocalToUTC(local, false) picks 01:30Z — but only in zones east of Greenwich
+        DateTimeZone berlin = DateTimeZone.forID("Europe/Berlin");
+        long local = new LocalDateTime(2023, 10, 29, 2, 30).toDateTime(DateTimeZone.UTC).getMillis();
+        long viaOffset = local - berlin.getOffsetFromLocal(local);
+        assertEquals(viaOffset, berlin.convertLocalToUTC(local, false));
+        assertEquals(viaOffset, berlin.convertLocalToUTC(local, true));
+    }
+
+    @Test
+    void parseLocalDateTimeIgnoresTheZoneId() {
+        // joda-time/2: "any parsed time-zone or offset field is completely ignored", yet a zone id in a DST gap throws
+        DateTimeFormatter f = DateTimeFormat.forPattern("yyyy-MM-dd HH:mm ZZZ");
+        assertEquals(new LocalDateTime(2010, 3, 14, 2, 30), f.parseLocalDateTime("2010-03-14 02:30 America/New_York"));
+        assertEquals(new LocalDate(2010, 3, 14), f.parseLocalDate("2010-03-14 02:30 America/New_York"));
+    }
+
+    @Test
+    void zoneIdPatternParsesTheIdsItPrints() {
+        // joda-time/3: ZZZ prints "+02:00" for a fixed-offset zone, which DateTimeZone.forID accepts, but the ZZZ parser rejects
+        DateTimeFormatter f = DateTimeFormat.forPattern("yyyy-MM-dd ZZZ").withOffsetParsed();
+        String text = f.print(new DateTime(0, DateTimeZone.forOffsetHours(2)));
+        assertEquals("1970-01-01 +02:00", text);
+        assertEquals(7_200_000, f.parseDateTime(text).getZone().getOffset(0));
+    }
+
+    @Test
+    void toStandardUnitsTruncateTheTotal() {
+        // joda-time/4: -16 weeks + 16 days + 1h - 2m - 3.994s = -13.7 weeks = -95.96 days, truncated: -13 weeks, -95 days
+        Period p = new Period(0, 0, -16, 16, 1, -2, -3, -994);
+        assertEquals(-13, p.toStandardWeeks().getWeeks());
+        assertEquals(-95, p.toStandardDays().getDays());
+    }
+
+    @Test
+    void islamicChronologyKeepsItsLeapYearPatternInUTC() {
+        // joda-time/5: withUTC()/withZone() return the 16-based chronology; LocalDate calls withUTC(), so 8 AH
+        // (a leap year in the Indian pattern) is treated as a common year
+        IslamicChronology indian = IslamicChronology.getInstance(DateTimeZone.UTC, IslamicChronology.LEAP_YEAR_INDIAN);
+        assertEquals(IslamicChronology.LEAP_YEAR_INDIAN, ((IslamicChronology) indian.withUTC()).getLeapYearPatternType());
+        assertEquals(IslamicChronology.LEAP_YEAR_INDIAN, ((IslamicChronology) indian.withZone(DateTimeZone.forID("Europe/Paris"))).getLeapYearPatternType());
+        assertTrue(new LocalDate(8, 1, 1, indian).year().isLeap());
+    }
+
+    @Test
+    void singleFieldPeriodsDividedByMinusOneOverflowLoudly() {
+        // joda-time/6: Days.MIN_VALUE.dividedBy(-1) returns Days.MIN_VALUE; negated() throws as documented
+        assertTrue(Zoo.throwsA(ArithmeticException.class, () -> Days.MIN_VALUE.dividedBy(-1)));
+    }
+
+    @Test
+    void isoPeriodFormatPrintsLargeSecondsExactly() {
+        // joda-time/7: seconds*1000 + millis is folded into an int: 2147483647 s + 1000 ms prints as -2147483648 s
+        Period p = new Period(0, 0, 0, 0, 0, 0, Integer.MAX_VALUE, 1000);
+        assertEquals("PT2147483648S", p.toString());
+    }
+
+    @Test
+    void partialMaximumValueUsesTheChronologyYear() {
+        // joda-time/8: getMaximumValue(ReadablePartial) feeds the era year into the leap-year rule: BE 2567 is 2024 CE
+        // (February has 29 days), 1 BC in the Julian calendar is a leap year
+        BuddhistChronology bud = BuddhistChronology.getInstanceUTC();
+        assertEquals(29, bud.dayOfMonth().getMaximumValue(new LocalDate(2567, 2, 1, bud)));
+        JulianChronology jul = JulianChronology.getInstanceUTC();
+        assertEquals(29, jul.dayOfMonth().getMaximumValue(new LocalDate(-1, 2, 1, jul)));
+        assertEquals(366, jul.dayOfYear().getMaximumValue(new LocalDate(-1, 2, 1, jul)));
+    }
+
+    @Test
+    void limitChronologyMaximaFollowThePartial() {
+        // joda-time/9: LimitDateTimeField answers getMaximumValue(ReadablePartial) with the absolute maximum
+        IslamicChronology isl = IslamicChronology.getInstanceUTC();
+        LocalDate common = new LocalDate(1427, 1, 1, isl);
+        assertEquals(common.dayOfYear().getMaximumValue(), isl.dayOfYear().getMaximumValue(common));
+        assertEquals(354, isl.dayOfYear().getMaximumValue(common));
+    }
+
+    @Test
+    void minusOfMinValueOverflowsOnlyWhenTheResultDoes() {
+        // joda-time/10: minus(x) is plus(safeNegate(x)), so minus(MIN_VALUE) throws even when the result fits
+        assertEquals(Long.MAX_VALUE, new Duration(-1).minus(Long.MIN_VALUE).getMillis());
+        assertEquals(Integer.MAX_VALUE, Days.days(-1).minus(Integer.MIN_VALUE).getDays());
+    }
+
+    @Test
+    void nextTransitionNeverGoesBackwards() {
+        // joda-time/11: DSTZone.nextTransition(Long.MAX_VALUE) returns an instant before its argument
+        long next = DateTimeZone.forID("Africa/Cairo").nextTransition(Long.MAX_VALUE);
+        assertTrue(next >= Long.MAX_VALUE, "nextTransition(Long.MAX_VALUE) = " + next);
+    }
+
+    @Test
+    void previousTransitionAtLongMaxIsTheLastTransition() {
+        // joda-time/12: DSTZone.previousTransition increments its argument first, wrapping Long.MAX_VALUE
+        DateTimeZone ny = DateTimeZone.forID("America/New_York");
+        assertEquals(ny.previousTransition(Long.MAX_VALUE - 1), ny.previousTransition(Long.MAX_VALUE));
+    }
+
+    @Test
+    void plusMonthsRespectsTheMaximumYear() {
+        // joda-time/13: BasicMonthOfYearDateTimeField.add(long, int) has no range check, unlike add(long, long) and plusYears
+        assertTrue(Zoo.throwsA(null, () -> new LocalDate(292278993, 12, 1).plusMonths(1)), "plusMonths left the supported range");
+        assertTrue(Zoo.throwsA(null, () -> new YearMonth(292278993, 12).plusMonths(Integer.MAX_VALUE)), "plusMonths wrapped to " + new YearMonth(292278993, 12).plusMonths(Integer.MAX_VALUE));
+    }
+
+    @Test
+    void roundingAtTheLongExtremesOverflowsLoudly() {
+        // joda-time/14: roundCeiling(Long.MAX_VALUE) and roundFloor(Long.MIN_VALUE) wrap to the other sign
+        ISOChronology iso = ISOChronology.getInstanceUTC();
+        assertTrue(Zoo.throwsA(ArithmeticException.class, () -> iso.secondOfMinute().roundCeiling(Long.MAX_VALUE)),
+            "roundCeiling(Long.MAX_VALUE) = " + iso.secondOfMinute().roundCeiling(Long.MAX_VALUE));
+        assertTrue(Zoo.throwsA(ArithmeticException.class, () -> iso.secondOfMinute().roundFloor(Long.MIN_VALUE)),
+            "roundFloor(Long.MIN_VALUE) = " + iso.secondOfMinute().roundFloor(Long.MIN_VALUE));
+    }
+
+    @Test
+    void gjChronologyOctober1582HasThirtyOneDays() {
+        // joda-time/15: CutoverField.getMaximumValue assumes the cutover removes the end of the range; October 1582
+        // loses days 5-14 but keeps 15-31, and day 31 is accepted by set()
+        GJChronology gj = GJChronology.getInstanceUTC();
+        LocalDate d = new LocalDate(1582, 10, 4, gj);
+        assertEquals(31, d.dayOfMonth().getMaximumValue());
+        assertEquals(new LocalDate(1582, 10, 31, gj), d.dayOfMonth().withMaximumValue());
+    }
+
+    @Test
+    void lenientTwoDigitYearRequiresDigits() {
+        // joda-time/16: a sign followed by a non-digit parses as a year ('#' - '0' = -13, negated)
+        DateTimeFormatter f = new DateTimeFormatterBuilder().appendTwoDigitYear(2000, true).appendLiteral('#').toFormatter();
+        assertTrue(Zoo.throwsA(IllegalArgumentException.class, () -> f.parseLocalDate("-#")), "parsed as " + f.parseLocalDate("-#"));
+    }
+
+    @Test
+    void twoDigitYearParseFailurePositionIsTheStart() {
+        // joda-time/17: a leading '+' is consumed before the failure is reported, so the position is off by one
+        DateTimeFormatter f = new DateTimeFormatterBuilder().appendTwoDigitYear(2000, true).toFormatter();
+        assertEquals(~0, f.parseInto(new MutableDateTime(0L, DateTimeZone.UTC), "+x", 0));
+    }
+
+    @Test
+    void basicIsoFormatsRoundTripLargeYears() {
+        // joda-time/18: basicDate() prints five-digit years (appendYear(4, 4) limits parsing only) that it cannot parse
+        DateTimeFormatter b = ISODateTimeFormat.basicDate();
+        LocalDate d = new LocalDate(12345, 6, 30);
+        assertEquals(d, b.parseLocalDate(b.print(d)));
+    }
+
+    @Test
+    void gjAcceptsJulianLeapDaysTheGregorianCalendarLacks() {
+        // joda-time/19: the four-argument getDateTimeMillis checks February 29 of the Julian year 300 against the
+        // Gregorian month length; DateTime, the seven-argument overload and the fields accept and print the day, and
+        // plusYears onto such a date clamps to the 28th instead of landing on the 29th
+        GJChronology gj = GJChronology.getInstanceUTC();
+        assertEquals(new LocalDate(300, 2, 29, gj), new LocalDate(1988, 2, 29, gj).plusYears(-1688));
+        assertEquals(new LocalDate(300, 3, 1, gj).minusDays(1), new LocalDate(300, 2, 29, gj));
+    }
+
+    @Test
+    void tailRuleTransitionsAgreeWithOffsetsNearLongMax() {
+        // joda-time/20: in a zone with a DST tail rule, previousTransition(Long.MAX_VALUE - 1) names the millisecond
+        // before a transition at which the offset does not change, and nextTransition just before it reports none
+        DateTimeZone chicago = DateTimeZone.forID("America/Chicago");
+        long pt = chicago.previousTransition(Long.MAX_VALUE - 1);
+        assertTrue(chicago.getOffset(pt) != chicago.getOffset(pt + 1),
+                "phantom transition after " + pt + ": offset " + chicago.getOffset(pt) + " on both sides");
+    }
+
+    @Test
+    void overlapAcrossTheDateLineResolvesToTheEarlierInstant() {
+        // joda-time/21: Pacific/Kwajalein went from +11:00 to -12:00 at the end of 1969-09-30, so 23:00 local is
+        // ambiguous; the earlier-instant rule (and java.time) give +11:00, getOffsetFromLocal and toDateTime -12:00
+        DateTimeZone kwajalein = DateTimeZone.forID("Pacific/Kwajalein");
+        DateTime dt = new LocalDateTime(1969, 9, 30, 23, 0).toDateTime(kwajalein);
+        assertEquals(11 * 3600 * 1000, kwajalein.getOffset(dt.getMillis()), "resolved to " + dt);
+    }
+}
diff --git a/hegel/src/test/java/zoo/Known.java b/hegel/src/test/java/zoo/Known.java
new file mode 100644
index 0000000..fd512e1
--- /dev/null
+++ b/hegel/src/test/java/zoo/Known.java
@@ -0,0 +1,68 @@
+package zoo;
+
+/**
+ * Switches for the recorded bugs (bugs.toml): while a switch is true the properties skip the shape it names, and the
+ * matching pin in {@link JodaTimePinsTest} asserts the correct behaviour (and fails). Flip a switch to false once
+ * upstream fixes the bug to make the properties cover the shape again.
+ */
+final class Known {
+    private Known() {}
+
+    /** joda-time/1: convertLocalToUTC(local, strict) resolves an overlap to the later instant in eastern zones. */
+    static final boolean CONVERT_LOCAL_TO_UTC_OVERLAP_DEPENDS_ON_HEMISPHERE = true;
+
+    /** joda-time/2: parseLocalDateTime/parseLocalDate throw IllegalInstantException for a zone id (ZZZ) in a DST gap. */
+    static final boolean PARSE_LOCAL_WITH_ZONE_ID_THROWS_IN_GAPS = true;
+
+    /** joda-time/3: the ZZZ pattern prints fixed-offset zone ids ("+02:00") that its parser rejects. */
+    static final boolean ZONE_ID_PARSER_REJECTS_FIXED_OFFSET_IDS = true;
+
+    /** joda-time/4: Period.toStandardWeeks/Days/Hours/Minutes/Seconds truncate the smaller fields before adding the whole field. */
+    static final boolean TO_STANDARD_UNITS_TRUNCATE_BEFORE_ADDING_THE_WHOLE_FIELD = true;
+
+    /** joda-time/5: IslamicChronology.withUTC()/withZone() return the 16-based chronology whatever the leap-year pattern. */
+    static final boolean ISLAMIC_WITH_ZONE_DROPS_THE_LEAP_YEAR_PATTERN = true;
+
+    /** joda-time/6: Days/Weeks/Months/Years/Hours/Minutes/Seconds.dividedBy(-1) of MIN_VALUE returns MIN_VALUE. */
+    static final boolean SINGLE_FIELD_DIVIDED_BY_MINUS_ONE_OVERFLOWS = true;
+
+    /** joda-time/7: the ISO period printer wraps seconds*1000+millis to an int, printing a negative number of seconds. */
+    static final boolean ISO_PERIOD_PRINTER_WRAPS_SECONDS = true;
+
+    /** joda-time/8: getMaximumValue(ReadablePartial) of dayOfMonth/dayOfYear uses the era year, so BC leap years of the Julian/GJ chronologies get 28/365. */
+    static final boolean PARTIAL_MAXIMA_USE_THE_ERA_YEAR = true;
+
+    /** joda-time/9: LimitChronology fields answer getMaximumValue(ReadablePartial) with the absolute maximum (Islamic/Coptic/Ethiopic). */
+    static final boolean LIMIT_CHRONOLOGY_PARTIAL_MAXIMA_IGNORE_THE_PARTIAL = true;
+
+    /** joda-time/10: minus(MIN_VALUE) on Duration/Instant/Days... throws ArithmeticException even when the result fits. */
+    static final boolean MINUS_MIN_VALUE_ALWAYS_OVERFLOWS = true;
+
+    /** joda-time/11: nextTransition(t) at the long extreme (Long.MAX_VALUE and the millisecond before) returns an instant before t in zones with a DST tail rule. */
+    static final boolean NEXT_TRANSITION_AT_THE_LONG_EXTREME_GOES_BACKWARDS = true;
+
+    /** joda-time/12: previousTransition(Long.MAX_VALUE) wraps and returns an instant near Long.MIN_VALUE or the last precalculated transition. */
+    static final boolean PREVIOUS_TRANSITION_AT_LONG_MAX_WRAPS = true;
+
+    /**
+     * Not yet recorded: GJChronology.getDateTimeMillis(year, month, day, millisOfDay), hence the LocalDate constructor,
+     * rejects February 29 of a Julian leap year before the cutover whose year number is not a Gregorian leap year
+     * (300, 1500, every BC year), while the seven-argument overload, DateTime and the chronology's own fields accept
+     * and print the day; plusYears/plusMonths/withYear from a Gregorian date (GJ and Buddhist) clamp such a target to
+     * February 28 instead of landing on the 29th.
+     */
+    static final boolean GJ_GET_DATE_TIME_MILLIS_REJECTS_JULIAN_LEAP_DAYS = true;
+
+    /**
+     * Not yet recorded: in zones with a DST tail rule, getOffset/nextTransition/previousTransition disagree with each
+     * other during the last two years before Long.MAX_VALUE (the recurrences of the final year cannot be computed).
+     */
+    static final boolean TAIL_RULE_OFFSETS_ARE_WRONG_IN_THE_LAST_YEARS_BEFORE_LONG_MAX = true;
+
+    /**
+     * Not yet recorded: when a backward transition crosses the date line (a positive offset before, a negative one
+     * after: Pacific/Kwajalein 1969-10-01), getOffsetFromLocal and toDateTime resolve the last hours of the overlap to
+     * the later instant, against the documented earlier-instant rule and java.time.
+     */
+    static final boolean OVERLAP_INTO_A_NEGATIVE_OFFSET_RESOLVES_TO_THE_LATER_INSTANT = true;
+}
diff --git a/hegel/src/test/java/zoo/PeriodTest.java b/hegel/src/test/java/zoo/PeriodTest.java
