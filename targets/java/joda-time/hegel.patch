+            long t = c.t();
+            DateTime dt = new DateTime(t, z.joda());
+            ZonedDateTime zdt = java.time.Instant.ofEpochMilli(t).atZone(z.jid());
+            String at = z.id() + " @ " + t + " (" + zdt + ")";
+            check(z.joda().getOffset(t) == zdt.getOffset().getTotalSeconds() * 1000, () -> at + ": offset " + z.joda().getOffset(t) + " vs " + zdt.getOffset());
+            check(jl(dt.toLocalDateTime()).equals(zdt.toLocalDateTime()), () -> at + ": local fields " + dt.toLocalDateTime() + " vs " + zdt.toLocalDateTime());
+            check(dt.toString().equals(zdt.format(ISO_MILLIS)), () -> at + ": toString " + show(dt.toString()) + " vs " + show(zdt.format(ISO_MILLIS)));
