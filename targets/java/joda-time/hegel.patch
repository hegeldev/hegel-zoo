+    static final String[] DATE_PATTERNS = {"yyyy-MM-dd", "yyyyMMdd", "yyyy-DDD", "xxxx-'W'ww-e", "G yyyy MM dd", "YYYY G MM dd", "dd/MM/yyyy", "d.M.yyyy", "yyyy-M-d", "MM/dd/yyyy"};
+    static final String[] TIME_PATTERNS = {"HH:mm:ss.SSS", "HHmmssSSS", "hh:mm:ss.SSS a", "KK:mm:ss.SSS a", "kk:mm:ss.SSS", "H:m:s.SSS", "HH:mm:ss.SSSS", "HH:mm:ss.SSSSSSSSS", "HH:mm:ss.SSS", "HH:mm:ss SSS"};
+    static final String[] ZONE_PATTERNS = {"", " Z", " ZZ", " ZZZ"};
+
+    /** The java.time pattern for the Joda pattern, or null when the semantics differ (weeks, era, zones). */
+    static String javaPattern(String joda) {
+        if (joda.contains("x") || joda.contains("G") || joda.contains("Z") || joda.contains("e")) {
+            return null;
+        }
