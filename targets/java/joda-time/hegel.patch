+            List<ZoneOffset> valid = z.jdk().getValidOffsets(jlocal);
+            tc.assume(!(Known.OVERLAP_INTO_A_NEGATIVE_OFFSET_RESOLVES_TO_THE_LATER_INSTANT && valid.size() == 2
