+<?xml version="1.0" encoding="UTF-8"?>
+<!-- Hegel property tests for Joda-Time, added by the Hegel zoo (targets/java/joda-time).
+     Runs against the joda-time artifact that `[run] setup` installs from this checkout into the local Maven
+     repository. The oracles are java.time (ISO chronology, zone rules, ISO formats), independent day-count
+     models of the Julian, Coptic, Ethiopic and tabular Islamic calendars, exact BigInteger arithmetic for
+     durations and periods, interval algebra on [start, end) pairs, and the library against itself
+     (print/parse round trips, mutable vs immutable, chronology fields vs whole-value arithmetic). -->
+<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
+         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
+  <modelVersion>4.0.0</modelVersion>
+
+  <groupId>dev.hegel.zoo</groupId>
+  <artifactId>joda-time-hegel</artifactId>
+  <version>0</version>
+  <packaging>jar</packaging>
+
+  <properties>
+    <maven.compiler.release>22</maven.compiler.release>
+    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
+    <joda.version>2.14.4</joda.version>
+    <hegel.version>0.6.0</hegel.version>
+    <junit.version>5.11.4</junit.version>
+  </properties>
+
+  <dependencies>
+    <dependency>
+      <groupId>joda-time</groupId>
+      <artifactId>joda-time</artifactId>
+      <version>${joda.version}</version>
+    </dependency>
+    <dependency>
+      <groupId>dev.hegel</groupId>
+      <artifactId>hegel</artifactId>
+      <version>${hegel.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.jupiter</groupId>
+      <artifactId>junit-jupiter</artifactId>
+      <version>${junit.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.platform</groupId>
+      <artifactId>junit-platform-launcher</artifactId>
+      <version>1.11.4</version>
+      <scope>test</scope>
+    </dependency>
+  </dependencies>
+
+  <build>
+    <plugins>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-compiler-plugin</artifactId>
+        <version>3.13.0</version>
+      </plugin>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-surefire-plugin</artifactId>
+        <version>3.5.2</version>
+        <configuration>
+          <argLine>-XX:-OmitStackTraceInFastThrow -Xmx2g -Duser.timezone=UTC -Duser.language=en -Duser.country=US</argLine>
+          <testFailureIgnore>true</testFailureIgnore>
+          <trimStackTrace>false</trimStackTrace>
+        </configuration>
+      </plugin>
+    </plugins>
+  </build>
+</project>
diff --git a/hegel/src/test/java/zoo/Cal.java b/hegel/src/test/java/zoo/Cal.java
new file mode 100644
index 0000000..c42c6ee
--- /dev/null
+++ b/hegel/src/test/java/zoo/Cal.java
@@ -0,0 +1,167 @@
+package zoo;
+
+/**
+ * Independent day-count models of the calendars Joda-Time implements, on proleptic astronomical years
+ * (year 0 exists; Joda's era-based year y maps to y for y > 0 and y + 1 for y < 0). Epoch days count from
+ * 1970-01-01 (Gregorian).
+ */
+final class Cal {
+    private Cal() {}
+
+    record Ymd(long year, int month, int day) {}
+
+    // ---- Julian and Gregorian, via Julian Day Numbers (Fliegel–Van Flandern with floor division) ----
+
+    static long julianEpochDay(long y, int m, int d) {
+        long a = (14 - m) / 12;
+        long yy = y + 4800 - a;
+        long mm = m + 12 * a - 3;
+        long jdn = d + (153 * mm + 2) / 5 + 365 * yy + Math.floorDiv(yy, 4) - 32083;
+        return jdn - 2440588;
+    }
+
+    static long gregorianEpochDay(long y, int m, int d) {
+        long a = (14 - m) / 12;
+        long yy = y + 4800 - a;
+        long mm = m + 12 * a - 3;
+        long jdn = d + (153 * mm + 2) / 5 + 365 * yy + Math.floorDiv(yy, 4) - Math.floorDiv(yy, 100) + Math.floorDiv(yy, 400) - 32045;
+        return jdn - 2440588;
+    }
+
+    static Ymd julianFromEpochDay(long ed) {
+        long jdn = ed + 2440588;
+        long c = jdn + 32082;
+        long d = Math.floorDiv(4 * c + 3, 1461);
+        long e = c - Math.floorDiv(1461 * d, 4);
+        long m = Math.floorDiv(5 * e + 2, 153);
+        int day = (int) (e - Math.floorDiv(153 * m + 2, 5) + 1);
+        int month = (int) (m + 3 - 12 * Math.floorDiv(m, 10));
+        long year = d - 4800 + Math.floorDiv(m, 10);
+        return new Ymd(year, month, day);
+    }
+
+    static Ymd gregorianFromEpochDay(long ed) {
+        long jdn = ed + 2440588;
+        long a = jdn + 32044;
+        long b = Math.floorDiv(4 * a + 3, 146097);
+        long c = a - Math.floorDiv(146097 * b, 4);
+        long d = Math.floorDiv(4 * c + 3, 1461);
+        long e = c - Math.floorDiv(1461 * d, 4);
+        long m = Math.floorDiv(5 * e + 2, 153);
+        int day = (int) (e - Math.floorDiv(153 * m + 2, 5) + 1);
+        int month = (int) (m + 3 - 12 * Math.floorDiv(m, 10));
+        long year = 100 * b + d - 4800 + Math.floorDiv(m, 10);
+        return new Ymd(year, month, day);
+    }
+
+    static boolean julianLeap(long y) {
+        return Math.floorMod(y, 4) == 0;
+    }
+
+    static boolean gregorianLeap(long y) {
+        return Math.floorMod(y, 4) == 0 && (Math.floorMod(y, 100) != 0 || Math.floorMod(y, 400) == 0);
+    }
+
+    static int monthLength(int m, boolean leap) {
+        return switch (m) {
+            case 2 -> leap ? 29 : 28;
+            case 4, 6, 9, 11 -> 30;
+            default -> 31;
+        };
+    }
+
+    /** The default GJ cutover: 1582-10-15 Gregorian. */
+    static final long GJ_CUTOVER = gregorianEpochDay(1582, 10, 15);
+
+    // ---- Coptic and Ethiopic: 12 months of 30 days plus a 13th of 5 or 6, leap when year % 4 == 3 ----
+
+    static final long COPTIC_EPOCH = julianEpochDay(284, 8, 29);
+    static final long ETHIOPIC_EPOCH = julianEpochDay(8, 8, 29);
+
+    static boolean fixedLeap(long y) {
+        return Math.floorMod(y, 4) == 3;
+    }
+
+    static long fixedDaysBeforeYear(long y) {
+        return 365 * (y - 1) + Math.floorDiv(y, 4);
+    }
+
+    static long fixedEpochDay(long epoch, long y, int m, int d) {
+        return epoch + fixedDaysBeforeYear(y) + 30L * (m - 1) + d - 1;
+    }
+
+    static Ymd fixedFromEpochDay(long epoch, long ed) {
+        long d0 = ed - epoch;
+        long y = Math.floorDiv(4 * d0 + 1463, 1461);
+        long doy = d0 - fixedDaysBeforeYear(y);
+        return new Ymd(y, (int) (doy / 30) + 1, (int) (doy % 30) + 1);
+    }
+
+    static int fixedMonthLength(long y, int m) {
+        return m < 13 ? 30 : fixedLeap(y) ? 6 : 5;
+    }
+
+    // ---- Tabular Islamic: 30-year cycle with 11 leap years given by a bit pattern, years from 1 AH ----
+
+    static final long ISLAMIC_EPOCH = julianEpochDay(622, 7, 16);
+
+    static boolean islamicLeap(int pattern, long y) {
+        return (pattern & (1 << (int) Math.floorMod(y, 30))) != 0;
+    }
+
+    static long islamicDaysBeforeYear(int pattern, long y) {
+        long cycles = (y - 1) / 30;
+        long days = cycles * (30 * 354 + 11);
+        for (long k = cycles * 30 + 1; k < y; k++) {
+            days += islamicLeap(pattern, k) ? 355 : 354;
+        }
+        return days;
+    }
+
+    static int islamicMonthLength(int pattern, long y, int m) {
+        if (m == 12) {
+            return islamicLeap(pattern, y) ? 30 : 29;
+        }
+        return m % 2 == 1 ? 30 : 29;
+    }
+
+    static long islamicEpochDay(int pattern, long y, int m, int d) {
+        long days = islamicDaysBeforeYear(pattern, y);
+        for (int k = 1; k < m; k++) {
+            days += islamicMonthLength(pattern, y, k);
+        }
+        return ISLAMIC_EPOCH + days + d - 1;
+    }
+
+    static Ymd islamicFromEpochDay(int pattern, long ed) {
+        long d0 = ed - ISLAMIC_EPOCH;
+        long y = Math.max(1, (long) (d0 / 354.36667) - 1);
+        while (islamicDaysBeforeYear(pattern, y + 1) <= d0) {
+            y++;
+        }
+        while (y > 1 && islamicDaysBeforeYear(pattern, y) > d0) {
+            y--;
+        }
+        long doy = d0 - islamicDaysBeforeYear(pattern, y);
+        int m = 1;
+        while (doy >= islamicMonthLength(pattern, y, m)) {
+            doy -= islamicMonthLength(pattern, y, m);
+            m++;
+        }
+        return new Ymd(y, m, (int) doy + 1);
+    }
+
+    /** ISO day of week (1 = Monday) of an epoch day. */
+    static int dayOfWeek(long ed) {
+        return (int) Math.floorMod(ed + 3, 7) + 1;
+    }
+
+    /** Joda's era-based year of an astronomical year in the chronologies that skip year 0. */
+    static long skipZero(long astronomical) {
+        return astronomical <= 0 ? astronomical - 1 : astronomical;
+    }
+
+    static long unskipZero(long jodaYear) {
+        return jodaYear < 0 ? jodaYear + 1 : jodaYear;
+    }
+}
diff --git a/hegel/src/test/java/zoo/ChronoTest.java b/hegel/src/test/java/zoo/ChronoTest.java
new file mode 100644
index 0000000..b10e34d
--- /dev/null
+++ b/hegel/src/test/java/zoo/ChronoTest.java
@@ -0,0 +1,382 @@
+package zoo;
+
+import static dev.hegel.Generators.sampledFrom;
+import static dev.hegel.Generators.tuples;
+import static zoo.Gen.ints;
+import static zoo.Gen.w;
+import static zoo.Gen.weighted;
+import static zoo.Zoo.check;
+
+import dev.hegel.Generator;
+import java.util.Arrays;
+import java.util.List;
+import org.joda.time.Chronology;
+import org.joda.time.DateTimeConstants;
+import org.joda.time.DateTimeZone;
+import org.joda.time.Days;
+import org.joda.time.IllegalFieldValueException;
+import org.joda.time.LocalDate;
+import org.joda.time.chrono.BuddhistChronology;
+import org.joda.time.chrono.CopticChronology;
+import org.joda.time.chrono.EthiopicChronology;
+import org.joda.time.chrono.GJChronology;
+import org.joda.time.chrono.GregorianChronology;
+import org.joda.time.chrono.IslamicChronology;
+import org.joda.time.chrono.JulianChronology;
+import org.junit.jupiter.api.Test;
+
+/** The non-ISO chronologies against independent day-count models. */
+class ChronoTest {
+
+    enum Kind { JULIAN, GREGORIAN, GJ, BUDDHIST, COPTIC, ETHIOPIC, ISLAMIC_16, ISLAMIC_15, ISLAMIC_INDIAN, ISLAMIC_HABASH }
+
+    static final long NONE = Long.MIN_VALUE;
+
+    record Model(Kind kind, Chronology chrono, long minEd, long maxEd) {
+        /** Joda's (era-based) year, month, day of an epoch day, plus leap flag and month length. */
+        Cal.Ymd fields(long ed) {
+            return switch (kind) {
+                case JULIAN -> skip(Cal.julianFromEpochDay(ed));
+                case GREGORIAN -> Cal.gregorianFromEpochDay(ed);
+                case GJ -> skip(ed >= Cal.GJ_CUTOVER ? Cal.gregorianFromEpochDay(ed) : Cal.julianFromEpochDay(ed));
+                case BUDDHIST -> {
+                    Cal.Ymd g = ed >= Cal.GJ_CUTOVER ? Cal.gregorianFromEpochDay(ed) : Cal.julianFromEpochDay(ed);
+                    yield new Cal.Ymd(g.year() + 543, g.month(), g.day());
+                }
+                case COPTIC -> skip(Cal.fixedFromEpochDay(Cal.COPTIC_EPOCH, ed));
+                case ETHIOPIC -> skip(Cal.fixedFromEpochDay(Cal.ETHIOPIC_EPOCH, ed));
+                default -> Cal.islamicFromEpochDay(pattern(), ed);
+            };
+        }
+
+        int pattern() {
+            return switch (kind) {
+                case ISLAMIC_15 -> 623158436;
+                case ISLAMIC_16 -> 623191204;
+                case ISLAMIC_INDIAN -> 690562340;
+                case ISLAMIC_HABASH -> 153692453;
+                default -> throw new IllegalStateException();
+            };
+        }
+
+        static Cal.Ymd skip(Cal.Ymd a) {
+            return new Cal.Ymd(Cal.skipZero(a.year()), a.month(), a.day());
+        }
+
+        /** The epoch day of Joda-style fields, or NONE if the model rejects them (an invalid date). */
+        long epochDay(long y, int m, int d) {
+            if (m < 1 || d < 1) {
+                return NONE;
+            }
+            switch (kind) {
+                case JULIAN, GREGORIAN, GJ, BUDDHIST -> {
+                    long a = kind == Kind.BUDDHIST ? y - 543 : kind == Kind.GREGORIAN ? y : Cal.unskipZero(y);
+                    if (kind != Kind.BUDDHIST && kind != Kind.GREGORIAN && y == 0 || m > 12) {
+                        return NONE;
+                    }
+                    boolean greg = kind == Kind.GREGORIAN;
+                    if (kind == Kind.GJ || kind == Kind.BUDDHIST) {
+                        // the month is Gregorian if its Gregorian version ends at or after the cutover
+                        long gEnd = Cal.gregorianEpochDay(a, m, Cal.monthLength(m, Cal.gregorianLeap(a)));
+                        greg = gEnd >= Cal.GJ_CUTOVER;
+                        long jStart = Cal.julianEpochDay(a, m, 1);
+                        if (greg && jStart < Cal.GJ_CUTOVER) {
+                            // the cutover month (October 1582): Gregorian days 15..31 exist, plus Julian days 1..4
+                            long ge = Cal.gregorianEpochDay(a, m, d);
+                            if (d <= Cal.monthLength(m, Cal.gregorianLeap(a)) && ge >= Cal.GJ_CUTOVER) {
+                                return ge;
+                            }
+                            long je = Cal.julianEpochDay(a, m, d);
+                            return je < Cal.GJ_CUTOVER ? je : NONE;
+                        }
+                    }
+                    if (greg) {
+                        return d <= Cal.monthLength(m, Cal.gregorianLeap(a)) ? Cal.gregorianEpochDay(a, m, d) : NONE;
+                    }
+                    return d <= Cal.monthLength(m, Cal.julianLeap(a)) ? Cal.julianEpochDay(a, m, d) : NONE;
+                }
+                case COPTIC, ETHIOPIC -> {
+                    long a = Cal.unskipZero(y);
+                    if (y == 0 || m > 13 || d > Cal.fixedMonthLength(a, m)) {
+                        return NONE;
+                    }
+                    return Cal.fixedEpochDay(kind == Kind.COPTIC ? Cal.COPTIC_EPOCH : Cal.ETHIOPIC_EPOCH, a, m, d);
+                }
+                default -> {
+                    if (y < 1 || m > 12 || d > Cal.islamicMonthLength(pattern(), y, m)) {
+                        return NONE;
+                    }
+                    return Cal.islamicEpochDay(pattern(), y, m, d);
+                }
+            }
+        }
+
+        boolean leap(long y) {
+            return switch (kind) {
+                case JULIAN -> Cal.julianLeap(Cal.unskipZero(y));
+                case GREGORIAN -> Cal.gregorianLeap(y);
+                case GJ -> Cal.unskipZero(y) > 1582 ? Cal.gregorianLeap(Cal.unskipZero(y)) : Cal.julianLeap(Cal.unskipZero(y));
+                case BUDDHIST -> y - 543 > 1582 ? Cal.gregorianLeap(y - 543) : Cal.julianLeap(y - 543);
+                case COPTIC, ETHIOPIC -> Cal.fixedLeap(Cal.unskipZero(y));
+                default -> Cal.islamicLeap(pattern(), y);
+            };
+        }
+
+        int monthsInYear() {
+            return kind == Kind.COPTIC || kind == Kind.ETHIOPIC ? 13 : 12;
+        }
+    }
+
+    /**
+     * Whether GJ's conversion of Gregorian fields to a Julian date is known to lose this date: February 29 of a Julian
+     * leap year before the cutover whose GJ year number (no year zero) is not a Gregorian leap year. The GJ constructor
+     * rejects such a day; year and month arithmetic from a Gregorian date (GJ and Buddhist) clamps it to the 28th.
+     */
+    static boolean gjLosesTheLeapDay(Model m, long y, int mo, int d) {
+        if (!Known.GJ_GET_DATE_TIME_MILLIS_REJECTS_JULIAN_LEAP_DAYS || mo != 2 || d != 29 || m.kind() == Kind.GJ && y == 0) {
+            return false;
+        }
+        long a = switch (m.kind()) {
+            case GJ -> Cal.unskipZero(y);
+            case BUDDHIST -> y - 543;
+            default -> Long.MIN_VALUE;
+        };
+        return a != Long.MIN_VALUE && Cal.julianLeap(a) && !Cal.gregorianLeap(Cal.skipZero(a)) && Cal.julianEpochDay(a, 2, 29) < Cal.GJ_CUTOVER;
+    }
+
+    /** Whether getMaximumValue(ReadablePartial) is known to be wrong for this chronology and year (bugs 8 and 9). */
+    static boolean partialMaximaBroken(Model m, long year) {
+        if (Known.PARTIAL_MAXIMA_USE_THE_ERA_YEAR && (year < 0 && (m.kind() == Kind.JULIAN || m.kind() == Kind.GJ) || m.kind() == Kind.BUDDHIST)) {
+            return true;
+        }
+        return Known.LIMIT_CHRONOLOGY_PARTIAL_MAXIMA_IGNORE_THE_PARTIAL && (m.kind() == Kind.COPTIC || m.kind() == Kind.ETHIOPIC || m.kind().name().startsWith("ISLAMIC"));
+    }
+
+    static Model model(Kind k) {
+        DateTimeZone utc = DateTimeZone.UTC;
+        Chronology c = switch (k) {
+            case JULIAN -> JulianChronology.getInstanceUTC();
+            case GREGORIAN -> GregorianChronology.getInstanceUTC();
+            case GJ -> GJChronology.getInstanceUTC();
+            case BUDDHIST -> BuddhistChronology.getInstanceUTC();
+            case COPTIC -> CopticChronology.getInstanceUTC();
+            case ETHIOPIC -> EthiopicChronology.getInstanceUTC();
+            case ISLAMIC_16 -> IslamicChronology.getInstance(utc, IslamicChronology.LEAP_YEAR_16_BASED);
+            case ISLAMIC_15 -> IslamicChronology.getInstance(utc, IslamicChronology.LEAP_YEAR_15_BASED);
+            case ISLAMIC_INDIAN -> IslamicChronology.getInstance(utc, IslamicChronology.LEAP_YEAR_INDIAN);
+            case ISLAMIC_HABASH -> IslamicChronology.getInstance(utc, IslamicChronology.LEAP_YEAR_HABASH_AL_HASIB);
+        };
+        long minEd = -100_000_000L;
+        long maxEd = 100_000_000L;
+        if (k.name().startsWith("ISLAMIC")) {
+            minEd = Cal.ISLAMIC_EPOCH;
+        } else if (k == Kind.BUDDHIST) {
+            minEd = Cal.julianEpochDay(-542, 1, 1);
+        } else if (k == Kind.COPTIC) {
+            minEd = Cal.COPTIC_EPOCH;
+        } else if (k == Kind.ETHIOPIC) {
+            minEd = Cal.ETHIOPIC_EPOCH;
+        }
+        return new Model(k, c, minEd, maxEd);
+    }
+
+    // ---- the cases ---------------------------------------------------------------------------------------------
+
+    /** The epochs of the fixed and Islamic calendars and the days around year 1 (Julian and Buddhist). */
+    static final List<Long> EPOCHS = List.of(Cal.COPTIC_EPOCH, Cal.ETHIOPIC_EPOCH, Cal.ISLAMIC_EPOCH, Cal.julianEpochDay(0, 12, 31),
+        Cal.julianEpochDay(1, 1, 1), Cal.julianEpochDay(-542, 12, 31), Cal.julianEpochDay(-543, 1, 1));
+
+    /**
+     * An epoch day in the model's range: {@link Gen#EPOCH_DAY} (77%), within 40 days of the GJ cutover (15%) or
+     * within two days of a calendar's epoch or year 1 (8%); a day outside the range is folded into it.
+     */
+    static Generator<Long> epochDay(Model m) {
+        return weighted(
+                w(77, Gen.EPOCH_DAY),
+                w(15, ints(-40, 40).map(d -> Cal.GJ_CUTOVER + d)),
+                w(8, tuples(sampledFrom(EPOCHS), ints(-2, 2)).map(t -> t.value1() + t.value2())))
+            .map(ed -> ed < m.minEd() || ed > m.maxEd() ? Math.floorMod(ed, m.maxEd() - m.minEd()) + m.minEd() : ed);
+    }
+
+    /**
+     * The chronologies a LocalDate computes with: while joda-time/5 stands the Indian, 15-based and Habash al-Hasib
+     * Islamic patterns are left out (LocalDate calls withUTC(), which loses the pattern; islamicPatternsAgreeThroughDateTimes
+     * covers them through DateTime).
+     */
+    static final List<Kind> LOCAL_DATE_KINDS = Arrays.stream(Kind.values())
+            .filter(k -> !(Known.ISLAMIC_WITH_ZONE_DROPS_THE_LEAP_YEAR_PATTERN && k.name().startsWith("ISLAMIC") && k != Kind.ISLAMIC_16))
+            .toList();
+
+    /** A step of up to a thousand days (70%) or two million. */
+    static final Generator<Integer> DAY_STEP = weighted(w(70, ints(-1000, 1000)), w(30, ints(-2_000_000, 2_000_000)));
+
+    /**
+     * The chronology, an epoch day in its range, a month and a day to build in that year (each one past the range),
+     * and the steps of the day and year arithmetic.
+     */
+    record ChronoCase(Kind kind, long ed, int month, int day, int days, int years) {}
+
+    static final Generator<ChronoCase> CHRONO_CASE = sampledFrom(LOCAL_DATE_KINDS).flatMap(k -> {
+        Model m = model(k);
+        return tuples(epochDay(m), ints(1, m.monthsInYear() + 1), ints(1, 32), DAY_STEP, ints(-3000, 3000))
+                .map(t -> new ChronoCase(k, t.value1(), t.value2(), t.value3(), t.value4(), t.value5()));
+    });
+
+    /** An Islamic chronology, an epoch day in its range and the step of the year arithmetic. */
+    record IslamicCase(Kind kind, long ed, int years) {}
+
+    static final Generator<IslamicCase> ISLAMIC_CASE = sampledFrom(Kind.ISLAMIC_16, Kind.ISLAMIC_15, Kind.ISLAMIC_INDIAN, Kind.ISLAMIC_HABASH)
+            .flatMap(k -> tuples(epochDay(model(k)), ints(-3000, 3000)).map(t -> new IslamicCase(k, t.value1(), t.value2())));
+
+    @Test
+    void calendarFieldsAgreeWithTheDayCountModels() {
+        Zoo.property("calendarFieldsAgreeWithTheDayCountModels", tc -> {
+            ChronoCase c = tc.draw(CHRONO_CASE, "case");
+            Model m = model(c.kind());
+            long ed = c.ed();
+            LocalDate d = new LocalDate(ed * Gen.DAY, m.chrono());
+            Cal.Ymd want = m.fields(ed);
+            String at = m.kind() + " epoch day " + ed + " (ISO " + java.time.LocalDate.ofEpochDay(ed) + ")";
+            check(d.getYear() == want.year() && d.getMonthOfYear() == want.month() && d.getDayOfMonth() == want.day(),
