+            for (int i = 0; i < Math.min(len, newLen); i++) {
+                int i0 = i;
+                check(IntBigArrays.get(grown, i) == got[i], () -> "forceCapacity lost element " + i0);
+            }
+            int[] back = new int[len];
+            IntBigArrays.copyFromBig(b, 0, back, 0, len);
+            check(Arrays.equals(back, got), () -> "copyFromBig " + show(back));
+            check(IntBigArrays.equals(b, IntBigArrays.wrap(got)), () -> "IntBigArrays.equals with the wrapped result");
+        });
+    }
+}
