+                            } else {
+                                al.ensureCapacity(n(tc, 0, 40));
+                            }
+                        }
+                    }
+                    case 23 -> {
+                        // boxed positional methods
+                        script.add("Add(" + idx + "," + x + ")");
+                        model.add(idx, x);
+                        fu.add(idx, Integer.valueOf(x));
+                        if (pos >= 0) {
+                            script.add("Remove(" + pos + ")");
+                            Integer exp = model.remove(pos);
+                            Integer got = fu.remove(pos);
+                            check(exp.equals(got), () -> "boxed remove(int) returned " + got + " expected " + exp + info.get());
+                        }
+                    }
+                    default -> {
+                        script.add("indexOf");
+                    }
+                }
+                check(fu.size() == model.size() && fu.isEmpty() == model.isEmpty(), () -> "size " + fu.size() + " expected " + model.size() + info.get());
+                check(fu.indexOf(x) == model.indexOf(x) && fu.lastIndexOf(x) == model.lastIndexOf(x), () -> "indexOf/lastIndexOf(" + x + ") " + fu.indexOf(x) + "/" + fu.lastIndexOf(x) + " expected " + model.indexOf(x) + "/" + model.lastIndexOf(x) + info.get());
+                check(fu.indexOf(Integer.valueOf(x)) == model.indexOf(x), () -> "boxed indexOf" + info.get());
+                check(fu.contains(x) == model.contains(x), () -> "contains(" + x + ")" + info.get());
+                if (!model.isEmpty()) {
+                    int p = n(tc, 0, model.size() - 1);
+                    check(fu.getInt(p) == model.get(p) && fu.get(p).equals(model.get(p)), () -> "getInt(" + p + ") " + fu.getInt(p) + " expected " + model.get(p) + info.get());
+                }
+                // any IndexOutOfBoundsException satisfies the List contract (the big list throws the array subclass)
+                check(Zoo.outOfBounds(() -> fu.getInt(model.size())), () -> "getInt(size) throws " + Zoo.throwsClass(() -> fu.getInt(model.size())) + info.get());
+                check(Zoo.outOfBounds(() -> fu.getInt(-1)), () -> "getInt(-1) throws " + Zoo.throwsClass(() -> fu.getInt(-1)) + info.get());
+                check(Zoo.outOfBounds(() -> fu.add(model.size() + 1, 0)), () -> "add(size+1) throws " + Zoo.throwsClass(() -> fu.add(model.size() + 1, 0)) + info.get());
+                if (chance(tc, 30)) {
+                    compareState(fu, model, info);
+                }
+            }
+            compareState(fu, model, info);
+        });
+    }
+
+    static void compareState(IntList fu, List<Integer> model, Supplier<String> info) {
+        List<Integer> got = elements(fu);
+        check(got.equals(model), () -> "elements " + got + " expected " + model + info.get());
+        int[] arr = fu.toIntArray();
+        check(Arrays.equals(arr, arr(model)), () -> "toIntArray " + Arrays.toString(arr) + info.get());
+        check(Arrays.equals(fu.toArray(new int[0]), arr) && Arrays.equals(Arrays.copyOf(fu.toIntArray(new int[arr.length + 2]), arr.length), arr), () -> "toArray variants" + info.get());
+        check(fu.equals(model) && model.equals(fu), () -> "equality with the model" + info.get());
+        check(fu.hashCode() == model.hashCode(), () -> "hashCode " + fu.hashCode() + " expected " + model.hashCode() + info.get());
+        IntList copy = new IntArrayList(fu);
+        check(copy.equals(fu) && fu.equals(copy) && fu.compareTo(copy) == 0, () -> "copy equality / compareTo" + info.get());
+        IntList imm = new IntImmutableList(fu);
+        check(imm.equals(fu) && fu.equals(imm) && imm.hashCode() == fu.hashCode() && elements(imm).equals(model), () -> "immutable copy " + imm + info.get());
+        check(IntLists.unmodifiable(fu).equals(model) && IntLists.unmodifiable(fu).hashCode() == model.hashCode(), () -> "unmodifiable view" + info.get());
+        // compareTo is lexicographic
+        if (!model.isEmpty()) {
+            IntList bigger = new IntArrayList(fu);
+            bigger.add(Integer.MIN_VALUE);
+            check(fu.compareTo(bigger) < 0 && bigger.compareTo(fu) > 0, () -> "compareTo with a longer list" + info.get());
+            IntList changed = new IntArrayList(fu);
+            int last = model.size() - 1;
+            if (changed.getInt(last) != Integer.MAX_VALUE) {
+                changed.set(last, changed.getInt(last) + 1);
+                check(fu.compareTo(changed) < 0 && changed.compareTo(fu) > 0, () -> "compareTo with a greater last element" + info.get());
+            }
+        }
+        // streams and spliterators
+        long sum = 0;
+        for (int x : model) {
+            sum += x;
+        }
+        long expSum = sum;
+        check(fu.intStream().asLongStream().sum() == expSum, () -> "intStream sum" + info.get());
+        check(fu.intParallelStream().asLongStream().sum() == expSum, () -> "intParallelStream sum" + info.get());
+        check(fu.stream().mapToLong(Integer::longValue).sum() == expSum, () -> "stream sum" + info.get());
+        IntSpliterator sp = fu.spliterator();
+        check(sp.estimateSize() == model.size(), () -> "estimateSize " + sp.estimateSize() + info.get());
+        check(sp.hasCharacteristics(java.util.Spliterator.ORDERED) && sp.hasCharacteristics(java.util.Spliterator.SIZED), () -> "spliterator characteristics " + sp.characteristics() + info.get());
+        List<Integer> fromSplits = new ArrayList<>();
+        IntSpliterator first = sp.trySplit();
+        if (first != null) {
+            first.forEachRemaining((int x) -> fromSplits.add(x));
+        }
+        sp.forEachRemaining((int x) -> fromSplits.add(x));
+        check(fromSplits.equals(model), () -> "split spliterator elements " + fromSplits + info.get());
+        // skip through iterators
+        if (!model.isEmpty()) {
+            int s = model.size() / 2;
+            IntIterator it = fu.iterator();
+            int skipped = it.skip(s);
+            check(skipped == s, () -> "skip(" + s + ") returned " + skipped + info.get());
+            List<Integer> rest = new ArrayList<>();
+            it.forEachRemaining((int x) -> rest.add(x));
+            check(rest.equals(model.subList(s, model.size())), () -> "rest after skip " + rest + info.get());
+            IntListIterator li = fu.listIterator(model.size());
+            int back = li.back(s + 1);
+            check(back == s + 1, () -> "back(" + (s + 1) + ") returned " + back + info.get());
+            check(li.nextIndex() == model.size() - s - 1, () -> "nextIndex after back " + li.nextIndex() + info.get());
+            IntSpliterator sp2 = fu.spliterator();
+            long sk = sp2.skip(s);
+            check(sk == s, () -> "spliterator skip(" + s + ") returned " + sk + info.get());
+            List<Integer> rest2 = new ArrayList<>();
+            sp2.forEachRemaining((int x) -> rest2.add(x));
+            check(rest2.equals(model.subList(s, model.size())), () -> "spliterator rest after skip " + rest2 + info.get());
+        }
+        // sub list views read like the model's
+        int size = model.size();
+        for (int from0 = 0; from0 <= size; from0 += Math.max(1, size / 3)) {
+            for (int to0 = from0; to0 <= size; to0 += Math.max(1, size / 3)) {
+                int from = from0, to = to0;
+                IntList fv = fu.subList(from, to);
+                List<Integer> mv = model.subList(from, to);
+                check(elements(fv).equals(mv) && fv.equals(mv) && fv.hashCode() == mv.hashCode(), () -> "subList(" + from + "," + to + ") " + fv + " expected " + mv + info.get());
+                check(Arrays.equals(fv.toIntArray(), arr(mv)), () -> "subList toIntArray" + info.get());
+                if (to > from) {
+                    check(fv.indexOf(mv.get(0)) == mv.indexOf(mv.get(0)) && fv.lastIndexOf(mv.get(mv.size() - 1)) == mv.lastIndexOf(mv.get(mv.size() - 1)), () -> "subList indexOf" + info.get());
+                    IntList inner = fv.subList(0, fv.size() - 1);
+                    check(elements(inner).equals(mv.subList(0, mv.size() - 1)), () -> "subList of a subList " + inner + info.get());
+                }
+            }
+        }
+    }
+
+    /**
+     * An {@code IntBigList} seen as an {@code IntList} for the script (indexes are small): every
+     * operation the big list has is delegated, so its own code runs; only the list iterators come
+     * from {@code AbstractIntList} (a big list iterator indexes with longs).
+     */
+    static final class BigAsList extends it.unimi.dsi.fastutil.ints.AbstractIntList {
+        final IntBigList big;
+
+        BigAsList(IntBigList big) {
+            this.big = big;
+        }
+
+        @Override public int getInt(int i) { return big.getInt(i); }
+        @Override public int size() { return (int) big.size64(); }
+        @Override public boolean isEmpty() { return big.isEmpty(); }
+        @Override public boolean add(int k) { return big.add(k); }
+        @Override public void add(int i, int k) { big.add(i, k); }
+        @Override public int set(int i, int k) { return big.set(i, k); }
+        @Override public int removeInt(int i) { return big.removeInt(i); }
+        @Override public void size(int s) { big.size(s); }
+        @Override public void removeElements(int from, int to) { big.removeElements(from, to); }
+        @Override public void addElements(int i, int[] a, int off, int len) { big.addElements(i, new int[][] {a}, off, len); }
+        @Override public void getElements(int from, int[] a, int off, int len) { big.getElements(from, new int[][] {a}, off, len); }
+        @Override public void setElements(int i, int[] a, int off, int len) { big.setElements(i, new int[][] {a}, off, len); }
+        @Override public int indexOf(int k) { return (int) big.indexOf(k); }
+        @Override public int lastIndexOf(int k) { return (int) big.lastIndexOf(k); }
+        @Override public boolean contains(int k) { return big.contains(k); }
+        @Override public boolean rem(int k) { return big.rem(k); }
+        @Override public boolean addAll(IntCollection c) { return big.addAll(c); }
+        @Override public boolean addAll(int i, IntCollection c) { return big.addAll(i, c); }
+        @Override public boolean addAll(int i, java.util.Collection<? extends Integer> c) { return big.addAll(i, c); }
+        @Override public boolean removeAll(IntCollection c) { return big.removeAll(c); }
+        @Override public boolean removeAll(java.util.Collection<?> c) { return big.removeAll(c); }
+        @Override public boolean retainAll(IntCollection c) { return big.retainAll(c); }
+        @Override public boolean retainAll(java.util.Collection<?> c) { return big.retainAll(c); }
+        @Override public boolean removeIf(java.util.function.IntPredicate p) { return big.removeIf(p); }
+        @Override public int[] toIntArray() { return big.toIntArray(); }
+        @Override public IntList subList(int from, int to) { return new BigAsList(big.subList(from, to)); }
+        @Override public void clear() { big.clear(); }
+        @Override public String toString() { return big.toString(); }
+    }
+}
