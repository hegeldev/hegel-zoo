+            check(Arrays.equals(got, exp), () -> "big " + names[alg] + " [" + from + "," + to + ") gave " + show(got) + " expected " + show(exp) + "\norig " + show(flat));
+            if (to > from) {
+                int probe = chance(tc, 50) ? exp[n(tc, from, to - 1)] : n(tc, -20, 20);
+                long r = IntBigArrays.binarySearch(b, from, to, probe);
+                int e = Arrays.binarySearch(exp, from, to, probe);
+                check(e >= 0 ? r >= from && r < to && exp[(int) r] == probe : r == e, () -> "big binarySearch(" + probe + ") = " + r + " expected " + e);
