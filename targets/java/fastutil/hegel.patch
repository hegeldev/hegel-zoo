+                        model.put(k, (old == null ? drv : old) + v);
+                        int got = switch (fu) {
+                            case Int2IntOpenHashMap m -> m.addTo(k, v);
+                            case Int2IntLinkedOpenHashMap m -> m.addTo(k, v);
+                            case Int2IntOpenCustomHashMap m -> m.addTo(k, v);
+                            case Int2IntAVLTreeMap m -> m.addTo(k, v);
+                            case Int2IntRBTreeMap m -> m.addTo(k, v);
+                            default -> { model.put(k, exp); if (old == null) { model.remove(k); } yield exp; }
+                        };
+                        check(got == exp, () -> "addTo returned " + got + " expected " + exp + info.get());
+                    }
+                    case 20 -> {
+                        script.add("keySet().remove(" + k + ")");
+                        boolean exp = model.keySet().remove(k);
+                        boolean got = fu.keySet().remove(k);
+                        check(got == exp, () -> "keySet().remove returned " + got + " expected " + exp + info.get());
+                    }
+                    case 21 -> {
+                        int m = pick(tc, 2, 3, 5);
+                        script.add("keySet().removeIf(k%" + m + "==0)");
