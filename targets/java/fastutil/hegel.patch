+        });
+    }
+
+    @Test
+    void bigArraysSortAndSearchLikeArrays() {
+        Zoo.run("bigArraysSortAndSearchLikeArrays", tc -> {
+            int len = pick(tc, n(tc, 0, 8), n(tc, 0, 100), n(tc, 0, 5000));
