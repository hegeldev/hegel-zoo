+                case 1 -> ObjectArrays.stableSort(a, from, to, byKey);
+                case 2 -> ObjectArrays.quickSort(a, from, to, byKey);
+                default -> ObjectArrays.parallelQuickSort(a, from, to, byKey);
+            }
+            for (int i = from + 1; i < to; i++) {
+                int i0 = i;
+                check(a[i - 1][0] <= a[i][0], () -> names[alg] + " not sorted at " + i0 + ": " + Arrays.deepToString(a));
