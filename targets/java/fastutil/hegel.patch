+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.NoSuchElementException;
+import java.util.SortedMap;
+import java.util.TreeMap;
+import java.util.function.Supplier;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Every {@code Int2IntMap} implementation against the {@code java.util} map of the same contract: a
+ * random script of the interface's operations (primitive and boxed) runs on both, each return value
+ * is compared, and the states are compared after every step.
+ */
+class MapsTest {
+
+    /**
+     * Strategy equal to the natural one, so the model stays a plain map. Its hash must be
+     * Integer.hashCode: a custom map hashes its entries with the strategy (by design, since the
+     * strategy defines key equality), and the model's hashCode is java.util's.
+     */
+    static final IntHash.Strategy NATURAL = new IntHash.Strategy() {
+        @Override public int hashCode(int e) { return Integer.hashCode(e); }
+        @Override public boolean equals(int a, int b) { return a == b; }
+    };
+
+    record Kind(String name, Supplier<Int2IntMap> make, boolean sorted, boolean linked) {}
+
+    static List<Kind> kinds(TestCase tc) {
+        int cap = pick(tc, 0, 1, 2, 16, 64);
+        float lf = pick(tc, 0.75f, 0.5f, 0.25f, 0.95f);
+        return List.of(
+            new Kind("Int2IntOpenHashMap(" + cap + "," + lf + ")", () -> new Int2IntOpenHashMap(cap, lf), false, false),
+            new Kind("Int2IntLinkedOpenHashMap(" + cap + "," + lf + ")", () -> new Int2IntLinkedOpenHashMap(cap, lf), false, true),
+            new Kind("Int2IntOpenCustomHashMap(" + cap + "," + lf + ")", () -> new Int2IntOpenCustomHashMap(cap, lf, NATURAL), false, false),
+            new Kind("Int2IntAVLTreeMap", Int2IntAVLTreeMap::new, true, false),
+            new Kind("Int2IntRBTreeMap", Int2IntRBTreeMap::new, true, false),
+            new Kind("Int2IntArrayMap(" + cap + ")", () -> new Int2IntArrayMap(cap), false, false));
+    }
+
+    /** Keys from a small pool so that hits and misses are both frequent. */
+    static int key(TestCase tc) {
+        return switch (n(tc, 0, 9)) {
+            case 0 -> pick(tc, Integer.MIN_VALUE, Integer.MAX_VALUE, -1, 0, 1, 0x7fffffff, 0x80000000);
+            case 1 -> n(tc, -1000000, 1000000);
+            default -> n(tc, -12, 12);
+        };
+    }
+
+    static int value(TestCase tc) {
+        return switch (n(tc, 0, 5)) {
+            case 0 -> pick(tc, Integer.MIN_VALUE, Integer.MAX_VALUE, -1, 0);
+            default -> n(tc, -5, 5);
+        };
+    }
+
+    /** The map's state as an ordered list of "k=v", in iteration order. */
+    static List<String> entries(Map<Integer, Integer> m) {
+        List<String> out = new ArrayList<>();
+        for (Map.Entry<Integer, Integer> e : m.entrySet()) {
+            out.add(e.getKey() + "=" + e.getValue());
+        }
+        return out;
+    }
+
+    static List<String> entriesFast(Int2IntMap m) {
+        List<String> out = new ArrayList<>();
+        ObjectIterator<Int2IntMap.Entry> it = Int2IntMaps.fastIterator(m);
+        while (it.hasNext()) {
+            Int2IntMap.Entry e = it.next();
+            out.add(e.getIntKey() + "=" + e.getIntValue());
+        }
+        return out;
+    }
+
+    static String sortedString(List<String> xs) {
+        List<String> c = new ArrayList<>(xs);
+        c.sort(null);
+        return c.toString();
+    }
+
+    @Test
+    void mapsMatchTheJavaUtilModel() {
+        Zoo.run("mapsMatchTheJavaUtilModel", tc -> {
+            Kind kind = pick(tc, kinds(tc).toArray(Kind[]::new));
+            boolean ordered = kind.sorted || kind.linked;
+            count(kind.name.replaceAll("\\(.*", ""));
+            Int2IntMap fu = kind.make.get();
+            Map<Integer, Integer> model = kind.sorted ? new TreeMap<>() : new LinkedHashMap<>();
+            int drv = chance(tc, 30) ? pick(tc, -1, 7, Integer.MIN_VALUE) : 0;
+            if (drv != 0) {
+                fu.defaultReturnValue(drv);
+            }
+            List<String> script = new ArrayList<>();
+            Supplier<String> info = () -> "\n" + kind.name + " drv=" + fu.defaultReturnValue() + "\nscript " + script + "\nfastutil " + fu + "\nmodel " + model;
+            int steps = n(tc, 0, 40);
+            for (int i = 0; i < steps; i++) {
+                int k = key(tc), v = value(tc);
+                int op = n(tc, 0, 27);
+                switch (op) {
+                    case 0, 1, 2, 3 -> {
+                        script.add("put(" + k + "," + v + ")");
+                        Integer old = model.put(k, v);
+                        int got = fu.put(k, v);
+                        check(got == (old == null ? drv : old), () -> "put returned " + got + " expected " + (old == null ? drv : old) + info.get());
+                    }
+                    case 4 -> {
+                        script.add("Put(" + k + "," + v + ")");
+                        Integer old = model.put(k, v);
+                        Integer got = fu.put(Integer.valueOf(k), Integer.valueOf(v));
+                        check(java.util.Objects.equals(got, old), () -> "boxed put returned " + got + " expected " + old + info.get());
+                    }
+                    case 5, 6 -> {
+                        script.add("remove(" + k + ")");
+                        Integer old = model.remove(k);
+                        int got = fu.remove(k);
+                        check(got == (old == null ? drv : old), () -> "remove returned " + got + " expected " + (old == null ? drv : old) + info.get());
+                    }
+                    case 7 -> {
+                        script.add("Remove(" + k + ")");
+                        Integer old = model.remove(k);
+                        Integer got = fu.remove(Integer.valueOf(k));
+                        check(java.util.Objects.equals(got, old), () -> "boxed remove returned " + got + " expected " + old + info.get());
+                    }
+                    case 8 -> {
+                        script.add("putIfAbsent(" + k + "," + v + ")");
+                        Integer old = model.putIfAbsent(k, v);
+                        int got = fu.putIfAbsent(k, v);
+                        check(got == (old == null ? drv : old), () -> "putIfAbsent returned " + got + " expected " + (old == null ? drv : old) + info.get());
+                    }
+                    case 9 -> {
+                        script.add("replace(" + k + "," + v + ")");
+                        Integer old = model.replace(k, v);
+                        int got = fu.replace(k, v);
+                        check(got == (old == null ? drv : old), () -> "replace returned " + got + " expected " + (old == null ? drv : old) + info.get());
+                    }
+                    case 10 -> {
+                        int w = chance(tc, 50) && model.containsKey(k) ? model.get(k) : value(tc);
+                        script.add("replace(" + k + "," + w + "," + v + ")");
+                        boolean exp = model.replace(k, w, v);
+                        boolean got = fu.replace(k, w, v);
+                        check(got == exp, () -> "replace(k,old,new) returned " + got + " expected " + exp + info.get());
+                    }
+                    case 11 -> {
+                        int w = chance(tc, 50) && model.containsKey(k) ? model.get(k) : value(tc);
+                        script.add("remove(" + k + "," + w + ")");
+                        boolean exp = model.remove(k, w);
+                        boolean got = fu.remove(k, w);
+                        check(got == exp, () -> "remove(k,v) returned " + got + " expected " + exp + info.get());
+                    }
+                    case 12 -> {
+                        script.add("merge(" + k + "," + v + ",+)");
+                        Integer exp = model.merge(k, v, Integer::sum);
+                        int got = fu.merge(k, v, Integer::sum);
+                        check(got == exp, () -> "merge returned " + got + " expected " + exp + info.get());
+                    }
+                    case 13 -> {
+                        // a merge whose function removes when the sum is even
+                        script.add("mergeInt(" + k + "," + v + ",max)");
+                        Integer exp = model.merge(k, v, Math::max);
+                        int got = fu.mergeInt(k, v, Math::max);
+                        check(got == exp, () -> "mergeInt returned " + got + " expected " + exp + info.get());
+                    }
+                    case 14 -> {
