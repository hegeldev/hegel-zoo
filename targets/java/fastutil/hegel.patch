index 0000000..40e4bf6
--- /dev/null
+++ b/hegel/src/test/java/zoo/ArraysTest.java
@@ -0,0 +1,484 @@
+package zoo;
+
+import static zoo.Zoo.check;
+import static zoo.Zoo.chance;
+import static zoo.Zoo.count;
+import static zoo.Zoo.n;
+import static zoo.Zoo.pick;
+
+import dev.hegel.TestCase;
+import it.unimi.dsi.fastutil.BigArrays;
+import it.unimi.dsi.fastutil.doubles.DoubleArrays;
+import it.unimi.dsi.fastutil.floats.FloatArrays;
+import it.unimi.dsi.fastutil.ints.IntArrays;
+import it.unimi.dsi.fastutil.ints.IntBigArrays;
+import it.unimi.dsi.fastutil.ints.IntComparator;
+import it.unimi.dsi.fastutil.longs.LongArrays;
+import it.unimi.dsi.fastutil.objects.ObjectArrays;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Comparator;
+import java.util.List;
+import java.util.function.Supplier;
+import org.junit.jupiter.api.Test;
+
+/**
+ * The sorting and searching routines of {@code IntArrays} (and the double/float/long/Object
+ * variants for the floating-point orderings and stability) against {@code java.util.Arrays}:
+ * every algorithm on ranges of random arrays, with a comparator, in parallel, indirectly (a
+ * permutation) and on two arrays at once, plus radix sorts, {@code stabilize}, binary search,
+ * {@code shuffle}, {@code reverse} and the big-array versions.
+ */
+class ArraysTest {
+
+    static int[] ints(TestCase tc, int len) {
+        int[] a = new int[len];
+        int spread = pick(tc, 3, 10, 1000, Integer.MAX_VALUE);
+        for (int i = 0; i < len; i++) {
+            a[i] = spread == Integer.MAX_VALUE ? pick(tc, Integer.MIN_VALUE, Integer.MAX_VALUE, 0, -1, n(tc, -1000000000, 1000000000)) : n(tc, -spread, spread);
+        }
+        return a;
+    }
+
+    static int[] identity(int len) {
+        int[] p = new int[len];
+        for (int i = 0; i < len; i++) {
+            p[i] = i;
+        }
+        return p;
+    }
+
+    static String show(int[] a) {
+        return a.length > 40 ? Arrays.toString(Arrays.copyOf(a, 40)) + "... (" + a.length + ")" : Arrays.toString(a);
+    }
+
+    /** True when `a` is sorted within [from, to) by `cmp` and the rest is untouched vs `orig`. */
+    static void checkSorted(int[] a, int[] orig, int from, int to, IntComparator cmp, String what, Supplier<String> info) {
+        for (int i = from + 1; i < to; i++) {
+            int x = a[i - 1], y = a[i];
+            int cmpv = cmp == null ? Integer.compare(x, y) : cmp.compare(x, y);
+            int i0 = i;
+            check(cmpv <= 0, () -> what + " not sorted at " + i0 + ": " + show(a) + info.get());
+        }
+        int[] sortedPart = Arrays.copyOfRange(orig, from, to);
+        int[] gotPart = Arrays.copyOfRange(a, from, to);
+        Arrays.sort(sortedPart);
+        Arrays.sort(gotPart);
+        check(Arrays.equals(sortedPart, gotPart), () -> what + " changed the multiset: " + show(a) + " from " + show(orig) + info.get());
+        for (int i = 0; i < orig.length; i++) {
+            if (i < from || i >= to) {
+                int j = i;
+                check(a[i] == orig[i], () -> what + " touched index " + j + " outside [" + from + "," + to + "): " + show(a) + " from " + show(orig) + info.get());
+            }
+        }
+    }
+
+    @Test
+    void sortsAgreeWithJavaUtil() {
+        Zoo.run("sortsAgreeWithJavaUtil", tc -> {
+            int len = pick(tc, n(tc, 0, 8), n(tc, 0, 40), n(tc, 0, 300), n(tc, 0, 3000));
+            int[] orig = ints(tc, len);
+            int from = n(tc, 0, len), to = n(tc, from, len);
+            boolean whole = chance(tc, 40);
+            if (whole) {
+                from = 0;
+                to = len;
+            }
+            int f = from, t = to;
+            IntComparator cmp = switch (n(tc, 0, 3)) {
+                case 0 -> null;
+                case 1 -> (a, b) -> Integer.compare(b, a);
+                case 2 -> (a, b) -> Integer.compare(Math.abs(a % 7), Math.abs(b % 7)); // many ties
+                default -> (a, b) -> Integer.compare(a & 0xff, b & 0xff);
+            };
+            String cmpName = cmp == null ? "natural" : "cmp";
+            Supplier<String> info = () -> "\nlen " + len + " range [" + f + "," + t + ") " + cmpName + "\norig " + show(orig);
+            int alg = n(tc, 0, 12);
+            String[] names = {"quickSort", "mergeSort", "stableSort", "unstableSort", "parallelQuickSort", "radixSort", "parallelRadixSort", "quickSortIndirect", "radixSortIndirect", "parallelQuickSortIndirect", "parallelRadixSortIndirect", "mergeSortWithSupport", "quickSortTwoArrays"};
+            String name = names[alg];
+            count(name);
+            int[] a = orig.clone();
+            switch (alg) {
+                case 0 -> {
+                    if (cmp == null) {
+                        if (whole) { IntArrays.quickSort(a); } else { IntArrays.quickSort(a, from, to); }
+                    } else {
+                        if (whole) { IntArrays.quickSort(a, cmp); } else { IntArrays.quickSort(a, from, to, cmp); }
+                    }
+                    checkSorted(a, orig, from, to, cmp, name, info);
+                }
+                case 1 -> {
+                    if (cmp == null) {
+                        if (whole) { IntArrays.mergeSort(a); } else { IntArrays.mergeSort(a, from, to); }
+                    } else {
+                        if (whole) { IntArrays.mergeSort(a, cmp); } else { IntArrays.mergeSort(a, from, to, cmp); }
+                    }
+                    checkSorted(a, orig, from, to, cmp, name, info);
+                    checkStable(a, orig, from, to, cmp, name, info);
+                }
+                case 2 -> {
+                    if (cmp == null) {
+                        if (whole) { IntArrays.stableSort(a); } else { IntArrays.stableSort(a, from, to); }
+                    } else {
+                        if (whole) { IntArrays.stableSort(a, cmp); } else { IntArrays.stableSort(a, from, to, cmp); }
+                    }
+                    checkSorted(a, orig, from, to, cmp, name, info);
+                    checkStable(a, orig, from, to, cmp, name, info);
+                }
+                case 3 -> {
+                    if (cmp == null) {
+                        if (whole) { IntArrays.unstableSort(a); } else { IntArrays.unstableSort(a, from, to); }
+                    } else {
+                        if (whole) { IntArrays.unstableSort(a, cmp); } else { IntArrays.unstableSort(a, from, to, cmp); }
+                    }
+                    checkSorted(a, orig, from, to, cmp, name, info);
+                }
+                case 4 -> {
+                    if (cmp == null) {
+                        if (whole) { IntArrays.parallelQuickSort(a); } else { IntArrays.parallelQuickSort(a, from, to); }
+                    } else {
+                        if (whole) { IntArrays.parallelQuickSort(a, cmp); } else { IntArrays.parallelQuickSort(a, from, to, cmp); }
+                    }
+                    checkSorted(a, orig, from, to, cmp, name, info);
+                }
+                case 5 -> {
+                    if (whole) { IntArrays.radixSort(a); } else { IntArrays.radixSort(a, from, to); }
+                    checkSorted(a, orig, from, to, null, name, info);
+                }
+                case 6 -> {
+                    if (whole) { IntArrays.parallelRadixSort(a); } else { IntArrays.parallelRadixSort(a, from, to); }
+                    checkSorted(a, orig, from, to, null, name, info);
+                }
+                case 7, 8, 9, 10 -> {
+                    // indirect sorts: a permutation of [0, len) sorted by the values
+                    int[] perm = identity(len);
+                    boolean stable = chance(tc, 50);
+                    switch (alg) {
+                        case 7 -> { if (whole) { IntArrays.quickSortIndirect(perm, orig); } else { IntArrays.quickSortIndirect(perm, orig, from, to); } }
+                        case 8 -> { if (whole) { IntArrays.radixSortIndirect(perm, orig, stable); } else { IntArrays.radixSortIndirect(perm, orig, from, to, stable); } }
+                        case 9 -> { if (whole) { IntArrays.parallelQuickSortIndirect(perm, orig); } else { IntArrays.parallelQuickSortIndirect(perm, orig, from, to); } }
+                        default -> { if (whole) { IntArrays.parallelRadixSortIndirect(perm, orig, stable); } else { IntArrays.parallelRadixSortIndirect(perm, orig, from, to, stable); } }
+                    }
+                    int[] expPerm = identity(len);
+                    check(Arrays.equals(orig, a), () -> name + " modified the values" + info.get());
+                    // the range of the permutation is a permutation of [from, to) sorted by value
+                    int[] slice = Arrays.copyOfRange(perm, from, to);
+                    int[] sortedSlice = slice.clone();
+                    Arrays.sort(sortedSlice);
+                    check(Arrays.equals(sortedSlice, Arrays.copyOfRange(expPerm, from, to)), () -> name + " perm range is not a permutation of [" + f + "," + t + "): " + show(perm) + info.get());
+                    for (int i = from + 1; i < to; i++) {
+                        int i0 = i;
+                        check(orig[perm[i - 1]] <= orig[perm[i]], () -> name + " perm not sorted at " + i0 + ": " + show(perm) + info.get());
+                        if (stable && (alg == 8 || alg == 10)) {
+                            check(orig[perm[i - 1]] < orig[perm[i]] || perm[i - 1] < perm[i], () -> name + " stable=true but ties reordered at " + i0 + ": " + show(perm) + info.get());
+                        }
+                    }
+                    for (int i = 0; i < len; i++) {
+                        if (i < from || i >= to) {
+                            int j = i;
+                            check(perm[i] == i, () -> name + " touched perm index " + j + info.get());
+                        }
+                    }
+                    if (alg == 8 && !stable && chance(tc, 50)) {
+                        // stabilize makes an unstable indirect sort stable
+                        if (whole) { IntArrays.stabilize(perm, orig); } else { IntArrays.stabilize(perm, orig, from, to); }
+                        for (int i = from + 1; i < to; i++) {
+                            int i0 = i;
+                            check(orig[perm[i - 1]] < orig[perm[i]] || (orig[perm[i - 1]] == orig[perm[i]] && perm[i - 1] < perm[i]), () -> "stabilize left ties unordered at " + i0 + ": " + show(perm) + info.get());
+                        }
+                    }
+                }
+                case 11 -> {
+                    // the support array must hold a copy of the range (documented)
+                    int[] supp = a.clone();
+                    if (whole) { IntArrays.mergeSort(a, 0, len, supp); } else { IntArrays.mergeSort(a, from, to, supp); }
+                    checkSorted(a, orig, from, to, null, name, info);
+                    if (cmp != null) {
+                        int[] b = orig.clone();
+                        int[] supp2 = b.clone();
+                        if (whole) { IntArrays.mergeSort(b, 0, len, cmp, supp2); } else { IntArrays.mergeSort(b, from, to, cmp, supp2); }
+                        checkSorted(b, orig, from, to, cmp, name, info);
+                        checkStable(b, orig, from, to, cmp, name, info);
+                    }
+                }
+                default -> {
+                    // sorting two arrays at once: b follows a
+                    int[] b = identity(len);
+                    int which = n(tc, 0, 4);
+                    switch (which) {
+                        case 0 -> { if (whole) { IntArrays.quickSort(a, b); } else { IntArrays.quickSort(a, b, from, to); } }
+                        case 1 -> { if (whole) { IntArrays.radixSort(a, b); } else { IntArrays.radixSort(a, b, from, to); } }
+                        case 2 -> { if (whole) { IntArrays.parallelQuickSort(a, b); } else { IntArrays.parallelQuickSort(a, b, from, to); } }
+                        case 3 -> { if (whole) { IntArrays.parallelRadixSort(a, b); } else { IntArrays.parallelRadixSort(a, b, from, to); } }
+                        default -> { if (whole) { IntArrays.quickSort(a, b); } else { IntArrays.quickSort(a, b, from, to); } }
+                    }
+                    count(name + "/" + which);
+                    // lexicographic order of (a, b) pairs; b was the identity so ties in a are ordered by index
+                    for (int i = from + 1; i < to; i++) {
+                        int i0 = i;
+                        check(a[i - 1] < a[i] || (a[i - 1] == a[i] && b[i - 1] <= b[i]), () -> name + "/" + which + " pairs not sorted at " + i0 + ": " + show(a) + " / " + show(b) + info.get());
+                    }
+                    for (int i = from; i < to; i++) {
+                        int i0 = i;
+                        check(orig[b[i]] == a[i], () -> name + "/" + which + " b does not follow a at " + i0 + ": " + show(a) + " / " + show(b) + info.get());
+                    }
+                    for (int i = 0; i < len; i++) {
+                        if (i < from || i >= to) {
+                            int j = i;
+                            check(a[i] == orig[i] && b[i] == i, () -> name + "/" + which + " touched index " + j + " outside the range" + info.get());
+                        }
+                    }
+                    int[] sortedPart = Arrays.copyOfRange(orig, from, to);
+                    Arrays.sort(sortedPart);
+                    check(Arrays.equals(sortedPart, Arrays.copyOfRange(a, from, to)), () -> name + "/" + which + " changed the multiset" + info.get());
+                }
+            }
+            // binary search on the sorted result (natural order only)
+            if (cmp == null && alg <= 6 && to > from) {
+                int probe = chance(tc, 50) ? a[n(tc, from, to - 1)] : n(tc, -20, 20);
+                int got = IntArrays.binarySearch(a, from, to, probe);
+                int exp = Arrays.binarySearch(a, from, to, probe);
+                if (exp >= 0) {
+                    check(got >= from && got < to && a[got] == probe, () -> "binarySearch(" + probe + ") = " + got + " but a[" + got + "] is not it" + info.get());
+                } else {
+                    check(got == exp, () -> "binarySearch(" + probe + ") = " + got + " expected " + exp + info.get());
+                }
+                int gotC = IntArrays.binarySearch(a, from, to, probe, (IntComparator) Integer::compare);
+                check(exp >= 0 ? gotC >= from && gotC < to && a[gotC] == probe : gotC == exp, () -> "binarySearch with comparator = " + gotC + " expected " + exp + info.get());
+            }
+            // reverse, shuffle and equals on the range
+            if (chance(tc, 30)) {
+                int[] r = orig.clone();
+                IntArrays.reverse(r, from, to);
+                for (int i = from; i < to; i++) {
+                    int i0 = i;
+                    check(r[i] == orig[to - 1 - (i - from)], () -> "reverse wrong at " + i0 + ": " + show(r) + info.get());
+                }
+                for (int i = 0; i < len; i++) {
+                    if (i < from || i >= to) {
+                        int j = i;
+                        check(r[i] == orig[i], () -> "reverse touched " + j + info.get());
+                    }
+                }
+                int[] s = orig.clone();
+                IntArrays.shuffle(s, from, to, new java.util.Random(n(tc, 0, 1000)));
+                int[] p1 = Arrays.copyOfRange(s, from, to), p2 = Arrays.copyOfRange(orig, from, to);
+                Arrays.sort(p1);
+                Arrays.sort(p2);
+                check(Arrays.equals(p1, p2), () -> "shuffle changed the multiset" + info.get());
+                check(IntArrays.equals(orig, orig.clone()) && (len == 0 || !IntArrays.equals(orig, Arrays.copyOf(orig, len + 1))), () -> "IntArrays.equals" + info.get());
+            }
+        });
+    }
+
+    /** With a comparator with ties, a stable sort keeps the original relative order of equal keys. */
+    static void checkStable(int[] a, int[] orig, int from, int to, IntComparator cmp, String what, Supplier<String> info) {
+        // the stable order is what a stable sort of the indexes gives
+        Integer[] idx = new Integer[to - from];
+        for (int i = 0; i < idx.length; i++) {
+            idx[i] = from + i;
+        }
+        Comparator<Integer> byValue = (i, j) -> cmp == null ? Integer.compare(orig[i], orig[j]) : cmp.compare(orig[i], orig[j]);
+        Arrays.sort(idx, byValue); // java.util's object sort is stable
+        int[] exp = orig.clone();
+        for (int i = 0; i < idx.length; i++) {
+            exp[from + i] = orig[idx[i]];
+        }
+        check(Arrays.equals(a, exp), () -> what + " is not stable: " + show(a) + " expected " + show(exp) + info.get());
+    }
+
+    @Test
+    void floatingPointSortsOrderLikeJavaUtil() {
+        Zoo.run("floatingPointSortsOrderLikeJavaUtil", tc -> {
+            int len = pick(tc, n(tc, 0, 8), n(tc, 0, 60), n(tc, 0, 2000));
+            double[] d = new double[len];
+            for (int i = 0; i < len; i++) {
+                d[i] = switch (n(tc, 0, 6)) {
+                    case 0 -> pick(tc, Double.NaN, -0.0, 0.0, Double.POSITIVE_INFINITY, Double.NEGATIVE_INFINITY, Double.MIN_VALUE, -Double.MIN_VALUE, Double.MAX_VALUE);
+                    case 1 -> n(tc, -5, 5);
+                    default -> n(tc, -1000000, 1000000) / 8.0;
+                };
+            }
+            double[] orig = d.clone();
+            double[] exp = d.clone();
+            Arrays.sort(exp); // -0.0 before 0.0, NaN last
+            int alg = n(tc, 0, 6);
+            String[] names = {"quickSort", "mergeSort", "stableSort", "radixSort", "parallelQuickSort", "parallelRadixSort", "unstableSort"};
+            count("double/" + names[alg]);
+            switch (alg) {
+                case 0 -> DoubleArrays.quickSort(d);
+                case 1 -> DoubleArrays.mergeSort(d);
+                case 2 -> DoubleArrays.stableSort(d);
+                case 3 -> DoubleArrays.radixSort(d);
+                case 4 -> DoubleArrays.parallelQuickSort(d);
+                case 5 -> DoubleArrays.parallelRadixSort(d);
+                default -> DoubleArrays.unstableSort(d);
+            }
+            // compare by bits so that -0.0/0.0 and NaN are told apart
+            long[] gotBits = Arrays.stream(d).mapToLong(Double::doubleToLongBits).toArray();
+            long[] expBits = Arrays.stream(exp).mapToLong(Double::doubleToLongBits).toArray();
+            check(Arrays.equals(gotBits, expBits), () -> "double " + names[alg] + " gave " + Arrays.toString(len > 30 ? Arrays.copyOf(d, 30) : d) + " expected " + Arrays.toString(len > 30 ? Arrays.copyOf(exp, 30) : exp) + "\norig " + Arrays.toString(len > 30 ? Arrays.copyOf(orig, 30) : orig));
+            // binary search agrees on the sorted array for a present value
+            if (len > 0) {
+                double probe = exp[n(tc, 0, len - 1)];
+                int got = DoubleArrays.binarySearch(exp, probe);
+                check(got >= 0 && Double.compare(exp[got], probe) == 0, () -> "double binarySearch(" + probe + ") = " + got + " in " + Arrays.toString(exp));
+            }
+            // the same in float and on the indirect radix sort
+            float[] f = new float[len];
+            for (int i = 0; i < len; i++) {
+                f[i] = (float) orig[i];
+            }
+            float[] fexp = f.clone();
+            Arrays.sort(fexp);
+            int falg = n(tc, 0, 3);
+            switch (falg) {
+                case 0 -> FloatArrays.quickSort(f);
+                case 1 -> FloatArrays.radixSort(f);
+                case 2 -> FloatArrays.mergeSort(f);
+                default -> FloatArrays.parallelRadixSort(f);
+            }
+            int[] gotF = new int[len], expF = new int[len];
+            for (int i = 0; i < len; i++) {
+                gotF[i] = Float.floatToIntBits(f[i]);
+                expF[i] = Float.floatToIntBits(fexp[i]);
+            }
+            check(Arrays.equals(gotF, expF), () -> "float sort " + falg + " gave " + Arrays.toString(len > 30 ? Arrays.copyOf(f, 30) : f) + " expected " + Arrays.toString(len > 30 ? Arrays.copyOf(fexp, 30) : fexp));
+            int[] perm = identity(len);
+            boolean stable = chance(tc, 50);
+            DoubleArrays.radixSortIndirect(perm, orig, stable);
+            boolean nanTiesKnown = false;
+            for (int i = 1; i < len; i++) {
+                int i0 = i;
+                double x = orig[perm[i - 1]], y = orig[perm[i]];
+                // the documented postcondition is a[perm[i]] <= a[perm[i + 1]], under which -0.0 and 0.0 are equal
+                check(Double.compare(x + 0.0, y + 0.0) <= 0, () -> "double radixSortIndirect not sorted at " + i0 + ": " + Arrays.toString(perm) + "\norig " + Arrays.toString(orig));
+                // stability: identical bit patterns keep their index order
+                if (stable && Double.doubleToRawLongBits(x) == Double.doubleToRawLongBits(y) && perm[i - 1] > perm[i]) {
+                    if (Double.isNaN(x)) {
+                        // fastutil/3: the quicksort fallback's stabilize() compares with != and never regroups NaN
