index 0000000..8a2fcbe
--- /dev/null
+++ b/hegel/src/test/java/zoo/QueuesTest.java
@@ -0,0 +1,374 @@
+package zoo;
+
+import static zoo.Zoo.check;
+import static zoo.Zoo.chance;
+import static zoo.Zoo.count;
+import static zoo.Zoo.n;
+import static zoo.Zoo.pick;
+
+import dev.hegel.TestCase;
+import it.unimi.dsi.fastutil.ints.IntArrayFIFOQueue;
+import it.unimi.dsi.fastutil.ints.IntArrayIndirectPriorityQueue;
+import it.unimi.dsi.fastutil.ints.IntArrayPriorityQueue;
+import it.unimi.dsi.fastutil.ints.IntComparator;
+import it.unimi.dsi.fastutil.ints.IntHeapIndirectPriorityQueue;
+import it.unimi.dsi.fastutil.ints.IntHeapPriorityQueue;
+import it.unimi.dsi.fastutil.ints.IntHeapSemiIndirectPriorityQueue;
+import it.unimi.dsi.fastutil.ints.IntIndirectPriorityQueue;
+import it.unimi.dsi.fastutil.ints.IntPriorityQueue;
+import it.unimi.dsi.fastutil.ints.IntPriorityQueues;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.Comparator;
+import java.util.List;
+import java.util.NoSuchElementException;
+import java.util.PriorityQueue;
+import java.util.function.Supplier;
+import org.junit.jupiter.api.Test;
+
+/**
+ * The priority queues against {@code java.util.PriorityQueue} (direct queues: heap and array, with
+ * and without a comparator, {@code changed()} after modifying the first element, {@code last()} on
+ * the array queue) and against a sorted list of indexes (indirect and semi-indirect queues, whose
+ * elements are indexes into a reference array whose values may change), plus the FIFO queue
+ * against {@code ArrayDeque}.
+ */
+class QueuesTest {
+
+    static int value(TestCase tc) {
+        return MapsTest.value(tc);
+    }
+
+    @Test
+    void priorityQueuesDequeueInOrder() {
+        Zoo.run("priorityQueuesDequeueInOrder", tc -> {
+            boolean reverse = chance(tc, 40);
+            IntComparator cmp = reverse ? (a, b) -> Integer.compare(b, a) : null;
+            Comparator<Integer> mcmp = reverse ? Comparator.reverseOrder() : Comparator.naturalOrder();
+            int cap = pick(tc, 0, 1, 2, 16);
+            int which = n(tc, 0, 2);
+            String name = switch (which) {
+                case 0 -> "IntHeapPriorityQueue";
+                case 1 -> "IntArrayPriorityQueue";
+                default -> "IntPriorityQueues.synchronize(heap)";
+            };
+            count(name + (reverse ? "/reverse" : ""));
+            IntPriorityQueue q = switch (which) {
+                case 0 -> cmp == null ? new IntHeapPriorityQueue(cap) : new IntHeapPriorityQueue(cap, cmp);
+                case 1 -> cmp == null ? new IntArrayPriorityQueue(cap) : new IntArrayPriorityQueue(cap, cmp);
+                default -> IntPriorityQueues.synchronize(cmp == null ? new IntHeapPriorityQueue(cap) : new IntHeapPriorityQueue(cap, cmp));
+            };
+            PriorityQueue<Integer> model = new PriorityQueue<>(mcmp);
+            List<String> script = new ArrayList<>();
+            Supplier<String> info = () -> "\n" + name + (reverse ? " reverse" : "") + "\nscript " + script + "\nmodel " + model;
+            check((q.comparator() == null) == (cmp == null), () -> "comparator() " + q.comparator() + info.get());
+            int steps = n(tc, 0, 40);
+            for (int i = 0; i < steps; i++) {
+                int v = value(tc);
+                switch (n(tc, 0, 9)) {
+                    case 0, 1, 2, 3 -> {
+                        script.add("enqueue(" + v + ")");
+                        model.add(v);
+                        q.enqueue(v);
+                    }
+                    case 4, 5 -> {
+                        script.add("dequeueInt()");
+                        if (model.isEmpty()) {
+                            check(Zoo.throwsClass(q::dequeueInt) == NoSuchElementException.class, () -> "dequeueInt on empty: " + Zoo.throwsClass(q::dequeueInt) + info.get());
+                        } else {
+                            int exp = model.poll();
+                            int got = q.dequeueInt();
+                            check(got == exp, () -> "dequeueInt returned " + got + " expected " + exp + info.get());
+                        }
+                    }
+                    case 6 -> {
+                        script.add("Dequeue()");
+                        if (!model.isEmpty()) {
+                            Integer exp = model.poll();
+                            Integer got = q.dequeue();
+                            check(exp.equals(got), () -> "boxed dequeue returned " + got + " expected " + exp + info.get());
+                        }
+                    }
+                    case 7 -> {
+                        // last(): the array queue supports it; the heap queue documents UnsupportedOperationException
+                        script.add("lastInt()");
+                        Class<?> thrown = Zoo.throwsClass(q::lastInt);
+                        if (model.isEmpty()) {
+                            check(thrown != null, () -> "lastInt on empty returned" + info.get());
+                        } else if (thrown == null) {
+                            int got = q.lastInt();
+                            int exp = Collections.max(model, mcmp);
+                            check(got == exp, () -> "lastInt returned " + got + " expected " + exp + info.get());
+                        } else {
+                            check(thrown == UnsupportedOperationException.class, () -> "lastInt threw " + thrown + info.get());
+                            count("lastInt unsupported");
+                        }
+                    }
+                    default -> {
+                        script.add("clear()");
+                        model.clear();
+                        q.clear();
+                    }
+                }
+                check(q.size() == model.size() && q.isEmpty() == model.isEmpty(), () -> "size " + q.size() + " expected " + model.size() + info.get());
+                if (model.isEmpty()) {
+                    check(Zoo.throwsClass(q::firstInt) == NoSuchElementException.class, () -> "firstInt on empty: " + Zoo.throwsClass(q::firstInt) + info.get());
+                } else {
+                    check(q.firstInt() == model.peek(), () -> "firstInt " + q.firstInt() + " expected " + model.peek() + info.get());
+                    check(q.first().equals(model.peek()), () -> "boxed first" + info.get());
+                }
+            }
+            // drain in order
+            List<Integer> drained = new ArrayList<>();
+            while (!q.isEmpty()) {
+                drained.add(q.dequeueInt());
+            }
+            List<Integer> exp = new ArrayList<>(model);
+            exp.sort(mcmp);
+            check(drained.equals(exp), () -> "drained " + drained + " expected " + exp + info.get());
+        });
+    }
+
+    @Test
+    void indirectQueuesTrackTheReferenceArray() {
+        Zoo.run("indirectQueuesTrackTheReferenceArray", tc -> {
+            int n = n(tc, 1, 12);
+            int[] ref = new int[n];
+            for (int i = 0; i < n; i++) {
+                ref[i] = value(tc);
+            }
+            boolean reverse = chance(tc, 30);
+            IntComparator cmp = reverse ? (a, b) -> Integer.compare(b, a) : null;
+            int which = n(tc, 0, 2);
+            String name = switch (which) {
+                case 0 -> "IntHeapIndirectPriorityQueue";
+                case 1 -> "IntArrayIndirectPriorityQueue";
+                default -> "IntHeapSemiIndirectPriorityQueue";
+            };
+            count(name + (reverse ? "/reverse" : ""));
+            IntIndirectPriorityQueue q = switch (which) {
+                case 0 -> cmp == null ? new IntHeapIndirectPriorityQueue(ref) : new IntHeapIndirectPriorityQueue(ref, cmp);
+                case 1 -> cmp == null ? new IntArrayIndirectPriorityQueue(ref) : new IntArrayIndirectPriorityQueue(ref, cmp);
+                default -> cmp == null ? new IntHeapSemiIndirectPriorityQueue(ref) : new IntHeapSemiIndirectPriorityQueue(ref, cmp);
+            };
+            boolean semi = which == 2;
+            // the model: the multiset of enqueued indexes (a semi-indirect queue allows repeats)
+            List<Integer> model = new ArrayList<>();
+            List<String> script = new ArrayList<>();
+            Supplier<String> info = () -> "\n" + name + (reverse ? " reverse" : "") + "\nref " + Arrays.toString(ref) + "\nscript " + script + "\nmodel " + model;
+            Comparator<Integer> byRef = (a, b) -> {
+                int c = reverse ? Integer.compare(ref[b], ref[a]) : Integer.compare(ref[a], ref[b]);
+                return c;
+            };
+            int steps = n(tc, 0, 40);
+            for (int i = 0; i < steps; i++) {
+                int idx = n(tc, 0, n - 1);
+                switch (n(tc, 0, 9)) {
+                    case 0, 1, 2 -> {
+                        if (!semi && model.contains(idx)) {
+                            break; // an indirect queue holds each index at most once
+                        }
+                        script.add("enqueue(" + idx + ")");
+                        model.add(idx);
+                        q.enqueue(idx);
+                    }
+                    case 3, 4 -> {
+                        script.add("dequeue()");
+                        if (model.isEmpty()) {
+                            check(Zoo.throwsClass(q::dequeue) == NoSuchElementException.class, () -> "dequeue on empty: " + Zoo.throwsClass(q::dequeue) + info.get());
+                        } else {
+                            int got = q.dequeue();
+                            // any index whose value is minimal is acceptable
+                            int best = Collections.min(model, byRef);
+                            check(model.contains(got) && ref[got] == ref[best], () -> "dequeue returned " + got + " (ref " + ref[got] + ") expected an index with ref " + ref[best] + info.get());
+                            model.remove(Integer.valueOf(got));
+                        }
+                    }
+                    case 5 -> {
+                        // change the value of the first element and notify the queue
+                        if (model.isEmpty()) {
+                            break;
+                        }
+                        int first = q.first();
+                        int nv = value(tc);
+                        ref[first] = nv;
+                        if (semi && Collections.frequency(model, first) > 1) {
+                            // every copy of the index changed, not only the top one: changed() re-sifts the top alone
+                            script.add("ref[" + first + "]=" + nv + "; allChanged()");
+                            q.allChanged();
+                        } else {
+                            script.add("ref[" + first + "]=" + nv + "; changed()");
+                            q.changed();
+                        }
+                    }
+                    case 6 -> {
+                        if (semi || model.isEmpty()) {
+                            break;
+                        }
+                        // change any queued element and notify by index (indirect queues only)
+                        int e = model.get(n(tc, 0, model.size() - 1));
+                        int nv = value(tc);
+                        script.add("ref[" + e + "]=" + nv + "; changed(" + e + ")");
+                        ref[e] = nv;
+                        q.changed(e);
+                    }
+                    case 7 -> {
+                        if (semi || model.isEmpty()) {
+                            break;
+                        }
+                        int e = model.get(n(tc, 0, model.size() - 1));
+                        script.add("remove(" + e + ")");
+                        boolean got = q.remove(e);
+                        check(got, () -> "remove(" + e + ") returned false" + info.get());
+                        model.remove(Integer.valueOf(e));
+                        boolean again = q.remove(e);
+                        check(!again, () -> "remove(" + e + ") again returned true" + info.get());
+                    }
+                    case 8 -> {
+                        if (semi) {
+                            // change several values and rebuild the whole queue
+                            for (int j = 0; j < n; j++) {
+                                if (chance(tc, 30)) {
+                                    ref[j] = value(tc);
+                                }
+                            }
+                            script.add("ref changed; allChanged()");
+                            ((IntHeapSemiIndirectPriorityQueue) q).allChanged();
+                        } else {
+                            for (int j = 0; j < n; j++) {
+                                if (chance(tc, 30)) {
+                                    ref[j] = value(tc);
+                                }
+                            }
+                            script.add("ref changed; allChanged()");
+                            if (q instanceof IntHeapIndirectPriorityQueue h) {
+                                h.allChanged();
+                            } else {
+                                ((IntArrayIndirectPriorityQueue) q).allChanged();
+                            }
+                        }
+                    }
+                    default -> {
+                        script.add("clear()");
+                        model.clear();
+                        q.clear();
+                    }
+                }
+                check(q.size() == model.size() && q.isEmpty() == model.isEmpty(), () -> "size " + q.size() + " expected " + model.size() + info.get());
+                if (!semi) {
+                    // contains is optional (the interface's default throws)
+                    if (Zoo.throwsClass(() -> q.contains(idx)) == UnsupportedOperationException.class) {
+                        count("contains unsupported");
+                    } else {
+                        check(q.contains(idx) == model.contains(idx), () -> "contains(" + idx + ") is " + q.contains(idx) + info.get());
+                    }
+                }
+                if (model.isEmpty()) {
+                    check(Zoo.throwsClass(q::first) == NoSuchElementException.class, () -> "first on empty: " + Zoo.throwsClass(q::first) + info.get());
+                } else {
+                    int first = q.first();
+                    int best = Collections.min(model, byRef);
+                    check(model.contains(first) && ref[first] == ref[best], () -> "first is " + first + " (ref " + ref[first] + ") expected an index with ref " + ref[best] + info.get());
+                    Class<?> lt = Zoo.throwsClass(q::last);
+                    if (lt == null) {
+                        int last = q.last();
+                        int worst = Collections.max(model, byRef);
+                        check(model.contains(last) && ref[last] == ref[worst], () -> "last is " + last + " (ref " + ref[last] + ") expected an index with ref " + ref[worst] + info.get());
+                    } else {
+                        check(lt == UnsupportedOperationException.class, () -> "last threw " + lt + info.get());
+                    }
+                    // front(): every index whose value equals the first's
+                    int[] front = new int[model.size()];
+                    int cnt = q.front(front);
+                    List<Integer> got = new ArrayList<>();
+                    for (int j = 0; j < cnt; j++) {
+                        got.add(front[j]);
+                    }
+                    List<Integer> exp = new ArrayList<>();
+                    for (int e : model) {
+                        if (ref[e] == ref[best]) {
+                            exp.add(e);
+                        }
+                    }
+                    Collections.sort(got);
+                    Collections.sort(exp);
+                    check(got.equals(exp), () -> "front() " + got + " expected " + exp + info.get());
+                }
+            }
+            // drain: values come out in order
+            List<Integer> vals = new ArrayList<>();
+            while (!q.isEmpty()) {
+                vals.add(ref[q.dequeue()]);
+            }
+            List<Integer> exp = new ArrayList<>();
+            for (int e : model) {
+                exp.add(ref[e]);
+            }
+            exp.sort(reverse ? Comparator.reverseOrder() : Comparator.naturalOrder());
+            check(vals.equals(exp), () -> "drained values " + vals + " expected " + exp + info.get());
+        });
+    }
+
+    @Test
+    void fifoQueueMatchesArrayDeque() {
+        Zoo.run("fifoQueueMatchesArrayDeque", tc -> {
+            IntArrayFIFOQueue q = new IntArrayFIFOQueue(pick(tc, 0, 1, 2, 4, 16));
+            java.util.ArrayDeque<Integer> model = new java.util.ArrayDeque<>();
+            List<String> script = new ArrayList<>();
+            Supplier<String> info = () -> "\nscript " + script + "\nmodel " + model;
+            int steps = n(tc, 0, 60);
+            for (int i = 0; i < steps; i++) {
+                int v = value(tc);
+                switch (n(tc, 0, 7)) {
+                    case 0, 1, 2 -> {
+                        script.add("enqueue(" + v + ")");
+                        model.addLast(v);
+                        q.enqueue(v);
+                    }
+                    case 3 -> {
+                        script.add("enqueueFirst(" + v + ")");
+                        model.addFirst(v);
+                        q.enqueueFirst(v);
+                    }
+                    case 4 -> {
+                        script.add("dequeueInt()");
+                        if (model.isEmpty()) {
+                            check(Zoo.throwsClass(q::dequeueInt) == NoSuchElementException.class, () -> "dequeueInt on empty: " + Zoo.throwsClass(q::dequeueInt) + info.get());
+                        } else {
+                            int exp = model.pollFirst();
+                            int got = q.dequeueInt();
+                            check(got == exp, () -> "dequeueInt " + got + " expected " + exp + info.get());
+                        }
+                    }
+                    case 5 -> {
+                        script.add("dequeueLastInt()");
+                        if (model.isEmpty()) {
+                            check(Zoo.throwsClass(q::dequeueLastInt) == NoSuchElementException.class, () -> "dequeueLastInt on empty: " + Zoo.throwsClass(q::dequeueLastInt) + info.get());
+                        } else {
+                            int exp = model.pollLast();
+                            int got = q.dequeueLastInt();
+                            check(got == exp, () -> "dequeueLastInt " + got + " expected " + exp + info.get());
+                        }
+                    }
+                    case 6 -> {
+                        script.add("trim()");
+                        q.trim();
+                    }
+                    default -> {
+                        script.add("clear()");
+                        model.clear();
+                        q.clear();
+                    }
+                }
+                check(q.size() == model.size() && q.isEmpty() == model.isEmpty(), () -> "size " + q.size() + " expected " + model.size() + info.get());
+                if (!model.isEmpty()) {
+                    check(q.firstInt() == model.peekFirst() && q.lastInt() == model.peekLast(), () -> "first/last " + q.firstInt() + "/" + q.lastInt() + " expected " + model.peekFirst() + "/" + model.peekLast() + info.get());
+                } else {
+                    check(Zoo.throwsClass(q::firstInt) == NoSuchElementException.class && Zoo.throwsClass(q::lastInt) == NoSuchElementException.class, () -> "first/last on empty" + info.get());
+                }
+            }
+            check(q.comparator() == null, "comparator");
+        });
+    }
+}
