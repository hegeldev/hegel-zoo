+                        boolean got = fu.keySet().removeIf((int kk) -> kk % m == 0);
+                        check(got == exp, () -> "keySet().removeIf returned " + got + " expected " + exp + info.get());
+                    }
+                    case 22 -> {
+                        int m = pick(tc, 2, 3);
+                        script.add("values().removeIf(v%" + m + "==0)");
+                        boolean exp = model.values().removeIf(vv -> vv % m == 0);
+                        boolean got = fu.values().removeIf((int vv) -> vv % m == 0);
+                        check(got == exp, () -> "values().removeIf returned " + got + " expected " + exp + info.get());
+                    }
+                    case 23 -> {
+                        script.add("entrySet().removeIf(k+v<0)");
+                        boolean exp = model.entrySet().removeIf(e -> (long) e.getKey() + e.getValue() < 0);
+                        boolean got = fu.int2IntEntrySet().removeIf(e -> (long) e.getIntKey() + e.getIntValue() < 0);
+                        check(got == exp, () -> "entrySet().removeIf returned " + got + " expected " + exp + info.get());
+                    }
+                    case 24 -> {
+                        // iterator removal of every entry with an odd key, through the entry iterator
+                        script.add("iterator remove odd keys");
+                        model.entrySet().removeIf(e -> (e.getKey() & 1) != 0);
+                        Iterator<Int2IntMap.Entry> it = fu.int2IntEntrySet().iterator();
+                        while (it.hasNext()) {
+                            if ((it.next().getIntKey() & 1) != 0) {
+                                it.remove();
+                            }
+                        }
+                    }
+                    case 25 -> {
+                        // both filled in the same order, since a linked map keeps the argument's iteration order
+                        Int2IntMap other = new Int2IntLinkedOpenHashMap();
+                        Map<Integer, Integer> otherModel = new LinkedHashMap<>();
+                        int cnt = n(tc, 0, 4);
+                        for (int j = 0; j < cnt; j++) {
+                            int kk = key(tc), vv = value(tc);
+                            other.put(kk, vv);
+                            otherModel.put(kk, vv);
+                        }
+                        script.add("putAll(" + otherModel + ")");
+                        model.putAll(otherModel);
+                        fu.putAll(other);
+                    }
+                    case 26 -> {
+                        if (chance(tc, 50)) {
+                            script.add("clear()");
+                            model.clear();
+                            fu.clear();
+                        } else {
+                            script.add("trim()");
+                            switch (fu) {
+                                case Int2IntOpenHashMap m -> check(m.trim() || true, "trim");
+                                case Int2IntLinkedOpenHashMap m -> m.trim();
+                                case Int2IntOpenCustomHashMap m -> m.trim();
+                                default -> { }
+                            }
+                        }
+                    }
+                    default -> {
+                        if (kind.linked) {
+                            Int2IntLinkedOpenHashMap m = (Int2IntLinkedOpenHashMap) fu;
+                            switch (n(tc, 0, 4)) {
+                                case 0 -> {
+                                    script.add("putAndMoveToFirst(" + k + "," + v + ")");
+                                    Integer old = model.remove(k);
+                                    LinkedHashMap<Integer, Integer> re = new LinkedHashMap<>();
+                                    re.put(k, v);
+                                    re.putAll(model);
+                                    model.clear();
+                                    model.putAll(re);
+                                    int got = m.putAndMoveToFirst(k, v);
+                                    check(got == (old == null ? drv : old), () -> "putAndMoveToFirst returned " + got + " expected " + (old == null ? drv : old) + info.get());
+                                }
+                                case 1 -> {
+                                    script.add("putAndMoveToLast(" + k + "," + v + ")");
+                                    Integer old = model.remove(k);
+                                    model.put(k, v);
+                                    int got = m.putAndMoveToLast(k, v);
+                                    check(got == (old == null ? drv : old), () -> "putAndMoveToLast returned " + got + " expected " + (old == null ? drv : old) + info.get());
+                                }
+                                case 2 -> {
+                                    script.add("getAndMoveToLast(" + k + ")");
+                                    Integer old = model.remove(k);
+                                    if (old != null) {
+                                        model.put(k, old);
+                                    }
+                                    int got = m.getAndMoveToLast(k);
+                                    check(got == (old == null ? drv : old), () -> "getAndMoveToLast returned " + got + " expected " + (old == null ? drv : old) + info.get());
+                                }
+                                case 3 -> {
+                                    script.add("getAndMoveToFirst(" + k + ")");
+                                    Integer old = model.remove(k);
+                                    if (old != null) {
+                                        LinkedHashMap<Integer, Integer> re = new LinkedHashMap<>();
+                                        re.put(k, old);
+                                        re.putAll(model);
+                                        model.clear();
+                                        model.putAll(re);
+                                    }
+                                    int got = m.getAndMoveToFirst(k);
+                                    check(got == (old == null ? drv : old), () -> "getAndMoveToFirst returned " + got + " expected " + (old == null ? drv : old) + info.get());
+                                }
+                                default -> {
+                                    boolean first = chance(tc, 50);
+                                    script.add(first ? "removeFirstInt()" : "removeLastInt()");
+                                    Integer expKey = null;
+                                    for (Integer kk : model.keySet()) {
+                                        expKey = kk;
+                                        if (first) {
+                                            break;
+                                        }
+                                    }
+                                    Integer exp = expKey == null ? null : model.remove(expKey);
+                                    Integer got = null;
+                                    try {
+                                        got = first ? m.removeFirstInt() : m.removeLastInt();
+                                    } catch (NoSuchElementException e) {
+                                        // expected on an empty map
+                                    }
+                                    Integer g = got;
+                                    check(java.util.Objects.equals(g, exp), () -> "removeFirst/Last returned " + g + " expected " + exp + info.get());
+                                }
+                            }
+                        } else {
+                            script.add("get(" + k + ")");
+                        }
+                    }
+                }
+                // reads after every step
+                Integer mv = model.get(k);
+                int got = fu.get(k);
+                check(got == (mv == null ? drv : mv), () -> "get(" + k + ") is " + got + " expected " + (mv == null ? drv : mv) + info.get());
+                Integer bgot = fu.get(Integer.valueOf(k));
+                check(java.util.Objects.equals(bgot, mv), () -> "boxed get(" + k + ") is " + bgot + " expected " + mv + info.get());
+                check(fu.containsKey(k) == model.containsKey(k), () -> "containsKey(" + k + ") is " + fu.containsKey(k) + info.get());
+                check(fu.containsKey(Integer.valueOf(k)) == model.containsKey(k), () -> "boxed containsKey(" + k + ") is " + fu.containsKey(Integer.valueOf(k)) + info.get());
+                check(fu.containsValue(v) == model.containsValue(v), () -> "containsValue(" + v + ") is " + fu.containsValue(v) + info.get());
+                check(!fu.containsValue(null), () -> "containsValue(null) is true" + info.get());
+                check(!fu.containsKey(null), () -> "containsKey(null) is true" + info.get());
+                check(fu.getOrDefault(k, 99) == (mv == null ? 99 : mv), () -> "getOrDefault(" + k + ",99) is " + fu.getOrDefault(k, 99) + info.get());
+                check(fu.size() == model.size() && fu.isEmpty() == model.isEmpty(), () -> "size " + fu.size() + " expected " + model.size() + info.get());
+                check(fu.keySet().size() == model.size() && fu.values().size() == model.size() && fu.int2IntEntrySet().size() == model.size(), () -> "view sizes differ" + info.get());
+                if (chance(tc, 30)) {
+                    compareState(fu, model, ordered, kind, info);
+                }
+            }
+            compareState(fu, model, ordered, kind, info);
+        });
+    }
+
+    static void compareState(Int2IntMap fu, Map<Integer, Integer> model, boolean ordered, Kind kind, Supplier<String> info) {
+        List<String> exp = entries(model);
+        List<String> got = entries(fu);
+        List<String> fast = entriesFast(fu);
+        if (ordered) {
+            check(got.equals(exp), () -> "entries " + got + " expected " + exp + info.get());
+            check(fast.equals(exp), () -> "fast entries " + fast + " expected " + exp + info.get());
+        } else {
+            check(sortedString(got).equals(sortedString(exp)), () -> "entries " + got + " expected " + exp + info.get());
+            check(sortedString(fast).equals(sortedString(exp)), () -> "fast entries " + fast + " expected " + exp + info.get());
+        }
+        // the three views agree with each other
+        List<String> viaViews = new ArrayList<>();
+        int[] keys = fu.keySet().toIntArray();
+        int[] vals = fu.values().toIntArray();
+        check(keys.length == vals.length && keys.length == model.size(), () -> "toIntArray sizes" + info.get());
+        for (int i = 0; i < keys.length; i++) {
+            viaViews.add(keys[i] + "=" + vals[i]);
+        }
+        if (ordered || kind.name.startsWith("Int2IntArrayMap")) {
+            check(viaViews.equals(got), () -> "keySet/values order " + viaViews + " vs entries " + got + info.get());
+        } else {
+            check(sortedString(viaViews).equals(sortedString(exp)), () -> "keySet/values pairs " + viaViews + " expected " + exp + info.get());
+        }
+        // forEach and fastForEach
+        List<String> fe = new ArrayList<>();
+        fu.forEach((int k, int v) -> fe.add(k + "=" + v));
+        List<String> ffe = new ArrayList<>();
+        Int2IntMaps.fastForEach(fu, e -> ffe.add(e.getIntKey() + "=" + e.getIntValue()));
+        check(fe.equals(got), () -> "forEach " + fe + " vs entries " + got + info.get());
+        check(ffe.equals(got), () -> "fastForEach " + ffe + " vs entries " + got + info.get());
+        // equals and hashCode against java.util
+        check(fu.equals(model), () -> "fastutil.equals(model) false" + info.get());
+        check(model.equals(fu), () -> "model.equals(fastutil) false" + info.get());
+        check(fu.hashCode() == model.hashCode(), () -> "hashCode " + fu.hashCode() + " expected " + model.hashCode() + info.get());
+        check(fu.keySet().equals(model.keySet()) && model.keySet().equals(fu.keySet()), () -> "keySet equality" + info.get());
+        check(fu.keySet().hashCode() == model.keySet().hashCode(), () -> "keySet hashCode" + info.get());
+        check(fu.int2IntEntrySet().equals(model.entrySet()) && model.entrySet().equals(fu.int2IntEntrySet()), () -> "entrySet equality" + info.get());
+        check(fu.int2IntEntrySet().hashCode() == model.entrySet().hashCode(), () -> "entrySet hashCode " + fu.int2IntEntrySet().hashCode() + " expected " + model.entrySet().hashCode() + info.get());
+        // spliterator and streams
+        long sum = 0;
+        for (int v : model.values()) {
+            sum += v;
+        }
+        long fsum = fu.values().intStream().asLongStream().sum();
+        long expSum = sum;
+        check(fsum == expSum, () -> "values().intStream sum " + fsum + " expected " + expSum + info.get());
+        long ksum = 0;
+        for (int k : model.keySet()) {
+            ksum += k;
+        }
+        long[] acc = {0};
+        fu.keySet().spliterator().forEachRemaining((int k) -> acc[0] += k);
+        long expKsum = ksum;
+        check(acc[0] == expKsum, () -> "keySet spliterator sum " + acc[0] + " expected " + expKsum + info.get());
+        // a copy through the copy constructor / clone
+        Int2IntMap copy = switch (fu) {
+            case Int2IntOpenHashMap m -> m.clone();
+            case Int2IntLinkedOpenHashMap m -> m.clone();
+            case Int2IntOpenCustomHashMap m -> m.clone();
+            case Int2IntAVLTreeMap m -> m.clone();
+            case Int2IntRBTreeMap m -> m.clone();
+            case Int2IntArrayMap m -> m.clone();
+            default -> fu;
+        };
+        check(copy.equals(fu) && copy.hashCode() == fu.hashCode() && entries(copy).equals(got), () -> "clone differs: " + copy + info.get());
+        check(copy.defaultReturnValue() == fu.defaultReturnValue(), () -> "clone drv " + copy.defaultReturnValue() + info.get());
+        if (kind.sorted) {
+            compareSorted((Int2IntSortedMap) fu, (TreeMap<Integer, Integer>) model, info);
+        }
+    }
+
+    static void compareSorted(Int2IntSortedMap fu, TreeMap<Integer, Integer> model, Supplier<String> info) {
+        if (model.isEmpty()) {
+            check(Zoo.throwsClass(fu::firstIntKey) == NoSuchElementException.class, () -> "firstIntKey on empty: " + Zoo.throwsClass(fu::firstIntKey) + info.get());
+            check(Zoo.throwsClass(fu::lastIntKey) == NoSuchElementException.class, () -> "lastIntKey on empty: " + Zoo.throwsClass(fu::lastIntKey) + info.get());
+        } else {
+            check(fu.firstIntKey() == model.firstKey() && fu.lastIntKey() == model.lastKey(), () -> "first/last " + fu.firstIntKey() + "/" + fu.lastIntKey() + info.get());
+            check(fu.keySet().firstInt() == model.firstKey() && fu.keySet().lastInt() == model.lastKey(), () -> "keySet first/last" + info.get());
+        }
+        int[] bounds = {Integer.MIN_VALUE, -13, -3, 0, 2, 5, 13, Integer.MAX_VALUE};
+        for (int lo : bounds) {
+            SortedMap<Integer, Integer> hm = model.headMap(lo);
+            check(entries(fu.headMap(lo)).equals(entries(hm)), () -> "headMap(" + lo + ") " + entries(fu.headMap(lo)) + " expected " + entries(hm) + info.get());
+            SortedMap<Integer, Integer> tm = model.tailMap(lo);
+            check(entries(fu.tailMap(lo)).equals(entries(tm)), () -> "tailMap(" + lo + ") " + entries(fu.tailMap(lo)) + " expected " + entries(tm) + info.get());
+            check(fu.headMap(lo).size() == hm.size() && fu.tailMap(lo).size() == tm.size(), () -> "head/tail sizes at " + lo + info.get());
+            for (int hi : bounds) {
+                if (lo > hi) {
+                    continue;
+                }
+                SortedMap<Integer, Integer> sm = model.subMap(lo, hi);
+                Int2IntSortedMap fs = fu.subMap(lo, hi);
+                check(entries(fs).equals(entries(sm)), () -> "subMap(" + lo + "," + hi + ") " + entries(fs) + " expected " + entries(sm) + info.get());
+                check(fs.size() == sm.size(), () -> "subMap size " + fs.size() + " expected " + sm.size() + info.get());
+                if (!sm.isEmpty()) {
+                    check(fs.firstIntKey() == sm.firstKey() && fs.lastIntKey() == sm.lastKey(), () -> "subMap first/last" + info.get());
+                }
+                // the sub map's key set walked backwards
+                IntSortedSet ks = fs.keySet();
+                IntBidirectionalIterator it = ks.iterator(hi);
+                List<Integer> back = new ArrayList<>();
+                while (it.hasPrevious()) {
+                    back.add(it.previousInt());
+                }
+                List<Integer> expBack = new ArrayList<>(sm.keySet());
+                java.util.Collections.reverse(expBack);
+                check(back.equals(expBack), () -> "subMap keys backwards from " + hi + ": " + back + " expected " + expBack + info.get());
+            }
+        }
+        // a bidirectional walk from a key present or absent
+        for (int from : new int[] {-1, 0, 3}) {
+            IntBidirectionalIterator it = fu.keySet().iterator(from);
+            List<Integer> fwd = new ArrayList<>();
+            while (it.hasNext()) {
+                fwd.add(it.nextInt());
+            }
+            List<Integer> expFwd = new ArrayList<>(model.tailMap(from, false).keySet());
+            check(fwd.equals(expFwd), () -> "keySet().iterator(" + from + ") forward " + fwd + " expected " + expFwd + info.get());
+            List<Integer> back = new ArrayList<>();
+            while (it.hasPrevious()) {
+                back.add(it.previousInt());
+            }
+            List<Integer> expBack = new ArrayList<>(model.keySet());
+            java.util.Collections.reverse(expBack);
+            check(back.equals(expBack), () -> "then backwards " + back + " expected " + expBack + info.get());
+        }
+        // Arrays.toString of the key set through a spliterator split
+        int[] all = fu.keySet().toIntArray();
+        int[] sorted = model.keySet().stream().mapToInt(Integer::intValue).toArray();
+        check(Arrays.equals(all, sorted), () -> "sorted keys " + Arrays.toString(all) + info.get());
+    }
+}
diff --git a/hegel/src/test/java/zoo/PinsTest.java b/hegel/src/test/java/zoo/PinsTest.java
new file mode 100644
index 0000000..c0195af
--- /dev/null
+++ b/hegel/src/test/java/zoo/PinsTest.java
@@ -0,0 +1,109 @@
+package zoo;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import it.unimi.dsi.fastutil.doubles.DoubleArrays;
+import it.unimi.dsi.fastutil.ints.IntArrayFrontCodedList;
+import it.unimi.dsi.fastutil.ints.IntArrayList;
+import it.unimi.dsi.fastutil.ints.IntBigArrayBigList;
+import it.unimi.dsi.fastutil.ints.IntBigList;
+import it.unimi.dsi.fastutil.ints.IntIterator;
+import it.unimi.dsi.fastutil.ints.IntIterators;
+import it.unimi.dsi.fastutil.ints.IntLists;
+import it.unimi.dsi.fastutil.ints.IntSets;
+import it.unimi.dsi.fastutil.ints.IntSpliterators;
+import it.unimi.dsi.fastutil.ints.IntList;
+import java.util.HashSet;
+import java.util.List;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Pins: one deterministic reproduction per bug in bugs.toml, expected to fail at the pinned version
+ * (target.toml's [expected_failures]) and to pass once upstream fixes it.
+ */
+class PinsTest {
+
+    @Test
+    void pinSubListRemoveAllRemovesEveryOccurrence() {
+        // fastutil/1: AbstractIntCollection.removeAll(IntCollection) removes one occurrence per element.
+        IntList boxed = new IntArrayList(new int[] {9, 1, -4, 5, 5, 9}).subList(1, 5);
+        assertTrue(boxed.removeAll(new HashSet<>(List.of(5, 1))));
+        assertEquals(IntList.of(-4), boxed, "with a HashSet argument");
+        IntList sub = new IntArrayList(new int[] {9, 1, -4, 5, 5, 9}).subList(1, 5);
+        assertTrue(sub.removeAll(IntList.of(5, 1)));
+        assertEquals(IntList.of(-4), sub, "IntArrayList sub list with an IntList argument");
+        IntBigList big = new IntBigArrayBigList(IntList.of(9, 1, -4, 5, 5, 9)).subList(1, 5);
+        assertTrue(big.removeAll(IntList.of(5, 1)));
+        assertEquals(IntList.of(-4), new IntArrayList(big.toIntArray()), "IntBigArrayBigList sub list with an IntList argument");
+    }
+
+    @Test
+    void pinBackwardsFromToIsEmpty() {
+        // fastutil/2: a backwards interval iterates nothing but reports negative counts.
+        assertEquals(0, java.util.stream.IntStream.range(5, 3).count(), "java.util's range is empty");
+        assertFalse(IntIterators.fromTo(5, 3).hasNext(), "iterator hasNext");
+        assertEquals(0, IntIterators.fromTo(5, 3).skip(1), "iterator skip(1)");
+        assertEquals(0, IntSpliterators.fromTo(5, 3).estimateSize(), "spliterator estimateSize");
+        assertEquals(0, IntSpliterators.fromTo(5, 3).skip(1), "spliterator skip(1)");
+        assertEquals(0, IntSets.fromTo(5, 3).size(), "IntSets.fromTo size");
+    }
+
+    @Test
+    void pinIndirectRadixSortKeepsNaNTiesInOrder() {
+        // fastutil/3: the quicksort fallback (whole arrays below 1024 elements, and radix buckets below 1024
+        // elements, which NaN shares with +Infinity and the largest finite values) stabilizes with !=, so
+        // NaN ties keep quicksort's order.
+        assertEquals(-1, firstNaNTieOutOfOrder(1200, false), "1200 elements, a NaN-only bucket (the radix path)");
+        assertEquals(-1, firstNaNTieOutOfOrder(200, false), "200 elements (the quicksort + stabilize path)");
+        assertEquals(-1, firstNaNTieOutOfOrder(1200, true), "1200 elements, NaN in a bucket with Double.MAX_VALUE");
+    }
+
+    private static int firstNaNTieOutOfOrder(int len, boolean withMax) {
+        double[] a = new double[len];
+        int[] perm = new int[len];
+        for (int i = 0; i < len; i++) {
+            a[i] = i % 3 == 0 ? Double.NaN : withMax && i % 5 == 0 ? Double.MAX_VALUE : (i * 7919) % 101;
+            perm[i] = i;
+        }
+        DoubleArrays.radixSortIndirect(perm, a, true);
+        for (int i = 1; i < len; i++) {
+            if (Double.isNaN(a[perm[i - 1]]) && Double.isNaN(a[perm[i]]) && perm[i - 1] > perm[i]) {
+                return i;
+            }
+        }
+        return -1;
+    }
+
+    @Test
+    void pinSingletonIteratorSkipAdvances() {
+        // fastutil/4: the singleton iterator's skip reports one element skipped but does not move.
+        IntIterator plain = new IntArrayList(new int[] {7}).iterator();
+        assertEquals(1, plain.skip(1));
+        assertFalse(plain.hasNext(), "IntArrayList's iterator is consumed by skip(1)");
+        IntIterator single = IntIterators.singleton(7);
+        assertEquals(1, single.skip(1));
+        assertFalse(single.hasNext(), "the singleton iterator is consumed by skip(1)");
+    }
+
+    @Test
+    void pinUnmodifiableListSizeThrows() {
+        // fastutil/5: the unmodifiable list wrapper forwards size(int) to the backing list.
+        IntArrayList base = new IntArrayList(new int[] {1, 2, 3});
+        IntList view = IntLists.unmodifiable(base);
+        assertThrows(UnsupportedOperationException.class, () -> IntLists.EMPTY_LIST.size(3), "the empty list throws");
+        assertThrows(UnsupportedOperationException.class, () -> view.size(5), "the unmodifiable view throws");
+        assertEquals(IntList.of(1, 2, 3), base, "the backing list is untouched");
+    }
+
+    @Test
+    void pinFrontCodedListHashCodeIsRepeatable() {
+        // fastutil/6: the hash code is built from the identity hashes of freshly decoded arrays.
+        int[][] arrays = {{1, 2}, {1, 3}, {2}};
+        IntArrayFrontCodedList list = new IntArrayFrontCodedList(java.util.Arrays.asList(arrays).iterator(), 2);
+        assertTrue(list.equals(list.clone()), "a list equals its clone");
+        assertEquals(list.hashCode(), list.hashCode(), "two calls of hashCode on the same list");
+    }
+}
diff --git a/hegel/src/test/java/zoo/QueuesTest.java b/hegel/src/test/java/zoo/QueuesTest.java
