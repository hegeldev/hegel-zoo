+/**
+ * {@code IntArrayList} (and a big list, and the sub lists of both) against {@code ArrayList}: a random
+ * script of the list operations - positional and element-wise, bulk, through list iterators and
+ * through sub list views - with the state compared after every step, and the read-only operations
+ * (indexOf, equals/compareTo/hashCode, sorting, streams, spliterators) checked on the result.
+ */
+class ListsTest {
+
+    record Kind(String name, Supplier<IntList> make) {}
+
+    static List<Kind> kinds(TestCase tc) {
+        int cap = pick(tc, 0, 1, 2, 16);
+        return List.of(
+            new Kind("IntArrayList(" + cap + ")", () -> new IntArrayList(cap)),
+            new Kind("IntArrayList.wrap", () -> IntArrayList.wrap(new int[cap], 0)),
+            new Kind("IntBigArrayBigList(" + cap + ")", () -> new BigAsList(new IntBigArrayBigList(cap))));
+    }
+
+    static int elem(TestCase tc) {
+        return MapsTest.value(tc);
+    }
+
+    static List<Integer> elements(Iterable<Integer> s) {
+        List<Integer> out = new ArrayList<>();
+        for (Integer x : s) {
+            out.add(x);
+        }
+        return out;
+    }
+
+    static int[] arr(List<Integer> xs) {
+        return xs.stream().mapToInt(Integer::intValue).toArray();
+    }
+
+    @Test
+    void listsMatchTheJavaUtilModel() {
