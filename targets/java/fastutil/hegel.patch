+            check(IntBigArrays.length(wrapped) == len, () -> "wrapped length " + IntBigArrays.length(wrapped));
+            for (int i = 0; i < Math.min(len, 20); i++) {
+                int i0 = n(tc, 0, len - 1);
+                check(IntBigArrays.get(big, i0) == flat[i0], () -> "get(" + i0 + ")");
+            }
+            int from = n(tc, 0, len), to = n(tc, from, len);
+            int[] exp = flat.clone();
+            Arrays.sort(exp, from, to);
+            int alg = n(tc, 0, 4);
+            String[] names = {"quickSort", "radixSort", "parallelQuickSort", "quickSort(cmp)", "mergeSort(BigArrays)"};
+            count("big/" + names[alg]);
+            switch (alg) {
+                case 0 -> IntBigArrays.quickSort(big, from, to);
+                case 1 -> IntBigArrays.radixSort(big, from, to);
+                case 2 -> IntBigArrays.parallelQuickSort(big, from, to);
+                case 3 -> IntBigArrays.quickSort(big, from, to, (IntComparator) Integer::compare);
+                default -> {
+                    int[][] copy = IntBigArrays.copy(big);
+                    BigArrays.mergeSort(from, to, (x, y) -> Integer.compare(IntBigArrays.get(copy, x), IntBigArrays.get(copy, y)), (x, y) -> IntBigArrays.swap(copy, x, y));
+                    big = copy;
+                }
+            }
+            int[] got = new int[len];
