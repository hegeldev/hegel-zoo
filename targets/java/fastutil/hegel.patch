+        });
+    }
+
+    @Test
+    void objectSortsAreStableWhereDocumented() {
+        Zoo.run("objectSortsAreStableWhereDocumented", tc -> {
+            int len = pick(tc, n(tc, 0, 8), n(tc, 0, 60), n(tc, 0, 1000));
