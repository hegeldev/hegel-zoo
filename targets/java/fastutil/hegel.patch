+
+    static void compareState(IntSet fu, Set<Integer> model, boolean ordered, Kind kind, Supplier<String> info) {
+        List<Integer> exp = elements(model);
+        List<Integer> got = elements(fu);
+        if (ordered) {
+            check(got.equals(exp), () -> "elements " + got + " expected " + exp + info.get());
+        } else {
+            check(sorted(got).equals(sorted(exp)), () -> "elements " + got + " expected " + exp + info.get());
+        }
+        int[] arr = fu.toIntArray();
+        int[] arr2 = fu.toArray(new int[0]);
+        int[] arr3 = fu.toIntArray(new int[fu.size() + 3]);
+        check(Arrays.equals(arr, got.stream().mapToInt(Integer::intValue).toArray()), () -> "toIntArray " + Arrays.toString(arr) + info.get());
+        check(Arrays.equals(arr2, arr), () -> "toArray(int[0]) " + Arrays.toString(arr2) + info.get());
+        check(Arrays.equals(Arrays.copyOf(arr3, arr.length), arr), () -> "toIntArray(larger) " + Arrays.toString(arr3) + info.get());
+        Object[] boxed = fu.toArray();
+        check(boxed.length == arr.length && Arrays.equals(Arrays.stream(boxed).mapToInt(o -> (Integer) o).toArray(), arr), () -> "toArray() " + Arrays.toString(boxed) + info.get());
+        check(fu.equals(model) && model.equals(fu), () -> "equality with the model" + info.get());
+        check(fu.hashCode() == model.hashCode(), () -> "hashCode " + fu.hashCode() + " expected " + model.hashCode() + info.get());
+        check(fu.containsAll(model) && model.containsAll(fu), () -> "containsAll" + info.get());
+        check(fu.containsAll(new IntArrayList(arr)), () -> "containsAll(IntArrayList)" + info.get());
+        // streams and spliterators
+        long sum = 0;
+        for (int x : model) {
+            sum += x;
+        }
+        long expSum = sum;
+        check(fu.intStream().asLongStream().sum() == expSum, () -> "intStream sum" + info.get());
+        check(fu.intParallelStream().asLongStream().sum() == expSum, () -> "intParallelStream sum" + info.get());
+        long[] acc = {0, 0};
+        IntSpliterator sp = fu.spliterator();
+        check(sp.estimateSize() == model.size() || sp.estimateSize() == Long.MAX_VALUE, () -> "estimateSize " + sp.estimateSize() + info.get());
+        IntSpliterator half = sp.trySplit();
+        if (half != null) {
+            half.forEachRemaining((int x) -> acc[1] += x);
+        }
+        sp.forEachRemaining((int x) -> acc[0] += x);
+        check(acc[0] + acc[1] == expSum, () -> "split spliterator sum " + (acc[0] + acc[1]) + " expected " + expSum + info.get());
+        // skip through the iterator
+        if (!got.isEmpty()) {
+            int s = got.size() / 2;
+            IntIterator it = fu.iterator();
+            int skipped = it.skip(s);
+            check(skipped == s, () -> "skip(" + s + ") returned " + skipped + info.get());
+            List<Integer> rest = new ArrayList<>();
+            it.forEachRemaining((int x) -> rest.add(x));
+            check(rest.equals(got.subList(s, got.size())), () -> "rest after skip " + rest + " expected " + got.subList(s, got.size()) + info.get());
+            IntIterator it2 = fu.iterator();
+            int over = it2.skip(got.size() + 5);
+            check(over == got.size(), () -> "skip past the end returned " + over + " expected " + got.size() + info.get());
+            check(!it2.hasNext(), () -> "hasNext after skipping past the end" + info.get());
+        }
+        if (kind.sorted) {
+            compareSorted((IntSortedSet) fu, (TreeSet<Integer>) model, info);
+        }
+    }
+
+    static void compareSorted(IntSortedSet fu, TreeSet<Integer> model, Supplier<String> info) {
+        if (model.isEmpty()) {
+            check(Zoo.throwsClass(fu::firstInt) == NoSuchElementException.class, () -> "firstInt on empty: " + Zoo.throwsClass(fu::firstInt) + info.get());
+            check(Zoo.throwsClass(fu::lastInt) == NoSuchElementException.class, () -> "lastInt on empty: " + Zoo.throwsClass(fu::lastInt) + info.get());
+        } else {
+            check(fu.firstInt() == model.first() && fu.lastInt() == model.last(), () -> "first/last " + fu.firstInt() + "/" + fu.lastInt() + info.get());
+        }
+        int[] bounds = {Integer.MIN_VALUE, -13, -3, 0, 2, 5, 13, Integer.MAX_VALUE};
+        for (int lo : bounds) {
+            check(elements(fu.headSet(lo)).equals(elements(model.headSet(lo))), () -> "headSet(" + lo + ") " + fu.headSet(lo) + " expected " + model.headSet(lo) + info.get());
+            check(elements(fu.tailSet(lo)).equals(elements(model.tailSet(lo))), () -> "tailSet(" + lo + ") " + fu.tailSet(lo) + " expected " + model.tailSet(lo) + info.get());
+            check(fu.headSet(lo).size() == model.headSet(lo).size() && fu.tailSet(lo).size() == model.tailSet(lo).size(), () -> "head/tail sizes at " + lo + info.get());
+            for (int hi : bounds) {
+                if (lo > hi) {
+                    continue;
+                }
+                SortedSet<Integer> sm = model.subSet(lo, hi);
+                IntSortedSet fs = fu.subSet(lo, hi);
+                check(elements(fs).equals(elements(sm)), () -> "subSet(" + lo + "," + hi + ") " + fs + " expected " + sm + info.get());
+                check(fs.size() == sm.size() && fs.isEmpty() == sm.isEmpty(), () -> "subSet size " + fs.size() + " expected " + sm.size() + info.get());
+                if (!sm.isEmpty()) {
+                    check(fs.firstInt() == sm.first() && fs.lastInt() == sm.last(), () -> "subSet first/last" + info.get());
+                } else {
+                    check(Zoo.throwsClass(fs::firstInt) == NoSuchElementException.class, () -> "empty subSet firstInt: " + Zoo.throwsClass(fs::firstInt) + info.get());
+                }
+                for (int x : new int[] {lo, hi, 0, 3}) {
+                    check(fs.contains(x) == sm.contains(x), () -> "subSet(" + lo + "," + hi + ").contains(" + x + ") is " + fs.contains(x) + info.get());
+                }
+                // the sub set's elements backwards from its upper bound
+                IntBidirectionalIterator it = fs.iterator(hi);
+                List<Integer> back = new ArrayList<>();
+                while (it.hasPrevious()) {
+                    back.add(it.previousInt());
+                }
+                List<Integer> expBack = new ArrayList<>(sm);
+                Collections.reverse(expBack);
+                check(back.equals(expBack), () -> "subSet(" + lo + "," + hi + ") backwards from " + hi + ": " + back + " expected " + expBack + info.get());
+                // and a head set of the sub set
+                if (hi > lo) {
+                    int mid = lo + (int) (((long) hi - lo) / 2);
+                    check(elements(fs.headSet(mid)).equals(elements(sm.headSet(mid))), () -> "subSet.headSet(" + mid + ") " + fs.headSet(mid) + " expected " + sm.headSet(mid) + info.get());
+                    check(elements(fs.tailSet(mid)).equals(elements(sm.tailSet(mid))), () -> "subSet.tailSet(" + mid + ") " + fs.tailSet(mid) + " expected " + sm.tailSet(mid) + info.get());
+                }
+            }
+        }
+        // a bidirectional walk from a key present or absent, forward then all the way back
+        for (int from : new int[] {Integer.MIN_VALUE, -1, 0, 3, Integer.MAX_VALUE}) {
+            IntBidirectionalIterator it = fu.iterator(from);
+            List<Integer> fwd = new ArrayList<>();
+            while (it.hasNext()) {
+                fwd.add(it.nextInt());
+            }
+            List<Integer> expFwd = new ArrayList<>(model.tailSet(from, false));
+            check(fwd.equals(expFwd), () -> "iterator(" + from + ") forward " + fwd + " expected " + expFwd + info.get());
+            List<Integer> back = new ArrayList<>();
+            while (it.hasPrevious()) {
+                back.add(it.previousInt());
+            }
+            List<Integer> expBack = new ArrayList<>(model);
+            Collections.reverse(expBack);
+            check(back.equals(expBack), () -> "iterator(" + from + ") then backwards " + back + " expected " + expBack + info.get());
+            // back(n) and skip(n)
+            IntBidirectionalIterator it2 = fu.iterator(from);
+            int fwdCount = expFwd.size();
+            int s = it2.skip(2);
+            check(s == Math.min(2, fwdCount), () -> "iterator(" + from + ").skip(2) returned " + s + info.get());
+            int b = it2.back(3);
+            int expB = Math.min(3, model.size() - fwdCount + s);
+            check(b == expB, () -> "then back(3) returned " + b + " expected " + expB + info.get());
+        }
+        // the sorted spliterator carries a comparator and the sorted characteristic
+        IntSpliterator sp = fu.spliterator();
+        check(sp.hasCharacteristics(java.util.Spliterator.SORTED) && sp.hasCharacteristics(java.util.Spliterator.DISTINCT), () -> "sorted set spliterator characteristics " + sp.characteristics() + info.get());
+        check(sp.getComparator() == null || true, "comparator");
+    }
+}
