+import org.junit.jupiter.api.Test;
+
+/**
+ * Every {@code IntSet} implementation against the {@code java.util} set of the same contract, through
+ * a random script of the collection operations (primitive and boxed, bulk operations with fastutil
+ * and java.util arguments, iterator removal), with the sorted sets' views and bidirectional
+ * iterators checked against {@code TreeSet}.
+ */
+class SetsTest {
+
+    static final IntHash.Strategy NATURAL = new IntHash.Strategy() {
+        @Override public int hashCode(int e) { return Integer.hashCode(e); }
+        @Override public boolean equals(int a, int b) { return a == b; }
+    };
+
+    record Kind(String name, Supplier<IntSet> make, boolean sorted, boolean linked) {}
+
+    static List<Kind> kinds(TestCase tc) {
+        int cap = pick(tc, 0, 1, 2, 16, 64);
+        float lf = pick(tc, 0.75f, 0.5f, 0.25f, 0.95f);
+        return List.of(
+            new Kind("IntOpenHashSet(" + cap + "," + lf + ")", () -> new IntOpenHashSet(cap, lf), false, false),
+            new Kind("IntLinkedOpenHashSet(" + cap + "," + lf + ")", () -> new IntLinkedOpenHashSet(cap, lf), false, true),
+            new Kind("IntOpenCustomHashSet(" + cap + "," + lf + ")", () -> new IntOpenCustomHashSet(cap, lf, NATURAL), false, false),
+            new Kind("IntLinkedOpenCustomHashSet(" + cap + "," + lf + ")", () -> new IntLinkedOpenCustomHashSet(cap, lf, NATURAL), false, true),
+            new Kind("IntOpenHashBigSet(" + cap + "," + lf + ")", () -> new IntOpenHashBigSet(cap, lf), false, false),
+            new Kind("IntAVLTreeSet", IntAVLTreeSet::new, true, false),
+            new Kind("IntRBTreeSet", IntRBTreeSet::new, true, false),
+            new Kind("IntArraySet(" + cap + ")", () -> new IntArraySet(cap), false, false));
+    }
+
+    static int key(TestCase tc) {
+        return MapsTest.key(tc);
+    }
+
+    static List<Integer> elements(Iterable<Integer> s) {
+        List<Integer> out = new ArrayList<>();
+        for (Integer x : s) {
+            out.add(x);
+        }
+        return out;
+    }
+
+    static List<Integer> sorted(List<Integer> xs) {
+        List<Integer> c = new ArrayList<>(xs);
+        Collections.sort(c);
+        return c;
+    }
+
+    /** A collection argument for a bulk op: a fastutil set or list, or a java.util set. */
+    static java.util.Collection<Integer> arg(TestCase tc, List<Integer> xs, List<String> script) {
+        switch (n(tc, 0, 3)) {
+            case 0 -> { script.add("IntOpenHashSet" + xs); return new IntOpenHashSet(xs.stream().mapToInt(Integer::intValue).toArray()); }
+            case 1 -> { script.add("IntArrayList" + xs); return new IntArrayList(xs.stream().mapToInt(Integer::intValue).toArray()); }
+            case 2 -> { script.add("HashSet" + xs); return new HashSet<>(xs); }
+            default -> { script.add("IntRBTreeSet" + xs); return new IntRBTreeSet(xs.stream().mapToInt(Integer::intValue).toArray()); }
+        }
+    }
+
+    @Test
+    void setsMatchTheJavaUtilModel() {
+        Zoo.run("setsMatchTheJavaUtilModel", tc -> {
+            Kind kind = pick(tc, kinds(tc).toArray(Kind[]::new));
+            boolean ordered = kind.sorted || kind.linked;
+            count(kind.name.replaceAll("\\(.*", ""));
+            IntSet fu = kind.make.get();
+            Set<Integer> model = kind.sorted ? new TreeSet<>() : new LinkedHashSet<>();
+            List<String> script = new ArrayList<>();
+            Supplier<String> info = () -> "\n" + kind.name + "\nscript " + script + "\nfastutil " + fu + "\nmodel " + model;
+            int steps = n(tc, 0, 40);
+            for (int i = 0; i < steps; i++) {
+                int k = key(tc);
+                switch (n(tc, 0, 17)) {
+                    case 0, 1, 2, 3, 4 -> {
+                        script.add("add(" + k + ")");
+                        boolean exp = model.add(k);
+                        boolean got = fu.add(k);
+                        check(got == exp, () -> "add returned " + got + " expected " + exp + info.get());
+                    }
+                    case 5 -> {
+                        script.add("Add(" + k + ")");
+                        boolean exp = model.add(k);
+                        boolean got = fu.add(Integer.valueOf(k));
+                        check(got == exp, () -> "boxed add returned " + got + " expected " + exp + info.get());
+                    }
+                    case 6, 7 -> {
+                        script.add("remove(" + k + ")");
+                        boolean exp = model.remove(k);
+                        boolean got = fu.remove(k);
+                        check(got == exp, () -> "remove returned " + got + " expected " + exp + info.get());
+                    }
+                    case 8 -> {
+                        script.add("Remove(" + k + ")");
+                        boolean exp = model.remove(k);
+                        boolean got = fu.remove(Integer.valueOf(k));
+                        check(got == exp, () -> "boxed remove returned " + got + " expected " + exp + info.get());
+                    }
+                    case 9 -> {
+                        List<Integer> xs = new ArrayList<>();
+                        for (int j = n(tc, 0, 4); j > 0; j--) {
+                            xs.add(key(tc));
+                        }
+                        script.add("addAll");
+                        java.util.Collection<Integer> a = arg(tc, xs, script);
+                        boolean exp = model.addAll(a);
+                        boolean got = a instanceof IntCollection c && chance(tc, 70) ? fu.addAll(c) : fu.addAll(a);
+                        check(got == exp, () -> "addAll returned " + got + " expected " + exp + info.get());
+                    }
+                    case 10 -> {
+                        List<Integer> xs = new ArrayList<>(model);
+                        Collections.shuffle(xs, new java.util.Random(n(tc, 0, 1000)));
+                        xs = xs.subList(0, n(tc, 0, xs.size()));
+                        xs = new ArrayList<>(xs);
+                        if (chance(tc, 50)) {
+                            xs.add(key(tc));
+                        }
+                        script.add("removeAll");
+                        java.util.Collection<Integer> a = arg(tc, xs, script);
+                        boolean exp = model.removeAll(a);
+                        boolean got = a instanceof IntCollection c && chance(tc, 70) ? fu.removeAll(c) : fu.removeAll(a);
+                        check(got == exp, () -> "removeAll returned " + got + " expected " + exp + info.get());
+                    }
+                    case 11 -> {
+                        List<Integer> xs = new ArrayList<>(model);
+                        Collections.shuffle(xs, new java.util.Random(n(tc, 0, 1000)));
+                        xs = new ArrayList<>(xs.subList(0, n(tc, 0, xs.size())));
+                        if (chance(tc, 50)) {
+                            xs.add(key(tc));
+                        }
+                        script.add("retainAll");
+                        java.util.Collection<Integer> a = arg(tc, xs, script);
+                        boolean exp = model.retainAll(a);
+                        boolean got = a instanceof IntCollection c && chance(tc, 70) ? fu.retainAll(c) : fu.retainAll(a);
+                        check(got == exp, () -> "retainAll returned " + got + " expected " + exp + info.get());
+                    }
+                    case 12 -> {
+                        int m = pick(tc, 2, 3, 5);
+                        script.add("removeIf(x%" + m + "==0)");
+                        boolean exp = model.removeIf(x -> x % m == 0);
+                        boolean got = chance(tc, 50) ? fu.removeIf((int x) -> x % m == 0) : fu.removeIf((Integer x) -> x % m == 0);
+                        check(got == exp, () -> "removeIf returned " + got + " expected " + exp + info.get());
+                    }
+                    case 13 -> {
+                        // iterator removal of the elements with an odd value, skipping some with skip()
+                        script.add("iterator remove odd");
+                        model.removeIf(x -> (x & 1) != 0);
