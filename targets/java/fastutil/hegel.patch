+                        check(java.util.Objects.equals(got, exp), () -> "boxed merge returned " + got + " expected " + exp + info.get());
+                    }
+                    case 15 -> {
+                        script.add("compute(" + k + ")");
+                        Integer exp = model.compute(k, (kk, old) -> old == null ? Integer.valueOf(v) : (old + v) % 3 == 0 ? null : Integer.valueOf(old + v));
+                        int got = fu.compute(k, (kk, old) -> old == null ? Integer.valueOf(v) : (old + v) % 3 == 0 ? null : Integer.valueOf(old + v));
+                        check(got == (exp == null ? drv : exp), () -> "compute returned " + got + " expected " + (exp == null ? drv : exp) + info.get());
+                    }
+                    case 16 -> {
+                        script.add("computeIfAbsent(" + k + ")");
+                        Integer exp = model.computeIfAbsent(k, kk -> kk * 2);
+                        int got = fu.computeIfAbsent(k, (java.util.function.IntUnaryOperator) kk -> kk * 2);
+                        check(got == exp, () -> "computeIfAbsent returned " + got + " expected " + exp + info.get());
+                    }
+                    case 17 -> {
+                        script.add("computeIfAbsentNullable(" + k + ")");
+                        Integer exp = model.computeIfAbsent(k, kk -> kk % 2 == 0 ? null : kk);
+                        int got = fu.computeIfAbsentNullable(k, kk -> kk % 2 == 0 ? null : kk);
+                        check(got == (exp == null ? drv : exp), () -> "computeIfAbsentNullable returned " + got + " expected " + (exp == null ? drv : exp) + info.get());
+                    }
+                    case 18 -> {
+                        script.add("computeIfPresent(" + k + ")");
+                        Integer exp = model.computeIfPresent(k, (kk, old) -> old % 2 == 0 ? null : old + 1);
+                        int got = fu.computeIfPresent(k, (kk, old) -> old % 2 == 0 ? null : old + 1);
+                        check(got == (exp == null ? drv : exp), () -> "computeIfPresent returned " + got + " expected " + (exp == null ? drv : exp) + info.get());
+                    }
+                    case 19 -> {
+                        script.add("addTo(" + k + "," + v + ")");
+                        Integer old = model.get(k);
