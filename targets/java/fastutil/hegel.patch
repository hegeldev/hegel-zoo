+            List<Integer> model = new ArrayList<>();
+            List<String> script = new ArrayList<>();
+            Supplier<String> info = () -> "\n" + kind.name + "\nscript " + script + "\nfastutil " + fu + "\nmodel " + model;
+            int steps = n(tc, 0, 40);
+            for (int i = 0; i < steps; i++) {
+                int x = elem(tc);
+                int size = model.size();
+                int idx = n(tc, 0, size);
+                int pos = size == 0 ? -1 : n(tc, 0, size - 1);
+                switch (n(tc, 0, 24)) {
+                    case 0, 1, 2, 3 -> {
+                        script.add("add(" + x + ")");
+                        model.add(x);
+                        check(fu.add(x), () -> "add returned false" + info.get());
+                    }
+                    case 4 -> {
+                        script.add("add(" + idx + "," + x + ")");
+                        model.add(idx, x);
+                        fu.add(idx, x);
+                    }
+                    case 5 -> {
+                        if (pos < 0) {
