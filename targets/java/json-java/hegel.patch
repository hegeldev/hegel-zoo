new file mode 100644
index 0000000..01b63f4
--- /dev/null
+++ b/hegel/src/test/java/zoo/ParseTest.java
@@ -0,0 +1,486 @@
+package zoo;
+
+import static zoo.Zoo.chance;
+import static zoo.Zoo.check;
+import static zoo.Zoo.count;
+import static zoo.Zoo.n;
+import static zoo.Zoo.pick;
+
+import dev.hegel.TestCase;
+import java.math.BigDecimal;
+import java.math.BigInteger;
+import java.util.ArrayList;
+import java.util.List;
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+import org.json.JSONParserConfiguration;
+import org.json.JSONTokener;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Hegel zoo: org.json's parser against RFC 8259 (Jackson as the reference reader) in strict mode,
+ * against its own documented leniencies otherwise, and its number typing against the rules its
+ * javadoc states.
+ */
+class ParseTest {
+
+    static final JSONParserConfiguration STRICT = new JSONParserConfiguration().withStrictMode(true);
+
+    /** Parses an object or array text with org.json; the exception when it rejects it. */
+    static Object parse(String text, JSONParserConfiguration cfg) {
+        try {
+            JSONTokener t = new JSONTokener(text, cfg);
+            char c = t.nextClean();
+            t.back();
+            return c == '[' ? new JSONArray(t, cfg) : new JSONObject(t, cfg);
+        } catch (JSONException | StackOverflowError | NumberFormatException e) {
+            return e;
+        }
+    }
+
+    // ------------------------------------------------------------------ RFC 8259 text of a value, with every freedom the RFC gives
+
+    /** RFC-valid whitespace (or nothing). */
+    static String ws(TestCase tc) {
+        if (chance(tc, 70)) {
+            return "";
+        }
+        return Zoo.word(tc, " \t\n\r", 1, 3);
+    }
+
+    /** An RFC-valid string literal for s: characters raw or escaped as the RFC allows. */
+    static String rfcString(TestCase tc, String s) {
+        StringBuilder sb = new StringBuilder("\"");
+        for (int i = 0; i < s.length(); i++) {
+            char c = s.charAt(i);
+            int mode = n(tc, 0, 3);
+            if (c == '"' || c == '\\') {
+                sb.append(mode == 0 ? uEscape(c) : "\\" + c);
+            } else if (c < 0x20) {
+                String shortForm = c == '\b' ? "\\b" : c == '\f' ? "\\f" : c == '\n' ? "\\n" : c == '\r' ? "\\r" : c == '\t' ? "\\t" : null;
+                sb.append(shortForm != null && mode != 0 ? shortForm : uEscape(c));
+            } else if (c == '/') {
+                sb.append(mode == 0 ? "\\/" : mode == 1 ? uEscape(c) : "/");
+            } else if (mode == 0) {
+                sb.append(uEscape(c));
+            } else {
+                sb.append(c);
+            }
+        }
+        return sb.append('"').toString();
+    }
+
+    static String uEscape(char c) {
+        String hex = String.format("%04x", (int) c);
+        return "\\u" + (c > 0x7f && (c & 1) == 0 ? hex.toUpperCase() : hex);
+    }
+
+    /** An RFC-valid number literal for x (as a decimal): plain, or with an exponent, or with trailing fraction zeros. */
+    static String rfcNumber(TestCase tc, Number x) {
+        BigDecimal b = Gen.exact(x);
+        if (b.signum() == 0) {
+            return pick(tc, "0", "-0", "0.0", "0e0", "-0.0E+0", "0.000");
+        }
+        switch (n(tc, 0, 3)) {
+            case 0:
+                return b.toPlainString();
+            case 1: {
+                // d.ddd e exp
+                BigDecimal u = b.abs();
+                int exp = u.precision() - u.scale() - 1;
+                String digits = u.unscaledValue().toString();
+                String mant = digits.length() > 1 ? digits.charAt(0) + "." + digits.substring(1) : digits;
+                String e = pick(tc, "e", "E") + (exp >= 0 && chance(tc, 50) ? "+" : "") + exp;
+                return (b.signum() < 0 ? "-" : "") + mant + e;
+            }
+            case 2:
+                return b.toString();
+            default: {
+                String p = b.toPlainString();
+                return p.indexOf('.') >= 0 ? p + "0" : p + ".0";
+            }
+        }
+    }
+
+    /** RFC 8259 text of an org.json tree, exercising whitespace, escapes and number spellings. */
+    static String rfc(TestCase tc, Object o) {
+        StringBuilder sb = new StringBuilder();
+        rfc(tc, o, sb);
+        return sb.toString();
+    }
+
+    private static void rfc(TestCase tc, Object o, StringBuilder sb) {
+        sb.append(ws(tc));
+        if (Gen.isNull(o)) {
+            sb.append("null");
+        } else if (o instanceof Boolean) {
+            sb.append(o);
+        } else if (o instanceof Number x) {
+            sb.append(rfcNumber(tc, x));
+        } else if (o instanceof String s) {
+            sb.append(rfcString(tc, s));
+        } else if (o instanceof JSONObject j) {
+            sb.append('{');
+            boolean first = true;
+            for (String k : j.keySet()) {
+                if (!first) {
+                    sb.append(ws(tc)).append(',');
+                }
+                first = false;
+                sb.append(ws(tc)).append(rfcString(tc, k)).append(ws(tc)).append(':');
+                rfc(tc, j.opt(k), sb);
+            }
+            sb.append(ws(tc)).append('}');
+        } else if (o instanceof JSONArray a) {
+            sb.append('[');
+            for (int i = 0; i < a.length(); i++) {
+                if (i > 0) {
+                    sb.append(ws(tc)).append(',');
+                }
+                rfc(tc, a.opt(i), sb);
+            }
+            sb.append(ws(tc)).append(']');
+        }
+        sb.append(ws(tc));
+    }
+
+    static Object container(TestCase tc) {
+        return chance(tc, 50) ? Gen.object(tc, 3) : Gen.array(tc, 3);
+    }
+
+    @Test
+    void rfcTextParsesToItsValueInBothModes() {
+        Zoo.run("rfcTextParsesToItsValueInBothModes", tc -> {
+            Object o = container(tc);
+            String text = rfc(tc, o);
+            String want = Gen.canonical(o);
+            Object jack = RoundTripTest.jackson(text);
+            check(!(jack instanceof Exception), () -> "our RFC writer is wrong (Jackson rejects): " + jack + "\n text " + Zoo.show(text));
+            check(Gen.canonical(jack).equals(want), () -> "our RFC writer is wrong (Jackson reads another value)\n text " + Zoo.show(text)
+                    + "\n want " + want + "\n got  " + Gen.canonical(jack));
+            for (JSONParserConfiguration cfg : new JSONParserConfiguration[] {STRICT, new JSONParserConfiguration()}) {
+                String mode = cfg.isStrictMode() ? "strict" : "lenient";
+                Object got = parse(text, cfg);
+                check(!(got instanceof Throwable), () -> "org.json (" + mode + ") rejects RFC 8259 text: " + got + "\n text " + Zoo.show(text));
+                check(Gen.canonical(got).equals(want), () -> "org.json (" + mode + ") reads RFC 8259 text differently\n text " + Zoo.show(text)
+                        + "\n want " + want + "\n got  " + Gen.canonical(got));
+            }
+        });
+    }
+
+    // ------------------------------------------------------------------ mutations: strict mode against Jackson
+
+    static final String[] TOKENS = {
+        "0x1.8p1", "0x1p3", "1.5f", "1e5D", "1d", "1F", "01", "-01", "00", ".5", "5.", "+1", "-", "1e", "1e+", "1.2e6.3", "0x10", "1_0",
+        "Infinity", "-Infinity", "NaN", "TRUE", "True", "NULL", "Null", "FALSE", "nul", "tru",
+        "'a'", "'", "\"", "\\", "\\'", "\\u-123", "\\u+123", "\\u12", "\\x41", "\\U0041", "\\0", "\\a", "\\v",
+        "\u0001", "\u0000", "\u000b", "\f", "\u00a0", "\u2028", "\ufeff", "\t", "\n", " ",
+        ",", ",,", ";", "=", "=>", ":", "#", "//x\n", "/*x*/", "]", "}", "[", "{", "[]", "{}", "x", "abc", "1abc", "a b",
+        "\"\"", "\"a\"", "null", "true", "1", "-0", "0", "1E+2", "1e-2", "9223372036854775808", "\"\\/\"", "\"\\ud800\"",
+    };
+
+    /** The text with random tokens inserted, deleted or replaced; the result may or may not be JSON. */
+    static String mutate(TestCase tc, String text) {
+        StringBuilder sb = new StringBuilder(text);
+        int edits = chance(tc, 70) ? 1 : n(tc, 2, 3);
+        for (int e = 0; e < edits; e++) {
+            int at = sb.length() == 0 ? 0 : n(tc, 0, sb.length());
+            switch (n(tc, 0, 3)) {
+                case 0:
+                case 1:
+                    sb.insert(at, pick(tc, TOKENS));
+                    break;
+                case 2:
+                    if (at < sb.length()) {
+                        sb.deleteCharAt(at);
+                    }
+                    break;
+                default:
+                    if (at < sb.length()) {
+                        sb.replace(at, at + 1, pick(tc, TOKENS));
+                    }
+            }
+        }
+        return sb.toString();
+    }
+
+    @Test
+    void strictModeAgreesWithJacksonOnMutatedText() {
+        Zoo.run("strictModeAgreesWithJacksonOnMutatedText", tc -> {
+            Object o = container(tc);
+            String text = mutate(tc, chance(tc, 50) ? Gen.standard(o) : rfc(tc, o));
+            String trimmed = text.trim();
+            if (trimmed.isEmpty() || (trimmed.charAt(0) != '[' && trimmed.charAt(0) != '{')) {
+                return; // org.json parses only objects and arrays at the root
+            }
+            Object jack = RoundTripTest.jackson(text);
+            Object got = parse(text, STRICT);
+            boolean jackOk = !(jack instanceof Exception);
+            boolean gotOk = !(got instanceof Throwable);
+            if (!jackOk && firstLine(jack).contains("Too many")) {
+                count("jackson limit"); // Jackson's own number-size limits, not a JSON rule
+                return;
+            }
+            count(jackOk ? (gotOk ? "both accept" : "jackson only") : (gotOk ? "strict only" : "both reject"));
+            if (jackOk && !gotOk) {
+                Zoo.fail("strict mode rejects RFC 8259 text that Jackson accepts: " + got + "\n text " + Zoo.show(text));
+            } else if (!jackOk && gotOk) {
+                Zoo.fail("strict mode accepts text Jackson rejects (" + firstLine(jack) + ")\n text " + Zoo.show(text) + "\n value " + Gen.canonical(got));
+            } else if (jackOk) {
+                check(Gen.canonical(jack).equals(Gen.canonical(got)), () -> "strict mode reads another value than Jackson\n text " + Zoo.show(text)
+                        + "\n jackson " + Gen.canonical(jack) + "\n orgjson " + Gen.canonical(got));
+            }
+        });
+    }
+
+    static String firstLine(Object e) {
+        String s = String.valueOf(e instanceof Exception x ? x.getMessage() : e);
+        int nl = s.indexOf('\n');
+        return nl < 0 ? s : s.substring(0, nl);
+    }
+
+    // ------------------------------------------------------------------ the documented leniencies
+
+    /** A word that the lenient parser reads as a string when unquoted: letters and underscores, not a keyword. */
+    static String bareWord(TestCase tc) {
+        while (true) {
+            String w = Zoo.word(tc, "abcdefXYZ_", 1, 6);
+            if (!w.equalsIgnoreCase("true") && !w.equalsIgnoreCase("false") && !w.equalsIgnoreCase("null")) {
+                return w;
+            }
+        }
+    }
+
+    /** A tree whose strings can be written unquoted when the generator chooses to. */
+    static Object lenientValue(TestCase tc, int depth) {
+        if (depth <= 0 || chance(tc, 50)) {
+            return chance(tc, 40) ? bareWord(tc) : Gen.scalar(tc);
+        }
+        if (chance(tc, 50)) {
+            JSONObject o = new JSONObject();
+            int size = n(tc, 0, 4);
+            for (int i = 0; i < size; i++) {
+                o.put(chance(tc, 60) ? bareWord(tc) : Gen.key(tc), lenientValue(tc, depth - 1));
+            }
+            return o;
+        }
+        JSONArray a = new JSONArray();
+        int size = n(tc, 0, 4);
+        for (int i = 0; i < size; i++) {
+            a.put(lenientValue(tc, depth - 1));
+        }
+        return a;
+    }
+
+    static boolean isBareWord(String s) {
+        return s.matches("[a-zA-Z_]+") && !s.equalsIgnoreCase("true") && !s.equalsIgnoreCase("false") && !s.equalsIgnoreCase("null");
+    }
+
+    /** A string in one of the lenient spellings: double quotes, single quotes, or bare when it is a bare word. */
+    static String lenientString(TestCase tc, String s) {
+        int mode = n(tc, 0, 2);
+        if (mode == 0 && isBareWord(s)) {
+            return s;
+        }
+        if (mode == 1 && s.indexOf('\'') < 0) {
+            return "'" + rfcString(tc, s).replaceAll("^\"|\"$", "") + "'";
+        }
+        return rfcString(tc, s);
+    }
+
+    /** Lenient text of a tree: bare words, single quotes, ';' between members, ',,' and trailing commas in arrays as nulls. */
+    static void lenient(TestCase tc, Object o, StringBuilder sb) {
+        sb.append(ws(tc));
+        if (Gen.isNull(o)) {
+            sb.append(pick(tc, "null", "NULL", "Null"));
+        } else if (o instanceof Boolean b) {
+            sb.append(chance(tc, 30) ? b.toString().toUpperCase() : b.toString());
+        } else if (o instanceof Number x) {
+            sb.append(rfcNumber(tc, x));
+        } else if (o instanceof String s) {
+            sb.append(lenientString(tc, s));
+        } else if (o instanceof JSONObject j) {
+            sb.append('{');
+            boolean first = true;
+            for (String k : j.keySet()) {
+                if (!first) {
+                    sb.append(ws(tc)).append(pick(tc, ",", ";"));
+                }
+                first = false;
+                sb.append(ws(tc)).append(lenientString(tc, k)).append(ws(tc)).append(':');
+                lenient(tc, j.opt(k), sb);
+            }
+            if (!first && chance(tc, 30)) {
+                sb.append(ws(tc)).append(',');
+            }
+            sb.append(ws(tc)).append('}');
+        } else if (o instanceof JSONArray a) {
+            sb.append('[');
+            for (int i = 0; i < a.length(); i++) {
+                if (i > 0) {
+                    sb.append(ws(tc)).append(',');
+                }
+                if (Gen.isNull(a.opt(i)) && i < a.length() - 1 && chance(tc, 50)) {
+                    sb.append(ws(tc)); // an omitted element before a comma reads as null (a trailing comma is ignored)
+                } else {
+                    lenient(tc, a.opt(i), sb);
+                }
+            }
+            if (a.length() > 0 && chance(tc, 30)) {
+                sb.append(ws(tc)).append(',');
+            }
+            sb.append(ws(tc)).append(']');
+        }
+        sb.append(ws(tc));
+    }
+
+    @Test
+    void lenientSpellingsParseToTheValue() {
+        Zoo.run("lenientSpellingsParseToTheValue", tc -> {
+            Object o = chance(tc, 50) ? lenientValue(tc, 3) : new JSONArray().put(lenientValue(tc, 2));
+            if (!(o instanceof JSONObject) && !(o instanceof JSONArray)) {
+                o = new JSONArray().put(o);
+            }
+            StringBuilder sb = new StringBuilder();
+            lenient(tc, o, sb);
+            String text = sb.toString();
+            String want = Gen.canonical(o);
+            Object got = parse(text, new JSONParserConfiguration());
+            check(!(got instanceof Throwable), () -> "lenient parser rejects a documented spelling: " + got + "\n text " + Zoo.show(text));
+            check(Gen.canonical(got).equals(want), () -> "lenient parser reads a documented spelling differently\n text " + Zoo.show(text)
+                    + "\n want " + want + "\n got  " + Gen.canonical(got));
+        });
+    }
+
+    // ------------------------------------------------------------------ number typing
+
+    @Test
+    void integerTextsGetTheNarrowestType() {
+        Zoo.run("integerTextsGetTheNarrowestType", tc -> {
+            BigInteger v = chance(tc, 40) ? new BigInteger(Zoo.word(tc, "0123456789", 1, 25))
+                    : BigInteger.valueOf(pick(tc, 0L, 1L, -1L, (long) Integer.MAX_VALUE, (long) Integer.MIN_VALUE, Long.MAX_VALUE, Long.MIN_VALUE, 1L << 31, -(1L << 31) - 1))
+                            .add(BigInteger.valueOf(n(tc, -2, 2)));
+            if (chance(tc, 30)) {
+                v = v.negate();
+            }
+            String text = v.toString();
+            Object got = JSONObject.stringToValue(text);
+            Class<?> want = v.signum() == 0 && text.startsWith("-") ? Double.class
+                    : v.bitLength() <= 31 ? Integer.class : v.bitLength() <= 63 ? Long.class : BigInteger.class;
+            check(got.getClass() == want, () -> "stringToValue(" + text + ") is a " + got.getClass().getSimpleName() + ", want " + want.getSimpleName());
+            check(got instanceof Number x && Gen.exact(x).compareTo(new BigDecimal(v)) == 0, () -> "stringToValue(" + text + ") = " + got);
+            Object inArray = new JSONArray("[" + text + "]").get(0);
+            check(inArray.getClass() == want && Gen.exact((Number) inArray).compareTo(new BigDecimal(v)) == 0,
+                    () -> "[" + text + "] parses to " + Zoo.show(inArray));
+            // the written form is the text itself, and reads back the same way
+            JSONArray a = new JSONArray().put(got);
+            check(a.toString().equals("[" + text + "]"), () -> "toString of [" + text + "] is " + a);
+        });
+    }
+
+    @Test
+    void decimalTextsKeepTheirValue() {
+        Zoo.run("decimalTextsKeepTheirValue", tc -> {
+            Number x = Gen.finiteNumber(tc);
+            String text = rfcNumber(tc, x);
+            BigDecimal want = Gen.exact(x);
+            Object got = JSONObject.stringToValue(text);
+            check(got instanceof Number, () -> "stringToValue(" + text + ") is not a number: " + Zoo.show(got));
+            check(Gen.exact((Number) got).compareTo(want) == 0, () -> "stringToValue(" + text + ") = " + Zoo.show(got) + ", want " + want);
+            // numberToString then parse is the identity on the value, for every type org.json supports
+            String written = JSONObject.numberToString(x);
+            Object back = JSONObject.stringToValue(written);
+            check(back instanceof Number b && Gen.exact(b).compareTo(want) == 0,
+                    () -> "numberToString(" + Zoo.show(x) + ") = " + written + " reads back as " + Zoo.show(back));
+            Object jack = RoundTripTest.jackson("[" + written + "]");
+            check(!(jack instanceof Exception) && Gen.canonical(jack).equals("[" + Gen.canonicalNumber(x) + "]"),
+                    () -> "Jackson reads numberToString(" + Zoo.show(x) + ") = " + written + " as " + Gen.canonical(jack));
+        });
+    }
+
+    // ------------------------------------------------------------------ strings
+
+    @Test
+    void quoteReadsBackAndIsStandard() {
+        Zoo.run("quoteReadsBackAndIsStandard", tc -> {
+            String s = Gen.string(tc);
+            String q = JSONObject.quote(s);
+            Object back = new JSONTokener(q).nextValue();
+            check(s.equals(back), () -> "quote then nextValue changed " + Zoo.show(s) + " -> " + q + " -> " + Zoo.show(back));
+            Object strict = parse("[" + q + "]", STRICT);
+            check(strict instanceof JSONArray a && s.equals(a.opt(0)), () -> "strict mode does not read quote's output " + q + ": " + strict);
+            Object jack = RoundTripTest.jackson("[" + q + "]");
+            check(jack instanceof List<?> l && s.equals(l.get(0)), () -> "Jackson does not read quote's output " + q + " as the string: " + jack);
+            // quote never leaves a raw control character or an unescaped quote/backslash
+            for (int i = 1; i < q.length() - 1; i++) {
+                char c = q.charAt(i);
+                if (c < 0x20) {
+                    Zoo.fail("quote(" + Zoo.show(s) + ") = " + Zoo.show(q) + " contains a raw control character");
+                    return;
+                }
+            }
+        });
+    }
+
+    @Test
+    void stringToValueIsTotal() {
+        Zoo.run("stringToValueIsTotal", tc -> {
+            String s = chance(tc, 50) ? Gen.string(tc) : mutate(tc, rfcNumber(tc, Gen.finiteNumber(tc)));
+            Object v;
+            try {
+                v = JSONObject.stringToValue(s);
+            } catch (RuntimeException e) {
+                Zoo.fail("stringToValue(" + Zoo.show(s) + ") throws " + e);
+                return;
+            }
+            if (v instanceof String) {
+                check(v.equals(s), () -> "stringToValue(" + Zoo.show(s) + ") returned another string: " + Zoo.show(v));
+            } else if (v instanceof Number x) {
+                // a numeric result is the value the text denotes, as Java's own parsers read it
+                BigDecimal want;
+                try {
+                    want = new BigDecimal(s.trim());
+                } catch (NumberFormatException e) {
+                    want = null;
+                }
+                if (want == null) {
+                    count("java-only number syntax");
+                    check(!STRICT.isStrictMode() || true, "unreachable");
+                } else {
+                    BigDecimal w = want;
+                    check(Gen.exact(x).compareTo(w) == 0, () -> "stringToValue(" + Zoo.show(s) + ") = " + Zoo.show(v) + ", want " + w);
+                }
+            } else {
+                check(v == JSONObject.NULL || v instanceof Boolean, () -> "stringToValue(" + Zoo.show(s) + ") = " + Zoo.show(v));
+                check(s.equalsIgnoreCase("null") || s.equalsIgnoreCase("true") || s.equalsIgnoreCase("false"),
+                        () -> "stringToValue(" + Zoo.show(s) + ") = " + Zoo.show(v) + " for a text that is not a keyword");
+            }
+        });
+    }
+
+    /** Depth: the parser's own limit is a StackOverflowError wrapped as JSONException; nesting up to 512 must work. */
+    @Test
+    void nestingUpToTheDocumentedDepthParses() {
+        Zoo.run("nestingUpToTheDocumentedDepthParses", tc -> {
+            int depth = n(tc, 1, 400);
+            boolean arrays = chance(tc, 50);
+            StringBuilder sb = new StringBuilder();
+            for (int i = 0; i < depth; i++) {
+                sb.append(arrays ? "[" : "{\"k\":");
+            }
+            sb.append(arrays ? "1" : "1");
+            for (int i = 0; i < depth; i++) {
+                sb.append(arrays ? "]" : "}");
+            }
+            String text = sb.toString();
+            Object got = parse(text, STRICT);
+            check(!(got instanceof Throwable), () -> "depth " + depth + " rejected: " + got);
+            String back = got.toString();
+            check(back.equals(text), () -> "depth " + depth + " toString differs: " + back.substring(0, Math.min(80, back.length())));
+            List<Object> l = new ArrayList<>();
+            l.add(1);
+            count("depth " + (depth / 100) + "xx");
+        });
+    }
+}
diff --git a/hegel/src/test/java/zoo/PinsTest.java b/hegel/src/test/java/zoo/PinsTest.java
new file mode 100644
index 0000000..fb14d71
