+    // ------------------------------------------------------------------ RFC 8259 text of a value, with every freedom the RFC gives
+
+    /** The spelling of a number: which form (0 plain), which zero spelling (0 "0"), an upper-case E, an explicit '+' in the exponent. */
+    record NumberStyle(int form, int zero, boolean upperE, boolean plus) {
+        static final NumberStyle PLAIN = new NumberStyle(0, 0, false, false);
+    }
+
+    static final Generator<NumberStyle> NUMBER_STYLE = tuples(ints(0, 3), ints(0, 5), chance(50), chance(50))
+            .map(t -> new NumberStyle(t.value1(), t.value2(), t.value3(), t.value4()));
+
+    static final String[] ZEROS = {"0", "-0", "0.0", "0e0", "-0.0E+0", "0.000"};
+
+    /** An RFC-valid number literal for x (as a decimal): plain, or with an exponent, or with trailing fraction zeros. */
+    static String rfcNumber(Number x, NumberStyle style) {
