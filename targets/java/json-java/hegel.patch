+<?xml version="1.0" encoding="UTF-8"?>
+<!-- Hegel zoo: property-based tests for JSON-java (org.json) against the library built from this checkout
+     (`mvn -DskipTests install` at the root first; see targets/java/json-java in the zoo). -->
+<project xmlns="http://maven.apache.org/POM/4.0.0"
+         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
+         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
+  <modelVersion>4.0.0</modelVersion>
+  <groupId>dev.hegel.zoo</groupId>
+  <artifactId>json-java-hegel</artifactId>
+  <version>0</version>
+  <packaging>jar</packaging>
+
+  <properties>
+    <maven.compiler.release>22</maven.compiler.release>
+    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
+    <json.version>20260814</json.version>
+    <hegel.version>0.6.0</hegel.version>
+    <junit.version>5.11.4</junit.version>
+  </properties>
+
+  <dependencies>
+    <dependency>
+      <groupId>org.json</groupId>
+      <artifactId>json</artifactId>
+      <version>${json.version}</version>
+    </dependency>
+    <dependency>
+      <groupId>com.fasterxml.jackson.core</groupId>
+      <artifactId>jackson-databind</artifactId>
+      <version>2.18.2</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>com.google.code.gson</groupId>
+      <artifactId>gson</artifactId>
+      <version>2.11.0</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>dev.hegel</groupId>
+      <artifactId>hegel</artifactId>
+      <version>${hegel.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.jupiter</groupId>
+      <artifactId>junit-jupiter</artifactId>
+      <version>${junit.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.platform</groupId>
+      <artifactId>junit-platform-launcher</artifactId>
+      <version>1.11.4</version>
+      <scope>test</scope>
+    </dependency>
+  </dependencies>
+
+  <build>
+    <plugins>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-compiler-plugin</artifactId>
+        <version>3.13.0</version>
+      </plugin>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-surefire-plugin</artifactId>
+        <version>3.5.2</version>
+        <configuration>
+          <argLine>--enable-native-access=ALL-UNNAMED</argLine>
+          <trimStackTrace>false</trimStackTrace>
+          <!-- every test's `ZOO …` line is what the zoo judges; Maven's exit code is not -->
+          <testFailureIgnore>true</testFailureIgnore>
+        </configuration>
+      </plugin>
+    </plugins>
+  </build>
+</project>
diff --git a/hegel/src/test/java/zoo/ApiTest.java b/hegel/src/test/java/zoo/ApiTest.java
new file mode 100644
index 0000000..c9fbed6
--- /dev/null
+++ b/hegel/src/test/java/zoo/ApiTest.java
@@ -0,0 +1,438 @@
+package zoo;
+
+import static dev.hegel.Generators.just;
+import static dev.hegel.Generators.lists;
+import static dev.hegel.Generators.maps;
+import static dev.hegel.Generators.tuples;
+import static zoo.Gen.INDEX;
+import static zoo.Gen.chance;
+import static zoo.Gen.ints;
+import static zoo.Gen.many;
+import static zoo.Gen.maybe;
+import static zoo.Gen.pick;
+import static zoo.Gen.v;
+import static zoo.Gen.w;
+import static zoo.Gen.weighted;
+import static zoo.Zoo.check;
+import static zoo.Zoo.count;
+
+import dev.hegel.Generator;
+import dev.hegel.Tuple2;
+import dev.hegel.Tuple3;
+import java.math.BigDecimal;
+import java.math.BigInteger;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.function.UnaryOperator;
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+import org.json.JSONParserConfiguration;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Hegel zoo: the Java-side API of org.json — {@code similar} as an equivalence, the parser
+ * configuration's builders, nesting-depth limits, and the collection constructors — against
+ * what the javadoc states.
+ */
+class ApiTest {
+
+    // ------------------------------------------------------------------ similar
+
+    /** The values the typed numbers are made of, so that equal values meet in different types. */
+    static final Generator<BigDecimal> BASE = pick(BigDecimal.ZERO, BigDecimal.ONE, new BigDecimal("-1"), new BigDecimal("0.5"), new BigDecimal("2"), new BigDecimal("1.5"),
+            new BigDecimal("100"), new BigDecimal("9007199254740993"), new BigDecimal("0.1"));
+
+    static Number asInt(BigDecimal v) {
+        return v.scale() <= 0 && v.abs().compareTo(new BigDecimal(Integer.MAX_VALUE)) <= 0 ? v.intValueExact() : v;
+    }
+
+    static Number asLong(BigDecimal v) {
+        return v.scale() <= 0 && v.abs().compareTo(new BigDecimal(Long.MAX_VALUE)) <= 0 ? v.longValueExact() : v;
+    }
+
+    static Number asBigInteger(BigDecimal v) {
+        return v.scale() <= 0 ? v.toBigIntegerExact() : v;
+    }
+
+    static Number asDouble(BigDecimal v, boolean negativeZero) {
+        return v.doubleValue() == 0 && negativeZero ? -0.0 : v.doubleValue();
+    }
+
+    static Number asFloat(BigDecimal v, boolean negativeZero) {
+        return v.floatValue() == 0 && negativeZero ? -0.0f : v.floatValue();
+    }
+
+    static Number scaled(BigDecimal v, int extra) {
+        return v.setScale(v.scale() + extra);
+    }
+
+    static final Generator<Number> AS_BIG_DECIMAL = BASE.map(v -> v);
+    static final Generator<Number> AS_INT = BASE.map(ApiTest::asInt);
+    static final Generator<Number> AS_LONG = BASE.map(ApiTest::asLong);
+    static final Generator<Number> AS_BIG_INTEGER = BASE.map(ApiTest::asBigInteger);
+    static final Generator<Number> AS_DOUBLE = tuples(BASE, chance(50)).map(t -> asDouble(t.value1(), t.value2()));
+    static final Generator<Number> AS_FLOAT = tuples(BASE, chance(50)).map(t -> asFloat(t.value1(), t.value2()));
+    static final Generator<Number> SCALED = tuples(BASE, ints(0, 3)).map(t -> scaled(t.value1(), t.value2()));
+
+    /** A number of every supported type over the base values (a zero may be a negative zero in double or float). */
+    static final Generator<Number> TYPED_NUMBER = weighted(
+            w(1, AS_BIG_DECIMAL), w(1, AS_INT), w(1, AS_LONG), w(1, AS_BIG_INTEGER), w(1, AS_DOUBLE), w(1, AS_FLOAT), w(1, SCALED));
+
+    /** A scalar for similar: typed numbers (half the time), a few strings, NULL and the booleans. */
+    static final Generator<Object> SIM_SCALAR = Gen.<Object>weighted(
+            w(2, TYPED_NUMBER), w(1, pick("a", "b", "1", "")), w(1, pick(JSONObject.NULL, Boolean.TRUE, Boolean.FALSE)));
+
+    private static final List<Generator<Object>> SIM_VALUES = new ArrayList<>(List.of(SIM_SCALAR));
+
+    /** A value for similar up to the given depth: a scalar (50%), or an object over the keys k, l, m or an array (25% each). */
+    static Generator<Object> simValue(int depth) {
+        while (SIM_VALUES.size() <= depth) {
+            int d = SIM_VALUES.size();
+            Generator<Object> object = maps(pick("k", "l", "m"), simValue(d - 1)).maxSize(3).map(Gen::toObject);
+            Generator<Object> array = lists(simValue(d - 1)).maxSize(3).map(Gen::toArray);
+            SIM_VALUES.add(Gen.<Object>weighted(w(50, SIM_SCALAR), w(25, object), w(25, array)));
+        }
+        return SIM_VALUES.get(depth);
+    }
+
+    /** The model of similar: same shape, same keys, numbers by value (all finite here), strings and booleans by equals. */
+    static boolean modelSimilar(Object a, Object b) {
+        if (Gen.isNull(a) || Gen.isNull(b)) {
+            return Gen.isNull(a) && Gen.isNull(b);
+        }
+        if (a instanceof Number x && b instanceof Number y) {
+            return numberSimilar(x, y);
+        }
+        if (a instanceof JSONObject o && b instanceof JSONObject p) {
+            if (!o.keySet().equals(p.keySet())) {
+                return false;
+            }
+            for (String k : o.keySet()) {
+                if (!modelSimilar(o.opt(k), p.opt(k))) {
+                    return false;
+                }
+            }
+            return true;
+        }
+        if (a instanceof JSONArray o && b instanceof JSONArray p) {
+            if (o.length() != p.length()) {
+                return false;
+            }
+            for (int i = 0; i < o.length(); i++) {
+                if (!modelSimilar(o.opt(i), p.opt(i))) {
+                    return false;
+                }
+            }
+            return true;
+        }
+        return a.getClass() == b.getClass() && a.equals(b);
+    }
+
+    /** isNumberSimilar's documented algorithm: the same type compares with compareTo (so 0.0 and -0.0 differ), otherwise by BigDecimal value. */
+    @SuppressWarnings({"rawtypes", "unchecked"})
+    static boolean numberSimilar(Number x, Number y) {
+        if (x.getClass() == y.getClass() && x instanceof Comparable c) {
+            return c.compareTo(y) == 0;
+        }
+        return Gen.exact(x).compareTo(Gen.exact(y)) == 0;
+    }
+
+    static boolean similar(Object a, Object b) {
+        if (a instanceof JSONObject o) {
+            return o.similar(b);
+        }
+        return ((JSONArray) a).similar(b);
+    }
+
+    /** Two values two levels deep; the second is absent (null) when it is to be the re-parse of the first's text. */
+    static final Generator<Tuple2<Object, Object>> SIMILAR_PAIR = tuples(simValue(2), maybe(50, (Object) null, simValue(2)));
+
+    @Test
+    void similarIsValueEqualityUpToNumberType() {
+        Zoo.run("similarIsValueEqualityUpToNumberType", tc -> {
+            Tuple2<Object, Object> c = tc.draw(SIMILAR_PAIR, "pair");
+            // wrap scalars in arrays so that similar applies
+            Object a = new JSONArray().put(c.value1());
+            Object b = c.value2() != null ? new JSONArray().put(c.value2()) : new JSONArray(a.toString());
+            boolean want = modelSimilar(a, b);
+            boolean got = similar(a, b);
+            boolean got2 = similar(b, a);
+            count(want ? "similar" : "different");
+            check(got == want, () -> a + ".similar(" + b + ") = " + got + ", want " + want + " (" + Zoo.show(((JSONArray) a).opt(0)) + " vs " + Zoo.show(((JSONArray) b).opt(0)) + ")");
+            check(got == got2, () -> "similar is not symmetric: " + a + " vs " + b + ": " + got + " / " + got2);
+            check(similar(a, a), () -> "similar is not reflexive on " + a);
+        });
+    }
+
+    /** The same value as x in another type: x's BigDecimal itself, a double or float (a negative zero for zero), more scale, a long, a BigInteger. */
+    static Generator<Number> sameValue(Number x) {
+        BigDecimal v = Gen.exact(x);
+        Generator<Number> asDouble = chance(50).map(nz -> asDouble(v, nz));
+        Generator<Number> asFloat = chance(50).map(nz -> asFloat(v, nz));
+        Generator<Number> scaled = ints(1, 3).map(extra -> scaled(v, extra));
+        return weighted(v(1, (Number) v), w(1, asDouble), w(1, asFloat), w(1, scaled), v(1, asLong(v)), v(1, asBigInteger(v)));
+    }
+
+    /** A typed number and a partner: the same value in another type, or an independent typed number. */
+    static final Generator<Tuple2<Number, Number>> NUMBER_PAIR = TYPED_NUMBER.flatMap(x -> tuples(just(x), weighted(w(1, sameValue(x)), w(1, TYPED_NUMBER))));
+
+    /** Pairs of typed numbers over a few values, so that -0.0f meets 0.0f, 1 meets 1.0 and 1.00, and so on. */
+    @Test
+    void similarOnNumberPairsIsValueEquality() {
+        Zoo.run("similarOnNumberPairsIsValueEquality", tc -> {
+            Tuple2<Number, Number> pair = tc.draw(NUMBER_PAIR, "pair");
+            Number x = pair.value1();
+            Number y = pair.value2();
+            boolean want = numberSimilar(x, y);
+            JSONArray a = new JSONArray().put(x);
+            JSONArray b = new JSONArray().put(y);
+            boolean got = a.similar(b);
+            count(want ? "equal values" : "different values");
+            check(got == want, () -> "[" + Zoo.show(x) + "].similar([" + Zoo.show(y) + "]) = " + got + ", want " + want);
+            check(got == b.similar(a), () -> "similar is not symmetric for " + Zoo.show(x) + " and " + Zoo.show(y));
+            JSONObject o = new JSONObject().put("k", x);
+            check(o.similar(new JSONObject().put("k", y)) == want, () -> "JSONObject.similar differs from JSONArray.similar for " + Zoo.show(x) + " and " + Zoo.show(y));
+        });
+    }
+
+    static final Generator<Object> IN_ARRAY = simValue(3).map(x -> new JSONArray().put(x));
+    static final Generator<Object> IN_OBJECT = simValue(3).map(x -> new JSONObject().put("k", x));
+    /** A value three levels deep held in an array or in an object. */
+    static final Generator<Object> WRAPPED = Gen.<Object>weighted(w(1, IN_ARRAY), w(1, IN_OBJECT));
+
+    @Test
+    void similarSurvivesAToStringRoundTrip() {
+        Zoo.run("similarSurvivesAToStringRoundTrip", tc -> {
+            Object a = tc.draw(WRAPPED, "value");
+            String text = a.toString();
+            Object back = a instanceof JSONObject ? new JSONObject(text) : new JSONArray(text);
+            check(similar(a, back), () -> a + " is not similar to its re-parsed toString " + text);
+            check(similar(back, a), () -> "re-parsed " + text + " is not similar to the original " + a);
+        });
+    }
+
+    // ------------------------------------------------------------------ parser configuration
+
+    /** The six settings and the order the builder calls are made in (positions modulo the calls left; all zeros is the declared order). */
+    record ParserConfig(boolean keepStrings, int depth, int numLen, boolean overwrite, boolean nativeNulls, boolean strict, List<Integer> order) {
+        List<UnaryOperator<JSONParserConfiguration>> steps() {
+            return Gen.permuted(List.of(
+                    c -> c.withKeepStrings(keepStrings), c -> c.withMaxNestingDepth(depth), c -> c.withMaxNumberLength(numLen),
+                    c -> c.withOverwriteDuplicateKey(overwrite), c -> c.withUseNativeNulls(nativeNulls), c -> c.withStrictMode(strict)), order);
+        }
+
+        String expected() {
+            return "keepStrings=" + keepStrings + " maxNestingDepth=" + depth + " maxNumberLength=" + numLen
+                    + " overwriteDuplicateKey=" + overwrite + " useNativeNulls=" + nativeNulls + " strictMode=" + strict;
+        }
+    }
+
+    static final Generator<ParserConfig> PARSER_CONFIG = tuples(chance(50), pick(1, 5, 512, 1000, -1), pick(3, 10, 1000, -1), chance(50), chance(50), chance(50), many(INDEX, 6, 6))
+            .map(t -> new ParserConfig(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6(), t.value7()));
+
+    @Test
+    void parserConfigurationBuildersAreOrderIndependentAndLossless() {
+        Zoo.run("parserConfigurationBuildersAreOrderIndependentAndLossless", tc -> {
+            ParserConfig p = tc.draw(PARSER_CONFIG, "config");
+            JSONParserConfiguration c = new JSONParserConfiguration();
+            for (var step : p.steps()) {
+                c = step.apply(c);
+            }
+            String got = "keepStrings=" + c.isKeepStrings() + " maxNestingDepth=" + c.getMaxNestingDepth() + " maxNumberLength=" + c.getMaxNumberLength()
+                    + " overwriteDuplicateKey=" + c.isOverwriteDuplicateKey() + " useNativeNulls=" + c.isUseNativeNulls() + " strictMode=" + c.isStrictMode();
+            String want = p.expected();
+            check(got.equals(want), () -> "JSONParserConfiguration after the builder calls\n want " + want + "\n got  " + got);
+        });
+    }
+
+    /** A number-length limit and a digit count. */
+    static final Generator<Tuple2<Integer, Integer>> LIMIT_AND_DIGITS = tuples(ints(1, 12), ints(1, 16));
+
+    @Test
+    void maxNumberLengthAppliesToParsedNumbers() {
+        Zoo.run("maxNumberLengthAppliesToParsedNumbers", tc -> {
+            Tuple2<Integer, Integer> c = tc.draw(LIMIT_AND_DIGITS, "case");
+            int limit = c.value1();
+            int digits = c.value2();
+            String num = "1" + "0".repeat(digits - 1);
+            JSONParserConfiguration cfg = new JSONParserConfiguration().withMaxNumberLength(limit);
+            Object v = new JSONArray("[" + num + "]", cfg).get(0);
+            // documented: a number text longer than the limit is kept as a string
+            boolean wantString = digits > limit;
+            check((v instanceof String) == wantString, () -> "[" + num + "] with maxNumberLength " + limit + " parses to " + Zoo.show(v));
+        });
+    }
+
+    // ------------------------------------------------------------------ nesting depth
+
+    /** A depth limit, a nesting depth and whether the nesting is arrays (else objects). */
+    static final Generator<Tuple3<Integer, Integer, Boolean>> LIMIT_AND_DEPTH = tuples(ints(1, 40), ints(1, 60), chance(50));
+
+    @Test
+    void nestingDepthLimitIsEnforcedForText() {
+        Zoo.run("nestingDepthLimitIsEnforcedForText", tc -> {
+            Tuple3<Integer, Integer, Boolean> c = tc.draw(LIMIT_AND_DEPTH, "case");
+            int limit = c.value1();
+            int depth = c.value2();
+            boolean arrays = c.value3();
+            String text = (arrays ? "[" : "{\"k\":").repeat(depth) + "1" + (arrays ? "]" : "}").repeat(depth);
+            JSONParserConfiguration cfg = new JSONParserConfiguration().withMaxNestingDepth(limit);
+            Object got;
+            try {
+                got = arrays ? new JSONArray(text, cfg) : new JSONObject(text, cfg);
+            } catch (JSONException e) {
+                got = e;
+            }
+            Object g = got;
+            // the javadoc: the parser throws a JSONException when the maximum depth is reached
+            if (depth > limit) {
+                count("beyond the limit");
+                check(g instanceof JSONException, () -> "depth " + depth + " parsed with maxNestingDepth " + limit + ": no exception");
+            } else {
+                count("within the limit");
+                check(!(g instanceof JSONException), () -> "depth " + depth + " rejected with maxNestingDepth " + limit + ": " + g);
+            }
+        });
+    }
+
+    /** The nesting from the leaf outwards (true: a map, false: a list) and how negative the limit is. */
+    static final Generator<Tuple2<List<Boolean>, Integer>> NEGATIVE_LIMIT = tuples(many(chance(50), 1, 30), ints(1, 5));
+
+    @Test
+    void negativeNestingDepthMeansNoLimit() {
+        Zoo.run("negativeNestingDepthMeansNoLimit", tc -> {
+            Tuple2<List<Boolean>, Integer> c = tc.draw(NEGATIVE_LIMIT, "case");
+            int depth = c.value1().size();
+            Object nested = 1;
+            for (boolean map : c.value1()) {
+                nested = map ? Map.of("k", nested) : List.of(nested);
+            }
+            JSONParserConfiguration cfg = new JSONParserConfiguration().withMaxNestingDepth(-c.value2());
+            Object got;
+            try {
+                got = nested instanceof Map<?, ?> m ? new JSONObject(m, cfg) : new JSONArray((List<?>) nested, cfg);
+            } catch (JSONException e) {
+                got = e;
+            }
+            Object g = got;
+            check(!(g instanceof JSONException), () -> "a negative maxNestingDepth (documented: no limit) rejects depth " + depth + ": " + g);
+            if (!(g instanceof JSONException)) {
+                check(Gen.canonical(g).equals(Gen.canonical(JSONObject.wrap(nested))), () -> "value changed: " + g);
+            }
+        });
+    }
+
+    // ------------------------------------------------------------------ collections
+
+    static final Generator<Object> MAP_ITEM = Gen.SCALAR.map(s -> {
+        Map<String, Object> m = new LinkedHashMap<>();
+        m.put("a", s);
+        return m;
+    });
+    static final Generator<Object> PAIR_ITEM = tuples(Gen.SCALAR, Gen.SCALAR).map(t -> Arrays.asList(t.value1(), t.value2()));
+    static final Generator<Object> ARRAY_ITEM = ints(0, 9).map(n -> new JSONArray().put(n));
+
+    /** An item of a collection: a scalar, a one-member map, a two-element list, a JSONArray of one int, or a Java null. */
+    static final Generator<Object> ITEM = Gen.<Object>weighted(w(1, Gen.SCALAR), w(1, MAP_ITEM), w(1, PAIR_ITEM), w(1, ARRAY_ITEM), v(1, null));
+
+    static final Generator<List<Object>> ITEMS = lists(ITEM).maxSize(4);
+
+    @Test
+    void collectionConstructorAndPutAllAgree() {
+        Zoo.run("collectionConstructorAndPutAllAgree", tc -> {
+            List<Object> items = tc.draw(ITEMS, "items");
+            JSONArray a = new JSONArray(items);
+            JSONArray b = new JSONArray().putAll(items);
+            JSONArray c = new JSONArray().putAll(a);
+            // NOTES.md: putAll does not wrap its items (a Map stays a Map), so only the values are compared, not similar()
+            String wa = a.toString();
+            check(Gen.canonical(a).equals(Gen.canonical(b)), () -> "new JSONArray(items) = " + wa + " differs in value from new JSONArray().putAll(items) = " + b);
+            check(a.similar(c) && c.similar(a), () -> "putAll(JSONArray) copy " + c + " differs from " + wa);
+            check(a.toString().equals(b.toString()), () -> "toString differs: " + wa + " vs " + b);
+        });
+    }
+
+    /** One to six put(index, value) steps and the index to remove afterwards. */
+    static final Generator<Tuple2<List<Tuple2<Integer, Object>>, Integer>> PUTS = tuples(many(tuples(ints(0, 6), Gen.SCALAR), 1, 6), ints(0, 8));
+
+    @Test
+    void putAtIndexPadsWithNull() {
+        Zoo.run("putAtIndexPadsWithNull", tc -> {
+            Tuple2<List<Tuple2<Integer, Object>>, Integer> c = tc.draw(PUTS, "case");
+            JSONArray a = new JSONArray();
+            List<Object> model = new ArrayList<>();
+            for (Tuple2<Integer, Object> put : c.value1()) {
+                int idx = put.value1();
+                Object v = put.value2();
+                a.put(idx, v);
+                while (model.size() <= idx) {
+                    model.add(JSONObject.NULL);
+                }
+                model.set(idx, v);
+            }
+            String want = Gen.canonical(model);
+            check(Gen.canonical(a).equals(want), () -> "put(index, value) sequence gives " + a + ", want " + want);
+            // remove returns the element and shifts, or null out of range
+            int idx = c.value2();
+            Object removed = a.remove(idx);
+            Object wantRemoved = idx < model.size() ? model.remove(idx) : null;
+            check(removed == wantRemoved || removed != null && removed.equals(wantRemoved), () -> "remove(" + idx + ") returned " + Zoo.show(removed) + ", want " + Zoo.show(wantRemoved));
+            check(Gen.canonical(a).equals(Gen.canonical(model)), () -> "after remove(" + idx + "): " + a + ", want " + Gen.canonical(model));
+        });
+    }
+
+    /** The documented increment types: Integer, Long, BigInteger, Double, Float, BigDecimal. */
+    static final Generator<Number> START = pick(0, 5, Integer.MAX_VALUE, 7L, Long.MAX_VALUE, BigInteger.TEN, 1.5, 2.5f, new BigDecimal("1.25"));
+
+    /** A start value, whether it is put before the increments (30%), how often to increment, and the values to accumulate. */
+    record IncrementCase(Number start, boolean put, int times, List<Object> values) {}
+
+    static final Generator<IncrementCase> INCREMENT_CASE = tuples(START, chance(30), ints(1, 4), many(Gen.SCALAR, 1, 4))
+            .map(t -> new IncrementCase(t.value1(), t.value2(), t.value3(), t.value4()));
+
+    @Test
+    void incrementAndAccumulateFollowTheirModels() {
+        Zoo.run("incrementAndAccumulateFollowTheirModels", tc -> {
+            IncrementCase c = tc.draw(INCREMENT_CASE, "case");
+            JSONObject o = new JSONObject();
+            // increment: absent -> 1, then +1 keeping the type as documented (Integer, Long, BigInteger, Double, Float, BigDecimal)
+            Number start = c.start();
+            if (c.put()) {
+                o.put("n", start);
+            }
+            int times = c.times();
+            for (int i = 0; i < times; i++) {
+                o.increment("n");
+            }
+            Number got = (Number) o.get("n");
+            BigDecimal expected = c.put() ? Gen.exact(start).add(BigDecimal.valueOf(times)) : BigDecimal.valueOf(times);
+            // the documented no-overflow-check: Integer.MAX_VALUE + 1 wraps
+            if (start instanceof Integer s && c.put() && (long) s + times > Integer.MAX_VALUE) {
+                expected = BigDecimal.valueOf((int) (s + times));
+            }
+            if (start instanceof Long s && c.put() && s > Long.MAX_VALUE - times) {
+                expected = BigDecimal.valueOf(s + times);
+            }
+            BigDecimal e = expected;
+            check(Gen.exact(got).compareTo(e) == 0, () -> "increment " + times + " times from " + Zoo.show(start) + " gives " + Zoo.show(got) + ", want " + e);
+            // accumulate: first value is put, further values make an array
+            JSONObject acc = new JSONObject();
+            List<Object> values = c.values();
+            for (Object v : values) {
+                acc.accumulate("k", v);
+            }
+            Object wantAcc = values.size() == 1 ? values.get(0) : new JSONArray(values);
+            check(Gen.canonical(acc.opt("k")).equals(Gen.canonical(wantAcc)), () -> "accumulate " + values + " gives " + acc.opt("k"));
+            // append always makes an array
+            JSONObject app = new JSONObject();
+            for (Object v : values) {
+                app.append("k", v);
+            }
+            check(Gen.canonical(app.opt("k")).equals(Gen.canonical(new JSONArray(values))), () -> "append " + values + " gives " + app.opt("k"));
+        });
+    }
+}
