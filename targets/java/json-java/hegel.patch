index 0000000..200ab60
--- /dev/null
+++ b/hegel/src/test/java/zoo/Gen.java
@@ -0,0 +1,429 @@
+package zoo;
+
+import static dev.hegel.Generators.booleans;
+import static dev.hegel.Generators.integers;
+import static dev.hegel.Generators.just;
+import static dev.hegel.Generators.lists;
+import static dev.hegel.Generators.longs;
+import static dev.hegel.Generators.maps;
+import static dev.hegel.Generators.sampledFrom;
+import static dev.hegel.Generators.tuples;
+
+import dev.hegel.Generator;
+import dev.hegel.Generators;
+import java.math.BigDecimal;
+import java.math.BigInteger;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+/**
+ * The combinators the binding lacks (weighted choice, a biased coin, an optional with a probability, int ranges,
+ * bounded lists, words over an alphabet), generators of JSON values as org.json trees, and a canonical text of any
+ * JSON-like Java value (org.json trees, java.util collections, Jackson/Gson trees converted to them) for
+ * comparisons: numbers by their exact value ({@code 1}, {@code 1.0} and {@code 1e0} are the same canonical
+ * number), object members sorted by key, strings quoted with every non-ASCII character escaped.
+ *
+ * <p>Every generator here is a value; the drawn data is rendered by pure functions. The first alternative of every
+ * choice is the plainest, so a shrunk case lands on it.
+ */
+final class Gen {
+    private Gen() {}
+
+    // ------------------------------------------------------------------ combinators
+
+    /** A weighted alternative for {@link #weighted}; the generator may produce a subtype of the choice's type. */
+    record Choice<T>(int weight, Generator<? extends T> gen) {}
+
+    static <T> Choice<T> w(int weight, Generator<? extends T> gen) {
+        return new Choice<>(weight, gen);
+    }
+
+    /** A constant alternative. */
+    static <T> Choice<T> v(int weight, T value) {
+        return new Choice<>(weight, just(value));
+    }
+
+    /** One of the generators, chosen in proportion to the weights; one draw, shrinks towards the first. */
+    @SafeVarargs
+    static <T> Generator<T> weighted(Choice<T>... choices) {
+        List<Choice<T>> cs = List.of(choices);
+        int total = 0;
+        for (Choice<T> c : cs) {
+            total += c.weight();
+        }
+        return ints(0, total - 1).flatMap(i -> {
+            int acc = 0;
+            for (Choice<T> c : cs) {
+                acc += c.weight();
+                if (i < acc) {
+                    return widen(c.gen());
+                }
+            }
+            throw new IllegalStateException("weighted: " + i + " beyond " + acc);
+        });
+    }
+
+    /** A generator of a subtype is a generator of the supertype: it only ever produces values. */
+    @SuppressWarnings("unchecked")
+    static <T> Generator<T> widen(Generator<? extends T> g) {
+        return (Generator<T>) g;
+    }
+
+    /** True with probability pct/100; shrinks to false. */
+    static Generator<Boolean> chance(int pct) {
+        return ints(0, 99).map(x -> x >= 100 - pct);
+    }
+
+    /** {@code absent} (weight 100 - pct), or a value of {@code present} (weight pct); shrinks to absent. */
+    static <T> Generator<T> maybe(int pct, T absent, Generator<? extends T> present) {
+        return weighted(w(100 - pct, just(absent)), w(pct, present));
+    }
+
+    /** One of the values, equally likely; shrinks to the first. */
+    @SafeVarargs
+    static <T> Generator<T> pick(T... xs) {
+        return sampledFrom(xs);
+    }
+
+    /** An int in [lo, hi]; shrinks to lo. */
+    static Generator<Integer> ints(int lo, int hi) {
+        return integers().min(lo).max(hi);
+    }
+
+    /** A position, taken modulo the live size where it is used. */
+    static final Generator<Integer> INDEX = ints(0, 999);
+
+    /** lo..hi values of the generator. */
+    static <T> Generator<List<T>> many(Generator<T> g, int lo, int hi) {
+        return lists(g).minSize(lo).maxSize(hi);
+    }
+
+    /** One UTF-16 unit of the alphabet, as a string (a surrogate pair in the alphabet yields its halves). */
+    static Generator<String> chars(String alphabet) {
+        List<String> cs = new ArrayList<>();
+        for (int i = 0; i < alphabet.length(); i++) {
+            cs.add(String.valueOf(alphabet.charAt(i)));
+        }
+        return sampledFrom(cs);
+    }
+
+    /** A string of lo..hi units drawn from the alphabet; shrinks to lo units. */
+    static Generator<String> word(String alphabet, int lo, int hi) {
+        return many(chars(alphabet), lo, hi).map(Gen::join);
+    }
+
+    static String join(List<String> parts) {
+        return String.join("", parts);
+    }
+
+    /** The element of the list at a drawn position, modulo its size (the list must not be empty). */
+    static <T> T at(List<T> xs, int index) {
+        return xs.get(Math.floorMod(index, xs.size()));
+    }
+
+    /** The element of a style tape at a position, modulo its length; {@code plain} when the tape is empty. */
+    static <T> T tape(List<T> xs, int index, T plain) {
+        return xs.isEmpty() ? plain : at(xs, index);
+    }
+
+    /** The elements reordered: each pick takes the element at that position (modulo what is left); all-zero picks keep the order. */
+    static <T> List<T> permuted(List<T> xs, List<Integer> picks) {
+        List<T> left = new ArrayList<>(xs);
+        List<T> out = new ArrayList<>();
+        for (int p : picks) {
+            if (left.isEmpty()) {
+                break;
+            }
+            out.add(left.remove(Math.floorMod(p, left.size())));
+        }
+        out.addAll(left);
+        return out;
+    }
+
+    // ------------------------------------------------------------------ JSON values
+
+    /** Characters a JSON string may contain, weighted to the ones a writer must escape. */
+    static final String SPECIAL = "\"\\/\b\f\n\r\t \u00e9\u00a0\u2028\uffff\ud7ff<>&'";
+
+    static String cp(int codePoint) {
+        return new String(Character.toChars(codePoint));
+    }
+
+    /** One character of a string: printable ASCII (50%), one of SPECIAL (30%), a supplementary character (10%), any other BMP character (10%). */
+    static final Generator<String> CHAR = weighted(
+            w(5, ints(0x20, 0x7e).map(Gen::cp)),
+            w(3, chars(SPECIAL)),
+            w(1, ints(0x10000, 0x10ffff).map(Gen::cp)),
+            w(1, ints(0x80, 0xffff).map(Gen::cp)));
+
+    /** A string of up to twelve characters. */
+    static final Generator<String> STRING = lists(CHAR).maxSize(12).map(Gen::join);
+
+    /** A member key: usually short and plain, sometimes any string. */
+    static final Generator<String> KEY = weighted(w(80, word("abcxyz_0", 1, 4)), w(20, STRING));
+
+    static final Generator<Number> SMALL_INT = ints(-1000, 1000).map(Integer::valueOf);
+    static final Generator<Number> BIG_INTEGER = tuples(word("0123456789", 1, 30), chance(30))
+            .map(t -> t.value2() ? new BigInteger(t.value1()).negate() : new BigInteger(t.value1()));
+    /** A double from arbitrary bits: sign, a finite exponent (2047 would be NaN or an infinity, which are not JSON values), mantissa. */
+    static final Generator<Number> ANY_DOUBLE = tuples(chance(50), ints(0, 2046), longs())
+            .map(t -> Double.longBitsToDouble((t.value1() ? Long.MIN_VALUE : 0L) | ((long) t.value2() << 52) | (t.value3() & ((1L << 52) - 1))));
+    static final Generator<Number> BIG_DECIMAL = tuples(word("0123456789", 1, 25), ints(-30, 30))
+            .map(t -> new BigDecimal(new BigInteger(t.value1()), t.value2()));
+
+    /** A finite number of any type org.json supports: small ints, boundary ints and longs, big integers, notable and arbitrary doubles, decimals. */
+    static final Generator<Number> NUMBER = weighted(
+            w(1, SMALL_INT),
+            w(1, pick(0, -1, 1, Integer.MAX_VALUE, Integer.MIN_VALUE)),
+            w(1, pick(Long.MAX_VALUE, Long.MIN_VALUE, 1L << 53, -(1L << 53), 2147483648L, 9007199254740993L)),
+            w(1, BIG_INTEGER),
+            w(1, pick(0.5, -0.5, 1e-7, 123456789.125, 1e21, 1e-300, 1.7976931348623157e308, 4.9e-324, 0.1, 100.0, -0.0)),
+            w(1, ANY_DOUBLE),
+            w(1, BIG_DECIMAL),
+            w(1, pick(new BigDecimal("0.0"), new BigDecimal("1E+2"), new BigDecimal("-0"), BigDecimal.valueOf(1, -1), new BigDecimal("0.000"))));
+
+    /** A scalar org.json value: NULL, a boolean, a number (twice as often) or a string. */
+    static final Generator<Object> SCALAR = Gen.<Object>weighted(v(1, JSONObject.NULL), w(1, booleans()), w(2, NUMBER), w(1, STRING));
+
+    private static final List<Generator<Object>> VALUES = new ArrayList<>(List.of(SCALAR));
+
+    /** Any org.json value up to the given depth: a scalar (50%), or an object or an array (25% each) of values one level down. */
+    static Generator<Object> value(int depth) {
+        while (VALUES.size() <= depth) {
+            int d = VALUES.size();
+            VALUES.add(Gen.<Object>weighted(w(50, SCALAR), w(25, object(d)), w(25, array(d))));
+        }
+        return VALUES.get(depth);
+    }
+
+    /** An object of up to four members (distinct keys by construction) whose values go one level down. */
+    static Generator<JSONObject> object(int depth) {
+        return maps(KEY, value(depth - 1)).maxSize(4).map(Gen::toObject);
+    }
+
+    /** An array of up to four values one level down. */
+    static Generator<JSONArray> array(int depth) {
+        return lists(value(depth - 1)).maxSize(4).map(Gen::toArray);
+    }
+
+    /** An object or an array of the given depth. */
+    static Generator<Object> container(int depth) {
+        return Generators.<Object>oneOf(object(depth), array(depth));
+    }
+
+    static JSONObject toObject(Map<String, Object> members) {
+        JSONObject o = new JSONObject();
+        members.forEach(o::put);
+        return o;
+    }
+
+    static JSONArray toArray(List<?> items) {
+        JSONArray a = new JSONArray();
+        for (Object x : items) {
+            a.put(x);
+        }
+        return a;
+    }
+
+    // ------------------------------------------------------------------ canonical form
+
+    /** True for the value org.json uses for JSON null and for Java null. */
+    static boolean isNull(Object o) {
+        return o == null || JSONObject.NULL.equals(o);
+    }
+
+    /** The value of a number as a normalised BigDecimal (so 1, 1.0 and 1e0 agree); doubles by their shortest decimal; -0.0 is 0. */
+    static BigDecimal exact(Number x) {
+        if (x instanceof BigDecimal b) {
+            return b.stripTrailingZeros();
+        }
+        if (x instanceof BigInteger b) {
+            return new BigDecimal(b).stripTrailingZeros();
+        }
+        if (x instanceof Float f) {
+            if (f.isNaN() || f.isInfinite()) {
+                throw new IllegalArgumentException("not finite: " + f);
+            }
+            return new BigDecimal(Float.toString(f)).stripTrailingZeros();
+        }
+        if (x instanceof Double) {
+            double d = x.doubleValue();
+            if (Double.isNaN(d) || Double.isInfinite(d)) {
+                throw new IllegalArgumentException("not finite: " + d);
+            }
+            // the shortest decimal that reads back as the same double: what a JSON writer emits
+            return new BigDecimal(Double.toString(d)).stripTrailingZeros();
+        }
+        return BigDecimal.valueOf(x.longValue()).stripTrailingZeros();
+    }
+
+    static String canonicalNumber(Number x) {
+        BigDecimal b = exact(x);
+        return b.signum() == 0 ? "0" : b.toString();
+    }
+
+    /** Canonical text of a JSON-like Java value. */
+    static String canonical(Object o) {
+        StringBuilder sb = new StringBuilder();
+        canonical(o, sb);
+        return sb.toString();
+    }
+
+    private static void canonical(Object o, StringBuilder sb) {
+        if (isNull(o)) {
+            sb.append("null");
+        } else if (o instanceof Boolean) {
+            sb.append(o);
+        } else if (o instanceof Number x) {
+            sb.append(canonicalNumber(x));
+        } else if (o instanceof String s) {
+            quote(s, sb);
+        } else if (o instanceof Character c) {
+            quote(c.toString(), sb);
+        } else if (o instanceof JSONObject j) {
+            canonicalMap(j.toMap(), sb);
+        } else if (o instanceof Map<?, ?> m) {
+            canonicalMap(m, sb);
+        } else if (o instanceof JSONArray a) {
+            canonicalList(a.toList(), sb);
+        } else if (o instanceof List<?> l) {
+            canonicalList(l, sb);
+        } else if (o instanceof Object[] arr) {
+            canonicalList(List.of(arr), sb);
+        } else {
+            throw new IllegalArgumentException("not a JSON value: " + o.getClass() + " " + o);
+        }
+    }
+
+    private static void canonicalMap(Map<?, ?> m, StringBuilder sb) {
+        sb.append('{');
+        List<String> keys = new ArrayList<>();
+        Map<String, Object> byKey = new LinkedHashMap<>();
+        for (Map.Entry<?, ?> e : m.entrySet()) {
+            String k = String.valueOf(e.getKey());
+            keys.add(k);
+            byKey.put(k, e.getValue());
+        }
+        keys.sort(null);
+        boolean first = true;
+        for (String k : keys) {
+            if (!first) {
+                sb.append(',');
+            }
+            first = false;
+            quote(k, sb);
+            sb.append(':');
+            canonical(byKey.get(k), sb);
+        }
+        sb.append('}');
+    }
+
+    private static void canonicalList(List<?> l, StringBuilder sb) {
+        sb.append('[');
+        boolean first = true;
+        for (Object x : l) {
+            if (!first) {
+                sb.append(',');
+            }
+            first = false;
+            canonical(x, sb);
+        }
+        sb.append(']');
+    }
+
+    /** A JSON string literal with every character outside printable ASCII escaped as \\uXXXX. */
+    static void quote(String s, StringBuilder sb) {
+        sb.append('"');
+        for (int i = 0; i < s.length(); i++) {
+            char c = s.charAt(i);
+            if (c == '"' || c == '\\') {
+                sb.append('\\').append(c);
+            } else if (c < 0x20 || c > 0x7e) {
+                sb.append(String.format("\\u%04x", (int) c));
+            } else {
+                sb.append(c);
+            }
+        }
+        sb.append('"');
+    }
+
+    static String quote(String s) {
+        StringBuilder sb = new StringBuilder();
+        quote(s, sb);
+        return sb.toString();
+    }
+
+    /** A Jackson tree as plain Java values (Map/List/String/Boolean/BigDecimal/BigInteger/null). */
+    static Object fromJackson(com.fasterxml.jackson.databind.JsonNode n) {
+        if (n == null || n.isNull()) {
+            return null;
+        }
+        if (n.isBoolean()) {
+            return n.booleanValue();
+        }
+        if (n.isNumber()) {
+            return n.decimalValue();
+        }
+        if (n.isTextual()) {
+            return n.textValue();
+        }
+        if (n.isArray()) {
+            List<Object> l = new ArrayList<>();
+            n.forEach(x -> l.add(fromJackson(x)));
+            return l;
+        }
+        if (n.isObject()) {
+            Map<String, Object> m = new LinkedHashMap<>();
+            n.fields().forEachRemaining(e -> m.put(e.getKey(), fromJackson(e.getValue())));
+            return m;
+        }
+        throw new IllegalArgumentException("jackson node " + n.getNodeType());
+    }
+
+    /** Standard JSON text of a value (our own writer, RFC 8259 strict, keys in insertion order). */
+    static String standard(Object o) {
+        StringBuilder sb = new StringBuilder();
+        standard(o, sb);
+        return sb.toString();
+    }
+
+    private static void standard(Object o, StringBuilder sb) {
+        if (isNull(o)) {
+            sb.append("null");
+        } else if (o instanceof Boolean) {
+            sb.append(o);
+        } else if (o instanceof Number x) {
+            sb.append(canonicalNumber(x));
+        } else if (o instanceof String s) {
+            quote(s, sb);
+        } else if (o instanceof JSONObject j) {
+            sb.append('{');
+            boolean first = true;
+            for (String k : j.keySet()) {
+                if (!first) {
+                    sb.append(',');
+                }
+                first = false;
+                quote(k, sb);
+                sb.append(':');
+                standard(j.opt(k), sb);
+            }
+            sb.append('}');
+        } else if (o instanceof JSONArray a) {
+            sb.append('[');
+            for (int i = 0; i < a.length(); i++) {
+                if (i > 0) {
+                    sb.append(',');
+                }
+                standard(a.opt(i), sb);
+            }
+            sb.append(']');
+        } else {
+            throw new IllegalArgumentException("not an org.json value: " + o.getClass());
+        }
+    }
+}
