+package zoo;
+
+import static dev.hegel.Generators.booleans;
+import static dev.hegel.Generators.lists;
+import static dev.hegel.Generators.maps;
+import static dev.hegel.Generators.tuples;
+import static zoo.Gen.INDEX;
+import static zoo.Gen.chance;
+import static zoo.Gen.ints;
+import static zoo.Gen.many;
+import static zoo.Gen.maybe;
+import static zoo.Gen.pick;
+import static zoo.Gen.v;
+import static zoo.Gen.w;
+import static zoo.Gen.weighted;
+import static zoo.Gen.word;
+import static zoo.Zoo.check;
+import static zoo.Zoo.count;
+
+import dev.hegel.Generator;
+import dev.hegel.Tuple2;
+import dev.hegel.Tuple5;
+import java.io.StringReader;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.function.UnaryOperator;
+import javax.xml.parsers.DocumentBuilder;
+import javax.xml.parsers.DocumentBuilderFactory;
+import org.json.JSONArray;
+import org.json.JSONObject;
+import org.json.XML;
+import org.json.XMLParserConfiguration;
+import org.junit.jupiter.api.Test;
+import org.w3c.dom.Document;
+import org.w3c.dom.Element;
+import org.w3c.dom.Node;
+import org.xml.sax.InputSource;
+
+/**
+ * Hegel zoo: {@link XML} against the JDK's XML parser (well-formedness and a DOM-based model of
+ * the documented XML-to-JSON mapping), its own escape/unescape pair, and the configuration
+ * object's builder laws.
+ */
+class XmlTest {
+
+    static final DocumentBuilder DOM;
+
+    static {
+        try {
+            DocumentBuilderFactory f = DocumentBuilderFactory.newInstance();
+            f.setNamespaceAware(false);
+            f.setExpandEntityReferences(true);
+            DOM = f.newDocumentBuilder();
+            DOM.setErrorHandler(null);
+        } catch (Exception e) {
+            throw new ExceptionInInitializerError(e);
+        }
+    }
+
+    static Object parseXml(String xml) {
+        try {
+            return DOM.parse(new InputSource(new StringReader(xml)));
+        } catch (Exception e) {
+            return e;
+        }
+    }
+
+    // ------------------------------------------------------------------ escape / unescape
+
+    /** Any string (60%) or a short text over the markup characters (with raw control characters, a replacement character and an emoji, whose halves may come apart). */
+    static final Generator<String> ESCAPE_INPUT = weighted(w(60, Gen.STRING), w(40, word("a<>&\"' \t\n�😀", 0, 8)));
+
+    @Test
+    void unescapeInvertsEscape() {
+        Zoo.run("unescapeInvertsEscape", tc -> {
+            String s = tc.draw(ESCAPE_INPUT, "text");
+            String e = XML.escape(s);
+            // the escaped text has no raw markup characters
+            check(e.indexOf('<') < 0 && e.indexOf('>') < 0 && e.indexOf('"') < 0 && e.indexOf('\'') < 0
+                    && !e.matches(".*&(?![a-zA-Z#]).*"), () -> "XML.escape(" + Zoo.show(s) + ") = " + Zoo.show(e) + " leaves markup characters");
+            String back;
+            try {
+                back = XML.unescape(e);
+            } catch (RuntimeException ex) {
+                Zoo.fail("XML.unescape(XML.escape(" + Zoo.show(s) + ") = " + Zoo.show(e) + ") throws " + ex);
+                return;
+            }
+            check(back.equals(s), () -> "XML.unescape(XML.escape(" + Zoo.show(s) + ") = " + Zoo.show(e) + ") = " + Zoo.show(back));
+            // the JDK agrees on what the escaped text denotes (when it is a legal XML character)
+            boolean legal = s.chars().allMatch(c -> c == 9 || c == 10 || c == 13 || c >= 0x20 && c != 0xfffe && c != 0xffff)
+                    && !s.matches(".*[\ud800-\udbff](?![\udc00-\udfff]).*") && !s.matches(".*(?<![\ud800-\udbff])[\udc00-\udfff].*");
+            if (legal) {
+                Object doc = parseXml("<r>" + e + "</r>");
+                check(doc instanceof Document, () -> "JDK rejects <r>" + Zoo.show(e) + "</r>: " + doc);
+                if (doc instanceof Document d) {
+                    String text = d.getDocumentElement().getTextContent();
+                    check(text.equals(s.replace("\r\n", "\n").replace('\r', '\n')) || text.equals(s),
+                            () -> "JDK reads XML.escape(" + Zoo.show(s) + ") = " + Zoo.show(e) + " as " + Zoo.show(text));
+                }
+            }
+        });
+    }
+
+    /** A part of an entity text: plain words, the five named entities, decimal and hex character references, and doubtful references. */
+    static final Generator<String> ENTITY_PART = weighted(
+            w(2, word("abc xyz", 1, 4)),
+            w(1, pick("&amp;", "&lt;", "&gt;", "&quot;", "&apos;")),
+            w(1, ints(0x20, 0x7e).map(n -> "&#" + n + ";")),
+            w(1, pick(0x41, 0xe9, 0x4e2d, 0x1f600, 0x9, 0x1, 0x7f, 0xa0).map(n -> "&#x" + Integer.toHexString(n) + ";")),
+            w(1, pick("&AMP;", "&Amp;", "&nbsp;", "&foo;", "&#X41;", "&#0041;", "&#x0000041;")));
+
+    /** Text made of entity references and plain characters. */
+    static final Generator<String> ENTITY_TEXT = lists(ENTITY_PART).maxSize(6).map(Gen::join);
+
+    @Test
+    void unescapeMatchesTheJdkOnEntityText() {
+        Zoo.run("unescapeMatchesTheJdkOnEntityText", tc -> {
+            String e = tc.draw(ENTITY_TEXT, "text");
+            Object doc = parseXml("<r>" + e + "</r>");
+            Object got;
+            try {
+                got = XML.unescape(e);
+            } catch (RuntimeException ex) {
+                got = ex;
+            }
+            Object g = got;
+            if (doc instanceof Document d) {
+                String want = d.getDocumentElement().getTextContent();
+                count("legal");
+                check(want.equals(g), () -> "XML.unescape(" + Zoo.show(e) + ") = " + Zoo.show(g) + ", the JDK reads " + Zoo.show(want));
+            } else {
+                count("illegal for the JDK");
+                // an entity text the JDK rejects (unknown entity, capital X, illegal character): unescape may be lenient, but must not throw
+                // for a reference the JDK would merely leave undeclared
+                check(!(g instanceof Exception) || e.contains("&#"), () -> "XML.unescape(" + Zoo.show(e) + ") throws " + g + " for text the JDK rejects only for: " + doc);
+            }
+        });
+    }
+
+    // ------------------------------------------------------------------ toString produces XML
+
+    /** An XML name: a letter then letters, digits and punctuation. */
+    static final Generator<String> XML_NAME = tuples(word("abcXYZ", 1, 1), word("abcXYZ019_-.", 0, 4)).map(t -> t.value1() + t.value2());
+
+    /**
+     * An element name: one that is not an XML name (or is reserved, or is one after all) 15% of the time, else an XML name. The doubtful
+     * names come first: they are what this property is about, and a later alternative at 15% lands well under 10% in a 100-case run.
+     */
+    static final Generator<String> ELEMENT_NAME = weighted(
+            w(15, pick("a b", "1a", "", " ", "a:b", "-a", ".a", "a\tb", "é", "ab", "xml", "a&b", "a<b", "a/b", "a\"b")), w(85, XML_NAME));
+
+    /** A string for an XML value: markup-flavoured text (70%) or any string. */
+    static final Generator<String> XML_STRING = weighted(w(70, word("abc XYZ 019 <>&\"'\t\né中", 0, 8)), w(30, Gen.STRING));
+
+    /** A scalar XML.toString accepts: null, a boolean, a number or (twice as often) a string. */
+    static final Generator<Object> XML_SCALAR = Gen.<Object>weighted(v(1, JSONObject.NULL), w(1, booleans()), w(1, Gen.NUMBER), w(2, XML_STRING));
+
+    private static final List<Generator<Object>> XML_VALUES = new ArrayList<>(List.of(XML_SCALAR));
+
+    /** A JSON value XML.toString accepts, up to the given depth: a scalar (50%), an object over element names (30%) or an array (20%). */
+    static Generator<Object> xmlValue(int depth) {
+        while (XML_VALUES.size() <= depth) {
+            int d = XML_VALUES.size();
+            Generator<Object> object = maps(ELEMENT_NAME, xmlValue(d - 1)).maxSize(3).map(Gen::toObject);
+            Generator<Object> array = lists(xmlValue(d - 1)).maxSize(3).map(Gen::toArray);
+            XML_VALUES.add(Gen.<Object>weighted(w(50, XML_SCALAR), w(30, object), w(20, array)));
+        }
+        return XML_VALUES.get(depth);
+    }
+
+    static boolean isXmlName(String s) {
+        return s.matches("[A-Za-z_:][A-Za-z0-9_:.\\-]*") && !s.toLowerCase().startsWith("xml");
+    }
+
+    static boolean namesAreXmlNames(Object o) {
+        if (o instanceof JSONObject j) {
+            for (String k : j.keySet()) {
+                if (!isXmlName(k) || !namesAreXmlNames(j.opt(k))) {
+                    return false;
+                }
+            }
+            return true;
+        }
+        if (o instanceof JSONArray a) {
+            for (int i = 0; i < a.length(); i++) {
+                if (!namesAreXmlNames(a.opt(i))) {
+                    return false;
+                }
+            }
+        }
+        return true;
+    }
+
+    static boolean textIsLegalXml(Object o) {
+        if (o instanceof String s) {
+            return s.chars().allMatch(c -> c == 9 || c == 10 || c == 13 || c >= 0x20 && c != 0xfffe && c != 0xffff)
+                    && !s.matches(".*[\ud800-\udbff](?![\udc00-\udfff]).*") && !s.matches(".*(?<![\ud800-\udbff])[\udc00-\udfff].*");
+        }
+        if (o instanceof JSONObject j) {
+            for (String k : j.keySet()) {
+                if (!textIsLegalXml(j.opt(k))) {
+                    return false;
+                }
+            }
+        }
+        if (o instanceof JSONArray a) {
+            for (int i = 0; i < a.length(); i++) {
+                if (!textIsLegalXml(a.opt(i))) {
+                    return false;
+                }
+            }
+        }
+        return true;
+    }
+
+    /** A value three levels deep and the element name to wrap it in when it is not an object. */
+    static final Generator<Tuple2<Object, String>> TO_STRING_CASE = tuples(xmlValue(3), ELEMENT_NAME);
+
+    @Test
+    void toStringIsWellFormedXmlOrRejectsTheName() {
+        Zoo.run("toStringIsWellFormedXmlOrRejectsTheName", tc -> {
+            Tuple2<Object, String> c = tc.draw(TO_STRING_CASE, "case");
+            // a JSONObject at the root: XML.toString of an array is documented as a sequence of elements, not a document
+            Object generated = c.value1();
+            Object v = generated instanceof JSONObject ? generated : new JSONObject().put(c.value2(), generated);
+            boolean names = namesAreXmlNames(v);
+            boolean legal = textIsLegalXml(v);
+            String xml;
+            try {
+                xml = XML.toString(v, "root");
+            } catch (RuntimeException e) {
+                // rejecting a bad element name is right; rejecting good input is not
+                check(!names, () -> "XML.toString(" + v + ") throws " + e + " though every key is an XML name");
+                count("rejected");
+                return;
+            }
+            String x = xml;
+            Object doc = parseXml(x);
+            count(names ? (legal ? "names ok" : "illegal text") : "bad name");
+            // control characters in the text cannot be represented in XML 1.0; the writer cannot be blamed when that is what the JDK objects to
+            check(doc instanceof Document || !legal && String.valueOf(doc).contains("invalid XML character"),
+                    () -> "XML.toString(" + v + ") = " + Zoo.show(x) + " is not well-formed XML: " + ((Exception) doc).getMessage()
+                    + (names ? " (every key is an XML name)" : " (a key is not an XML name; toString should have thrown)"));
+        });
+    }
+
+    // ------------------------------------------------------------------ XML -> JSON against a DOM model
+
+    static final Generator<String> DOC_NAME = tuples(word("abcXYZ", 1, 1), word("abcXYZ019_", 0, 3)).map(t -> t.value1() + t.value2());
+    static final Generator<String> ATTR_NAME = tuples(word("pqr", 1, 1), word("pqr019", 0, 2)).map(t -> t.value1() + t.value2());
+    static final Generator<String> ATTR_TEXT = pick("x", "1", "01", "1.5", "true", "null", "", "a b", "&amp;", "&lt;x&gt;", "-0", "1e2", "TRUE", "Null", "0x10");
+    static final Generator<String> TEXT = pick("x", "1", "01", "1.5", "true", "null", "a b", " x ", "&amp;", "&lt;x&gt;", "&#65;", "-0", "1e2", "TRUE", "007", "1_0", "12345678901234567890");
+    static final Generator<Map<String, String>> ATTRS = maps(ATTR_NAME, ATTR_TEXT).maxSize(2);
+
+    /** The inside of an element: nothing (written as a self-closing tag or an open-close pair) or children, elements or text. */
+    record Body(boolean selfClose, List<Object> children) {}
+
+    static final Generator<Body> EMPTY_BODY = chance(50).map(sc -> new Body(sc, List.of()));
+
+    /** An element of a small XML document: nested elements, attributes, text; names are XML names. */
+    record XElem(String name, Map<String, String> attrs, Body body) {
+        void render(StringBuilder sb) {
+            sb.append('<').append(name);
+            attrs.forEach((an, av) -> sb.append(' ').append(an).append("=\"").append(av).append('"'));
+            if (body.children().isEmpty()) {
+                sb.append(body.selfClose() ? "/>" : "></" + name + ">");
+                return;
+            }
+            sb.append('>');
+            for (Object child : body.children()) {
+                if (child instanceof XElem e) {
+                    e.render(sb);
+                } else {
+                    sb.append(child);
+                }
+            }
+            sb.append("</").append(name).append('>');
+        }
+
+        String xml() {
+            StringBuilder sb = new StringBuilder();
+            render(sb);
+            return sb.toString();
+        }
+    }
+
+    private static final List<Generator<XElem>> XELEMS = new ArrayList<>();
+
+    /** An element up to the given depth: a leaf is empty; otherwise empty (30%) or with up to three children (text or elements). */
+    static Generator<XElem> xelem(int depth) {
+        while (XELEMS.size() <= depth) {
+            int d = XELEMS.size();
+            Generator<Body> body = d == 0 ? EMPTY_BODY
+                    : weighted(w(30, EMPTY_BODY), w(70, lists(Gen.<Object>weighted(w(1, TEXT), w(1, xelem(d - 1)))).maxSize(3).map(cs -> new Body(false, cs))));
+            XELEMS.add(tuples(DOC_NAME, ATTRS, body).map(t -> new XElem(t.value1(), t.value2(), t.value3())));
+        }
+        return XELEMS.get(depth);
+    }
+
+    /**
+     * The documented mapping of an element (with keepStrings): attributes are members, child
+     * elements members (repeated names become arrays), text goes to "content" (joined with
+     * newlines when there are several runs or child elements); an element with only text is that
+     * text; an empty element is "".
+     */
+    static Object model(Element e, XMLParserConfiguration cfg) {
+        JSONObject o = new JSONObject();
+        var attrs = e.getAttributes();
+        for (int i = 0; i < attrs.getLength(); i++) {
+            Node a = attrs.item(i);
+            accumulate(o, a.getNodeName(), value(a.getNodeValue(), cfg, true));
+        }
+        List<String> texts = new ArrayList<>();
+        boolean hasChildElement = false;
+        for (Node c = e.getFirstChild(); c != null; c = c.getNextSibling()) {
+            if (c.getNodeType() == Node.ELEMENT_NODE) {
+                hasChildElement = true;
+                accumulate(o, c.getNodeName(), model((Element) c, cfg));
+            } else if (c.getNodeType() == Node.TEXT_NODE || c.getNodeType() == Node.CDATA_SECTION_NODE) {
+                String t = c.getNodeValue().trim();
+                if (!t.isEmpty()) {
+                    texts.add(t);
+                }
+            }
+        }
+        if (!hasChildElement && attrs.getLength() == 0) {
+            if (texts.isEmpty()) {
+                return "";
+            }
+            if (texts.size() == 1) {
+                return value(texts.get(0), cfg, false);
+            }
+        }
+        for (String t : texts) {
+            accumulate(o, cfg.getcDataTagName(), value(t, cfg, false));
+        }
+        return o;
+    }
+
+    static Object value(String s, XMLParserConfiguration cfg, boolean attribute) {
+        return cfg.isKeepStrings() ? s : XML.stringToValue(s);
+    }
+
+    static void accumulate(JSONObject o, String k, Object v) {
+        if (!o.has(k)) {
+            o.put(k, v);
+            return;
+        }
+        Object cur = o.opt(k);
+        if (cur instanceof JSONArray a) {
+            a.put(v);
+        } else {
+            o.put(k, new JSONArray().put(cur).put(v));
+        }
+    }
+
+    /** A document three levels deep and whether to keep strings. */
+    static final Generator<Tuple2<XElem, Boolean>> DOM_CASE = tuples(xelem(3), chance(60));
+
+    @Test
+    void toJsonObjectMatchesTheDomModel() {
+        Zoo.run("toJsonObjectMatchesTheDomModel", tc -> {
+            Tuple2<XElem, Boolean> c = tc.draw(DOM_CASE, "case");
+            String root = c.value1().name();
+            String xml = c.value1().xml();
+            Object doc = parseXml(xml);
+            check(doc instanceof Document, () -> "our XML generator is wrong: " + doc + "\n xml " + Zoo.show(xml));
+            boolean keep = c.value2();
+            XMLParserConfiguration cfg = keep ? XMLParserConfiguration.KEEP_STRINGS : XMLParserConfiguration.ORIGINAL;
+            count(keep ? "keepStrings" : "typed");
+            JSONObject want = new JSONObject().put(root, model(((Document) doc).getDocumentElement(), cfg));
+            JSONObject got;
+            try {
+                got = XML.toJSONObject(xml, cfg);
+            } catch (RuntimeException e) {
+                Zoo.fail("XML.toJSONObject(" + Zoo.show(xml) + ") throws " + e);
+                return;
+            }
+            check(Gen.canonical(got).equals(Gen.canonical(want)), () -> "XML.toJSONObject(" + (keep ? "KEEP_STRINGS" : "ORIGINAL") + ")\n xml  " + Zoo.show(xml)
+                    + "\n want " + Gen.canonical(want) + "\n got  " + Gen.canonical(got));
+        });
+    }
+
+    // ------------------------------------------------------------------ XML round trip
+
+    /** A string the mapping keeps: trimmed, non-empty, legal XML characters. */
+    static final Generator<String> STRING_VALUE = word("abc XYZ 019 <>&\"'é中.,", 1, 8).map(s -> s.trim().isEmpty() ? "x" : s.trim());
+
+    /** An inner object of one member over p, q, r and perhaps one over s, t, u. */
+    static final Generator<Object> INNER = tuples(word("pqr", 1, 2), STRING_VALUE, Gen.<Tuple2<String, String>>maybe(50, null, tuples(word("stu", 1, 2), STRING_VALUE)))
+            .map(t -> {
+                JSONObject inner = new JSONObject().put(t.value1(), t.value2());
+                if (t.value3() != null) {
+                    inner.put(t.value3().value1(), t.value3().value2());
+                }
+                return inner;
+            });
+
+    /** A member value that survives the mapping: a string, an inner object, an array of two or three strings, or an object with "content" and one more member. */
+    static final Generator<Object> MEMBER = Gen.<Object>weighted(
+            w(1, STRING_VALUE),
+            w(1, INNER),
+            w(1, lists(STRING_VALUE).minSize(2).maxSize(3).map(Gen::toArray)),
+            // an object whose only member is "content" is documented to become that text: not a value that survives
+            w(1, tuples(STRING_VALUE, STRING_VALUE).map(t -> new JSONObject().put("content", t.value1()).put("q", t.value2()))));
+
+    static final Generator<String> MEMBER_NAME = tuples(word("abcXYZ", 1, 1), word("abc019_", 0, 3)).map(t -> t.value1() + t.value2());
+
+    /** A JSON object of XML-name keys and string values that survive the mapping: trimmed, non-empty, no nested arrays of arrays. */
+    static final Generator<JSONObject> ROUND_TRIP_OBJECT = maps(MEMBER_NAME, MEMBER).minSize(1).maxSize(4).map(m -> (JSONObject) Gen.toObject(m));
+
+    @Test
+    void jsonToXmlAndBackKeepsStringValues() {
+        Zoo.run("jsonToXmlAndBackKeepsStringValues", tc -> {
+            JSONObject o = tc.draw(ROUND_TRIP_OBJECT, "object");
+            String xml = XML.toString(o, "root");
+            JSONObject back;
+            try {
+                back = XML.toJSONObject(xml, XMLParserConfiguration.KEEP_STRINGS);
+            } catch (RuntimeException e) {
+                Zoo.fail("XML.toJSONObject(XML.toString(" + o + ") = " + Zoo.show(xml) + ") throws " + e);
+                return;
+            }
+            JSONObject want = new JSONObject().put("root", o);
+            check(Gen.canonical(back).equals(Gen.canonical(want)), () -> "JSON -> XML -> JSON (KEEP_STRINGS)\n json " + o + "\n xml  " + Zoo.show(xml)
+                    + "\n got  " + Gen.canonical(back));
+        });
+    }
+
+    // ------------------------------------------------------------------ configuration laws
+
+    /** The ten settings and the order the builder calls are made in (positions modulo the calls left; all zeros is the declared order). */
+    record XmlConfig(boolean keepStrings, boolean keepNumbers, boolean keepBooleans, String cdata, boolean nil,
+            Set<String> force, int depth, int numLen, boolean close, boolean trim, List<Integer> order) {
+        List<UnaryOperator<XMLParserConfiguration>> steps() {
+            return Gen.permuted(List.of(
+                    c -> c.withKeepStrings(keepStrings), c -> c.withKeepNumberAsString(keepNumbers), c -> c.withKeepBooleanAsString(keepBooleans),
+                    c -> c.withcDataTagName(cdata), c -> c.withConvertNilAttributeToNull(nil), c -> c.withForceList(force),
+                    c -> c.withMaxNestingDepth(depth), c -> c.withMaxNumberLength(numLen), c -> c.withCloseEmptyTag(close), c -> c.withShouldTrimWhitespace(trim)), order);
+        }
+
+        String expected() {
+            return "keepStrings=" + keepStrings + " keepNumberAsString=" + keepNumbers + " keepBooleanAsString=" + keepBooleans + " cDataTagName=" + cdata
+                    + " nil=" + nil + " forceList=" + force + " maxNestingDepth=" + depth + " maxNumberLength=" + numLen + " closeEmptyTag=" + close + " trim=" + trim;
+        }
+    }
+
+    static final Generator<Tuple5<Boolean, Boolean, Boolean, String, Boolean>> FIRST_SETTINGS = tuples(chance(50), chance(50), chance(50), pick("content", "text", "$"), chance(50));
+    static final Generator<Tuple5<Set<String>, Integer, Integer, Boolean, Boolean>> LAST_SETTINGS = tuples(
+            chance(50).map(f -> f ? Set.of("a") : Set.<String>of()), pick(1, 5, 512, 1000), pick(3, 10, 1000), chance(50), chance(50));
+
+    static final Generator<XmlConfig> XML_CONFIG = tuples(FIRST_SETTINGS, LAST_SETTINGS, many(INDEX, 10, 10)).map(t -> {
+        Tuple5<Boolean, Boolean, Boolean, String, Boolean> a = t.value1();
+        Tuple5<Set<String>, Integer, Integer, Boolean, Boolean> b = t.value2();
+        return new XmlConfig(a.value1(), a.value2(), a.value3(), a.value4(), a.value5(), b.value1(), b.value2(), b.value3(), b.value4(), b.value5(), t.value3());
+    });
+
+    @Test
+    void configurationBuildersAreOrderIndependentAndLossless() {
+        Zoo.run("configurationBuildersAreOrderIndependentAndLossless", tc -> {
+            XmlConfig p = tc.draw(XML_CONFIG, "config");
+            List<UnaryOperator<XMLParserConfiguration>> order = p.steps();
+            XMLParserConfiguration c = new XMLParserConfiguration();
+            for (var step : order) {
+                c = step.apply(c);
+            }
+            String got = describe(c);
+            String want = p.expected();
+            check(got.equals(want), () -> "XMLParserConfiguration after " + order.size() + " builder calls\n want " + want + "\n got  " + got);
+        });
+    }
+
+    static String describe(XMLParserConfiguration c) {
+        return "keepStrings=" + c.isKeepStrings() + " keepNumberAsString=" + c.isKeepNumberAsString() + " keepBooleanAsString=" + c.isKeepBooleanAsString()
+                + " cDataTagName=" + c.getcDataTagName() + " nil=" + c.isConvertNilAttributeToNull() + " forceList=" + c.getForceList()
+                + " maxNestingDepth=" + c.getMaxNestingDepth() + " maxNumberLength=" + c.getMaxNumberLength() + " closeEmptyTag=" + c.isCloseEmptyTag()
+                + " trim=" + c.shouldTrimWhiteSpace();
+    }
+}
diff --git a/hegel/src/test/java/zoo/Zoo.java b/hegel/src/test/java/zoo/Zoo.java
new file mode 100644
index 0000000..6e12b6a
--- /dev/null
+++ b/hegel/src/test/java/zoo/Zoo.java
@@ -0,0 +1,115 @@
+package zoo;
+
+import dev.hegel.Database;
+import dev.hegel.Settings;
+import dev.hegel.TestCase;
+import java.util.LinkedHashSet;
+import java.util.Set;
+import java.util.function.Supplier;
+
+/**
+ * Hegel zoo harness. {@link #settings} reads {@code HEGEL_TEST_CASES} and {@code HEGEL_DATABASE}
+ * (hegel-java itself reads no environment variable); {@link #fail} throws, or under
+ * {@code ZOO_COLLECT=1} prints a {@code COLLECT <message>} line once per distinct message and
+ * lets the test case go on, so one run shows every kind of mismatch at once.
+ */
+final class Zoo {
+    private Zoo() {}
+
+    static final boolean COLLECT = notEmpty(System.getenv("ZOO_COLLECT"));
+    private static final Set<String> SEEN = new LinkedHashSet<>();
+
+    /** Runs a property under {@link #settings}. */
+    static void run(String name, java.util.function.Consumer<TestCase> body) {
+        dev.hegel.Hegel.test(body, settings(name));
+        if (COLLECT) {
+            String st = stats();
+            if (!st.equals("{}")) {
+                System.out.println("STATS " + name + " " + st);
+                System.out.flush();
+            }
+        }
+    }
+
+    static Settings settings(String name) {
+        Settings s = new Settings().name(name).testCases(testCases());
+        String db = System.getenv("HEGEL_DATABASE");
+        if (notEmpty(db)) {
+            s = s.database(Database.path(db));
+        }
+        return s;
+    }
+
+    static long testCases() {
+        String n = System.getenv("HEGEL_TEST_CASES");
+        return notEmpty(n) ? Long.parseLong(n.trim()) : 100;
+    }
+
+    static void fail(String msg) {
+        if (COLLECT) {
+            String key = msg.length() > 300 ? msg.substring(0, 300) : msg;
+            if (SEEN.add(key)) {
+                System.out.println("COLLECT " + msg.replace('\n', ' '));
+                System.out.flush();
+            }
+            return;
+        }
+        throw new AssertionError(msg);
+    }
+
+    static void check(boolean ok, Supplier<String> msg) {
+        if (!ok) {
+            fail(msg.get());
+        }
+    }
+
+    static void check(boolean ok, String msg) {
+        if (!ok) {
+            fail(msg);
+        }
+    }
+
+    private static final java.util.Map<String, Integer> STATS = new java.util.TreeMap<>();
+
+    /** Bumps a statistic; the counts are printed in collect mode (ZOO_COLLECT=1) via {@link #stats()}. */
+    static synchronized void count(String key) {
+        STATS.merge(key, 1, Integer::sum);
+    }
+
+    /** The statistics so far, cleared, as one line. */
+    static synchronized String stats() {
+        String s = STATS.toString();
+        STATS.clear();
+        return s;
+    }
+
+    /** A readable rendering of a value: strings quoted with unprintables escaped, null as "null". */
+    static String show(Object o) {
+        if (o == null) {
+            return "null";
+        }
+        if (o instanceof String s) {
+            StringBuilder sb = new StringBuilder("\"");
+            for (int i = 0; i < s.length(); i++) {
+                char c = s.charAt(i);
+                if (c == '"' || c == '\\') {
+                    sb.append('\\').append(c);
+                } else if (c < 0x20 || c == 0x7f || (c >= 0xd800 && c <= 0xdfff) || c == '\u2028' || c == '\u2029') {
+                    sb.append(String.format("\\u%04x", (int) c));
+                } else {
+                    sb.append(c);
+                }
+            }
+            return sb.append('"').toString();
+        }
+        String s = o.toString();
+        if (o instanceof Number || o instanceof Boolean) {
+            return s + " (" + o.getClass().getSimpleName() + ")";
+        }
+        return s.length() > 400 ? s.substring(0, 400) + "…" : s;
+    }
+
+    private static boolean notEmpty(String s) {
+        return s != null && !s.isEmpty();
+    }
+}
diff --git a/hegel/src/test/java/zoo/ZooListener.java b/hegel/src/test/java/zoo/ZooListener.java
