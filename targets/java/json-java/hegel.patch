+++ b/hegel/src/test/java/zoo/PinsTest.java
@@ -0,0 +1,214 @@
+package zoo;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.junit.jupiter.api.Assertions.fail;
+
+import java.io.StringReader;
+import java.util.List;
+import java.util.Map;
+import javax.xml.parsers.DocumentBuilderFactory;
+import org.json.CDL;
+import org.json.HTTP;
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONML;
+import org.json.JSONObject;
+import org.json.JSONParserConfiguration;
+import org.json.JSONPointer;
+import org.json.JSONPointerException;
+import org.json.JSONTokener;
+import org.json.XML;
+import org.json.XMLParserConfiguration;
+import org.junit.jupiter.api.Test;
+import org.xml.sax.InputSource;
+
+/**
+ * Hegel zoo: deterministic pins, one per recorded bug (targets/java/json-java/bugs.toml). Each
+ * asserts the correct behaviour and fails while the bug exists.
+ */
+class PinsTest {
+
+    static final JSONParserConfiguration STRICT = new JSONParserConfiguration().withStrictMode(true);
+
+    /** json-java/1: a \\u escape must be followed by four hex digits; a sign is not a digit. */
+    @Test
+    void pinUnicodeEscapeNeedsFourHexDigits() {
+        for (String text : new String[] {"[\"\\u-041\"]", "[\"\\u+041\"]", "{\"\\u-041\":1}"}) {
+            assertThrows(JSONException.class, () -> new JSONTokener(text).nextValue(), text + " must be rejected");
+        }
+    }
+
+    /** json-java/2: strict mode must reject Java-only number spellings. */
+    @Test
+    void pinStrictModeRejectsJavaNumberSyntax() {
+        for (String text : new String[] {"[0x1.8p1]", "[1.5f]", "[1e5D]", "[01.5]", "[1.E5]", "[1.0d]"}) {
+            assertThrows(JSONException.class, () -> new JSONArray(text, STRICT), text + " must be rejected in strict mode");
+        }
+    }
+
+    /** json-java/3: RFC 8259 whitespace is space, tab, LF and CR only. */
+    @Test
+    void pinStrictModeRejectsControlCharacterWhitespace() {
+        for (String text : new String[] {"[\u0001 1]", "{\f\"a\":1}", "[1\u000b]", "[1]\u0001"}) {
+            assertTrue(ParseTest.parse(text, STRICT) instanceof Exception, Zoo.show(text) + " must be rejected in strict mode");
+        }
+    }
+
+    /** json-java/4: tokens are unescaped once, when the pointer is parsed. */
+    @Test
+    void pinPointerTokensAreUnescapedOnce() {
+        JSONObject doc = new JSONObject().put("~1", "tilde-one").put("/", "slash").put("a~0b", "a-tilde-zero-b").put("a~b", "a-tilde-b");
+        assertEquals("tilde-one", new JSONPointer("/~01").queryFrom(doc), "/~01 references the member named ~1");
+        assertEquals("tilde-one", JSONPointer.builder().append("~1").build().queryFrom(doc), "builder tokens must not be escaped by the caller");
+        assertEquals("a-tilde-zero-b", new JSONPointer("/a~00b").queryFrom(doc), "/a~00b references the member named a~0b");
+        assertEquals("slash", new JSONPointer("/~1").queryFrom(doc));
+    }
+
+    /** json-java/5: the URI fragment form escapes ~ and / first (RFC 6901 section 6) and '+' is a plain character. */
+    @Test
+    void pinUriFragmentFormFollowsRfc6901() {
+        assertEquals("#/a~1b", JSONPointer.builder().append("a/b").build().toURIFragment());
+        assertEquals("#/~0", JSONPointer.builder().append("~").build().toURIFragment());
+        JSONObject doc = new JSONObject().put("a+b", 1).put("a b", 2).put("a/b", 3);
+        assertEquals(1, new JSONPointer("#/a+b").queryFrom(doc), "'+' in a fragment is a literal plus");
+        assertEquals(2, new JSONPointer("#/a%20b").queryFrom(doc));
+        JSONPointer p = JSONPointer.builder().append("a/b").build();
+        assertEquals(3, new JSONPointer(p.toURIFragment()).queryFrom(doc), "toURIFragment must re-parse to the same pointer");
+    }
+
+    /** json-java/6: an array index is 0 or a digit string without leading zeros, sign or other digits. */
+    @Test
+    void pinArrayIndexTokensFollowRfc6901() {
+        JSONArray a = new JSONArray().put(10).put(20);
+        for (String token : new String[] {"01", "+1", "-0", "00", "\u0661"}) {
+            assertThrows(JSONPointerException.class, () -> new JSONPointer("/" + token).queryFrom(a), Zoo.show(token) + " is not an array index");
+        }
+    }
+
+    /** json-java/7: unescape must accept the numeric character references escape emits. */
+    @Test
+    void pinUnescapeAcceptsEscapeOutput() {
+        for (String s : new String[] {"a\u0001b", "\u007f", "\u0085", "\uffff", "\ud83d", "\t\u000c"}) {
+            String e = XML.escape(s);
+            assertEquals(s, XML.unescape(e), "unescape(escape(" + Zoo.show(s) + ") = " + Zoo.show(e) + ")");
+        }
+    }
+
+    /** json-java/8: a with* call on an XMLParserConfiguration must keep keepStrings. */
+    @Test
+    void pinXmlConfigurationBuildersKeepKeepStrings() {
+        assertTrue(XMLParserConfiguration.KEEP_STRINGS.withcDataTagName("content").isKeepStrings());
+        assertTrue(new XMLParserConfiguration().withKeepStrings(true).withMaxNestingDepth(5).isKeepStrings());
+        JSONObject o = XML.toJSONObject("<a>null</a>", XMLParserConfiguration.KEEP_STRINGS.withcDataTagName("content"));
+        assertEquals("null", o.get("a"), "keepStrings keeps the text 'null'");
+    }
+
+    /** json-java/9: a with* call must keep maxNumberLength (both configuration classes). */
+    @Test
+    void pinConfigurationBuildersKeepMaxNumberLength() {
+        JSONParserConfiguration j = new JSONParserConfiguration().withMaxNumberLength(3);
+        assertEquals(3, j.withStrictMode(true).getMaxNumberLength());
+        XMLParserConfiguration x = new XMLParserConfiguration().withMaxNumberLength(3);
+        assertEquals(3, x.withCloseEmptyTag(true).getMaxNumberLength());
+    }
+
+    /** json-java/10: under keepStrings an attribute value "null" is the string "null". */
+    @Test
+    void pinXmlAttributeNullKeepsStringUnderKeepStrings() {
+        JSONObject o = XML.toJSONObject("<a b=\"null\" c=\"Null\"/>", XMLParserConfiguration.KEEP_STRINGS);
+        assertEquals("null", o.getJSONObject("a").get("b"));
+        assertEquals("Null", o.getJSONObject("a").get("c"));
+    }
+
+    /** json-java/11: toString either rejects a key that is not an XML name or produces well-formed XML. */
+    @Test
+    void pinXmlToStringIsWellFormedOrRejectsTheName() {
+        for (String key : new String[] {"a b", "", "1a", ".a", "a\tb"}) {
+            String xml;
+            try {
+                xml = XML.toString(new JSONObject().put(key, 1), "root");
+            } catch (JSONException e) {
+                continue; // rejecting the name is right
+            }
+            assertWellFormed(xml, "XML.toString of key " + Zoo.show(key));
+        }
+        String ml;
+        try {
+            ml = JSONML.toString(new JSONArray(List.of("a<b")));
+        } catch (JSONException e) {
+            return;
+        }
+        assertWellFormed(ml, "JSONML.toString of tag a<b");
+    }
+
+    static void assertWellFormed(String xml, String what) {
+        try {
+            DocumentBuilderFactory.newInstance().newDocumentBuilder().parse(new InputSource(new StringReader(xml)));
+        } catch (Exception e) {
+            fail(what + " = " + Zoo.show(xml) + " is not well-formed XML: " + e.getMessage());
+        }
+    }
+
+    /** json-java/12: a value starting with an apostrophe must be quoted, since the reader takes a leading ' as a quote. */
+    @Test
+    void pinCdlQuotesValuesStartingWithAnApostrophe() {
+        for (String v : new String[] {"'", "'a", "'a' b"}) {
+            JSONArray row = new JSONArray().put(v).put("x");
+            String text = CDL.rowToString(row);
+            JSONArray back = CDL.rowToJSONArray(new JSONTokener(text));
+            assertEquals(row.toString(), String.valueOf(back), "row " + row + " written as " + Zoo.show(text));
+        }
+    }
+
+    /** json-java/13: a value with leading or trailing whitespace must be quoted, since the reader trims. */
+    @Test
+    void pinCdlKeepsEdgeWhitespace() {
+        JSONArray row = new JSONArray().put(" a ").put("b ").put(" c");
+        String text = CDL.rowToString(row);
+        JSONArray back = CDL.rowToJSONArray(new JSONTokener(text));
+        assertEquals(row.toString(), String.valueOf(back), "row " + row + " written as " + Zoo.show(text));
+    }
+
+    /** json-java/14: toJSONObject must read a complete header block, in particular toString's own output. */
+    @Test
+    void pinHttpParsesItsOwnOutput() {
+        JSONObject req = new JSONObject().put("Method", "GET").put("Request-URI", "/x").put("HTTP-Version", "HTTP/1.1").put("Host", "h");
+        String text = HTTP.toString(req);
+        JSONObject back = HTTP.toJSONObject(text);
+        assertTrue(req.similar(back), "HTTP.toJSONObject(" + Zoo.show(text) + ") = " + back);
+        assertEquals("h", HTTP.toJSONObject("GET /x HTTP/1.1\r\nHost: h\r\n\r\n").get("Host"));
+        assertEquals("1", HTTP.toJSONObject("HTTP/1.1 200 OK\nX: 1\n\n").get("X"));
+    }
+
+    /** json-java/15: keepStrings must not unescape entities a second time. */
+    @Test
+    void pinJsonmlKeepStringsUnescapesOnce() {
+        assertEquals("&amp;", JSONML.toJSONArray("<a>&amp;amp;</a>", true).get(1));
+        assertEquals("&amp;", JSONML.toJSONArray("<a>&amp;amp;</a>", false).get(1));
+        assertEquals("&lt;b&gt;", JSONML.toJSONObject("<a>&amp;lt;b&amp;gt;</a>", true).getJSONArray("childNodes").get(0));
+    }
+
+    /** json-java/16: the configured maximum nesting depth applies to JSON text. */
+    @Test
+    void pinNestingDepthLimitAppliesToText() {
+        JSONParserConfiguration cfg = new JSONParserConfiguration().withMaxNestingDepth(2);
+        assertThrows(JSONException.class, () -> new JSONArray("[[[[1]]]]", cfg));
+        assertThrows(JSONException.class, () -> new JSONObject("{\"a\":{\"b\":{\"c\":{\"d\":1}}}}", cfg));
+    }
+
+    /** json-java/17: a negative maxNestingDepth is documented as no limit. */
+    @Test
+    void pinNegativeNestingDepthMeansNoLimit() {
+        JSONParserConfiguration cfg = new JSONParserConfiguration().withMaxNestingDepth(-1);
+        assertEquals(1, new JSONObject(Map.of("a", 1), cfg).get("a"));
+        assertEquals(1, new JSONArray(List.of(1), cfg).get(0));
+    }
+
+    /** json-java/18: NOTES.md says an invalid number format such as 1.2e6.3 causes an error. */
+    @Test
+    void pinInvalidNumberFormatIsAnError() {
+        assertThrows(JSONException.class, () -> new JSONArray("[1.2e6.3]"));
+    }
+}
diff --git a/hegel/src/test/java/zoo/PointerTest.java b/hegel/src/test/java/zoo/PointerTest.java
new file mode 100644
index 0000000..aa94e42
--- /dev/null
+++ b/hegel/src/test/java/zoo/PointerTest.java
@@ -0,0 +1,274 @@
+package zoo;
+
+import static zoo.Zoo.chance;
+import static zoo.Zoo.check;
+import static zoo.Zoo.count;
+import static zoo.Zoo.n;
+import static zoo.Zoo.pick;
+
+import dev.hegel.TestCase;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.List;
+import org.json.JSONArray;
+import org.json.JSONObject;
+import org.json.JSONPointer;
+import org.json.JSONPointerException;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Hegel zoo: {@link JSONPointer} against a model of RFC 6901 (JSON Pointer) and its URI fragment
+ * form (section 6, with RFC 3986 percent-encoding).
+ */
+class PointerTest {
+
+    static final String[] TOKENS = {
+        "", "a", "b", "a/b", "~", "~0", "~1", "~01", "~10", "a~b", "a~1b", "a~0b", "/", "//", "0", "1", "2", "01", "-", "+1", "-0", "10",
+        "a b", "a+b", "%", "%2F", "%7E1", "#", "?", "&", "=", "é", "ü/~", "😀", "'", "\"", "\\", ".", "..", "a.b",
+    };
+
+    static String token(TestCase tc) {
+        return chance(tc, 80) ? pick(tc, TOKENS) : Gen.string(tc);
+    }
+
+    // ------------------------------------------------------------------ RFC 6901 model
+
+    static String escape(String token) {
+        return token.replace("~", "~0").replace("/", "~1");
+    }
+
+    static String pointer(List<String> tokens) {
+        StringBuilder sb = new StringBuilder();
+        for (String t : tokens) {
+            sb.append('/').append(escape(t));
+        }
+        return sb.toString();
+    }
+
+    /** RFC 3986 fragment percent-encoding of an escaped token (unreserved, sub-delims, ':' and '@' stay). */
+    static String fragment(List<String> tokens) {
+        StringBuilder sb = new StringBuilder("#");
+        for (String t : tokens) {
+            sb.append('/');
+            for (byte b : escape(t).getBytes(StandardCharsets.UTF_8)) {
+                char c = (char) (b & 0xff);
+                if (Character.isLetterOrDigit(c) && c < 0x80 || "-._~!$&'()*+,;=:@".indexOf(c) >= 0) {
+                    sb.append(c);
+                } else {
+                    sb.append(String.format("%%%02X", b & 0xff));
+                }
+            }
+        }
+        return sb.toString();
+    }
+
+    static boolean isArrayIndex(String t) {
+        return t.matches("0|[1-9][0-9]*");
+    }
+
+    /** RFC 6901 evaluation: the referenced value, or null when the pointer does not reference a value. */
+    static Object evaluate(Object doc, List<String> tokens) {
+        Object cur = doc;
+        for (String t : tokens) {
+            if (cur instanceof JSONObject o) {
+                if (!o.has(t)) {
+                    return null;
+                }
+                cur = o.opt(t);
+            } else if (cur instanceof JSONArray a) {
+                if (!isArrayIndex(t) || t.length() > 9 || Integer.parseInt(t) >= a.length()) {
+                    return null;
+                }
+                cur = a.opt(Integer.parseInt(t));
+            } else {
+                return null;
+            }
+        }
+        return cur;
+    }
+
+    /** A document holding the given leaf at the path, objects or (when the token is an index) arrays along the way. */
+    static Object documentWith(TestCase tc, List<String> tokens, Object leaf) {
+        Object cur = leaf;
+        for (int i = tokens.size() - 1; i >= 0; i--) {
+            String t = tokens.get(i);
+            if (isArrayIndex(t) && t.length() < 4 && chance(tc, 70)) {
+                JSONArray a = new JSONArray();
+                int idx = Integer.parseInt(t);
+                for (int k = 0; k < idx; k++) {
+                    a.put(Gen.scalar(tc));
+                }
+                a.put(cur);
+                if (chance(tc, 30)) {
+                    a.put(Gen.scalar(tc));
+                }
+                cur = a;
+            } else {
+                JSONObject o = new JSONObject();
+                o.put(t, cur);
+                // a decoy sibling with the escaped/unescaped spelling of the token
+                String decoy = chance(tc, 50) ? escape(t) : t.replace("~1", "/").replace("~0", "~");
+                if (!decoy.equals(t) && chance(tc, 70)) {
+                    o.put(decoy, "decoy");
+                }
+                if (chance(tc, 30)) {
+                    o.put(Gen.key(tc), Gen.scalar(tc));
+                }
+                cur = o;
+            }
+        }
+        return cur;
+    }
+
+    static List<String> tokens(TestCase tc) {
+        int len = n(tc, 0, 4);
+        List<String> ts = new ArrayList<>();
+        for (int i = 0; i < len; i++) {
+            ts.add(token(tc));
+        }
+        return ts;
+    }
+
+    static Object query(JSONPointer p, Object doc) {
+        try {
+            return p.queryFrom(doc);
+        } catch (JSONPointerException e) {
+            return e;
+        }
+    }
+
+    // ------------------------------------------------------------------ properties
+
+    @Test
+    void builderPointerPrintsAndQueriesPerRfc6901() {
+        Zoo.run("builderPointerPrintsAndQueriesPerRfc6901", tc -> {
+            List<String> ts = tokens(tc);
+            JSONPointer.Builder b = JSONPointer.builder();
+            for (String t : ts) {
+                b.append(t);
+            }
+            JSONPointer p = b.build();
+            String want = pointer(ts);
+            check(p.toString().equals(want), () -> "builder " + ts + " prints " + Zoo.show(p.toString()) + ", want " + Zoo.show(want));
+            String leaf = "leaf" + n(tc, 0, 9);
+            Object doc = documentWith(tc, ts, leaf);
+            Object got = query(p, doc);
+            check(leaf.equals(got), () -> "builder pointer " + ts + " on " + doc + " gives " + Zoo.show(got) + ", want " + leaf);
+        });
+    }
+
+    @Test
+    void pointerTextQueriesPerRfc6901() {
+        Zoo.run("pointerTextQueriesPerRfc6901", tc -> {
+            List<String> ts = tokens(tc);
+            String text = pointer(ts);
+            String leaf = "leaf" + n(tc, 0, 9);
+            Object doc = documentWith(tc, ts, leaf);
+            JSONPointer p = new JSONPointer(text);
+            check(p.toString().equals(text), () -> "new JSONPointer(" + Zoo.show(text) + ") prints " + Zoo.show(p.toString()));
+            Object got = query(p, doc);
+            check(leaf.equals(got), () -> "pointer " + Zoo.show(text) + " (tokens " + ts + ") on " + doc + " gives " + Zoo.show(got) + ", want " + leaf);
+            // the document's own query methods agree
+            if (doc instanceof JSONObject o && !ts.isEmpty()) {
+                Object viaDoc;
+                try {
+                    viaDoc = o.query(text);
+                } catch (RuntimeException e) {
+                    viaDoc = e;
+                }
+                Object v = viaDoc;
+                check(leaf.equals(v), () -> "JSONObject.query(" + Zoo.show(text) + ") gives " + Zoo.show(v) + ", want " + leaf);
+            }
+        });
+    }
+
+    @Test
+    void uriFragmentFormRoundTrips() {
+        Zoo.run("uriFragmentFormRoundTrips", tc -> {
+            List<String> ts = tokens(tc);
+            String leaf = "leaf" + n(tc, 0, 9);
+            Object doc = documentWith(tc, ts, leaf);
+            String frag = fragment(ts);
+            // the RFC 6901 section 6 form is read correctly
+            Object fromRfc;
+            try {
+                fromRfc = query(new JSONPointer(frag), doc);
+            } catch (RuntimeException e) {
+                fromRfc = e;
+            }
+            Object f = fromRfc;
+            check(leaf.equals(f), () -> "fragment " + Zoo.show(frag) + " (tokens " + ts + ") on " + doc + " gives " + Zoo.show(f) + ", want " + leaf);
+            // and the library's own fragment re-parses to the same pointer
+            JSONPointer p = new JSONPointer(pointer(ts));
+            String own = p.toURIFragment();
+            check(own.startsWith("#"), () -> "toURIFragment " + Zoo.show(own) + " does not start with #");
+            Object back;
+            try {
+                JSONPointer q = new JSONPointer(own);
+                back = q.toString().equals(p.toString()) ? query(q, doc) : "re-parsed as " + Zoo.show(q.toString());
+            } catch (RuntimeException e) {
+                back = e;
+            }
+            Object bk = back;
+            check(leaf.equals(bk), () -> "toURIFragment of " + ts + " is " + Zoo.show(own) + "; re-parsed it gives " + Zoo.show(bk) + ", want " + leaf);
+        });
+    }
+
+    @Test
+    void arrayIndexTokensFollowRfc6901() {
+        Zoo.run("arrayIndexTokensFollowRfc6901", tc -> {
+            int len = n(tc, 0, 12);
+            JSONArray a = new JSONArray();
+            for (int i = 0; i < len; i++) {
+                a.put(i);
+            }
+            String t = pick(tc, "0", "1", "2", "9", "10", "11", "12", "01", "00", "+1", "-1", "-0", "-", "1 ", " 1", "1.0", "1e0", "0x1", "", "a", "١",
+                    String.valueOf(n(tc, 0, 15)), String.valueOf(n(tc, 0, 15)) + pick(tc, "", "0", "+", "-"));
+            List<String> ts = List.of(t);
+            Object want = evaluate(a, ts);
+            Object got = query(new JSONPointer(pointer(ts)), a);
+            count(want == null ? "no value" : "value");
+            if (want == null) {
+                check(got instanceof JSONPointerException, () -> "index token " + Zoo.show(t) + " on an array of " + len + " references nothing per RFC 6901, but queryFrom gives " + Zoo.show(got));
+            } else {
+                check(want.equals(got), () -> "index token " + Zoo.show(t) + " on an array of " + len + " gives " + Zoo.show(got) + ", want " + want);
+            }
+        });
+    }
+
+    @Test
+    void queriesMatchTheModelOnRandomDocuments() {
+        Zoo.run("queriesMatchTheModelOnRandomDocuments", tc -> {
+            Object doc = chance(tc, 50) ? Gen.object(tc, 3) : Gen.array(tc, 3);
+            List<String> ts = new ArrayList<>();
+            // walk the document for a real path, then perhaps perturb it
+            Object cur = doc;
+            int steps = n(tc, 0, 4);
+            for (int i = 0; i < steps; i++) {
+                if (cur instanceof JSONObject o && o.length() > 0) {
+                    String k = pick(tc, o.keySet().toArray(new String[0]));
+                    ts.add(k);
+                    cur = o.opt(k);
+                } else if (cur instanceof JSONArray a && a.length() > 0) {
+                    int idx = n(tc, 0, a.length() - 1);
+                    ts.add(String.valueOf(idx));
+                    cur = a.opt(idx);
+                } else {
+                    break;
+                }
+            }
+            if (chance(tc, 30)) {
+                ts.add(token(tc));
+            }
+            Object want = evaluate(doc, ts);
+            Object got = query(new JSONPointer(pointer(ts)), doc);
+            count(want == null ? "no value" : "value");
+            if (want == null) {
+                // org.json returns null for a missing object member rather than throwing; both are "no value" here
+                check(got == null || got instanceof JSONPointerException, () -> "pointer " + ts + " on " + doc + " references nothing, but queryFrom gives " + Zoo.show(got));
+            } else {
+                check(Gen.canonical(want).equals(Gen.canonical(got)), () -> "pointer " + ts + " on " + doc + " gives " + Zoo.show(got) + ", want " + Zoo.show(want));
+            }
+        });
+    }
+}
diff --git a/hegel/src/test/java/zoo/RoundTripTest.java b/hegel/src/test/java/zoo/RoundTripTest.java
new file mode 100644
index 0000000..a57344b
--- /dev/null
+++ b/hegel/src/test/java/zoo/RoundTripTest.java
@@ -0,0 +1,252 @@
+package zoo;
+
+import static zoo.Zoo.chance;
+import static zoo.Zoo.check;
+import static zoo.Zoo.count;
+import static zoo.Zoo.n;
+import static zoo.Zoo.pick;
+
+import com.fasterxml.jackson.core.JsonParser;
+import com.fasterxml.jackson.databind.DeserializationFeature;
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.google.gson.JsonElement;
+import dev.hegel.TestCase;
+import java.io.StringWriter;
+import java.util.List;
+import java.util.Map;
+import org.json.JSONArray;
+import org.json.JSONObject;
+import org.json.JSONParserConfiguration;
+import org.json.JSONStringer;
+import org.json.JSONTokener;
+import org.json.JSONWriter;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Hegel zoo: org.json's writers and parsers against each other, against Jackson and Gson, and
+ * against a canonical form of the generated value.
+ */
+class RoundTripTest {
+
+    static final ObjectMapper JACKSON = new ObjectMapper()
+            .enable(DeserializationFeature.USE_BIG_DECIMAL_FOR_FLOATS)
+            .enable(DeserializationFeature.USE_BIG_INTEGER_FOR_INTS)
+            .enable(DeserializationFeature.FAIL_ON_TRAILING_TOKENS)
+            .enable(JsonParser.Feature.STRICT_DUPLICATE_DETECTION);
+
+    static Object jackson(String text) {
+        try {
+            JsonNode node = JACKSON.readTree(text);
+            return Gen.fromJackson(node);
+        } catch (Exception e) {
+            return e;
+        }
+    }
+
+    /** Parses with org.json as an object or an array, according to the first character. */
+    static Object orgJson(String text, JSONParserConfiguration cfg) {
+        JSONTokener t = new JSONTokener(text);
+        Object v = cfg == null ? (text.trim().charAt(0) == '[' ? new JSONArray(t) : new JSONObject(t))
