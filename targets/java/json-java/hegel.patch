+
+    /** json-java/8: a with* call on an XMLParserConfiguration must keep keepStrings. */
+    @Test
+    void pinXmlConfigurationBuildersKeepKeepStrings() {
+        assertTrue(XMLParserConfiguration.KEEP_STRINGS.withcDataTagName("content").isKeepStrings());
+        assertTrue(new XMLParserConfiguration().withKeepStrings(true).withMaxNestingDepth(5).isKeepStrings());
+        JSONObject o = XML.toJSONObject("<a>null</a>", XMLParserConfiguration.KEEP_STRINGS.withcDataTagName("content"));
+        assertEquals("null", o.get("a"), "keepStrings keeps the text 'null'");
+    }
+
+    /** json-java/9: a with* call must keep maxNumberLength (both configuration classes). */
+    @Test
+    void pinConfigurationBuildersKeepMaxNumberLength() {
+        JSONParserConfiguration j = new JSONParserConfiguration().withMaxNumberLength(3);
+        assertEquals(3, j.withStrictMode(true).getMaxNumberLength());
+        XMLParserConfiguration x = new XMLParserConfiguration().withMaxNumberLength(3);
+        assertEquals(3, x.withCloseEmptyTag(true).getMaxNumberLength());
+    }
+
+    /** json-java/10: under keepStrings an attribute value "null" is the string "null". */
+    @Test
+    void pinXmlAttributeNullKeepsStringUnderKeepStrings() {
+        JSONObject o = XML.toJSONObject("<a b=\"null\" c=\"Null\"/>", XMLParserConfiguration.KEEP_STRINGS);
+        assertEquals("null", o.getJSONObject("a").get("b"));
+        assertEquals("Null", o.getJSONObject("a").get("c"));
+    }
+
+    /** json-java/11: toString either rejects a key that is not an XML name or produces well-formed XML. */
+    @Test
+    void pinXmlToStringIsWellFormedOrRejectsTheName() {
+        for (String key : new String[] {"a b", "", "1a", ".a", "a\tb"}) {
+            String xml;
+            try {
+                xml = XML.toString(new JSONObject().put(key, 1), "root");
+            } catch (JSONException e) {
+                continue; // rejecting the name is right
+            }
+            assertWellFormed(xml, "XML.toString of key " + Zoo.show(key));
+        }
+        String ml;
+        try {
+            ml = JSONML.toString(new JSONArray(List.of("a<b")));
+        } catch (JSONException e) {
+            return;
+        }
+        assertWellFormed(ml, "JSONML.toString of tag a<b");
+    }
+
+    static void assertWellFormed(String xml, String what) {
+        try {
+            DocumentBuilderFactory.newInstance().newDocumentBuilder().parse(new InputSource(new StringReader(xml)));
+        } catch (Exception e) {
+            fail(what + " = " + Zoo.show(xml) + " is not well-formed XML: " + e.getMessage());
+        }
+    }
+
+    /** json-java/12: a value starting with an apostrophe must be quoted, since the reader takes a leading ' as a quote. */
+    @Test
+    void pinCdlQuotesValuesStartingWithAnApostrophe() {
+        for (String v : new String[] {"'", "'a", "'a' b"}) {
+            JSONArray row = new JSONArray().put(v).put("x");
+            String text = CDL.rowToString(row);
+            JSONArray back = CDL.rowToJSONArray(new JSONTokener(text));
+            assertEquals(row.toString(), String.valueOf(back), "row " + row + " written as " + Zoo.show(text));
+        }
+    }
+
+    /** json-java/13: a value with leading or trailing whitespace must be quoted, since the reader trims. */
+    @Test
+    void pinCdlKeepsEdgeWhitespace() {
+        JSONArray row = new JSONArray().put(" a ").put("b ").put(" c");
+        String text = CDL.rowToString(row);
+        JSONArray back = CDL.rowToJSONArray(new JSONTokener(text));
+        assertEquals(row.toString(), String.valueOf(back), "row " + row + " written as " + Zoo.show(text));
+    }
+
+    /** json-java/14: toJSONObject must read a complete header block, in particular toString's own output. */
+    @Test
+    void pinHttpParsesItsOwnOutput() {
+        JSONObject req = new JSONObject().put("Method", "GET").put("Request-URI", "/x").put("HTTP-Version", "HTTP/1.1").put("Host", "h");
+        String text = HTTP.toString(req);
+        JSONObject back = HTTP.toJSONObject(text);
+        assertTrue(req.similar(back), "HTTP.toJSONObject(" + Zoo.show(text) + ") = " + back);
+        assertEquals("h", HTTP.toJSONObject("GET /x HTTP/1.1\r\nHost: h\r\n\r\n").get("Host"));
+        assertEquals("1", HTTP.toJSONObject("HTTP/1.1 200 OK\nX: 1\n\n").get("X"));
+    }
+
+    /** json-java/15: keepStrings must not unescape entities a second time. */
+    @Test
+    void pinJsonmlKeepStringsUnescapesOnce() {
+        assertEquals("&amp;", JSONML.toJSONArray("<a>&amp;amp;</a>", true).get(1));
+        assertEquals("&amp;", JSONML.toJSONArray("<a>&amp;amp;</a>", false).get(1));
+        assertEquals("&lt;b&gt;", JSONML.toJSONObject("<a>&amp;lt;b&amp;gt;</a>", true).getJSONArray("childNodes").get(0));
+    }
+
+    /** json-java/16: the configured maximum nesting depth applies to JSON text. */
+    @Test
+    void pinNestingDepthLimitAppliesToText() {
+        JSONParserConfiguration cfg = new JSONParserConfiguration().withMaxNestingDepth(2);
+        assertThrows(JSONException.class, () -> new JSONArray("[[[[1]]]]", cfg));
+        assertThrows(JSONException.class, () -> new JSONObject("{\"a\":{\"b\":{\"c\":{\"d\":1}}}}", cfg));
+    }
+
+    /** json-java/17: a negative maxNestingDepth is documented as no limit. */
+    @Test
+    void pinNegativeNestingDepthMeansNoLimit() {
+        JSONParserConfiguration cfg = new JSONParserConfiguration().withMaxNestingDepth(-1);
+        assertEquals(1, new JSONObject(Map.of("a", 1), cfg).get("a"));
+        assertEquals(1, new JSONArray(List.of(1), cfg).get(0));
+    }
+
+    /** json-java/18: NOTES.md says an invalid number format such as 1.2e6.3 causes an error. */
+    @Test
+    void pinInvalidNumberFormatIsAnError() {
+        assertThrows(JSONException.class, () -> new JSONArray("[1.2e6.3]"));
+    }
+}
diff --git a/hegel/src/test/java/zoo/PointerTest.java b/hegel/src/test/java/zoo/PointerTest.java
new file mode 100644
index 0000000..fad69c1
--- /dev/null
+++ b/hegel/src/test/java/zoo/PointerTest.java
@@ -0,0 +1,318 @@
+package zoo;
+
+import static dev.hegel.Generators.tuples;
+import static zoo.Gen.INDEX;
+import static zoo.Gen.at;
+import static zoo.Gen.chance;
+import static zoo.Gen.ints;
+import static zoo.Gen.many;
+import static zoo.Gen.maybe;
+import static zoo.Gen.pick;
+import static zoo.Gen.w;
+import static zoo.Gen.weighted;
+import static zoo.Zoo.check;
+import static zoo.Zoo.count;
+
+import dev.hegel.Generator;
+import dev.hegel.Tuple2;
+import dev.hegel.Tuple3;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.List;
+import org.json.JSONArray;
+import org.json.JSONObject;
+import org.json.JSONPointer;
+import org.json.JSONPointerException;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Hegel zoo: {@link JSONPointer} against a model of RFC 6901 (JSON Pointer) and its URI fragment
+ * form (section 6, with RFC 3986 percent-encoding).
+ */
+class PointerTest {
+
+    static final String[] TOKENS = {
+        "", "a", "b", "a/b", "~", "~0", "~1", "~01", "~10", "a~b", "a~1b", "a~0b", "/", "//", "0", "1", "2", "01", "-", "+1", "-0", "10",
+        "a b", "a+b", "%", "%2F", "%7E1", "#", "?", "&", "=", "é", "ü/~", "😀", "'", "\"", "\\", ".", "..", "a.b",
+    };
+
+    /** A reference token: one of the interesting ones (80%) or any string. */
+    static final Generator<String> TOKEN = weighted(w(80, pick(TOKENS)), w(20, Gen.STRING));
+
+    // ------------------------------------------------------------------ RFC 6901 model
+
+    static String escape(String token) {
+        return token.replace("~", "~0").replace("/", "~1");
+    }
+
+    static String pointer(List<String> tokens) {
+        StringBuilder sb = new StringBuilder();
+        for (String t : tokens) {
+            sb.append('/').append(escape(t));
+        }
+        return sb.toString();
+    }
+
+    /** RFC 3986 fragment percent-encoding of an escaped token (unreserved, sub-delims, ':' and '@' stay). */
+    static String fragment(List<String> tokens) {
+        StringBuilder sb = new StringBuilder("#");
+        for (String t : tokens) {
+            sb.append('/');
+            for (byte b : escape(t).getBytes(StandardCharsets.UTF_8)) {
+                char c = (char) (b & 0xff);
+                if (Character.isLetterOrDigit(c) && c < 0x80 || "-._~!$&'()*+,;=:@".indexOf(c) >= 0) {
+                    sb.append(c);
+                } else {
+                    sb.append(String.format("%%%02X", b & 0xff));
+                }
+            }
+        }
+        return sb.toString();
+    }
+
+    static boolean isArrayIndex(String t) {
+        return t.matches("0|[1-9][0-9]*");
+    }
+
+    /** RFC 6901 evaluation: the referenced value, or null when the pointer does not reference a value. */
+    static Object evaluate(Object doc, List<String> tokens) {
+        Object cur = doc;
+        for (String t : tokens) {
+            if (cur instanceof JSONObject o) {
+                if (!o.has(t)) {
+                    return null;
+                }
+                cur = o.opt(t);
+            } else if (cur instanceof JSONArray a) {
+                if (!isArrayIndex(t) || t.length() > 9 || Integer.parseInt(t) >= a.length()) {
+                    return null;
+                }
+                cur = a.opt(Integer.parseInt(t));
+            } else {
+                return null;
+            }
+        }
+        return cur;
+    }
+
+    // ------------------------------------------------------------------ documents
+
+    /**
+     * How one level of the document around the path is built: an array when the token is an index (70%), with these
+     * fillers before the path and perhaps one after; else an object with perhaps a decoy sibling spelled with the escaped
+     * (or unescaped) form of the token, and perhaps one more member.
+     */
+    record Level(boolean array, List<Object> fillers, boolean extra, boolean escapedDecoy, boolean decoy, boolean member, String memberKey, Object memberValue) {}
+
+    static final Generator<Level> LEVEL = tuples(chance(70), many(Gen.SCALAR, 1, 3), chance(30), chance(50), chance(70), chance(30), Gen.KEY, Gen.SCALAR)
+            .map(t -> new Level(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6(), t.value7(), t.value8()));
+
+    /** A path of tokens, the leaf to put there, and the shape of the levels along the way (recycled when the path is longer). */
+    record PointerCase(List<String> tokens, String leaf, List<Level> levels) {
+        Object document() {
+            return documentWith(tokens, leaf, levels);
+        }
+    }
+
+    static final Generator<PointerCase> POINTER_CASE = tuples(many(TOKEN, 0, 4), ints(0, 9), many(LEVEL, 1, 4))
+            .map(t -> new PointerCase(t.value1(), "leaf" + t.value2(), t.value3()));
+
+    /** A document holding the given leaf at the path, objects or (when the token is an index) arrays along the way. */
+    static Object documentWith(List<String> tokens, Object leaf, List<Level> levels) {
+        Object cur = leaf;
+        for (int i = tokens.size() - 1; i >= 0; i--) {
+            String t = tokens.get(i);
+            Level level = at(levels, i);
+            if (isArrayIndex(t) && t.length() < 4 && level.array()) {
+                JSONArray a = new JSONArray();
+                int idx = Integer.parseInt(t);
+                for (int k = 0; k < idx; k++) {
+                    a.put(at(level.fillers(), k));
+                }
+                a.put(cur);
+                if (level.extra()) {
+                    a.put(at(level.fillers(), idx));
+                }
+                cur = a;
+            } else {
+                JSONObject o = new JSONObject();
+                o.put(t, cur);
+                // a decoy sibling with the escaped/unescaped spelling of the token
+                String decoy = level.escapedDecoy() ? escape(t) : t.replace("~1", "/").replace("~0", "~");
+                if (!decoy.equals(t) && level.decoy()) {
+                    o.put(decoy, "decoy");
+                }
+                // one more member, never on the path's own key
+                if (level.member() && !level.memberKey().equals(t)) {
+                    o.put(level.memberKey(), level.memberValue());
+                }
+                cur = o;
+            }
+        }
+        return cur;
+    }
+
+    static Object query(JSONPointer p, Object doc) {
+        try {
+            return p.queryFrom(doc);
+        } catch (JSONPointerException e) {
+            return e;
+        }
+    }
+
+    // ------------------------------------------------------------------ properties
+
+    @Test
+    void builderPointerPrintsAndQueriesPerRfc6901() {
+        Zoo.run("builderPointerPrintsAndQueriesPerRfc6901", tc -> {
+            PointerCase c = tc.draw(POINTER_CASE, "case");
+            List<String> ts = c.tokens();
+            JSONPointer.Builder b = JSONPointer.builder();
+            for (String t : ts) {
+                b.append(t);
+            }
+            JSONPointer p = b.build();
+            String want = pointer(ts);
+            check(p.toString().equals(want), () -> "builder " + ts + " prints " + Zoo.show(p.toString()) + ", want " + Zoo.show(want));
+            String leaf = c.leaf();
+            Object doc = c.document();
+            Object got = query(p, doc);
+            check(leaf.equals(got), () -> "builder pointer " + ts + " on " + doc + " gives " + Zoo.show(got) + ", want " + leaf);
+        });
+    }
+
+    @Test
+    void pointerTextQueriesPerRfc6901() {
+        Zoo.run("pointerTextQueriesPerRfc6901", tc -> {
+            PointerCase c = tc.draw(POINTER_CASE, "case");
+            List<String> ts = c.tokens();
+            String text = pointer(ts);
+            String leaf = c.leaf();
+            Object doc = c.document();
+            JSONPointer p = new JSONPointer(text);
+            check(p.toString().equals(text), () -> "new JSONPointer(" + Zoo.show(text) + ") prints " + Zoo.show(p.toString()));
+            Object got = query(p, doc);
+            check(leaf.equals(got), () -> "pointer " + Zoo.show(text) + " (tokens " + ts + ") on " + doc + " gives " + Zoo.show(got) + ", want " + leaf);
+            // the document's own query methods agree
+            if (doc instanceof JSONObject o && !ts.isEmpty()) {
+                Object viaDoc;
+                try {
+                    viaDoc = o.query(text);
+                } catch (RuntimeException e) {
+                    viaDoc = e;
+                }
+                Object v = viaDoc;
+                check(leaf.equals(v), () -> "JSONObject.query(" + Zoo.show(text) + ") gives " + Zoo.show(v) + ", want " + leaf);
+            }
+        });
+    }
+
+    @Test
+    void uriFragmentFormRoundTrips() {
+        Zoo.run("uriFragmentFormRoundTrips", tc -> {
+            PointerCase c = tc.draw(POINTER_CASE, "case");
+            List<String> ts = c.tokens();
+            String leaf = c.leaf();
+            Object doc = c.document();
+            String frag = fragment(ts);
+            // the RFC 6901 section 6 form is read correctly
+            Object fromRfc;
+            try {
+                fromRfc = query(new JSONPointer(frag), doc);
+            } catch (RuntimeException e) {
+                fromRfc = e;
+            }
+            Object f = fromRfc;
+            check(leaf.equals(f), () -> "fragment " + Zoo.show(frag) + " (tokens " + ts + ") on " + doc + " gives " + Zoo.show(f) + ", want " + leaf);
+            // and the library's own fragment re-parses to the same pointer
+            JSONPointer p = new JSONPointer(pointer(ts));
+            String own = p.toURIFragment();
+            check(own.startsWith("#"), () -> "toURIFragment " + Zoo.show(own) + " does not start with #");
+            Object back;
+            try {
+                JSONPointer q = new JSONPointer(own);
+                back = q.toString().equals(p.toString()) ? query(q, doc) : "re-parsed as " + Zoo.show(q.toString());
+            } catch (RuntimeException e) {
+                back = e;
+            }
+            Object bk = back;
+            check(leaf.equals(bk), () -> "toURIFragment of " + ts + " is " + Zoo.show(own) + "; re-parsed it gives " + Zoo.show(bk) + ", want " + leaf);
+        });
+    }
+
+    /** An index-like token: the interesting spellings, a small number, or a small number with a suffix. */
+    static final Generator<String> INDEX_TOKEN = weighted(
+            w(21, pick("0", "1", "2", "9", "10", "11", "12", "01", "00", "+1", "-1", "-0", "-", "1 ", " 1", "1.0", "1e0", "0x1", "", "a", "١")),
+            w(1, ints(0, 15).map(String::valueOf)),
+            w(1, tuples(ints(0, 15), pick("", "0", "+", "-")).map(t -> t.value1() + t.value2())));
+
+    /** An array length and an index token. */
+    static final Generator<Tuple2<Integer, String>> INDEX_CASE = tuples(ints(0, 12), INDEX_TOKEN);
+
+    @Test
+    void arrayIndexTokensFollowRfc6901() {
+        Zoo.run("arrayIndexTokensFollowRfc6901", tc -> {
+            Tuple2<Integer, String> c = tc.draw(INDEX_CASE, "case");
+            int len = c.value1();
+            JSONArray a = new JSONArray();
+            for (int i = 0; i < len; i++) {
+                a.put(i);
+            }
+            String t = c.value2();
+            List<String> ts = List.of(t);
+            Object want = evaluate(a, ts);
+            Object got = query(new JSONPointer(pointer(ts)), a);
+            count(want == null ? "no value" : "value");
+            if (want == null) {
+                check(got instanceof JSONPointerException, () -> "index token " + Zoo.show(t) + " on an array of " + len + " references nothing per RFC 6901, but queryFrom gives " + Zoo.show(got));
+            } else {
+                check(want.equals(got), () -> "index token " + Zoo.show(t) + " on an array of " + len + " gives " + Zoo.show(got) + ", want " + want);
+            }
+        });
+    }
+
+    /** A document three levels deep, the steps of a walk into it (positions modulo what is there), and perhaps a final token that need not exist. */
+    static final Generator<Tuple3<Object, List<Integer>, String>> WALK = tuples(Gen.container(3), many(INDEX, 0, 4), maybe(30, (String) null, TOKEN));
+
+    /** The path of a walk into the document: member keys and indices as far as the document goes. */
+    static List<String> walk(Object doc, List<Integer> steps) {
+        List<String> ts = new ArrayList<>();
+        Object cur = doc;
+        for (int step : steps) {
+            if (cur instanceof JSONObject o && o.length() > 0) {
+                String k = at(new ArrayList<>(o.keySet()), step);
+                ts.add(k);
+                cur = o.opt(k);
+            } else if (cur instanceof JSONArray a && a.length() > 0) {
+                int idx = Math.floorMod(step, a.length());
+                ts.add(String.valueOf(idx));
+                cur = a.opt(idx);
+            } else {
+                break;
+            }
+        }
+        return ts;
+    }
+
+    @Test
+    void queriesMatchTheModelOnRandomDocuments() {
+        Zoo.run("queriesMatchTheModelOnRandomDocuments", tc -> {
+            Tuple3<Object, List<Integer>, String> c = tc.draw(WALK, "case");
+            Object doc = c.value1();
+            // walk the document for a real path, then perhaps perturb it
+            List<String> ts = walk(doc, c.value2());
+            if (c.value3() != null) {
+                ts.add(c.value3());
+            }
+            Object want = evaluate(doc, ts);
+            Object got = query(new JSONPointer(pointer(ts)), doc);
+            count(want == null ? "no value" : "value");
+            if (want == null) {
+                // org.json returns null for a missing object member rather than throwing; both are "no value" here
+                check(got == null || got instanceof JSONPointerException, () -> "pointer " + ts + " on " + doc + " references nothing, but queryFrom gives " + Zoo.show(got));
+            } else {
+                check(Gen.canonical(want).equals(Gen.canonical(got)), () -> "pointer " + ts + " on " + doc + " gives " + Zoo.show(got) + ", want " + Zoo.show(want));
+            }
+        });
+    }
+}
diff --git a/hegel/src/test/java/zoo/RoundTripTest.java b/hegel/src/test/java/zoo/RoundTripTest.java
new file mode 100644
index 0000000..06a81ec
--- /dev/null
+++ b/hegel/src/test/java/zoo/RoundTripTest.java
@@ -0,0 +1,260 @@
+package zoo;
+
+import static dev.hegel.Generators.tuples;
+import static zoo.Gen.chance;
+import static zoo.Gen.ints;
+import static zoo.Zoo.check;
+import static zoo.Zoo.count;
+
+import com.fasterxml.jackson.core.JsonParser;
+import com.fasterxml.jackson.databind.DeserializationFeature;
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.google.gson.JsonElement;
+import dev.hegel.Generator;
+import dev.hegel.Tuple2;
+import java.io.StringWriter;
+import java.util.List;
+import java.util.Map;
+import org.json.JSONArray;
+import org.json.JSONObject;
+import org.json.JSONParserConfiguration;
+import org.json.JSONStringer;
+import org.json.JSONTokener;
+import org.json.JSONWriter;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Hegel zoo: org.json's writers and parsers against each other, against Jackson and Gson, and
+ * against a canonical form of the generated value.
+ */
+class RoundTripTest {
+
+    static final ObjectMapper JACKSON = new ObjectMapper()
+            .enable(DeserializationFeature.USE_BIG_DECIMAL_FOR_FLOATS)
+            .enable(DeserializationFeature.USE_BIG_INTEGER_FOR_INTS)
+            .enable(DeserializationFeature.FAIL_ON_TRAILING_TOKENS)
+            .enable(JsonParser.Feature.STRICT_DUPLICATE_DETECTION);
+
+    static Object jackson(String text) {
+        try {
+            JsonNode node = JACKSON.readTree(text);
+            return Gen.fromJackson(node);
+        } catch (Exception e) {
+            return e;
+        }
+    }
+
+    /** Parses with org.json as an object or an array, according to the first character. */
+    static Object orgJson(String text, JSONParserConfiguration cfg) {
+        JSONTokener t = new JSONTokener(text);
+        Object v = cfg == null ? (text.trim().charAt(0) == '[' ? new JSONArray(t) : new JSONObject(t))
+                : (text.trim().charAt(0) == '[' ? new JSONArray(t, cfg) : new JSONObject(t, cfg));
+        return v;
+    }
+
+    /** An object or an array four levels deep. */
+    static final Generator<Object> CONTAINER = Gen.container(4);
+
+    @Test
+    void toStringParsesBackToTheSameValue() {
+        Zoo.run("toStringParsesBackToTheSameValue", tc -> {
+            Object o = tc.draw(CONTAINER, "value");
+            String want = Gen.canonical(o);
+            String text = o.toString();
+            Object back = orgJson(text, null);
+            check(Gen.canonical(back).equals(want), () -> "toString then parse changed the value\n text " + text
+                    + "\n want " + want + "\n got  " + Gen.canonical(back));
+            boolean similar = o instanceof JSONObject j ? j.similar(back) : ((JSONArray) o).similar(back);
+            check(similar, () -> "similar is false after a toString round trip\n text " + text);
+        });
+    }
+
+    /** A value and an indent width. */
+    static final Generator<Tuple2<Object, Integer>> INDENTED = tuples(CONTAINER, ints(0, 5));
+
+    @Test
+    void indentedToStringParsesBackToTheSameValue() {
+        Zoo.run("indentedToStringParsesBackToTheSameValue", tc -> {
+            Tuple2<Object, Integer> c = tc.draw(INDENTED, "case");
+            Object o = c.value1();
+            int indent = c.value2();
+            String want = Gen.canonical(o);
+            String text = o instanceof JSONObject j ? j.toString(indent) : ((JSONArray) o).toString(indent);
+            Object back = orgJson(text, null);
+            check(Gen.canonical(back).equals(want), () -> "toString(" + indent + ") then parse changed the value\n text " + text
+                    + "\n want " + want + "\n got  " + Gen.canonical(back));
+            Object jack = jackson(text);
+            check(!(jack instanceof Exception), () -> "Jackson rejects toString(" + indent + ") output: " + jack + "\n text " + text);
+            check(Gen.canonical(jack).equals(want), () -> "Jackson reads toString(" + indent + ") output differently\n text " + text
+                    + "\n want " + want + "\n got  " + Gen.canonical(jack));
+        });
+    }
+
+    @Test
+    void toStringIsStandardJson() {
+        Zoo.run("toStringIsStandardJson", tc -> {
+            Object o = tc.draw(CONTAINER, "value");
+            String want = Gen.canonical(o);
+            String text = o.toString();
+            Object jack = jackson(text);
+            check(!(jack instanceof Exception), () -> "Jackson rejects toString output: " + jack + "\n text " + text);
+            check(Gen.canonical(jack).equals(want), () -> "Jackson reads toString output differently\n text " + text
+                    + "\n want " + want + "\n got  " + Gen.canonical(jack));
+            JsonElement g = com.google.gson.JsonParser.parseString(text);
+            String gs = Gen.canonical(gson(g));
+            check(gs.equals(want), () -> "Gson reads toString output differently\n text " + text + "\n want " + want + "\n got  " + gs);
+        });
+    }
+
+    static Object gson(JsonElement e) {
+        if (e == null || e.isJsonNull()) {
+            return null;
+        }
+        if (e.isJsonPrimitive()) {
+            var p = e.getAsJsonPrimitive();
+            if (p.isBoolean()) {
+                return p.getAsBoolean();
+            }
+            if (p.isNumber()) {
+                return p.getAsBigDecimal();
+            }
+            return p.getAsString();
+        }
+        if (e.isJsonArray()) {
+            List<Object> l = new java.util.ArrayList<>();
+            e.getAsJsonArray().forEach(x -> l.add(gson(x)));
+            return l;
+        }
+        Map<String, Object> m = new java.util.LinkedHashMap<>();
+        e.getAsJsonObject().entrySet().forEach(en -> m.put(en.getKey(), gson(en.getValue())));
+        return m;
+    }
+
+    /** A value and whether to parse it in strict mode (lenient first). */
+    static final Generator<Tuple2<Object, Boolean>> MODED = tuples(CONTAINER, chance(50));
+
+    @Test
+    void standardJsonParsesLikeJackson() {
+        Zoo.run("standardJsonParsesLikeJackson", tc -> {
+            Tuple2<Object, Boolean> c = tc.draw(MODED, "case");
+            Object o = c.value1();
+            String text = Gen.standard(o);
+            String want = Gen.canonical(o);
+            Object jack = jackson(text);
+            check(!(jack instanceof Exception), () -> "our standard writer is wrong: " + jack + "\n text " + text);
+            boolean strict = c.value2();
+            JSONParserConfiguration cfg = strict ? new JSONParserConfiguration().withStrictMode(true) : null;
+            count(strict ? "strict" : "lenient");
+            Object back;
+            try {
+                back = orgJson(text, cfg);
+            } catch (RuntimeException e) {
+                Zoo.fail("org.json rejects standard JSON (" + (strict ? "strict" : "lenient") + "): " + e + "\n text " + text);
+                return;
+            }
+            check(Gen.canonical(back).equals(want), () -> "org.json reads standard JSON differently (" + (strict ? "strict" : "lenient")
+                    + ")\n text " + text + "\n want " + want + "\n got  " + Gen.canonical(back));
+        });
+    }
+
+    @Test
+    void jsonWriterMatchesToString() {
+        Zoo.run("jsonWriterMatchesToString", tc -> {
+            Object o = tc.draw(CONTAINER, "value");
+            JSONStringer s = new JSONStringer();
+            write(s, o);
+            String text = s.toString();
+            String want = o.toString();
+            check(text.equals(want), () -> "JSONStringer differs from toString\n stringer " + text + "\n toString " + want);
+            StringWriter sw = new StringWriter();
+            JSONWriter w = new JSONWriter(sw);
+            write(w, o);
+            check(sw.toString().equals(want), () -> "JSONWriter differs from toString\n writer   " + sw + "\n toString " + want);
+        });
+    }
+
+    static void write(JSONWriter w, Object o) {
+        if (o instanceof JSONObject j) {
+            w.object();
+            for (String k : j.keySet()) {
+                w.key(k);
+                write(w, j.opt(k));
+            }
+            w.endObject();
+        } else if (o instanceof JSONArray a) {
+            w.array();
+            for (int i = 0; i < a.length(); i++) {
+                write(w, a.opt(i));
+            }
+            w.endArray();
+        } else {
+            w.value(o);
+        }
+    }
+
+    @Test
+    void toMapAndBackKeepsTheValue() {
+        Zoo.run("toMapAndBackKeepsTheValue", tc -> {
+            Object o = tc.draw(CONTAINER, "value");
+            String want = Gen.canonical(o);
+            // toMap/toList turn JSONObject.NULL into Java null; the Map constructor keeps a null member
+            // only under useNativeNulls (documented: otherwise "ignore that map entry"), lists keep nulls
+            JSONParserConfiguration keep = new JSONParserConfiguration().withUseNativeNulls(true);
+            Object back = o instanceof JSONObject j ? new JSONObject(j.toMap(), keep) : new JSONArray(((JSONArray) o).toList(), keep);
+            check(Gen.canonical(back).equals(want), () -> "toMap/toList then the collection constructor (useNativeNulls) changed the value\n want " + want
+                    + "\n got  " + Gen.canonical(back));
+            String wantDropped = Gen.canonical(withoutNullMembers(o));
+            Object dropped = o instanceof JSONObject j ? new JSONObject(j.toMap()) : new JSONArray(((JSONArray) o).toList());
+            check(Gen.canonical(dropped).equals(wantDropped), () -> "toMap/toList then the collection constructor should only drop null members\n want " + wantDropped
+                    + "\n got  " + Gen.canonical(dropped));
+            Object wrapped = JSONObject.wrap(o instanceof JSONObject j ? j.toMap() : ((JSONArray) o).toList());
+            check(Gen.canonical(wrapped).equals(wantDropped), () -> "wrap(toMap/toList) should only drop null members\n want " + wantDropped
+                    + "\n got  " + Gen.canonical(wrapped));
+            // a copy through the standard text is `similar`
+            Object copy = orgJson(Gen.standard(o), null);
+            boolean similar = o instanceof JSONObject j ? j.similar(copy) : ((JSONArray) o).similar(copy);
+            check(similar, () -> "similar is false for a value and its re-parsed standard text\n text " + Gen.standard(o) + "\n copy " + copy);
+        });
+    }
+
+    /** A copy of the tree without the object members whose value is null (arrays keep their nulls). */
+    static Object withoutNullMembers(Object o) {
+        if (o instanceof JSONObject j) {
+            JSONObject r = new JSONObject();
+            for (String k : j.keySet()) {
+                Object v = j.opt(k);
+                if (!Gen.isNull(v)) {
+                    r.put(k, withoutNullMembers(v));
+                }
+            }
+            return r;
+        }
+        if (o instanceof JSONArray a) {
+            JSONArray r = new JSONArray();
+            for (int i = 0; i < a.length(); i++) {
+                r.put(withoutNullMembers(a.opt(i)));
+            }
+            return r;
+        }
+        return o;
+    }
+
+    @Test
+    void valueToStringMatchesQuoteAndNumberToString() {
+        Zoo.run("valueToStringMatchesQuoteAndNumberToString", tc -> {
+            Object v = tc.draw(Gen.SCALAR, "scalar");
+            String s = JSONObject.valueToString(v);
+            String want = v instanceof String str ? JSONObject.quote(str)
+                    : v instanceof Number x ? JSONObject.numberToString(x) : String.valueOf(v);
+            check(s.equals(want), () -> "valueToString " + s + " differs from " + want + " for " + Zoo.show(v));
+            // and a scalar in an array round-trips through toString
+            JSONArray a = new JSONArray().put(v);
+            Object back = new JSONArray(a.toString()).opt(0);
+            check(Gen.canonical(back).equals(Gen.canonical(v)), () -> "scalar changed by a toString round trip: " + Zoo.show(v)
+                    + " -> " + a + " -> " + Zoo.show(back));
+            Object jack = jackson(a.toString());
+            check(!(jack instanceof Exception) && Gen.canonical(jack).equals(Gen.canonical(a)), () -> "Jackson disagrees on " + a + ": " + jack);
+        });
+    }
+}
