+/**
+ * Hegel zoo: deterministic pins, one per recorded bug (targets/java/json-java/bugs.toml). Each
+ * asserts the correct behaviour and fails while the bug exists.
+ */
+class PinsTest {
+
+    static final JSONParserConfiguration STRICT = new JSONParserConfiguration().withStrictMode(true);
+
+    /** json-java/1: a \\u escape must be followed by four hex digits; a sign is not a digit. */
+    @Test
+    void pinUnicodeEscapeNeedsFourHexDigits() {
+        for (String text : new String[] {"[\"\\u-041\"]", "[\"\\u+041\"]", "{\"\\u-041\":1}"}) {
+            assertThrows(JSONException.class, () -> new JSONTokener(text).nextValue(), text + " must be rejected");
+        }
+    }
+
+    /** json-java/2: strict mode must reject Java-only number spellings. */
+    @Test
+    void pinStrictModeRejectsJavaNumberSyntax() {
+        for (String text : new String[] {"[0x1.8p1]", "[1.5f]", "[1e5D]", "[01.5]", "[1.E5]", "[1.0d]"}) {
+            assertThrows(JSONException.class, () -> new JSONArray(text, STRICT), text + " must be rejected in strict mode");
+        }
+    }
+
+    /** json-java/3: RFC 8259 whitespace is space, tab, LF and CR only. */
+    @Test
+    void pinStrictModeRejectsControlCharacterWhitespace() {
+        for (String text : new String[] {"[\u0001 1]", "{\f\"a\":1}", "[1\u000b]", "[1]\u0001"}) {
+            assertTrue(ParseTest.parse(text, STRICT) instanceof Exception, Zoo.show(text) + " must be rejected in strict mode");
+        }
+    }
+
+    /** json-java/4: tokens are unescaped once, when the pointer is parsed. */
+    @Test
+    void pinPointerTokensAreUnescapedOnce() {
+        JSONObject doc = new JSONObject().put("~1", "tilde-one").put("/", "slash").put("a~0b", "a-tilde-zero-b").put("a~b", "a-tilde-b");
+        assertEquals("tilde-one", new JSONPointer("/~01").queryFrom(doc), "/~01 references the member named ~1");
+        assertEquals("tilde-one", JSONPointer.builder().append("~1").build().queryFrom(doc), "builder tokens must not be escaped by the caller");
+        assertEquals("a-tilde-zero-b", new JSONPointer("/a~00b").queryFrom(doc), "/a~00b references the member named a~0b");
+        assertEquals("slash", new JSONPointer("/~1").queryFrom(doc));
+    }
+
+    /** json-java/5: the URI fragment form escapes ~ and / first (RFC 6901 section 6) and '+' is a plain character. */
+    @Test
+    void pinUriFragmentFormFollowsRfc6901() {
+        assertEquals("#/a~1b", JSONPointer.builder().append("a/b").build().toURIFragment());
+        assertEquals("#/~0", JSONPointer.builder().append("~").build().toURIFragment());
+        JSONObject doc = new JSONObject().put("a+b", 1).put("a b", 2).put("a/b", 3);
+        assertEquals(1, new JSONPointer("#/a+b").queryFrom(doc), "'+' in a fragment is a literal plus");
+        assertEquals(2, new JSONPointer("#/a%20b").queryFrom(doc));
+        JSONPointer p = JSONPointer.builder().append("a/b").build();
+        assertEquals(3, new JSONPointer(p.toURIFragment()).queryFrom(doc), "toURIFragment must re-parse to the same pointer");
+    }
+
+    /** json-java/6: an array index is 0 or a digit string without leading zeros, sign or other digits. */
+    @Test
+    void pinArrayIndexTokensFollowRfc6901() {
+        JSONArray a = new JSONArray().put(10).put(20);
+        for (String token : new String[] {"01", "+1", "-0", "00", "\u0661"}) {
