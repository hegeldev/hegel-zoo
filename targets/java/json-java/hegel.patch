+
+/**
+ * Hegel zoo: the text converters of org.json (CDL, Cookie, CookieList, HTTP, JSONML) against
+ * the round trips their javadoc describes.
+ */
+class ConvertersTest {
+
+    // ------------------------------------------------------------------ CDL
+
+    /** Printable ASCII plus a few non-ASCII letters and the characters CDL treats specially. */
+    static final String CDL_CHARS = "abcXYZ019 _-.:;'\"\\,\t\n\r\u00e9\u4e2d";
+
+    static final Generator<String> CDL_VALUE = word(CDL_CHARS, 0, 8);
+
+    /** CDL's javadoc: a value may contain any character except the delimiter unless quoted; the writer quotes those. */
+    static boolean cdlSafe(String v, char delim) {
+        if (v.isEmpty()) {
+            return true;
+        }
+        for (char c : v.toCharArray()) {
+            if (c == '"' || c == '\'' && v.charAt(0) == '\'' || c < ' ' && c != '\n' && c != '\r' && c != '\t') {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    /** The delimiter: a comma (70%) or one of the others. */
+    static final Generator<Character> DELIM = Gen.<Character>maybe(70, ',', pick(';', '|', '\t'));
+
+    /** A table: the delimiter, the column names c0.., c1.. with these suffixes, and one to three rows of as many values. */
+    record CdlTable(char delim, List<String> suffixes, List<List<String>> rows) {
+        List<String> names() {
+            List<String> names = new ArrayList<>();
+            for (int i = 0; i < suffixes.size(); i++) {
+                names.add("c" + i + suffixes.get(i));
+            }
+            return names;
+        }
+
+        JSONArray table() {
+            JSONArray table = new JSONArray();
+            List<String> names = names();
+            for (List<String> values : rows) {
+                JSONObject row = new JSONObject();
+                for (int i = 0; i < names.size(); i++) {
+                    row.put(names.get(i), values.get(i));
+                }
+                table.put(row);
+            }
+            return table;
+        }
+    }
+
+    static final Generator<CdlTable> CDL_TABLE = tuples(DELIM, many(word("abx", 0, 2), 1, 4))
+            .flatMap(t -> many(many(CDL_VALUE, t.value2().size(), t.value2().size()), 1, 3).map(rows -> new CdlTable(t.value1(), t.value2(), rows)));
+
+    @Test
+    void cdlRowsRoundTrip() {
+        Zoo.run("cdlRowsRoundTrip", tc -> {
+            CdlTable c = tc.draw(CDL_TABLE, "table");
+            char delim = c.delim();
+            List<String> names = c.names();
+            JSONArray namesArr = new JSONArray(names);
+            JSONArray table = c.table();
+            int rows = table.length();
+            boolean allSafe = true;
+            for (List<String> values : c.rows()) {
+                for (String v : values) {
+                    allSafe &= cdlSafe(v, delim);
+                }
+            }
+            String text = CDL.toString(namesArr, table, delim);
+            JSONArray back;
+            try {
+                back = CDL.toJSONArray(namesArr, text, delim);
+            } catch (RuntimeException e) {
+                Zoo.fail("CDL.toJSONArray(CDL.toString(table)) throws " + e + "\n text " + Zoo.show(text) + "\n table " + Gen.canonical(table));
+                return;
+            }
+            String want = Gen.canonical(table);
+            String got = back == null ? "null" : Gen.canonical(back);
+            boolean edge = false;
+            boolean newline = false;
+            for (int r = 0; r < rows; r++) {
+                for (String nm : names) {
+                    String v = table.getJSONObject(r).getString(nm);
+                    edge |= !v.equals(v.trim());
+                    newline |= v.indexOf('\n') >= 0 || v.indexOf('\r') >= 0;
+                }
+            }
+            count(!allSafe ? "quote or control in a value" : newline ? "newline in a value" : edge ? "edge whitespace" : "plain");
+            check(got.equals(want), () -> "CDL round trip (delimiter " + Zoo.show(String.valueOf(delim)) + ") changed the table\n text " + Zoo.show(text)
+                    + "\n want " + want + "\n got  " + got);
+        });
+    }
+
+    static final Generator<List<String>> CDL_ROW = many(CDL_VALUE, 1, 5);
+
+    @Test
+    void cdlSingleRowRoundTrips() {
+        Zoo.run("cdlSingleRowRoundTrips", tc -> {
+            JSONArray row = new JSONArray(tc.draw(CDL_ROW, "row"));
+            String text = CDL.rowToString(row);
+            check(text.endsWith("\n"), () -> "rowToString does not end with a newline: " + Zoo.show(text));
+            JSONArray back;
+            try {
+                back = CDL.rowToJSONArray(new JSONTokener(text));
+            } catch (RuntimeException e) {
+                Zoo.fail("rowToJSONArray(rowToString(row)) throws " + e + "\n text " + Zoo.show(text) + "\n row " + Gen.canonical(row));
+                return;
+            }
+            String want = Gen.canonical(row);
+            String got = back == null ? "null" : Gen.canonical(back);
+            check(got.equals(want), () -> "rowToString then rowToJSONArray changed the row\n text " + Zoo.show(text) + "\n want " + want + "\n got  " + got);
+        });
+    }
+
+    // ------------------------------------------------------------------ Cookie
+
+    static final String COOKIE_CHARS = "abcXYZ019_-./:+%=;, \"\u00e9";
+
+    /** Cookie-flavoured text (70%) or any string. */
+    static final Generator<String> ESCAPE_INPUT = weighted(w(70, word(COOKIE_CHARS, 0, 10)), w(30, Gen.STRING));
+
+    @Test
+    void cookieEscapeUnescapeRoundTrips() {
+        Zoo.run("cookieEscapeUnescapeRoundTrips", tc -> {
+            String s = tc.draw(ESCAPE_INPUT, "text");
+            String e = Cookie.escape(s);
+            // the javadoc: '+', '%', '=', ';' and control characters are replaced by %hh
+            int bad = -1;
+            for (int i = 0; i < e.length() && bad < 0; i++) {
+                char c = e.charAt(i);
+                if (c == '+' || c == '=' || c == ';' || c < ' ') {
+                    bad = i;
+                }
+            }
+            int b = bad;
+            check(b < 0, () -> "Cookie.escape(" + Zoo.show(s) + ") = " + Zoo.show(e) + " still contains " + Zoo.show(String.valueOf(e.charAt(b))));
+            String back = Cookie.unescape(e);
+            check(back.equals(s.trim()), () -> "Cookie.unescape(Cookie.escape(" + Zoo.show(s) + ")) = " + Zoo.show(back) + " (escape trims: want " + Zoo.show(s.trim()) + ")");
+        });
+    }
+
+    /** An attribute name; "x-" gets its position appended. */
+    static final Generator<String> ATTRIBUTE_KEY = pick("path", "domain", "expires", "max-age", "secure", "httponly", "samesite", "Path", "Secure", "x-");
+
+    /** An attribute value: text (60%) or the flag TRUE. */
+    static final Generator<Object> ATTRIBUTE_VALUE = Gen.<Object>weighted(w(60, word(COOKIE_CHARS, 1, 6)), v(40, Boolean.TRUE));
+
+    /** A cookie: its name (made non-blank), its value and up to three attributes (a repeated name overwrites). */
+    record CookieCase(String name, String value, List<Tuple2<String, Object>> attributes) {
+        JSONObject object() {
+            JSONObject jo = new JSONObject();
+            jo.put("name", name.replace("=", "").replace(";", "").trim().isEmpty() ? "n" : name);
+            jo.put("value", value);
+            for (int i = 0; i < attributes.size(); i++) {
+                String key = attributes.get(i).value1();
+                jo.put(key.equals("x-") ? key + i : key, attributes.get(i).value2());
+            }
+            return jo;
+        }
+    }
+
+    static final Generator<CookieCase> COOKIE = tuples(word(COOKIE_CHARS, 1, 6), word(COOKIE_CHARS, 0, 8), lists(tuples(ATTRIBUTE_KEY, ATTRIBUTE_VALUE)).maxSize(3))
+            .map(t -> new CookieCase(t.value1(), t.value2(), t.value3()));
+
+    @Test
+    void cookieRoundTrips() {
+        Zoo.run("cookieRoundTrips", tc -> {
+            JSONObject jo = tc.draw(COOKIE, "cookie").object();
+            String text;
+            try {
+                text = Cookie.toString(jo);
+            } catch (RuntimeException e) {
+                Zoo.fail("Cookie.toString(" + jo + ") throws " + e);
+                return;
+            }
+            JSONObject back;
+            try {
+                back = Cookie.toJSONObject(text);
+            } catch (RuntimeException e) {
+                Zoo.fail("Cookie.toJSONObject(Cookie.toString(" + jo + ") = " + Zoo.show(text) + ") throws " + e);
+                return;
+            }
+            // the documented model: name/value trimmed, attribute names lower-cased, string attributes trimmed,
+            // and (the reader's "only store non-blank attributes") an attribute whose trimmed text is empty is dropped
+            JSONObject want = new JSONObject();
+            for (String k : jo.keySet()) {
+                Object v = jo.get(k);
+                boolean nameOrValue = k.equals("name") || k.equals("value");
+                String key = nameOrValue ? k : k.toLowerCase(Locale.ROOT);
+                if (v instanceof String s) {
+                    if (nameOrValue || !s.trim().isEmpty()) {
+                        want.put(key, s.trim());
+                    }
+                } else {
+                    want.put(key, v);
+                }
+            }
+            for (String k : jo.keySet()) {
+                if (!k.equals(k.toLowerCase(Locale.ROOT))) {
+                    count("upper-case attribute");
+                }
+                if (jo.get(k) instanceof String s && s.trim().isEmpty() && !k.equals("value")) {
+                    count("blank attribute value");
+                }
+            }
+            check(Gen.canonical(back).equals(Gen.canonical(want)), () -> "Cookie round trip\n object " + jo + "\n text   " + Zoo.show(text)
+                    + "\n want   " + Gen.canonical(want) + "\n got    " + Gen.canonical(back));
+        });
+    }
+
+    /** One to four cookies as name/value pairs (blank names get a stand-in, repeated names overwrite). */
+    static final Generator<List<Tuple2<String, String>>> COOKIE_LIST = many(tuples(word(COOKIE_CHARS, 1, 5), word(COOKIE_CHARS, 0, 6)), 1, 4);
+
+    static JSONObject cookieList(List<Tuple2<String, String>> cookies) {
+        JSONObject jo = new JSONObject();
+        for (int i = 0; i < cookies.size(); i++) {
+            String name = cookies.get(i).value1().trim();
+            jo.put(name.isEmpty() ? "n" + i : name, cookies.get(i).value2());
+        }
+        return jo;
+    }
+
+    @Test
+    void cookieListRoundTrips() {
+        Zoo.run("cookieListRoundTrips", tc -> {
+            JSONObject jo = cookieList(tc.draw(COOKIE_LIST, "cookies"));
+            String text = CookieList.toString(jo);
+            JSONObject back;
+            try {
+                back = CookieList.toJSONObject(text);
+            } catch (RuntimeException e) {
+                Zoo.fail("CookieList.toJSONObject(" + Zoo.show(text) + ") throws " + e + " for " + jo);
+                return;
+            }
+            // the reader trims names and values (nextTo trims); an empty value stays an empty value
+            JSONObject want = new JSONObject();
+            for (String k : jo.keySet()) {
+                want.put(k, jo.getString(k).trim());
+            }
+            check(Gen.canonical(back).equals(Gen.canonical(want)), () -> "CookieList round trip\n object " + jo + "\n text   " + Zoo.show(text)
+                    + "\n want   " + Gen.canonical(want) + "\n got    " + Gen.canonical(back));
+        });
+    }
+
+    // ------------------------------------------------------------------ HTTP
+
+    static final String TOKEN_CHARS = "abcXYZ019-_.";
+
+    /** A request line as its members. */
+    static final Generator<Map<String, String>> REQUEST = tuples(pick("GET", "POST", "PUT", "DELETE", "OPTIONS"), word(TOKEN_CHARS + "/?=&%", 0, 8), pick("HTTP/1.1", "HTTP/1.0"))
+            .map(t -> {
+                Map<String, String> m = new LinkedHashMap<>();
+                m.put("Method", t.value1());
+                m.put("Request-URI", "/" + t.value2());
+                m.put("HTTP-Version", t.value3());
+                return m;
+            });
+
+    /** A status line as its members. */
+    static final Generator<Map<String, String>> RESPONSE = tuples(pick("HTTP/1.1", "HTTP/1.0", "HTTP/2"), ints(100, 599), pick("OK", "Not Found", "I'm a teapot", "Moved Permanently", "X"))
+            .map(t -> {
+                Map<String, String> m = new LinkedHashMap<>();
+                m.put("HTTP-Version", t.value1());
+                m.put("Status-Code", String.valueOf(t.value2()));
+                m.put("Reason-Phrase", t.value3());
+                return m;
+            });
+
+    static final Generator<String> HEADER_NAME = weighted(w(4, pick("Host", "Content-Type", "Content-Length", "Accept")), w(1, word(TOKEN_CHARS, 1, 4).map(s -> "X-" + s)));
+
+    /** A request or a response start line and up to three headers (a repeated name overwrites). */
+    static final Generator<Tuple2<Map<String, String>, List<Tuple2<String, String>>>> HTTP_MESSAGE = tuples(
+            weighted(w(1, REQUEST), w(1, RESPONSE)),
+            lists(tuples(HEADER_NAME, word(TOKEN_CHARS + " ;=,/", 0, 10).map(String::trim))).maxSize(3));
+
+    @Test
+    void httpHeadersRoundTrip() {
+        Zoo.run("httpHeadersRoundTrip", tc -> {
+            Tuple2<Map<String, String>, List<Tuple2<String, String>>> c = tc.draw(HTTP_MESSAGE, "message");
+            JSONObject jo = new JSONObject(c.value1());
+            for (Tuple2<String, String> h : c.value2()) {
+                jo.put(h.value1(), h.value2());
+            }
+            int headers = c.value2().size();
+            String text = HTTP.toString(jo);
+            check(text.endsWith(HTTP.CRLF + HTTP.CRLF), () -> "HTTP.toString does not end with two CRLF: " + Zoo.show(text));
+            count(headers == 0 ? "no headers" : "headers");
+            JSONObject back;
+            try {
+                back = HTTP.toJSONObject(text);
+            } catch (RuntimeException e) {
+                Zoo.fail("HTTP.toJSONObject(HTTP.toString(" + jo + ") = " + Zoo.show(text) + ") throws " + e);
+                return;
+            }
+            check(Gen.canonical(back).equals(Gen.canonical(jo)), () -> "HTTP round trip\n object " + jo + "\n text   " + Zoo.show(text)
+                    + "\n got    " + Gen.canonical(back));
+        });
+    }
+
+    // ------------------------------------------------------------------ JSONML
+
+    static final Generator<String> XML_NAME = tuples(word("abcXYZ", 1, 1), word("abcXYZ019_-.", 0, 4)).map(t -> t.value1() + t.value2());
+
+    /** Text content JSONML keeps as is: no XML meta characters, no edge whitespace. */
+    static final Generator<String> XML_TEXT = word("abcXYZ019 _-.,;:!?'\"\u00e9\u4e2d", 1, 8).map(s -> s.trim().isEmpty() ? "x" : s.trim());
+
+    /** An attribute value: a small number's text or text. */
+    static final Generator<String> ATTR_VALUE = weighted(w(30, ints(0, 99).map(String::valueOf)), w(70, XML_TEXT));
+
+    /**
+     * An element: its name, its attributes (absent half the time), its child elements each with perhaps a text before it, and perhaps
+     * a text after the last one (so that no two text nodes are adjacent: they would merge).
+     */
+    record Ml(String name, Map<String, String> attrs, List<Tuple2<String, Ml>> children, String trailing) {
+        /** The JSONML array [tagName, {attributes}?, children...]. */
+        JSONArray array() {
+            JSONArray a = new JSONArray();
+            a.put(name);
+            if (attrs != null) {
+                a.put(new JSONObject(attrs));
+            }
+            for (Tuple2<String, Ml> child : children) {
+                if (child.value1() != null) {
+                    a.put(child.value1());
+                }
+                a.put(child.value2().array());
+            }
+            if (trailing != null) {
+                a.put(trailing);
+            }
+            return a;
+        }
+    }
+
+    static final Generator<Map<String, String>> ATTRS = Gen.<Map<String, String>>maybe(50, null, maps(XML_NAME, ATTR_VALUE).minSize(1).maxSize(3));
+
+    /** A text, or none. */
+    static final Generator<String> TEXT_OR_NONE = Gen.<String>maybe(50, null, XML_TEXT);
+
+    private static final List<Generator<Ml>> ML = new ArrayList<>(List.of(
+            tuples(XML_NAME, ATTRS).map(t -> new Ml(t.value1(), t.value2(), List.of(), null))));
+
+    /** An element up to the given depth; a leaf has no children. */
+    static Generator<Ml> ml(int depth) {
+        while (ML.size() <= depth) {
+            int d = ML.size();
+            ML.add(tuples(XML_NAME, ATTRS, lists(tuples(TEXT_OR_NONE, ml(d - 1))).maxSize(3), TEXT_OR_NONE)
+                    .map(t -> new Ml(t.value1(), t.value2(), t.value3(), t.value4())));
+        }
+        return ML.get(depth);
+    }
+
+    static final Generator<Ml> ML3 = ml(3);
+
+    /** JSONML keeps attribute and text values as strings under keepStrings; the model is the tree itself. */
+    @Test
+    void jsonmlArrayRoundTrips() {
+        Zoo.run("jsonmlArrayRoundTrips", tc -> {
+            JSONArray ml = tc.draw(ML3, "element").array();
+            String xml = JSONML.toString(ml);
+            JSONArray back;
+            try {
+                back = JSONML.toJSONArray(xml, true);
+            } catch (RuntimeException e) {
+                Zoo.fail("JSONML.toJSONArray(JSONML.toString(" + ml + ") = " + Zoo.show(xml) + ") throws " + e);
+                return;
+            }
+            check(Gen.canonical(back).equals(Gen.canonical(ml)), () -> "JSONML array round trip\n array " + ml + "\n xml   " + Zoo.show(xml)
+                    + "\n got   " + back);
+            // the object form of the same XML carries the same tag names, attributes and children
+            JSONObject obj = JSONML.toJSONObject(xml, true);
+            String xml2 = JSONML.toString(obj);
+            JSONArray back2 = JSONML.toJSONArray(xml2, true);
+            check(Gen.canonical(back2).equals(Gen.canonical(ml)), () -> "JSONML via the object form\n array " + ml + "\n xml   " + Zoo.show(xml)
+                    + "\n object " + obj + "\n xml2  " + Zoo.show(xml2) + "\n got   " + back2);
+        });
+    }
+}
diff --git a/hegel/src/test/java/zoo/Gen.java b/hegel/src/test/java/zoo/Gen.java
