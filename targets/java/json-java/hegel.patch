+    /** A copy of the tree without the object members whose value is null (arrays keep their nulls). */
+    static Object withoutNullMembers(Object o) {
+        if (o instanceof JSONObject j) {
+            JSONObject r = new JSONObject();
+            for (String k : j.keySet()) {
