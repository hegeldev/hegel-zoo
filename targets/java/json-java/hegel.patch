+<?xml version="1.0" encoding="UTF-8"?>
+<!-- Hegel zoo: property-based tests for JSON-java (org.json) against the library built from this checkout
+     (`mvn -DskipTests install` at the root first; see targets/java/json-java in the zoo). -->
+<project xmlns="http://maven.apache.org/POM/4.0.0"
+         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
+         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
+  <modelVersion>4.0.0</modelVersion>
+  <groupId>dev.hegel.zoo</groupId>
+  <artifactId>json-java-hegel</artifactId>
+  <version>0</version>
+  <packaging>jar</packaging>
+
+  <properties>
+    <maven.compiler.release>22</maven.compiler.release>
+    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
+    <json.version>20260814</json.version>
+    <hegel.version>0.6.0</hegel.version>
+    <junit.version>5.11.4</junit.version>
+  </properties>
+
+  <dependencies>
+    <dependency>
+      <groupId>org.json</groupId>
+      <artifactId>json</artifactId>
+      <version>${json.version}</version>
+    </dependency>
+    <dependency>
+      <groupId>com.fasterxml.jackson.core</groupId>
+      <artifactId>jackson-databind</artifactId>
+      <version>2.18.2</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>com.google.code.gson</groupId>
+      <artifactId>gson</artifactId>
+      <version>2.11.0</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>dev.hegel</groupId>
+      <artifactId>hegel</artifactId>
+      <version>${hegel.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.jupiter</groupId>
+      <artifactId>junit-jupiter</artifactId>
+      <version>${junit.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.platform</groupId>
+      <artifactId>junit-platform-launcher</artifactId>
+      <version>1.11.4</version>
+      <scope>test</scope>
+    </dependency>
+  </dependencies>
+
+  <build>
+    <plugins>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-compiler-plugin</artifactId>
+        <version>3.13.0</version>
+      </plugin>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-surefire-plugin</artifactId>
+        <version>3.5.2</version>
+        <configuration>
+          <argLine>--enable-native-access=ALL-UNNAMED</argLine>
+          <trimStackTrace>false</trimStackTrace>
+          <!-- every test's `ZOO …` line is what the zoo judges; Maven's exit code is not -->
+          <testFailureIgnore>true</testFailureIgnore>
+        </configuration>
+      </plugin>
+    </plugins>
+  </build>
+</project>
diff --git a/hegel/src/test/java/zoo/ApiTest.java b/hegel/src/test/java/zoo/ApiTest.java
new file mode 100644
index 0000000..5cbbaaf
--- /dev/null
+++ b/hegel/src/test/java/zoo/ApiTest.java
@@ -0,0 +1,414 @@
+package zoo;
+
+import static zoo.Zoo.chance;
+import static zoo.Zoo.check;
+import static zoo.Zoo.count;
+import static zoo.Zoo.n;
+import static zoo.Zoo.pick;
+
+import dev.hegel.TestCase;
+import java.math.BigDecimal;
+import java.math.BigInteger;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+import org.json.JSONParserConfiguration;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Hegel zoo: the Java-side API of org.json — {@code similar} as an equivalence, the parser
+ * configuration's builders, nesting-depth limits, and the collection constructors — against
+ * what the javadoc states.
+ */
+class ApiTest {
+
+    // ------------------------------------------------------------------ similar
+
+    /** Numbers of every supported type over a small set of values, so that equal values meet in different types. */
+    static Number typedNumber(TestCase tc) {
+        BigDecimal v = pick(tc, BigDecimal.ZERO, BigDecimal.ONE, new BigDecimal("-1"), new BigDecimal("0.5"), new BigDecimal("2"), new BigDecimal("1.5"),
+                new BigDecimal("100"), new BigDecimal("9007199254740993"), new BigDecimal("0.1"));
+        switch (n(tc, 0, 6)) {
+            case 0:
+                return v.scale() <= 0 && v.abs().compareTo(new BigDecimal(Integer.MAX_VALUE)) <= 0 ? v.intValueExact() : v;
+            case 1:
+                return v.scale() <= 0 && v.abs().compareTo(new BigDecimal(Long.MAX_VALUE)) <= 0 ? v.longValueExact() : v;
+            case 2:
+                return v.scale() <= 0 ? v.toBigIntegerExact() : v;
+            case 3:
+                return v.doubleValue() == 0 && chance(tc, 50) ? -0.0 : v.doubleValue();
+            case 4:
+                return v.floatValue() == 0 && chance(tc, 50) ? -0.0f : v.floatValue();
+            case 5:
+                return v.setScale(v.scale() + n(tc, 0, 3));
+            default:
+                return v;
+        }
+    }
+
+    /** A value for similar: scalars of mixed numeric types, nested containers. */
+    static Object value(TestCase tc, int depth) {
+        if (depth <= 0 || chance(tc, 50)) {
+            switch (n(tc, 0, 3)) {
+                case 0:
+                    return typedNumber(tc);
+                case 1:
+                    return pick(tc, "a", "b", "1", "");
+                case 2:
+                    return pick(tc, JSONObject.NULL, Boolean.TRUE, Boolean.FALSE);
+                default:
+                    return typedNumber(tc);
+            }
+        }
+        if (chance(tc, 50)) {
+            JSONObject o = new JSONObject();
+            int size = n(tc, 0, 3);
+            for (int i = 0; i < size; i++) {
+                o.put(pick(tc, "k", "l", "m"), value(tc, depth - 1));
+            }
+            return o;
+        }
+        JSONArray a = new JSONArray();
+        int size = n(tc, 0, 3);
+        for (int i = 0; i < size; i++) {
+            a.put(value(tc, depth - 1));
+        }
+        return a;
+    }
+
+    /** The model of similar: same shape, same keys, numbers by value (all finite here), strings and booleans by equals. */
+    static boolean modelSimilar(Object a, Object b) {
+        if (Gen.isNull(a) || Gen.isNull(b)) {
+            return Gen.isNull(a) && Gen.isNull(b);
+        }
+        if (a instanceof Number x && b instanceof Number y) {
+            return numberSimilar(x, y);
+        }
+        if (a instanceof JSONObject o && b instanceof JSONObject p) {
+            if (!o.keySet().equals(p.keySet())) {
+                return false;
+            }
+            for (String k : o.keySet()) {
+                if (!modelSimilar(o.opt(k), p.opt(k))) {
+                    return false;
+                }
+            }
+            return true;
+        }
+        if (a instanceof JSONArray o && b instanceof JSONArray p) {
+            if (o.length() != p.length()) {
+                return false;
+            }
+            for (int i = 0; i < o.length(); i++) {
+                if (!modelSimilar(o.opt(i), p.opt(i))) {
+                    return false;
+                }
+            }
+            return true;
+        }
+        return a.getClass() == b.getClass() && a.equals(b);
+    }
+
+    /** isNumberSimilar's documented algorithm: the same type compares with compareTo (so 0.0 and -0.0 differ), otherwise by BigDecimal value. */
+    @SuppressWarnings({"rawtypes", "unchecked"})
+    static boolean numberSimilar(Number x, Number y) {
+        if (x.getClass() == y.getClass() && x instanceof Comparable c) {
+            return c.compareTo(y) == 0;
+        }
+        return Gen.exact(x).compareTo(Gen.exact(y)) == 0;
+    }
+
+    static boolean similar(Object a, Object b) {
+        if (a instanceof JSONObject o) {
+            return o.similar(b);
+        }
+        return ((JSONArray) a).similar(b);
+    }
+
+    @Test
+    void similarIsValueEqualityUpToNumberType() {
+        Zoo.run("similarIsValueEqualityUpToNumberType", tc -> {
+            // wrap scalars in arrays so that similar applies
+            Object a = new JSONArray().put(value(tc, 2));
+            Object b = chance(tc, 50) ? new JSONArray().put(value(tc, 2)) : new JSONArray(a.toString());
+            boolean want = modelSimilar(a, b);
+            boolean got = similar(a, b);
+            boolean got2 = similar(b, a);
+            count(want ? "similar" : "different");
+            check(got == want, () -> a + ".similar(" + b + ") = " + got + ", want " + want + " (" + Zoo.show(((JSONArray) a).opt(0)) + " vs " + Zoo.show(((JSONArray) b).opt(0)) + ")");
+            check(got == got2, () -> "similar is not symmetric: " + a + " vs " + b + ": " + got + " / " + got2);
+            check(similar(a, a), () -> "similar is not reflexive on " + a);
+        });
+    }
+
+    /** Pairs of typed numbers over a few values, so that -0.0f meets 0.0f, 1 meets 1.0 and 1.00, and so on. */
+    @Test
+    void similarOnNumberPairsIsValueEquality() {
+        Zoo.run("similarOnNumberPairsIsValueEquality", tc -> {
+            Number x = typedNumber(tc);
+            Number y = chance(tc, 50) ? typedNumber(tc) : sameValueOtherType(tc, x);
+            boolean want = numberSimilar(x, y);
+            JSONArray a = new JSONArray().put(x);
+            JSONArray b = new JSONArray().put(y);
+            boolean got = a.similar(b);
+            count(want ? "equal values" : "different values");
+            check(got == want, () -> "[" + Zoo.show(x) + "].similar([" + Zoo.show(y) + "]) = " + got + ", want " + want);
+            check(got == b.similar(a), () -> "similar is not symmetric for " + Zoo.show(x) + " and " + Zoo.show(y));
+            JSONObject o = new JSONObject().put("k", x);
+            check(o.similar(new JSONObject().put("k", y)) == want, () -> "JSONObject.similar differs from JSONArray.similar for " + Zoo.show(x) + " and " + Zoo.show(y));
+        });
+    }
+
+    static Number sameValueOtherType(TestCase tc, Number x) {
+        BigDecimal v = Gen.exact(x);
+        switch (n(tc, 0, 5)) {
+            case 0:
+                return v.doubleValue() == 0 && chance(tc, 50) ? -0.0 : v.doubleValue();
+            case 1:
+                return v.floatValue() == 0 && chance(tc, 50) ? -0.0f : v.floatValue();
+            case 2:
+                return v.setScale(v.scale() + n(tc, 1, 3));
+            case 3:
+                return v.scale() <= 0 && v.abs().compareTo(new BigDecimal(Long.MAX_VALUE)) <= 0 ? v.longValueExact() : v;
+            case 4:
+                return v.scale() <= 0 ? v.toBigIntegerExact() : v;
+            default:
+                return v;
+        }
+    }
+
+    @Test
+    void similarSurvivesAToStringRoundTrip() {
+        Zoo.run("similarSurvivesAToStringRoundTrip", tc -> {
+            Object a = chance(tc, 50) ? new JSONArray().put(value(tc, 3)) : new JSONObject().put("k", value(tc, 3));
+            String text = a.toString();
+            Object back = a instanceof JSONObject ? new JSONObject(text) : new JSONArray(text);
+            check(similar(a, back), () -> a + " is not similar to its re-parsed toString " + text);
+            check(similar(back, a), () -> "re-parsed " + text + " is not similar to the original " + a);
+        });
+    }
+
+    // ------------------------------------------------------------------ parser configuration
+
+    @Test
+    void parserConfigurationBuildersAreOrderIndependentAndLossless() {
+        Zoo.run("parserConfigurationBuildersAreOrderIndependentAndLossless", tc -> {
+            boolean keepStrings = chance(tc, 50);
+            int depth = pick(tc, 1, 5, 512, 1000, -1);
+            int numLen = pick(tc, 3, 10, 1000, -1);
+            boolean overwrite = chance(tc, 50);
+            boolean nativeNulls = chance(tc, 50);
+            boolean strict = chance(tc, 50);
+            List<java.util.function.UnaryOperator<JSONParserConfiguration>> steps = new ArrayList<>(List.of(
+                    c -> c.withKeepStrings(keepStrings), c -> c.withMaxNestingDepth(depth), c -> c.withMaxNumberLength(numLen),
+                    c -> c.withOverwriteDuplicateKey(overwrite), c -> c.withUseNativeNulls(nativeNulls), c -> c.withStrictMode(strict)));
+            List<java.util.function.UnaryOperator<JSONParserConfiguration>> order = new ArrayList<>();
+            while (!steps.isEmpty()) {
+                order.add(steps.remove(n(tc, 0, steps.size() - 1)));
+            }
+            JSONParserConfiguration c = new JSONParserConfiguration();
+            for (var step : order) {
+                c = step.apply(c);
+            }
+            String got = "keepStrings=" + c.isKeepStrings() + " maxNestingDepth=" + c.getMaxNestingDepth() + " maxNumberLength=" + c.getMaxNumberLength()
+                    + " overwriteDuplicateKey=" + c.isOverwriteDuplicateKey() + " useNativeNulls=" + c.isUseNativeNulls() + " strictMode=" + c.isStrictMode();
+            String want = "keepStrings=" + keepStrings + " maxNestingDepth=" + depth + " maxNumberLength=" + numLen
+                    + " overwriteDuplicateKey=" + overwrite + " useNativeNulls=" + nativeNulls + " strictMode=" + strict;
+            check(got.equals(want), () -> "JSONParserConfiguration after the builder calls\n want " + want + "\n got  " + got);
+        });
+    }
+
+    @Test
+    void maxNumberLengthAppliesToParsedNumbers() {
+        Zoo.run("maxNumberLengthAppliesToParsedNumbers", tc -> {
+            int limit = n(tc, 1, 12);
+            int digits = n(tc, 1, 16);
+            String num = "1" + "0".repeat(digits - 1);
+            JSONParserConfiguration cfg = new JSONParserConfiguration().withMaxNumberLength(limit);
+            Object v = new JSONArray("[" + num + "]", cfg).get(0);
+            // documented: a number text longer than the limit is kept as a string
+            boolean wantString = digits > limit;
+            check((v instanceof String) == wantString, () -> "[" + num + "] with maxNumberLength " + limit + " parses to " + Zoo.show(v));
+        });
+    }
+
+    // ------------------------------------------------------------------ nesting depth
+
+    @Test
+    void nestingDepthLimitIsEnforcedForText() {
+        Zoo.run("nestingDepthLimitIsEnforcedForText", tc -> {
+            int limit = n(tc, 1, 40);
+            int depth = n(tc, 1, 60);
+            boolean arrays = chance(tc, 50);
+            String text = (arrays ? "[" : "{\"k\":").repeat(depth) + "1" + (arrays ? "]" : "}").repeat(depth);
+            JSONParserConfiguration cfg = new JSONParserConfiguration().withMaxNestingDepth(limit);
+            Object got;
+            try {
+                got = arrays ? new JSONArray(text, cfg) : new JSONObject(text, cfg);
+            } catch (JSONException e) {
+                got = e;
+            }
+            Object g = got;
+            // the javadoc: the parser throws a JSONException when the maximum depth is reached
+            if (depth > limit) {
+                count("beyond the limit");
+                check(g instanceof JSONException, () -> "depth " + depth + " parsed with maxNestingDepth " + limit + ": no exception");
+            } else {
+                count("within the limit");
+                check(!(g instanceof JSONException), () -> "depth " + depth + " rejected with maxNestingDepth " + limit + ": " + g);
+            }
+        });
+    }
+
+    @Test
+    void negativeNestingDepthMeansNoLimit() {
+        Zoo.run("negativeNestingDepthMeansNoLimit", tc -> {
+            int depth = n(tc, 1, 30);
+            Object nested = 1;
+            for (int i = 0; i < depth; i++) {
+                nested = chance(tc, 50) ? Map.of("k", nested) : List.of(nested);
+            }
+            JSONParserConfiguration cfg = new JSONParserConfiguration().withMaxNestingDepth(-n(tc, 1, 5));
+            Object got;
+            try {
+                got = nested instanceof Map<?, ?> m ? new JSONObject(m, cfg) : new JSONArray((List<?>) nested, cfg);
+            } catch (JSONException e) {
+                got = e;
+            }
+            Object g = got;
+            check(!(g instanceof JSONException), () -> "a negative maxNestingDepth (documented: no limit) rejects depth " + depth + ": " + g);
+            if (!(g instanceof JSONException)) {
+                check(Gen.canonical(g).equals(Gen.canonical(JSONObject.wrap(nested))), () -> "value changed: " + g);
+            }
+        });
+    }
+
+    // ------------------------------------------------------------------ collections
+
+    @Test
+    void collectionConstructorAndPutAllAgree() {
+        Zoo.run("collectionConstructorAndPutAllAgree", tc -> {
+            List<Object> items = new ArrayList<>();
+            int size = n(tc, 0, 4);
+            for (int i = 0; i < size; i++) {
+                switch (n(tc, 0, 4)) {
+                    case 0:
+                        items.add(Gen.scalar(tc));
+                        break;
+                    case 1: {
+                        Map<String, Object> m = new LinkedHashMap<>();
+                        m.put("a", Gen.scalar(tc));
+                        items.add(m);
+                        break;
+                    }
+                    case 2:
+                        items.add(Arrays.asList(Gen.scalar(tc), Gen.scalar(tc)));
+                        break;
+                    case 3:
+                        items.add(new JSONArray().put(n(tc, 0, 9)));
+                        break;
+                    default:
+                        items.add(null);
+                }
+            }
+            JSONArray a = new JSONArray(items);
+            JSONArray b = new JSONArray().putAll(items);
+            JSONArray c = new JSONArray().putAll(a);
+            // NOTES.md: putAll does not wrap its items (a Map stays a Map), so only the values are compared, not similar()
+            String wa = a.toString();
+            check(Gen.canonical(a).equals(Gen.canonical(b)), () -> "new JSONArray(items) = " + wa + " differs in value from new JSONArray().putAll(items) = " + b);
+            check(a.similar(c) && c.similar(a), () -> "putAll(JSONArray) copy " + c + " differs from " + wa);
+            check(a.toString().equals(b.toString()), () -> "toString differs: " + wa + " vs " + b);
+        });
+    }
+
+    @Test
+    void putAtIndexPadsWithNull() {
+        Zoo.run("putAtIndexPadsWithNull", tc -> {
+            JSONArray a = new JSONArray();
+            List<Object> model = new ArrayList<>();
+            int ops = n(tc, 1, 6);
+            for (int i = 0; i < ops; i++) {
+                int idx = n(tc, 0, 6);
+                Object v = Gen.scalar(tc);
+                a.put(idx, v);
+                while (model.size() <= idx) {
+                    model.add(JSONObject.NULL);
+                }
+                model.set(idx, v);
+            }
+            String want = Gen.canonical(model);
+            check(Gen.canonical(a).equals(want), () -> "put(index, value) sequence gives " + a + ", want " + want);
+            // remove returns the element and shifts, or null out of range
+            int idx = n(tc, 0, 8);
+            Object removed = a.remove(idx);
+            Object wantRemoved = idx < model.size() ? model.remove(idx) : null;
+            check(removed == wantRemoved || removed != null && removed.equals(wantRemoved), () -> "remove(" + idx + ") returned " + Zoo.show(removed) + ", want " + Zoo.show(wantRemoved));
+            check(Gen.canonical(a).equals(Gen.canonical(model)), () -> "after remove(" + idx + "): " + a + ", want " + Gen.canonical(model));
+        });
+    }
+
+    @Test
+    void incrementAndAccumulateFollowTheirModels() {
+        Zoo.run("incrementAndAccumulateFollowTheirModels", tc -> {
+            JSONObject o = new JSONObject();
+            // increment: absent -> 1, then +1 keeping the type as documented (Integer, Long, BigInteger, Double, Float, BigDecimal)
+            Number start = pick(tc, 0, 5, Integer.MAX_VALUE, 7L, Long.MAX_VALUE, BigInteger.TEN, 1.5, 2.5f, new BigDecimal("1.25"));
+            if (chance(tc, 30)) {
+                o.put("n", start);
+            }
+            int times = n(tc, 1, 4);
+            for (int i = 0; i < times; i++) {
+                o.increment("n");
+            }
+            BigDecimal want = (o.has("n") && start != null && chance(tc, 0) ? null : null) == null && !(o.opt("n") instanceof Number) ? null : null;
+            Number got = (Number) o.get("n");
+            BigDecimal expected;
+            if (!(start instanceof Number) || !hadStart(o, start, times)) {
+                expected = BigDecimal.valueOf(times);
+            } else {
+                expected = Gen.exact(start).add(BigDecimal.valueOf(times));
+            }
+            // the documented no-overflow-check: Integer.MAX_VALUE + 1 wraps
+            if (start instanceof Integer s && hadStart(o, start, times) && (long) s + times > Integer.MAX_VALUE) {
+                expected = BigDecimal.valueOf((int) (s + times));
+            }
+            if (start instanceof Long s && hadStart(o, start, times) && s > Long.MAX_VALUE - times) {
+                expected = BigDecimal.valueOf(s + times);
+            }
+            BigDecimal e = expected;
+            check(Gen.exact(got).compareTo(e) == 0, () -> "increment " + times + " times from " + Zoo.show(start) + " gives " + Zoo.show(got) + ", want " + e);
+            // accumulate: first value is put, further values make an array
+            JSONObject acc = new JSONObject();
+            List<Object> values = new ArrayList<>();
+            int k = n(tc, 1, 4);
+            for (int i = 0; i < k; i++) {
+                Object v = Gen.scalar(tc);
+                values.add(v);
+                acc.accumulate("k", v);
+            }
+            Object wantAcc = k == 1 ? values.get(0) : new JSONArray(values);
+            check(Gen.canonical(acc.opt("k")).equals(Gen.canonical(wantAcc)), () -> "accumulate " + values + " gives " + acc.opt("k"));
+            // append always makes an array
+            JSONObject app = new JSONObject();
+            for (Object v : values) {
+                app.append("k", v);
+            }
+            check(Gen.canonical(app.opt("k")).equals(Gen.canonical(new JSONArray(values))), () -> "append " + values + " gives " + app.opt("k"));
+        });
+    }
+
+    /** Whether the object held the start value before the increments (it was put with 30% chance; detect from the result type). */
+    static boolean hadStart(JSONObject o, Number start, int times) {
+        Object v = o.opt("n");
+        if (start instanceof Integer || start instanceof Long || start instanceof BigInteger) {
+            return !(v instanceof Integer) || start instanceof Integer && !Gen.exact((Number) v).equals(BigDecimal.valueOf(times));
+        }
+        return v.getClass() == start.getClass();
+    }
+}
diff --git a/hegel/src/test/java/zoo/ConvertersTest.java b/hegel/src/test/java/zoo/ConvertersTest.java
new file mode 100644
index 0000000..4a8c2e3
--- /dev/null
+++ b/hegel/src/test/java/zoo/ConvertersTest.java
@@ -0,0 +1,331 @@
+package zoo;
+
+import static zoo.Zoo.chance;
+import static zoo.Zoo.check;
+import static zoo.Zoo.count;
+import static zoo.Zoo.n;
+import static zoo.Zoo.pick;
+
+import dev.hegel.TestCase;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+import org.json.CDL;
+import org.json.Cookie;
+import org.json.CookieList;
+import org.json.HTTP;
+import org.json.JSONArray;
+import org.json.JSONML;
+import org.json.JSONObject;
+import org.json.JSONTokener;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Hegel zoo: the text converters of org.json (CDL, Cookie, CookieList, HTTP, JSONML) against
+ * the round trips their javadoc describes.
+ */
+class ConvertersTest {
+
+    // ------------------------------------------------------------------ CDL
+
+    /** Printable ASCII plus a few non-ASCII letters and the characters CDL treats specially. */
+    static final String CDL_CHARS = "abcXYZ019 _-.:;'\"\\,\t\n\r\u00e9\u4e2d";
+
+    static String cdlValue(TestCase tc) {
+        return Zoo.word(tc, CDL_CHARS, 0, 8);
+    }
+
+    /** CDL's javadoc: a value may contain any character except the delimiter unless quoted; the writer quotes those. */
+    static boolean cdlSafe(String v, char delim) {
+        if (v.isEmpty()) {
+            return true;
+        }
