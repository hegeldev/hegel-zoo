+pin("TestHegelPinSetQuarter", () => {
+  // luxon/2: set({quarter: n}) moves to that quarter (or throws like set({weeks: n}) does)
+  const dt = DateTime.fromISO("2026-02-15T00:28", { zone: "UTC" });
+  assert.equal(dt.quarter, 1);
+  const moved = dt.set({ quarter: 2 });
+  assert.notEqual(moved.toISO(), dt.toISO(), "set({quarter: 2}) is a silent no-op");
+  assert.equal(moved.quarter, 2);
+});
+
+pin("TestHegelPinIsoOffsetWithZoneAnnotation", () => {
+  // luxon/3: the offset of an ISO string decides the instant even when a bracketed zone follows
+  const a = DateTime.fromISO("2020-11-01T01:30:00-05:00[America/New_York]", { setZone: true });
+  assert.equal(a.toUTC().toISO(), "2020-11-01T06:30:00.000Z");
+  assert.equal(a.zoneName, "America/New_York");
+  const b = DateTime.fromISO("2020-06-01T12:00:00Z[America/New_York]", { setZone: true });
+  assert.equal(b.toUTC().toISO(), "2020-06-01T12:00:00.000Z");
+});
