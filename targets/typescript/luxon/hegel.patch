@@ -0,0 +1,1153 @@
+// Hegel zoo: Luxon against Temporal and against itself.
+//
+// Luxon is "a powerful, modern, and friendly wrapper for JavaScript dates and times": immutable
+// DateTimes in IANA zones (offsets read from Intl), Durations with casual or long-term unit
+// conversion, and Intervals. The properties below check it three ways:
+//
+//  * differentially against Temporal (the @js-temporal/polyfill, 0.5.1), which reads zone data
+//    from the same Intl/ICU as Luxon, so the two agree on every offset: calendar fields, ISO
+//    renderings, zone changes and the calendar/time arithmetic Luxon's docs describe (calendar
+//    units keep the wall clock, time units are exact, gaps push forward);
+//  * against Luxon's own documented laws: diff/plus inversion, Duration conversions preserving
+//    the total, parse(format(x)) round trips for ISO/RFC 2822/HTTP/SQL and fromFormat/toFormat;
+//  * against a brute-force model of half-open intervals for the Interval algebra.
+//
+// Where a wall time is ambiguous (a repeated hour) Luxon documents its choice as undefined, so
+// only the wall clock is checked and either offset is accepted. Other documented differences are
+// skipped through `Accepted` (README), bugs through `Known` and pinned at the end.
+import assert from "node:assert/strict";
+import { createRequire } from "node:module";
+import { property, pin, fail, count, n, pick, chance } from "./hegel-zoo.mjs";
+
+const require = createRequire(import.meta.url);
+const { Temporal } = require("../.hegel/node_modules/@js-temporal/polyfill");
+const { DateTime, Duration, Interval, Info, Settings, IANAZone, FixedOffsetZone } = await import("../src/luxon.js");
+
+// ---------------------------------------------------------------------------------------------
+// Known bugs (each has a pin below) and accepted differences (README).
+const Known = {
+  // luxon/1: toISOWeekDate() does not expand years outside 0000–9999 ("-0007-W22-6", "10000-W23-1"),
+  // unlike toISODate(), and fromISO() cannot read the result
+  weekDateYear: true,
+  // luxon/2: set({quarter: n}) is silently ignored (quarter is a getter and a unit of startOf/plus/diff;
+  // other unknown units throw InvalidUnitError)
+  setQuarter: true,
+  // luxon/3: fromISO() discards the offset of a string that also carries a bracketed IANA zone
+  // ("2020-11-01T01:30:00-05:00[America/New_York]" is 01:30-04:00, "…T12:00:00Z[America/New_York]"
+  // is 12:00-04:00): the zone extractor replaces the fixed-offset zone and the offset is not kept
+  isoOffsetWithZone: true,
+  // luxon/4: a wall time within a day after a transition in a zone whose current offset is many hours
+  // from its offset then (Pacific/Apia before its 2011 date-line move: -11 then, +13 now) is taken for
+  // a gap and pushed forward an hour by fromObject/fromISO/fromFormat/fromSQL/local: fixOffset starts
+  // from the zone's offset *now* and its two corrections both land on the other side of the transition
+  staleOffsetGuess: true,
+  // luxon/5: splitAt() with a cut equal to the start, or with duplicate cuts, returns empty intervals
+  splitAtEmptyPieces: true,
+  // luxon/6: the narrow offset format (token Z, FixedOffsetZone names) leaves single-digit minutes
+  // unpadded: "+5:5" for +05:05, "UTC+0:9" as a zone name that the zone parser then rejects
+  narrowOffsetMinutes: true,
+  // luxon/7: shiftTo/normalize leave a lower unit with the opposite sign when its magnitude is below one
+  // ({ minutes: 1, seconds: -0.5 }.normalize() is unchanged; { hours: -75, seconds: 26 }.shiftTo("hours",
+  // "minutes") is { hours: -75, minutes: 0.43 }): the borrow rounds |v| < 1 down to nothing
+  mixedSignFraction: true,
+  // luxon/8: set() does not validate: set({day: 31}) in November is December 1st, set({weekNumber: 53})
+  // in a 52-week year is week 1 of the next week-year, set({hour: 25}) is 01:00 the next day, while
+  // fromObject with the same values is invalid
+  setOverflow: true,
+  // luxon/9: fromFormat() with both a quarter (q) and a month token sets the month from the quarter
+  // ("2020-03-08 q1" with "yyyy-MM-dd 'q'q" is January 8th)
+  quarterOverridesMonth: true,
+  // luxon/10: with conversionAccuracy "longterm", shiftTo leaves fractional intermediate units when a
+  // lower unit overflows into a larger one ({ days: 400 }.shiftTo("years", "days", "hours") has fractional
+  // days): the overflow pass runs after the pass that pushes fractions down to the lowest unit
+  longtermFraction: true,
+};
+const Accepted = {
+  ambiguous: true, // a repeated wall time resolves to either occurrence (documented as undefined)
+  casualFraction: true, // fractional calendar units are converted casually (1.5 months = 1 month + 15 days)
+  dateLimit: true, // results within a day of the ±8.64e15 ms Date limits
+  floatUnit: true, // the fractional lowest unit of a diff is compared to 9 significant digits
+  subMillisecondSplit: true, // divideEqually of an interval not divisible by n yields sub-millisecond pieces
+  emptyIntervals: true, // overlaps/merge/xor/splitAt treat an empty interval as a point (README)
+  casualMatrix: true, // casual conversions between years, quarters, months and weeks do not preserve the total (documented: 12 * 30 != 365)
+};
+
+// ---------------------------------------------------------------------------------------------
+// Zones and instants.
+const CURATED = ["UTC", "Europe/London", "Europe/Paris", "America/New_York", "America/Whitehorse", "Pacific/Auckland", "America/Santiago", "Australia/Lord_Howe", "Asia/Tehran", "America/Sao_Paulo", "Pacific/Apia", "Asia/Kolkata", "Africa/Casablanca", "America/Havana", "Asia/Gaza", "Europe/Moscow", "Pacific/Chatham", "America/St_Johns", "Asia/Kathmandu", "Antarctica/Troll", "Africa/Cairo"];
+const ALL_ZONES = Intl.supportedValuesOf("timeZone");
+function genZone(tc) {
+  const zone = chance(tc, 75) ? pick(tc, CURATED) : pick(tc, ALL_ZONES);
+  count(`zone=${zone === "UTC" ? "UTC" : zone.split("/")[0]}`);
+  return zone;
+}
+const MAX_TS = 8.64e15;
+const zdtAt = (t, zone) => Temporal.Instant.fromEpochMilliseconds(t).toZonedDateTimeISO(zone);
+const EDGES = [0, -1, 1, 951782400000, 951868799999, 4102444800000, -2208988800000, 253402300799999, -62135596800000, -62167219200000, 1e12, -1e12, 8639999999999999, -8639999999999999];
+/** A UTC timestamp in `zone`: near one of the zone's transitions, an edge, or random. */
+function genInstant(tc, zone) {
+  const r = n(tc, 0, 99);
+  let y = n(tc, 1900, 2100);
+  if (r >= 90) y = n(tc, -1000, 3000);
+  if (r >= 97) y = n(tc, -200000, 200000);
+  const d = new Date(Date.UTC(2000, n(tc, 0, 11), n(tc, 1, 31), n(tc, 0, 23), n(tc, 0, 59), n(tc, 0, 59), n(tc, 0, 999)));
+  d.setUTCFullYear(y);
+  let t = d.getTime();
+  if (r < 45) {
+    // the next transition of the zone after a random instant, plus or minus a few hours
+    const next = zdtAt(t, zone).getTimeZoneTransition("next");
+    if (next) {
+      t = next.epochMilliseconds + n(tc, -180, 180) * 60000 + (chance(tc, 30) ? n(tc, 0, 59999) : 0);
+      count("near-transition");
+    }
+  } else if (r < 50) t = pick(tc, EDGES);
+  return t;
+}
+const nearLimit = (...ts) => ts.some((t) => !Number.isFinite(t) || Math.abs(t) > MAX_TS - 86400000 * 2);
+
+// ---------------------------------------------------------------------------------------------
+// Rendering helpers shared with the models.
+const pad = (v, w = 2) => String(Math.abs(v)).padStart(w, "0");
+const isoYear = (y) => (y >= 0 && y <= 9999 ? pad(y, 4) : `${y < 0 ? "-" : "+"}${pad(y, 6)}`);
+/** Luxon's offset rendering: sign, whole hours, whole minutes (seconds dropped). */
+function offsetString(offMinutes, style = "short") {
+  const sign = offMinutes < 0 ? "-" : "+";
+  const hh = pad(Math.trunc(Math.abs(offMinutes / 60)));
+  const mm = pad(Math.trunc(Math.abs(offMinutes % 60)));
+  if (style === "narrow") return `${sign}${Math.trunc(Math.abs(offMinutes / 60))}${mm === "00" ? "" : `:${mm}`}`;
+  if (style === "techie") return `${sign}${hh}${mm}`;
+  return `${sign}${hh}:${mm}`;
+}
+const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
+const WEEKDAYS = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
+const WEEKDAYS_LONG = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];
+const MONTHS_LONG = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
+/** The fields Luxon and Temporal share, from a Temporal ZonedDateTime. */
+function fieldsOf(z) {
+  return {
+    year: z.year,
+    month: z.month,
+    day: z.day,
+    hour: z.hour,
+    minute: z.minute,
+    second: z.second,
+    millisecond: z.millisecond,
+    offset: z.offsetNanoseconds / 6e10,
+    weekday: z.dayOfWeek,
+    weekNumber: z.weekOfYear,
+    weekYear: z.yearOfWeek,
+    ordinal: z.dayOfYear,
+    daysInMonth: z.daysInMonth,
+    daysInYear: z.daysInYear,
+    isInLeapYear: z.inLeapYear,
+    quarter: Math.ceil(z.month / 3),
+  };
+}
+const luxonFields = (dt) => ({
+  year: dt.year,
+  month: dt.month,
+  day: dt.day,
+  hour: dt.hour,
+  minute: dt.minute,
+  second: dt.second,
+  millisecond: dt.millisecond,
+  offset: dt.offset,
+  weekday: dt.weekday,
+  weekNumber: dt.weekNumber,
+  weekYear: dt.weekYear,
+  ordinal: dt.ordinal,
+  daysInMonth: dt.daysInMonth,
+  daysInYear: dt.daysInYear,
+  isInLeapYear: dt.isInLeapYear,
+  quarter: dt.quarter,
+});
+const show = (x) => JSON.stringify(x, (k, v) => (typeof v === "bigint" ? `${v}n` : v && typeof v === "object" && !Array.isArray(v) ? Object.fromEntries(Object.keys(v).sort().map((kk) => [kk, v[kk]])) : v));
+function expectEqual(what, actual, expected) {
+  if (show(actual) !== show(expected)) fail(`${what}\n  luxon:    ${show(actual)}\n  expected: ${show(expected)}`);
+}
+/** The wall-clock fields of a Temporal ZonedDateTime as a plain object for ZonedDateTime.from. */
+const wallOf = (z) => ({ year: z.year, month: z.month, day: z.day, hour: z.hour, minute: z.minute, second: z.second, millisecond: z.millisecond });
+/**
+ * Luxon's resolution of a wall time: keep `guess` (an offset in minutes) if the zone allows it,
+ * otherwise the zone's offset; a gap pushes forward (fixOffset). Returns the ZonedDateTime.
+ */
+function resolve(wall, zone, guessMinutes) {
+  const offset = guessMinutes === undefined ? undefined : offsetSeconds(guessMinutes);
+  return Temporal.ZonedDateTime.from({ ...wall, timeZone: zone, ...(offset === undefined ? {} : { offset }) }, { offset: "prefer", disambiguation: "compatible", overflow: "reject" });
+}
+/** An offset in minutes (possibly fractional, before 1900) as Temporal's ±HH:MM:SS. */
+function offsetSeconds(offMinutes) {
+  const total = Math.round(Math.abs(offMinutes) * 60);
+  const sign = offMinutes < 0 ? "-" : "+";
+  return `${sign}${pad(Math.floor(total / 3600))}:${pad(Math.floor((total % 3600) / 60))}:${pad(total % 60)}`;
+}
+/** Is the wall time `wall` in `zone` ambiguous (two instants) or a gap (none)? */
+function wallKind(wall, zone) {
+  const earlier = Temporal.ZonedDateTime.from({ ...wall, timeZone: zone }, { disambiguation: "earlier", overflow: "reject" });
+  const later = Temporal.ZonedDateTime.from({ ...wall, timeZone: zone }, { disambiguation: "later", overflow: "reject" });
+  if (earlier.epochMilliseconds === later.epochMilliseconds) return { kind: "unique", instants: [earlier.epochMilliseconds] };
+  if (Temporal.PlainDateTime.compare(earlier.toPlainDateTime(), later.toPlainDateTime()) === 0) return { kind: "ambiguous", instants: [earlier.epochMilliseconds, later.epochMilliseconds] };
+  return { kind: "gap", instants: [] };
+}
+const offsetAt = (t, zone) => zdtAt(t, zone).offsetNanoseconds / 6e10;
+/** Luxon's fixOffset for a fresh wall time (guess: the zone's offset now); returns the verdict. */
+function luxonFixOffset(wall, zone) {
+  const localTS = Temporal.PlainDateTime.from(wall).toZonedDateTime("UTC").epochMilliseconds;
+  const o = offsetAt(Date.now(), zone);
+  let utcGuess = localTS - o * 60000;
+  const o2 = offsetAt(utcGuess, zone);
+  if (o === o2) return { ms: utcGuess, hole: false };
+  utcGuess -= (o2 - o) * 60000;
+  const o3 = offsetAt(utcGuess, zone);
+  if (o2 === o3) return { ms: utcGuess, hole: false };
+  return { ms: localTS - Math.min(o2, o3) * 60000, hole: true };
+}
+/** Does luxon/4 fire for this wall time: fixOffset says "hole" although the wall time exists? */
+const staleMisfire = (wall, zone) => luxonFixOffset(wall, zone).hole && wallKind(wall, zone).kind !== "gap";
+/** luxon/6: does the narrow rendering of this offset have a single-digit minute part? */
+const narrowMinutes = (offMinutes) => Math.abs(Math.trunc(offMinutes)) % 60 > 0 && Math.abs(Math.trunc(offMinutes)) % 60 < 10;
+/**
+ * A fresh DateTime built from a wall time in `zone` (no offset): the instant must be one of the wall
+ * time's instants, or the gap resolution (forward) with wasHole set.
+ */
+function expectWall(what, dt, wall, zone, { checkHole = true } = {}) {
+  if (!dt.isValid) return fail(`${what}: invalid (${dt.invalidReason}: ${dt.invalidExplanation})`);
+  const k = wallKind(wall, zone);
+  if (k.instants.some((i) => !Number.isInteger(offsetAt(i, zone)))) checkHole = false; // offsets with seconds: fixOffset compares fractional minutes
+  const stale = Known.staleOffsetGuess && k.kind !== "gap" && staleMisfire(wall, zone);
+  if (stale) checkHole = false; // luxon/4 may reach the right instant through its "hole" branch, with wasHole set
+  if (k.kind === "gap") {
+    const expected = resolve(wall, zone);
+    if (dt.toMillis() !== expected.epochMilliseconds) return fail(`${what} in a gap: ${dt.toISO()} (${dt.toMillis()}), expected ${expected.toString()}`);
+    if (checkHole && dt.wasHole !== true) return fail(`${what} in a gap: wasHole is ${dt.wasHole}`);
+    return;
+  }
+  if (k.instants.includes(dt.toMillis())) {
+    if (checkHole && dt.wasHole) fail(`${what}: wasHole is true for an existing wall time ${dt.toISO()}`);
+    if (k.kind === "ambiguous") count("ambiguous-wall");
+    return;
+  }
+  if (stale) return count("known-stale-offset-guess");
+  fail(`${what} = ${dt.toISO()} (${dt.toMillis()}), expected one of ${k.instants} (${k.kind})`);
+}
+/**
+ * Compare a Luxon result with the expected ZonedDateTime; where the wall time is ambiguous the
+ * other occurrence is accepted too (documented as undefined).
+ */
+function expectInstant(what, dt, expected, zone) {
+  if (!dt.isValid) return fail(`${what}: invalid (${dt.invalidReason}: ${dt.invalidExplanation}); expected ${expected.toString()}`);
+  const expectedOffset = expected.offsetNanoseconds / 6e10;
+  if (dt.toMillis() === expected.epochMilliseconds && (dt.offset === expectedOffset || (!Number.isInteger(expectedOffset) && Math.abs(dt.offset - expectedOffset) < 1))) return;
+  if (Accepted.ambiguous) {
+    const k = wallKind(wallOf(expected), zone);
+    if (k.kind === "ambiguous" && k.instants.includes(dt.toMillis())) {
+      count("accepted-ambiguous");
+      return;
+    }
+  }
+  fail(`${what}\n  luxon:    ${dt.toISO()} (${dt.toMillis()})\n  expected: ${expected.toString()} (${expected.epochMilliseconds})`);
+}
+
+// ---------------------------------------------------------------------------------------------
+// Fields, renderings and zone changes against Temporal.
+property("TestHegelFieldsLikeTemporal", (tc) => {
+  const zone = genZone(tc);
+  const t = genInstant(tc, zone);
+  const dt = DateTime.fromMillis(t, { zone });
+  const z = zdtAt(t, zone);
+  // at the very edge of the Date range the wall clock of a positive-offset zone lies beyond it, and luxon gives up
+  if (!dt.isValid && nearLimit(t) && Accepted.dateLimit) { count("accepted-date-limit"); return; }
+  assert.ok(dt.isValid, `fromMillis(${t}, ${zone}) invalid: ${dt.invalidReason}`);
+  const f = fieldsOf(z);
+  expectEqual(`fields of ${t} in ${zone}`, luxonFields(dt), f);
+  if (Math.abs(f.weekYear) < 270000) expectEqual("weeksInWeekYear", dt.weeksInWeekYear, Temporal.PlainDate.from({ year: f.weekYear, month: 12, day: 28 }).weekOfYear);
+  expectEqual("toMillis/valueOf/toSeconds/toUnixInteger", [dt.toMillis(), dt.valueOf(), dt.toSeconds(), dt.toUnixInteger(), dt.toJSDate().getTime()], [t, t, t / 1000, Math.floor(t / 1000), t]);
+  expectEqual("zoneName/isOffsetFixed", [dt.zoneName, dt.isOffsetFixed], [zone, zone === "UTC"]);
+
+  // ISO and the technical formats, built from Temporal's fields
+  const off = offsetString(f.offset);
+  const date = `${isoYear(f.year)}-${pad(f.month)}-${pad(f.day)}`;
+  const time = `${pad(f.hour)}:${pad(f.minute)}:${pad(f.second)}.${pad(f.millisecond, 3)}`;
+  const isoOff = zone === "UTC" ? "Z" : off;
+  expectEqual("toISO", dt.toISO(), `${date}T${time}${isoOff}`);
+  expectEqual("toISO basic", dt.toISO({ format: "basic" }), `${date.replace(/-(?=\d\d(-|$))/g, "")}T${time.replace(/:/g, "")}${isoOff === "Z" ? "Z" : offsetString(f.offset, "techie")}`);
