+  if (nearLimit(t)) return count("skip-date-limit");
+  const z = zdtAt(t, zone);
+  const f = fieldsOf(z);
+  if (!Number.isInteger(f.offset)) return count("skip-lmt-offset");
+  const dt = DateTime.fromMillis(t, { zone });
+  const dateSet = pick(tc, DATE_SETS);
