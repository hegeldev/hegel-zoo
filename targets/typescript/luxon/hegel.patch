+// Pins: one test per recorded bug, asserting the correct behaviour (they fail while the bug exists).
+pin("TestHegelPinWeekDateExpandsYear", () => {
+  // luxon/1: toISOWeekDate() outside 0000–9999, like toISODate(), and readable by fromISO()
+  const bce = DateTime.utc(-7, 6, 5);
+  assert.equal(bce.toISODate(), "-000007-06-05");
+  assert.equal(bce.toISOWeekDate(), "-000007-W22-6");
+  assert.equal(DateTime.utc(10000, 6, 5).toISOWeekDate(), "+010000-W23-1");
+  assert.ok(DateTime.fromISO(bce.toISOWeekDate(), { zone: "UTC" }).isValid, "fromISO reads toISOWeekDate()");
+});
