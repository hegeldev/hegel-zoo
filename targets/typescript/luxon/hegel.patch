+  const atStart = i.splitAt(s);
+  assert.deepEqual(atStart.map((x) => [x.start.toMillis(), x.end.toMillis()]), [[0, 7200000]]);
+  const twice = i.splitAt(s.plus({ hours: 1 }), s.plus({ hours: 1 }));
+  assert.deepEqual(twice.map((x) => [x.start.toMillis(), x.end.toMillis()]), [[0, 3600000], [3600000, 7200000]]);
