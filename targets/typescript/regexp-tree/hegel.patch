+pin("TestHegelPinAstralLiteralIsOneCharacterUnderU", () => {
+  // regexp-tree/17: under u a literal astral character is one code point: /😀+/u repeats it, and
+  // [😀-🙏] is an ordered range.
+  assert.equal(rt.parse("/\u{1F600}+/u").body.type, "Repetition");
