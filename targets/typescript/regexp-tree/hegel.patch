+pin("TestHegelPinZeroRepetitionIsNotAStar", () => {
+  // regexp-tree/33: a{0} matches the empty string only; the optimizer writes a*.
+  assert.equal(optimized("/a{0}b/").exec("ab").index, 1);
+  assert.equal(optimized("/(a){0,0}b/").exec("ab")[1], undefined);
+});
