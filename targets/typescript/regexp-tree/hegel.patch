+  const d = firstDifference(re, re2, inputs(tc, 8));
+  if (d) return problem(`optimize(${where}) = ${show(lit(src2, flags2))}: on ${show(d.s)} ${show(d.a)} vs ${show(d.b)}`);
+  // toString names the same regex as getSource/getFlags.
+  if (o.toString() !== lit(src2, flags2)) {
+    if (Known.optimizeToStringStale) count("known-optimizeToStringStale");
+    else fail(`optimize(${where}).toString() = ${show(o.toString())} but getSource/getFlags give ${show(lit(src2, flags2))}`);
+  }
+  // A fixed point: optimising the result again changes nothing.
+  try {
+    const o2 = rt.optimize(lit(src2, flags2));
+    if (o2.getSource() !== src2) count("not-a-fixed-point");
+  } catch (e) {
+    return problem(`optimize(${show(lit(src2, flags2))}) threw ${firstLine(e)}`);
+  }
+});
+
+property("TestHegelCompatTranspilePreservesTheMatches", (tc) => {
+  const r = regex(tc);
+  const re = v8(r.source, r.flags);
+  const p = rtParse(r.source, r.flags);
+  if (!re || !p.ast) return count(!re && !p.ast ? "both-reject" : "acceptance-differs");
+  const sh = shape(r.source, r.flags);
+  const where = show(lit(r.source, r.flags));
+  const gates = ["forwardNamedReferenceAsChars", "generateThrowsOnArrayNodes", "undefinedNamedReference"];
+  const problem = (message) => {
+    const k = knownFor(sh, ...gates);
+    if (k) return count(k);
+    fail(message);
+  };
+  const xs = inputs(tc, 6);
+  let c;
+  let csrc;
+  let cflags;
+  try {
+    c = rt.compatTranspile(lit(r.source, r.flags));
+    csrc = c.getSource();
+    cflags = c.getFlags();
+  } catch (e) {
+    return problem(`compatTranspile(${where}) threw ${firstLine(e)}`);
+  }
+  const cre = v8(csrc, cflags);
+  if (!cre) return problem(`compatTranspile(${where}) = ${show(lit(csrc, cflags))}, which V8 rejects`);
+  if (cflags.includes("s")) fail(`compatTranspile(${where}) = ${show(lit(csrc, cflags))} keeps the s flag`);
+  for (const s of xs) {
+    const a = execShape(re, s);
+    let b;
+    try {
+      const m = rt.exec(lit(r.source, r.flags), s);
+      b = m === null ? null : { index: m.index, captures: [...m], groups: m.groups ? Object.fromEntries(Object.entries(m.groups)) : undefined };
+    } catch (e) {
+      return problem(`exec(${where}, ${show(s)}) threw ${firstLine(e)}`);
+    }
+    if (a && b && a.groups === undefined && b.groups && Object.keys(b.groups).length === 0) {
+      if (Known.execAddsEmptyGroups) {
+        count("known-execAddsEmptyGroups");
+        b.groups = undefined;
+      }
+    }
+    if (!same(a, b)) return problem(`exec(${where}, ${show(s)}) = ${show(b)} through ${show(lit(csrc, cflags))}, V8 gives ${show(a)}`);
+  }
+  // Extended: the same regex with whitespace and comments between tokens under the x flag.
+  const xsrc = extended(tc, r.source);
+  if (xsrc !== r.source) {
+    let cx;
+    let xre;
+    try {
+      cx = rt.compatTranspile(lit(xsrc, r.flags + "x"));
+      xre = v8(cx.getSource(), cx.getFlags());
+    } catch (e) {
+      return problem(`compatTranspile(${show(lit(xsrc, r.flags + "x"))}) threw ${firstLine(e)}`);
+    }
+    if (!xre) return problem(`compatTranspile(${show(lit(xsrc, r.flags + "x"))}) = ${show(cx.toString())}, which V8 rejects`);
+    const d = firstDifference(cre, xre, xs);
+    if (d) return problem(`compatTranspile(${show(lit(xsrc, r.flags + "x"))}) = ${show(cx.toString())}: on ${show(d.s)} ${show(d.b)}, the plain regex ${where} gives ${show(d.a)}`);
+    count("extended");
+  }
+  count("ok");
+});
+
+property("TestHegelTransformAndToRegExpAgree", (tc) => {
+  const r = regex(tc);
+  const re = v8(r.source, r.flags);
+  const p = rtParse(r.source, r.flags);
+  if (!re || !p.ast) return count(!re && !p.ast ? "both-reject" : "acceptance-differs");
+  const sh = shape(r.source, r.flags);
+  const where = show(lit(r.source, r.flags));
+  const gates = ["forwardNamedReferenceAsChars", "generateThrowsOnArrayNodes", "undefinedNamedReference"];
+  const problem = (message) => {
+    const k = knownFor(sh, ...gates);
+    if (k) return count(k);
+    fail(message);
+  };
+  // Parsing a RegExp object gives the same tree as parsing its text (flags in V8's order).
+  const strip = (x) => JSON.parse(JSON.stringify(x, (k, v) => (k === "loc" ? undefined : v)));
+  const a = strip(rt.parse(re));
+  const b = strip(p.ast);
+  a.flags = sortFlags(a.flags);
+  b.flags = sortFlags(b.flags);
+  if (!same(a, b)) return fail(`parse(new RegExp(...)) and parse(${where}) differ`);
+  // A transform without handlers reproduces the regex; its RegExp behaves like the original.
+  let t;
+  let ts;
+  try {
+    t = rt.transform(lit(r.source, r.flags), {});
+    ts = t.toString();
+  } catch (e) {
+    return problem(`transform(${where}, {}) threw ${firstLine(e)}`);
+  }
+  const g = generateSafely(p.ast);
+  if (g.error) return problem(`generate(parse(${where})) threw ${firstLine(g.error)}`);
+  if (ts !== g.text) return fail(`transform(${where}, {}) = ${show(ts)}, generate gives ${show(g.text)}`);
+  const xs = inputs(tc, 4);
+  let tre;
+  try {
+    tre = t.toRegExp();
+  } catch (e) {
+    return problem(`transform(${where}, {}).toRegExp() threw ${firstLine(e)}`);
+  }
+  const d = firstDifference(re, tre, xs);
+  if (d) return problem(`transform(${where}, {}).toRegExp(): on ${show(d.s)} ${show(d.b)}, V8 gives ${show(d.a)}`);
+  // toRegExp goes through the compat transpiler, which strips named groups.
+  let t2;
+  try {
+    t2 = rt.toRegExp(lit(r.source, r.flags));
+  } catch (e) {
+    return problem(`toRegExp(${where}) threw ${firstLine(e)}`);
+  }
+  for (const s of xs) {
+    const x = execShape(re, s);
+    const y = execShape(t2, s);
+    if (x) x.groups = undefined;
+    if (y) y.groups = undefined;
+    if (!same(x, y)) return problem(`toRegExp(${where}) = ${show(t2.toString())}: on ${show(s)} ${show(y)}, V8 gives ${show(x)}`);
+  }
+  count("ok");
+});
