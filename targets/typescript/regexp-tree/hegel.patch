diff --git a/hegel/gen.mjs b/hegel/gen.mjs
new file mode 100644
index 0000000..00c8c10
--- /dev/null
+++ b/hegel/gen.mjs
@@ -0,0 +1,242 @@
+// A generator of ECMAScript regular expressions for regexp-tree, as source text plus the facts
+// the properties need (capturing group count, group names, whether the regex is meant to be
+// valid). Everything is generated inside the syntax regexp-tree's parser supports (no `v` flag,
+// no modifiers); `u` decides which escapes are legal. `ctx.x` inserts extended-mode whitespace
+// and comments between tokens (regexp-tree's non-standard `x` flag) and returns both spellings.
+
+import { n, pick, chance, word } from "./hegel-zoo.mjs";
+
+// Literal characters: ASCII letters/digits, the syntax characters (escaped where needed), a few
+// non-ASCII ones with interesting case folding (é, ſ/s/S/k/K/Kelvin sign, ß), an astral character
+// and `ε` (the finite-automaton interpreter's epsilon symbol).
+export const LITERALS = ["a", "b", "c", "0", "1", "_", "-", " ", "é"[0], "é", "ſ", "s", "S", "k", "K", "K", "ß", "ε", "\u{1F600}", "x", "y", "Z", "9"];
+const SYNTAX = ["^", "$", "\\", ".", "*", "+", "?", "(", ")", "[", "]", "{", "}", "|", "/"];
+export const GROUP_NAMES = ["n1", "x", "y_", "$z", "π", "a‍"];
+
+// Inputs for exec comparisons: the literals plus line terminators, lone surrogates and more.
+export const INPUT_ALPHABET = [...LITERALS, "\n", "\r", " ", "\t", "\u0000", "\ud83d", "\ude00", "K", "İ", "ı", "i", "I", "d", "w", "9", "µ", "μ"];
+
+export function inputString(tc) {
+  return word(tc, INPUT_ALPHABET, 0, 8);
+}
+
+function hex(cp, width) {
+  return cp.toString(16).padStart(width, "0");
+}
+
+// One literal character, escaped for its position (inside or outside a class).
+function literal(tc, ctx, inClass) {
+  const c = pick(tc, LITERALS);
+  return c;
+}
+
+function syntaxChar(tc, ctx, inClass) {
+  const c = pick(tc, SYNTAX);
+  if (inClass) {
+    // Inside a class only `\`, `]` (and `^` at the start, `-`) need escaping; escaping any syntax
+    // character is legal in both modes.
+    return chance(tc, 50) || c === "\\" || c === "]" ? "\\" + c : c;
+  }
+  return "\\" + c;
+}
+
+// A character escape legal in the mode: \n \t \r \v \f \0, \xHH, \uHHHH, \u{...} (u only, or a
+// literal `u{...}` sequence without u — avoided), \cX, and in non-u mode identity escapes and
+// legacy octal escapes.
+function charEscape(tc, ctx, inClass) {
+  const k = n(tc, 0, 9);
+  if (k === 0) return pick(tc, ["\\n", "\\t", "\\r", "\\v", "\\f", "\\0"]);
+  if (k === 1) return "\\x" + hex(n(tc, 0, 255), 2);
+  if (k === 2) return "\\u" + hex(pick(tc, [0x41, 0x61, 0xe9, 0x17f, 0x212a, 0x3b5, 0xd83d, 0xde00, 0x2028, 0x0]), 4);
+  if (k === 3 && ctx.u) return "\\u{" + hex(pick(tc, [0x41, 0x1f600, 0x10ffff, 0xe9, 0x0, 0x1f64f]), 1) + "}";
+  if (k === 4) return "\\c" + pick(tc, ["A", "J", "z", "M"]);
+  if (k === 5 && !ctx.u) return "\\" + pick(tc, ["_", "-", "e", "q", "z", "A", "Z", "8", "9", "k", "%", "@", "é"]);
+  if (k === 6 && !ctx.u) return "\\" + pick(tc, ["1", "07", "12", "377", "400", "00", "08"]);
+  if (k === 7 && inClass) return "\\b";
+  return pick(tc, ["\\d", "\\D", "\\w", "\\W", "\\s", "\\S"]);
+}
+
+function unicodeProperty(tc, ctx) {
+  const neg = chance(tc, 30) ? "P" : "p";
+  return "\\" + neg + "{" + pick(tc, ["L", "Lu", "Ll", "N", "Nd", "Script=Greek", "sc=Grek", "Script_Extensions=Latin", "General_Category=Letter", "gc=Lu", "ASCII", "Any", "Emoji", "Alphabetic", "White_Space", "ASCII_Hex_Digit", "Script=Vithkuqi", "Script=Kawi"]) + "}";
+}
+
+// One character-class atom: a character, an escape, a range or a class escape.
+function classItem(tc, ctx) {
+  const k = n(tc, 0, 9);
+  if (k <= 3) return literal(tc, ctx, true);
+  if (k === 4) return syntaxChar(tc, ctx, true);
+  if (k === 5 || k === 6) return charEscape(tc, ctx, true);
+  if (k === 7 && ctx.u) return unicodeProperty(tc, ctx);
+  // A range: endpoints from ordered pairs, spelled as literals or escapes.
+  const pairs = [["a", "z"], ["A", "Z"], ["0", "9"], ["a", "c"], ["\\x41", "\\x5a"], ["\\u0061", "\\u007a"], [" ", "~"], ["é", "ſ"], ["\\0", "\\x7f"], ["a", "a"], ["\\d", "z"], ["-", "a"], ["!", "-"], ["\\n", "\\r"]];
+  if (ctx.u) {
+    pairs.push(["\u{1F600}", "\u{1F64F}"], ["\\u{1F600}", "\\u{1F64F}"], ["\\ud83d\\ude00", "\\ud83d\\ude4f"], ["\\u{0}", "\\u{10FFFF}"]);
+  }
+  const [lo, hi] = pick(tc, pairs);
+  if ((lo === "\\d") && ctx.u) return "\\d";
+  return lo + "-" + hi;
+}
+
+function charClass(tc, ctx) {
+  const neg = chance(tc, 25) ? "^" : "";
+  const items = [];
+  for (let i = n(tc, 0, 4); i > 0; i--) items.push(classItem(tc, ctx));
+  return "[" + neg + items.join("") + "]";
+}
+
+// A quantifier for an atom.
+function quantifier(tc, ctx) {
+  const k = n(tc, 0, 7);
+  let q;
+  if (k <= 2) q = pick(tc, ["*", "+", "?"]);
+  else if (k === 3) q = "{" + n(tc, 0, 3) + "}";
+  else if (k === 4) q = "{" + n(tc, 0, 2) + ",}";
+  else {
+    const lo = n(tc, 0, 2);
+    q = "{" + lo + "," + (lo + n(tc, 0, 2)) + "}";
+  }
+  if (chance(tc, 30)) q += "?";
+  return q;
+}
+
+// Extended-mode filler between tokens: spaces, newlines, `# comments`.
+function filler(tc, ctx) {
+  if (!ctx.x) return "";
+  const k = n(tc, 0, 9);
+  if (k < 5) return "";
+  if (k < 8) return pick(tc, [" ", "  ", "\n", "\t", " \n "]);
+  return "# c" + pick(tc, ["", " a|b", " [", " (?<x>"]) + "\n";
+}
+
+function assertion(tc, ctx) {
+  return pick(tc, ["^", "$", "\\b", "\\B"]);
+}
+
+function group(tc, ctx, depth) {
+  const k = n(tc, 0, 9);
+  let open;
+  if (k <= 3) {
+    ctx.groups++;
+    open = "(";
+  } else if (k <= 5) {
+    open = "(?:";
+  } else if (k === 6 || k === 7) {
+    ctx.groups++;
+    const free = GROUP_NAMES.filter((g) => !ctx.names.includes(g));
+    const name = free.length && chance(tc, 90) ? pick(tc, free) : pick(tc, GROUP_NAMES);
+    // The name becomes referenceable after the group closes (see the note in backreference).
+    const body = disjunction(tc, ctx, depth + 1);
+    ctx.names.push(name);
+    return { text: "(?<" + name + ">" + filler(tc, ctx) + body + filler(tc, ctx) + ")", quantifiable: true };
+  } else if (k === 8) {
+    open = pick(tc, ["(?=", "(?!"]);
+  } else {
+    open = pick(tc, ["(?<=", "(?<!"]);
+  }
+  const body = disjunction(tc, ctx, depth + 1);
+  return { text: open + filler(tc, ctx) + body + filler(tc, ctx) + ")", quantifiable: !open.startsWith("(?=") && !open.startsWith("(?!") && !open.startsWith("(?<=") && !open.startsWith("(?<!") };
+}
+
+function backreference(tc, ctx) {
+  if (ctx.names.length && chance(tc, 50)) {
+    // A named reference: to a closed group, or (rarely) to an ASCII name defined later or never
+    // (V8 rejects the latter once any named group exists). Never a reference to a non-ASCII
+    // name that is not yet defined: the parser loops forever on it (regexp-tree/32; the pin
+    // covers it, the property would hang).
+    return "\\k<" + (chance(tc, 85) ? pick(tc, ctx.names) : pick(tc, ["nope", "n1", "x", "y_"])) + ">";
+  }
+  // Numbered: usually within the groups so far (or to come: forward references are legal).
+  const max = Math.max(1, ctx.groups + (chance(tc, 20) ? 2 : 0));
+  return "\\" + n(tc, 1, Math.min(max, 9));
+}
+
+function atom(tc, ctx, depth) {
+  const k = n(tc, 0, 19);
+  if (k <= 5) return { text: literal(tc, ctx, false), quantifiable: true };
+  if (k <= 7) return { text: charEscape(tc, ctx, false), quantifiable: true };
+  if (k === 8) return { text: syntaxChar(tc, ctx, false), quantifiable: true };
+  if (k === 9) return { text: ".", quantifiable: true };
+  if (k <= 11) return { text: charClass(tc, ctx), quantifiable: true };
+  if (k <= 14 && depth < 3) return group(tc, ctx, depth);
+  if (k === 15) return { text: assertion(tc, ctx), quantifiable: false };
+  if (k === 16 && (ctx.groups > 0 || chance(tc, 20))) return { text: backreference(tc, ctx), quantifiable: true };
+  if (k === 17 && ctx.u) return { text: unicodeProperty(tc, ctx), quantifiable: true };
+  return { text: literal(tc, ctx, false), quantifiable: true };
+}
+
+function term(tc, ctx, depth) {
+  const a = atom(tc, ctx, depth);
+  if (a.quantifiable && chance(tc, 35)) return a.text + filler(tc, ctx) + quantifier(tc, ctx);
+  return a.text;
+}
+
+function alternative(tc, ctx, depth) {
+  let s = filler(tc, ctx);
+  for (let i = n(tc, depth === 0 ? 1 : 0, 4); i > 0; i--) s += term(tc, ctx, depth) + filler(tc, ctx);
+  return s;
+}
+
+function disjunction(tc, ctx, depth) {
+  const alts = [alternative(tc, ctx, depth)];
+  for (let i = n(tc, 0, 2); i > 0; i--) alts.push(chance(tc, 15) ? "" : alternative(tc, ctx, depth));
+  return alts.join("|");
+}
+
+/** Random flags without `v`: `u` is decided by ctx. */
+export function flags(tc, ctx) {
+  let f = "";
+  for (const c of ["d", "g", "i", "m", "s", "y"]) if (chance(tc, 25)) f += c;
+  if (ctx.u) f += "u";
+  return f;
+}
+
+/**
+ * A regex: `{ source, flags, u, groups, names, x }`. With `x: true` the source carries extended-
+ * mode filler and `plain` is the same regex without it (the `x` flag itself is regexp-tree's).
+ */
+export function regex(tc, opts = {}) {
+  const ctx = { u: opts.u ?? chance(tc, 50), x: !!opts.x, groups: 0, names: [] };
+  const source = disjunction(tc, ctx, 0);
+  return { source, flags: flags(tc, ctx), u: ctx.u, groups: ctx.groups, names: ctx.names, x: ctx.x };
+}
+
+/** A random single-character edit of a source string, for the acceptance differential. */
+export function mutate(tc, source) {
+  // No raw "/": the parser takes the /pattern/flags form and cannot represent one.
+  const pieces = [...SYNTAX.filter((c) => c !== "/"), "\\", "\\k<x>", "\\1", "{2,1}", "{,2}", "\\u{41}", "\\p{L}", "(?<x>", "\\c", "\\x4", "\\u12", "\\8", "\\00", "\\-", "a", "-", "\\b", "(?i)", "(?=", "*?", "??"];
+  const i = n(tc, 0, source.length);
+  const k = n(tc, 0, 2);
+  if (k === 0) return source.slice(0, i) + pick(tc, pieces) + source.slice(i);
+  if (k === 1 && source.length) return source.slice(0, i) + source.slice(i + 1);
+  return source.slice(0, i) + pick(tc, pieces) + source.slice(i + 1);
+}
+
+/** The finite-automaton subset: simple characters, groups, alternation, `*`, `+`, `?`. */
+export function faRegex(tc) {
+  // ε rarely: it is the interpreter's epsilon symbol (regexp-tree/30) and would gate most cases.
+  const chars = ["a", "b", "c", "x", "a", "b", "c", "x", "a", "b", "c", "x", "ε"];
+  function alt(depth) {
+    const parts = [];
+    // Mostly non-empty alternatives: an empty one crashes the builders (regexp-tree/31).
+    for (let i = chance(tc, 8) ? 0 : n(tc, 1, 3); i > 0; i--) {
+      let t;
+      const k = n(tc, 0, 5);
+      if (k <= 3 || depth >= 2) t = pick(tc, chars);
+      else t = "(" + dis(depth + 1) + ")";
+      if (chance(tc, 30)) t += pick(tc, ["*", "+", "?"]);
+      parts.push(t);
+    }
+    return parts.join("");
+  }
+  function dis(depth) {
+    const alts = [alt(depth)];
+    for (let i = n(tc, 0, 2); i > 0; i--) alts.push(alt(depth));
+    return alts.join("|");
+  }
+  return dis(0);
+}
+
+export function faInput(tc) {
+  return word(tc, ["a", "b", "c", "x", "a", "b", "c", "x", "a", "b", "c", "x", "ε"], 0, 6);
+}
diff --git a/hegel/hegel-zoo.mjs b/hegel/hegel-zoo.mjs
new file mode 100644
index 0000000..1ca6f10
--- /dev/null
+++ b/hegel/hegel-zoo.mjs
@@ -0,0 +1,163 @@
+// Hegel zoo: the small harness shared by the zoo's TypeScript/JavaScript targets.
+//
+// `property(name, body)` registers a node:test test that runs `body(tc)` under Hegel with
+// HEGEL_TEST_CASES cases (default 100) and the database at HEGEL_DATABASE. With ZOO_COLLECT=1
+// a `fail()` records the mismatch instead of failing, the case ends there, and the counts of
+// mismatches and of the shapes seen (`count(key)`) are printed at the end of the test, so a
+// property can be run over many cases to see every shape at once. `pin(name, body)` is a
+// plain test for one pinned bug: it must fail while the bug is present and pass once it is
+// fixed (the zoo's judge reads an unexpected pass as "fixed upstream?").
+
+import { readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+import { test as nodeTest } from "node:test";
+
+// The Hegel version these tests were written against (the zoo pins it in zoo.toml; upstream
+// would add it to devDependencies). Hegel and esbuild are installed with `npm install --prefix
+// .hegel` so the target's own package.json and lock file stay untouched. Checked at load time so
+// a stray install cannot silently change the engine.
+export const HEGEL_PIN = { "@hegeldev/hegel": "0.4.5" };
+
+const hegelDir = join(dirname(fileURLToPath(import.meta.url)), "..", ".hegel", "node_modules", "@hegeldev", "hegel");
+{
+  const installed = JSON.parse(readFileSync(join(hegelDir, "package.json"), "utf8")).version;
+  if (installed !== HEGEL_PIN["@hegeldev/hegel"]) {
+    throw new Error(`@hegeldev/hegel ${installed} is installed; these tests pin ${HEGEL_PIN["@hegeldev/hegel"]}`);
+  }
+}
+const hegel = await import(pathToFileURL(join(hegelDir, "dist", "index.js")));
+const gs = await import(pathToFileURL(join(hegelDir, "dist", "generators", "index.js")));
+
+export const collecting = !!process.env.ZOO_COLLECT;
+
+class Collected extends Error {}
+
+let msgs = [];
+let stats = new Map();
+
+/** Report a mismatch: an error normally, a recorded line in collect mode. */
+export function fail(message) {
+  if (collecting) {
+    msgs.push(message);
+    throw new Collected(message);
+  }
+  throw new Error(message);
+}
+
+/** Bump a statistic (the shape of a pinned bug, a generator branch). */
+export function count(key) {
+  stats.set(key, (stats.get(key) || 0) + 1);
+}
+
+function settings() {
+  const s = { testCases: Number(process.env.HEGEL_TEST_CASES) || 100 };
+  if (process.env.HEGEL_DATABASE) {
+    s.database = hegel.Database.fromPath(process.env.HEGEL_DATABASE);
+  }
+  return s;
+}
+
+/** A property: `body(tc)` runs under Hegel; a thrown error (or `fail`) is a failure. */
+export function property(name, body) {
+  nodeTest(name, () => {
+    msgs = [];
+    stats = new Map();
+    hegel.test((tc) => {
+      try {
+        body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** An async property: `body(tc)` may await; runs under Hegel's testAsync with the same settings. */
+export function propertyAsync(name, body) {
+  nodeTest(name, async () => {
+    msgs = [];
+    stats = new Map();
+    await hegel.testAsync(async (tc) => {
+      try {
+        await body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** A pin: a plain test for one recorded bug. */
+export function pin(name, body) {
+  nodeTest(name, body);
+}
+
+/** An integer in [lo, hi]. */
+export function n(tc, lo, hi) {
+  return tc.draw(gs.integers({ minValue: lo, maxValue: hi }));
+}
+
+/** One of xs. */
+export function pick(tc, xs) {
+  return xs[n(tc, 0, xs.length - 1)];
+}
+
+/** True pct percent of the time. */
+export function chance(tc, pct) {
+  return n(tc, 0, 99) < pct;
+}
+
+/** A string of `len` characters drawn from `alphabet` (an array of strings). */
+export function word(tc, alphabet, lo, hi) {
+  const len = n(tc, lo, hi);
+  let s = "";
+  for (let i = 0; i < len; i++) {
+    s += pick(tc, alphabet);
+  }
+  return s;
+}
+
+/** Structural equality: arrays by position, objects by key set (prototype ignored), else ===. */
+export function same(a, b) {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) {
+      return false;
+    }
+    return a.every((x, i) => same(x, b[i]));
+  }
+  if (a !== null && b !== null && typeof a === "object" && typeof b === "object") {
+    const ka = Object.keys(a).sort();
+    const kb = Object.keys(b).sort();
+    if (ka.length !== kb.length || ka.some((k, i) => k !== kb[i])) {
+      return false;
+    }
+    return ka.every((k) => same(a[k], b[k]));
+  }
+  return a === b;
+}
+
+/** A compact, unambiguous rendering for messages. */
+export function show(x) {
+  return JSON.stringify(x, (k, v) => (v === undefined ? "<undefined>" : v));
+}
diff --git a/hegel/hegel.test.mjs b/hegel/hegel.test.mjs
new file mode 100644
index 0000000..f5ca1d2
--- /dev/null
+++ b/hegel/hegel.test.mjs
@@ -0,0 +1,884 @@
+// regexp-tree against V8: Node's own RegExp decides what a regular expression means. The parser
+// must accept exactly what V8 accepts, the generator must reproduce the source, the AST must
+// describe the regex V8 runs (groups, names, code points, locations), and the optimizer, the
+// compat transpiler and the finite-automaton interpreter must preserve its behaviour.
+
+import assert from "node:assert/strict";
+import { createRequire } from "node:module";
+import { fileURLToPath } from "node:url";
+import { Worker } from "node:worker_threads";
+import { property, pin, count, fail, n, pick, chance, show, same } from "./hegel-zoo.mjs";
+import { regex, mutate, inputString, faRegex, faInput } from "./gen.mjs";
+
+const require = createRequire(import.meta.url);
+// src/ is the library as published (dist/ is its babel output); no runtime dependencies.
+const rt = require("../src/regexp-tree.js");
+
+// Recorded bugs (regexp-tree/N): a switch per bug gates the input shape, on a mismatch only, so
+// the properties stay green while the pins fail.
+const Known = {
+  uModeLoneBrackets: true, // 1: /a{/u, /}/u, /]/u accepted
+  uModeLegacyEscapes: true, // 2: /\1/u without a group, /\01/u, /\8/u accepted
+  classEscapeRange: true, // 3: [\d-z] is a ClassRange (V8: three atoms; a SyntaxError under u)
+  undefinedNamedReference: true, // 4: \k<m> or \k( accepted while named groups exist
+  quantifiedLookaheadRejected: true, // 5: /(?=a)*/ rejected (Annex B accepts it)
+  controlCharsHaveNoCodePoint: true, // 6: \cA has no codePoint, so [\cA-\cZ] is "out of order"
+  classBigBRejected: true, // 7: /[\B]/ rejected
+  groupNameBraceEscapeRejected: true, // 8: /(?<\u{41}>x)/ rejected without u
+  staleUnicodeTables: true, // 9: Script=Vithkuqi, Toto, Kawi... rejected
+  classBackspaceFallsThrough: true, // 10: [\b] has symbol "." and codePoint null
+  legacyOctalAsDecimal: true, // 11: \40 has codePoint 40, optimize gives \(
+  eightNineAsCodes: true, // 12: \8 and \9 have codePoints 8 and 9
+  octalLexerTakesEightNine: true, // 13: \08 is one NUL char, the 8 is lost
+  forwardReferenceAsChar: true, // 14: \1(a) is a Char, the optimizer folds it into a class
+  forwardNamedReferenceAsChars: true, // 15: \k<n>(?<n>a) is five Chars; optimize/compat break it
+  controlNonLetterAsIdentityEscape: true, // 16: \c1 is "c" + "1"; optimize gives /c1/
+  astralLiteralSplit: true, // 17: /😀+/u quantifies the trail surrogate; [😀-🙏]/u rejected
+  lazyQuantifierLocation: true, // 18: the Quantifier node's loc omits the lazy ?
+  generateThrowsOnArrayNodes: true, // 19: generate(parse("/[\\k<x>]/")) throws TypeError
+  caretSortedFirstNegatesClass: true, // 20: optimize /[b^]/ gives /[^b]/
+  classReentryUnescaped: true, // 21: /(?:b|[\]])/ gives /[]b]/, /(?:[-a]|\cA)/ gives /[a-\cA]/
+  lowercaseUsesFullMapping: true, // 22: /İ/i gives /i/i
+  repeatedAssertionQuantified: true, // 23: /(?=a)(?=a)/ gives /(?=a){2}/
+  optimizeToStringStale: true, // 24: optimize(...).toString() != "/" + getSource() + "/" + flags
+  uModeUnescapeBrackets: true, // 25: optimize /\}/u gives /}/u, /[\]]/u gives /]/u
+  xCommentAtEndRejected: true, // 26: /a#b/x is "Unexpected end of input"
+  xFlagKeptForRegExp: true, // 27: optimize("/a b/x").toRegExp() throws
