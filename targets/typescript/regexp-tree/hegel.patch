+pin("TestHegelPinForwardNamedReferenceIsABackreference", () => {
+  // regexp-tree/15: \k<n>(?<n>a) is a named backreference; optimize gives /k<n>(?<n>a)/ and
+  // compatTranspile /\k<n>(a)/.
