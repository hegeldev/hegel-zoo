+property("TestHegelFiniteAutomatonAgreesWithV8", (tc) => {
+  const src = faRegex(tc);
+  const re = v8("^(?:" + src + ")$", "");
+  if (!re) return count("v8-rejects");
+  const where = show("/" + src + "/");
+  const known = [];
+  if (src.includes("ε")) known.push("epsilonLiteralIsEpsilon");
+  if (/\|\||^\||\|$|\(\||\|\)|\(\)|^$/.test(src)) known.push("emptyAlternativeCrashesFa");
+  if (!/^[abcx](?![*?])/.test(src)) known.push("dfaStartsInTheWrongState");
+  const problem = (message, s) => {
+    // The literal ε is the interpreter's epsilon in the pattern and in the input alike.
+    const ks = s !== undefined && s.includes("ε") ? [...known, "epsilonLiteralIsEpsilon"] : known;
+    for (const k of ks) if (Known[k]) return count("known-" + k);
+    fail(message);
+  };
+  const xs = ["", "a", "ε"];
+  for (let i = 0; i < 6; i++) xs.push(faInput(tc));
+  let dfa;
+  let nfa;
+  try {
+    nfa = rt.fa.toNFA("/" + src + "/");
+    dfa = rt.fa.toDFA("/" + src + "/");
+  } catch (e) {
+    return problem(`fa.toDFA(${where}) threw ${firstLine(e)}`);
+  }
+  for (const s of xs) {
+    const want = re.test(s);
+    let got;
+    let gotNfa;
+    try {
+      got = dfa.matches(s);
+      gotNfa = nfa.matches(s);
+    } catch (e) {
+      return problem(`fa ${where} on ${show(s)} threw ${firstLine(e)}`, s);
+    }
+    if (got !== want) return problem(`fa ${where} on ${show(s)}: DFA ${got}, V8's ^(?:...)$ gives ${want}`, s);
+    if (gotNfa !== want) return problem(`fa ${where} on ${show(s)}: NFA ${gotNfa}, V8's ^(?:...)$ gives ${want}`, s);
+  }
+  count("ok");
+});
+
+// ---------------------------------------------------------------- pins
+
+const parses = (s, o) => {
+  try {
+    rt.parse(s, o);
+    return true;
+  } catch (e) {
+    return false;
+  }
+};
+const optimized = (s) => rt.optimize(s).toRegExp();
+
+pin("TestHegelPinUModeRejectsLoneBrackets", () => {
+  // regexp-tree/1: in u-mode a lone `{`, `}` or `]` is a SyntaxError (V8: "Lone quantifier brackets").
+  assert.equal(parses("/a{/u"), false);
+  assert.equal(parses("/}/u"), false);
+  assert.equal(parses("/]/u"), false);
+});
+
+pin("TestHegelPinUModeRejectsLegacyEscapes", () => {
+  // regexp-tree/2: \1 without a group, \01 and \8 are invalid escapes under u.
+  assert.equal(parses("/\\1/u"), false);
+  assert.equal(parses("/\\01/u"), false);
+  assert.equal(parses("/\\8/u"), false);
+});
+
+pin("TestHegelPinClassEscapeIsNoRangeEndpoint", () => {
+  // regexp-tree/3: [\d-z] is three class atoms in V8 (a SyntaxError under u), not a range.
+  assert.equal(parses("/[\\d-z]/u"), false);
+  assert.notEqual(rt.parse("/[\\d-z]/").body.expressions[0].type, "ClassRange");
+});
+
+pin("TestHegelPinUndefinedNamedReferenceIsRejected", () => {
+  // regexp-tree/4: once a named group exists, \k must reference one of them.
+  assert.equal(parses("/(?<n>a)\\k<m>/"), false);
+  assert.equal(parses("/(?<n>a)\\k(b)/"), false);
+  assert.equal(parses("/(?<x>a)[\\k<x>]/"), false);
+});
+
+pin("TestHegelPinQuantifiedLookaheadIsAccepted", () => {
+  // regexp-tree/5: Annex B QuantifiableAssertion, accepted by V8 without the u flag.
+  assert.equal(parses("/(?=a)*/"), true);
+  assert.equal(parses("/(?!a)+b/"), true);
+});
+
+pin("TestHegelPinControlEscapesHaveCodePoints", () => {
+  // regexp-tree/6: \cA is U+0001; a range between control escapes is valid.
+  assert.equal(rt.parse("/\\cA/").body.codePoint, 1);
+  assert.equal(rt.parse("/\\cA/").body.symbol, "");
+  assert.equal(parses("/[\\cA-\\cZ]/"), true);
+});
+
+pin("TestHegelPinClassBigBIsAccepted", () => {
+  // regexp-tree/7: [\B] is the identity escape B in Annex B.
+  assert.equal(parses("/[\\B]/"), true);
+});
+
+pin("TestHegelPinGroupNameBraceEscapeWithoutU", () => {
+  // regexp-tree/8: \u{41} in a group name is legal without the u flag (RegExpIdentifierName).
+  assert.equal(parses("/(?<\\u{41}>x)/"), true);
+});
+
+pin("TestHegelPinRecentScriptNamesAreKnown", () => {
+  // regexp-tree/9: Unicode 14+ scripts V8 accepts.
+  assert.equal(parses("/\\p{Script=Vithkuqi}/u"), true);
+  assert.equal(parses("/\\p{Script=Kawi}/u"), true);
+});
+
+pin("TestHegelPinClassBackspaceIsCodePointEight", () => {
+  // regexp-tree/10: [\b] is U+0008; the Char case falls through to "." in the parser.
+  const c = rt.parse("/[\\b]/").body.expressions[0];
+  assert.equal(c.codePoint, 8);
+  assert.equal(c.symbol, "\b");
+});
+
+pin("TestHegelPinLegacyOctalEscapesAreOctal", () => {
+  // regexp-tree/11: \40 is U+0020 (octal), read as decimal 40 "("; the optimizer then writes \(.
+  assert.equal(rt.parse("/\\40/").body.codePoint, 32);
+  assert.equal(optimized("/\\40/").test(" "), true);
+  assert.equal(rt.parse("/\\12/").body.codePoint, 10);
+});
+
+pin("TestHegelPinBackslashEightIsTheDigitEight", () => {
+  // regexp-tree/12: \8 and \9 are identity escapes for the digits.
+  assert.equal(rt.parse("/\\8/").body.codePoint, 56);
+  assert.equal(rt.parse("/\\9/").body.codePoint, 57);
+});
+
+pin("TestHegelPinOctalEscapeStopsBeforeEight", () => {
+  // regexp-tree/13: \08 is NUL followed by the digit 8 (two atoms), not one NUL.
+  const body = rt.parse("/\\08/").body;
+  assert.equal(body.type, "Alternative");
+  assert.equal(body.expressions.length, 2);
