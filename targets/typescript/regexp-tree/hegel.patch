+
+pin("TestHegelPinControlEscapeBeforeNonLetterIsLiteral", () => {
+  // regexp-tree/16: in Annex B, \c not followed by a letter matches the text "\c" literally, so
+  // /\c1/ matches "\\c1"; parsed as "c" + "1", the optimizer gives /c1/.
+  assert.equal(optimized("/^\\c1$/").test("\\c1"), true);
+  assert.equal(optimized("/^\\c1$/").test("c1"), false);
+});
+
+pin("TestHegelPinAstralLiteralIsOneCharacterUnderU", () => {
+  // regexp-tree/17: under u a literal astral character is one code point: /😀+/u repeats it, and
+  // [😀-🙏] is an ordered range.
+  assert.equal(rt.parse("/\u{1F600}+/u").body.type, "Repetition");
+  assert.equal(parses("/[\u{1F600}-\u{1F64F}]/u"), true);
+});
+
+pin("TestHegelPinLazyQuantifierLocationCoversTheQuestionMark", () => {
+  // regexp-tree/18: the Quantifier of /a*?/ spans "*?" (offsets 2-4), its loc says "*".
+  const q = rt.parse("/a*?/", { captureLocations: true }).body.quantifier;
+  assert.equal(q.loc.end.offset - q.loc.start.offset, 2);
+});
+
+pin("TestHegelPinGenerateDoesNotThrowOnClassWithK", () => {
+  // regexp-tree/19: /[\k<x>]/ (no named groups: four literal characters) parses, generate throws.
+  assert.equal(rt.generate(rt.parse("/[\\k<x>]/")), "/[\\k<x>]/");
+  assert.equal(rt.generate(rt.parse("/\\k<x>*/")), "/\\k<x>*/");
+});
+
+pin("TestHegelPinOptimizeKeepsACaretInsideTheClass", () => {
+  // regexp-tree/20: [b^] matches "b" and "^"; sorted to /[^b]/ it matches everything but "b".
+  assert.equal(optimized("/[b^]/").test("a"), false);
+  assert.equal(optimized("/[a\\^]/").test("a"), true);
+});
+
+pin("TestHegelPinOptimizeReescapesCharsEnteringAClass", () => {
+  // regexp-tree/21: alternatives folded into a class keep their meaning: "]" escaped, "-" not
+  // a range, \0 not followed by a digit.
+  assert.equal(optimized("/(?:b|[\\]])/").test("b"), true);
