+pin("TestHegelPinForwardReferenceIsABackreference", () => {
+  // regexp-tree/14: \1(a) references group 1 (V8 matches "a"); the parser makes a Char of it and
+  // the optimizer folds it into a class.
+  assert.equal(rt.parse("/\\1(a)/").body.expressions[0].type, "Backreference");
+  assert.equal(optimized("/(?:[.]|\\1)(9)/").test("9"), true);
