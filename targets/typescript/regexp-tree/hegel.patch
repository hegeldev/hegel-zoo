+pin("TestHegelPinDisjunctionLocationIncludesTheEmptyFirstAlternative", () => {
+  // regexp-tree/34: in (|a|b) the Disjunction spans "|a|b" from offset 2; with three or more
+  // alternatives its loc starts at "a".
