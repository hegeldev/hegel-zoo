+  if (sortFlags(flags2) !== sortFlags(r.flags)) return fail(`optimize(${where}) = ${show(lit(src2, flags2))}: flags changed`);
+  const re2 = v8(src2, flags2);
+  if (!re2) return problem(`optimize(${where}) = ${show(lit(src2, flags2))}, which V8 rejects`);
+  count(src2 === r.source ? "unchanged" : "rewritten");
+  const d = firstDifference(re, re2, inputs(tc, 8));
+  if (d) return problem(`optimize(${where}) = ${show(lit(src2, flags2))}: on ${show(d.s)} ${show(d.a)} vs ${show(d.b)}`);
+  // toString names the same regex as getSource/getFlags.
+  if (o.toString() !== lit(src2, flags2)) {
+    if (Known.optimizeToStringStale) count("known-optimizeToStringStale");
+    else fail(`optimize(${where}).toString() = ${show(o.toString())} but getSource/getFlags give ${show(lit(src2, flags2))}`);
+  }
+  // A fixed point: optimising the result again changes nothing.
+  try {
+    const o2 = rt.optimize(lit(src2, flags2));
+    if (o2.getSource() !== src2) count("not-a-fixed-point");
+  } catch (e) {
+    return problem(`optimize(${show(lit(src2, flags2))}) threw ${firstLine(e)}`);
+  }
+});
