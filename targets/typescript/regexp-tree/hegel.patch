+pin("TestHegelPinNamedReferenceToAnUnknownNonAsciiNameTerminates", async () => {
+  // regexp-tree/32: parse("/\\k<π>/") (a named reference to a non-ASCII name no group defines)
+  // never returns; parsed in a worker with a time limit, since the bug is a hang.
+  const src = fileURLToPath(new URL("../src/regexp-tree.js", import.meta.url));
+  const worker = new Worker(`const rt = require(${JSON.stringify(src)}); rt.parse("/\\\\k<\\u03c0>/"); require("worker_threads").parentPort.postMessage("done");`, { eval: true });
+  const outcome = await new Promise((resolve) => {
+    const timer = setTimeout(() => resolve("timeout"), 3000);
+    worker.on("message", (m) => { clearTimeout(timer); resolve(m); });
+    worker.on("error", (e) => { clearTimeout(timer); resolve("error " + e.message); });
+  });
+  await worker.terminate();
+  assert.equal(outcome, "done");
+});
