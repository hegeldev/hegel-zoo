+pin("TestHegelPinAsyncPromiseResolvingToUndefinedIsUndefined", async () => {
+  const back = d.parse(await d.stringifyAsync({ a: Promise.resolve(undefined), b: [Promise.resolve(NaN), Promise.resolve(-0), Promise.resolve(Infinity)] }));
+  assert.ok("a" in back && back.a === undefined, `a is ${String(back.a)}`);
+  assert.ok(Number.isNaN(back.b[0]), `b[0] is ${String(back.b[0])}`);
+  assert.ok(Object.is(back.b[1], -0), `b[1] is ${String(back.b[1])}`);
