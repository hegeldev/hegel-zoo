+  const back = d.parse(s, undefined, { operations: realmOperations(ctx) });
+  expectSame("parse into a vm realm", v, back);
+  const realmProtos = new Set(REALM_TYPES.map((t) => vm.runInContext(t + ".prototype", ctx)));
+  for (const p of prototypesOf(back)) {
+    if (p !== null && !realmProtos.has(p)) fail(`a revived object has a prototype from the wrong realm: ${p.constructor && p.constructor.name}`);
+  }
+});
