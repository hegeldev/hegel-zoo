+// ---------------------------------------------------------------------------------------------
+// custom operations (README "Custom operations" / "Customizing parse")
+
+const REALM_TYPES = ["Object", "Array", "Map", "Set", "Date", "RegExp", "ArrayBuffer", "DataView", "Number", "String", "Boolean", "BigInt",
+  "Int8Array", "Uint8Array", "Uint8ClampedArray", "Int16Array", "Uint16Array", "Int32Array", "Uint32Array", "Float32Array", "Float64Array", "BigInt64Array", "BigUint64Array"];
+
+function realmOperations(ctx) {
+  const R = (code) => vm.runInContext(code, ctx);
+  return {
+    createObject: R("() => ({})"),
+    createArray: R("(n) => new Array(n)"),
+    createSparseArray: R("(n) => { const a = []; a.length = n; return a; }"),
+    createMap: R("() => new Map()"),
+    createSet: R("() => new Set()"),
+    createNullPrototypeObject: R("() => Object.create(null)"),
+    fromISOString: R("(iso) => new Date(iso)"),
+    fromRegExpInfo: R("(s, f) => new RegExp(s, f)"),
+    box: R("(v) => Object(v)"),
+    fromArrayBuffer: R("(b) => { const c = new ArrayBuffer(b.byteLength); new Uint8Array(c).set(new Uint8Array(b)); return c; }"),
+    fromViewInfo: R("(tag, buf, off, len) => off !== undefined ? new globalThis[tag](buf, off, len) : new globalThis[tag](buf)"),
+  };
+}
+
+function prototypesOf(root) {
+  const protos = new Set();
+  const seen = new Set();
+  function go(x) {
+    if (x === null || typeof x !== "object" || seen.has(x)) return;
+    seen.add(x);
+    protos.add(Object.getPrototypeOf(x));
+    if (Array.isArray(x)) for (let i = 0; i < x.length; i++) if (i in x) go(x[i]);
+    else if (x instanceof Map || Object.prototype.toString.call(x) === "[object Map]") for (const [k, y] of x) { go(k); go(y); }
+    else if (Object.prototype.toString.call(x) === "[object Set]") for (const y of x) go(y);
+    else if (ArrayBuffer.isView(x)) go(x.buffer);
+    else if (Object.prototype.toString.call(x) === "[object Object]") for (const k of Object.keys(x)) go(x[k]);
+  }
+  go(root);
+  return protos;
+}
+
+// what the custom parse operations below can build: no URL/Temporal (no operation for them), no unpaired surrogates
+const realmValue = gen.values(gen.without(gen.FULL, "url", "temporal", "loneSurrogates"));
