+pin("TestHegelPinUnevalOutputWithSixtyFiveThousandNamesEvaluates", () => {
+  // 65534 values referenced twice: one below the cutoff at which uneval switches from function
+  // parameters to a destructured array; V8 cannot call a function with that many arguments
+  const N = 65534;
+  const objs = [];
+  for (let i = 0; i < N; i++) objs.push({});
+  const root = [...objs, ...objs];
+  const code = d.uneval(root);
+  let back;
+  try {
+    back = evaluate(code);
+  } catch (e) {
+    assert.fail(`uneval output for ${N} shared objects does not evaluate: ${e.constructor.name}: ${e.message}`);
+  }
+  assert.equal(back.length, 2 * N);
+  assert.equal(back[0], back[N]);
+});
+
+pin("TestHegelPinUnevalViewOverAnOddBufferEvaluates", () => {
+  const view = new Uint16Array(new ArrayBuffer(3), 0, 1);
+  view[0] = 513;
+  let code;
+  assert.doesNotThrow(() => { code = d.uneval(view); }, "uneval must accept a legal typed array");
+  const back = evaluate(code);
+  assert.ok(back instanceof Uint16Array && back.length === 1 && back[0] === 513, `evaluates to ${canon(back)}`);
+  assert.equal(back.buffer.byteLength, 3);
+});
+
+pin("TestHegelPinUnevalPlaceholderNamesDoNotShadowGlobals", () => {
+  // 113794 objects referenced twice: the 113794th placeholder is named `Map`, and `new Map(...)`
+  // inside the generated function body then names it
+  const N = 113794;
+  const objs = [];
+  for (let i = 0; i < N; i++) objs.push({});
+  objs[0].m = new Map([[1, 2]]);
+  const root = [...objs, ...objs];
+  const code = d.uneval(root);
+  let back;
+  try {
+    back = evaluate(code);
+  } catch (e) {
+    assert.fail(`uneval output does not evaluate: ${e.constructor.name}: ${e.message}`);
+  }
+  assert.ok(back[0].m instanceof Map && back[0].m.get(1) === 2, `back[0].m is ${canon(back[0].m).slice(0, 80)}`);
+  assert.equal(back.length, 2 * N);
+});
+
+pin("TestHegelPinTaggedObjectIsNotAnEmptyArray", () => {
+  const o = { a: 1, b: "two" };
+  Object.defineProperty(o, Symbol.toStringTag, { value: "Array" });
+  let s;
+  try {
+    s = d.stringify(o);
+  } catch (e) {
+    assert.ok(e instanceof d.DevalueError, `stringify threw ${e.constructor.name}: ${e.message}`);
+    return;
+  }
+  const back = d.parse(s);
+  assert.ok(!Array.isArray(back), `an object tagged Array came back as ${canon(back)} (${s})`);
+  assert.deepEqual(back, { a: 1, b: "two" });
+});
+
+pin("TestHegelPinOutputIsWellFormedText", () => {
+  const s = d.stringify(["\ud800", { "\udfff": 1 }]);
+  assert.ok(s.isWellFormed(), `stringify output has an unpaired surrogate: ${JSON.stringify(s)}`);
+  const code = d.uneval("a\ud83db");
