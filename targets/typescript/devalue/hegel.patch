+// ---------------------------------------------------------------------------------------------
+// parse of hostile input
+
+const PROTOS = [Object.prototype, Array.prototype, Map.prototype, Set.prototype, Function.prototype, Date.prototype];
+const protoSnapshot = () => PROTOS.map((p) => Object.getOwnPropertyNames(p).join(",")).join("|");
+
+/** A random flattened array in devalue's own encoding, with the ingredients of prototype pollution and of cycles/overflows. */
+function hostileFlat(tc) {
+  const len = n(tc, 1, 6);
+  const idx = () => n(tc, -8, len + 1);
+  const arr = [];
+  for (let i = 0; i < len; i++) {
+    switch (n(tc, 0, 14)) {
+      case 0: arr.push(n(tc, -8, 8)); break;
+      case 1: arr.push(pick(tc, ["__proto__", "constructor", "polluted", "x"])); break;
+      case 2: { const o = {}; o[pick(tc, ["__proto__", "constructor", "prototype", "polluted", "a"])] = idx(); if (chance(tc, 50)) o.polluted = idx(); arr.push(o); break; }
+      case 3: arr.push(JSON.parse(`{"__proto__":{"polluted":${idx()}},"constructor":{"prototype":{"polluted":1}}}`)); break;
+      case 4: arr.push(["null", pick(tc, ["__proto__", "constructor", "polluted"]), idx()]); break;
+      case 5: arr.push(["Object", idx()]); break;
+      case 6: arr.push(["Map", idx(), idx()]); break;
+      case 7: arr.push(["Set", idx(), idx()]); break;
+      case 8: arr.push(["Date", pick(tc, ["2020-01-01T00:00:00.000Z", "", 5, null])]); break;
+      case 9: arr.push(["RegExp", pick(tc, ["a", "(", 5]), pick(tc, ["g", "zz", null])]); break;
+      case 10: arr.push([pick(tc, ["Uint8Array", "DataView", "Float64Array", "BigInt64Array"]), idx(), n(tc, -1, 5), n(tc, -1, 5)]); break;
+      case 11: arr.push(["ArrayBuffer", pick(tc, ["AAAA", "!!", "", 5, null])]); break;
+      case 12: arr.push([-7, pick(tc, [0, 3, -1, 2 ** 32 - 1, 2 ** 32, 1.5, "3"]), pick(tc, [0, 1, "__proto__", "length", -1, 2 ** 32 - 2, 2 ** 32 - 1]), idx()]); break;
+      case 13: arr.push([-2, idx(), -2, idx()]); break;
+      default: arr.push([pick(tc, ["Custom", "BigInt", "URL", "Temporal.Instant", "Nope"]), pick(tc, [idx(), "12", "x", "http://a/"])]);
+    }
+  }
+  return arr;
+}
+
+property("TestHegelParseNeverPollutesPrototypes", (tc) => {
+  const before = protoSnapshot();
+  const arr = hostileFlat(tc);
+  const text = JSON.stringify(arr);
+  const withRevivers = chance(tc, 50) ? { Custom: (x) => x } : undefined;
+  let outcome = "returned";
+  try {
+    if (chance(tc, 50)) d.parse(text, withRevivers);
+    else d.unflatten(JSON.parse(text), withRevivers);
+  } catch (e) {
+    if (!(e instanceof Error)) fail(`parse threw a non-Error: ${String(e)}`);
+    outcome = "threw";
+  }
+  count(outcome);
+  if (protoSnapshot() !== before) fail(`parse changed a builtin prototype: ${text}`);
+  if ({}.polluted !== undefined || [].polluted !== undefined || new Map().polluted !== undefined) fail(`prototype pollution through ${text}`);
+});
