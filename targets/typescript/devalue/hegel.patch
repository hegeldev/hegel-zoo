+// ---------------------------------------------------------------------------------------------
+// errors and their paths
+
+/** What devalue refuses, by kind: how to make one and the documented message. */
+const OFFENDERS = {
+  function: [() => function f() {}, "Cannot stringify a function"],
+  symbol: [() => Symbol("s"), "Cannot stringify a Symbol primitive"],
+  "class instance": [() => new (class Foo { constructor() { this.a = 1; } })(), "Cannot stringify arbitrary non-POJOs"],
+  "symbol key": [() => ({ a: 1, [Symbol("k")]: 2 }), "Cannot stringify POJOs with symbolic keys"],
+  "__proto__ key": [() => JSON.parse('{"__proto__":1}'), "Cannot stringify objects with __proto__ keys"],
+};
+
+/** Every plain object, array or Map in v that an expression from the root can address (nothing inside a Set or a Map key, for which devalue's path has no expression: it stops at the Set / writes `.get(...)`). */
+function addressableContainers(root) {
+  const out = [];
+  const seen = new Set();
+  function go(x, addressable) {
+    if (x === null || typeof x !== "object" || seen.has(x)) return;
+    seen.add(x);
+    if (Array.isArray(x)) {
+      if (addressable) out.push(x);
+      for (let i = 0; i < x.length; i++) if (i in x) go(x[i], addressable);
+    } else if (x instanceof Map) {
+      if (addressable) out.push(x);
+      for (const [k, y] of x) {
+        go(k, false);
+        go(y, addressable && (k === null || (typeof k !== "object" && typeof k !== "function")));
+      }
+    } else if (x instanceof Set) {
+      for (const y of x) go(y, false);
+    } else if (Object.prototype.toString.call(x) === "[object Object]") {
+      if (addressable) out.push(x);
+      for (const k of Object.keys(x)) go(x[k], addressable);
+    }
+  }
+  go(root, true);
+  return out;
+}
+
+/**
+ * The error-path case: a container without shared references (a Set root goes into an array),
+ * the kind of offender, which addressable container gets it (an index taken modulo their number)
+ * and where in it: appended to an array 70% of the time or at an index (modulo its length), under
+ * a primitive Map key (undefined and bigints included), or under an object key.
+ */
+const errorPathCase = gs.record({
+  root: gen.container(gen.without(gen.FULL, "share")).map((r) => (r instanceof Set ? [r] : r)),
+  kind: gs.sampledFrom(Object.keys(OFFENDERS)),
+  target: ints(0, 99),
+  slot: gs.record({ append: chance(70), index: ints(0, 99), mapKey: gen.leaf({ undefined: true, bigint: true }), key: gen.key(gen.FULL) }),
+});
+
+property("TestHegelUnserialisableValuesReportTheirPath", (tc) => {
+  const { root, kind, target, slot } = tc.draw(errorPathCase);
+  const [make, message] = OFFENDERS[kind];
+  const offender = make();
+  const targets = addressableContainers(root);
+  const t = targets[target % targets.length];
+  if (Array.isArray(t)) t[slot.append ? t.length : slot.index % Math.max(1, t.length)] = offender;
+  else if (t instanceof Map) t.set(slot.mapKey !== null && typeof slot.mapKey === "object" ? "k" : slot.mapKey, offender);
+  else t[slot.key] = offender;
+  for (const [name, fn] of [["stringify", () => d.stringify(root)], ["uneval", () => d.uneval(root)]]) {
+    let err;
+    try {
+      fn();
+    } catch (e) {
+      err = e;
+    }
+    if (!err) return fail(`${name} accepted a value with a ${kind}`);
+    if (!(err instanceof d.DevalueError)) return fail(`${name} threw ${err.constructor.name} (${err.message}) for a ${kind}`);
+    if (err.message !== message) fail(`${name}: message ${JSON.stringify(err.message)} for a ${kind}, expected ${JSON.stringify(message)}`);
+    if (err.value !== offender) fail(`${name}: error.value is not the offending ${kind}`);
+    if (err.root !== root) fail(`${name}: error.root is not the root`);
+    let found;
+    try {
+      found = new Function("root", "return root" + err.path)(root);
+    } catch (e) {
+      return fail(`${name}: error.path ${JSON.stringify(err.path)} does not evaluate (${e.message})`);
+    }
+    if (found !== offender) fail(`${name}: error.path ${JSON.stringify(err.path)} leads to ${canon(found).slice(0, 80)}, not to the ${kind}`);
+  }
+});
