diff --git a/hegel/canon.mjs b/hegel/canon.mjs
new file mode 100644
index 0000000..a4b27a5
--- /dev/null
+++ b/hegel/canon.mjs
@@ -0,0 +1,91 @@
+// Hegel zoo: a canonical rendering of a JavaScript value graph.
+//
+// `canon(v)` renders a value so that two graphs render the same text exactly when they are
+// structurally equal *including identity structure*: every object gets a label `#k` in
+// depth-first order and a later reference to the same object renders as `@k`, so shared
+// references and cycles are compared, not just contents. It distinguishes -0, NaN, bigints,
+// boxed primitives, Dates (by time value, NaN for an invalid one), RegExps (source and flags),
+// arrays with holes, Maps (entries in order), Sets, ArrayBuffers (bytes), typed arrays and
+// DataViews (buffer identity, offset, length, elements), null-prototype objects, class instances
+// (by constructor name), URL/URLSearchParams and Temporal values (by their string form). It
+// uses `Object.prototype.toString` tags rather than `instanceof`, so values built in another
+// realm (node:vm) compare with the host's.
+
+function prim(x) {
+  if (typeof x === "number") return Object.is(x, -0) ? "-0" : String(x);
+  if (typeof x === "bigint") return x + "n";
+  if (typeof x === "string") return JSON.stringify(x);
+  if (x === undefined) return "undefined";
+  if (x === null) return "null";
+  if (typeof x === "boolean") return String(x);
+  if (typeof x === "symbol") return x.toString();
+  return null;
+}
+
+export function canon(v, options = {}) {
+  const seen = new Map();
+  let next = 0;
+  function go(x) {
+    const p = prim(x);
+    if (p !== null) return p;
+    if (typeof x === "function") return "function";
+    if (seen.has(x)) return "@" + seen.get(x);
+    const id = next++;
+    seen.set(x, id);
+    const head = "#" + id;
+    const tag = Object.prototype.toString.call(x).slice(8, -1);
+    switch (tag) {
+      case "Number":
+      case "String":
+      case "Boolean":
+      case "BigInt":
+        return head + tag + "(" + prim(x.valueOf()) + ")";
+      case "Date":
+        return head + "Date(" + prim(x.getTime()) + ")";
+      case "RegExp":
+        return head + "RegExp(" + JSON.stringify(x.source) + "," + x.flags + ")";
+      case "URL":
+        return head + "URL(" + JSON.stringify(x.href) + ")";
+      case "URLSearchParams":
+        return head + "URLSearchParams(" + JSON.stringify(x.toString()) + ")";
+      case "ArrayBuffer":
+        return head + "ArrayBuffer[" + Array.from(new Uint8Array(x)).join(",") + "]";
+      case "DataView":
+        return head + "DataView(" + go(x.buffer) + "," + x.byteOffset + "," + x.byteLength + ")";
+      case "Map":
+        return head + "Map{" + [...x].map(([k, y]) => go(k) + "=>" + go(y)).join(",") + "}";
+      case "Set":
+        return head + "Set{" + [...x].map(go).join(",") + "}";
+      case "Array": {
+        const parts = [];
+        for (let i = 0; i < x.length; i++) parts.push(i in x ? go(x[i]) : "<hole>");
+        return head + "[" + parts.join(",") + "]";
+      }
+      case "Promise":
+        return head + "Promise";
+    }
+    if (ArrayBuffer.isView(x)) {
+      const elements = Array.from(x, (e) => prim(e)).join(",");
+      return head + tag + "(" + go(x.buffer) + "," + x.byteOffset + "," + x.length + ")[" + elements + "]";
+    }
+    if (tag.startsWith("Temporal.")) return head + tag + "(" + JSON.stringify(x.toString()) + ")";
+    const proto = Object.getPrototypeOf(x);
+    let name = "";
+    if (proto === null) name = options.nullProtoAsPlain ? "" : "null";
+    else if (!(proto.constructor && proto.constructor.name === "Object" && Object.getPrototypeOf(proto) === null)) {
+      name = (proto.constructor && proto.constructor.name) || "?";
+    }
+    const body = Object.keys(x).map((k) => JSON.stringify(k) + ":" + go(x[k])).join(",");
+    return head + name + "{" + body + "}";
+  }
+  return go(v);
+}
+
+/** The first index at which two renderings differ, with context, for messages. */
+export function diff(a, b) {
+  if (a === b) return "equal";
+  let i = 0;
+  while (i < a.length && i < b.length && a[i] === b[i]) i++;
+  const cut = (s) => (s.length > 160 ? s.slice(0, 160) + "..." : s);
+  return `differ at ${i}:\n  expected ...${cut(a.slice(Math.max(0, i - 40)))}\n  actual   ...${cut(b.slice(Math.max(0, i - 40)))}`;
+}
diff --git a/hegel/gen.mjs b/hegel/gen.mjs
new file mode 100644
index 0000000..4824f81
--- /dev/null
+++ b/hegel/gen.mjs
@@ -0,0 +1,311 @@
+// Hegel zoo: generators of JavaScript values for the devalue properties.
+//
+// `value(tc, shape)` builds a value graph of the kinds devalue documents (README "Like
+// JSON.stringify, but handles ..."): primitives including undefined/NaN/-0/BigInt, strings with
+// the characters that matter to embedding (`<`, U+2028, quotes, controls, optionally lone
+// surrogates), Dates over the whole range (and invalid), RegExps, boxed primitives, ArrayBuffers
+// and views (typed arrays, DataViews, subarrays over shared buffers), Maps with any keys, Sets,
+// arrays with holes, plain and null-prototype objects, URL/URLSearchParams and Temporal values,
+// and, with `shape.share`, repeated references and cycles. `shape` names what may appear so a
+// property can stay inside the value space its oracle supports.
+
+import { chance, n, pick, word } from "./hegel-zoo.mjs";
+
+export const FULL = Object.freeze({
+  undefined: true, bigint: true, date: true, regexp: true, boxed: true, bin: true, map: true, set: true,
+  nullProto: true, url: true, temporal: true, sparse: true, share: true, loneSurrogates: true,
+});
+
+/** shape minus some keys. */
+export function without(shape, ...keys) {
+  const s = { ...shape };
+  for (const k of keys) delete s[k];
+  return Object.freeze(s);
+}
+
+const CHARS = ["a", "b", "z", "A", "0", "9", " ", "_", "$", "-", ".", "/", "<", ">", "&", "'", "\"", "`", "\\", "\n", "\r", "\t",
+  "\b", "\f", "\0", "\x01", "\x1f", "\x7f", "", " ", " ", " ", "﻿", "￿", "é", "ß",
+  "中", "퟿", "", "\u{1F600}", "\u{10FFFF}", "</script>", "<!--", "-->", "${", "\\u003C", "\\n"];
+const LONE = ["\ud800", "\udc00", "\udbff", "\udfff", "\ud83d"];
+
+/** A string; with shape.loneSurrogates it may contain unpaired surrogates. */
+export function str(tc, shape = {}) {
+  const alphabet = shape.loneSurrogates && chance(tc, 30) ? [...CHARS, ...LONE] : CHARS;
+  const r = n(tc, 0, 99);
+  if (r < 70) return word(tc, alphabet, 0, 6);
+  if (r < 95) return word(tc, alphabet, 7, 30);
+  return word(tc, ["a", "é", "\u{1F600}"], 200, 2000);
+}
+
+const KEYS = ["a", "b", "c", "k", "x", "y", "_", "$", "$x", "b_1", "if", "class", "let", "null", "true", "void", "in", "do",
+  "0", "1", "2", "10", "01", "-1", "1.5", "4294967295", "4294967296", "", " ", "a b", "<x>", "\"q\"", "'q'", "\n", "\\",
+  "é", "中", "\u{1F600}", " ", "constructor", "prototype", "hasOwnProperty", "toString", "valueOf",
+  "then", "__proto_", "__PROTO__", "proto", "length", "get", "set", "Map", "Object", "NaN", "undefined"];
+
+/** An object key (never `__proto__`, which devalue rejects by design). */
+export function key(tc, shape = {}) {
+  return chance(tc, 80) ? pick(tc, KEYS) : str(tc, shape);
+}
+
+const SPECIAL_NUMBERS = [0, -0, 1, -1, 0.5, -0.5, 0.1, 1 / 3, 1e21, 1e-7, 5e-324, 1.7976931348623157e308, 2 ** 53, -(2 ** 53),
+  2 ** 31, -(2 ** 31), 4294967295, 4294967296, 123456789.125, NaN, Infinity, -Infinity, 7.99, 1e300, -1e-300];
+
+/** A number: the special values, small integers, or a random double. */
+export function num(tc) {
+  const r = n(tc, 0, 99);
+  if (r < 45) return pick(tc, SPECIAL_NUMBERS);
+  if (r < 75) return n(tc, -1000, 1000);
+  const m = n(tc, 0, 2 ** 52) + n(tc, 0, 2 ** 52);
+  const e = n(tc, -70, 70);
+  const v = (chance(tc, 40) ? -1 : 1) * m * 2 ** e;
+  return Number.isFinite(v) ? v : 2.5;
+}
+
+export function big(tc) {
+  const r = n(tc, 0, 99);
+  if (r < 40) return pick(tc, [0n, 1n, -1n, 2n ** 63n, -(2n ** 63n), 2n ** 64n, 10n ** 30n, -(10n ** 40n), 2n ** 53n + 1n]);
+  return BigInt(n(tc, -(2 ** 40), 2 ** 40)) * (chance(tc, 30) ? 1000000007n : 1n);
+}
+
+/** A Date anywhere in the range, sometimes invalid. */
+export function date(tc) {
+  const r = n(tc, 0, 99);
+  if (r < 10) return new Date(NaN);
+  if (r < 40) return new Date(pick(tc, [0, -1, 1, 8.64e15, -8.64e15, -62135596800000, 253402300799999, 951782400000, 1e12 + 123]));
+  return new Date((chance(tc, 30) ? -1 : 1) * n(tc, 0, 8.64e15));
+}
+
+const SOURCES = ["a", "(?:)", "a\\/b", "[a-z]+<", "^x$", "\\d{2,}", "(?<n>a)|b", "\\u2028", "\\p{L}", "[\\q{ab}]", ".*", "a|", "(a)(b)\\2", "\\/", "[/]", "\\n\\r"];
+const FLAGS = ["", "g", "i", "gi", "m", "s", "y", "d", "u", "v", "gimsy", "dgimsuy", "dgimsvy"];
+
+export function regexp(tc) {
+  for (let tries = 0; tries < 5; tries++) {
+    const source = chance(tc, 80) ? pick(tc, SOURCES) : str(tc);
+    const flags = pick(tc, FLAGS);
+    try {
+      return new RegExp(source, flags);
+    } catch {
+      // an invalid combination: try again
+    }
+  }
+  return /a/g;
+}
+
+export function boxed(tc, shape) {
+  const r = n(tc, 0, 99);
+  if (r < 35) return Object(num(tc));
+  if (r < 65) return Object(str(tc, shape));
+  if (r < 80) return Object(chance(tc, 50));
+  return Object(big(tc));
+}
+
+const TYPED = [Int8Array, Uint8Array, Uint8ClampedArray, Int16Array, Uint16Array, Int32Array, Uint32Array, Float32Array, Float64Array, BigInt64Array, BigUint64Array];
+
+function fillView(tc, view) {
+  for (let i = 0; i < view.length; i++) {
+    if (view instanceof BigInt64Array || view instanceof BigUint64Array) view[i] = BigInt.asIntN(64, big(tc));
+    else if (view instanceof Float32Array || view instanceof Float64Array) view[i] = num(tc);
+    else view[i] = n(tc, -300, 300);
+  }
+}
+
+/** A typed array, possibly a view at an offset into a larger buffer (aligned; with shape.oddBuffers the buffer's length need not be a multiple of the element size). */
+export function typedArray(tc, shape = {}, buffer) {
+  const Ctor = pick(tc, TYPED);
+  const bpe = Ctor.BYTES_PER_ELEMENT;
+  const len = n(tc, 0, 6);
+  if (buffer) {
+    const room = Math.floor(buffer.byteLength / bpe);
+    const l = Math.min(len, room);
+    const off = n(tc, 0, room - l) * bpe;
+    const v = new Ctor(buffer, off, l);
+    return v;
+  }
+  const before = chance(tc, 30) ? n(tc, 1, 3) : 0;
+  const after = chance(tc, 30) ? n(tc, 1, 3) : 0;
+  let bytes = (before + len + after) * bpe;
+  if (shape.oddBuffers && bpe > 1 && chance(tc, 70)) bytes += n(tc, 1, bpe - 1);
+  const buf = new ArrayBuffer(bytes);
+  new Uint8Array(buf).fill(0xee);
+  const v = new Ctor(buf, before * bpe, len);
+  fillView(tc, v);
+  return v;
+}
+
+export function arrayBuffer(tc, multiple = 1) {
+  let len = chance(tc, 80) ? n(tc, 0, 12) : pick(tc, [63, 64, 65, 300]);
+  len = Math.ceil(len / multiple) * multiple;
+  const b = new ArrayBuffer(len);
+  const u = new Uint8Array(b);
+  for (let i = 0; i < len; i++) u[i] = n(tc, 0, 255);
+  return b;
+}
+
+/** Binary: an ArrayBuffer, a typed array, a DataView, or several views sharing one buffer. */
+export function bin(tc, shape) {
+  const r = n(tc, 0, 99);
+  if (r < 15) return arrayBuffer(tc);
+  if (r < 70) return typedArray(tc, shape);
+  if (r < 85) {
+    const b = arrayBuffer(tc);
+    const off = n(tc, 0, b.byteLength);
+    const len = n(tc, 0, b.byteLength - off);
+    return chance(tc, 50) ? new DataView(b, off, len) : new DataView(b);
+  }
+  // several views over one buffer (a multiple of every element size unless odd buffers are wanted)
+  const b = arrayBuffer(tc, shape.oddBuffers ? 1 : 8);
+  const views = [];
+  const k = n(tc, 2, 3);
+  for (let i = 0; i < k; i++) views.push(chance(tc, 80) ? typedArray(tc, shape, b) : new DataView(b, 0, b.byteLength));
+  if (chance(tc, 30)) views.push(b);
+  return views;
+}
+
+const TZ = ["UTC", "Europe/Paris", "America/New_York", "Asia/Kolkata", "Pacific/Apia", "+05:30", "-08:00", "Etc/GMT+3"];
+// (not "chinese": the polyfill's month-day conversions throw "Unexpected leap month suffix")
+const CALENDARS = ["iso8601", "gregory", "hebrew", "japanese", "islamic-civil"];
+
+/** A Temporal value (the polyfill's classes, installed on globalThis by the test). */
+export function temporal(tc) {
+  const T = globalThis.Temporal;
+  const iso = T.PlainDateTime.from({
+    year: n(tc, -1000, 3000), month: n(tc, 1, 12), day: n(tc, 1, 28), hour: n(tc, 0, 23), minute: n(tc, 0, 59),
+    second: n(tc, 0, 59), millisecond: n(tc, 0, 999), microsecond: n(tc, 0, 999), nanosecond: n(tc, 0, 999),
+  });
+  const cal = chance(tc, 25) ? pick(tc, CALENDARS) : "iso8601";
+  const r = n(tc, 0, 99);
+  if (r < 15) return iso.toPlainDate().withCalendar(cal);
+  if (r < 25) return iso.toPlainTime();
+  if (r < 40) return iso.withCalendar(cal);
+  if (r < 55) return iso.toZonedDateTime("UTC").toInstant().add({ nanoseconds: n(tc, -999, 999) });
+  if (r < 70) return iso.toZonedDateTime(pick(tc, TZ)).withCalendar(cal);
+  if (r < 80) return iso.toPlainDate().withCalendar(cal).toPlainYearMonth();
+  if (r < 88) return iso.toPlainDate().withCalendar(cal).toPlainMonthDay();
+  const sign = chance(tc, 30) ? -1 : 1;
+  const f = () => (chance(tc, 50) ? 0 : sign * n(tc, 0, 40));
+  return T.Duration.from({
+    years: f(), months: f(), weeks: f(), days: f(), hours: f(), minutes: f(),
+    seconds: chance(tc, 20) ? sign * n(tc, 0, 2 ** 40) : f(), milliseconds: f(), microseconds: f(), nanoseconds: f(),
+  });
+}
+
+const HOSTS = ["example.com", "EXAMPLE.com", "xn--nxasmq6b.com", "é.com", "[::1]", "127.0.0.1", "a.b.c", "localhost"];
+const SCHEMES = ["http", "https", "ftp", "ws", "file", "blob", "foo"];
+
+export function url(tc, shape) {
+  const r = n(tc, 0, 99);
+  let text;
+  if (r < 10) text = pick(tc, ["data:text/plain,hi<>", "mailto:a@b.c", "javascript:alert(1)", "file:///tmp/a%20b", "about:blank", "http://a/%zz", "http://a/b/../c/./d"]);
+  else text = `${pick(tc, SCHEMES)}://${chance(tc, 20) ? "u:p@" : ""}${pick(tc, HOSTS)}${chance(tc, 30) ? ":" + n(tc, 1, 65535) : ""}/${word(tc, ["a", "b", "/", " ", "%20", "é", "?", "#", "<", ".", ".."], 0, 8)}${chance(tc, 50) ? "?" + word(tc, ["a", "=", "&", "b", " ", "+", "é", "<"], 0, 8) : ""}${chance(tc, 40) ? "#" + word(tc, ["f", "<", " ", "é"], 0, 4) : ""}`;
+  try {
+    return new URL(text);
+  } catch {
+    return new URL("http://example.com/fallback");
+  }
+}
+
+export function searchParams(tc, shape) {
+  const entries = [];
+  const k = n(tc, 0, 5);
+  const alphabet = ["a", "b", " ", "+", "%20", "%", "&", "=", "é", "\u{1F600}", "<", "\n", "\0"];
+  for (let i = 0; i < k; i++) entries.push([word(tc, alphabet, 0, 4), word(tc, alphabet, 0, 4)]);
+  return new URLSearchParams(entries);
+}
+
+/** A primitive (or boxed primitive / Date / RegExp / binary: the leaves). */
+export function leaf(tc, shape) {
+  const r = n(tc, 0, 99);
+  if (r < 6) return null;
+  if (r < 12) return chance(tc, 50);
+  if (r < 34) return num(tc);
+  if (r < 52) return str(tc, shape);
+  if (r < 58 && shape.undefined) return undefined;
+  if (r < 64 && shape.bigint) return big(tc);
+  if (r < 71 && shape.date) return date(tc);
+  if (r < 76 && shape.regexp) return regexp(tc);
+  if (r < 81 && shape.boxed) return boxed(tc, shape);
+  if (r < 89 && shape.bin) return bin(tc, shape);
+  if (r < 93 && shape.url) return chance(tc, 60) ? url(tc, shape) : searchParams(tc, shape);
+  if (r < 97 && shape.temporal) return temporal(tc);
+  return str(tc, shape);
+}
+
+/** A Map key: mostly primitives (including NaN, -0, undefined, bigint), sometimes a container. */
+function mapKey(tc, depth, shape, ctx) {
+  if (chance(tc, 20) && depth < 3) return value(tc, depth + 1, shape, ctx);
+  return leaf(tc, shape);
+}
+
+function array(tc, depth, shape, ctx) {
+  const r = n(tc, 0, 99);
+  const a = [];
+  ctx.pool.push(a);
+  if (shape.sparse && r < 25) {
+    // holes: dense-ish, or very sparse (the encodings differ)
+    const len = chance(tc, 70) ? n(tc, 0, 12) : n(tc, 13, 400);
+    a.length = len;
+    const filled = n(tc, 0, Math.min(len, 8));
+    for (let i = 0; i < filled; i++) a[n(tc, 0, Math.max(0, len - 1))] = value(tc, depth + 1, shape, ctx);
+    if (len > 0 && chance(tc, 30)) a[len - 1] = value(tc, depth + 1, shape, ctx);
+    return a;
+  }
+  const size = r < 80 ? n(tc, 0, 5) : n(tc, 6, 30);
+  for (let i = 0; i < size; i++) a.push(value(tc, depth + 1, shape, ctx));
+  return a;
+}
+
+function object(tc, depth, shape, ctx) {
+  const o = shape.nullProto && chance(tc, 15) ? Object.create(null) : {};
+  ctx.pool.push(o);
+  const size = chance(tc, 80) ? n(tc, 0, 5) : n(tc, 6, 25);
+  for (let i = 0; i < size; i++) {
+    const k = key(tc, shape);
+    if (k === "__proto__") continue;
+    o[k] = value(tc, depth + 1, shape, ctx);
+  }
+  return o;
+}
+
+function map(tc, depth, shape, ctx) {
+  const m = new Map();
+  ctx.pool.push(m);
+  const size = n(tc, 0, 5);
+  for (let i = 0; i < size; i++) m.set(mapKey(tc, depth, shape, ctx), value(tc, depth + 1, shape, ctx));
+  return m;
+}
+
+function set(tc, depth, shape, ctx) {
+  const s = new Set();
+  ctx.pool.push(s);
+  const size = n(tc, 0, 5);
+  for (let i = 0; i < size; i++) s.add(chance(tc, 70) ? leaf(tc, shape) : value(tc, depth + 1, shape, ctx));
+  return s;
+}
+
+/** A value of the shape, nesting up to depth 4; with shape.share, sometimes a reference to a container made earlier (a repeated reference or, if it is an ancestor, a cycle). */
+export function value(tc, depth, shape, ctx = { pool: [] }) {
+  if (shape.share && ctx.pool.length > 0 && chance(tc, 12)) return pick(tc, ctx.pool);
+  if (shape.custom && chance(tc, 8)) return shape.custom(tc);
+  const r = n(tc, 0, 99);
+  if (depth >= 4 || r < 50) return leaf(tc, shape);
+  if (r < 70) return array(tc, depth, shape, ctx);
+  if (r < 88 || !(shape.map || shape.set)) return object(tc, depth, shape, ctx);
+  if (shape.map && (!shape.set || chance(tc, 50))) return map(tc, depth, shape, ctx);
+  return set(tc, depth, shape, ctx);
+}
+
+/** A top-level container (object, array, Map or Set) of the shape. */
+export function container(tc, shape) {
+  const ctx = { pool: [] };
+  const r = n(tc, 0, 99);
+  if (r < 45) return object(tc, 0, shape, ctx);
+  if (r < 80) return array(tc, 0, shape, ctx);
+  if (r < 90 && shape.map) return map(tc, 0, shape, ctx);
+  if (shape.set) return set(tc, 0, shape, ctx);
+  return array(tc, 0, shape, ctx);
+}
+
+/** Any value of the shape: a container 80% of the time, else a leaf. */
+export function any(tc, shape) {
+  return chance(tc, 80) ? container(tc, shape) : leaf(tc, shape);
+}
diff --git a/hegel/hegel-zoo.mjs b/hegel/hegel-zoo.mjs
new file mode 100644
index 0000000..1ca6f10
--- /dev/null
+++ b/hegel/hegel-zoo.mjs
@@ -0,0 +1,163 @@
+// Hegel zoo: the small harness shared by the zoo's TypeScript/JavaScript targets.
+//
+// `property(name, body)` registers a node:test test that runs `body(tc)` under Hegel with
+// HEGEL_TEST_CASES cases (default 100) and the database at HEGEL_DATABASE. With ZOO_COLLECT=1
+// a `fail()` records the mismatch instead of failing, the case ends there, and the counts of
+// mismatches and of the shapes seen (`count(key)`) are printed at the end of the test, so a
+// property can be run over many cases to see every shape at once. `pin(name, body)` is a
+// plain test for one pinned bug: it must fail while the bug is present and pass once it is
+// fixed (the zoo's judge reads an unexpected pass as "fixed upstream?").
+
+import { readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+import { test as nodeTest } from "node:test";
+
+// The Hegel version these tests were written against (the zoo pins it in zoo.toml; upstream
+// would add it to devDependencies). Hegel and esbuild are installed with `npm install --prefix
+// .hegel` so the target's own package.json and lock file stay untouched. Checked at load time so
+// a stray install cannot silently change the engine.
+export const HEGEL_PIN = { "@hegeldev/hegel": "0.4.5" };
+
+const hegelDir = join(dirname(fileURLToPath(import.meta.url)), "..", ".hegel", "node_modules", "@hegeldev", "hegel");
+{
+  const installed = JSON.parse(readFileSync(join(hegelDir, "package.json"), "utf8")).version;
