diff --git a/hegel/canon.mjs b/hegel/canon.mjs
new file mode 100644
index 0000000..a4b27a5
--- /dev/null
+++ b/hegel/canon.mjs
@@ -0,0 +1,91 @@
+// Hegel zoo: a canonical rendering of a JavaScript value graph.
+//
+// `canon(v)` renders a value so that two graphs render the same text exactly when they are
+// structurally equal *including identity structure*: every object gets a label `#k` in
+// depth-first order and a later reference to the same object renders as `@k`, so shared
+// references and cycles are compared, not just contents. It distinguishes -0, NaN, bigints,
+// boxed primitives, Dates (by time value, NaN for an invalid one), RegExps (source and flags),
+// arrays with holes, Maps (entries in order), Sets, ArrayBuffers (bytes), typed arrays and
+// DataViews (buffer identity, offset, length, elements), null-prototype objects, class instances
+// (by constructor name), URL/URLSearchParams and Temporal values (by their string form). It
+// uses `Object.prototype.toString` tags rather than `instanceof`, so values built in another
+// realm (node:vm) compare with the host's.
+
+function prim(x) {
+  if (typeof x === "number") return Object.is(x, -0) ? "-0" : String(x);
+  if (typeof x === "bigint") return x + "n";
+  if (typeof x === "string") return JSON.stringify(x);
+  if (x === undefined) return "undefined";
+  if (x === null) return "null";
+  if (typeof x === "boolean") return String(x);
+  if (typeof x === "symbol") return x.toString();
+  return null;
+}
+
+export function canon(v, options = {}) {
+  const seen = new Map();
+  let next = 0;
+  function go(x) {
+    const p = prim(x);
+    if (p !== null) return p;
+    if (typeof x === "function") return "function";
+    if (seen.has(x)) return "@" + seen.get(x);
+    const id = next++;
+    seen.set(x, id);
+    const head = "#" + id;
+    const tag = Object.prototype.toString.call(x).slice(8, -1);
+    switch (tag) {
+      case "Number":
+      case "String":
+      case "Boolean":
+      case "BigInt":
+        return head + tag + "(" + prim(x.valueOf()) + ")";
+      case "Date":
+        return head + "Date(" + prim(x.getTime()) + ")";
+      case "RegExp":
+        return head + "RegExp(" + JSON.stringify(x.source) + "," + x.flags + ")";
+      case "URL":
+        return head + "URL(" + JSON.stringify(x.href) + ")";
+      case "URLSearchParams":
+        return head + "URLSearchParams(" + JSON.stringify(x.toString()) + ")";
+      case "ArrayBuffer":
+        return head + "ArrayBuffer[" + Array.from(new Uint8Array(x)).join(",") + "]";
+      case "DataView":
+        return head + "DataView(" + go(x.buffer) + "," + x.byteOffset + "," + x.byteLength + ")";
+      case "Map":
+        return head + "Map{" + [...x].map(([k, y]) => go(k) + "=>" + go(y)).join(",") + "}";
+      case "Set":
+        return head + "Set{" + [...x].map(go).join(",") + "}";
+      case "Array": {
+        const parts = [];
+        for (let i = 0; i < x.length; i++) parts.push(i in x ? go(x[i]) : "<hole>");
+        return head + "[" + parts.join(",") + "]";
+      }
+      case "Promise":
+        return head + "Promise";
+    }
+    if (ArrayBuffer.isView(x)) {
+      const elements = Array.from(x, (e) => prim(e)).join(",");
+      return head + tag + "(" + go(x.buffer) + "," + x.byteOffset + "," + x.length + ")[" + elements + "]";
+    }
+    if (tag.startsWith("Temporal.")) return head + tag + "(" + JSON.stringify(x.toString()) + ")";
+    const proto = Object.getPrototypeOf(x);
+    let name = "";
+    if (proto === null) name = options.nullProtoAsPlain ? "" : "null";
+    else if (!(proto.constructor && proto.constructor.name === "Object" && Object.getPrototypeOf(proto) === null)) {
+      name = (proto.constructor && proto.constructor.name) || "?";
+    }
+    const body = Object.keys(x).map((k) => JSON.stringify(k) + ":" + go(x[k])).join(",");
+    return head + name + "{" + body + "}";
+  }
+  return go(v);
+}
+
+/** The first index at which two renderings differ, with context, for messages. */
+export function diff(a, b) {
+  if (a === b) return "equal";
+  let i = 0;
+  while (i < a.length && i < b.length && a[i] === b[i]) i++;
+  const cut = (s) => (s.length > 160 ? s.slice(0, 160) + "..." : s);
+  return `differ at ${i}:\n  expected ...${cut(a.slice(Math.max(0, i - 40)))}\n  actual   ...${cut(b.slice(Math.max(0, i - 40)))}`;
+}
diff --git a/hegel/gen.mjs b/hegel/gen.mjs
new file mode 100644
index 0000000..0eecc48
--- /dev/null
+++ b/hegel/gen.mjs
@@ -0,0 +1,501 @@
+// Hegel zoo: the generators behind the devalue properties, as values built from Hegel's
+// combinators, and the pure function that builds the value graph they describe.
+//
+// A value graph is drawn as a small tree. Its leaves are the kinds devalue documents (README
+// "Like JSON.stringify, but handles ..."): primitives including undefined/NaN/-0/BigInt, strings
+// with the characters that matter to embedding (`<`, U+2028, quotes, controls; with
+// `shape.loneSurrogates` unpaired surrogates), Dates over the whole range and invalid, RegExps,
+// boxed primitives, ArrayBuffers and views (typed arrays, DataViews, several views over one
+// buffer; with `shape.oddBuffers` over buffers whose length is no multiple of the element size),
+// URL/URLSearchParams and Temporal values; its containers (array, dense or with holes, plain or
+// null-prototype object, Map with any keys, Set) hold child nodes; and with `shape.share` a node
+// may be a reference to an earlier container by index. `build` renders the tree depth first and
+// resolves a reference against the containers built so far (the index taken modulo their
+// number), so a reference to an ancestor is a cycle and one to a finished container a repeated
+// reference. `shape` names what may appear so a property can stay inside the value space its
+// oracle supports; `shape.custom` is a generator of values a reducer/replacer handles.
+
+import { gs } from "./hegel-zoo.mjs";
+
+// ---------------------------------------------------------------- generator helpers
+
+export const ints = (lo, hi) => gs.integers({ minValue: lo, maxValue: hi });
+
+/** oneOf with weights: `weighted([45, a], [55, b])` draws a 45 times in 100; shrinks towards the first choice. */
+export function weighted(...choices) {
+  if (choices.length === 1) return choices[0][1];
+  const total = choices.reduce((sum, [w]) => sum + w, 0);
+  return ints(0, total - 1).flatMap((r) => {
+    for (const [w, g] of choices) {
+      if (r < w) return g;
+      r -= w;
+    }
+    throw new Error("unreachable");
+  });
+}
+
+/** True pct percent of the time; shrinks to false. */
+export const chance = (pct) => ints(0, 99).map((r) => r >= 100 - pct);
+/** A draw from g pct percent of the time, else undefined (listed first: shrinks to absent). */
+export const maybe = (pct, g) => weighted([100 - pct, gs.just(undefined)], [pct, g]);
+/** lo-hi pieces of `pool` (strings of one or more characters) concatenated. */
+const pieces = (pool, lo, hi) => gs.arrays(gs.sampledFrom(pool), { minSize: lo, maxSize: hi }).map((xs) => xs.join(""));
+/** A record of kind `k` with the given fields. */
+const node = (k, fields) => gs.record({ k: gs.just(k), ...fields });
+
+// ---------------------------------------------------------------- shapes
+
+export const FULL = Object.freeze({
+  undefined: true, bigint: true, date: true, regexp: true, boxed: true, bin: true, map: true, set: true,
+  nullProto: true, url: true, temporal: true, sparse: true, share: true, loneSurrogates: true,
+});
+
+/** shape minus some keys. */
+export function without(shape, ...keys) {
+  const s = { ...shape };
+  for (const k of keys) delete s[k];
+  return Object.freeze(s);
+}
+
+// ---------------------------------------------------------------- strings and keys
+
+const CHARS = ["a", "b", "z", "A", "0", "9", " ", "_", "$", "-", ".", "/", "<", ">", "&", "'", "\"", "`", "\\", "\n", "\r", "\t",
+  "\b", "\f", "\0", "\x01", "\x1f", "\x7f", "\u0085", "\u00a0", "\u2028", "\u2029", "\ufeff", "\uffff", "\u00e9", "\u00df",
+  "\u4e2d", "\ud7ff", "\ue000", "\u{1F600}", "\u{10FFFF}", "</script>", "<!--", "-->", "${", "\\u003C", "\\n"];
+const LONE = ["\ud800", "\udc00", "\udbff", "\udfff", "\ud83d"];
+
+/** 0-6 pieces of `pool` 70% of the time, 7-30 pieces 25%, else 200-2000 characters of a three-letter alphabet. */
+const wordsFrom = (pool) => weighted([70, pieces(pool, 0, 6)], [25, pieces(pool, 7, 30)], [5, gs.text({ alphabet: "a\u00e9\u{1F600}", minSize: 200, maxSize: 2000 })]);
+const plainWords = wordsFrom(CHARS);
+const surrogateWords = wordsFrom([...CHARS, ...LONE]);
+/** A string of the characters that matter to embedding (`<`, U+2028/2029, quotes, controls, a BOM, non-ASCII, astral). */
+export const str = plainWords;
+/** A string; with shape.loneSurrogates it is drawn from a pool with unpaired surrogates 30% of the time. */
+const strFor = (shape) => (shape.loneSurrogates ? weighted([70, plainWords], [30, surrogateWords]) : plainWords);
+
+// Object keys: reserved words, numeric, empty, prototype-ish names; never `__proto__`, which
+// devalue refuses by design (no pool here spells it: CHARS has no p, r, o or t).
+const KEYS = ["a", "b", "c", "k", "x", "y", "_", "$", "$x", "b_1", "if", "class", "let", "null", "true", "void", "in", "do",
+  "0", "1", "2", "10", "01", "-1", "1.5", "4294967295", "4294967296", "", " ", "a b", "<x>", "\"q\"", "'q'", "\n", "\\",
+  "\u00e9", "\u4e2d", "\u{1F600}", "\u2028", "constructor", "prototype", "hasOwnProperty", "toString", "valueOf",
+  "then", "__proto_", "__PROTO__", "proto", "length", "get", "set", "Map", "Object", "NaN", "undefined"];
+
+/** An object key: one of KEYS 80% of the time, else a string. */
+export const key = (shape = {}) => weighted([80, gs.sampledFrom(KEYS)], [20, strFor(shape)]);
+
+// ---------------------------------------------------------------- numbers, bigints, dates
+
+const SPECIAL_NUMBERS = [0, -0, 1, -1, 0.5, -0.5, 0.1, 1 / 3, 1e21, 1e-7, 5e-324, 1.7976931348623157e308, 2 ** 53, -(2 ** 53),
+  2 ** 31, -(2 ** 31), 4294967295, 4294967296, 123456789.125, NaN, Infinity, -Infinity, 7.99, 1e300, -1e-300];
+
+/** A random double: a 53-bit mantissa (two draws), a binary exponent in -70..70 and a sign (2.5 when it overflows). */
+const anyDouble = gs.record({ a: ints(0, 2 ** 52), b: ints(0, 2 ** 52), e: ints(-70, 70), negative: chance(40) }).map(({ a, b, e, negative }) => {
+  const v = (negative ? -1 : 1) * (a + b) * 2 ** e;
+  return Number.isFinite(v) ? v : 2.5;
+});
+/** A number: one of the special values 45% of the time, a small integer 30%, else a random double. */
+export const num = weighted([45, gs.sampledFrom(SPECIAL_NUMBERS)], [30, ints(-1000, 1000)], [25, anyDouble]);
+
+/** A bigint: a boundary value 40% of the time, else a 41-bit integer, 30% of the time times a large prime. */
+const big = weighted(
+  [40, gs.sampledFrom([0n, 1n, -1n, 2n ** 63n, -(2n ** 63n), 2n ** 64n, 10n ** 30n, -(10n ** 40n), 2n ** 53n + 1n])],
+  [60, gs.tuples(ints(-(2 ** 40), 2 ** 40), chance(30)).map(([x, prime]) => BigInt(x) * (prime ? 1000000007n : 1n))],
+);
+
+const DATE_TIMES = [0, -1, 1, 8.64e15, -8.64e15, -62135596800000, 253402300799999, 951782400000, 1e12 + 123];
+/** A Date: a boundary 30% of the time, anywhere in the range 60% (negative 30%), invalid 10%. */
+const date = weighted([30, gs.sampledFrom(DATE_TIMES)], [60, gs.tuples(chance(30), ints(0, 8.64e15)).map(([negative, t]) => (negative ? -t : t))], [10, gs.just(NaN)]).map((t) => new Date(t));
+
+// ---------------------------------------------------------------- RegExps and boxed primitives
+
+const SOURCES = ["a", "(?:)", "a\\/b", "[a-z]+<", "^x$", "\\d{2,}", "(?<n>a)|b", "\\u2028", "\\p{L}", "[\\q{ab}]", ".*", "a|", "(a)(b)\\2", "\\/", "[/]", "\\n\\r"];
+const FLAGS = ["", "g", "i", "gi", "m", "s", "y", "d", "u", "v", "gimsy", "dgimsuy", "dgimsvy"];
+
+/** A RegExp from a drawn source (one of SOURCES 80% of the time, else a string) and flags; an invalid combination falls back to the flags that take the source, then to the source `a`. */
+const regexp = gs.tuples(weighted([80, gs.sampledFrom(SOURCES)], [20, plainWords]), gs.sampledFrom(FLAGS)).map(([source, flags]) => {
+  for (const [s, f] of [[source, flags], [source, "v"], [source, "u"], ["a", flags]]) {
+    try {
+      return new RegExp(s, f);
+    } catch {
+      // an invalid combination: the next
+    }
+  }
+  return /a/g;
+});
+
+/** A boxed number, string, boolean or bigint. */
+const boxed = (shape) => weighted([35, num], [30, strFor(shape)], [15, gs.booleans()], [20, big]).map((v) => Object(v));
+
+// ---------------------------------------------------------------- binary
+
+/** The bytes of a buffer: 0-12 of them 80% of the time, else 63, 64, 65 or 300. */
+const bytes = weighted([80, gs.binary({ maxSize: 12 })], [20, gs.sampledFrom([63, 64, 65, 300]).flatMap((len) => gs.binary({ minSize: len, maxSize: len }))]);
+
+/** A buffer holding `bs`, its length rounded up to a multiple of `multiple`. */
+function bufferOf(bs, multiple = 1) {
+  const b = new ArrayBuffer(Math.ceil(bs.length / multiple) * multiple);
+  new Uint8Array(b).set(bs);
+  return b;
+}
+const arrayBuffer = bytes.map((bs) => bufferOf(bs));
+
+/** A DataView over a buffer, 50% of the time over a part of it (offset and length taken modulo what fits). */
+const dataView = gs.record({ bytes, range: maybe(50, gs.tuples(ints(0, 99), ints(0, 99))) }).map(({ bytes, range }) => {
+  const b = bufferOf(bytes);
+  if (range === undefined) return new DataView(b);
+  const offset = range[0] % (b.byteLength + 1);
+  return new DataView(b, offset, range[1] % (b.byteLength - offset + 1));
+});
+
+const TYPED = [Int8Array, Uint8Array, Uint8ClampedArray, Int16Array, Uint16Array, Int32Array, Uint32Array, Float32Array, Float64Array, BigInt64Array, BigUint64Array];
+const BIG_TYPED = new Set([BigInt64Array, BigUint64Array]);
+const FLOAT_TYPED = new Set([Float32Array, Float64Array]);
+/** An element of a `Ctor` array: a 64-bit bigint, a number, or a small integer. */
+const elementOf = (Ctor) => (BIG_TYPED.has(Ctor) ? big.map((x) => BigInt.asIntN(64, x)) : FLOAT_TYPED.has(Ctor) ? num : ints(-300, 300));
+/** The backing store's extra elements before or after a view: none 70% of the time, else 1-3. */
+const margin = weighted([70, gs.just(0)], [30, ints(1, 3)]);
+/** A typed array of 0-6 elements, possibly at an (aligned) offset into a larger buffer whose other bytes are 0xee; with shape.oddBuffers the buffer is 70% of the time 1 to bpe-1 bytes longer, so its length is no multiple of the element size. */
+const typedArray = (shape) =>
+  gs
+    .sampledFrom(TYPED)
+    .flatMap((Ctor) => gs.record({ Ctor: gs.just(Ctor), before: margin, items: gs.arrays(elementOf(Ctor), { maxSize: 6 }), after: margin, odd: shape.oddBuffers ? maybe(70, ints(1, 7)) : gs.just(undefined) }))
+    .map(({ Ctor, before, items, after, odd }) => {
+      const bpe = Ctor.BYTES_PER_ELEMENT;
+      const extra = odd === undefined || bpe === 1 ? 0 : 1 + ((odd - 1) % (bpe - 1));
+      const buf = new ArrayBuffer((before + items.length + after) * bpe + extra);
+      new Uint8Array(buf).fill(0xee);
+      const view = new Ctor(buf, before * bpe, items.length);
+      view.set(items);
+      return view;
+    });
+
+/** A view over a shared buffer as data: a typed array of up to 6 elements at a position taken modulo the room, or a DataView over the whole buffer. */
+const sharedView = weighted([80, gs.record({ Ctor: gs.sampledFrom(TYPED), len: ints(0, 6), at: ints(0, 99) })], [20, gs.just("DataView")]);
+/** Several views over one buffer (a multiple of every element size unless shape.oddBuffers), 30% of the time the buffer itself too: an array. */
+const sharedViews = (shape) =>
+  gs.record({ bytes, views: gs.arrays(sharedView, { minSize: 2, maxSize: 3 }), withBuffer: chance(30) }).map(({ bytes, views, withBuffer }) => {
+    const b = bufferOf(bytes, shape.oddBuffers ? 1 : 8);
+    const out = views.map((spec) => {
+      if (spec === "DataView") return new DataView(b, 0, b.byteLength);
+      const { Ctor, len, at } = spec;
+      const room = Math.floor(b.byteLength / Ctor.BYTES_PER_ELEMENT);
+      const l = Math.min(len, room);
+      return new Ctor(b, (at % (room - l + 1)) * Ctor.BYTES_PER_ELEMENT, l);
+    });
+    if (withBuffer) out.push(b);
+    return out;
+  });
+
+/** Binary: an ArrayBuffer 15% of the time, a typed array 55%, a DataView 15%, or several views sharing one buffer 15%. */
+export const bin = (shape) => weighted([15, arrayBuffer], [55, typedArray(shape)], [15, dataView], [15, sharedViews(shape)]);
+
+// ---------------------------------------------------------------- URLs
+
+const HOSTS = ["example.com", "EXAMPLE.com", "xn--nxasmq6b.com", "\u00e9.com", "[::1]", "127.0.0.1", "a.b.c", "localhost"];
+const SCHEMES = ["http", "https", "ftp", "ws", "file", "blob", "foo"];
+const FIXED_URLS = ["data:text/plain,hi<>", "mailto:a@b.c", "javascript:alert(1)", "file:///tmp/a%20b", "about:blank", "http://a/%zz", "http://a/b/../c/./d"];
+
+/** A URL string: one of FIXED_URLS 10% of the time, else a scheme, userinfo 20%, a host, a port 30%, a path, a query 50% and a fragment 40%. */
+const urlText = weighted(
+  [10, gs.sampledFrom(FIXED_URLS)],
+  [90, gs
+    .record({
+      scheme: gs.sampledFrom(SCHEMES),
+      userinfo: chance(20),
+      host: gs.sampledFrom(HOSTS),
+      port: maybe(30, ints(1, 65535)),
+      path: pieces(["a", "b", "/", " ", "%20", "\u00e9", "?", "#", "<", ".", ".."], 0, 8),
+      query: maybe(50, pieces(["a", "=", "&", "b", " ", "+", "\u00e9", "<"], 0, 8)),
+      fragment: maybe(40, pieces(["f", "<", " ", "\u00e9"], 0, 4)),
+    })
+    .map(({ scheme, userinfo, host, port, path, query, fragment }) => `${scheme}://${userinfo ? "u:p@" : ""}${host}${port === undefined ? "" : ":" + port}/${path}${query === undefined ? "" : "?" + query}${fragment === undefined ? "" : "#" + fragment}`)],
+);
+/** A URL (http://example.com/fallback when the text does not parse). */
+export const url = urlText.map((text) => {
+  try {
+    return new URL(text);
+  } catch {
+    return new URL("http://example.com/fallback");
+  }
+});
+
+const PARAM_CHARS = ["a", "b", " ", "+", "%20", "%", "&", "=", "\u00e9", "\u{1F600}", "<", "\n", "\0"];
+/** URLSearchParams of 0-5 entries whose names and values are 0-4 pieces of the characters that matter to its encoding. */
+export const searchParams = gs.arrays(gs.tuples(pieces(PARAM_CHARS, 0, 4), pieces(PARAM_CHARS, 0, 4)), { maxSize: 5 }).map((entries) => new URLSearchParams(entries));
+
+// ---------------------------------------------------------------- Temporal
+
+const TZ = ["UTC", "Europe/Paris", "America/New_York", "Asia/Kolkata", "Pacific/Apia", "+05:30", "-08:00", "Etc/GMT+3"];
+// (not "chinese": the polyfill's month-day conversions throw "Unexpected leap month suffix")
+const CALENDARS = ["iso8601", "gregory", "hebrew", "japanese", "islamic-civil"];
+
+/** The ISO fields of a date-time: years -1000..3000, days 1-28 (valid in every month), the time down to the nanosecond. */
+const isoFields = gs.record({
+  year: ints(-1000, 3000), month: ints(1, 12), day: ints(1, 28), hour: ints(0, 23), minute: ints(0, 59),
+  second: ints(0, 59), millisecond: ints(0, 999), microsecond: ints(0, 999), nanosecond: ints(0, 999),
+});
+/** A calendar: iso8601 75% of the time, else one of the others. */
+const calendar = weighted([75, gs.just("iso8601")], [25, gs.sampledFrom(CALENDARS)]);
+/** A Duration field: 0 half the time, else 0-40. */
+const durationPart = weighted([50, gs.just(0)], [50, ints(0, 40)]);
+/** Which Temporal value to make of the fields: PlainDate 15%, PlainTime 10, PlainDateTime 15, Instant 15 (nudged by up to 999 ns), ZonedDateTime 15, PlainYearMonth 10, PlainMonthDay 8, Duration 12 (negative 30%; its seconds 20% of the time up to 2^40). */
+const temporalKind = weighted(
+  [15, node("plainDate", { cal: calendar })],
+  [10, node("plainTime", {})],
+  [15, node("plainDateTime", { cal: calendar })],
+  [15, node("instant", { nanos: ints(-999, 999) })],
+  [15, node("zoned", { tz: gs.sampledFrom(TZ), cal: calendar })],
+  [10, node("yearMonth", { cal: calendar })],
+  [8, node("monthDay", { cal: calendar })],
+  [12, node("duration", {
+    negative: chance(30),
+    fields: gs.record({
+      years: durationPart, months: durationPart, weeks: durationPart, days: durationPart, hours: durationPart, minutes: durationPart,
+      seconds: weighted([80, durationPart], [20, ints(0, 2 ** 40)]), milliseconds: durationPart, microseconds: durationPart, nanoseconds: durationPart,
+    }),
+  })],
+);
+
+/** The Temporal value (the polyfill's classes, installed on globalThis by the test) that `fields` and `kind` describe. */
+function temporalOf(fields, kind) {
+  const T = globalThis.Temporal;
+  const iso = T.PlainDateTime.from(fields);
+  switch (kind.k) {
+    case "plainDate":
+      return iso.toPlainDate().withCalendar(kind.cal);
+    case "plainTime":
+      return iso.toPlainTime();
+    case "plainDateTime":
+      return iso.withCalendar(kind.cal);
+    case "instant":
+      return iso.toZonedDateTime("UTC").toInstant().add({ nanoseconds: kind.nanos });
+    case "zoned":
+      return iso.toZonedDateTime(kind.tz).withCalendar(kind.cal);
+    case "yearMonth":
+      return iso.toPlainDate().withCalendar(kind.cal).toPlainYearMonth();
+    case "monthDay":
+      return iso.toPlainDate().withCalendar(kind.cal).toPlainMonthDay();
+    default: {
+      const sign = kind.negative ? -1 : 1;
+      return T.Duration.from(Object.fromEntries(Object.entries(kind.fields).map(([k, v]) => [k, sign * v])));
+    }
+  }
+}
+/** A Temporal value in several calendars and zones. */
+export const temporal = gs.tuples(isoFields, temporalKind).map(([fields, kind]) => temporalOf(fields, kind));
+
+// ---------------------------------------------------------------- leaves
+
+/** A primitive or a leaf object of the shape (nothing that holds a child node). */
+export function leaf(shape) {
+  const choices = [[6, gs.just(null)], [6, gs.booleans()], [22, num], [21, strFor(shape)]];
+  if (shape.undefined) choices.push([6, gs.just(undefined)]);
+  if (shape.bigint) choices.push([6, big]);
+  if (shape.date) choices.push([7, date]);
+  if (shape.regexp) choices.push([5, regexp]);
+  if (shape.boxed) choices.push([5, boxed(shape)]);
+  if (shape.bin) choices.push([8, bin(shape)]);
+  if (shape.url) choices.push([4, weighted([60, url], [40, searchParams])]);
+  if (shape.temporal) choices.push([4, temporal]);
+  return weighted(...choices);
+}
+
+// ---------------------------------------------------------------- the tree and its rendering
+
+/** 0-5 children 80% of the time, else 6-`most`. */
+const children = (child, most) => weighted([80, gs.arrays(child, { maxSize: 5 })], [20, gs.arrays(child, { minSize: 6, maxSize: most })]);
+
+/** The container nodes of the shape, by kind, with children from `child` (a node generator) and `leafNode` (the leaf nodes). */
+function containersFor(shape, child, leafNode) {
+  const dense = gs.record({ items: children(child, 30) });
+  // an array with holes: a length (0-12, or 13-400: the two encodings), up to 8 elements at positions taken modulo it, and 30% of the time its last element
+  const sparse = gs.record({ len: weighted([70, ints(0, 12)], [30, ints(13, 400)]), fills: gs.arrays(gs.tuples(ints(0, 399), child), { maxSize: 8 }), last: maybe(30, child) });
+  const containers = {
+    array: node("array", { layout: shape.sparse ? weighted([75, dense], [25, sparse]) : dense }),
+    object: node("object", { nullProto: shape.nullProto ? chance(15) : gs.just(false), entries: children(gs.tuples(key(shape), child), 25) }),
+  };
+  // a Map key is mostly a leaf (NaN, -0, undefined, bigint included), sometimes a container; a Set element likewise
+  if (shape.map) containers.map = node("map", { entries: gs.arrays(gs.tuples(weighted([80, leafNode], [20, child]), child), { maxSize: 5 }) });
+  if (shape.set) containers.set = node("set", { items: gs.arrays(weighted([70, leafNode], [30, child]), { maxSize: 5 }) });
+  return containers;
+}
+/** The weighted choices of `table` whose kind the shape has. */
+const kinds = (containers, table) => table.filter(([, kind]) => containers[kind]).map(([w, kind]) => [w, containers[kind]]);
+
+/**
+ * The value graph a drawn tree describes. `pool` is the containers built so far, in depth-first
+ * order; a reference resolves to one of them by its index modulo their number (null when there
+ * is none yet).
+ */
+export function build(node, pool = []) {
+  switch (node.k) {
+    case "leaf":
+      return node.v;
+    case "ref":
+      return pool.length ? pool[node.at % pool.length] : null;
+    case "array": {
+      const a = [];
+      pool.push(a);
+      const { layout } = node;
+      if (layout.items !== undefined) {
+        for (const item of layout.items) a.push(build(item, pool));
+      } else {
+        a.length = layout.len;
+        if (layout.len) for (const [at, v] of layout.fills) a[at % layout.len] = build(v, pool);
+        if (layout.len && layout.last !== undefined) a[layout.len - 1] = build(layout.last, pool);
+      }
+      return a;
+    }
+    case "object": {
+      const o = node.nullProto ? Object.create(null) : {};
+      pool.push(o);
+      for (const [k, v] of node.entries) o[k] = build(v, pool);
+      return o;
+    }
+    case "map": {
+      const m = new Map();
+      pool.push(m);
+      for (const [k, v] of node.entries) m.set(build(k, pool), build(v, pool));
+      return m;
+    }
+    case "set": {
+      const s = new Set();
+      pool.push(s);
+      for (const item of node.items) s.add(build(item, pool));
+      return s;
+    }
+  }
+  throw new Error(`unknown node kind ${node.k}`);
+}
+
+/**
+ * The node generators of the shape: its leaf nodes and its top-level containers, whose children
+ * nest up to depth 4. Below the root a node is a leaf 50% of the time, else a container (array
+ * 20, object 18, Map 6, Set 6); with `shape.share` a reference to an earlier container 12% of the
+ * time (a cycle when it is an ancestor), with `shape.custom` a custom value 8%.
+ */
+function levels(shape) {
+  const leafNode = leaf(shape).map((v) => ({ k: "leaf", v }));
+  const extras = [];
+  if (shape.share) extras.push([12, node("ref", { at: ints(0, 99) })]);
+  if (shape.custom) extras.push([8, shape.custom.map((v) => ({ k: "leaf", v }))]);
+  // depth 4: leaves only; depths 3 to 1: containers whose children are the level below
+  let child = weighted([100, leafNode], ...extras);
+  for (let depth = 3; depth >= 1; depth--) {
+    const containers = containersFor(shape, child, leafNode);
+    child = weighted([50, leafNode], ...kinds(containers, [[20, "array"], [18, "object"], [6, "map"], [6, "set"]]), ...extras);
+  }
+  return { leafNode, root: weighted(...kinds(containersFor(shape, child, leafNode), [[45, "object"], [35, "array"], [10, "map"], [10, "set"]])) };
+}
+
+/** A top-level container of the shape: an object 45% of the time, an array 35%, a Map 10%, a Set 10% (the kinds the shape lacks leave their share to the others). */
+export function container(shape) {
+  return levels(shape).root.map((tree) => build(tree));
+}
+
+/** Any value of the shape: a leaf 20% of the time, else a container. */
+export function values(shape) {
+  const { leafNode, root } = levels(shape);
+  return weighted([20, leafNode], [80, root]).map((tree) => build(tree));
+}
+
+// ---------------------------------------------------------------- the cases of the properties
+
+/** The odd-buffer views case: views (typed arrays, DataViews, several over one buffer) over buffers whose length need not be a multiple of the element size; one 60% of the time, else a pair. */
+const oddBin = bin({ bin: true, oddBuffers: true });
+export const oddViewsCase = weighted([60, oddBin], [40, gs.tuples(oddBin, oddBin)]);
+
+/** A Node Buffer: the UTF-8 of a string plus "x" 80% of the time, else 1-50 copies of the byte 7. */
+export const bufferCase = weighted([80, str.map((s) => Buffer.from(s + "x"))], [20, ints(1, 50).map((size) => Buffer.alloc(size, 7))]);
+
+/**
+ * The sparse-array case: a length (0-20 half the time, else a round number or 100-5000), up to
+ * 12 fills at positions taken modulo it (a leaf 80% of the time, else a container), 30% of the
+ * time its last element, 30% an undefined at index 0, and whether the array is held three times
+ * by an object instead of being the value itself.
+ */
+export const sparseCase = gs.record({
+  len: weighted([50, ints(0, 20)], [44, gs.sampledFrom([21, 99, 100, 101, 999, 1000, 4096])], [6, ints(100, 5000)]),
+  fills: gs.arrays(gs.tuples(ints(0, 4999), weighted([80, leaf(FULL)], [20, container(without(FULL, "share"))])), { maxSize: 12 }),
+  last: maybe(30, leaf(FULL).map((v) => ({ v }))),
+  firstUndefined: chance(30),
+  wrapped: chance(30),
+});
+
+/** The URLs case: 1-4 URLs or URLSearchParams, and whether the first is held twice by an object instead. */
+export const urlsCase = gs.record({ items: gs.arrays(weighted([50, url], [50, searchParams]), { minSize: 1, maxSize: 4 }), shared: chance(30) });
+
+/** The Temporal case: 1-4 Temporal values, and whether the first and the last go into a Map as key and value instead. */
+export const temporalCase = gs.record({ items: gs.arrays(temporal, { minSize: 1, maxSize: 4 }), asMap: chance(30) });
+
+// ---------------------------------------------------------------- hostile flattened input
+
+const POLLUTERS = ["__proto__", "constructor", "prototype", "polluted", "a"];
+/** An index into the flattened array as data: `indexOf` resolves it against the array's length to -8..length+1. */
+const index = ints(0, 99);
+const indexOf = (ix, len) => (ix % (len + 10)) - 8;
+
+/** One entry of a hostile flattened array in devalue's own encoding, its indices as data: the ingredients of prototype pollution, cycles and overflows. */
+const hostileEntry = gs.oneOf(
+  node("number", { v: ints(-8, 8) }),
+  node("string", { v: gs.sampledFrom(["__proto__", "constructor", "polluted", "x"]) }),
+  node("object", { key: gs.sampledFrom(POLLUTERS), ix: index, polluted: maybe(50, index) }),
+  node("protoJson", { ix: index }),
+  node("nullProto", { key: gs.sampledFrom(["__proto__", "constructor", "polluted"]), ix: index }),
+  node("boxed", { ix: index }),
+  node("map", { a: index, b: index }),
+  node("set", { a: index, b: index }),
+  node("date", { v: gs.sampledFrom(["2020-01-01T00:00:00.000Z", "", 5, null]) }),
+  node("regexp", { source: gs.sampledFrom(["a", "(", 5]), flags: gs.sampledFrom(["g", "zz", null]) }),
+  node("view", { tag: gs.sampledFrom(["Uint8Array", "DataView", "Float64Array", "BigInt64Array"]), ix: index, offset: ints(-1, 5), length: ints(-1, 5) }),
+  node("arrayBuffer", { v: gs.sampledFrom(["AAAA", "!!", "", 5, null]) }),
+  node("sparse", { len: gs.sampledFrom([0, 3, -1, 2 ** 32 - 1, 2 ** 32, 1.5, "3"]), key: gs.sampledFrom([0, 1, "__proto__", "length", -1, 2 ** 32 - 2, 2 ** 32 - 1]), ix: index }),
+  node("holes", { a: index, b: index }),
+  node("custom", { tag: gs.sampledFrom(["Custom", "BigInt", "URL", "Temporal.Instant", "Nope"]), payload: weighted([25, index.map((ix) => ({ ix }))], [75, gs.sampledFrom(["12", "x", "http://a/"]).map((v) => ({ v }))]) }),
+);
+
+/** The flattened entry `e` describes, its indices resolved against `len` entries. */
+function entryOf(e, len) {
+  const at = (ix) => indexOf(ix, len);
+  switch (e.k) {
+    case "number":
+    case "string":
+      return e.v;
+    case "object": {
+      const o = {};
+      // an own property, `__proto__` included
+      Object.defineProperty(o, e.key, { value: at(e.ix), enumerable: true, writable: true, configurable: true });
+      if (e.polluted !== undefined) o.polluted = at(e.polluted);
+      return o;
+    }
+    case "protoJson":
+      return JSON.parse(`{"__proto__":{"polluted":${at(e.ix)}},"constructor":{"prototype":{"polluted":1}}}`);
+    case "nullProto":
+      return ["null", e.key, at(e.ix)];
+    case "boxed":
+      return ["Object", at(e.ix)];
+    case "map":
+      return ["Map", at(e.a), at(e.b)];
+    case "set":
+      return ["Set", at(e.a), at(e.b)];
+    case "date":
+      return ["Date", e.v];
+    case "regexp":
+      return ["RegExp", e.source, e.flags];
+    case "view":
+      return [e.tag, at(e.ix), e.offset, e.length];
+    case "arrayBuffer":
+      return ["ArrayBuffer", e.v];
+    case "sparse":
+      return [-7, e.len, e.key, at(e.ix)];
+    case "holes":
+      return [-2, at(e.a), -2, at(e.b)];
+    default:
+      return [e.tag, e.payload.ix !== undefined ? at(e.payload.ix) : e.payload.v];
+  }
+}
+
+/** The hostile-input case: a flattened array of 1-6 entries (indices resolved against its length), whether a `Custom` reviver is passed, and whether it goes through parse (as text) or unflatten. */
+export const hostileCase = gs
+  .record({ entries: gs.arrays(hostileEntry, { minSize: 1, maxSize: 6 }), withRevivers: chance(50), viaParse: chance(50) })
+  .map(({ entries, withRevivers, viaParse }) => ({ flat: entries.map((e) => entryOf(e, entries.length)), withRevivers, viaParse }));
diff --git a/hegel/hegel-zoo.mjs b/hegel/hegel-zoo.mjs
new file mode 100644
index 0000000..ffb5e91
--- /dev/null
+++ b/hegel/hegel-zoo.mjs
@@ -0,0 +1,141 @@
+// Hegel zoo: the small harness shared by the zoo's TypeScript/JavaScript targets.
+//
+// `property(name, body)` registers a node:test test that runs `body(tc)` under Hegel with
+// HEGEL_TEST_CASES cases (default 100) and the database at HEGEL_DATABASE. With ZOO_COLLECT=1
+// a `fail()` records the mismatch instead of failing, the case ends there, and the counts of
+// mismatches and of the shapes seen (`count(key)`) are printed at the end of the test, so a
+// property can be run over many cases to see every shape at once. `pin(name, body)` is a
+// plain test for one pinned bug: it must fail while the bug is present and pass once it is
+// fixed (the zoo's judge reads an unexpected pass as "fixed upstream?").
+
+import { readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+import { test as nodeTest } from "node:test";
+
+// The Hegel version these tests were written against (the zoo pins it in zoo.toml; upstream
+// would add it to devDependencies). Hegel and esbuild are installed with `npm install --prefix
+// .hegel` so the target's own package.json and lock file stay untouched. Checked at load time so
+// a stray install cannot silently change the engine.
+export const HEGEL_PIN = { "@hegeldev/hegel": "0.4.5" };
+
+const hegelDir = join(dirname(fileURLToPath(import.meta.url)), "..", ".hegel", "node_modules", "@hegeldev", "hegel");
+{
+  const installed = JSON.parse(readFileSync(join(hegelDir, "package.json"), "utf8")).version;
+  if (installed !== HEGEL_PIN["@hegeldev/hegel"]) {
+    throw new Error(`@hegeldev/hegel ${installed} is installed; these tests pin ${HEGEL_PIN["@hegeldev/hegel"]}`);
+  }
+}
+const hegel = await import(pathToFileURL(join(hegelDir, "dist", "index.js")));
+const gs = await import(pathToFileURL(join(hegelDir, "dist", "generators", "index.js")));
+
+/** Hegel's generators, re-exported so the tests import everything from one place. */
+export { gs };
+
+export const collecting = !!process.env.ZOO_COLLECT;
+
+class Collected extends Error {}
+
+let msgs = [];
+let stats = new Map();
+
+/** Report a mismatch: an error normally, a recorded line in collect mode. */
+export function fail(message) {
+  if (collecting) {
+    msgs.push(message);
+    throw new Collected(message);
+  }
+  throw new Error(message);
+}
+
+/** Bump a statistic (the shape of a pinned bug, a generator branch). */
+export function count(key) {
+  stats.set(key, (stats.get(key) || 0) + 1);
+}
+
+function settings() {
+  const s = { testCases: Number(process.env.HEGEL_TEST_CASES) || 100 };
+  if (process.env.HEGEL_DATABASE) {
+    s.database = hegel.Database.fromPath(process.env.HEGEL_DATABASE);
+  }
+  return s;
+}
+
+/** A property: `body(tc)` runs under Hegel; a thrown error (or `fail`) is a failure. */
+export function property(name, body) {
+  nodeTest(name, () => {
+    msgs = [];
+    stats = new Map();
+    hegel.test((tc) => {
+      try {
+        body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** An async property: `body(tc)` may await; runs under Hegel's testAsync with the same settings. */
+export function propertyAsync(name, body) {
+  nodeTest(name, async () => {
+    msgs = [];
+    stats = new Map();
+    await hegel.testAsync(async (tc) => {
+      try {
+        await body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** A pin: a plain test for one recorded bug. */
+export function pin(name, body) {
+  nodeTest(name, body);
+}
+
+/** Structural equality: arrays by position, objects by key set (prototype ignored), else ===. */
+export function same(a, b) {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) {
+      return false;
+    }
+    return a.every((x, i) => same(x, b[i]));
+  }
+  if (a !== null && b !== null && typeof a === "object" && typeof b === "object") {
+    const ka = Object.keys(a).sort();
+    const kb = Object.keys(b).sort();
+    if (ka.length !== kb.length || ka.some((k, i) => k !== kb[i])) {
+      return false;
+    }
+    return ka.every((k) => same(a[k], b[k]));
+  }
+  return a === b;
+}
+
+/** A compact, unambiguous rendering for messages. */
+export function show(x) {
+  return JSON.stringify(x, (k, v) => (v === undefined ? "<undefined>" : v));
+}
