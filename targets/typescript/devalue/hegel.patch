+/** The values a large graph's objects may hold besides each other, by name (one instance of each per graph). */
+const EXTRAS = {
+  map: () => new Map([[1, 2]]), set: () => new Set([1]), date: () => new Date(5), url: () => new URL("http://a/"), nan: () => NaN, holes: () => [1, , 2],
+  boxed: () => Object(3), regexp: () => /x/g, bytes: () => new Uint8Array([1, 2]), negativeZero: () => -0, undefined: () => undefined, bigint: () => 1n,
+  string: () => "str", nullProto: () => Object.create(null), dataView: () => new DataView(new ArrayBuffer(2)),
+};
+
+/** The large-graph case: N objects each referenced twice (1-300 85% of the time, else beside the 65 534 parameter cutoff or 50 000-70 000), and 0-8 extras put into the objects at positions taken modulo N. */
+const bigGraphCase = gs.record({
+  size: weighted([85, ints(1, 300)], [8, gs.sampledFrom([65533, 65534, 65535, 65536, 65537])], [7, ints(50000, 70000)]),
+  extras: gs.arrays(gs.tuples(ints(0, 69999), gs.sampledFrom(Object.keys(EXTRAS))), { maxSize: 8 }),
+});
+
+/** A graph with N objects each referenced twice (devalue names them as function parameters; above 65534 it switches form). */
+function bigGraph({ size: N, extras }) {
+  const objs = new Array(N);
+  for (let i = 0; i < N; i++) {
+    switch (i % 6) {
+      case 0: objs[i] = {}; break;
+      case 1: objs[i] = []; break;
+      case 2: objs[i] = new Map(); break;
+      case 3: objs[i] = new Set(); break;
+      case 4: objs[i] = new Date(i); break;
+      default: objs[i] = Object(i);
+    }
+  }
+  const made = Object.fromEntries(Object.entries(EXTRAS).map(([name, make]) => [name, make()]));
+  extras.forEach(([at, name], j) => {
+    const t = objs[at % N];
+    const e = made[name];
+    if (Array.isArray(t)) t.push(e);
+    else if (t instanceof Map) t.set(j, e);
+    else if (t instanceof Set) t.add(e);
+    else if (Object.getPrototypeOf(t) === Object.prototype) t["k" + j] = e;
+  });
+  const root = [...objs, ...objs];
+  root.push(objs[0]);
+  return root;
+}
