+pin("TestHegelPinErrorPathForUndefinedOrBigIntMapKeyEvaluates", () => {
+  for (const key of [undefined, 5n]) {
+    const fn = () => 1;
+    const root = { m: new Map([[key, fn]]) };
+    let err;
+    try {
+      d.stringify(root);
+    } catch (e) {
+      err = e;
+    }
+    assert.ok(err instanceof d.DevalueError);
+    let found;
+    assert.doesNotThrow(() => { found = new Function("root", "return root" + err.path)(root); }, `error.path ${JSON.stringify(err.path)} does not evaluate`);
+    assert.equal(found, fn, `error.path ${JSON.stringify(err.path)} does not lead to the function`);
+  }
+});
