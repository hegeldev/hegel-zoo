+++ b/hegel/hegel.test.mjs
@@ -0,0 +1,729 @@
+// Hegel zoo: properties of devalue (Rich-Harris/devalue) against its README, JavaScript's own
+// semantics (indirect eval of `uneval` output, `JSON.parse` of `stringify` output,
+// `structuredClone` as a second implementation of the same value space) and a canonical
+// rendering that compares identity structure (shared references, cycles) as well as contents.
+// Run with `node --test hegel/hegel.test.mjs` from the repository root; HEGEL_TEST_CASES sets
+// the case count, ZOO_COLLECT=1 collects mismatches instead of stopping at the first.
+//
+// The generators are in gen.mjs: a value graph is drawn as a small tree (leaves, containers,
+// references to earlier containers) and built by a pure function; each property draws one value
+// or one case record and renders it.
+
+import assert from "node:assert/strict";
+import { createRequire } from "node:module";
+import vm from "node:vm";
+import { count, fail, gs, pin, property, propertyAsync } from "./hegel-zoo.mjs";
+import * as gen from "./gen.mjs";
+import { chance, ints, weighted } from "./gen.mjs";
+import { canon, diff } from "./canon.mjs";
+import * as d from "../index.js";
+
+const require = createRequire(import.meta.url);
+const { Temporal } = require("../.hegel/node_modules/@js-temporal/polyfill");
+// devalue's parse and uneval output name the global `Temporal` (Node 22 has none).
+globalThis.Temporal = Temporal;
+
+// ---------------------------------------------------------------------------------------------
+// Helpers
+
+/** Indirect eval, as the README prescribes for `uneval` output. */
+const evaluate = (code) => (0, eval)("(" + code + ")");
+
+function expectSame(label, expected, actual, options) {
+  const a = canon(expected, options);
+  const b = canon(actual, options);
+  if (a !== b) fail(`${label}: ${diff(a, b)}`);
+}
+
+function parseJson(label, s) {
+  try {
+    return JSON.parse(s);
+  } catch (e) {
+    return fail(`${label}: output is not JSON (${e.message}): ${s.length > 300 ? s.slice(0, 300) + "..." : s}`);
+  }
+}
+
+class Vector {
+  constructor(x, y) {
+    this.x = x;
+    this.y = y;
+  }
+}
+class Temp {
+  constructor(c) {
+    this.c = c;
+  }
+}
+/** A value the reducers, revivers and replacer handle: a Temp 40% of the time, else a Vector. */
+const customValue = weighted([40, gen.num.map((c) => new Temp(c))], [60, gs.tuples(gen.num, gen.num).map(([x, y]) => new Vector(x, y))]);
+const reducers = {
+  Vector: (v) => v instanceof Vector && [v.x, v.y],
+  Temp: (v) => v instanceof Temp && { c: v.c },
+};
+const revivers = {
+  Vector: ([x, y]) => new Vector(x, y),
+  Temp: ({ c }) => new Temp(c),
+};
+// Since upstream 58ad745 a replacer receives the `js` tag and returns a fragment whose holes are
+// serialised recursively (before, it received an `uneval` function and returned a string).
+const replacer = (value, js) => {
+  if (value instanceof Vector) return js`new Vector(${value.x},${value.y})`;
+  if (value instanceof Temp) return js`new Temp(${value.c})`;
+};
+
+/** A copy of `v` (same identity structure) with `wrap` applied at every position that may hold a promise: the root, object properties, present array elements and Map values (not Set elements or Map keys), children before parents. */
+function copyWith(v, wrap) {
+  const memo = new Map();
+  function go(x) {
+    if (x === null || typeof x !== "object") return x;
+    if (memo.has(x)) return memo.get(x);
+    if (Array.isArray(x)) {
+      const a = new Array(x.length);
+      memo.set(x, a);
+      for (let i = 0; i < x.length; i++) if (i in x) a[i] = wrap(go(x[i]));
+      return a;
+    }
+    if (x instanceof Map) {
+      const m = new Map();
+      memo.set(x, m);
+      for (const [k, y] of x) m.set(go(k), wrap(go(y)));
+      return m;
+    }
+    if (x instanceof Set) {
+      const s = new Set();
+      memo.set(x, s);
+      for (const y of x) s.add(go(y));
+      return s;
+    }
+    const tag = Object.prototype.toString.call(x).slice(8, -1);
+    if (tag !== "Object") return x;
+    const o = Object.getPrototypeOf(x) === null ? Object.create(null) : {};
+    memo.set(x, o);
+    for (const k of Object.keys(x)) o[k] = wrap(go(x[k]));
+    return o;
+  }
+  return wrap(go(v));
+}
+
+/** A copy of `v` in which the positions numbered in `at` (taken modulo the number of positions) hold promises of their value. Returns [copy, promises inserted]. */
+function promisify(v, at) {
+  let total = 0;
+  copyWith(v, (x) => (total++, x));
+  const chosen = new Set(at.map((i) => i % total));
+  let position = 0;
+  let inserted = 0;
+  const copy = copyWith(v, (x) => {
+    if (!chosen.has(position++)) return x;
+    inserted++;
+    return Promise.resolve(x);
+  });
+  return [copy, inserted];
+}
+
+// the whole value space
+const fullValue = gen.values(gen.FULL);
+
+const UNSAFE = /[<\u2028\u2029\x00-\x1f]/;
+
+// ---------------------------------------------------------------------------------------------
+// stringify / parse / uneval round trips
+
+property("TestHegelParseStringifyRoundTrips", (tc) => {
+  const v = tc.draw(fullValue);
+  const s = d.stringify(v);
+  const parsed = parseJson("stringify", s);
+  expectSame("parse(stringify(v))", v, d.parse(s));
+  expectSame("unflatten(JSON.parse(stringify(v)))", v, d.unflatten(parsed));
+});
+
+property("TestHegelEvalUnevalRoundTrips", (tc) => {
+  const v = tc.draw(fullValue);
+  const code = d.uneval(v);
+  let back;
+  try {
+    back = evaluate(code);
+  } catch (e) {
+    return fail(`uneval output does not evaluate (${e.constructor.name}: ${e.message}): ${code.length > 300 ? code.slice(0, 300) + "..." : code}`);
+  }
+  expectSame("eval(uneval(v))", v, back);
+  // the README's other prescription
