+const TAGS = ["Array", "Date", "Map", "Set", "RegExp", "Uint8Array", "ArrayBuffer", "DataView", "URL", "URLSearchParams", "Number", "String", "Boolean", "BigInt",
+  "Temporal.Instant", "Object", "Null", "Promise", "Error", "Foo", "Arguments"];
+
+property("TestHegelTaggedObjectsAreObjectsOrRejected", (tc) => {
+  // a plain object with a Symbol.toStringTag is still a plain object: serialised as one, or refused
+  const o = gen.container(tc, gen.without(gen.FULL, "share", "map", "set"));
+  const target = Array.isArray(o) ? {} : o;
+  const tag = pick(tc, TAGS);
+  const enumerable = chance(tc, 50);
+  Object.defineProperty(target, Symbol.toStringTag, { value: tag, enumerable, configurable: true });
+  const expected = Object.fromEntries(Object.entries(target));
+  count(enumerable ? "enumerable" : "non-enumerable");
+  for (const [name, encode, decode] of [["stringify", d.stringify, d.parse], ["uneval", d.uneval, evaluate]]) {
+    let out;
+    try {
+      out = encode(target);
+    } catch (e) {
+      if (!(e instanceof Error)) fail(`${name} threw a non-Error for tag ${tag}`);
+      count(`${name}-rejects-${e.constructor.name}`);
+      continue;
+    }
+    let back;
+    try {
+      back = decode(out);
+    } catch (e) {
+      return fail(`${name} produced undecodable output for tag ${tag} (${e.message}): ${out.slice(0, 200)}`);
+    }
+    if (Array.isArray(back) || back === null || typeof back !== "object") fail(`${name} turned an object tagged ${tag} into ${canon(back).slice(0, 100)}`);
+    else expectSame(`${name} of an object tagged ${tag}`, expected, back, { nullProtoAsPlain: true });
+  }
+});
