+pin("TestHegelPinPooledBufferDoesNotLeakItsPool", () => {
+  // Buffer.from(string) below 4 KiB is a view into Node's shared 8 KiB pool
+  let secret, b;
+  for (let i = 0; i < 5 && !(secret && secret.buffer === b.buffer); i++) {
+    secret = Buffer.from("SECRET-PASSWORD-" + i);
+    b = Buffer.from("abc");
+  }
+  if (secret.buffer !== b.buffer) return; // no shared pool here: nothing to leak
+  const s = d.stringify(b);
+  const back = d.parse(s);
+  assert.deepEqual(Array.from(back), [97, 98, 99]);
+  const all = Buffer.from(back.buffer);
+  assert.ok(!all.includes(secret), `the serialisation of a 3-byte Buffer carries the bytes of another Buffer (${back.buffer.byteLength} bytes, ${s.length} chars)`);
+  assert.equal(back.buffer.byteLength, 3);
+});
