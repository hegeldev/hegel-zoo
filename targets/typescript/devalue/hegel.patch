+/** A graph with N objects each referenced twice (devalue names them as function parameters; above 65534 it switches form). */
+function bigGraph(tc) {
+  const N = chance(tc, 85) ? n(tc, 1, 300) : chance(tc, 50) ? pick(tc, [65533, 65534, 65535, 65536, 65537]) : n(tc, 50000, 70000);
+  const objs = new Array(N);
+  for (let i = 0; i < N; i++) {
+    switch (i % 6) {
+      case 0: objs[i] = {}; break;
+      case 1: objs[i] = []; break;
+      case 2: objs[i] = new Map(); break;
+      case 3: objs[i] = new Set(); break;
+      case 4: objs[i] = new Date(i); break;
+      default: objs[i] = Object(i);
+    }
+  }
+  const extras = [new Map([[1, 2]]), new Set([1]), new Date(5), new URL("http://a/"), NaN, [1, , 2], Object(3), /x/g, new Uint8Array([1, 2]), -0, undefined, 1n, "str", Object.create(null), new DataView(new ArrayBuffer(2))];
+  const k = n(tc, 0, 8);
+  for (let j = 0; j < k; j++) {
+    const t = objs[n(tc, 0, N - 1)];
+    const e = extras[n(tc, 0, extras.length - 1)];
+    if (Array.isArray(t)) t.push(e);
+    else if (t instanceof Map) t.set(j, e);
+    else if (t instanceof Set) t.add(e);
+    else if (Object.getPrototypeOf(t) === Object.prototype) t["k" + j] = e;
+  }
+  const root = [...objs, ...objs];
+  root.push(objs[0]);
+  return root;
+}
+
+property("TestHegelLargeGraphsRoundTrip", (tc) => {
+  const v = bigGraph(tc);
+  const names = (v.length - 1) / 2;
+  count(names > 65534 ? "above-65534-names" : names >= 50000 ? "50000-65534-names" : "small");
+  const code = d.uneval(v);
+  let back;
+  try {
+    back = evaluate(code);
+  } catch (e) {
+    return fail(`uneval output for ${v.length / 2} shared objects does not evaluate (${e.constructor.name}: ${e.message})`);
+  }
+  expectSame("eval(uneval(big graph))", v, back);
+  expectSame("parse(stringify(big graph))", v, d.parse(d.stringify(v)));
+});
