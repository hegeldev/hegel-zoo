+  if (len > 0 && chance(tc, 30)) a[len - 1] = gen.leaf(tc, gen.FULL);
+  if (len > 0 && chance(tc, 30)) a[0] = undefined;
+  const v = chance(tc, 70) ? a : { a, b: [a, a] };
