+property("TestHegelSparseArraysKeepTheirHoles", (tc) => {
+  const len = chance(tc, 50) ? n(tc, 0, 20) : pick(tc, [21, 99, 100, 101, 999, 1000, 4096, n(tc, 100, 5000)]);
+  const a = new Array(len);
