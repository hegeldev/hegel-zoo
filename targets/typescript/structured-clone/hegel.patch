+// structured-clone/17: a +0 and, later in the serializer's order, a -0 (bare, or inside a nested array or object), in an array, an object or a Map with plain values around and between
+const negativeZeroAfterZero = gs.record({ how: gs.sampledFrom(["array", "object", "map"]), pre: plainNodes(2), mid: plainNodes(2), post: plainNodes(2), nest: gs.sampledFrom(["bare", "array", "object"]) }).map(({ how, pre, mid, post, nest }) => {
+  const pool = [];
+  const late = nest === "bare" ? -0 : nest === "array" ? [-0] : { z: -0 };
+  const items = [...buildAll(pre, pool), 0, ...buildAll(mid, pool), late, ...buildAll(post, pool)];
+  if (how === "array") return items;
+  if (how === "object") {
+    const o = {};
+    items.forEach((x, i) => (o["k" + i] = x));
+    return o;
+  }
+  return new Map(items.map((x, i) => ["k" + i, x]));
+});
+
+/** The shape generators by bug id: the value to clone (13 in json mode, 14 with `null` for the options, 15 and 16 through the json module). */
+export const shapes = {
+  "structured-clone/1": placed(arrayWithHoles),
+  "structured-clone/2": placed(arrayWithOwnProperty),
+  "structured-clone/3": placed(errorWithCause),
+  "structured-clone/4": placed(aggregateError),
+  "structured-clone/5": placed(errorNamedAfterAGlobal),
+  "structured-clone/6": placed(domException),
+  "structured-clone/7": placed(exotic),
+  "structured-clone/8": placed(sharedArrayBuffer),
+  "structured-clone/9": placed(dataViewOverPart),
+  "structured-clone/10": placed(bufferReferencedTwice),
+  "structured-clone/11": placed(viewsSharingABuffer),
+  "structured-clone/12": placed(taggedPlainObject),
+  "structured-clone/13": placed(objectWithAnOddToJSON),
+  "structured-clone/14": values(CLEAN),
+  "structured-clone/15": placed(numberLostInJsonText),
+  "structured-clone/16": placed(bigintArray),
+  "structured-clone/17": placed(negativeZeroAfterZero),
+};
diff --git a/hegel/hegel-zoo.mjs b/hegel/hegel-zoo.mjs
new file mode 100644
index 0000000..f8098a8
--- /dev/null
+++ b/hegel/hegel-zoo.mjs
@@ -0,0 +1,131 @@
+// Hegel zoo: the small harness shared by the zoo's TypeScript/JavaScript targets.
+//
+// `property(name, body)` registers a node:test test that runs `body(tc)` under Hegel with
+// HEGEL_TEST_CASES cases (default 100) and the database at HEGEL_DATABASE. With ZOO_COLLECT=1
+// a `fail()` records the mismatch instead of failing, the case ends there, and the counts of
+// cases, mismatches and of the shapes seen (`count(key)`) are printed at the end of the test, so
+// a property can be run over many cases to see every shape at once. `pin(name, body)` is a
+// plain test for one pinned bug: it must fail while the bug is present and pass once it is
+// fixed (the zoo's judge reads an unexpected pass as "fixed upstream?"). HEGEL_NO_KNOWN=1
+// (`noKnown`, read once here) asks for a run that looks past the recorded bugs: the generators
+// then leave their shapes out, a mismatch that still has one is skipped, and a property that
+// draws nothing but such a shape is registered skipped (`property(name, body, { skip })`).
+
+import { readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+import { test as nodeTest } from "node:test";
+
+// The Hegel version these tests were written against (the zoo pins it in zoo.toml; upstream
+// would add it to devDependencies). Hegel is installed with `npm install --prefix .hegel` so the
+// target's own package.json and lock file stay untouched. Checked at load time so a stray
+// install cannot silently change the engine.
+export const HEGEL_PIN = { "@hegeldev/hegel": "0.4.5" };
+
+const hegelDir = join(dirname(fileURLToPath(import.meta.url)), "..", ".hegel", "node_modules", "@hegeldev", "hegel");
+{
+  const installed = JSON.parse(readFileSync(join(hegelDir, "package.json"), "utf8")).version;
+  if (installed !== HEGEL_PIN["@hegeldev/hegel"]) {
+    throw new Error(`@hegeldev/hegel ${installed} is installed; these tests pin ${HEGEL_PIN["@hegeldev/hegel"]}`);
+  }
+}
+const hegel = await import(pathToFileURL(join(hegelDir, "dist", "index.js")));
+const gs = await import(pathToFileURL(join(hegelDir, "dist", "generators", "index.js")));
+
+/** Hegel's generators, re-exported so the tests import everything from one place. */
+export { gs };
+
+export const collecting = !!process.env.ZOO_COLLECT;
+
+/** HEGEL_NO_KNOWN=1: leave the shapes of the recorded bugs out (they are drawn, and fail, by default). */
+export const noKnown = !!process.env.HEGEL_NO_KNOWN;
+
+class Collected extends Error {}
+
+let msgs = [];
+let stats = new Map();
+
+/** Report a mismatch: an error normally, a recorded line in collect mode. */
+export function fail(message) {
+  if (collecting) {
+    msgs.push(message);
+    throw new Collected(message);
+  }
+  throw new Error(message);
+}
+
+/** Bump a statistic (the shape of a pinned bug, a generator branch). */
+export function count(key) {
+  stats.set(key, (stats.get(key) || 0) + 1);
+}
+
+function settings() {
+  const s = { testCases: Number(process.env.HEGEL_TEST_CASES) || 100 };
+  if (process.env.HEGEL_DATABASE) {
+    s.database = hegel.Database.fromPath(process.env.HEGEL_DATABASE);
+  }
+  return s;
+}
+
+// Hegel keys its example database by the test function's source text. Every property here runs
+// through the same wrapper, so without this every property would share one key and replay the
+// stored failing examples of all the others; the key is the test's name instead.
+function keyed(name, fn) {
+  fn.toString = () => name;
+  return fn;
+}
+
+/** A property: `body(tc)` runs under Hegel; a thrown error (or `fail`) is a failure. */
+export function property(name, body, { skip } = {}) {
+  nodeTest(name, { skip }, () => {
+    msgs = [];
+    stats = new Map();
+    hegel.test(keyed(name, (tc) => {
+      if (collecting) count("cases");
+      try {
+        body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }), settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** A pin: a plain test for one recorded bug. */
+export function pin(name, body) {
+  nodeTest(name, body);
+}
+
+/** Structural equality: arrays by position, objects by key set (prototype ignored), else ===. */
+export function same(a, b) {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) {
+      return false;
+    }
+    return a.every((x, i) => same(x, b[i]));
+  }
+  if (a !== null && b !== null && typeof a === "object" && typeof b === "object") {
+    const ka = Object.keys(a).sort();
+    const kb = Object.keys(b).sort();
+    if (ka.length !== kb.length || ka.some((k, i) => k !== kb[i])) {
+      return false;
+    }
+    return ka.every((k) => same(a[k], b[k]));
+  }
+  return a === b;
+}
+
+/** A compact, unambiguous rendering for messages. */
+export function show(x) {
+  return JSON.stringify(x, (k, v) => (v === undefined ? "<undefined>" : v));
+}
diff --git a/hegel/hegel.test.mjs b/hegel/hegel.test.mjs
new file mode 100644
index 0000000..5203f1a
--- /dev/null
+++ b/hegel/hegel.test.mjs
@@ -0,0 +1,500 @@
+// Hegel zoo: properties of @ungap/structured-clone (ungap/structured-clone) against Node's own
+// `structuredClone` (V8's serializer, the reference implementation of the algorithm the
+// package polyfills), its README (lossy/json modes, "serialized values can be safely stringified
+// as JSON"), and JSON.stringify for the json mode's toJSON contract, through a canonical
+// rendering that compares identity structure (shared references, cycles) as well as contents.
+// Run with `node --test hegel/hegel.test.mjs` from the repository root; HEGEL_TEST_CASES sets
+// the case count, ZOO_COLLECT=1 collects mismatches instead of stopping at the first.
+//
+// The generators are in gen.mjs: a value graph is drawn as a small tree (leaves, containers,
+// references to earlier containers) and built by a pure function; each property draws one value.
+// The shapes of the recorded bugs (bugs.toml) are drawn like any other, so the wide properties
+// fail on them, naming the shapes (known.mjs) in the failure; each bug also has a property over
+// its shape alone (the section before the pins) and a pin. HEGEL_NO_KNOWN=1 asks for a run that
+// looks past the known bugs: the generators then leave the shapes out (gen.CLEAN, gen.JSON_CLEAN),
+// a mismatch that still has one is skipped, and the one-bug properties are skipped whole.
+
+import assert from "node:assert/strict";
+import { appendFileSync } from "node:fs";
+import { inspect } from "node:util";
+import { count, fail, noKnown, pin, property } from "./hegel-zoo.mjs";
+import * as gen from "./gen.mjs";
+import { put } from "./gen.mjs";
+import { canon, diff } from "./canon.mjs";
+import { hasBigIntArray, lostInJsonText, shapesOf } from "./known.mjs";
+import { deserialize, serialize } from "../esm/index.js";
+import { parse, stringify } from "../esm/json.js";
+
+// ---------------------------------------------------------------------------------------------
+// Helpers
+
+const native = globalThis.structuredClone;
+/** The polyfill's clone: deserialize(serialize(v)), which is what the default export does where there is no native structuredClone. */
+const poly = (v, options) => deserialize(serialize(v, options));
+
+/** Run f; return { value } or { error }. */
+function attempt(f) {
+  try {
+    return { value: f() };
+  } catch (error) {
+    return { error };
+  }
+}
+
+const describeError = (e) => (e && e.constructor ? e.constructor.name : "?") + ": " + (e && e.message);
+
+/** Compare the outcome of the polyfill with the oracle's: both throw, or both return canon-equal values. Returns null when they agree, else a message. */
+function compare(expected, actual, options) {
+  if (expected.error && actual.error) {
+    count("both-throw");
+    return null;
+  }
+  if (expected.error) return `oracle throws (${describeError(expected.error)}) but the polyfill returns ${cut(canon(actual.value, options))}`;
+  if (actual.error) return `oracle returns ${cut(canon(expected.value, options))} but the polyfill throws ${describeError(actual.error)}`;
+  const a = canon(expected.value, options);
+  const b = canon(actual.value, options);
+  return a === b ? null : diff(a, b);
+}
+
+// The README supports typed arrays "without major issues": the polyfill writes a view's elements
+// and nothing of its buffer, so the properties at that level of support compare views by their
+// elements; the strict rendering (buffer identity, offset, every byte of the buffer) is what sees
+// bug 11.
+const BY_ELEMENTS = { viewsByElements: true };
+
+// The value spaces. Every shape is drawn by default, the recorded bugs' included; under
+// HEGEL_NO_KNOWN=1 the clone properties draw gen.CLEAN (no shape of an in-memory bug) and the
+// json properties gen.JSON_CLEAN (neither those nor what JSON text loses: bugs 13, 15, 16).
+const space = noKnown ? gen.CLEAN : gen.FULL;
+const jsonSpace = noKnown ? gen.JSON_CLEAN : gen.FULL;
+const value = gen.values(space);
+const jsonValue = gen.values(jsonSpace);
+
+const cut = (s) => (s.length > 300 ? s.slice(0, 300) + "..." : s);
+
+/** With ZOO_TRACE=<file>, append every value a property is about to clone (to find one that hangs). */
+function trace(v) {
+  if (process.env.ZOO_TRACE) appendFileSync(process.env.ZOO_TRACE, inspect(v, { depth: 8, breakLength: Infinity, maxArrayLength: 50, maxStringLength: 100 }) + "\n");
+}
+
+/**
+ * The recorded shapes (bug ids) of a mismatch, as the suffix of its failure message; under
+ * HEGEL_NO_KNOWN=1 a mismatch that has one is counted and skipped instead.
+ */
+function recorded(tc, shapes) {
+  for (const s of shapes) count((noKnown ? "skip/" : "known/") + s);
+  if (noKnown && shapes.length) tc.assume(false);
+  if (!shapes.length) return "";
+  return ` (recorded shape${shapes.length > 1 ? "s" : ""} ${shapes.join(", ")})`;
+}
+
+/** Report a mismatch on `v` (`message` null: none): a failure naming the recorded shapes of the case (by default those known.mjs finds in `v`). */
+function judge(tc, v, message, label, shapes = shapesOf(v)) {
+  if (message === null) return;
+  const suffix = recorded(tc, shapes);
+  fail(`${label}: ${message}${suffix}\n  value: ${cut(canon(v))}`);
+}
+
+/** A plain object: its prototype is Object.prototype or null and no internal class stands behind its tag (a misleading Symbol.toStringTag is fine; an `arguments` object is not plain). */
+function isPlainObject(x) {
+  if (x === null || typeof x !== "object") return false;
+  const proto = Object.getPrototypeOf(x);
+  return (proto === Object.prototype || proto === null) && (Object.prototype.toString.call(x) === "[object Object]" || Symbol.toStringTag in x);
+}
+const isIndex = (k, length) => String(k >>> 0) === k && k >>> 0 < length;
+
+/** A copy of `v` with functions and symbols removed the way the README says lossy mode removes them: object properties dropped, array elements replaced by null, Map entries and Set elements dropped, the root itself becoming null. Identity structure, holes and an array's own properties are kept. */
+function stripped(v) {
+  const memo = new Map();
+  const skip = (x) => typeof x === "function" || typeof x === "symbol";
+  function go(x) {
+    if (skip(x)) return null;
+    if (x === null || typeof x !== "object") return x;
+    if (memo.has(x)) return memo.get(x);
+    if (Array.isArray(x)) {
+      const a = new Array(x.length);
+      memo.set(x, a);
+      for (const k of Object.keys(x)) {
+        if (isIndex(k, x.length)) a[k] = go(x[k]);
+        else if (!skip(x[k])) a[k] = go(x[k]);
+      }
+      return a;
+    }
+    if (x instanceof Map) {
+      const m = new Map();
+      memo.set(x, m);
+      for (const [k, y] of x) if (!skip(k) && !skip(y)) m.set(go(k), go(y));
+      return m;
+    }
+    if (x instanceof Set) {
+      const s = new Set();
+      memo.set(x, s);
+      for (const y of x) if (!skip(y)) s.add(go(y));
+      return s;
+    }
+    if (!isPlainObject(x)) return x; // leaves (Date, RegExp, views, boxed, Error, what the algorithm refuses) carry no functions the rule applies to
+    const o = {};
+    memo.set(x, o);
+    for (const k of Object.keys(x)) if (!skip(x[k])) put(o, k, go(x[k]));
+    return o;
+  }
+  return go(v);
+}
+
+/** Whether `v` holds a function or symbol anywhere the algorithm visits: the elements and own properties of arrays, the properties of plain objects, Map keys and values, Set elements. */
+function hasUncloneable(v) {
+  const seen = new Set();
+  const skip = (x) => typeof x === "function" || typeof x === "symbol";
+  function go(x) {
+    if (skip(x)) return true;
+    if (x === null || typeof x !== "object" || seen.has(x)) return false;
+    seen.add(x);
+    if (x instanceof Map) return [...x].some(([k, y]) => go(k) || go(y));
+    if (x instanceof Set) return [...x].some((y) => go(y));
+    if (!Array.isArray(x) && !isPlainObject(x)) return false;
+    return Object.keys(x).some((k) => go(x[k]));
+  }
+  return go(v);
+}
+
+// ---------------------------------------------------------------------------------------------
+// The polyfill against the native implementation
+
+/** deserialize(serialize(v)) against structuredClone(v), the two rendered with `options`. */
+function checkClone(tc, v, options) {
+  trace(v);
+  judge(tc, v, compare(attempt(() => native(v)), attempt(() => poly(v)), options), "clone");
+}
+
+property("TestHegelCloneMatchesNative", (tc) => {
+  // views by their elements, the README's level of support
+  checkClone(tc, tc.draw(value), BY_ELEMENTS);
+});
+
+property("TestHegelCloneMatchesNativeEverywhere", (tc) => {
+  // the strict rendering: buffer identity, offsets and every byte of a view's buffer
+  checkClone(tc, tc.draw(value));
+});
+
+// ---------------------------------------------------------------------------------------------
+// The json module (README: "serialized values can be safely stringified as JSON")
+
+/** The recorded shapes of a json-module mismatch: bug 13 by the error the polyfill throws, 15 and 16 by what the value holds, then the in-memory ones. */
+function jsonShapes(v, actual) {
+  const shapes = [];
+  if (actual && actual.error && /toJSON is not a function/.test(actual.error.message)) shapes.push("structured-clone/13");
+  if (lostInJsonText(v)) shapes.push("structured-clone/15");
+  if (hasBigIntArray(v)) shapes.push("structured-clone/16");
+  return [...shapes, ...shapesOf(v)];
+}
+
+/** parse(stringify(v)) of the json module against structuredClone(v) (json mode implies lossy; views by elements). */
+function checkJsonRoundTrip(tc, v) {
+  const expected = attempt(() => native(v));
+  const actual = attempt(() => parse(stringify(v)));
+  judge(tc, v, compare(expected, actual, BY_ELEMENTS), "json", jsonShapes(v, actual));
+}
+
+property("TestHegelJsonRoundTripMatchesNative", (tc) => {
+  checkJsonRoundTrip(tc, tc.draw(jsonValue));
+});
+
+/** README: "Serialized values can be safely stringified as JSON too, and deserialization resurrect all values": deserialize(JSON.parse(JSON.stringify(serialize(v)))) equals deserialize(serialize(v)). */
+function checkRecordsSurviveJsonText(tc, v) {
+  const records = attempt(() => serialize(v));
+  if (records.error) {
+    // no records to carry: a refusal the native algorithm shares is the verdict, any other a bug of serialize
+    if (attempt(() => native(v)).error) return count("both-refuse");
+    return judge(tc, v, `serialize throws ${describeError(records.error)}`, "records");
+  }
+  const text = attempt(() => JSON.stringify(records.value));
+  if (text.error) return judge(tc, v, `JSON.stringify(serialize(v)) throws ${describeError(text.error)}`, "records", jsonShapes(v));
+  const direct = attempt(() => canon(deserialize(records.value)));
+  const viaText = attempt(() => canon(deserialize(JSON.parse(text.value))));
+  if (direct.error && viaText.error) return count("both-throw");
+  const outcome = (r) => (r.error ? `throws ${describeError(r.error)}` : "returns");
+  if (direct.error || viaText.error) return judge(tc, v, `deserialize of the records ${outcome(direct)} but through JSON text ${outcome(viaText)}`, "records through JSON text", jsonShapes(v));
+  if (direct.value !== viaText.value) judge(tc, v, diff(direct.value, viaText.value), "records through JSON text", jsonShapes(v));
+}
+
+property("TestHegelRecordsSurviveJsonText", (tc) => {
+  checkRecordsSurviveJsonText(tc, tc.draw(jsonValue));
+});
+
+// ---------------------------------------------------------------------------------------------
+// lossy / strict modes (README "Extra Features")
+
+// the value space with functions and symbols among the leaves
+const valueWithFunctions = gen.values(gen.withKeys(space, "functions"));
+
+property("TestHegelLossyDropsFunctionsAndSymbolsLikeJson", (tc) => {
+  const v = tc.draw(valueWithFunctions);
+  if (hasUncloneable(v)) count("with-uncloneable");
+  const expected = attempt(() => native(stripped(v)));
+  const actual = attempt(() => poly(v, { lossy: true }));
+  judge(tc, v, compare(expected, actual, BY_ELEMENTS), "lossy");
+});
+
+property("TestHegelStrictRefusesFunctionsAndSymbols", (tc) => {
+  const v = tc.draw(valueWithFunctions);
+  const has = hasUncloneable(v);
+  const r = attempt(() => serialize(v));
+  if (has) {
+    count("refused");
+    if (!r.error) return judge(tc, v, "serialize accepted a value holding a function or symbol", "strict");
+    if (!(r.error instanceof TypeError) || !/^unable to serialize (function|symbol)$/.test(r.error.message)) {
+      judge(tc, v, `serialize threw ${describeError(r.error)} instead of TypeError "unable to serialize function|symbol"`, "strict");
+    }
+    // the native implementation refuses it too
+    const nat = attempt(() => native(v));
+    if (!nat.error) judge(tc, v, "native structuredClone accepted what the polyfill refused", "strict");
+  } else if (r.error) {
+    judge(tc, v, `serialize threw ${describeError(r.error)} on a value without functions or symbols`, "strict");
+  }
+});
+
+// ---------------------------------------------------------------------------------------------
+// json mode's toJSON contract, against JSON.stringify's
+
+// the json space whose plain objects carry a toJSON 20% of the time (returning a fresh value, a wrapper, and by default `this` or not callable)
+const valueWithToJSON = gen.values(gen.withKeys(jsonSpace, "toJSON"));
+
+/** Whether a plain object anywhere in `v` has an own `toJSON` (inserted, or a drawn key). */
+function hasOwnToJSON(v) {
+  const seen = new Set();
+  function go(x) {
+    if (x === null || typeof x !== "object" || seen.has(x)) return false;
+    seen.add(x);
+    if (Array.isArray(x)) return x.some(go);
+    if (x instanceof Map) return [...x].some(([k, y]) => go(k) || go(y));
+    if (x instanceof Set) return [...x].some(go);
+    if (!isPlainObject(x)) return false;
+    return Object.hasOwn(x, "toJSON") || Object.keys(x).some((k) => go(x[k]));
+  }
+  return go(v);
+}
+
+/** JSON.stringify's model: a plain object with a callable toJSON is replaced by its result (once, not recursively on itself); a non-callable toJSON is an ordinary property. Identity structure, holes and an array's own properties are kept; nothing else is touched. */
+function jsonModel(v) {
+  const memo = new Map();
+  function go(x, fromToJSON) {
+    if (x === null || typeof x !== "object") return x;
+    if (memo.has(x)) return memo.get(x);
+    if (Array.isArray(x)) {
+      const a = new Array(x.length);
+      memo.set(x, a);
+      for (const k of Object.keys(x)) a[k] = go(x[k], false);
+      return a;
+    }
+    if (x instanceof Map) {
+      const m = new Map();
+      memo.set(x, m);
+      for (const [k, y] of x) m.set(go(k, false), go(y, false));
+      return m;
+    }
+    if (x instanceof Set) {
+      const s = new Set();
+      memo.set(x, s);
+      for (const y of x) s.add(go(y, false));
+      return s;
+    }
+    if (!isPlainObject(x)) return x;
+    if (!fromToJSON && typeof x.toJSON === "function") {
+      const r = x.toJSON();
+      if (r === x) return go(x, true);
+      return go(r, false);
+    }
+    const o = {};
+    memo.set(x, o);
+    for (const k of Object.keys(x)) {
+      if (typeof x[k] === "function") continue; // lossy mode drops the toJSON function itself
+      put(o, k, go(x[k], false));
+    }
+    return o;
+  }
+  return go(v, false);
+}
+
+/** deserialize(serialize(v, { json: true })) against structuredClone of what JSON.stringify would see. */
+function checkJsonMode(tc, v) {
+  if (hasOwnToJSON(v)) count("with-toJSON");
+  const model = jsonModel(v);
+  const expected = attempt(() => native(model));
+  const actual = attempt(() => poly(v, { json: true }));
+  const message = compare(expected, actual, BY_ELEMENTS);
+  if (message === null) return;
+  // bug 13: a toJSON returning the receiver overflows the stack; a non-callable toJSON is called. The
+  // other shapes are read off the model as well, since what a toJSON returns is only visible there.
+  const shapes = new Set(actual.error && (actual.error instanceof RangeError || /toJSON is not a function/.test(actual.error.message)) ? ["structured-clone/13"] : []);
+  for (const s of [...shapesOf(v), ...shapesOf(model)]) shapes.add(s);
+  judge(tc, v, message, "json mode", [...shapes]);
+}
+
+property("TestHegelJsonModeAppliesToJSONLikeJsonStringify", (tc) => {
+  checkJsonMode(tc, tc.draw(valueWithToJSON));
+});
+
+// ---------------------------------------------------------------------------------------------
+// Hostile records
+
+const PROTOS = [Object.prototype, Array.prototype, Error.prototype, Map.prototype, Function.prototype, Uint8Array.prototype, Date.prototype];
+
+function snapshot() {
+  return PROTOS.map((p) => Object.getOwnPropertyNames(p).sort().join(",")).join("|");
+}
+
+property("TestHegelDeserializeReturnsOrThrowsAndNeverPollutes", (tc) => {
+  // records with bad indices, `__proto__`/`constructor` keys, error and regexp payloads
+  const records = tc.draw(gen.hostileRecords);
+  const before = snapshot();
+  const r = attempt(() => deserialize(records));
+  if (r.error && !(r.error instanceof Error)) fail(`deserialize threw a non-Error: ${String(r.error)}`);
+  if (r.error) count("throws");
+  else count("returns");
+  if (snapshot() !== before) fail(`a built-in prototype changed after deserialize(${JSON.stringify(records)})`);
+  if (({}).polluted !== undefined || [].polluted !== undefined) fail(`Object/Array prototype polluted by ${JSON.stringify(records)}`);
+});
+
+// ---------------------------------------------------------------------------------------------
+// One property per recorded bug
+//
+// The wide properties above reach the recorded shapes at their natural rates and shrink to one
+// bug each; these draw one bug's shape region with random contents around it (`shapes` in
+// gen.mjs) and check it with the same oracle, so every bug has a property that finds it in every
+// run. They draw nothing but the shape, so HEGEL_NO_KNOWN=1 skips them whole.
+const KNOWN = { skip: noKnown && "draws only a recorded bug's shape" };
+/** The body of a property over the shape of bug `id`, checked by `check(tc, v)`. */
+const shaped = (id, check) => (tc) => check(tc, tc.draw(gen.shapes[id]));
+/** The strict clone comparison (buffer identity, offsets, every byte). */
+const strictClone = (tc, v) => checkClone(tc, v);
+
+property("TestHegelSparseArraysKeepTheirHoles", shaped("structured-clone/1", strictClone), KNOWN);
+property("TestHegelArrayOwnPropertiesClone", shaped("structured-clone/2", strictClone), KNOWN);
+property("TestHegelErrorCausesClone", shaped("structured-clone/3", strictClone), KNOWN);
+property("TestHegelAggregateErrorsCloneAsErrors", shaped("structured-clone/4", strictClone), KNOWN);
+property("TestHegelErrorsNamedAfterGlobalsCloneAsErrors", shaped("structured-clone/5", strictClone), KNOWN);
+property("TestHegelDOMExceptionsCloneAsDOMExceptions", shaped("structured-clone/6", strictClone), KNOWN);
+property("TestHegelUncloneableObjectsAreRefusedLikeNative", shaped("structured-clone/7", strictClone), KNOWN);
+property("TestHegelSharedArrayBuffersClone", shaped("structured-clone/8", strictClone), KNOWN);
+property("TestHegelDataViewsOverPartOfABufferKeepTheirRange", shaped("structured-clone/9", strictClone), KNOWN);
+property("TestHegelRepeatedBufferReferencesCloneAsOneObject", shaped("structured-clone/10", strictClone), KNOWN);
+property("TestHegelViewsOverOneBufferKeepSharingIt", shaped("structured-clone/11", strictClone), KNOWN);
+property("TestHegelTaggedPlainObjectsCloneAsPlainObjects", shaped("structured-clone/12", strictClone), KNOWN);
+property("TestHegelJsonModeNonCallableOrSelfToJSONLikeJsonStringify", shaped("structured-clone/13", checkJsonMode), KNOWN);
+
+property("TestHegelNullOptionsCloneLikeNative", (tc) => {
+  // bug 14: `serialize(value, null)`, the documented nullable options, on a value of no other recorded shape
+  const v = tc.draw(gen.shapes["structured-clone/14"]);
+  judge(tc, v, compare(attempt(() => native(v)), attempt(() => poly(v, null))), "clone with null options", ["structured-clone/14", ...shapesOf(v)]);
+}, KNOWN);
+
+property("TestHegelJsonModuleKeepsNonFiniteNumbersAndBoxedNegativeZero", shaped("structured-clone/15", checkJsonRoundTrip), KNOWN);
+property("TestHegelBigIntArraysSurviveJsonText", shaped("structured-clone/16", checkRecordsSurviveJsonText), KNOWN);
+property("TestHegelNegativeZeroAfterZeroStaysNegative", shaped("structured-clone/17", strictClone), KNOWN);
+
+// ---------------------------------------------------------------------------------------------
+// Pins: one per bug in bugs.toml (each must fail while the bug is present)
+
+const cloneOf = (v) => poly(v);
+
+pin("TestHegelPinHolesStayHoles", () => {
+  const c = cloneOf([, 1]);
+  assert.equal(0 in c, false, "the clone of [, 1] has index 0 (a hole became undefined)");
+});
+
+pin("TestHegelPinArraysKeepTheirOwnProperties", () => {
+  const c = cloneOf(Object.assign([1], { foo: 2 }));
+  assert.equal(c.foo, 2, "the own property foo of an array is lost");
+});
+
+pin("TestHegelPinErrorsKeepTheirCause", () => {
+  const c = cloneOf(new Error("m", { cause: 1 }));
+  assert.equal(c.cause, 1, "the cause of an Error is lost");
+});
+
+pin("TestHegelPinAggregateErrorsKeepTheirMessage", () => {
+  const c = cloneOf(new AggregateError([], "agg"));
+  assert.equal(c.message, "agg", `the message of an AggregateError is lost (errors: ${JSON.stringify(c.errors)})`);
+});
+
+pin("TestHegelPinRecordsDoNotConstructArbitraryGlobals", () => {
+  let constructed = 0;
+  globalThis.ZooSpy = class ZooSpy { constructor() { constructed++; } };
+  try {
+    attempt(() => deserialize([["ZooSpy", "x"]]));
+    attempt(() => deserialize([[7, { name: "ZooSpy", message: "x" }]]));
+    const viaError = attempt(() => cloneOf(Object.assign(new Error("x"), { name: "ZooSpy" })));
+    assert.equal(constructed, 0, "deserialize called the constructor of a global named by the records");
+    assert.ok(viaError.value instanceof Error, "an Error whose name is a global's clones as something else");
+    const asArray = cloneOf(Object.assign(new Error("3"), { name: "Array" }));
+    assert.ok(asArray instanceof Error, "an Error named Array clones as an Array");
+  } finally {
+    delete globalThis.ZooSpy;
+  }
+});
+
+pin("TestHegelPinDOMExceptionsSurvive", () => {
+  const c = cloneOf(new DOMException("aborted", "AbortError"));
+  assert.equal(c.name, "AbortError", "a DOMException clones as a plain Error");
+});
+
+pin("TestHegelPinUncloneableObjectsAreRefused", () => {
+  for (const v of [Promise.resolve(1), new WeakMap(), new WeakRef({}), Object(Symbol("s"))]) {
+    const r = attempt(() => serialize(v));
+    assert.ok(r.error, `${Object.prototype.toString.call(v)} is serialized (as ${JSON.stringify(r.value)}) instead of refused`);
+  }
+});
+
+pin("TestHegelPinSharedArrayBuffersClone", () => {
+  const sab = new SharedArrayBuffer(3);
+  new Uint8Array(sab).set([1, 2, 3]);
+  const c = cloneOf(sab);
+  assert.deepEqual([...new Uint8Array(c)], [1, 2, 3]);
+});
+
+pin("TestHegelPinDataViewsKeepTheirRange", () => {
+  const c = cloneOf(new DataView(new Uint8Array([1, 2, 3, 4]).buffer, 1, 2));
+  assert.deepEqual([c.byteOffset, c.byteLength], [1, 2], "a DataView over part of a buffer comes back over the whole buffer");
+});
+
+pin("TestHegelPinRepeatedBufferReferencesStayOneObject", () => {
+  const b = new ArrayBuffer(2);
+  const c = cloneOf([b, b]);
+  assert.ok(c[0] === c[1], "two references to one ArrayBuffer clone as two buffers");
+});
+
+pin("TestHegelPinViewsOverOneBufferShareIt", () => {
+  const b = new ArrayBuffer(4);
+  const c = cloneOf([new Uint8Array(b), new Uint16Array(b)]);
+  assert.ok(c[0].buffer === c[1].buffer, "two views over one buffer clone over separate buffers");
+});
+
+pin("TestHegelPinTaggedObjectsArePlainObjects", () => {
+  const c = cloneOf({ [Symbol.toStringTag]: "Array", a: 1 });
+  assert.deepEqual(c, { a: 1 });
+});
+
+pin("TestHegelPinJsonModeToJSONLikeJsonStringify", () => {
+  const self = { toJSON() { return this; }, a: 1 };
+  assert.deepEqual(poly(self, { json: true }), { a: 1 }, "toJSON returning the receiver");
+  assert.deepEqual(poly({ toJSON: 1, a: 1 }, { json: true }), { toJSON: 1, a: 1 }, "a non-callable toJSON");
+});
+
+pin("TestHegelPinNullOptionsAreAccepted", () => {
+  assert.equal(deserialize(serialize(1, null)), 1);
+});
+
+pin("TestHegelPinJsonModuleKeepsNaNAndInfinity", () => {
+  assert.ok(Number.isNaN(parse(stringify(NaN))), `parse(stringify(NaN)) is ${parse(stringify(NaN))}`);
+  assert.equal(parse(stringify(Infinity)), Infinity);
+});
+
+pin("TestHegelPinNegativeZeroAfterZeroStaysNegative", () => {
+  const c = cloneOf([0, -0]);
+  assert.ok(Object.is(c[1], -0), `[0, -0] clones as [${c[0]}, ${Object.is(c[1], -0) ? "-0" : c[1]}]`);
+});
+
+pin("TestHegelPinJsonModuleStringifiesBigIntArrays", () => {
+  const c = parse(stringify(new BigInt64Array([1n])));
+  assert.deepEqual([...c], [1n]);
+});
diff --git a/hegel/known.mjs b/hegel/known.mjs
new file mode 100644
index 0000000..bf6383e
--- /dev/null
+++ b/hegel/known.mjs
@@ -0,0 +1,182 @@
+// Hegel zoo: the recorded bugs of @ungap/structured-clone, as predicates on the value that was
+// cloned (bugs.toml has the details). `shapesOf(v)` walks the value graph and names every recorded
+// bug whose shape it contains, so a property names the shapes in a mismatch's failure and, under
+// HEGEL_NO_KNOWN=1, skips the mismatch instead; the CLEAN shape (gen.mjs) draws none of them but a
+// -0 after a +0 (bug 17), which is a property of the drawn numbers, so a run under that flag skips
+// only that one.
+
+const tagOf = (x) => Object.prototype.toString.call(x).slice(8, -1);
+const hasOwn = (o, k) => Object.prototype.hasOwnProperty.call(o, k);
+const STANDARD_ERROR_NAMES = new Set(["Error", "TypeError", "RangeError", "ReferenceError", "SyntaxError", "URIError", "EvalError"]);
+const EXOTIC = new Set(["Promise", "WeakMap", "WeakSet", "WeakRef", "Symbol", "Arguments"]);
+// tags the serializer classifies by (typeOf in serialize.js, the OBJECT cases of `pair`)
+const MISLEADING_TAGS = /^(Array|Map|Set|Date|RegExp|DataView|Number|String|Boolean|BigInt|.*Array.*)$/;
+const isBoxed = (x) => x instanceof Number || x instanceof String || x instanceof Boolean || Object.getPrototypeOf(x) === BigInt.prototype;
+const bugNumber = (id) => Number(id.split("/")[1]);
+
+/** The recorded bugs (ids, in bug order) whose shapes `v` contains. */
+export function shapesOf(v) {
+  const seen = new Set();
+  const buffers = new Map(); // ArrayBuffer -> number of views/references seen
+  const found = new Set();
+  let zeros = 0; // 1: a +0 was met
+  const hit = (id) => found.add(id);
+  function zero(x) {
+    if (typeof x !== "number" || x !== 0) return;
+    if (Object.is(x, -0)) {
+      if (zeros === 1) hit("structured-clone/17");
+    } else zeros = 1;
+  }
+  function buffer(b) {
+    const c = (buffers.get(b) || 0) + 1;
+    buffers.set(b, c);
+    if (c > 1) hit("structured-clone/11");
+  }
+  function go(x) {
+    zero(x);
+    if (x === null || (typeof x !== "object" && typeof x !== "function")) return;
+    if (seen.has(x)) {
+      if (x instanceof ArrayBuffer || x instanceof DataView) hit("structured-clone/10");
+      return;
+    }
+    seen.add(x);
+    if (Array.isArray(x)) {
+      for (let i = 0; i < x.length; i++) {
+        if (!(i in x)) hit("structured-clone/1");
+      }
+      for (const k of Object.keys(x)) {
+        if (!(String(k >>> 0) === k && k >>> 0 < x.length)) hit("structured-clone/2");
+      }
+      for (let i = 0; i < x.length; i++) go(x[i]);
+      return;
+    }
+    if (x instanceof DOMException) return hit("structured-clone/6");
+    if (x instanceof Error) {
+      if (hasOwn(x, "cause")) hit("structured-clone/3");
+      const name = x.name || "Error";
+      // an AggregateError is rebuilt through the same `new env[name](message)` as bug 5's, but is recorded on its own
+      if (x instanceof AggregateError || name === "AggregateError") hit("structured-clone/4");
+      else if (!STANDARD_ERROR_NAMES.has(name) && typeof globalThis[name] === "function") hit("structured-clone/5");
+      if (hasOwn(x, "cause")) go(x.cause);
+      return;
+    }
+    if (x instanceof Map) {
+      for (const [k, y] of x) {
+        go(k);
+        go(y);
+      }
+      return;
+    }
+    if (x instanceof Set) {
+      for (const y of x) go(y);
+      return;
+    }
+    if (x instanceof DataView) {
+      if (x.byteOffset !== 0 || x.byteLength !== x.buffer.byteLength) hit("structured-clone/9");
+      return buffer(x.buffer);
+    }
+    if (x instanceof ArrayBuffer) return buffer(x);
+    if (ArrayBuffer.isView(x)) {
+      if (x.byteOffset !== 0 || x.byteLength !== x.buffer.byteLength) hit("structured-clone/11");
+      return buffer(x.buffer);
+    }
+    if (x instanceof SharedArrayBuffer) return hit("structured-clone/8");
+    if (x instanceof Date || x instanceof RegExp || isBoxed(x)) return;
+    const tag = tagOf(x);
+    if (EXOTIC.has(tag)) return hit("structured-clone/7");
+    if (MISLEADING_TAGS.test(tag)) hit("structured-clone/12");
+    for (const k of Object.keys(x)) go(x[k]);
+  }
+  go(v);
+  return [...found].sort((a, b) => bugNumber(a) - bugNumber(b));
+}
+
+/** The first recorded bug (an id) whose shape `v` contains, or null. */
+export function known(v) {
+  const shapes = shapesOf(v);
+  return shapes.length ? shapes[0] : null;
+}
+
+/** A generic walk over the values JSON text would carry: numbers, boxed Numbers, Float array elements, Error causes, Map keys and values, Set elements, array elements, object values. `visit(x, inBox)` sees a boxed Number's or float element's value with inBox = true. */
+function walk(v, visit) {
+  const seen = new Set();
+  let found = false;
+  function go(x, inBox = false) {
+    if (found) return;
+    if (visit(x, inBox)) {
+      found = true;
+      return;
+    }
+    if (x === null || typeof x !== "object" || seen.has(x)) return;
+    seen.add(x);
+    if (x instanceof Number) return go(x.valueOf(), true);
+    if (x instanceof Float32Array || x instanceof Float64Array) {
+      for (const e of x) go(e, true);
+      return;
+    }
+    if (x instanceof Error) return go(x.cause);
+    if (x instanceof Map) {
+      for (const [k, y] of x) {
+        go(k);
+        go(y);
+      }
+      return;
+    }
+    if (x instanceof Set) {
+      for (const y of x) go(y);
+      return;
+    }
+    if (ArrayBuffer.isView(x) || x instanceof ArrayBuffer || x instanceof Date || x instanceof RegExp) return;
+    for (const k of Object.keys(x)) go(x[k]);
+  }
+  go(v);
+  return found;
+}
+
+/** Whether `v` holds a -0 after a +0 in the serializer's order (its identity map merges them: bug 17). Only the positions the serializer visits as primitives count: not typed-array elements, not boxed Numbers. */
+export function hasZeroAfterPlusZero(v) {
+  const seen = new Set();
+  let zeros = 0;
+  let found = false;
+  function go(x) {
+    if (found) return;
+    if (typeof x === "number" && x === 0) {
+      if (Object.is(x, -0)) {
+        if (zeros === 1) found = true;
+      } else zeros = 1;
+      return;
+    }
+    if (x === null || typeof x !== "object" || seen.has(x)) return;
+    seen.add(x);
+    if (Array.isArray(x)) {
+      for (let i = 0; i < x.length; i++) go(x[i]);
+      return;
+    }
+    if (x instanceof Map) {
+      for (const [k, y] of x) {
+        go(k);
+        go(y);
+      }
+      return;
+    }
+    if (x instanceof Set) {
+      for (const y of x) go(y);
+      return;
+    }
+    if (x instanceof Error) return go(x.cause);
+    if (Object.prototype.toString.call(x) !== "[object Object]") return;
+    for (const k of Object.keys(x)) go(x[k]);
+  }
+  go(v);
+  return found;
+}
+
+/** Whether `v` holds a number JSON text cannot carry and the serializer does not encode (bug 15): NaN or an infinity anywhere, or a -0 inside a boxed Number or a float array (only a bare -0 gets the '-0' record). */
+export function lostInJsonText(v) {
+  return walk(v, (x, inBox) => typeof x === "number" && (!Number.isFinite(x) || (inBox && Object.is(x, -0))));
+}
+
+/** Whether `v` contains a BigInt64Array or BigUint64Array (JSON.stringify refuses their elements). */
+export function hasBigIntArray(v) {
+  return walk(v, (x) => x instanceof BigInt64Array || x instanceof BigUint64Array);
+}
