diff --git a/hegel/canon.mjs b/hegel/canon.mjs
new file mode 100644
index 0000000..650e424
--- /dev/null
+++ b/hegel/canon.mjs
@@ -0,0 +1,118 @@
+// Hegel zoo: a canonical rendering of a JavaScript value graph.
+//
+// `canon(v)` renders a value so that two graphs render the same text exactly when they are
+// structurally equal *including identity structure*: every object gets a label `#k` in
+// depth-first order and a later reference to the same object renders as `@k`, so shared
+// references and cycles are compared, not just contents. It distinguishes -0, NaN, bigints,
+// boxed primitives, Dates (by time value, NaN for an invalid one), RegExps (source and flags),
+// arrays with holes and with own non-index properties, Maps (entries in order), Sets,
+// ArrayBuffers and SharedArrayBuffers (bytes), typed arrays and DataViews (buffer identity,
+// offset, length, elements), Errors (prototype, name, message, own `cause`, AggregateError
+// `errors`; never the stack), DOMExceptions, and class instances (by constructor name). It uses
+// `Object.prototype.toString` tags rather than `instanceof`, so values from another realm compare.
+
+function prim(x) {
+  if (typeof x === "number") return Object.is(x, -0) ? "-0" : String(x);
+  if (typeof x === "bigint") return x + "n";
+  if (typeof x === "string") return JSON.stringify(x);
+  if (x === undefined) return "undefined";
+  if (x === null) return "null";
+  if (typeof x === "boolean") return String(x);
+  if (typeof x === "symbol") return x.toString();
+  return null;
+}
+
+const hasOwn = (o, k) => Object.prototype.hasOwnProperty.call(o, k);
+
+/** The elements of a view, capped: a gigabyte-long typed array (bug 5) is rendered by its first elements and its length. */
+function bytes(view) {
+  const CAP = 100000;
+  if (view.length <= CAP) return Array.from(view, (e) => prim(e)).join(",");
+  return Array.from(view.subarray(0, 64), (e) => prim(e)).join(",") + ",...(length " + view.length + ")";
+}
+
+/** options.viewsByElements: render typed arrays and DataViews by their elements/bytes alone (no buffer identity, offset or the buffer's other bytes), the polyfill's documented level of support for views. */
+export function canon(v, options = {}) {
+  const seen = new Map();
+  let next = 0;
+  function go(x) {
+    const p = prim(x);
+    if (p !== null) return p;
+    if (typeof x === "function") return "function";
+    if (seen.has(x)) return "@" + seen.get(x);
+    const id = next++;
+    seen.set(x, id);
+    const head = "#" + id;
+    const tag = Object.prototype.toString.call(x).slice(8, -1);
+    switch (tag) {
+      case "Number":
+      case "String":
+      case "Boolean":
+      case "BigInt":
+      case "Symbol":
+        return head + tag + "(" + prim(x.valueOf()) + ")";
+      case "Date":
+        return head + "Date(" + prim(x.getTime()) + ")";
+      case "RegExp":
+        return head + "RegExp(" + JSON.stringify(x.source) + "," + x.flags + ")";
+      case "ArrayBuffer":
+      case "SharedArrayBuffer":
+        return head + tag + "[" + bytes(new Uint8Array(x)) + "]";
+      case "DataView":
+        if (options.viewsByElements) return head + "DataView[" + bytes(new Uint8Array(x.buffer, x.byteOffset, x.byteLength)) + "]";
+        return head + "DataView(" + go(x.buffer) + "," + x.byteOffset + "," + x.byteLength + ")";
+      case "Map":
+        return head + "Map{" + [...x].map(([k, y]) => go(k) + "=>" + go(y)).join(",") + "}";
+      case "Set":
+        return head + "Set{" + [...x].map(go).join(",") + "}";
+      case "Array": {
+        const parts = [];
+        for (let i = 0; i < x.length; i++) parts.push(i in x ? go(x[i]) : "<hole>");
+        // own enumerable non-index properties (structuredClone keeps them)
+        for (const k of Object.keys(x)) {
+          if (!(String(k >>> 0) === k && k >>> 0 < x.length)) parts.push(JSON.stringify(k) + ":" + go(x[k]));
+        }
+        return head + "[" + parts.join(",") + "]";
+      }
+      case "Error": {
+        const proto = Object.getPrototypeOf(x);
+        const ctor = (proto && proto.constructor && proto.constructor.name) || "?";
+        let s = head + "Error(" + ctor + ",name=" + JSON.stringify(String(x.name)) + ",message=" + JSON.stringify(String(x.message));
+        if (hasOwn(x, "cause")) s += ",cause=" + go(x.cause);
+        if (hasOwn(x, "errors")) s += ",errors=" + go(x.errors);
+        return s + ")";
+      }
+      case "DOMException":
+        return head + "DOMException(" + JSON.stringify(x.name) + "," + JSON.stringify(x.message) + ")";
+      case "Promise":
+      case "WeakMap":
+      case "WeakSet":
+      case "WeakRef":
+        return head + tag;
+    }
+    if (ArrayBuffer.isView(x)) {
+      const elements = bytes(x);
+      if (options.viewsByElements) return head + tag + "[" + elements + "]";
+      return head + tag + "(" + go(x.buffer) + "," + x.byteOffset + "," + x.length + ")[" + elements + "]";
+    }
+    const proto = Object.getPrototypeOf(x);
+    let name = "";
+    if (proto === null) name = "";
+    else if (!(proto.constructor && proto.constructor.name === "Object" && Object.getPrototypeOf(proto) === null)) {
+      name = (proto.constructor && proto.constructor.name) || "?";
+    }
+    if (tag !== "Object" && name === "") name = tag;
+    const body = Object.keys(x).map((k) => JSON.stringify(k) + ":" + go(x[k])).join(",");
+    return head + name + "{" + body + "}";
+  }
+  return go(v);
+}
+
+/** The first index at which two renderings differ, with context, for messages. */
+export function diff(a, b) {
+  if (a === b) return "equal";
+  let i = 0;
+  while (i < a.length && i < b.length && a[i] === b[i]) i++;
+  const cut = (s) => (s.length > 160 ? s.slice(0, 160) + "..." : s);
+  return `differ at ${i}:\n  expected ...${cut(a.slice(Math.max(0, i - 40)))}\n  actual   ...${cut(b.slice(Math.max(0, i - 40)))}`;
+}
diff --git a/hegel/gen.mjs b/hegel/gen.mjs
new file mode 100644
index 0000000..f3ad60f
--- /dev/null
+++ b/hegel/gen.mjs
@@ -0,0 +1,495 @@
+// Hegel zoo: the generators behind the structured-clone properties, as values built from Hegel's
+// combinators, and the pure function that builds the value graph they describe.
+//
+// A value graph is drawn as a small tree. Its leaves are the kinds the structured clone algorithm
+// covers (MDN "Supported types", which the README points to): primitives including undefined,
+// NaN, -0 and BigInt, strings with awkward characters (controls, U+2028, lone surrogates), Dates
+// over the whole range and invalid, RegExps, boxed primitives, ArrayBuffers and views (typed
+// arrays, DataViews, several views over one buffer); its containers (array, plain or
+// null-prototype object, Map, Set, Error with a cause, tagged object) hold child nodes; and with
+// `shape.share` a node may be a reference to an earlier container by index. `build` renders the
+// tree depth first and resolves a reference against the containers built so far (the index taken
+// modulo their number), so a reference to an ancestor is a cycle and one to a finished container
+// a repeated reference. `shape` names what may appear so a property can stay inside the value
+// space its oracle agrees on: `shape.exotic` adds objects the algorithm must refuse (Promise,
+// WeakMap, WeakSet, WeakRef, boxed Symbol, arguments), `shape.tagged` plain objects with a
+// misleading Symbol.toStringTag, `shape.functions` functions and symbols, `shape.toJSON` a
+// toJSON member on some plain objects (returning a fresh value, a primitive, `this`, or not
+// callable). Object keys are reserved words, numeric, empty or `__proto__` (shape.protoKey).
+
+import { gs } from "./hegel-zoo.mjs";
+
+// ---------------------------------------------------------------- generator helpers
+
+const ints = (lo, hi) => gs.integers({ minValue: lo, maxValue: hi });
+
+/** oneOf with weights: `weighted([45, a], [55, b])` draws a 45 times in 100; shrinks towards the first choice. */
+function weighted(...choices) {
+  if (choices.length === 1) return choices[0][1];
+  const total = choices.reduce((sum, [w]) => sum + w, 0);
+  return ints(0, total - 1).flatMap((r) => {
+    for (const [w, g] of choices) {
+      if (r < w) return g;
+      r -= w;
+    }
+    throw new Error("unreachable");
+  });
+}
+
+/** True pct percent of the time; shrinks to false. */
+const chance = (pct) => ints(0, 99).map((r) => r >= 100 - pct);
+/** A draw from g pct percent of the time, else undefined (listed first: shrinks to absent). */
+const maybe = (pct, g) => weighted([100 - pct, gs.just(undefined)], [pct, g]);
+/** lo-hi pieces of `pool` (strings of one or more characters) concatenated. */
+const pieces = (pool, lo, hi) => gs.arrays(gs.sampledFrom(pool), { minSize: lo, maxSize: hi }).map((xs) => xs.join(""));
+
+// ---------------------------------------------------------------- shapes
+
+export const FULL = Object.freeze({
+  undefined: true, bigint: true, date: true, regexp: true, boxed: true, bin: true, map: true, set: true,
+  nullProto: true, share: true, loneSurrogates: true, error: true, protoKey: true,
+  // the shapes of recorded bugs (see known.mjs); CLEAN leaves them out
+  sparse: true, arrayProps: true, cause: true, oddErrorNames: true, domException: true, aggregate: true, exotic: true,
+  sab: true, dataViewRange: true, sharedBuffers: true, tagged: true,
+});
+
+/** shape minus some keys. */
+export function without(shape, ...keys) {
+  const s = { ...shape };
+  for (const k of keys) delete s[k];
+  return Object.freeze(s);
+}
+
+/** shape plus some keys. */
+export function withKeys(shape, ...keys) {
+  const s = { ...shape };
+  for (const k of keys) s[k] = true;
+  return Object.freeze(s);
+}
+
+export const CLEAN = without(FULL, "sparse", "arrayProps", "cause", "oddErrorNames", "domException", "aggregate", "exotic", "sab", "dataViewRange", "sharedBuffers", "tagged");
+
+// ---------------------------------------------------------------- strings and keys
+
+const CHARS = ["a", "b", "z", "A", "0", "9", " ", "_", "$", "-", ".", "/", "<", ">", "&", "'", "\"", "`", "\\", "\n", "\r", "\t",
+  "\b", "\f", "\0", "\x01", "\x1f", "\x7f", "\u2028", "\u2029", "\u00a0", "\ufeff", "\uffff", "\u00e9", "\u00df",
+  "\u4e2d", "\ud7ff", "\ue000", "\u{1F600}", "\u{10FFFF}", "</script>", "${", "\\u003C", "\\n", "toJSON", "__proto__"];
+const LONE = ["\ud800", "\udc00", "\udbff", "\udfff", "\ud83d"];
+
+/** 0-6 pieces of `pool` 70% of the time, 7-30 pieces 25%, else 200-2000 characters of a three-letter alphabet. */
+const wordsFrom = (pool) => weighted([70, pieces(pool, 0, 6)], [25, pieces(pool, 7, 30)], [5, gs.text({ alphabet: "a\u00e9\u{1F600}", minSize: 200, maxSize: 2000 })]);
+const plainWords = wordsFrom(CHARS);
+const surrogateWords = wordsFrom([...CHARS, ...LONE]);
+/** A string of awkward characters (controls, U+2028, a BOM, U+FFFF, non-ASCII, astral). */
+export const str = plainWords;
+/** A string; with shape.loneSurrogates it is drawn from a pool with unpaired surrogates 30% of the time. */
+const strFor = (shape) => (shape.loneSurrogates ? weighted([70, plainWords], [30, surrogateWords]) : plainWords);
+
+const KEYS = ["a", "b", "c", "k", "x", "y", "_", "$", "$x", "b_1", "if", "class", "let", "null", "true", "void", "in", "do",
+  "0", "1", "2", "10", "01", "-1", "1.5", "4294967295", "4294967296", "", " ", "a b", "<x>", "\"q\"", "'q'", "\n", "\\",
+  "\u00e9", "\u4e2d", "\u{1F600}", "constructor", "prototype", "hasOwnProperty", "toString", "valueOf",
+  "then", "__proto_", "__PROTO__", "proto", "length", "get", "set", "Map", "Object", "NaN", "undefined", "toJSON", "name", "message", "cause", "errors", "stack"];
+
+/** An object key: one of KEYS 80% of the time, else a string; with shape.protoKey, `__proto__` 4% of the time. */
+const key = (shape) => (shape.protoKey ? weighted([77, gs.sampledFrom(KEYS)], [19, strFor(shape)], [4, gs.just("__proto__")]) : weighted([80, gs.sampledFrom(KEYS)], [20, strFor(shape)]));
+
+/** o[k] = v as an own property, `__proto__` included. */
+export function put(o, k, v) {
+  if (k === "__proto__") Object.defineProperty(o, k, { value: v, enumerable: true, writable: true, configurable: true });
+  else o[k] = v;
+}
+
+// ---------------------------------------------------------------- numbers, bigints, dates
+
+const SPECIAL_NUMBERS = [0, -0, 1, -1, 0.5, -0.5, 0.1, 1 / 3, 1e21, 1e-7, 5e-324, 1.7976931348623157e308, 2 ** 53, -(2 ** 53),
+  2 ** 31, -(2 ** 31), 4294967295, 4294967296, 123456789.125, NaN, Infinity, -Infinity, 7.99, 1e300, -1e-300];
+
+/** A random double: a 53-bit mantissa (two draws), a binary exponent in -70..70 and a sign (2.5 when it overflows). */
+const anyDouble = gs.record({ a: ints(0, 2 ** 52), b: ints(0, 2 ** 52), e: ints(-70, 70), negative: chance(40) }).map(({ a, b, e, negative }) => {
+  const v = (negative ? -1 : 1) * (a + b) * 2 ** e;
+  return Number.isFinite(v) ? v : 2.5;
+});
+/** A number: one of the special values 45% of the time, a small integer 30%, else a random double. */
+export const num = weighted([45, gs.sampledFrom(SPECIAL_NUMBERS)], [30, ints(-1000, 1000)], [25, anyDouble]);
+
+/** A bigint: a boundary value 40% of the time, else a 41-bit integer, 30% of the time times a large prime. */
+const big = weighted(
+  [40, gs.sampledFrom([0n, 1n, -1n, 2n ** 63n, -(2n ** 63n), 2n ** 64n, 10n ** 30n, -(10n ** 40n), 2n ** 53n + 1n])],
+  [60, gs.tuples(ints(-(2 ** 40), 2 ** 40), chance(30)).map(([x, prime]) => BigInt(x) * (prime ? 1000000007n : 1n))],
+);
+
+const DATE_TIMES = [0, -1, 1, 8.64e15, -8.64e15, -62135596800000, 253402300799999, 951782400000, 1e12 + 123];
+/** A Date: a boundary 30% of the time, anywhere in the range 60% (negative 30%), invalid 10%. */
+const date = weighted([30, gs.sampledFrom(DATE_TIMES)], [60, gs.tuples(chance(30), ints(0, 8.64e15)).map(([negative, t]) => (negative ? -t : t))], [10, gs.just(NaN)]).map((t) => new Date(t));
+
+// ---------------------------------------------------------------- RegExps and boxed primitives
+
+const SOURCES = ["a", "(?:)", "a\\/b", "[a-z]+<", "^x$", "\\d{2,}", "(?<n>a)|b", "\\u2028", "\\p{L}", "[\\q{ab}]", ".*", "a|", "(a)(b)\\2", "\\/", "[/]", "\\n\\r"];
+const FLAGS = ["", "g", "i", "gi", "m", "s", "y", "d", "u", "v", "gimsy", "dgimsuy", "dgimsvy"];
+
+/** A RegExp from a drawn source (one of SOURCES 80% of the time, else a string), flags and 20% of the time a lastIndex; an invalid combination falls back to the flags that take the source, then to the source `a`. */
+const regexp = gs.record({ source: weighted([80, gs.sampledFrom(SOURCES)], [20, plainWords]), flags: gs.sampledFrom(FLAGS), lastIndex: maybe(20, ints(0, 5)) }).map(({ source, flags, lastIndex }) => {
+  let re = /a/g;
+  for (const [s, f] of [[source, flags], [source, "v"], [source, "u"], ["a", flags]]) {
+    try {
+      re = new RegExp(s, f);
+      break;
+    } catch {
+      // an invalid combination: the next
+    }
+  }
+  if (lastIndex !== undefined) re.lastIndex = lastIndex;
+  return re;
+});
+
+/** A boxed number, string, boolean or bigint. */
+const boxed = (shape) => weighted([35, num], [30, strFor(shape)], [15, gs.booleans()], [20, big]).map((v) => Object(v));
+
+// ---------------------------------------------------------------- binary
+
+/** The bytes of a buffer: 0-12 of them 80% of the time, else 63, 64, 65 or 300. */
+const bytes = weighted([80, gs.binary({ maxSize: 12 })], [20, gs.sampledFrom([63, 64, 65, 300]).flatMap((len) => gs.binary({ minSize: len, maxSize: len }))]);
+
+/** A buffer holding `bs`, its length rounded up to a multiple of `multiple`. */
+function bufferOf(bs, multiple = 1, Buffer = ArrayBuffer) {
+  const b = new Buffer(Math.ceil(bs.length / multiple) * multiple);
+  new Uint8Array(b).set(bs);
+  return b;
+}
+const arrayBuffer = bytes.map((bs) => bufferOf(bs));
+const sharedArrayBuffer = bytes.map((bs) => bufferOf(bs, 1, SharedArrayBuffer));
+
+/** A DataView over a buffer; with shape.dataViewRange, 60% of the time over a part of it (offset and length taken modulo what fits). */
+const dataView = (shape) =>
+  gs.record({ bytes, range: shape.dataViewRange ? maybe(60, gs.tuples(ints(0, 99), ints(0, 99))) : gs.just(undefined) }).map(({ bytes, range }) => {
+    const b = bufferOf(bytes);
+    if (range === undefined) return new DataView(b);
+    const offset = range[0] % (b.byteLength + 1);
+    return new DataView(b, offset, range[1] % (b.byteLength - offset + 1));
+  });
+
+const TYPED = [Int8Array, Uint8Array, Uint8ClampedArray, Int16Array, Uint16Array, Int32Array, Uint32Array, Float32Array, Float64Array, BigInt64Array, BigUint64Array];
+const BIG_TYPED = new Set([BigInt64Array, BigUint64Array]);
+const FLOAT_TYPED = new Set([Float32Array, Float64Array]);
+/** An element of a `Ctor` array: a 64-bit bigint, a number, or a small integer. */
+const elementOf = (Ctor) => (BIG_TYPED.has(Ctor) ? big.map((x) => BigInt.asIntN(64, x)) : FLOAT_TYPED.has(Ctor) ? num : ints(-300, 300));
+/** The backing store's extra elements before or after a view: none 70% of the time, else 1-3. */
+const margin = weighted([70, gs.just(0)], [30, ints(1, 3)]);
+/** A typed array of 0-6 elements, possibly at an (aligned) offset into a larger buffer whose other bytes are 0xee. */
+const typedArray = gs
+  .sampledFrom(TYPED)
+  .flatMap((Ctor) => gs.record({ Ctor: gs.just(Ctor), before: margin, items: gs.arrays(elementOf(Ctor), { maxSize: 6 }), after: margin }))
+  .map(({ Ctor, before, items, after }) => {
+    const bpe = Ctor.BYTES_PER_ELEMENT;
+    const buf = new ArrayBuffer((before + items.length + after) * bpe);
+    new Uint8Array(buf).fill(0xee);
+    const view = new Ctor(buf, before * bpe, items.length);
+    view.set(items);
+    return view;
+  });
+
+/** A view over a shared buffer as data: a typed array of up to 6 elements at a position taken modulo the room, or a DataView over the whole buffer. */
+const sharedView = weighted([80, gs.record({ Ctor: gs.sampledFrom(TYPED), len: ints(0, 6), at: ints(0, 99) })], [20, gs.just("DataView")]);
+/** Several views over one buffer (a multiple of every element size), 30% of the time the buffer itself too: an array. */
+const sharedViews = gs.record({ bytes, views: gs.arrays(sharedView, { minSize: 2, maxSize: 3 }), withBuffer: chance(30) }).map(({ bytes, views, withBuffer }) => {
+  const b = bufferOf(bytes, 8);
+  const out = views.map((spec) => {
+    if (spec === "DataView") return new DataView(b);
+    const { Ctor, len, at } = spec;
+    const room = b.byteLength / Ctor.BYTES_PER_ELEMENT;
+    const l = Math.min(len, room);
+    return new Ctor(b, (at % (room - l + 1)) * Ctor.BYTES_PER_ELEMENT, l);
+  });
+  if (withBuffer) out.push(b);
+  return out;
+});
+
+/** Binary: an ArrayBuffer, a typed array, a DataView (over a range only with shape.dataViewRange), a SharedArrayBuffer (shape.sab), or several views sharing one buffer (shape.sharedBuffers). */
+function bin(shape) {
+  const choices = [[15, arrayBuffer], [shape.sharedBuffers ? 50 : 65, typedArray], [15, dataView(shape)]];
+  if (shape.sab) choices.push([5, sharedArrayBuffer]);
+  if (shape.sharedBuffers) choices.push([15, sharedViews]);
+  return weighted(...choices);
+}
+
+// ---------------------------------------------------------------- what the algorithm refuses
+
+/** Objects with internal slots the algorithm cannot clone. */
+const EXOTIC = {
+  Promise: () => Promise.resolve(1),
+  WeakMap: () => new WeakMap(),
+  WeakSet: () => new WeakSet(),
+  WeakRef: () => new WeakRef({}),
+  Symbol: () => Object(Symbol("s")),
+  arguments: () => (function () { return arguments; })(1, "two"),
+};
+const exotic = gs.sampledFrom(Object.keys(EXOTIC)).map((k) => EXOTIC[k]());
+
+/** A function or a symbol (what the algorithm refuses; lossy mode drops them). */
+const uncloneable = gs.sampledFrom([() => 1, function named() {}, Math.max, Symbol("s"), Symbol.iterator]);
+
+// ---------------------------------------------------------------- leaves
+
+/** A primitive or a leaf object of the shape (nothing that holds a child node). */
+export function leaf(shape) {
+  const choices = [[6, gs.just(null)], [6, gs.booleans()], [20, num], [18, strFor(shape)]];
+  if (shape.undefined) choices.push([6, gs.just(undefined)]);
+  if (shape.bigint) choices.push([6, big]);
+  if (shape.date) choices.push([6, date]);
+  if (shape.regexp) choices.push([5, regexp]);
+  if (shape.boxed) choices.push([5, boxed(shape)]);
+  if (shape.bin) choices.push([9, bin(shape)]);
+  if (shape.exotic) choices.push([3, exotic]);
+  if (shape.functions) choices.push([3, uncloneable]);
+  return weighted(...choices);
+}
+
+// ---------------------------------------------------------------- Errors
+
+const STANDARD_ERRORS = [Error, TypeError, RangeError, ReferenceError, SyntaxError, URIError, EvalError];
+// names of globals that are constructors: an Error given one of these as its `name` ...
+const GLOBAL_NAMES = ["Array", "Date", "Map", "Set", "Uint8Array", "Object", "Boolean", "Number", "String", "RegExp", "Promise", "ArrayBuffer", "WeakRef", "Symbol", "BigInt"];
+const OTHER_NAMES = ["Foo", "MyError", "", "error", "AbortError", "Error ", "TypeErr"];
+const DOM_NAMES = ["AbortError", "NotFoundError", "InvalidStateError", "DataCloneError", "TimeoutError", "Error"];
+
+class ZooError extends Error {
+  constructor(message, options) {
+    super(message, options);
+    this.name = "ZooError";
+  }
+}
+
+/** The kind of an Error: a built-in one, an AggregateError (shape.aggregate; with two errors or none), a DOMException (shape.domException), a subclass, or a plain Error. */
+function errorKind(shape) {
+  const choices = [[55, gs.sampledFrom(STANDARD_ERRORS).map((ctor) => ({ ctor }))]];
+  if (shape.aggregate) choices.push([10, chance(50).map((inner) => ({ ctor: AggregateError, inner }))]);
+  if (shape.domException) choices.push([10, gs.sampledFrom(DOM_NAMES).map((domName) => ({ ctor: DOMException, domName }))]);
+  choices.push([10, gs.just({ ctor: ZooError })], [15, gs.just({ ctor: Error })]);
+  return weighted(...choices);
+}
+/** An Error's odd `name`: another global's 60% of the time, else a name that is no constructor. */
+const oddName = weighted([60, gs.sampledFrom(GLOBAL_NAMES)], [40, gs.sampledFrom(OTHER_NAMES)]);
+
+/** A tree node of kind `k` with the given fields. */
+const node = (k, fields) => gs.record({ k: gs.just(k), ...fields });
+
+/** An Error node: its kind, a message (a string 85% of the time, else a number's text), a `cause` (shape.cause, 30%: a child node), an odd name (shape.oddErrorNames, 40%) and an extra own `code` property (15%; dropped by the algorithm). */
+function errorNode(shape, cause) {
+  return node("error", {
+    kind: errorKind(shape),
+    message: weighted([85, strFor(shape)], [15, num.map(String)]),
+    cause: shape.cause ? maybe(30, cause) : gs.just(undefined),
+    name: shape.oddErrorNames ? maybe(40, oddName) : gs.just(undefined),
+    code: maybe(15, strFor(shape)),
+  });
+}
+
+/** The leaf nodes of a level: a plain leaf, or (shape.error) an Error whose cause is drawn from `cause`. */
+const leafNodeFor = (shape, plainLeafNode, cause) => (shape.error ? weighted([93, plainLeafNode], [7, errorNode(shape, cause)]) : plainLeafNode);
+
+// ---------------------------------------------------------------- containers
+
+const PROP_KEYS = ["foo", "-1", "1.5", "length1", "x y", ""];
+const TAGS = ["Array", "Map", "Set", "Date", "RegExp", "Int8Array", "Uint8Array", "Float64Array", "ArrayBuffer", "DataView", "Error", "Foo", "Object", "Promise", "Number", "Boolean", "BigInt"];
+
+/** 0-5 children 80% of the time, else 6-`most`. */
+const children = (child, most) => weighted([80, gs.arrays(child, { maxSize: 5 })], [20, gs.arrays(child, { minSize: 6, maxSize: most })]);
+
+/** What a plain object's toJSON is: a function returning a fresh leaf, one returning a wrapper, one returning the receiver, or not callable. */
+const toJsonSpec = (shape) =>
+  weighted(
+    [40, leaf(shape).map((v) => ({ kind: "fresh", v }))],
+    [20, gs.just({ kind: "wrapped" })],
+    [20, gs.just({ kind: "self" })],
+    [20, gs.sampledFrom([1, "s", null, true]).map((v) => ({ kind: "value", v }))],
+  );
+
+/** The container nodes of the shape, by kind, with children from `child` (a node generator) and `leafNode` (the level's leaf nodes). */
+function containersFor(shape, child, leafNode) {
+  const dense = gs.record({ items: children(child, 30) });
+  // a sparse array: a length (0-12, or 13-400), up to 8 elements at positions taken modulo it, and 30% of the time its last element
+  const sparse = gs.record({ len: weighted([70, ints(0, 12)], [30, ints(13, 400)]), fills: gs.arrays(gs.tuples(ints(0, 399), child), { maxSize: 8 }), last: maybe(30, child) });
+  const plainObject = node("object", {
+    nullProto: shape.nullProto ? chance(15) : gs.just(false),
+    entries: children(gs.tuples(key(shape), child), 25),
+    toJSON: shape.toJSON ? maybe(20, toJsonSpec(shape)) : gs.just(undefined),
+  });
+  const tagged = node("tagged", { tag: gs.sampledFrom(TAGS), a: maybe(70, child) });
+  const containers = {
+    array: node("array", {
+      layout: shape.sparse ? weighted([80, dense], [20, sparse]) : dense,
+      prop: shape.arrayProps ? maybe(15, gs.tuples(gs.sampledFrom(PROP_KEYS), child)) : gs.just(undefined),
+    }),
+    object: shape.tagged ? weighted([92, plainObject], [8, tagged]) : plainObject,
+  };
+  // a Map key is mostly a leaf (NaN, -0, undefined, bigint included), sometimes a container; a Set element likewise
+  if (shape.map) containers.map = node("map", { entries: gs.arrays(gs.tuples(weighted([80, leafNode], [20, child]), child), { maxSize: 5 }) });
+  if (shape.set) containers.set = node("set", { items: gs.arrays(weighted([70, leafNode], [30, child]), { maxSize: 5 }) });
+  return containers;
+}
+
+// ---------------------------------------------------------------- the rendering
+
+/** The toJSON member `spec` describes, on the object `o`. */
+function toJsonOf(o, spec) {
+  switch (spec.kind) {
+    case "fresh":
+      return () => spec.v;
+    case "wrapped":
+      return () => ({ wrapped: Object.keys(o).length });
+    case "self":
+      return function () { return this; };
+    default:
+      return spec.v;
+  }
+}
+
+/** The Error a node describes (its cause built against the pool). */
+function errorOf(node, pool) {
+  const { kind, name, code } = node;
+  let message = node.message;
+  // a numeric message on an Error named after a typed array or ArrayBuffer becomes the length of
+  // what the polyfill constructs (bug 5): "4294967296" is 4 GiB, which nothing here could render
+  if (name !== undefined && /^[0-9]/.test(message)) message = "n" + message;
+  const options = node.cause === undefined ? undefined : { cause: build(node.cause, pool) };
+  let e;
+  if (kind.ctor === AggregateError) e = new AggregateError(kind.inner ? [new Error("inner"), 1] : [], message, options);
+  else if (kind.ctor === DOMException) e = new DOMException(message, kind.domName);
+  else e = new kind.ctor(message, options);
+  if (e instanceof DOMException) return e; // its name and code are getters
+  if (name !== undefined) e.name = name;
+  if (code !== undefined) e.code = code;
+  return e;
+}
+
+/**
+ * The value graph a drawn tree describes. `pool` is the containers built so far, in depth-first
+ * order; a reference resolves to one of them by its index modulo their number (null when there
+ * is none yet). Errors and views are not in the pool.
+ */
+export function build(node, pool = []) {
+  switch (node.k) {
+    case "leaf":
+      return node.v;
+    case "ref":
+      return pool.length ? pool[node.at % pool.length] : null;
+    case "array": {
+      const a = [];
+      pool.push(a);
+      const { layout, prop } = node;
+      if (layout.items !== undefined) {
+        for (const item of layout.items) a.push(build(item, pool));
+      } else {
+        a.length = layout.len;
+        if (layout.len) for (const [at, v] of layout.fills) a[at % layout.len] = build(v, pool);
+        if (layout.len && layout.last !== undefined) a[layout.len - 1] = build(layout.last, pool);
+      }
+      if (prop !== undefined) a[prop[0]] = build(prop[1], pool);
+      return a;
+    }
+    case "object": {
+      const o = node.nullProto ? Object.create(null) : {};
+      pool.push(o);
+      for (const [k, v] of node.entries) put(o, k, build(v, pool));
+      if (node.toJSON !== undefined) o.toJSON = toJsonOf(o, node.toJSON);
+      return o;
+    }
+    case "tagged": {
+      const o = { [Symbol.toStringTag]: node.tag };
+      pool.push(o);
+      if (node.a !== undefined) o.a = build(node.a, pool);
+      return o;
+    }
+    case "map": {
+      const m = new Map();
+      pool.push(m);
+      for (const [k, v] of node.entries) m.set(build(k, pool), build(v, pool));
+      return m;
+    }
+    case "set": {
+      const s = new Set();
+      pool.push(s);
+      for (const item of node.items) s.add(build(item, pool));
+      return s;
+    }
+    case "error":
+      return errorOf(node, pool);
+  }
+  throw new Error(`unknown node kind ${node.k}`);
+}
+
+/**
+ * Any value of the shape: a leaf 20% of the time, else a container (object 45%, array 35%, Map
+ * 10%, Set 10%) nesting up to depth 4. Below the root a node is a leaf 44% of the time, else a
+ * container (array 18, object 16, Map 5, Set 5), and with `shape.share` a reference to an earlier
+ * container 12% of the time (a cycle when it is an ancestor).
+ */
+export function values(shape) {
+  const plainLeafNode = leaf(shape).map((v) => ({ k: "leaf", v }));
+  const ref = node("ref", { at: ints(0, 99) });
+  // depth 4: leaves (an Error's cause a plain leaf); depths 3 to 1: containers whose children are the level below
+  let child = leafNodeFor(shape, plainLeafNode, plainLeafNode);
+  for (let depth = 3; depth >= 1; depth--) {
+    const leafNode = leafNodeFor(shape, plainLeafNode, child);
+    const c = containersFor(shape, child, leafNode);
+    const choices = [[44, leafNode], [18, c.array], [16, c.object]];
+    if (c.map) choices.push([5, c.map]);
+    if (c.set) choices.push([5, c.set]);
+    if (shape.share) choices.push([12, ref]);
+    child = weighted(...choices);
+  }
+  const leafNode = leafNodeFor(shape, plainLeafNode, child);
+  const c = containersFor(shape, child, leafNode);
+  const roots = [[45, c.object], [35, c.array]];
+  if (c.map) roots.push([10, c.map]);
+  if (c.set) roots.push([10, c.set]);
+  return weighted([20, leafNode], [80, weighted(...roots)]).map((tree) => build(tree));
+}
+
+// ---------------------------------------------------------------- hostile records
+
+const TYPE_CODES = [-1, 0, 1, 2, 3, 4, 5, 6, 7, 8, "BigInt", "Boolean", "Number", "String", "ArrayBuffer", "DataView", "Uint8Array", "Float64Array", "Int16Array", "-0", "Foo", "", 9, 99, null];
+const HOSTILE_NAMES = ["Error", "TypeError", "Foo", "__proto__", "constructor", "Uint8Array", "Boolean", "Symbol", "Function", "eval"];
+const POLLUTERS = ["__proto__", "constructor", "prototype", "polluted"];
+const EXTRA_RECORDS = [[], [2], [2, [["__proto__", 0]]], [2, [[0, 0]]], [1, [0]]];
+
+/** A record index: 85% of the time a position taken modulo the number of records, else one that is out of range or not a number. */
+const index = weighted([85, ints(0, 99).map((at) => ({ at }))], [15, gs.sampledFrom([-1, "size", "size+5", 1e9, "0", null]).map((bad) => ({ bad }))]);
+/** A record's payload: a leaf, 0-4 indices, 0-4 index pairs, an error or regexp payload, a prototype-ish string, or an index with such a string. */
+const hostilePayload = weighted(
+  [20, leaf(CLEAN).map((v) => ({ kind: "leaf", v }))],
+  [25, gs.arrays(index, { maxSize: 4 }).map((items) => ({ kind: "indices", items }))],
+  [20, gs.arrays(gs.tuples(index, index), { maxSize: 4 }).map((pairs) => ({ kind: "pairs", pairs }))],
+  [10, gs.record({ kind: gs.just("error"), name: gs.sampledFrom(HOSTILE_NAMES), message: str })],
+  [10, gs.record({ kind: gs.just("regexp"), source: gs.sampledFrom(["a", "(", "[", "\\"]), flags: gs.sampledFrom(["", "g", "q", "gg"]) })],
+  [7, gs.sampledFrom(POLLUTERS).map((v) => ({ kind: "leaf", v }))],
+  [8, gs.tuples(index, gs.sampledFrom(["__proto__", "polluted"])).map(([i, k]) => ({ kind: "keyed", i, k }))],
+);
+
+/** The payload `p` with its indices resolved against `size` records. */
+function payloadOf(p, size) {
+  const at = (i) => (i.at !== undefined ? (size ? i.at % size : 0) : i.bad === "size" ? size : i.bad === "size+5" ? size + 5 : i.bad);
+  switch (p.kind) {
+    case "leaf":
+      return p.v;
+    case "indices":
+      return p.items.map(at);
+    case "pairs":
+      return p.pairs.map(([a, b]) => [at(a), at(b)]);
+    case "error":
+      return { name: p.name, message: p.message };
+    case "regexp":
+      return { source: p.source, flags: p.flags };
+    default:
+      return [at(p.i), p.k];
+  }
+}
+
+/** The hostile-records case: 0-6 records of a type code and a payload, 30% of the time followed by a malformed fixed record. */
+export const hostileRecords = gs
+  .record({ records: gs.arrays(gs.tuples(gs.sampledFrom(TYPE_CODES), hostilePayload), { maxSize: 6 }), extra: maybe(30, gs.sampledFrom(EXTRA_RECORDS)) })
+  .map(({ records, extra }) => {
+    const out = records.map(([type, p]) => [type, payloadOf(p, records.length)]);
+    if (extra !== undefined) out.push(extra);
+    return out;
+  });
diff --git a/hegel/hegel-zoo.mjs b/hegel/hegel-zoo.mjs
new file mode 100644
index 0000000..a2a3479
--- /dev/null
+++ b/hegel/hegel-zoo.mjs
@@ -0,0 +1,116 @@
+// Hegel zoo: the small harness shared by the zoo's TypeScript/JavaScript targets.
+//
+// `property(name, body)` registers a node:test test that runs `body(tc)` under Hegel with
+// HEGEL_TEST_CASES cases (default 100) and the database at HEGEL_DATABASE. With ZOO_COLLECT=1
+// a `fail()` records the mismatch instead of failing, the case ends there, and the counts of
+// mismatches and of the shapes seen (`count(key)`) are printed at the end of the test, so a
+// property can be run over many cases to see every shape at once. `pin(name, body)` is a
+// plain test for one pinned bug: it must fail while the bug is present and pass once it is
+// fixed (the zoo's judge reads an unexpected pass as "fixed upstream?").
+
+import { readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+import { test as nodeTest } from "node:test";
+
+// The Hegel version these tests were written against (the zoo pins it in zoo.toml; upstream
+// would add it to devDependencies). Hegel is installed with `npm install --prefix .hegel` so the
+// target's own package.json and lock file stay untouched. Checked at load time so a stray
+// install cannot silently change the engine.
+export const HEGEL_PIN = { "@hegeldev/hegel": "0.4.5" };
+
+const hegelDir = join(dirname(fileURLToPath(import.meta.url)), "..", ".hegel", "node_modules", "@hegeldev", "hegel");
+{
+  const installed = JSON.parse(readFileSync(join(hegelDir, "package.json"), "utf8")).version;
+  if (installed !== HEGEL_PIN["@hegeldev/hegel"]) {
+    throw new Error(`@hegeldev/hegel ${installed} is installed; these tests pin ${HEGEL_PIN["@hegeldev/hegel"]}`);
+  }
+}
+const hegel = await import(pathToFileURL(join(hegelDir, "dist", "index.js")));
+const gs = await import(pathToFileURL(join(hegelDir, "dist", "generators", "index.js")));
+
+/** Hegel's generators, re-exported so the tests import everything from one place. */
+export { gs };
+
+export const collecting = !!process.env.ZOO_COLLECT;
+
+class Collected extends Error {}
+
+let msgs = [];
+let stats = new Map();
+
+/** Report a mismatch: an error normally, a recorded line in collect mode. */
+export function fail(message) {
+  if (collecting) {
+    msgs.push(message);
+    throw new Collected(message);
+  }
+  throw new Error(message);
+}
+
+/** Bump a statistic (the shape of a pinned bug, a generator branch). */
+export function count(key) {
+  stats.set(key, (stats.get(key) || 0) + 1);
+}
+
+function settings() {
+  const s = { testCases: Number(process.env.HEGEL_TEST_CASES) || 100 };
+  if (process.env.HEGEL_DATABASE) {
+    s.database = hegel.Database.fromPath(process.env.HEGEL_DATABASE);
+  }
+  return s;
+}
+
+/** A property: `body(tc)` runs under Hegel; a thrown error (or `fail`) is a failure. */
+export function property(name, body) {
+  nodeTest(name, () => {
+    msgs = [];
+    stats = new Map();
+    hegel.test((tc) => {
+      try {
+        body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** A pin: a plain test for one recorded bug. */
+export function pin(name, body) {
+  nodeTest(name, body);
+}
+
+/** Structural equality: arrays by position, objects by key set (prototype ignored), else ===. */
+export function same(a, b) {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) {
+      return false;
+    }
+    return a.every((x, i) => same(x, b[i]));
+  }
+  if (a !== null && b !== null && typeof a === "object" && typeof b === "object") {
+    const ka = Object.keys(a).sort();
+    const kb = Object.keys(b).sort();
+    if (ka.length !== kb.length || ka.some((k, i) => k !== kb[i])) {
+      return false;
+    }
+    return ka.every((k) => same(a[k], b[k]));
+  }
+  return a === b;
+}
+
+/** A compact, unambiguous rendering for messages. */
+export function show(x) {
+  return JSON.stringify(x, (k, v) => (v === undefined ? "<undefined>" : v));
+}
diff --git a/hegel/hegel.test.mjs b/hegel/hegel.test.mjs
new file mode 100644
index 0000000..66f2bcf
--- /dev/null
+++ b/hegel/hegel.test.mjs
@@ -0,0 +1,425 @@
+// Hegel zoo: properties of @ungap/structured-clone (ungap/structured-clone) against Node's own
+// `structuredClone` (V8's serializer, the reference implementation of the algorithm the
+// package polyfills), its README (lossy/json modes, "serialized values can be safely stringified
+// as JSON"), and JSON.stringify for the json mode's toJSON contract, through a canonical
+// rendering that compares identity structure (shared references, cycles) as well as contents.
+// Run with `node --test hegel/hegel.test.mjs` from the repository root; HEGEL_TEST_CASES sets
+// the case count, ZOO_COLLECT=1 collects mismatches instead of stopping at the first.
+//
+// The generators are in gen.mjs: a value graph is drawn as a small tree (leaves, containers,
+// references to earlier containers) and built by a pure function; each property draws one value.
+
+import assert from "node:assert/strict";
+import { appendFileSync } from "node:fs";
+import { inspect } from "node:util";
+import { count, fail, pin, property } from "./hegel-zoo.mjs";
+import * as gen from "./gen.mjs";
+import { put } from "./gen.mjs";
+import { canon, diff } from "./canon.mjs";
+import { hasBigIntArray, hasZeroAfterPlusZero, known, lostInJsonText } from "./known.mjs";
+import { deserialize, serialize } from "../esm/index.js";
+import { parse, stringify } from "../esm/json.js";
+
+// ---------------------------------------------------------------------------------------------
+// Helpers
+
+const native = globalThis.structuredClone;
+/** The polyfill's clone: deserialize(serialize(v)), which is what the default export does where there is no native structuredClone. */
+const poly = (v, options) => deserialize(serialize(v, options));
+
+/** Run f; return { value } or { error }. */
+function attempt(f) {
+  try {
+    return { value: f() };
+  } catch (error) {
+    return { error };
+  }
+}
+
+const describeError = (e) => (e && e.constructor ? e.constructor.name : "?") + ": " + (e && e.message);
+
+/** Compare the outcome of the polyfill with the oracle's: both throw, or both return canon-equal values. Returns null when they agree, else a message. */
+function compare(expected, actual, options) {
+  if (expected.error && actual.error) {
+    count("both-throw");
+    return null;
+  }
+  if (expected.error) return `oracle throws (${describeError(expected.error)}) but the polyfill returns ${cut(canon(actual.value, options))}`;
+  if (actual.error) return `oracle returns ${cut(canon(expected.value, options))} but the polyfill throws ${describeError(actual.error)}`;
+  const a = canon(expected.value, options);
+  const b = canon(actual.value, options);
+  return a === b ? null : diff(a, b);
+}
+
+// The README supports typed arrays "without major issues": the polyfill writes a view's elements
+// and nothing of its buffer, so on the CLEAN space views compare by elements (bug 11 covers the rest).
+const BY_ELEMENTS = { viewsByElements: true };
+
+// the value space on which the two are recorded to agree: no shape of a recorded bug
+const cleanValue = gen.values(gen.CLEAN);
+// the whole value space
+const fullValue = gen.values(gen.FULL);
+
+/** The one shape of a recorded bug the CLEAN generator cannot avoid without changing the numbers it draws, a -0 after a +0 (bug 17): counted, not judged. */
+function skipZeroAfterPlusZero(tc, v) {
+  if (hasZeroAfterPlusZero(v)) {
+    count("skipped: -0 after +0");
+    tc.assume(false);
+  }
+}
+
+const cut = (s) => (s.length > 300 ? s.slice(0, 300) + "..." : s);
+
+/** With ZOO_TRACE=<file>, append every value a property is about to clone (to find one that hangs). */
+function trace(v) {
+  if (process.env.ZOO_TRACE) appendFileSync(process.env.ZOO_TRACE, inspect(v, { depth: 8, breakLength: Infinity, maxArrayLength: 50, maxStringLength: 100 }) + "\n");
+}
+
+/** Report a mismatch on `v`: counted against a recorded bug when `v` has its shape, a failure otherwise. */
+function judge(v, message, label) {
+  if (message === null) return;
+  const bug = known(v);
+  if (bug) {
+    count(bug);
+    return;
+  }
+  fail(`${label}: ${message}\n  value: ${cut(canon(v))}`);
+}
+
+/** A copy of `v` with functions and symbols removed the way the README says lossy mode removes them: object properties dropped, array elements replaced by null, Map entries and Set elements dropped, the root itself becoming null. Identity structure is kept. */
+function stripped(v) {
+  const memo = new Map();
+  const skip = (x) => typeof x === "function" || typeof x === "symbol";
+  function go(x) {
+    if (skip(x)) return null;
+    if (x === null || typeof x !== "object") return x;
+    if (memo.has(x)) return memo.get(x);
+    if (Array.isArray(x)) {
+      const a = [];
+      memo.set(x, a);
+      for (let i = 0; i < x.length; i++) a.push(go(x[i]));
+      return a;
+    }
+    if (x instanceof Map) {
+      const m = new Map();
+      memo.set(x, m);
+      for (const [k, y] of x) if (!skip(k) && !skip(y)) m.set(go(k), go(y));
+      return m;
+    }
+    if (x instanceof Set) {
+      const s = new Set();
+      memo.set(x, s);
+      for (const y of x) if (!skip(y)) s.add(go(y));
+      return s;
+    }
+    const tag = Object.prototype.toString.call(x).slice(8, -1);
+    if (tag !== "Object") return x; // leaves (Date, RegExp, views, boxed, Error) carry no functions
+    const o = {};
+    memo.set(x, o);
+    for (const k of Object.keys(x)) if (!skip(x[k])) put(o, k, go(x[k]));
+    return o;
+  }
+  return go(v);
+}
+
+/** Whether `v` holds a function or symbol at a position the strict serializer visits. */
+function hasUncloneable(v) {
+  const seen = new Set();
+  const skip = (x) => typeof x === "function" || typeof x === "symbol";
+  function go(x) {
+    if (skip(x)) return true;
+    if (x === null || typeof x !== "object" || seen.has(x)) return false;
+    seen.add(x);
+    if (Array.isArray(x)) return x.some((y) => go(y));
+    if (x instanceof Map) return [...x].some(([k, y]) => go(k) || go(y));
+    if (x instanceof Set) return [...x].some((y) => go(y));
+    if (Object.prototype.toString.call(x) !== "[object Object]") return false;
+    return Object.keys(x).some((k) => go(x[k]));
+  }
+  return go(v);
+}
+
+// ---------------------------------------------------------------------------------------------
+// The polyfill against the native implementation
+
+property("TestHegelCloneMatchesNative", (tc) => {
+  const v = tc.draw(cleanValue);
+  skipZeroAfterPlusZero(tc, v);
+  const message = compare(attempt(() => native(v)), attempt(() => poly(v)), BY_ELEMENTS);
+  if (message !== null) fail(`clone: ${message}\n  value: ${cut(canon(v))}`);
+});
+
+property("TestHegelCloneMatchesNativeEverywhere", (tc) => {
+  // a mismatch must be one of the recorded bugs' shapes
+  const v = tc.draw(fullValue);
+  trace(v);
+  judge(v, compare(attempt(() => native(v)), attempt(() => poly(v))), "clone");
+});
+
+property("TestHegelJsonRoundTripMatchesNative", (tc) => {
+  // the json module: parse(stringify(v)) against native (json mode implies lossy; no functions here)
+  const v = tc.draw(cleanValue);
+  skipZeroAfterPlusZero(tc, v);
+  const expected = attempt(() => native(v));
+  const actual = attempt(() => parse(stringify(v)));
+  const message = compare(expected, actual, BY_ELEMENTS);
+  if (message === null) return;
+  if (actual.error && /toJSON is not a function/.test(actual.error.message)) return count("structured-clone/13");
+  if (lostInJsonText(v)) return count("structured-clone/15");
+  if (hasBigIntArray(v)) return count("structured-clone/16");
+  fail(`json: ${message}\n  value: ${cut(canon(v))}`);
+});
+
+property("TestHegelRecordsSurviveJsonText", (tc) => {
+  // README: "Serialized values can be safely stringified as JSON too, and deserialization resurrect all values"
+  const v = tc.draw(cleanValue); // the two deserializations see the same records, so bug 17 does not matter here
+  const records = serialize(v);
+  const text = attempt(() => JSON.stringify(records));
+  if (text.error) {
+    if (hasBigIntArray(v)) return count("structured-clone/16");
+    return fail(`JSON.stringify(serialize(v)) throws ${describeError(text.error)}\n  value: ${cut(canon(v))}`);
+  }
+  const direct = canon(deserialize(records));
+  const viaText = canon(deserialize(JSON.parse(text.value)));
+  if (direct === viaText) return;
+  if (lostInJsonText(v)) return count("structured-clone/15");
+  fail(`records through JSON text: ${diff(direct, viaText)}\n  value: ${cut(canon(v))}`);
+});
+
+// ---------------------------------------------------------------------------------------------
+// lossy / strict modes (README "Extra Features")
+
+// the CLEAN space with functions and symbols among the leaves
+const valueWithFunctions = gen.values(gen.withKeys(gen.CLEAN, "functions"));
+
+property("TestHegelLossyDropsFunctionsAndSymbolsLikeJson", (tc) => {
+  const v = tc.draw(valueWithFunctions);
+  skipZeroAfterPlusZero(tc, v);
+  if (hasUncloneable(v)) count("with-uncloneable");
+  const expected = attempt(() => native(stripped(v)));
+  const actual = attempt(() => poly(v, { lossy: true }));
+  const message = compare(expected, actual, BY_ELEMENTS);
+  if (message !== null) fail(`lossy: ${message}\n  value: ${cut(canon(v))}`);
+});
+
+property("TestHegelStrictRefusesFunctionsAndSymbols", (tc) => {
+  const v = tc.draw(valueWithFunctions);
+  const has = hasUncloneable(v);
+  const r = attempt(() => serialize(v));
+  if (has) {
+    count("refused");
+    if (!r.error) return fail(`serialize accepted a value holding a function or symbol: ${cut(canon(v))}`);
+    if (!(r.error instanceof TypeError) || !/^unable to serialize (function|symbol)$/.test(r.error.message)) {
+      fail(`serialize threw ${describeError(r.error)} instead of TypeError "unable to serialize function|symbol"`);
+    }
+    // the native implementation refuses it too
+    const nat = attempt(() => native(v));
+    if (!nat.error) fail(`native structuredClone accepted what the polyfill refused: ${cut(canon(v))}`);
+  } else if (r.error) {
+    fail(`serialize threw ${describeError(r.error)} on a value without functions or symbols: ${cut(canon(v))}`);
+  }
+});
+
+// ---------------------------------------------------------------------------------------------
+// json mode's toJSON contract, against JSON.stringify's
+
+// the CLEAN space whose plain objects carry a toJSON 20% of the time (returning a fresh value, a wrapper, `this`, or not callable)
+const valueWithToJSON = gen.values(gen.withKeys(gen.CLEAN, "toJSON"));
+
+/** Whether a plain object anywhere in `v` has an own `toJSON` (inserted, or a drawn key). */
+function hasOwnToJSON(v) {
+  const seen = new Set();
+  function go(x) {
+    if (x === null || typeof x !== "object" || seen.has(x)) return false;
+    seen.add(x);
+    if (Array.isArray(x)) return x.some(go);
+    if (x instanceof Map) return [...x].some(([k, y]) => go(k) || go(y));
+    if (x instanceof Set) return [...x].some(go);
+    if (Object.prototype.toString.call(x) !== "[object Object]") return false;
+    return Object.hasOwn(x, "toJSON") || Object.keys(x).some((k) => go(x[k]));
+  }
+  return go(v);
+}
+
+/** JSON.stringify's model: an object with a callable toJSON is replaced by its result (once, not recursively on itself); a non-callable toJSON is an ordinary property. Identity kept. */
+function jsonModel(v) {
+  const memo = new Map();
+  function go(x, fromToJSON) {
+    if (x === null || typeof x !== "object") return x;
+    if (memo.has(x)) return memo.get(x);
+    if (Array.isArray(x)) {
+      const a = [];
+      memo.set(x, a);
+      for (const y of x) a.push(go(y, false));
+      return a;
+    }
+    if (x instanceof Map) {
+      const m = new Map();
+      memo.set(x, m);
+      for (const [k, y] of x) m.set(go(k, false), go(y, false));
+      return m;
+    }
+    if (x instanceof Set) {
+      const s = new Set();
+      memo.set(x, s);
+      for (const y of x) s.add(go(y, false));
+      return s;
+    }
+    if (Object.prototype.toString.call(x) !== "[object Object]") return x;
+    if (!fromToJSON && typeof x.toJSON === "function") {
+      const r = x.toJSON();
+      if (r === x) return go(x, true);
+      return go(r, false);
+    }
+    const o = {};
+    memo.set(x, o);
+    for (const k of Object.keys(x)) {
+      if (typeof x[k] === "function") continue; // lossy mode drops the toJSON function itself
+      put(o, k, go(x[k], false));
+    }
+    return o;
+  }
+  return go(v, false);
+}
+
+property("TestHegelJsonModeAppliesToJSONLikeJsonStringify", (tc) => {
+  const v = tc.draw(valueWithToJSON);
+  skipZeroAfterPlusZero(tc, v);
+  if (hasOwnToJSON(v)) count("with-toJSON");
+  const model = jsonModel(v);
+  const expected = attempt(() => native(model));
+  const actual = attempt(() => poly(v, { json: true }));
+  const message = compare(expected, actual, BY_ELEMENTS);
+  if (message === null) return;
+  // the recorded bug: toJSON returning the receiver overflows the stack; a non-callable toJSON is called
+  if (actual.error && (actual.error instanceof RangeError || /toJSON is not a function/.test(actual.error.message))) return count("structured-clone/13");
+  fail(`json mode: ${message}\n  value: ${cut(canon(v))}`);
+});
+
+// ---------------------------------------------------------------------------------------------
+// Hostile records
+
+const PROTOS = [Object.prototype, Array.prototype, Error.prototype, Map.prototype, Function.prototype, Uint8Array.prototype, Date.prototype];
+
+function snapshot() {
+  return PROTOS.map((p) => Object.getOwnPropertyNames(p).sort().join(",")).join("|");
+}
+
+property("TestHegelDeserializeReturnsOrThrowsAndNeverPollutes", (tc) => {
+  // records with bad indices, `__proto__`/`constructor` keys, error and regexp payloads
+  const records = tc.draw(gen.hostileRecords);
+  const before = snapshot();
+  const r = attempt(() => deserialize(records));
+  if (r.error && !(r.error instanceof Error)) fail(`deserialize threw a non-Error: ${String(r.error)}`);
+  if (r.error) count("throws");
+  else count("returns");
+  if (snapshot() !== before) fail(`a built-in prototype changed after deserialize(${JSON.stringify(records)})`);
+  if (({}).polluted !== undefined || [].polluted !== undefined) fail(`Object/Array prototype polluted by ${JSON.stringify(records)}`);
+});
+
+// ---------------------------------------------------------------------------------------------
+// Pins: one per bug in bugs.toml (each must fail while the bug is present)
+
+const cloneOf = (v) => poly(v);
+
+pin("TestHegelPinHolesStayHoles", () => {
+  const c = cloneOf([, 1]);
+  assert.equal(0 in c, false, "the clone of [, 1] has index 0 (a hole became undefined)");
+});
+
+pin("TestHegelPinArraysKeepTheirOwnProperties", () => {
+  const c = cloneOf(Object.assign([1], { foo: 2 }));
+  assert.equal(c.foo, 2, "the own property foo of an array is lost");
+});
+
+pin("TestHegelPinErrorsKeepTheirCause", () => {
+  const c = cloneOf(new Error("m", { cause: 1 }));
+  assert.equal(c.cause, 1, "the cause of an Error is lost");
+});
+
+pin("TestHegelPinAggregateErrorsKeepTheirMessage", () => {
+  const c = cloneOf(new AggregateError([], "agg"));
+  assert.equal(c.message, "agg", `the message of an AggregateError is lost (errors: ${JSON.stringify(c.errors)})`);
+});
+
+pin("TestHegelPinRecordsDoNotConstructArbitraryGlobals", () => {
+  let constructed = 0;
+  globalThis.ZooSpy = class ZooSpy { constructor() { constructed++; } };
+  try {
+    attempt(() => deserialize([["ZooSpy", "x"]]));
+    attempt(() => deserialize([[7, { name: "ZooSpy", message: "x" }]]));
+    const viaError = attempt(() => cloneOf(Object.assign(new Error("x"), { name: "ZooSpy" })));
+    assert.equal(constructed, 0, "deserialize called the constructor of a global named by the records");
+    assert.ok(viaError.value instanceof Error, "an Error whose name is a global's clones as something else");
+    const asArray = cloneOf(Object.assign(new Error("3"), { name: "Array" }));
+    assert.ok(asArray instanceof Error, "an Error named Array clones as an Array");
+  } finally {
+    delete globalThis.ZooSpy;
+  }
+});
+
+pin("TestHegelPinDOMExceptionsSurvive", () => {
+  const c = cloneOf(new DOMException("aborted", "AbortError"));
+  assert.equal(c.name, "AbortError", "a DOMException clones as a plain Error");
+});
+
+pin("TestHegelPinUncloneableObjectsAreRefused", () => {
+  for (const v of [Promise.resolve(1), new WeakMap(), new WeakRef({}), Object(Symbol("s"))]) {
+    const r = attempt(() => serialize(v));
+    assert.ok(r.error, `${Object.prototype.toString.call(v)} is serialized (as ${JSON.stringify(r.value)}) instead of refused`);
+  }
+});
+
+pin("TestHegelPinSharedArrayBuffersClone", () => {
+  const sab = new SharedArrayBuffer(3);
+  new Uint8Array(sab).set([1, 2, 3]);
+  const c = cloneOf(sab);
+  assert.deepEqual([...new Uint8Array(c)], [1, 2, 3]);
+});
+
+pin("TestHegelPinDataViewsKeepTheirRange", () => {
+  const c = cloneOf(new DataView(new Uint8Array([1, 2, 3, 4]).buffer, 1, 2));
+  assert.deepEqual([c.byteOffset, c.byteLength], [1, 2], "a DataView over part of a buffer comes back over the whole buffer");
+});
+
+pin("TestHegelPinRepeatedBufferReferencesStayOneObject", () => {
+  const b = new ArrayBuffer(2);
+  const c = cloneOf([b, b]);
+  assert.ok(c[0] === c[1], "two references to one ArrayBuffer clone as two buffers");
+});
+
+pin("TestHegelPinViewsOverOneBufferShareIt", () => {
+  const b = new ArrayBuffer(4);
+  const c = cloneOf([new Uint8Array(b), new Uint16Array(b)]);
+  assert.ok(c[0].buffer === c[1].buffer, "two views over one buffer clone over separate buffers");
+});
+
+pin("TestHegelPinTaggedObjectsArePlainObjects", () => {
+  const c = cloneOf({ [Symbol.toStringTag]: "Array", a: 1 });
+  assert.deepEqual(c, { a: 1 });
+});
+
+pin("TestHegelPinJsonModeToJSONLikeJsonStringify", () => {
+  const self = { toJSON() { return this; }, a: 1 };
+  assert.deepEqual(poly(self, { json: true }), { a: 1 }, "toJSON returning the receiver");
+  assert.deepEqual(poly({ toJSON: 1, a: 1 }, { json: true }), { toJSON: 1, a: 1 }, "a non-callable toJSON");
+});
+
+pin("TestHegelPinNullOptionsAreAccepted", () => {
+  assert.equal(deserialize(serialize(1, null)), 1);
+});
+
+pin("TestHegelPinJsonModuleKeepsNaNAndInfinity", () => {
+  assert.ok(Number.isNaN(parse(stringify(NaN))), `parse(stringify(NaN)) is ${parse(stringify(NaN))}`);
+  assert.equal(parse(stringify(Infinity)), Infinity);
+});
+
+pin("TestHegelPinNegativeZeroAfterZeroStaysNegative", () => {
+  const c = cloneOf([0, -0]);
+  assert.ok(Object.is(c[1], -0), `[0, -0] clones as [${c[0]}, ${Object.is(c[1], -0) ? "-0" : c[1]}]`);
+});
+
+pin("TestHegelPinJsonModuleStringifiesBigIntArrays", () => {
+  const c = parse(stringify(new BigInt64Array([1n])));
+  assert.deepEqual([...c], [1n]);
+});
diff --git a/hegel/known.mjs b/hegel/known.mjs
new file mode 100644
index 0000000..c51e7a4
--- /dev/null
+++ b/hegel/known.mjs
@@ -0,0 +1,176 @@
+// Hegel zoo: the recorded bugs of @ungap/structured-clone, as predicates on the value that was
+// cloned (bugs.toml has the details). `known(v)` walks the value graph and names the first
+// recorded bug whose shape it contains, so a property over the whole value space can count a
+// mismatch against a known bug instead of failing on it; the property over the CLEAN shape
+// (gen.mjs) contains none of these shapes and must never need this.
+
+const tagOf = (x) => Object.prototype.toString.call(x).slice(8, -1);
+const hasOwn = (o, k) => Object.prototype.hasOwnProperty.call(o, k);
+const STANDARD_ERROR_NAMES = new Set(["Error", "TypeError", "RangeError", "ReferenceError", "SyntaxError", "URIError", "EvalError"]);
+const EXOTIC = new Set(["Promise", "WeakMap", "WeakSet", "WeakRef", "Symbol", "Arguments"]);
+// tags the serializer classifies by (typeOf in serialize.js, the OBJECT cases of `pair`)
+const MISLEADING_TAGS = /^(Array|Map|Set|Date|RegExp|DataView|Number|String|Boolean|BigInt|.*Array.*)$/;
+const isBoxed = (x) => x instanceof Number || x instanceof String || x instanceof Boolean || Object.getPrototypeOf(x) === BigInt.prototype;
+
+/** The recorded bug (an id) whose shape `v` contains, or null. */
+export function known(v) {
+  const seen = new Set();
+  const buffers = new Map(); // ArrayBuffer -> number of views/references seen
+  let found = null;
+  let zeros = 0; // 1: a +0 was met, 2: a -0 followed it
+  function hit(id) {
+    if (found === null) found = id;
+  }
+  function zero(x) {
+    if (typeof x !== "number" || x !== 0) return;
+    if (Object.is(x, -0)) {
+      if (zeros === 1) hit("structured-clone/17");
+    } else zeros = 1;
+  }
+  function buffer(b) {
+    const c = (buffers.get(b) || 0) + 1;
+    buffers.set(b, c);
+    if (c > 1) hit("structured-clone/11");
+  }
+  function go(x) {
+    if (found !== null) return;
+    zero(x);
+    if (x === null || (typeof x !== "object" && typeof x !== "function")) return;
+    if (seen.has(x)) {
+      if (x instanceof ArrayBuffer || x instanceof DataView) hit("structured-clone/10");
+      return;
+    }
+    seen.add(x);
+    if (Array.isArray(x)) {
+      for (let i = 0; i < x.length; i++) {
+        if (!(i in x)) hit("structured-clone/1");
+      }
+      for (const k of Object.keys(x)) {
+        if (!(String(k >>> 0) === k && k >>> 0 < x.length)) hit("structured-clone/2");
+      }
+      for (let i = 0; i < x.length; i++) go(x[i]);
+      return;
+    }
+    if (x instanceof DOMException) return hit("structured-clone/6");
+    if (x instanceof Error) {
+      if (hasOwn(x, "cause")) hit("structured-clone/3");
+      if (x instanceof AggregateError) hit("structured-clone/4");
+      const name = x.name || "Error";
+      if (!STANDARD_ERROR_NAMES.has(name) && typeof globalThis[name] === "function") hit("structured-clone/5");
+      if (hasOwn(x, "cause")) go(x.cause);
+      return;
+    }
+    if (x instanceof Map) {
+      for (const [k, y] of x) {
+        go(k);
+        go(y);
+      }
+      return;
+    }
+    if (x instanceof Set) {
+      for (const y of x) go(y);
+      return;
+    }
+    if (x instanceof DataView) {
+      if (x.byteOffset !== 0 || x.byteLength !== x.buffer.byteLength) hit("structured-clone/9");
+      return buffer(x.buffer);
+    }
+    if (x instanceof ArrayBuffer) return buffer(x);
+    if (ArrayBuffer.isView(x)) {
+      if (x.byteOffset !== 0 || x.byteLength !== x.buffer.byteLength) hit("structured-clone/11");
+      return buffer(x.buffer);
+    }
+    if (x instanceof SharedArrayBuffer) return hit("structured-clone/8");
+    if (x instanceof Date || x instanceof RegExp || isBoxed(x)) return;
+    const tag = tagOf(x);
+    if (EXOTIC.has(tag)) return hit("structured-clone/7");
+    if (MISLEADING_TAGS.test(tag)) hit("structured-clone/12");
+    for (const k of Object.keys(x)) go(x[k]);
+  }
+  go(v);
+  return found;
+}
+
+/** A generic walk over the values JSON text would carry: numbers, boxed Numbers, Float array elements, Error causes, Map keys and values, Set elements, array elements, object values. `visit(x, inBox)` sees a boxed Number's or float element's value with inBox = true. */
+function walk(v, visit) {
+  const seen = new Set();
+  let found = false;
+  function go(x, inBox = false) {
+    if (found) return;
+    if (visit(x, inBox)) {
+      found = true;
+      return;
+    }
+    if (x === null || typeof x !== "object" || seen.has(x)) return;
+    seen.add(x);
+    if (x instanceof Number) return go(x.valueOf(), true);
+    if (x instanceof Float32Array || x instanceof Float64Array) {
+      for (const e of x) go(e, true);
+      return;
+    }
+    if (x instanceof Error) return go(x.cause);
+    if (x instanceof Map) {
+      for (const [k, y] of x) {
+        go(k);
+        go(y);
+      }
+      return;
+    }
+    if (x instanceof Set) {
+      for (const y of x) go(y);
+      return;
+    }
+    if (ArrayBuffer.isView(x) || x instanceof ArrayBuffer || x instanceof Date || x instanceof RegExp) return;
+    for (const k of Object.keys(x)) go(x[k]);
+  }
+  go(v);
+  return found;
+}
+
+/** Whether `v` holds a -0 after a +0 in the serializer's order (its identity map merges them: bug 17). Only the positions the serializer visits as primitives count: not typed-array elements, not boxed Numbers. */
+export function hasZeroAfterPlusZero(v) {
+  const seen = new Set();
+  let zeros = 0;
+  let found = false;
+  function go(x) {
+    if (found) return;
+    if (typeof x === "number" && x === 0) {
+      if (Object.is(x, -0)) {
+        if (zeros === 1) found = true;
+      } else zeros = 1;
+      return;
+    }
+    if (x === null || typeof x !== "object" || seen.has(x)) return;
+    seen.add(x);
+    if (Array.isArray(x)) {
+      for (let i = 0; i < x.length; i++) go(x[i]);
+      return;
+    }
+    if (x instanceof Map) {
+      for (const [k, y] of x) {
+        go(k);
+        go(y);
+      }
+      return;
+    }
+    if (x instanceof Set) {
+      for (const y of x) go(y);
+      return;
+    }
+    if (x instanceof Error) return go(x.cause);
+    if (Object.prototype.toString.call(x) !== "[object Object]") return;
+    for (const k of Object.keys(x)) go(x[k]);
+  }
+  go(v);
+  return found;
+}
+
+/** Whether `v` holds a number JSON text cannot carry and the serializer does not encode (bug 15): NaN or an infinity anywhere, or a -0 inside a boxed Number or a float array (only a bare -0 gets the '-0' record). */
+export function lostInJsonText(v) {
+  return walk(v, (x, inBox) => typeof x === "number" && (!Number.isFinite(x) || (inBox && Object.is(x, -0))));
+}
+
+/** Whether `v` contains a BigInt64Array or BigUint64Array (JSON.stringify refuses their elements). */
+export function hasBigIntArray(v) {
+  return walk(v, (x) => x instanceof BigInt64Array || x instanceof BigUint64Array);
+}
