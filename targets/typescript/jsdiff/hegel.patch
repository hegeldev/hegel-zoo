diff --git a/test/hegel-zoo.mjs b/test/hegel-zoo.mjs
new file mode 100644
index 0000000..ef914e1
--- /dev/null
+++ b/test/hegel-zoo.mjs
@@ -0,0 +1,138 @@
+// Hegel zoo: the small harness shared by the zoo's TypeScript/JavaScript targets.
+//
+// `property(name, body)` registers a node:test test that runs `body(tc)` under Hegel with
+// HEGEL_TEST_CASES cases (default 100) and the database at HEGEL_DATABASE. With ZOO_COLLECT=1
+// a `fail()` records the mismatch instead of failing, the case ends there, and the counts of
+// mismatches and of the shapes seen (`count(key)`) are printed at the end of the test, so a
+// property can be run over many cases to see every shape at once. `pin(name, body)` is a
+// plain test for one pinned bug: it must fail while the bug is present and pass once it is
+// fixed (the zoo's judge reads an unexpected pass as "fixed upstream?").
+
+import { readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { test as nodeTest } from "node:test";
+import * as hegel from "@hegeldev/hegel";
+import * as gs from "@hegeldev/hegel/generators";
+
+// The Hegel version these tests were written against (the zoo pins it in zoo.toml and installs
+// it with `npm install --no-save @hegeldev/hegel@<version>`; upstream would add it to
+// devDependencies). Checked at load time so a stray install cannot silently change the engine.
+export const HEGEL_PIN = { "@hegeldev/hegel": "0.4.5" };
+
+{
+  let dir = dirname(fileURLToPath(import.meta.resolve("@hegeldev/hegel")));
+  while (!/[\\/]hegel$/.test(dir) && dir !== dirname(dir)) dir = dirname(dir);
+  const installed = JSON.parse(readFileSync(join(dir, "package.json"), "utf8")).version;
+  if (installed !== HEGEL_PIN["@hegeldev/hegel"]) {
+    throw new Error(`@hegeldev/hegel ${installed} is installed; these tests pin ${HEGEL_PIN["@hegeldev/hegel"]}`);
+  }
+}
+
+export const collecting = !!process.env.ZOO_COLLECT;
+
+class Collected extends Error {}
+
+let msgs = [];
+let stats = new Map();
+
+/** Report a mismatch: an error normally, a recorded line in collect mode. */
+export function fail(message) {
+  if (collecting) {
+    msgs.push(message);
+    throw new Collected(message);
+  }
+  throw new Error(message);
+}
+
+/** Bump a statistic (the shape of a pinned bug, a generator branch). */
+export function count(key) {
+  stats.set(key, (stats.get(key) || 0) + 1);
+}
+
+function settings() {
+  const s = { testCases: Number(process.env.HEGEL_TEST_CASES) || 100 };
+  if (process.env.HEGEL_DATABASE) {
+    s.database = hegel.Database.fromPath(process.env.HEGEL_DATABASE);
+  }
+  return s;
+}
+
+/** A property: `body(tc)` runs under Hegel; a thrown error (or `fail`) is a failure. */
+export function property(name, body) {
+  nodeTest(name, () => {
+    msgs = [];
+    stats = new Map();
+    hegel.test((tc) => {
+      try {
+        body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** A pin: a plain test for one recorded bug. */
+export function pin(name, body) {
+  nodeTest(name, body);
+}
+
+/** An integer in [lo, hi]. */
+export function n(tc, lo, hi) {
+  return tc.draw(gs.integers({ minValue: lo, maxValue: hi }));
+}
+
+/** One of xs. */
+export function pick(tc, xs) {
+  return xs[n(tc, 0, xs.length - 1)];
+}
+
+/** True pct percent of the time. */
+export function chance(tc, pct) {
+  return n(tc, 0, 99) < pct;
+}
+
+/** A string of `len` characters drawn from `alphabet` (an array of strings). */
+export function word(tc, alphabet, lo, hi) {
+  const len = n(tc, lo, hi);
+  let s = "";
+  for (let i = 0; i < len; i++) {
+    s += pick(tc, alphabet);
+  }
+  return s;
+}
+
+/** Structural equality: arrays by position, objects by key set (prototype ignored), else ===. */
+export function same(a, b) {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) {
+      return false;
+    }
+    return a.every((x, i) => same(x, b[i]));
+  }
+  if (a !== null && b !== null && typeof a === "object" && typeof b === "object") {
+    const ka = Object.keys(a).sort();
+    const kb = Object.keys(b).sort();
+    if (ka.length !== kb.length || ka.some((k, i) => k !== kb[i])) {
+      return false;
+    }
+    return ka.every((k) => same(a[k], b[k]));
+  }
+  return a === b;
+}
+
+/** A compact, unambiguous rendering for messages. */
+export function show(x) {
+  return JSON.stringify(x, (k, v) => (v === undefined ? "<undefined>" : v));
+}
diff --git a/test/hegel.test.mjs b/test/hegel.test.mjs
new file mode 100644
index 0000000..cf022a8
--- /dev/null
+++ b/test/hegel.test.mjs
@@ -0,0 +1,910 @@
+// Hegel zoo: property tests for jsdiff (npm `diff`), against the tsc-built ESM output in
+// ../libesm/ (see targets/typescript/jsdiff/target.toml for the build). The oracles are GNU
+// `patch` and `diff` (diffutils) and `git diff`, all on the machine, plus models written out
+// here: a positional hunk applier, an LCS edit distance, the documented tokenizers.
+//
+//   node --test --test-reporter=tap test/hegel.test.mjs
+//   HEGEL_TEST_CASES=2000 ZOO_COLLECT=1 node --test test/hegel.test.mjs   # every shape at once
+
+import { spawnSync } from "node:child_process";
+import { mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import * as D from "../libesm/index.js";
+import { chance, count, fail, n, pick, property, same, show, word } from "./hegel-zoo.mjs";
+
+// ---------------------------------------------------------------------------------------------
+// Generators
+
+// Lines of text: shapes the unified diff format cares about (leading + - space @@ \, the header
+// markers, blanks, whitespace-only lines, CR inside a line, non-ASCII).
+const LINE_ATOMS = [
+  "a", "b", "c", "x", "foo", "bar baz", "", " ", "  ", "\t", "+", "-", "++", "--", "@@ -1 +1 @@",
+  "@@", "\\", "\\ No newline at end of file", "#", "é", "日本", "a b", "---", "+++", "--- a",
+  "+++ b", "Index: a", "diff --git a/a b/a", "=".repeat(67), "0", "\r", "a\r", "\u2028", "*",
+];
+const LINE_CHARS = ["a", "b", "z", " ", "0", "9", ".", ",", "é", "€", "_", "-", "+", "\t", "\\"];
+
+/** Line contents (no line endings). A small pool most of the time, for repeats. */
+function genLines(tc) {
+  const len = n(tc, 0, 10);
+  const pool = [];
+  const poolSize = n(tc, 1, 4);
+  for (let i = 0; i < poolSize; i++) pool.push(pick(tc, LINE_ATOMS));
+  const lines = [];
+  for (let i = 0; i < len; i++) {
+    if (chance(tc, 60)) lines.push(pick(tc, pool));
+    else if (chance(tc, 50)) lines.push(pick(tc, LINE_ATOMS));
+    else lines.push(word(tc, LINE_CHARS, 0, 6));
+  }
+  return lines;
+}
+
+/** A second version of `lines`: a few edits (insert, delete, replace, move, duplicate), or
+ *  unrelated lines. */
+function genEdited(tc, lines) {
+  if (chance(tc, 15)) return genLines(tc);
+  const out = lines.slice();
+  const edits = n(tc, 0, 4);
+  for (let e = 0; e < edits; e++) {
+    const op = pick(tc, ["insert", "delete", "replace", "move", "dup", "insert-run"]);
+    const pos = n(tc, 0, out.length);
+    if (op === "insert") out.splice(pos, 0, chance(tc, 50) && lines.length ? pick(tc, lines) : pick(tc, LINE_ATOMS));
+    else if (op === "insert-run") {
+      const k = n(tc, 1, 4);
+      const l = pick(tc, LINE_ATOMS);
+      for (let i = 0; i < k; i++) out.splice(pos, 0, l);
+    } else if (op === "delete" && out.length) out.splice(Math.min(pos, out.length - 1), n(tc, 1, 3));
+    else if (op === "replace" && out.length) out[Math.min(pos, out.length - 1)] = pick(tc, LINE_ATOMS);
+    else if (op === "move" && out.length > 1) {
+      const from = n(tc, 0, out.length - 1);
+      const k = n(tc, 1, Math.min(3, out.length - from));
+      const block = out.splice(from, k);
+      out.splice(n(tc, 0, out.length), 0, ...block);
+    } else if (op === "dup" && out.length) {
+      const from = n(tc, 0, out.length - 1);
+      const block = out.slice(from, from + n(tc, 1, 3));
+      out.splice(n(tc, 0, out.length), 0, ...block);
+    }
+  }
+  return out;
+}
+
+/** Join lines with line endings: unix, windows or mixed; with or without a final one. */
+function genText(tc, lines, shapes) {
+  if (lines.length === 0) {
+    shapes.add("empty");
+    return "";
+  }
+  const mode = pick(tc, ["unix", "unix", "unix", "win", "mixed"]);
+  const trailing = chance(tc, 75);
+  shapes.add(mode);
+  if (!trailing) shapes.add("no-eofnl");
+  let s = "";
+  for (let i = 0; i < lines.length; i++) {
+    s += lines[i];
+    if (i < lines.length - 1 || trailing) {
+      s += mode === "unix" ? "\n" : mode === "win" ? "\r\n" : pick(tc, ["\n", "\r\n"]);
+    }
+  }
+  return s;
+}
+
+/** An (old, new) pair of texts. */
+function genPair(tc, shapes) {
+  const oldLines = genLines(tc);
+  const newLines = genEdited(tc, oldLines);
+  const oldText = genText(tc, oldLines, shapes);
+  const newText = chance(tc, 5) ? oldText : genText(tc, newLines, shapes);
+  return { oldText, newText };
+}
+
+const NAME_CHARS = ["a", "b", "c", "1", "_", ".", "-", " ", "é", "日", "\"", "\\", "#", "~", "'", "\t", "\n", "\x01", "/"];
+
+/** A file name for structuredPatch/formatPatch/parsePatch (anything goes, the format quotes). */
+function genName(tc) {
+  const s = word(tc, NAME_CHARS, 1, 6);
+  return s.trim() === "" ? "f" : s;
+}
+
+const MARK = "\u00b6~"; // never produced by the generators above
+
+// ---------------------------------------------------------------------------------------------
+// Models
+
+/** Lines with their line endings, as the unified diff format sees them ("" → none). */
+function tokensOf(text) {
+  return text === "" ? [] : text.split(/(?<=\n)/);
+}
+
+/** A hunk's old and new lines (with their endings; a "\ No newline" marker removes one). */
+function hunkSides(hunk, where) {
+  const olds = [];
+  const news = [];
+  const L = hunk.lines;
+  for (let i = 0; i < L.length; i++) {
+    const l = L[i];
+    if (l.startsWith("\\")) {
+      if (i === 0 || L[i - 1].startsWith("\\")) fail(`${where}: stray marker line ${show(l)} in ${show(L)}`);
+      continue;
+    }
+    const op = l[0];
+    const content = l.slice(1) + (L[i + 1]?.startsWith("\\") ? "" : "\n");
+    if (op === " " || op === "-") olds.push(content);
+    if (op === " " || op === "+") news.push(content);
+    if (op !== " " && op !== "-" && op !== "+") fail(`${where}: hunk line ${show(l)} has no operation`);
+  }
+  if (olds.length !== hunk.oldLines || news.length !== hunk.newLines) {
+    fail(`${where}: hunk header says -${hunk.oldStart},${hunk.oldLines} +${hunk.newStart},${hunk.newLines}, lines give ${olds.length} old and ${news.length} new: ${show(L)}`);
+  }
+  return { olds, news };
+}
+
+/** Apply a structured patch exactly where its hunk headers say, checking every number. */
+function positionalApply(text, patch, where) {
+  const src = tokensOf(text);
+  const out = [];
+  let pos = 0;
+  for (const h of patch.hunks) {
+    const { olds, news } = hunkSides(h, where);
+    const start = h.oldStart - 1;
+    if (start < pos) fail(`${where}: hunk -${h.oldStart},${h.oldLines} starts inside the previous hunk (line ${pos + 1})`);
+    if (start > src.length) fail(`${where}: hunk -${h.oldStart},${h.oldLines} starts after the end of a ${src.length}-line text`);
+    while (pos < start) out.push(src[pos++]);
+    if (out.length + 1 !== h.newStart) fail(`${where}: hunk +${h.newStart},${h.newLines} would start at new line ${out.length + 1}`);
+    for (const o of olds) {
+      if (src[pos] !== o) fail(`${where}: old line ${pos + 1} is ${show(src[pos])}, hunk -${h.oldStart},${h.oldLines} says ${show(o)}`);
+      pos++;
+    }
+    out.push(...news);
+  }
+  while (pos < src.length) out.push(src[pos++]);
+  return out.join("");
+}
+
+/** How many times `seq` occurs as a consecutive run in `arr`. */
+function occurrences(arr, seq) {
+  let c = 0;
+  outer: for (let i = 0; i + seq.length <= arr.length; i++) {
+    for (let j = 0; j < seq.length; j++) if (arr[i + j] !== seq[j]) continue outer;
+    c++;
+  }
+  return c;
+}
+
+/** Edit distance (insertions + deletions) between two token arrays under `eq`. */
+function editDistance(a, b, eq) {
+  const m = a.length;
+  const k = b.length;
+  let prev = new Array(k + 1).fill(0);
+  for (let i = 1; i <= m; i++) {
+    const cur = new Array(k + 1).fill(0);
+    for (let j = 1; j <= k; j++) {
+      cur[j] = eq(a[i - 1], b[j - 1]) ? prev[j - 1] + 1 : Math.max(prev[j], cur[j - 1]);
+    }
+    prev = cur;
+  }
+  return m + k - 2 * prev[k];
+}
+
+/** The documented diffLines tokenizer. */
+function modelLineTokens(text, opts) {
+  if (opts.stripTrailingCr) text = text.replace(/\r\n/g, "\n");
+  const parts = text.split(/(\n|\r\n)/);
+  if (parts[parts.length - 1] === "") parts.pop();
+  const tokens = [];
+  for (let i = 0; i < parts.length; i++) {
+    if (i % 2 === 1 && !opts.newlineIsToken) tokens[tokens.length - 1] += parts[i];
+    else tokens.push(parts[i]);
+  }
+  return tokens.filter((t) => t !== "");
+}
+
+/** The documented diffLines line equality. */
+function modelLineEquals(opts) {
+  return (l, r) => {
+    if (opts.ignoreWhitespace) {
+      if (!opts.newlineIsToken || !l.includes("\n")) l = l.trim();
+      if (!opts.newlineIsToken || !r.includes("\n")) r = r.trim();
+    } else if (opts.ignoreNewlineAtEof && !opts.newlineIsToken) {
+      // a line missing its ending (the last line of a text) equals the same line with one
+      const lEnds = /\r?\n$/.test(l);
+      const rEnds = /\r?\n$/.test(r);
+      if (lEnds !== rEnds) {
+        l = l.replace(/\r?\n$/, "");
+        r = r.replace(/\r?\n$/, "");
+      }
+    }
+    return l === r;
+  };
+}
+
+function stripPatch(p) {
+  return {
+    oldFileName: p.oldFileName,
+    newFileName: p.newFileName,
+    oldHeader: p.oldHeader || "",
+    newHeader: p.newHeader || "",
+    hunks: p.hunks,
+  };
+}
+
+// ---------------------------------------------------------------------------------------------
+// Oracles: GNU diff / patch and git, in a scratch directory
+
+const scratch = mkdtempSync(join(tmpdir(), "hegel-jsdiff-"));
+process.on("exit", () => rmSync(scratch, { recursive: true, force: true }));
+let serial = 0;
+
+function gnuDiff(oldText, newText, oldLabel, newLabel) {
+  const a = join(scratch, `o${++serial}`);
+  const b = join(scratch, `n${serial}`);
+  writeFileSync(a, oldText);
+  writeFileSync(b, newText);
+  const r = spawnSync("diff", ["-u", "--label", oldLabel, "--label", newLabel, a, b], { encoding: "utf8" });
+  if (r.status !== 0 && r.status !== 1) fail(`GNU diff failed: ${r.stderr}`);
+  return r.stdout;
+}
+
+/** GNU patch applied to `text`: the result, or false when it refuses. */
+function gnuPatch(text, patchText) {
+  const f = join(scratch, `f${++serial}`);
+  const p = join(scratch, `p${serial}`);
+  const o = join(scratch, `r${serial}`);
+  writeFileSync(f, text);
+  writeFileSync(p, patchText);
+  const r = spawnSync("patch", ["-s", "-f", "-u", "--binary", "-o", o, f, p], { encoding: "utf8" });
+  if (r.status !== 0) return { ok: false, err: (r.stdout + r.stderr).trim() };
+  return { ok: true, text: readFileSync(o, "utf8") };
+}
+
+function gitDiff(oldName, oldText, newName, newText) {
+  const dir = mkdtempSync(join(scratch, "g"));
+  const args = ["-c", "core.quotePath=true", "-c", "diff.noprefix=false", "-c", "diff.mnemonicPrefix=false", "diff", "--no-index", "--no-color", "--no-ext-diff", "--"];
+  if (oldText === null) args.push("/dev/null");
+  else {
+    writeFileSync(join(dir, oldName), oldText);
+    args.push(oldName);
+  }
+  if (newText === null) args.push("/dev/null");
+  else {
+    writeFileSync(join(dir, newName), newText);
+    args.push(newName);
+  }
+  const r = spawnSync("git", args, { cwd: dir, encoding: "utf8" });
+  rmSync(dir, { recursive: true, force: true });
+  if (r.status !== 0 && r.status !== 1) fail(`git diff failed (${r.status}): ${r.stderr}`);
+  return r.stdout;
+}
+
+// ---------------------------------------------------------------------------------------------
+// 1. Patches created by jsdiff apply (positionally, by applyPatch, by GNU patch), parse back to
+//    the same structure, format back to the same text, and reverse.
+
+property("TestHegelPatchesApplyParseFormatAndReverse", (tc) => {
+  const shapes = new Set();
+  const { oldText, newText } = genPair(tc, shapes);
+  const context = pick(tc, [undefined, 0, 1, 2, 3, 4, Infinity]);
+  const oldName = genName(tc);
+  const newName = chance(tc, 60) ? oldName : genName(tc);
+  const oldHeader = chance(tc, 50) ? undefined : word(tc, ["h", "1", " ", "é", "-", "\t"], 1, 5).trim() || "h";
+  const newHeader = chance(tc, 50) ? undefined : word(tc, ["h", "2", " ", "é", "-", "\t"], 1, 5).trim() || "h";
+  const outerSpace = (x) => x !== undefined && x !== x.trim();
+  const knownLossy = () => {
+    // jsdiff/1: formatPatch does not quote a file name with leading or trailing whitespace and
+    // parsePatch trims, so such names do not round-trip; jsdiff/3: parsePatch keeps only what
+    // is before the second tab of a ---/+++ line, so a header containing a tab is cut short
+    if (outerSpace(oldName) || outerSpace(newName)) return "bug/jsdiff-1";
+    if ((oldHeader ?? "").includes("\t") || (newHeader ?? "").includes("\t")) return "bug/jsdiff-3";
+    return null;
+  };
+  const opts = context === undefined ? {} : { context };
+  for (const s of shapes) count(`text/${s}`);
+  count(`context/${context}`);
+
+  // ignoreWhitespace / stripTrailingCr: the patch must still describe old → new, so it must
+  // apply to the old text, and the result must be the new text up to the ignored differences
+  if (chance(tc, 25)) {
+    const lax = pick(tc, ["ignoreWhitespace", "stripTrailingCr"]);
+    count(`lax/${lax}`);
+    const laxOpts = { ...opts, [lax]: true };
+    const norm = lax === "ignoreWhitespace" ? (t) => tokensOf(t).map((l) => l.trim()).join("\n") : (t) => t.replace(/\r+\n/g, "\n").replace(/\r+$/, "");
+    const laxText = D.createTwoFilesPatch(oldName, newName, oldText, newText, undefined, undefined, laxOpts);
+    const laxSp = D.parsePatch(laxText)[0];
+    const touched = laxSp.hunks.some((h) => h.lines.some((l) => l[0] === "+" || l[0] === "-"));
+    if (!touched && norm(oldText) !== norm(newText)) fail(`createTwoFilesPatch(${show(oldText)} → ${show(newText)}, ${lax}) has no changes although the texts differ beyond ${lax}:\n${laxText}`);
+    const got = D.applyPatch(oldText, laxText, { autoConvertLineEndings: false });
+    if (got === false || norm(got) !== norm(newText)) {
+      // jsdiff/5: context lines are taken from the new text and deleted lines from the old, so
+      // when they differ in whitespace / trailing CR the patch fits neither text — it is
+      // refused, or a hunk that happens to fit elsewhere is applied there
+      // (trim() also removes a line's final newline, so a last line without one is "ignorable")
+      const ignorable = norm(oldText) !== oldText || norm(newText) !== newText || (lax === "ignoreWhitespace" && (!oldText.endsWith("\n") || !newText.endsWith("\n")));
+      if (ignorable) count("bug/jsdiff-5");
+      else fail(`createTwoFilesPatch(${show(oldText)} → ${show(newText)}, ${lax}) applied to the old text gives ${show(got)}, not the new text up to ${lax}:\n${laxText}`);
+    }
+  }
+
+  const sp = D.structuredPatch(oldName, newName, oldText, newText, oldHeader, newHeader, opts);
+  const where = `structuredPatch(${show(oldText)} → ${show(newText)}, context ${context})`;
+  // the hunks describe exactly the change, where they say they are
+  const positional = positionalApply(oldText, sp, where);
+  if (positional !== newText) fail(`${where}: applying the hunks where their headers say gives ${show(positional)}`);
+  if (oldText === newText && sp.hunks.length) fail(`${where}: ${sp.hunks.length} hunks for identical texts`);
+  // context lines are at most `context` on each side of a hunk
+  if (context !== undefined && context !== Infinity) {
+    for (const h of sp.hunks) {
+      const ops = h.lines.filter((l) => !l.startsWith("\\")).map((l) => l[0]);
+      let lead = 0;
+      while (lead < ops.length && ops[lead] === " ") lead++;
+      let trail = 0;
+      while (trail < ops.length - lead && ops[ops.length - 1 - trail] === " ") trail++;
+      if (lead > context || trail > context) fail(`${where}: hunk has ${lead} leading and ${trail} trailing context lines: ${show(h.lines)}`);
+    }
+  }
+
+  // applyPatch on the structure and on the text (line-ending conversion off: property 4 has it)
+  const noConvert = { autoConvertLineEndings: false };
+  const applied = D.applyPatch(oldText, sp, noConvert);
+  if (applied !== newText) fail(`${where}: applyPatch(old, structuredPatch) = ${show(applied)}, expected ${show(newText)}`);
+  const text = D.formatPatch(sp);
