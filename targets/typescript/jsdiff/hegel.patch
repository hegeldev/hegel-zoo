+const escapeHTML = (s) => s.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;").replaceAll("\"", "&quot;");
+const noWs = (s) => s.replace(/\s+/g, "");
+
+property("TestHegelDiffsRebuildInputsAndAreMinimal", (tc) => {
+  const kind = pick(tc, ["chars", "chars", "words", "wordsWithSpace", "lines", "sentences", "css", "arrays", "json"]);
+  count(`kind/${kind}`);
+  const ignoreCase = (kind === "chars" || kind === "words") && chance(tc, 30);
+  if (ignoreCase) count("opt/ignoreCase");
+
+  if (kind === "json") {
+    const a = genJson(tc) ?? null; // a bare undefined is outside diffJson's `string | object`
+    const b = chance(tc, 30) ? a : genJson(tc) ?? null;
+    const opts = chance(tc, 50) ? { undefinedReplacement: pick(tc, [null, "undef", 0]) } : {};
+    const changes = D.diffJson(a, b, opts);
+    const canon = (v) => (typeof v === "string" ? v : JSON.stringify(D.canonicalize(v, null, null, (k, x) => (x === undefined ? opts.undefinedReplacement : x)), null, "  "));
+    const rebuiltNew = changes.filter((c) => !c.removed).map((c) => c.value).join("");
+    const rebuiltOld = changes.filter((c) => !c.added).map((c) => c.value).join("");
+    const relax = (s) => s.replace(/,(\r?\n)/g, "$1");
+    const cb = canon(b);
+    const ca = canon(a);
+    if (cb === undefined || ca === undefined) return; // a bare undefined serialises to nothing
+    if (relax(rebuiltNew) !== relax(cb) || relax(rebuiltOld) !== relax(ca)) fail(`diffJson(${show(a)}, ${show(b)}, ${show(opts)}) rebuilds ${show(rebuiltOld)} / ${show(rebuiltNew)}, canonical forms ${show(ca)} / ${show(cb)}`);
+    // key order does not matter; the string form agrees with the object form
+    if (a && typeof a === "object") {
+      const shuffled = shuffleKeys(tc, a);
+      const noop = D.diffJson(a, shuffled, opts);
+      if (noop.some((c) => c.added || c.removed)) fail(`diffJson(${show(a)}, same object with keys reordered) reports changes: ${show(noop)}`);
+    }
+    if (typeof a === "string" || typeof b === "string") return;
+    const viaStrings = D.diffJson(ca, cb);
+    const shape = (cs) => cs.map((c) => (c.added ? "+" : c.removed ? "-" : "=") + c.value);
+    if (!same(shape(viaStrings), shape(changes))) fail(`diffJson on the objects ${show(a)}, ${show(b)} gives ${show(shape(changes))}, on their canonical JSON strings ${show(shape(viaStrings))}`);
+    return;
+  }
+
+  let oldV;
+  let newV;
+  let fn;
+  let opts = {};
+  if (kind === "arrays") {
+    const atoms = ["", "a", "b", 0, 1, -0, null, undefined, "0", true];
+    const arr = () => {
+      const out = [];
+      const k = n(tc, 0, 10);
+      for (let i = 0; i < k; i++) out.push(pick(tc, atoms));
+      return out;
+    };
+    oldV = arr();
+    newV = chance(tc, 30) ? oldV.slice() : arr();
+    fn = D.diffArrays;
+  } else {
+    oldV = genShort(tc);
+    newV = chance(tc, 30) ? oldV : genShort(tc);
+    if (ignoreCase) opts = { ignoreCase: true };
+    fn = { chars: D.diffChars, words: D.diffWords, wordsWithSpace: D.diffWordsWithSpace, lines: D.diffLines, sentences: D.diffSentences, css: D.diffCss }[kind];
+  }
+  const where = `${kind === "arrays" ? "diffArrays" : fn.name}(${show(oldV)}, ${show(newV)}${ignoreCase ? ", {ignoreCase}" : ""})`;
+  const changes = fn(oldV, newV, opts);
+  if (!Array.isArray(changes)) fail(`${where} returned ${show(changes)}`);
+  for (const c of changes) {
+    if (c.added && c.removed) fail(`${where}: a change both added and removed: ${show(c)}`);
+    if (!(c.count >= 1)) fail(`${where}: change with count ${show(c.count)}: ${show(c)}`);
+  }
+
+  // rebuild both sides
+  const olds = changes.filter((c) => !c.added).map((c) => c.value);
+  const news = changes.filter((c) => !c.removed).map((c) => c.value);
+  if (kind === "arrays") {
+    const flat = (xs) => xs.flat();
+    if (!same(flat(olds), oldV) || !same(flat(news), newV)) fail(`${where} rebuilds ${show(flat(olds))} / ${show(flat(news))}`);
+  } else if (kind === "words") {
+    // whitespace is redistributed between change objects; the non-whitespace characters and
+    // their order are kept (values of common tokens come from the new text: compare lowercase
+    // when ignoring case)
+    const norm = (s) => (ignoreCase ? noWs(s).toLowerCase() : noWs(s));
+    if (norm(olds.join("")) !== norm(oldV) || norm(news.join("")) !== norm(newV)) fail(`${where} rebuilds ${show(olds.join(""))} / ${show(news.join(""))} (whitespace aside)`);
+    if (news.join("") !== newV && !ignoreCase) {
+      // the new text is rebuilt exactly when whitespace is unchanged around every change: check
+      // the weaker documented promise only
+      count("words/new-not-exact");
+    }
+  } else {
+    const rebuiltNew = news.join("");
+    const rebuiltOld = olds.join("");
+    if (rebuiltNew !== newV) fail(`${where} rebuilds the new text as ${show(rebuiltNew)}`);
+    if (!ignoreCase && rebuiltOld !== oldV) fail(`${where} rebuilds the old text as ${show(rebuiltOld)}`);
+    if (ignoreCase && rebuiltOld.toLowerCase() !== oldV.toLowerCase()) fail(`${where} rebuilds the old text as ${show(rebuiltOld)} (case aside)`);
+  }
+
+  // token counts and minimality where the tokens are known exactly
+  let tokOld = null;
+  let tokNew = null;
+  let eq = (x, y) => x === y;
+  if (kind === "chars") {
+    tokOld = Array.from(oldV);
+    tokNew = Array.from(newV);
+    if (ignoreCase) eq = (x, y) => x === y || x.toLowerCase() === y.toLowerCase();
+  } else if (kind === "arrays") {
+    tokOld = oldV;
+    tokNew = newV;
+  } else if (kind === "lines") {
+    tokOld = modelLineTokens(oldV, {});
+    tokNew = modelLineTokens(newV, {});
+  } else if (kind === "css") {
+    tokOld = oldV.split(/([{}:;,]|\s+)/).filter((t) => t !== "");
+    tokNew = newV.split(/([{}:;,]|\s+)/).filter((t) => t !== "");
+  }
+  if (tokOld) {
+    const cOld = changes.filter((c) => !c.added).reduce((s, c) => s + c.count, 0);
+    const cNew = changes.filter((c) => !c.removed).reduce((s, c) => s + c.count, 0);
+    if (cOld !== tokOld.length || cNew !== tokNew.length) fail(`${where}: counts sum to ${cOld} old / ${cNew} new tokens, the texts have ${tokOld.length} / ${tokNew.length}`);
+    const d = changes.filter((c) => c.added || c.removed).reduce((s, c) => s + c.count, 0);
+    const best = editDistance(tokOld, tokNew, eq);
+    if (d !== best) fail(`${where}: ${d} tokens added or removed, a minimal diff has ${best}: ${show(changes)}`);
+    // maxEditLength: exactly the edit distance is enough, one less is not
+    const atLimit = fn(oldV, newV, { ...opts, maxEditLength: best });
+    if (!Array.isArray(atLimit)) fail(`${where} with maxEditLength ${best} (the edit distance) returned ${show(atLimit)}`);
+    if (best > 0) {
+      const below = fn(oldV, newV, { ...opts, maxEditLength: best - 1 });
+      if (below !== undefined) fail(`${where} with maxEditLength ${best - 1} (below the edit distance ${best}) returned ${show(below)}`);
+    }
+    // for common tokens the value comes from the new text
+    if (kind !== "arrays") {
+      let ni = 0;
+      for (const c of changes) {
+        if (!c.added && !c.removed) {
+          const expect = tokNew.slice(ni, ni + c.count).join("");
+          if (c.value !== expect) fail(`${where}: common change ${show(c.value)} is not the new text's tokens ${show(expect)}`);
+        }
+        if (!c.removed) ni += c.count;
+      }
+    }
+  }
+
+  // oneChangePerToken: one token per change, same diff once merged
+  if (kind !== "words") {
+    const single = fn(oldV, newV, { ...opts, oneChangePerToken: true });
+    if (single.some((c) => c.count !== 1)) fail(`${where} with oneChangePerToken has a change with count ≠ 1: ${show(single)}`);
+    const merged = [];
+    for (const c of single) {
+      const last = merged[merged.length - 1];
+      if (last && last.added === c.added && last.removed === c.removed) {
+        last.count += 1;
+        last.value = kind === "arrays" ? last.value.concat(c.value) : last.value + c.value;
+      } else merged.push({ value: c.value, added: c.added, removed: c.removed, count: 1 });
+    }
+    const plain = changes.map((c) => ({ value: c.value, added: c.added, removed: c.removed, count: c.count }));
+    if (!same(merged, plain)) fail(`${where} with oneChangePerToken, merged, is ${show(merged)}; without it ${show(plain)}`);
+  }
+
+  // converters
+  if (kind !== "arrays") {
+    const xml = D.convertChangesToXML(changes);
+    const wantXml = changes.map((c) => (c.added ? `<ins>${escapeHTML(c.value)}</ins>` : c.removed ? `<del>${escapeHTML(c.value)}</del>` : escapeHTML(c.value))).join("");
+    if (xml !== wantXml) fail(`${where}: convertChangesToXML gives ${show(xml)}, expected ${show(wantXml)}`);
+  }
+  const dmp = D.convertChangesToDMP(changes);
+  const wantDmp = changes.map((c) => [c.added ? 1 : c.removed ? -1 : 0, c.value]);
+  if (!same(dmp, wantDmp)) fail(`${where}: convertChangesToDMP gives ${show(dmp)}, expected ${show(wantDmp)}`);
+});
+
+// ---------------------------------------------------------------------------------------------
+// Pins: one plain test per recorded bug (see bugs.toml). Each fails while the bug is present.
+
+import { pin } from "./hegel-zoo.mjs";
+import assert from "node:assert/strict";
+
+pin("PinJsdiff1FileNamesWithOuterSpacesDoNotRoundTrip", () => {
+  // formatPatch leaves "a " and " b" unquoted; parsePatch trims the ---/+++ lines
+  const text = D.createTwoFilesPatch("a ", " b", "x\n", "y\n");
+  const [p] = D.parsePatch(text);
+  assert.deepEqual([p.oldFileName, p.newFileName], ["a ", " b"]);
+});
+
+pin("PinJsdiff2IgnoreNewlineAtEofIgnoresOnlyLf", () => {
+  // the last line of a CRLF text without its line ending should equal the same line with one
+  const changes = D.diffLines("a\r\nb", "a\r\nb\r\n", { ignoreNewlineAtEof: true });
+  assert.deepEqual(changes.filter((c) => c.added || c.removed), []);
+});
+
+pin("PinJsdiff3HeaderWithTabIsTruncatedByParsePatch", () => {
+  // "--- f\th1\th2": split('\t', 2) keeps "h1" and drops "\th2"
+  const text = D.createPatch("f", "x\n", "y\n", "h1\th2", "n1\tn2");
+  const [p] = D.parsePatch(text);
+  assert.deepEqual([p.oldHeader, p.newHeader], ["h1\th2", "n1\tn2"]);
+});
+
+pin("PinJsdiff5IgnoreWhitespacePatchAppliesToNeitherText", () => {
+  // context lines come from the new text, deletions from the old: "a " / "c" in old, "a" /
+  // "c " in new → the hunk " a\n-b\n+d\n c " fits neither
+  const patch = D.createPatch("f", "a \nb\nc\n", "a\nd\nc \n", undefined, undefined, { ignoreWhitespace: true });
+  const applied = D.applyPatch("a \nb\nc\n", patch);
+  assert.notEqual(applied, false, `the patch does not apply to the text it was made from:\n${patch}`);
+  assert.equal(applied.replace(/ +$/gm, ""), "a\nd\nc\n");
+});
+
+pin("PinJsdiff4ApplyPatchThrowsOnAnEmptyPatch", () => {
+  // parsePatch("") is []; applyPatch then reads .hunks of undefined instead of returning the
+  // source unchanged (as it does for a header-only patch) or false
+  assert.equal(D.applyPatch("a\nb\n", ""), "a\nb\n");
+  assert.equal(D.applyPatch("a\nb\n", []), "a\nb\n");
+});
