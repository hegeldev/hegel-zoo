diff --git a/hegel/gen.mjs b/hegel/gen.mjs
new file mode 100644
index 0000000..d98afcb
--- /dev/null
+++ b/hegel/gen.mjs
@@ -0,0 +1,310 @@
+// Hegel zoo: generators for tough-cookie. Two shape spaces: CLEAN leaves out every shape a
+// recorded bug (bugs.toml) is about, FULL has them all; `known(ops, model)` names the recorded
+// bug whose shape a jar scenario contains, so the property over FULL can count a mismatch there
+// instead of failing on it.
+
+import { chance, n, pick, word } from "./hegel-zoo.mjs";
+import { asciiLower, canonicalHost, isIP, isPublicSuffix } from "./model.mjs";
+
+export const FULL = {
+  idn: true, // Domain attributes with non-ASCII labels, and IPv6 in brackets (bug 2)
+  percent: true, // percent-escapes in URL paths and Path attributes (bug 3)
+  ipDomain: true, // Domain attribute naming the IPv4 host (bug 4)
+  psHost: true, // hosts that are public suffixes themselves, with Domain naming them (bug 5)
+  dot: true, // hosts with a trailing dot (bug 6)
+  prefixCase: true, // __secure-/__HOST- prefixes in other cases (bug 16)
+  unicodeSpace: true, // non-ASCII whitespace at the ends of names and values (bug 14)
+  nonLatin1: true, // characters above U+00FF glued to date tokens (bug 15)
+  urlChars: true, // "@", "/", ":", "%", "#", "?", "\0" in a domain name (bug 7)
+  specialSuffix: true, // Domain=localhost (or invalid) itself, the special-use names tough-cookie treats as registrable (bug 17)
+};
+export const CLEAN = Object.fromEntries(Object.keys(FULL).map((k) => [k, false]));
+
+// ---------------------------------------------------------------------------------------------
+// Hosts, URLs and Set-Cookie headers for jar scenarios
+
+const SITES = ["example.com", "example.org", "foo.co.uk", "bar.github.io", "localhost"];
+const SUBS = ["www", "api", "a.b"];
+const PATHS = ["/", "/a", "/a/", "/a/b", "/a/b/", "/ab", "/abc/d", "/b/a", "/a/b/c/d"];
+const PERCENT_PATHS = ["/%41", "/%41/b", "/caf%C3%A9", "/caf%C3%A9/x", "/a%2Fb", "/a/%2e%2e/b"];
+
+/** The hosts of one scenario: two or three names around one or two sites, so domain cookies interact. */
+export function hosts(tc, flags) {
+  const out = new Set();
+  const sites = [pick(tc, SITES)];
+  if (chance(tc, 40)) sites.push(pick(tc, SITES));
+  if (flags.idn && chance(tc, 50)) sites.push(pick(tc, ["éxample.com", "bücher.example", "中文.org"]));
+  for (const site of sites) {
+    out.add(site);
+    if (chance(tc, 70)) out.add(`${pick(tc, SUBS)}.${site}`);
+  }
+  if (flags.psHost && chance(tc, 50)) out.add(pick(tc, ["github.io", "co.uk", "com"]));
+  if (flags.ipDomain && chance(tc, 50)) out.add(pick(tc, ["1.2.3.4", "127.0.0.1", "[::1]"]));
+  if (flags.dot && chance(tc, 25)) {
+    const h = pick(tc, [...out]);
+    if (!isIP(h.replace(/^\[|\]$/g, ""))) out.add(`${h}.`);
+  }
+  return [...out];
+}
+
+export function path(tc, flags) {
+  return flags.percent && chance(tc, 10) ? pick(tc, PERCENT_PATHS) : pick(tc, PATHS);
+}
+
+export function url(tc, flags, hs, ps) {
+  const p = ps && chance(tc, 70) ? pick(tc, ps) : path(tc, flags);
+  return `${chance(tc, 30) ? "https" : "http"}://${pick(tc, hs)}${p}`;
+}
+
+/** A Domain attribute value for a cookie set from `host`: the host, a suffix, with a leading dot or upper case, a child, an unrelated name. */
+function domainAttr(tc, flags, host) {
+  const bare = host.replace(/^\[|\]$/g, "");
+  const labels = bare.split(".");
+  const options = [bare];
+  for (let i = 1; i < labels.length; i++) options.push(labels.slice(i).join("."));
+  if (isIP(bare) && !flags.ipDomain && !bare.includes(":")) options.length = 0;
+  if (bare.includes(":")) {
+    options.length = 0;
+    if (flags.idn) options.push(host); // "[::1]"
+    options.push(bare);
+  }
+  if (!flags.idn) {
+    for (let i = options.length - 1; i >= 0; i--) if (/[^\x00-\x7f]/.test(options[i])) options.splice(i, 1);
+  } else if (/[^\x00-\x7f]/.test(bare) && chance(tc, 50)) {
+    options.push(canonicalHost(bare));
+  }
+  if (!flags.psHost) {
+    for (let i = options.length - 1; i >= 0; i--) if (isPublicSuffix(options[i]) && options[i] === bare) options.splice(i, 1);
+  }
+  if (!flags.specialSuffix) {
+    for (let i = options.length - 1; i >= 0; i--) if (options[i] === "localhost" || options[i] === "invalid") options.splice(i, 1);
+  }
+  options.push("other.net", `x.${bare}`);
+  let d = pick(tc, options);
+  if (chance(tc, 25)) d = `.${d}`;
+  if (chance(tc, 20)) d = d.toUpperCase();
+  return d;
+}
+
+const KEYS = ["a", "b", "c", "d", "__Secure-a", "__Host-a"];
+const VALUE_CHARS = [..."abcxyz019-_!#$&'()*+/:<>?@[]^`{|}~\""];
+
+/** A Set-Cookie header for a cookie set from `host` at time `now`. */
+export function header(tc, flags, host, now) {
+  let key = pick(tc, KEYS);
+  if (flags.prefixCase && chance(tc, 10)) key = pick(tc, ["__secure-a", "__SECURE-b", "__host-a", "__HOST-b"]);
+  const value = chance(tc, 10) ? "" : word(tc, VALUE_CHARS, 1, 6);
+  const attrs = [];
+  if (chance(tc, 50)) attrs.push(`Domain=${domainAttr(tc, flags, host)}`);
+  if (chance(tc, 50)) attrs.push(`Path=${chance(tc, 85) ? path(tc, flags) : pick(tc, ["", "rel", "a/b"])}`);
+  if (chance(tc, 45)) attrs.push(`Max-Age=${pick(tc, [-1, 0, 1, 2, 3, 5, 8, 10, 30, 3600])}`);
+  if (chance(tc, 25)) attrs.push(`Expires=${new Date(now + pick(tc, [-10, 0, 1, 5, 20, 60, 100000]) * 1000).toUTCString()}`);
+  if (chance(tc, 30)) attrs.push("Secure");
+  if (chance(tc, 20)) attrs.push("HttpOnly");
+  if (chance(tc, 20)) attrs.push(`SameSite=${pick(tc, ["Strict", "Lax", "None"])}`);
+  if (chance(tc, 10)) attrs.push("Priority=High");
+  // attribute order is free, and so is their case
+  for (let i = attrs.length - 1; i > 0; i--) {
+    const j = n(tc, 0, i);
+    [attrs[i], attrs[j]] = [attrs[j], attrs[i]];
+  }
+  const cased = attrs.map((a) => (chance(tc, 20) ? a.toUpperCase() : chance(tc, 20) ? a.toLowerCase() : a));
+  return [`${key}=${value}`, ...cased].join("; ");
+}
+
+const EPOCH = 1_700_000_000_000;
+
+/** A scenario: a list of {at, kind: "set"|"get", url, header?} in time order, ending with a get for every host. */
+export function ops(tc, flags) {
+  const hs = hosts(tc, flags);
+  const ps = [pick(tc, PATHS), pick(tc, PATHS)]; // a scenario's requests mostly share a couple of paths, so cookies are asked for again
+  const out = [];
+  let at = EPOCH;
+  const count = n(tc, 1, 10);
+  for (let i = 0; i < count; i++) {
+    at += n(tc, 0, 15) * 1000 + n(tc, 0, 999);
+    const u = url(tc, flags, hs, ps);
+    if (chance(tc, 55)) out.push({ at, kind: "set", url: u, header: header(tc, flags, new URL(u).hostname, at) });
+    else out.push({ at, kind: "get", url: u });
+  }
+  at += n(tc, 0, 15) * 1000;
+  for (const h of hs) out.push({ at, kind: "get", url: `${chance(tc, 50) ? "https" : "http"}://${h}${chance(tc, 70) ? pick(tc, ps) : path(tc, flags)}` });
+  return out;
+}
+
+/** The recorded bugs whose shapes the scenario contains (after the model has run over it): a list of ids, empty when there is none. */
+export function known(ops, model) {
+  const ids = new Set();
+  if (model.slid) ids.add("tough-cookie/1");
+  for (const op of ops) {
+    const u = new URL(op.url);
+    if (u.hostname.endsWith(".")) ids.add("tough-cookie/6");
+    if (u.pathname.includes("%")) ids.add("tough-cookie/3");
+    if (op.kind !== "set") continue;
+    const m = /(?:^|;)\s*domain\s*=\s*([^;]*)/i.exec(op.header);
+    const d = m ? asciiLower(m[1].trim().replace(/^\./, "")) : "";
+    if (d !== "") {
+      if (/[^\x00-\x7f]/.test(d) || d.includes("[")) ids.add("tough-cookie/2");
+      if (isIP(d) && !d.includes(":")) ids.add("tough-cookie/4");
+      if (isPublicSuffix(d) && d === u.hostname) ids.add("tough-cookie/5");
+      if (d === "localhost" || d === "invalid") ids.add("tough-cookie/17");
+    }
+    if (/^__(?:secure|host)-/i.test(op.header) && !/^__(?:Secure|Host)-/.test(op.header)) ids.add("tough-cookie/16");
+    if (/(?:^|;)\s*path\s*=\s*[^;]*%/i.test(op.header)) ids.add("tough-cookie/3");
+  }
+  return [...ids].sort();
+}
+
+// ---------------------------------------------------------------------------------------------
+// Set-Cookie strings for the parser property
+
+const UNICODE_SPACE = ["\u00a0", "\u2003", "\u3000", "\ufeff", "\u2028", "\u202f"];
+const TOKEN_CHARS = [..."abcXYZ019-_!#$%&'*+.^`|~"];
+const WSP = ["", "", " ", "  ", "\t", " \t"];
+
+function padded(tc, s) {
+  return pick(tc, WSP) + s + pick(tc, WSP);
+}
+
+function attrName(tc, name) {
+  return pick(tc, [name, name.toLowerCase(), name.toUpperCase(), name[0] + name.slice(1).toUpperCase()]);
+}
+
+/** A Set-Cookie string with the syntax varied: whitespace, case, order, repeated and unknown attributes, odd values. */
+export function setCookieString(tc, flags) {
+  const parts = [];
+  const key = chance(tc, 5) ? "" : word(tc, TOKEN_CHARS, 1, 5);
+  const value = pick(tc, ["", word(tc, VALUE_CHARS, 0, 8), `"${word(tc, TOKEN_CHARS, 0, 4)}"`, "a=b=c", "x y z", word(tc, [..."é中ß"], 1, 3)]);
+  parts.push(`${padded(tc, key)}=${padded(tc, value)}`);
+  const count = n(tc, 0, 5);
+  for (let i = 0; i < count; i++) {
+    const kind = n(tc, 0, 10);
+    let a;
+    switch (kind) {
+      case 0:
+        a = `${attrName(tc, "Expires")}=${pick(tc, ["Wed, 09 Jun 2021 10:18:14 GMT", "Sun, 06 Nov 1994 08:49:37 GMT", "Fri, 31 Dec 1999 23:59:59 GMT", "junk", "", "Thu, 01 Jan 1970 00:00:00 GMT", "1 Jan 2020 00:00:00", "31 Feb 2020 00:00:00 GMT"])}`;
+        break;
+      case 1:
+        a = `${attrName(tc, "Max-Age")}=${pick(tc, ["0", "5", "-3", "007", "+5", "5x", "", "99999999999", "-0", "1000000000000000000000"])}`;
+        break;
+      case 2:
+        a = `${attrName(tc, "Domain")}=${pick(tc, ["example.com", ".example.com", "Example.COM", "", "..example.com", "sub.example.com", "1.2.3.4", "[::1]", "xn--9ca.com"])}`;
+        break;
+      case 3:
+        a = `${attrName(tc, "Path")}=${pick(tc, ["/", "/a", "/a/b", "", "rel", "a/b", "/a b", "/x=y"])}`;
+        break;
+      case 4:
+        a = attrName(tc, "Secure");
+        break;
+      case 5:
+        a = attrName(tc, "HttpOnly");
+        break;
+      case 6:
+        a = `${attrName(tc, "SameSite")}=${pick(tc, ["Strict", "lax", "NONE", "junk", "", "Lax "])}`;
+        break;
+      case 7:
+        a = pick(tc, ["Priority=High", "Partitioned", "foo", "foo=bar=baz", "=", "=x", "Secure=1", "HttpOnly=false"]);
+        break;
+      case 8:
+        a = `${attrName(tc, pick(tc, ["Expires", "Max-Age", "Domain", "Path", "Secure", "SameSite"]))}`; // bare, no value
+        break;
+      default:
+        a = `${attrName(tc, "Domain")}=${padded(tc, pick(tc, ["example.com", ".x.y"]))}`;
+    }
+    parts.push(padded(tc, a));
+  }
+  let s = parts.join(";");
+  if (flags.unicodeSpace && chance(tc, 15)) {
+    const sp = pick(tc, UNICODE_SPACE);
+    s = chance(tc, 50) ? s.replace(/=/, `=${sp}`) : s.replace(/(;|$)/, `${sp}$1`);
+  }
+  return s;
+}
+
+/** Does the string contain non-ASCII whitespace, which String.prototype.trim strips and RFC 6265 WSP does not include (bug 14 shape)? */
+export function hasUnicodeSpace(s) {
+  return /[\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]/.test(s);
+}
+
+// ---------------------------------------------------------------------------------------------
+// Cookie dates
+
+const DELIMS = [" ", " ", " ", ",", ", ", "-", "/", "\t", ";", "(", ")", " - "];
+const MONTH_TOKENS = ["Jan", "feb", "MAR", "Apr", "May", "Jun", "jul", "Aug", "Sep", "Oct", "Nov", "Dec", "January", "Sept", "Decem", "Ma", "Foo"];
+const JUNK = ["GMT", "UTC", "Wed", "Mon,", "+0000", "Z", "T", "x", "1st", "PM", "GMT+1", "été"];
+
+/** A cookie-date string: date tokens in some order, some duplicated, some junk, joined by delimiters. */
+export function dateString(tc, flags) {
+  const day = pick(tc, ["1", "01", "9", "12", "28", "29", "30", "31", "32", "0", "00", "123", "1x", "31st", "9th"]);
+  const month = pick(tc, MONTH_TOKENS);
+  const year = pick(tc, ["2021", "1999", "69", "70", "99", "00", "0", "1600", "1601", "9999", "10000", "20210", "2021x", "999", "1"]);
+  const time = pick(tc, ["10:18:14", "0:0:0", "23:59:59", "24:00:00", "12:60:00", "12:00:60", "1:2:3:4", "1:2", "001:02:03", "10:18:14.5", "10:18:14x", "9:5:7"]);
+  let tokens = [day, month, year, time];
+  if (chance(tc, 30)) tokens.push(pick(tc, JUNK));
+  if (chance(tc, 20)) tokens.push(pick(tc, [day, month, year, time, "5", "Feb", "2000", "1:1:1"]));
+  if (chance(tc, 15)) tokens.splice(n(tc, 0, tokens.length - 1), 1);
+  if (chance(tc, 60)) {
+    for (let i = tokens.length - 1; i > 0; i--) {
+      const j = n(tc, 0, i);
+      [tokens[i], tokens[j]] = [tokens[j], tokens[i]];
+    }
+  }
+  if (flags.nonLatin1 && chance(tc, 25)) {
+    const i = n(tc, 0, tokens.length - 1);
+    tokens[i] = tokens[i] + pick(tc, ["日", "ā", "中"]);
+  }
+  let s = "";
+  for (let i = 0; i < tokens.length; i++) s += (i === 0 && chance(tc, 20) ? pick(tc, DELIMS) : i === 0 ? "" : pick(tc, DELIMS)) + tokens[i];
+  if (chance(tc, 20)) s += pick(tc, DELIMS);
+  return s;
+}
+
+/** Does the string contain a character above U+00FF (bug 15's shape)? */
+export function hasNonLatin1(s) {
+  return /[^\x00-\xff]/.test(s);
+}
+
+// ---------------------------------------------------------------------------------------------
+// Host names for domain matching and canonicalization
+
+const LABELS = ["a", "b", "www", "example", "com", "org", "co", "uk", "xn--9ca", "a-b", "a_b", "1", "01", "255", "localhost"];
+const NON_ASCII_LABELS = ["é", "ÉXAMPLE", "bücher", "中文", "ＡＢ", "straße"];
+const URL_CHARS = ["@", "/", ":", "%41", "#", "?", "\0", "\\", " "];
+
+/** A host-like string: labels joined by dots, sometimes mixed case, a leading or trailing dot, an IP. */
+export function hostName(tc, flags) {
+  if (chance(tc, 10)) return pick(tc, ["1.2.3.4", "127.0.0.1", "255.255.255.255", "256.1.1.1", "1.2.3", "::1", "[::1]", "fe80::1", "2001:db8::ff00:42:8329"]);
+  const count = n(tc, 1, 4);
+  const labels = [];
+  for (let i = 0; i < count; i++) labels.push(flags.idn && chance(tc, 25) ? pick(tc, NON_ASCII_LABELS) : pick(tc, LABELS));
+  let s = labels.join(".");
+  if (chance(tc, 25)) s = s.toUpperCase();
+  if (chance(tc, 10)) s = `.${s}`;
+  if (chance(tc, 10)) s = `${s}.`;
+  if (flags.urlChars && chance(tc, 20)) {
+    const i = n(tc, 0, s.length);
+    s = s.slice(0, i) + pick(tc, URL_CHARS) + s.slice(i);
+  }
+  return s;
+}
+
+/** A domain string to match `host` against: one of its suffixes, the host itself, a sibling, or an unrelated name. */
+export function domainFor(tc, host) {
+  const labels = host.split(".");
+  const options = [host, `x.${host}`, `x${host}`, "other.org"];
+  for (let i = 1; i < labels.length; i++) options.push(labels.slice(i).join("."));
+  if (labels.length > 1) options.push(`x.${labels.slice(1).join(".")}`, labels.slice(1).join(".").slice(1));
+  return pick(tc, options);
+}
+
+/** A URL path or cookie path: segments of short words, maybe a trailing slash, maybe no leading slash. */
+export function pathString(tc) {
+  const count = n(tc, 0, 4);
+  const segs = [];
+  for (let i = 0; i < count; i++) segs.push(pick(tc, ["a", "b", "ab", "abc", "a b", "%41", ".", ".."]));
+  let s = `/${segs.join("/")}`;
+  if (count > 0 && chance(tc, 30)) s += "/";
+  if (chance(tc, 10)) s = s.slice(1);
+  if (chance(tc, 5)) s = "";
+  return s;
+}
diff --git a/hegel/hegel-zoo.mjs b/hegel/hegel-zoo.mjs
new file mode 100644
index 0000000..1ca6f10
--- /dev/null
+++ b/hegel/hegel-zoo.mjs
@@ -0,0 +1,163 @@
+// Hegel zoo: the small harness shared by the zoo's TypeScript/JavaScript targets.
+//
+// `property(name, body)` registers a node:test test that runs `body(tc)` under Hegel with
+// HEGEL_TEST_CASES cases (default 100) and the database at HEGEL_DATABASE. With ZOO_COLLECT=1
+// a `fail()` records the mismatch instead of failing, the case ends there, and the counts of
+// mismatches and of the shapes seen (`count(key)`) are printed at the end of the test, so a
+// property can be run over many cases to see every shape at once. `pin(name, body)` is a
+// plain test for one pinned bug: it must fail while the bug is present and pass once it is
+// fixed (the zoo's judge reads an unexpected pass as "fixed upstream?").
+
+import { readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+import { test as nodeTest } from "node:test";
+
+// The Hegel version these tests were written against (the zoo pins it in zoo.toml; upstream
+// would add it to devDependencies). Hegel and esbuild are installed with `npm install --prefix
+// .hegel` so the target's own package.json and lock file stay untouched. Checked at load time so
+// a stray install cannot silently change the engine.
+export const HEGEL_PIN = { "@hegeldev/hegel": "0.4.5" };
+
+const hegelDir = join(dirname(fileURLToPath(import.meta.url)), "..", ".hegel", "node_modules", "@hegeldev", "hegel");
+{
+  const installed = JSON.parse(readFileSync(join(hegelDir, "package.json"), "utf8")).version;
+  if (installed !== HEGEL_PIN["@hegeldev/hegel"]) {
+    throw new Error(`@hegeldev/hegel ${installed} is installed; these tests pin ${HEGEL_PIN["@hegeldev/hegel"]}`);
+  }
+}
+const hegel = await import(pathToFileURL(join(hegelDir, "dist", "index.js")));
+const gs = await import(pathToFileURL(join(hegelDir, "dist", "generators", "index.js")));
+
+export const collecting = !!process.env.ZOO_COLLECT;
+
+class Collected extends Error {}
+
+let msgs = [];
+let stats = new Map();
+
+/** Report a mismatch: an error normally, a recorded line in collect mode. */
+export function fail(message) {
+  if (collecting) {
+    msgs.push(message);
+    throw new Collected(message);
+  }
+  throw new Error(message);
+}
+
+/** Bump a statistic (the shape of a pinned bug, a generator branch). */
+export function count(key) {
+  stats.set(key, (stats.get(key) || 0) + 1);
+}
+
+function settings() {
+  const s = { testCases: Number(process.env.HEGEL_TEST_CASES) || 100 };
+  if (process.env.HEGEL_DATABASE) {
+    s.database = hegel.Database.fromPath(process.env.HEGEL_DATABASE);
+  }
+  return s;
+}
+
+/** A property: `body(tc)` runs under Hegel; a thrown error (or `fail`) is a failure. */
+export function property(name, body) {
+  nodeTest(name, () => {
+    msgs = [];
+    stats = new Map();
+    hegel.test((tc) => {
+      try {
+        body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** An async property: `body(tc)` may await; runs under Hegel's testAsync with the same settings. */
+export function propertyAsync(name, body) {
+  nodeTest(name, async () => {
+    msgs = [];
+    stats = new Map();
+    await hegel.testAsync(async (tc) => {
+      try {
+        await body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** A pin: a plain test for one recorded bug. */
+export function pin(name, body) {
+  nodeTest(name, body);
+}
+
+/** An integer in [lo, hi]. */
+export function n(tc, lo, hi) {
+  return tc.draw(gs.integers({ minValue: lo, maxValue: hi }));
+}
+
+/** One of xs. */
+export function pick(tc, xs) {
+  return xs[n(tc, 0, xs.length - 1)];
+}
+
+/** True pct percent of the time. */
+export function chance(tc, pct) {
+  return n(tc, 0, 99) < pct;
+}
+
+/** A string of `len` characters drawn from `alphabet` (an array of strings). */
+export function word(tc, alphabet, lo, hi) {
+  const len = n(tc, lo, hi);
+  let s = "";
+  for (let i = 0; i < len; i++) {
+    s += pick(tc, alphabet);
+  }
+  return s;
+}
+
+/** Structural equality: arrays by position, objects by key set (prototype ignored), else ===. */
+export function same(a, b) {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) {
+      return false;
+    }
+    return a.every((x, i) => same(x, b[i]));
+  }
+  if (a !== null && b !== null && typeof a === "object" && typeof b === "object") {
+    const ka = Object.keys(a).sort();
+    const kb = Object.keys(b).sort();
+    if (ka.length !== kb.length || ka.some((k, i) => k !== kb[i])) {
+      return false;
+    }
+    return ka.every((k) => same(a[k], b[k]));
+  }
+  return a === b;
+}
+
+/** A compact, unambiguous rendering for messages. */
+export function show(x) {
+  return JSON.stringify(x, (k, v) => (v === undefined ? "<undefined>" : v));
+}
