@@ -0,0 +1,334 @@
+// A naive model of a graphology graph: { options, nodes: [{key, attributes}], edges: [{key, source,
+// target, undirected, attributes}] }, and brute-force versions of the algorithms under test.
+
+export function outbound(m, u) {
+  const s = new Set();
+  for (const e of m.edges) {
+    if (e.source === u) s.add(e.target);
+    if (e.undirected && e.target === u) s.add(e.source);
+  }
+  return s;
+}
+
+export function inbound(m, u) {
+  const s = new Set();
+  for (const e of m.edges) {
+    if (e.target === u) s.add(e.source);
+    if (e.undirected && e.source === u) s.add(e.target);
+  }
+  return s;
+}
+
+export function neighbors(m, u) {
+  return new Set([...outbound(m, u), ...inbound(m, u)]);
+}
+
+/** Outbound neighbours after an edge filter (directed / undirected / in / out). */
+export function neighborsBy(m, u, mode) {
+  const s = new Set();
+  for (const e of m.edges) {
+    if (mode === "out" && !e.undirected && e.source === u) s.add(e.target);
+    if (mode === "in" && !e.undirected && e.target === u) s.add(e.source);
+    if (mode === "undirected" && e.undirected) {
+      if (e.source === u) s.add(e.target);
+      if (e.target === u) s.add(e.source);
+    }
+    if (mode === "directed" && !e.undirected) {
+      if (e.source === u) s.add(e.target);
+      if (e.target === u) s.add(e.source);
+    }
+  }
+  return s;
+}
+
+export function degrees(m, u, withSelfLoops = true) {
+  let inD = 0, outD = 0, und = 0;
+  for (const e of m.edges) {
+    if (!withSelfLoops && e.source === e.target) continue;
+    if (!e.undirected) {
+      if (e.source === u) outD++;
+      if (e.target === u) inD++;
+    } else {
+      if (e.source === u) und++;
+      if (e.target === u) und++;
+    }
+  }
+  return { in: inD, out: outD, undirected: und, directed: inD + outD, degree: inD + outD + und };
+}
+
+/** Edges going from source to target as documented: directed s->t and undirected s--t. */
+export function edgesBetween(m, s, t, type) {
+  const out = [];
+  for (const e of m.edges) {
+    if (type === "directed" && e.undirected) continue;
+    if (type === "undirected" && !e.undirected) continue;
+    if (e.source === s && e.target === t) out.push(e.key);
+    else if (e.undirected && e.source === t && e.target === s) out.push(e.key);
+  }
+  return out.sort();
+}
+
+const STEP = { outbound, inbound, all: neighbors };
+
+/** BFS distances from u following the given neighbour relation: Map key -> distance. */
+export function distances(m, u, dir = "outbound") {
+  const step = STEP[dir];
+  const dist = new Map([[u, 0]]);
+  const queue = [u];
+  while (queue.length) {
+    const v = queue.shift();
+    for (const w of step(m, v)) {
+      if (!dist.has(w)) {
+        dist.set(w, dist.get(v) + 1);
+        queue.push(w);
+      }
+    }
+  }
+  return dist;
+}
+
+/** Whether v -> w is one step along an outbound edge. */
+export function isStep(m, v, w) {
+  return outbound(m, v).has(w);
+}
+
+/** Minimal weight of an edge usable from v to w (Infinity if none). */
+export function stepWeight(m, v, w, attr = "weight") {
+  let best = Infinity;
+  for (const e of m.edges) {
+    const usable = (e.source === v && e.target === w) || (e.undirected && e.source === w && e.target === v);
+    if (usable) best = Math.min(best, e.attributes[attr]);
+  }
+  return best;
+}
+
+/** Bellman-Ford distances with positive weights from u. */
+export function weightedDistances(m, u, attr = "weight") {
+  const dist = new Map(m.nodes.map((n) => [n.key, Infinity]));
+  dist.set(u, 0);
+  for (let i = 0; i < m.nodes.length; i++) {
+    let changed = false;
+    for (const e of m.edges) {
+      const w = e.attributes[attr];
+      const relax = (a, b) => {
+        if (dist.get(a) + w < dist.get(b)) {
+          dist.set(b, dist.get(a) + w);
+          changed = true;
+        }
+      };
+      relax(e.source, e.target);
+      if (e.undirected) relax(e.target, e.source);
+    }
+    if (!changed) break;
+  }
+  return dist;
+}
+
+export function pathWeight(m, path, attr = "weight") {
+  let total = 0;
+  for (let i = 1; i < path.length; i++) total += stepWeight(m, path[i - 1], path[i], attr);
+  return total;
+}
+
+/** Weakly connected components as sorted arrays of sorted keys. */
+export function weakComponents(m) {
+  const seen = new Set();
+  const comps = [];
+  for (const n of m.nodes) {
+    if (seen.has(n.key)) continue;
+    const comp = [...distances(m, n.key, "all").keys()];
+    comp.forEach((k) => seen.add(k));
+    comps.push(comp.sort());
+  }
+  return comps.sort((a, b) => (a[0] < b[0] ? -1 : 1));
+}
+
+/** Strongly connected components (mutual outbound reachability). */
+export function strongComponents(m) {
+  const reach = new Map(m.nodes.map((n) => [n.key, distances(m, n.key, "outbound")]));
+  const seen = new Set();
+  const comps = [];
+  for (const n of m.nodes) {
+    if (seen.has(n.key)) continue;
+    const comp = m.nodes.map((o) => o.key).filter((k) => reach.get(n.key).has(k) && reach.get(k).has(n.key));
+    comp.forEach((k) => seen.add(k));
+    comps.push(comp.sort());
+  }
+  return comps.sort((a, b) => (a[0] < b[0] ? -1 : 1));
+}
+
+/** Whether the directed edges contain a cycle (a self loop is one). */
+export function hasDirectedCycle(m) {
+  const color = new Map();
+  const visit = (u) => {
+    color.set(u, 1);
+    for (const w of neighborsBy(m, u, "out")) {
+      if (color.get(w) === 1) return true;
+      if (!color.has(w) && visit(w)) return true;
+    }
+    color.set(u, 2);
+    return false;
+  };
+  return m.nodes.some((n) => !color.has(n.key) && visit(n.key));
+}
+
+/** Every simple node path from s to t along outbound edges (cycles when s === t), as sorted JSON strings. */
+export function simplePaths(m, s, t, maxDepth = Infinity) {
+  const out = [];
+  const visited = new Set([s]);
+  const path = [s];
+  const go = (u) => {
+    if (path.length - 1 >= maxDepth) return;
+    for (const w of outbound(m, u)) {
+      if (w === t && s === t) {
+        out.push(JSON.stringify([...path, w]));
+        continue;
+      }
+      if (visited.has(w)) continue;
+      if (w === t) out.push(JSON.stringify([...path, w]));
+      visited.add(w);
+      path.push(w);
+      go(w);
+      path.pop();
+      visited.delete(w);
+    }
+  };
+  go(s);
+  return out.sort();
+}
+
+/** Every simple edge path from s to t (edge keys) along outbound edges, as sorted JSON strings. */
+export function simpleEdgePaths(m, s, t, maxDepth = Infinity) {
+  const out = [];
+  const visited = new Set([s]);
+  const path = [];
+  const go = (u) => {
+    if (path.length >= maxDepth) return;
+    for (const e of m.edges) {
+      let w = null;
+      if (e.source === u) w = e.target;
+      else if (e.undirected && e.target === u) w = e.source;
+      if (w === null) continue;
+      if (w === t && s === t) {
+        out.push(JSON.stringify([...path, e.key]));
+        continue;
+      }
+      if (visited.has(w)) continue;
+      if (w === t) out.push(JSON.stringify([...path, e.key]));
+      visited.add(w);
+      path.push(e.key);
+      go(w);
+      path.pop();
+      visited.delete(w);
+    }
+  };
+  go(s);
+  return out.sort();
+}
+
+export function eccentricity(m, u) {
+  const d = distances(m, u, "outbound");
+  if (d.size < m.nodes.length) return Infinity;
+  return Math.max(...d.values());
+}
+
+/** Closeness as graphology documents it (networkx's): inbound distances, count/total, optional Wasserman-Faust factor. */
+export function closeness(m, wassermanFaust = false) {
+  const N = m.nodes.length;
+  const out = {};
+  for (const n of m.nodes) {
+    const d = distances(m, n.key, "inbound");
+    let count = 0, total = 0;
+    for (const [k, v] of d) if (k !== n.key) { count++; total += v; }
+    let c = 0;
+    if (total > 0 && N > 1) {
+      c = count / total;
+      if (wassermanFaust) c *= count / (N - 1);
+    }
+    out[n.key] = c;
+  }
+  return out;
+}
+
+/**
+ * Betweenness by Brandes' accumulation over ordered pairs, normalised by 1/((N-1)(N-2)) when N > 2;
+ * with `weighted`, shortest means minimal total `weight` (one usable edge per neighbour pair assumed).
+ */
+export function betweenness(m, normalized = true, weighted = false) {
+  const N = m.nodes.length;
+  const cb = Object.fromEntries(m.nodes.map((n) => [n.key, 0]));
+  for (const s of m.nodes.map((n) => n.key)) {
+    const dist = weighted ? weightedDistances(m, s) : distances(m, s, "outbound");
+    // nodes reachable from s in order of distance (ties in any order: predecessors are strictly closer)
+    const order = m.nodes.map((n) => n.key).filter((k) => dist.get(k) !== undefined && dist.get(k) < Infinity).sort((a, b) => dist.get(a) - dist.get(b));
+    const sigma = new Map(order.map((v) => [v, 0]));
+    const pred = new Map(order.map((v) => [v, []]));
+    sigma.set(s, 1);
+    for (const v of order) {
+      for (const w of outbound(m, v)) {
+        const step = weighted ? stepWeight(m, v, w) : 1;
+        if (w !== s && dist.get(w) === dist.get(v) + step) {
+          sigma.set(w, sigma.get(w) + sigma.get(v));
+          pred.get(w).push(v);
+        }
+      }
+    }
+    const delta = new Map(order.map((v) => [v, 0]));
+    for (const w of order.reverse()) {
+      for (const v of pred.get(w)) delta.set(v, delta.get(v) + (sigma.get(v) / sigma.get(w)) * (1 + delta.get(w)));
+      if (w !== s) cb[w] += delta.get(w);
+    }
+  }
+  let scale = null;
+  if (normalized) scale = N <= 2 ? null : 1 / ((N - 1) * (N - 2));
+  else scale = m.options.type === "undirected" ? 0.5 : null;
+  if (scale !== null) for (const k in cb) cb[k] *= scale;
+  return cb;
+}
+
+/** k-core numbers by peeling, degree = in + out + undirected, edges removed with their multiplicity. */
+export function coreNumbers(m) {
+  const deg = new Map(m.nodes.map((n) => [n.key, degrees(m, n.key).degree]));
+  const remaining = new Set(m.nodes.map((n) => n.key));
+  const core = {};
+  let k = 0;
+  while (remaining.size) {
+    let v = null;
+    for (const u of remaining) if (v === null || deg.get(u) < deg.get(v)) v = u;
+    k = Math.max(k, deg.get(v));
+    core[v] = k;
+    remaining.delete(v);
+    for (const e of m.edges) {
+      if (e.source === v && remaining.has(e.target)) deg.set(e.target, deg.get(e.target) - 1);
+      if (e.target === v && remaining.has(e.source)) deg.set(e.source, deg.get(e.source) - 1);
+    }
+  }
+  return core;
+}
+
+export function isBipartiteBy(m, attr) {
+  const parts = new Set(m.nodes.map((n) => n.attributes[attr]));
+  if (parts.size > 2) return false;
+  const part = Object.fromEntries(m.nodes.map((n) => [n.key, n.attributes[attr]]));
+  return m.edges.every((e) => part[e.source] !== part[e.target]);
+}
+
+export function density(m) {
+  const order = m.nodes.length;
+  const size = m.edges.length;
+  if (order < 2) return 0;
+  const d = order * (order - 1);
+  if (m.options.type === "undirected") return (2 * size) / d;
+  if (m.options.type === "directed") return size / d;
+  return size / (d + d / 2);
+}
+
+/** Number of edges of a simple graph with the same adjacency: one per (type, source, target) class. */
+export function simpleSize(m) {
+  const classes = new Set();
+  for (const e of m.edges) {
+    const [a, b] = e.undirected && e.source > e.target ? [e.target, e.source] : [e.source, e.target];
+    classes.add(`${e.undirected ? "u" : "d"}:${a}:${b}`);
+  }
+  return classes.size;
+}
