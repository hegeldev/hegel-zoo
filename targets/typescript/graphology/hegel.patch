diff --git a/hegel/gen.mjs b/hegel/gen.mjs
new file mode 100644
index 0000000..136f626
--- /dev/null
+++ b/hegel/gen.mjs
@@ -0,0 +1,52 @@
+// Random graphs built in parallel in graphology and in the model (hegel/model.mjs).
+import { n, pick, chance } from "./hegel-zoo.mjs";
+
+export const FULL = !!process.env.ZOO_FULL;
+
+export function options(tc) {
+  return { type: pick(tc, ["mixed", "directed", "undirected", "mixed"]), multi: chance(tc, 30), allowSelfLoops: chance(tc, 50) };
+}
+
+/** Whether the model accepts the edge under its options (graphology throws otherwise). */
+export function accepts(m, source, target, undirected) {
+  if (source === target && !m.options.allowSelfLoops) return false;
+  if (undirected && m.options.type === "directed") return false;
+  if (!undirected && m.options.type === "undirected") return false;
+  if (m.options.multi) return true;
+  return !m.edges.some((e) => e.undirected === undirected && ((e.source === source && e.target === target) || (undirected && e.source === target && e.target === source)));
+}
+
+/**
+ * A random graph with the given options: { graph, model }. Node keys n0.., edge keys <prefix>0..,
+ * every edge has a positive integer `weight`, every node a `part` of A/B.
+ */
+export function randomGraph(tc, Graph, opts, { maxNodes = 7, maxEdges = 10, prefix = "e" } = {}) {
+  const graph = new Graph(opts);
+  const model = { options: opts, nodes: [], edges: [] };
+  const order = n(tc, 0, maxNodes);
+  for (let i = 0; i < order; i++) {
+    const attributes = { part: pick(tc, ["A", "B", "A", "B", "C"]), x: i };
+    graph.addNode(`n${i}`, { ...attributes });
+    model.nodes.push({ key: `n${i}`, attributes });
+  }
+  if (order > 0) {
+    const size = n(tc, 0, maxEdges);
+    let k = 0;
+    for (let i = 0; i < size; i++) {
+      const source = `n${n(tc, 0, order - 1)}`;
+      const target = `n${n(tc, 0, order - 1)}`;
+      const undirected = opts.type === "undirected" ? true : opts.type === "directed" ? false : chance(tc, 50);
+      if (!accepts(model, source, target, undirected)) continue;
+      const key = `${prefix}${k++}`;
+      const attributes = { weight: n(tc, 1, 9) };
+      if (undirected) graph.addUndirectedEdgeWithKey(key, source, target, { ...attributes });
+      else graph.addDirectedEdgeWithKey(key, source, target, { ...attributes });
+      model.edges.push({ key, source, target, undirected, attributes });
+    }
+  }
+  return { graph, model };
+}
+
+export function someNode(tc, model) {
+  return pick(tc, model.nodes).key;
+}
diff --git a/hegel/hegel-zoo.mjs b/hegel/hegel-zoo.mjs
new file mode 100644
index 0000000..1ca6f10
--- /dev/null
+++ b/hegel/hegel-zoo.mjs
@@ -0,0 +1,163 @@
+// Hegel zoo: the small harness shared by the zoo's TypeScript/JavaScript targets.
+//
+// `property(name, body)` registers a node:test test that runs `body(tc)` under Hegel with
+// HEGEL_TEST_CASES cases (default 100) and the database at HEGEL_DATABASE. With ZOO_COLLECT=1
+// a `fail()` records the mismatch instead of failing, the case ends there, and the counts of
+// mismatches and of the shapes seen (`count(key)`) are printed at the end of the test, so a
+// property can be run over many cases to see every shape at once. `pin(name, body)` is a
+// plain test for one pinned bug: it must fail while the bug is present and pass once it is
+// fixed (the zoo's judge reads an unexpected pass as "fixed upstream?").
+
+import { readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+import { test as nodeTest } from "node:test";
+
+// The Hegel version these tests were written against (the zoo pins it in zoo.toml; upstream
+// would add it to devDependencies). Hegel and esbuild are installed with `npm install --prefix
+// .hegel` so the target's own package.json and lock file stay untouched. Checked at load time so
+// a stray install cannot silently change the engine.
+export const HEGEL_PIN = { "@hegeldev/hegel": "0.4.5" };
+
+const hegelDir = join(dirname(fileURLToPath(import.meta.url)), "..", ".hegel", "node_modules", "@hegeldev", "hegel");
+{
+  const installed = JSON.parse(readFileSync(join(hegelDir, "package.json"), "utf8")).version;
+  if (installed !== HEGEL_PIN["@hegeldev/hegel"]) {
+    throw new Error(`@hegeldev/hegel ${installed} is installed; these tests pin ${HEGEL_PIN["@hegeldev/hegel"]}`);
+  }
+}
+const hegel = await import(pathToFileURL(join(hegelDir, "dist", "index.js")));
+const gs = await import(pathToFileURL(join(hegelDir, "dist", "generators", "index.js")));
+
+export const collecting = !!process.env.ZOO_COLLECT;
+
+class Collected extends Error {}
+
+let msgs = [];
+let stats = new Map();
+
+/** Report a mismatch: an error normally, a recorded line in collect mode. */
+export function fail(message) {
+  if (collecting) {
+    msgs.push(message);
+    throw new Collected(message);
+  }
+  throw new Error(message);
+}
+
+/** Bump a statistic (the shape of a pinned bug, a generator branch). */
+export function count(key) {
+  stats.set(key, (stats.get(key) || 0) + 1);
+}
+
+function settings() {
+  const s = { testCases: Number(process.env.HEGEL_TEST_CASES) || 100 };
+  if (process.env.HEGEL_DATABASE) {
+    s.database = hegel.Database.fromPath(process.env.HEGEL_DATABASE);
+  }
+  return s;
+}
+
+/** A property: `body(tc)` runs under Hegel; a thrown error (or `fail`) is a failure. */
+export function property(name, body) {
+  nodeTest(name, () => {
+    msgs = [];
+    stats = new Map();
+    hegel.test((tc) => {
+      try {
+        body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** An async property: `body(tc)` may await; runs under Hegel's testAsync with the same settings. */
+export function propertyAsync(name, body) {
+  nodeTest(name, async () => {
+    msgs = [];
+    stats = new Map();
+    await hegel.testAsync(async (tc) => {
+      try {
+        await body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** A pin: a plain test for one recorded bug. */
+export function pin(name, body) {
+  nodeTest(name, body);
+}
+
+/** An integer in [lo, hi]. */
+export function n(tc, lo, hi) {
+  return tc.draw(gs.integers({ minValue: lo, maxValue: hi }));
+}
+
+/** One of xs. */
+export function pick(tc, xs) {
+  return xs[n(tc, 0, xs.length - 1)];
+}
+
+/** True pct percent of the time. */
+export function chance(tc, pct) {
+  return n(tc, 0, 99) < pct;
+}
+
+/** A string of `len` characters drawn from `alphabet` (an array of strings). */
+export function word(tc, alphabet, lo, hi) {
+  const len = n(tc, lo, hi);
+  let s = "";
+  for (let i = 0; i < len; i++) {
+    s += pick(tc, alphabet);
+  }
+  return s;
+}
+
+/** Structural equality: arrays by position, objects by key set (prototype ignored), else ===. */
+export function same(a, b) {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) {
+      return false;
+    }
+    return a.every((x, i) => same(x, b[i]));
+  }
+  if (a !== null && b !== null && typeof a === "object" && typeof b === "object") {
+    const ka = Object.keys(a).sort();
+    const kb = Object.keys(b).sort();
+    if (ka.length !== kb.length || ka.some((k, i) => k !== kb[i])) {
+      return false;
+    }
+    return ka.every((k) => same(a[k], b[k]));
+  }
+  return a === b;
+}
+
+/** A compact, unambiguous rendering for messages. */
+export function show(x) {
+  return JSON.stringify(x, (k, v) => (v === undefined ? "<undefined>" : v));
+}
diff --git a/hegel/hegel.test.mjs b/hegel/hegel.test.mjs
new file mode 100644
index 0000000..1e6c158
--- /dev/null
+++ b/hegel/hegel.test.mjs
@@ -0,0 +1,465 @@
+// Hegel properties for graphology and its standard library (see README.md in targets/typescript/graphology).
+import assert from "node:assert/strict";
+import { fail, count, property, pin, n, pick, chance } from "./hegel-zoo.mjs";
+import { FULL, options, randomGraph, someNode, accepts } from "./gen.mjs";
+import * as M from "./model.mjs";
+import { Graph, shortestPath, components, simplePath, traversal, dag, operators, metrics, cores, bipartite } from "./graphology.mjs";
+
+const J = JSON.stringify;
+const sorted = (xs) => [...xs].sort();
+const show = (model) => `graph ${J(model.options)} nodes ${model.nodes.map((x) => x.key).join(",")} edges ${model.edges.map((e) => `${e.key}:${e.source}${e.undirected ? "--" : "->"}${e.target}(w${e.attributes.weight})`).join(" ")}`;
+const close = (a, b) => Math.abs(a - b) <= 1e-9 * Math.max(1, Math.abs(a), Math.abs(b));
+
+/** JSON with plain objects' keys sorted (mappings come back in insertion order, which is not judged). */
+function canon(x) {
+  if (Array.isArray(x)) return x.map(canon);
+  if (x && typeof x === "object" && Object.getPrototypeOf(x) === Object.prototype) return Object.fromEntries(Object.keys(x).sort().map((k) => [k, canon(x[k])]));
+  return x;
+}
+
+function eq(actual, expected, what, model) {
+  if (J(canon(actual)) !== J(canon(expected))) fail(`${what}: got ${J(actual)}, model ${J(expected)}\n${show(model)}`);
+}
+
+/** Canonical form of an export: nodes and edges sorted by key, undirected flag explicit. */
+function canonical(data) {
+  return {
+    options: data.options,
+    nodes: [...data.nodes].sort((a, b) => (a.key < b.key ? -1 : 1)).map((x) => ({ key: x.key, attributes: x.attributes || {} })),
+    // (the flag is omitted when the graph's type implies it)
+    edges: [...data.edges].sort((a, b) => (a.key < b.key ? -1 : 1)).map((e) => ({ key: e.key, source: e.source, target: e.target, undirected: data.options.type === "undirected" || !!e.undirected, attributes: e.attributes || {} })),
+  };
+}
+
+// ---- the core graph -----------------------------------------------------------------------------
+
+property("TestHegelGraphReadsAgreeWithTheModel", (tc) => {
+  const { graph, model } = randomGraph(tc, Graph, options(tc));
+  // some mutation after construction: drop edges and a node, keeping the model in step
+  for (let i = 0, k = n(tc, 0, 2); i < k && model.edges.length; i++) {
+    const e = pick(tc, model.edges);
+    graph.dropEdge(e.key);
+    model.edges.splice(model.edges.indexOf(e), 1);
+  }
+  if (model.nodes.length && chance(tc, 30)) {
+    const v = someNode(tc, model);
+    graph.dropNode(v);
+    model.nodes.splice(model.nodes.findIndex((x) => x.key === v), 1);
+    for (let i = model.edges.length - 1; i >= 0; i--) if (model.edges[i].source === v || model.edges[i].target === v) model.edges.splice(i, 1);
+  }
+  eq(graph.order, model.nodes.length, "order", model);
+  eq(graph.size, model.edges.length, "size", model);
+  eq(graph.directedSize, model.edges.filter((e) => !e.undirected).length, "directedSize", model);
+  eq(graph.undirectedSize, model.edges.filter((e) => e.undirected).length, "undirectedSize", model);
+  eq(graph.selfLoopCount, model.edges.filter((e) => e.source === e.target).length, "selfLoopCount", model);
+  eq(sorted(graph.nodes()), sorted(model.nodes.map((x) => x.key)), "nodes()", model);
+  eq(sorted(graph.edges()), sorted(model.edges.map((e) => e.key)), "edges()", model);
+  for (const { key: u } of model.nodes) {
+    const d = M.degrees(model, u);
+    eq([graph.degree(u), graph.inDegree(u), graph.outDegree(u), graph.undirectedDegree(u), graph.directedDegree(u)], [d.degree, d.in, d.out, d.undirected, d.directed], `degrees of ${u}`, model);
+    const dd = M.degrees(model, u, false);
+    eq([graph.degreeWithoutSelfLoops(u), graph.inDegreeWithoutSelfLoops(u), graph.outDegreeWithoutSelfLoops(u), graph.undirectedDegreeWithoutSelfLoops(u)], [dd.degree, dd.in, dd.out, dd.undirected], `degrees without self loops of ${u}`, model);
+    eq(sorted(graph.neighbors(u)), sorted(M.neighbors(model, u)), `neighbors(${u})`, model);
+    eq(sorted(graph.outboundNeighbors(u)), sorted(M.outbound(model, u)), `outboundNeighbors(${u})`, model);
+    eq(sorted(graph.inboundNeighbors(u)), sorted(M.inbound(model, u)), `inboundNeighbors(${u})`, model);
+    eq(sorted(graph.outNeighbors(u)), sorted(M.neighborsBy(model, u, "out")), `outNeighbors(${u})`, model);
+    eq(sorted(graph.inNeighbors(u)), sorted(M.neighborsBy(model, u, "in")), `inNeighbors(${u})`, model);
+    eq(sorted(graph.undirectedNeighbors(u)), sorted(M.neighborsBy(model, u, "undirected")), `undirectedNeighbors(${u})`, model);
+    eq(sorted(graph.directedNeighbors(u)), sorted(M.neighborsBy(model, u, "directed")), `directedNeighbors(${u})`, model);
+    eq(sorted(graph.edges(u)), sorted(model.edges.filter((e) => e.source === u || e.target === u).map((e) => e.key)), `edges(${u})`, model);
+  }
+  if (model.nodes.length) {
+    const s = someNode(tc, model), t = someNode(tc, model);
+    const dir = M.edgesBetween(model, s, t, "directed"), und = M.edgesBetween(model, s, t, "undirected");
+    eq(sorted(graph.undirectedEdges(s, t)), und, `undirectedEdges(${s}, ${t})`, model);
+    eq(sorted(graph.outEdges(s, t)), dir, `outEdges(${s}, ${t})`, model);
+    eq(graph.hasDirectedEdge(s, t), dir.length > 0, `hasDirectedEdge(${s}, ${t})`, model);
+    eq(graph.hasUndirectedEdge(s, t), und.length > 0, `hasUndirectedEdge(${s}, ${t})`, model);
+    eq(graph.hasEdge(s, t), dir.length + und.length > 0, `hasEdge(${s}, ${t})`, model);
+    eq(graph.areOutboundNeighbors(s, t), M.outbound(model, s).has(t), `areOutboundNeighbors(${s}, ${t})`, model);
+    if (FULL) {
+      // documented as "the edges going from source to target" (bug 1: the reverse directed edges come too)
+      eq(sorted(graph.edges(s, t)), sorted([...dir, ...und]), `edges(${s}, ${t})`, model);
+      eq(sorted(graph.directedEdges(s, t)), dir, `directedEdges(${s}, ${t})`, model);
+    }
+  }
+  // serialisation round trip
+  const copy = new Graph(model.options);
+  copy.import(graph.export());
+  eq(canonical(copy.export()), canonical(graph.export()), "export/import round trip", model);
+  eq(canonical(graph.copy().export()), canonical(graph.export()), "copy()", model);
+  count(model.options.type);
+});
+
+property("TestHegelEdgeAdditionIsRefusedExactlyWhenTheModelSaysSo", (tc) => {
+  const opts = options(tc);
+  const { graph, model } = randomGraph(tc, Graph, opts, { maxNodes: 4, maxEdges: 4 });
+  if (!model.nodes.length) return;
+  for (let i = 0; i < 4; i++) {
+    const s = someNode(tc, model), t = someNode(tc, model);
+    const undirected = chance(tc, 50);
+    const ok = accepts(model, s, t, undirected);
+    let threw = null;
+    let key;
+    try {
+      key = undirected ? graph.addUndirectedEdge(s, t, { weight: 1 }) : graph.addDirectedEdge(s, t, { weight: 1 });
+    } catch (e) {
+      threw = e;
+    }
+    if (ok && threw) fail(`add${undirected ? "Undirected" : "Directed"}Edge(${s}, ${t}) threw ${threw.message} where the model accepts it\n${show(model)}`);
+    if (!ok && !threw) fail(`add${undirected ? "Undirected" : "Directed"}Edge(${s}, ${t}) was accepted where the model refuses it\n${show(model)}`);
+    if (ok) model.edges.push({ key, source: s, target: t, undirected, attributes: { weight: 1 } });
+    count(ok ? "accepted" : "refused");
+  }
+  eq(graph.size, model.edges.length, "size after additions", model);
+});
+
+// ---- shortest paths -----------------------------------------------------------------------------
+
+function validPath(model, path, s, t) {
+  if (path[0] !== s || path[path.length - 1] !== t) return false;
+  for (let i = 1; i < path.length; i++) if (!M.isStep(model, path[i - 1], path[i])) return false;
+  return true;
+}
+
+property("TestHegelUnweightedShortestPathsAgreeWithBfs", (tc) => {
+  const { graph, model } = randomGraph(tc, Graph, options(tc));
+  if (!model.nodes.length) return;
+  const s = someNode(tc, model), t = someNode(tc, model);
+  const dist = M.distances(model, s, "outbound");
+  eq(shortestPath.singleSourceLength(graph, s), Object.fromEntries(dist), `singleSourceLength(${s})`, model);
+  eq(shortestPath.undirectedSingleSourceLength(graph, s), Object.fromEntries(M.distances(model, s, "all")), `undirectedSingleSourceLength(${s})`, model);
+  const paths = shortestPath.singleSource(graph, s);
+  eq(sorted(Object.keys(paths)), sorted(dist.keys()), `singleSource(${s}) targets`, model);
+  for (const [k, p] of Object.entries(paths)) {
+    if (!validPath(model, p, s, k) || p.length - 1 !== dist.get(k)) fail(`singleSource(${s})[${k}] = ${J(p)} is not a shortest path (distance ${dist.get(k)})\n${show(model)}`);
+  }
+  const p = shortestPath.bidirectional(graph, s, t);
+  if (!dist.has(t)) {
+    if (p !== null) fail(`bidirectional(${s}, ${t}) = ${J(p)} where ${t} is unreachable\n${show(model)}`);
+  } else if (!p || !validPath(model, p, s, t) || p.length - 1 !== dist.get(t)) {
+    fail(`bidirectional(${s}, ${t}) = ${J(p)}, model distance ${dist.get(t)}\n${show(model)}`);
+  }
+  if (p && p.length > 1) {
+    // (a one-node path is mapped to a self loop when there is one, by design: not judged)
+    const ep = shortestPath.edgePathFromNodePath(graph, p);
+    if (ep.length !== p.length - 1 || ep.some((e, i) => !M.edgesBetween(model, p[i], p[i + 1]).includes(e))) fail(`edgePathFromNodePath(${J(p)}) = ${J(ep)}\n${show(model)}`);
+  }
+  count(dist.has(t) ? "reachable" : "unreachable");
+});
+
+property("TestHegelDijkstraFindsMinimalWeightPaths", (tc) => {
+  const { graph, model } = randomGraph(tc, Graph, options(tc));
+  if (!model.nodes.length) return;
+  const s = someNode(tc, model), t = someNode(tc, model);
+  const dist = M.weightedDistances(model, s);
+  const paths = shortestPath.dijkstra.singleSource(graph, s, "weight");
+  const reachable = model.nodes.map((x) => x.key).filter((k) => dist.get(k) < Infinity);
+  eq(sorted(Object.keys(paths)), sorted(reachable), `dijkstra.singleSource(${s}) targets`, model);
+  for (const [k, p] of Object.entries(paths)) {
+    if (!validPath(model, p, s, k) || M.pathWeight(model, p) !== dist.get(k)) fail(`dijkstra.singleSource(${s})[${k}] = ${J(p)} weighs ${M.pathWeight(model, p)}, model ${dist.get(k)}\n${show(model)}`);
+  }
+  const p = shortestPath.dijkstra.bidirectional(graph, s, t, "weight");
+  if (dist.get(t) === Infinity) {
+    if (p !== null) fail(`dijkstra.bidirectional(${s}, ${t}) = ${J(p)} where ${t} is unreachable\n${show(model)}`);
+  } else if (!p || !validPath(model, p, s, t) || M.pathWeight(model, p) !== dist.get(t)) {
+    fail(`dijkstra.bidirectional(${s}, ${t}) = ${J(p)} weighs ${p && M.pathWeight(model, p)}, model ${dist.get(t)}\n${show(model)}`);
+  }
+  count("ok");
+});
+
+// ---- components, DAGs, simple paths, traversal ---------------------------------------------------
+
+property("TestHegelConnectedComponentsPartitionTheGraph", (tc) => {
+  const { graph, model } = randomGraph(tc, Graph, options(tc));
+  const weak = M.weakComponents(model);
+  eq(components.connectedComponents(graph).map(sorted).sort((a, b) => (a[0] < b[0] ? -1 : 1)), weak, "connectedComponents", model);
+  eq(components.countConnectedComponents(graph), weak.length, "countConnectedComponents", model);
+  const orders = [];
+  components.forEachConnectedComponentOrder(graph, (o) => orders.push(o));
+  eq(orders.sort((a, b) => a - b), weak.map((c) => c.length).sort((a, b) => a - b), "forEachConnectedComponentOrder", model);
+  if (model.nodes.length) {
+    const largest = components.largestConnectedComponent(graph);
+    eq(largest.length, Math.max(...weak.map((c) => c.length)), "largestConnectedComponent size", model);
+    if (!weak.some((c) => J(c) === J(sorted(largest)))) fail(`largestConnectedComponent ${J(largest)} is not a component\n${show(model)}`);
+    const sub = components.largestConnectedComponentSubgraph(graph);
+    eq(sorted(sub.nodes()), sorted(largest), "largestConnectedComponentSubgraph nodes", model);
+    eq(sorted(sub.edges()), sorted(model.edges.filter((e) => largest.includes(e.source)).map((e) => e.key)), "largestConnectedComponentSubgraph edges", model);
+  }
