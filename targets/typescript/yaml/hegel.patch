+pin("TestHegelYamlTestSuitePasses", () => {
+  const root = join(here, "..", "tests", "yaml-test-suite", "src");
+  const skip = { "2JQS/0": ["event", "errors"], "9MMA/0": ["errors"], "SF5V/0": ["errors"] };
+  const failures = [];
+  let cases = 0;
+  for (const fn of readdirSync(root)) {
+    if (!fn.endsWith(".yaml")) continue;
+    const id = fn.slice(0, -5);
+    const data = Y.parse(readFileSync(join(root, fn), "utf8"));
+    if (!Array.isArray(data) || data[0].skip) continue;
+    for (let i = 0; i < data.length; i++) {
+      const sd = skip[`${id}/${i}`] || [];
+      const yaml = unescapeSuite(data[i].yaml);
+      const { fail: expectFail, tree, json } = data[i];
+      cases++;
+      const label = `${id}/${i}`;
+      let cst = "";
+      for (const tok of new Y.Parser().parse(yaml)) cst += Y.CST.stringify(tok);
+      if (cst !== yaml) failures.push(`${label}: CST does not stringify back to the source`);
+      if (!expectFail && tree && !sd.includes("event")) {
+        const res = testEvents(yaml);
+        const exp = unescapeSuite(tree).replace(/^\s+/gm, "");
+        if (res.events.join("\n") + "\n" !== exp || res.error) failures.push(`${label}: event stream differs`);
+      }
+      const docs = Y.parseAllDocuments(yaml, { resolveKnownTags: false });
+      const errors = errorsOf(docs);
+      if (!sd.includes("errors")) {
+        if (expectFail && errors.length === 0) failures.push(`${label}: expected an error, got none`);
+        if (!expectFail && errors.length > 0) failures.push(`${label}: unexpected error ${errors[0].message.split("\n")[0]}`);
+      }
+      if (!expectFail && json) {
+        const expected = docs.length > 1 ? json.replace(/\n$/, "").split("\n").map((l) => JSON.parse(l)) : [JSON.parse(json)];
+        const received = docs[0] ? docs.map((d) => d.toJS()) : null;
+        if (!deepEqual(received, expected)) failures.push(`${label}: JSON differs`);
+        const src2 = docs.map(String).join("");
+        const docs2 = Y.parseAllDocuments(src2, { resolveKnownTags: false });
+        const received2 = docs2[0] ? docs2.map((d) => d.toJS()) : null;
+        if (!deepEqual(received2, expected)) failures.push(`${label}: JSON differs after stringify + re-parse`);
+      }
+    }
+  }
+  if (cases < 300) throw new Error(`only ${cases} test-suite cases found under ${root}`);
+  if (failures.length) throw new Error(`${failures.length} test-suite failures:\n${failures.join("\n")}`);
+});
