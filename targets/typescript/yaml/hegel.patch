+  "0", "-0", "+0", "00", "007", "017", "018", "0o17", "0o8", "0x1F", "0X1F", "0xg", "0b101", "0B1", "0b2", "1_000", "1__0", "_1", "1_", "12", "-12", "+12", "1:30", "1:60", "190:20:30", "1:2:3:4", "-1:30", "1:5", "1:05",
+  "1.5", ".5", "5.", "-.5", "+.5", "1e3", "1E3", "1.e3", "1.0e+3", "1e", "1.5.2", "1_0.5", "1:30.5", "1.5e3", "1.5E-3", "1.5e+3", "1.5e3.0", "0.0", "-0.0", "+.0", ".", "-.", "1_.5", "1._5", "1.5_",
+  ".inf", "-.inf", "+.Inf", ".INF", ".nan", ".NaN", ".NAN", "inf", "nan", "Infinity", "NaN", "-.NAN", "+.nan",
+  "2001-12-14", "2001-12-14t21:59:43.10-05:00", "2001-12-14 21:59:43.10 -5", "2001-12-14T21:59:43Z", "2001-1-1", "2001-12-14 21:59:43", "2001-12-14t21:59:43.", "2001-2-30", "2001-02-30", "1999-12-31 23:59:60",
+  "2001-12-14T24:00:00Z", "2001-12-14 21:59:43 +25", "2001-13-01", "0000-01-01", "2001-02-29 00:00:00", "2001-12-14\t21:59:43", "2001-12-14 21:59:43 \tZ", "2001-12-14T21:59:43.123456789Z",
+  "9007199254740993", "-9007199254740993", "123456789012345678901234567890", "0x1fffffffffffff", "0xFFFFFFFFFFFFFFFF", "1e400", "-1e400", "4.9e-324", "1e-400",
+  "=", "<<", "a", "x y", "1 2", "1,2", "1;2", "true false", "0x", "0o", "0b", "0x_", "08", "09", "0_8", "+_1", "-_1", "1__", "3:00", "12:00:00", "-12:00:00",
+];
+
+/** A part of a composed scalar: a number 40% of the time, a numeric piece (a sign, a dot, an exponent letter, a base prefix, `.inf`) 20, a signed digit group 20, a word the schemas type 20. */
+const scalarPart = weighted(
+  [40, ints(0, 9999).map(String)],
+  [20, gs.sampledFrom(["-", "+", ".", "e", "E", "_", ":", "x", "o", "b", "0", "0x", "0o", "0b", ".inf", ".nan"])],
+  [20, gs.tuples(gs.sampledFrom(["-", "+", "", ""]), gs.sampledFrom(["0", "00", "1", "9", "1_0", "1.", ".1"])).map(([sign, digits]) => sign + digits)],
+  [20, gs.sampledFrom(["true", "yes", "on", "no", "null", "~", "T", "Y"])],
+);
+/** Whether `s` is read as one plain scalar after `- `: no indicator first (unless it starts like a number), no leading or trailing space, no `: `, ` #`, tab or line break, no trailing colon. */
+const plainShape = (s) => !(/^[-?:,[\]{}#&*!|>'"%@`]|[ \t]$|^[ \t]|: | #|[\n\r]/.test(s) && !/^[-+]?[.0-9]/.test(s)) && !/: | #|[\n\r\t]|^[ \t]|[ \t]$|:$/.test(s);
