+  assertEq(Y.parse(seq.toString()), [42], `set(0, 42) over !!str x, text ${JSON.stringify(seq.toString())}`);
+});
+
+// yaml/12
+pin("TestHegelPinSetHandlesCircularObjects", () => {
+  const o = {};
+  o.self = o;
+  const doc = new Y.Document({});
+  doc.set("x", o);
+  const text = doc.toString();
+  if (!text.includes("&")) throw new Error(`no anchor in ${JSON.stringify(text)}`);
+});
+
+// yaml/13
+pin("TestHegelPinVisitReplacingAKeyUpdatesTheMap", () => {
+  const doc = Y.parseDocument("a: 1\nb: 2\n");
+  Y.visit(doc, { Scalar(key, node) { if (key === "key" && node.value === "a") return new Y.Scalar("z"); } });
+  assertEq(doc.toString(), "z: 1\nb: 2\n", "toString after replacing the key");
+  if (!doc.value.has("z") || doc.value.has("a")) throw new Error(`has(z) ${doc.value.has("z")}, has(a) ${doc.value.has("a")} after the key was replaced`);
+  assertEq(doc.get("z")?.value, 1, "get(z)");
