+});
+
+// yaml/22
+pin("TestHegelPinBlockScalarTokensKeepLeadingSpaces", () => {
+  const token = Y.CST.createScalarToken("  a", { indent: 4, type: Y.Scalar.BLOCK_LITERAL });
