+    if (back !== value) fail(`the source of a created ${typeName ?? "auto"} token for ${JSON.stringify(value)}, ${JSON.stringify(src)}, parses to ${JSON.stringify(back)}`);
+  }
+  // setScalarValue on an existing token
+  const value2 = genString(tc);
+  const typeName2 = pick(tc, [null, ...SCALAR_TYPE_NAMES]);
+  try {
+    Y.CST.setScalarValue(token, value2, { inFlow, implicitKey, ...(typeName2 === null ? {} : { type: Y.Scalar[typeName2] }) });
+  } catch (e) {
+    fail(`setScalarValue threw for ${JSON.stringify(value2)} as ${typeName2}: ${e.message}`);
+  }
+  const src2 = Y.CST.stringify(token);
+  const blockSrc2 = src2.startsWith("|") || src2.startsWith(">");
+  if (indent === 0 && !implicitKey && !inFlow && blockSrc2) {
+    count("block-scalar-at-indent-0");
+    if (!FULL) return;
+  }
+  if (blockSrc2 && (/^[ \t]*$/.test(value2) || /(^|\n)[ \t]/.test(value2))) {
+    count("block-scalar-leading-space");
+    if (!FULL) return;
+  }
+  if (loneTerminator(src2)) {
+    count("lone-line-terminator");
+    if (!FULL) return;
+  }
+  let res2;
+  try {
+    res2 = Y.CST.resolveAsScalar(token);
+  } catch (e) {
+    fail(`resolveAsScalar threw after setScalarValue(${JSON.stringify(value2)}, ${typeName2 ?? "auto"}) on a ${typeName ?? "auto"} token at indent ${indent} (source ${JSON.stringify(src2)}): ${e.message.split("\n")[0]}`);
+  }
+  if (!res2 || res2.value !== value2) fail(`resolveAsScalar after setScalarValue(${JSON.stringify(value2)}, ${typeName2 ?? "auto"}) on a ${typeName ?? "auto"} token gives ${res2 && JSON.stringify(res2.value)} (source ${JSON.stringify(Y.CST.stringify(token))})`);
+});
+
+// ---------------------------------------------------------------- plain scalar resolution
+
+// The YAML 1.2 core schema and the YAML 1.1 types as regular expressions (spec 10.3.2; the
+// yaml-1.1 tag repository), plus the library's documented deviations (docs/03_options.md,
+// 10_yaml_syntax.md): no `y`/`n` booleans in 1.1, hex/octal/binary/sexagesimal ints in 1.1.
+const CORE_NULL = /^(~|[Nn]ull|NULL|)$/;
+const CORE_BOOL = /^([Tt]rue|TRUE|[Ff]alse|FALSE)$/;
+const CORE_INT = /^([-+]?[0-9]+|0o[0-7]+|0x[0-9a-fA-F]+)$/;
+const CORE_FLOAT = /^([-+]?(\.[0-9]+|[0-9]+(\.[0-9]*)?)([eE][-+]?[0-9]+)?|[-+]?\.(inf|Inf|INF)|\.(nan|NaN|NAN))$/;
+const Y11_BOOL = /^(Y|y|[Yy]es|YES|[Tt]rue|TRUE|[Oo]n|ON|N|n|[Nn]o|NO|[Ff]alse|FALSE|[Oo]ff|OFF)$/;
+const Y11_INT = /^([-+]?0b[0-1_]+|[-+]?0[0-7_]+|[-+]?[0-9][0-9_]*|[-+]?0x[0-9a-fA-F_]+|[-+]?[0-9][0-9_]*(:[0-5]?[0-9])+)$/;
+const Y11_FLOAT = /^([-+]?([0-9][0-9_]*)?(\.[0-9_]*)?[eE][-+]?[0-9]+|[-+]?([0-9][0-9_]*)?\.[0-9_]*|[-+]?[0-9][0-9_]*(:[0-5]?[0-9])+\.[0-9_]*|[-+]?\.(inf|Inf|INF)|\.(nan|NaN|NAN))$/;
+const Y11_TIMESTAMP = /^([0-9]{4})-([0-9]{1,2})-([0-9]{1,2})((t|T|[ \t]+)([0-9]{1,2}):([0-9]{1,2}):([0-9]{1,2}(\.[0-9]+)?)([ \t]*(Z|[-+][012]?[0-9](:[0-9]{2})?))?)?$/;
+
+function coreModel(s) {
+  if (CORE_NULL.test(s)) return { kind: "null" };
+  if (CORE_BOOL.test(s)) return { kind: "bool" };
+  if (CORE_INT.test(s)) return { kind: "int" };
+  if (CORE_FLOAT.test(s)) return { kind: "float" };
+  return { kind: "str" };
+}
+
+function y11Model(s) {
+  if (CORE_NULL.test(s)) return { kind: "null" };
+  if (Y11_BOOL.test(s)) return { kind: "bool" };
+  if (Y11_INT.test(s)) return { kind: "int" };
+  if (Y11_FLOAT.test(s)) return { kind: "float" };
+  if (Y11_TIMESTAMP.test(s)) return { kind: "timestamp" };
+  return { kind: "str" };
+}
+
+function kindOf(v) {
+  if (v === null) return "null";
+  if (typeof v === "boolean") return "bool";
+  if (typeof v === "bigint") return "int";
+  if (typeof v === "number") return Number.isInteger(v) && !Object.is(v, -0) && !/[.eE]|inf|nan/i.test("") ? "number" : "number";
+  if (v instanceof Date) return "timestamp";
+  return typeof v === "string" ? "str" : typeof v;
+}
+
+const SCALAR_POOL = [
+  "", "~", "null", "Null", "NULL", "nULL", "true", "True", "TRUE", "tRUE", "false", "yes", "Yes", "YES", "no", "No", "NO", "y", "Y", "n", "N", "on", "On", "ON", "off", "Off", "OFF",
+  "0", "-0", "+0", "00", "007", "017", "018", "0o17", "0o8", "0x1F", "0X1F", "0xg", "0b101", "0B1", "0b2", "1_000", "1__0", "_1", "1_", "12", "-12", "+12", "1:30", "1:60", "190:20:30", "1:2:3:4", "-1:30", "1:5", "1:05",
+  "1.5", ".5", "5.", "-.5", "+.5", "1e3", "1E3", "1.e3", "1.0e+3", "1e", "1.5.2", "1_0.5", "1:30.5", "1.5e3", "1.5E-3", "1.5e+3", "1.5e3.0", "0.0", "-0.0", "+.0", ".", "-.", "1_.5", "1._5", "1.5_",
+  ".inf", "-.inf", "+.Inf", ".INF", ".nan", ".NaN", ".NAN", "inf", "nan", "Infinity", "NaN", "-.NAN", "+.nan",
+  "2001-12-14", "2001-12-14t21:59:43.10-05:00", "2001-12-14 21:59:43.10 -5", "2001-12-14T21:59:43Z", "2001-1-1", "2001-12-14 21:59:43", "2001-12-14t21:59:43.", "2001-2-30", "2001-02-30", "1999-12-31 23:59:60",
+  "2001-12-14T24:00:00Z", "2001-12-14 21:59:43 +25", "2001-13-01", "0000-01-01", "2001-02-29 00:00:00", "2001-12-14\t21:59:43", "2001-12-14 21:59:43 \tZ", "2001-12-14T21:59:43.123456789Z",
+  "9007199254740993", "-9007199254740993", "123456789012345678901234567890", "0x1fffffffffffff", "0xFFFFFFFFFFFFFFFF", "1e400", "-1e400", "4.9e-324", "1e-400",
+  "=", "<<", "a", "x y", "1 2", "1,2", "1;2", "true false", "0x", "0o", "0b", "0x_", "08", "09", "0_8", "+_1", "-_1", "1__", "3:00", "12:00:00", "-12:00:00",
+];
+
+function genPlainScalar(tc) {
+  if (chance(tc, 55)) return pick(tc, SCALAR_POOL);
+  const parts = [];
+  const len = n(tc, 1, 4);
+  for (let i = 0; i < len; i++) {
+    const r = n(tc, 1, 10);
+    if (r <= 4) parts.push(String(n(tc, 0, 9999)));
+    else if (r <= 6) parts.push(pick(tc, ["-", "+", ".", "e", "E", "_", ":", "x", "o", "b", "0", "0x", "0o", "0b", ".inf", ".nan"]));
+    else if (r <= 8) parts.push(pick(tc, ["-", "+", "", ""]) + pick(tc, ["0", "00", "1", "9", "1_0", "1.", ".1"]));
+    else parts.push(pick(tc, ["true", "yes", "on", "no", "null", "~", "T", "Y"]));
+  }
+  return parts.join(pick(tc, ["", "", "_", ":", "."]));
+}
+
+property("TestHegelPlainScalarsResolveLikeTheSchema", (tc) => {
+  const s = genPlainScalar(tc);
+  trace("plain", JSON.stringify(s));
+  // only plain-scalar shapes: no indicators, no leading/trailing space
+  if (/^[-?:,[\]{}#&*!|>'"%@`]|[ \t]$|^[ \t]|: | #|[\n\r]/.test(s) && !/^[-+]?[.0-9]/.test(s)) { count("skip:not-plain"); return; }
+  if (/: | #|[\n\r\t]|^[ \t]|[ \t]$|:$/.test(s)) { count("skip:not-plain"); return; }
+  const text = `- ${s}\n`;
+  const check = (schema, model) => {
+    const docs = Y.parseAllDocuments(text, { schema });
+    const errors = errorsOf(docs);
+    if (errors.length) fail(`${schema}: ${JSON.stringify(text)} has errors: ${errors.map((e) => e.message.split("\n")[0]).join("; ")}`);
+    const arr = docs[0].toJS();
+    if (!Array.isArray(arr) || arr.length !== 1) fail(`${schema}: ${JSON.stringify(text)} is not one item: ${showValue(arr)}`);
+    const v = arr[0];
+    const got = v === null ? "null" : typeof v === "boolean" ? "bool" : typeof v === "number" || typeof v === "bigint" ? "number" : v instanceof Date ? "timestamp" : "str";
+    const exp = model.kind === "int" || model.kind === "float" ? "number" : model.kind;
+    count(`${schema}:${exp}`);
+    if (got !== exp) {
+      // the second implementation's verdict tells a model slip from a change
+      const v2 = Y2.parse(text, { schema })[0];
+      const got2 = v2 === null ? "null" : typeof v2 === "boolean" ? "bool" : typeof v2 === "number" || typeof v2 === "bigint" ? "number" : v2 instanceof Date ? "timestamp" : "str";
+      count(`${schema}:mismatch:${got2 === got ? "v2-agrees-with-v3" : "v2-agrees-with-model"}`);
+      fail(`${schema}: plain ${JSON.stringify(s)} resolves to ${got} ${showValue(v)}, the schema says ${exp} (yaml@2: ${got2} ${showValue(v2)})`);
+    }
+    if (got === "str" && v !== s) fail(`${schema}: plain ${JSON.stringify(s)} resolves to the string ${JSON.stringify(v)}`);
+    if (got === "number" && typeof v === "number") {
+      // the numeric value: JS Number of the digits (underscores removed, bases converted), NaN/Infinity as written
+      let expected;
+      const clean = s.replace(/_/g, "");
+      if (/^[-+]?\.(inf|Inf|INF)$/.test(clean)) expected = clean.startsWith("-") ? -Infinity : Infinity;
+      else if (/^\.(nan|NaN|NAN)$/.test(clean)) expected = NaN;
+      else if (/^[-+]?0x/.test(clean)) expected = (clean.startsWith("-") ? -1 : 1) * parseInt(clean.replace(/^[-+]?0x/, ""), 16);
+      else if (/^[-+]?0o/.test(clean)) expected = (clean.startsWith("-") ? -1 : 1) * parseInt(clean.replace(/^[-+]?0o/, ""), 8);
+      else if (/^[-+]?0b/.test(clean)) expected = (clean.startsWith("-") ? -1 : 1) * parseInt(clean.replace(/^[-+]?0b/, ""), 2);
+      else if (schema === "yaml-1.1" && /^[-+]?0[0-7]+$/.test(clean)) expected = (clean.startsWith("-") ? -1 : 1) * parseInt(clean.replace(/^[-+]?0/, ""), 8);
+      else if (clean.includes(":")) {
+        const neg = clean.startsWith("-");
+        const parts = clean.replace(/^[-+]/, "").split(":");
+        let acc = 0;
+        for (const p of parts) acc = acc * 60 + Number(p);
+        expected = neg ? -acc : acc;
+      } else expected = Number(clean);
+      if (!Object.is(expected, v) && !(Number.isNaN(expected) && Number.isNaN(v)) && !(expected === 0 && v === 0)) {
+        fail(`${schema}: plain ${JSON.stringify(s)} resolves to ${showValue(v)}, expected ${showValue(expected)}`);
+      }
+    }
+  };
+  check("core", coreModel(s));
+  check("yaml-1.1", y11Model(s));
+  // json and failsafe: failsafe reads every plain scalar as a string; json reads only the JSON forms
+  const fs = Y.parse(text, { schema: "failsafe" })[0];
+  if (fs !== s) fail(`failsafe: plain ${JSON.stringify(s)} resolves to ${showValue(fs)}`);
+});
