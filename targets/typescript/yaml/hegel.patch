diff --git a/hegel/writer.mjs b/hegel/writer.mjs
new file mode 100644
index 0000000..76135a2
--- /dev/null
+++ b/hegel/writer.mjs
@@ -0,0 +1,487 @@
+// Hegel zoo: a randomised YAML writer (adapted from the js-yaml target's). A generated tree of
+// plain values is written as a document in random styles - block and flow collections at random
+// indentation, plain / single-quoted / double-quoted / literal / folded scalars, explicit keys,
+// anchors, matching explicit tags, comments, document markers - staying inside what YAML 1.2
+// core and YAML 1.1 readers agree on, so that the reader must return exactly the tree.
+
+import * as Y2 from "../.hegel/node_modules/yaml/dist/index.js";
+import { chance, n, pick, word as zooWord } from "./hegel-zoo.mjs";
+
+const LETTERS = [..."abcdefghijklmnopqrstuvwxyz"];
+function word(tc) {
+  return zooWord(tc, LETTERS, 1, 6);
+}
+
+// ---------------------------------------------------------------- trees
+
+const TWO53 = 2 ** 53;
+
+export const STRING_POOL = [
+  "", " ", "a", "x y", "a: b", "a:b", "- x", "? x", "# c", "x #y", "x#y", ": x", "key:", "yes", "no", "on", "off", "y", "n",
+  "true", "false", "null", "~", "Null", "1", "-1", "+1", "0", "00", "017", "0x1f", "0o17", "0b11", "1_000", "1.5", ".5", "5.", "1e3",
+  "1.0e+3", ".inf", "-.inf", ".nan", "1:30", "12:30:45", "2001-12-14", "2001-12-14t21:59:43.10-05:00", "2001-12-14 21:59:43.10 -5",
+  "<<", "=", "---", "...", "--- x", "... x", "-", "?", ":", ",", "[", "]", "{", "}", "&a", "*a", "!x", "|", ">", "%x", "@x", "`x",
+  "'q'", "\"q\"", "\\", "a\\b", "a\nb", "a\n\nb", "a\n", "\na", "a\n\n", "  a", "a  ", "a\tb", "\t", "é", "一", "😀",
+  "\x85", " ", " ", "\ufeff", "\x00", "\x1b", "\x7f", "a\rb", "0.5.2", "1__0", "1.e3", "-.5", "+.5", "._5",
+  "a b c d e f g", "line one\nline two\nline three", "trailing space \nnext", "x".repeat(200), "w ".repeat(50).trim(),
+  "a\n b", " a\nb", "a \nb", "\n\n", "a\r\nb", "\r", "x\x85y", "　", "\x07", "---\na", "a\n---", "a\n...", "a\n#b",
+  "a\n- b", "a\nb: c", "0123456789".repeat(20), "word ".repeat(30), "a".repeat(1100),
+];
+
+export function genString(tc) {
+  if (chance(tc, 45)) return pick(tc, STRING_POOL);
+  const parts = [];
+  const len = n(tc, 1, 5);
+  for (let i = 0; i < len; i++) {
+    const r = n(tc, 1, 12);
+    if (r <= 6) parts.push(word(tc));
+    else if (r <= 8) parts.push(String(n(tc, 0, 999)));
+    else if (r === 9) parts.push(pick(tc, [" ", "  ", "\n", "\n\n", "\t"]));
+    else if (r === 10) parts.push(pick(tc, ["-", ":", "#", ",", "[", "]", "{", "}", "?", "!", "&", "*", "|", ">", "'", "\"", "%", "@", "`", "\\", "/", ".", "_", "=", "<<"]));
+    else if (r === 11) parts.push(pick(tc, ["é", "一", "😀", " ", "\x85", " "]));
+    else parts.push(pick(tc, [" ", "-", ":", " "]));
+  }
+  return parts.join(pick(tc, ["", "", " ", "-", ":"]));
+}
+
+export function genInt(tc) {
+  const r = n(tc, 1, 10);
+  if (r <= 4) return n(tc, -100, 100);
+  if (r <= 7) return n(tc, -1000000, 1000000);
+  if (r === 8) return pick(tc, [0, 1, -1, 255, 256, 65535, 2147483647, -2147483648, 4294967295, TWO53 - 1, -(TWO53 - 1)]);
+  return n(tc, -999999999999, 999999999999);
+}
+
+export function genFloat(tc) {
+  const r = n(tc, 1, 10);
+  if (r <= 3) return n(tc, -1000, 1000) / pick(tc, [2, 4, 8, 10, 100]);
+  if (r <= 5) return pick(tc, [0.1, 0.5, 1.5, -2.5, 1e-7, 1e21, 1e300, 5e-324, 123456.789, -0.0, 0.0]);
+  if (r <= 7) return pick(tc, [Infinity, -Infinity, NaN]);
+  if (r === 8) return n(tc, -1000000, 1000000) * 10 ** n(tc, -12, 12);
+  return n(tc, 1, 999) + n(tc, 0, 999) / 1000;
+}
+
+function genKey(tc, used) {
+  for (let i = 0; i < 20; i++) {
+    let k = chance(tc, 70) ? word(tc) + (chance(tc, 30) ? String(n(tc, 0, 99)) : "") : genString(tc);
+    if (k.length > 200) k = k.slice(0, 200);
+    if (!used.has(k)) return k;
+  }
+  let k = "k" + used.size;
+  while (used.has(k)) k += "_";
+  return k;
+}
+
+/** A random tree: {kind: "null"|"bool"|"int"|"float"|"string"|"seq"|"map", ...}. */
+export function genTree(tc, depth = 0) {
+  const r = n(tc, 1, 100);
+  if (depth < 3 && r <= 28) return genSeq(tc, depth);
+  if (depth < 3 && r <= 56) return genMap(tc, depth);
+  return genScalar(tc);
+}
+
+function genScalar(tc) {
+  const r = n(tc, 1, 20);
+  if (r <= 2) return { kind: "null" };
+  if (r <= 4) return { kind: "bool", value: chance(tc, 50) };
+  if (r <= 8) return { kind: "int", value: genInt(tc) };
+  if (r <= 11) return { kind: "float", value: genFloat(tc) };
+  return { kind: "string", value: genString(tc) };
+}
+
+function genSeq(tc, depth) {
+  const len = chance(tc, 10) ? 0 : n(tc, 1, 5);
+  const items = [];
+  for (let i = 0; i < len; i++) items.push(genTree(tc, depth + 1));
+  return { kind: "seq", items };
+}
+
+function genMap(tc, depth) {
+  const len = chance(tc, 10) ? 0 : n(tc, 1, 5);
+  const used = new Set();
+  const entries = [];
+  for (let i = 0; i < len; i++) {
+    const k = genKey(tc, used);
+    used.add(k);
+    entries.push([k, genTree(tc, depth + 1)]);
+  }
+  return { kind: "map", entries };
+}
+
+/** The JS value a reader should produce for a tree. */
+export function treeToValue(t) {
+  switch (t.kind) {
+    case "null": return null;
+    case "bool": case "int": case "float": case "string": return t.value;
+    case "seq": return t.items.map(treeToValue);
+    case "map": return Object.fromEntries(t.entries.map(([k, v]) => [k, treeToValue(v)]));
+  }
+  throw new Error("bad tree");
+}
+
+function isColl(t) {
+  return t.kind === "seq" || t.kind === "map";
+}
+
+function size(t) {
+  return t.kind === "seq" ? t.items.length : t.kind === "map" ? t.entries.length : 0;
+}
+
+// ---------------------------------------------------------------- scalars
+
+const PLAIN_BAN_FIRST = "-?:,[]{}#&*!|>'\"%@` \t";
+const CONTROL = /[\u0000-\u0008\u000b\u000c\u000e-\u001f\u007f\u0085\u2028\u2029\ufeff]/;
+
+const plainCache = new Map();
+
+// A string may be plain if both a 1.2 core reader and a 1.1 reader (yaml@2 with either schema
+// stands in for both) give the same string back, and the syntax leaves it whole. Not: empty,
+// multi-line, tabs, leading/trailing space.
+export function plainSafe(s, flow) {
+  if (s === "" || /[\n\r\t]/.test(s) || CONTROL.test(s)) return false;
+  if (PLAIN_BAN_FIRST.includes(s[0])) return false;
+  if (s.includes(": ") || s.includes(" #") || s.endsWith(":") || s.endsWith(" ")) return false;
+  if (s.startsWith("---") || s.startsWith("...")) return false;
+  if (s === "=" || s === "<<") return false; // YAML 1.1 !!value and !!merge
+  if (flow && /[,[\]{}:?]/.test(s)) return false;
+  if (/[\ud800-\udfff]/.test(s)) return false; // surrogates: keep them in double quotes
+  if (s.length > 1000) return false;
+  if (plainCache.has(s)) return plainCache.get(s);
+  let ok = true;
+  for (const schema of ["core", "yaml-1.1"]) {
+    let v;
+    try {
+      v = Y2.parse("- " + s + "\n", { schema });
+    } catch {
+      ok = false;
+      break;
+    }
+    if (!Array.isArray(v) || v.length !== 1 || v[0] !== s) { ok = false; break; }
+  }
+  plainCache.set(s, ok);
+  return ok;
+}
+
+function singleOK(s) {
+  return !/[\n\r\t]/.test(s) && !CONTROL.test(s) && !/[\ud800-\udfff]/.test(s) && s.length <= 1000;
+}
+
+function double(tc, s) {
+  let out = '"';
+  for (const ch of s) {
+    const c = ch.codePointAt(0);
+    if (ch === '"') out += '\\"';
+    else if (ch === "\\") out += "\\\\";
+    else if (ch === "\n") out += chance(tc, 80) ? "\\n" : "\\x0a";
+    else if (ch === "\r") out += "\\r";
+    else if (ch === "\t") out += chance(tc, 70) ? "\\t" : "\\x09";
+    else if (c === 0x85) out += "\\N";
+    else if (c === 0xa0) out += chance(tc, 50) ? "\\_" : "\\xa0";
+    else if (c === 0x2028) out += "\\L";
+    else if (c === 0x2029) out += "\\P";
+    else if (c === 0xfeff) out += "\\ufeff";
+    else if (c < 0x20 || c === 0x7f) out += "\\x" + c.toString(16).padStart(2, "0");
+    else if (c >= 0xd800 && c <= 0xdfff) out += "\\u" + c.toString(16).padStart(4, "0");
+    else if (ch === " " && chance(tc, 10)) out += "\\ ";
+    else if (ch === "/" && chance(tc, 30)) out += "\\/";
+    else if (c > 0x7f && chance(tc, 30)) out += c < 0x10000 ? "\\u" + c.toString(16).padStart(4, "0") : "\\U" + c.toString(16).padStart(8, "0");
+    else out += ch;
+  }
+  return out + '"';
+}
+
+function single(s) {
+  return "'" + s.replaceAll("'", "''") + "'";
+}
+
+// A literal block can hold s when it is multi-line, free of CR/tab/controls, not all whitespace,
+// no line ends in a space and (with keep chomping) no line starts with one.
+function literalOK(s) {
+  if (!s.includes("\n") || /[\r\t]/.test(s) || CONTROL.test(s) || s.trim() === "" || /[\ud800-\udfff]/.test(s)) return false;
+  const lines = s.split("\n");
+  if (lines.some((l) => l !== "" && l.trim() === "")) return false;
+  if (lines.some((l) => l.endsWith(" "))) return false;
+  const first = lines.find((l) => l !== "");
+  if (first === undefined || first.startsWith(" ")) return false;
+  return true;
+}
+
+// A folded block can hold s when every line is non-empty, no line starts or ends with a space,
+// no double spaces, no tabs, and it is not all whitespace.
+function foldedOK(s) {
+  if (!literalOK(s) && !(s.length > 0 && !s.includes("\n") && s.includes(" "))) return false;
+  if (/[\r\t]/.test(s) || CONTROL.test(s) || /[\ud800-\udfff]/.test(s)) return false;
+  const lines = s.replace(/\n+$/, "").split("\n");
+  return lines.every((l) => l !== "" && !l.startsWith(" ") && !l.endsWith(" ") && !l.includes("  "));
+}
+
+function chompFor(tc, s) {
+  const trimmed = s.replace(/\n+$/, "");
+  const trailing = s.length - trimmed.length;
+  const chomp = trailing === 0 ? "-" : trailing === 1 ? "" : "+";
+  return { trimmed, trailing, chomp };
+}
+
+function header(tc, kind, chomp, ind) {
+  let h = kind;
+  if (chance(tc, 50)) h += ind + chomp;
+  else h += chomp + ind;
+  if (chance(tc, 20)) h += " # comment";
+  return h;
+}
+
+/** Lines of a literal block for s, content indented by `indent` spaces (parent at parentIndent). */
+function literal(tc, s, parentIndent, indent) {
+  const { trimmed, trailing, chomp } = chompFor(tc, s);
+  const lines = trimmed.split("\n");
+  let ind = "";
+  if (chomp !== "+" && indent - parentIndent <= 9 && chance(tc, 20)) ind = String(indent - parentIndent);
+  const out = [header(tc, "|", chomp, ind)];
+  const pad = " ".repeat(indent);
+  for (const l of lines) out.push(l === "" ? (chance(tc, 50) ? "" : pad) : pad + l);
+  for (let i = 1; i < trailing; i++) out.push("");
+  return out;
+}
+
+/** Lines of a folded block for s: spaces inside a line may become line breaks, a newline in s
+ * becomes an empty line. */
+function folded(tc, s, parentIndent, indent) {
+  const { trimmed, trailing, chomp } = chompFor(tc, s);
+  const srcLines = trimmed.split("\n");
+  let ind = "";
+  if (chomp !== "+" && indent - parentIndent <= 9 && chance(tc, 20)) ind = String(indent - parentIndent);
+  const out = [header(tc, ">", chomp, ind)];
+  const pad = " ".repeat(indent);
+  srcLines.forEach((line, i) => {
+    if (i > 0) out.push("");
+    const words = line.split(" ");
+    let cur = words[0];
+    for (let w = 1; w < words.length; w++) {
+      if (chance(tc, 40)) {
+        out.push(pad + cur);
+        cur = words[w];
+      } else cur += " " + words[w];
+    }
+    out.push(pad + cur);
+  });
+  for (let i = 1; i < trailing; i++) out.push("");
+  return out;
+}
+
+function integer(tc, v) {
+  if (v === 0) return pick(tc, ["0", "0", "+0", "0x0"]);
+  if (v < 0) return String(v);
+  const r = n(tc, 1, 10);
+  if (r === 1) return "0x" + v.toString(16);
+  if (r === 2) return "0x" + v.toString(16).toUpperCase();
+  if (r === 3) return "+" + String(v);
+  return String(v);
+}
+
+function float(tc, f) {
+  if (f === Infinity) return pick(tc, [".inf", ".Inf", ".INF", "+.inf"]);
+  if (f === -Infinity) return pick(tc, ["-.inf", "-.Inf", "-.INF"]);
+  if (Number.isNaN(f)) return pick(tc, [".nan", ".NaN", ".NAN"]);
+  if (Object.is(f, -0)) return pick(tc, ["-0.0", "-0.0e+0"]);
+  let s;
+  const r = n(tc, 1, 4);
+  if (r === 1) s = f.toExponential();
+  else if (r === 2) s = f.toExponential().toUpperCase();
+  else if (Math.abs(f) < 1e17 && Math.abs(f) >= 1e-6 || f === 0) s = String(f);
+  else s = String(f);
+  s = s.replace(/^([-+]?\d+)([eE])/, "$1.0$2");
+  s = s.replace(/([eE])(\d)/, "$1+$2");
+  if (!s.includes(".")) s += ".0";
+  if (s.startsWith("0.") && chance(tc, 20)) s = s.slice(1);
+  if (/^[0-9]/.test(s) && chance(tc, 15)) s = "+" + s;
+  return s;
+}
+
+const TAG = { null: "!!null", bool: "!!bool", int: "!!int", float: "!!float", string: "!!str", seq: "!!seq", map: "!!map" };
+let anchorCount = 0;
+
+/** Node properties (anchor and/or a tag matching the kind), with a trailing space, or "". */
+function props(tc, t) {
+  let p = "";
+  if (chance(tc, 6)) p += "&a" + anchorCount++ + " ";
+  if (chance(tc, 6)) p += TAG[t.kind] + " ";
+  return p;
+}
+
+function scalar(tc, t, flow) {
+  switch (t.kind) {
+    case "null": return pick(tc, ["null", "null", "Null", "NULL", "~"]);
+    case "bool": return t.value ? pick(tc, ["true", "true", "True", "TRUE"]) : pick(tc, ["false", "false", "False", "FALSE"]);
+    case "int": return integer(tc, t.value);
+    case "float": return float(tc, t.value);
+    case "string": {
+      const s = t.value;
+      if (plainSafe(s, flow) && chance(tc, 65)) return s;
+      if (singleOK(s) && chance(tc, 45)) return single(s);
+      return double(tc, s);
+    }
+  }
+  throw new Error("scalar of a collection");
+}
+
+function key(tc, k, flow) {
+  if (plainSafe(k, flow) && chance(tc, 75)) return k;
+  if (singleOK(k) && chance(tc, 40)) return single(k);
+  return double(tc, k);
+}
+
+// ---------------------------------------------------------------- collections
+
+function sp(tc) {
+  return " ".repeat(n(tc, 0, 2));
+}
+
+function flow(tc, t) {
+  if (t.kind === "seq") {
+    if (t.items.length === 0) return props(tc, t) + "[" + sp(tc) + "]";
+    const parts = t.items.map((it) => flow(tc, it));
+    let s = props(tc, t) + "[" + sp(tc) + parts.join(sp(tc) + "," + pick(tc, [" ", " ", "", "  "]));
+    if (chance(tc, 15)) s += sp(tc) + ",";
+    return s + sp(tc) + "]";
+  }
+  if (t.kind === "map") {
+    if (t.entries.length === 0) return props(tc, t) + "{" + sp(tc) + "}";
+    const parts = t.entries.map(([k, v]) => key(tc, k, true) + sp(tc) + ": " + sp(tc) + flow(tc, v));
+    let s = props(tc, t) + "{" + sp(tc) + parts.join(sp(tc) + "," + pick(tc, [" ", " ", "", "  "]));
+    if (chance(tc, 15)) s += sp(tc) + ",";
+    return s + sp(tc) + "}";
+  }
+  return props(tc, t) + scalar(tc, t, true);
+}
+
+function comment(tc) {
+  return pick(tc, [" # c", " #", "  # comment: with [flow] and 'quotes'", " # 日本"]);
+}
+
+function maybeComment(tc) {
+  return chance(tc, 15) ? comment(tc) : "";
+}
+
+// A block scalar's lines after `head` (the key or `-`), or null when s does not fit one.
+function blockScalarLines(tc, s, indent) {
+  const step = n(tc, 1, 4);
+  if (literalOK(s) && chance(tc, 60)) return literal(tc, s, indent, indent + step);
+  if (foldedOK(s) && chance(tc, 40)) return folded(tc, s, indent, indent + step);
+  return null;
+}
+
+// Set after a keep-chomped (`+`) block scalar: an empty line following it would join its content.
+let fragileTail = false;
+
+function isKeep(block) {
+  return block !== null && /^[|>][0-9]?\+|^[|>]\+/.test(block[0]);
+}
+
+/** Lines of a collection in block style, every line indented by `indent` spaces. */
+function blockLines(tc, t, indent) {
+  const pad = " ".repeat(indent);
+  const lines = [];
+  if (t.kind === "map") {
+    for (const [k, kid] of t.entries) {
+      fragileTail = false;
+      if (chance(tc, 15)) lines.push(pad + "# before " + k.replace(/[^ -\x7e]/g, "").slice(0, 20));
+      let head = pad + key(tc, k, false) + ":";
+      let explicit = false;
+      if (chance(tc, 8) && !k.includes("\n")) {
+        lines.push(pad + "? " + key(tc, k, false));
+        head = pad + ":";
+        explicit = true;
+      }
+      const block = kid.kind === "string" ? blockScalarLines(tc, kid.value, indent) : null;
+      if (kid.kind === "null" && chance(tc, 30)) {
+        lines.push(head + maybeComment(tc));
+      } else if (block) {
+        lines.push(head + " " + props(tc, kid) + block[0], ...block.slice(1));
+        fragileTail = isKeep(block);
+      } else if (isColl(kid) && size(kid) > 0 && chance(tc, 75)) {
+        let step = n(tc, 1, 4);
+        if (kid.kind === "seq" && !explicit && chance(tc, 35)) step = 0;
+        const p = props(tc, kid);
+        lines.push(head + (p ? " " + p.trimEnd() : "") + maybeComment(tc), ...blockLines(tc, kid, indent + step));
+      } else if (isColl(kid)) {
+        lines.push(head + " " + flow(tc, kid) + maybeComment(tc));
+      } else {
+        lines.push(head + " " + sp(tc) + props(tc, kid) + scalar(tc, kid, false) + maybeComment(tc));
+      }
+      if (chance(tc, 10) && !fragileTail) lines.push("");
+    }
+  } else if (t.kind === "seq") {
+    for (const it of t.items) {
+      fragileTail = false;
+      const block = it.kind === "string" ? blockScalarLines(tc, it.value, indent) : null;
+      if (isColl(it) && size(it) > 0 && chance(tc, 50)) {
+        // compact: "- k: v" / "- - a", the rest aligned under the first entry
+        const sub = blockLines(tc, it, indent + 2);
+        sub[0] = pad + "- " + sub[0].slice(indent + 2);
+        lines.push(...sub);
+      } else if (isColl(it) && size(it) > 0) {
+        const p = props(tc, it);
+        lines.push(pad + "-" + (p ? " " + p.trimEnd() : "") + maybeComment(tc), ...blockLines(tc, it, indent + n(tc, 1, 4)));
+      } else if (block) {
+        lines.push(pad + "- " + props(tc, it) + block[0], ...block.slice(1));
+        fragileTail = isKeep(block);
+      } else if (isColl(it)) {
+        lines.push(pad + "- " + flow(tc, it) + maybeComment(tc));
+      } else if (it.kind === "null" && chance(tc, 20)) {
+        lines.push(pad + "-");
+      } else {
+        lines.push(pad + "- " + sp(tc) + props(tc, it) + scalar(tc, it, false) + maybeComment(tc));
+      }
+      if (chance(tc, 8) && !fragileTail) lines.push("");
+    }
+  } else {
+    lines.push(pad + props(tc, t) + scalar(tc, t, false));
+  }
+  return lines;
+}
+
+/** A whole document for the tree, as text; `style` records the top-level choice. */
+export function writeDocument(tc, t) {
+  let out = "";
+  const style = [];
+  anchorCount = 0;
+  if (chance(tc, 20)) { out += "# leading comment\n"; style.push("leading-comment"); }
+  if (chance(tc, 15)) out += "\n";
+  const marker = chance(tc, 30);
+  if (marker) style.push("marker");
+  if (chance(tc, 10)) { out += "%YAML 1.2\n---\n"; style.push("directive"); }
+  else if (isColl(t) && size(t) > 0 && chance(tc, 80)) {
+    if (marker) out += "---" + (chance(tc, 30) ? comment(tc) : "") + "\n";
+    let indent = 0;
+    if (chance(tc, 15)) { indent = n(tc, 1, 3); style.push("indented-root"); }
+    out += blockLines(tc, t, indent).join("\n") + "\n";
+    style.push("block");
+    if (chance(tc, 20)) { out += "...\n"; style.push("end-marker"); }
+    if (chance(tc, 10)) out += "# trailing comment\n";
+    return { text: out, style };
+  }
+  if (isColl(t) && size(t) > 0) {
+    let indent = 0;
+    if (chance(tc, 15)) { indent = n(tc, 1, 3); style.push("indented-root"); }
+    out += blockLines(tc, t, indent).join("\n") + "\n";
+    style.push("block");
+  } else if (isColl(t)) {
+    if (marker && !style.includes("directive")) out += "--- ";
+    out += flow(tc, t) + "\n";
+    style.push("flow");
+  } else if (t.kind === "string" && (literalOK(t.value) || foldedOK(t.value)) && chance(tc, 50)) {
+    // a top-level block scalar (no indentation indicator)
+    const useLiteral = literalOK(t.value) && (!foldedOK(t.value) || chance(tc, 60));
+    const lines = useLiteral ? literal(tc, t.value, -1, n(tc, 1, 4)) : folded(tc, t.value, -1, n(tc, 1, 4));
+    lines[0] = lines[0].replace(/^([|>])([+-]?)[0-9]/, "$1$2").replace(/^([|>])[0-9]([+-])/, "$1$2");
+    out += (marker && !style.includes("directive") ? "--- " : "") + lines.join("\n") + "\n";
+    style.push("block-scalar");
+  } else {
+    if (marker && !style.includes("directive")) out += "--- ";
+    out += scalar(tc, t, false) + "\n";
+    style.push("scalar");
+  }
+  if (chance(tc, 20)) { out += "...\n"; style.push("end-marker"); }
+  if (chance(tc, 10)) out += "# trailing comment\n";
+  return { text: out, style };
+}
