+      else if (/^[-+]?0x/.test(clean)) expected = (clean.startsWith("-") ? -1 : 1) * parseInt(clean.replace(/^[-+]?0x/, ""), 16);
+      else if (/^[-+]?0o/.test(clean)) expected = (clean.startsWith("-") ? -1 : 1) * parseInt(clean.replace(/^[-+]?0o/, ""), 8);
