+      ok = false;
+      break;
+    }
+    if (!Array.isArray(v) || v.length !== 1 || v[0] !== s) { ok = false; break; }
+  }
+  plainCache.set(s, ok);
+  return ok;
+}
+
+function singleOK(s) {
+  return !/[\n\r\t]/.test(s) && !CONTROL.test(s) && !SURROGATE.test(s) && s.length <= 1000;
+}
+
+const hex = (code, width) => code.toString(16).padStart(width, "0");
+
+/** `s` double-quoted, with the escapes `q` asks for where the text leaves a choice. */
+function double(s, q) {
+  let out = '"';
+  for (const ch of s) {
+    const c = ch.codePointAt(0);
+    if (ch === '"') out += '\\"';
+    else if (ch === "\\") out += "\\\\";
+    else if (ch === "\n") out += q.nlHex ? "\\x0a" : "\\n";
+    else if (ch === "\r") out += "\\r";
+    else if (ch === "\t") out += q.tabHex ? "\\x09" : "\\t";
+    else if (c === 0x85) out += "\\N";
+    else if (c === 0xa0) out += q.nbspHex ? "\\xa0" : "\\_";
+    else if (c === 0x2028) out += "\\L";
+    else if (c === 0x2029) out += "\\P";
+    else if (c === 0xfeff) out += "\\u" + hex(c, 4);
+    else if (c < 0x20 || c === 0x7f) out += "\\x" + hex(c, 2);
+    else if (c >= 0xd800 && c <= 0xdfff) out += "\\u" + hex(c, 4);
+    else if (ch === " " && q.escSpace) out += "\\ ";
+    else if (ch === "/" && q.escSlash) out += "\\/";
+    else if (c > 0x7f && q.escUnicode) out += c < 0x10000 ? "\\u" + hex(c, 4) : "\\U" + hex(c, 8);
+    else out += ch;
+  }
+  return out + '"';
+}
+
+function single(s) {
+  return "'" + s.replaceAll("'", "''") + "'";
+}
+
+// A literal block can hold s when it is multi-line, free of CR/tab/controls, not all whitespace,
+// no line ends in a space and (with keep chomping) no line starts with one.
+function literalOK(s) {
+  if (!s.includes("\n") || /[\r\t]/.test(s) || CONTROL.test(s) || s.trim() === "" || SURROGATE.test(s)) return false;
+  const lines = s.split("\n");
+  if (lines.some((l) => l !== "" && l.trim() === "")) return false;
+  if (lines.some((l) => l.endsWith(" "))) return false;
+  const first = lines.find((l) => l !== "");
+  if (first === undefined || first.startsWith(" ")) return false;
+  return true;
+}
+
+// A folded block can hold s when every line is non-empty, no line starts or ends with a space,
+// no double spaces, no tabs, and it is not all whitespace.
+function foldedOK(s) {
+  if (!literalOK(s) && !(s.length > 0 && !s.includes("\n") && s.includes(" "))) return false;
+  if (/[\r\t]/.test(s) || CONTROL.test(s) || SURROGATE.test(s)) return false;
+  const lines = s.replace(/\n+$/, "").split("\n");
+  return lines.every((l) => l !== "" && !l.startsWith(" ") && !l.endsWith(" ") && !l.includes("  "));
+}
+
+function chompFor(s) {
+  const trimmed = s.replace(/\n+$/, "");
+  const trailing = s.length - trimmed.length;
+  const chomp = trailing === 0 ? "-" : trailing === 1 ? "" : "+";
+  return { trimmed, trailing, chomp };
+}
+
+/** The header of a block scalar: the indicator `kind`, the chomping and indentation indicators in the order `b` asks for, a comment when it asks for one. */
+function header(kind, chomp, parentIndent, indent, b) {
+  const ind = chomp !== "+" && indent - parentIndent <= 9 && b.indicator ? String(indent - parentIndent) : "";
+  let h = kind + (b.indicatorFirst ? ind + chomp : chomp + ind);
+  if (b.headerComment) h += " # comment";
+  return h;
+}
+
+/** Lines of a literal block for s, content indented by `indent` spaces (parent at parentIndent), in block style `b`. */
+function literal(s, parentIndent, indent, b) {
+  const { trimmed, trailing, chomp } = chompFor(s);
+  const out = [header("|", chomp, parentIndent, indent, b)];
+  const pad = " ".repeat(indent);
+  for (const l of trimmed.split("\n")) out.push(l === "" ? (b.padEmpty ? pad : "") : pad + l);
+  for (let i = 1; i < trailing; i++) out.push("");
+  return out;
+}
+
+/** Lines of a folded block for s: spaces inside a line may become line breaks (where `b.breaks` says so), a newline in s becomes an empty line. */
+function folded(s, parentIndent, indent, b) {
+  const { trimmed, trailing, chomp } = chompFor(s);
+  const out = [header(">", chomp, parentIndent, indent, b)];
+  const pad = " ".repeat(indent);
+  let boundary = 0;
+  const breakHere = () => b.breaks.length > 0 && b.breaks[boundary++ % b.breaks.length];
+  trimmed.split("\n").forEach((line, i) => {
+    if (i > 0) out.push(""); // a newline in the value is an empty line in the block
+    const words = line.split(" ");
+    let cur = words[0];
+    for (let w = 1; w < words.length; w++) {
+      if (breakHere()) {
+        out.push(pad + cur);
+        cur = words[w];
+      } else cur += " " + words[w];
+    }
+    out.push(pad + cur);
+  });
+  for (let i = 1; i < trailing; i++) out.push("");
+  return out;
+}
+
+function integer(t) {
+  const v = t.value;
+  if (v === 0) return t.zero;
+  if (v < 0) return String(v);
+  switch (t.form) {
+    case "hex": return "0x" + v.toString(16);
+    case "HEX": return "0x" + v.toString(16).toUpperCase();
+    case "plus": return "+" + String(v);
+    default: return String(v);
+  }
+}
+
+function floatText(t) {
+  const f = t.value;
+  if (f === Infinity) return INFS[t.special % INFS.length];
+  if (f === -Infinity) return NEG_INFS[t.special % NEG_INFS.length];
+  if (Number.isNaN(f)) return NANS[t.special % NANS.length];
+  if (Object.is(f, -0)) return NEG_ZEROS[t.special % NEG_ZEROS.length];
+  let s = t.form === "exp" ? f.toExponential() : t.form === "EXP" ? f.toExponential().toUpperCase() : String(f);
+  s = s.replace(/^([-+]?\d+)([eE])/, "$1.0$2");
+  s = s.replace(/([eE])(\d)/, "$1+$2");
+  if (!s.includes(".")) s += ".0";
+  if (s.startsWith("0.") && t.stripZero) s = s.slice(1);
+  if (/^[0-9]/.test(s) && t.plus) s = "+" + s;
+  return s;
+}
+
+/** The text of a string in its quoting `q`: plain or single-quoted when the text allows it and `q` asks for it, else double-quoted. */
+function quoted(s, q, flow) {
+  if (q.plain && plainSafe(s, flow)) return s;
+  if (q.single && singleOK(s)) return single(s);
+  return double(s, q);
+}
+
+/** The in-line text of a scalar node. */
+function scalarText(t, flow) {
+  switch (t.kind) {
+    case "null": return t.text;
+    case "bool": return (t.value ? TRUES : FALSES)[t.spell];
+    case "int": return integer(t);
+    case "float": return floatText(t);
+    case "string": return quoted(t.value, t.quote, flow);
+  }
+  throw new Error("scalar of a collection");
+}
+
+// ---------------------------------------------------------------- node properties
+
+const TAG = { null: "!!null", bool: "!!bool", int: "!!int", float: "!!float", string: "!!str", seq: "!!seq", map: "!!map" };
+
+/** The node properties of `t` (an anchor numbered in writing order and/or the tag matching the kind), with a trailing space, or "". */
+function propsText(t, ctx) {
+  let p = "";
+  if (t.props.anchor) p += "&a" + ctx.anchors++ + " ";
+  if (t.props.tag) p += TAG[t.kind] + " ";
+  return p;
+}
+
+// ---------------------------------------------------------------- writing collections
+
+const sp = (n) => " ".repeat(n);
+
+/** A collection (or scalar) in flow style, on one line, with its properties. */
+function flow(t, ctx) {
+  if (t.kind === "seq") {
+    const F = t.flow;
+    if (t.items.length === 0) return propsText(t, ctx) + "[" + sp(F.open) + "]";
+    const parts = t.items.map((it) => flow(it.node, ctx));
+    let s = propsText(t, ctx) + "[" + sp(F.open) + parts.join(sp(F.beforeComma) + "," + F.afterComma);
+    if (F.trail !== undefined) s += sp(F.trail) + ",";
+    return s + sp(F.close) + "]";
+  }
+  if (t.kind === "map") {
+    const F = t.flow;
+    if (t.entries.length === 0) return propsText(t, ctx) + "{" + sp(F.open) + "}";
+    const parts = t.entries.map((e) => quoted(e.key, e.keyQuote, true) + sp(e.layout.beforeColon) + ": " + sp(e.layout.afterColon) + flow(e.node, ctx));
+    let s = propsText(t, ctx) + "{" + sp(F.open) + parts.join(sp(F.beforeComma) + "," + F.afterComma);
+    if (F.trail !== undefined) s += sp(F.trail) + ",";
+    return s + sp(F.close) + "}";
+  }
+  return propsText(t, ctx) + scalarText(t, true);
+}
+
+// The lines of a string node as a block scalar after `head` (the key or `-`), or null when the text does not fit the form its style asks for.
+function blockScalarLines(t, indent) {
+  const s = t.value;
+  const b = t.block;
+  if (b.literal && literalOK(s)) return literal(s, indent, indent + b.step, b);
+  if (b.folded && foldedOK(s)) return folded(s, indent, indent + b.step, b);
+  return null;
+}
+
+function isKeep(block) {
+  return block !== null && /^[|>][0-9]?\+|^[|>]\+/.test(block[0]);
+}
+
+/**
+ * Lines of a collection in block style, every line indented by `indent` spaces. `ctx.fragile` is
+ * set after a keep-chomped (`+`) block scalar: an empty line following it would join its content,
+ * so none is written until some other entry has been.
+ */
+function blockLines(t, indent, ctx) {
+  const pad = " ".repeat(indent);
+  const lines = [];
+  if (t.kind === "map") {
+    for (const e of t.entries) {
+      const { key: k, node: kid, layout: L } = e;
+      ctx.fragile = false;
+      if (L.before) lines.push(pad + "# before " + k.replace(/[^ -\x7e]/g, "").slice(0, 20));
+      let head = pad + quoted(k, e.keyQuote, false) + ":";
+      let explicit = false;
+      if (L.explicit && !k.includes("\n")) {
+        lines.push(pad + "? " + quoted(k, e.keyQuote, false));
+        head = pad + ":";
+        explicit = true;
+      }
+      const block = kid.kind === "string" ? blockScalarLines(kid, indent) : null;
+      const tail = L.comment ?? "";
+      if (kid.kind === "null" && L.bareNull) {
+        lines.push(head + tail);
+      } else if (block) {
+        lines.push(head + " " + propsText(kid, ctx) + block[0], ...block.slice(1));
+        ctx.fragile = isKeep(block);
+      } else if (isColl(kid) && size(kid) > 0 && L.block) {
+        const step = kid.kind === "seq" && !explicit && L.indentless ? 0 : L.step;
+        const p = propsText(kid, ctx);
+        lines.push(head + (p ? " " + p.trimEnd() : "") + tail, ...blockLines(kid, indent + step, ctx));
+      } else if (isColl(kid)) {
+        lines.push(head + " " + flow(kid, ctx) + tail);
+      } else {
+        lines.push(head + " " + sp(L.sp) + propsText(kid, ctx) + scalarText(kid, false) + tail);
+      }
+      if (L.blank && !ctx.fragile) lines.push("");
+    }
+  } else if (t.kind === "seq") {
+    for (const { node: kid, layout: L } of t.items) {
+      ctx.fragile = false;
+      const block = kid.kind === "string" ? blockScalarLines(kid, indent) : null;
+      const tail = L.comment ?? "";
+      if (isColl(kid) && size(kid) > 0 && L.compact) {
+        // compact: "- k: v" / "- - a", the rest aligned under the first entry
+        const sub = blockLines(kid, indent + 2, ctx);
+        sub[0] = pad + "- " + sub[0].slice(indent + 2);
+        lines.push(...sub);
+      } else if (isColl(kid) && size(kid) > 0) {
+        const p = propsText(kid, ctx);
+        lines.push(pad + "-" + (p ? " " + p.trimEnd() : "") + tail, ...blockLines(kid, indent + L.step, ctx));
+      } else if (block) {
+        lines.push(pad + "- " + propsText(kid, ctx) + block[0], ...block.slice(1));
+        ctx.fragile = isKeep(block);
+      } else if (isColl(kid)) {
+        lines.push(pad + "- " + flow(kid, ctx) + tail);
+      } else if (kid.kind === "null" && L.bareNull) {
+        lines.push(pad + "-");
+      } else {
+        lines.push(pad + "- " + sp(L.sp) + propsText(kid, ctx) + scalarText(kid, false) + tail);
+      }
+      if (L.blank && !ctx.fragile) lines.push("");
+    }
+  } else {
+    lines.push(pad + propsText(t, ctx) + scalarText(t, false));
+  }
+  return lines;
+}
+
+/** A whole document for a drawn case (its tree in its framing), as text; `style` records the top-level choices. */
+export function writeDocument({ tree: t, framing: D }) {
+  let out = "";
+  const style = [];
+  const ctx = { fragile: false, anchors: 0 };
+  if (D.leadingComment) { out += "# leading comment\n"; style.push("leading-comment"); }
+  if (D.blank) out += "\n";
+  if (D.marker) style.push("marker");
+  // the directive brings its own `---`, so the marker is not written again after it
+  const marker = D.marker && !D.directive;
+  if (D.directive) { out += "%YAML 1.2\n---\n"; style.push("directive"); }
+  if (isColl(t) && size(t) > 0 && (D.block || D.directive)) {
+    if (marker) out += "---" + (D.markerComment ?? "") + "\n";
+    let indent = 0;
+    if (D.rootIndent !== undefined) { indent = D.rootIndent; style.push("indented-root"); }
+    out += blockLines(t, indent, ctx).join("\n") + "\n";
+    style.push("block");
+  } else if (isColl(t)) {
+    if (marker) out += "--- ";
+    out += flow(t, ctx) + "\n";
+    style.push("flow");
+  } else if (t.kind === "string" && (literalOK(t.value) || foldedOK(t.value)) && D.blockScalar) {
+    // a top-level block scalar (no indentation indicator)
+    const useLiteral = literalOK(t.value) && (!foldedOK(t.value) || D.literal);
+    const lines = useLiteral ? literal(t.value, -1, D.step, t.block) : folded(t.value, -1, D.step, t.block);
+    lines[0] = lines[0].replace(/^([|>])([+-]?)[0-9]/, "$1$2").replace(/^([|>])[0-9]([+-])/, "$1$2");
+    out += (marker ? "--- " : "") + lines.join("\n") + "\n";
+    style.push("block-scalar");
+  } else {
+    if (marker) out += "--- ";
+    out += scalarText(t, false) + "\n";
+    style.push("scalar");
+  }
+  if (D.endMarker) { out += "...\n"; style.push("end-marker"); }
+  if (D.trailingComment) out += "# trailing comment\n";
+  return { text: out, style };
+}
