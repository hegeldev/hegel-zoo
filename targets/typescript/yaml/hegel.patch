+property("TestHegelLineCounterAgreesWithBruteForce", (tc) => {
+  const text = genSource(tc);
+  trace("linecounter", text);
+  if (loneTerminator(text)) { count("lone-line-terminator"); if (!FULL) return; }
+  const lineCounter = new Y.LineCounter();
+  const parsed = Y.parseAllDocuments(text, { lineCounter });
+  // recorded shape (yaml/6): line breaks inside a scalar token that the parser stores as a source token while
+  // recovering from an error (a plain continuation, an unterminated quoted scalar after a finished node), and the
+  // empty line after a block scalar header followed by a %-token, are not counted
+  const lexed = Y.lex(text);
+  if (errorsOf(parsed).length > 0 && lexed.some((x) => (x.includes("\n") && x !== "\n" && x !== "\r\n") || /^[|>]/.test(x))) {
+    count("multiline-scalar-under-error");
+    if (!FULL) return;
+  }
+  // line starts: 0 and every offset after a line break (\n, or \r\n as one break)
+  const starts = [0];
+  for (let i = 0; i < text.length; i++) if (text[i] === "\n") starts.push(i + 1);
+  const got = lineCounter.lineStarts;
+  if (got.length !== starts.length || got.some((x, i) => x !== starts[i])) {
+    fail(`lineStarts ${JSON.stringify(got)} for ${shortText(text)}, expected ${JSON.stringify(starts)}`);
+  }
+  const offset = n(tc, 0, text.length);
+  const { line, col } = lineCounter.linePos(offset);
+  let li = 0;
+  while (li + 1 < starts.length && starts[li + 1] <= offset) li++;
+  const eline = li + 1;
+  const ecol = offset - starts[li] + 1;
+  if (line !== eline || col !== ecol) fail(`linePos(${offset}) is ${line}:${col} for ${shortText(text)}, expected ${eline}:${ecol}`);
+  // error positions (prettyErrors) name the same line and column as the offsets
+  const docs = Y.parseAllDocuments(text, { prettyErrors: true });
+  for (const d of docs) for (const e of d.errors) {
+    if (!e.linePos) continue;
+    const lc = new Y.LineCounter();
+    Y.parseAllDocuments(text, { lineCounter: lc });
+    const p = lc.linePos(e.pos[0]);
+    if (e.linePos[0].line !== p.line || e.linePos[0].col !== p.col) fail(`error at offset ${e.pos[0]} reports ${e.linePos[0].line}:${e.linePos[0].col}, the LineCounter says ${p.line}:${p.col} for ${shortText(text)}`);
+  }
+});
