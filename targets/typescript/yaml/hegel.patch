+const plainScalar = weighted(
+  [55, gs.sampledFrom(SCALAR_POOL)],
+  [45, gs.tuples(gs.arrays(scalarPart, { minSize: 1, maxSize: 4 }), gs.sampledFrom(["", "", "_", ":", "."])).map(([parts, sep]) => parts.join(sep))],
+).filter(plainShape);
