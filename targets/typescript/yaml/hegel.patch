+});
+
+// yaml/21
+pin("TestHegelPinGetWithAMissingKeyOnASequenceReturnsUndefined", () => {
+  const doc = new Y.Document([1]);
+  let got;
+  try {
+    got = doc.get("x");
+  } catch (e) {
