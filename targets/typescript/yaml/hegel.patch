+const CORE_INT = /^([-+]?[0-9]+|0o[0-7]+|0x[0-9a-fA-F]+)$/;
+const CORE_FLOAT = /^([-+]?(\.[0-9]+|[0-9]+(\.[0-9]*)?)([eE][-+]?[0-9]+)?|[-+]?\.(inf|Inf|INF)|\.(nan|NaN|NAN))$/;
+const Y11_BOOL = /^(Y|y|[Yy]es|YES|[Tt]rue|TRUE|[Oo]n|ON|N|n|[Nn]o|NO|[Ff]alse|FALSE|[Oo]ff|OFF)$/;
+const Y11_INT = /^([-+]?0b[0-1_]+|[-+]?0[0-7_]+|[-+]?[0-9][0-9_]*|[-+]?0x[0-9a-fA-F_]+|[-+]?[0-9][0-9_]*(:[0-5]?[0-9])+)$/;
+const Y11_FLOAT = /^([-+]?([0-9][0-9_]*)?(\.[0-9_]*)?[eE][-+]?[0-9]+|[-+]?([0-9][0-9_]*)?\.[0-9_]*|[-+]?[0-9][0-9_]*(:[0-5]?[0-9])+\.[0-9_]*|[-+]?\.(inf|Inf|INF)|\.(nan|NaN|NAN))$/;
+const Y11_TIMESTAMP = /^([0-9]{4})-([0-9]{1,2})-([0-9]{1,2})((t|T|[ \t]+)([0-9]{1,2}):([0-9]{1,2}):([0-9]{1,2}(\.[0-9]+)?)([ \t]*(Z|[-+][012]?[0-9](:[0-9]{2})?))?)?$/;
+
+function coreModel(s) {
+  if (CORE_NULL.test(s)) return { kind: "null" };
+  if (CORE_BOOL.test(s)) return { kind: "bool" };
+  if (CORE_INT.test(s)) return { kind: "int" };
+  if (CORE_FLOAT.test(s)) return { kind: "float" };
+  return { kind: "str" };
+}
+
+function y11Model(s) {
+  if (CORE_NULL.test(s)) return { kind: "null" };
+  if (Y11_BOOL.test(s)) return { kind: "bool" };
+  if (Y11_INT.test(s)) return { kind: "int" };
+  if (Y11_FLOAT.test(s)) return { kind: "float" };
+  if (Y11_TIMESTAMP.test(s)) return { kind: "timestamp" };
+  return { kind: "str" };
+}
