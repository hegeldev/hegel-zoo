+// ---------------------------------------------------------------- the YAML test suite
+
+const unescapeSuite = (t) => t.replace(/␣/g, " ").replace(/—*»/g, "\t").replace(/←/g, "\r").replace(/⇔/g, "\ufeff").replace(/↵/g, "").replace(/∎\n/g, "");
