+});
+
+// yaml/23
+pin("TestHegelPinNegativeZeroInExponentialNotationKeepsItsSign", () => {
+  const doc = Y.parseDocument("- !!float -0.0e+0\n");
+  const text = doc.toString();
+  const back = Y.parse(text)[0];
+  if (!Object.is(back, -0)) throw new Error(`${JSON.stringify(text)} reads back as ${showValue(back)}, not -0`);
+  const s = new Y.Scalar(-0);
+  s.format = "EXP";
+  const text2 = new Y.Document([s]).toString();
+  if (!Object.is(Y.parse(text2)[0], -0)) throw new Error(`${JSON.stringify(text2)} reads back as ${showValue(Y.parse(text2)[0])}, not -0`);
