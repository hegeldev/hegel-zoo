diff --git a/hegel/gen.mjs b/hegel/gen.mjs
new file mode 100644
index 0000000..26b53bb
--- /dev/null
+++ b/hegel/gen.mjs
@@ -0,0 +1,160 @@
+// Hegel zoo: JS value generators, stringify options and value comparison for the yaml target.
+import { chance, n, pick, word } from "./hegel-zoo.mjs";
+import { genFloat, genInt, genString } from "./writer.mjs";
+
+export const FULL = !!process.env.ZOO_FULL;
+
+// ---------------------------------------------------------------- comparison
+
+/** Deep equality: Map/Set/Date/Uint8Array aware, NaN equal to NaN, -0 distinct from 0, bigint. */
+export function deepEqual(a, b, seen = new Map()) {
+  if (Object.is(a, b)) return true;
+  if (typeof a !== "object" || typeof b !== "object" || a === null || b === null) return false;
+  if (seen.get(a) === b) return true;
+  seen.set(a, b);
+  if (a instanceof Date || b instanceof Date) {
+    return a instanceof Date && b instanceof Date && Object.is(a.getTime(), b.getTime());
+  }
+  if (a instanceof Uint8Array || b instanceof Uint8Array) {
+    return a instanceof Uint8Array && b instanceof Uint8Array && a.length === b.length && a.every((x, i) => x === b[i]);
+  }
+  if (Array.isArray(a) || Array.isArray(b)) {
+    return Array.isArray(a) && Array.isArray(b) && a.length === b.length && a.every((x, i) => deepEqual(x, b[i], seen));
+  }
+  if (a instanceof Set || b instanceof Set) {
+    if (!(a instanceof Set && b instanceof Set) || a.size !== b.size) return false;
+    const bs = [...b];
+    return [...a].every((x) => bs.some((y) => deepEqual(x, y, new Map(seen))));
+  }
+  if (a instanceof Map || b instanceof Map) {
+    if (!(a instanceof Map && b instanceof Map) || a.size !== b.size) return false;
+    const bs = [...b];
+    return [...a].every(([k, x]) => bs.some(([l, y]) => deepEqual(k, l, new Map(seen)) && deepEqual(x, y, seen)));
+  }
+  const ka = Object.keys(a).sort();
+  const kb = Object.keys(b).sort();
+  if (ka.length !== kb.length || ka.some((k, i) => k !== kb[i])) return false;
+  return ka.every((k) => deepEqual(a[k], b[k], seen));
+}
+
+/** A rendering of a value for messages (Map/Set/Date/bytes/NaN/-0/bigint made visible). */
+export function showValue(v) {
+  const seen = new WeakSet();
+  return JSON.stringify(v, function (k, x) {
+    if (x && typeof x === "object") {
+      if (seen.has(x)) return "<cycle>";
+      seen.add(x);
+    }
+    if (typeof x === "number" && !Number.isFinite(x)) return `<${String(x)}>`;
+    if (Object.is(x, -0)) return "<-0>";
+    if (typeof x === "bigint") return `<${x}n>`;
+    if (x === undefined) return "<undefined>";
+    if (x instanceof Map) return { $map: [...x] };
+    if (x instanceof Set) return { $set: [...x] };
+    if (x instanceof Uint8Array) return { $bytes: [...x] };
+    if (x instanceof Date) return { $date: Number.isNaN(x.getTime()) ? "invalid" : x.toISOString() };
+    return x;
+  });
+}
+
+// ---------------------------------------------------------------- JS values
+
+/** A random JS value for stringify: plain objects, arrays, strings, numbers, booleans, null;
+ * with `mode.maps` also Map (string or scalar keys) and Set; `mode.dates` Dates; `mode.bytes`
+ * Uint8Array; `mode.bigint` BigInt. */
+export function genValue(tc, mode = {}, depth = 0) {
+  const r = n(tc, 1, 100);
+  if (depth < 3 && r <= 22) {
+    const len = chance(tc, 10) ? 0 : n(tc, 1, 5);
+    const a = [];
+    for (let i = 0; i < len; i++) a.push(genValue(tc, mode, depth + 1));
+    return a;
+  }
+  if (depth < 3 && r <= 44 && !mode.maps) {
+    const len = chance(tc, 10) ? 0 : n(tc, 1, 5);
+    const o = {};
+    for (let i = 0; i < len; i++) o[genKey(tc)] = genValue(tc, mode, depth + 1);
+    return o;
+  }
+  if (depth < 3 && mode.maps && r <= 50 + 22) {
+    const m = new Map();
+    const len = n(tc, 0, 4);
+    for (let i = 0; i < len; i++) m.set(chance(tc, 60) ? genKey(tc) : genScalarValue(tc, mode), genValue(tc, mode, depth + 1));
+    return m;
+  }
+  if (depth < 3 && mode.maps && mode.sets && r <= 54 + 22) {
+    const s = new Set();
+    const len = n(tc, 0, 4);
+    for (let i = 0; i < len; i++) s.add(genScalarValue(tc, mode));
+    return s;
+  }
+  return genScalarValue(tc, mode);
+}
+
+export function genScalarValue(tc, mode = {}) {
+  const r = n(tc, 1, 24);
+  if (r <= 2) return null;
+  if (r <= 4) return chance(tc, 50);
+  // with intAsBigInt every integer reads back as a BigInt, so integers are written as BigInts and
+  // floats are kept non-integral (0.0 would come back as 0n)
+  if (r <= 8) return mode.bigint ? BigInt(genInt(tc)) : genInt(tc);
+  if (r <= 11) {
+    const f = genFloat(tc);
+    return mode.bigint && Number.isInteger(f) ? f + 0.5 : f;
+  }
+  if (r === 12 && mode.dates) return genDate(tc);
+  if (r === 13 && mode.bytes) return new Uint8Array(Array.from({ length: n(tc, 0, 40) }, () => n(tc, 0, 255)));
+  if (r === 14 && mode.bigint) return BigInt(genInt(tc)) * (chance(tc, 30) ? 1000000007n : 1n);
+  return genString(tc);
+}
+
+export function genDate(tc) {
+  const r = n(tc, 1, 6);
+  if (r === 1) return new Date(pick(tc, [0, 1e12, -1e12, 951782400000, 253402300799000, -62135596800000, 1234567890123]));
+  const t = n(tc, -2208988800, 4102444800) * 1000 + (chance(tc, 50) ? n(tc, 0, 999) : 0);
+  return new Date(t);
+}
+
+export function genKey(tc) {
+  const r = n(tc, 1, 10);
+  if (r <= 6) return word(tc, [..."abcdefghijklmnopqrstuvwxyz"], 1, 6) + (chance(tc, 30) ? String(n(tc, 0, 99)) : "");
+  return genString(tc).slice(0, 200);
+}
+
+// ---------------------------------------------------------------- options
+
+const SCALAR_TYPES = ["PLAIN", "QUOTE_DOUBLE", "QUOTE_SINGLE", "BLOCK_LITERAL", "BLOCK_FOLDED"];
+
+/** Random ToStringOptions + DocumentOptions + SchemaOptions (as one object, as the API takes). */
+export function genOptions(tc, mode) {
+  const o = {};
+  const maybe = (k, f) => { if (chance(tc, 30)) o[k] = f(); };
+  o.schema = pick(tc, ["core", "core", "core", "yaml-1.1", "json", "failsafe"]);
+  if (mode.dates || mode.bytes || mode.sets) o.schema = "yaml-1.1"; // !!timestamp, !!binary and !!set are YAML 1.1 tags
+  if (o.schema === "yaml-1.1" && chance(tc, 50)) o.version = "1.1";
+  maybe("blockQuote", () => pick(tc, [true, false, "folded", "literal"]));
+  maybe("collectionStyle", () => pick(tc, ["any", "block", "flow"]));
+  maybe("defaultKeyType", () => pick(tc, [null, ...SCALAR_TYPES]));
+  maybe("defaultStringType", () => pick(tc, SCALAR_TYPES));
+  maybe("doubleQuotedAsJSON", () => chance(tc, 50));
+  maybe("doubleQuotedMinMultiLineLength", () => n(tc, 0, 60));
+  maybe("flowCollectionPadding", () => chance(tc, 50));
+  maybe("indent", () => n(tc, 1, 6));
+  maybe("indentSeq", () => chance(tc, 50));
+  maybe("lineWidth", () => pick(tc, [0, 10, 20, 40, 80, 200]));
+  maybe("minContentWidth", () => pick(tc, [0, 5, 20, 40]));
+  maybe("simpleKeys", () => chance(tc, 50));
+  maybe("singleQuote", () => pick(tc, [null, true, false]));
+  maybe("sortMapEntries", () => chance(tc, 50));
+  maybe("trailingComma", () => chance(tc, 50));
+  maybe("directives", () => pick(tc, [null, true, false]));
+  maybe("nullStr", () => pick(tc, ["null", "~", "Null", ""]));
+  maybe("trueStr", () => pick(tc, ["true", "True", "TRUE"]));
+  maybe("falseStr", () => pick(tc, ["false", "False", "FALSE"]));
+  maybe("aliasDuplicateObjects", () => chance(tc, 50));
+  maybe("anchorPrefix", () => pick(tc, ["a", "x", "anchor"]));
+  if (mode.maps) o.mapAsMap = true;
+  if (mode.bigint) o.intAsBigInt = true;
+  maybe("keepUndefined", () => chance(tc, 50));
+  return o;
+}
diff --git a/hegel/hegel-zoo.mjs b/hegel/hegel-zoo.mjs
new file mode 100644
index 0000000..1ca6f10
--- /dev/null
+++ b/hegel/hegel-zoo.mjs
@@ -0,0 +1,163 @@
+// Hegel zoo: the small harness shared by the zoo's TypeScript/JavaScript targets.
+//
+// `property(name, body)` registers a node:test test that runs `body(tc)` under Hegel with
+// HEGEL_TEST_CASES cases (default 100) and the database at HEGEL_DATABASE. With ZOO_COLLECT=1
+// a `fail()` records the mismatch instead of failing, the case ends there, and the counts of
+// mismatches and of the shapes seen (`count(key)`) are printed at the end of the test, so a
+// property can be run over many cases to see every shape at once. `pin(name, body)` is a
+// plain test for one pinned bug: it must fail while the bug is present and pass once it is
+// fixed (the zoo's judge reads an unexpected pass as "fixed upstream?").
+
+import { readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+import { test as nodeTest } from "node:test";
+
+// The Hegel version these tests were written against (the zoo pins it in zoo.toml; upstream
+// would add it to devDependencies). Hegel and esbuild are installed with `npm install --prefix
+// .hegel` so the target's own package.json and lock file stay untouched. Checked at load time so
+// a stray install cannot silently change the engine.
+export const HEGEL_PIN = { "@hegeldev/hegel": "0.4.5" };
+
+const hegelDir = join(dirname(fileURLToPath(import.meta.url)), "..", ".hegel", "node_modules", "@hegeldev", "hegel");
+{
+  const installed = JSON.parse(readFileSync(join(hegelDir, "package.json"), "utf8")).version;
+  if (installed !== HEGEL_PIN["@hegeldev/hegel"]) {
+    throw new Error(`@hegeldev/hegel ${installed} is installed; these tests pin ${HEGEL_PIN["@hegeldev/hegel"]}`);
+  }
+}
+const hegel = await import(pathToFileURL(join(hegelDir, "dist", "index.js")));
+const gs = await import(pathToFileURL(join(hegelDir, "dist", "generators", "index.js")));
+
+export const collecting = !!process.env.ZOO_COLLECT;
+
+class Collected extends Error {}
+
+let msgs = [];
+let stats = new Map();
+
+/** Report a mismatch: an error normally, a recorded line in collect mode. */
+export function fail(message) {
+  if (collecting) {
+    msgs.push(message);
+    throw new Collected(message);
+  }
+  throw new Error(message);
+}
+
+/** Bump a statistic (the shape of a pinned bug, a generator branch). */
+export function count(key) {
+  stats.set(key, (stats.get(key) || 0) + 1);
+}
+
+function settings() {
+  const s = { testCases: Number(process.env.HEGEL_TEST_CASES) || 100 };
+  if (process.env.HEGEL_DATABASE) {
+    s.database = hegel.Database.fromPath(process.env.HEGEL_DATABASE);
+  }
+  return s;
+}
+
+/** A property: `body(tc)` runs under Hegel; a thrown error (or `fail`) is a failure. */
+export function property(name, body) {
+  nodeTest(name, () => {
+    msgs = [];
+    stats = new Map();
+    hegel.test((tc) => {
+      try {
+        body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** An async property: `body(tc)` may await; runs under Hegel's testAsync with the same settings. */
+export function propertyAsync(name, body) {
+  nodeTest(name, async () => {
+    msgs = [];
+    stats = new Map();
+    await hegel.testAsync(async (tc) => {
+      try {
+        await body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** A pin: a plain test for one recorded bug. */
+export function pin(name, body) {
+  nodeTest(name, body);
+}
+
+/** An integer in [lo, hi]. */
+export function n(tc, lo, hi) {
+  return tc.draw(gs.integers({ minValue: lo, maxValue: hi }));
+}
+
+/** One of xs. */
+export function pick(tc, xs) {
+  return xs[n(tc, 0, xs.length - 1)];
+}
+
+/** True pct percent of the time. */
+export function chance(tc, pct) {
+  return n(tc, 0, 99) < pct;
+}
+
+/** A string of `len` characters drawn from `alphabet` (an array of strings). */
+export function word(tc, alphabet, lo, hi) {
+  const len = n(tc, lo, hi);
+  let s = "";
+  for (let i = 0; i < len; i++) {
+    s += pick(tc, alphabet);
+  }
+  return s;
+}
+
+/** Structural equality: arrays by position, objects by key set (prototype ignored), else ===. */
+export function same(a, b) {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) {
+      return false;
+    }
+    return a.every((x, i) => same(x, b[i]));
+  }
+  if (a !== null && b !== null && typeof a === "object" && typeof b === "object") {
+    const ka = Object.keys(a).sort();
+    const kb = Object.keys(b).sort();
+    if (ka.length !== kb.length || ka.some((k, i) => k !== kb[i])) {
+      return false;
+    }
+    return ka.every((k) => same(a[k], b[k]));
+  }
+  return a === b;
+}
+
+/** A compact, unambiguous rendering for messages. */
+export function show(x) {
+  return JSON.stringify(x, (k, v) => (v === undefined ? "<undefined>" : v));
+}
diff --git a/hegel/hegel.test.mjs b/hegel/hegel.test.mjs
new file mode 100644
index 0000000..7141011
--- /dev/null
+++ b/hegel/hegel.test.mjs
@@ -0,0 +1,1058 @@
+// Hegel zoo: property tests for yaml (eemeli/yaml) against a randomised YAML writer, the previous
+// stable release (yaml@2) as a second implementation, the language itself for round trips, and a
+// naive model of the Document API. Run: node --test hegel/hegel.test.mjs. ZOO_COLLECT=1 prints
+// mismatch statistics; ZOO_FULL=1 opens the gates around the recorded bugs.
+
+import { readdirSync, readFileSync, writeFileSync } from "node:fs";
+
+const TRACE = process.env.ZOO_TRACE;
+function trace(label, s) {
+  if (TRACE) writeFileSync(TRACE, label + "\n" + s);
+}
+import { dirname, join } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+import { Worker } from "node:worker_threads";
+
+import * as Y from "./yaml3.mjs";
+import * as Y2 from "../.hegel/node_modules/yaml/dist/index.js";
+import { testEvents } from "./test-events.mjs";
+import { chance, count, fail, n, pick, pin, property } from "./hegel-zoo.mjs";
+import { deepEqual, FULL, genKey, genOptions, genScalarValue, genValue, showValue } from "./gen.mjs";
+import { genString, genTree, STRING_POOL, treeToValue, writeDocument } from "./writer.mjs";
+
+const here = dirname(fileURLToPath(import.meta.url));
+
+function errorsOf(docs) {
+  const out = [];
+  for (const d of docs) for (const e of d.errors) out.push(e);
+  return out;
+}
+
+/** A CR not followed by LF, or U+2028/U+2029: the recorded lexer hang (an infinite loop, so gated before lex runs). */
+function loneTerminator(s) {
+  return /\r(?!\n)|[\u2028\u2029]/.test(s);
+}
+
+/** A string with a whitespace-only line (or all whitespace): the recorded block-scalar shape. */
+/** Whether the value is a string starting with U+FEFF, or has a key starting with one, anywhere (yaml/31: at the stream start it is read as a byte order mark). */
+function hasBomStart(v) {
+  if (typeof v === "string") return v.startsWith("\ufeff");
+  if (Array.isArray(v)) return v.some(hasBomStart);
+  if (v instanceof Map) return [...v.entries()].some(([k, x]) => hasBomStart(k) || hasBomStart(x));
+  if (v instanceof Set) return [...v].some(hasBomStart);
+  if (v && typeof v === "object" && !(v instanceof Date) && !(v instanceof Uint8Array)) return Object.entries(v).some(([k, x]) => k.startsWith("\ufeff") || hasBomStart(x));
+  return false;
+}
+
+function hasBlankLine(v) {
+  if (typeof v === "string") return /(^|\n)[ \t]+(\n|$)/.test(v);
+  if (Array.isArray(v)) return v.some(hasBlankLine);
+  if (v instanceof Map) return [...v.values()].some(hasBlankLine) || [...v.keys()].some(hasBlankLine);
+  if (v instanceof Set) return [...v].some(hasBlankLine);
+  if (v && typeof v === "object" && !(v instanceof Date) && !(v instanceof Uint8Array)) return Object.values(v).some(hasBlankLine);
+  return false;
+}
+
+function shortText(s) {
+  return JSON.stringify(s.length > 300 ? s.slice(0, 300) + "..." : s);
+}
+
+// ---------------------------------------------------------------- the writer's documents
+
+property("TestHegelWrittenDocumentsParseToTheirTree", (tc) => {
+  const tree = genTree(tc);
+  const expected = treeToValue(tree);
+  const { text, style } = writeDocument(tc, tree);
+  trace("written", text);
+  for (const s of style) count("style:" + s);
+  const docs = Y.parseAllDocuments(text);
+  if (!Array.isArray(docs) || docs.length !== 1) fail(`expected one document, got ${Array.isArray(docs) ? docs.length : "an empty stream"} for ${shortText(text)}`);
+  const errors = errorsOf(docs);
+  if (errors.length > 0) fail(`errors for ${shortText(text)}: ${errors.map((e) => e.message).join("; ")}`);
+  const warnings = docs[0].warnings;
+  if (warnings.length > 0) fail(`warnings for ${shortText(text)}: ${warnings.map((e) => e.message).join("; ")}`);
+  const got = docs[0].toJS();
+  if (!deepEqual(got, expected)) fail(`parse mismatch for ${shortText(text)}\n  got      ${showValue(got)}\n  expected ${showValue(expected)}`);
+  const got2 = Y.parse(text);
+  if (!deepEqual(got2, expected)) fail(`parse() differs from parseAllDocuments for ${shortText(text)}: ${showValue(got2)}`);
+  // yaml@2 reads the same thing
+  const v2 = Y2.parseAllDocuments(text);
+  const e2 = errorsOf(v2);
+  if (e2.length > 0) { count("v2-errors"); return; }
+  const got3 = v2[0].toJS();
+  if (!deepEqual(got3, expected)) { count("v2-differs"); return; }
+  // recorded shape: a negative zero in exponential notation is written without its sign
+  if (/-0\.0[eE]\+0/.test(text) && !FULL) { count("negative-zero-exponential"); return; }
+  // stringify and re-parse gives the same value, in v3 and in v2
+  const out = docs[0].toString();
+  const back = Y.parseAllDocuments(out);
+  const eb = errorsOf(back);
+  if (eb.length > 0) fail(`toString() output has errors for ${shortText(text)} -> ${shortText(out)}: ${eb.map((e) => e.message).join("; ")}`);
+  const gotBack = back[0].toJS();
+  if (!deepEqual(gotBack, expected)) fail(`toString() round trip mismatch for ${shortText(text)} -> ${shortText(out)}\n  got      ${showValue(gotBack)}\n  expected ${showValue(expected)}`);
+  const back2 = Y2.parse(out);
+  if (!deepEqual(back2, expected)) fail(`yaml@2 reads v3 toString() output differently for ${shortText(out)}\n  got      ${showValue(back2)}\n  expected ${showValue(expected)}`);
+});
+
+// ---------------------------------------------------------------- any source: lossless CST, no throw
+
+const HOSTILE = [
+  ..."abcxyzAZ09 -_.:,#?!&*|>'\"%@`[]{}\\~=<+/$;()", "\t", "\n", "\r", "\r\n", " ", " ", "　",
+  "\x85", "\ufeff", "\x7f", "\x1b", "é", "一", "😀", "\ud800", "---", "...", "--- ", "\n---\n", "\n...\n", "%YAML 1.2\n", "%TAG ! tag:x,2000:\n",
+  "&a ", "*a", "!!str ", "!x ", "! ", "|", ">", "|-", ">+", "|2", "? ", ": ", "- ", "# ", "\n  ", "\n    ", "\n\t", "'", "''", '"', '\\"', "\\x41", "\\u00e9", "\\U0001F600", "\\N", "\\_", "\\L", "\\P", "\\\n", "<<: ", "=: ", "[]", "{}", "[ ", "{ ", ", ", "]", "}",
+];
+
+function mutate(tc, text) {
+  let s = text;
+  const k = n(tc, 1, 4);
+  for (let i = 0; i < k; i++) {
+    const at = n(tc, 0, s.length);
+    const r = n(tc, 1, 3);
+    if (r === 1) s = s.slice(0, at) + pick(tc, HOSTILE) + s.slice(at);
+    else if (r === 2 && s.length > 0) s = s.slice(0, at) + s.slice(Math.min(s.length, at + n(tc, 1, 3)));
+    else s = s.slice(0, at) + pick(tc, HOSTILE) + s.slice(Math.min(s.length, at + 1));
+  }
+  return s;
+}
+
+function genSource(tc) {
+  const r = n(tc, 1, 10);
+  if (r <= 4) { count("source:written"); return writeDocument(tc, genTree(tc)).text; }
+  if (r <= 8) { count("source:mutated"); return mutate(tc, writeDocument(tc, genTree(tc)).text); }
+  count("source:hostile");
+  let s = "";
+  const len = n(tc, 0, 12);
+  for (let i = 0; i < len; i++) s += chance(tc, 30) ? genString(tc) : pick(tc, HOSTILE);
+  return s;
+}
+
+property("TestHegelLexerAndCstAreLosslessAndParsingNeverThrows", (tc) => {
+  const text = genSource(tc);
+  trace("cst", text);
+  if (loneTerminator(text)) { count("lone-line-terminator"); if (!FULL) return; }
+  let lexed;
+  try {
+    lexed = Y.lex(text);
+  } catch (e) {
+    fail(`lex threw for ${shortText(text)}: ${e.message}`);
+  }
+  if (!Array.isArray(lexed) || lexed.some((t) => typeof t !== "string")) fail(`lex did not return strings for ${shortText(text)}`);
+  // the lexer marks document starts, flow ends and scalars with C0 control characters (CST.DOCUMENT, FLOW_END, SCALAR)
