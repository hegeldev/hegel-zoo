diff --git a/hegel/gen.mjs b/hegel/gen.mjs
new file mode 100644
index 0000000..17aeefd
--- /dev/null
+++ b/hegel/gen.mjs
@@ -0,0 +1,264 @@
+// Hegel zoo: the generators behind the yaml properties, as values built from Hegel's
+// combinators - strings, numbers, keys and dates; the JS values `stringify` is given (plain
+// objects, arrays, Map/Set, Dates, bytes, BigInt, by a `mode` record) and the stringify options
+// drawn as a record whose absent fields are dropped - plus the value comparison and rendering
+// helpers the properties share. Nothing here draws from a TestCase: every generator is a value.
+
+import { gs } from "./hegel-zoo.mjs";
+
+export const FULL = !!process.env.ZOO_FULL;
+
+// ---------------------------------------------------------------- generator helpers
+
+export const ints = (lo, hi) => gs.integers({ minValue: lo, maxValue: hi });
+
+/** oneOf with weights: `weighted([45, a], [55, b])` draws a 45 times in 100; shrinks towards the first choice. */
+export function weighted(...choices) {
+  if (choices.length === 1) return choices[0][1];
+  const total = choices.reduce((sum, [w]) => sum + w, 0);
+  return ints(0, total - 1).flatMap((r) => {
+    for (const [w, g] of choices) {
+      if (r < w) return g;
+      r -= w;
+    }
+    throw new Error("unreachable");
+  });
+}
+
+/** True pct percent of the time; shrinks to false. */
+export const chance = (pct) => ints(0, 99).map((r) => r >= 100 - pct);
+/** A draw from g pct percent of the time, else undefined (listed first: shrinks to absent). */
+export const maybe = (pct, g) => weighted([100 - pct, gs.just(undefined)], [pct, g]);
+/** The record without its undefined fields (the `maybe`s that came out absent). */
+export const dropUndefined = (o) => Object.fromEntries(Object.entries(o).filter(([, v]) => v !== undefined));
+
+// ---------------------------------------------------------------- strings
+
+export const STRING_POOL = [
+  "", " ", "a", "x y", "a: b", "a:b", "- x", "? x", "# c", "x #y", "x#y", ": x", "key:", "yes", "no", "on", "off", "y", "n",
+  "true", "false", "null", "~", "Null", "1", "-1", "+1", "0", "00", "017", "0x1f", "0o17", "0b11", "1_000", "1.5", ".5", "5.", "1e3",
+  "1.0e+3", ".inf", "-.inf", ".nan", "1:30", "12:30:45", "2001-12-14", "2001-12-14t21:59:43.10-05:00", "2001-12-14 21:59:43.10 -5",
+  "<<", "=", "---", "...", "--- x", "... x", "-", "?", ":", ",", "[", "]", "{", "}", "&a", "*a", "!x", "|", ">", "%x", "@x", "`x",
+  "'q'", "\"q\"", "\\", "a\\b", "a\nb", "a\n\nb", "a\n", "\na", "a\n\n", "  a", "a  ", "a\tb", "\t", "\u{e9}", "\u{4e00}", "\u{1f600}",
+  "\x85", "\xa0", "\u{2028}", "\u{feff}", "\x00", "\x1b", "\x7f", "a\rb", "0.5.2", "1__0", "1.e3", "-.5", "+.5", "._5",
+  "a b c d e f g", "line one\nline two\nline three", "trailing space \nnext", "x".repeat(200), "w ".repeat(50).trim(),
+  "a\n b", " a\nb", "a \nb", "\n\n", "a\r\nb", "\r", "x\x85y", "\u{3000}", "\x07", "---\na", "a\n---", "a\n...", "a\n#b",
+  "a\n- b", "a\nb: c", "0123456789".repeat(20), "word ".repeat(30), "a".repeat(1100),
+];
+
+/** 1-6 lower-case letters. */
+export const word = gs.text({ alphabet: "abcdefghijklmnopqrstuvwxyz", minSize: 1, maxSize: 6 });
+const PUNCTUATION = ["-", ":", "#", ",", "[", "]", "{", "}", "?", "!", "&", "*", "|", ">", "'", "\"", "%", "@", "`", "\\", "/", ".", "_", "=", "<<"];
+const NON_ASCII = ["\u{e9}", "\u{4e00}", "\u{1f600}", "\xa0", "\x85", "\u{2028}"];
+/** A piece of a composed string: a word half the time, else a number, whitespace, YAML punctuation, a non-ASCII character or a separator. */
+const piece = weighted(
+  [50, word],
+  [17, ints(0, 999).map(String)],
+  [8, gs.sampledFrom([" ", "  ", "\n", "\n\n", "\t"])],
+  [8, gs.sampledFrom(PUNCTUATION)],
+  [8, gs.sampledFrom(NON_ASCII)],
+  [9, gs.sampledFrom([" ", "-", ":", " "])],
+);
+/** A string: one of the pool 45% of the time (first: shrinks to ""), else 1-5 pieces joined by nothing, a space, a dash or a colon. */
+export const text = weighted(
+  [45, gs.sampledFrom(STRING_POOL)],
+  [55, gs.tuples(gs.arrays(piece, { minSize: 1, maxSize: 5 }), gs.sampledFrom(["", "", " ", "-", ":"])).map(([parts, sep]) => parts.join(sep))],
+);
+
+// ---------------------------------------------------------------- numbers, dates, keys
+
+const TWO53 = 2 ** 53;
+const INT_EDGES = [0, 1, -1, 255, 256, 65535, 2147483647, -2147483648, 4294967295, TWO53 - 1, -(TWO53 - 1)];
+/** An integer: -100..100 40% of the time, within a million 30, an edge 10, else within 10^12. */
+export const int = weighted([40, ints(-100, 100)], [30, ints(-1000000, 1000000)], [10, gs.sampledFrom(INT_EDGES)], [20, ints(-999999999999, 999999999999)]);
+
+const FLOAT_EDGES = [0.1, 0.5, 1.5, -2.5, 1e-7, 1e21, 1e300, 5e-324, 123456.789, -0.0, 0.0];
+/**
+ * A float: a small fraction 30% of the time, a special value 20, an infinity or NaN 20, a mantissa
+ * times a power of ten 10, else 1-999 with three decimals. With `finite`, no infinity, NaN or -0
+ * (the JSON schema writes them as null and 0, like JSON.stringify: not judged).
+ */
+export const floatOf = ({ finite = false } = {}) =>
+  weighted(
+    [30, gs.tuples(ints(-1000, 1000), gs.sampledFrom([2, 4, 8, 10, 100])).map(([a, d]) => a / d)],
+    [20, gs.sampledFrom(finite ? FLOAT_EDGES.filter((x) => !Object.is(x, -0)) : FLOAT_EDGES)],
+    ...(finite ? [] : [[20, gs.sampledFrom([Infinity, -Infinity, NaN])]]),
+    [10, gs.tuples(ints(-1000000, 1000000), ints(-12, 12)).map(([m, e]) => m * 10 ** e)],
+    [20, gs.tuples(ints(1, 999), ints(0, 999)).map(([a, b]) => a + b / 1000)],
+  );
+export const float = floatOf();
+
+/**
+ * A float that does not read back as an integer under intAsBigInt: an integral value written in
+ * plain digits (every double below 10^21 with no fraction, 0.0 and -0.0 too) would come back as a
+ * BigInt, so it gains a half when the doubles are that fine (below 2^52) and is folded below a
+ * million (where they are) otherwise; values written in exponent notation and the non-finite ones
+ * stay as they are.
+ */
+export const nonIntegral = (x) => (!Number.isInteger(x) || /e/.test(String(x)) ? x : Math.abs(x) < 2 ** 52 ? x + 0.5 : (x % 1000000) + 0.5);
+
+const DATE_EDGES = [0, 1e12, -1e12, 951782400000, 253402300799000, -62135596800000, 1234567890123];
+/** A Date: a whole second between 1900 and 2100 (with milliseconds half the time) 5 times in 6, else an edge (the epoch, the year 1, 9999). */
+export const date = weighted(
+  [5, gs.record({ s: ints(-2208988800, 4102444800), ms: maybe(50, ints(0, 999)) }).map(({ s, ms }) => new Date(s * 1000 + (ms ?? 0)))],
+  [1, gs.sampledFrom(DATE_EDGES).map((t) => new Date(t))],
+);
+
+/** A mapping key: 1-6 letters with a number after them 30% of the time, 60% of the time; else one of the strings `strings` cut to 200 characters. */
+export const keyOf = (strings) => weighted([60, gs.tuples(word, maybe(30, ints(0, 99))).map(([w, d]) => w + (d ?? ""))], [40, strings.map((s) => s.slice(0, 200))]);
+export const key = keyOf(text);
+
+// ---------------------------------------------------------------- JS values for stringify
+
+/**
+ * What a stringify case may hold: Map and Set (with `mapAsMap`) 25% of the time (Sets 40% of
+ * those), Dates 20, bytes 15, BigInt 15. A mode may also ask for `finite` numbers only (no
+ * infinity, NaN or -0) and name the string generator its strings and keys come from (`text`).
+ */
+export const mode = gs.record({ maps: chance(25), dates: chance(20), bytes: chance(15), bigint: chance(15), sets: chance(40) }).map((m) => ({ ...m, sets: m.maps && m.sets }));
+
+/**
+ * A scalar value: null 2 times in 24, a boolean 2, an integer 4 (a BigInt with `bigint`: every
+ * integer reads back as one under intAsBigInt), a float 3 (made non-integral with `bigint`, see
+ * `nonIntegral`), a Date 1 (with `dates`), up to 40 bytes 1 (with `bytes`), a BigInt beyond 2^53 1
+ * (with `bigint`); a string (from `m.text`, default `text`) otherwise.
+ */
+export function scalarValue(m = {}) {
+  const f = floatOf(m);
+  const str = m.text ?? text;
+  return weighted(
+    [2, gs.just(null)],
+    [2, gs.booleans()],
+    [4, m.bigint ? int.map(BigInt) : int],
+    [3, m.bigint ? f.map(nonIntegral) : f],
+    [1, m.dates ? date : str],
+    [1, m.bytes ? gs.binary({ maxSize: 40 }) : str],
+    [1, m.bigint ? gs.tuples(int, chance(30)).map(([v, big]) => BigInt(v) * (big ? 1000000007n : 1n)) : str],
+    [10, str],
+  );
+}
+
+/**
+ * One nesting level over `below` (the values one level down; null at the leaves): a scalar, an
+ * array of up to 5, an object of up to 5 distinct keys, or with `maps` a Map of up to 4 (keys a key
+ * 60% of the time, else a scalar whose strings come from `m.keyText`, default `m.text`) and with
+ * `sets` a Set of up to 4 scalars.
+ */
+function valueLevel(m, below) {
+  const scalar = scalarValue(m);
+  if (below === null) return scalar;
+  const array = gs.arrays(below, { maxSize: 5 });
+  const objectKey = keyOf(m.text ?? text);
+  if (!m.maps) {
+    const object = gs.maps(objectKey, below, { maxSize: 5 }).map((entries) => Object.fromEntries(entries));
+    return weighted([56, scalar], [22, array], [22, object]);
+  }
+  const map = gs.maps(weighted([60, objectKey], [40, scalarValue({ ...m, text: m.keyText ?? m.text })]), below, { maxSize: 4 });
+  if (!m.sets) return weighted([28, scalar], [22, array], [50, map]);
+  return weighted([24, scalar], [22, array], [50, map], [4, gs.sets(scalar, { maxSize: 4 })]);
+}
+
+/** A JS value for stringify in mode `m`, containers nested `levels` deep. */
+export function valueOf(m = {}, levels = 3) {
+  let g = null;
+  for (let d = 0; d <= levels; d++) g = valueLevel(m, g);
+  return g;
+}
+
+// ---------------------------------------------------------------- options
+
+export const SCALAR_TYPES = ["PLAIN", "QUOTE_DOUBLE", "QUOTE_SINGLE", "BLOCK_LITERAL", "BLOCK_FOLDED"];
+
+/**
+ * ToStringOptions + DocumentOptions + SchemaOptions as one object, as the API takes them: the
+ * schema core half the time, yaml-1.1 or json a sixth each (yaml-1.1 always with Dates, bytes or
+ * Sets: !!timestamp, !!binary and !!set are YAML 1.1 tags; never failsafe, which reads every scalar
+ * as a string), `version: "1.1"` half the time under yaml-1.1, every other option set 30% of the
+ * time, `mapAsMap` with Maps and `intAsBigInt` with BigInts.
+ */
+export const optionsOf = (m) => {
+  const schema = m.dates || m.bytes || m.sets ? gs.just("yaml-1.1") : gs.sampledFrom(["core", "core", "core", "yaml-1.1", "json"]);
+  return schema.flatMap((schema) =>
+    gs.record({
+      schema: gs.just(schema),
+      version: schema === "yaml-1.1" ? maybe(50, gs.just("1.1")) : gs.just(undefined),
+      blockQuote: maybe(30, gs.sampledFrom([true, false, "folded", "literal"])),
+      collectionStyle: maybe(30, gs.sampledFrom(["any", "block", "flow"])),
+      defaultKeyType: maybe(30, gs.sampledFrom([null, ...SCALAR_TYPES])),
+      defaultStringType: maybe(30, gs.sampledFrom(SCALAR_TYPES)),
+      doubleQuotedAsJSON: maybe(30, gs.booleans()),
+      doubleQuotedMinMultiLineLength: maybe(30, ints(0, 60)),
+      flowCollectionPadding: maybe(30, gs.booleans()),
+      indent: maybe(30, ints(1, 6)),
+      indentSeq: maybe(30, gs.booleans()),
+      lineWidth: maybe(30, gs.sampledFrom([0, 10, 20, 40, 80, 200])),
+      minContentWidth: maybe(30, gs.sampledFrom([0, 5, 20, 40])),
+      simpleKeys: maybe(30, gs.booleans()),
+      singleQuote: maybe(30, gs.sampledFrom([null, true, false])),
+      sortMapEntries: maybe(30, gs.booleans()),
+      trailingComma: maybe(30, gs.booleans()),
+      directives: maybe(30, gs.sampledFrom([null, true, false])),
+      nullStr: maybe(30, gs.sampledFrom(["null", "~", "Null", ""])),
+      trueStr: maybe(30, gs.sampledFrom(["true", "True", "TRUE"])),
+      falseStr: maybe(30, gs.sampledFrom(["false", "False", "FALSE"])),
+      aliasDuplicateObjects: maybe(30, gs.booleans()),
+      anchorPrefix: maybe(30, gs.sampledFrom(["a", "x", "anchor"])),
+      mapAsMap: gs.just(m.maps ? true : undefined),
+      intAsBigInt: gs.just(m.bigint ? true : undefined),
+      keepUndefined: maybe(30, gs.booleans()),
+    }),
+  ).map(dropUndefined);
+};
+
+// ---------------------------------------------------------------- comparison
+
+/** Deep equality: Map/Set/Date/Uint8Array aware, NaN equal to NaN, -0 distinct from 0, bigint. */
+export function deepEqual(a, b, seen = new Map()) {
+  if (Object.is(a, b)) return true;
+  if (typeof a !== "object" || typeof b !== "object" || a === null || b === null) return false;
+  if (seen.get(a) === b) return true;
+  seen.set(a, b);
+  if (a instanceof Date || b instanceof Date) {
+    return a instanceof Date && b instanceof Date && Object.is(a.getTime(), b.getTime());
+  }
+  if (a instanceof Uint8Array || b instanceof Uint8Array) {
+    return a instanceof Uint8Array && b instanceof Uint8Array && a.length === b.length && a.every((x, i) => x === b[i]);
+  }
+  if (Array.isArray(a) || Array.isArray(b)) {
+    return Array.isArray(a) && Array.isArray(b) && a.length === b.length && a.every((x, i) => deepEqual(x, b[i], seen));
+  }
+  if (a instanceof Set || b instanceof Set) {
+    if (!(a instanceof Set && b instanceof Set) || a.size !== b.size) return false;
+    const bs = [...b];
+    return [...a].every((x) => bs.some((y) => deepEqual(x, y, new Map(seen))));
+  }
+  if (a instanceof Map || b instanceof Map) {
+    if (!(a instanceof Map && b instanceof Map) || a.size !== b.size) return false;
+    const bs = [...b];
+    return [...a].every(([k, x]) => bs.some(([l, y]) => deepEqual(k, l, new Map(seen)) && deepEqual(x, y, seen)));
+  }
+  const ka = Object.keys(a).sort();
+  const kb = Object.keys(b).sort();
+  if (ka.length !== kb.length || ka.some((k, i) => k !== kb[i])) return false;
+  return ka.every((k) => deepEqual(a[k], b[k], seen));
+}
+
+/** A rendering of a value for messages (Map/Set/Date/bytes/NaN/-0/bigint made visible). */
+export function showValue(v) {
+  const seen = new WeakSet();
+  return JSON.stringify(v, function (k, x) {
+    if (x && typeof x === "object") {
+      if (seen.has(x)) return "<cycle>";
+      seen.add(x);
+    }
+    if (typeof x === "number" && !Number.isFinite(x)) return `<${String(x)}>`;
+    if (Object.is(x, -0)) return "<-0>";
+    if (typeof x === "bigint") return `<${x}n>`;
+    if (x === undefined) return "<undefined>";
+    if (x instanceof Map) return { $map: [...x] };
+    if (x instanceof Set) return { $set: [...x] };
+    if (x instanceof Uint8Array) return { $bytes: [...x] };
+    if (x instanceof Date) return { $date: Number.isNaN(x.getTime()) ? "invalid" : x.toISOString() };
+    return x;
+  });
+}
diff --git a/hegel/hegel-zoo.mjs b/hegel/hegel-zoo.mjs
new file mode 100644
index 0000000..8b4d5bf
--- /dev/null
+++ b/hegel/hegel-zoo.mjs
@@ -0,0 +1,149 @@
+// Hegel zoo: the small harness shared by the zoo's TypeScript/JavaScript targets.
+//
+// `property(name, body)` registers a node:test test that runs `body(tc)` under Hegel with
+// HEGEL_TEST_CASES cases (default 100) and the database at HEGEL_DATABASE. With ZOO_COLLECT=1
+// a `fail()` records the mismatch instead of failing, the case ends there, and the counts of
+// mismatches and of the shapes seen (`count(key)`) are printed at the end of the test, so a
+// property can be run over many cases to see every shape at once. `pin(name, body)` is a
+// plain test for one pinned bug: it must fail while the bug is present and pass once it is
+// fixed (the zoo's judge reads an unexpected pass as "fixed upstream?").
+
+import { readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+import { test as nodeTest } from "node:test";
+
+// The Hegel version these tests were written against (the zoo pins it in zoo.toml; upstream
+// would add it to devDependencies). Hegel and esbuild are installed with `npm install --prefix
+// .hegel` so the target's own package.json and lock file stay untouched. Checked at load time so
+// a stray install cannot silently change the engine.
+export const HEGEL_PIN = { "@hegeldev/hegel": "0.4.5" };
+
+const hegelDir = join(dirname(fileURLToPath(import.meta.url)), "..", ".hegel", "node_modules", "@hegeldev", "hegel");
+{
+  const installed = JSON.parse(readFileSync(join(hegelDir, "package.json"), "utf8")).version;
+  if (installed !== HEGEL_PIN["@hegeldev/hegel"]) {
+    throw new Error(`@hegeldev/hegel ${installed} is installed; these tests pin ${HEGEL_PIN["@hegeldev/hegel"]}`);
+  }
+}
+const hegel = await import(pathToFileURL(join(hegelDir, "dist", "index.js")));
+const gs = await import(pathToFileURL(join(hegelDir, "dist", "generators", "index.js")));
+
+/** Hegel's generators, re-exported so the tests import everything from one place. */
+export { gs };
+
+export const collecting = !!process.env.ZOO_COLLECT;
+
+class Collected extends Error {}
+
+let msgs = [];
+let stats = new Map();
+
+/** Report a mismatch: an error normally, a recorded line in collect mode. */
+export function fail(message) {
+  if (collecting) {
+    msgs.push(message);
+    throw new Collected(message);
+  }
+  throw new Error(message);
+}
+
+/** Bump a statistic (the shape of a pinned bug, a generator branch). */
+export function count(key) {
+  stats.set(key, (stats.get(key) || 0) + 1);
+}
+
+function settings() {
+  const s = { testCases: Number(process.env.HEGEL_TEST_CASES) || 100 };
+  if (process.env.HEGEL_DATABASE) {
+    s.database = hegel.Database.fromPath(process.env.HEGEL_DATABASE);
+  }
+  return s;
+}
+
+// Hegel keys its example database by the test function's source text. Every property here runs
+// through the same wrapper, so without this every property would share one key and replay the
+// stored failing examples of all the others; the key is the test's name instead.
+function keyed(name, fn) {
+  fn.toString = () => name;
+  return fn;
+}
+
+/** A property: `body(tc)` runs under Hegel; a thrown error (or `fail`) is a failure. */
+export function property(name, body) {
+  nodeTest(name, () => {
+    msgs = [];
+    stats = new Map();
+    hegel.test(keyed(name, (tc) => {
+      try {
+        body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }), settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** An async property: `body(tc)` may await; runs under Hegel's testAsync with the same settings. */
+export function propertyAsync(name, body) {
+  nodeTest(name, async () => {
+    msgs = [];
+    stats = new Map();
+    await hegel.testAsync(keyed(name, async (tc) => {
+      try {
+        await body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }), settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** A pin: a plain test for one recorded bug. */
+export function pin(name, body) {
+  nodeTest(name, body);
+}
+
+/** Structural equality: arrays by position, objects by key set (prototype ignored), else ===. */
+export function same(a, b) {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) {
+      return false;
+    }
+    return a.every((x, i) => same(x, b[i]));
+  }
+  if (a !== null && b !== null && typeof a === "object" && typeof b === "object") {
+    const ka = Object.keys(a).sort();
+    const kb = Object.keys(b).sort();
+    if (ka.length !== kb.length || ka.some((k, i) => k !== kb[i])) {
+      return false;
+    }
+    return ka.every((k) => same(a[k], b[k]));
+  }
+  return a === b;
+}
+
+/** A compact, unambiguous rendering for messages. */
+export function show(x) {
+  return JSON.stringify(x, (k, v) => (v === undefined ? "<undefined>" : v));
+}
diff --git a/hegel/hegel.test.mjs b/hegel/hegel.test.mjs
new file mode 100644
index 0000000..ee4129f
--- /dev/null
+++ b/hegel/hegel.test.mjs
@@ -0,0 +1,1328 @@
+// Hegel zoo: property tests for yaml (eemeli/yaml) against a randomised YAML writer, the previous
+// stable release (yaml@2) as a second implementation, the language itself for round trips, and a
+// naive model of the Document API. Run: node --test hegel/hegel.test.mjs. ZOO_COLLECT=1 prints
+// mismatch statistics; ZOO_FULL=1 opens the gates around the recorded bugs. Each property draws
+// one case record (see gen.mjs and writer.mjs for the generators) and renders it with pure
+// functions; an edit or operation list is applied with positions taken modulo the live size.
+
+import { readdirSync, readFileSync, writeFileSync } from "node:fs";
+
+const TRACE = process.env.ZOO_TRACE;
+function trace(label, s) {
+  if (TRACE) writeFileSync(TRACE, label + "\n" + s);
+}
+import { dirname, join } from "node:path";
