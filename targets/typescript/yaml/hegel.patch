+    if (doc.errors.length === 0) throw new Error(`${JSON.stringify(src)} parses without an error (toJS then throws a ReferenceError)`);
+  }
+});
+
+// yaml/26
+pin("TestHegelPinCstHasNoInternalMarkers", () => {
+  for (const src of ["- '{'[ x\n", "k: '{'[ x\n...\n", "- a\n- '{'[ x: 1\n...\n"]) {
