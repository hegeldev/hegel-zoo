+    assertEq(out, src, `CST of ${JSON.stringify(src)}`);
+  }
+});
+
+// yaml/27
+pin("TestHegelPinBlockScalarIndicatorFollowsTheIndentOption", () => {
+  for (const [v, o] of [[{ a: "  x\n" }, { indent: 4 }], [{ a: { b: "  x\ny\n" } }, { indent: 3 }]]) {
+    const text = Y.stringify(v, o);
+    assertEq(Y.parse(text, o), v, `parse(stringify(${showValue(v)}, ${JSON.stringify(o)})) via ${JSON.stringify(text)}`);
+  }
+});
+
+// yaml/28
+pin("TestHegelPinTimestampsBeforeTheYear100KeepTheirYear", () => {
+  for (const [src, year] of [["0001-01-01", 1], ["0099-12-31T23:59:59Z", 99], ["0000-01-01", 0]]) {
+    const d = Y.parse(src, { schema: "yaml-1.1" });
+    if (!(d instanceof Date)) throw new Error(`${src} is not a timestamp: ${showValue(d)}`);
+    if (d.getUTCFullYear() !== year) throw new Error(`${src} parses to ${d.toISOString()}, year ${d.getUTCFullYear()} instead of ${year}`);
+  }
+});
+
+// yaml/29
+pin("TestHegelPinEmptyBinaryStringifiesWithUnlimitedLineWidth", () => {
+  for (const o of [{ schema: "yaml-1.1", lineWidth: 0, minContentWidth: 0 }, { schema: "yaml-1.1", lineWidth: 0, minContentWidth: 0, indent: 1 }]) {
+    let text;
+    try {
+      text = Y.stringify(new Uint8Array([]), o);
+    } catch (e) {
+      throw new Error(`stringify(new Uint8Array([]), ${JSON.stringify(o)}) threw: ${e.message}`);
+    }
+    const back = Y.parse(text, o);
+    if (!(back instanceof Uint8Array) || back.length !== 0) throw new Error(`${JSON.stringify(text)} reads back as ${showValue(back)}`);
+  }
+});
+
+// yaml/30
+pin("TestHegelPinAMarkerLikePlainScalarAfterTheDocumentStartIsAScalar", () => {
+  assertEq(Y.parseAllDocuments("--- ---\n").map((d) => d.toJS()), ["---"], "documents of --- ---");
+  assertEq(Y.parseAllDocuments("--- ...\n").map((d) => d.toJS()), ["..."], "documents of --- ...");
+  assertEq(Y.parseAllDocuments("--- --- x\n").map((d) => d.toJS()), ["--- x"], "documents of --- --- x");
