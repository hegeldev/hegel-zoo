diff --git a/hegel/writer.mjs b/hegel/writer.mjs
new file mode 100644
index 0000000..ec69bfd
--- /dev/null
+++ b/hegel/writer.mjs
@@ -0,0 +1,511 @@
+// Hegel zoo: a randomised YAML writer (adapted from the js-yaml target's). A tree of plain
+// values is drawn with the style of every node beside its value - how a scalar is spelled
+// (plain, single- or double-quoted with its escape choices, literal or folded with chomping and
+// indentation indicators), its node properties (an anchor, the matching `!!` tag), how a
+// collection entry sits on its lines (block or flow, compact, explicit key, indentless, comments,
+// blank lines), how a flow collection is spaced, and how the document is framed (markers, a
+// `%YAML` directive, comments, an indented root) - and `writeDocument` renders the tree in its
+// style as text without drawing, staying inside what YAML 1.2 core and YAML 1.1 readers agree
+// on, so that the reader must return exactly the tree. Plain-safety of a string is decided with
+// yaml@2 under both schemas, never with the target.
+
+import * as Y2 from "../.hegel/node_modules/yaml/dist/index.js";
+import { gs } from "./hegel-zoo.mjs";
+import { chance, float, int, ints, maybe, text, weighted, word } from "./gen.mjs";
+
+/** A tree node of kind `kind` with the given fields. */
+const node = (kind, fields) => gs.record({ kind: gs.just(kind), ...fields });
+
+// ---------------------------------------------------------------- scalars and their styles
+
+const NULLS = ["null", "null", "Null", "NULL", "~"];
+const TRUES = ["true", "true", "True", "TRUE"];
+const FALSES = ["false", "false", "False", "FALSE"];
+const INFS = [".inf", ".Inf", ".INF", "+.inf"];
+const NEG_INFS = ["-.inf", "-.Inf", "-.INF"];
+const NANS = [".nan", ".NaN", ".NAN"];
+const NEG_ZEROS = ["-0.0", "-0.0e+0"];
+const INT_FORMS = ["dec", "dec", "dec", "dec", "dec", "dec", "dec", "hex", "HEX", "plus"];
+
+/** The node properties: an anchor 6% of the time, the kind's `!!` tag 6%. */
+const props = gs.record({ anchor: chance(6), tag: chance(6) });
+
+/**
+ * How a string is quoted: plain when the text may be (plainPct% of the time), else single-quoted
+ * when it may be (singlePct%), else double-quoted with these escape choices - a newline as `\x0a`
+ * rather than `\n`, a tab as `\x09`, NBSP as `\xa0` rather than `\_`, a space as `\ `, a slash as
+ * `\/`, a non-ASCII character as `\u`/`\U`.
+ */
+const quoting = (plainPct, singlePct) =>
+  gs.record({ plain: chance(plainPct), single: chance(singlePct), nlHex: chance(20), tabHex: chance(30), nbspHex: chance(50), escSpace: chance(10), escSlash: chance(30), escUnicode: chance(30) });
+
+/**
+ * How a string value is written as a block scalar when its parent puts it on lines of its own
+ * and the text fits the form: literal 60% of the time, else folded 40%; the content indented
+ * `step` past the parent; an indentation indicator 20% of the time, before the chomping
+ * indicator half the time; a comment after the header 20%; an empty line written as indentation
+ * half the time; a coin per word boundary of a folded block (recycled) for a line break there.
+ */
+const blocking = gs.record({
+  literal: chance(60),
+  folded: chance(40),
+  step: ints(1, 4),
+  indicator: chance(20),
+  indicatorFirst: chance(50),
+  headerComment: chance(20),
+  padEmpty: chance(50),
+  breaks: gs.arrays(chance(40), { maxSize: 8 }),
+});
+
+/** A scalar node with its spelling and properties: null 10% of the time, a boolean 10, an integer 20 (hexadecimal or with a `+` 30%), a float 15, a string 45. */
+const scalar = weighted(
+  [10, node("null", { text: gs.sampledFrom(NULLS), props })],
+  [10, node("bool", { value: gs.booleans(), spell: ints(0, 3), props })],
+  [20, node("int", { value: int, form: gs.sampledFrom(INT_FORMS), zero: gs.sampledFrom(["0", "0", "+0", "0x0"]), props })],
+  [15, node("float", { value: float, form: gs.sampledFrom(["plain", "plain", "exp", "EXP"]), special: ints(0, 3), stripZero: chance(20), plus: chance(15), props })],
+  [45, node("string", { value: text, quote: quoting(65, 45), block: blocking, props })],
+);
+
+// ---------------------------------------------------------------- collections and their layouts
+
+const spaces = ints(0, 2);
+const COMMENTS = [" # c", " #", "  # comment: with [flow] and 'quotes'", " # \u{65e5}\u{672c}"];
+/** A comment after a line 15% of the time. */
+const comment = maybe(15, gs.sampledFrom(COMMENTS));
+
+/** The spacing of a flow collection: spaces after the opening bracket, before each comma and after it (one, none or two), a trailing comma 15% of the time with spaces before it, spaces before the closing bracket. */
+const flowing = gs.record({ open: spaces, beforeComma: spaces, afterComma: gs.sampledFrom([" ", " ", "", "  "]), trail: maybe(15, spaces), close: spaces });
+
+/**
+ * How a mapping entry sits in a block mapping: a comment line before it 15% of the time; an
+ * explicit `? key` 8%; a null value as the bare key 30%; a non-empty collection value in block
+ * style 75% (else flow), indented `step` further, a sequence indentless 35%; spaces before a
+ * scalar value; a comment after the line; an empty line after the entry 10%. In a flow mapping,
+ * the spaces before and after its colon.
+ */
+const entryLayout = gs.record({
+  before: chance(15),
+  explicit: chance(8),
+  bareNull: chance(30),
+  block: chance(75),
+  step: ints(1, 4),
+  indentless: chance(35),
+  sp: spaces,
+  comment,
+  blank: chance(10),
+  beforeColon: spaces,
+  afterColon: spaces,
+});
+
+/** How a sequence item sits in a block sequence: a non-empty collection compact on the dash's line (`- k: v`, `- - a`) half the time, else on the lines below indented `step` further; a null as a bare dash 20%; spaces before a scalar; a comment after the line; an empty line after the item 8%. */
+const itemLayout = gs.record({ compact: chance(50), step: ints(1, 4), bareNull: chance(20), sp: spaces, comment, blank: chance(8) });
+
+/** A mapping key: 1-6 letters, with a number after them 30% of the time, 70% of the time; else a string; cut to 200 characters. */
+const keyName = weighted([70, gs.tuples(word, maybe(30, ints(0, 99))).map(([w, d]) => w + (d ?? ""))], [30, text]).map((k) => k.slice(0, 200));
+
+/** The collection nodes of a level whose children come from `child`: a sequence of 0-5 items and a mapping of 0-5 entries with distinct keys, every item and entry with its layout, every collection with its flow spacing and properties. */
+function collections(child) {
+  const seq = node("seq", { items: gs.arrays(gs.record({ node: child, layout: itemLayout }), { maxSize: 5 }), flow: flowing, props });
+  const entry = gs.record({ node: child, keyQuote: quoting(75, 40), layout: entryLayout });
+  const map = node("map", { entries: gs.maps(keyName, entry, { maxSize: 5 }).map((m) => [...m].map(([key, e]) => ({ key, ...e }))), flow: flowing, props });
+  return [seq, map];
+}
+
+/** A tree up to three collections deep: at each level a scalar 44% of the time, a sequence 28, a mapping 28. */
+function trees() {
+  let tree = scalar;
+  for (let depth = 2; depth >= 0; depth--) {
+    const [seq, map] = collections(tree);
+    tree = weighted([44, scalar], [28, seq], [28, map]);
+  }
+  return tree;
+}
+
+/**
+ * How the document is framed: a leading comment line 20% of the time, a blank line 15, a `---`
+ * marker 30 (with a comment 30% of that), a `%YAML 1.2` directive with its own `---` 10 (then a
+ * non-empty collection is always in block style); otherwise a non-empty collection in block
+ * style 80% (else flow), at an indentation of 1-3 15%; a string that fits a block scalar written
+ * as one half the time, literal rather than folded 60% of that, its content indented 1-4; a `...`
+ * marker 20%; a trailing comment 10%.
+ */
+const framing = gs.record({
+  leadingComment: chance(20),
+  blank: chance(15),
+  marker: chance(30),
+  markerComment: maybe(30, gs.sampledFrom(COMMENTS)),
+  directive: chance(10),
+  block: chance(80),
+  rootIndent: maybe(15, ints(1, 3)),
+  blockScalar: chance(50),
+  literal: chance(60),
+  step: ints(1, 4),
+  endMarker: chance(20),
+  trailingComment: chance(10),
+});
+
+/** The writer's case: a tree and the framing of its document. */
+export const documentCase = gs.record({ tree: trees(), framing });
+
+/** The JS value a reader should produce for a tree. */
+export function treeToValue(t) {
+  switch (t.kind) {
+    case "null": return null;
+    case "bool": case "int": case "float": case "string": return t.value;
+    case "seq": return t.items.map((it) => treeToValue(it.node));
+    case "map": return Object.fromEntries(t.entries.map((e) => [e.key, treeToValue(e.node)]));
+  }
+  throw new Error("bad tree");
+}
+
+function isColl(t) {
+  return t.kind === "seq" || t.kind === "map";
+}
+
+function size(t) {
+  return t.kind === "seq" ? t.items.length : t.kind === "map" ? t.entries.length : 0;
+}
+
+// ---------------------------------------------------------------- writing scalars
+
+const PLAIN_BAN_FIRST = "-?:,[]{}#&*!|>'\"%@` \t";
+const CONTROL = /[\x00-\x08\x0b\x0c\x0e-\x1f\x7f\x85\u{2028}\u{2029}\u{feff}]/u;
+// Any surrogate code unit, paired or not: such strings stay in double quotes, where they are escaped.
+const SURROGATE = /[\ud800-\udfff]/;
+
+const plainCache = new Map();
+
+// A string may be plain if both a 1.2 core reader and a 1.1 reader (yaml@2 with either schema
+// stands in for both) give the same string back, and the syntax leaves it whole. Not: empty,
+// multi-line, tabs, leading/trailing space.
+export function plainSafe(s, flow) {
+  if (s === "" || /[\n\r\t]/.test(s) || CONTROL.test(s)) return false;
+  if (PLAIN_BAN_FIRST.includes(s[0])) return false;
+  if (s.includes(": ") || s.includes(" #") || s.endsWith(":") || s.endsWith(" ")) return false;
+  if (s.startsWith("---") || s.startsWith("...")) return false;
+  if (s === "=" || s === "<<") return false; // YAML 1.1 !!value and !!merge
+  if (flow && /[,[\]{}:?]/.test(s)) return false;
+  if (SURROGATE.test(s)) return false;
+  if (s.length > 1000) return false;
+  if (plainCache.has(s)) return plainCache.get(s);
+  let ok = true;
+  for (const schema of ["core", "yaml-1.1"]) {
+    let v;
+    try {
+      v = Y2.parse("- " + s + "\n", { schema });
