+    if (errors.length) fail(`${schema}: ${JSON.stringify(text)} has errors: ${errors.map((e) => e.message.split("\n")[0]).join("; ")}`);
+    const arr = docs[0].toJS();
+    if (!Array.isArray(arr) || arr.length !== 1) fail(`${schema}: ${JSON.stringify(text)} is not one item: ${showValue(arr)}`);
+    const v = arr[0];
+    const got = v === null ? "null" : typeof v === "boolean" ? "bool" : typeof v === "number" || typeof v === "bigint" ? "number" : v instanceof Date ? "timestamp" : "str";
+    const exp = model.kind === "int" || model.kind === "float" ? "number" : model.kind;
+    count(`${schema}:${exp}`);
+    if (got !== exp) {
+      // the second implementation's verdict tells a model slip from a change
+      const v2 = Y2.parse(text, { schema })[0];
