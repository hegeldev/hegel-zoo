+// Hegel zoo: an independent model of the MessagePack specification
+// (https://github.com/msgpack/msgpack/blob/master/spec.md), written from the spec for the tests
+// in hegel.test.mjs. It knows nothing of msgpackr's code.
+//
+// - `encode(value)` writes the canonical (smallest) representation of a JS value: null, booleans,
+//   integers (number or bigint) in the smallest int/uint format, other numbers as float 64, strings
+//   as UTF-8 str, Uint8Array as bin, arrays, plain objects (string keys, in insertion order) and
+//   Maps as map, Dates as the timestamp extension (-1) in its smallest form, and `undefined` as the
+//   fixext 1 / type 0 / data 0 convention msgpackr documents.
+// - `decode(bytes)` parses one complete value strictly (every length checked; leftover bytes are an
+//   error unless `allowTrailing`), returning integers as numbers when safe and bigints otherwise,
+//   maps as `Map` unless every key is a string (then a plain object), ext as `{ext: type, data}`
+//   with timestamps turned into Dates, and reports where each value ends.
+// - `canonical(value)` renders a value for comparison: it distinguishes -0, NaN, bigints, Dates,
+//   binary, Maps and objects, and sorts nothing (order is part of the value).
+
+const utf8 = new TextEncoder();
+const utf8d = new TextDecoder("utf-8", { fatal: false });
+
+class Writer {
+  constructor() {
+    this.buf = new Uint8Array(1024);
+    this.pos = 0;
+    this.view = new DataView(this.buf.buffer);
+  }
+  ensure(n) {
+    if (this.pos + n > this.buf.length) {
+      let size = this.buf.length * 2;
+      while (size < this.pos + n) size *= 2;
+      const nb = new Uint8Array(size);
+      nb.set(this.buf.subarray(0, this.pos));
+      this.buf = nb;
+      this.view = new DataView(nb.buffer);
+    }
+  }
+  u8(b) {
+    this.ensure(1);
+    this.buf[this.pos++] = b;
+  }
+  u16(v) {
+    this.ensure(2);
+    this.view.setUint16(this.pos, v);
+    this.pos += 2;
+  }
+  u32(v) {
+    this.ensure(4);
+    this.view.setUint32(this.pos, v);
+    this.pos += 4;
+  }
+  u64(v) {
+    this.ensure(8);
+    this.view.setBigUint64(this.pos, BigInt(v));
+    this.pos += 8;
+  }
+  i64(v) {
+    this.ensure(8);
+    this.view.setBigInt64(this.pos, BigInt(v));
+    this.pos += 8;
+  }
+  f64(v) {
+    this.ensure(8);
+    this.view.setFloat64(this.pos, v);
+    this.pos += 8;
+  }
+  f32(v) {
+    this.ensure(4);
+    this.view.setFloat32(this.pos, v);
+    this.pos += 4;
+  }
+  bytes(b) {
+    this.ensure(b.length);
+    this.buf.set(b, this.pos);
+    this.pos += b.length;
+  }
+  result() {
+    return this.buf.slice(0, this.pos);
+  }
+}
+
+/** Writes an integer (number or bigint) in its smallest format. */
+function writeInt(w, v) {
+  const b = typeof v === "bigint" ? v : BigInt(v);
+  if (b >= 0n) {
+    if (b < 0x80n) w.u8(Number(b));
+    else if (b < 0x100n) { w.u8(0xcc); w.u8(Number(b)); }
+    else if (b < 0x10000n) { w.u8(0xcd); w.u16(Number(b)); }
+    else if (b < 0x100000000n) { w.u8(0xce); w.u32(Number(b)); }
+    else if (b < 0x10000000000000000n) { w.u8(0xcf); w.u64(b); }
+    else throw new RangeError(`integer ${b} does not fit in 64 bits`);
+  } else {
+    if (b >= -0x20n) w.u8(0x100 + Number(b));
+    else if (b >= -0x80n) { w.u8(0xd0); w.u8(0x100 + Number(b)); }
+    else if (b >= -0x8000n) { w.u8(0xd1); w.u16(0x10000 + Number(b)); }
+    else if (b >= -0x80000000n) { w.u8(0xd2); w.u32(0x100000000 + Number(b)); }
+    else if (b >= -0x8000000000000000n) { w.u8(0xd3); w.i64(b); }
+    else throw new RangeError(`integer ${b} does not fit in 64 bits`);
+  }
+}
+
+function writeStr(w, s) {
+  const b = utf8.encode(s);
+  const n = b.length;
+  if (n < 32) w.u8(0xa0 | n);
+  else if (n < 0x100) { w.u8(0xd9); w.u8(n); }
+  else if (n < 0x10000) { w.u8(0xda); w.u16(n); }
+  else { w.u8(0xdb); w.u32(n); }
+  w.bytes(b);
+}
+
+function writeBin(w, b) {
+  const n = b.length;
+  if (n < 0x100) { w.u8(0xc4); w.u8(n); }
+  else if (n < 0x10000) { w.u8(0xc5); w.u16(n); }
+  else { w.u8(0xc6); w.u32(n); }
+  w.bytes(b);
+}
+
+function writeArrayHeader(w, n) {
