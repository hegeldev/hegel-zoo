index 0000000..4345cee
--- /dev/null
+++ b/hegel/gen.mjs
@@ -0,0 +1,205 @@
+// Hegel zoo: generators of JS values for the msgpackr properties.
+//
+// Each generator takes the Hegel test case `tc` and a `shape` describing what the value may
+// contain (which the property chooses from what the option set under test supports):
+//   undefined, bigint, date, bin, map (Map with primitive keys), float, nested (arrays/objects),
+//   moreTypes (Set, typed arrays, Error, RegExp), longStrings, keysOnly (objects with only
+//   string keys are always allowed).
+
+import { chance, n, pick, word } from "./hegel-zoo.mjs";
+
+const ALPHABET = ["a", "b", "z", "A", "0", "9", " ", "_", "-", ".", "é", "ß", "Ѐ", "中", "퟿", "", "￿", "\u{1F600}", "\u{10FFFF}", "\u0000", "\u001f", "\u007f", "", "\n", "\"", "\\"];
+
+const SPECIAL_INTS = [0, 1, -1, 31, 32, 33, 63, 64, 65, 127, 128, 129, 255, 256, 257, -31, -32, -33, -127, -128, -129,
+  32767, 32768, 65535, 65536, -32767, -32768, -32769, 2147483647, 2147483648, 4294967295, 4294967296, -2147483647,
+  -2147483648, -2147483649, 2 ** 53 - 1, -(2 ** 53 - 1), 2 ** 53, -(2 ** 53)];
+
+const SPECIAL_FLOATS = [0.5, -0.5, 0.1, 0.2, 0.3, 1.5, -1.5, 7.99, 1 / 3, Math.PI, 1e-7, 1e-45, 1e-46, 1e10 + 0.5, 3.4028235e38,
+  3.5e38, 1e300, -1e300, 5e-324, 2 ** 31 - 0.5, 2 ** 31 + 0.5, 16777217.5, 0.1 + 0.2, 123456.78, 123456789.1, NaN, Infinity, -Infinity, -0];
+
+/** A string: short words over a mixed alphabet, the str8/16/32 boundaries, or (rarely) a long one. */
+export function str(tc, shape = {}) {
+  const r = n(tc, 0, 99);
+  if (r < 60) return word(tc, ALPHABET, 0, 8);
+  if (r < 80) return word(tc, ALPHABET, 20, 40);
+  if (r < 90) return "x".repeat(pick(tc, [31, 32, 255, 256]));
+  if (r < 97 || !shape.longStrings) return word(tc, ["a", "é", "\u{1F600}"], 100, 400);
+  return word(tc, ["a", "b", "é"], 65530, 65540);
+}
+
+/** A string that may contain lone surrogates. */
+export function strWithLoneSurrogates(tc) {
+  return word(tc, [...ALPHABET, "\ud800", "\udc00", "\udbff", "\udfff", "\ud83d"], 0, 12);
+}
+
+/** An integer number: boundary values or random in a random magnitude. */
+export function int(tc) {
+  if (chance(tc, 40)) return pick(tc, SPECIAL_INTS);
+  const bits = pick(tc, [4, 7, 8, 15, 16, 31, 32, 40, 53]);
+  const mag = n(tc, 0, Math.min(2 ** bits, Number.MAX_SAFE_INTEGER));
+  return chance(tc, 40) ? -mag : mag;
+}
+
+/** A bigint: 64-bit boundaries, values that also fit a number, or (if shape.hugeBigint) wider. */
+export function big(tc, shape = {}) {
+  const r = n(tc, 0, 99);
+  if (r < 30) return pick(tc, [0n, 1n, -1n, 2n ** 32n, 2n ** 53n, 2n ** 53n + 1n, 2n ** 63n - 1n, 2n ** 63n, 2n ** 64n - 1n, -(2n ** 63n), -(2n ** 63n) + 1n, -(2n ** 53n) - 1n]);
+  if (r < 50) return BigInt(int(tc));
+  if (r < 85 || !shape.hugeBigint) {
+    const hi = BigInt(n(tc, 0, 2 ** 31 - 1));
+    const lo = BigInt(n(tc, 0, 2 ** 32 - 1));
+    const v = (hi << 32n) | lo;
+    return chance(tc, 50) ? -v : v;
+  }
+  return pick(tc, [2n ** 64n, -(2n ** 63n) - 1n, 2n ** 70n, -(2n ** 100n), 10n ** 30n]);
+}
+
+/** A non-integer (or special) double. */
+export function float(tc) {
+  if (chance(tc, 40)) return pick(tc, SPECIAL_FLOATS);
+  if (chance(tc, 30)) {
+    // a decimal with few significant digits, the kind DECIMAL_FIT is for
+    const digits = n(tc, 1, 9);
+    const scale = n(tc, 0, 9);
+    const sign = chance(tc, 30) ? -1 : 1;
+    return sign * n(tc, 0, 10 ** digits) / 10 ** scale;
+  }
+  const m = n(tc, 0, 2 ** 52) + n(tc, 0, 2 ** 52);
+  const e = n(tc, -60, 60);
+  const v = (chance(tc, 30) ? -1 : 1) * m * 2 ** e;
+  return Number.isFinite(v) ? v : 1.25;
+}
+
+/** A Date: the whole JS range, including pre-1970 with milliseconds, and the timestamp format boundaries. */
+export function date(tc, shape = {}) {
+  const r = n(tc, 0, 99);
+  let ms;
+  if (r < 30) ms = pick(tc, [0, 1, -1, 999, 1000, -1000, -1001, 4294967295000, 4294967296000, 17179869183999, 17179869184000, -62135596800000, 8.64e15, -8.64e15, 1e12 + 123]);
+  else if (r < 70) ms = n(tc, 0, 4294967295) * 1000 + n(tc, 0, 999);
+  else if (r < 90) ms = -n(tc, 0, 2 ** 40) - n(tc, 0, 999);
+  else ms = (chance(tc, 50) ? -1 : 1) * n(tc, 0, 8.64e15);
+  if (shape.wholeSeconds) ms = Math.trunc(ms / 1000) * 1000;
+  return new Date(ms);
+}
+
+/** Bytes as a Uint8Array (sometimes a Buffer, sometimes a view into a larger buffer). */
+export function bin(tc) {
+  const len = chance(tc, 80) ? n(tc, 0, 40) : pick(tc, [255, 256, 300, 65535, 65536]);
+  const a = new Uint8Array(len);
+  for (let i = 0; i < Math.min(len, 64); i++) a[i] = n(tc, 0, 255);
+  for (let i = 64; i < len; i++) a[i] = (i * 7) & 0xff;
+  const r = n(tc, 0, 2);
+  if (r === 0) return a;
+  if (r === 1) return Buffer.from(a);
+  const big = new Uint8Array(len + 6);
+  big.fill(0xee);
+  big.set(a, 3);
+  return big.subarray(3, 3 + len);
+}
+
+/** A primitive map key (what msgpackr's Map encoding can hold). */
+export function mapKey(tc, shape) {
+  const r = n(tc, 0, 99);
+  if (r < 50) return str(tc);
+  if (r < 75) return int(tc);
+  if (r < 85) return pick(tc, [true, false, null]);
+  if (r < 92 && shape.float) return float(tc);
+  return str(tc);
+}
+
+/** A scalar. */
+export function scalar(tc, shape) {
+  const r = n(tc, 0, 99);
+  if (r < 8) return null;
+  if (r < 14) return pick(tc, [true, false]);
+  if (r < 40) return int(tc);
+  if (r < 50 && shape.float) return float(tc);
+  if (r < 58 && shape.bigint) return big(tc, shape);
+  if (r < 64 && shape.date) return date(tc, shape);
+  if (r < 70 && shape.bin) return bin(tc);
+  if (r < 74 && shape.undefined) return undefined;
+  return str(tc, shape);
+}
+
+/** A plain object with string keys. */
+export function object(tc, depth, shape) {
+  const o = {};
+  const r = n(tc, 0, 99);
+  const size = r < 70 ? n(tc, 0, 5) : r < 92 ? n(tc, 6, 20) : shape.wideObjects ? n(tc, 60, 300) : n(tc, 10, 30);
+  for (let i = 0; i < size; i++) {
+    const k = chance(tc, 70) ? word(tc, ["a", "b", "c", "k", "x", "_", "1", "é"], 1, 4) : chance(tc, 50) ? String(n(tc, 0, 1000)) : str(tc);
+    if (k === "__proto__") continue;
+    o[k] = value(tc, depth + 1, shape);
+  }
+  return o;
+}
+
+export function array(tc, depth, shape) {
+  const r = n(tc, 0, 99);
+  const size = r < 75 ? n(tc, 0, 6) : r < 95 ? n(tc, 14, 20) : shape.wideArrays ? n(tc, 60, 200) : n(tc, 15, 17);
+  const a = [];
+  for (let i = 0; i < size; i++) a.push(value(tc, depth + 1, shape));
+  return a;
+}
+
+export function map(tc, depth, shape) {
+  const m = new Map();
+  const size = n(tc, 0, 6);
+  for (let i = 0; i < size; i++) m.set(mapKey(tc, shape), value(tc, depth + 1, shape));
+  return m;
+}
+
+export function moreTypesValue(tc, depth, shape) {
+  const r = n(tc, 0, 99);
+  if (r < 25) {
+    const s = new Set();
+    const size = n(tc, 0, 5);
+    for (let i = 0; i < size; i++) s.add(scalar(tc, shape));
+    return s;
+  }
+  if (r < 65) return typedArray(tc);
+  if (r < 85) {
+    const Ctor = pick(tc, [Error, TypeError, RangeError, SyntaxError]);
+    return new Ctor(str(tc));
+  }
+  return new RegExp(pick(tc, ["a", "a\\/b", "[a-z]+", "^x$", "\\d{2,}", "(?<n>a)|b"]), pick(tc, ["", "g", "i", "gi", "m", "s", "u", "y", "d"]));
+}
+
+const TYPED = [Int8Array, Uint8Array, Uint8ClampedArray, Int16Array, Uint16Array, Int32Array, Uint32Array, Float32Array, Float64Array];
+
+/** A typed array of any kind (sometimes a view at an offset into a larger buffer). */
+export function typedArray(tc) {
+  const Ctor = pick(tc, TYPED);
+  const len = n(tc, 0, 6);
+  const offset = chance(tc, 30) ? n(tc, 1, 3) : 0;
+  const backing = new Ctor(len + offset + 1);
+  for (let i = 0; i < backing.length; i++) {
+    backing[i] = Ctor === Float32Array || Ctor === Float64Array ? float(tc) : int(tc);
+  }
+  return offset ? backing.subarray(offset, offset + len) : backing.subarray(0, len);
+}
+
+/** A value of the given shape, nesting up to depth 3. */
+export function value(tc, depth, shape) {
+  const r = n(tc, 0, 99);
+  if (depth >= 3 || r < 55) return scalar(tc, shape);
+  if (r < 75) return array(tc, depth, shape);
+  if (r < 90 || !(shape.map || shape.moreTypes)) return object(tc, depth, shape);
+  if (shape.map && (!shape.moreTypes || chance(tc, 50))) return map(tc, depth, shape);
+  return moreTypesValue(tc, depth, shape);
+}
+
+/** A top-level value that is an object or array (what streams and records are about). */
+export function container(tc, shape) {
+  return chance(tc, 60) ? object(tc, 0, shape) : array(tc, 0, shape);
+}
+
+/** Random bytes, biased towards MessagePack type bytes. */
+export function bytes(tc) {
+  const len = n(tc, 1, 24);
+  const b = new Uint8Array(len);
+  for (let i = 0; i < len; i++) {
+    b[i] = chance(tc, 40) ? pick(tc, [0xc0, 0xc2, 0xc3, 0xc4, 0xc7, 0xca, 0xcb, 0xcc, 0xcd, 0xce, 0xcf, 0xd0, 0xd3, 0xd4, 0xd9, 0xda, 0xdc, 0xde, 0x81, 0x91, 0xa1, 0x00, 0x01, 0xff, 0xe0]) : n(tc, 0, 255);
+  }
+  return b;
+}
diff --git a/hegel/hegel-zoo.mjs b/hegel/hegel-zoo.mjs
new file mode 100644
index 0000000..1ca6f10
--- /dev/null
+++ b/hegel/hegel-zoo.mjs
@@ -0,0 +1,163 @@
+// Hegel zoo: the small harness shared by the zoo's TypeScript/JavaScript targets.
+//
+// `property(name, body)` registers a node:test test that runs `body(tc)` under Hegel with
+// HEGEL_TEST_CASES cases (default 100) and the database at HEGEL_DATABASE. With ZOO_COLLECT=1
+// a `fail()` records the mismatch instead of failing, the case ends there, and the counts of
+// mismatches and of the shapes seen (`count(key)`) are printed at the end of the test, so a
+// property can be run over many cases to see every shape at once. `pin(name, body)` is a
+// plain test for one pinned bug: it must fail while the bug is present and pass once it is
+// fixed (the zoo's judge reads an unexpected pass as "fixed upstream?").
+
+import { readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+import { test as nodeTest } from "node:test";
+
+// The Hegel version these tests were written against (the zoo pins it in zoo.toml; upstream
+// would add it to devDependencies). Hegel and esbuild are installed with `npm install --prefix
+// .hegel` so the target's own package.json and lock file stay untouched. Checked at load time so
+// a stray install cannot silently change the engine.
+export const HEGEL_PIN = { "@hegeldev/hegel": "0.4.5" };
+
+const hegelDir = join(dirname(fileURLToPath(import.meta.url)), "..", ".hegel", "node_modules", "@hegeldev", "hegel");
+{
+  const installed = JSON.parse(readFileSync(join(hegelDir, "package.json"), "utf8")).version;
+  if (installed !== HEGEL_PIN["@hegeldev/hegel"]) {
+    throw new Error(`@hegeldev/hegel ${installed} is installed; these tests pin ${HEGEL_PIN["@hegeldev/hegel"]}`);
+  }
+}
+const hegel = await import(pathToFileURL(join(hegelDir, "dist", "index.js")));
+const gs = await import(pathToFileURL(join(hegelDir, "dist", "generators", "index.js")));
+
+export const collecting = !!process.env.ZOO_COLLECT;
+
+class Collected extends Error {}
+
+let msgs = [];
+let stats = new Map();
+
+/** Report a mismatch: an error normally, a recorded line in collect mode. */
+export function fail(message) {
+  if (collecting) {
+    msgs.push(message);
+    throw new Collected(message);
+  }
+  throw new Error(message);
+}
+
+/** Bump a statistic (the shape of a pinned bug, a generator branch). */
+export function count(key) {
+  stats.set(key, (stats.get(key) || 0) + 1);
+}
+
+function settings() {
+  const s = { testCases: Number(process.env.HEGEL_TEST_CASES) || 100 };
+  if (process.env.HEGEL_DATABASE) {
+    s.database = hegel.Database.fromPath(process.env.HEGEL_DATABASE);
+  }
+  return s;
+}
+
+/** A property: `body(tc)` runs under Hegel; a thrown error (or `fail`) is a failure. */
+export function property(name, body) {
+  nodeTest(name, () => {
+    msgs = [];
+    stats = new Map();
+    hegel.test((tc) => {
+      try {
+        body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** An async property: `body(tc)` may await; runs under Hegel's testAsync with the same settings. */
+export function propertyAsync(name, body) {
+  nodeTest(name, async () => {
+    msgs = [];
+    stats = new Map();
+    await hegel.testAsync(async (tc) => {
+      try {
+        await body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** A pin: a plain test for one recorded bug. */
+export function pin(name, body) {
+  nodeTest(name, body);
+}
+
+/** An integer in [lo, hi]. */
+export function n(tc, lo, hi) {
+  return tc.draw(gs.integers({ minValue: lo, maxValue: hi }));
+}
+
+/** One of xs. */
+export function pick(tc, xs) {
+  return xs[n(tc, 0, xs.length - 1)];
+}
+
+/** True pct percent of the time. */
+export function chance(tc, pct) {
+  return n(tc, 0, 99) < pct;
+}
+
+/** A string of `len` characters drawn from `alphabet` (an array of strings). */
+export function word(tc, alphabet, lo, hi) {
+  const len = n(tc, lo, hi);
+  let s = "";
+  for (let i = 0; i < len; i++) {
+    s += pick(tc, alphabet);
+  }
+  return s;
+}
+
+/** Structural equality: arrays by position, objects by key set (prototype ignored), else ===. */
+export function same(a, b) {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) {
+      return false;
+    }
+    return a.every((x, i) => same(x, b[i]));
+  }
+  if (a !== null && b !== null && typeof a === "object" && typeof b === "object") {
+    const ka = Object.keys(a).sort();
+    const kb = Object.keys(b).sort();
+    if (ka.length !== kb.length || ka.some((k, i) => k !== kb[i])) {
+      return false;
+    }
+    return ka.every((k) => same(a[k], b[k]));
+  }
+  return a === b;
+}
+
+/** A compact, unambiguous rendering for messages. */
+export function show(x) {
+  return JSON.stringify(x, (k, v) => (v === undefined ? "<undefined>" : v));
+}
diff --git a/hegel/hegel.test.mjs b/hegel/hegel.test.mjs
