index 0000000..41626f4
--- /dev/null
+++ b/hegel/hegel.test.mjs
@@ -0,0 +1,841 @@
+// Hegel zoo: properties of msgpackr (kriszyp/msgpackr) against an independent model of the
+// MessagePack specification (msgpack-model.mjs), @msgpack/msgpack as a second implementation,
+// and msgpackr's own README. Run with `node --test hegel/hegel.test.mjs` from the repository
+// root; HEGEL_TEST_CASES sets the case count, ZOO_COLLECT=1 collects mismatches instead of
+// stopping at the first.
+
+import assert from "node:assert/strict";
+import { createRequire } from "node:module";
+import { Transform } from "node:stream";
+import { chance, collecting, count, fail, n, pick, pin, property, propertyAsync, show } from "./hegel-zoo.mjs";
+import * as model from "./msgpack-model.mjs";
+import * as gen from "./gen.mjs";
+import * as M from "../node-index.js";
+
+const require = createRequire(import.meta.url);
+const oracle = require("../.hegel/node_modules/@msgpack/msgpack");
+
+const { Packr, Unpackr, PackrStream, UnpackrStream, pack, unpack, unpackMultiple, addExtension, FLOAT32_OPTIONS, roundFloat32 } = M;
+const { canonical, hex } = model;
+
+// ---------------------------------------------------------------------------------------------
+// Helpers
+
+/** A copy of a packed buffer: Packr reuses its internal buffer, so a result must be copied before the next pack. */
+function packed(packr, v) {
+  return Uint8Array.from(packr.pack(v));
+}
+
+/** msgpackr writes the number -0 as the integer 0 (like JSON); the model of what comes back. */
+function normZero(v) {
+  if (typeof v === "number") return Object.is(v, -0) ? 0 : v;
+  if (v === null || typeof v !== "object") return v;
+  if (v instanceof Date || v instanceof Uint8Array || ArrayBuffer.isView(v) || v instanceof RegExp || v instanceof Error) return v;
+  if (Array.isArray(v)) return v.map(normZero);
+  if (v instanceof Map) return new Map([...v].map(([k, x]) => [normZero(k), normZero(x)]));
+  if (v instanceof Set) return new Set([...v].map(normZero));
+  const o = {};
+  for (const k of Object.keys(v)) o[k] = normZero(v[k]);
+  return o;
+}
+
+/** The value as the spec model decodes it: Maps whose keys are all strings become plain objects. */
+function modelView(v) {
+  if (v === null || typeof v !== "object") return v;
+  if (v instanceof Date || v instanceof Uint8Array) return v;
+  if (Array.isArray(v)) return v.map(modelView);
+  if (v instanceof Map) {
+    if ([...v.keys()].every((k) => typeof k === "string")) {
+      const o = {};
+      for (const [k, x] of v) o[k] = modelView(x);
+      return o;
+    }
+    return new Map([...v].map(([k, x]) => [modelView(k), modelView(x)]));
+  }
+  const o = {};
+  for (const k of Object.keys(v)) o[k] = modelView(v[k]);
+  return o;
+}
+
+/** The value as a records-mode Unpackr decodes a plain map: every map is a Map. */
+function mapView(v) {
+  if (v === null || typeof v !== "object") return v;
+  if (v instanceof Date || v instanceof Uint8Array) return v;
+  if (Array.isArray(v)) return v.map(mapView);
+  if (v instanceof Map) return new Map([...v].map(([k, x]) => [mapView(k), mapView(x)]));
+  return new Map(Object.keys(v).map((k) => [k, mapView(v[k])]));
+}
+
+/** The value as a compatibility-mode Unpackr decodes it: every map is an object with string keys. */
+function objectView(v) {
+  if (v === null || typeof v !== "object") return v;
+  if (v instanceof Date || v instanceof Uint8Array) return v;
+  if (Array.isArray(v)) return v.map(objectView);
+  const o = {};
+  if (v instanceof Map) {
+    for (const [k, x] of v) o[String(k)] = objectView(x);
+    return o;
+  }
+  for (const k of Object.keys(v)) o[k] = objectView(v[k]);
+  return o;
+}
+
+const NARROW = { narrowBigints: true };
+
+function same(a, b, opts = NARROW) {
+  return canonical(a, opts) === canonical(b, opts);
+}
+
+function mismatch(what, expected, actual, extra = "", opts = NARROW) {
+  const e = canonical(expected, opts);
+  const a = canonical(actual, opts);
+  let i = 0;
+  while (i < e.length && i < a.length && e[i] === a[i]) i++;
+  const from = Math.max(0, i - 60);
+  fail(`${what}\n  expected ${e.length > 300 ? "..." + e.slice(from, from + 300) : e}\n  actual   ${a.length > 300 ? "..." + a.slice(from, from + 300) : a}\n  (first difference at ${i} of ${e.length}/${a.length})${extra ? "\n  " + extra : ""}`);
+}
+
+/** The value with every undefined replaced by null (what encodeUndefinedAsNil reads back). */
+function undefinedToNull(v) {
+  if (v === undefined) return null;
+  if (v === null || typeof v !== "object") return v;
+  if (v instanceof Date || v instanceof Uint8Array || ArrayBuffer.isView(v)) return v;
+  if (Array.isArray(v)) return v.map(undefinedToNull);
+  if (v instanceof Map) return new Map([...v].map(([k, x]) => [undefinedToNull(k), undefinedToNull(x)]));
+  const o = {};
+  for (const k of Object.keys(v)) o[k] = undefinedToNull(v[k]);
+  return o;
+}
+
+function describe(opts) {
+  return JSON.stringify(opts, (k, v) => (typeof v === "function" ? "<function>" : v));
+}
+
+function attempt(f) {
+  try {
+    return { value: f() };
+  } catch (e) {
