+// Hegel properties for liquidjs against Shopify's Ruby liquid (see README.md in targets/typescript/liquidjs).
+import assert from "node:assert/strict";
+import test from "node:test";
+import { fail, count, propertyAsync, pin, n, pick, chance } from "./hegel-zoo.mjs";
+import { FULL, context, template, printable, output } from "./gen.mjs";
+import { rubyRender, stopOracle } from "./oracle.mjs";
+import { Liquid } from "./liquid.mjs";
+
+const engine = new Liquid();
+
+function jsRender(tpl, data) {
+  try {
+    return { output: engine.parseAndRenderSync(tpl, data) };
+  } catch (e) {
+    return { error: `${e.name}: ${e.message}` };
+  }
+}
+
+/** Documented differences normalised away: Ruby prints floats with `.0` (and a negative zero as -0.0), JavaScript does not. */
+export function normalise(s) {
+  return s.replace(/(-?\d+)\.0(?![\d])/g, "$1").replace(/(^|[^\d.])-0(?![\d.])/g, "$10");
+}
+
+const show = (tpl, data) => `template: ${JSON.stringify(tpl)}\ndata: ${JSON.stringify(data)}`;
+
+async function differential(tc, tpl, data) {
+  const js = jsRender(tpl, structuredClone(data)); // (liquidjs writes assigns and counters into the scope it is given)
+  const rb = await rubyRender(tpl, data, { strict: true });
+  if (rb.error) {
+    // the Ruby side rejects the template: liquidjs must reject it too (or the shape is one we skip)
+    if (js.error) {
+      count("both-reject");
+      return;
+    }
+    fail(`Ruby rejects (${rb.error}) but liquidjs renders ${JSON.stringify(js.output)}\n${show(tpl, data)}`);
+  }
+  if (rb.errors.length) {
+    count("ruby-render-error");
+    if (js.error) return;
+    // Ruby writes the error text into the output; liquidjs throws or renders: compare only when both render
+    return;
+  }
+  if (js.error) fail(`liquidjs throws ${js.error} where Ruby renders ${JSON.stringify(rb.output)}\n${show(tpl, data)}`);
+  if (normalise(js.output) !== normalise(rb.output)) {
+    fail(`liquidjs ${JSON.stringify(js.output)}\nruby     ${JSON.stringify(rb.output)}\n${show(tpl, data)}`);
+  }
+  count("same");
+}
+
+propertyAsync("TestHegelTemplatesRenderLikeShopifyLiquid", async (tc) => {
+  const data = context(tc);
+  const tpl = template(tc);
+  await differential(tc, tpl, data);
+});
+
+propertyAsync("TestHegelFilterChainsRenderLikeShopifyLiquid", async (tc) => {
+  const data = context(tc);
+  const tpl = output(tc, printable(tc).src);
+  await differential(tc, tpl, data);
+});
+
+// ---- pins: one test per recorded bug --------------------------------------------------------------
+
+const render = (tpl, data = {}) => engine.parseAndRenderSync(tpl, data);
+
+pin("TestHegelPinRawClosesOnWhitespaceControlledEndraw", () => {
+  assert.equal(render("a{% raw %}x{{ y }}{% endraw -%} b"), "ax{{ y }}b");
+  assert.equal(render("a{% raw %}x{{ y }}{%- endraw %}b"), "ax{{ y }}b");
+});
+
+pin("TestHegelPinUnnamedCyclesWithDifferentCandidatesAreIndependent", () => {
+  assert.equal(render('{% cycle "a", "b" %}{% cycle "x", "y" %}{% cycle "a", "b" %}{% cycle "x", "y" %}'), "axby");
+  assert.equal(render('{% cycle 1, 2 %}{% cycle "1", "2" %}{% cycle 1, 2 %}'), "112");
+});
+
+pin("TestHegelPinTruncatewordsKeepsAStringWithExactlyThatManyWords", () => {
+  assert.equal(render('{{ "1 2 3" | truncatewords: 3 }}'), "1 2 3");
+  assert.equal(render('{{ "1 2 3" | truncatewords: 2 }}'), "1 2...");
+  assert.equal(render('{{ "cherry" | truncatewords: 0 }}'), "cherry");
+});
+
+pin("TestHegelPinModuloOfAFloatKeepsItsPrecision", () => {
+  assert.equal(render("{{ 0.1 | modulo: 7 }}"), "0.1");
+  assert.equal(render("{{ 0.1 | modulo: 3 }}"), "0.1");
+  assert.equal(render("{{ -1 | modulo: 7 }}"), "6");
+});
+
+pin("TestHegelPinCycleEmitsAZeroOrFalseCandidate", () => {
+  assert.equal(render("{% cycle 0, 1 %}|{% cycle 0, 1 %}"), "0|1");
+  assert.equal(render("{% cycle false, true %}"), "false");
+  assert.equal(render("{% cycle z, 1 %}", { z: 0 }), "0");
+});
+
+pin("TestHegelPinForElseRendersWhenLimitOrOffsetEmptiesTheLoop", () => {
+  assert.equal(render("{% for i in (1..3) limit: 0 %}x{% else %}empty{% endfor %}"), "empty");
+  assert.equal(render("{% for i in words offset: 3 %}x{% else %}empty{% endfor %}", { words: ["a"] }), "empty");
+});
+
+pin("TestHegelPinMathFiltersTreatTrueAsZero", () => {
+  assert.equal(render("{{ true | plus: 1 }}"), "1");
+  assert.equal(render("{{ true | times: 2 }}"), "0");
+  assert.equal(render("{{ true | abs }}"), "0");
+});
+
+pin("TestHegelPinBlockWithOnlyWhitespaceRendersNothing", () => {
+  assert.equal(render("{% if true %} {% endif %}x"), "x");
+  assert.equal(render("{% for i in (1..2) %} {% endfor %}x"), "x");
+  assert.equal(render("{% if true %} {% assign a = 1 %} {% endif %}x"), "x");
+});
+
+test("stop the oracle", () => stopOracle());
