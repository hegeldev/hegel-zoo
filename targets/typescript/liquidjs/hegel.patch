+const candidateList = (lo) => gs.arrays(gs.sampledFrom(CYCLE_POOL), { minSize: lo, maxSize: 3, unique: true }).map((cs) => cs.join(", "));
+const unnamedCyclesOfTwoLists = withContext(
+  gs.record({ a: candidateList(1), b: candidateList(2), order: chance(50), more: ints(0, 3) })
+    .filter(({ a, b }) => a !== b)
+    .flatMap(({ a, b, order, more }) => {
+      const cycle = (cands) => seq(text, tag(`cycle ${cands}`));
+      const [first, second] = order ? [b, a] : [a, b];
+      return seq(cycle(first), cycle(second), times(more, gs.oneOf(cycle(a), cycle(b))), text);
+    }),
+);
+
+// liquidjs/3: a string of exactly as many words as truncatewords is given (a count below 1 counts as 1)
+const exactWordCount = withContext(
+  output(
+    gs.tuples(gs.arrays(plainWord, { minSize: 1, maxSize: 4 }), chance(20), maybe(30, quoted(STR_LITERALS.filter((s) => s !== "")))).map(
+      ([ws, zero, ellipsis]) => `${JSON.stringify(ws.join(" "))} | truncatewords: ${zero && ws.length === 1 ? 0 : ws.length}${ellipsis === undefined ? "" : ", " + ellipsis}`,
+    ),
+  ),
+);
+
+// liquidjs/10: a string of fewer words than the count, with whitespace liquidjs would rebuild: leading
+// blanks, two or more trailing blanks (one is rebuilt as it was), or a run of blanks between words
