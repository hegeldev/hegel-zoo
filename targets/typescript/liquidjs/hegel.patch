+++ b/hegel/gen.mjs
@@ -0,0 +1,446 @@
+// Generators for liquidjs vs Shopify liquid: a random render context and a random template over
+// the tags and filters both engines implement, with expressions typed so filters get arguments of
+// the kinds their documentation describes (the default run); ZOO_FULL loosens that.
+//
+// Everything here is a generator value built from Hegel's combinators. A template is drawn as a
+// tree of nodes - strings for the parts that need no state, arrays for sequences, and a few tagged
+// records for the tags that hand out names or refer to earlier ones - and `render` turns the tree
+// into the template text, numbering the names (`v0`, `c1`, `i2`) and tracking the variables assigned
+// so far in document order, so the shrinker can delete or swap whole tags.
+import { gs } from "./hegel-zoo.mjs";
+
+export const FULL = !!process.env.ZOO_FULL;
+
+// ---- helpers -----------------------------------------------------------------------------------
+
+const ints = (lo, hi) => gs.integers({ minValue: lo, maxValue: hi });
+
+/** oneOf with weights: `weighted([45, a], [55, b])` draws a 45 times in 100; shrinks towards the first choice. */
+function weighted(...choices) {
+  const total = choices.reduce((sum, [w]) => sum + w, 0);
+  return ints(0, total - 1).flatMap((r) => {
+    for (const [w, g] of choices) {
+      if (r < w) return g;
+      r -= w;
+    }
+    throw new Error("unreachable");
+  });
+}
+
+/** True pct percent of the time; shrinks to false. */
+const chance = (pct) => ints(0, 99).map((r) => r < pct);
+/** A string (or a generator of one) as a generator. */
+const lift = (x) => (typeof x === "string" ? gs.just(x) : x);
+/** A draw from g pct percent of the time, else undefined (listed first: shrinks to absent). */
+const maybe = (pct, g) => weighted([100 - pct, gs.just(undefined)], [pct, g]);
+/** A draw from g pct percent of the time, else "" (shrinks to the empty string). */
+const maybeText = (pct, g) => weighted([100 - pct, gs.just("")], [pct, lift(g)]);
+/** The parts (strings or generators of strings) drawn and concatenated. */
+const seq = (...parts) => gs.tuples(...parts.map(lift)).map((ss) => ss.join(""));
+/** lo-hi characters from `alphabet`, an array of strings (a repeated entry weighs more; gs.text's alphabet is a set). */
+const chars = (alphabet, lo, hi) => gs.arrays(gs.sampledFrom(alphabet), { minSize: lo, maxSize: hi }).map((cs) => cs.join(""));
+
+// ---- the context -------------------------------------------------------------------------------
+
+const WORDS = ["apple", "Banana", "cherry", "date", "Fig", "grape", "kiwi", "Lemon", "a", "Zed", "x y", "e-mail"];
+// (CLEAN: no digits in free text, so that a float output followed by text stays recognisable to normalise())
+const TEXT_ALPHABET = [..."abcxyz ABC 0123.,;:!?-_'\"/\n  "].filter((c) => FULL || !/[0-9]/.test(c));
+
+/** Free text between tags: 0-12 characters. */
+export const text = chars(TEXT_ALPHABET, 0, 12);
+
+const word = gs.sampledFrom(WORDS);
+const distinctWords = (max) => gs.arrays(word, { maxSize: max, unique: true });
+
+/** The render context: fixed names with random values, all JSON (what the Ruby side gets). */
+export const context = gs.record({
+  x: word,
+  // (CLEAN: in the default run the HTML sample has no quotes: liquidjs escapes `"` as `&#34;` where Shopify's CGI gives
+  // `&quot;` (candidate liquidjs/14), and its url_encode leaves `'` as encodeURIComponent does where CGI.escape gives
+  // `%27` (candidate liquidjs/17), both found by the 2026-09-23 rewrite's long runs and not yet in bugs.toml; and the
+  // accented sample is all lower case, since sort_natural folds case with Ruby's ASCII-only casecmp there and toLowerCase
+  // here, so `Ü` sorts before `é` in Shopify and after it in liquidjs - candidate liquidjs/15, same origin; `capitalize |
+  // split: "" | sort_natural` could still rebuild the mixed case, one chain in millions)
+  s: gs.sampledFrom(["Hello World", "  padded  ", "a,b,c", "line1\nline2", FULL ? "<b>bold</b> & \"q\"" : "<b>bold</b> & q", "", FULL ? "Ünïcödé" : "ünïcödé", "tic tac toe"]),
+  e: gs.just(""),
+  n: ints(-20, 50),
+  m: ints(1, 9),
+  f: ints(-50, 50).map((k) => (2 * k + 1) / 4), // never integral: `divided_by` an integer is integer division in Ruby (documented)
+  z: gs.just(0),
+  big: ints(1000, 99999),
+  t: gs.just(true),
+  fl: gs.just(false),
+  nl: gs.just(null),
+  words: distinctWords(5),
+  nums: gs.arrays(ints(-20, 50), { maxSize: 5, unique: true }),
+  people: gs.tuples(
+    gs.record({ name: word, age: ints(1, 90), tags: distinctWords(3), active: gs.booleans() }),
+    gs.record({ name: word, age: ints(1, 90), tags: gs.just([]), active: gs.booleans() }),
+    gs.record({ name: word, age: ints(1, 90), active: gs.just(false) }),
+  ),
+  h: gs.record({ k: word, count: ints(0, 9), nested: gs.record({ deep: word }) }),
+});
+
+// ---- expressions -------------------------------------------------------------------------------
+
+// typed variables of the context
+const VARS = {
+  str: ["x", "s", "e", "people[0].name", "h.k", "h.nested.deep", 'h["k"]', "words.first", "words[0]", "people.first.name"],
+  int: ["n", "m", "z", "big", "h.count", "people[1].age", "nums[0]", "words.size", "s.size", "people.size", "nums.size"],
+  num: ["f", "n", "m"],
+  bool: ["t", "fl", "people[0].active"],
+  arr: ["words", "nums", "people[0].tags"],
+  objs: ["people"],
+  nil: ["nl", "missing", "h.nope", "words[99]"],
+};
+
+/** Quoted string literals from xs. */
+const quoted = (xs) => gs.sampledFrom(xs).map((s) => JSON.stringify(s));
+const STR_LITERALS = [...WORDS, "", " ", "a,b", "Hello, World"];
+
+/** Literal sources by type (no array literals in Liquid). */
+export const LITERAL = {
+  str: quoted(STR_LITERALS),
+  int: gs.sampledFrom([0, 1, 2, 3, 7, -1, -3, 10, 100]).map(String),
+  // (CLEAN: binary fractions only; Shopify computes in BigDecimal, so `7 | times: 0.1` is 0.7 there and 0.7000000000000001 here)
+  num: weighted([6, gs.sampledFrom(["1.5", "2.5", "-0.5", FULL ? "0.1" : "0.25", "3.0", "10.75"])], [1, ints(-9, 9).map(String)]),
+  bool: gs.sampledFrom(["true", "false"]),
+  nil: gs.sampledFrom(["nil", "null"]),
+};
+
+/** A plain (filter-free) expression of the type: { src, type }; a "num" is an int 40% of the time, a literal 40% of the time when the type has them. */
+export function atom(type) {
+  const typed = type === "num" ? weighted([60, gs.just("num")], [40, gs.just("int")]) : gs.just(type);
+  return typed.flatMap((type) => {
+    const variable = gs.sampledFrom(VARS[type] || VARS.str).map((src) => ({ src, type }));
+    const lit = LITERAL[type];
+    return lit ? weighted([40, lit.map((src) => ({ src, type }))], [60, variable]) : variable;
+  });
+}
+
+const src = (g) => g.map((e) => e.src);
+const strArg = src(atom("str"));
+const numArg = src(atom("num"));
+const count = (lo, hi) => ints(lo, hi).map(String);
+const none = gs.just([]);
+const one = (g) => g.map((a) => [a]);
+/** `first` alone half the time, else `first, second`. */
+const oneOrTwo = (first, second) => gs.tuples(first, maybe(50, second)).map(([a, b]) => (b === undefined ? [a] : [a, b]));
+/** The output type of at_least/at_most: a "dec" input stays one, anything else is a "num". */
+const decStays = (args, cur) => (cur.type === "dec" ? "dec" : "num");
+
+/**
+ * Filters shared by both engines: { name, in: input types, args: a generator of argument sources, out }.
+ * Types: str int num bool arr objs nil any.
+ */
+export const FILTERS = [
+  // (CLEAN: `size` never follows the untyped first/last of an array, whose value may be an integer: 8 for a Ruby integer,
+  // 0 in liquidjs, documented)
+  { name: "size", in: ["str", "arr", "objs"], onAny: false, args: none, out: "int" },
+  { name: "downcase", in: ["str"], args: none, out: "str" },
+  { name: "upcase", in: ["str"], args: none, out: "str" },
+  { name: "capitalize", in: ["str"], args: none, out: "str" },
+  { name: "escape", in: ["str"], args: none, out: "str" },
+  { name: "escape_once", in: ["str"], args: none, out: "str" },
+  { name: "url_encode", in: ["str"], args: none, out: "str" },
+  { name: "url_decode", in: ["str"], args: none, out: "str" },
+  { name: "strip", in: ["str"], args: none, out: "str" },
+  { name: "lstrip", in: ["str"], args: none, out: "str" },
+  { name: "rstrip", in: ["str"], args: none, out: "str" },
+  { name: "strip_html", in: ["str"], args: none, out: "str" },
+  { name: "strip_newlines", in: ["str"], args: none, out: "str" },
+  { name: "newline_to_br", in: ["str"], args: none, out: "str" },
+  { name: "truncate", in: ["str"], args: oneOrTwo(count(0, 12), LITERAL.str), out: "str" },
+  // (CLEAN: only in the full run. Bug 3 appends the ellipsis at an exact count, which counts above any generated word
+  // count avoided; but under the count liquidjs also trims the string and rejoins its words with single spaces where
+  // Shopify returns it unchanged - `"  padded  " | truncatewords: 8` - and no input shape is safe from that: candidate
+  // liquidjs/10, found by the 2026-09-23 rewrite's long runs, not yet in bugs.toml)
+  ...(FULL ? [{ name: "truncatewords", in: ["str"], args: oneOrTwo(count(0, 4), LITERAL.str), out: "str" }] : []),
+  { name: "slice", in: ["str", "arr"], args: oneOrTwo(count(-5, 5), count(0, 5)), out: "same" },
+  // (CLEAN: no `split: " "` in the default run. Ruby's `split(" ")` is awk-style, skipping leading whitespace and runs of it,
+  // where liquidjs only drops the trailing empty strings, so `" grape" | split: " " | first` is `grape` there and empty
+  // here: candidate liquidjs/11, found by the 2026-09-23 rewrite's long runs, not yet in bugs.toml)
+  { name: "split", in: ["str"], args: one(quoted(FULL ? [",", " ", "", "a", "l"] : [",", "", "a", "l"])), out: "arr" },
+  { name: "append", in: ["str"], args: one(strArg), out: "str" },
+  { name: "prepend", in: ["str"], args: one(strArg), out: "str" },
+  // (CLEAN: no empty pattern for `replace` in the default run. Ruby's `gsub("", x)` puts x before every character and at
+  // the end, liquidjs's `split("").join(x)` only between characters, so `"Hello" | replace: "", "a"` is `aHaealalaoa`
+  // there and `Haealalao` here (and `"" | replace: "", "a"` is `a` there, empty here); replace_first, replace_last and the
+  // remove filters agree: candidate liquidjs/12, found by the 2026-09-23 rewrite's long runs, not yet in bugs.toml)
+  { name: "replace", in: ["str"], args: gs.tuples(FULL ? LITERAL.str : quoted(STR_LITERALS.filter((s) => s !== "")), LITERAL.str), out: "str" },
+  { name: "replace_first", in: ["str"], args: gs.tuples(LITERAL.str, LITERAL.str), out: "str" },
+  { name: "replace_last", in: ["str"], args: gs.tuples(LITERAL.str, LITERAL.str), out: "str" },
+  { name: "remove", in: ["str"], args: one(LITERAL.str), out: "str" },
+  { name: "remove_first", in: ["str"], args: one(LITERAL.str), out: "str" },
+  { name: "remove_last", in: ["str"], args: one(LITERAL.str), out: "str" },
+  { name: "join", in: ["arr"], args: weighted([50, none], [50, one(LITERAL.str)]), out: "str" },
+  { name: "sort", in: ["arr"], args: none, out: "arr" },
+  { name: "sort_natural", in: ["arr"], args: none, out: "arr" },
+  { name: "uniq", in: ["arr"], args: none, out: "arr" },
+  { name: "reverse", in: ["arr"], args: none, out: "arr" },
+  { name: "compact", in: ["arr"], args: none, out: "arr" },
+  { name: "concat", in: ["arr"], args: one(gs.sampledFrom(VARS.arr)), out: "arr" },
+  { name: "first", in: ["arr"], args: none, out: "any" },
+  { name: "last", in: ["arr"], args: none, out: "any" },
+  // (CLEAN: an array of the `tags` arrays or of the `active` booleans is only printed, which both engines do alike.
+  // Shopify's array filters flatten a nested array (InputIterator) and liquidjs's do not, so `people | map: "tags" |
+  // sort_natural` orders differently: candidate liquidjs/9, found by the 2026-09-23 rewrite's long runs, not yet in
+  // bugs.toml. And a boolean reaching `sum`, or a math filter through `first`, meets bug 7)
+  {
+    name: "map",
+    in: ["objs"],
+    args: one(quoted(["name", "age", "active", "tags", "nope"])),
+    out: (args) => (FULL ? "arr" : args[0] === '"tags"' ? "nested" : args[0] === '"active"' ? "bools" : "arr"),
+  },
+  { name: "where", in: ["objs"], args: weighted([50, gs.just(['"active"'])], [50, gs.tuples(gs.just('"name"'), strArg)]), out: "objs" },
+  { name: "sort", in: ["objs"], args: one(quoted(["name", "age"])), out: "objs" },
+  // (CLEAN: the documented BigDecimal difference. Ruby carries a float on from its shortest decimal form in BigDecimal and
+  // JavaScript in binary, which agree while every value is an exact binary fraction (the literals, f, and their sums,
+  // differences and products); a quotient by f or a value rounded to 1-3 places is not one - `10.75 | round: 1 | times:
+  // 3` is 32.4 there and 32.400000000000006 here, and even `| minus: n` can round the two apart - so it is typed "dec"
+  // and only the filters that never round take it: abs, at_least, at_most, ceil and floor)
+  { name: "abs", in: ["num", "int", "dec"], args: none, out: "same" },
+  { name: "plus", in: ["num", "int"], args: one(numArg), out: "num" },
+  { name: "minus", in: ["num", "int"], args: one(numArg), out: "num" },
+  { name: "times", in: ["num", "int"], args: one(numArg), out: "num" },
+  { name: "divided_by", in: ["num", "int"], args: one(FULL ? numArg : gs.sampledFrom(["2.0", "4.0", "0.5", "-2.0", "f"])), out: (args) => (!FULL && args[0] === "f" ? "dec" : "num") },
+  // (CLEAN: integers only, bug 4 loses precision on floats)
+  { name: "modulo", in: FULL ? ["num", "int"] : ["int"], args: one(gs.sampledFrom(FULL ? ["2", "3", "7", "2.5"] : ["2", "3", "7"])), out: "num" },
+  { name: "round", in: ["num", "int"], args: weighted([50, none], [50, one(count(0, 3))]), out: (args) => (!FULL && args.length && args[0] !== "0" ? "dec" : "num") },
+  { name: "ceil", in: ["num", "int", "dec"], args: none, out: "int" },
+  { name: "floor", in: ["num", "int", "dec"], args: none, out: "int" },
+  { name: "at_least", in: ["num", "int", "dec"], args: one(numArg), out: decStays },
+  { name: "at_most", in: ["num", "int", "dec"], args: one(numArg), out: decStays },
+  { name: "sum", in: ["arr"], args: none, out: "num" },
+  // (CLEAN: typed by the argument, and no arrays or booleans in: string filters on an array hit the documented
+  // stringify difference, and a true passed through meets bug 7 in the math filters)
+  { name: "default", in: FULL ? ["str", "nil", "bool", "int", "arr"] : ["str", "nil"], args: one(strArg), out: FULL ? "any" : "str" },
+  { name: "default", in: FULL ? ["str", "nil", "bool", "int", "arr"] : ["int", "nil"], args: one(src(atom("int"))), out: FULL ? "any" : "int" },
+];
+
+const TYPE_ORDER = ["str", "int", "num", "bool", "arr", "objs", "nil"];
+
+// the filter input types a value of `type` may feed (a "nested" array or an array of "bools" feeds none: printed only;
+// a "dec" feeds the filters that list it)
+// (CLEAN: an unknown value never meets an array filter: `first`/`last` on strings are a liquidjs extension)
+const feeds = (type) =>
+  type === "num" ? ["num"] : type === "int" ? ["int", "num"] : type === "any" ? (FULL ? TYPE_ORDER : ["str", "int", "num", "bool", "nil"]) : type === "nested" || type === "bools" ? [] : [type];
+const outType = (f, cur, args) => (typeof f.out === "function" ? f.out(args, cur) : f.out === "same" ? cur.type : f.out);
+
+/** cur with one more shared filter applied (cur itself when none takes its type). */
+function filtered(cur) {
+  const inType = feeds(cur.type);
+  const candidates = FILTERS.filter((f) => FULL || (f.in.some((t) => inType.includes(t)) && (cur.type !== "any" || f.onAny !== false)));
+  if (candidates.length === 0) return gs.just(cur);
+  return gs.sampledFrom(candidates).flatMap((f) =>
+    f.args.map((args) => ({ src: `${cur.src} | ${f.name}${args.length ? ": " + args.join(", ") : ""}`, type: outType(f, cur, args) })),
+  );
+}
+const chain = (cur, k) => (k === 0 ? gs.just(cur) : filtered(cur).flatMap((next) => chain(next, k - 1)));
+/** A type from `types`, a "num" turned into an int 30% of the time. */
+const someType = (types) => gs.sampledFrom(types).flatMap((t) => (t === "num" ? weighted([70, gs.just("num")], [30, gs.just("int")]) : gs.just(t)));
+/** An expression of a type drawn from `typeGen` with 0-3 filters: { src, type }. */
+const exprOf = (typeGen) => gs.tuples(typeGen.flatMap(atom), gs.sampledFrom([0, 0, 1, 1, 2, 3])).flatMap(([a, k]) => chain(a, k));
+
+/** An expression with 0-3 filters: { src, type }, of `wantType` or of a random type. */
+export const expr = (wantType) => exprOf(wantType ? gs.just(wantType) : someType(TYPE_ORDER));
+
+/** An expression whose value prints the same way in both engines: no objects (documented: Ruby inspects hashes, JavaScript gives [object Object]). */
+export const printable = FULL ? expr() : expr().filter((e) => e.type !== "objs");
+
+// ---- tags --------------------------------------------------------------------------------------
+
+// whitespace control: `{%-` / `-%}` and `{{-` / `-}}`, each side 15% of the time
+const ws = gs.tuples(chance(15), chance(15));
+const wrap = ([l, r], open, close, body) => `${open}${l ? "-" : ""} ${body} ${r ? "-" : ""}${close}`;
+
+/** A tag `{% body %}` with random whitespace control (body: a string or a generator of one). */
+export const tag = (body) => gs.tuples(ws, lift(body)).map(([w, b]) => wrap(w, "{%", "%}", b));
+/** An output `{{ src }}` with random whitespace control (src: a string or a generator of one). */
+export const output = (s) => gs.tuples(ws, lift(s)).map(([w, b]) => wrap(w, "{{", "}}", b));
+
+const OPS = ["==", "!=", "<", ">", "<=", ">="];
+
+// comparisons of like types (strings only for equality: the engines order strings differently)
+const cmp = gs.sampledFrom(["int", "num", "str"]).flatMap((type) => {
+  const ops = type === "str" && !FULL ? ["==", "!="] : OPS;
+  return gs.tuples(atom(type), gs.sampledFrom(ops), atom(type)).map(([a, op, b]) => `${a.src} ${op} ${b.src}`);
+});
+const contains = weighted(
+  [50, gs.tuples(gs.sampledFrom(VARS.arr), strArg).map(([arr, a]) => `${arr} contains ${a}`)],
+  [50, gs.tuples(strArg, LITERAL.str).map(([a, lit]) => `${a} contains ${lit}`)],
+);
+const truthy = gs.sampledFrom([...VARS.bool, ...VARS.nil, ...VARS.str, "empty", "blank"]);
+// (CLEAN: no literal nil against blank in the default run: liquidjs's `nil == blank` is false where Shopify's is true,
+// though a nil variable against blank, and `blank == nil`, agree: candidate liquidjs/13, found by the 2026-09-23
+// rewrite's long runs, not yet in bugs.toml)
+const eqmixed = gs
+  .tuples(src(gs.sampledFrom(TYPE_ORDER).flatMap(atom)), gs.sampledFrom(["==", "!="]), gs.sampledFrom(["empty", "blank", "nil", "true", "false", '""', "0"]))
+  .filter(([a, , b]) => FULL || !((a === "nil" || a === "null") && b === "blank"))
+  .map(([a, op, b]) => `${a} ${op} ${b}`);
+const simpleCondition = weighted([3, cmp], [1, contains], [1, truthy], [1, eqmixed]);
+
+/** A condition for if/unless: comparisons of like types, contains, truthiness, and one and/or of those. */
+export const condition = weighted(
+  [2, cmp],
+  [1, contains],
+  [1, truthy],
+  [1, eqmixed],
+  [1, gs.tuples(simpleCondition, gs.sampledFrom(["and", "or"]), simpleCondition).map(([a, op, b]) => `${a} ${op} ${b}`)],
+);
+
+// ---- the template tree -------------------------------------------------------------------------
+//
+// A node is a string, an array of nodes, undefined (nothing), or a record with a `kind`:
+//   assign    {ws, expr}                 `{% assign vN = expr %}`, vN a fresh name recorded with its type
+//   capture   {ws, body, end}            `{% capture cN %}body{% endcapture %}`
+//   outputVar {ws, idx, fallback}        `{{ name }}` of the idx-th (modulo their number) variable assigned so far,
+//                                        or `{{ fallback }}` when none has been
+//   for       {ws, head, lead, pieces, else, end}   `{% for iN in ... %}`, the loop variable in scope for the pieces
+//   loopVar   {ws, field | filter}       `{{ iN }}`, `{{ iN.field }}` or `{{ iN | filter }}` of the innermost loop
+
+/** CLEAN: a body that is never only whitespace and blank tags (Shopify renders such a block as nothing, bug 8). */
+const nonblank = (node) => (FULL ? node : gs.tuples(node, gs.sampledFrom(["a", "b", "c"])));
+
+const printableSrc = src(printable);
+const outputItem = weighted(
+  [70, output(printableSrc)],
+  [30, gs.record({ kind: gs.just("outputVar"), ws, idx: ints(0, 99), fallback: printableSrc })],
+);
+const echo = tag(seq("echo ", printableSrc));
+const comment = seq(tag("comment"), text, maybeText(30, "{{ x }} {% if t %}"), tag("endcomment"));
+// (CLEAN: no `{%- endraw`, bug 1)
+const endraw = FULL ? tag("endraw") : seq("{% endraw ", weighted([70, gs.just("%}")], [30, gs.just("-%}")]));
+const raw = seq(tag("raw"), text, gs.sampledFrom(["{{ x }}", "{% if %}", "{%- raw -%}", ""]), endraw);
+const cycleTags = seq(tag('cycle "one", "two", "three"'), tag('cycle "one", "two", "three"'));
+const incr = gs.sampledFrom(["ctr", "ctr2"]).flatMap((name) => seq(tag(seq(gs.sampledFrom(["increment", "increment", "decrement"]), ` ${name}`)), tag(`increment ${name}`)));
+const assign = gs.record({ kind: gs.just("assign"), ws, expr: expr() });
+const capture = (body) => gs.record({ kind: gs.just("capture"), ws, body, end: tag("endcapture") });
+
+const ifTag = (body) =>
+  gs.tuples(tag(seq("if ", condition)), body, maybe(30, gs.tuples(tag(seq("elsif ", condition)), body)), maybe(50, gs.tuples(tag("else"), body)), tag("endif"));
+const unlessTag = (body) => gs.tuples(tag(seq("unless ", condition)), body, maybe(40, gs.tuples(tag("else"), body)), tag("endunless"));
+
+const caseTag = (body) =>
+  gs.sampledFrom(["str", "int"]).flatMap((type) => {
+    const lit = LITERAL[type];
+    // (CLEAN: distinct alternatives; Shopify renders the body once per matching alternative, so `when 1 or 1` renders it twice)
+    const pair = FULL ? gs.tuples(lit, lit) : gs.tuples(lit, lit).filter(([a, b]) => a !== b);
+    const alternatives = weighted([56, lit], [30, pair.map(([a, b]) => `${a}, ${b}`)], [14, pair.map(([a, b]) => `${a} or ${b}`)]);
+    return gs.tuples(
+      tag(seq("case ", src(atom(type)))),
+      gs.arrays(gs.tuples(tag(seq("when ", alternatives)), body), { minSize: 1, maxSize: 3 }),
+      maybe(50, gs.tuples(tag("else"), body)),
+      tag("endcase"),
+    );
+  });
+
+// (no filters in the collection: liquidjs accepts them as an extension, Shopify does not)
+const small = weighted([50, gs.sampledFrom([0, 1, 2, 3, 7, -1, -3, 10]).map(String)], [50, gs.sampledFrom(["n", "m", "z", "h.count", "people.size", "nums.size", "words.size"])]);
+// (CLEAN: `offset: continue` only on a loop that runs once, i.e. not inside another loop. A liquidjs loop with `offset:
+// continue` records a non-numeric position (src/tags/for.ts adds the collection length to the offset argument itself),
+// so its next run restarts at 0 where Shopify's continues past the end: `{% for j in words offset: continue %}{{ j }}{%
+// endfor %}` twice is `abc|` there and `abc|abc` here. Candidate liquidjs/16, found by the 2026-09-23 rewrite's long
+// runs, not yet in bugs.toml)
+const forHeadAt = (inLoop) =>
+  gs.record({
+    coll: weighted([60, gs.sampledFrom([...VARS.arr, ...VARS.objs])], [40, gs.tuples(small, small).map(([a, b]) => `(${a}..${b})`)]),
+    reversed: chance(20), // Shopify's grammar: `reversed` right after the collection
+    limit: maybe(25, count(0, 4)),
+    offset: maybe(25, inLoop && !FULL ? count(0, 3) : weighted([80, count(0, 3)], [20, gs.just("continue")])),
+  });
+// (CLEAN: named, so that unnamed cycles with different candidates never meet: bug 2)
+// (CLEAN: no 0 among the candidates, bug 5 drops it)
+const cyclePiece = tag(seq("cycle ", FULL ? maybeText(30, '"g": ') : '"g": ', '"a", "b", ', FULL ? LITERAL.int : gs.sampledFrom(["1", "3", "-3", "10"])));
+const breakPiece = seq(tag(ints(1, 3).map((k) => `if forloop.index == ${k}`)), tag(gs.sampledFrom(["break", "continue"])), tag("endif"));
+const forloopPiece = output(gs.sampledFrom(["index", "index0", "rindex", "rindex0", "first", "last", "length", "name"]).map((f) => `forloop.${f}`));
+// the loop variable: a field of it over `people`, else plain or through a string filter (no `size`: Ruby gives 8 for an integer, documented)
+const loopVar = (people) =>
+  people
+    ? gs.record({ kind: gs.just("loopVar"), ws, field: gs.sampledFrom(["name", "age", "tags"]) })
+    : gs.record({ kind: gs.just("loopVar"), ws, filter: maybe(30, gs.sampledFrom(["upcase", "downcase"])) });
+const forTag = (body, inLoop) =>
+  forHeadAt(inLoop).flatMap((head) => {
+    const piece = weighted([2, loopVar(head.coll.startsWith("people"))], [1, forloopPiece], [1, breakPiece], [1, cyclePiece], [1, body]);
+    // (CLEAN: no `else` on a loop with limit/offset, bug 6)
+    const elseAllowed = FULL || (head.limit === undefined && head.offset === undefined);
+    return gs.record({
+      kind: gs.just("for"),
+      ws,
+      head: gs.just(head),
+      lead: nonblank(text),
+      pieces: gs.arrays(piece, { minSize: 1, maxSize: 3 }),
+      else: elseAllowed ? maybe(30, gs.tuples(tag("else"), nonblank(text))) : gs.just(undefined),
+      end: tag("endfor"),
+    });
+  });
+
+/** The items of one template level (`inLoop`: inside a for body): outputs three times as often as any tag, the plain tags before the blocks. */
+function itemAt(depth, inLoop) {
+  const body = bodyAt(depth, inLoop);
+  return weighted(
+    [3, outputItem],
+    [1, echo],
+    [1, comment],
+    [1, raw],
+    [1, cycleTags],
+    [1, incr],
+    [1, assign],
+    [1, capture(body)],
+    [1, ifTag(body)],
+    [1, unlessTag(body)],
+    [1, caseTag(body)],
+    [1, forTag(bodyAt(depth + 1, true), inLoop)],
+  );
+}
+
+/** The body of a block at `depth`: a nested template, or below depth 2 just text and perhaps an output. */
+function bodyAt(depth, inLoop) {
+  return nonblank(depth >= 2 ? gs.tuples(text, maybeText(60, output(printableSrc))) : templateAt(depth + 1, inLoop));
+}
+
+/** A template level: 1-5 items (1-3 when nested), text before an item 60% of the time and after the last 50%. */
+function templateAt(depth, inLoop) {
+  return gs.tuples(gs.arrays(gs.tuples(maybeText(60, text), itemAt(depth, inLoop)), { minSize: 1, maxSize: depth === 0 ? 5 : 3 }), maybeText(50, text));
+}
+
+/** The template text of a tree: names numbered and variables tracked in document order. */
+function render(node, state) {
+  if (node === undefined) return "";
+  if (typeof node === "string") return node;
+  if (Array.isArray(node)) return node.map((part) => render(part, state)).join("");
+  switch (node.kind) {
+    case "assign": {
+      const name = `v${state.counter++}`;
+      state.vars.push({ name, type: node.expr.type });
+      return wrap(node.ws, "{%", "%}", `assign ${name} = ${node.expr.src}`);
+    }
+    case "capture": {
+      const name = `c${state.counter++}`;
+      state.vars.push({ name, type: "str" });
+      return wrap(node.ws, "{%", "%}", `capture ${name}`) + render(node.body, state) + node.end;
+    }
+    case "outputVar": {
+      const vars = state.vars.filter((v) => FULL || v.type !== "objs");
+      return wrap(node.ws, "{{", "}}", vars.length ? vars[node.idx % vars.length].name : node.fallback);
+    }
+    case "for": {
+      const v = `i${state.counter++}`;
+      const { coll, reversed, limit, offset } = node.head;
+      const head = `for ${v} in ${coll}${reversed ? " reversed" : ""}${limit === undefined ? "" : ` limit: ${limit}`}${offset === undefined ? "" : ` offset: ${offset}`}`;
+      state.loops.push(v);
+      const inner = render(node.lead, state) + render(node.pieces, state);
+      state.loops.pop();
+      return wrap(node.ws, "{%", "%}", head) + inner + render(node.else, state) + node.end;
+    }
+    case "loopVar": {
+      const v = state.loops[state.loops.length - 1];
+      return wrap(node.ws, "{{", "}}", node.field ? `${v}.${node.field}` : node.filter ? `${v} | ${node.filter}` : v);
+    }
+    default:
+      throw new Error(`unknown node ${JSON.stringify(node)}`);
+  }
+}
+
+/** A template over the context: text with random whitespace control around the tags and outputs above. */
+export const template = templateAt(0, false).map((tree) => render(tree, { counter: 0, vars: [], loops: [] }));
diff --git a/hegel/hegel-zoo.mjs b/hegel/hegel-zoo.mjs
new file mode 100644
index 0000000..ffb5e91
--- /dev/null
+++ b/hegel/hegel-zoo.mjs
@@ -0,0 +1,141 @@
+// Hegel zoo: the small harness shared by the zoo's TypeScript/JavaScript targets.
+//
+// `property(name, body)` registers a node:test test that runs `body(tc)` under Hegel with
+// HEGEL_TEST_CASES cases (default 100) and the database at HEGEL_DATABASE. With ZOO_COLLECT=1
+// a `fail()` records the mismatch instead of failing, the case ends there, and the counts of
+// mismatches and of the shapes seen (`count(key)`) are printed at the end of the test, so a
+// property can be run over many cases to see every shape at once. `pin(name, body)` is a
+// plain test for one pinned bug: it must fail while the bug is present and pass once it is
+// fixed (the zoo's judge reads an unexpected pass as "fixed upstream?").
+
+import { readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+import { test as nodeTest } from "node:test";
+
+// The Hegel version these tests were written against (the zoo pins it in zoo.toml; upstream
+// would add it to devDependencies). Hegel and esbuild are installed with `npm install --prefix
+// .hegel` so the target's own package.json and lock file stay untouched. Checked at load time so
+// a stray install cannot silently change the engine.
+export const HEGEL_PIN = { "@hegeldev/hegel": "0.4.5" };
+
+const hegelDir = join(dirname(fileURLToPath(import.meta.url)), "..", ".hegel", "node_modules", "@hegeldev", "hegel");
+{
+  const installed = JSON.parse(readFileSync(join(hegelDir, "package.json"), "utf8")).version;
+  if (installed !== HEGEL_PIN["@hegeldev/hegel"]) {
+    throw new Error(`@hegeldev/hegel ${installed} is installed; these tests pin ${HEGEL_PIN["@hegeldev/hegel"]}`);
+  }
+}
+const hegel = await import(pathToFileURL(join(hegelDir, "dist", "index.js")));
+const gs = await import(pathToFileURL(join(hegelDir, "dist", "generators", "index.js")));
+
+/** Hegel's generators, re-exported so the tests import everything from one place. */
+export { gs };
+
+export const collecting = !!process.env.ZOO_COLLECT;
+
+class Collected extends Error {}
+
+let msgs = [];
+let stats = new Map();
+
+/** Report a mismatch: an error normally, a recorded line in collect mode. */
+export function fail(message) {
+  if (collecting) {
+    msgs.push(message);
+    throw new Collected(message);
+  }
+  throw new Error(message);
+}
+
+/** Bump a statistic (the shape of a pinned bug, a generator branch). */
+export function count(key) {
+  stats.set(key, (stats.get(key) || 0) + 1);
+}
+
+function settings() {
+  const s = { testCases: Number(process.env.HEGEL_TEST_CASES) || 100 };
+  if (process.env.HEGEL_DATABASE) {
+    s.database = hegel.Database.fromPath(process.env.HEGEL_DATABASE);
+  }
+  return s;
+}
+
+/** A property: `body(tc)` runs under Hegel; a thrown error (or `fail`) is a failure. */
+export function property(name, body) {
+  nodeTest(name, () => {
+    msgs = [];
+    stats = new Map();
+    hegel.test((tc) => {
+      try {
+        body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** An async property: `body(tc)` may await; runs under Hegel's testAsync with the same settings. */
+export function propertyAsync(name, body) {
+  nodeTest(name, async () => {
+    msgs = [];
+    stats = new Map();
+    await hegel.testAsync(async (tc) => {
+      try {
+        await body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** A pin: a plain test for one recorded bug. */
+export function pin(name, body) {
+  nodeTest(name, body);
+}
+
+/** Structural equality: arrays by position, objects by key set (prototype ignored), else ===. */
+export function same(a, b) {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) {
+      return false;
+    }
+    return a.every((x, i) => same(x, b[i]));
+  }
+  if (a !== null && b !== null && typeof a === "object" && typeof b === "object") {
+    const ka = Object.keys(a).sort();
+    const kb = Object.keys(b).sort();
+    if (ka.length !== kb.length || ka.some((k, i) => k !== kb[i])) {
+      return false;
+    }
+    return ka.every((k) => same(a[k], b[k]));
+  }
+  return a === b;
+}
+
+/** A compact, unambiguous rendering for messages. */
+export function show(x) {
+  return JSON.stringify(x, (k, v) => (v === undefined ? "<undefined>" : v));
+}
diff --git a/hegel/hegel.test.mjs b/hegel/hegel.test.mjs
new file mode 100644
index 0000000..dd59511
--- /dev/null
+++ b/hegel/hegel.test.mjs
@@ -0,0 +1,149 @@
+// Hegel properties for liquidjs against Shopify's Ruby liquid (see README.md in targets/typescript/liquidjs).
+import assert from "node:assert/strict";
+import test from "node:test";
+import { fail, count, propertyAsync, pin } from "./hegel-zoo.mjs";
+import { context, template, printable, output } from "./gen.mjs";
+import { rubyRender, stopOracle } from "./oracle.mjs";
+import { Liquid } from "./liquid.mjs";
+
+const engine = new Liquid();
+
+function jsRender(tpl, data) {
+  try {
+    return { output: engine.parseAndRenderSync(tpl, data) };
+  } catch (e) {
+    return { error: `${e.name}: ${e.message}` };
+  }
+}
+
+const show = (tpl, data) => `template: ${JSON.stringify(tpl)}\ndata: ${JSON.stringify(data)}`;
+
+async function differential(tc, tpl, data) {
+  const js = jsRender(tpl, structuredClone(data)); // (liquidjs writes assigns and counters into the scope it is given)
+  const rb = await rubyRender(tpl, data, { strict: true });
+  if (rb.error) {
+    // the Ruby side rejects the template: liquidjs must reject it too (or the shape is one we skip)
+    if (js.error) {
+      count("both-reject");
+      return;
+    }
+    fail(`Ruby rejects (${rb.error}) but liquidjs renders ${JSON.stringify(js.output)}\n${show(tpl, data)}`);
+  }
+  if (rb.errors.length) {
+    // Ruby writes the error text into the output where liquidjs throws or renders: nothing to compare
+    count("ruby-render-error");
+    tc.assume(false);
+  }
+  if (js.error) fail(`liquidjs throws ${js.error} where Ruby renders ${JSON.stringify(rb.output)}\n${show(tpl, data)}`);
+  // (the one documented difference in the output text, Ruby's `2.0` and `-0.0` for floats, is removed in the oracle itself)
+  if (js.output !== rb.output) {
+    fail(`liquidjs ${JSON.stringify(js.output)}\nruby     ${JSON.stringify(rb.output)}\n${show(tpl, data)}`);
+  }
+  count("same");
+}
+
+propertyAsync("TestHegelTemplatesRenderLikeShopifyLiquid", async (tc) => {
+  const data = tc.draw(context);
+  const tpl = tc.draw(template);
+  await differential(tc, tpl, data);
+});
+
+// a single output of a typed filter chain
+const filterChain = output(printable.map((e) => e.src));
+
+propertyAsync("TestHegelFilterChainsRenderLikeShopifyLiquid", async (tc) => {
+  const data = tc.draw(context);
+  const tpl = tc.draw(filterChain);
+  await differential(tc, tpl, data);
+});
+
+// ---- pins: one test per recorded bug --------------------------------------------------------------
+
+const render = (tpl, data = {}) => engine.parseAndRenderSync(tpl, data);
+
+pin("TestHegelPinRawClosesOnWhitespaceControlledEndraw", () => {
+  assert.equal(render("a{% raw %}x{{ y }}{% endraw -%} b"), "ax{{ y }}b");
+  assert.equal(render("a{% raw %}x{{ y }}{%- endraw %}b"), "ax{{ y }}b");
+});
+
+pin("TestHegelPinUnnamedCyclesWithDifferentCandidatesAreIndependent", () => {
+  assert.equal(render('{% cycle "a", "b" %}{% cycle "x", "y" %}{% cycle "a", "b" %}{% cycle "x", "y" %}'), "axby");
+  assert.equal(render('{% cycle 1, 2 %}{% cycle "1", "2" %}{% cycle 1, 2 %}'), "112");
+});
+
+pin("TestHegelPinTruncatewordsKeepsAStringWithExactlyThatManyWords", () => {
+  assert.equal(render('{{ "1 2 3" | truncatewords: 3 }}'), "1 2 3");
+  assert.equal(render('{{ "1 2 3" | truncatewords: 2 }}'), "1 2...");
+  assert.equal(render('{{ "cherry" | truncatewords: 0 }}'), "cherry");
+});
+
+pin("TestHegelPinModuloOfAFloatKeepsItsPrecision", () => {
+  assert.equal(render("{{ 0.1 | modulo: 7 }}"), "0.1");
+  assert.equal(render("{{ 0.1 | modulo: 3 }}"), "0.1");
+  assert.equal(render("{{ -1 | modulo: 7 }}"), "6");
+});
+
+pin("TestHegelPinCycleEmitsAZeroOrFalseCandidate", () => {
+  assert.equal(render("{% cycle 0, 1 %}|{% cycle 0, 1 %}"), "0|1");
+  assert.equal(render("{% cycle false, true %}"), "false");
+  assert.equal(render("{% cycle z, 1 %}", { z: 0 }), "0");
+});
+
+pin("TestHegelPinForElseRendersWhenLimitOrOffsetEmptiesTheLoop", () => {
+  assert.equal(render("{% for i in (1..3) limit: 0 %}x{% else %}empty{% endfor %}"), "empty");
+  assert.equal(render("{% for i in words offset: 3 %}x{% else %}empty{% endfor %}", { words: ["a"] }), "empty");
+});
+
+pin("TestHegelPinMathFiltersTreatTrueAsZero", () => {
+  assert.equal(render("{{ true | plus: 1 }}"), "1");
+  assert.equal(render("{{ true | times: 2 }}"), "0");
+  assert.equal(render("{{ true | abs }}"), "0");
+});
+
+pin("TestHegelPinBlockWithOnlyWhitespaceRendersNothing", () => {
+  assert.equal(render("{% if true %} {% endif %}x"), "x");
+  assert.equal(render("{% for i in (1..2) %} {% endfor %}x"), "x");
+  assert.equal(render("{% if true %} {% assign a = 1 %} {% endif %}x"), "x");
+});
+
+pin("TestHegelPinArrayFiltersFlattenNestedArrays", () => {
+  // liquidjs/9: Shopify's array filters flatten nested arrays first
+  const a = [["Fig", "apple"], [], null, ["Zed"]];
+  assert.equal(render('{{ a | reverse | join: "," }}', { a }), "Zed,,apple,Fig");
+  assert.equal(render('{{ a | sort | join: "," }}', { a }), "Fig,Zed,apple,");
+});
+
+pin("TestHegelPinTruncatewordsUnderTheCountKeepsTheString", () => {
+  // liquidjs/10: a string with fewer words than the count comes back unchanged in Shopify
+  assert.equal(render('{{ "  padded  " | truncatewords: 8 }}|'), "  padded  |");
+});
+
+pin("TestHegelPinSplitOnASpaceIsAwkStyle", () => {
+  // liquidjs/11: Ruby's split(" ") skips leading blanks and runs of blanks
+  assert.equal(render('{{ " grape" | split: " " | first }}|'), "grape|");
+  assert.equal(render('{{ "a  b" | split: " " | size }}'), "2");
+});
+
+pin("TestHegelPinReplaceWithAnEmptyPatternInsertsAtBothEnds", () => {
+  // liquidjs/12: gsub("") matches before every character and at the end
+  assert.equal(render('{{ "Hello" | replace: "", "a" }}'), "aHaealalaoa");
+});
+
+pin("TestHegelPinEscapeWritesQuotAsShopify", () => {
+  // liquidjs/13: CGI.escapeHTML writes &quot;
+  assert.equal(render("{{ q | escape }}", { q: '"' }), "&quot;");
+  assert.equal(render("{{ q | escape_once }}", { q: '"' }), "&quot;");
+});
+
+pin("TestHegelPinUrlEncodeEscapesApostropheAndParentheses", () => {
+  // liquidjs/14: CGI.escape encodes ' ( ) ! *
+  assert.equal(render("{{ s | url_encode }}", { s: "it's (x)! *~" }), "it%27s+%28x%29%21+%2A~");
+});
+
+pin("TestHegelPinOffsetContinueResumesAcrossLoops", () => {
+  // liquidjs/15: the second loop with offset: continue starts where the first ended
+  const t = "{% for j in words offset: continue %}{{ j }}{% endfor %}|{% for j in words offset: continue %}{{ j }}{% endfor %}";
+  assert.equal(render(t, { words: ["a", "b", "c"] }), "abc|");
+});
+
+test("stop the oracle", () => stopOracle());
