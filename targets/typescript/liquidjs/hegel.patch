+  gs.tuples(gs.sampledFrom(["plus", "minus", "times", "at_least", "at_most"]), numArg).map(([f, a]) => `${f}: ${a}`),
+  gs.sampledFrom(["2.0", "4.0", "0.5", "-2.0", "f"]).map((a) => `divided_by: ${a}`),
+  gs.sampledFrom(["2", "3", "7", "2.5"]).map((a) => `modulo: ${a}`),
+  gs.sampledFrom(["abs", "ceil", "floor", "round"]),
