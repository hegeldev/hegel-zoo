+// (KNOWN: `offset: continue` on a loop inside another loop, so that it runs more than once. A liquidjs loop with
+// `offset: continue` records a non-numeric position (src/tags/for.ts adds the collection length to the offset argument
+// itself), so its next run restarts at 0 where Shopify's continues past the end: `{% for j in words offset: continue
+// %}{{ j }}{% endfor %}` twice is `abc|` there and `abc|abc` here, liquidjs/15. Under HEGEL_NO_KNOWN=1 only a loop
+// outside any other loop takes `offset: continue`)
+const forHeadAt = (inLoop) =>
+  gs.record({
+    coll: weighted([60, gs.sampledFrom([...VARS.arr, ...VARS.objs])], [40, gs.tuples(small, small).map(([a, b]) => `(${a}..${b})`)]),
+    reversed: chance(20), // Shopify's grammar: `reversed` right after the collection
+    limit: maybe(25, count(0, 4)),
+    offset: maybe(25, inLoop && noKnown ? count(0, 3) : weighted([80, count(0, 3)], [20, gs.just("continue")])),
+  });
+// (KNOWN: unnamed 30% of the time, so that unnamed cycles with different candidates meet and share liquidjs's one
+// counter, liquidjs/2; and a 0 or a false among the candidates, which liquidjs's render loop drops, liquidjs/5. Under
+// HEGEL_NO_KNOWN=1 every cycle is named and no candidate is falsy. Three candidates always, and literals: liquidjs keys
+// a named cycle by the number of its candidates as well, and Shopify keys an unnamed one with a variable candidate by
+// that variable's object id, both quirks of their own)
+const cyclePiece = tag(seq("cycle ", noKnown ? '"g": ' : maybeText(30, '"g": '), '"a", "b", ', gs.sampledFrom(noKnown ? ["1", "3", "-3", "10"] : ["0", "1", "3", "-3", "10", "false"])));
+const breakPiece = seq(tag(ints(1, 3).map((k) => `if forloop.index == ${k}`)), tag(gs.sampledFrom(["break", "continue"])), tag("endif"));
+const forloopPiece = output(gs.sampledFrom(["index", "index0", "rindex", "rindex0", "first", "last", "length", "name"]).map((f) => `forloop.${f}`));
