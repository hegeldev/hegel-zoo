index 0000000..4cd4d1f
--- /dev/null
+++ b/hegel/oracle.rb
@@ -0,0 +1,69 @@
+# The oracle: Shopify's Ruby liquid gem, one JSON request per line on stdin, one JSON reply per
+# line on stdout. Request: {"template": "...", "data": {...}, "strict": true|false}.
+# Reply: {"output": "..."} or {"error": "ClassName: message"}.
+require "json"
+require "liquid"
+
+# Ruby prints a float as `2.0` or `-0.0` where JavaScript (and so liquidjs) prints `2` or `0`, a
+# documented difference. Printing floats the JavaScript way here makes the two outputs comparable
+# as they are: a textual normalisation of the rendered output cannot tell `2.0` followed by `5`
+# from `2.05`. (Liquid's own uses of Float#to_s - `BigDecimal(obj.to_s)` in Utils.to_number -
+# read both forms.)
+class Float
+  alias_method :ruby_to_s, :to_s
+  def to_s
+    s = ruby_to_s
+    return "0" if s == "-0.0"
+    s.end_with?(".0") ? s[0...-2] : s
+  end
+end
+
+# Shopify's liquid runs inside Rails, where ActiveSupport gives every object `blank?`, and its
+# documentation of the `blank` literal (nil, false, an empty or whitespace string, an empty array or
+# hash) is ActiveSupport's definition; the bare gem has none, so `x == blank` is nil for every x
+# (Condition#equal_variables sends `blank?` only if the value responds to it). These are
+# ActiveSupport's definitions (active_support/core_ext/object/blank.rb).
+class Object
+  def blank?
+    respond_to?(:empty?) ? !!empty? : !self
+  end
+end
+class NilClass
+  def blank?
+    true
+  end
+end
+class FalseClass
+  def blank?
+    true
+  end
+end
+class TrueClass
+  def blank?
+    false
+  end
+end
+class Numeric
+  def blank?
+    false
+  end
+end
+class String
+  def blank?
+    /\A[[:space:]]*\z/.match?(self)
+  end
+end
+
+STDOUT.sync = true
+
+STDIN.each_line do |line|
+  req = JSON.parse(line)
+  begin
+    template = Liquid::Template.parse(req["template"], error_mode: (req["strict"] ? :strict : :lax))
+    output = template.render(req["data"], { strict_variables: !!req["strict_variables"], strict_filters: !!req["strict_filters"] })
+    errors = template.errors.map { |e| "#{e.class.name}: #{e.message}" }
+    puts JSON.generate({ "output" => output, "errors" => errors })
+  rescue Exception => e
+    puts JSON.generate({ "error" => "#{e.class.name}: #{e.message}" })
+  end
+end
