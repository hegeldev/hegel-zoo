@@ -0,0 +1,41 @@
+// Bridge to the Ruby oracle (hegel/oracle.rb): one persistent `ruby` process, JSON lines in and
+// out, requests answered in order.
+import { spawn } from "node:child_process";
+import { createInterface } from "node:readline";
+import { dirname, join } from "node:path";
+import { fileURLToPath } from "node:url";
+
+const here = dirname(fileURLToPath(import.meta.url));
+
+let child;
+let lines;
+const queue = [];
+
+function start() {
+  child = spawn("ruby", [join(here, "oracle.rb")], { stdio: ["pipe", "pipe", "inherit"] });
+  lines = createInterface({ input: child.stdout });
+  lines.on("line", (line) => {
+    const next = queue.shift();
+    if (next) next(JSON.parse(line));
+  });
+  child.on("exit", (code) => {
+    for (const next of queue.splice(0)) next({ error: `oracle exited with ${code}` });
+    child = undefined;
+  });
+}
+
+/** Render with Shopify's liquid: { output, errors } or { error }. */
+export function rubyRender(template, data, opts = {}) {
+  if (!child) start();
+  return new Promise((resolve) => {
+    queue.push(resolve);
+    child.stdin.write(JSON.stringify({ template, data, ...opts }) + "\n");
+  });
+}
+
+export function stopOracle() {
+  if (child) {
+    child.stdin.end();
+    child = undefined;
+  }
+}
