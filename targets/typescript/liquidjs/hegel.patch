+const cycleWithAFalsyCandidate = withContext(
+  gs.record({ name: maybe(30, gs.just('"g": ')), before: gs.arrays(plainCandidate, { maxSize: 2 }), falsy: gs.sampledFrom(["0", "false"]), after: gs.arrays(plainCandidate, { maxSize: 1 }), extra: ints(0, 2) }).flatMap(
