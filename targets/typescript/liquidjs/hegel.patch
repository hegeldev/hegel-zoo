diff --git a/hegel/gen.mjs b/hegel/gen.mjs
new file mode 100644
index 0000000..f64d81b
--- /dev/null
+++ b/hegel/gen.mjs
@@ -0,0 +1,331 @@
+// Generators for liquidjs vs Shopify liquid: a random render context and a random template over
+// the tags and filters both engines implement, with expressions typed so filters get arguments of
+// the kinds their documentation describes (the default run); ZOO_FULL loosens that.
+import { n, pick, chance, word } from "./hegel-zoo.mjs";
+
+export const FULL = !!process.env.ZOO_FULL;
+
+const WORDS = ["apple", "Banana", "cherry", "date", "Fig", "grape", "kiwi", "Lemon", "a", "Zed", "x y", "e-mail"];
+// (CLEAN: no digits in free text, so that a float output followed by text stays recognisable to normalise())
+const TEXT_ALPHABET = FULL ? "abcxyz ABC 0123.,;:!?-_'\"/\n  " : "abcxyz ABC 0123.,;:!?-_'\"/\n  ".replace(/[0-9]/g, "");
+
+export function text(tc) {
+  return word(tc, TEXT_ALPHABET, 0, 12);
+}
+
+function distinct(tc, k, gen) {
+  const out = [];
+  let guard = 0;
+  while (out.length < k && guard++ < 50) {
+    const v = gen(tc);
+    if (!out.includes(v)) out.push(v);
+  }
+  return out;
+}
+
+/** The render context: fixed names with random values, all JSON (what the Ruby side gets). */
+export function context(tc) {
+  const words = distinct(tc, n(tc, 0, 5), (tc) => pick(tc, WORDS));
+  const nums = distinct(tc, n(tc, 0, 5), (tc) => n(tc, -20, 50));
+  return {
+    x: pick(tc, WORDS),
+    s: pick(tc, ["Hello World", "  padded  ", "a,b,c", "line1\nline2", "<b>bold</b> & \"q\"", "", "Ünïcödé", "tic tac toe"]),
+    e: "",
+    n: n(tc, -20, 50),
+    m: n(tc, 1, 9),
+    f: (2 * n(tc, -50, 50) + 1) / 4, // never integral: `divided_by` an integer is integer division in Ruby (documented)
+    z: 0,
+    big: n(tc, 1000, 99999),
+    t: true,
+    fl: false,
+    nl: null,
+    words,
+    nums,
+    people: [
+      { name: pick(tc, WORDS), age: n(tc, 1, 90), tags: distinct(tc, n(tc, 0, 3), (tc) => pick(tc, WORDS)), active: chance(tc, 50) },
+      { name: pick(tc, WORDS), age: n(tc, 1, 90), tags: [], active: chance(tc, 50) },
+      { name: pick(tc, WORDS), age: n(tc, 1, 90), active: false },
+    ],
+    h: { k: pick(tc, WORDS), count: n(tc, 0, 9), nested: { deep: pick(tc, WORDS) } },
+  };
+}
+
+// typed variables of the context
+const VARS = {
+  str: ["x", "s", "e", "people[0].name", "h.k", "h.nested.deep", 'h["k"]', "words.first", "words[0]", "people.first.name"],
+  int: ["n", "m", "z", "big", "h.count", "people[1].age", "nums[0]", "words.size", "s.size", "people.size", "nums.size"],
+  num: ["f", "n", "m"],
+  bool: ["t", "fl", "people[0].active"],
+  arr: ["words", "nums", "people[0].tags"],
+  objs: ["people"],
+  nil: ["nl", "missing", "h.nope", "words[99]"],
+};
+
+export function literal(tc, type) {
+  switch (type) {
+    case "str":
+      return JSON.stringify(pick(tc, [...WORDS, "", " ", "a,b", "Hello, World"]));
+    case "int":
+      return String(pick(tc, [0, 1, 2, 3, 7, -1, -3, 10, 100]));
+    case "num":
+      // (CLEAN: binary fractions only; Shopify computes in BigDecimal, so `7 | times: 0.1` is 0.7 there and 0.7000000000000001 here)
+      return pick(tc, ["1.5", "2.5", "-0.5", FULL ? "0.1" : "0.25", "3.0", "10.75", String(n(tc, -9, 9))]);
+    case "bool":
+      return pick(tc, ["true", "false"]);
+    case "nil":
+      return pick(tc, ["nil", "null"]);
+    case "arr":
+      return null; // no array literals in Liquid
+    default:
+      return null;
+  }
+}
+
+/** A plain (filter-free) expression of the type: { src, type }. */
+export function atom(tc, type) {
+  if (type === "num" && chance(tc, 40)) type = "int";
+  const lit = literal(tc, type);
+  if (lit !== null && chance(tc, 40)) return { src: lit, type };
+  const vars = VARS[type] || VARS.str;
+  return { src: pick(tc, vars), type: type === "num" ? "num" : type };
+}
+
+/**
+ * Filters shared by both engines: { name, in: input types, args: (tc) => [arg src...], out }.
+ * Types: str int num bool arr objs nil any.
+ */
+export const FILTERS = [
+  { name: "size", in: ["str", "arr", "objs"], args: () => [], out: "int" },
+  { name: "downcase", in: ["str"], args: () => [], out: "str" },
+  { name: "upcase", in: ["str"], args: () => [], out: "str" },
+  { name: "capitalize", in: ["str"], args: () => [], out: "str" },
+  { name: "escape", in: ["str"], args: () => [], out: "str" },
+  { name: "escape_once", in: ["str"], args: () => [], out: "str" },
+  { name: "url_encode", in: ["str"], args: () => [], out: "str" },
+  { name: "url_decode", in: ["str"], args: () => [], out: "str" },
+  { name: "strip", in: ["str"], args: () => [], out: "str" },
+  { name: "lstrip", in: ["str"], args: () => [], out: "str" },
+  { name: "rstrip", in: ["str"], args: () => [], out: "str" },
+  { name: "strip_html", in: ["str"], args: () => [], out: "str" },
+  { name: "strip_newlines", in: ["str"], args: () => [], out: "str" },
+  { name: "newline_to_br", in: ["str"], args: () => [], out: "str" },
+  { name: "truncate", in: ["str"], args: (tc) => (chance(tc, 50) ? [String(n(tc, 0, 12))] : [String(n(tc, 0, 12)), literal(tc, "str")]), out: "str" },
+  // (CLEAN: counts above any generated word count, bug 3 appends the ellipsis at an exact count)
+  { name: "truncatewords", in: ["str"], args: (tc) => { const w = FULL ? String(n(tc, 0, 4)) : pick(tc, ["8", "15"]); return chance(tc, 50) ? [w] : [w, literal(tc, "str")]; }, out: "str" },
+  { name: "slice", in: ["str", "arr"], args: (tc) => (chance(tc, 50) ? [String(n(tc, -5, 5))] : [String(n(tc, -5, 5)), String(n(tc, 0, 5))]), out: "same" },
+  { name: "split", in: ["str"], args: (tc) => [JSON.stringify(pick(tc, [",", " ", "", "a", "l"]))], out: "arr" },
+  { name: "append", in: ["str"], args: (tc) => [atom(tc, "str").src], out: "str" },
+  { name: "prepend", in: ["str"], args: (tc) => [atom(tc, "str").src], out: "str" },
+  { name: "replace", in: ["str"], args: (tc) => [literal(tc, "str"), literal(tc, "str")], out: "str" },
+  { name: "replace_first", in: ["str"], args: (tc) => [literal(tc, "str"), literal(tc, "str")], out: "str" },
+  { name: "replace_last", in: ["str"], args: (tc) => [literal(tc, "str"), literal(tc, "str")], out: "str" },
+  { name: "remove", in: ["str"], args: (tc) => [literal(tc, "str")], out: "str" },
+  { name: "remove_first", in: ["str"], args: (tc) => [literal(tc, "str")], out: "str" },
+  { name: "remove_last", in: ["str"], args: (tc) => [literal(tc, "str")], out: "str" },
+  { name: "join", in: ["arr"], args: (tc) => (chance(tc, 50) ? [] : [literal(tc, "str")]), out: "str" },
+  { name: "sort", in: ["arr"], args: () => [], out: "arr" },
+  { name: "sort_natural", in: ["arr"], args: () => [], out: "arr" },
+  { name: "uniq", in: ["arr"], args: () => [], out: "arr" },
+  { name: "reverse", in: ["arr"], args: () => [], out: "arr" },
+  { name: "compact", in: ["arr"], args: () => [], out: "arr" },
+  { name: "concat", in: ["arr"], args: (tc) => [pick(tc, VARS.arr)], out: "arr" },
+  { name: "first", in: ["arr"], args: () => [], out: "any" },
+  { name: "last", in: ["arr"], args: () => [], out: "any" },
+  { name: "map", in: ["objs"], args: (tc) => [JSON.stringify(pick(tc, ["name", "age", "active", "tags", "nope"]))], out: "arr" },
+  { name: "where", in: ["objs"], args: (tc) => (chance(tc, 50) ? ['"active"'] : ['"name"', atom(tc, "str").src]), out: "objs" },
+  { name: "sort", in: ["objs"], args: (tc) => [JSON.stringify(pick(tc, ["name", "age"]))], out: "objs" },
+  { name: "abs", in: ["num", "int"], args: () => [], out: "same" },
+  { name: "plus", in: ["num", "int"], args: (tc) => [atom(tc, "num").src], out: "num" },
+  { name: "minus", in: ["num", "int"], args: (tc) => [atom(tc, "num").src], out: "num" },
+  { name: "times", in: ["num", "int"], args: (tc) => [atom(tc, "num").src], out: "num" },
+  { name: "divided_by", in: ["num", "int"], args: (tc) => [FULL ? atom(tc, "num").src : pick(tc, ["2.0", "4.0", "0.5", "-2.0", "f"])], out: "num" },
+  // (CLEAN: integers only, bug 4 loses precision on floats)
+  { name: "modulo", in: FULL ? ["num", "int"] : ["int"], args: (tc) => [pick(tc, FULL ? ["2", "3", "7", "2.5"] : ["2", "3", "7"])], out: "num" },
+  { name: "round", in: ["num", "int"], args: (tc) => (chance(tc, 50) ? [] : [String(n(tc, 0, 3))]), out: "num" },
+  { name: "ceil", in: ["num", "int"], args: () => [], out: "int" },
+  { name: "floor", in: ["num", "int"], args: () => [], out: "int" },
+  { name: "at_least", in: ["num", "int"], args: (tc) => [atom(tc, "num").src], out: "num" },
+  { name: "at_most", in: ["num", "int"], args: (tc) => [atom(tc, "num").src], out: "num" },
+  { name: "sum", in: ["arr"], args: () => [], out: "num" },
+  // (CLEAN: typed by the argument, and no arrays or booleans in: string filters on an array hit the documented
+  // stringify difference, and a true passed through meets bug 7 in the math filters)
+  { name: "default", in: FULL ? ["str", "nil", "bool", "int", "arr"] : ["str", "nil"], args: (tc) => [atom(tc, "str").src], out: FULL ? "any" : "str" },
+  { name: "default", in: FULL ? ["str", "nil", "bool", "int", "arr"] : ["int", "nil"], args: (tc) => [atom(tc, "int").src], out: FULL ? "any" : "int" },
+];
+
+const TYPE_ORDER = ["str", "int", "num", "bool", "arr", "objs", "nil"];
+
+/** An expression with 0-3 filters: { src, type }. */
+export function expr(tc, wantType) {
+  let type = wantType || pick(tc, TYPE_ORDER);
+  if (type === "num" && !wantType && chance(tc, 30)) type = "int";
+  let cur = atom(tc, type);
+  const count = pick(tc, [0, 0, 1, 1, 2, 3]);
+  for (let i = 0; i < count; i++) {
+    // (CLEAN: an unknown value never meets an array filter: `first`/`last` on strings are a liquidjs extension)
+    const inType = cur.type === "num" ? ["num"] : cur.type === "int" ? ["int", "num"] : cur.type === "any" ? (FULL ? TYPE_ORDER : ["str", "int", "num", "bool", "nil"]) : [cur.type];
+    const candidates = FILTERS.filter((f) => FULL || f.in.some((t) => inType.includes(t)));
+    if (candidates.length === 0) break;
+    const f = pick(tc, candidates);
+    const args = f.args(tc);
+    cur = { src: `${cur.src} | ${f.name}${args.length ? ": " + args.join(", ") : ""}`, type: f.out === "same" ? cur.type : f.out };
+  }
+  return cur;
+}
+
+/** An expression whose value prints the same way in both engines: no objects (documented: Ruby inspects hashes, JavaScript gives [object Object]). */
+export function printable(tc) {
+  let e = expr(tc);
+  let guard = 0;
+  while (!FULL && e.type === "objs" && guard++ < 10) e = expr(tc);
+  return e;
+}
+
+// ---- tags ------------------------------------------------------------------------------------
+
+function ws(tc, open, close) {
+  // whitespace control: `{%-` / `-%}` and `{{-` / `-}}`
+  const l = chance(tc, 15) ? "-" : "";
+  const r = chance(tc, 15) ? "-" : "";
+  return [open + l, r + close];
+}
+
+export function tag(tc, body) {
+  const [o, c] = ws(tc, "{%", "%}");
+  return `${o} ${body} ${c}`;
+}
+
+export function output(tc, src) {
+  const [o, c] = ws(tc, "{{", "}}");
+  return `${o} ${src} ${c}`;
+}
+
+const OPS = ["==", "!=", "<", ">", "<=", ">="];
+
+/** A condition for if/unless: comparisons of like types, contains, truthiness, and/or. */
+export function condition(tc, depth = 0) {
+  const k = pick(tc, ["cmp", "cmp", "contains", "truthy", "eqmixed", depth < 1 ? "andor" : "cmp"]);
+  switch (k) {
+    case "cmp": {
+      const type = pick(tc, ["int", "num", "str"]);
+      const ops = type === "str" && !FULL ? ["==", "!="] : OPS;
+      return `${atom(tc, type).src} ${pick(tc, ops)} ${atom(tc, type).src}`;
+    }
+    case "contains":
+      return chance(tc, 50) ? `${pick(tc, VARS.arr)} contains ${atom(tc, "str").src}` : `${atom(tc, "str").src} contains ${literal(tc, "str")}`;
+    case "truthy":
+      return pick(tc, [...VARS.bool, ...VARS.nil, ...VARS.str, "empty", "blank"]);
+    case "eqmixed":
+      return `${atom(tc, pick(tc, TYPE_ORDER)).src} ${pick(tc, ["==", "!="])} ${pick(tc, ["empty", "blank", "nil", "true", "false", '""', "0"])}`;
+    default:
+      return `${condition(tc, depth + 1)} ${pick(tc, ["and", "or"])} ${condition(tc, depth + 1)}`;
+  }
+}
+
+/** A template: { src, vars } where vars are names assigned along the way (for later output). */
+export function template(tc, depth = 0, state = { counter: 0, vars: [] }) {
+  const count = n(tc, 1, depth === 0 ? 5 : 3);
+  let src = "";
+  for (let i = 0; i < count; i++) {
+    src += chance(tc, 60) ? text(tc) : "";
+    src += item(tc, depth, state);
+  }
+  src += chance(tc, 50) ? text(tc) : "";
+  return src;
+}
+
+/** CLEAN: a body that is never only whitespace and blank tags (Shopify renders such a block as nothing, bug 8). */
+function nonblank(tc, s) {
+  return FULL ? s : s + pick(tc, ["a", "b", "c"]);
+}
+
+function body(tc, depth, state) {
+  return nonblank(tc, depth >= 2 ? text(tc) + (chance(tc, 60) ? output(tc, printable(tc).src) : "") : template(tc, depth + 1, state));
+}
+
+function item(tc, depth, state) {
+  const kinds = ["output", "output", "output", "assign", "if", "for", "case", "unless", "capture", "comment", "raw", "cycle", "incr", "echo"];
+  const k = pick(tc, kinds);
+  switch (k) {
+    case "output": {
+      const vars = state.vars.filter((v) => FULL || v.type !== "objs");
+      const e = chance(tc, 30) && vars.length ? { src: pick(tc, vars).name } : printable(tc);
+      return output(tc, e.src);
+    }
+    case "assign": {
+      const name = `v${state.counter++}`;
+      const e = expr(tc);
+      state.vars.push({ name, type: e.type });
+      return tag(tc, `assign ${name} = ${e.src}`);
+    }
+    case "capture": {
+      const name = `c${state.counter++}`;
+      state.vars.push({ name, type: "str" });
+      return tag(tc, `capture ${name}`) + body(tc, depth, state) + tag(tc, "endcapture");
+    }
+    case "if": {
+      let s = tag(tc, `if ${condition(tc)}`) + body(tc, depth, state);
+      if (chance(tc, 30)) s += tag(tc, `elsif ${condition(tc)}`) + body(tc, depth, state);
+      if (chance(tc, 50)) s += tag(tc, "else") + body(tc, depth, state);
+      return s + tag(tc, "endif");
+    }
+    case "unless": {
+      let s = tag(tc, `unless ${condition(tc)}`) + body(tc, depth, state);
+      if (chance(tc, 40)) s += tag(tc, "else") + body(tc, depth, state);
+      return s + tag(tc, "endunless");
+    }
+    case "case": {
+      const type = pick(tc, ["str", "int"]);
+      let s = tag(tc, `case ${atom(tc, type).src}`);
+      for (let i = 0, m = n(tc, 1, 3); i < m; i++) {
+        // (CLEAN: distinct alternatives; Shopify renders the body once per matching alternative, so `when 1 or 1` renders it twice)
+        const alt = () => literal(tc, type);
+        let a = alt(), b = alt();
+        for (let guard = 0; !FULL && a === b && guard < 10; guard++) b = alt();
+        const whens = chance(tc, 30) ? `${a}, ${b}` : chance(tc, 20) ? `${a} or ${b}` : a;
+        s += tag(tc, `when ${whens}`) + body(tc, depth, state);
+      }
+      if (chance(tc, 50)) s += tag(tc, "else") + body(tc, depth, state);
+      return s + tag(tc, "endcase");
+    }
+    case "for": {
+      const v = `i${state.counter++}`;
+      // (no filters in the collection: liquidjs accepts them as an extension, Shopify does not)
+      const small = () => (chance(tc, 50) ? String(pick(tc, [0, 1, 2, 3, 7, -1, -3, 10])) : pick(tc, ["n", "m", "z", "h.count", "people.size", "nums.size", "words.size"]));
+      const coll = chance(tc, 40) ? `(${small()}..${small()})` : pick(tc, [...VARS.arr, ...VARS.objs]);
+      let head = `for ${v} in ${coll}`;
+      if (chance(tc, 20)) head += " reversed"; // Shopify's grammar: `reversed` right after the collection
+      if (chance(tc, 25)) head += ` limit: ${n(tc, 0, 4)}`;
+      if (chance(tc, 25)) head += ` offset: ${chance(tc, 80) ? n(tc, 0, 3) : "continue"}`;
+      let inner = nonblank(tc, text(tc));
+      const pieces = n(tc, 1, 3);
+      for (let i = 0; i < pieces; i++) {
+        const p = pick(tc, ["var", "var", "forloop", "break", "cycle", "body"]);
+        if (p === "var") inner += output(tc, coll.startsWith("people") ? `${v}.${pick(tc, ["name", "age", "tags"])}` : chance(tc, 70) ? v : `${v} | ${pick(tc, ["upcase", "downcase"])}`); // (no `size`: Ruby gives 8 for an integer, documented)
+        else if (p === "forloop") inner += output(tc, `forloop.${pick(tc, ["index", "index0", "rindex", "rindex0", "first", "last", "length", "name"])}`);
+        else if (p === "break") inner += tag(tc, `if forloop.index == ${n(tc, 1, 3)}`) + tag(tc, pick(tc, ["break", "continue"])) + tag(tc, "endif");
+        // (CLEAN: named, so that unnamed cycles with different candidates never meet: bug 2)
+        // (CLEAN: no 0 among the candidates, bug 5 drops it)
+        else if (p === "cycle") inner += tag(tc, `cycle ${!FULL || chance(tc, 30) ? '"g": ' : ""}"a", "b", ${FULL ? literal(tc, "int") : pick(tc, ["1", "3", "-3", "10"])}`);
+        else inner += body(tc, depth + 1, state);
+      }
+      let s = tag(tc, head) + inner;
+      // (CLEAN: no `else` on a loop with limit/offset, bug 6)
+      if (chance(tc, 30) && (FULL || !/limit|offset/.test(head))) s += tag(tc, "else") + nonblank(tc, text(tc));
+      return s + tag(tc, "endfor");
+    }
+    case "comment":
+      return tag(tc, "comment") + text(tc) + (chance(tc, 30) ? "{{ x }} {% if t %}" : "") + tag(tc, "endcomment");
+    case "raw":
+      // (CLEAN: no `{%- endraw`, bug 1)
+      return tag(tc, "raw") + text(tc) + pick(tc, ["{{ x }}", "{% if %}", "{%- raw -%}", ""]) + (FULL ? tag(tc, "endraw") : `{% endraw ${chance(tc, 30) ? "-%}" : "%}"}`);
+    case "cycle":
+      return tag(tc, `cycle "one", "two", "three"`) + tag(tc, `cycle "one", "two", "three"`);
+    case "incr": {
+      const name = pick(tc, ["ctr", "ctr2"]);
+      return tag(tc, `${pick(tc, ["increment", "increment", "decrement"])} ${name}`) + tag(tc, `increment ${name}`);
+    }
+    default:
+      return tag(tc, `echo ${printable(tc).src}`);
+  }
+}
diff --git a/hegel/hegel-zoo.mjs b/hegel/hegel-zoo.mjs
new file mode 100644
index 0000000..1ca6f10
--- /dev/null
+++ b/hegel/hegel-zoo.mjs
@@ -0,0 +1,163 @@
+// Hegel zoo: the small harness shared by the zoo's TypeScript/JavaScript targets.
+//
+// `property(name, body)` registers a node:test test that runs `body(tc)` under Hegel with
+// HEGEL_TEST_CASES cases (default 100) and the database at HEGEL_DATABASE. With ZOO_COLLECT=1
+// a `fail()` records the mismatch instead of failing, the case ends there, and the counts of
+// mismatches and of the shapes seen (`count(key)`) are printed at the end of the test, so a
+// property can be run over many cases to see every shape at once. `pin(name, body)` is a
+// plain test for one pinned bug: it must fail while the bug is present and pass once it is
+// fixed (the zoo's judge reads an unexpected pass as "fixed upstream?").
+
+import { readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+import { test as nodeTest } from "node:test";
+
+// The Hegel version these tests were written against (the zoo pins it in zoo.toml; upstream
+// would add it to devDependencies). Hegel and esbuild are installed with `npm install --prefix
+// .hegel` so the target's own package.json and lock file stay untouched. Checked at load time so
+// a stray install cannot silently change the engine.
+export const HEGEL_PIN = { "@hegeldev/hegel": "0.4.5" };
+
+const hegelDir = join(dirname(fileURLToPath(import.meta.url)), "..", ".hegel", "node_modules", "@hegeldev", "hegel");
+{
+  const installed = JSON.parse(readFileSync(join(hegelDir, "package.json"), "utf8")).version;
+  if (installed !== HEGEL_PIN["@hegeldev/hegel"]) {
+    throw new Error(`@hegeldev/hegel ${installed} is installed; these tests pin ${HEGEL_PIN["@hegeldev/hegel"]}`);
+  }
+}
+const hegel = await import(pathToFileURL(join(hegelDir, "dist", "index.js")));
+const gs = await import(pathToFileURL(join(hegelDir, "dist", "generators", "index.js")));
+
+export const collecting = !!process.env.ZOO_COLLECT;
+
+class Collected extends Error {}
+
+let msgs = [];
+let stats = new Map();
+
+/** Report a mismatch: an error normally, a recorded line in collect mode. */
+export function fail(message) {
+  if (collecting) {
+    msgs.push(message);
+    throw new Collected(message);
+  }
+  throw new Error(message);
+}
+
+/** Bump a statistic (the shape of a pinned bug, a generator branch). */
+export function count(key) {
+  stats.set(key, (stats.get(key) || 0) + 1);
+}
+
+function settings() {
+  const s = { testCases: Number(process.env.HEGEL_TEST_CASES) || 100 };
+  if (process.env.HEGEL_DATABASE) {
+    s.database = hegel.Database.fromPath(process.env.HEGEL_DATABASE);
+  }
+  return s;
+}
+
+/** A property: `body(tc)` runs under Hegel; a thrown error (or `fail`) is a failure. */
+export function property(name, body) {
+  nodeTest(name, () => {
+    msgs = [];
+    stats = new Map();
+    hegel.test((tc) => {
+      try {
+        body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** An async property: `body(tc)` may await; runs under Hegel's testAsync with the same settings. */
+export function propertyAsync(name, body) {
+  nodeTest(name, async () => {
+    msgs = [];
+    stats = new Map();
+    await hegel.testAsync(async (tc) => {
+      try {
+        await body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** A pin: a plain test for one recorded bug. */
+export function pin(name, body) {
+  nodeTest(name, body);
+}
+
+/** An integer in [lo, hi]. */
+export function n(tc, lo, hi) {
+  return tc.draw(gs.integers({ minValue: lo, maxValue: hi }));
+}
+
+/** One of xs. */
+export function pick(tc, xs) {
+  return xs[n(tc, 0, xs.length - 1)];
+}
+
+/** True pct percent of the time. */
+export function chance(tc, pct) {
+  return n(tc, 0, 99) < pct;
+}
+
+/** A string of `len` characters drawn from `alphabet` (an array of strings). */
+export function word(tc, alphabet, lo, hi) {
+  const len = n(tc, lo, hi);
+  let s = "";
+  for (let i = 0; i < len; i++) {
+    s += pick(tc, alphabet);
+  }
+  return s;
+}
+
+/** Structural equality: arrays by position, objects by key set (prototype ignored), else ===. */
+export function same(a, b) {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) {
+      return false;
+    }
+    return a.every((x, i) => same(x, b[i]));
+  }
+  if (a !== null && b !== null && typeof a === "object" && typeof b === "object") {
+    const ka = Object.keys(a).sort();
+    const kb = Object.keys(b).sort();
+    if (ka.length !== kb.length || ka.some((k, i) => k !== kb[i])) {
+      return false;
+    }
+    return ka.every((k) => same(a[k], b[k]));
+  }
+  return a === b;
+}
+
+/** A compact, unambiguous rendering for messages. */
+export function show(x) {
+  return JSON.stringify(x, (k, v) => (v === undefined ? "<undefined>" : v));
+}
