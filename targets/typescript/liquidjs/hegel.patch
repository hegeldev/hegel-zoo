+const nestedArray = gs.tuples(gs.arrays(nestedElement, { maxSize: 2 }), innerArray, gs.arrays(nestedElement, { maxSize: 2 })).map(([a, b, c]) => [...a, b, ...c]);
+const flattening = gs.sampledFrom(["reverse", "sort", "sort_natural", "uniq", "compact"]);
+const nestedThroughArrayFilters = withExtra(
+  "a",
+  nestedArray,
+  output(gs.tuples(gs.arrays(flattening, { minSize: 1, maxSize: 2 }), maybe(50, gs.sampledFrom(['join: ","', "join", "first", "last", "size"]))).map(([fs, tail]) => ["a", ...fs, ...(tail === undefined ? [] : [tail])].join(" | "))),
+);
+
+// liquidjs/11: a string with leading blanks or a run of blanks split on one space, read by a filter that sees the empty strings
+const blankRunText = gs.oneOf(seq(blanks(1, 2), wordsJoined(0, 3)), seq(wordsJoined(1, 2), "  ", wordsJoined(1, 2)));
+const splitOnASpace = withContext(output(gs.tuples(blankRunText, gs.sampledFrom(["size", "first", 'join: ","'])).map(([s, probe]) => `${JSON.stringify(s)} | split: " " | ${probe}`)));
+
+// liquidjs/12: replace with an empty pattern and a non-empty replacement, on a literal or a string variable
+const replaceEmptyPattern = withContext(
+  output(gs.tuples(gs.oneOf(LITERAL.str, gs.sampledFrom(["x", "s"])), quoted(STR_LITERALS.filter((s) => s !== ""))).map(([s, r]) => `${s} | replace: "", ${r}`)),
+);
+
+// liquidjs/13: a string with a `"` in it, escaped
+const HTML_CHARS = ["a", "b", " ", "<", ">", "&", "'", '"'];
+const withAQuote = gs.tuples(chars(HTML_CHARS, 0, 4), gs.just('"'), chars(HTML_CHARS, 0, 4)).map((ss) => ss.join(""));
+const escapedQuote = withExtra("q", withAQuote, output(gs.sampledFrom(["q | escape", "q | escape_once"])));
+
+// liquidjs/14: a string with one of `' ( ) ! *` in it, url-encoded
+const URL_CHARS = ["a", "b", " ", "-", "_", ".", "~", "'", "(", ")", "!", "*"];
+const withAnUnreservedMark = gs.tuples(chars(URL_CHARS, 0, 4), gs.sampledFrom(["'", "(", ")", "!", "*"]), chars(URL_CHARS, 0, 4)).map((ss) => ss.join(""));
+const urlEncodedMark = withExtra("q", withAnUnreservedMark, output("q | url_encode"));
+
+// liquidjs/15: a loop with `offset: continue` that runs more than once: repeated with the same variable and collection
+// (Shopify and liquidjs both key the position by the two), or inside another loop
+const continuedLoop = gs.record({ coll: gs.sampledFrom(["words", "nums", "(1..3)", "(1..5)"]), limit: maybe(40, count(1, 3)), sep: text }).map(
+  ({ coll, limit, sep }) => `{% for j in ${coll} offset: continue${limit === undefined ? "" : ` limit: ${limit}`} %}{{ j }}{% endfor %}${sep}`,
+);
+const offsetContinueTwice = withContext(
+  gs.tuples(ints(2, 3), continuedLoop, chance(50)).map(([n, loop, nested]) => (nested ? `{% for i in (1..${n}) %}${loop}{% endfor %}` : loop.repeat(n))),
+);
+
+/** The shape generators by bug id: { data, tpl }. */
+export const shapes = {
+  "liquidjs/1": rawClosedTrimmed,
+  "liquidjs/2": unnamedCyclesOfTwoLists,
+  "liquidjs/3": exactWordCount,
+  "liquidjs/4": moduloOfAFraction,
+  "liquidjs/5": cycleWithAFalsyCandidate,
+  "liquidjs/6": emptiedLoopWithElse,
+  "liquidjs/7": trueIntoMath,
+  "liquidjs/8": blockOfOnlyWhitespace,
+  "liquidjs/9": nestedThroughArrayFilters,
+  "liquidjs/10": fewerWordsThanCount,
+  "liquidjs/11": splitOnASpace,
+  "liquidjs/12": replaceEmptyPattern,
+  "liquidjs/13": escapedQuote,
+  "liquidjs/14": urlEncodedMark,
+  "liquidjs/15": offsetContinueTwice,
+};
