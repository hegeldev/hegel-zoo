+const blankBody = seq(blank, maybeText(50, seq(blankTag, blank)));
+const enteredBlock = gs.oneOf(
+  seq(tag(seq("if ", gs.sampledFrom(["true", "t", "x == x"]))), blankBody, tag("endif")),
+  seq(tag(seq("unless ", gs.sampledFrom(["false", "fl", "nl"]))), blankBody, tag("endunless")),
+  seq(tag(seq("for i in (1..", ints(1, 3).map(String), ")")), blankBody, tag("endfor")),
+  seq(tag("case 1"), tag("when 1"), blankBody, tag("endcase")),
+);
+const blockOfOnlyWhitespace = withContext(seq(text, enteredBlock, text));
