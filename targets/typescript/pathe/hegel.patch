+// Hegel zoo: the generator helpers behind the pathe properties, as values built from Hegel's
+// combinators. Nothing here draws from a TestCase: every generator is a value.
+
+import { gs } from "./hegel-zoo.mjs";
+
+export const ints = (lo, hi) => gs.integers({ minValue: lo, maxValue: hi });
+
+/** oneOf with weights: `weighted([45, a], [55, b])` draws a 45 times in 100; shrinks towards the first choice. */
+export function weighted(...choices) {
+  if (choices.length === 1) return choices[0][1];
+  const total = choices.reduce((sum, [w]) => sum + w, 0);
+  return ints(0, total - 1).flatMap((r) => {
+    for (const [w, g] of choices) {
+      if (r < w) return g;
+      r -= w;
+    }
+    throw new Error("unreachable");
+  });
+}
+
+/** True pct percent of the time; shrinks to false. */
+export const chance = (pct) => ints(0, 99).map((r) => r >= 100 - pct);
+/** A draw from g pct percent of the time, else undefined (listed first: shrinks to absent). */
+export const maybe = (pct, g) => weighted([100 - pct, gs.just(undefined)], [pct, g]);
+export const pick = (xs) => gs.sampledFrom(xs);
+/** lo-hi pieces of `pool` (an array of strings; a repeated entry weighs more) joined into one string. */
+export const word = (pool, lo, hi) => gs.arrays(pick(pool), { minSize: lo, maxSize: hi }).map((cs) => cs.join(""));
