index 0000000..c6dbc33
--- /dev/null
+++ b/test/hegel.test.mjs
@@ -0,0 +1,695 @@
+// Hegel zoo: property tests for pathe (unjs/pathe); see README.md of the target.
+//
+// Run with `node --test --test-reporter=tap test/hegel.test.mjs` after the setup in target.toml
+// (npm install of Hegel and TypeScript under .hegel/; tsc of src/ into .hegel/dist as CommonJS).
+// HEGEL_TEST_CASES sets the budget, ZOO_COLLECT=1 records mismatches instead of failing at the first.
+// Node's own `path.posix` and `path.win32` are the oracles.
+
+import assert from "node:assert/strict";
+import { createRequire } from "node:module";
+import nodePath from "node:path";
+import { chance, count, fail, n, pick, pin, property, same, show, word } from "./hegel-zoo.mjs";
+
+const require = createRequire(import.meta.url);
+const pathe = require("../.hegel/dist/index.js");
+const utils = require("../.hegel/dist/utils.js");
+const posix = nodePath.posix;
+const win32 = nodePath.win32;
+
+// Shapes of the recorded bugs (bugs.toml): a property skips a case that has one and stays strict
+// on everything else; each has a pin below.
+const Known = {
+  // pathe/1: ".." climbing past a drive or UNC root drops the root ("C:\a\..\.." -> "/")
+  climbsAboveRoot: (segments) => {
+    let depth = 0;
+    for (const s of segments) {
+      if (s === "" || s === ".") continue;
+      if (s === "..") {
+        if (depth === 0) return true;
+        depth--;
+      } else depth++;
+    }
+    return false;
+  },
+  // pathe/2: dirname/basename/parse of a drive root ("C:\") lose the drive
+  driveRoot: (p) => /^[A-Za-z]:[\\/]+$/.test(p),
+  // pathe/3: three or more leading slashes become a UNC prefix ("///a" -> "//a")
+  threeSlashes: (p) => /^[\\/]{3}/.test(p),
+  // pathe/4: parse().root of a UNC path is "/" (not a prefix of its dir)
+  unc: (p) => /^[\\/]{2}[^\\/]/.test(p),
+  // pathe/5: parse() of a lower-case drive path: root keeps "c:/", dir gets "C:/"
+  lowerDrive: (p) => /^[a-z]:[\\/]/.test(p),
+  // pathe/6: normalize("C:") is the absolute "C:/" but isAbsolute("C:") is false
+  bareDrive: (p) => /^[A-Za-z]:$/.test(p),
+  // pathe/7: an escaped letter or digit in a glob is passed to the RegExp as an escape (\d, \w, \s, \b)
+  escapedAlnum: (atoms) => atoms.some((a) => a.kind === "escape" && /[A-Za-z0-9]/.test(a.char)),
+  // pathe/8: a numeric range pads to the shorter endpoint's width ({01..3} does not match 02)
+  paddedRange: (atoms) => atoms.some((a) => a.kind === "range" && (a.lo.length !== a.hi.length && (a.lo.startsWith("0") || a.hi.startsWith("0")))),
+  // pathe/9: a bracket expression whose first character is "]" is empty ("[]]" does not match "]")
+  bracketStartsWithClose: (atoms) => atoms.some((a) => a.kind === "class" && a.chars[0] === "]"),
+  // pathe/10: format() does not ignore root when dir is given
+  rootAndDir: (obj) => !!obj.root && !!obj.dir,
+  // pathe/11: filename("..") is "."
+  dotdotName: (base) => base === "..",
+  // pathe/14: a segment ending in "*" followed by "**" ("*/**") consumes the slash, so "a" no longer matches "*/**"
+  starBeforeGlobstar: (segments) => segments.some((s, i) => !s.globstar && s.atoms[s.atoms.length - 1].kind === "star" && segments[i + 1] && segments[i + 1].globstar),
+  // pathe/13: a "-" inside a bracket expression is passed to the RegExp as a range: "[a-0]" throws SyntaxError
+  // (a negated class puts "^\\/" first, so a leading "-" becomes a range end too)
+  interiorDash: (atoms) => atoms.some((a) => a.kind === "class" && (a.chars.slice(1, -1).includes("-") || (a.negated && a.chars[0] === "-"))),
+  // pathe/15: a UNC server name starting with "." is rewritten as the device namespace ("//.a/c" -> "//./.a/c")
+  dotServer: (p) => /^[\\/]{2}\.[^\\/]/.test(p),
+  // pathe/12: resolve() of a path that reduces to a drive root gives "/C:" or "C:"
+  resolvesToDriveRoot: (p) => /^[A-Za-z]:/.test(p) && segmentsOf(p).length > 0 && !Known.climbsAboveRoot(segmentsOf(p)) && (() => {
+    let depth = 0;
+    for (const x of segmentsOf(p)) {
+      if (x === ".") continue;
+      depth += x === ".." ? -1 : 1;
+    }
+    return depth === 0;
+  })(),
+};
+
+// ---------------------------------------------------------------- generators
+
+const NAMES = ["a", "b", "c", "abc", "a.b", "a.b.c", ".a", "..a", "a.", "a..", ".", "..", "-", "_", "a b", "é", "😀", "x.tar.gz", "a-b_c", "A", "b.C"];
+
+function genSegments(tc, lo, hi) {
+  const segs = [];
+  const k = n(tc, lo, hi);
+  for (let i = 0; i < k; i++) segs.push(pick(tc, NAMES));
+  return segs;
+}
+
+/** A POSIX-style path: optional root, segments joined by one or more slashes, optional trailing slash. */
+function genPosixPath(tc) {
+  if (chance(tc, 4)) return "";
+  const segs = genSegments(tc, 0, 4);
+  let s = "";
+  const r = n(tc, 0, 99);
+  if (r < 40) s = "/";
+  else if (r < 44) s = "//";
+  else if (r < 47) s = "///";
+  else if (r < 55) s = "./";
+  s += segs.join(chance(tc, 85) ? "/" : "//");
+  if (segs.length && chance(tc, 25)) s += chance(tc, 80) ? "/" : "//";
+  return s;
+}
+
+const isPosixInput = (p) => !p.includes("\\") && !/^[A-Za-z]:/.test(p);
+
+/** A Windows drive path: "X:" + separators + segments, mixed separators, optional trailing one. */
+function genDrivePath(tc) {
+  const drive = pick(tc, ["C", "D", "c", "Z"]) + ":";
+  if (chance(tc, 5)) return drive;
+  const sep = () => (chance(tc, 60) ? "\\" : "/");
+  const segs = genSegments(tc, 0, 4);
+  let s = drive + sep();
+  if (chance(tc, 8)) s += sep();
+  s += segs.map((x, i) => (i ? sep() : "") + x).join("");
+  if (segs.length && chance(tc, 25)) s += sep();
+  return s;
+}
+
+/** A UNC path: two separators, server, share, segments. */
+function genUncPath(tc) {
+  const sep = () => (chance(tc, 60) ? "\\" : "/");
+  const segs = genSegments(tc, 0, 3);
+  let s = sep() + sep() + pick(tc, ["server", "srv1", "S"]) + sep() + pick(tc, ["share", "c$", "x"]);
+  for (const x of segs) s += sep() + x;
+  if (chance(tc, 25)) s += sep();
+  return s;
+}
+
+/** Segments of a path in Windows or POSIX notation, root removed. */
+function segmentsOf(p) {
+  const body = /^[A-Za-z]:/.test(p) ? p.slice(2) : p.replace(/^[\\/]{2}[^\\/]+[\\/]+[^\\/]+/, "");
+  return body.split(/[\\/]+/).filter((x) => x !== "");
+}
+
+/** Node's win32 result in pathe's notation: forward slashes, upper-case drive letter. */
+const W = (s) => (typeof s === "string" ? s.replace(/\\/g, "/").replace(/^([a-z]):/, (m, d) => d.toUpperCase() + ":") : s);
+const Wobj = (o) => Object.fromEntries(Object.entries(o).map(([k, v]) => [k, W(v)]));
+
+// ---------------------------------------------------------------- POSIX differential
+
+property("TestHegelAgreesWithNodePosix", (tc) => {
+  const p = genPosixPath(tc);
+  if (/^[\\/]{2}(?![\\/])/.test(p)) {
+    // pathe keeps a "//" prefix as a UNC root by design; POSIX collapses it (README)
+    count("skip/unc-prefix");
+    return;
+  }
+  const known3 = Known.threeSlashes(p);
+  if (known3) count("known/pathe-3");
+  const cmp = (fn, ...args) => {
+    const a = pathe[fn](...args);
+    const b = posix[fn](...args);
+    if (a !== b) {
+      if (known3) return;
+      fail(`${fn}(${args.map(show).join(", ")}) = ${show(a)}, node posix ${show(b)}`);
+    }
+  };
+  cmp("normalize", p);
+  cmp("isAbsolute", p);
+  cmp("dirname", p);
+  cmp("basename", p);
+  cmp("extname", p);
+  cmp("toNamespacedPath", p);
+  // basename with an extension argument
+  const b = posix.basename(p);
+  const ext = pick(tc, [posix.extname(p), b.slice(n(tc, 0, b.length)), pick(tc, [".b", ".gz", "c", ""])]);
+  // Node keeps a dotfile that equals the extension whole where pathe strips it, returns "/" for basename("/", ext) and
+  // keeps a trailing slash when the extension does not match: its own quirks (README)
+  if (ext !== "" && ext !== b && b !== "" && !p.endsWith("/")) cmp("basename", p, ext);
+  // parse and format
+  const pa = pathe.parse(p);
+  const pb = posix.parse(p);
+  if (pb.base === ".." && pb.root !== "") {
+    count("skip/node-parse-dotdot"); // node: parse("/..") has ext "." and name "." (its own quirk)
+  } else if (!same(pa, pb)) {
+    if (!known3) fail(`parse(${show(p)}) = ${show(pa)}, node posix ${show(pb)}`);
+  }
+  if (!pa.dir.startsWith(pa.root)) fail(`parse(${show(p)}).dir ${show(pa.dir)} does not start with root ${show(pa.root)}`);
+  const fa = pathe.format(pa);
+  const fb = posix.format(pb);
+  if (fa !== fb && fa !== posix.normalize(fb) && !known3 && !(pb.base === ".." && pb.root !== "")) fail(`format(parse(${show(p)})) = ${show(fa)}, node posix ${show(fb)}`);
+  // join, resolve, relative with a second path
+  const q = genPosixPath(tc);
+  const knownQ = Known.threeSlashes(q) || /^[\\/]{2}(?![\\/])/.test(q);
+  if (!knownQ) {
+    cmp("join", p, q);
+    const extra = chance(tc, 30) ? [pick(tc, NAMES)] : [];
+    cmp("join", ...[p, q, ...extra]);
+    cmp("resolve", p, q, ...extra);
+    cmp("relative", p, q);
+    cmp("relative", q, p);
+  }
+  if (chance(tc, 10)) {
+    cmp("join");
+    cmp("resolve");
+    cmp("join", "", "");
+  }
+});
+
+// ---------------------------------------------------------------- Windows drive paths against node's win32
+
+property("TestHegelAgreesWithNodeWin32OnDrivePaths", (tc) => {
+  const p = genDrivePath(tc);
+  const segs = segmentsOf(p);
+  const known1 = Known.climbsAboveRoot(segs);
+  const known2 = Known.driveRoot(p);
+  const known6 = Known.bareDrive(p);
+  if (known1) count("known/pathe-1");
+  if (known2) count("known/pathe-2");
+  if (known6) count("known/pathe-6");
+  const skip = known1 || known2 || known6;
+  const cmp = (fn, ...args) => {
+    const a = pathe[fn](...args);
+    const b = win32[fn](...args);
+    if (W(a) !== W(b)) {
+      if (skip) return;
+      fail(`${fn}(${args.map(show).join(", ")}) = ${show(a)}, node win32 ${show(b)}`);
+    }
+  };
+  cmp("normalize", p);
+  cmp("isAbsolute", p);
+  cmp("dirname", p);
+  cmp("basename", p);
+  cmp("extname", p);
+  const pa = pathe.parse(p);
+  const pb = win32.parse(p);
+  if (!same(Wobj(pa), Wobj(pb))) {
+    if (!skip && !(pb.base === ".." && Known.climbsAboveRoot(segs))) fail(`parse(${show(p)}) = ${show(pa)}, node win32 ${show(pb)}`);
+  }
+  if (!pa.dir.startsWith(pa.root)) {
+    if (Known.lowerDrive(p)) count("known/pathe-5");
+    else if (!skip) fail(`parse(${show(p)}).dir ${show(pa.dir)} does not start with root ${show(pa.root)}`);
+  }
+  // a normalized path is normalized, absolute stays absolute
+  const norm = pathe.normalize(p);
+  if (norm.includes("\\")) fail(`normalize(${show(p)}) = ${show(norm)} keeps a backslash`);
+  if (pathe.normalize(norm) !== norm && !known6) fail(`normalize is not idempotent on ${show(p)}: ${show(norm)} -> ${show(pathe.normalize(norm))}`);
+  if (pathe.isAbsolute(norm) !== pathe.isAbsolute(p)) {
+    if (known6) count("known/pathe-6");
+    else fail(`normalize(${show(p)}) = ${show(norm)} changes isAbsolute ${pathe.isAbsolute(p)} -> ${pathe.isAbsolute(norm)}`);
+  }
+  // join and resolve with relative segments; relative between two drive paths
+  const rel = genSegments(tc, 1, 3);
+  const joined = [p, ...rel];
+  const allSegs = segmentsOf(p).concat(rel.flatMap((r) => r.split(/[\\/]+/)));
+  const knownJ = Known.climbsAboveRoot(allSegs);
+  const known12 = Known.resolvesToDriveRoot(p) || Known.resolvesToDriveRoot(p.replace(/[\\/]*$/, "") + "/" + rel.join("/"));
+  if (!knownJ && !skip) {
+    cmp("join", ...joined);
+    if (known12) count("known/pathe-12");
+    else cmp("resolve", ...joined);
+  } else if (knownJ) count("known/pathe-1");
+  const q = genDrivePath(tc);
+  if (!skip && !Known.climbsAboveRoot(segmentsOf(q)) && !Known.driveRoot(q) && !Known.bareDrive(q)) {
+    if (Known.resolvesToDriveRoot(p) || Known.resolvesToDriveRoot(q)) count("known/pathe-12");
+    else if (/[A-Z]/.test(p.slice(2) + q.slice(2))) count("skip/win32-case-insensitive"); // node compares Windows paths case-insensitively; pathe is POSIX (README)
+    else {
+      cmp("relative", p, q);
+      cmp("relative", q, p);
+    }
+  }
+});
+
+// ---------------------------------------------------------------- UNC paths keep their prefix
+
+property("TestHegelUncPathsKeepTheirPrefix", (tc) => {
+  const p = genUncPath(tc);
+  const segs = segmentsOf(p);
+  const norm = pathe.normalize(p);
+  const prefix = "//" + p.slice(2).split(/[\\/]+/).slice(0, 2).join("/");
+  if (Known.climbsAboveRoot(segs)) {
+    count("known/pathe-1");
+    return;
+  }
+  if (!norm.startsWith(prefix)) fail(`normalize(${show(p)}) = ${show(norm)} loses the UNC prefix ${show(prefix)}`);
+  if (norm.includes("\\") || /[^/]\/\/|\/\.\/|\/\.$/.test(norm)) fail(`normalize(${show(p)}) = ${show(norm)} is not normalized`);
+  if (pathe.normalize(norm) !== norm) fail(`normalize is not idempotent on ${show(p)}: ${show(norm)} -> ${show(pathe.normalize(norm))}`);
+  if (!pathe.isAbsolute(p) || !pathe.isAbsolute(norm)) fail(`isAbsolute(${show(p)}) is false`);
+  if (pathe.resolve(p) !== norm.replace(/(.)\/$/, "$1")) fail(`resolve(${show(p)}) = ${show(pathe.resolve(p))}, normalize gives ${show(norm)}`);
+  const pa = pathe.parse(p);
+  if (!pa.dir.startsWith(pa.root)) {
+    if (Known.unc(p)) count("known/pathe-4");
+    else fail(`parse(${show(p)}).dir ${show(pa.dir)} does not start with root ${show(pa.root)}`);
+  }
+  if (segs.length) {
+    const d = pathe.dirname(p);
+    const b = pathe.basename(p);
+    if (b !== segs[segs.length - 1]) fail(`basename(${show(p)}) = ${show(b)}`);
+    if (!d.startsWith(prefix)) fail(`dirname(${show(p)}) = ${show(d)} loses the UNC prefix ${show(prefix)}`);
+    if (pathe.normalize(pathe.join(d, b)) !== norm.replace(/(.)\/$/, "$1")) fail(`join(dirname, basename) of ${show(p)} = ${show(pathe.join(d, b))}, normalize gives ${show(norm)}`);
+  }
+});
+
+// ---------------------------------------------------------------- laws on any input
+
+property("TestHegelPathLaws", (tc) => {
+  const kind = n(tc, 0, 2);
+  const p = kind === 0 ? genPosixPath(tc) : kind === 1 ? genDrivePath(tc) : genUncPath(tc);
+  const segs = segmentsOf(p);
+  const known1 = kind !== 0 && Known.climbsAboveRoot(segs);
+  const known2 = Known.driveRoot(p);
+  const known3 = Known.threeSlashes(p);
+  const known6 = Known.bareDrive(p);
+  const known15 = Known.dotServer(p);
+  if (known15) count("known/pathe-15");
+  const norm = pathe.normalize(p);
+  // normalized: forward slashes only, no empty or "." segments, ".." only leading
+  if (norm.includes("\\")) fail(`normalize(${show(p)}) = ${show(norm)} keeps a backslash`);
+  const body = norm.replace(/^[\\/]{2}/, "").replace(/^[A-Za-z]:\//, "").replace(/^\//, "");
+  if (body !== "." && body !== "./" && (/\/\//.test(body) || /(^|\/)\.(\/|$)/.test(body) || /\/\.\.(\/|$)/.test(body.replace(/^(\.\.\/)*\.\.(?=\/|$)/, "")))) {
+    if (!known3 && !known15) fail(`normalize(${show(p)}) = ${show(norm)} is not normalized`);
+  }
+  if (pathe.normalize(norm) !== norm && !known6 && !known15) fail(`normalize not idempotent on ${show(p)}: ${show(norm)} -> ${show(pathe.normalize(norm))}`);
+  if (pathe.isAbsolute(norm) !== pathe.isAbsolute(p)) {
+    if (known6) count("known/pathe-6");
+    else if (!known1 && !known3 && !known15) fail(`normalize(${show(p)}) = ${show(norm)} changes isAbsolute`);
+  }
+  if (pathe.isAbsolute(p) && !known1 && !known3 && !known2) {
+    const root = pathe.parse(p).root;
+    if (root === "" || !norm.startsWith(root)) {
+      if (Known.lowerDrive(p)) count("known/pathe-5");
+      else if (Known.unc(p)) count("known/pathe-4");
+      else fail(`normalize(${show(p)}) = ${show(norm)} does not start with parse().root ${show(root)}`);
+    }
+  }
+  // join of the pieces gives the normalized path
+  const d = pathe.dirname(p);
+  const b = pathe.basename(p);
+  const rejoined = pathe.normalize(pathe.join(d, b));
+  const target = norm.length > 1 ? norm.replace(/\/$/, "") : norm;
+  if (rejoined !== target && !(b === "" && pathe.normalize(d) === target)) {
+    if (known1) count("known/pathe-1");
+    else if (known2) count("known/pathe-2");
+    else if (known3) count("known/pathe-3");
+    else if (known6) count("known/pathe-6");
+    else if (kind === 0 && /^[\\/]{2}/.test(p)) count("skip/unc-prefix");
+    else if (segs.length && segs[segs.length - 1] !== "." && segs[segs.length - 1] !== "..") fail(`join(dirname, basename) of ${show(p)} = ${show(rejoined)} (${show(d)}, ${show(b)}), normalize gives ${show(norm)}`);
+  }
+  // resolve is absolute and normalized; relative round trip
+  const r = pathe.resolve(p);
+  const known12 = known2 || Known.resolvesToDriveRoot(p);
+  if (known12) count("known/pathe-12");
+  if (!pathe.isAbsolute(r) && !known12 && !known1) fail(`resolve(${show(p)}) = ${show(r)} is not absolute`);
+  if (pathe.normalize(r) !== r && !known3 && !known12 && !known6 && !(kind === 0 && /^[\\/]{2}/.test(p))) fail(`resolve(${show(p)}) = ${show(r)} is not normalized`); // resolve("//") keeps the UNC prefix normalize drops (README)
+  const q = kind === 0 ? genPosixPath(tc) : kind === 1 ? genDrivePath(tc) : genUncPath(tc);
+  const knownQ = (kind !== 0 && Known.climbsAboveRoot(segmentsOf(q))) || Known.threeSlashes(q) || Known.bareDrive(q) || Known.driveRoot(q) || Known.resolvesToDriveRoot(q);
+  const uncMix = kind === 0 && (/^[\\/]{2}/.test(p) || /^[\\/]{2}/.test(q)); // a UNC-prefixed POSIX path against a plain one: relative() has no answer (README)
+  if (!known1 && !known3 && !known6 && !known2 && !known12 && !knownQ && !uncMix) {
+    const rel = pathe.relative(p, q);
+    const back = pathe.resolve(pathe.resolve(p), rel);
+    const rq = pathe.resolve(q);
+    if (back !== rq && !/^[A-Za-z]:/.test(rel)) fail(`resolve(resolve(${show(p)}), relative(p, ${show(q)}) = ${show(rel)}) = ${show(back)}, resolve(q) = ${show(rq)}`);
+    if (pathe.relative(p, p) !== "") fail(`relative(${show(p)}, same) = ${show(pathe.relative(p, p))}`);
+  }
+  // extname and parse agree; the name and ext make the base
+  const pa = pathe.parse(p);
+  if (pa.ext !== pathe.extname(p)) fail(`parse(${show(p)}).ext ${show(pa.ext)} != extname ${show(pathe.extname(p))}`);
+  if (pa.name + pa.ext !== pa.base) fail(`parse(${show(p)}): name ${show(pa.name)} + ext ${show(pa.ext)} != base ${show(pa.base)}`);
+  if (pa.base !== b) fail(`parse(${show(p)}).base ${show(pa.base)} != basename ${show(b)}`);
+});
+
+// ---------------------------------------------------------------- format
+
+property("TestHegelFormatAgreesWithNodePosix", (tc) => {
+  const obj = {};
+  if (chance(tc, 40)) obj.root = pick(tc, ["/", "", "//"]);
+  if (chance(tc, 60)) obj.dir = pick(tc, ["a", "/a", "a/b", "/", "", "a/", "."]);
+  if (chance(tc, 70)) obj.base = pick(tc, ["b", "b.c", ".c", "", "b.", "..", "x.tar.gz"]);
+  else {
+    if (chance(tc, 80)) obj.name = pick(tc, ["b", "", ".c", "x.tar"]);
+    if (chance(tc, 80)) obj.ext = pick(tc, [".c", "c", "", ".", ".gz"]);
+  }
+  const a = pathe.format(obj);
+  const b = posix.format(obj);
+  if (a !== b) {
+    if (Known.rootAndDir(obj)) count("known/pathe-10");
+    else if (obj.ext && !obj.ext.startsWith(".")) count("skip/ext-without-dot"); // pathe adds the dot; node (< 20) did not (README)
+    else if (obj.dir && !obj.base && !obj.name && !(obj.ext && obj.ext !== "")) count("skip/empty-base"); // node keeps the trailing separator; pathe normalizes it away (README)
+    else if (obj.root === "//" || (obj.dir && obj.dir.startsWith("//"))) count("skip/unc-prefix");
+    else if (obj.root && (obj.base === ".." || obj.name === "..")) count("skip/dotdot-normalized"); // with a root pathe resolves, so ".." folds away (README)
+    else fail(`format(${show(obj)}) = ${show(a)}, node posix ${show(b)}`);
+  }
+});
+
+// ---------------------------------------------------------------- matchesGlob against a model of its grammar
+
+const GLOB_LIT = "abcxyz01.-_".split("");
+
+/** One glob atom: {kind, text, re, solutions}. */
+function genGlobAtom(tc) {
+  const r = n(tc, 0, 99);
+  if (r < 45) {
+    const c = pick(tc, GLOB_LIT);
+    return { kind: "lit", text: c, re: escapeRe(c), solutions: [c] };
+  }
+  if (r < 62) return { kind: "star", text: "*", re: "[^/]*", solutions: ["", "a", "xy", "a.b"] };
+  if (r < 70) return { kind: "question", text: "?", re: "[^/]", solutions: ["a", "."] };
+  if (r < 80) {
+    const neg = chance(tc, 25);
+    const chars = [];
+    const k = n(tc, 1, 3);
+    for (let i = 0; i < k; i++) chars.push(i === 0 && chance(tc, 8) ? "]" : pick(tc, ["a", "b", "x", "0", "-", "."])); // "]" only first (POSIX)
+    const range = chance(tc, 30);
+    const inner = range ? "a-c" : chars.join("");
+    const sol = range ? ["a", "b", "c"] : chars.slice();
+    return {
+      kind: "class",
+      negated: neg,
+      chars: range ? ["a"] : chars,
+      text: `[${neg ? "!" : ""}${inner}]`,
+      re: `[${neg ? "^/" : ""}${range ? "a-c" : chars.map((c) => (c === "]" || c === "\\" || c === "^" || c === "-" ? "\\" + c : c)).join("")}]`,
+      solutions: neg ? ["z", "q"] : sol,
+    };
+  }
+  if (r < 90) {
+    const alts = [];
+    const k = n(tc, 2, 3);
+    for (let i = 0; i < k; i++) alts.push(word(tc, GLOB_LIT, 0, 3));
+    return { kind: "brace", text: `{${alts.join(",")}}`, re: `(?:${alts.map(escapeRe).join("|")})`, solutions: alts };
+  }
+  if (r < 95) {
+    const lo = pick(tc, ["1", "01", "3", "9", "0"]);
+    const hi = pick(tc, ["3", "12", "05", "2"]);
+    const width = Math.max(lo.length, hi.length);
+    const a = Number(lo);
+    const b = Number(hi);
+    const items = [];
+    for (let i = Math.min(a, b); i <= Math.max(a, b); i++) items.push(String(i).padStart(lo.startsWith("0") || hi.startsWith("0") ? width : 0, "0"));
+    return { kind: "range", lo, hi, text: `{${lo}..${hi}}`, re: `(?:${items.join("|")})`, solutions: items };
+  }
+  const c = pick(tc, ["*", "?", "[", "]", "{", "}", ".", "a", "d", "w", "s", "b", "n", "1"]); // not "\\": pathe turns a backslash in the path into a slash
+  return { kind: "escape", char: c, text: "\\" + c, re: escapeRe(c), solutions: [c] };
+}
+
+function escapeRe(s) {
+  return s.replace(/[.*+?^${}()|[\]\\/-]/g, "\\$&");
+}
+
+/** A glob of 1–4 segments (some "**") with the regex pathe's grammar gives it and sample matches. */
+function genGlob(tc) {
+  const segments = [];
+  const k = n(tc, 1, 4);
+  for (let i = 0; i < k; i++) {
+    if (chance(tc, 20) && !(i > 0 && segments[i - 1].globstar)) {
+      segments.push({ globstar: true, atoms: [] });
+      continue;
+    }
+    const atoms = [];
+    const m = n(tc, 1, 3);
+    for (let j = 0; j < m; j++) atoms.push(genGlobAtom(tc));
+    if (atoms.length > 1 && atoms.every((a) => a.kind === "star")) atoms.push({ kind: "lit", text: "q", re: "q", solutions: ["q"] }); // "**" is the globstar
+    segments.push({ globstar: false, atoms });
+  }
+  const text = segments.map((s) => (s.globstar ? "**" : s.atoms.map((a) => a.text).join(""))).join("/");
+  // the regex: "**" alone matches anything; "**/" at the start zero or more leading directories; "/**/"
+  // zero or more directories between; "/**" at the end the segment's subtree or the segment itself
+  let re = "";
+  segments.forEach((s, i) => {
+    if (s.globstar) {
+      if (segments.length === 1) re += ".*";
+      else if (i === 0) re += "(?:.*/)?";
+      else if (i === segments.length - 1) re += "(?:/.*)?";
+      else re += "(?:/.+/|/)";
+    } else {
+      if (i > 0 && !segments[i - 1].globstar) re += "/";
+      else if (i > 0 && segments[i - 1].globstar && i - 1 !== 0 && i - 1 !== segments.length - 1) re += "";
+      re += s.atoms.map((a) => a.re).join("");
+    }
+  });
+  // a "**" in the middle already contributed its slashes on both sides
+  re = re.replace(/\(\?:\/\.\+\/\|\/\)(?=[^/])/g, "(?:/.+/|/)");
+  return { segments, text, re: new RegExp(`^(?:${re})/?$`, "s"), atoms: segments.flatMap((s) => s.atoms) };
+}
+
+/** Candidate paths: solutions of the glob, mutations, random. */
+function genGlobPaths(tc, glob) {
+  const out = new Set();
+  const solve = () => {
+    const parts = [];
+    for (const s of glob.segments) {
+      if (s.globstar) {
+        const k = n(tc, 0, 2);
+        for (let i = 0; i < k; i++) parts.push(word(tc, GLOB_LIT, 1, 2));
+        continue;
+      }
+      parts.push(s.atoms.map((a) => pick(tc, a.solutions)).join(""));
+    }
+    return parts.filter((x) => x !== "" && x !== "." && x !== "..");
+  };
+  const total = n(tc, 3, 8);
+  for (let i = 0; i < total; i++) {
+    let parts = solve();
+    if (chance(tc, 40) && parts.length) {
+      const r = n(tc, 0, 3);
+      const idx = n(tc, 0, parts.length - 1);
+      if (r === 0) parts[idx] += pick(tc, GLOB_LIT);
+      else if (r === 1) parts.splice(idx, 1);
+      else if (r === 2) parts.splice(idx, 0, word(tc, GLOB_LIT, 1, 2));
+      else parts[idx] = parts[idx].slice(1) || "q";
+      parts = parts.filter((x) => x !== "" && x !== "." && x !== "..");
+    }
+    if (parts.length === 0) continue;
+    out.add(parts.join("/") + (chance(tc, 15) ? "/" : ""));
+  }
+  return [...out];
+}
+
+function mg(p, glob) {
+  try {
+    return pathe.matchesGlob(p, glob);
+  } catch (e) {
+    fail(`matchesGlob(${show(p)}, ${show(glob)}) threw ${e.constructor.name}: ${e.message}`);
+  }
+}
+
+property("TestHegelGlobMatchesItsGrammar", (tc) => {
+  const glob = genGlob(tc);
+  const paths = genGlobPaths(tc, glob);
+  if (paths.length === 0) return;
+  const knownShapes = [];
+  if (Known.escapedAlnum(glob.atoms)) knownShapes.push("known/pathe-7");
+  if (Known.paddedRange(glob.atoms)) knownShapes.push("known/pathe-8");
+  if (Known.bracketStartsWithClose(glob.atoms)) knownShapes.push("known/pathe-9");
+  if (Known.interiorDash(glob.atoms)) knownShapes.push("known/pathe-13");
+  if (Known.starBeforeGlobstar(glob.segments)) knownShapes.push("known/pathe-14");
+  if (knownShapes.length) {
+    for (const k of knownShapes) count(k);
+    // still: it must not throw, except for the recorded crash
+    if (!Known.interiorDash(glob.atoms)) for (const p of paths) mg(p, glob.text);
+    return;
+  }
+  const hasGlobstar = glob.segments.some((s) => s.globstar);
+  if (hasGlobstar) count("globstar");
+  for (const p of paths) {
+    const got = mg(p, glob.text);
+    const want = glob.re.test(p);
+    if (got !== want) fail(`matchesGlob(${show(p)}, ${show(glob.text)}) = ${got}, the grammar says ${want} (${glob.re})`);
+    // the path is normalized first
+    const messy = chance(tc, 50) ? "./" + p : p.replace(/\//g, chance(tc, 50) ? "//" : "/./");
+    if (mg(messy, glob.text) !== got) fail(`matchesGlob(${show(messy)}, ${show(glob.text)}) != matchesGlob(${show(p)})`);
+    // node agrees where the engines share their semantics: no "**", no escapes, no dotfiles, no ranges
+    const emptyAlt = glob.atoms.some((a) => a.kind === "brace" && a.solutions.includes("")); // minimatch expands "{a,}" and then collapses the "//" it leaves (README)
+    if (!hasGlobstar && !emptyAlt && !glob.atoms.some((a) => a.kind === "escape" || a.kind === "range") && !p.split("/").some((s) => s.startsWith("."))) {
+      const node = posix.matchesGlob(p, glob.text);
+      if (node !== got) fail(`matchesGlob(${show(p)}, ${show(glob.text)}) = ${got}, node ${node}`);
+    }
+  }
+  // a list of globs matches when any does
+  const other = genGlob(tc);
+  const p = pick(tc, paths);
+  if (Known.interiorDash(other.atoms)) return;
+  const a = mg(p, glob.text);
+  const b = mg(p, other.text);
+  if (mg(p, [glob.text, other.text]) !== (a || b)) fail(`matchesGlob(${show(p)}, [${show(glob.text)}, ${show(other.text)}]) != ${a} || ${b}`);
+});
+
+// ---------------------------------------------------------------- utils
+
+property("TestHegelUtilsAgreeWithParse", (tc) => {
+  const p = chance(tc, 70) ? genPosixPath(tc) : genDrivePath(tc);
+  const base = pathe.basename(p);
+  const name = utils.filename(p);
+  if (base === "" || /[\\/]$/.test(p)) {
+    // a trailing separator: filename() has nothing after it (README), while basename() looks back
+    if (name !== undefined && !/[\\/]$/.test(p)) fail(`filename(${show(p)}) = ${show(name)} for a path without a final segment`);
+  } else if (name !== pathe.parse(p).name) {
+    if (Known.dotdotName(base)) count("known/pathe-11");
+    else fail(`filename(${show(p)}) = ${show(name)}, parse().name ${show(pathe.parse(p).name)}`);
+  }
+  // aliases: distinct prefixes to distinct targets; a chained alias resolves through the other
+  const names = pick(tc, [
+    ["@", "~", "#lib"],
+    ["src", "lib"],
+    ["@app", "@app/lib"],
+  ]);
+  const aliases = {};
+  const targets = chance(tc, 70) ? ["/root/a", "/root/b", "rel/d"] : ["/root/a", "/root/a/sub", "/root/b"];
+  names.forEach((k, i) => (aliases[k] = targets[i]));
+  const rest = genSegments(tc, 0, 2).filter((s) => s !== "." && s !== ".." && s !== "").join("/");
+  const alias = pick(tc, names);
+  const input = alias + (rest ? "/" + rest : "") + (chance(tc, 20) ? "/" : "");
+  const resolved = utils.resolveAlias(input, aliases);
+  // the most specific alias wins
+  const best = names.filter((k) => input === k || input.startsWith(k + "/")).sort((x, y) => y.split("/").length - x.split("/").length)[0];
+  const expected = pathe.join(aliases[best], input.slice(best.length));
+  if (resolved !== expected) fail(`resolveAlias(${show(input)}, ${show(aliases)}) = ${show(resolved)}, expected ${show(expected)}`);
+  // a path that only shares a prefix of the alias is untouched
+  const near = alias + "x" + (rest ? "/" + rest : "");
+  if (!names.some((k) => near === k || near.startsWith(k + "/")) && utils.resolveAlias(near, aliases) !== near) {
+    fail(`resolveAlias(${show(near)}) = ${show(utils.resolveAlias(near, aliases))} changes a non-aliased path`);
+  }
+  // the reverse resolution contains the aliased form when targets are prefix-free
+  const used = Object.values(aliases).map((t) => pathe.normalize(t));
+  const prefixFree = used.every((t, i) => used.every((u, j) => i === j || !(u === t || u.startsWith(t + "/"))));
+  if (prefixFree) {
+    const back = utils.reverseResolveAlias(resolved, aliases);
+    const want = pathe.join(best, input.slice(best.length));
+    if (!back.includes(want)) fail(`reverseResolveAlias(${show(resolved)}, ${show(aliases)}) = ${show(back)} lacks ${show(want)}`);
+  }
+  // chained aliases
+  const chained = { "@": "/r", "~": "@/h" };
+  if (utils.resolveAlias("~/x", chained) !== "/r/h/x") fail(`chained alias: ${show(utils.resolveAlias("~/x", chained))}`);
+});
+
+// ---------------------------------------------------------------- pins
+
+// pathe/1
+pin("TestHegelPinDotDotStopsAtTheDriveRoot", () => {
+  assert.equal(pathe.normalize("C:\\a\\..\\.."), "C:/");
+  assert.equal(pathe.resolve("C:\\a", "..", ".."), "C:/");
+  assert.equal(pathe.join("C:/a", "../.."), "C:/");
+});
+
+// pathe/2
+pin("TestHegelPinDriveRootHasNoBasename", () => {
+  assert.equal(pathe.dirname("C:\\"), "C:/");
+  assert.equal(pathe.basename("C:\\"), "");
+  assert.deepEqual(pathe.parse("C:/"), { root: "C:/", dir: "C:/", base: "", ext: "", name: "" });
+});
+
+// pathe/3
+pin("TestHegelPinThreeSlashesAreOneRoot", () => {
+  assert.equal(pathe.normalize("///a"), "/a");
+  assert.equal(pathe.resolve("///a"), "/a");
+});
+
+// pathe/4
+pin("TestHegelPinUncParseRootIsThePrefix", () => {
+  const parsed = pathe.parse("\\\\server\\share\\x");
+  assert.equal(parsed.dir, "//server/share");
+  assert.ok(parsed.dir.startsWith(parsed.root) && parsed.root.startsWith("//server/share"), `root ${show(parsed.root)}`);
+});
+
+// pathe/5
+pin("TestHegelPinParseKeepsOneDriveLetterCase", () => {
+  const parsed = pathe.parse("c:/a");
+  assert.ok(parsed.dir.startsWith(parsed.root), `root ${show(parsed.root)}, dir ${show(parsed.dir)}`);
+});
+
+// pathe/6
+pin("TestHegelPinNormalizeKeepsABareDriveRelative", () => {
+  assert.equal(pathe.isAbsolute(pathe.normalize("C:")), pathe.isAbsolute("C:"));
+});
+
+// pathe/7
+pin("TestHegelPinEscapedLettersAreLiteralInGlobs", () => {
+  assert.equal(pathe.matchesGlob("d", "\\d"), true);
+  assert.equal(pathe.matchesGlob("5", "\\d"), false);
+  assert.equal(pathe.matchesGlob("b", "\\b"), true);
+  assert.equal(pathe.matchesGlob(" ", "\\s"), false);
+});
+
+// pathe/8
+pin("TestHegelPinNumericRangesPadToTheWiderEndpoint", () => {
+  assert.equal(pathe.matchesGlob("a02", "a{01..3}"), true);
+  assert.equal(pathe.matchesGlob("a2", "a{01..3}"), false);
+  assert.equal(pathe.matchesGlob("a002", "a{001..3}"), true);
+});
+
+// pathe/9
+pin("TestHegelPinBracketExpressionMayStartWithCloseBracket", () => {
+  assert.equal(pathe.matchesGlob("a/]", "a/[]]"), true);
+  assert.equal(pathe.matchesGlob("a/]", "a/[]a]"), true);
+  assert.equal(pathe.matchesGlob("a/b", "a/[!]]"), true);
+});
+
+// pathe/10
+pin("TestHegelPinFormatIgnoresRootWhenDirIsGiven", () => {
+  assert.equal(pathe.format({ root: "/", dir: "a", base: "b" }), posix.format({ root: "/", dir: "a", base: "b" }));
+});
+
+// pathe/15
+pin("TestHegelPinUncServerStartingWithADotIsKept", () => {
+  assert.equal(pathe.normalize("//.a/c"), "//.a/c");
+  assert.equal(pathe.normalize("\\\\.srv\\share\\x"), "//.srv/share/x");
+});
+
+// pathe/14
+pin("TestHegelPinStarSlashGlobstarMatchesTheSegmentItself", () => {
+  assert.equal(pathe.matchesGlob("a", "a/**"), true);
+  assert.equal(pathe.matchesGlob("a/b", "*/**"), true);
+  assert.equal(pathe.matchesGlob("a", "*/**"), true);
+});
+
+// pathe/13
+pin("TestHegelPinOutOfOrderBracketRangeDoesNotThrow", () => {
+  assert.doesNotThrow(() => pathe.matchesGlob("a", "[a-0]"));
+  assert.doesNotThrow(() => pathe.matchesGlob("a", "x/[z-a]"));
+});
+
+// pathe/12
+pin("TestHegelPinResolveOfADriveRootIsTheDriveRoot", () => {
+  assert.equal(pathe.resolve("C:/"), "C:/");
+  assert.equal(pathe.resolve("C:\\a\\.."), "C:/");
+});
+
+// pathe/11
+pin("TestHegelPinFilenameOfDotDot", () => {
+  assert.equal(utils.filename(".."), pathe.parse("..").name);
+  assert.equal(utils.filename("a/.."), pathe.parse("a/..").name);
+});
