+// Hegel zoo: the small harness shared by the zoo's TypeScript/JavaScript targets.
+//
+// `property(name, body)` registers a node:test test that runs `body(tc)` under Hegel with
+// HEGEL_TEST_CASES cases (default 100) and the database at HEGEL_DATABASE. With ZOO_COLLECT=1
+// a `fail()` records the mismatch instead of failing, the case ends there, and the counts of
+// mismatches and of the shapes seen (`count(key)`) are printed at the end of the test, so a
+// property can be run over many cases to see every shape at once. `pin(name, body)` is a
+// plain test for one pinned bug: it must fail while the bug is present and pass once it is
+// fixed (the zoo's judge reads an unexpected pass as "fixed upstream?").
+
+import { readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+import { test as nodeTest } from "node:test";
+
+// The Hegel version these tests were written against (the zoo pins it in zoo.toml; upstream
+// would add it to devDependencies). smol-toml's package.json declares `devEngines.packageManager
+// = pnpm` with `onFail: "error"`, which makes npm refuse to install anything into the package
+// itself, so Hegel (and the TypeScript compiler that builds src/ into .hegel/dist) are installed
+// with `npm install --prefix .hegel` and imported from there. Checked at load time so a stray
+// install cannot silently change the engine.
+export const HEGEL_PIN = { "@hegeldev/hegel": "0.4.5" };
+
+const hegelDir = join(dirname(fileURLToPath(import.meta.url)), "..", ".hegel", "node_modules", "@hegeldev", "hegel");
+{
+  const installed = JSON.parse(readFileSync(join(hegelDir, "package.json"), "utf8")).version;
+  if (installed !== HEGEL_PIN["@hegeldev/hegel"]) {
+    throw new Error(`@hegeldev/hegel ${installed} is installed; these tests pin ${HEGEL_PIN["@hegeldev/hegel"]}`);
+  }
+}
+const hegel = await import(pathToFileURL(join(hegelDir, "dist", "index.js")));
+const gs = await import(pathToFileURL(join(hegelDir, "dist", "generators", "index.js")));
+
+export const collecting = !!process.env.ZOO_COLLECT;
+
+class Collected extends Error {}
+
+let msgs = [];
+let stats = new Map();
+
+/** Report a mismatch: an error normally, a recorded line in collect mode. */
+export function fail(message) {
+  if (collecting) {
+    msgs.push(message);
+    throw new Collected(message);
+  }
+  throw new Error(message);
+}
+
+/** Bump a statistic (the shape of a pinned bug, a generator branch). */
+export function count(key) {
+  stats.set(key, (stats.get(key) || 0) + 1);
+}
+
+function settings() {
+  const s = { testCases: Number(process.env.HEGEL_TEST_CASES) || 100 };
+  if (process.env.HEGEL_DATABASE) {
+    s.database = hegel.Database.fromPath(process.env.HEGEL_DATABASE);
+  }
+  return s;
+}
+
+// Hegel keys its example database by the test function's source text. Every property here runs
+// through the same wrapper, so without this every property would share one key and replay the
+// stored failing examples of all the others; the key is the test's name instead.
+function keyed(name, fn) {
+  fn.toString = () => name;
+  return fn;
+}
+
+/** A property: `body(tc)` runs under Hegel; a thrown error (or `fail`) is a failure. */
+export function property(name, body) {
+  nodeTest(name, () => {
+    msgs = [];
+    stats = new Map();
+    hegel.test(keyed(name, (tc) => {
+      try {
+        body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }), settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** A pin: a plain test for one recorded bug. */
+export function pin(name, body) {
+  nodeTest(name, body);
+}
+
+/** Hegel's generators, re-exported so the tests import everything from one place. */
+export { gs };
+
+/** Structural equality: arrays by position, objects by key set (prototype ignored), else ===. */
+export function same(a, b) {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) {
+      return false;
+    }
+    return a.every((x, i) => same(x, b[i]));
+  }
+  if (a !== null && b !== null && typeof a === "object" && typeof b === "object") {
+    const ka = Object.keys(a).sort();
+    const kb = Object.keys(b).sort();
+    if (ka.length !== kb.length || ka.some((k, i) => k !== kb[i])) {
+      return false;
+    }
+    return ka.every((k) => same(a[k], b[k]));
+  }
+  return a === b;
+}
+
+/** A compact, unambiguous rendering for messages. */
+export function show(x) {
+  return JSON.stringify(x, (k, v) => (v === undefined ? "<undefined>" : v));
+}
diff --git a/test/hegel.test.mjs b/test/hegel.test.mjs
new file mode 100644
index 0000000..0973fab
--- /dev/null
+++ b/test/hegel.test.mjs
@@ -0,0 +1,788 @@
+// Hegel zoo: property tests for pathe (unjs/pathe); see README.md of the target.
+//
+// Run with `node --test --test-reporter=tap test/hegel.test.mjs` after the setup in target.toml
+// (npm install of Hegel and TypeScript under .hegel/; tsc of src/ into .hegel/dist as CommonJS).
+// HEGEL_TEST_CASES sets the budget, ZOO_COLLECT=1 records mismatches instead of failing at the first.
+// Node's own `path.posix` and `path.win32` are the oracles.
+//
+// Every property draws one record (the helpers are in gen.mjs). A path is a record - its root or
+// drive, its segments, the separators as a tape read modulo its length, a trailing separator -
+// rendered by a pure function; a glob is a list of segments of atoms, each atom carrying the
+// regex the grammar gives it and a few strings that match it, and its candidate paths are drawn
+// from those solutions with one edit applied at a position taken modulo the live length.
+
+import assert from "node:assert/strict";
+import { createRequire } from "node:module";
+import nodePath from "node:path";
+import { count, fail, gs, pin, property, same, show } from "./hegel-zoo.mjs";
+import { chance, ints, maybe, pick, weighted, word } from "./gen.mjs";
+
+const require = createRequire(import.meta.url);
+const pathe = require("../.hegel/dist/index.js");
+const utils = require("../.hegel/dist/utils.js");
+const posix = nodePath.posix;
+const win32 = nodePath.win32;
+
+// Shapes of the recorded bugs (bugs.toml): a property skips a case that has one and stays strict
+// on everything else; each has a pin below.
+const Known = {
+  // pathe/1: ".." climbing past a drive or UNC root drops the root ("C:\a\..\.." -> "/")
+  climbsAboveRoot: (segments) => {
+    let depth = 0;
+    for (const s of segments) {
+      if (s === "" || s === ".") continue;
+      if (s === "..") {
+        if (depth === 0) return true;
+        depth--;
+      } else depth++;
+    }
+    return false;
+  },
+  // pathe/2: dirname/basename/parse of a drive root ("C:\") lose the drive
+  driveRoot: (p) => /^[A-Za-z]:[\\/]+$/.test(p),
+  // pathe/3: three or more leading slashes become a UNC prefix ("///a" -> "//a")
+  threeSlashes: (p) => /^[\\/]{3}/.test(p),
+  // pathe/4: parse().root of a UNC path is "/" (not a prefix of its dir)
+  unc: (p) => /^[\\/]{2}[^\\/]/.test(p),
+  // pathe/5: parse() of a lower-case drive path: root keeps "c:/", dir gets "C:/"
+  lowerDrive: (p) => /^[a-z]:[\\/]/.test(p),
+  // pathe/6: normalize("C:") is the absolute "C:/" but isAbsolute("C:") is false
+  bareDrive: (p) => /^[A-Za-z]:$/.test(p),
+  // pathe/7: an escaped letter or digit in a glob is passed to the RegExp as an escape (\d, \w, \s, \b)
+  escapedAlnum: (atoms) => atoms.some((a) => a.kind === "escape" && /[A-Za-z0-9]/.test(a.char)),
+  // pathe/8: a numeric range pads to the shorter endpoint's width ({01..3} does not match 02)
+  paddedRange: (atoms) => atoms.some((a) => a.kind === "range" && (a.lo.length !== a.hi.length && (a.lo.startsWith("0") || a.hi.startsWith("0")))),
+  // pathe/9: a bracket expression whose first character is "]" is empty ("[]]" does not match "]")
+  bracketStartsWithClose: (atoms) => atoms.some((a) => a.kind === "class" && a.chars[0] === "]"),
+  // pathe/10: format() does not ignore root when dir is given
+  rootAndDir: (obj) => !!obj.root && !!obj.dir,
+  // pathe/11: filename("..") is "."
+  dotdotName: (base) => base === "..",
+  // pathe/14: a segment ending in "*" followed by "**" ("*/**") consumes the slash, so "a" no longer matches "*/**"
+  starBeforeGlobstar: (segments) => segments.some((s, i) => !s.globstar && s.atoms[s.atoms.length - 1].kind === "star" && segments[i + 1] && segments[i + 1].globstar),
+  // pathe/13: a "-" inside a bracket expression is passed to the RegExp as a range: "[a-0]" throws SyntaxError
+  // (a negated class puts "^\\/" first, so a leading "-" becomes a range end too)
+  interiorDash: (atoms) => atoms.some((a) => a.kind === "class" && (a.chars.slice(1, -1).includes("-") || (a.negated && a.chars[0] === "-"))),
+  // pathe/15: a UNC server name starting with "." is rewritten as the device namespace ("//.a/c" -> "//./.a/c")
+  dotServer: (p) => /^[\\/]{2}\.[^\\/]/.test(p),
+  // pathe/12: resolve() of a path that reduces to a drive root gives "/C:" or "C:"
+  resolvesToDriveRoot: (p) => /^[A-Za-z]:/.test(p) && segmentsOf(p).length > 0 && !Known.climbsAboveRoot(segmentsOf(p)) && (() => {
+    let depth = 0;
+    for (const x of segmentsOf(p)) {
+      if (x === ".") continue;
+      depth += x === ".." ? -1 : 1;
+    }
+    return depth === 0;
+  })(),
+};
+
+/** Segments of a path in Windows or POSIX notation, root removed. */
+function segmentsOf(p) {
+  const body = /^[A-Za-z]:/.test(p) ? p.slice(2) : p.replace(/^[\\/]{2}[^\\/]+[\\/]+[^\\/]+/, "");
+  return body.split(/[\\/]+/).filter((x) => x !== "");
+}
+
+/** Node's win32 result in pathe's notation: forward slashes, upper-case drive letter. */
+const W = (s) => (typeof s === "string" ? s.replace(/\\/g, "/").replace(/^([a-z]):/, (m, d) => d.toUpperCase() + ":") : s);
+const Wobj = (o) => Object.fromEntries(Object.entries(o).map(([k, v]) => [k, W(v)]));
+
+// ---------------------------------------------------------------- paths
+//
+// A path is a record rendered by a pure function. The separators of a Windows path are a tape
+// (1-6 of "\" or "/") read modulo its length, so a one-element tape of "/" is the plain spelling.
+
+const NAMES = ["a", "b", "c", "abc", "a.b", "a.b.c", ".a", "..a", "a.", "a..", ".", "..", "-", "_", "a b", "é", "😀", "x.tar.gz", "a-b_c", "A", "b.C"];
+/** lo-hi path segments. */
+const names = (lo, hi) => gs.arrays(pick(NAMES), { minSize: lo, maxSize: hi });
+
+/** The root of a POSIX path: none 45%, "/" 40, "./" 8, "//" 4, "///" 3. */
+const posixRoot = weighted([45, gs.just("")], [40, gs.just("/")], [8, gs.just("./")], [4, gs.just("//")], [3, gs.just("///")]);
+/** The same without the "//" root, which pathe keeps as a UNC prefix by design (README) and the POSIX differential cannot compare. */
+const plainPosixRoot = weighted([47, gs.just("")], [42, gs.just("/")], [8, gs.just("./")], [3, gs.just("///")]);
+/** A POSIX-style path over `root`: segments joined by "/" (doubled 15%), a trailing "/" 20% ("//" 5) after a last segment. */
+const posixPathOf = (root) => gs.record({
+  root,
+  segs: names(0, 4),
+  joiner: chance(15).map((d) => (d ? "//" : "/")),
+  trail: weighted([75, gs.just("")], [20, gs.just("/")], [5, gs.just("//")]),
+}).map(({ root, segs, joiner, trail }) => root + segs.join(joiner) + (segs.length ? trail : ""));
+const posixPath = posixPathOf(posixRoot);
+const plainPosixPath = posixPathOf(plainPosixRoot);
+
+/** A separator tape: "\" 60%, else "/". */
+const seps = gs.arrays(chance(60).map((b) => (b ? "\\" : "/")), { minSize: 1, maxSize: 6 });
+/** The separators of a rendering, read from the tape in order. */
+const tape = (xs) => {
+  let i = 0;
+  return () => xs[i++ % xs.length];
+};
+
+/** A Windows drive path over `segs`: "X:" + separators + segments, mixed separators, optional trailing one; bare "X:" 5% of the time, a doubled first separator 8%. */
+const drivePathOf = (segs) => gs.record({ letter: pick(["C", "D", "c", "Z"]), bare: chance(5), doubled: chance(8), seps, segs, trail: chance(25) }).map(({ letter, bare, doubled, seps, segs, trail }) => {
+  const drive = letter + ":";
+  if (bare) return drive;
+  const sep = tape(seps);
+  let s = drive + sep();
+  if (doubled) s += sep();
+  s += segs.map((x, i) => (i ? sep() : "") + x).join("");
+  if (segs.length && trail) s += sep();
+  return s;
+});
+const drivePath = drivePathOf(names(0, 4));
+/** A drive path with at least one segment 92% of the time: the drive root is pathe/2's shape, which silences the win32 comparison, so it is kept rare. */
+const deepDrivePath = drivePathOf(weighted([92, names(1, 4)], [8, gs.just([])]));
+
+/** A UNC path: two separators, server, share, segments, a trailing separator 25% of the time. */
+const uncPath = gs.record({ seps, server: pick(["server", "srv1", "S"]), share: pick(["share", "c$", "x"]), segs: names(0, 3), trail: chance(25) }).map(({ seps, server, share, segs, trail }) => {
+  const sep = tape(seps);
+  let s = sep() + sep() + server + sep() + share;
+  for (const x of segs) s += sep() + x;
+  if (trail) s += sep();
+  return s;
+});
+
+// ---------------------------------------------------------------- POSIX differential
+
+/**
+ * The extension argument of basename: the path's own extension, a suffix of its basename cut at
+ * `at` (taken modulo the basename's length plus one), or a literal.
+ */
+const extSpec = gs.record({ kind: pick(["own", "suffix", "lit"]), at: ints(0, 12), lit: pick([".b", ".gz", "c", ""]) });
+const extOf = (p, b, { kind, at, lit }) => (kind === "own" ? posix.extname(p) : kind === "suffix" ? b.slice(at % (b.length + 1)) : lit);
+
+/** The POSIX case: two paths without a "//" root, the extension spec, an extra join argument 30% of the time, the no-argument calls 10%. */
+const posixCase = gs.record({ p: plainPosixPath, ext: extSpec, q: plainPosixPath, extra: maybe(30, pick(NAMES)), noArgs: chance(10) });
+
+property("TestHegelAgreesWithNodePosix", (tc) => {
+  const { p, ext: extSpec, q, extra: extraName, noArgs } = tc.draw(posixCase);
+  // pathe keeps a "//" prefix as a UNC root by design; POSIX collapses it (README). The generator
+  // leaves that root out; the gate is a guard.
+  if (/^[\\/]{2}(?![\\/])/.test(p)) count("skip/unc-prefix");
+  tc.assume(!/^[\\/]{2}(?![\\/])/.test(p));
+  const known3 = Known.threeSlashes(p);
+  if (known3) count("known/pathe-3");
+  const cmp = (fn, ...args) => {
+    const a = pathe[fn](...args);
+    const b = posix[fn](...args);
+    if (a !== b) {
+      if (known3) return;
+      fail(`${fn}(${args.map(show).join(", ")}) = ${show(a)}, node posix ${show(b)}`);
+    }
+  };
+  cmp("normalize", p);
+  cmp("isAbsolute", p);
+  cmp("dirname", p);
+  cmp("basename", p);
+  cmp("extname", p);
+  cmp("toNamespacedPath", p);
+  // basename with an extension argument
+  const b = posix.basename(p);
+  const ext = extOf(p, b, extSpec);
+  // Node keeps a dotfile that equals the extension whole where pathe strips it, returns "/" for basename("/", ext) and
+  // keeps a trailing slash when the extension does not match: its own quirks (README)
+  if (ext !== "" && ext !== b && b !== "" && !p.endsWith("/")) cmp("basename", p, ext);
+  // parse and format
+  const pa = pathe.parse(p);
+  const pb = posix.parse(p);
+  if (pb.base === ".." && pb.root !== "") {
+    count("skip/node-parse-dotdot"); // node: parse("/..") has ext "." and name "." (its own quirk)
+  } else if (!same(pa, pb)) {
+    if (!known3) fail(`parse(${show(p)}) = ${show(pa)}, node posix ${show(pb)}`);
+  }
+  if (!pa.dir.startsWith(pa.root)) fail(`parse(${show(p)}).dir ${show(pa.dir)} does not start with root ${show(pa.root)}`);
+  const fa = pathe.format(pa);
+  const fb = posix.format(pb);
+  if (fa !== fb && fa !== posix.normalize(fb) && !known3 && !(pb.base === ".." && pb.root !== "")) fail(`format(parse(${show(p)})) = ${show(fa)}, node posix ${show(fb)}`);
+  // join, resolve, relative with a second path
+  const knownQ = Known.threeSlashes(q) || /^[\\/]{2}(?![\\/])/.test(q);
+  if (!knownQ) {
+    cmp("join", p, q);
+    const extra = extraName === undefined ? [] : [extraName];
+    cmp("join", ...[p, q, ...extra]);
+    cmp("resolve", p, q, ...extra);
+    cmp("relative", p, q);
+    cmp("relative", q, p);
+  }
+  if (noArgs) {
+    cmp("join");
+    cmp("resolve");
+    cmp("join", "", "");
+  }
+});
+
+// ---------------------------------------------------------------- Windows drive paths against node's win32
+
+/** The drive case: a drive path, 1-3 relative segments to join to it, a second drive path. */
+const driveCase = gs.record({ p: deepDrivePath, rel: names(1, 3), q: deepDrivePath });
+
+property("TestHegelAgreesWithNodeWin32OnDrivePaths", (tc) => {
+  const { p, rel, q } = tc.draw(driveCase);
+  const segs = segmentsOf(p);
+  const known1 = Known.climbsAboveRoot(segs);
+  const known2 = Known.driveRoot(p);
+  const known6 = Known.bareDrive(p);
+  if (known1) count("known/pathe-1");
+  if (known2) count("known/pathe-2");
+  if (known6) count("known/pathe-6");
+  const skip = known1 || known2 || known6;
+  const cmp = (fn, ...args) => {
+    const a = pathe[fn](...args);
+    const b = win32[fn](...args);
+    if (W(a) !== W(b)) {
+      if (skip) return;
+      fail(`${fn}(${args.map(show).join(", ")}) = ${show(a)}, node win32 ${show(b)}`);
+    }
+  };
+  cmp("normalize", p);
+  cmp("isAbsolute", p);
+  cmp("dirname", p);
+  cmp("basename", p);
+  cmp("extname", p);
+  const pa = pathe.parse(p);
+  const pb = win32.parse(p);
+  if (!same(Wobj(pa), Wobj(pb))) {
+    if (!skip && !(pb.base === ".." && Known.climbsAboveRoot(segs))) fail(`parse(${show(p)}) = ${show(pa)}, node win32 ${show(pb)}`);
+  }
+  if (!pa.dir.startsWith(pa.root)) {
+    if (Known.lowerDrive(p)) count("known/pathe-5");
+    else if (!skip) fail(`parse(${show(p)}).dir ${show(pa.dir)} does not start with root ${show(pa.root)}`);
+  }
+  // a normalized path is normalized, absolute stays absolute
+  const norm = pathe.normalize(p);
+  if (norm.includes("\\")) fail(`normalize(${show(p)}) = ${show(norm)} keeps a backslash`);
+  if (pathe.normalize(norm) !== norm && !known6) fail(`normalize is not idempotent on ${show(p)}: ${show(norm)} -> ${show(pathe.normalize(norm))}`);
+  if (pathe.isAbsolute(norm) !== pathe.isAbsolute(p)) {
+    if (known6) count("known/pathe-6");
+    else fail(`normalize(${show(p)}) = ${show(norm)} changes isAbsolute ${pathe.isAbsolute(p)} -> ${pathe.isAbsolute(norm)}`);
+  }
+  // join and resolve with relative segments; relative between two drive paths
+  const joined = [p, ...rel];
+  const allSegs = segmentsOf(p).concat(rel.flatMap((r) => r.split(/[\\/]+/)));
+  const knownJ = Known.climbsAboveRoot(allSegs);
+  const known12 = Known.resolvesToDriveRoot(p) || Known.resolvesToDriveRoot(p.replace(/[\\/]*$/, "") + "/" + rel.join("/"));
+  if (!knownJ && !skip) {
+    cmp("join", ...joined);
+    if (known12) count("known/pathe-12");
+    else cmp("resolve", ...joined);
+  } else if (knownJ) count("known/pathe-1");
+  if (!skip && !Known.climbsAboveRoot(segmentsOf(q)) && !Known.driveRoot(q) && !Known.bareDrive(q)) {
