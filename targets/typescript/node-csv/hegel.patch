@@ -0,0 +1,75 @@
+# Hegel zoo: the Python `csv` oracle for node-csv. Reads one JSON request per line from the
+# request FIFO and writes one JSON answer per line to the response FIFO (see hegel/csv.mjs).
+#
+#   {"op": "read", "text": "...", "dialect": {...}}
+#       -> {"ok": true, "records": [[field, ...], ...]} or {"ok": false, "error": "..."}
+#   {"op": "write", "records": [[...], ...], "dialect": {...}}
+#       -> {"ok": true, "text": "..."} or {"ok": false, "error": "..."}
+#
+# dialect keys (all optional): delimiter, quotechar, escapechar (null for none), doublequote,
+# skipinitialspace, strict, lineterminator, quoting ("minimal", "all", "nonnumeric", "none").
+#
+# The reader is fed the text through io.StringIO(newline=""), so "\r", "\n" and "\r\n" all end
+# a record and a newline inside a quoted field is kept as written.
+
+import csv
+import io
+import json
+import sys
+
+QUOTING = {
+    "minimal": csv.QUOTE_MINIMAL,
+    "all": csv.QUOTE_ALL,
+    "nonnumeric": csv.QUOTE_NONNUMERIC,
+    "none": csv.QUOTE_NONE,
+}
+
+
+def dialect_kwargs(d):
+    kw = {}
+    for k in ("delimiter", "quotechar", "escapechar", "doublequote", "skipinitialspace", "strict", "lineterminator"):
+        if k in d:
+            kw[k] = d[k]
+    if "quoting" in d:
+        kw["quoting"] = QUOTING[d["quoting"]]
+    return kw
+
+
+def read(text, dialect):
+    try:
+        rows = list(csv.reader(io.StringIO(text, newline=""), **dialect_kwargs(dialect)))
+    except Exception as e:  # csv.Error, TypeError for a bad dialect
+        return {"ok": False, "error": "%s: %s" % (type(e).__name__, e)}
+    return {"ok": True, "records": rows}
+
+
+def write(records, dialect):
+    out = io.StringIO()
+    try:
+        w = csv.writer(out, **dialect_kwargs(dialect))
+        w.writerows(records)
+    except Exception as e:
+        return {"ok": False, "error": "%s: %s" % (type(e).__name__, e)}
+    return {"ok": True, "text": out.getvalue()}
+
+
+def main(req_path, resp_path):
+    req = open(req_path, "r", encoding="utf-8", errors="surrogatepass")
+    resp = open(resp_path, "w", encoding="utf-8", errors="surrogatepass")
+    for line in req:
+        try:
+            q = json.loads(line)
+            if q["op"] == "read":
+                a = read(q["text"], q.get("dialect", {}))
+            elif q["op"] == "write":
+                a = write(q["records"], q.get("dialect", {}))
+            else:
+                a = {"ok": False, "error": "unknown op %r" % q["op"]}
+        except Exception as e:  # never let the oracle die on one request
+            a = {"ok": False, "error": "oracle: %s: %s" % (type(e).__name__, e)}
+        resp.write(json.dumps(a, ensure_ascii=True) + "\n")
+        resp.flush()
+
+
+if __name__ == "__main__":
+    main(sys.argv[1], sys.argv[2])
