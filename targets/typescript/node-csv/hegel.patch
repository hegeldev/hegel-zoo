+/** Would csv-stringify leave `f` unquoted under options `s`? (the quoting rules of api/index.js) */
+function unquoted(f, s) {
+  if (s.quoted || s.quoted_string) return false;
+  const rd = resolveRd(s.record_delimiter);
+  const delimiter = s.delimiter ?? ",";
+  const quote = s.quote ?? "\"";
+  if (f.includes(delimiter) || f.includes(rd) || f.includes(quote)) return false;
+  if (s.quoted_match) {
+    const m = Array.isArray(s.quoted_match) ? s.quoted_match : [s.quoted_match];
+    if (m.some((p) => (typeof p === "string" ? f.includes(p) : p.test(f)))) return false;
+  }
+  return true;
+}
+
+/** Would csv-stringify write an empty field as nothing under options `s`? */
+function emptyUnquoted(s) {
+  return s.quoted_empty !== true && !(s.quoted_string && s.quoted_empty !== false);
+}
