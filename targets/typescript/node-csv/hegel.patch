@@ -0,0 +1,430 @@
+// Hegel zoo: the Python `csv` oracle bridge, the library under test, and the generators used by
+// the properties (records and option sets for the round trips, raw CSV documents with their
+// expected model for the parser, mutations for the hostile-input checks).
+
+import { execFileSync, spawn } from "node:child_process";
+import { mkdtempSync, openSync, readSync, rmSync, writeSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { dirname, join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { chance, count, n, pick, word } from "./hegel-zoo.mjs";
+
+const here = dirname(fileURLToPath(import.meta.url));
+
+// The libraries under test: the ESM sources of the two packages.
+export const { parse, CsvError } = await import("../packages/csv-parse/lib/sync.js");
+export const { Parser } = await import("../packages/csv-parse/lib/index.js");
+export const { delimiter_discover } = await import("../packages/csv-parse/lib/utils/delimiter_discover.js");
+export const { stringify } = await import("../packages/csv-stringify/lib/sync.js");
+
+// ---------------------------------------------------------------- the oracle, held open
+
+let oracle = null;
+
+function startOracle() {
+  execFileSync("python3", ["-c", "import csv"], { stdio: "ignore" });
+  const dir = mkdtempSync(join(tmpdir(), "hegel-csv-"));
+  const req = join(dir, "req");
+  const resp = join(dir, "resp");
+  execFileSync("mkfifo", [req, resp]);
+  const child = spawn("python3", ["-u", join(here, "oracle.py"), req, resp], {
+    stdio: ["ignore", "inherit", "inherit"],
+  });
+  child.unref();
+  const wfd = openSync(req, "w");
+  const rfd = openSync(resp, "r");
+  process.on("exit", () => {
+    try { child.kill(); } catch {}
+    try { rmSync(dir, { recursive: true, force: true }); } catch {}
+  });
+  const buf = Buffer.alloc(1 << 16);
+  let pending = "";
+  return {
+    call(obj) {
+      // Lone surrogates cannot cross as UTF-8; escape every surrogate code unit.
+      const line = JSON.stringify(obj).replace(/[\ud800-\udfff]/g, (c) => "\\u" + c.charCodeAt(0).toString(16).padStart(4, "0"));
+      writeSync(wfd, line + "\n");
+      for (;;) {
+        const nl = pending.indexOf("\n");
+        if (nl !== -1) {
+          const answer = pending.slice(0, nl);
+          pending = pending.slice(nl + 1);
+          return JSON.parse(answer);
+        }
+        const got = readSync(rfd, buf, 0, buf.length, null);
+        if (got === 0) throw new Error("the csv oracle went away");
+        pending += buf.toString("utf8", 0, got);
+      }
+    },
+  };
+}
+
+/** Python's csv.reader on `text` with `dialect` (see oracle.py): {ok, records} or {ok: false, error}. */
+export function pyRead(text, dialect) {
+  oracle ??= startOracle();
+  return oracle.call({ op: "read", text, dialect });
+}
+
+/** Python's csv.writer on `records` with `dialect`: {ok, text} or {ok: false, error}. */
+export function pyWrite(records, dialect) {
+  oracle ??= startOracle();
+  return oracle.call({ op: "write", records, dialect });
+}
+
+// ---------------------------------------------------------------- fields and records
+
+const WORDS = ["a", "b", "x", "abc", "hello", "world", "42", "-1", "3.5", "1e3", "0x10", "true", "null", "NaN", "e", "ee", "Z"];
+const ODD = ["\u00e9", "\u65e5\u672c", "\ud83d\ude00", "\u00ff", "\u0100", "\u00a0", "\u2028", "\u2029", "\u3000", "\u001e", "\u0000", "\u0085", "\ufeff", "\u007f", "\u200b"];
+const PUNCT = [",", ";", "\t", "|", ":", " ", "  ", ".", "/", "#", "=", "+", "-", "@", "'", "\"", "\\", "^", "~", "«", "＝", "＋"];
+const BREAKS = ["\n", "\r", "\r\n", "\n\r", "\n\n"];
+
+/** A field: a short concatenation of words, punctuation (delimiters, quotes, escapes, comment
+ *  and formula characters), line breaks and odd characters, often empty; `avoid` is a set of
+ *  strings none of which may appear as a substring, `newlines` allows line breaks, `nonempty`
+ *  forbids the empty field. */
+export function genField(tc, { avoid = [], newlines = true, nonempty = false } = {}) {
+  for (let attempt = 0; attempt < 20; attempt++) {
+    let s = "";
+    const parts = !nonempty && chance(tc, 15) ? 0 : n(tc, 1, 4);
+    for (let i = 0; i < parts; i++) {
+      const r = n(tc, 0, 99);
+      if (r < 45) s += pick(tc, WORDS);
+      else if (r < 75) s += pick(tc, PUNCT);
+      else if (r < 85) s += pick(tc, ODD);
+      else if (r < 95 && newlines) s += pick(tc, BREAKS);
+      else s += word(tc, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789", 1, 6);
+    }
+    if (avoid.every((a) => a === "" || !s.includes(a))) return s;
+  }
+  return "";
+}
+
+/** Rectangular records: `rows` x `width` fields. */
+export function genRecords(tc, { rows = n(tc, 0, 6), width = n(tc, 1, 5), field = (tc) => genField(tc) } = {}) {
+  const out = [];
+  for (let r = 0; r < rows; r++) {
+    const rec = [];
+    for (let c = 0; c < width; c++) rec.push(field(tc));
+    out.push(rec);
+  }
+  return out;
+}
+
+const DELIMITERS = [",", ",", ",", ";", "\t", "|", ":", " ", "::", ", ", "é", "│"];
+const QUOTES = ["\"", "\"", "\"", "'", "|", "«", "~"];
+const RECORD_DELIMITERS = ["\n", "\n", "\r\n", "\r", "unix", "windows", "mac", "ascii", "unicode", "\u001e", "\u2028", "||", ";\n", "\n\n"];
+const ESCAPES = ["\\", "^", "\\", "§"];
+
+function resolveRd(rd) {
+  return { unix: "\n", windows: "\r\n", mac: "\r", ascii: "\u001e", unicode: "\u2028" }[rd] ?? rd;
+}
+
+/** Distinct separator characters for a document: delimiter, quote, escape and record delimiter
+ *  that do not contain one another (the escape may equal the quote: RFC 4180 doubling);
+ *  `multibyte` asks for a record delimiter, delimiter, quote or escape of more than one byte,
+ *  `lines` for a record delimiter that advances csv-parse's line count (one starting with a CR or LF). */
+export function genSeparators(tc, { python = false, multibyte = false, lines = false } = {}) {
+  // the pools are narrowed to the shape asked for rather than redrawn until it comes up, so the
+  // simplest case stays small: `multibyte` widens the record delimiter (0), the delimiter (1), the
+  // quote (2) or the escape (3)
+  const wide = multibyte ? n(tc, 0, 3) : -1;
+  const isWide = (s) => Buffer.byteLength(s) > 1;
+  const ascii = (s) => s.length === 1 && s.charCodeAt(0) < 128;
+  const delimiters = python ? DELIMITERS.filter(ascii) : wide === 1 ? DELIMITERS.filter(isWide) : DELIMITERS;
+  const quotes = python ? QUOTES.filter(ascii) : wide === 2 ? QUOTES.filter(isWide) : QUOTES;
+  const escapes = python ? ESCAPES.filter(ascii) : wide === 3 ? ESCAPES.filter(isWide) : ESCAPES;
+  const rdNames = python
+    ? ["\n", "\n", "\r\n", "\r"]
+    : RECORD_DELIMITERS.filter((r) => (!lines || /^[\r\n]/.test(resolveRd(r))) && (wide !== 0 || isWide(resolveRd(r))));
+  for (;;) {
+    const delimiter = pick(tc, delimiters);
+    const quote = pick(tc, quotes);
+    const escape = wide !== 3 && chance(tc, 60) ? quote : pick(tc, escapes);
+    const rdName = pick(tc, rdNames);
+    const rd = resolveRd(rdName);
+    const chars = new Set([...delimiter, ...quote, ...escape, ...rd]);
+    if (chars.size !== delimiter.length + quote.length + (escape === quote ? 0 : escape.length) + rd.length) continue;
+    if (/[\r\n]/.test(delimiter) || /[\r\n]/.test(quote) || /[\r\n]/.test(escape)) continue;
+    // a record delimiter that shares characters with the delimiter would fuse at boundaries
+    if ([...rd].some((c) => delimiter.includes(c)) || [...delimiter].some((c) => rd.includes(c))) continue;
+    return { delimiter, quote, escape, rdName, rd };
+  }
+}
+
+// ---------------------------------------------------------------- raw documents with a model
+
+const TRIM_WS = [" ", "\t", " \t", "  "];
+// csv-parse's trimable characters (init_state.js): the JS whitespace set, line breaks included
+const TRIM_CLASS = "[ \\t\\n\\r\\f\\v\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]";
+const TRIM_START = new RegExp("^" + TRIM_CLASS + "+");
+const TRIM_END = new RegExp(TRIM_CLASS + "+$");
+const TRIM_ALL = new RegExp("^" + TRIM_CLASS + "+$");
+
+/** A raw CSV document written in the RFC 4180 style with the given separators and a model of
+ *  how csv-parse (and Python's strict reader, on the plain subset) should read it. Lines:
+ *  {kind: "record", fields, quoted}, {kind: "empty"}, {kind: "comment"}; each record line's
+ *  `span` is the number of physical lines it covers (quoted fields may hold line breaks). The
+ *  option set decides what the generator may write: comment lines only with `comment` (`false`
+ *  for none), whitespace around fields only with ltrim/rtrim, empty lines only when they parse;
+ *  `noCrlfInQuotes` keeps a CRLF out of the quoted fields. */
+export function genDocument(tc, opts = {}) {
+  const sep = opts.sep ?? genSeparators(tc);
+  const { delimiter, quote, escape, rd } = sep;
+  const comment = opts.comment ?? (chance(tc, 25) ? pick(tc, ["#", "//", "%", "--"]) : null);
+  const ltrim = opts.ltrim ?? chance(tc, 25);
+  const rtrim = opts.rtrim ?? chance(tc, 25);
+  const width = opts.width ?? n(tc, 1, 5);
+  const ragged = opts.ragged ?? chance(tc, 15);
+  const emptyLines = opts.emptyLines ?? chance(tc, 30);
+  const trailing = chance(tc, 70);
+  const bom = opts.bom ?? chance(tc, 10);
+  const nlines = n(tc, 0, 7);
+  const bareAvoid = [delimiter, quote, "\r", "\n", rd, ...(escape === quote ? [] : [escape]), ...(comment ? [comment] : [])];
+  // padding whitespace must not be the delimiter (a space or tab delimiter is a delimiter first)
+  const padding = TRIM_WS.filter((ws) => ![...ws].some((c) => delimiter.includes(c) || rd.includes(c)));
+  const quotedAvoid = [rd.length > 1 && !/^[\r\n]+$/.test(rd) ? rd : "", opts.noCrlfInQuotes ? "\r\n" : ""];
+  const lines = [];
+  let text = bom ? "\ufeff" : "";
+  let physical = 1;
+  for (let i = 0; i < nlines; i++) {
+    const r = n(tc, 0, 99);
+    let raw;
+    let line;
+    if (comment && r < 15) {
+      raw = comment + genField(tc, { avoid: ["\r", "\n", rd] });
+      line = { kind: "comment", raw, start: physical, span: 1 };
+    } else if (emptyLines && r < 30) {
+      raw = "";
+      line = { kind: "empty", raw, start: physical, span: 1 };
+    } else {
+      const w = ragged && chance(tc, 30) ? n(tc, 1, width + 2) : width;
+      const fields = [];
+      const rawFields = [];
+      let span = 1;
+      for (let c = 0; c < w; c++) {
+        const quoted = chance(tc, 45);
+        let value;
+        let rawField;
+        if (quoted) {
+          value = genField(tc, { avoid: quotedAvoid });
+          let inner = "";
+          for (const ch of value) {
+            if (ch === quote || ch === escape) inner += escape + ch;
+            else inner += ch;
+          }
+          rawField = quote + inner + quote;
+          span += (value.match(/\r\n|\r|\n/g) || []).length;
+        } else {
+          value = genField(tc, { avoid: bareAvoid, newlines: false });
+          rawField = value;
+        }
+        // whitespace around the field, allowed only when it is trimmed away
+        if (ltrim && chance(tc, 40)) {
+          const ws = pick(tc, padding);
+          rawField = ws + rawField;
+        }
+        if (rtrim && chance(tc, 40)) rawField = rawField + pick(tc, padding);
+        if (!quoted) {
+          if (ltrim) value = value.replace(TRIM_START, "");
+          if (rtrim) value = value.replace(TRIM_END, "");
+        }
+        fields.push(value);
+        rawFields.push(rawField);
+      }
+      raw = rawFields.join(delimiter);
+      line = { kind: "record", fields, raw, start: physical, span };
+    }
+    lines.push(line);
+    text += raw;
+    if (i < nlines - 1 || trailing) text += rd;
+    // a record delimiter counts as one line break when it starts with a CR or LF (csv-parse counts
+    // lines by the CR/LF bytes it meets, and skips the rest of a matched delimiter); with any other
+    // record delimiter the line count never advances
+    physical += line.span - 1 + (/^[\r\n]/.test(rd) ? 1 : 0);
+  }
+  // a last line that reads as empty with no record delimiter after it is nothing at all
+  if (!trailing && lines.length && emptyish(lines[lines.length - 1], ltrim)) lines.pop();
+  return { text, lines, sep, comment, ltrim, rtrim, width, bom, trailing, rdKind: rd };
+}
+
+/** A document written from given lines, in the shape `genDocument` gives (for the properties that
+ *  draw one recorded bug's shape): `specs` are {kind: "comment", body}, {kind: "empty"} or
+ *  {kind: "record", fields: [{value, quoted}]}; no trimming, no BOM. */
+export function renderDocument(specs, sep, { comment = null, trailing = true } = {}) {
+  const { quote, escape, rd } = sep;
+  const lines = [];
+  let text = "";
+  let physical = 1;
+  specs.forEach((spec, i) => {
+    let raw;
+    let line;
+    if (spec.kind === "comment") {
+      raw = comment + spec.body;
+      line = { kind: "comment", raw, start: physical, span: 1 };
+    } else if (spec.kind === "empty") {
+      raw = "";
+      line = { kind: "empty", raw, start: physical, span: 1 };
+    } else {
+      let span = 1;
+      const rawFields = spec.fields.map(({ value, quoted }) => {
+        if (!quoted) return value;
+        let inner = "";
+        for (const ch of value) inner += ch === quote || ch === escape ? escape + ch : ch;
+        span += (value.match(/\r\n|\r|\n/g) || []).length;
+        return quote + inner + quote;
+      });
+      raw = rawFields.join(sep.delimiter);
+      line = { kind: "record", fields: spec.fields.map((f) => f.value), raw, start: physical, span };
+    }
+    lines.push(line);
+    text += raw;
+    if (i < specs.length - 1 || trailing) text += rd;
+    physical += line.span - 1 + (/^[\r\n]/.test(rd) ? 1 : 0);
+  });
+  if (!trailing && lines.length && emptyish(lines[lines.length - 1], false)) lines.pop();
+  return { text, lines, sep, comment, ltrim: false, rtrim: false, width: specs.find((s) => s.kind === "record")?.fields.length ?? 1, bom: false, trailing, rdKind: rd };
+}
+
+/** A line csv-parse reads as empty: an empty line, a record line that is one bare empty field,
+ *  or, with ltrim, one of whitespace only. */
+function emptyish(line, ltrim) {
+  return line.kind === "empty" || line.raw === "" || (ltrim && TRIM_ALL.test(line.raw));
+}
+
+/** The records csv-parse should produce for a generated document under `options` (a subset of
+ *  its options: from, to, from_line, to_line, skip_empty_lines, relax_column_count[_less|_more],
+ *  columns), as {records, error} where `error` is the CsvError code expected instead. */
+export function model(doc, options = {}) {
+  const from = options.from ?? 1;
+  const to = options.to ?? -1;
+  const fromLine = options.from_line ?? 1;
+  const toLine = options.to_line ?? -1;
+  const skipEmpty = !!options.skip_empty_lines;
+  const relax = !!options.relax_column_count;
+  const relaxLess = !!options.relax_column_count_less;
+  const relaxMore = !!options.relax_column_count_more;
+  const columns = options.columns === true;
+  const recs = [];
+  let header = null;
+  let expected = null;
+  let records = 0;
+  let commentLines = 0;
+  let emptyLines = 0;
+  for (const line of doc.lines) {
+    const last = line.start + line.span - 1;
+    if (toLine !== -1 && last > toLine) break;
+    if (line.kind === "comment") {
+      commentLines++;
+      continue;
+    }
+    if (line.start < fromLine) continue;
+    let fields = line.fields;
+    if (emptyish(line, doc.ltrim) && skipEmpty) {
+      emptyLines++;
+      continue;
+    }
+    if (line.kind === "empty") fields = [""];
+    if (columns && header === null) {
+      header = fields;
+      expected = fields.length;
+      continue;
+    }
+    if (expected === null) expected = fields.length;
+    if (fields.length !== expected) {
+      const ok = relax || (relaxLess && fields.length < expected) || (relaxMore && fields.length > expected);
+      if (!ok) return { records: recs, header, error: columns ? "CSV_RECORD_INCONSISTENT_COLUMNS" : "CSV_RECORD_INCONSISTENT_FIELDS_LENGTH" };
+    }
+    records++;
+    if (records < from) {
+      // `to` counts the records handled, the skipped ones included
+      if (to !== -1 && records >= to) break;
+      continue;
+    }
+    let rec = fields;
+    if (columns) {
+      rec = {};
+      for (let i = 0; i < Math.min(header.length, fields.length); i++) rec[header[i]] = fields[i];
+    }
+    recs.push({ record: rec, info: { lines: last, records, comment_lines: commentLines, empty_lines: emptyLines } });
+    if (to !== -1 && records >= to) break;
+  }
+  return { records: recs, header, error: null };
+}
+
+/** The csv-parse options for a generated document (separators and the trim/comment choices). */
+export function parseOptions(doc, extra = {}) {
+  const { delimiter, quote, escape, rd } = doc.sep;
+  const o = { delimiter, quote, escape, ...extra };
+  if (doc.comment) o.comment = doc.comment;
+  if (doc.ltrim) o.ltrim = true;
+  if (doc.rtrim) o.rtrim = true;
+  if (doc.bom) o.bom = true;
+  // the three usual line endings are discovered; anything else must be named
+  if (!["\n", "\r\n", "\r"].includes(rd) || extra.explicitRd) o.record_delimiter = rd;
+  delete o.explicitRd;
+  return o;
+}
+
+// ---------------------------------------------------------------- mutations
+
+/** `text` with 1..k random edits: a character inserted, deleted, replaced or a slice
+ *  duplicated; the inserted characters favour the separators of `sep`. */
+export function mutate(tc, text, sep, k = n(tc, 1, 3)) {
+  const special = [sep.delimiter, sep.quote, sep.escape, sep.rd, "\n", "\r", "\r\n", " ", "\"", "'", "\\", "#", "\ufeff", "\u00e9", "\ud800", "\u2028"];
+  for (let i = 0; i < k; i++) {
+    const pos = n(tc, 0, text.length);
+    const r = n(tc, 0, 3);
+    if (r === 0 || text.length === 0) text = text.slice(0, pos) + pick(tc, special) + text.slice(pos);
+    else if (r === 1) text = text.slice(0, pos) + text.slice(pos + 1);
+    else if (r === 2) text = text.slice(0, pos) + pick(tc, special) + text.slice(pos + 1);
+    else {
+      const end = Math.min(text.length, pos + n(tc, 1, 5));
+      text = text.slice(0, end) + text.slice(pos, end) + text.slice(end);
+    }
+  }
+  return text;
+}
+
+/** Random chunk boundaries for a buffer: byte offsets, often cutting inside multi-byte
+ *  sequences and multi-character separators. */
+export function chunk(tc, buf) {
+  const out = [];
+  let pos = 0;
+  while (pos < buf.length) {
+    const len = chance(tc, 30) ? 1 : n(tc, 1, Math.max(1, Math.min(buf.length - pos, 12)));
+    out.push(buf.subarray(pos, pos + len));
+    pos += len;
+  }
+  if (chance(tc, 20)) out.push(Buffer.alloc(0));
+  return out;
+}
+
+/** Feed `chunks` to a csv-parse stream with `options`; resolves {records} or {error}. */
+export function parseStream(chunks, options) {
+  return new Promise((resolve) => {
+    const records = [];
+    let done = false;
+    const finish = (v) => {
+      if (!done) {
+        done = true;
+        resolve(v);
+      }
+    };
+    const parser = new Parser(options);
+    parser.on("readable", function () {
+      let rec;
+      while ((rec = this.read()) !== null) records.push(rec);
+    });
+    parser.on("error", (error) => finish({ error }));
+    parser.on("end", () => finish({ records }));
+    parser.on("close", () => finish({ records }));
+    // a source stops writing once the parser has ended itself (`to`, `to_line`), as pipe() does
+    for (const c of chunks) {
+      if (parser.writableEnded || parser.destroyed) break;
+      parser.write(c);
+    }
+    if (!parser.writableEnded && !parser.destroyed) parser.end();
+  });
+}
+
+export { count };
