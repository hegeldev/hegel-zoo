+// Hegel zoo: the shapes of the recorded bugs of node-csv (bugs.toml). `known(where, ctx)` returns
+// the bug id when a mismatch has the shape of a recorded bug; the property then names it in its
+// failure (the bug is found, and the property is the expected failure), or under HEGEL_NO_KNOWN=1
+// skips the case (see `recorded` in hegel.test.mjs). `where` names the property, `ctx` carries
+// what it has. The tests are consulted only once the two sides differ, so they cannot hide
+// coverage.
+
+const FORMULA = new Set(["=", "+", "-", "@", "\t", "\r", "＝", "＋", "－", "＠"]);
+
+function resolveRd(rd) {
+  return { unix: "\n", windows: "\r\n", mac: "\r", ascii: "", unicode: " " }[rd] ?? rd ?? "\n";
