+const loneEmpty = (r) => r.length === 1 && r[0] === "";
+
+export function known(where, ctx) {
+  if (where === "roundtrip" || where === "python-reads") {
+    const { records, s } = ctx;
+    const fields = records.flat();
+    // node-csv/1: a field holding a CR or LF that is not the record delimiter is written bare
+    if (fields.some((f) => /[\r\n]/.test(f) && unquoted(f, s))) return "node-csv/1";
+    // node-csv/2: a lone empty field is written as an empty line: no fields to Python's reader,
+    // and nothing at all to csv-parse when it ends the output (`eof: false`)
+    if (where === "python-reads" && records.some(loneEmpty) && emptyUnquoted(s)) return "node-csv/2";
+    if (where === "roundtrip" && s.eof === false && records.length && loneEmpty(records[records.length - 1]) && emptyUnquoted(s)) return "node-csv/2";
+    // node-csv/3: escape_formulas prefixes a quote character without escaping it
+    if (s.escape_formulas && (s.quote ?? "\"") === "'" && fields.some((f) => f && FORMULA.has(f[0]))) return "node-csv/3";
+  }
+  if (where === "model") {
+    const { doc, opts } = ctx;
+    // node-csv/4: a comment line just before from_line swallows the record at from_line
+    if (opts.from_line > 1 && doc.lines.some((l) => l.kind === "comment" && l.start === opts.from_line - 1)) return "node-csv/4";
+    // node-csv/5: a CRLF inside a quoted field counts as two lines
+    if ((opts.info || opts.from_line || opts.to_line) && doc.lines.some((l) => l.kind === "record" && l.raw.includes("\r\n"))) return "node-csv/5";
+  }
+  if (where === "stream") {
+    const { opts, streamed } = ctx;
+    // node-csv/10: after a closing quote of several bytes the stream does not wait for a whole
+    // delimiter of several bytes
+    if (Buffer.byteLength(opts.quote ?? "\"") > 1 && Buffer.byteLength(opts.delimiter ?? ",") > 2 &&
+      (streamed.error === "CSV_INVALID_CLOSING_QUOTE" || opts.skip_records_with_error)) return "node-csv/10";
+  }
+  if (where === "hostile") {
+    // node-csv/9: delimiter_auto on an empty stream throws
+    if (ctx.opts.delimiter_auto && ctx.text === "" && (ctx.crash ?? "").includes("reading 'map'")) return "node-csv/9";
+    // node-csv/6, reached through the parser
+    if (ctx.opts.delimiter_auto && /[^\x00-\x7e]/.test(ctx.text) && (ctx.crash ?? "").startsWith("TypeError")) return "node-csv/6";
+  }
+  if (where === "discover") {
+    // node-csv/6: delimiter discovery throws on a character beyond U+007E
+    if (/[^\x00-\x7e]/.test(ctx.text) && (ctx.error ?? "").startsWith("TypeError")) return "node-csv/6";
+  }
+  return "";
+}
