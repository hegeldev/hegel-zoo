index 0000000..2b0a5ec
--- /dev/null
+++ b/hegel/hegel.test.mjs
@@ -0,0 +1,1320 @@
+// Hegel zoo: property-based tests for cron-parser (harrisiirak/cron-parser).
+//
+// The library is compiled from src/ into .hegel/dist by the target's setup (see hegel/tsconfig.json)
+// and used as CommonJS. The oracle is a brute-force model over wall-clock fields in the expression's
+// time zone (luxon, the library's own runtime dependency, does the zone arithmetic): the next
+// occurrence is the first whole-second instant after `currentDate` whose local fields match.
+
+import { createRequire } from "node:module";
+import { mkdtempSync, writeFileSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { property, pin, fail, count, n, pick, chance, word, same, show } from "./hegel-zoo.mjs";
+
+const require = createRequire(import.meta.url);
+const cron = require("../.hegel/dist/index.js");
+const { CronExpressionParser, CronExpression, CronFieldCollection, CronFileParser } = cron;
+const { DateTime } = require("../.hegel/node_modules/luxon");
+
+// ---------------------------------------------------------------------------------------------
+// Generators
+
+const FIELDS = ["second", "minute", "hour", "dayOfMonth", "month", "dayOfWeek"];
+const RANGES = { second: [0, 59], minute: [0, 59], hour: [0, 23], dayOfMonth: [1, 31], month: [1, 12], dayOfWeek: [0, 7] };
+const MONTHS = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"];
+const DAYS = ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"];
+const ZONES = [
+  "UTC",
+  "America/New_York",
+  "Europe/Rome",
+  "Asia/Kolkata",
+  "Australia/Lord_Howe",
+  "Pacific/Auckland",
+  "America/Santiago",
+  "America/Sao_Paulo",
+  "Asia/Tokyo",
+  "Pacific/Chatham",
+  "America/Havana",
+];
+
+/** Does the UTC offset change by other than whole hours on this day (Lord Howe's 30-minute DST)? */
+function halfHourShift(day) {
+  const before = day.minus({ hours: 1 }).offset;
+  const after = day.endOf("day").offset;
+  return (after - before) % 60 !== 0;
+}
+
+/** The alias for a numeric month/weekday value (weekday 7 is SUN too). */
+function alias(field, v, tc) {
+  if (field === "dayOfWeek" && v === 7) {
+    return "7";
+  }
+  const name = field === "month" ? MONTHS[v - 1] : DAYS[v];
+  return chance(tc, 20) ? name.toLowerCase() : name;
+}
+
+/** Values lo..hi stepping by s. */
+function stepped(lo, hi, s) {
+  const out = [];
+  for (let v = lo; v <= hi; v += s) {
+    out.push(v);
+  }
+  return out;
+}
+
+/**
+ * One numeric element of a field: `*`, `v`, `a-b`, `a-b/s`, `*\/s`, `a/s`, with aliases for month
+ * and dayOfWeek. Returns {text, values, wildcard} where `values` is the model's expansion.
+ */
+function genElement(tc, field) {
+  const [lo, hi] = RANGES[field];
+  const canAlias = field === "month" || field === "dayOfWeek";
+  const num = (v) => (canAlias && chance(tc, 25) ? alias(field, v, tc) : String(v));
+  const small = () => (chance(tc, 60) ? n(tc, 1, 5) : n(tc, 1, hi - lo));
+  switch (n(tc, 0, 6)) {
+    case 0:
+      return { text: chance(tc, 85) ? "*" : "?", values: stepped(lo, hi, 1), wildcard: true };
+    case 1: {
+      const v = n(tc, lo, hi);
+      return { text: num(v), values: [v] };
+    }
+    case 2: {
+      const a = n(tc, lo, hi);
+      const b = n(tc, a, hi);
+      return { text: `${num(a)}-${num(b)}`, values: stepped(a, b, 1) };
+    }
+    case 3: {
+      const a = n(tc, lo, hi);
+      const b = n(tc, a, hi);
+      const s = small();
+      return { text: `${num(a)}-${num(b)}/${s}`, values: stepped(a, b, s) };
+    }
+    case 4: {
+      const s = small();
+      return { text: `*/${s}`, values: stepped(lo, hi, s) };
+    }
+    case 5: {
+      const a = n(tc, lo, hi);
+      const s = small();
+      return { text: `${num(a)}/${s}`, values: stepped(a, hi, s) };
+    }
+    default: {
+      const v = n(tc, lo, hi);
+      return { text: num(v), values: [v] };
+    }
+  }
+}
+
+/**
+ * A whole field: a list of 1-3 numeric elements, or (for the day fields) one of the specials.
+ * Returns {text, values, wildcard, last, nth} with the model's view of it.
+ */
+function genField(tc, field) {
+  if (field === "dayOfMonth" && chance(tc, 12)) {
+    count("dom-L");
+    return { text: "L", values: [], last: true, wildcard: false };
+  }
+  if (field === "dayOfWeek" && chance(tc, 12)) {
+    const d = n(tc, 0, 7);
+    count("dow-L");
+    return { text: `${d}L`, values: [], lastDays: [d % 7], wildcard: false };
+  }
+  if (field === "dayOfWeek" && chance(tc, 12)) {
+    const d = n(tc, 0, 7);
+    const k = n(tc, 1, 5);
+    count("dow-nth");
+    return { text: `${d}#${k}`, values: [d], nth: k, wildcard: false };
+  }
+  // the library rejects a list whose elements overlap ("duplicate values found"), so the
+  // elements of a list are kept disjoint (an overlapping draw is dropped)
+  const k = chance(tc, 70) ? 1 : n(tc, 2, 3);
+  const parts = [];
+  const seen = new Set();
+  for (let i = 0; i < k; i++) {
+    const e = genElement(tc, field);
+    const dup = e.values.some((v) => seen.has(v) || (field === "dayOfWeek" && seen.has((v + 7) % 14)));
+    if (dup && parts.length > 0) {
+      count("overlap-dropped");
+      continue;
+    }
+    parts.push(e);
+    e.values.forEach((v) => seen.add(v));
+  }
+  const values = [...new Set(parts.flatMap((p) => p.values))].sort((a, b) => a - b);
+  return { text: parts.map((p) => p.text).join(","), values, wildcard: parts.length === 1 && parts[0].wildcard === true };
+}
+
+/** A whole expression: 6 fields (or 5, the seconds defaulting to 0). */
+function genExpression(tc, { seconds = chance(tc, 45) } = {}) {
+  const spec = {};
+  for (const f of FIELDS) {
+    spec[f] = genField(tc, f);
+  }
+  if (!seconds) {
+    spec.second = { text: null, values: [0], wildcard: false };
+  }
+  const text = FIELDS.filter((f) => spec[f].text !== null)
+    .map((f) => spec[f].text)
+    .join(" ");
+  return { text, spec, seconds };
+}
+
+const T0 = Date.UTC(2000, 0, 1);
+const T1 = Date.UTC(2040, 0, 1);
+
+/** An instant: whole seconds half the time, otherwise with milliseconds. */
+function genInstant(tc) {
+  const secs = n(tc, Math.floor(T0 / 1000), Math.floor(T1 / 1000));
+  const ms = chance(tc, 50) ? 0 : n(tc, 1, 999);
+  return secs * 1000 + ms;
+}
+
+// ---------------------------------------------------------------------------------------------
+// The model
+
+const DAYS_IN_MONTH = [31, 29, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
+
+/** The library's "Invalid explicit day of month definition": one month, numeric DOM all past it, DOW wildcard. */
+function unreachableDom(spec) {
+  const months = spec.month.values;
+  if (months.length !== 1 || spec.dayOfMonth.last || !spec.dayOfWeek.wildcard) {
+    return false;
+  }
+  const dim = DAYS_IN_MONTH[months[0] - 1];
+  return spec.dayOfMonth.values.every((d) => d > dim);
+}
+
+/** The library prunes numeric days past the month's length when the month field is a single value. */
+function prune(domValues, monthValues) {
+  if (monthValues.length !== 1) {
+    return domValues;
+  }
+  const dim = DAYS_IN_MONTH[monthValues[0] - 1];
+  const kept = domValues.filter((d) => d <= dim);
+  return kept.length > 0 ? kept : domValues;
+}
+
+function numbers(values) {
+  return values.filter((v) => typeof v === "number");
+}
+
+/** Normalise a day-of-week value list: 7 is Sunday. */
+function normDow(values) {
+  return [...new Set(numbers(values).map((v) => v % 7))].sort((a, b) => a - b);
+}
+
+/** Does the wall-clock day `d` (a luxon DateTime) satisfy the day-of-week field? */
+function dowMatch(fields, d) {
+  const f = fields.dayOfWeek;
+  const dow = d.weekday % 7;
+  const plain = normDow(f.values).includes(dow) && (f.nthDay <= 0 || Math.ceil(d.day / 7) === f.nthDay);
+  const lasts = f.values.filter((v) => typeof v === "string").map((v) => parseInt(v, 10) % 7);
+  const last = lasts.includes(dow) && d.day > d.daysInMonth - 7;
+  return plain || last;
+}
+
+function domMatch(fields, d) {
+  const f = fields.dayOfMonth;
+  return numbers(f.values).includes(d.day) || (f.hasLastChar && d.day === d.daysInMonth);
+}
+
+/** The library's documented day rules: both restricted -> either; else whichever is restricted. */
+function dayMatch(fields, d) {
+  const rDom = !fields.dayOfMonth.isWildcard;
+  const rDow = !fields.dayOfWeek.isWildcard;
+  if (rDom && rDow) {
+    return domMatch(fields, d) || dowMatch(fields, d);
+  }
+  if (rDom) {
+    return domMatch(fields, d);
+  }
+  if (rDow) {
+    return dowMatch(fields, d);
+  }
+  return true;
+}
+
+/** Does the instant (a luxon DateTime in the expression's zone) match all fields? */
+function matches(fields, d) {
+  return (
+    numbers(fields.second.values).includes(d.second) &&
+    numbers(fields.minute.values).includes(d.minute) &&
+    numbers(fields.hour.values).includes(d.hour) &&
+    numbers(fields.month.values).includes(d.month) &&
+    dayMatch(fields, d)
+  );
+}
+
+/** A day whose UTC offset changes (or that does not start at midnight): DST is the library's own subject. */
+function transitionDay(day) {
+  return day.hour !== 0 || day.offset !== day.endOf("day").offset;
+}
+
+/** The first (h,m,s) triple in the sorted value lists lexicographically after `after` (null: the first). */
+function firstTripleAfter(hs, ms, ss, after) {
+  if (after === null) {
+    return [hs[0], ms[0], ss[0]];
+  }
+  const [ah, am, as] = after;
+  for (const h of hs) {
+    if (h < ah) continue;
+    if (h > ah) return [h, ms[0], ss[0]];
+    for (const m of ms) {
+      if (m < am) continue;
+      if (m > am) return [h, m, ss[0]];
+      for (const s of ss) {
+        if (s > as) return [h, m, s];
+      }
+    }
+  }
+  return null;
+}
+
+/** The last triple lexicographically before `before` (null: the last); `inclusive` allows equality. */
+function lastTripleBefore(hs, ms, ss, before, inclusive) {
+  const rh = [...hs].reverse();
+  const rm = [...ms].reverse();
+  const rs = [...ss].reverse();
+  if (before === null) {
+    return [rh[0], rm[0], rs[0]];
+  }
+  const [bh, bm, bs] = before;
+  for (const h of rh) {
+    if (h > bh) continue;
+    if (h < bh) return [h, rm[0], rs[0]];
+    for (const m of rm) {
+      if (m > bm) continue;
+      if (m < bm) return [h, m, rs[0]];
+      for (const s of rs) {
+        if (s < bs || (inclusive && s === bs)) return [h, m, s];
+      }
+    }
+  }
+  return null;
+}
+
+const MAX_DAYS = 366 * 4 + 2;
+const MAX_DST_TRIPLES = 6000;
+
+/**
+ * Every occurrence on a DST transition day, as sorted distinct instants: each matching wall-clock
+ * triple is mapped by luxon, which moves a time inside the gap forward by the gap's length (02:30
+ * becomes 03:30 when 02:00-02:59 is skipped, the library's "landing hour") and takes the first of
+ * the two passes through a repeated hour (the library does not return a repeated hour twice).
+ */
+function dayInstants(fields, day) {
+  const hs = numbers(fields.hour.values);
+  const ms = numbers(fields.minute.values);
+  const ss = numbers(fields.second.values);
+  if (hs.length * ms.length * ss.length > MAX_DST_TRIPLES) {
+    return null;
+  }
+  const out = new Set();
+  for (const h of hs) {
+    for (const m of ms) {
+      for (const s of ss) {
+        out.add(day.set({ hour: h, minute: m, second: s, millisecond: 0 }).toMillis());
+      }
+    }
+  }
+  return [...out].sort((a, b) => a - b);
+}
+
+/**
+ * The model's next occurrence strictly after `startMs` in `zone`: {ms} or {dst: true} when the
+ * day it falls on is a DST transition day (not modelled here) or null when none within MAX_DAYS.
+ */
+function modelNext(fields, zone, startMs) {
+  const hs = numbers(fields.hour.values);
+  const ms = numbers(fields.minute.values);
+  const ss = numbers(fields.second.values);
+  const cur = DateTime.fromMillis(startMs, { zone });
+  let day = cur.startOf("day");
+  for (let i = 0; i < MAX_DAYS; i++, day = day.plus({ days: 1 })) {
+    if (!numbers(fields.month.values).includes(day.month) || !dayMatch(fields, day)) {
+      continue;
+    }
+    if (transitionDay(day)) {
+      const list = dayInstants(fields, day);
+      if (list === null) {
+        return { dst: true, day: day.toISODate() };
+      }
+      const hit = list.find((t) => t > startMs);
+      if (hit === undefined) {
+        continue;
+      }
+      return { ms: hit, dst: false, transition: day.toISODate(), halfHour: halfHourShift(day) };
+    }
+    const t = firstTripleAfter(hs, ms, ss, i === 0 ? [cur.hour, cur.minute, cur.second] : null);
+    if (t === null) {
+      continue;
+    }
+    return { ms: day.set({ hour: t[0], minute: t[1], second: t[2], millisecond: 0 }).toMillis() };
+  }
+  return null;
+}
+
+/** The model's previous occurrence strictly before `startMs`. */
+function modelPrev(fields, zone, startMs) {
+  const hs = numbers(fields.hour.values);
+  const ms = numbers(fields.minute.values);
+  const ss = numbers(fields.second.values);
+  const cur = DateTime.fromMillis(startMs, { zone });
+  const inclusive = startMs % 1000 !== 0;
+  let day = cur.startOf("day");
+  for (let i = 0; i < MAX_DAYS; i++, day = day.minus({ days: 1 })) {
+    if (!numbers(fields.month.values).includes(day.month) || !dayMatch(fields, day)) {
+      continue;
+    }
+    if (transitionDay(day)) {
+      const list = dayInstants(fields, day);
+      if (list === null) {
+        return { dst: true, day: day.toISODate() };
+      }
+      const hits = list.filter((t) => t < startMs);
+      if (hits.length === 0) {
+        continue;
+      }
+      return { ms: hits[hits.length - 1], dst: false, transition: day.toISODate(), halfHour: halfHourShift(day) };
+    }
+    const t = lastTripleBefore(hs, ms, ss, i === 0 ? [cur.hour, cur.minute, cur.second] : null, inclusive);
+    if (t === null) {
+      continue;
+    }
+    return { ms: day.set({ hour: t[0], minute: t[1], second: t[2], millisecond: 0 }).toMillis() };
+  }
+  return null;
+}
+
+/** Parse, classifying the library's "unreachable day of month" rejection against the model. */
+function parseOrNull(expr, options = {}) {
+  try {
+    return CronExpressionParser.parse(expr.text, options);
+  } catch (e) {
+    if (unreachableDom(expr.spec) && /Invalid explicit day of month/.test(e.message)) {
+      count("unreachable-dom");
+      return null;
+    }
+    fail(`parse(${show(expr.text)}) threw ${e.message}`);
+  }
+}
+
+/** The model's view of the parsed fields, for equality across a round trip. */
+function shape(fields) {
+  return {
+    second: numbers(fields.second.values),
+    minute: numbers(fields.minute.values),
+    hour: numbers(fields.hour.values),
+    dayOfMonth: numbers(fields.dayOfMonth.values),
+    domLast: fields.dayOfMonth.hasLastChar,
+    domWild: fields.dayOfMonth.isWildcard,
+    month: numbers(fields.month.values),
+    dayOfWeek: normDow(fields.dayOfWeek.values),
+    dowLast: fields.dayOfWeek.values.filter((v) => typeof v === "string").map((v) => parseInt(v, 10) % 7),
+    dowWild: fields.dayOfWeek.isWildcard,
+    nth: fields.dayOfWeek.nthDay,
+  };
+}
+
+function iso(ms) {
+  return new Date(ms).toISOString();
+}
+
+// ---------------------------------------------------------------------------------------------
+// Properties
+
+// parse expands each field like the model
+property("TestHegelFieldExpansionLikeTheModel", (tc) => {
+  const expr = genExpression(tc);
+  const p = parseOrNull(expr);
+  if (p === null) {
+    return;
+  }
+  const f = p.fields;
+  for (const name of FIELDS) {
+    const want = expr.spec[name];
+    const got = f[name];
+    const gotValues = name === "dayOfWeek" ? normDow(got.values) : numbers(got.values);
