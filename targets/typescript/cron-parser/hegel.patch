+/** A hashed element for `field`: H, H/s, H(a-b), H(a-b)/s; the model's range and step. */
+function genHashed(tc, field) {
+  const [lo, hi] = RANGES[field];
+  switch (n(tc, 0, 4)) {
+    case 0:
+      return { text: "H", lo, hi, step: null };
+    case 1: {
+      const s = n(tc, 1, hi - lo);
+      return { text: `H/${s}`, lo, hi, step: s };
+    }
+    case 2: {
+      const a = n(tc, lo, hi);
+      const b = n(tc, a, hi);
+      return { text: `H(${a}-${b})`, lo: a, hi: b, step: null };
+    }
+    case 3: {
+      // a range reaching outside the field: strict mode rejects it, otherwise it is clamped
+      const a = chance(tc, 50) ? n(tc, Math.max(0, lo - 3), lo - 1 < 0 ? lo : lo - 1) : n(tc, lo, hi);
+      const b = chance(tc, 50) ? n(tc, hi + 1, hi + 5) : n(tc, Math.max(a, lo), hi);
+      if (a >= lo && b <= hi) {
+        return { text: `H(${a}-${b})`, lo: a, hi: b, step: null };
+      }
+      count("outside");
+      return { text: `H(${a}-${b})`, lo: Math.max(a, lo), hi: Math.min(b, hi), step: null, outside: true };
+    }
+    default: {
+      const a = n(tc, lo, hi);
+      const b = n(tc, a, hi);
+      const s = n(tc, 1, Math.max(1, hi - lo));
+      if (s > b - a + 1) {
+        count("step-wider");
+        return { text: `H(${a}-${b})/${s}`, lo: a, hi: b, step: null, wider: true };
+      }
+      return { text: `H(${a}-${b})/${s}`, lo: a, hi: b, step: s };
+    }
+  }
+}
