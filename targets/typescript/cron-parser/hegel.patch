+  if (parts[3] === "*" || parts[5] === "*") {
+    // (with both day fields restricted strict mode rejects the expression for that reason)
+    let strictOk = true;
+    try {
+      CronExpressionParser.parse(text, { hashSeed: seed, strict: true });
+    } catch (e) {
+      strictOk = false;
+      if (!unusable && !/Invalid explicit day of month/.test(e.message)) {
+        fail(`strict parse(${show(text)}, seed ${show(seed)}) rejected a usable hash: ${e.message}`);
+      }
+    }
+    if (unusable && strictOk) {
+      fail(`strict parse(${show(text)}, seed ${show(seed)}) accepted an unusable hash`);
+    }
+  }
+  for (const [f, h] of Object.entries(hashed)) {
+    const values = numbers(p.fields[f].values);
+    count(h.step === null ? "single" : "stepped");
+    if (h.step === null) {
+      if (values.length !== 1 || values[0] < h.lo || values[0] > h.hi) {
+        fail(`parse(${show(text)}, seed ${show(seed)}).fields.${f}.values = ${show(values)}, expected one value in ${h.lo}-${h.hi}`);
+      }
+      continue;
+    }
+    if (values.length === 0 || values[0] < h.lo || values[values.length - 1] > h.hi) {
+      fail(`parse(${show(text)}, seed ${show(seed)}).fields.${f}.values = ${show(values)}, expected values in ${h.lo}-${h.hi}`);
+    }
+    for (let i = 1; i < values.length; i++) {
+      if (values[i] - values[i - 1] !== h.step) {
+        fail(`parse(${show(text)}, seed ${show(seed)}).fields.${f}.values = ${show(values)}, expected step ${h.step}`);
+      }
+    }
+    // the progression is maximal: it covers the range from its offset
+    if (values[0] - h.lo >= h.step || values[values.length - 1] + h.step <= h.hi) {
+      fail(`parse(${show(text)}, seed ${show(seed)}).fields.${f}.values = ${show(values)}, does not cover ${h.lo}-${h.hi} by ${h.step}`);
+    }
+  }
+  // the hashed expression schedules like its expanded form
+  const start = genInstant(tc);
+  const expanded = CronExpressionParser.parse(p.stringify(true), { currentDate: new Date(start) });
+  const r = CronExpressionParser.parse(text, { hashSeed: seed, currentDate: new Date(start) });
+  try {
+    const x = r.next().getTime();
+    const y = expanded.next().getTime();
+    if (x !== y) {
+      fail(`parse(${show(text)}, seed ${show(seed)}).next() from ${iso(start)} = ${iso(x)}, its expansion ${show(p.stringify(true))} gives ${iso(y)}`);
+    }
+  } catch (e) {
+    if (!/loop limit/.test(e.message)) throw e;
+    count("loop-limit");
+  }
+});
+
+// CronFieldCollection.from applies overrides and keeps the rest
+property("TestHegelFieldCollectionFrom", (tc) => {
+  const expr = genExpression(tc);
+  const p = parseOrNull(expr);
+  if (p === null) {
+    return;
+  }
+  const overrides = {};
+  const want = shape(p.fields);
+  for (const f of ["second", "minute", "hour", "month"]) {
+    if (chance(tc, 40)) {
+      const [lo, hi] = RANGES[f];
+      const k = n(tc, 1, 4);
+      const vals = [];
+      for (let i = 0; i < k; i++) vals.push(n(tc, lo, hi));
+      overrides[f] = [...new Set(vals)].sort((a, b) => a - b);
+      want[f] = overrides[f];
+    }
+  }
+  let c;
+  try {
+    c = CronFieldCollection.from(p.fields, overrides);
+  } catch (e) {
+    fail(`CronFieldCollection.from(fields of ${show(expr.text)}, ${show(overrides)}) threw ${e.message}`);
+  }
+  if (!same(shape(c), want)) {
+    fail(`CronFieldCollection.from(fields of ${show(expr.text)}, ${show(overrides)}) = ${show(shape(c))}, expected ${show(want)}`);
+  }
+  const e2 = CronExpression.fieldsToExpression(c, {});
+  if (overrides.month && expr.spec.month.values.length === 1 && numbers(p.fields.dayOfMonth.values).length < expr.spec.dayOfMonth.values.length) {
+    // cron-parser/1: the base's day-of-month values were pruned for its single month; with the
+    // month overridden they no longer cover it and stringify prints them as a restricted range
+    count("known cron-parser/1");
+    return;
+  }
+  let back;
+  try {
+    back = CronExpressionParser.parse(e2.stringify(true));
+  } catch (e) {
+    fail(`fieldsToExpression(from(fields of ${show(expr.text)}, ${show(overrides)})).stringify(true) = ${show(e2.stringify(true))} does not parse: ${e.message}`);
+  }
+  want.dayOfMonth = prune(want.dayOfMonth, want.month);
+  if (!same(shape(back.fields), want)) {
+    fail(`fieldsToExpression(from(fields of ${show(expr.text)}, ${show(overrides)})).stringify(true) = ${show(e2.stringify(true))} re-parses to ${show(shape(back.fields))}`);
+  }
+});
+
+const JUNK = ["*", "/", "-", ",", "#", "L", "H", "?", "W", "(", ")", "0", "1", "2", "5", "7", "9", "13", "31", "60", "JAN", "SUN", "x", " ", "@daily"];
+
+// malformed expressions are rejected with an Error, valid ones re-parse
+property("TestHegelMalformedExpressionsRejected", (tc) => {
+  const k = n(tc, 1, 7);
+  const parts = [];
+  for (let i = 0; i < k; i++) {
+    parts.push(word(tc, JUNK, 1, 4));
+  }
+  const text = parts.join(" ");
+  let p;
+  try {
+    p = CronExpressionParser.parse(text);
+  } catch (e) {
+    if (!(e instanceof Error)) {
+      fail(`parse(${show(text)}) threw a non-Error ${show(e)}`);
+    }
+    count("rejected");
+    return;
+  }
+  count("accepted");
+  const f = p.fields;
+  for (const name of FIELDS) {
+    const [lo, hi] = RANGES[name];
+    for (const v of numbers(f[name].values)) {
+      if (v < lo || v > hi) {
+        fail(`parse(${show(text)}).fields.${name}.values = ${show(f[name].values)} has ${v} outside ${lo}-${hi}`);
+      }
+    }
+    if (numbers(f[name].values).length === 0 && !f[name].hasLastChar) {
+      fail(`parse(${show(text)}).fields.${name}.values = ${show(f[name].values)} is empty`);
+    }
+  }
+  const s = p.stringify(true);
+  let q;
+  try {
+    q = CronExpressionParser.parse(s);
+  } catch (e) {
+    fail(`parse(${show(text)}) accepted but its stringify ${show(s)} is rejected: ${e.message}`);
+  }
+  if (!same(shape(q.fields), shape(p.fields))) {
+    fail(`parse(${show(text)}) accepted; stringify ${show(s)} re-parses to ${show(shape(q.fields))}, not ${show(shape(p.fields))}`);
+  }
+});
+
+// out-of-range values, zero steps and reversed ranges are rejected
+property("TestHegelOutOfRangeRejected", (tc) => {
+  const field = pick(tc, FIELDS);
+  const [lo, hi] = RANGES[field];
+  const idx = FIELDS.indexOf(field);
+  const base = ["*", "*", "*", "*", "*", "*"];
+  const kind = pick(tc, ["above", "below", "zero-step", "reversed"]);
+  let bad;
+  if (kind === "above") {
+    bad = String(hi + n(tc, 1, 40));
+  } else if (kind === "below") {
+    if (lo === 0) {
+      count("no-below");
+      return;
+    }
+    bad = "0";
+  } else if (kind === "zero-step") {
+    bad = pick(tc, ["*/0", `${lo}-${hi}/0`, `${lo}/0`]);
+  } else {
+    const a = n(tc, lo + 1, hi);
+    const b = n(tc, lo, a - 1);
+    bad = `${a}-${b}`;
+  }
+  base[idx] = bad;
+  const text = base.join(" ");
+  count(kind);
+  try {
+    const p = CronExpressionParser.parse(text);
+    fail(`parse(${show(text)}) accepted: fields ${show(shape(p.fields))}`);
+  } catch (e) {
+    if (/accepted/.test(e.message)) throw e;
+  }
+});
+
+const COMMAND_WORDS = ["/usr/bin/backup", "echo", "hello", "--verbose", "-n", "2>/dev/null", "&&", "true", "--level=3", "FOO=bar", "a=b"];
+
+// CronFileParser reads every entry, variable and comment of a crontab
+property("TestHegelCrontabFileParser", (tc) => {
+  const lines = [];
+  const entries = [];
+  const variables = {};
+  const invalid = [];
+  const k = n(tc, 0, 6);
+  for (let i = 0; i < k; i++) {
+    switch (n(tc, 0, 5)) {
+      case 0:
+        lines.push(pick(tc, ["", "   ", "# a comment", "#0 0 * * * not an entry"]));
+        break;
+      case 1: {
+        const key = word(tc, ["A", "B", "C", "_", "X"], 1, 6);
+        const value = word(tc, ["a", "b", "1", "/", ":", " "], 0, 8);
+        const quoted = pick(tc, [value, `"${value}"`, `'${value}'`]);
+        const line = `${key}=${quoted}`;
+        lines.push(line);
+        // the parser trims the line, then strips every quote character from the value
+        variables[key] = line.trim().slice(key.length + 1).replace(/["']/g, "");
+        break;
+      }
+      default: {
+        const expr = genExpression(tc, { seconds: false });
+        if (unreachableDom(expr.spec)) {
+          return;
+        }
+        const sep = pick(tc, [" ", " ", " ", " ", "  ", "\t"]);
+        count(sep === " " ? "single-space" : sep === "  " ? "double-space" : "tab");
+        const command = word(tc, COMMAND_WORDS.map((w) => w + " "), 0, 4).trim();
+        if (chance(tc, 15)) {
+          // a bad entry: a seventh field that is no command, or a field out of range
+          const bad = pick(tc, ["60 * * * *", "* * 32 * *", "* * * 13 *", "* * * * 8"]);
+          lines.push(`${bad} ${command}`.trim());
+          invalid.push(`${bad} ${command}`.trim());
+          break;
+        }
+        const line = expr.text.split(" ").join(sep) + (command ? sep + command : "");
+        lines.push(line);
+        entries.push({ text: expr.text, command });
+        if (/=/.test(command)) count("command-with-equals");
+        break;
+      }
+    }
+  }
+  const dir = mkdtempSync(join(tmpdir(), "zoo-cron-"));
+  let result;
+  try {
+    const file = join(dir, "crontab");
+    writeFileSync(file, lines.join("\n") + (chance(tc, 50) ? "\n" : ""));
+    result = CronFileParser.parseFileSync(file);
+  } finally {
+    rmSync(dir, { recursive: true, force: true });
+  }
+  const content = show(lines.join("\n"));
+  if (lines.some((l) => !/^\s*(#|$)/.test(l) && !/^[A-Z_]+=/.test(l) && /=/.test(l))) {
+    // cron-parser/4: an entry whose command contains "=" is read as a variable assignment
+    count("known cron-parser/4");
+    return;
+  }
+  if (lines.some((l) => /\t|  /.test(l) && !/^\s*#/.test(l) && !/^[A-Z_]+=/.test(l))) {
+    // cron-parser/5: entries are split on single spaces, so tabs or runs of spaces misparse
+    count("known cron-parser/5");
+    return;
+  }
+  if (!same(result.variables, variables)) {
+    fail(`parseFileSync(${content}).variables = ${show(result.variables)}, expected ${show(variables)}`);
+  }
+  const got = result.expressions.map((e) => e.stringify());
+  const want = entries.map((e) => CronExpressionParser.parse(e.text).stringify());
+  if (!same(got, want)) {
+    fail(`parseFileSync(${content}).expressions = ${show(got)}, expected ${show(want)}`);
+  }
+  const errorKeys = Object.keys(result.errors).sort();
+  // errors are keyed by the entry's text, so repeated invalid entries collapse into one
+  if (!same(errorKeys, [...new Set(invalid)].sort())) {
+    fail(`parseFileSync(${content}).errors are for ${show(errorKeys)}, expected ${show(invalid)}`);
+  }
+});
+
+// ---------------------------------------------------------------------------------------------
+// Pins: one plain test per recorded bug; each must fail while the bug is present
+
+// cron-parser/1: CronFieldCollection.from keeps the base's day-of-month values, which were pruned to
+// the base's single month; overriding the month leaves them short of the new months, so stringify
+// prints the wildcard as a range and the printed expression schedules differently.
+pin("TestHegelPinFromKeepsWildcardDayOfMonth", () => {
+  const options = { currentDate: new Date("2026-09-01T00:00:00Z"), tz: "UTC" };
+  const base = CronExpressionParser.parse("0 0 * 9 4", options); // Thursdays in September
+  const moved = CronExpression.fieldsToExpression(CronFieldCollection.from(base.fields, { month: [3, 8] }), options);
+  const printed = moved.stringify(true);
+  const back = CronExpressionParser.parse(printed, options);
+  const a = moved.take(3).map((d) => d.toISOString());
+  const b = back.take(3).map((d) => d.toISOString());
+  if (!same(a, b)) {
+    throw new Error(`from(fields of "0 0 * 9 4", {month: [3, 8]}) stringifies to ${show(printed)}; it schedules ${a.join(", ")} but the printed expression schedules ${b.join(", ")}`);
+  }
+});
+
+// cron-parser/2: `?` is documented as an alias for `*`, but strict mode's "both day fields" check
+// only recognises `*`, so the Quartz idiom `? ... 1-5` is rejected.
