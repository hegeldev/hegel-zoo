+      fail(`parse(${show(expr.text)}, ${zone}) from ${iso(start)}: next() gave ${dates.map(iso).join(", ")}, not increasing`);
+    }
+  }
+  // walking back from the last date visits the same dates
+  for (let i = k - 2; i >= 0; i--) {
