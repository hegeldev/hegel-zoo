+    if (back !== dates[i]) {
+      fail(`parse(${show(expr.text)}, ${zone}) from ${iso(start)}: next() gave ${dates.map(iso).join(", ")}; prev() from ${iso(dates[i + 1])} gave ${iso(back)}, not ${iso(dates[i])}`);
