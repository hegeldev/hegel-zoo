+  if (edits.length === 0 && describe !== "object-remove-missing") fail(`modify(${show(path)}, ${show(newValue)}) returns no edits for ${show(text)}`);
+});
+
+// ---------------------------------------------------------------- pins
+
+// node-jsonc-parser/1
+pin("TestHegelPinLocationMatchesADoubleStarPattern", () => {
+  const loc = getLocation('{"a":{"b":1}}', 10);
+  assert.deepEqual(loc.path, ["a", "b"]);
+  assert.equal(loc.matches(["**"]), true);
+  assert.equal(loc.matches(["**", "b"]), true);
+  assert.equal(loc.matches(["a", "**"]), true);
+});
+
+// node-jsonc-parser/2
+pin("TestHegelPinParseKeepsProtoAsAnOwnProperty", () => {
+  const text = '{"__proto__": {"polluted": 1}}';
+  const v = parse(text);
+  assert.deepEqual(Object.keys(v), Object.keys(JSON.parse(text)));
+  assert.equal(Object.getPrototypeOf(v), Object.prototype);
+  assert.equal(v.polluted, undefined);
+});
+
+// node-jsonc-parser/3
+pin("TestHegelPinModifyRefusesToRemoveBeyondTheArrayEnd", () => {
+  assert.throws(() => modify("[1,2]", [5], undefined, {}), /length is not sufficient/);
+  assert.throws(() => modify("[1]", [3], undefined, {}), /length is not sufficient/);
+});
+
+// node-jsonc-parser/4
+pin("TestHegelPinUnterminatedBlockCommentEndsWithTheText", () => {
+  const sc = createScanner("/*", false);
+  assert.equal(sc.scan(), SyntaxKind.BlockCommentTrivia);
+  assert.equal(sc.getTokenError(), ScanError.UnexpectedEndOfComment);
+  assert.equal(sc.getTokenLength(), 2);
+  const errors = [];
+  parse("[1, /*", errors);
+  for (const e of errors) assert.ok(e.offset + e.length <= 6, `error ${printParseErrorCode(e.error)} at ${e.offset}+${e.length} in a text of 6`);
+});
+
+// node-jsonc-parser/5
+pin("TestHegelPinModifyEditsTheKeyThatParseReads", () => {
+  const text = '{"a":1,"a":2}';
+  assert.equal(parse(text).a, 2);
+  const out = applyEdits(text, modify(text, ["a"], 3, {}));
+  assert.equal(parse(out).a, 3, out);
+});
+
+// node-jsonc-parser/6
+pin("TestHegelPinModifyRemovesTheOnlyPropertyBeforeATrailingComma", () => {
+  const text = '{"a": 1,}';
+  const errors = [];
+  assert.deepEqual(parse(text, errors, { allowTrailingComma: true }), { a: 1 });
+  assert.deepEqual(errors, []);
+  const out = applyEdits(text, modify(text, ["a"], undefined, {}));
+  const after = [];
+  const v = parse(out, after, { allowTrailingComma: true });
+  assert.deepEqual(after, [], `${show(out)} has errors`);
+  assert.deepEqual(v, {});
+});
+
+// node-jsonc-parser/8
+pin("TestHegelPinCommentTokenValueIsTheComment", () => {
+  const sc = createScanner("[1,/*x*/2]", false);
+  while (sc.scan() !== SyntaxKind.BlockCommentTrivia);
+  assert.equal(sc.getTokenOffset(), 3);
+  assert.equal(sc.getTokenLength(), 5);
+  assert.equal(sc.getTokenValue(), "/*x*/");
+  assert.equal(stripComments("[1,/*x*/2]", " "), "[1,     2]");
+});
+
+// node-jsonc-parser/9
+pin("TestHegelPinRangeFormattingKeepsTheLinesBeforeTheRange", () => {
+  const text = "[1,\n\n2]";
+  const opts = { insertSpaces: true, tabSize: 2, keepLines: true };
+  const full = applyEdits(text, format(text, undefined, opts));
+  assert.equal(full, "[ 1,\n\n  2 ]");
+  const ranged = applyEdits(text, format(text, { offset: 4, length: 1 }, opts));
+  assert.equal(ranged.split("\n").length, 3, `the blank line is gone: ${show(ranged)}`);
+});
+
+// node-jsonc-parser/7
+pin("TestHegelPinLocationInAnArrayElementIsNotAtAPropertyKey", () => {
+  const loc = getLocation("[{}, 2]", 5);
+  assert.deepEqual(loc.path, [1]);
+  assert.equal(loc.previousNode && loc.previousNode.value, 2);
+  assert.equal(loc.isAtPropertyKey, false);
+});
