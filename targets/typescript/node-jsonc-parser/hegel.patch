diff --git a/test/hegel-zoo.mjs b/test/hegel-zoo.mjs
new file mode 100644
index 0000000..ef914e1
--- /dev/null
+++ b/test/hegel-zoo.mjs
@@ -0,0 +1,138 @@
+// Hegel zoo: the small harness shared by the zoo's TypeScript/JavaScript targets.
+//
+// `property(name, body)` registers a node:test test that runs `body(tc)` under Hegel with
+// HEGEL_TEST_CASES cases (default 100) and the database at HEGEL_DATABASE. With ZOO_COLLECT=1
+// a `fail()` records the mismatch instead of failing, the case ends there, and the counts of
+// mismatches and of the shapes seen (`count(key)`) are printed at the end of the test, so a
+// property can be run over many cases to see every shape at once. `pin(name, body)` is a
+// plain test for one pinned bug: it must fail while the bug is present and pass once it is
+// fixed (the zoo's judge reads an unexpected pass as "fixed upstream?").
+
+import { readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { test as nodeTest } from "node:test";
+import * as hegel from "@hegeldev/hegel";
+import * as gs from "@hegeldev/hegel/generators";
+
+// The Hegel version these tests were written against (the zoo pins it in zoo.toml and installs
+// it with `npm install --no-save @hegeldev/hegel@<version>`; upstream would add it to
+// devDependencies). Checked at load time so a stray install cannot silently change the engine.
+export const HEGEL_PIN = { "@hegeldev/hegel": "0.4.5" };
+
+{
+  let dir = dirname(fileURLToPath(import.meta.resolve("@hegeldev/hegel")));
+  while (!/[\\/]hegel$/.test(dir) && dir !== dirname(dir)) dir = dirname(dir);
+  const installed = JSON.parse(readFileSync(join(dir, "package.json"), "utf8")).version;
+  if (installed !== HEGEL_PIN["@hegeldev/hegel"]) {
+    throw new Error(`@hegeldev/hegel ${installed} is installed; these tests pin ${HEGEL_PIN["@hegeldev/hegel"]}`);
+  }
+}
+
+export const collecting = !!process.env.ZOO_COLLECT;
+
+class Collected extends Error {}
+
+let msgs = [];
+let stats = new Map();
+
+/** Report a mismatch: an error normally, a recorded line in collect mode. */
+export function fail(message) {
+  if (collecting) {
+    msgs.push(message);
+    throw new Collected(message);
+  }
+  throw new Error(message);
+}
+
+/** Bump a statistic (the shape of a pinned bug, a generator branch). */
+export function count(key) {
+  stats.set(key, (stats.get(key) || 0) + 1);
+}
+
+function settings() {
+  const s = { testCases: Number(process.env.HEGEL_TEST_CASES) || 100 };
+  if (process.env.HEGEL_DATABASE) {
+    s.database = hegel.Database.fromPath(process.env.HEGEL_DATABASE);
+  }
+  return s;
+}
+
+/** A property: `body(tc)` runs under Hegel; a thrown error (or `fail`) is a failure. */
+export function property(name, body) {
+  nodeTest(name, () => {
+    msgs = [];
+    stats = new Map();
+    hegel.test((tc) => {
+      try {
+        body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** A pin: a plain test for one recorded bug. */
+export function pin(name, body) {
+  nodeTest(name, body);
+}
+
+/** An integer in [lo, hi]. */
+export function n(tc, lo, hi) {
+  return tc.draw(gs.integers({ minValue: lo, maxValue: hi }));
+}
+
+/** One of xs. */
+export function pick(tc, xs) {
+  return xs[n(tc, 0, xs.length - 1)];
+}
+
+/** True pct percent of the time. */
+export function chance(tc, pct) {
+  return n(tc, 0, 99) < pct;
+}
+
+/** A string of `len` characters drawn from `alphabet` (an array of strings). */
+export function word(tc, alphabet, lo, hi) {
+  const len = n(tc, lo, hi);
+  let s = "";
+  for (let i = 0; i < len; i++) {
+    s += pick(tc, alphabet);
+  }
+  return s;
+}
+
+/** Structural equality: arrays by position, objects by key set (prototype ignored), else ===. */
+export function same(a, b) {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) {
+      return false;
+    }
+    return a.every((x, i) => same(x, b[i]));
+  }
+  if (a !== null && b !== null && typeof a === "object" && typeof b === "object") {
+    const ka = Object.keys(a).sort();
+    const kb = Object.keys(b).sort();
+    if (ka.length !== kb.length || ka.some((k, i) => k !== kb[i])) {
+      return false;
+    }
+    return ka.every((k) => same(a[k], b[k]));
+  }
+  return a === b;
+}
+
+/** A compact, unambiguous rendering for messages. */
+export function show(x) {
+  return JSON.stringify(x, (k, v) => (v === undefined ? "<undefined>" : v));
+}
diff --git a/test/hegel.test.mjs b/test/hegel.test.mjs
new file mode 100644
index 0000000..af07bc5
--- /dev/null
+++ b/test/hegel.test.mjs
@@ -0,0 +1,897 @@
+// Hegel zoo: property tests for jsonc-parser (microsoft/node-jsonc-parser); see README.md of the target.
+//
+// Run with `node --test --test-reporter=tap test/hegel.test.mjs` after the setup in target.toml
+// (npm install of Hegel at the root and of TypeScript under .hegel/; tsc of src/ into .hegel/dist).
+// HEGEL_TEST_CASES sets the budget, ZOO_COLLECT=1 records mismatches instead of failing at the first.
+
+import assert from "node:assert/strict";
+import { chance, count, fail, n, pick, pin, property, same, show, word } from "./hegel-zoo.mjs";
+import * as jsonc from "../.hegel/dist/main.js";
+
+const {
+  parse,
+  parseTree,
+  visit,
+  getLocation,
+  getNodeValue,
+  getNodePath,
+  findNodeAtLocation,
+  findNodeAtOffset,
+  createScanner,
+  stripComments,
+  format,
+  modify,
+  applyEdits,
+  printParseErrorCode,
+  SyntaxKind,
+  ScanError,
+  ParseErrorCode,
+} = jsonc;
+
+// Shapes of the recorded bugs (bugs.toml): a property skips a case that has one and stays strict
+// on everything else; each has a pin below.
+const Known = {
+  // node-jsonc-parser/1: Location.matches() never matches a pattern that contains "**"
+  globstarPattern: (pattern) => pattern.includes("**"),
+  // node-jsonc-parser/2: parse() assigns a "__proto__" member through the prototype setter
+  protoKey: (value) => hasKey(value, "__proto__"),
+  // node-jsonc-parser/3: modify() removing an array index at or past the end deletes the sole item or
+  // throws a TypeError (generation keeps removals in range; the pin covers the shape)
+  // node-jsonc-parser/4: an unterminated block comment's token extends one character past the text
+  unterminatedBlockComment: (kind, error, end, length) =>
+    kind === SyntaxKind.BlockCommentTrivia && error === ScanError.UnexpectedEndOfComment && end === length + 1,
+  // node-jsonc-parser/5: modify() of a duplicated key edits the first occurrence, parse() reads the last
+  // (generation keeps keys unique; the pin covers the shape)
+  // node-jsonc-parser/6: modify() removing the only property before a trailing comma leaves "{,}"
+  // (generation never puts trailing commas in a text that modify() edits; the pin covers the shape)
+  // node-jsonc-parser/7: getLocation() reports isAtPropertyKey inside an array element when the last
+  // "{" or ":" before it is the "{" of an empty object
+  // node-jsonc-parser/8: a comment token's value starts one character before the comment
+  commentValueStartsEarly: (text, offset, length, value) => offset > 0 && value === text.slice(offset - 1, offset + length),
+  // node-jsonc-parser/9: format() of a range with keepLines drops the line breaks before the range's first token
+  rangeKeepLines: (opts, range) => !!(opts.keepLines && range),
+  atKeyAfterEmptyObject: (text, offset) => {
+    const sc = createScanner(text, true);
+    let last = 0;
+    for (;;) {
+      const k = sc.scan();
+      if (k === SyntaxKind.EOF || sc.getTokenOffset() >= offset) break;
+      if (k === SyntaxKind.OpenBraceToken || k === SyntaxKind.ColonToken) last = k;
+    }
+    return last === SyntaxKind.OpenBraceToken;
+  },
+};
+
+// ---------------------------------------------------------------- values and texts
+
+const STR_CHARS = ["a", "b", "Z", " ", '"', "\\", "/", "\n", "\t", "\u0000", "\u001f", "\u007f", "é", "😀", "*", "//", "/*", "*/", "\u2028", "\ud83d", ":", ",", "{", "}", "[", "]", "'"];
+const KEYS = ["a", "b", "c", "", "__proto__", "constructor", "a b", "1", "😀", '"q"', "toString", "-1", "*", "**", "0"];
+const NUMBERS = [0, 1, -1, 7, 42, -1000, 1e21, 5e-7, 0.5, -0.25, 3.14159, 123456789, Number.MAX_SAFE_INTEGER, 1.7976931348623157e308, 5e-324, 1e-7, 2 ** 53];
+
+function genString(tc) {
+  return word(tc, STR_CHARS, 0, 5);
+}
+
+function genKey(tc) {
+  return chance(tc, 70) ? pick(tc, KEYS) : genString(tc);
+}
+
+function genNumber(tc) {
+  return chance(tc, 50) ? n(tc, -1000000, 1000000) : pick(tc, NUMBERS);
+}
+
+/** Set an own, enumerable property (a plain assignment of "__proto__" would set the prototype). */
+function setKey(obj, key, value) {
+  Object.defineProperty(obj, key, { value, enumerable: true, writable: true, configurable: true });
+}
+
+/** A JSON value: leaves, arrays and objects with unique keys, nested up to `depth`. */
+function genValue(tc, depth) {
+  const r = n(tc, 0, 99);
+  if (depth <= 0 || r < 50) {
+    const k = n(tc, 0, 5);
+    if (k === 0) return null;
+    if (k === 1) return true;
+    if (k === 2) return false;
+    if (k === 3) return genNumber(tc);
+    return genString(tc);
+  }
+  if (r < 75) {
+    const a = [];
+    const len = n(tc, 0, 4);
+    for (let i = 0; i < len; i++) a.push(genValue(tc, depth - 1));
+    return a;
+  }
+  const o = {};
+  const len = n(tc, 0, 4);
+  for (let i = 0; i < len; i++) {
+    const k = genKey(tc);
+    if (Object.prototype.hasOwnProperty.call(o, k)) continue;
+    setKey(o, k, genValue(tc, depth - 1));
+  }
+  return o;
+}
+
+function hasKey(value, key) {
+  if (value === null || typeof value !== "object") return false;
+  if (Array.isArray(value)) return value.some((x) => hasKey(x, key));
+  return Object.keys(value).some((k) => k === key || hasKey(value[k], key));
+}
+
+/** The leaves of a value in document order. */
+function leavesOf(value) {
+  if (value === null || typeof value !== "object") return [value];
+  if (Array.isArray(value)) return value.flatMap(leavesOf);
+  return Object.keys(value).flatMap((k) => leavesOf(value[k]));
+}
+
+/** A deep copy through JSON (own "__proto__" members survive JSON.parse). */
+function clone(value) {
+  return JSON.parse(JSON.stringify(value));
+}
+
+const hex4 = (tc, u) => {
+  const h = u.toString(16).padStart(4, "0");
+  return chance(tc, 50) ? h.toUpperCase() : h;
+};
+
+const COMMENT_CHARS = ["a", " ", "*", "\n", "é", '"', "{", ",", "\t", "😀"];
+const LINE_COMMENT_CHARS = ["a", " ", "*", "/", "é", '"', "]", "\t"];
+
+/** How a value is written: line ending, whitespace density, comments, trailing commas, literal spellings. */
+function genStyle(tc, { comments = false, trailing = false, altNumbers = false, altStrings = false } = {}) {
+  return {
+    eol: pick(tc, ["\n", "\n", "\r\n", "\r"]),
+    dense: chance(tc, 30),
+    comments: comments && chance(tc, 70),
+    trailing: trailing && chance(tc, 60),
+    altNumbers: altNumbers && chance(tc, 70),
+    altStrings: altStrings && chance(tc, 70),
+  };
+}
+
+/** The text of `value` in `style`: {text, comments, trailing} with the counts of what was inserted. */
+function render(tc, value, st) {
+  let comments = 0;
+  let trailing = 0;
+  const ws = () => {
+    if (st.dense && chance(tc, 70)) return "";
+    let s = "";
+    const k = n(tc, 0, 3);
+    for (let i = 0; i < k; i++) s += pick(tc, [" ", "\t", st.eol]);
+    return s;
+  };
+  const trivia = () => {
+    let s = ws();
+    if (st.comments && chance(tc, 25)) {
+      comments++;
+      if (chance(tc, 50)) s += "/*" + word(tc, COMMENT_CHARS, 0, 4) + "*/" + ws();
+      else s += "//" + word(tc, LINE_COMMENT_CHARS, 0, 4) + st.eol + ws();
+    }
+    return s;
+  };
+  const str = (s) => {
+    if (!st.altStrings) return JSON.stringify(s);
+    let r = '"';
+    for (let i = 0; i < s.length; i++) {
+      const c = s[i];
+      const u = s.charCodeAt(i);
+      if (c === '"') r += '\\"';
+      else if (c === "\\") r += "\\\\";
+      else if (c === "/") r += chance(tc, 50) ? "\\/" : "/";
+      else if (u < 0x20) {
+        const short = { 8: "\\b", 9: "\\t", 10: "\\n", 12: "\\f", 13: "\\r" }[u];
+        r += short && chance(tc, 50) ? short : "\\u" + hex4(tc, u);
+      } else if (u >= 0xd800 && u <= 0xdfff) r += chance(tc, 50) ? "\\u" + hex4(tc, u) : c;
+      else if (chance(tc, 10)) r += "\\u" + hex4(tc, u);
+      else r += c;
+    }
+    return r + '"';
+  };
+  const num = (x) => {
+    const canon = JSON.stringify(x);
+    if (!st.altNumbers || !Number.isInteger(x) || Math.abs(x) > 1e9 || !chance(tc, 60)) return canon;
+    return pick(tc, [canon + ".0", canon + "e0", canon + "E+0", canon + ".00e-0", x * 10 + "e-1", x * 100 + "E-2"]);
+  };
+  const val = (v) => {
+    if (v === null) return "null";
+    if (typeof v === "boolean") return String(v);
+    if (typeof v === "number") return num(v);
+    if (typeof v === "string") return str(v);
+    if (Array.isArray(v)) {
+      let s = "[" + trivia();
+      v.forEach((x, i) => {
+        if (i) s += "," + trivia();
+        s += val(x) + trivia();
+      });
+      if (v.length && st.trailing && chance(tc, 50)) {
+        s += "," + trivia();
+        trailing++;
+      }
+      return s + "]";
+    }
+    const keys = Object.keys(v);
+    let s = "{" + trivia();
+    keys.forEach((k, i) => {
+      if (i) s += "," + trivia();
+      s += str(k) + trivia() + ":" + trivia() + val(v[k]) + trivia();
+    });
+    if (keys.length && st.trailing && chance(tc, 50)) {
+      s += "," + trivia();
+      trailing++;
+    }
+    return s + "}";
+  };
+  const text = trivia() + val(value) + trivia();
+  return { text, comments, trailing };
+}
+
+const JSON_CHARS = [..."{}[]:,\"\\/*0123456789.-+eE tnulrfas", "\n", "\r", "\t", "é", "\u0000", "//", "/*", "*/", "true", "null", '"a"', "1e5"];
+
+/** One random edit of a text: delete, insert, replace, duplicate or truncate. */
+function mutate(tc, text) {
+  const r = n(tc, 0, 99);
+  const i = n(tc, 0, Math.max(0, text.length - 1));
+  if (r < 30 && text.length) return text.slice(0, i) + text.slice(i + 1);
+  if (r < 60) return text.slice(0, i) + pick(tc, JSON_CHARS) + text.slice(i);
+  if (r < 80 && text.length) return text.slice(0, i) + pick(tc, JSON_CHARS) + text.slice(i + 1);
+  if (r < 90) {
+    const j = n(tc, i, text.length);
+    return text.slice(0, j) + text.slice(i, j) + text.slice(j);
+  }
+  return text.slice(0, i);
+}
+
+/** [line, character] of an offset: "\r\n", "\r" and "\n" each end a line. */
+function lineCol(text, off) {
+  let line = 0;
+  let start = 0;
+  for (let i = 0; i < off; i++) {
+    const c = text[i];
+    if (c === "\r") {
+      if (text[i + 1] === "\n") i++;
+      line++;
+      start = i + 1;
+    } else if (c === "\n") {
+      line++;
+      start = i + 1;
+    }
+  }
+  return [line, off - start];
+}
+
+/** The tokens of a text other than whitespace: [kind, text] (comments included). */
+function tokensOf(text) {
+  const sc = createScanner(text, false);
+  const out = [];
+  for (;;) {
+    const k = sc.scan();
+    if (k === SyntaxKind.EOF) return out;
+    if (k === SyntaxKind.Trivia || k === SyntaxKind.LineBreakTrivia) continue;
+    out.push([k, text.slice(sc.getTokenOffset(), sc.getTokenOffset() + sc.getTokenLength())]);
+  }
+}
+
+/** [offset, end) of every comment of a text. */
+function commentRanges(text) {
+  const sc = createScanner(text, false);
+  const out = [];
+  for (;;) {
+    const k = sc.scan();
+    if (k === SyntaxKind.EOF) return out;
+    if (k === SyntaxKind.LineCommentTrivia || k === SyntaxKind.BlockCommentTrivia) out.push([sc.getTokenOffset(), sc.getTokenOffset() + sc.getTokenLength()]);
+  }
+}
+
+function walk(node, f) {
+  f(node);
+  for (const c of node.children || []) walk(c, f);
+}
+
+/** Every container in a value with its path: [[path, container], ...]. */
+function containerPaths(value, path = [], out = []) {
+  if (value === null || typeof value !== "object") return out;
+  out.push([path, value]);
+  if (Array.isArray(value)) value.forEach((x, i) => containerPaths(x, [...path, i], out));
+  else for (const k of Object.keys(value)) containerPaths(value[k], [...path, k], out);
+  return out;
+}
+
+/** Well-formed edits: in range, non-negative, non-overlapping. */
+function checkEdits(text, edits, what) {
+  const sorted = edits.slice().sort((a, b) => a.offset - b.offset || a.length - b.length);
+  let last = 0;
+  for (const e of sorted) {
+    if (e.offset < 0 || e.length < 0 || e.offset + e.length > text.length) fail(`${what}: edit out of range ${show(e)} in a text of ${text.length}`);
+    if (e.offset < last) fail(`${what}: overlapping edits ${show(edits)}`);
+    last = e.offset + e.length;
+  }
+}
+
+function genFormatting(tc) {
+  const o = {};
+  if (chance(tc, 60)) o.insertSpaces = true;
+  if (chance(tc, 70)) o.tabSize = n(tc, 1, 8);
+  if (chance(tc, 30)) o.insertFinalNewline = true;
+  if (chance(tc, 30)) o.eol = pick(tc, ["\n", "\r\n"]);
+  return o;
+}
+
+function firstEol(text) {
+  const m = /\r\n|\r|\n/.exec(text);
+  return m ? m[0] : undefined;
+}
+
+const errText = (text, errors) => errors.map((e) => `${printParseErrorCode(e.error)}@${e.offset}+${e.length}`).join(",") + " in " + show(text);
+
+// ---------------------------------------------------------------- parse vs JSON.parse
+
+property("TestHegelParseAgreesWithJSONParse", (tc) => {
+  const value = genValue(tc, 3);
+  const st = genStyle(tc, { altNumbers: true, altStrings: true });
+  const { text } = render(tc, value, st);
+  let expected;
+  try {
+    expected = JSON.parse(text);
+  } catch (e) {
+    fail(`the rendered text is not JSON (test bug): ${e.message} ${show(text)}`);
+  }
+  if (st.altNumbers) count("alt-numbers");
+  if (st.altStrings) count("alt-strings");
+  const errors = [];
+  const got = parse(text, errors, { disallowComments: true });
+  if (errors.length) fail(`parse reports errors on valid JSON: ${errText(text, errors)}`);
+  if (Known.protoKey(value)) count("known/node-jsonc-parser-2");
+  else if (!same(got, expected)) fail(`parse ${show(got)} != JSON.parse ${show(expected)} for ${show(text)}`);
+  const treeErrors = [];
+  const root = parseTree(text, treeErrors, { disallowComments: true });
+  if (treeErrors.length) fail(`parseTree reports errors on valid JSON: ${errText(text, treeErrors)}`);
+  const fromTree = getNodeValue(root);
+  if (!same(fromTree, expected)) fail(`getNodeValue(parseTree) ${show(fromTree)} != JSON.parse ${show(expected)} for ${show(text)}`);
+  const leaves = [];
+  visit(text, { onLiteralValue: (v) => leaves.push(v) }, { disallowComments: true });
+  if (!same(leaves, leavesOf(expected))) fail(`visit saw the leaves ${show(leaves)}, JSON has ${show(leavesOf(expected))} in ${show(text)}`);
+});
+
+// ---------------------------------------------------------------- comments and trailing commas
+
+property("TestHegelCommentsAndTrailingCommasAreTrivia", (tc) => {
+  const value = genValue(tc, 3);
+  const st = genStyle(tc, { comments: true, trailing: true, altStrings: true });
+  const { text, comments, trailing } = render(tc, value, st);
+  const expected = clone(value);
+  if (comments) count("comments");
+  if (trailing) count("trailing-commas");
+  const errors = [];
+  const got = parse(text, errors, { allowTrailingComma: true });
+  if (errors.length) fail(`errors on valid JSONC: ${errText(text, errors)}`);
+  if (Known.protoKey(value)) count("known/node-jsonc-parser-2");
+  else if (!same(got, expected)) fail(`parse ${show(got)} != ${show(expected)} for ${show(text)}`);
+  // the tree agrees and its value is exact even for "__proto__"
+  const root = parseTree(text, [], { allowTrailingComma: true });
+  if (!same(getNodeValue(root), expected)) fail(`getNodeValue(parseTree) ${show(getNodeValue(root))} != ${show(expected)} for ${show(text)}`);
+  // the visitor sees each comment once
+  let seen = 0;
+  visit(text, { onComment: () => seen++ }, { allowTrailingComma: true });
+  if (seen !== comments) fail(`visit saw ${seen} comments, ${comments} were written in ${show(text)}`);
+  // disallowComments flags every comment and nothing else; the value is still recovered
+  const strict = [];
+  const gotStrict = parse(text, strict, { disallowComments: true, allowTrailingComma: true });
+  if (strict.length !== comments || strict.some((e) => e.error !== ParseErrorCode.InvalidCommentToken)) {
+    fail(`disallowComments: ${errText(text, strict)} for ${comments} comments`);
+  }
+  if (!Known.protoKey(value) && !same(gotStrict, expected)) fail(`disallowComments changes the value to ${show(gotStrict)} for ${show(text)}`);
+  // without allowTrailingComma each trailing comma is an error, and the value is still recovered
+  const noTrailing = [];
+  const gotNoTrailing = parse(text, noTrailing);
