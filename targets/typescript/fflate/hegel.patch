+      count("fflate/5");
+      return false;
+    }
+    fail(`${what}: zipfile cannot read the archive of ${show(flat.map((f) => f.name))}: ${py.error}`);
+  }
+  if (py.testzip !== null) fail(`${what}: zipfile's testzip finds ${show(py.testzip)} corrupt`);
+  const names = py.files.map((f) => f.name).sort();
+  const wantNames = flat.map((f) => f.name).sort();
+  if (show(names) !== show(wantNames)) fail(`${what}: zipfile lists ${show(names)}, fflate was given ${show(wantNames)}`);
+  for (const f of flat) {
+    const p = py.files.find((x) => x.name === f.name);
+    const a = f.attrs;
+    if (!eq(p.data, f.data)) fail(`${what}: ${show(f.name)} reads back as ${hex(p.data)}, not ${hex(f.data)}`);
+    const method = a.level === 0 ? 0 : 8;
+    if (p.method !== method) fail(`${what}: ${show(f.name)} has method ${p.method}, expected ${method} for level ${show(a.level)}`);
+    if (a.mtime !== undefined && show(p.date_time) !== show(dosTime(a.mtime))) fail(`${what}: ${show(f.name)} date_time ${show(p.date_time)} for mtime ${show(a.mtime)}, expected ${show(dosTime(a.mtime))}`);
+    const comment = Buffer.from(a.comment || "").toString("utf8");
+    if (Buffer.from(p.comment).toString("utf8") !== comment) fail(`${what}: ${show(f.name)} comment ${show(Buffer.from(p.comment).toString("utf8"))}, expected ${show(comment)}`);
+    if (p.external_attr !== ((a.attrs || 0) >>> 0)) fail(`${what}: ${show(f.name)} external_attr ${p.external_attr}, expected ${(a.attrs || 0) >>> 0}`);
+    if (p.create_system !== (a.os || 0)) fail(`${what}: ${show(f.name)} create_system ${p.create_system}, expected ${a.os || 0}`);
+    if (!eq(p.extra, extraBytes(a.extra))) fail(`${what}: ${show(f.name)} extra ${hex(p.extra)}, expected ${hex(extraBytes(a.extra))}`);
+    const nonAscii = /[^\u0000-\u007f]/.test(f.name) || /[^\u0000-\u007f]/.test(comment);
+    if (!!(p.flag_bits & 0x800) !== nonAscii) fail(`${what}: ${show(f.name)} UTF-8 flag ${!!(p.flag_bits & 0x800)}, expected ${nonAscii}`);
+    if (p.is_dir !== f.name.endsWith("/")) fail(`${what}: ${show(f.name)} is_dir ${p.is_dir}`);
+  }
+  return true;
+}
+
+// zipSync and the streaming Zip write archives that zipfile reads back entry for entry, with
+// every attribute as given, and that fflate's own unzipSync reads too.
+property("TestHegelZipfileReadsWhatFflateZips", (tc) => {
+  const shapes = new Set();
+  const global = genZipAttributes(tc, shapes);
+  const { tree, flat } = genZippable(tc, shapes, global);
+  count(`entries/${Math.min(flat.length, 5)}${flat.length > 5 ? "+" : ""}`);
+  if (flat.some((f) => f.name.endsWith("/"))) count("has/directory");
+  const archive = tryF(() => F.zipSync(tree, global));
+  if (!archive.ok) fail(`zipSync of ${show(flat.map((f) => f.name))} with ${show(global)} threw ${archive.code} ${archive.message}`);
+  if (!checkPythonReads(archive.out, flat, shapes, "zipSync")) return;
+  const own = tryF(() => F.unzipSync(archive.out));
+  if (!own.ok) fail(`unzipSync cannot read zipSync's archive: ${describe(own)}`);
+  else {
+    const names = Object.keys(own.out).sort();
+    if (show(names) !== show(flat.map((f) => f.name).sort())) fail(`unzipSync lists ${show(names)} of zipSync's ${show(flat.map((f) => f.name).sort())}`);
+    for (const f of flat) if (own.out[f.name] && !eq(own.out[f.name], f.data)) fail(`unzipSync reads ${show(f.name)} as ${hex(own.out[f.name])}, not ${hex(f.data)}`);
+  }
+  // the streaming writer, with data descriptors, files pushed in pieces
+  const chunks = [];
+  let zerr = null;
+  const zs = tryF(() => {
+    const zip = new F.Zip((err, chunk, final) => {
+      if (err) zerr = err;
+      else chunks.push(Uint8Array.from(chunk));
+    });
+    for (const f of flat) {
+      const a = f.attrs;
+      const file = a.level === 0 ? new F.ZipPassThrough(f.name) : new F.ZipDeflate(f.name, { level: a.level, mem: a.mem });
+      for (const k of ["mtime", "os", "attrs", "extra", "comment"]) if (a[k] !== undefined) file[k] = a[k];
+      zip.add(file);
+      const parts = pieces(f.data, genCuts(tc, f.data.length));
+      parts.forEach((p, i) => file.push(p, i === parts.length - 1));
+    }
+    zip.end();
+  });
+  if (!zs.ok) fail(`the streaming Zip of ${show(flat.map((f) => f.name))} threw ${zs.code} ${zs.message}`);
+  if (zerr) fail(`the streaming Zip reported ${zerr.code} ${zerr.message}`);
+  checkPythonReads(concat(chunks), flat, shapes, "Zip stream");
+});
+
+// ---------------------------------------------------------------- ZIP: zipfile writes, fflate reads
+
+function genPyFiles(tc) {
+  const used = new Set();
+  const files = [];
+  const k = n(tc, 0, 6);
+  for (let i = 0; i < k; i++) {
+    let name = genName(tc, used);
+    if (name === null) continue;
+    const dir = chance(tc, 15);
+    if (dir) name += "/";
+    if (used.has(name)) continue;
+    used.add(name);
+    const method = dir ? 0 : pick(tc, [0, 0, 8, 8, 8, 8, 12, 14]);
+    const f = {
+      name,
+      data: dir || chance(tc, 10) ? new Uint8Array(0) : genData(tc, 6000).data,
+      method,
+      level: method === 8 && chance(tc, 50) ? n(tc, 0, 9) : null,
+      date_time: [n(tc, 1980, 2107), n(tc, 1, 12), n(tc, 1, 28), n(tc, 0, 23), n(tc, 0, 59), n(tc, 0, 58) & ~1],
+      comment: chance(tc, 30) ? new Uint8Array(Buffer.from(genComment(tc))) : new Uint8Array(0),
+      external_attr: chance(tc, 30) ? n(tc, 0, 0xffffffff) : 0,
+      create_system: pick(tc, [0, 3, 3]),
+      extra: chance(tc, 15) ? extraBytes(genExtra(tc)) : new Uint8Array(0),
+      force_zip64: chance(tc, 10),
+    };
+    files.push(f);
+  }
+  return files;
+}
+
+// zipfile's archives — stored and deflated, streamed with data descriptors or not, zip64
+// records, comments, non-ASCII names — are read by unzipSync and the streaming Unzip alike;
+// bzip2 and lzma entries are refused as unknown, not misread.
+property("TestHegelFflateReadsWhatZipfileWrites", (tc) => {
+  const files = genPyFiles(tc);
+  const streaming = chance(tc, 40);
+  const comment = chance(tc, 30) ? new Uint8Array(Buffer.from(genComment(tc))) : new Uint8Array(0);
+  const py = pyWriteZip(files, { comment, streaming });
+  if (!py.ok) fail(`zipfile refused ${show(files.map((f) => f.name))}: ${py.error}`);
+  const archive = py.zip;
+  const unsupported = files.filter((f) => f.method !== 0 && f.method !== 8);
+  count(`${streaming ? "streamed" : "seekable"}/${unsupported.length ? "with-unknown-method" : "known-methods"}`);
+  if (files.some((f) => f.force_zip64)) count("has/zip64");
+  const supported = files.filter((f) => f.method === 0 || f.method === 8);
+  // one-shot
+  const got = tryF(() => F.unzipSync(archive));
+  if (unsupported.length) {
+    if (got.ok) fail(`unzipSync accepts an archive with method ${unsupported[0].method} entries: ${show(Object.keys(got.out))}`);
+    else if (got.code !== 14) fail(`unzipSync on a method ${unsupported[0].method} entry: error ${got.code} ${got.message}, expected 14`);
+  } else if (!got.ok) {
+    fail(`unzipSync cannot read zipfile's archive of ${show(files.map((f) => f.name))} (${streaming ? "streamed" : "seekable"}): ${describe(got)}`);
+  }
+  // filtered to the entries it can read
+  const filtered = tryF(() => F.unzipSync(archive, { filter: (f) => f.compression === 0 || f.compression === 8 }));
+  if (!filtered.ok) fail(`unzipSync with a filter cannot read zipfile's archive: ${describe(filtered)}`);
+  else {
+    const names = Object.keys(filtered.out).sort();
+    const want = supported.map((f) => f.name).sort();
+    if (show(names) !== show(want)) fail(`unzipSync lists ${show(names)}, zipfile wrote ${show(want)}`);
+    for (const f of supported) if (filtered.out[f.name] && !eq(filtered.out[f.name], f.data)) fail(`unzipSync reads ${show(f.name)} (method ${f.method}) as ${hex(filtered.out[f.name])}, not ${hex(f.data)}`);
+  }
+  // streaming, pushed in pieces
+  const seen = new Map();
+  const errors = [];
+  const skipped = [];
+  const st = tryF(() => {
+    const u = new F.Unzip((file) => {
+      const chunks = [];
+      file.ondata = (err, chunk, final) => {
+        if (err) errors.push({ name: file.name, code: err.code, message: err.message });
+        else {
+          chunks.push(Uint8Array.from(chunk));
+          if (final) seen.set(file.name, concat(chunks));
+        }
+      };
+      if (file.compression === 0 || file.compression === 8) file.start();
+      else skipped.push(file.name);
+    });
+    u.register(F.UnzipInflate);
+    const parts = pieces(archive, genCuts(tc, archive.length));
+    parts.forEach((p, i) => u.push(p, i === parts.length - 1));
+  });
+  if (show(skipped.sort()) !== show(unsupported.map((f) => f.name).sort())) fail(`the streaming Unzip announces ${show(skipped)} with an unknown method, zipfile wrote ${show(unsupported.map((f) => f.name))}`);
+  if (unsupported.length) {
+    // starting an entry whose method has no decoder must report error 14 through ondata
+    let reported = null;
+    const started = tryF(() => {
+      const u = new F.Unzip((file) => {
+        file.ondata = (err) => { if (err) reported = err.code; };
+        file.start();
+      });
+      u.register(F.UnzipInflate);
+      u.push(archive, true);
+    });
+    if (!started.ok) {
+      // fflate/7: after reporting error 14, start() goes on to construct the missing decoder
+      if (reported === 14 && /not a constructor/.test(started.message)) count("fflate/7");
+      else fail(`starting a method ${unsupported[0].method} entry threw ${started.code} ${started.message} (reported ${reported})`);
+    } else if (reported !== 14) fail(`starting a method ${unsupported[0].method} entry reported ${reported}, expected 14`);
+  }
+  if (!st.ok) fail(`the streaming Unzip of zipfile's archive (${streaming ? "streamed" : "seekable"}) threw ${st.code} ${st.message}`);
+  for (const e of errors) {
+    const f = files.find((x) => x.name === e.name);
+    if (!f || (f.method === 0 || f.method === 8)) fail(`the streaming Unzip reports ${e.code} ${e.message} for ${show(e.name)}`);
+    else if (e.code !== 14) fail(`the streaming Unzip reports ${e.code} ${e.message} for a method ${f.method} entry, expected 14`);
+  }
+  const names = [...seen.keys()].sort();
+  const want = supported.map((f) => f.name).sort();
+  if (show(names) !== show(want)) fail(`the streaming Unzip delivers ${show(names)}, zipfile wrote ${show(want)} (${streaming ? "streamed" : "seekable"})`);
+  for (const f of supported) if (seen.has(f.name) && !eq(seen.get(f.name), f.data)) fail(`the streaming Unzip reads ${show(f.name)} (method ${f.method}) as ${hex(seen.get(f.name))}, not ${hex(f.data)}`);
+});
+
+// ---------------------------------------------------------------- pins
+
+pin("TestHegelPinGunzipSyncAcceptsZeroPadding", () => {
+  // fflate/1: gunzipSync sizes its output from the last four bytes of the input; a member
+  // followed by zero padding (which gzip(1) and zlib accept) comes back empty
+  const g = zlib.gzipSync(Buffer.from("abc".repeat(100)));
+  const padded = concat([new Uint8Array(g), new Uint8Array(8)]);
+  assert.deepEqual(new Uint8Array(zlib.gunzipSync(padded)), new Uint8Array(Buffer.from("abc".repeat(100))));
+  assert.equal(F.gunzipSync(padded).length, 300);
+});
+
+pin("TestHegelPinGunzipSyncReadsEveryMember", () => {
+  // fflate/1: the one-shot gunzipSync reads the first member only, into a buffer sized by the
+  // last member's ISIZE (the streaming Gunzip reads them all)
+  const two = concat([new Uint8Array(zlib.gzipSync(Buffer.from("abc".repeat(100)))), new Uint8Array(zlib.gzipSync(Buffer.from("xyz")))]);
+  assert.equal(zlib.gunzipSync(two).toString(), "abc".repeat(100) + "xyz");
+  assert.equal(Buffer.from(F.gunzipSync(two)).toString(), "abc".repeat(100) + "xyz");
+});
+
+pin("TestHegelPinDamagedChecksumIsAnError", () => {
+  // fflate/2: the Adler-32 (zlib) and CRC-32 (gzip) trailers are not verified
+  const data = Buffer.from("abc".repeat(100));
+  const z = Uint8Array.from(zlib.deflateSync(data));
+  z[z.length - 1] ^= 1;
+  assert.throws(() => zlib.inflateSync(z));
+  assert.throws(() => F.unzlibSync(z), "unzlibSync accepts a wrong Adler-32");
+});
+
+pin("TestHegelPinGzipFilenameOutsideLatin1IsNotCorrupting", () => {
+  // fflate/3: FNAME is written from the low byte of each UTF-16 code unit; a character whose
+  // low byte is 0 ends the name early and the rest of the header is read as compressed data
+  const data = new Uint8Array(Buffer.from("abc".repeat(100)));
+  const g = F.gzipSync(data, { filename: "a一b" });
+  assert.deepEqual(new Uint8Array(zlib.gunzipSync(g)), data);
+});
+
+pin("TestHegelPinEncodeUtf8KeepsASplitSurrogatePair", () => {
+  // fflate/4: EncodeUTF8 pushes each chunk through strToU8 with no state between pushes
+  const chunks = [];
+  const enc = new F.EncodeUTF8((b) => chunks.push(Uint8Array.from(b)));
+  enc.push("\ud83d", false);
+  enc.push("\ude00", true);
+  assert.deepEqual(concat(chunks), new TextEncoder().encode("😀"));
+});
+
+pin("TestHegelPinDecompressStreamKeepsAShortFirstPush", () => {
+  // fflate/6: the Decompress stream's buffer for a first push under 3 bytes is built and
+  // dropped, so the format is never detected and the stream yields nothing
+  const data = new Uint8Array(Buffer.from("abc".repeat(100)));
+  const s = new Uint8Array(zlib.deflateSync(data));
+  const out = [];
+  const d = new F.Decompress((chunk) => out.push(Uint8Array.from(chunk)));
+  d.push(s.subarray(0, 1), false);
+  d.push(s.subarray(1), true);
+  assert.deepEqual(concat(out), data);
+});
+
+pin("TestHegelPinUnzipStartOnAnUnknownMethodOnlyReports", () => {
+  // fflate/7: start() on an entry whose compression method has no registered decoder calls
+  // ondata with error 14 and then throws "ctr is not a constructor"
+  const py = pyWriteZip([{ name: "a", data: new Uint8Array([1, 2, 3]), method: 12, level: null, date_time: [2020, 1, 1, 0, 0, 0], external_attr: 0, create_system: 3, force_zip64: false }]);
+  assert.ok(py.ok, py.error);
+  let reported = null;
+  const u = new F.Unzip((file) => {
+    file.ondata = (err) => { if (err) reported = err.code; };
+    file.start();
+  });
+  u.push(py.zip, true);
+  assert.equal(reported, 14);
+});
+
+pin("TestHegelPinTruncatedZlibStreamIsAnError", () => {
+  // fflate/8: unzlibSync slices the header and trailer off first, so a stream cut to fewer
+  // than seven bytes decodes to nothing without an error (zlib: unexpected end of file)
+  const s = new Uint8Array(zlib.deflateSync(Buffer.from("abc".repeat(100)))).subarray(0, 4);
+  assert.throws(() => zlib.inflateSync(s));
+  assert.throws(() => F.unzlibSync(s), "unzlibSync returns for 4 bytes of a zlib stream");
+});
+
+pin("TestHegelPinSyncFlushAtLevelZeroStaysDecodable", () => {
+  // fflate/9: at level 0 (stored blocks) flush(true) writes the empty stored block without
+  // its header byte: `00 0100 feff 01 | 0000ffff | …`, and nothing can read on
+  const chunks = [];
+  const d = new F.Deflate({ level: 0 }, (c) => chunks.push(Uint8Array.from(c)));
+  d.push(new Uint8Array([1]), false);
+  d.flush(true);
+  d.push(new Uint8Array([2, 3]), true);
+  assert.deepEqual(new Uint8Array(zlib.inflateRawSync(concat(chunks))), new Uint8Array([1, 2, 3]));
+});
+
+pin("TestHegelPinShortDictionaryOutputIsReadable", () => {
+  // fflate/10: 1000 incompressible bytes with a one-byte dictionary: zlib rejects the
+  // output ("invalid distance too far back") and fflate reads it back as other bytes
+  const data = new Uint8Array(1000);
+  let s = 1;
+  for (let i = 0; i < data.length; i++) {
+    s = (Math.imul(s, 1103515245) + 12345) & 0x7fffffff;
+    data[i] = s >> 16;
+  }
+  const dictionary = new Uint8Array([7]);
+  const c = F.zlibSync(data, { dictionary });
+  assert.deepEqual(new Uint8Array(zlib.inflateSync(c, { dictionary })), data);
+});
+
+pin("TestHegelPinGunzipStreamReportsATruncatedStream", () => {
+  // fflate/11: a gzip stream cut inside its header, pushed as final, ends with no output and
+  // no error (gunzipSync: error 6; Node: unexpected end of file)
+  const g = new Uint8Array(zlib.gzipSync(Buffer.from("abc".repeat(100))));
+  assert.throws(() => zlib.gunzipSync(g.subarray(0, 5)));
+  assert.throws(() => F.gunzipSync(g.subarray(0, 5)));
+  assert.throws(() => {
+    const s = new F.Gunzip(() => {});
+    s.push(g.subarray(0, 5), true);
+  }, "the Gunzip stream accepts five bytes of header as a whole stream");
+});
+
+pin("TestHegelPinInflateStreamWithDictionaryAcceptsAnEmptyFirstPush", () => {
+  // fflate/12: `new Inflate({ dictionary })` pushed an empty chunk first slices its window
+  // with a negative start and the data that follows decodes to wrong bytes, silently
+  const data = new Uint8Array(Buffer.from("hello world 0123456789 ".repeat(200)));
+  const dictionary = new Uint8Array(Buffer.from("hello".repeat(31) + "0123456789"));
+  const s = new Uint8Array(zlib.deflateRawSync(data, { dictionary }));
+  const out = [];
+  const inf = new F.Inflate({ dictionary }, (c) => out.push(Uint8Array.from(c)));
+  inf.push(new Uint8Array(0), false);
+  inf.push(s, true);
+  assert.deepEqual(concat(out), data);
+});
+
+pin("TestHegelPinStoredBlocksOfExactly65535BytesEndTheStream", () => {
+  // fflate/13: `zlibSync(new Uint8Array(65535), { level: 0 })` writes `01 ffff 0000 <data>
+  // 01 0000 ffff <adler>`: two final blocks, and zlib reads the Adler-32 where the second
+  // block is
+  const data = new Uint8Array(65535).fill(7);
+  assert.deepEqual(new Uint8Array(zlib.inflateSync(F.zlibSync(data, { level: 0 }))), data);
+});
+
+pin("TestHegelPinZipCommentOver65535BytesIsRefused", () => {
+  // fflate/5: a file comment longer than the 16-bit length field is written without an error
+  // (a long filename gets error 11, a long extra field error 9) and the archive is unreadable
+  const archive = (() => {
+    try {
+      return F.zipSync({ a: [new Uint8Array([1, 2, 3]), { comment: "c".repeat(70000) }] });
+    } catch (e) {
+      return null; // an error is the fix
+    }
+  })();
+  if (archive === null) return;
+  const py = pyReadZip(archive);
+  assert.ok(py.ok, `zipfile cannot read it: ${py.error}`);
+  assert.equal(Buffer.from(py.files[0].comment).length, 70000);
+});
