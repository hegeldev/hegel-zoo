+++ b/test/hegel-zip-oracle.py
@@ -0,0 +1,122 @@
+#!/usr/bin/env python3
+"""Hegel zoo: Python's zipfile as the oracle for fflate's ZIP writer and reader, held open by
+the tests.
+
+Reads one JSON request per line from the FIFO given as argv[1] and writes one JSON response
+per line to the FIFO given as argv[2]. Bytes cross the boundary as base64.
+
+  {"op": "ping"}
+  {"op": "read", "zip": b64}
+      -> {"ok": true, "comment": b64, "testzip": null | name, "files": [{"name", "data": b64,
+          "crc", "method", "date_time": [y, m, d, H, M, S], "comment": b64, "external_attr",
+          "create_system", "flag_bits", "extra": b64, "is_dir", "file_size", "compress_size"}]}
+      or {"ok": false, "error": "..."}
+  {"op": "write", "files": [{"name", "data": b64, "method": 0|8|12|14, "level": int|null,
+          "date_time": [..], "comment": b64, "external_attr", "create_system", "extra": b64,
+          "force_zip64": bool}], "comment": b64, "streaming": bool}
+      -> {"ok": true, "zip": b64} or {"ok": false, "error": "..."}
+
+With "streaming" the archive is written to an unseekable sink, so zipfile writes data
+descriptors (flag bit 3) and leaves the sizes out of the local headers.
+"""
+import base64
+import io
+import json
+import sys
+import zipfile
+
+
+def b64(b):
+    return base64.b64encode(b).decode("ascii")
+
+
+def unb64(s):
+    return base64.b64decode(s)
+
+
+class Unseekable:
+    """A write-only sink: zipfile then takes the streaming path (data descriptors)."""
+
+    def __init__(self):
+        self.buf = io.BytesIO()
+
+    def write(self, b):
+        return self.buf.write(b)
+
+    def flush(self):
+        pass
+
+
+def do_read(req):
+    data = unb64(req["zip"])
+    zf = zipfile.ZipFile(io.BytesIO(data))
+    files = []
+    for info in zf.infolist():
+        files.append({
+            "name": info.filename,
+            "data": b64(zf.read(info)),
+            "crc": info.CRC,
+            "method": info.compress_type,
+            "date_time": list(info.date_time),
+            "comment": b64(info.comment),
+            "external_attr": info.external_attr,
+            "create_system": info.create_system,
+            "flag_bits": info.flag_bits,
+            "extra": b64(info.extra),
+            "is_dir": info.is_dir(),
+            "file_size": info.file_size,
+            "compress_size": info.compress_size,
+        })
+    return {"ok": True, "comment": b64(zf.comment), "testzip": zf.testzip(), "files": files}
+
+
+def do_write(req):
+    sink = Unseekable() if req.get("streaming") else io.BytesIO()
+    with zipfile.ZipFile(sink, "w", allowZip64=True) as zf:
+        for f in req["files"]:
+            info = zipfile.ZipInfo(f["name"], date_time=tuple(f["date_time"]))
+            info.compress_type = f["method"]
+            if f.get("level") is not None:
+                # the public name arrived with Python 3.13; 3.12 has the private one
+                if hasattr(info, "compress_level"):
+                    info.compress_level = f["level"]
+                else:
+                    info._compresslevel = f["level"]
+            info.comment = unb64(f.get("comment", ""))
+            info.external_attr = f.get("external_attr", 0)
+            info.create_system = f.get("create_system", 3)
+            info.extra = unb64(f.get("extra", ""))
+            data = unb64(f["data"])
+            if f.get("force_zip64"):
+                with zf.open(info, "w", force_zip64=True) as w:
+                    w.write(data)
+            else:
+                zf.writestr(info, data)
+        zf.comment = unb64(req.get("comment", ""))
+    out = sink.buf.getvalue() if isinstance(sink, Unseekable) else sink.getvalue()
+    return {"ok": True, "zip": b64(out)}
+
+
+def main():
+    req_path, resp_path = sys.argv[1], sys.argv[2]
+    with open(req_path, "r", encoding="utf-8") as req, open(resp_path, "w", encoding="utf-8") as resp:
+        for line in req:
+            r = json.loads(line)
+            try:
+                op = r["op"]
+                if op == "ping":
+                    ans = {"ok": True, "python": sys.version.split()[0]}
+                elif op == "read":
+                    ans = do_read(r)
+                elif op == "write":
+                    ans = do_write(r)
+                else:
+                    ans = {"ok": False, "error": "unknown op " + op}
+            except Exception as e:  # noqa: BLE001 - every failure is an answer
+                ans = {"ok": False, "error": "%s: %s" % (type(e).__name__, e)}
+            resp.write(json.dumps(ans, ensure_ascii=True) + "\n")
+            resp.flush()
+
+
+if __name__ == "__main__":
+    main()
diff --git a/test/hegel-zip.mjs b/test/hegel-zip.mjs
new file mode 100644
index 0000000..bfde802
--- /dev/null
+++ b/test/hegel-zip.mjs
@@ -0,0 +1,92 @@
+// Hegel zoo: the bridge to Python's zipfile (test/hegel-zip-oracle.py), held open as a child
+// process over two FIFOs with one JSON line per request, so a ZIP archive can be read or
+// written by an independent implementation in well under a millisecond per case.
+
+import { execFileSync, spawn } from "node:child_process";
+import { mkdtempSync, openSync, readSync, rmSync, writeSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { dirname, join } from "node:path";
+import { fileURLToPath } from "node:url";
+
+const here = dirname(fileURLToPath(import.meta.url));
+
+let oracle = null;
+
+function startOracle() {
+  execFileSync("python3", ["-c", "import zipfile, zlib, bz2, lzma"], { stdio: "ignore" });
+  const dir = mkdtempSync(join(tmpdir(), "hegel-zip-"));
+  const req = join(dir, "req");
+  const resp = join(dir, "resp");
+  execFileSync("mkfifo", [req, resp]);
+  const child = spawn("python3", ["-u", join(here, "hegel-zip-oracle.py"), req, resp], {
+    stdio: ["ignore", "inherit", "inherit"],
+  });
+  child.unref();
+  const wfd = openSync(req, "w");
+  const rfd = openSync(resp, "r");
+  process.on("exit", () => {
+    try { child.kill(); } catch {}
+    try { rmSync(dir, { recursive: true, force: true }); } catch {}
+  });
+  const buf = Buffer.alloc(1 << 16);
+  let pending = "";
+  return {
+    call(obj) {
+      // lone surrogates have no UTF-8; escape every surrogate code unit so the request line
+      // is plain ASCII-safe JSON
+      const line = JSON.stringify(obj).replace(/[\ud800-\udfff]/g, (c) => "\\u" + c.charCodeAt(0).toString(16).padStart(4, "0"));
+      writeSync(wfd, line + "\n");
+      for (;;) {
+        const nl = pending.indexOf("\n");
+        if (nl !== -1) {
+          const answer = pending.slice(0, nl);
+          pending = pending.slice(nl + 1);
+          return JSON.parse(answer);
+        }
+        const got = readSync(rfd, buf, 0, buf.length, null);
+        if (got === 0) throw new Error("the zipfile oracle went away");
+        pending += buf.toString("utf8", 0, got);
+      }
+    },
+  };
+}
+
+export function b64(u8) {
+  return Buffer.from(u8.buffer, u8.byteOffset, u8.byteLength).toString("base64");
+}
+
+export function unb64(s) {
+  return new Uint8Array(Buffer.from(s, "base64"));
+}
+
+/** zipfile reads `archive` (a Uint8Array): {ok, comment, testzip, files: [...]} with the data
+ *  and comments decoded from base64 to Uint8Array, or {ok: false, error}. */
+export function pyReadZip(archive) {
+  oracle ??= startOracle();
+  const r = oracle.call({ op: "read", zip: b64(archive) });
+  if (r.ok) {
+    r.comment = unb64(r.comment);
+    for (const f of r.files) {
+      f.data = unb64(f.data);
+      f.comment = unb64(f.comment);
+      f.extra = unb64(f.extra);
+    }
+  }
+  return r;
+}
+
+/** zipfile writes an archive of `files` ([{name, data: Uint8Array, method, level, date_time,
+ *  comment: Uint8Array, external_attr, create_system, extra: Uint8Array, force_zip64}]) with
+ *  the archive `comment` (Uint8Array), streaming (data descriptors) or not: {ok, zip:
+ *  Uint8Array} or {ok: false, error}. */
+export function pyWriteZip(files, { comment = new Uint8Array(0), streaming = false } = {}) {
+  oracle ??= startOracle();
+  const r = oracle.call({
+    op: "write",
+    files: files.map((f) => ({ ...f, data: b64(f.data), comment: b64(f.comment || new Uint8Array(0)), extra: b64(f.extra || new Uint8Array(0)) })),
+    comment: b64(comment),
+    streaming,
+  });
+  if (r.ok) r.zip = unb64(r.zip);
+  return r;
+}
diff --git a/test/hegel-zoo.mjs b/test/hegel-zoo.mjs
new file mode 100644
index 0000000..ef914e1
--- /dev/null
+++ b/test/hegel-zoo.mjs
@@ -0,0 +1,138 @@
+// Hegel zoo: the small harness shared by the zoo's TypeScript/JavaScript targets.
+//
+// `property(name, body)` registers a node:test test that runs `body(tc)` under Hegel with
+// HEGEL_TEST_CASES cases (default 100) and the database at HEGEL_DATABASE. With ZOO_COLLECT=1
+// a `fail()` records the mismatch instead of failing, the case ends there, and the counts of
+// mismatches and of the shapes seen (`count(key)`) are printed at the end of the test, so a
+// property can be run over many cases to see every shape at once. `pin(name, body)` is a
+// plain test for one pinned bug: it must fail while the bug is present and pass once it is
+// fixed (the zoo's judge reads an unexpected pass as "fixed upstream?").
+
+import { readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { test as nodeTest } from "node:test";
+import * as hegel from "@hegeldev/hegel";
+import * as gs from "@hegeldev/hegel/generators";
+
+// The Hegel version these tests were written against (the zoo pins it in zoo.toml and installs
+// it with `npm install --no-save @hegeldev/hegel@<version>`; upstream would add it to
+// devDependencies). Checked at load time so a stray install cannot silently change the engine.
+export const HEGEL_PIN = { "@hegeldev/hegel": "0.4.5" };
+
+{
+  let dir = dirname(fileURLToPath(import.meta.resolve("@hegeldev/hegel")));
+  while (!/[\\/]hegel$/.test(dir) && dir !== dirname(dir)) dir = dirname(dir);
+  const installed = JSON.parse(readFileSync(join(dir, "package.json"), "utf8")).version;
+  if (installed !== HEGEL_PIN["@hegeldev/hegel"]) {
+    throw new Error(`@hegeldev/hegel ${installed} is installed; these tests pin ${HEGEL_PIN["@hegeldev/hegel"]}`);
+  }
+}
+
+export const collecting = !!process.env.ZOO_COLLECT;
+
+class Collected extends Error {}
+
+let msgs = [];
+let stats = new Map();
+
+/** Report a mismatch: an error normally, a recorded line in collect mode. */
+export function fail(message) {
+  if (collecting) {
+    msgs.push(message);
+    throw new Collected(message);
+  }
+  throw new Error(message);
+}
+
+/** Bump a statistic (the shape of a pinned bug, a generator branch). */
+export function count(key) {
+  stats.set(key, (stats.get(key) || 0) + 1);
+}
+
+function settings() {
+  const s = { testCases: Number(process.env.HEGEL_TEST_CASES) || 100 };
+  if (process.env.HEGEL_DATABASE) {
+    s.database = hegel.Database.fromPath(process.env.HEGEL_DATABASE);
+  }
+  return s;
+}
+
+/** A property: `body(tc)` runs under Hegel; a thrown error (or `fail`) is a failure. */
+export function property(name, body) {
+  nodeTest(name, () => {
+    msgs = [];
+    stats = new Map();
+    hegel.test((tc) => {
+      try {
+        body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** A pin: a plain test for one recorded bug. */
+export function pin(name, body) {
+  nodeTest(name, body);
+}
+
+/** An integer in [lo, hi]. */
+export function n(tc, lo, hi) {
+  return tc.draw(gs.integers({ minValue: lo, maxValue: hi }));
+}
+
+/** One of xs. */
+export function pick(tc, xs) {
+  return xs[n(tc, 0, xs.length - 1)];
+}
+
+/** True pct percent of the time. */
+export function chance(tc, pct) {
+  return n(tc, 0, 99) < pct;
+}
+
+/** A string of `len` characters drawn from `alphabet` (an array of strings). */
+export function word(tc, alphabet, lo, hi) {
+  const len = n(tc, lo, hi);
+  let s = "";
+  for (let i = 0; i < len; i++) {
+    s += pick(tc, alphabet);
+  }
+  return s;
+}
+
+/** Structural equality: arrays by position, objects by key set (prototype ignored), else ===. */
+export function same(a, b) {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) {
+      return false;
+    }
+    return a.every((x, i) => same(x, b[i]));
+  }
+  if (a !== null && b !== null && typeof a === "object" && typeof b === "object") {
+    const ka = Object.keys(a).sort();
+    const kb = Object.keys(b).sort();
+    if (ka.length !== kb.length || ka.some((k, i) => k !== kb[i])) {
+      return false;
+    }
+    return ka.every((k) => same(a[k], b[k]));
+  }
+  return a === b;
+}
+
+/** A compact, unambiguous rendering for messages. */
+export function show(x) {
+  return JSON.stringify(x, (k, v) => (v === undefined ? "<undefined>" : v));
+}
diff --git a/test/hegel.test.mjs b/test/hegel.test.mjs
new file mode 100644
index 0000000..8e5fc79
--- /dev/null
+++ b/test/hegel.test.mjs
@@ -0,0 +1,966 @@
+// Hegel zoo: properties of fflate (101arrowz/fflate) — its DEFLATE / zlib / gzip output read
+// by Node's zlib and Node's read by fflate, whole, streamed and damaged; the UTF-8 helpers;
+// ZIP archives against Python's zipfile in both directions.
+//
+// Run with `node --test --test-reporter=tap test/hegel.test.mjs` once tsc has built lib/ (the
+// setup step in target.toml: `tsc -p test/tsconfig.hegel.json --noCheck`). fflate ships tsc's
+// ES5 output and its streaming classes rely on it (`Deflate.call(this, …)` in the Gzip and
+// Zlib constructors fails on a native class), so the tests import ../lib/index.js rather than
+// the sources. ZOO_COLLECT=1 records mismatches instead of failing (see test/hegel-zoo.mjs).
+
+import assert from "node:assert/strict";
+import zlib from "node:zlib";
+import * as F from "../lib/index.js";
+import { property, pin, fail, count, n, pick, chance, word, show } from "./hegel-zoo.mjs";
+import { pyReadZip, pyWriteZip } from "./hegel-zip.mjs";
+
+const Z = zlib.constants;
+
+// ---------------------------------------------------------------- helpers
+
+function eq(a, b) {
+  if (a.length !== b.length) return false;
+  for (let i = 0; i < a.length; i++) if (a[i] !== b[i]) return false;
+  return true;
+}
+
+function concat(chunks) {
+  const out = new Uint8Array(chunks.reduce((s, c) => s + c.length, 0));
+  let pos = 0;
+  for (const c of chunks) {
+    out.set(c, pos);
+    pos += c.length;
+  }
+  return out;
+}
+
+function hex(u, k = 24) {
+  return Buffer.from(u.subarray(0, k)).toString("hex") + (u.length > k ? `…(${u.length})` : "");
+}
+
+/** Node's answer as {ok, out} or {ok: false, code}. */
+function tryNode(f) {
+  try {
+    return { ok: true, out: new Uint8Array(f()) };
+  } catch (e) {
+    return { ok: false, code: e.code || e.message };
+  }
+}
+
+/** fflate's answer in the same shape (its errors carry a numeric `code`, see FlateErrorCode). */
+function tryF(f) {
+  try {
+    return { ok: true, out: f() };
+  } catch (e) {
+    return { ok: false, code: e.code ?? e.message, message: e.message };
+  }
+}
+
+function describe(r) {
+  return r.ok ? `ok ${r.out.length}` : `error ${r.code}${r.message ? " " + r.message : ""}`;
+}
+
+// Random cut points for chunked pushes.
+function genCuts(tc, len) {
+  const cuts = [];
+  const k = n(tc, 0, 6);
+  for (let i = 0; i < k; i++) cuts.push(n(tc, 0, len));
+  cuts.sort((a, b) => a - b);
+  return cuts;
+}
+
+function pieces(data, cuts) {
+  const out = [];
+  const cut = (a, b) => (typeof data === "string" ? data.slice(a, b) : data.subarray(a, b));
+  let pos = 0;
+  for (const c of cuts) {
+    out.push(cut(pos, c));
+    pos = c;
+  }
+  out.push(cut(pos));
+  return out;
+}
+
+/** Push `data` through a streaming class in pieces; returns {ok, out} or {ok: false, code}. */
+function stream(make, data, cuts) {
+  const chunks = [];
+  try {
+    const s = make((chunk, final) => chunks.push(Uint8Array.from(chunk)));
+    const parts = pieces(data, cuts);
+    parts.forEach((part, i) => s.push(part, i === parts.length - 1));
+    return { ok: true, out: concat(chunks) };
+  } catch (e) {
+    return { ok: false, code: e.code ?? e.message, message: e.message };
+  }
+}
+
+// ---------------------------------------------------------------- data
+
+// Input data of a few textures: random bytes, text with repeats, runs, and mixtures; mostly
+// small, sometimes a few hundred kilobytes (past the 32 KiB window and fflate's 64 KiB chunk).
+const WORDS = ["hello", "world", "fflate", "zlib", "deflate", "the ", "and ", "\n", " ", "é", "全", "😀", "0123456789", "aaaa"];
+
+function genData(tc, max = 20000) {
+  const r = n(tc, 0, 99);
+  const big = max > 20000 && chance(tc, 6);
+  const size = big ? (chance(tc, 30) ? pick(tc, [65535, 131070]) : n(tc, 70000, 300000)) : chance(tc, 10) ? n(tc, 0, 3) : n(tc, 0, max);
+  const out = new Uint8Array(size);
+  if (r < 30) {
+    let s = n(tc, 1, 0x7fffffff);
+    for (let i = 0; i < size; i++) {
+      s = (Math.imul(s, 1103515245) + 12345) & 0x7fffffff;
+      out[i] = s >> 16;
+    }
+    return { data: out, texture: "random", text: false };
+  }
+  if (r < 60) {
+    let s = "";
+    const k = n(tc, 1, 6);
+    const vocab = [];
+    for (let i = 0; i < k; i++) vocab.push(pick(tc, WORDS));
+    while (Buffer.byteLength(s) < size) s += pick(tc, vocab);
+    const b = Buffer.from(s);
+    return { data: new Uint8Array(b.buffer, b.byteOffset, b.length), texture: "text", text: true };
+  }
+  if (r < 75) {
+    let i = 0;
+    while (i < size) {
+      const v = n(tc, 0, 255);
+      const len = n(tc, 1, 5000);
+      out.fill(v, i, Math.min(size, i + len));
+      i += len;
+    }
+    return { data: out, texture: "runs", text: false };
+  }
+  let i = 0;
+  let s = n(tc, 1, 0x7fffffff);
+  while (i < size) {
+    const len = n(tc, 1, 4000);
+    const end = Math.min(size, i + len);
+    if (chance(tc, 50)) {
+      for (; i < end; i++) {
+        s = (Math.imul(s, 1103515245) + 12345) & 0x7fffffff;
+        out[i] = s >> 16;
+      }
+    } else {
+      const period = n(tc, 1, 40);
+      for (; i < end; i++) out[i] = 65 + (i % period);
+    }
+  }
+  return { data: out, texture: "mixed", text: false };
+}
+
+function genBytes(tc, lo, hi) {
+  const len = n(tc, lo, hi);
+  const out = new Uint8Array(len);
+  for (let i = 0; i < len; i++) out[i] = n(tc, 0, 255);
+  return out;
+}
+
+const LATIN1 = ["a", "b", "z", "0", " ", ".", "/", "é", "ÿ", "-", "_", "x", "", "\u00a0"];
+
+// ---------------------------------------------------------------- fflate writes, zlib reads
+
+// fflate's compression options; the dictionary only where the format carries one.
+function genFflateOptions(tc) {
+  const mode = pick(tc, ["raw", "zlib", "zlib", "gzip", "gzip"]);
+  const o = {};
+  if (chance(tc, 70)) o.level = n(tc, 0, 9);
+  if (chance(tc, 40)) o.mem = n(tc, 0, 12);
+  let dictionary = null;
+  if (mode !== "gzip" && chance(tc, 25)) {
+    dictionary = chance(tc, 15) ? genData(tc, 40000).data : new Uint8Array(Buffer.from(word(tc, WORDS, 1, 40)));
+    o.dictionary = dictionary;
+  }
+  const shapes = new Set();
+  if (mode === "gzip") {
+    if (chance(tc, 50)) {
+      o.filename = word(tc, LATIN1, 0, 12);
+      if (chance(tc, 8)) {
+        o.filename += pick(tc, ["一", "😀", "Ā", "\u0000"]);
+        shapes.add("gzip/filename-outside-latin1");
+      }
+    }
+    if (chance(tc, 50)) {
+      const secs = pick(tc, [0, 1, 1700000000, 0x7fffffff, 0x80000000, 0xffffffff, n(tc, 1, 0xffffffff)]);
+      o.mtime = pick(tc, [secs * 1000, new Date(secs * 1000), new Date(secs * 1000).toISOString()]);
+      if (secs === 0) o.mtime = 0;
+    }
+  }
+  return { mode, o, dictionary, shapes };
+}
+
+function fflateCompress(mode, data, o) {
+  if (mode === "raw") return F.deflateSync(data, o);
+  if (mode === "gzip") return F.gzipSync(data, o);
+  return F.zlibSync(data, o);
+}
+
+function fflateStreamClass(mode) {
+  return mode === "raw" ? F.Deflate : mode === "gzip" ? F.Gzip : F.Zlib;
+}
