@@ -0,0 +1,443 @@
+// Hegel properties for entities, checked against a model of the HTML specification.
+//
+// Decoding: the WHATWG "character reference" states (named character reference state, numeric
+// character reference states and end state; https://html.spec.whatwg.org/multipage/parsing.html)
+// written out over the library's own tables, maps/entities.json (name → characters) and
+// maps/legacy.json (the names that may appear without a semicolon). Because the model shares the
+// data, every disagreement is algorithmic. `he` (Mathias Bynens' spec-following decoder, a
+// devDependency of entities) is a second opinion on the HTML modes.
+//
+// Encoding: exact models of encodeXML/escape/escapeUTF8/escapeAttribute/escapeText (whose output
+// is fully determined), a structural check of encodeHTML/encodeNonAsciiHTML (which characters are
+// encoded, every reference well-formed and semicolon-terminated, named when a name exists, decoding
+// to the characters it replaced), and the decode(encode(s)) round trips.
+//
+// Streaming: EntityDecoder fed one entity in random chunks must agree with the model on the number
+// of characters consumed, the code points emitted and the parse errors reported.
+
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { createRequire } from "node:module";
+import { count, fail, gs, pin, property, same, show } from "./hegel-zoo.mjs";
+
+const E = await import("../.hegel/dist/index.mjs");
+const D = await import("../.hegel/dist/decode.mjs");
+const he = createRequire(import.meta.url)("../.hegel/node_modules/he");
+
+const ENTITIES = JSON.parse(readFileSync(new URL("../maps/entities.json", import.meta.url), "utf8"));
+const LEGACY = new Set(Object.keys(JSON.parse(readFileSync(new URL("../maps/legacy.json", import.meta.url), "utf8"))));
+const NAMES = Object.keys(ENTITIES);
+const LEGACY_NAMES = [...LEGACY];
+const MAX_KEY = Math.max(...NAMES.map((k) => k.length)) + 1; // longest identifier incl. the semicolon
+const VALUE_TO_NAMES = new Map();
+for (const [k, v] of Object.entries(ENTITIES)) { if (!VALUE_TO_NAMES.has(v)) VALUE_TO_NAMES.set(v, []); VALUE_TO_NAMES.get(v).push(k); }
+
+const Known = {
+  c1Controls: true, // entities/1: encodeHTML/encodeNonAsciiHTML write U+0080–U+009F as &#128;… which HTML decodes to the windows-1252 characters
+  streamingSurrogates: true, // entities/2: EntityDecoder emits the two UTF-16 units of an astral named entity instead of the code point
+};
+
+// ---------- the spec model ----------
+
+// Numeric character reference end state: the windows-1252 remap of C1 controls.
+const C1_MAP = new Map([
+  [0x80, 0x20ac], [0x82, 0x201a], [0x83, 0x0192], [0x84, 0x201e], [0x85, 0x2026], [0x86, 0x2020], [0x87, 0x2021],
+  [0x88, 0x02c6], [0x89, 0x2030], [0x8a, 0x0160], [0x8b, 0x2039], [0x8c, 0x0152], [0x8e, 0x017d], [0x91, 0x2018],
+  [0x92, 0x2019], [0x93, 0x201c], [0x94, 0x201d], [0x95, 0x2022], [0x96, 0x2013], [0x97, 0x2014], [0x98, 0x02dc],
+  [0x99, 0x2122], [0x9a, 0x0161], [0x9b, 0x203a], [0x9c, 0x0153], [0x9e, 0x017e], [0x9f, 0x0178],
+]);
+const XML5 = [["amp", "&"], ["lt", "<"], ["gt", ">"], ["quot", '"'], ["apos", "'"]];
+
+function invalidCodePoint(cp) { return cp === 0 || (cp >= 0xd800 && cp <= 0xdfff) || cp > 0x10ffff; }
+function replaceHTML(cp) { return invalidCodePoint(cp) ? 0xfffd : C1_MAP.get(cp) ?? cp; }
+function replaceXML(cp) { return invalidCodePoint(cp) ? 0xfffd : cp; }
+function isAlnum(c) { return (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122); }
+
+// The reference starting right after an `&` at input[pos], in mode legacy | strict | attribute | xml.
+// Returns null when the `&` stays text, or { consumed (characters after the `&`), text, missing
+// (semicolon missing), validate (raw numeric value) } or { consumed: 0, nodigits } for `&#`/`&#x`
+// without digits (flushed as text; a parse error).
+function refAt(input, pos, mode) {
+  if (input[pos] === "#") {
+    let i = pos + 1;
+    const hex = input[i] === "x" || input[i] === "X";
+    if (hex) i++;
+    const digitsStart = i;
+    while (i < input.length && (hex ? /[0-9a-fA-F]/ : /[0-9]/).test(input[i])) i++;
+    if (i === digitsStart) return { consumed: 0, nodigits: hex ? 3 : 2 };
+    let code = 0;
+    for (const ch of input.slice(digitsStart, i)) code = code * (hex ? 16 : 10) + parseInt(ch, 16);
+    const semi = input[i] === ";";
+    if (semi) i++;
+    if (!semi && (mode === "strict" || mode === "xml")) return null;
+    return { consumed: i - pos, text: String.fromCodePoint(mode === "xml" ? replaceXML(code) : replaceHTML(code)), missing: !semi, validate: code };
+  }
+  if (mode === "xml") {
+    for (const [k, v] of XML5) if (input.startsWith(k + ";", pos)) return { consumed: k.length + 1, text: v };
+    return null;
+  }
+  // named: the longest identifier of the table (identifiers include the semicolon; legacy names also without)
+  for (let L = Math.min(MAX_KEY, input.length - pos); L >= 1; L--) {
+    const cand = input.substr(pos, L);
+    if (cand.endsWith(";")) {
+      const name = cand.slice(0, -1);
+      if (Object.hasOwn(ENTITIES, name)) return { consumed: L, text: ENTITIES[name] };
+    } else if (LEGACY.has(cand)) {
+      if (mode === "strict") return null;
+      if (mode === "attribute" && (input.charCodeAt(pos + L) === 61 || isAlnum(input.charCodeAt(pos + L)))) return null;
+      return { consumed: L, text: ENTITIES[cand], missing: true };
+    }
+  }
+  return null;
+}
+
+function modelDecode(input, mode) {
+  let out = "";
+  let i = 0;
+  while (i < input.length) {
+    const amp = input.indexOf("&", i);
+    if (amp < 0) { out += input.slice(i); break; }
+    out += input.slice(i, amp);
+    const r = refAt(input, amp + 1, mode);
+    if (r && r.consumed > 0) { out += r.text; i = amp + 1 + r.consumed; } else { out += "&"; i = amp + 1; }
+  }
+  return out;
+}
+
+// ---------- generators ----------
+
+const DEC_DIGITS = ["0", "00", "9", "13", "38", "60", "65", "128", "129", "141", "143", "144", "157", "159", "160", "173", "255", "256", "8364", "55295", "55296", "56320", "57343", "57344", "65533", "65534", "65535", "65536", "1114111", "1114112", "2147483648", "4294967296", "9999999999999999999", "000000000000000000000038", "99999999999999999999999999999999999999999999999999"];
+const HEX_DIGITS = ["0", "00", "26", "3c", "3C", "41", "7f", "80", "81", "8d", "9f", "a0", "ff", "d7ff", "D800", "dbff", "DC00", "dfff", "e000", "fffd", "FFFE", "ffff", "10000", "1d538", "10ffff", "110000", "7fffffff", "80000000", "ffffffff", "1ffffffff", "0000000000000000026", "ffffffffffffffffffffffffffffffffffffffff"];
+const FOLLOW = ["", "", " ", ";", "=", "x", "Z", "1", "&", "in", "-", ".", "#", "é"];
+const TEXT = ["", "a", "abc", " ", "  ", ";", "&", "&&", "#", "=", "x1", "ü", "€", "𝔸", " ", "<b>", '"', "'", "\n", "amp;", "lt", "not"];
+
+const JUNK = ["&#;", "&#x;", "&#X", "&#", "&#xg", "&#-1;", "&# 1;", "&#x 1;", "&;", "&", "&&amp;", "& amp;", "&#x26;#x26;"];
+const JUNK_NAMES = ["", ";", "1", "_", "-", "é", "ampamp;", "AMP", "Amp;", "LT", "lT;", "nbsp", "NBSP;", "ampl", "am", "a"];
+
+/** oneOf with integer weights: `weighted([3, a], [1, b])` draws from a three times in four (and shrinks towards a). */
+const weighted = (...choices) => gs.oneOf(...choices.flatMap(([w, g]) => Array(w).fill(g)));
+/** The concatenation of one string from each of gens. */
+const seq = (...gens) => gs.tuples(...gens).map((parts) => parts.join(""));
+/** value pct percent of the time, else "" (listed first: oneOf shrinks towards the absent case). */
+const maybe = (pct, value) => weighted([100 - pct, gs.just("")], [pct, gs.just(value)]);
+
+const semi = maybe(60, ";");
+const follow = gs.sampledFrom(FOLLOW);
+
+function flipCase(s, i) {
+  const c = s[i];
+  const f = c === c.toLowerCase() ? c.toUpperCase() : c.toLowerCase();
+  return s.slice(0, i) + f + s.slice(i + 1);
+}
+
+// a table name (any, or a legacy one), complete or — one time in ten each — truncated, extended or with one letter's case flipped
+const tableName = weighted([3, gs.sampledFrom(NAMES)], [2, gs.sampledFrom(LEGACY_NAMES)]);
+const shapedName = tableName.flatMap((name) =>
+  weighted(
+    [7, gs.just(name)],
+    [1, name.length > 1 ? gs.integers({ minValue: 1, maxValue: name.length - 1 }).map((k) => name.slice(0, k)) : gs.just(name)],
+    [1, gs.sampledFrom(["x", "in", "s", "1", "A", "e"]).map((x) => name + x)],
+    [1, gs.integers({ minValue: 0, maxValue: name.length - 1 }).map((i) => flipCase(name, i))],
+  ),
+);
+
+// one reference-like fragment starting with `&`
+const namedRef = seq(gs.just("&"), shapedName, semi, follow);
+const decimalRef = seq(gs.just("&#"), gs.sampledFrom(DEC_DIGITS), semi, follow);
+const hexRef = seq(gs.just("&#"), gs.sampledFrom(["x", "X"]), gs.sampledFrom(HEX_DIGITS), semi, follow);
+const junkRef = gs.sampledFrom(JUNK);
+const junkName = gs.sampledFrom(JUNK_NAMES).map((x) => "&" + x);
+// two references back to back, or a reference inside a word
+const adjacentRefs = seq(gs.sampledFrom(["", "a", "x"]), gs.just("&"), gs.sampledFrom(NAMES), maybe(50, ";"), gs.just("&"), gs.sampledFrom(LEGACY_NAMES), follow);
+// 2040–2052 digits: the length side channel
+const longNumericRef = seq(gs.just("&#"), gs.sampledFrom(["", "x"]), gs.integers({ minValue: 2040, maxValue: 2052 }).map((k) => "0".repeat(k)), gs.sampledFrom(["38", "26", "80", "0"]), semi, follow);
+const LONG_NUMERIC = /&#x?0{2040}/;
+
+const ref = weighted([20, namedRef], [10, decimalRef], [10, hexRef], [2, junkRef], [3, junkName], [3, adjacentRefs], [2, longNumericRef]);
+
+// 1–8 fragments, each plain text or a reference
+const decodeInput = gs.arrays(weighted([3, gs.sampledFrom(TEXT)], [7, ref]), { minSize: 1, maxSize: 8 }).map((parts) => parts.join(""));
+
+function showS(s) { return JSON.stringify(s); }
+
+// ---------- decoding ----------
+
+const MODES = [
+  { name: "legacy", fns: [["decodeHTML", (s) => E.decodeHTML(s)], ["decodeHTML(Legacy)", (s) => E.decodeHTML(s, E.DecodingMode.Legacy)], ["decode(HTML)", (s) => E.decode(s, E.EntityLevel.HTML)], ["decode({HTML})", (s) => E.decode(s, { level: E.EntityLevel.HTML })], ["decode({HTML,Legacy})", (s) => E.decode(s, { level: E.EntityLevel.HTML, mode: E.DecodingMode.Legacy })]], he: (s) => he.decode(s) },
+  { name: "strict", fns: [["decodeHTMLStrict", (s) => E.decodeHTMLStrict(s)], ["decodeHTML(Strict)", (s) => E.decodeHTML(s, E.DecodingMode.Strict)], ["decode({HTML,Strict})", (s) => E.decode(s, { level: E.EntityLevel.HTML, mode: E.DecodingMode.Strict })]] },
+  { name: "attribute", fns: [["decodeHTMLAttribute", (s) => E.decodeHTMLAttribute(s)], ["decodeHTML(Attribute)", (s) => E.decodeHTML(s, E.DecodingMode.Attribute)], ["decode({HTML,Attribute})", (s) => E.decode(s, { level: E.EntityLevel.HTML, mode: E.DecodingMode.Attribute })]], he: (s) => he.decode(s, { isAttributeValue: true }) },
+  { name: "xml", fns: [["decodeXML", (s) => E.decodeXML(s)], ["decodeXMLStrict", (s) => E.decodeXMLStrict(s)], ["decode", (s) => E.decode(s)], ["decode(XML)", (s) => E.decode(s, E.EntityLevel.XML)], ["decode({XML,Attribute})", (s) => E.decode(s, { level: E.EntityLevel.XML, mode: E.DecodingMode.Attribute })]] },
+];
+
+property("TestHegelDecodeLikeSpec", (tc) => {
+  const s = tc.draw(decodeInput);
+  if (LONG_NUMERIC.test(s)) count("long-numeric");
+  for (const m of MODES) {
+    const want = modelDecode(s, m.name);
+    const heGot = m.he ? m.he(s) : undefined;
+    for (const [fname, f] of m.fns) {
+      const got = f(s);
+      if (got !== want) {
+        const opinion = heGot === undefined ? "" : heGot === got ? " (he agrees with entities — model?)" : heGot === want ? " (he agrees with the model)" : ` (he says ${showS(heGot)})`;
+        return fail(`${fname}(${showS(s)}) = ${showS(got)}, spec model ${showS(want)}${opinion}`);
+      }
+    }
+    if (heGot !== undefined && heGot !== want) count(`he-differs-${m.name}`);
+  }
+  if (s.includes("&#")) count("numeric"); else if (s.includes("&")) count("named-or-junk"); else count("plain");
+  if (modelDecode(s, "legacy") !== s) count("decodes-something");
+});
+
+// ---------- encoding ----------
+
+const NAMED_VALUES = [...VALUE_TO_NAMES.keys()];
+
+/** The character of a code point in [lo, hi]. */
+const codePoints = (lo, hi) => gs.integers({ minValue: lo, maxValue: hi }).map((cp) => String.fromCodePoint(cp));
+/** The character of one of cps. */
+const codePointFrom = (cps) => gs.sampledFrom(cps).map((cp) => String.fromCodePoint(cp));
+
+// one piece of text: a character from each block the encoders treat differently, or a table value (93 of them are two code points)
+const piece = weighted(
+  [30, codePoints(0x20, 0x7e)],
+  [8, codePointFrom([0x09, 0x0a, 0x0c, 0x0d, 0x00, 0x01, 0x1f, 0x7f])],
+  [12, codePoints(0x80, 0xff)],
+  [10, codePoints(0x100, 0x2fff)],
+  [4, codePoints(0xe000, 0xffff)],
+  [4, codePointFrom([0xfffd, 0xfffe, 0xffff, 0xd7ff])],
+  [10, codePoints(0x10000, 0x10ffff)],
+  [17, gs.sampledFrom(NAMED_VALUES)],
+  [5, codePointFrom([0xa0, 0x3c, 0x26, 0x22, 0x27, 0x3e, 0x20d2, 0xfe00, 0x338, 0x2202, 0x1d538])],
+);
+// a plain run of 8–70 characters (the inline/regex scan switch)
+const longRun = gs.tuples(gs.sampledFrom(["a", "z", " ", "~", "0"]), gs.integers({ minValue: 8, maxValue: 70 })).map(([c, k]) => c.repeat(k));
+const LONG_RUN = /([az ~0])\1{7}/;
+const loneSurrogate = gs.sampledFrom([0xd800, 0xdbff, 0xdc00, 0xdfff]).map((u) => String.fromCharCode(u));
+/** s as it is or, pct percent of the time, with a draw from `insert` spliced in at a random position (a dependent draw: the position ranges over s). */
+const sometimesWith = (pct, insert) => (s) =>
+  weighted([100 - pct, gs.just(s)], [pct, gs.tuples(insert, gs.integers({ minValue: 0, maxValue: s.length })).map(([x, at]) => s.slice(0, at) + x + s.slice(at))]);
+// a random string of up to 24 pieces, sometimes with a long plain run, sometimes with a lone surrogate
+const encodeInput = gs.arrays(piece, { maxSize: 24 }).map((ps) => ps.join("")).flatMap(sometimesWith(25, longRun)).flatMap(sometimesWith(10, loneSurrogate));
+const utf8Level = gs.sampledFrom([E.EntityLevel.XML, E.EntityLevel.HTML]);
+
+function hasLoneSurrogate(s) { for (const ch of s) if (ch.length === 1 && ch.charCodeAt(0) >= 0xd800 && ch.charCodeAt(0) <= 0xdfff) return true; return false; }
+function isAscii(s) { for (let i = 0; i < s.length; i++) if (s.charCodeAt(i) >= 0x80) return false; return true; }
+
+// exact models
