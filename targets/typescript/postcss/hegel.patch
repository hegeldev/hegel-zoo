index 0000000..d3a59f2
--- /dev/null
+++ b/hegel/gen.mjs
@@ -0,0 +1,345 @@
+// Hegel zoo: the CSS generator behind postcss's properties, and the damage and node-API
+// operations they apply, all as generator values built from Hegel's combinators.
+//
+// A stylesheet is drawn as data - a body is a list of statements, each a record carrying its
+// text and its semicolon rule, with blocks nesting bodies down to depth 4 - and rendered by pure
+// functions into the CSS text, so that the last statement of a block can drop its `;` the way a
+// hand-written sheet does. The round-trip junk, the node-API operations and the nodes they insert
+// are records too; the test applies them with every index taken modulo the live size.
+
+import { gs } from "./hegel-zoo.mjs";
+
+// ---------------------------------------------------------------- generator helpers
+
+const ints = (lo, hi) => gs.integers({ minValue: lo, maxValue: hi });
+
+/** oneOf with weights: `weighted([45, a], [55, b])` draws a 45 times in 100; shrinks towards the first choice. */
+function weighted(...choices) {
+  const total = choices.reduce((sum, [w]) => sum + w, 0);
+  return ints(0, total - 1).flatMap((r) => {
+    for (const [w, g] of choices) {
+      if (r < w) return g;
+      r -= w;
+    }
+    throw new Error("unreachable");
+  });
+}
+
+/** True pct percent of the time; shrinks to false. */
+const chance = (pct) => ints(0, 99).map((r) => r >= 100 - pct);
+/** A string (or a generator of one) as a generator. */
+const lift = (x) => (typeof x === "string" ? gs.just(x) : x);
+/** A draw from g pct percent of the time, else undefined (listed first: shrinks to absent). */
+const maybe = (pct, g) => weighted([100 - pct, gs.just(undefined)], [pct, g]);
+/** A draw from g pct percent of the time, else "" (shrinks to the empty string). */
+const maybeText = (pct, g) => weighted([100 - pct, gs.just("")], [pct, lift(g)]);
+/** The parts (strings or generators of strings) drawn and concatenated. */
+const seq = (...parts) => gs.tuples(...parts.map(lift)).map((ss) => ss.join(""));
+/** lo-hi draws of g concatenated. */
+const many = (g, lo, hi) => gs.arrays(g, { minSize: lo, maxSize: hi }).map((ss) => ss.join(""));
+
+// ---------------------------------------------------------------- tokens
+
+const WS = [" ", " ", " ", "  ", "\n", "\n", "\n  ", "\t", "\r\n", "\f", " \n\t ", "\n\n"];
+/** Some whitespace (a repeated entry weighs more). */
+const ws = gs.sampledFrom(WS);
+/** Optional whitespace: none 60% of the time. */
+const ows = maybeText(40, ws);
+
+const IDENTS = ["a", "b", "div", "span", "color", "margin-top", "background", "width", "z-index", "font-family", "content", "filter", "grid-template-areas", "x1", "-webkit-flex", "--custom-prop", "--x", "\u00fc", "\\31 23", "e\\:x", "A", "Bc", "hyphen-ated-long-name"];
+const ident = gs.sampledFrom(IDENTS);
+
+const STRINGS = ['"a"', "'b'", '""', "''", '"a;b"', '"{"', "'}'", '"\\""', "'\\''", '"a\\\nb"', '"( "', '")"', '"/*"', '"*/"', '"\\61"', '"@x"', '":"'];
+const str = gs.sampledFrom(STRINGS);
+
+const COMMENT_BODIES = ["c", " c ", "", " ", "\n", "multi\nline", "!bang", " * ", "a{b:c}", ";", '"', "/", "**", "*", " x\r\n y "];
+const comment = gs.sampledFrom(COMMENT_BODIES).map((body) => `/*${body}*/`);
+
+// ---------------------------------------------------------------- selectors
+
+// a compound selector, the bare ident first
+const simple = gs.oneOf(
+  ident,
+  seq(".", ident),
+  seq("#", ident),
+  gs.just("*"),
+  seq(ident, ":hover"),
+  seq(ident, "::before"),
+  seq("[data-x=", str, "]"),
+  seq("[", ident, "]"),
+  seq(":not(", ident, ",", ows, ".", ident, ")"),
+  seq(":is([x=", str, "])"),
+  seq(ident, ":nth-child(2n+1)"),
+  gs.just("&"),
+  gs.just("&:hover"),
+  seq("& ", ident),
+  seq("> ", ident),
+  seq(":has(> ", ident, ")"),
+);
+const COMBINATORS = [" ", ">", " > ", "+", " ~ ", ",", ", ", ",\n", ""];
+
+/**
+ * 1-4 compounds joined by combinators, then `tail`. A statement that starts with a `--` word and
+ * contains a colon is a custom property to postcss (README), so such a selector gets a `.` in front.
+ */
+const selectorWith = (tail) => seq(simple, many(seq(gs.sampledFrom(COMBINATORS), simple), 0, 3), tail).map((s) => (s.startsWith("--") ? "." + s : s));
+/** A selector, one time in ten with a comment before its last compound. */
+export const selector = selectorWith(maybeText(10, seq(ows, comment, ows, simple)));
+/** A selector that keeps its meaning written into a stylesheet through the API: no comment. */
+export const plainSelector = selectorWith("");
+
+// ---------------------------------------------------------------- values
+
+const WORDS = ["0", "1px", "-2.5em", "1e3", "+.5", "#fff", "#00ff0080", "10%", "auto", "none", "inherit", "1/2", "a-b", "U+26", "\\;", "\\{", "\\}", "\u20ac", "\u{1f3a8}", "a\\\nb"];
+/** A value word: an ident one time in 21, else one of `pool`. */
+const wordFrom = (pool) => weighted([1, ident], [20, gs.sampledFrom(pool)]);
+export const word = wordFrom(WORDS);
+/** No `;`, `{`, `}` or comment: text the API can write into a stylesheet and read back unchanged. */
+const isPlain = (s) => !/[;{}]|\/\*/.test(s);
+const plainWord = wordFrom(WORDS.filter(isPlain));
+
+const FN_NAMES = ["calc", "rgb", "var", "linear-gradient", "attr", "counter", "min", "env", "fn"];
+const URLS = ["url(a.png)", 'url("a b.png")', "url('x')", "url( x )", "url(a\\)b)", "url()", "url(data:image/png;base64,AAAA)", "url(x{y})", "url(a;b)"];
+const ARG_SEPS = [",", ", ", " ", " + ", " , "];
+
+/** A function call of 0-3 arguments (words, or 30% nested calls while `depth` allows), or one time in ten a url(). */
+function fnWith(word, urls, depth) {
+  const arg = depth > 0 ? weighted([70, word], [30, fnWith(word, urls, depth - 1)]) : word;
+  const call = gs
+    .record({ name: gs.sampledFrom(FN_NAMES), open: ows, args: gs.arrays(arg, { maxSize: 3 }), sep: gs.sampledFrom(ARG_SEPS), close: ows })
+    .map(({ name, open, args, sep, close }) => `${name}(${open}${args.join(sep)}${close})`);
+  return weighted([90, call], [10, gs.sampledFrom(urls)]);
+}
+export const fn = fnWith(word, URLS, 1);
+const plainFn = fnWith(plainWord, URLS.filter(isPlain), 1);
+
+const SPECIAL_VALUES = ["progid:DXImageTransform.Microsoft.gradient(startColorstr='#80000000', endColorstr='#80000000')", "alpha(opacity=50)", "expression(a?b:c)", "1px/2px", "a , b", "a ,b"];
+const VALUE_SEPS = [" ", " ", ",", ", ", "  ", "\n  ", "/", " /*c*/ "];
+
+/** 1-4 `part`s joined by one separator from `seps`, or one time in twenty a legacy special value. */
+const valueWith = (part, seps) =>
+  weighted(
+    [95, gs.tuples(gs.arrays(part, { minSize: 1, maxSize: 4 }), gs.sampledFrom(seps)).map(([parts, sep]) => parts.join(sep))],
+    [5, gs.sampledFrom(SPECIAL_VALUES)],
+  );
+const valuePart = weighted([50, word], [20, fn], [10, str], [10, comment], [10, word.map((w) => `[${w}]`)]);
+/** A declaration value. */
+export const value = valueWith(valuePart, VALUE_SEPS);
+const plainPart = weighted([50, plainWord], [20, plainFn], [10, str], [10, plainWord.map((w) => `[${w}]`)]);
+/** A value the API can write into a stylesheet and read back unchanged (no comments, `;`, `{`, `}` outside strings), trimmed and never empty. */
+export const plainValue = valueWith(plainPart, VALUE_SEPS.filter(isPlain)).map((v) => v.trim() || "0");
+
+// ---------------------------------------------------------------- declarations
+
+const IMPORTANTS = ["!important", " !important", "!IMPORTANT", " ! important", "  !important", "!important ", "/*c*/!important", " !important/*c*/", "\n!important"];
+const important = gs.sampledFrom(IMPORTANTS);
+
+const HACKS = ["*zoom", "_height", "*--x", "--"];
+/** A property name, one time in twelve behind a `*`/`_` hack or a `--` prefix. */
+const prop = weighted([92, ident], [8, gs.tuples(gs.sampledFrom(HACKS), ident).map(([hack, id]) => hack + id.replace(/^--/, ""))]);
+
+const CUSTOM_VALUES = ["", " ", "{ a: b }", "{a:b;c:d}", " [1,2]", "red /* c */", "a{b}", "x", "10px !important", "\n  1\n  2\n", "{}", " {\n  a: b;\n}"];
+
+// the rest of a declaration after its property: a custom property (`--x`) keeps whatever raw
+// value it is given, so it takes the `{}` and blank values and no `!important`
+const declRest = (custom) =>
+  gs.record({
+    beforeColon: ows,
+    comment: maybeText(8, comment),
+    afterColon: custom ? gs.sampledFrom(["", " ", "  ", "\n"]) : ows,
+    value: custom ? weighted([1, value], [12, gs.sampledFrom(CUSTOM_VALUES)]) : value,
+    important: custom ? gs.just("") : maybeText(15, important),
+    trailing: custom ? gs.just("") : maybeText(20, ows),
+  });
+const customRest = declRest(true);
+const plainRest = declRest(false);
+const renderDecl = (prop, { beforeColon, comment, afterColon, value, important, trailing }) => prop + beforeColon + comment + ":" + afterColon + value + important + trailing;
+
+/** A declaration `prop: value` with its whitespace, comment and `!important` (custom properties: see declRest). */
+export const declaration = prop.flatMap((prop) => (prop.startsWith("--") ? customRest : plainRest).map((rest) => renderDecl(prop, rest)));
+
+// ---------------------------------------------------------------- statements and bodies
+//
+// A statement is {text, semi, dropIfLast}: `text` followed by `semi` (";" for a declaration or a
+// block-less at-rule, "" otherwise) unless it is the last statement of its body and `dropIfLast`.
+
+const AT_NAMES = ["media", "import", "charset", "font-face", "page", "supports", "layer", "container", "keyframes", "x", "-webkit-keyframes", "namespace", "apply", "nest"];
+const BLOCK_AT_NAMES = ["media", "font-face", "page", "supports", "container", "keyframes", "-webkit-keyframes", "nest"];
+const AT_PARAMS = ["(min-width: 1px)", "(min-width:1px) and (max-width: 2px)", "screen", "screen, print", '"x.css"', "url(x.css)", 'url("x.css") screen', "(display: grid) and (not (display: inline-grid))", "a, b", "name (x)", "k", "from", "50%", ":first", "(a{b})", "( x )", "x /*c*/ y", '"a" /*c*/', ""];
+
+// the gap between an at-rule's name and its params: whitespace, or one time in ~13 a bare space -
+// or nothing when the params start with `(` or `"`
+const afterNameTight = weighted([85, ws], [15, gs.sampledFrom([" ", ""])]);
+const afterNameLoose = weighted([85, ws], [15, gs.just(" ")]);
+
+/** An at-rule at `depth`: a block (85% for the block-taking names, 30% otherwise) holding a nested body, or a statement ending in `;`. */
+function atRuleAt(depth) {
+  const body = bodyAt(depth + 1);
+  const blockOrNot = (pct) => weighted([100 - pct, gs.just(null)], [pct, body]);
+  const blockUsual = blockOrNot(85);
+  const blockRare = blockOrNot(30);
+  return gs.record({ name: gs.sampledFrom(AT_NAMES), params: gs.sampledFrom(AT_PARAMS) }).flatMap(({ name, params }) =>
+    gs
+      .record({
+        afterName: params === "" ? ows : /^[("]/.test(params) ? afterNameTight : afterNameLoose,
+        afterParams: ows,
+        body: BLOCK_AT_NAMES.includes(name) ? blockUsual : blockRare,
+        dropIfLast: chance(10),
+      })
+      .map(({ afterName, afterParams, body, dropIfLast }) => {
+        const head = "@" + name + afterName + params + afterParams;
+        return body === null ? { text: head, semi: ";", dropIfLast } : { text: head + "{" + body + "}" };
+      }),
+  );
+}
+
+const plainStatement = (text) => ({ text });
+const commentStatement = comment.map(plainStatement);
+// a stray `;`, `{}` or `{ }`
+const emptyStatement = weighted([4, gs.sampledFrom([";", ";;", " ; ", "{}"])], [1, seq(ows, "{ }")]).map(plainStatement);
+// a declaration drops its `;` 40% of the time when last
+const declStatement = gs.record({ text: declaration, semi: gs.just(";"), dropIfLast: chance(40) });
+
+/** One statement at `depth`: declarations lead inside blocks and rules at the root; from depth 3 on no more blocks. */
+function statementAt(depth) {
+  if (depth >= 3) return weighted([80, declStatement], [13, commentStatement], [7, emptyStatement]);
+  // a rule, one time in twelve followed by a stray `;`
+  const ruleStatement = seq(selector, ows, "{", bodyAt(depth + 1), "}", maybeText(8, seq(ows, ";"))).map(plainStatement);
+  const atRuleStatement = atRuleAt(depth);
+  return depth === 0
+    ? weighted([50, ruleStatement], [7, declStatement], [13, commentStatement], [5, emptyStatement], [25, atRuleStatement])
+    : weighted([55, declStatement], [15, ruleStatement], [13, commentStatement], [7, emptyStatement], [10, atRuleStatement]);
+}
+
+/** The text of a body: leading whitespace, each statement with its terminator and the whitespace after it (80% of the time; optional after the last). */
+function renderBody({ lead, items, tail }) {
+  return (
+    lead +
+    items
+      .map(([st, gap], i) => {
+        const last = i === items.length - 1;
+        return st.text + (last && st.dropIfLast ? "" : st.semi ?? "") + (last ? tail : gap);
+      })
+      .join("")
+  );
+}
+
+/** The contents of a block at `depth` (0: the root, up to 6 statements; else up to 5), rendered. */
+function bodyAt(depth) {
+  return gs
+    .record({
+      lead: ows,
+      items: gs.arrays(gs.tuples(statementAt(depth), maybeText(80, ws)), { maxSize: depth === 0 ? 6 : 5 }),
+      tail: ows,
+    })
+    .map(renderBody);
+}
+
+/** A stylesheet: a root body, one time in twenty behind a BOM. */
+export const css = gs.tuples(chance(5), bodyAt(0)).map(([bom, body]) => (bom ? "\ufeff" : "") + body);
+
+// ---------------------------------------------------------------- junk
+
+const EMPTY_JUNK = ["}", "{", '"', "a", "@", "/*", "a:", ":", "a{", "a{b", "a{b:", "a{b:c", ";"];
+const JUNK_CHARS = ["{", "}", '"', "'", "(", ")", "/*", "*/", ";", ":", "@", "\\", "[", "]", " ", "\n", "a", "!"];
+/** An index into a string or a node list, taken modulo the live length when applied. */
+const at = ints(0, 999);
+const junkChar = gs.sampledFrom(JUNK_CHARS);
+
+/** One character-level damage: {edit: {kind, at, ch}, empty}; `empty` stands in for an empty stylesheet. */
+export const junk = gs.record({
+  edit: gs.oneOf(
+    gs.record({ kind: gs.just("delete"), at }),
+    gs.record({ kind: gs.just("truncate"), at }),
+    gs.record({ kind: gs.just("insert"), at, ch: junkChar }),
+    gs.record({ kind: gs.just("replace"), at, ch: junkChar }),
+  ),
+  empty: gs.sampledFrom(EMPTY_JUNK),
+});
+
+/** `css` with the damage applied (an empty stylesheet becomes the junk fragment). */
+export function applyJunk(css, { edit, empty }) {
+  if (!css.length) return empty;
+  const i = edit.at % css.length;
+  if (edit.kind === "delete") return css.slice(0, i) + css.slice(i + 1);
+  if (edit.kind === "truncate") return css.slice(0, i);
+  if (edit.kind === "insert") return css.slice(0, i) + edit.ch + css.slice(i);
+  return css.slice(0, i) + edit.ch + css.slice(i + 1);
+}
+
+/** The round-trip case: a stylesheet, one time in four with junk to apply. */
+export const roundTripCase = gs.record({ css, junk: maybe(25, junk) });
+
+// ---------------------------------------------------------------- nodes and operations for the API
+
+// a property name the API can set: no escapes
+const plainProp = ident.map((id) => id.replace(/\\.*/, "x"));
+
+/** A node to insert, as data {type, ...fields}: the test builds the postcss node from it. */
+export const nodeSpec = weighted(
+  [40, gs.record({ type: gs.just("decl"), prop: plainProp, value: plainValue, important: chance(15) })],
+  [20, gs.record({ type: gs.just("rule"), selector: plainSelector })],
+  [10, gs.record({ type: gs.just("rule"), selector: plainSelector, nodes: gs.just([{ type: "decl", prop: "a", value: "b" }]) })],
+  [10, gs.record({ type: gs.just("atrule"), name: gs.sampledFrom(["media", "x", "import"]), params: gs.sampledFrom(["(a)", "x", '"y"', "", "screen"]) })],
+  [10, gs.just({ type: "atrule", name: "media", params: "(a)", nodes: [] })],
+  [10, gs.record({ type: gs.just("comment"), text: gs.sampledFrom(["c", "hi there", "", "x\ny"]) })],
+);
+
+const FIXED_SNIPPETS = ["", "/* c */", "a: b; c: d", "a{b:c}d{e:f}", "@media (x) { a { b: c } }", '@import "x";'];
+/** A CSS string for the API's string-taking methods. */
+export const cssSnippet = weighted(
+  [6, gs.sampledFrom(FIXED_SNIPPETS)],
+  [1, seq(plainProp, ": ", plainValue)],
+  [1, seq(plainProp, ": ", plainValue, ";")],
+  [1, seq(plainSelector, " { a: b }")],
+  [1, seq(plainSelector, "{}")],
+);
+
+const nodeOrSnippet = weighted([50, nodeSpec], [50, cssSnippet]);
+/** `first` alone 70% of the time, else `first, second`. */
+const oneOrTwo = (g) => gs.tuples(g, maybe(30, g)).map(([a, b]) => (b === undefined ? [a] : [a, b]));
+/** A run of yes/no answers, read modulo its length while walking children. */
+const mask = (pct) => gs.arrays(chance(pct), { minSize: 1, maxSize: 6 });
+const op = (kind, fields = {}) => gs.record({ kind: gs.just(kind), ...fields });
+
+/**
+ * One node-API operation as data. `at` picks the target among the live nodes (or among those of
+ * the type the operation needs), `container` among the root and the live containers, `from` among
+ * the other tree's nodes, each modulo the count; `removeAll` is weighted down to its old 30% gate.
+ */
+export const operation = weighted(
+  [10, op("remove", { at })],
+  [10, op("cleanRaws", { at, keepBetween: chance(50) })],
+  [10, op("setValue", { at, value: plainValue })],
+  [10, op("setProp", { at, name: gs.sampledFrom(["color", "x", "margin", "a-b", "z"]) })],
+  [10, op("setImportant", { at })],
+  [10, op("setSelector", { at, selector: weighted([50, plainSelector], [50, gs.sampledFrom(["a", ".b", "#c", "d:hover", "[x]", ":not(a, .b)"]).map((s) => [s, "b"])]) })],
+  [10, op("setParams", { at, params: gs.sampledFrom(["(a)", "x", "", '"y"', "screen and (x)", "(a{b})"]) })],
+  [10, op("setName", { at, name: gs.sampledFrom(["media", "x", "supports", "import"]) })],
+  [10, op("setText", { at, text: gs.sampledFrom(["c", "", "x y", "a\nb", "*", "/"]) })],
+  [10, op("assign", { at, value: plainValue })],
+  [10, op("cloneBefore", { at })],
+  [10, op("cloneAfter", { at, value: maybe(50, plainValue) })],
+  [10, op("append", { container: at, node: nodeSpec })],
+  [10, op("prepend", { container: at, node: nodeSpec })],
+  [10, op("appendString", { container: at, snippet: cssSnippet })],
+  [10, op("insertBefore", { at, what: nodeOrSnippet })],
+  [10, op("insertAfter", { at, what: nodeOrSnippet })],
+  [10, op("replaceWith", { at, nodes: oneOrTwo(nodeSpec) })],
+  [3, op("removeAll", { container: at })],
+  [10, op("move", { container: at, from: at, at })],
+  [10, op("each-remove", { container: at, drops: mask(30) })],
+  [10, op("walk-mutate", { clones: mask(30), drops: mask(50) })],
+);
+
+/** The mutation case: a stylesheet, a second one to move nodes to and from, and 1-8 operations. */
+export const mutationCase = gs.record({ css, otherCss: css, ops: gs.arrays(operation, { minSize: 1, maxSize: 8 }) });
+
+/** The source-position case: a stylesheet, the node to probe with `error()` and whether to give it a word. */
+export const positionsCase = gs.record({ css, probe: at, byWord: chance(50) });
+
+// ---------------------------------------------------------------- list
+
+const LIST_PIECES = ["a\\,b", "a\\ b", "(", ")", "((a, b)", "'a", " ", ",", ", ", "  ", "\t", "\n", "a b", "url(a, b)"];
+/** 0-6 pieces for `list`: words, functions, strings and awkward fragments (unbalanced parentheses, an open quote, escaped separators). */
+export const listInput = gs.arrays(weighted([1, word], [1, fn], [1, str], [14, gs.sampledFrom(LIST_PIECES)]), { maxSize: 6 }).map((ps) => ps.join(""));
diff --git a/hegel/hegel-zoo.mjs b/hegel/hegel-zoo.mjs
