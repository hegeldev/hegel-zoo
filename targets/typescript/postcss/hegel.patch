@@ -0,0 +1,558 @@
+// Hegel properties for PostCSS's parser, stringifier and node API.
+//
+// The central guarantee (docs/syntax.md "Raw Values": a parser "should provide all information …
+// to generate byte-to-byte equal output", and the stringifier "byte-to-byte equal output if there
+// were no changes") is checked on generated CSS: `parse(css).toString() === css`, also through
+// `Processor#process`, `stringify` with a builder, `clone()`, `toJSON()`/`fromJSON()`. Then the
+// metamorphic property behind every plugin: after random node-API mutations the stringified tree
+// re-parses to the same structure and stringifies to the same text. Source positions are checked
+// against the input text, `list` against a small model, and upstream's postcss-parser-tests
+// fixtures (AST JSON and round trip) run as a fixed check.
+
+import assert from "node:assert/strict";
+import { readdirSync, readFileSync } from "node:fs";
+import { createRequire } from "node:module";
+import { collecting, chance, count, fail, n, pick, pin, property, same, show } from "./hegel-zoo.mjs";
+
+const require = createRequire(import.meta.url);
+const postcss = require("../lib/postcss.js");
+const { parse, stringify, fromJSON, list, CssSyntaxError } = postcss;
+
+const Known = {
+  customTrailingWhitespace: true, // postcss/1: a custom property that ends a block without a semicolon absorbs the block's closing whitespace into its value on re-parse, so appending one to a parsed rule changes the AST
+  colonFromComment: true, // postcss/3: Stringifier.rawColon derives the default `between` from the first declaration's raw between without dropping comments, so `b/*x:y*/:c` makes every node without its own raws come out as `d::e`
+  rootBeforeCopiesHack: true, // postcss/4: Root.normalize copies a neighbour's raws.before verbatim (Container.normalize keeps only its whitespace), so a `*`/`_` hack prefix of a root-level declaration spreads to inserted nodes or, on prepend, to the old first node
+  atRuleAtEofHasNoEnd: true, // postcss/5: a childless at-rule without params that ends the file or its block (`a{@x}`) gets no source.end (`@x foo`, `@x;` and `a{@x /*c*/}` do)
+  valueKeepsCommentSpace: true, // postcss/6: a comment at the end of a declaration value is dropped from `value` but the whitespace before it stays (`x: 1 /*c*/;` → "1 ")
+  importantLostAfterTrailingSpace: true, // postcss/7: `x: none! important ;` (no space before `!`, whitespace before `;`) is parsed as a plain declaration with the value "none! important"
+  customEndPosition: true, // postcss/2: source.end of a custom property stops at its last non-space token although its value keeps the trailing whitespace
+};
+
+// ---------- CSS generator ----------
+
+const WS = [" ", " ", " ", "  ", "\n", "\n", "\n  ", "\t", "\r\n", "\f", " \n\t ", "\n\n"];
+function ws(tc) { return pick(tc, WS); }
+function ows(tc) { return chance(tc, 60) ? "" : ws(tc); }
+
+const IDENTS = ["a", "b", "div", "span", "color", "margin-top", "background", "width", "z-index", "font-family", "content", "filter", "grid-template-areas", "x1", "-webkit-flex", "--custom-prop", "--x", "ü", "\\31 23", "e\\:x", "A", "Bc", "hyphen-ated-long-name"];
+function ident(tc) { return pick(tc, IDENTS); }
+
+const STRINGS = ['"a"', "'b'", '""', "''", '"a;b"', '"{"', "'}'", '"\\""', "'\\''", '"a\\\nb"', '"( "', '")"', '"/*"', '"*/"', '"\\61"', '"@x"', '":"'];
+function str(tc) { return pick(tc, STRINGS); }
+
+function comment(tc) {
+  const body = pick(tc, ["c", " c ", "", " ", "\n", "multi\nline", "!bang", " * ", "a{b:c}", ";", "\"", "/", "**", "*", " x\r\n y "]);
+  return "/*" + body + "*/";
+}
+
+function selector(tc) {
+  const simple = () => pick(tc, [ident(tc), "." + ident(tc), "#" + ident(tc), "*", ident(tc) + ":hover", ident(tc) + "::before", `[data-x=${str(tc)}]`, `[${ident(tc)}]`, `:not(${ident(tc)},${ows(tc)}.${ident(tc)})`, `:is([x=${str(tc)}])`, ident(tc) + ":nth-child(2n+1)", "&", "&:hover", "& " + ident(tc), "> " + ident(tc), `:has(> ${ident(tc)})`]);
+  let s = simple();
+  const k = n(tc, 0, 3);
+  for (let i = 0; i < k; i++) {
+    const comb = pick(tc, [" ", ">", " > ", "+", " ~ ", ",", ", ", ",\n", ""]);
+    s += comb + simple();
+  }
+  if (chance(tc, 10)) s += ows(tc) + comment(tc) + ows(tc) + simple();
+  if (s.startsWith("--")) s = "." + s; // a statement starting with a `--` word and containing `:` is a custom property to postcss
+  return s;
+}
+
+function word(tc) {
+  return pick(tc, [ident(tc), "0", "1px", "-2.5em", "1e3", "+.5", "#fff", "#00ff0080", "10%", "auto", "none", "inherit", "1/2", "a-b", "U+26", "\\;", "\\{", "\\}", "€", "🎨", "a\\\nb"]);
+}
+
+function fn(tc, depth) {
+  const name = pick(tc, ["calc", "rgb", "var", "url", "linear-gradient", "attr", "counter", "min", "env", "fn"]);
+  if (name === "url") {
+    return pick(tc, ["url(a.png)", 'url("a b.png")', "url('x')", "url( x )", "url(a\\)b)", "url()", "url(data:image/png;base64,AAAA)", "url(x{y})", "url(a;b)"]);
+  }
+  const argc = n(tc, 0, 3);
+  const args = [];
+  for (let i = 0; i < argc; i++) args.push(depth > 0 && chance(tc, 30) ? fn(tc, depth - 1) : word(tc));
+  return name + "(" + ows(tc) + args.join(pick(tc, [",", ", ", " ", " + ", " , "])) + ows(tc) + ")";
+}
+
+function value(tc) {
+  if (chance(tc, 5)) return pick(tc, ["progid:DXImageTransform.Microsoft.gradient(startColorstr='#80000000', endColorstr='#80000000')", "alpha(opacity=50)", "expression(a?b:c)", "1px/2px", "a , b", "a ,b"]);
+  const parts = n(tc, 1, 4);
+  const out = [];
+  for (let i = 0; i < parts; i++) {
+    const r = n(tc, 0, 9);
+    out.push(r < 5 ? word(tc) : r < 7 ? fn(tc, 1) : r < 8 ? str(tc) : r === 8 ? comment(tc) : "[" + word(tc) + "]");
+  }
+  return out.join(pick(tc, [" ", " ", ",", ", ", "  ", "\n  ", "/", " /*c*/ "]));
+}
+
+function important(tc) {
+  return pick(tc, ["!important", " !important", "!IMPORTANT", " ! important", "  !important", "!important ", "/*c*/!important", " !important/*c*/", "\n!important"]);
+}
+
+function declaration(tc, depth) {
+  const prop = chance(tc, 8) ? pick(tc, ["*zoom", "_height", "*--x", "--"]) + ident(tc).replace(/^--/, "") : ident(tc);
+  const custom = prop.startsWith("--");
+  let v;
+  if (custom) {
+    v = pick(tc, [value(tc), "", " ", "{ a: b }", "{a:b;c:d}", " [1,2]", "red /* c */", "a{b}", "x", "10px !important", "\n  1\n  2\n", "{}", " {\n  a: b;\n}"]);
+  } else {
+    v = value(tc);
+  }
+  let s = prop + ows(tc) + (chance(tc, 8) ? comment(tc) : "") + ":" + (custom ? pick(tc, ["", " ", "  ", "\n"]) : ows(tc)) + v;
+  if (!custom && chance(tc, 15)) s += important(tc);
+  if (!custom && chance(tc, 20)) s += ows(tc);
+  return s;
+}
+
+function atRuleParams(tc) {
+  return pick(tc, ["(min-width: 1px)", "(min-width:1px) and (max-width: 2px)", "screen", "screen, print", '"x.css"', "url(x.css)", "url(\"x.css\") screen", "(display: grid) and (not (display: inline-grid))", "a, b", "name (x)", "k", "from", "50%", ":first", "(a{b})", "( x )", "x /*c*/ y", "\"a\" /*c*/", ""]);
+}
+
+function block(tc, depth) {
+  return "{" + body(tc, depth + 1) + "}";
+}
+
+function atRule(tc, depth, last = true) {
+  const name = pick(tc, ["media", "import", "charset", "font-face", "page", "supports", "layer", "container", "keyframes", "x", "-webkit-keyframes", "namespace", "apply", "nest"]);
+  const params = atRuleParams(tc);
+  const afterName = params ? (chance(tc, 85) ? ws(tc) : chance(tc, 50) && /^[("]/.test(params) ? "" : " ") : ows(tc);
+  const withBlock = ["media", "font-face", "page", "supports", "container", "keyframes", "-webkit-keyframes", "nest"].includes(name) ? chance(tc, 85) : chance(tc, 30);
+  if (withBlock && depth < 3) return "@" + name + afterName + params + ows(tc) + block(tc, depth);
+  return "@" + name + afterName + params + ows(tc) + (!last || chance(tc, 90) ? ";" : ""); // only the last statement may drop its `;`
+}
+
+function rule(tc, depth) {
+  return selector(tc) + ows(tc) + block(tc, depth);
+}
+
+// the contents of a block (or the root): statements separated by whitespace, with the semicolon rules
+function body(tc, depth) {
+  const k = depth === 0 ? n(tc, 0, 6) : n(tc, 0, 5);
+  let s = ows(tc);
+  const items = [];
+  for (let i = 0; i < k; i++) {
+    const r = n(tc, 0, 99);
+    let kind;
+    if (depth === 0) kind = r < 50 ? "rule" : r < 75 ? "atrule" : r < 88 ? "comment" : r < 95 ? "decl" : "empty";
+    else kind = r < 55 ? "decl" : r < 70 ? "rule" : r < 80 ? "atrule" : r < 93 ? "comment" : "empty";
+    if (depth >= 3 && (kind === "rule" || kind === "atrule")) kind = "decl";
+    items.push(kind);
+  }
+  for (let i = 0; i < items.length; i++) {
+    const kind = items[i];
+    const last = i === items.length - 1;
+    if (kind === "rule") s += rule(tc, depth) + (chance(tc, 8) ? ows(tc) + ";" : "");
+    else if (kind === "atrule") s += atRule(tc, depth, last);
+    else if (kind === "comment") s += comment(tc);
+    else if (kind === "empty") s += pick(tc, [";", ";;", " ; ", "{}", ows(tc) + "{ }"]);
+    else {
+      const d = declaration(tc, depth);
+      // the last declaration may drop its semicolon; a custom property with `{}` value too
+      s += d + (last && chance(tc, 40) ? "" : ";");
+    }
+    s += last ? ows(tc) : (chance(tc, 80) ? ws(tc) : "");
+  }
+  return s;
+}
+
+function genCSS(tc) {
+  let css = body(tc, 0);
+  if (chance(tc, 5)) css = "﻿" + css;
+  return css;
+}
+
+// junk: a valid stylesheet with one character-level mutation
+function mutateText(tc, css) {
+  if (!css.length) return pick(tc, ["}", "{", "\"", "a", "@", "/*", "a:", ":", "a{", "a{b", "a{b:", "a{b:c", ";"]);
+  const at = n(tc, 0, css.length - 1);
+  const r = n(tc, 0, 3);
+  const ch = pick(tc, ["{", "}", "\"", "'", "(", ")", "/*", "*/", ";", ":", "@", "\\", "[", "]", " ", "\n", "a", "!"]);
+  if (r === 0) return css.slice(0, at) + css.slice(at + 1);
+  if (r === 1) return css.slice(0, at) + ch + css.slice(at);
+  if (r === 2) return css.slice(0, at) + ch + css.slice(at + 1);
+  return css.slice(0, at);
+}
+
+function showS(s) { return JSON.stringify(s); }
+
+// ---------- structure ----------
+
+function structure(node) {
+  const o = { type: node.type };
+  if (node.type === "decl") {
+    o.prop = node.prop; o.value = node.value; o.important = !!node.important;
+    // postcss/1: a last custom property may gain the block's closing whitespace on re-parse
+    if (Known.customTrailingWhitespace && node.prop.startsWith("--") && /\s$/.test(node.value) !== /\s$/.test(node.value.trimEnd())) { o.value = node.value.trimEnd(); count("known-custom-trailing-whitespace"); }
+  }
+  else if (node.type === "rule") o.selector = node.selector;
+  else if (node.type === "atrule") { o.name = node.name; o.params = node.params; }
+  else if (node.type === "comment") o.text = node.text;
+  if (node.nodes) o.nodes = node.nodes.map(structure);
+  return o;
+}
+
+function allNodes(root) { const out = []; root.walk((n2) => { out.push(n2); }); return out; }
+
+// ---------- 1. byte-exact round trip ----------
+
+property("TestHegelRoundTripExact", (tc) => {
+  let css = genCSS(tc);
+  const junk = chance(tc, 25);
+  if (junk) css = mutateText(tc, css);
+  let root;
+  try {
+    root = parse(css);
+  } catch (e) {
+    if (!junk && !css.includes("﻿")) return fail(`parse(${showS(css)}) threw ${e.name}: ${e.reason || e.message}`);
+    if (e.name !== "CssSyntaxError" || !(e instanceof CssSyntaxError)) return fail(`parse(${showS(css)}) threw a ${e.name} (${e.message.slice(0, 80)}) instead of a CssSyntaxError`);
+    if (!(e.line >= 1 && e.column >= 1)) return fail(`CssSyntaxError for ${showS(css)} without a position: ${show({ line: e.line, column: e.column })}`);
+    const lines = css.replace(/^﻿/, "").split("\n");
+    if (e.line > lines.length || e.column > lines[e.line - 1].length + 1) return fail(`CssSyntaxError for ${showS(css)} positioned at ${e.line}:${e.column}, beyond the input`);
+    if (e.input && typeof e.input.offset === "number" && (e.input.offset < 0 || e.input.offset > css.length)) return fail(`CssSyntaxError for ${showS(css)} with offset ${e.input.offset}`);
+    if (typeof e.showSourceCode() !== "string" || !e.toString().includes(e.reason)) return fail(`CssSyntaxError.toString() for ${showS(css)} lacks the reason`);
+    count("syntax-error:" + e.reason.replace(/ .*/, ""));
+    return;
+  }
+  if (junk) count("junk-parsed");
+  const out = root.toString();
+  if (out !== css) {
+    return fail(`parse(${showS(css)}).toString() = ${showS(out)}`);
+  }
+  // the same text through the other stringification paths
+  let built = "";
+  stringify(root, (part) => { built += part; });
+  if (built !== css) return fail(`stringify builder of ${showS(css)} = ${showS(built)}`);
+  if (root.clone().toString() !== css) return fail(`clone().toString() of ${showS(css)} = ${showS(root.clone().toString())}`);
+  const json = JSON.parse(JSON.stringify(root.toJSON()));
+  const revived = fromJSON(json);
+  if (revived.toString() !== css) return fail(`fromJSON(toJSON()).toString() of ${showS(css)} = ${showS(revived.toString())}`);
+  if (!same(structure(revived), structure(root))) return fail(`fromJSON(toJSON()) changed the structure of ${showS(css)}`);
+  const result = postcss().process(css, { from: undefined });
+  if (result.css !== css) return fail(`process(${showS(css)}).css = ${showS(result.css)}`);
+  if (result.root.toString() !== css) return fail(`process(${showS(css)}).root.toString() = ${showS(result.root.toString())}`);
+  // the structure is stable under re-parsing (trivially, since the text is)
+  if (root.nodes.length === 0) count("empty"); else count(root.nodes.length > 3 ? "4+ statements" : "1-3 statements");
+  const depth = (node, d) => (node.nodes ? Math.max(d, ...node.nodes.map((c) => depth(c, d + 1))) : d);
+  count("depth-" + depth(root, 0));
+});
+
+// ---------- 2. mutate, stringify, re-parse ----------
+
+function newNode(tc) {
+  const r = n(tc, 0, 9);
+  if (r < 4) return postcss.decl({ prop: ident(tc).replace(/\\.*/, "x"), value: plainValue(tc), important: chance(tc, 15) });
+  if (r < 6) return postcss.rule({ selector: plainSelector(tc) });
+  if (r < 7) return postcss.rule({ selector: plainSelector(tc), nodes: [postcss.decl({ prop: "a", value: "b" })] });
+  if (r < 8) return postcss.atRule({ name: pick(tc, ["media", "x", "import"]), params: pick(tc, ["(a)", "x", '"y"', "", "screen"]) });
+  if (r < 9) return postcss.atRule({ name: "media", params: "(a)", nodes: [] });
+  return postcss.comment({ text: pick(tc, ["c", "hi there", "", "x\ny"]) });
+}
+
+// remove /* */ comments outside quoted strings
+function stripComments(str) {
+  let out = "", quote = null;
+  for (let i = 0; i < str.length; i++) {
+    const ch = str[i];
+    if (quote) { out += ch; if (ch === "\\") { out += str[++i] ?? ""; } else if (ch === quote) quote = null; continue; }
+    if (ch === "\"" || ch === "'") { quote = ch; out += ch; continue; }
+    if (ch === "\\") { out += ch + (str[++i] ?? ""); continue; }
+    if (ch === "/" && str[i + 1] === "*") { const j = str.indexOf("*/", i + 2); i = j < 0 ? str.length : j + 1; continue; }
+    out += ch;
+  }
+  return out;
