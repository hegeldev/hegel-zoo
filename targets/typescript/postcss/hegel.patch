+    else if (ch === ")") { if (depth > 0) depth--; }
+    else if (depth === 0 && seps.includes(ch)) { const v = cur.trim(); if (keepEmpty || v !== "") out.push(v); cur = ""; continue; }
+    cur += ch;
+  }
+  const v = cur.trim(); if (keepEmpty || v !== "") out.push(v);
+  return out;
