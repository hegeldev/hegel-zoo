+    if (r.end.line !== q0.line || r.end.column !== q0.col + 1) return fail(`rangeBy end of ${node.type} in ${showS(css)} = ${r.end.line}:${r.end.column} (exclusive), last character at ${q0.line}:${q0.col}`);
+    const inside = node.positionInside(Math.min(3, e - s));
+    if (inside.offset !== s + Math.min(3, e - s)) return fail(`positionInside(3) of ${node.type} in ${showS(css)} = ${show(inside)}`);
+    const q = input.fromOffset(inside.offset);
+    if (q.line !== inside.line || q.col !== inside.column) return fail(`positionInside of ${node.type} in ${showS(css)}: ${show(inside)} vs ${show(q)}`);
+  });
+  // error positions: node.error() points into the node
+  const nodes = allNodes(root);
+  if (nodes.length) {
+    const node = nodes[probe % nodes.length];
+    const err = node.error("x", byWord ? { word: node.type === "decl" ? node.prop : node.type === "rule" ? node.selector.slice(0, 1) : "" } : {});
+    if (!(err instanceof CssSyntaxError) || err.line !== node.source.start.line) count("error-position-differs"); else count("error-position-ok");
+  }
+  count(css.includes(BOM) ? "bom" : "no-bom");
+});
+
+// ---------- 4. list ----------
+
+function modelSplit(s, seps, keepEmpty) {
+  const out = [];
+  let cur = "", depth = 0, quote = null, escape = false;
+  for (const ch of s) {
+    if (escape) { escape = false; cur += ch; continue; }
+    if (ch === "\\") { escape = true; cur += ch; continue; }
+    if (quote) { if (ch === quote) quote = null; cur += ch; continue; }
+    if (ch === '"' || ch === "'") { quote = ch; cur += ch; continue; }
+    if (ch === "(") depth++;
+    else if (ch === ")") { if (depth > 0) depth--; }
+    else if (depth === 0 && seps.includes(ch)) { const v = cur.trim(); if (keepEmpty || v !== "") out.push(v); cur = ""; continue; }
+    cur += ch;
+  }
+  const v = cur.trim(); if (keepEmpty || v !== "") out.push(v);
+  return out;
+}
+
+property("TestHegelListSplit", (tc) => {
+  const s = tc.draw(listInput);
+  const sp = list.space(s), co = list.comma(s);
+  if (!same(sp, modelSplit(s, [" ", "\n", "\t"], false))) return fail(`list.space(${showS(s)}) = ${show(sp)}, model ${show(modelSplit(s, [" ", "\n", "\t"], false))}`);
+  if (!same(co, modelSplit(s, [","], true))) return fail(`list.comma(${showS(s)}) = ${show(co)}, model ${show(modelSplit(s, [","], true))}`);
+  if (!same(list.split(s, ["/"], false), modelSplit(s, ["/"], false))) return fail(`list.split(${showS(s)}, "/")`);
+  if (s.includes("(")) count("parens"); if (/["']/.test(s)) count("quotes");
+});
