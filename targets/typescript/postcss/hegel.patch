+pin("TestHegelParserTestsFixtures", () => { // a fixed check, not a bug pin
+  const { eachTest, jsonify } = require("../.hegel/node_modules/postcss-parser-tests/index.js");
+  let seen = 0;
+  eachTest((name, css, json) => {
+    seen += 1;
+    const root = parse(css, { from: name });
+    assert.equal(root.toString(), css, `${name} round trip`);
+    assert.deepEqual(jsonify(root), json, `${name} AST`);
+  });
+  assert.ok(seen > 20, `fixtures: ${seen}`);
+});
+
+// ---------- pins ----------
+
+pin("TestHegelPinAppendedCustomPropertyStaysItself", () => {
+  // postcss/1: appending a declaration to a rule whose last declaration had no semicolon (raws.semicolon
+  // false) writes the new one without a semicolon too — fine for `y: 1`, but a custom property then
+  // absorbs the block's closing whitespace when the output is parsed again: `--x: 1\n}` has the value
+  // "1\n". The stringifier already forces a semicolon after a custom property that has following
+  // siblings (pushBody) for the same reason; the last one before a non-empty `after` needs it too.
+  const root = parse("a {\n  color: red\n}");
+  root.first.append({ prop: "--x", value: "1" });
+  const out = root.toString();
+  const again = parse(out);
+  assert.equal(again.first.nodes[1].prop, "--x");
+  assert.equal(again.first.nodes[1].value, "1", `re-parsed value of the appended custom property in ${JSON.stringify(out)}`);
+});
+
+pin("TestHegelPinCustomPropertyEndCoversValue", () => {
+  // postcss/2: for `--x: 1 /*c*/ \n` the value is "1  \n" (the parser keeps a custom property's trailing
+  // whitespace) but source.end is the end of the comment, because decl() takes the position of the
+  // last token that has one and space tokens have none: the node's own value extends past its range.
+  const root = parse("a{--x: 1 /*c*/ \n}");
+  const decl = root.first.first;
+  const text = root.source.input.css;
+  const slice = text.slice(decl.source.start.offset, decl.source.end.offset);
+  const raw = decl.raws.value ? decl.raws.value.raw : decl.value;
+  assert.ok(slice.endsWith(raw), `range ${JSON.stringify(slice)} should end with the value ${JSON.stringify(raw)}`);
+});
+
+pin("TestHegelPinDetectedColonIsAColon", () => {
+  // postcss/3: a node without its own raws.between (new, or after cleanRaws) gets the `colon` raw
+  // detected from the first declaration that has one: rawColon keeps everything that is whitespace or
+  // `:` in that raw, including the characters of a comment, so `b/*x:y*/:c` yields `::` and the
+  // appended declaration is written as `d::e`, which postcss itself refuses to parse.
+  const root = parse("a{b/*x:y*/:c}");
+  root.first.append({ prop: "d", value: "e" });
+  const out = root.toString();
+  let again;
+  try { again = parse(out); } catch (e) { assert.fail(`output ${JSON.stringify(out)} does not parse: ${e.reason}`); }
+  assert.equal(again.first.last.value, "e", `value of the appended declaration in ${JSON.stringify(out)}`);
+});
+
+pin("TestHegelPinRootPrependKeepsTheOldFirstNodePlain", () => {
+  // postcss/4: Root.normalize hands the old first node the second node's raws.before as it is, where
+  // Container.normalize keeps only the whitespace of the sample's before. With a `_`/`*` hack
+  // declaration in second place (style-attribute parsing: `parse("color: red; _zoom: 1")`), the plain
+  // `color: red` comes out as `_color: red` and is ignored by browsers; append/insertAfter next to a
+  // hack declaration likewise hands the hack prefix to the new node (`*e: f`).
+  const root = parse("color: red; _zoom: 1");
+  root.prepend({ prop: "e", value: "f" });
+  const out = root.toString();
+  const again = parse(out);
+  assert.equal(again.nodes[1].prop, "color");
+  assert.ok(!/[*_]/.test(again.nodes[1].raws.before), `the old first declaration gained a hack prefix in ${JSON.stringify(out)}`);
+});
+
+pin("TestHegelPinAtRuleAtEndOfFileHasAnEnd", () => {
+  // postcss/5: `@x foo` and `@x;` at the end of the input get source.end; `@x` without params does not,
+  // although its extent is known (the parser only records an end at `;`, `{`, `}` or the last params token).
+  const node = parse("@charset").first;
+  assert.ok(node.source.end, "source.end of the at-rule is missing");
+  assert.equal(node.source.end.offset, 8);
+});
+
+pin("TestHegelPinValueCleanedOfCommentIsTrimmed", () => {
+  // postcss/6: `value` is documented as the value "cleaned of comments"; the comment goes, the space
+  // before it stays, so `x: 1 /*c*/;` has the value "1 " where `x: 1 ;` has "1".
+  const withComment = parse("a{x: 1 /*c*/;}").first.first;
+  const withSpace = parse("a{x: 1 ;}").first.first;
+  assert.equal(withSpace.value, "1");
+  assert.equal(withComment.value, "1", "value of `x: 1 /*c*/;`");
+});
+
+pin("TestHegelPinImportantSurvivesTrailingWhitespace", () => {
+  // postcss/7: `none! important` is recognised when the declaration ends the block, but with whitespace
+  // between `important` and the `;` the parser's backwards scan (lib/parser.js decl(): `cache.pop()`
+  // inside a loop indexed by `j > 0`) stops one token short of the `!`: the declaration is not
+  // important and its value is "none! important".
+  const withSemicolon = parse("a{x: none! important\t;}").first.first;
+  const withoutSemicolon = parse("a{x: none! important\t}").first.first;
+  assert.equal(withoutSemicolon.important, true);
+  assert.equal(withoutSemicolon.value, "none");
+  assert.equal(withSemicolon.important, true, `important of \`x: none! important\t;\` (value ${JSON.stringify(withSemicolon.value)})`);
+  assert.equal(withSemicolon.value, "none");
+});
