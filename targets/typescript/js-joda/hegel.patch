+// Hegel zoo: property-based tests for @js-joda/core against java.time itself.
+//
+// js-joda is a port of ThreeTen-Backport, the reference implementation of JSR-310, and its
+// AGENTS.md says "method names and semantics intentionally match Java's JSR-310 API". So the
+// oracle is the JDK: hegel/Oracle.java answers the same operation on the same ISO strings, and
+// every property compares js-joda's result (or the name of the exception it throws) with Java's.
+// Values travel as the ISO toString() forms both sides share; the strings themselves are built
+// from numbers by Java's rules (hegel-gen.mjs), so a divergent toString() shows up as a mismatch
+// rather than a bad input. Each property draws one case record and runs its checks on it.
+// `node hegel/build.mjs` bundles src/ to .hegel/dist/js-joda.mjs (see target.toml [run]).
+import assert from "node:assert/strict";
+import { count, fail, gs, pin, propertyAsync } from "./hegel-zoo.mjs";
+import { java } from "./oracle.mjs";
+import * as J from "../.hegel/dist/js-joda.mjs";
+import {
+  ADJUSTERS, CHRONO_FIELDS, DATE_FIELDS, DATE_UNITS, ISO_DATE_VARIANTS, ISO_FIELDS, ISO_FORMATTERS, MAX_SAFE, MIN_WIDTH_LETTERS, PATTERN_KINDS, TIME_FIELDS, TIME_UNITS,
+  amount, byKind, durationText, durationTextMutated, edit, epochSecond, hms, instantHeld, ints, isoFormatterCase, ldIso, ldtIso, ltIso, ltIsoOf, maybe, mdIso, mutate,
+  nanos, odtIso, offIso, offsetSeconds, offsetText, otIso, parsePatternOf, patternOf, periodText, periodTextMutated, smallAmount, temporalCase, valueOf, weighted, year, ymIso, ymd,
+} from "./hegel-gen.mjs";
+
+const { ChronoField, ChronoUnit, IsoFields, TemporalAdjusters, DateTimeFormatter, ResolverStyle } = J;
+
+// ---------------------------------------------------------------------------------------------
+// Comparing with the oracle
+
+/** Runs `thunk` and renders its result as the oracle renders Java's: toString, or the exception's name. */
+function js(thunk) {
+  try {
+    const v = thunk();
+    return { ok: true, value: v === null || v === undefined ? String(v) : typeof v === "object" ? v.toString() : String(v) };
+  } catch (e) {
+    const name = e && e.name ? e.name : String(e);
+    // an exception that is not one of js-joda's is a harness mistake, shown with its message
+    const joda = ["DateTimeException", "DateTimeParseException", "ArithmeticException", "UnsupportedTemporalTypeException", "IllegalArgumentException", "IllegalStateException", "NullPointerException"];
+    return { ok: false, error: joda.includes(name) ? name : `${name}: ${e.message}` };
+  }
+}
+function show(r) {
+  return r.ok ? JSON.stringify(r.value) : `throws ${r.error}${r.message ? " (" + r.message + ")" : ""}`;
+}
+// Documented differences of the port's value model, accepted and counted rather than reported
+// (README): years run over -999999..999999 where Java's run over a billion, so a Java result
+// with a year beyond that is a DateTimeException here; numbers are JavaScript Numbers, so a
+// Java long beyond 2^53 is an ArithmeticException here and a Java int overflow in Period is a
+// plain number here; Duration.dividedBy documents its floating-point rounding; and
+// YearMonth.toString writes the sign Java omits for years past 9999.
+const beyondYears = (v) => { const m = /^([+-]?\d+)(?:-|$)/.exec(v); return m !== null && Math.abs(Number(m[1])) > 999999; };
+/** An ISO date, date-time or year-month argument (a year followed by a month) with a year beyond js-joda's. */
+const beyondYearsDate = (v) => /^[+-]?\d{7,}-\d\d/.test(v);
+/** A Java Duration or number js-joda cannot hold (seconds or value beyond 2^53). */
+function beyondSafe(v) {
+  if (/^\d{16,}$|^-\d{16,}$/.test(v)) return true;
+  if (/^-?P/.test(v)) { try { J.Duration.parse(v); return false; } catch { return true; } }
+  return false;
+}
+function accepted(op, args, s, j) {
+  if (!s.ok && ["DateTimeException", "ArithmeticException", "DateTimeParseException"].includes(s.error) && ((j.ok && beyondYears(j.value)) || args.some(beyondYearsDate))) return "java-year-beyond-999999";
+  if (j.ok && !s.ok && s.error === "ArithmeticException" && beyondSafe(j.value)) return "java-long-beyond-2^53";
+  if (j.ok && !s.ok && s.error === "DateTimeParseException" && op === "dur.parse" && beyondSafe(j.value)) return "java-long-beyond-2^53";
+  // the number parser reads at most 15 digits (NumberPrinterParser.MAX_WIDTH, "can't parse all
+  // numbers with more then 15 digits in javascript") where Java's reads 19: a 16-digit text such as
+  // "0010800000000000" for `N` is a parse error here and 03:00 there
+  if (j.ok && !s.ok && s.error === "DateTimeParseException" && /^fmt\.parse/.test(op) && /\d{16,}/.test(args[args.length - 1])) return "number-text-wider-than-15-digits";
+  // three recorded parser bugs surface on the texts an edit makes, whatever the pattern's shape: an
+  // offset field reads a trailing seconds group (js-joda/20: `XX` takes "+000100" whole where Java
+  // stops after "+0001" and fails on the rest), a parsed quarter is not cross-checked against the
+  // resolved date (js-joda/24: Java reports the conflict), and an offset hour of 24 to 59 passes the
+  // offset parser (js-joda/34: Java rejects "+31:00" outright, so ISO_DATE parses here and fails there)
+  if (/^fmt\.(parse|isoParse)/.test(op) && !j.ok) {
+    const text = args[args.length - 1];
+    const bare = /^fmt\.parse/.test(op) ? args[0].replace(/'[^']*'/g, "") : "";
+    if (/[xXZ]/.test(bare) && /[+-]\d\d:?\d\d:?\d\d/.test(text)) return "known-js-joda/20";
+    if (s.ok && /QuarterOfYear/.test(j.message || "")) return "known-js-joda/24";
+    if (s.ok && /[+-](2[4-9]|[3-5]\d):?\d\d/.test(text)) return "known-js-joda/34";
+  }
+  if (!j.ok && !s.ok && s.error === "ArithmeticException" && j.error === "DateTimeException" && args.some((a) => Math.abs(Number(a)) >= 1e8)) return "overflow-exception-for-a-huge-amount";
+  if (!s.ok && s.error === "DateTimeException" && j.ok && /^per\.(addTo|subtractFrom)$/.test(op)) {
+    // the months are added before the days, so the intermediate date can leave js-joda's years while Java's result is inside
+    const y = /^([+-]?\d+)-/.exec(args[1]);
+    const per = /^-?P(?:(-?\d+)Y)?(?:(-?\d+)M)?/.exec(args[2]);
+    if (y && per && Math.abs(Number(y[1])) + Math.abs(Number(per[1] || 0)) + Math.abs(Number(per[2] || 0)) / 12 + 1 > 999999) return "java-year-beyond-999999";
