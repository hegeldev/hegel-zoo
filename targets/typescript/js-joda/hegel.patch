+const PATTERN_KINDS = {
+  ld: { ...DATE_LETTERS },
+  lt: { ...TIME_LETTERS },
+  ldt: { ...DATE_LETTERS, ...TIME_LETTERS },
+  odt: { ...DATE_LETTERS, ...TIME_LETTERS, ...OFFSET_LETTERS },
+  ot: { ...TIME_LETTERS, ...OFFSET_LETTERS },
+  ym: { u: [1, 4], y: [1, 2, 4], M: [1, 2], L: [1, 2], Q: [1, 2] },
+  md: { M: [1, 2], d: [1, 2] },
+  year: { u: [1, 2, 3, 4, 5], y: [1, 2, 3, 4, 5] },
+};
