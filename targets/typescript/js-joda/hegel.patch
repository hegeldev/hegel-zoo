+// Hegel zoo: java.time as the oracle for js-joda. Started once per test file with the JDK's
+// source launcher (`java hegel/Oracle.java`, JDK 11+); reads one request per line on stdin,
+// `id TAB op TAB arg...`, and answers `id TAB ok TAB result` or `id TAB err TAB ExceptionName TAB
+// message`. Temporal values travel as their ISO toString() forms, which js-joda shares; every
+// result is rendered with toString(), so the JavaScript side compares strings.
+import java.io.BufferedReader;
+import java.io.InputStreamReader;
+import java.io.PrintStream;
+import java.time.DayOfWeek;
+import java.time.Duration;
+import java.time.Instant;
+import java.time.LocalDate;
+import java.time.LocalDateTime;
+import java.time.LocalTime;
+import java.time.Month;
+import java.time.MonthDay;
+import java.time.OffsetDateTime;
+import java.time.OffsetTime;
+import java.time.Period;
+import java.time.Year;
+import java.time.YearMonth;
+import java.time.ZoneOffset;
+import java.time.format.DateTimeFormatter;
+import java.time.format.ResolverStyle;
+import java.time.temporal.ChronoField;
+import java.time.temporal.ChronoUnit;
+import java.time.temporal.IsoFields;
+import java.time.temporal.Temporal;
+import java.time.temporal.TemporalAccessor;
+import java.time.temporal.TemporalAdjuster;
+import java.time.temporal.TemporalAdjusters;
+import java.time.temporal.TemporalField;
+import java.time.temporal.TemporalUnit;
+import java.util.Locale;
+
+public class Oracle {
+    static long L(String s) { return Long.parseLong(s); }
+    static int I(String s) { return Integer.parseInt(s); }
+
+    static Temporal temporal(String kind, String s) {
+        switch (kind) {
+            case "ld": return LocalDate.parse(s);
+            case "lt": return LocalTime.parse(s);
+            case "ldt": return LocalDateTime.parse(s);
+            case "inst": return Instant.parse(s);
+            case "odt": return OffsetDateTime.parse(s);
+            case "ot": return OffsetTime.parse(s);
+            case "ym": return YearMonth.parse(s);
+            case "year": return Year.of(I(s));
+            default: throw new IllegalStateException("oracle: unknown temporal kind " + kind);
+        }
+    }
+
+    static TemporalAccessor accessor(String kind, String s) {
+        switch (kind) {
+            case "md": return MonthDay.parse(s);
+            case "dow": return DayOfWeek.of(I(s));
+            case "month": return Month.of(I(s));
+            case "off": return ZoneOffset.of(s);
+            default: return temporal(kind, s);
+        }
+    }
+
+    static Object parseAs(String kind, String text, DateTimeFormatter f) {
+        switch (kind) {
+            case "ld": return LocalDate.parse(text, f);
+            case "lt": return LocalTime.parse(text, f);
+            case "ldt": return LocalDateTime.parse(text, f);
+            case "inst": return Instant.from(f.parse(text));
+            case "odt": return OffsetDateTime.parse(text, f);
+            case "ot": return OffsetTime.parse(text, f);
+            case "ym": return YearMonth.parse(text, f);
+            case "md": return MonthDay.parse(text, f);
+            case "year": return Year.parse(text, f);
+            default: throw new IllegalStateException("oracle: unknown parse kind " + kind);
+        }
+    }
+
+    static TemporalField field(String name) {
+        switch (name) {
+            case "WEEK_OF_WEEK_BASED_YEAR": return IsoFields.WEEK_OF_WEEK_BASED_YEAR;
+            case "WEEK_BASED_YEAR": return IsoFields.WEEK_BASED_YEAR;
+            case "QUARTER_OF_YEAR": return IsoFields.QUARTER_OF_YEAR;
+            case "DAY_OF_QUARTER": return IsoFields.DAY_OF_QUARTER;
+            default: return ChronoField.valueOf(name);
+        }
+    }
+
+    static TemporalUnit unit(String name) {
+        switch (name) {
+            case "WEEK_BASED_YEARS": return IsoFields.WEEK_BASED_YEARS;
+            case "QUARTER_YEARS": return IsoFields.QUARTER_YEARS;
+            default: return ChronoUnit.valueOf(name);
+        }
+    }
+
+    static TemporalAdjuster adjuster(String name, String[] a, int from) {
+        switch (name) {
+            case "firstDayOfMonth": return TemporalAdjusters.firstDayOfMonth();
+            case "lastDayOfMonth": return TemporalAdjusters.lastDayOfMonth();
+            case "firstDayOfNextMonth": return TemporalAdjusters.firstDayOfNextMonth();
+            case "firstDayOfYear": return TemporalAdjusters.firstDayOfYear();
+            case "lastDayOfYear": return TemporalAdjusters.lastDayOfYear();
+            case "firstDayOfNextYear": return TemporalAdjusters.firstDayOfNextYear();
+            case "firstInMonth": return TemporalAdjusters.firstInMonth(DayOfWeek.of(I(a[from])));
+            case "lastInMonth": return TemporalAdjusters.lastInMonth(DayOfWeek.of(I(a[from])));
+            case "dayOfWeekInMonth": return TemporalAdjusters.dayOfWeekInMonth(I(a[from]), DayOfWeek.of(I(a[from + 1])));
+            case "next": return TemporalAdjusters.next(DayOfWeek.of(I(a[from])));
+            case "nextOrSame": return TemporalAdjusters.nextOrSame(DayOfWeek.of(I(a[from])));
+            case "previous": return TemporalAdjusters.previous(DayOfWeek.of(I(a[from])));
+            case "previousOrSame": return TemporalAdjusters.previousOrSame(DayOfWeek.of(I(a[from])));
+            default: throw new IllegalStateException("oracle: unknown adjuster " + name);
+        }
+    }
+
+    static DateTimeFormatter iso(String name) throws Exception {
+        return (DateTimeFormatter) DateTimeFormatter.class.getField(name).get(null);
+    }
+
+    /** Every ChronoField the value supports, as NAME=value pairs, plus IsoFields for dates. */
+    static String fields(TemporalAccessor t) {
+        StringBuilder sb = new StringBuilder();
+        for (ChronoField f : ChronoField.values()) {
+            if (t.isSupported(f)) sb.append(f.name()).append('=').append(t.getLong(f)).append(';');
+        }
+        for (TemporalField f : new TemporalField[] { IsoFields.WEEK_OF_WEEK_BASED_YEAR, IsoFields.WEEK_BASED_YEAR, IsoFields.QUARTER_OF_YEAR, IsoFields.DAY_OF_QUARTER }) {
+            if (t.isSupported(f)) sb.append(f.toString()).append('=').append(t.getLong(f)).append(';');
+        }
+        return sb.toString();
+    }
+
+    @SuppressWarnings("unchecked")
+    static Object eval(String op, String[] a) throws Exception {
+        int dot = op.indexOf('.');
+        String kind = dot < 0 ? op : op.substring(0, dot);
+        String method = dot < 0 ? "" : op.substring(dot + 1);
+        switch (op) {
+            // constructors
+            case "LocalDate.of": return LocalDate.of(I(a[0]), I(a[1]), I(a[2]));
+            case "LocalDate.ofEpochDay": return LocalDate.ofEpochDay(L(a[0]));
+            case "LocalDate.ofYearDay": return LocalDate.ofYearDay(I(a[0]), I(a[1]));
+            case "LocalTime.of": return LocalTime.of(I(a[0]), I(a[1]), I(a[2]), I(a[3]));
+            case "LocalTime.ofSecondOfDay": return LocalTime.ofSecondOfDay(L(a[0]));
+            case "LocalTime.ofNanoOfDay": return LocalTime.ofNanoOfDay(L(a[0]));
+            case "LocalDateTime.ofEpochSecond": return LocalDateTime.ofEpochSecond(L(a[0]), I(a[1]), ZoneOffset.of(a[2]));
+            case "Instant.ofEpochSecond": return Instant.ofEpochSecond(L(a[0]), L(a[1]));
+            case "Instant.ofEpochMilli": return Instant.ofEpochMilli(L(a[0]));
+            case "Duration.ofSeconds": return Duration.ofSeconds(L(a[0]), L(a[1]));
+            case "Duration.of": return Duration.of(L(a[0]), unit(a[1]));
+            case "Duration.between": return Duration.between(temporal(a[0], a[1]), temporal(a[0], a[2]));
+            case "Period.of": return Period.of(I(a[0]), I(a[1]), I(a[2]));
+            case "Period.ofWeeks": return Period.ofWeeks(I(a[0]));
+            case "Period.between": return Period.between(LocalDate.parse(a[0]), LocalDate.parse(a[1]));
+            case "ZoneOffset.of": return ZoneOffset.of(a[0]);
+            case "ZoneOffset.ofTotalSeconds": return ZoneOffset.ofTotalSeconds(I(a[0]));
+            case "ZoneOffset.ofHoursMinutesSeconds": return ZoneOffset.ofHoursMinutesSeconds(I(a[0]), I(a[1]), I(a[2]));
+            case "YearMonth.of": return YearMonth.of(I(a[0]), I(a[1]));
+            case "MonthDay.of": return MonthDay.of(I(a[0]), I(a[1]));
+            case "Year.of": return Year.of(I(a[0]));
+            case "Year.isLeap": return Year.isLeap(L(a[0]));
+            case "Month.length": return Month.of(I(a[0])).length(Boolean.parseBoolean(a[1]));
+            case "Month.firstDayOfYear": return Month.of(I(a[0])).firstDayOfYear(Boolean.parseBoolean(a[1]));
+            case "Month.plus": return Month.of(I(a[0])).plus(L(a[1])).getValue();
+            case "DayOfWeek.plus": return DayOfWeek.of(I(a[0])).plus(L(a[1])).getValue();
+            // Duration
+            case "dur.plus": return Duration.parse(a[0]).plus(Duration.parse(a[1]));
+            case "dur.minus": return Duration.parse(a[0]).minus(Duration.parse(a[1]));
+            case "dur.plusUnit": return Duration.parse(a[0]).plus(L(a[1]), unit(a[2]));
+            case "dur.multipliedBy": return Duration.parse(a[0]).multipliedBy(L(a[1]));
+            case "dur.dividedBy": return Duration.parse(a[0]).dividedBy(L(a[1]));
+            case "dur.dividedByDuration": return Duration.parse(a[0]).dividedBy(Duration.parse(a[1]));
+            case "dur.negated": return Duration.parse(a[0]).negated();
+            case "dur.abs": return Duration.parse(a[0]).abs();
+            case "dur.truncatedTo": return Duration.parse(a[0]).truncatedTo(unit(a[1]));
+            case "dur.withSeconds": return Duration.parse(a[0]).withSeconds(L(a[1]));
+            case "dur.withNanos": return Duration.parse(a[0]).withNanos(I(a[1]));
+            case "dur.compare": return Integer.signum(Duration.parse(a[0]).compareTo(Duration.parse(a[1])));
+            case "dur.parse": return Duration.parse(a[0]);
+            case "dur.addTo": return temporal(a[0], a[1]).plus(Duration.parse(a[2]));
+            case "dur.subtractFrom": return temporal(a[0], a[1]).minus(Duration.parse(a[2]));
+            case "dur.get": {
+                Duration d = Duration.parse(a[0]);
+                switch (a[1]) {
+                    case "seconds": return d.getSeconds();
+                    case "nano": return d.getNano();
+                    case "toDays": return d.toDays();
+                    case "toHours": return d.toHours();
+                    case "toMinutes": return d.toMinutes();
+                    case "toSeconds": return d.toSeconds();
+                    case "toMillis": return d.toMillis();
+                    case "toNanos": return d.toNanos();
+                    case "toDaysPart": return d.toDaysPart();
+                    case "toHoursPart": return d.toHoursPart();
+                    case "toMinutesPart": return d.toMinutesPart();
+                    case "toSecondsPart": return d.toSecondsPart();
+                    case "toMillisPart": return d.toMillisPart();
+                    case "toNanosPart": return d.toNanosPart();
+                    case "isNegative": return d.isNegative();
+                    case "isZero": return d.isZero();
+                    default: throw new IllegalStateException("oracle: unknown duration getter " + a[1]);
+                }
+            }
+            // Period
+            case "per.plus": return Period.parse(a[0]).plus(Period.parse(a[1]));
+            case "per.minus": return Period.parse(a[0]).minus(Period.parse(a[1]));
+            case "per.multipliedBy": return Period.parse(a[0]).multipliedBy(I(a[1]));
+            case "per.negated": return Period.parse(a[0]).negated();
+            case "per.normalized": return Period.parse(a[0]).normalized();
+            case "per.parse": return Period.parse(a[0]);
+            case "per.addTo": return temporal(a[0], a[1]).plus(Period.parse(a[2]));
+            case "per.subtractFrom": return temporal(a[0], a[1]).minus(Period.parse(a[2]));
+            case "per.get": {
+                Period p = Period.parse(a[0]);
+                switch (a[1]) {
+                    case "years": return p.getYears();
+                    case "months": return p.getMonths();
+                    case "days": return p.getDays();
+                    case "toTotalMonths": return p.toTotalMonths();
+                    case "isNegative": return p.isNegative();
+                    case "isZero": return p.isZero();
+                    default: throw new IllegalStateException("oracle: unknown period getter " + a[1]);
+                }
+            }
+            // formatting
+            case "fmt.format": return DateTimeFormatter.ofPattern(a[0]).format(accessor(a[1], a[2]));
+            case "fmt.parse": return parseAs(a[1], a[2], DateTimeFormatter.ofPattern(a[0]));
+            case "fmt.parseStyle": return parseAs(a[2], a[3], DateTimeFormatter.ofPattern(a[0]).withResolverStyle(ResolverStyle.valueOf(a[1])));
+            case "fmt.pattern": DateTimeFormatter.ofPattern(a[0]); return "ok";
+            case "fmt.iso": return iso(a[0]).format(accessor(a[1], a[2]));
+            case "fmt.isoParse": return parseAs(a[1], a[2], iso(a[0]));
+            case "fmt.isoParseStyle": return parseAs(a[2], a[3], iso(a[0]).withResolverStyle(ResolverStyle.valueOf(a[1])));
+        }
+        // generic temporal methods: <kind>.<method> value args...
+        switch (method) {
+            case "parse": return accessor(kind, a[0]);
+            case "plus": return temporal(kind, a[0]).plus(L(a[1]), unit(a[2]));
+            case "minus": return temporal(kind, a[0]).minus(L(a[1]), unit(a[2]));
+            case "until": return temporal(kind, a[0]).until(temporal(kind, a[1]), unit(a[2]));
+            case "get": return accessor(kind, a[0]).getLong(field(a[1]));
+            case "with": return temporal(kind, a[0]).with(field(a[1]), L(a[2]));
+            case "range": return accessor(kind, a[0]).range(field(a[1]));
+            case "isSupportedField": return accessor(kind, a[0]).isSupported(field(a[1]));
+            case "isSupportedUnit": return temporal(kind, a[0]).isSupported(unit(a[1]));
+            case "fields": return fields(accessor(kind, a[0]));
+            case "adjust": return temporal(kind, a[0]).with(adjuster(a[1], a, 2));
+            case "compare": return Integer.signum(((Comparable<Object>) (Object) accessor(kind, a[0])).compareTo(accessor(kind, a[1])));
+            case "prop": return prop(kind, a);
+        }
+        throw new IllegalStateException("oracle: unknown op " + op);
+    }
+
+    /** Type-specific methods: <kind>.prop value name args... */
+    static Object prop(String kind, String[] a) {
+        String name = a[1];
+        switch (kind) {
+            case "ld": {
+                LocalDate d = LocalDate.parse(a[0]);
+                switch (name) {
+                    case "toEpochDay": return d.toEpochDay();
+                    case "lengthOfMonth": return d.lengthOfMonth();
+                    case "lengthOfYear": return d.lengthOfYear();
+                    case "isLeapYear": return d.isLeapYear();
+                    case "dayOfWeek": return d.getDayOfWeek().getValue();
+                    case "dayOfYear": return d.getDayOfYear();
+                    case "atStartOfDay": return d.atStartOfDay();
+                    case "atTime": return d.atTime(LocalTime.parse(a[2]));
+                    case "withDayOfMonth": return d.withDayOfMonth(I(a[2]));
+                    case "withDayOfYear": return d.withDayOfYear(I(a[2]));
+                    case "withMonth": return d.withMonth(I(a[2]));
+                    case "withYear": return d.withYear(I(a[2]));
+                    case "plusDays": return d.plusDays(L(a[2]));
+                    case "plusWeeks": return d.plusWeeks(L(a[2]));
+                    case "plusMonths": return d.plusMonths(L(a[2]));
+                    case "plusYears": return d.plusYears(L(a[2]));
+                    case "minusDays": return d.minusDays(L(a[2]));
+                    case "minusWeeks": return d.minusWeeks(L(a[2]));
+                    case "minusMonths": return d.minusMonths(L(a[2]));
+                    case "minusYears": return d.minusYears(L(a[2]));
+                    case "untilPeriod": return d.until(LocalDate.parse(a[2]));
+                    case "datesUntilCount": return d.datesUntil(LocalDate.parse(a[2])).count();
+                }
+                break;
+            }
+            case "lt": {
+                LocalTime t = LocalTime.parse(a[0]);
+                switch (name) {
+                    case "toSecondOfDay": return t.toSecondOfDay();
+                    case "toNanoOfDay": return t.toNanoOfDay();
+                    case "truncatedTo": return t.truncatedTo(unit(a[2]));
+                    case "plusHours": return t.plusHours(L(a[2]));
+                    case "plusMinutes": return t.plusMinutes(L(a[2]));
+                    case "plusSeconds": return t.plusSeconds(L(a[2]));
+                    case "plusNanos": return t.plusNanos(L(a[2]));
+                    case "minusHours": return t.minusHours(L(a[2]));
+                    case "minusMinutes": return t.minusMinutes(L(a[2]));
+                    case "minusSeconds": return t.minusSeconds(L(a[2]));
+                    case "minusNanos": return t.minusNanos(L(a[2]));
+                    case "withHour": return t.withHour(I(a[2]));
+                    case "withMinute": return t.withMinute(I(a[2]));
+                    case "withSecond": return t.withSecond(I(a[2]));
+                    case "withNano": return t.withNano(I(a[2]));
+                    case "atDate": return t.atDate(LocalDate.parse(a[2]));
+                    case "atOffset": return t.atOffset(ZoneOffset.of(a[2]));
+                }
+                break;
+            }
+            case "ldt": {
+                LocalDateTime t = LocalDateTime.parse(a[0]);
+                switch (name) {
+                    case "truncatedTo": return t.truncatedTo(unit(a[2]));
+                    case "toEpochSecond": return t.toEpochSecond(ZoneOffset.of(a[2]));
+                    case "toInstant": return t.toInstant(ZoneOffset.of(a[2]));
+                    case "atOffset": return t.atOffset(ZoneOffset.of(a[2]));
+                    case "toLocalDate": return t.toLocalDate();
+                    case "toLocalTime": return t.toLocalTime();
+                    case "plusDays": return t.plusDays(L(a[2]));
+                    case "plusHours": return t.plusHours(L(a[2]));
+                    case "plusMinutes": return t.plusMinutes(L(a[2]));
+                    case "plusSeconds": return t.plusSeconds(L(a[2]));
+                    case "plusNanos": return t.plusNanos(L(a[2]));
+                    case "plusWeeks": return t.plusWeeks(L(a[2]));
+                    case "plusMonths": return t.plusMonths(L(a[2]));
+                    case "plusYears": return t.plusYears(L(a[2]));
+                    case "minusDays": return t.minusDays(L(a[2]));
+                    case "minusHours": return t.minusHours(L(a[2]));
+                    case "minusMinutes": return t.minusMinutes(L(a[2]));
+                    case "minusSeconds": return t.minusSeconds(L(a[2]));
+                    case "minusNanos": return t.minusNanos(L(a[2]));
+                    case "minusMonths": return t.minusMonths(L(a[2]));
+                    case "minusYears": return t.minusYears(L(a[2]));
+                }
+                break;
+            }
+            case "inst": {
+                Instant i = Instant.parse(a[0]);
+                switch (name) {
+                    case "epochSecond": return i.getEpochSecond();
+                    case "nano": return i.getNano();
+                    case "toEpochMilli": return i.toEpochMilli();
+                    case "truncatedTo": return i.truncatedTo(unit(a[2]));
+                    case "atOffset": return i.atOffset(ZoneOffset.of(a[2]));
+                    case "plusSeconds": return i.plusSeconds(L(a[2]));
+                    case "plusMillis": return i.plusMillis(L(a[2]));
+                    case "plusNanos": return i.plusNanos(L(a[2]));
+                    case "minusSeconds": return i.minusSeconds(L(a[2]));
+                    case "minusMillis": return i.minusMillis(L(a[2]));
+                    case "minusNanos": return i.minusNanos(L(a[2]));
+                }
+                break;
+            }
+            case "odt": {
+                OffsetDateTime t = OffsetDateTime.parse(a[0]);
+                switch (name) {
+                    case "toInstant": return t.toInstant();
+                    case "toEpochSecond": return t.toEpochSecond();
+                    case "withOffsetSameInstant": return t.withOffsetSameInstant(ZoneOffset.of(a[2]));
+                    case "withOffsetSameLocal": return t.withOffsetSameLocal(ZoneOffset.of(a[2]));
+                    case "toLocalDateTime": return t.toLocalDateTime();
+                    case "truncatedTo": return t.truncatedTo(unit(a[2]));
+                    case "compareInstant": return Integer.signum(OffsetDateTime.timeLineOrder().compare(t, OffsetDateTime.parse(a[2])));
+                }
+                break;
+            }
+            case "ot": {
+                OffsetTime t = OffsetTime.parse(a[0]);
+                switch (name) {
+                    case "withOffsetSameInstant": return t.withOffsetSameInstant(ZoneOffset.of(a[2]));
+                    case "withOffsetSameLocal": return t.withOffsetSameLocal(ZoneOffset.of(a[2]));
+                    case "truncatedTo": return t.truncatedTo(unit(a[2]));
+                    case "toEpochNano": return t.toEpochSecond(LocalDate.EPOCH) * 1_000_000_000L + t.getNano();
+                }
+                break;
+            }
+            case "ym": {
+                YearMonth m = YearMonth.parse(a[0]);
+                switch (name) {
+                    case "atDay": return m.atDay(I(a[2]));
+                    case "atEndOfMonth": return m.atEndOfMonth();
+                    case "lengthOfMonth": return m.lengthOfMonth();
+                    case "lengthOfYear": return m.lengthOfYear();
+                    case "isValidDay": return m.isValidDay(I(a[2]));
+                    case "isLeapYear": return m.isLeapYear();
+                    case "plusMonths": return m.plusMonths(L(a[2]));
+                    case "plusYears": return m.plusYears(L(a[2]));
+                }
+                break;
+            }
+            case "md": {
+                MonthDay m = MonthDay.parse(a[0]);
+                switch (name) {
+                    case "atYear": return m.atYear(I(a[2]));
+                    case "isValidYear": return m.isValidYear(I(a[2]));
+                    case "withMonth": return m.withMonth(I(a[2]));
+                    case "withDayOfMonth": return m.withDayOfMonth(I(a[2]));
+                }
+                break;
+            }
+            case "year": {
+                Year y = Year.of(I(a[0]));
+                switch (name) {
+                    case "atDay": return y.atDay(I(a[2]));
+                    case "atMonthDay": return y.atMonthDay(MonthDay.parse(a[2]));
+                    case "isLeap": return y.isLeap();
+                    case "length": return y.length();
+                    case "isValidMonthDay": return y.isValidMonthDay(MonthDay.parse(a[2]));
+                }
+                break;
+            }
+            case "off": {
+                ZoneOffset o = ZoneOffset.of(a[0]);
+                switch (name) {
+                    case "totalSeconds": return o.getTotalSeconds();
+                    case "id": return o.getId();
+                }
+                break;
+            }
+        }
+        throw new IllegalStateException("oracle: unknown prop " + kind + "." + name);
+    }
+
+    public static void main(String[] args) throws Exception {
+        Locale.setDefault(Locale.ROOT);
+        BufferedReader in = new BufferedReader(new InputStreamReader(System.in, "UTF-8"));
+        PrintStream out = new PrintStream(System.out, false, "UTF-8");
+        String line;
+        while ((line = in.readLine()) != null) {
+            String[] parts = line.split("\t", -1);
+            String id = parts[0];
+            String op = parts.length > 1 ? parts[1] : "";
+            String[] a = new String[Math.max(0, parts.length - 2)];
+            System.arraycopy(parts, 2, a, 0, a.length);
+            try {
+                out.println(id + "\tok\t" + String.valueOf(eval(op, a)));
+            } catch (Throwable e) {
+                Throwable t = e;
+                if (t instanceof java.lang.reflect.InvocationTargetException && t.getCause() != null) t = t.getCause();
+                String msg = String.valueOf(t.getMessage()).replace('\t', ' ').replace('\n', ' ');
+                out.println(id + "\terr\t" + t.getClass().getSimpleName() + "\t" + msg);
+            }
+            out.flush();
+        }
+    }
+}
diff --git a/packages/core/hegel/build.mjs b/packages/core/hegel/build.mjs
