+function mutate(tc, text) {
+  if (text.length === 0) return pick(tc, ["0", " ", "x"]);
+  const i = n(tc, 0, text.length - 1);
+  switch (n(tc, 0, 9)) {
+    case 0: return text.slice(0, i) + text.slice(i + 1);
+    case 1: return text.slice(0, i) + pick(tc, ["0", "9", "1", "-", "+", " ", ":", "T", "Z", "."]) + text.slice(i);
+    case 2: return text.slice(0, i) + pick(tc, ["0", "9", "3", "9"]) + text.slice(i + 1);
+    case 3: return text + pick(tc, [" ", "0", "Z", "x", "T00:00"]);
