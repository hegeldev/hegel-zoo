+// Hegel zoo: bundle @js-joda/core's ES-module sources (extension-less imports, built upstream by
+// rollup + babel into an uncommitted dist/) into one ES module under .hegel/dist with esbuild, so
+// the tests import the library at the pinned commit without the repository's devDependencies.
+// Run from packages/core after the .hegel install.
+import { execFileSync } from "node:child_process";
+import { mkdirSync } from "node:fs";
+
+const esbuild = ".hegel/node_modules/esbuild/bin/esbuild";
+mkdirSync(".hegel/dist", { recursive: true });
+execFileSync(esbuild, ["src/js-joda.js", "--bundle", "--format=esm", "--platform=node", "--log-level=warning", "--outfile=.hegel/dist/js-joda.mjs"], { stdio: "inherit" });
+console.log("built .hegel/dist/js-joda.mjs");
diff --git a/packages/core/hegel/hegel-zoo.mjs b/packages/core/hegel/hegel-zoo.mjs
new file mode 100644
index 0000000..1ca6f10
--- /dev/null
+++ b/packages/core/hegel/hegel-zoo.mjs
@@ -0,0 +1,163 @@
+// Hegel zoo: the small harness shared by the zoo's TypeScript/JavaScript targets.
+//
+// `property(name, body)` registers a node:test test that runs `body(tc)` under Hegel with
+// HEGEL_TEST_CASES cases (default 100) and the database at HEGEL_DATABASE. With ZOO_COLLECT=1
+// a `fail()` records the mismatch instead of failing, the case ends there, and the counts of
+// mismatches and of the shapes seen (`count(key)`) are printed at the end of the test, so a
+// property can be run over many cases to see every shape at once. `pin(name, body)` is a
+// plain test for one pinned bug: it must fail while the bug is present and pass once it is
+// fixed (the zoo's judge reads an unexpected pass as "fixed upstream?").
+
+import { readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+import { test as nodeTest } from "node:test";
+
+// The Hegel version these tests were written against (the zoo pins it in zoo.toml; upstream
+// would add it to devDependencies). Hegel and esbuild are installed with `npm install --prefix
+// .hegel` so the target's own package.json and lock file stay untouched. Checked at load time so
+// a stray install cannot silently change the engine.
+export const HEGEL_PIN = { "@hegeldev/hegel": "0.4.5" };
+
+const hegelDir = join(dirname(fileURLToPath(import.meta.url)), "..", ".hegel", "node_modules", "@hegeldev", "hegel");
+{
+  const installed = JSON.parse(readFileSync(join(hegelDir, "package.json"), "utf8")).version;
+  if (installed !== HEGEL_PIN["@hegeldev/hegel"]) {
+    throw new Error(`@hegeldev/hegel ${installed} is installed; these tests pin ${HEGEL_PIN["@hegeldev/hegel"]}`);
+  }
+}
+const hegel = await import(pathToFileURL(join(hegelDir, "dist", "index.js")));
+const gs = await import(pathToFileURL(join(hegelDir, "dist", "generators", "index.js")));
+
+export const collecting = !!process.env.ZOO_COLLECT;
+
+class Collected extends Error {}
+
+let msgs = [];
+let stats = new Map();
+
+/** Report a mismatch: an error normally, a recorded line in collect mode. */
+export function fail(message) {
+  if (collecting) {
+    msgs.push(message);
+    throw new Collected(message);
+  }
+  throw new Error(message);
+}
+
+/** Bump a statistic (the shape of a pinned bug, a generator branch). */
+export function count(key) {
+  stats.set(key, (stats.get(key) || 0) + 1);
+}
+
+function settings() {
+  const s = { testCases: Number(process.env.HEGEL_TEST_CASES) || 100 };
+  if (process.env.HEGEL_DATABASE) {
+    s.database = hegel.Database.fromPath(process.env.HEGEL_DATABASE);
+  }
+  return s;
+}
+
+/** A property: `body(tc)` runs under Hegel; a thrown error (or `fail`) is a failure. */
+export function property(name, body) {
+  nodeTest(name, () => {
+    msgs = [];
+    stats = new Map();
+    hegel.test((tc) => {
+      try {
+        body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** An async property: `body(tc)` may await; runs under Hegel's testAsync with the same settings. */
+export function propertyAsync(name, body) {
+  nodeTest(name, async () => {
+    msgs = [];
+    stats = new Map();
+    await hegel.testAsync(async (tc) => {
+      try {
+        await body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** A pin: a plain test for one recorded bug. */
+export function pin(name, body) {
+  nodeTest(name, body);
+}
+
+/** An integer in [lo, hi]. */
+export function n(tc, lo, hi) {
+  return tc.draw(gs.integers({ minValue: lo, maxValue: hi }));
+}
+
+/** One of xs. */
+export function pick(tc, xs) {
+  return xs[n(tc, 0, xs.length - 1)];
+}
+
+/** True pct percent of the time. */
+export function chance(tc, pct) {
+  return n(tc, 0, 99) < pct;
+}
+
+/** A string of `len` characters drawn from `alphabet` (an array of strings). */
+export function word(tc, alphabet, lo, hi) {
+  const len = n(tc, lo, hi);
+  let s = "";
+  for (let i = 0; i < len; i++) {
+    s += pick(tc, alphabet);
+  }
+  return s;
+}
+
+/** Structural equality: arrays by position, objects by key set (prototype ignored), else ===. */
+export function same(a, b) {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) {
+      return false;
+    }
+    return a.every((x, i) => same(x, b[i]));
+  }
+  if (a !== null && b !== null && typeof a === "object" && typeof b === "object") {
+    const ka = Object.keys(a).sort();
+    const kb = Object.keys(b).sort();
+    if (ka.length !== kb.length || ka.some((k, i) => k !== kb[i])) {
+      return false;
+    }
+    return ka.every((k) => same(a[k], b[k]));
+  }
+  return a === b;
+}
+
+/** A compact, unambiguous rendering for messages. */
+export function show(x) {
+  return JSON.stringify(x, (k, v) => (v === undefined ? "<undefined>" : v));
+}
diff --git a/packages/core/hegel/hegel.test.mjs b/packages/core/hegel/hegel.test.mjs
new file mode 100644
index 0000000..f80a189
--- /dev/null
+++ b/packages/core/hegel/hegel.test.mjs
@@ -0,0 +1,1063 @@
+// Hegel zoo: property-based tests for @js-joda/core against java.time itself.
+//
+// js-joda is a port of ThreeTen-Backport, the reference implementation of JSR-310, and its
+// AGENTS.md says "method names and semantics intentionally match Java's JSR-310 API". So the
+// oracle is the JDK: hegel/Oracle.java answers the same operation on the same ISO strings, and
+// every property compares js-joda's result (or the name of the exception it throws) with Java's.
+// Values travel as the ISO toString() forms both sides share; the strings themselves are built
+// here from numbers, so a divergent toString() shows up as a mismatch rather than a bad input.
+// `node hegel/build.mjs` bundles src/ to .hegel/dist/js-joda.mjs (see target.toml [run]).
+import assert from "node:assert/strict";
+import { chance, count, fail, n, pick, pin, propertyAsync } from "./hegel-zoo.mjs";
+import { java } from "./oracle.mjs";
+import * as J from "../.hegel/dist/js-joda.mjs";
+
+const { ChronoField, ChronoUnit, IsoFields, TemporalAdjusters, DateTimeFormatter, ResolverStyle } = J;
+
+// ---------------------------------------------------------------------------------------------
+// Comparing with the oracle
+
+/** Runs `thunk` and renders its result as the oracle renders Java's: toString, or the exception's name. */
+function js(thunk) {
+  try {
+    const v = thunk();
+    return { ok: true, value: v === null || v === undefined ? String(v) : typeof v === "object" ? v.toString() : String(v) };
+  } catch (e) {
+    const name = e && e.name ? e.name : String(e);
+    // an exception that is not one of js-joda's is a harness mistake, shown with its message
+    const joda = ["DateTimeException", "DateTimeParseException", "ArithmeticException", "UnsupportedTemporalTypeException", "IllegalArgumentException", "IllegalStateException", "NullPointerException"];
+    return { ok: false, error: joda.includes(name) ? name : `${name}: ${e.message}` };
+  }
+}
+function show(r) {
+  return r.ok ? JSON.stringify(r.value) : `throws ${r.error}${r.message ? " (" + r.message + ")" : ""}`;
+}
+// Documented differences of the port's value model, accepted and counted rather than reported
+// (README): years run over -999999..999999 where Java's run over a billion, so a Java result
+// with a year beyond that is a DateTimeException here; numbers are JavaScript Numbers, so a
+// Java long beyond 2^53 is an ArithmeticException here and a Java int overflow in Period is a
+// plain number here; Duration.dividedBy documents its floating-point rounding; and
+// YearMonth.toString writes the sign Java omits for years past 9999.
+const beyondYears = (v) => { const m = /^([+-]?\d+)(?:-|$)/.exec(v); return m !== null && Math.abs(Number(m[1])) > 999999; };
+/** An ISO date, date-time or year-month argument (a year followed by a month) with a year beyond js-joda's. */
+const beyondYearsDate = (v) => /^[+-]?\d{7,}-\d\d/.test(v);
+/** A Java Duration or number js-joda cannot hold (seconds or value beyond 2^53). */
+function beyondSafe(v) {
+  if (/^\d{16,}$|^-\d{16,}$/.test(v)) return true;
+  if (/^-?P/.test(v)) { try { J.Duration.parse(v); return false; } catch { return true; } }
+  return false;
+}
+function accepted(op, args, s, j) {
+  if (!s.ok && ["DateTimeException", "ArithmeticException", "DateTimeParseException"].includes(s.error) && ((j.ok && beyondYears(j.value)) || args.some(beyondYearsDate))) return "java-year-beyond-999999";
+  if (j.ok && !s.ok && s.error === "ArithmeticException" && beyondSafe(j.value)) return "java-long-beyond-2^53";
+  if (j.ok && !s.ok && s.error === "DateTimeParseException" && op === "dur.parse" && beyondSafe(j.value)) return "java-long-beyond-2^53";
+  if (!j.ok && !s.ok && s.error === "ArithmeticException" && j.error === "DateTimeException" && args.some((a) => Math.abs(Number(a)) >= 1e8)) return "overflow-exception-for-a-huge-amount";
+  if (!s.ok && s.error === "DateTimeException" && j.ok && /^per\.(addTo|subtractFrom)$/.test(op)) {
+    // the months are added before the days, so the intermediate date can leave js-joda's years while Java's result is inside
+    const y = /^([+-]?\d+)-/.exec(args[1]);
+    const per = /^-?P(?:(-?\d+)Y)?(?:(-?\d+)M)?/.exec(args[2]);
+    if (y && per && Math.abs(Number(y[1])) + Math.abs(Number(per[1] || 0)) + Math.abs(Number(per[2] || 0)) / 12 + 1 > 999999) return "java-year-beyond-999999";
+  }
+  if (!j.ok && s.ok && j.error === "ArithmeticException" && /^(per\.|Period\.)/.test(op)) return "java-int-overflow-in-period";
+  if (!j.ok && s.ok && j.error === "DateTimeParseException" && op === "per.parse" && /\d{10,}/.test(args[0])) return "java-int-overflow-in-period";
+  if (j.ok && s.ok && (/^ym\.|^YearMonth\./.test(op) || args.includes("ym")) && s.value === "+" + j.value) return "yearmonth-plus-sign";
+  return null;
+}
+
+/** js-joda's result of `thunk` must equal Java's result of `op(...args)`; returns Java's answer. */
+async function agree(label, thunk, op, ...args) {
+  const j = await java(op, ...args);
+  const s = js(thunk);
+  if (j.error === "OracleUnavailable") throw new Error(j.message);
+  if (j.error === "IllegalStateException" && /^oracle:/.test(j.message)) throw new Error(`oracle: ${j.message}`);
+  if (s.ok !== j.ok || (s.ok ? s.value !== j.value : s.error !== j.error)) {
+    const why = accepted(op, args, s, j);
+    if (why) { count(`accepted-${why}`); return j; }
+    fail(`${label}: js-joda ${show(s)}, java ${show(j)}  [${op} ${args.join(" ")}]`);
+  }
+  return j;
+}
+
+// ---------------------------------------------------------------------------------------------
+// Generators (ISO strings built here, by Java's toString rules)
+
+function isLeap(y) { return y % 4 === 0 && (y % 100 !== 0 || y % 400 === 0); }
+function monthLength(y, m) { return m === 2 ? (isLeap(y) ? 29 : 28) : [4, 6, 9, 11].includes(m) ? 30 : 31; }
+function year(tc) {
+  const r = n(tc, 0, 99);
+  if (r < 55) return n(tc, 1900, 2100);
+  if (r < 75) return n(tc, 0, 9999);
+  if (r < 88) return n(tc, -999999, 999999);
+  return pick(tc, [-999999, -999998, -10000, -9999, -1000, -999, -1, 0, 1, 999, 1000, 1582, 1600, 1970, 2000, 9999, 10000, 999998, 999999]);
+}
+function isoYear(y) {
+  const sign = y < 0 ? "-" : y > 9999 ? "+" : "";
+  return sign + String(Math.abs(y)).padStart(4, "0");
+}
+const p2 = (x) => String(x).padStart(2, "0");
+function ymd(tc) {
+  const y = year(tc);
+  const m = n(tc, 1, 12);
+  const len = monthLength(y, m);
+  const d = chance(tc, 30) ? pick(tc, [1, 28, len - 1, len]) : n(tc, 1, len);
+  return { y, m, d };
+}
+function ldIso(tc) {
+  const { y, m, d } = ymd(tc);
+  return `${isoYear(y)}-${p2(m)}-${p2(d)}`;
+}
+function nanos(tc) {
+  const r = n(tc, 0, 99);
+  if (r < 35) return 0;
+  if (r < 55) return n(tc, 0, 999) * 1000000;
+  if (r < 70) return n(tc, 0, 999999) * 1000;
+  if (r < 90) return n(tc, 0, 999999999);
+  return pick(tc, [1, 999, 1000, 999999, 1000000, 500000000, 999999999]);
+}
+function hms(tc) {
+  const r = n(tc, 0, 99);
+  if (r < 15) return { h: pick(tc, [0, 23]), mi: pick(tc, [0, 59]), s: pick(tc, [0, 59]) };
+  return { h: n(tc, 0, 23), mi: n(tc, 0, 59), s: chance(tc, 25) ? 0 : n(tc, 0, 59) };
+}
+/** Java's LocalTime.toString: HH:mm, :ss when needed, then 3, 6 or 9 fraction digits. */
+function ltIsoOf(h, mi, s, nano) {
+  let out = `${p2(h)}:${p2(mi)}`;
+  if (s > 0 || nano > 0) {
+    out += `:${p2(s)}`;
+    if (nano > 0) {
+      if (nano % 1000000 === 0) out += "." + String(nano / 1000000).padStart(3, "0");
+      else if (nano % 1000 === 0) out += "." + String(nano / 1000).padStart(6, "0");
+      else out += "." + String(nano).padStart(9, "0");
+    }
+  }
+  return out;
+}
+function ltIso(tc) {
+  const { h, mi, s } = hms(tc);
+  return ltIsoOf(h, mi, s, nanos(tc));
+}
+function ldtIso(tc) { return `${ldIso(tc)}T${ltIso(tc)}`; }
+function offsetSeconds(tc) {
+  const r = n(tc, 0, 99);
+  if (r < 30) return 0;
+  if (r < 60) return n(tc, -18, 18) * 3600;
+  if (r < 80) return n(tc, -18 * 60, 18 * 60) * 60;
+  if (r < 95) return n(tc, -64800, 64800);
+  return pick(tc, [-64800, 64800, 1, -1, 3599, -3599, 30600, -12600, 45900]);
+}
+/** Java's ZoneOffset.getId: Z, or +HH:MM, or +HH:MM:SS. */
+function offIsoOf(total) {
+  if (total === 0) return "Z";
+  const a = Math.abs(total);
+  const h = Math.floor(a / 3600), m = Math.floor((a % 3600) / 60), s = a % 60;
+  return (total < 0 ? "-" : "+") + p2(h) + ":" + p2(m) + (s ? ":" + p2(s) : "");
+}
+function offIso(tc) { return offIsoOf(offsetSeconds(tc)); }
+function odtIso(tc) { return ldtIso(tc) + offIso(tc); }
+function otIso(tc) { return ltIso(tc) + offIso(tc); }
+function ymIso(tc) { const { y, m } = ymd(tc); return `${isoYear(y)}-${p2(m)}`; }
+function mdIso(tc) { const m = n(tc, 1, 12); return `--${p2(m)}-${p2(chance(tc, 20) ? monthLength(2000, m) : n(tc, 1, monthLength(2000, m)))}`; }
+
+function amount(tc) {
+  const r = n(tc, 0, 99);
+  if (r < 40) return n(tc, -100, 100);
+  if (r < 65) return n(tc, -100000, 100000);
+  if (r < 85) return n(tc, -1000000000, 1000000000);
+  if (r < 95) return n(tc, -1e13, 1e13);
+  return pick(tc, [0, 1, -1, 1e12, -1e12, 1e15, -1e15, 9007199254740991, -9007199254740991, 365243219162, -365243219162, 31556889864403199, -31557014167219200]);
+}
+function smallAmount(tc) { return chance(tc, 70) ? n(tc, -1000, 1000) : n(tc, -1e7, 1e7); }
+
+const CHRONO_FIELDS = ["NANO_OF_SECOND", "NANO_OF_DAY", "MICRO_OF_SECOND", "MICRO_OF_DAY", "MILLI_OF_SECOND", "MILLI_OF_DAY", "SECOND_OF_MINUTE", "SECOND_OF_DAY", "MINUTE_OF_HOUR", "MINUTE_OF_DAY", "HOUR_OF_AMPM", "CLOCK_HOUR_OF_AMPM", "HOUR_OF_DAY", "CLOCK_HOUR_OF_DAY", "AMPM_OF_DAY", "DAY_OF_WEEK", "ALIGNED_DAY_OF_WEEK_IN_MONTH", "ALIGNED_DAY_OF_WEEK_IN_YEAR", "DAY_OF_MONTH", "DAY_OF_YEAR", "EPOCH_DAY", "ALIGNED_WEEK_OF_MONTH", "ALIGNED_WEEK_OF_YEAR", "MONTH_OF_YEAR", "PROLEPTIC_MONTH", "YEAR_OF_ERA", "YEAR", "ERA", "INSTANT_SECONDS", "OFFSET_SECONDS"];
+const DATE_FIELDS = CHRONO_FIELDS.slice(15, 28);
+const TIME_FIELDS = CHRONO_FIELDS.slice(0, 15);
+const ISO_FIELDS = { WEEK_OF_WEEK_BASED_YEAR: "WeekOfWeekBasedYear", WEEK_BASED_YEAR: "WeekBasedYear", QUARTER_OF_YEAR: "QuarterOfYear", DAY_OF_QUARTER: "DayOfQuarter" };
+const ALL_FIELDS = [...CHRONO_FIELDS, ...Object.keys(ISO_FIELDS)];
+const DATE_UNITS = ["DAYS", "WEEKS", "MONTHS", "YEARS", "DECADES", "CENTURIES", "MILLENNIA", "ERAS"];
+const TIME_UNITS = ["NANOS", "MICROS", "MILLIS", "SECONDS", "MINUTES", "HOURS", "HALF_DAYS"];
+const ALL_UNITS = [...TIME_UNITS, ...DATE_UNITS, "WEEK_BASED_YEARS", "QUARTER_YEARS", "FOREVER"];
+const field = (name) => (name in ISO_FIELDS ? IsoFields[name] : ChronoField[name]);
+const unit = (name) => (name === "WEEK_BASED_YEARS" || name === "QUARTER_YEARS" ? IsoFields[name] : ChronoUnit[name]);
+
+/** The oracle's `fields` rendering, from js-joda: every supported field, in Java's order. */
+function fieldsOf(t) {
+  let out = "";
+  for (const name of CHRONO_FIELDS) if (t.isSupported(ChronoField[name])) out += `${name}=${t.getLong(ChronoField[name])};`;
+  for (const [name, javaName] of Object.entries(ISO_FIELDS)) if (t.isSupported(IsoFields[name])) out += `${javaName}=${t.getLong(IsoFields[name])};`;
+  return out;
+}
+/** A value for `with(field, v)`: usually inside the field's range, sometimes just outside. */
+function fieldValue(tc, t, f) {
+  let range;
+  try { range = t.range(f); } catch { range = null; }
+  if (range && chance(tc, 80)) {
+    const lo = Number(range.minimum()), hi = Number(range.maximum());
+    if (chance(tc, 30)) return pick(tc, [lo, hi, lo - 1, hi + 1, Number(range.largestMinimum()), Number(range.smallestMaximum())]);
+    return n(tc, Math.max(lo, -1e9), Math.min(hi, 1e9));
+  }
+  return amount(tc);
+}
+
+const KINDS = {
+  ld: { parse: (s) => J.LocalDate.parse(s), gen: ldIso },
+  lt: { parse: (s) => J.LocalTime.parse(s), gen: ltIso },
+  ldt: { parse: (s) => J.LocalDateTime.parse(s), gen: ldtIso },
+  inst: { parse: (s) => J.Instant.parse(s), gen: null },
+  odt: { parse: (s) => J.OffsetDateTime.parse(s), gen: odtIso },
+  ot: { parse: (s) => J.OffsetTime.parse(s), gen: otIso },
+  ym: { parse: (s) => J.YearMonth.parse(s), gen: ymIso },
+  md: { parse: (s) => J.MonthDay.parse(s), gen: mdIso },
+  year: { parse: (s) => J.Year.of(Number(s)), gen: (tc) => String(year(tc)) },
+};
+
+/** The generic Temporal methods of one kind, compared on one value. */
+async function temporalMethods(tc, kind, v, fields, units) {
+  const T = KINDS[kind].parse;
+  // (OffsetDateTime's field set is checked by TestHegelOffsetDateTimeFieldsAgreeWithJava)
+  if (kind !== "odt") await agree(`${kind}.fields`, () => fieldsOf(T(v)), `${kind}.fields`, v);
+  const f = pick(tc, fields);
+  // ranges bounded by Java's billion-year or long-sized limits are the port's documented model
+  if (!["YEAR", "YEAR_OF_ERA", "PROLEPTIC_MONTH", "WEEK_BASED_YEAR", "EPOCH_DAY", "INSTANT_SECONDS"].includes(f)) {
+    await agree(`${kind}.range ${f}`, () => T(v).range(field(f)), `${kind}.range`, v, f);
+  }
+  // (an unsupported field throws the plain DateTimeException: js-joda/14, TestHegelUnsupportedUnitsThrowUnsupportedTemporalTypeException)
+  if (typeof T(v).isSupported === "function" && !T(v).isSupported(field(f))) count("known-js-joda/14");
+  else {
+    const value = fieldValue(tc, T(v), field(f));
+    await agree(`${kind}.with ${f} ${value}`, () => T(v).with(field(f), value), `${kind}.with`, v, f, value);
