+const OFFSET_LETTERS = { X: [1, 2, 3, 4, 5], x: [1, 2, 3, 4, 5], Z: [1, 2, 3, 5] };
+const BAD_LETTERS = { d: [3], H: [3], s: [3], m: [3], S: [10], F: [2], j: [1], p: [1], X: [6], x: [6], Z: [6], D: [4] };
