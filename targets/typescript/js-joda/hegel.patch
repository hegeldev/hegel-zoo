+// Hegel zoo: bundle @js-joda/core's ES-module sources (extension-less imports, built upstream by
+// rollup + babel into an uncommitted dist/) into one ES module under .hegel/dist with esbuild, so
+// the tests import the library at the pinned commit without the repository's devDependencies.
+// Run from packages/core after the .hegel install.
+import { execFileSync } from "node:child_process";
+import { mkdirSync } from "node:fs";
+
+const esbuild = ".hegel/node_modules/esbuild/bin/esbuild";
+mkdirSync(".hegel/dist", { recursive: true });
+execFileSync(esbuild, ["src/js-joda.js", "--bundle", "--format=esm", "--platform=node", "--log-level=warning", "--outfile=.hegel/dist/js-joda.mjs"], { stdio: "inherit" });
+console.log("built .hegel/dist/js-joda.mjs");
diff --git a/packages/core/hegel/hegel-gen.mjs b/packages/core/hegel/hegel-gen.mjs
new file mode 100644
index 0000000..b5bd5a3
--- /dev/null
+++ b/packages/core/hegel/hegel-gen.mjs
@@ -0,0 +1,468 @@
+// Hegel zoo: the generators behind the js-joda properties, as values built from Hegel's
+// combinators, and the pure functions that render what they draw.
+//
+// Temporal values are drawn as their parts and rendered as the ISO strings both libraries share,
+// by Java's toString rules (a signed year past 9999, `:ss` only when needed, 3, 6 or 9 fraction
+// digits, `Z` or `+HH:MM[:SS]`), so a divergent toString shows up as a mismatch rather than a bad
+// input. An Instant is the exception: it is drawn as {s, nano} and the property asks Java for its
+// text, since Instant.toString is Java's to define. Duration and Period texts are records over
+// Java's grammar rendered by `renderDuration`/`renderPeriod`, and the ways they are broken are
+// data too (a named tweak, an edit, a fixed text). A pattern string is a list of pieces (a letter
+// with its count, padding and optional section, and the separator after it) rendered by
+// `renderPattern`; the parsing property draws them inside what Java accepts and js-joda is not
+// known to mis-parse (`parsePatternOf`). An edit of a formatted text is a record whose position is
+// taken modulo the live length when `mutate` applies it, so the shrinker can delete an edit or
+// shrink the text under it. Nothing here touches js-joda or the JVM.
+
+import { gs } from "./hegel-zoo.mjs";
+
+// ---------------------------------------------------------------- generator helpers
+
+export const ints = (lo, hi) => gs.integers({ minValue: lo, maxValue: hi });
+
+/** oneOf with weights: `weighted([45, a], [55, b])` draws a 45 times in 100; shrinks towards the first choice. */
+export function weighted(...choices) {
+  if (choices.length === 1) return choices[0][1];
+  const total = choices.reduce((sum, [w]) => sum + w, 0);
+  return ints(0, total - 1).flatMap((r) => {
+    for (const [w, g] of choices) {
+      if (r < w) return g;
+      r -= w;
+    }
+    throw new Error("unreachable");
+  });
+}
+
+/** True pct percent of the time; shrinks to false. */
+export const chance = (pct) => ints(0, 99).map((r) => r >= 100 - pct);
+/** A draw from g pct percent of the time, else undefined (listed first: shrinks to absent). */
+export const maybe = (pct, g) => weighted([100 - pct, gs.just(undefined)], [pct, g]);
+/** A record with a `kind` from `kinds` and the fields `fields(kind)` gives for it. */
+export const byKind = (kinds, fields) => gs.sampledFrom(kinds).flatMap((kind) => gs.record({ kind: gs.just(kind), ...fields(kind) }));
+
+export const MAX_SAFE = Number.MAX_SAFE_INTEGER;
+
+// ---------------------------------------------------------------- the calendar, by Java's toString rules
+
+export const isLeap = (y) => y % 4 === 0 && (y % 100 !== 0 || y % 400 === 0);
+export const monthLength = (y, m) => (m === 2 ? (isLeap(y) ? 29 : 28) : [4, 6, 9, 11].includes(m) ? 30 : 31);
+
+/** Java's year: four digits at least, a sign past 9999. */
+export function isoYear(y) {
+  const sign = y < 0 ? "-" : y > 9999 ? "+" : "";
+  return sign + String(Math.abs(y)).padStart(4, "0");
+}
+export const p2 = (x) => String(x).padStart(2, "0");
+export const ldIsoOf = ({ y, m, d }) => `${isoYear(y)}-${p2(m)}-${p2(d)}`;
+
+/** Java's LocalTime.toString: HH:mm, :ss when needed, then 3, 6 or 9 fraction digits. */
+export function ltIsoOf(h, mi, s, nano) {
+  let out = `${p2(h)}:${p2(mi)}`;
+  if (s > 0 || nano > 0) {
+    out += `:${p2(s)}`;
+    if (nano > 0) {
+      if (nano % 1000000 === 0) out += "." + String(nano / 1000000).padStart(3, "0");
+      else if (nano % 1000 === 0) out += "." + String(nano / 1000).padStart(6, "0");
+      else out += "." + String(nano).padStart(9, "0");
+    }
+  }
+  return out;
+}
+
+/** Java's ZoneOffset.getId: Z, or +HH:MM, or +HH:MM:SS. */
+export function offIsoOf(total) {
+  if (total === 0) return "Z";
+  const a = Math.abs(total);
+  const h = Math.floor(a / 3600), m = Math.floor((a % 3600) / 60), s = a % 60;
+  return (total < 0 ? "-" : "+") + p2(h) + ":" + p2(m) + (s ? ":" + p2(s) : "");
+}
+
+// ---------------------------------------------------------------- dates, times, offsets
+
+const YEAR_EDGES = [-999999, -999998, -10000, -9999, -1000, -999, -1, 0, 1, 999, 1000, 1582, 1600, 1970, 2000, 9999, 10000, 999998, 999999];
+/** A year: 1900-2100 55% of the time, 0-9999 20, anywhere in js-joda's range 13, else an edge of the range, of the sign or of the four digits. */
+export const year = weighted([55, ints(1900, 2100)], [20, ints(0, 9999)], [13, ints(-999999, 999999)], [12, gs.sampledFrom(YEAR_EDGES)]);
+/** A day of a month of `len` days: any 70% of the time, else the first, the 28th or one of the last two. */
+const dayOf = (len) => weighted([70, ints(1, len)], [30, gs.sampledFrom([1, 28, len - 1, len])]);
+/** A valid date, the day drawn for its month. */
+export const ymd = gs.record({ y: year, m: ints(1, 12) }).flatMap(({ y, m }) => gs.record({ y: gs.just(y), m: gs.just(m), d: dayOf(monthLength(y, m)) }));
+
+const NANO_EDGES = [1, 999, 1000, 999999, 1000000, 500000000, 999999999];
+/** Nanoseconds of a second: 0 35% of the time, whole milliseconds 20, whole microseconds 15, any 20, an edge of the three printing shapes 10. */
+export const nanos = weighted([35, gs.just(0)], [20, ints(0, 999).map((x) => x * 1000000)], [15, ints(0, 999999).map((x) => x * 1000)], [20, ints(0, 999999999)], [10, gs.sampledFrom(NANO_EDGES)]);
+/** Hour, minute and second: any (the second 0 a quarter of the time) 85% of the time, else each at an end of its range. */
+export const hms = weighted(
+  [85, gs.record({ h: ints(0, 23), mi: ints(0, 59), s: weighted([25, gs.just(0)], [75, ints(0, 59)]) })],
+  [15, gs.record({ h: gs.sampledFrom([0, 23]), mi: gs.sampledFrom([0, 59]), s: gs.sampledFrom([0, 59]) })],
+);
+const OFFSET_EDGES = [-64800, 64800, 1, -1, 3599, -3599, 30600, -12600, 45900];
+/** An offset in seconds: zero 30% of the time, whole hours 30, whole minutes 20, any 15, an edge (the +-18:00 bounds, a second off zero or an hour, three real half- and quarter-hour zones) 5. */
+export const offsetSeconds = weighted([30, gs.just(0)], [30, ints(-18, 18).map((h) => h * 3600)], [20, ints(-18 * 60, 18 * 60).map((m) => m * 60)], [15, ints(-64800, 64800)], [5, gs.sampledFrom(OFFSET_EDGES)]);
+
+export const ldIso = ymd.map(ldIsoOf);
+export const ltIso = gs.tuples(hms, nanos).map(([t, nano]) => ltIsoOf(t.h, t.mi, t.s, nano));
+export const ldtIso = gs.tuples(ldIso, ltIso).map(([d, t]) => `${d}T${t}`);
+export const offIso = offsetSeconds.map(offIsoOf);
+export const odtIso = gs.tuples(ldtIso, offIso).map(([t, o]) => t + o);
+export const otIso = gs.tuples(ltIso, offIso).map(([t, o]) => t + o);
+export const ymIso = gs.record({ y: year, m: ints(1, 12) }).map(({ y, m }) => `${isoYear(y)}-${p2(m)}`);
+/** A month-day: the day of a leap year's month, its last day 20% of the time. */
+export const mdIso = ints(1, 12)
+  .flatMap((m) => gs.record({ m: gs.just(m), d: weighted([80, ints(1, monthLength(2000, m))], [20, gs.just(monthLength(2000, m))]) }))
+  .map(({ m, d }) => `--${p2(m)}-${p2(d)}`);
+
+// The epoch seconds of 0000-01-01T00:00Z and 9999-12-31T23:59:59Z, of js-joda's Instant range
+// (years -1000000..1000000, where Java's run to a billion) and of the first and last second of
+// its LocalDate years -999999..999999.
+const Y0 = -62167219200, Y9999 = 253402300799;
+const INSTANT_MIN = -31619119219200, INSTANT_MAX = 31494816403199;
+const HELD_MIN = -31619087596800, HELD_MAX = 31494784780799;
+const EPOCH_EDGES = [0, -1, 1, Y9999, Y9999 + 1, Y0, Y0 - 1, INSTANT_MAX, INSTANT_MIN, INSTANT_MAX + 1, INSTANT_MIN - 1, MAX_SAFE, -MAX_SAFE];
+/** An epoch second: within 95 years of the epoch 40% of the time, in years 0000-9999 30, in js-joda's Instant range 20, an edge 10 (some beyond js-joda's years, which the accepted-difference gate counts). */
+export const epochSecond = weighted([40, ints(-3e9, 3e9)], [30, ints(Y0, Y9999)], [20, ints(INSTANT_MIN, INSTANT_MAX)], [10, gs.sampledFrom(EPOCH_EDGES)]);
+/** The same shape cut to the seconds whose Instant js-joda holds (years -999999..999999). */
+export const epochSecondHeld = weighted([40, ints(-3e9, 3e9)], [30, ints(Y0, Y9999)], [20, ints(HELD_MIN, HELD_MAX)], [10, gs.sampledFrom([0, -1, 1, Y9999, Y9999 + 1, Y0, Y0 - 1, HELD_MAX, HELD_MIN])]);
+/** An Instant as its parts; the property asks Java for its text. */
+export const instant = gs.record({ s: epochSecond, nano: nanos });
+export const instantHeld = gs.record({ s: epochSecondHeld, nano: nanos });
+
+/** A value of each kind, as the ISO text both libraries parse (an Instant as {s, nano}, see `instant`). */
+export const valueOf = { ld: ldIso, lt: ltIso, ldt: ldtIso, inst: instant, odt: odtIso, ot: otIso, ym: ymIso, md: mdIso, year: year.map(String) };
+
+// ---------------------------------------------------------------- amounts
+
+// 1e12/1e15, the safe-integer bounds, the epoch days of Java's LocalDate bounds, the epoch seconds of Java's Instant bounds
+const AMOUNT_EDGES = [0, 1, -1, 1e12, -1e12, 1e15, -1e15, MAX_SAFE, -MAX_SAFE, 365243219162, -365243219162, 31556889864403199, -31557014167219200];
+/** An amount for plus/minus: within 100 40% of the time, within 100000 25, within a billion 20, within 1e13 10, an edge 5. */
+export const amount = weighted([40, ints(-100, 100)], [25, ints(-100000, 100000)], [20, ints(-1000000000, 1000000000)], [10, ints(-1e13, 1e13)], [5, gs.sampledFrom(AMOUNT_EDGES)]);
+/** An amount within 1000 70% of the time, else within ten million. */
+export const smallAmount = weighted([70, ints(-1000, 1000)], [30, ints(-1e7, 1e7)]);
+
+// ---------------------------------------------------------------- fields, units, adjusters
+
+export const CHRONO_FIELDS = ["NANO_OF_SECOND", "NANO_OF_DAY", "MICRO_OF_SECOND", "MICRO_OF_DAY", "MILLI_OF_SECOND", "MILLI_OF_DAY", "SECOND_OF_MINUTE", "SECOND_OF_DAY", "MINUTE_OF_HOUR", "MINUTE_OF_DAY", "HOUR_OF_AMPM", "CLOCK_HOUR_OF_AMPM", "HOUR_OF_DAY", "CLOCK_HOUR_OF_DAY", "AMPM_OF_DAY", "DAY_OF_WEEK", "ALIGNED_DAY_OF_WEEK_IN_MONTH", "ALIGNED_DAY_OF_WEEK_IN_YEAR", "DAY_OF_MONTH", "DAY_OF_YEAR", "EPOCH_DAY", "ALIGNED_WEEK_OF_MONTH", "ALIGNED_WEEK_OF_YEAR", "MONTH_OF_YEAR", "PROLEPTIC_MONTH", "YEAR_OF_ERA", "YEAR", "ERA", "INSTANT_SECONDS", "OFFSET_SECONDS"];
+export const DATE_FIELDS = CHRONO_FIELDS.slice(15, 28);
+export const TIME_FIELDS = CHRONO_FIELDS.slice(0, 15);
+export const ISO_FIELDS = { WEEK_OF_WEEK_BASED_YEAR: "WeekOfWeekBasedYear", WEEK_BASED_YEAR: "WeekBasedYear", QUARTER_OF_YEAR: "QuarterOfYear", DAY_OF_QUARTER: "DayOfQuarter" };
+export const DATE_UNITS = ["DAYS", "WEEKS", "MONTHS", "YEARS", "DECADES", "CENTURIES", "MILLENNIA", "ERAS"];
+export const TIME_UNITS = ["NANOS", "MICROS", "MILLIS", "SECONDS", "MINUTES", "HOURS", "HALF_DAYS"];
+export const ADJUSTERS = ["firstDayOfMonth", "lastDayOfMonth", "firstDayOfNextMonth", "firstDayOfYear", "lastDayOfYear", "firstDayOfNextYear", "firstInMonth", "lastInMonth", "dayOfWeekInMonth", "next", "nextOrSame", "previous", "previousOrSame"];
+
+/**
+ * What `with(field, v)` is given, resolved against the field's range by the property (`fieldValueOf`):
+ * a value inside the range 56% of the time (`x` taken modulo the range, clamped to +-1e9), one of
+ * its six ends or the values just outside them 24, else any amount.
+ */
+export const fieldValue = weighted(
+  [56, gs.record({ mode: gs.just("in"), x: ints(0, 2e9) })],
+  [24, gs.record({ mode: gs.just("edge"), i: ints(0, 5) })],
+  [20, gs.record({ mode: gs.just("amount"), a: amount })],
+);
+
+/** One of `main` most of the time, one of `odd` (fields or units the kind does not support) 4% of the time when there are any. */
+const mostly = (main, odd) => (odd.length ? weighted([96, gs.sampledFrom(main)], [4, gs.sampledFrom(odd)]) : gs.sampledFrom(main));
+
+/** The draws of the generic Temporal methods of one kind: the field and the value it is set to, the unit and the amount (small 70% of the time), another value `w` of the kind and the unit of `until`. */
+export const temporalCase = (kind, fields, units, oddFields = [], oddUnits = []) =>
+  gs.record({ f: mostly(fields, oddFields), fv: fieldValue, u: mostly(units, oddUnits), amt: weighted([70, smallAmount], [30, amount]), w: valueOf[kind], uu: mostly(units, oddUnits) });
+
+// ---------------------------------------------------------------- edits of a text
+
+const at = ints(0, 199);
+const op = (name, fields = {}) => gs.record({ op: gs.just(name), ...fields });
+/** One edit of a text: delete the character at a position (taken modulo the length), insert a digit or a separator there, replace it by a digit, append a tail, prepend a space, lower-case it, add to its first number, zero-pad or negate that number, or double its first digit. */
+export const edit = gs.oneOf(
+  op("delete", { at }),
+  op("insert", { at, ch: gs.sampledFrom(["0", "9", "1", "-", "+", " ", ":", "T", "Z", "."]) }),
+  op("replace", { at, ch: gs.sampledFrom(["0", "9", "3", "9"]) }),
+  op("append", { s: gs.sampledFrom([" ", "0", "Z", "x", "T00:00"]) }),
+  op("prepend"),
+  op("lower"),
+  op("bump", { by: gs.sampledFrom([1, 10, 30, 60, 100]) }),
+  op("zero-pad"),
+  op("negate"),
+  op("double-zero"),
+);
+
+/** `text` with the edits applied in turn. */
+export function mutate(text, edits) {
+  for (const e of edits) {
+    if (text.length === 0) return "0";
+    const i = e.at === undefined ? 0 : e.at % text.length;
+    switch (e.op) {
+      case "delete": text = text.slice(0, i) + text.slice(i + 1); break;
+      case "insert": text = text.slice(0, i) + e.ch + text.slice(i); break;
+      case "replace": text = text.slice(0, i) + e.ch + text.slice(i + 1); break;
+      case "append": text += e.s; break;
+      case "prepend": text = " " + text; break;
+      case "lower": text = text.toLowerCase(); break;
+      case "bump": text = text.replace(/\d+/, (d) => String(Number(d) + e.by)); break;
+      case "zero-pad": text = text.replace(/\d+/, (d) => "0" + d); break;
+      case "negate": text = text.replace(/\d+/, (d) => (Number(d) === 0 ? "-0" : "-" + d)); break;
+      default: text = text.replace(/\d/, "00");
+    }
+  }
+  return text;
+}
+
+// ---------------------------------------------------------------- Duration and Period texts
+
+const sign = gs.sampledFrom(["", "", "", "-", "+"]);
+const signed = (num) => gs.tuples(sign, num).map(([s, n]) => s + n);
+/** A number of a duration: below 100000 80% of the time, else below 1e12. */
+const durationNumber = weighted([80, ints(0, 99999)], [20, ints(0, 1e12)]).map(String);
+/** A number of a period: below 10000 80% of the time, else up to 2^31 (one past Java's int). */
+const periodNumber = weighted([80, ints(0, 9999)], [20, ints(0, 2147483648)]).map(String);
+
+/**
+ * A Duration text by Java's grammar `[-]P[nD][T[nH][nM][n[.f]S]]`, every number optionally
+ * signed: a days part 40% of the time; a time part 85%, with hours 50%, minutes 50%, seconds 70%
+ * (a fraction of 1, 3, 6 or 9 digits after `.` or `,` half the time).
+ */
+export const durationText = gs.record({
+  sign,
+  days: maybe(40, signed(durationNumber)),
+  time: maybe(85, gs.record({
+    h: maybe(50, signed(durationNumber)),
+    m: maybe(50, signed(durationNumber)),
+    s: maybe(70, gs.record({ num: signed(durationNumber), frac: maybe(50, gs.record({ sep: gs.sampledFrom([".", ","]), digits: ints(0, 999999999), width: gs.sampledFrom([1, 3, 6, 9]) })) })),
+  })),
+}).map(renderDuration);
+
+function renderDuration({ sign, days, time }) {
+  let t = sign + "P";
+  if (days !== undefined) t += days + "D";
+  if (time !== undefined) {
+    t += "T";
+    if (time.h !== undefined) t += time.h + "H";
+    if (time.m !== undefined) t += time.m + "M";
+    if (time.s !== undefined) {
+      const f = time.s.frac;
+      t += time.s.num + (f === undefined ? "" : f.sep + String(f.digits).padStart(f.width, "0").slice(0, 9)) + "S";
+    }
+  }
+  return t;
+}
+
+/** A Period text by Java's grammar `[-]P[nY][nM][nW][nD]`: years 60% of the time, months 60, weeks 30, days 60. */
+export const periodText = gs.record({ sign, y: maybe(60, signed(periodNumber)), m: maybe(60, signed(periodNumber)), w: maybe(30, signed(periodNumber)), d: maybe(60, signed(periodNumber)) }).map(renderPeriod);
+
+function renderPeriod({ sign, y, m, w, d }) {
+  const part = (v, letter) => (v === undefined ? "" : v + letter);
+  return sign + "P" + part(y, "Y") + part(m, "M") + part(w, "W") + part(d, "D");
+}
+
+/** The ways a well-formed text is broken, by name. */
+const TWEAKS = {
+  lower: (t) => t.toLowerCase(),
+  "trailing-x": (t) => t + "X",
+  "leading-space": (t) => " " + t,
+  "trailing-space": (t) => t + " ",
+  "no-T": (t) => t.replace("T", ""),
+  "no-P": (t) => t.replace("P", ""),
+  "no-S": (t) => t.replace("S", ""),
+  "letter-for-a-digit": (t) => t.replace(/\d/, "a"),
+  doubled: (t) => t + t,
+  "trailing-T1H": (t) => t + "T1H",
+};
+const DURATION_TWEAKS = ["lower", "trailing-x", "leading-space", "trailing-space", "no-T", "no-P", "no-S", "letter-for-a-digit", "doubled"];
+const PERIOD_TWEAKS = ["lower", "trailing-T1H", "trailing-x", "leading-space", "trailing-space", "doubled"];
+// texts at the edges of the grammar and of the number types: bare fractions, weeks, repeats, signs, Long and safe-integer bounds, empty parts
+const DURATION_TEXTS = ["PT1.5", "PT.5S", "PT1.S", "P1W", "PT1H1H", "PT-0.5S", "-PT-1S", "PT+-1S", "PT9223372036854775807S", "PT9223372036854775808S", "PT9007199254740993S", "P106751991167301D", "PT0S", "P0D", "P", "PT", "T1H", "P1DT", "PT1H1M1S1S"];
+const PERIOD_TEXTS = ["P", "P1Y2M3W4D", "P-1Y", "-P1Y-2M", "P2147483647D", "P2147483648D", "P1W1W", "P1D1Y", " P1D", "P1.5D", "P0D", "P-0D", "P+1Y", "PT1H", "P1DT", "1D"];
+
+/** A text 40% of the time as it is, else broken: by a named tweak (`tweakPct`% of the broken ones), an edit (`editPct`), or replaced by one of `texts`. */
+const breakable = (text, tweaks, tweakPct, editPct, texts) =>
+  gs.record({
+    text,
+    how: maybe(60, weighted([tweakPct, gs.sampledFrom(tweaks).map((tweak) => ({ tweak }))], [editPct, edit.map((e) => ({ edit: e }))], [100 - tweakPct - editPct, gs.sampledFrom(texts).map((replace) => ({ replace }))])),
+  }).map(broken);
+
+function broken({ text, how }) {
+  if (how === undefined) return text;
+  if (how.tweak !== undefined) return TWEAKS[how.tweak](text);
+  if (how.edit !== undefined) return mutate(text, [how.edit]);
+  return how.replace;
+}
+
+/** A Duration text, and what breaks it: junk around it, repeats, missing designators, case, bounds. */
+export const durationTextMutated = breakable(durationText, DURATION_TWEAKS, 29, 3, DURATION_TEXTS);
+/** A Period text likewise. */
+export const periodTextMutated = breakable(periodText, PERIOD_TWEAKS, 21, 4, PERIOD_TEXTS);
+
+// ---------------------------------------------------------------- offset texts
+
+const OFFSET_FORMS = ["id", "+HH", "+H", "+HHMM", "+HH:MM", "+HHMMSS", "+HH:MM:SS"];
+// zone names, an offset past 18 hours, single-digit hours, 60 minutes or seconds, wrong separators, empty and sign-only texts
+const OFFSET_TEXTS = ["Z", "z", "UTC", "GMT", "UT", "+0", "+00:00:00", "+19:00", "-18:00:01", "+18:00", "+1:00", "+01:60", "+01:00:60", "+01-00", "+0100:00", "", "+", "-", "+18", "-18"];
+
+/** The text of an offset of `total` seconds in `form`: Java's id, one of the six `+HH..` spellings (minutes or seconds dropped), or a fixed text. */
+export function offsetTextOf(total, form) {
+  const a = Math.abs(total), s = total < 0 ? "-" : "+";
+  const h = Math.floor(a / 3600), m = Math.floor((a % 3600) / 60), sec = a % 60;
+  switch (form) {
+    case "id": return offIsoOf(total);
+    case "+HH": return s + p2(h);
+    case "+H": return s + h;
+    case "+HHMM": return s + p2(h) + p2(m);
+    case "+HH:MM": return `${s}${p2(h)}:${p2(m)}`;
+    case "+HHMMSS": return s + p2(h) + p2(m) + p2(sec);
+    case "+HH:MM:SS": return `${s}${p2(h)}:${p2(m)}:${p2(sec)}`;
+    default: return form;
+  }
+}
+/** A text for ZoneOffset.of: an offset in one of Java's accepted forms, or a refused one. */
+export const offsetText = gs.record({ total: offsetSeconds, form: gs.sampledFrom([...OFFSET_FORMS, ...OFFSET_TEXTS]) }).map(({ total, form }) => offsetTextOf(total, form));
+
+// ---------------------------------------------------------------- patterns
+
+// Pattern letters whose output needs no locale text, with the counts Java accepts (and a few it
+// refuses, BAD_LETTERS), so that acceptance, output and parsing are all compared. Text letters
+// (G, E, a, B, z, O, MMM and up, QQQ and up) and the localized week letters (w W Y e c) need
+// @js-joda/locale and are left out; N and A stay under 2^53. (DD, nn.., NN.., AA.. and F:
+// MIN_WIDTH_LETTERS, TestHegelMinWidthPatternLettersAgreeWithJava.)
+export const DATE_LETTERS = { u: [1, 2, 3, 4, 5, 9], y: [1, 2, 3, 4, 5], M: [1, 2], L: [1, 2], d: [1, 2], D: [1, 3], Q: [1, 2], q: [1, 2] };
+export const TIME_LETTERS = { H: [1, 2], k: [1, 2], K: [1, 2], h: [1, 2], m: [1, 2], s: [1, 2], S: [1, 2, 3, 6, 9], n: [1], N: [1], A: [1] };
+export const OFFSET_LETTERS = { X: [1, 2, 3, 4, 5], x: [1, 2, 3, 4, 5], Z: [1, 2, 3, 5] };
+export const BAD_LETTERS = { d: [3], H: [3], s: [3], m: [3], S: [10], F: [2], j: [1], p: [1], X: [6], x: [6], Z: [6], D: [4] };
+export const SEPARATORS = ["-", ":", "/", ".", " ", "T", ",", "'T'", "' '", "'-'", "'''", "'o''clock'", "'text'", "#", "{", "}", "[", "]", "''"];
+// the separators Java accepts anywhere: no reserved character (# { }), no unknown letter (T), no `]` without its `[`, no unterminated literal (''')
+const VALID_SEPARATORS = ["-", ":", "/", ".", " ", ",", "'T'", "' '", "'-'", "'o''clock'", "'text'", "[", "''"];
+
+export const PATTERN_KINDS = {
+  ld: { ...DATE_LETTERS },
+  lt: { ...TIME_LETTERS },
+  ldt: { ...DATE_LETTERS, ...TIME_LETTERS },
+  odt: { ...DATE_LETTERS, ...TIME_LETTERS, ...OFFSET_LETTERS },
+  ot: { ...TIME_LETTERS, ...OFFSET_LETTERS },
+  ym: { u: [1, 4], y: [1, 2, 4], M: [1, 2], L: [1, 2], Q: [1, 2] },
+  md: { M: [1, 2], d: [1, 2] },
+  year: { u: [1, 2, 3, 4, 5], y: [1, 2, 3, 4, 5] },
+};
+/** The min-width letters (js-joda/17), F (js-joda/18) and the fixed-width neighbours they are written beside, per kind. */
+export const MIN_WIDTH_LETTERS = {
+  ld: { D: [2], F: [1], u: [4], M: [2], d: [2] },
+  lt: { n: [2, 3, 9], N: [2, 14], A: [2, 8], H: [2], m: [2], s: [2] },
+  ldt: { D: [2], n: [2, 3, 9], N: [2, 14], A: [2, 8], F: [1], u: [4], H: [2], m: [2], s: [2] },
+};
+
+/** A letter of `table` with one of its counts. */
+const counted = (table) => gs.sampledFrom(Object.keys(table)).flatMap((l) => gs.record({ l: gs.just(l), n: gs.sampledFrom(table[l]) }));
+
+// the widest text each letter prints for the drawn values: a signed nine-digit year, +HH:MM:SS, nano-of-day
+const WIDTH = { u: 10, y: 9, M: 2, L: 2, d: 2, D: 3, Q: 2, q: 2, H: 2, k: 2, K: 2, h: 2, m: 2, s: 2, S: 9, n: 9, N: 14, A: 8, X: 9, x: 9, Z: 9 };
+
+/**
+ * A pattern part: a letter of `letters` with one of its counts, padded with `p` 8% of the time (1-3
+ * of them, or, with `fit`, enough for the letter's widest text plus 0-3, so the pad never fails to
+ * print), in an optional section 10% (left unclosed a fifth of those); with `bad`, a letter or
+ * count Java refuses 8% of the time.
+ */
+function partOf(letters, { bad = false, fit = false } = {}) {
+  const good = counted(letters).flatMap((letter) =>
+    gs.record({
+      letter: gs.just(letter),
+      pad: maybe(8, fit ? ints(WIDTH[letter.l], WIDTH[letter.l] + 3) : ints(1, 3)),
+      bracket: maybe(10, weighted([80, gs.just("[]")], [20, gs.just("[")])),
+    }),
+  );
+  return bad ? weighted([92, good], [8, gs.record({ letter: counted(BAD_LETTERS) })]) : good;
+}
+
+function partText({ letter, pad, bracket }) {
+  let s = letter.l.repeat(letter.n);
+  if (pad !== undefined) s = "p".repeat(pad) + s;
+  if (bracket !== undefined) s = "[" + s + (bracket === "[]" ? "]" : "");
+  return s;
+}
+
+const isOffsetLetter = (l) => "xXZ".includes(l);
+const bare = (s) => s.replace(/'[^']*'/g, "");
+
+/**
+ * The text of a pattern: its parts joined by the separator drawn after each (the last one's is
+ * unused). One quote-bearing separator per pattern: a second one is written `-`, since two make a
+ * literal with two escaped quotes (js-joda/19, its pin). A separator that would leave an offset
+ * letter next to the following letter with nothing but brackets and quoted literals between (which
+ * `bare` removes) is written `-` too, since js-joda's `+HHMM`/`+HH:MM` parsers then swallow the
+ * next field's digits (js-joda/20, its pin). So is one that would leave a quarter letter next to
+ * the following letter with nothing but brackets between (a quoted literal does separate the
+ * digits): the quarter then reads the next field's digits too, which Java reports as a conflict
+ * with the date and js-joda does not check (js-joda/24, its pin).
+ */
+export function renderPattern(pieces) {
+  let out = "";
+  let quoted = false;
+  pieces.forEach(({ part, sep }, i) => {
+    out += partText(part);
+    if (i === pieces.length - 1) return;
+    if (sep.includes("''")) {
+      if (quoted) sep = "-";
+      quoted = true;
+    }
+    if (isOffsetLetter(part.letter.l) && /^[A-Za-z[\]]*$/.test(bare(sep))) sep = "-";
+    if ("Qq".includes(part.letter.l) && /^[[\]]*$/.test(sep.replace(/'[^']*'/g, "'"))) sep = "-";
+    out += sep;
+  });
+  return out;
+}
+
+/** A pattern of 1-5 parts from `letters` (a refused letter or count among them 8% of the time) with the separators between them, some of which Java refuses. */
+export const patternOf = (letters) => gs.arrays(gs.record({ part: partOf(letters, { bad: true }), sep: gs.sampledFrom(SEPARATORS) }), { minSize: 1, maxSize: 5 }).map(renderPattern);
+
+const timeFamily = (l) => ("hHkK".includes(l) ? "hour" : l === "m" ? "minute" : l === "s" ? "second" : "SnNA".includes(l) ? "fraction" : null);
+
+/**
+ * The pieces without a second part of one time-field family (a mutated text can make the two
+ * disagree, which js-joda does not cross-check: js-joda/22) and without a whole-day part (N, A)
+ * beside another time part (the same). Neither drop can empty the pattern.
+ */
+function crossCheckable(pieces) {
+  const seen = new Set();
+  const kept = pieces.filter(({ part }) => {
+    const family = timeFamily(part.letter.l);
+    if (family === null) return true;
+    if (seen.has(family)) return false;
+    seen.add(family);
+    return true;
+  });
+  const timeParts = kept.filter(({ part }) => timeFamily(part.letter.l) !== null).length;
+  return timeParts > 1 ? kept.filter(({ part }) => !"NA".includes(part.letter.l)) : kept;
+}
+
+/**
+ * A pattern for the parsing property: 1-5 parts from `letters` with the counts Java accepts, pads
+ * that fit and separators Java accepts, at most one part per time-field family and a whole-day
+ * field (N, A) only without other time fields (none at all when `lenient`, whose whole-day field
+ * takes a sign js-joda does not check: js-joda/22).
+ */
+export function parsePatternOf(letters, lenient) {
+  const table = lenient ? Object.fromEntries(Object.entries(letters).filter(([l]) => !"NA".includes(l))) : letters;
+  return gs.arrays(gs.record({ part: partOf(table, { fit: true }), sep: gs.sampledFrom(VALID_SEPARATORS) }), { minSize: 1, maxSize: 5 }).map((pieces) => renderPattern(crossCheckable(pieces)));
+}
+
+// ---------------------------------------------------------------- the predefined ISO formatters
+
+/** Formatter name -> the kinds of value it formats (the first is what its text is for). */
+export const ISO_FORMATTERS = {
+  ISO_LOCAL_DATE: ["ld", "ldt", "odt"], ISO_DATE: ["ld", "odt", "ldt"], ISO_LOCAL_TIME: ["lt", "ldt", "odt", "ot"], ISO_TIME: ["lt", "ot", "odt"],
+  ISO_LOCAL_DATE_TIME: ["ldt", "odt"], ISO_OFFSET_DATE_TIME: ["odt"], ISO_DATE_TIME: ["odt", "ldt"], ISO_INSTANT: ["inst", "odt"],
+  ISO_OFFSET_DATE: ["odt"], ISO_OFFSET_TIME: ["ot", "odt"], ISO_ZONED_DATE_TIME: ["odt"],
+};
+/** The three date-only variants: an optional offset and a fixed four-digit year in Java, the week and ordinal fields. */
+export const ISO_DATE_VARIANTS = { ISO_ORDINAL_DATE: ["ld", "odt"], ISO_WEEK_DATE: ["ld", "odt"], BASIC_ISO_DATE: ["ld", "odt"] };
+
+/** A case of the ISO formatters in `table`: the formatter, the kind of the value it formats and the value, the kind the text is parsed back as, an edit of the text half the time, a resolver style 30%. */
+export const isoFormatterCase = (table) =>
+  gs.sampledFrom(Object.keys(table)).flatMap((name) =>
+    gs.sampledFrom(table[name]).flatMap((kind) =>
+      gs.record({
+        name: gs.just(name),
+        kind: gs.just(kind),
+        value: valueOf[kind],
+        parseKind: gs.sampledFrom(table[name]),
+        edit: maybe(50, edit),
+        style: maybe(30, gs.sampledFrom(["SMART", "LENIENT", "STRICT"])),
+      }),
+    ),
+  );
