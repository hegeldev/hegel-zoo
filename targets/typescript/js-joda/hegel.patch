+function parseWith(kind, text, formatter) {
+  switch (kind) {
+    case "ld": return J.LocalDate.parse(text, formatter);
+    case "lt": return J.LocalTime.parse(text, formatter);
+    case "ldt": return J.LocalDateTime.parse(text, formatter);
+    case "odt": return J.OffsetDateTime.parse(text, formatter);
+    case "ot": return J.OffsetTime.parse(text, formatter);
+    case "ym": return J.YearMonth.parse(text, formatter);
+    case "md": return J.MonthDay.parse(text, formatter);
+    case "year": return J.Year.parse(text, formatter);
+    case "inst": return J.Instant.from(formatter.parse(text));
