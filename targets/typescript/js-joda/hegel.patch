+      parts.push(bad.repeat(pick(tc, BAD_LETTERS[bad])));
+    } else {
+      const l = pick(tc, names);
+      let part = l.repeat(pick(tc, letters[l]));
+      if (chance(tc, 8)) part = "p".repeat(n(tc, 1, 3)) + part;
