+// Hegel zoo: the java.time oracle. Starts `java hegel/Oracle.java` once (the JDK's source
+// launcher compiles it on the fly) and exposes `java(op, ...args)`, a promise of the answer:
+// `{ ok: true, value }` or `{ ok: false, error, message }` with `error` the exception's simple
+// class name. Requests are answered in order over a line protocol on stdin/stdout.
+import { spawn } from "node:child_process";
+import { createInterface } from "node:readline";
+import { after } from "node:test";
+
+const child = spawn("java", ["hegel/Oracle.java"], { stdio: ["pipe", "pipe", "pipe"] });
+let stderr = "";
+child.stderr.on("data", (d) => { stderr += d; });
+const pending = new Map();
+let next = 0;
+let dead = null;
+
+createInterface({ input: child.stdout }).on("line", (line) => {
+  const [id, status, ...rest] = line.split("\t");
+  const resolve = pending.get(Number(id));
+  if (!resolve) return;
+  pending.delete(Number(id));
+  resolve(status === "ok" ? { ok: true, value: rest.join("\t") } : { ok: false, error: rest[0], message: rest.slice(1).join("\t") });
+});
+const die = (why) => {
+  dead = { ok: false, error: "OracleUnavailable", message: `${why}${stderr ? ": " + stderr.trim() : ""}` };
+  for (const resolve of pending.values()) resolve(dead);
+  pending.clear();
+};
+child.on("error", (e) => die(`java could not be started (${e.message})`));
+child.on("exit", (code, signal) => die(`java exited (${code ?? signal})`));
+
+export function java(op, ...args) {
+  if (dead) return Promise.resolve(dead);
+  return new Promise((resolve) => {
+    const id = next++;
+    pending.set(id, resolve);
+    child.stdin.write(`${id}\t${op}\t${args.map(String).join("\t")}\n`);
+  });
+}
+
+after(() => {
+  child.stdin.end();
+  child.kill();
+});
