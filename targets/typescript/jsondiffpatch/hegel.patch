+  return JSON.stringify(x, (k, v) => (v instanceof RegExp ? `RegExp(${v.toString()})` : v === undefined ? "<undefined>" : v));
+}
+
+// ---------------------------------------------------------------- pins
+
+pin("PinJsondiffpatch1PrototypePropertyNamesAreMisdiffed", () => {
+  // an added property named after an Object.prototype member is not seen ...
+  assert.deepEqual(jdp.diff({}, { toString: 1 }), { toString: [1] });
+  // ... and removing one throws "functions are not supported"
+  assert.deepEqual(jdp.diff({ constructor: 0 }, {}), { constructor: [0, 0, 0] });
+});
+
+pin("PinJsondiffpatch2CloneThrowsOnRegExpWithSFlag", () => {
+  assert.equal(jdp.clone(/a/s).toString(), "/a/s");
+  assert.equal(jdp.clone(/a/d).toString(), "/a/d");
+});
+
+pin("PinJsondiffpatch3PatchTurnsFlaglessRegExpIntoString", () => {
+  const patched = jdp.patch(/a/, jdp.diff(/a/, /b/));
+  assert.ok(patched instanceof RegExp, `got ${typeof patched} ${JSON.stringify(patched)}`);
+  const patchedS = jdp.patch(/a/s, jdp.diff(/a/s, /b/s));
+  assert.ok(patchedS instanceof RegExp, `got ${typeof patchedS} ${JSON.stringify(patchedS)}`);
+  // and the other way round: a new value that merely looks like a RegExp string becomes one
+  const toArray = jdp.patch(/a/, jdp.diff(/a/, ["/b/i"]));
+  assert.deepEqual(toArray, ["/b/i"]);
+});
+
+pin("PinJsondiffpatch4PlainInstanceUsesLeakedDiffMatchPatch", () => {
+  const left = "x".repeat(80);
+  const right = `${"x".repeat(79)}y`;
+  jdpText.diff(left, right); // any text-diffing instance in the process primes the cache
+  const plain = jdp.create().diff(left, right);
+  assert.deepEqual(plain, [left, right], `an instance without diff-match-patch produced ${JSON.stringify(plain)}`);
+});
+
+pin("PinJsondiffpatch5ReverseMisplacesNestedItemDeltas", () => {
+  const dp = jdp.create({ objectHash: (o) => String(o.id) });
+  const a = [{ id: 0, v: 1 }];
+  const b = [{ id: 2, v: 0 }, { id: 1, v: 0 }, { id: 0, v: 1 }, { id: 0, v: 2 }];
+  const delta = dp.diff(a, b);
+  assert.deepEqual(delta, { 0: [{ id: 2, v: 0 }], 1: [{ id: 1, v: 0 }], 2: [{ id: 0, v: 1 }], 3: { v: [1, 2] }, _t: "a" });
+  assert.deepEqual(dp.unpatch(structuredClone(b), delta), a);
+});
+
+pin("PinJsondiffpatch6OwnJsonPatchApplierRejectsDashKey", () => {
+  const ops = jsonpatch.format(jdp.diff({}, { "-": 1 }));
+  assert.deepEqual(ops, [{ op: "add", path: "/-", value: 1 }]);
+  assert.deepEqual(fjp.applyPatch({}, structuredClone(ops), true).newDocument, { "-": 1 });
+  const own = {};
+  jsonpatch.patch(own, ops);
+  assert.deepEqual(own, { "-": 1 });
+});
+
+pin("PinJsondiffpatch7ObjectsWithATPropertyCannotBePatched", () => {
+  const delta = jdp.diff({ _t: 1 }, { _t: 2 });
+  assert.deepEqual(jdp.patch({ _t: 1 }, delta), { _t: 2 });
+});
+
+pin("PinJsondiffpatch8EqualRegExpsGetAModificationDelta", () => {
+  assert.equal(jdp.diff(/a/i, /a/i), undefined);
+  assert.equal(jdp.diff({ re: /a/ }, { re: /a/ }), undefined);
+});
+
+pin("PinJsondiffpatch9RegExpAgainstObjectIsDiffedAsAnEmptyObject", () => {
+  const toRegExp = jdp.patch({}, jdp.diff({}, /a/));
+  assert.ok(toRegExp instanceof RegExp && toRegExp.source === "a", `patch({}, diff({}, /a/)) gave ${JSON.stringify(toRegExp)}`);
+  const fromRegExp = jdp.patch(/a/, jdp.diff(/a/, { x: 1 }));
+  assert.deepEqual(fromRegExp, { x: 1 });
+});
