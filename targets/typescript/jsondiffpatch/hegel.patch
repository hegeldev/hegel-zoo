index 0000000..bf2ef2d
--- /dev/null
+++ b/packages/jsondiffpatch/test/hegel.test.mjs
@@ -0,0 +1,1020 @@
+// Hegel zoo: property tests for jsondiffpatch (benjamine/jsondiffpatch). See the target's
+// README.md for what is covered. Run with `node --test test/hegel.test.mjs` after building lib/.
+//
+// The properties are inverse pairs on the library's own API (patch/unpatch/reverse undo diff),
+// an LCS model for array deltas, fast-json-patch as the RFC 6902 oracle for the jsonpatch
+// formatter, and structural invariants of the documented delta format.
+
+import assert from "node:assert/strict";
+import fjp from "fast-json-patch";
+import * as jdp from "../lib/index.js";
+import * as jdpText from "../lib/with-text-diffs.js";
+import * as jsonpatch from "../lib/formatters/jsonpatch.js";
+import * as annotated from "../lib/formatters/annotated.js";
+import * as consoleFmt from "../lib/formatters/console.js";
+import * as htmlFmt from "../lib/formatters/html.js";
+import { property, pin, fail, count, n, pick, chance, word, same, show } from "./hegel-zoo.mjs";
+
+const copy = (v) => structuredClone(v);
+
+// ---------------------------------------------------------------- generators: JSON values
+
+// Property names: ordinary ones, numeric strings (a JSON Pointer index on an object), "" and
+// "-" (RFC 6902's end-of-array token, a plain key on an object), "/" and "~" (escaped in JSON
+// Pointers), non-ASCII, and (rarely) names that exist on Object.prototype. "__proto__" is
+// excluded: the library documents refusing it.
+const KEYS = ["a", "b", "c", "d", "e", "id", "name", "0", "1", "10", "", "-", "a/b", "~", "~1", "x y", "ünï", "_x"];
+const RARE_KEYS = ["constructor", "toString", "hasOwnProperty", "valueOf", "length"];
+const SHORT = ["", "a", "b", "abc", "hello world", "0", "-", "~", "/", "\n", "  ", "ünï", "😀", "null", "true", "@@ -1 +1 @@"];
+const WORDS = ["the", "quick", "brown", "fox", "jumps", "over", "lazy", "dog", "\n", " ", "  ", ",", ".",
+  "%", "%20", "+", "-", "@@", "😀", "ü", "\t", "\r", "a", "aa", "%0A"];
+const NUMBERS = [0, 1, -1, 2, 10, 42, -0, 0.5, -1.5, 1e21, 1e-7, 3.14159, 2 ** 53, Number.MAX_SAFE_INTEGER];
+
+function genKey(tc) {
+  return chance(tc, 3) ? pick(tc, RARE_KEYS) : pick(tc, KEYS);
+}
+
+/** A string of `lo`..`hi` words (code-point safe: the words are whole characters). */
+function genText(tc, lo, hi) {
+  return word(tc, WORDS, lo, hi);
+}
+
+function genPrimitive(tc, textish) {
+  switch (n(tc, 0, 5)) {
+    case 0: return null;
+    case 1: return chance(tc, 50);
+    case 2: return n(tc, -5, 5);
+    case 3: return pick(tc, NUMBERS);
+    case 4: return textish && chance(tc, 60) ? genText(tc, 15, 60) : pick(tc, SHORT);
+    default: return textish && chance(tc, 30) ? genText(tc, 5, 30) : pick(tc, SHORT);
+  }
+}
+
+/** A JSON value of depth at most `depth`. */
+function genValue(tc, depth, textish = false) {
+  if (depth <= 0 || chance(tc, 40)) {
+    return genPrimitive(tc, textish);
+  }
+  if (chance(tc, 50)) {
+    const len = n(tc, 0, 5);
+    const xs = [];
+    for (let i = 0; i < len; i++) {
+      xs.push(genValue(tc, depth - 1, textish));
+    }
+    return xs;
+  }
+  const o = {};
+  const len = n(tc, 0, 4);
+  for (let i = 0; i < len; i++) {
+    o[genKey(tc)] = genValue(tc, depth - 1, textish);
+  }
+  return o;
+}
+
+/** A root value: usually a container (a primitive root makes every case one replacement). */
+function genRoot(tc, textish) {
+  if (chance(tc, 10)) {
+    return genPrimitive(tc, textish);
+  }
+  const len = n(tc, 1, 5);
+  if (chance(tc, 50)) {
+    const xs = [];
+    for (let i = 0; i < len; i++) {
+      xs.push(genValue(tc, 2, textish));
+    }
+    return xs;
+  }
+  const o = {};
+  for (let i = 0; i < len; i++) {
+    o[genKey(tc)] = genValue(tc, 2, textish);
+  }
+  return o;
+}
+
+/** An edit of the string: insert/delete/replace/duplicate a run of characters, on code points. */
+function editText(tc, s) {
+  const cs = Array.from(s);
+  const ops = n(tc, 1, 3);
+  for (let k = 0; k < ops; k++) {
+    const i = n(tc, 0, cs.length);
+    const len = Math.min(n(tc, 0, 6), cs.length - i);
+    switch (n(tc, 0, 3)) {
+      case 0: cs.splice(i, 0, ...Array.from(genText(tc, 1, 4))); break;
+      case 1: cs.splice(i, len); break;
+      case 2: cs.splice(i, len, ...Array.from(genText(tc, 1, 4))); break;
+      default: cs.splice(i, 0, ...cs.slice(i, i + len)); break;
+    }
+  }
+  return cs.join("");
+}
+
+function shuffle(tc, xs) {
+  for (let i = xs.length - 1; i > 0; i--) {
+    const j = n(tc, 0, i);
+    [xs[i], xs[j]] = [xs[j], xs[i]];
+  }
+}
+
+/**
+ * A value derived from `v` by a few edits. Unchanged parts are the same references as in `v`
+ * when `share` (so array items can match by reference) and deep copies otherwise.
+ */
+function edit(tc, v, share, depth, textish = false) {
+  if (chance(tc, 10)) {
+    return genValue(tc, 2, textish);
+  }
+  if (Array.isArray(v)) {
+    const xs = v.map((x) => (share ? x : copy(x)));
+    const ops = n(tc, 0, 3);
+    for (let k = 0; k < ops; k++) {
+      const i = xs.length ? n(tc, 0, xs.length - 1) : 0;
+      switch (n(tc, 0, 7)) {
+        case 0: if (xs.length) xs.splice(i, 1); break;
+        case 1: xs.splice(n(tc, 0, xs.length), 0, genValue(tc, depth - 1, textish)); break;
+        case 2: if (xs.length > 1) { const [x] = xs.splice(i, 1); xs.splice(n(tc, 0, xs.length), 0, x); } break;
+        case 3: if (xs.length) xs.splice(i, 0, xs[i]); break;
+        case 4: case 5: if (xs.length) xs[i] = edit(tc, xs[i], share, depth - 1, textish); break;
+        case 6: xs.reverse(); break;
+        default: shuffle(tc, xs); break;
+      }
+    }
+    return xs;
+  }
+  if (v !== null && typeof v === "object") {
+    const o = {};
+    for (const k of Object.keys(v)) {
+      o[k] = share ? v[k] : copy(v[k]);
+    }
+    const keys = Object.keys(o);
+    const ops = n(tc, 0, 3);
+    for (let k = 0; k < ops; k++) {
+      const key = keys.length ? pick(tc, keys) : genKey(tc);
+      switch (n(tc, 0, 4)) {
+        case 0: delete o[key]; break;
+        case 1: o[genKey(tc)] = genValue(tc, depth - 1, textish); break;
+        case 2: if (Object.hasOwn(o, key)) { const x = o[key]; delete o[key]; o[genKey(tc)] = x; } break;
+        default: if (Object.hasOwn(o, key)) o[key] = edit(tc, o[key], share, depth - 1, textish); break;
+      }
+    }
+    return o;
+  }
+  if (typeof v === "string" && v.length > 0 && chance(tc, 60)) {
+    return editText(tc, v);
+  }
+  return chance(tc, 40) ? genPrimitive(tc, textish) : v;
+}
+
+// ---------------------------------------------------------------- generators: id lists
+
+const idHash = (o) => (o !== null && typeof o === "object" && !Array.isArray(o) && "id" in o ? String(o.id) : undefined);
+
+function genIdItem(tc) {
+  return { id: n(tc, 0, 5), v: genValue(tc, 1) };
+}
+
+function genIdList(tc) {
+  const len = n(tc, 0, 7);
+  const xs = [];
+  for (let i = 0; i < len; i++) {
+    xs.push(genIdItem(tc));
+  }
+  return xs;
+}
+
+/** Edits of an id list: delete, insert, move, change an item's payload (matched by id). */
+function editIdList(tc, v) {
+  const xs = v.map(copy);
+  const ops = n(tc, 0, 4);
+  for (let k = 0; k < ops; k++) {
+    const i = xs.length ? n(tc, 0, xs.length - 1) : 0;
+    switch (n(tc, 0, 5)) {
+      case 0: if (xs.length) xs.splice(i, 1); break;
+      case 1: xs.splice(n(tc, 0, xs.length), 0, genIdItem(tc)); break;
+      case 2: if (xs.length > 1) { const [x] = xs.splice(i, 1); xs.splice(n(tc, 0, xs.length), 0, x); } break;
+      case 3: if (xs.length) xs[i] = { id: xs[i].id, v: edit(tc, xs[i].v, false, 1) }; break;
+      case 4: shuffle(tc, xs); break;
+      default: if (xs.length) xs[i] = { ...xs[i], extra: genPrimitive(tc) }; break;
+    }
+  }
+  return xs;
+}
+
+// ---------------------------------------------------------------- a case: two values + options
+
+/** Draw (a, b, options, instance, mode). `text` cases use the with-text-diffs entry point. */
+function genCase(tc, allowText = true) {
+  const mode = pick(tc, allowText ? ["plain", "plain", "shared", "idlist", "text"] : ["plain", "plain", "shared", "idlist"]);
+  count(`mode:${mode}`);
+  const textish = mode === "text";
+  let a;
+  let b;
+  const options = {};
+  if (mode === "idlist") {
+    a = genIdList(tc);
+    b = chance(tc, 10) ? genIdList(tc) : editIdList(tc, a);
+    options.objectHash = idHash;
+  } else {
+    a = genRoot(tc, textish);
+    b = chance(tc, 15) ? genRoot(tc, textish) : edit(tc, a, mode === "shared", 3, textish);
+  }
+  const r = n(tc, 0, 99);
+  if (r < 20) {
+    options.arrays = { detectMove: false };
+  } else if (r < 40) {
+    options.arrays = { includeValueOnMove: true };
+  }
+  if (chance(tc, 15)) {
+    options.matchByPosition = chance(tc, 50);
+  }
+  if (chance(tc, 20)) {
+    options.cloneDiffValues = true;
+  }
+  if (chance(tc, 15)) {
+    options.omitRemovedValues = true;
+  }
+  if (mode === "text" && chance(tc, 60)) {
+    options.textDiff = { minLength: pick(tc, [5, 20, 60, 200]) };
+  }
+  for (const k of Object.keys(options)) {
+    count(`opt:${k}`);
+  }
+  const mod = mode === "text" ? jdpText : jdp;
+  const dp = Object.keys(options).length === 0 && chance(tc, 50) ? mod : mod.create(options);
+  return { a, b, options, dp, mode };
+}
+
+// ---------------------------------------------------------------- helpers
+
+function hasTextDiff(delta) {
+  if (Array.isArray(delta)) {
+    return delta.length === 3 && delta[2] === 2;
+  }
+  if (delta !== null && typeof delta === "object") {
+    return Object.keys(delta).some((k) => k !== "_t" && hasTextDiff(delta[k]));
+  }
+  return false;
+}
+
+function collectRefs(v, set) {
+  if (v !== null && typeof v === "object") {
+    set.add(v);
+    for (const k of Object.keys(v)) {
+      collectRefs(v[k], set);
+    }
+  }
+}
+
+/** Objects reachable from the delta's values (added/old/new values), not the delta's own nodes. */
+function deltaValueRefs(delta, set) {
+  if (Array.isArray(delta)) {
+    for (const x of delta.slice(0, 2)) {
+      collectRefs(x, set);
+    }
+  } else if (delta !== null && typeof delta === "object") {
+    for (const k of Object.keys(delta)) {
+      if (k !== "_t") {
+        deltaValueRefs(delta[k], set);
+      }
+    }
+  }
+}
+
+function jsonRoundTrip(v) {
+  return JSON.parse(JSON.stringify(v));
+}
+
+/** Does any object in v have an own property named after an Object.prototype member? (bug jsondiffpatch/1) */
+function hasProtoKey(v) {
+  if (Array.isArray(v)) {
+    return v.some(hasProtoKey);
+  }
+  if (v !== null && typeof v === "object") {
+    return Object.keys(v).some((k) => RARE_KEYS.includes(k) || hasProtoKey(v[k]));
+  }
+  return false;
+}
+
+/**
+ * Does the delta have an array delta with an item delta (a matched item changed: a nested
+ * delta or a modification at a right index) next to insertions, deletions or moves? `reverse`
+ * misplaces those (bug jsondiffpatch/5), so unpatch and the reversed delta are wrong.
+ */
+function hasNestedItemDeltaWithSiblings(delta) {
+  if (Array.isArray(delta) || delta === null || typeof delta !== "object") {
+    return false;
+  }
+  const keys = Object.keys(delta).filter((k) => k !== "_t");
+  if (delta._t === "a") {
+    const insertion = (k) => Array.isArray(delta[k]) && delta[k].length === 1;
+    const itemDelta = keys.some((k) => !k.startsWith("_") && !insertion(k));
+    const siblings = keys.some((k) => k.startsWith("_") || insertion(k));
+    if (itemDelta && siblings) {
+      return true;
+    }
+  }
+  return keys.some((k) => hasNestedItemDeltaWithSiblings(delta[k]));
+}
+
+/**
+ * Record a mismatch: `fail` unless the case has the shape of a recorded bug, in which case the
+ * bug is counted and the case ends (the bug's pin keeps it visible).
+ */
+function mismatch(message, known) {
+  if (known) {
+    count(known);
+    throw new Known(known);
+  }
+  fail(message);
+}
+
+class Known extends Error {}
+
+/** f(), or a mismatch "`label` threw ..." (a known bug's crash counts as that bug). */
+function attempt(label, f, ctx, known) {
+  try {
+    return f();
+  } catch (e) {
+    if (e instanceof Known) {
+      throw e;
+    }
+    return mismatch(`${label} threw ${e.message}: ${ctx()}`, known);
+  }
+}
+
+/** Run body; a `Known` escape ends the case quietly. */
+function tolerant(body) {
+  try {
+    body();
+  } catch (e) {
+    if (!(e instanceof Known)) {
+      throw e;
+    }
+  }
+}
+
+/** Structural equality that also compares Dates by time and RegExps by source and flags. */
+function eq(a, b) {
+  if (a instanceof Date || b instanceof Date) {
+    return a instanceof Date && b instanceof Date && a.getTime() === b.getTime();
+  }
+  if (a instanceof RegExp || b instanceof RegExp) {
+    return a instanceof RegExp && b instanceof RegExp && a.source === b.source && a.flags === b.flags;
+  }
+  if (Array.isArray(a) || Array.isArray(b)) {
+    return Array.isArray(a) && Array.isArray(b) && a.length === b.length && a.every((x, i) => eq(x, b[i]));
+  }
+  if (a !== null && b !== null && typeof a === "object" && typeof b === "object") {
+    const ka = Object.keys(a).sort();
+    const kb = Object.keys(b).sort();
+    return ka.length === kb.length && ka.every((k, i) => k === kb[i] && eq(a[k], b[k]));
+  }
+  return a === b;
+}
+
+function lcsLength(xs, ys, match) {
+  const m = ys.length;
+  let prev = new Array(m + 1).fill(0);
+  for (let i = 1; i <= xs.length; i++) {
+    const cur = new Array(m + 1).fill(0);
+    for (let j = 1; j <= m; j++) {
+      cur[j] = match(xs[i - 1], ys[j - 1]) ? prev[j - 1] + 1 : Math.max(prev[j], cur[j - 1]);
+    }
+    prev = cur;
+  }
+  return prev[m];
+}
+
+// ---------------------------------------------------------------- property 1: inverse pairs
+
+property("TestHegelPatchUnpatchAndReverseInvertDiff", (tc) => tolerant(() => {
+  const { a, b, options, dp, mode } = genCase(tc);
+  const a0 = copy(a);
+  const b0 = copy(b);
+  // bug jsondiffpatch/1: properties named after Object.prototype members are misdiffed
+  const proto = hasProtoKey(a) || hasProtoKey(b) ? "bug/jsondiffpatch-1" : undefined;
+  let delta;
+  try {
+    delta = dp.diff(a, b);
+  } catch (e) {
+    mismatch(`diff threw ${e.message}: a=${show(a0)} b=${show(b0)}`, proto);
+  }
+  const ctx = () => `a=${show(a0)} b=${show(b0)} options=${show(Object.keys(options))} mode=${mode} delta=${show(delta)}`;
+  if (!same(a, a0) || !same(b, b0)) {
+    fail(`diff mutated its inputs: ${ctx()} now a=${show(a)} b=${show(b)}`);
+  }
+  if (delta === undefined) {
+    count("delta:none");
+    if (!same(a, b)) {
+      mismatch(`no delta for different values: ${ctx()}`, proto);
+    }
+    return;
+  }
+  count("delta:some");
+  if (hasTextDiff(delta)) {
+    count("delta:text");
+  }
+  // the delta is plain JSON: serialising it loses nothing (documented "pure JSON serializable")
+  const wire = jsonRoundTrip(delta);
+  if (!same(wire, delta)) {
+    fail(`delta is not JSON: ${ctx()} wire=${show(wire)}`);
+  }
+  let patched;
+  try {
+    patched = dp.patch(copy(a), delta);
+  } catch (e) {
+    fail(`patch threw ${e.message}: ${ctx()}`);
+  }
+  if (!same(patched, b)) {
