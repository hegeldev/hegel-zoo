+{
+	// Hegel zoo: compile src/ to plain ES modules under .hegel/dist (a build product outside the
+	// patch). Upstream builds with `tsc --build tsconfig.lib.json` + rolldown; the sources import
+	// each other as `./x.js`, so they cannot be run through Node's type stripping directly. The
+	// @tsconfig/* presets are devDependencies (not installed), hence the explicit options.
+	"compilerOptions": {
+		"target": "es2022",
+		"module": "nodenext",
+		"moduleResolution": "nodenext",
+		"lib": ["es2024", "ESNext.Array", "ESNext.Collection", "ESNext.Iterator", "ESNext.Promise"],
+		"types": [],
+		"rewriteRelativeImportExtensions": true,
+		"declaration": false,
+		"sourceMap": false,
+		"rootDir": "../src",
+		"outDir": "../.hegel/dist",
+		"skipLibCheck": true,
+	},
+	"include": ["../src"],
+}
