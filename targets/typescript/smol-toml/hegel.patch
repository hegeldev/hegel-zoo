index 0000000..08b31c3
--- /dev/null
+++ b/test/hegel-toml.mjs
@@ -0,0 +1,779 @@
+// Hegel zoo: the tomllib oracle bridge, the canonical value form shared with it, and the
+// generators used by the properties (TOML documents with a value model, JavaScript values for
+// stringify, mutations for the rejection differential).
+
+import { execFileSync, spawn } from "node:child_process";
+import { mkdtempSync, openSync, readSync, rmSync, writeSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { dirname, join } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+import { chance, count, n, pick, word } from "./hegel-zoo.mjs";
+
+const here = dirname(fileURLToPath(import.meta.url));
+
+// The library under test: src/ compiled by the pinned TypeScript into .hegel/dist (see
+// tsconfig.hegel.json and the target's [run] setup).
+export const lib = await import(pathToFileURL(join(here, "..", ".hegel", "dist", "index.js")));
+export const { parse, stringify, TomlDate, TomlError } = lib;
+
+// ---------------------------------------------------------------- the oracle, held open
+
+let oracle = null;
+
+function startOracle() {
+  execFileSync("python3", ["-c", "import tomllib"], { stdio: "ignore" });
+  const dir = mkdtempSync(join(tmpdir(), "hegel-toml-"));
+  const req = join(dir, "req");
+  const resp = join(dir, "resp");
+  execFileSync("mkfifo", [req, resp]);
+  const child = spawn("python3", ["-u", join(here, "hegel-toml-oracle.py"), req, resp], {
+    stdio: ["ignore", "inherit", "inherit"],
+  });
+  child.unref();
+  const wfd = openSync(req, "w");
+  const rfd = openSync(resp, "r");
+  process.on("exit", () => {
+    try { child.kill(); } catch {}
+    try { rmSync(dir, { recursive: true, force: true }); } catch {}
+  });
+  const buf = Buffer.alloc(1 << 16);
+  let pending = "";
+  return {
+    call(obj) {
+      // Lone surrogates cannot cross as UTF-8; escape every surrogate code unit.
+      const line = JSON.stringify(obj).replace(/[\ud800-\udfff]/g, (c) => "\\u" + c.charCodeAt(0).toString(16).padStart(4, "0"));
+      writeSync(wfd, line + "\n");
+      for (;;) {
+        const nl = pending.indexOf("\n");
+        if (nl !== -1) {
+          const answer = pending.slice(0, nl);
+          pending = pending.slice(nl + 1);
+          return JSON.parse(answer);
+        }
+        const got = readSync(rfd, buf, 0, buf.length, null);
+        if (got === 0) throw new Error("the tomllib oracle went away");
+        pending += buf.toString("utf8", 0, got);
+      }
+    },
+  };
+}
+
+/** tomllib.loads(text): {ok: true, value} in canonical form, or {ok: false, error}. */
+export function pyParse(text) {
+  oracle ??= startOracle();
+  return oracle.call({ op: "parse", text });
+}
+
+// ---------------------------------------------------------------- canonical form
+
+export function floatBits(x) {
+  if (Number.isNaN(x)) return "nan";
+  const view = new DataView(new ArrayBuffer(8));
+  view.setFloat64(0, x);
+  let s = "";
+  for (let i = 0; i < 8; i++) s += view.getUint8(i).toString(16).padStart(2, "0");
+  return s;
+}
+
+function bitsToFloat(bits) {
+  if (bits === "nan") return NaN;
+  const view = new DataView(new ArrayBuffer(8));
+  for (let i = 0; i < 8; i++) view.setUint8(i, parseInt(bits.slice(2 * i, 2 * i + 2), 16));
+  return view.getFloat64(0);
+}
+
+/** Sets an own enumerable property (a plain assignment of "__proto__" would set the prototype). */
+export function setKey(o, k, v) {
+  Object.defineProperty(o, k, { value: v, enumerable: true, writable: true, configurable: true });
+}
+
+export const cInt = (v) => ({ $i: typeof v === "bigint" ? v.toString() : String(v) });
+export const cFloat = (x) => ({ $f: floatBits(x) });
+export const cTable = (o) => ({ $m: o });
+
+const isoUTC = Date.prototype.toISOString;
+
+/** The canonical form of a value smol-toml parsed or stringify was given (TomlDate/Date aware).
+ *  `loose`: integral safe numbers count as integers (what the default and 'asNeeded' modes
+ *  return for integers and for floats such as 1.0 alike). */
+export function canon(v, loose = false) {
+  if (typeof v === "string" || typeof v === "boolean") return v;
+  if (typeof v === "bigint") return cInt(v);
+  if (typeof v === "number") {
+    if (loose && Number.isSafeInteger(v)) return cInt(v);
+    return cFloat(v);
+  }
+  if (v instanceof TomlDate) {
+    if (v.isDateTime() && !v.isLocal()) return { $dt: isoUTC.call(v) };
+    if (v.isDateTime()) return { $ldt: v.toISOString() };
+    if (v.isDate()) return { $ld: v.toISOString() };
+    if (v.isTime()) return { $lt: v.toISOString() };
+    throw new Error("invalid TomlDate in a parsed value");
+  }
+  if (v instanceof Date) return { $dt: isoUTC.call(v) };
+  if (Array.isArray(v)) return v.map((x) => canon(x, loose));
+  if (v !== null && typeof v === "object") {
+    const o = {};
+    for (const k of Object.keys(v)) setKey(o, k, canon(v[k], loose));
+    return cTable(o);
+  }
+  throw new Error(`unexpected value ${String(v)}`);
+}
+
+/** The loose view of a strict canonical value: integral safe floats become integers. */
+export function loosen(c) {
+  if (c === null || typeof c !== "object") return c;
+  if (Array.isArray(c)) return c.map(loosen);
+  if ("$f" in c) {
+    const x = bitsToFloat(c.$f);
+    return Number.isSafeInteger(x) ? cInt(x) : c;
+  }
+  if ("$m" in c) {
+    const o = {};
+    for (const k of Object.keys(c.$m)) setKey(o, k, loosen(c.$m[k]));
+    return cTable(o);
+  }
+  return c;
+}
+
+/** The canonical value with CRLF newlines inside strings turned into LF: tomllib normalises
+ *  every CRLF of the document before parsing (Python's convention), while the specification
+ *  says newlines inside multi-line strings "remain intact" (and smol-toml keeps them). */
+export function normaliseCrlf(c) {
+  if (typeof c === "string") return c.replace(/\r\n/g, "\n");
+  if (c === null || typeof c !== "object") return c;
+  if (Array.isArray(c)) return c.map(normaliseCrlf);
+  if ("$m" in c) {
+    const o = {};
+    for (const k of Object.keys(c.$m)) setKey(o, k, normaliseCrlf(c.$m[k]));
+    return cTable(o);
+  }
+  return c;
+}
+
+/** smol-toml/6's shape in a document: a quote right after a line-ending backslash (and the
+ *  whitespace it trims) in a multi-line basic string. Approximate (a literal string may match). */
+export function quoteAfterLineEndingBackslash(text) {
+  return /\\[ \t]*\r?\n[ \t\r\n]*"/.test(text);
+}
+
+/** smol-toml/7's shape: a character JavaScript's trimEnd() treats as whitespace but TOML does not
+ *  (a lone CR, form feed, vertical tab, NBSP, the Unicode spaces, the BOM) anywhere in the text. */
+export function jsOnlyWhitespace(text) {
+  return /[\u000b\u000c\u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]|\r(?!\n)/.test(text);
+}
+
+/** smol-toml/8's shape: inside an array, a comment followed by a line that does not start with a
+ *  comma, a closing bracket or another comment (approximate). */
+export function elementAfterCommentInArray(text) {
+  return /\[[^\n\]]*#[^\n]*\n[ \t\n]*[^ \t\n,\]#]/.test(text);
+}
+
+/** smol-toml/9's shape: a quoted key part containing "=" (approximate). */
+export function quotedKeyWithEquals(text) {
+  return /(^|[{,\n])[ \t]*(["'])[^"'\n]*=[^"'\n]*\2/.test(text);
+}
+
+/** Does the canonical value hold an integer outside the safe range (default mode rejects it)? */
+export function hasBigInt(c) {
+  if (c === null || typeof c !== "object") return false;
+  if (Array.isArray(c)) return c.some(hasBigInt);
+  if ("$i" in c) return !Number.isSafeInteger(Number(c.$i)) || BigInt(c.$i) !== BigInt(Number(c.$i));
+  if ("$m" in c) return Object.keys(c.$m).some((k) => hasBigInt(c.$m[k]));
+  return false;
+}
+
+// ---------------------------------------------------------------- text pieces
+
+const pad = (x, w) => String(x).padStart(w, "0");
+const BARE = /^[A-Za-z0-9_-]+$/;
+const CTRL = /[\u0000-\u0008\u000a-\u001f\u007f]/;
+
+const LETTERS = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ".split("");
+const DIGITS = "0123456789".split("");
+const KEY_CHARS = [...LETTERS, ...DIGITS, "_", "-", " ", ".", '"', "'", "\\", "#", "=", "[", "]", "{", "}", ",", "é", "日", "\u{1F600}", "\t", "\u0000", "\u007f", "\u2028"];
+const TEXT_CHARS = [...LETTERS, ...DIGITS, " ", " ", " ", "\t", ".", ",", ":", "=", "#", "[", "]", "{", "}", '"', '"', "'", "'", "\\", "\\", "/", "-", "+", "_", "é", "ß", "日", "本", "\u{1F600}", "\u{10348}", "\u2028", "\u0085", " ", "\ufeff"];
+const COMMENT_CHARS = [...LETTERS, ...DIGITS, " ", " ", "\t", "#", '"', "'", "[", "]", "=", "\\", "é", "日", "\u{1F600}", "\u2028", "~"];
+const SPECIAL_KEYS = ["", "__proto__", "constructor", "toString", "hasOwnProperty", "valueOf", "1", "-", "true", "inf", "nan", "a.b", "1.5", "x y", "\u0000", "\u007f"];
+
+function ws(tc, allowEmpty = true) {
+  if (allowEmpty && chance(tc, 55)) return "";
+  return word(tc, [" ", " ", " ", "\t"], 1, 3);
+}
+
+export function comment(tc) {
+  return "#" + (chance(tc, 20) ? "" : word(tc, COMMENT_CHARS, 0, 12));
+}
+
+function escapeChar(tc, c, doc) {
+  const code = c.codePointAt(0);
+  if (c === '"') return chance(tc, 50) ? '\\"' : '\\u0022';
+  if (c === "\\") return "\\\\";
+  if (c === "\b") return "\\b";
+  if (c === "\t") return chance(tc, 50) ? "\t" : "\\t";
+  if (c === "\n") return "\\n";
+  if (c === "\f") return "\\f";
+  if (c === "\r") return "\\r";
+  if (c === "\u001b" && doc && chance(tc, 30)) { doc.v11 = true; return "\\e"; }
+  if (code < 0x20 || code === 0x7f) {
+    if (doc && chance(tc, 10)) { doc.v11 = true; return "\\x" + pad(code.toString(16), 2); }
+    return "\\u" + pad(code.toString(16), 4);
+  }
+  if (chance(tc, 15)) {
+    if (code > 0xffff || chance(tc, 30)) return "\\U" + pad(code.toString(16), 8);
+    return "\\u" + pad(code.toString(16), 4);
+  }
+  return c;
+}
+
+/** A single-line basic string for `s`. */
+export function basicString(tc, s, doc) {
+  let out = '"';
+  for (const c of s) out += escapeChar(tc, c, doc);
+  return out + '"';
+}
+
+/** The text of a key (one part). */
+export function keyPart(tc, name, doc) {
+  if (BARE.test(name) && chance(tc, 85)) return name;
+  if (!name.includes("'") && !CTRL.test(name) && chance(tc, 40)) return "'" + name + "'";
+  return basicString(tc, name, doc);
+}
+
+export function dottedKey(tc, names, doc) {
+  return names.map((k) => keyPart(tc, k, doc)).join(ws(tc) + "." + ws(tc));
+}
+
+function genKeyName(tc, taken) {
+  for (let i = 0; i < 6; i++) {
+    const name = chance(tc, 20) ? pick(tc, SPECIAL_KEYS) : chance(tc, 70) ? word(tc, [...LETTERS, ...DIGITS, "_", "-"], 1, 6) : word(tc, KEY_CHARS, 0, 5);
+    if (!taken.has(name)) {
+      taken.add(name);
+      return name;
+    }
+  }
+  const name = "k" + taken.size + word(tc, LETTERS, 1, 4);
+  taken.add(name);
+  return name;
+}
+
+// ---------------------------------------------------------------- scalar values
+
+function genString(tc, doc) {
+  const kind = pick(tc, ["basic", "basic", "literal", "mlbasic", "mlliteral"]);
+  const multi = kind.startsWith("ml");
+  const chars = [...TEXT_CHARS];
+  if (multi) chars.push("\n", "\n");
+  let s = word(tc, chars, 0, 10);
+  if (chance(tc, 10)) s = pick(tc, ["\n", "\u0000", "\u001b", "\u0085", "퟿", "￿", "\u{10ffff}", '"', "'", "''", '""', "\\", "\\\\", "#", "\t\t"]);
+  if (kind === "literal") {
+    s = s.replace(/'/g, "x");
+    if (CTRL.test(s) || s.includes("\n")) return genString(tc, doc);
+    return { text: "'" + s + "'", canon: s };
+  }
+  if (kind === "basic") {
+    return { text: basicString(tc, s.replace(/\n/g, ""), doc), canon: s.replace(/\n/g, "") };
+  }
+  if (kind === "mlliteral") {
+    s = s.replace(/'''+/g, "''").replace(/\r/g, "");
+    if (CTRL.test(s.replace(/\n/g, ""))) return genString(tc, doc);
+    const text = "'''" + (s.startsWith("\n") || chance(tc, 30) ? doc.nl : "") + s.replace(/\n/g, doc.nl) + "'''";
+    return { text, canon: s.replace(/\n/g, doc.nl) };
+  }
+  // multi-line basic
+  let out = '"""' + (s.startsWith("\n") || chance(tc, 30) ? doc.nl : "");
+  let run = 0;
+  let canonS = "";
+  let trimming = false;
+  for (const c of s) {
+    if (chance(tc, 8)) {
+      // a line-ending backslash: trims itself, the newline and all whitespace that follows
+      out += "\\" + ws(tc) + doc.nl + (chance(tc, 50) ? word(tc, [" ", "\t", doc.nl], 0, 3) : "");
+      run = 0;
+      trimming = true;
+    }
+    if (trimming && (c === " " || c === "\t" || c === "\n")) {
+      // whitespace that must survive the trimming has to be escaped
+      out += c === " " ? "\\u0020" : c === "\t" ? "\\t" : "\\n";
+      canonS += c; // an escaped newline is always LF, whatever the document's line ending
+      continue;
+    }
+    trimming = false;
+    if (c === "\n") {
+      out += doc.nl;
+      canonS += doc.nl;
+      run = 0;
+      continue;
+    }
+    if (c === '"') {
+      if (run < 2 && chance(tc, 70)) {
+        out += '"';
+        run++;
+      } else {
+        out += '\\"';
+        run = 0;
+      }
+    } else {
+      out += escapeChar(tc, c, doc);
+      run = 0;
+    }
+    canonS += c;
+  }
+  return { text: out + '"""', canon: canonS };
+}
+
+function underscored(tc, digits) {
+  if (digits.length < 2 || chance(tc, 70)) return digits;
+  let out = digits[0];
+  for (let i = 1; i < digits.length; i++) out += (chance(tc, 30) ? "_" : "") + digits[i];
+  return out;
+}
+
+function genInteger(tc, doc) {
+  const r = n(tc, 0, 99);
+  let v;
+  if (r < 50) v = BigInt(n(tc, -1000, 1000));
+  else if (r < 75) v = BigInt(n(tc, 0, 2 ** 31 - 1)) * BigInt(n(tc, -4194304, 4194304)) + BigInt(n(tc, 0, 1000));
+  else {
+    // beyond 2^53: 64-bit-ish and larger
+    v = (BigInt(n(tc, 0, 2 ** 31 - 1)) << BigInt(n(tc, 22, 40))) + BigInt(n(tc, 0, 2 ** 31 - 1));
+    if (chance(tc, 50)) v = -v;
+    if (chance(tc, 20)) v = pick(tc, [9007199254740992n, -9007199254740992n, 9007199254740993n, 9223372036854775807n, -9223372036854775808n, 9223372036854775808n, 18446744073709551615n]);
+  }
+  if (!Number.isSafeInteger(Number(v)) || BigInt(Number(v)) !== v) doc.big = true;
+  let text;
+  const base = v < 0n ? "dec" : pick(tc, ["dec", "dec", "dec", "hex", "oct", "bin"]);
+  if (base === "dec") {
+    text = underscored(tc, (v < 0n ? -v : v).toString());
+    text = (v < 0n ? "-" : chance(tc, 20) ? "+" : "") + text;
+  } else {
+    const radix = base === "hex" ? 16 : base === "oct" ? 8 : 2;
+    let digits = v.toString(radix);
+    if (radix === 16 && chance(tc, 50)) digits = digits.toUpperCase();
+    text = "0" + { hex: "x", oct: "o", bin: "b" }[base] + underscored(tc, digits);
+  }
+  return { text, canon: cInt(v) };
+}
+
+function genFloat(tc) {
+  if (chance(tc, 12)) {
+    const t = pick(tc, ["inf", "+inf", "-inf", "nan", "+nan", "-nan"]);
+    return { text: t, canon: cFloat(t.endsWith("inf") ? (t[0] === "-" ? -Infinity : Infinity) : NaN) };
+  }
+  const sign = pick(tc, ["", "", "", "-", "+"]);
+  const intDigits = chance(tc, 20) ? "0" : word(tc, DIGITS, 1, 6).replace(/^0+(?=\d)/, "");
+  let text = sign + underscored(tc, intDigits);
+  const hasFrac = chance(tc, 75);
+  if (hasFrac) text += "." + underscored(tc, word(tc, DIGITS, 1, 8));
+  if (!hasFrac || chance(tc, 30)) text += pick(tc, ["e", "E"]) + pick(tc, ["", "", "-", "+"]) + underscored(tc, chance(tc, 10) ? String(n(tc, 300, 400)) : String(n(tc, 0, 30)));
+  const value = Number(text.replace(/_/g, ""));
+  if (Number.isNaN(value)) throw new Error(`generator made a bad float ${text}`);
+  return { text, canon: cFloat(value) };
+}
+
+const DAYS = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
+const isLeap = (y) => (y % 4 === 0 && y % 100 !== 0) || y % 400 === 0;
+
+/** Random valid date/time components (years 1-9999: Python's datetime has no year 0). */
+function genDateParts(tc) {
+  const y = chance(tc, 70) ? n(tc, 1900, 2100) : pick(tc, [1, 99, 100, 1000, 1600, 1970, 2000, 9999, n(tc, 1, 9999)]);
+  const mo = n(tc, 1, 12);
+  const d = n(tc, 1, mo === 2 && isLeap(y) ? 29 : DAYS[mo - 1]);
+  const h = n(tc, 0, 23);
+  const mi = n(tc, 0, 59);
+  const s = n(tc, 0, 59);
+  const fracDigits = chance(tc, 40) ? 0 : n(tc, 1, 9);
+  const frac = fracDigits ? word(tc, DIGITS, fracDigits, fracDigits) : "";
+  const ms = fracDigits ? Number((frac + "000").slice(0, 3)) : 0;
+  return { y, mo, d, h, mi, s, frac, ms };
+}
+
+function utcInstant(p, offsetMinutes) {
+  const date = new Date(0);
+  date.setUTCFullYear(p.y, p.mo - 1, p.d);
+  date.setUTCHours(p.h, p.mi, p.s, p.ms);
+  return new Date(date.getTime() - offsetMinutes * 60000);
+}
+
+const localDateText = (p) => `${pad(p.y, 4)}-${pad(p.mo, 2)}-${pad(p.d, 2)}`;
+const localTimeText = (p) => `${pad(p.h, 2)}:${pad(p.mi, 2)}:${pad(p.s, 2)}.${pad(p.ms, 3)}`;
+
+/** A TOML date/time of a random kind: {text, canon, kind, parts, offset} (`doc.v11` set for seconds omitted). */
+export function genDateTime(tc, doc) {
+  const p = genDateParts(tc);
+  const kind = pick(tc, ["dt", "dt", "ldt", "ld", "lt"]);
+  const noSeconds = doc && chance(tc, 3);
+  let time = `${pad(p.h, 2)}:${pad(p.mi, 2)}`;
+  if (noSeconds) {
+    doc.v11 = true;
+    p.s = 0;
+    p.ms = 0;
+    p.frac = "";
+  } else {
+    time += `:${pad(p.s, 2)}` + (p.frac ? "." + p.frac : "");
+  }
+  const dateT = localDateText(p);
+  const sep = pick(tc, ["T", "T", "t", " "]);
+  if (kind === "ld") return { text: dateT, canon: { $ld: dateT }, kind, parts: p };
+  if (kind === "lt") return { text: time, canon: { $lt: localTimeText(p) }, kind, parts: p };
+  if (kind === "ldt") return { text: dateT + sep + time, canon: { $ldt: dateT + "T" + localTimeText(p) }, kind, parts: p };
+  let offset;
+  let minutes;
+  if (chance(tc, 40)) {
+    offset = pick(tc, ["Z", "Z", "z"]);
+    minutes = 0;
+  } else {
+    const sign = pick(tc, ["+", "-"]);
+    const oh = n(tc, 0, 23);
+    const om = chance(tc, 60) ? pick(tc, [0, 30, 45]) : n(tc, 0, 59);
+    offset = `${sign}${pad(oh, 2)}:${pad(om, 2)}`;
+    minutes = (sign === "-" ? -1 : 1) * (oh * 60 + om);
+  }
+  const instant = utcInstant(p, minutes);
+  if (instant.getUTCFullYear() < 1 || instant.getUTCFullYear() > 9999) return genDateTime(tc, doc);
+  return { text: dateT + sep + time + offset, canon: { $dt: instant.toISOString() }, kind, parts: p, offset };
+}
+
+// ---------------------------------------------------------------- documents
+
+/** A value (scalar, array or inline table) rendered as TOML text: {text, canon}. */
+function genValue(tc, doc, depth) {
+  const r = n(tc, 0, 99);
+  if (r < 30) return genString(tc, doc);
+  if (r < 50) return genInteger(tc, doc);
+  if (r < 65) return genFloat(tc);
+  if (r < 73) {
+    const b = chance(tc, 50);
+    return { text: String(b), canon: b };
+  }
+  if (r < 85 || depth >= 3) {
+    const d = genDateTime(tc, doc);
+    return { text: d.text, canon: d.canon };
+  }
+  if (r < 93) return genArray(tc, doc, depth + 1);
+  return { text: inlineTableText(tc, doc, genTableNode(tc, doc, depth + 1, true)), canon: canonNode(genLast) };
+}
+
+let genLast = null; // the table node genValue last rendered inline (avoids a second return value)
+
+function genArray(tc, doc, depth) {
+  const len = n(tc, 0, 4);
+  const multi = chance(tc, 30);
+  const items = [];
+  const canon = [];
+  for (let i = 0; i < len; i++) {
+    const v = genValue(tc, doc, depth);
+    items.push(v.text);
+    canon.push(v.canon);
+  }
+  const gap = () => (multi ? word(tc, [" ", "\t", doc.nl, doc.nl], 0, 3) + (chance(tc, 20) ? comment(tc) + doc.nl : "") : ws(tc));
+  let text = "[" + gap();
+  for (let i = 0; i < items.length; i++) {
+    if (i) text += "," + gap();
+    text += items[i];
+  }
+  if (items.length && chance(tc, 25)) text += gap() + "," + gap();
+  text += gap() + "]";
+  return { text, canon };
+}
+
+/** A table node: {t: "tbl", entries: [[name, node]]}; nodes are values, tables or arrays of tables. */
+function genTableNode(tc, doc, depth, inlineOnly = false) {
+  const taken = new Set();
+  const size = n(tc, 0, depth === 0 ? 6 : 4);
+  const entries = [];
+  for (let i = 0; i < size; i++) {
+    const name = genKeyName(tc, taken);
+    const r = n(tc, 0, 99);
+    if (r < 60 || depth >= 3) entries.push([name, genValue(tc, doc, depth + 1)]);
+    else if (r < 82) entries.push([name, genTableNode(tc, doc, depth + 1, inlineOnly)]);
+    else {
+      const elements = [];
+      const len = inlineOnly ? n(tc, 0, 3) : n(tc, 1, 3);
+      for (let j = 0; j < len; j++) elements.push(genTableNode(tc, doc, depth + 1, inlineOnly));
+      entries.push([name, { t: "aot", elements }]);
+    }
+  }
+  genLast = { t: "tbl", entries };
+  return genLast;
+}
+
+export function canonNode(node) {
+  if (node.t === "tbl") {
+    const o = {};
+    for (const [k, child] of node.entries) setKey(o, k, canonNode(child));
+    return cTable(o);
+  }
+  if (node.t === "aot") return node.elements.map(canonNode);
+  return node.canon;
+}
+
+function inlineTableText(tc, doc, node) {
+  if (node.entries.length === 0) return "{" + ws(tc) + "}";
+  const multi = chance(tc, 4);
+  if (multi) doc.v11 = true;
+  const gap = () => (multi ? word(tc, [" ", "\t", doc.nl, doc.nl], 0, 3) : ws(tc));
+  let text = "{" + gap();
+  node.entries.forEach(([k, child], i) => {
+    if (i) text += "," + gap();
+    text += dottedKey(tc, [k], doc) + ws(tc) + "=" + ws(tc) + valueText(tc, doc, child);
+  });
+  if (multi && chance(tc, 40)) text += gap() + ",";
+  return text + gap() + "}";
+}
+
+function valueText(tc, doc, node) {
+  if (node.t === "tbl") return inlineTableText(tc, doc, node);
+  if (node.t === "aot") {
+    const parts = node.elements.map((el) => inlineTableText(tc, doc, el));
+    return "[" + ws(tc) + parts.join("," + ws(tc)) + ws(tc) + "]";
+  }
+  return node.text;
+}
+
+function shuffle(tc, xs) {
+  const a = xs.slice();
+  for (let i = a.length - 1; i > 0; i--) {
+    const j = n(tc, 0, i);
+    [a[i], a[j]] = [a[j], a[i]];
+  }
+  return a;
+}
+
+function emit(tc, doc, stmt) {
+  if (chance(tc, 12)) doc.lines.push(chance(tc, 50) ? "" : ws(tc) + comment(tc));
+  let line = ws(tc) + stmt;
+  if (chance(tc, 20)) line += ws(tc, false) + (chance(tc, 60) ? comment(tc) : "");
+  doc.lines.push(line);
+}
+
+function emitKV(tc, doc, keyNames, text) {
+  emit(tc, doc, dottedKey(tc, keyNames, doc) + ws(tc) + "=" + ws(tc) + text);
+}
+
+function emitDotted(tc, doc, path, node) {
+  for (const [k, child] of shuffle(tc, node.entries)) {
+    const keys = [...path, k];
+    if (child.t === "tbl" && child.entries.length > 0 && chance(tc, 60)) emitDotted(tc, doc, keys, child);
+    else emitKV(tc, doc, keys, valueText(tc, doc, child));
+  }
+}
+
+function emitHeader(tc, doc, path, aot) {
+  const open = aot ? "[[" : "[";
+  const close = aot ? "]]" : "]";
+  emit(tc, doc, open + ws(tc) + dottedKey(tc, path, doc) + ws(tc) + close);
+}
+
+/** Renders a table as a body (key/values) followed by its sections; returns the body's size. */
+function renderTable(tc, doc, node, path) {
+  const sections = [];
+  let body = 0;
+  for (const [k, child] of shuffle(tc, node.entries)) {
+    if (child.t === "tbl") {
+      const mode = pick(tc, ["header", "header", "dotted", "inline"]);
+      if (mode === "header") sections.push(["tbl", k, child]);
+      else if (mode === "dotted" && child.entries.length > 0) { emitDotted(tc, doc, [k], child); body++; }
+      else { emitKV(tc, doc, [k], inlineTableText(tc, doc, child)); body++; }
+    } else if (child.t === "aot") {
+      if (chance(tc, 35)) { emitKV(tc, doc, [k], valueText(tc, doc, child)); body++; }
+      else sections.push(["aot", k, child]);
+    } else {
+      emitKV(tc, doc, [k], child.text);
+      body++;
+    }
+  }
+  for (const [kind, k, child] of sections) {
+    const sub = [...path, k];
+    if (kind === "tbl") {
+      const at = doc.lines.length;
+      emitHeader(tc, doc, sub, false);
+      const headerLines = doc.lines.length - at;
+      const size = renderTable(tc, doc, child, sub);
+      // a super-table that is only implied by its sub-tables' headers need not be declared
+      if (size === 0 && child.entries.length > 0 && chance(tc, 40)) doc.lines.splice(at, headerLines);
+    } else {
+      for (const el of child.elements) {
+        emitHeader(tc, doc, sub, true);
+        renderTable(tc, doc, el, sub);
+      }
+    }
+  }
+  return body;
+}
+
+/** A random TOML document with its model: {text, value (strict canonical), v11, big}. */
+export function genDoc(tc) {
+  const doc = { nl: chance(tc, 15) ? "\r\n" : "\n", v11: false, big: false, lines: [] };
+  const root = genTableNode(tc, doc, 0);
+  if (chance(tc, 10)) doc.lines.push(comment(tc));
+  renderTable(tc, doc, root, []);
+  if (chance(tc, 10)) doc.lines.push(ws(tc) + comment(tc));
+  let text = doc.lines.join(doc.nl);
+  if (chance(tc, 80) || text.endsWith("]")) text += doc.nl;
+  return { text, value: canonNode(root), v11: doc.v11, big: doc.big };
+}
+
+// ---------------------------------------------------------------- mutations
+
+const TOKENS = ["[", "]", "[[", "]]", "{", "}", "=", ".", ",", "#", '"', "'", '"""', "'''", "\\", "\n", "\n", " ", "\t", "\u0000", "\u007f", "\r", "e", "x", "_", "0", "9", "-", "+", "T", "Z", ":", "inf", "nan", "true", "1979-05-27", "07:32:00", "\\u", "\\U0000", "\\uD800", "\\e", "\\x41", "a = 1", "[a]", "[[a]]", "a.b", "é", "\u2028", "\ufeff", "1e", "0x", "1__2", "1.", ".5", "+0x1", "-0", "24:00:00", "00:60:00", "1979-02-30", "13:00:00Z", "+24:00"];
+
+/** 1-3 random edits of `text` (characters or lines): the mutated text. */
+export function mutate(tc, text) {
+  const ops = n(tc, 1, 3);
+  for (let k = 0; k < ops; k++) {
+    const r = n(tc, 0, 99);
+    if (r < 50) {
+      const i = n(tc, 0, text.length);
+      const tok = pick(tc, TOKENS);
+      if (r < 15) text = text.slice(0, i) + text.slice(i + 1);
+      else if (r < 35) text = text.slice(0, i) + tok + text.slice(i);
+      else text = text.slice(0, i) + tok + text.slice(i + 1);
+    } else {
+      const lines = text.split("\n");
+      const i = n(tc, 0, lines.length - 1);
+      const j = n(tc, 0, lines.length - 1);
+      if (r < 65) lines.splice(j, 0, lines[i]);
+      else if (r < 80) lines.splice(i, 1);
+      else if (r < 90) [lines[i], lines[j]] = [lines[j], lines[i]];
+      else lines[i] = lines[i].trimStart();
+      text = lines.join("\n");
+    }
+  }
+  return text;
+}
+
+/** Why smol-toml might accept `text` while tomllib (TOML 1.0) rejects it: a limit key, or null. */
+export function acceptedOnlyBySmol(text) {
+  if (/\\[ex]/.test(text)) return "limit/v11-escape";
+  if (/(^|[^\d:])\d{2}:\d{2}(?![:\d])/.test(text.replace(/[+-]\d{2}:\d{2}/g, "+HH:MM"))) return "limit/v11-time-without-seconds";
+  if (/\{[^{}]*(\n|,\s*\})/.test(text)) return "limit/v11-inline-table";
+  for (const m of text.matchAll(/(\d{4})-(\d{2})-(\d{2})/g)) {
+    const y = Number(m[1]);
+    const mo = Number(m[2]);
+    const d = Number(m[3]);
+    if (y === 0) return "limit/year-zero";
+    if (mo >= 1 && mo <= 12 && d > (mo === 2 && isLeap(y) ? 29 : DAYS[mo - 1])) return "limit/calendar-day";
+  }
+  return null;
+}
+
+// ---------------------------------------------------------------- JavaScript values for stringify
+
+const STR_POOL = ["", "a", "hello world", "é日\u{1F600}", "\t", "\n", "\r\n", "\u0000", "\u001b", "\u007f", "\u2028", '"', "'", "\\", '"""', "'''", "#", "[table]", "a = 1", "\u0085", "\ufeff", "\ud800"];
+
+function genJsScalar(tc, model) {
+  const r = n(tc, 0, 99);
+  if (r < 25) {
