@@ -0,0 +1,657 @@
+// Hegel zoo: the generators behind the smol-toml properties, as values built from Hegel's
+// combinators, and the pure functions that render what they draw.
+//
+// A TOML document is drawn as a tree. A table node holds entries (distinct key names, by
+// `gs.maps`) whose values are scalars, arrays, tables or arrays of tables, and every node carries
+// the style it is to be written in beside its data: a table how it appears under its parent
+// (header section, dotted keys or inline table) and whether an implied super-table is declared,
+// an entry the order it is written in, the spelling of its key (bare, literal or basic) and the
+// whitespace and comments around its line, a string the escape choices of each of its pieces, a
+// number its base, sign and underscores, a date-time its separator and offset. `render(doc)`
+// turns the tree and the document style (its line ending) into text, `canonNode` into the
+// canonical value the parsers must return (hegel-toml.mjs); neither draws. With `v11` a document
+// may use TOML 1.1 syntax (`\e` and `\x` escapes, seconds omitted, newlines and a trailing comma
+// in an inline table), which the renderer reports so a property can count or avoid it.
+//
+// The JavaScript values for stringify are built directly by their generators, four levels deep;
+// the mutations of a document are a list of edits whose positions are taken modulo the live text
+// when they are applied, so the shrinker can delete an edit or shrink the document under it.
+
+import { gs } from "./hegel-zoo.mjs";
+import { cFloat, cInt, cTable, daysIn, setKey, TomlDate } from "./hegel-toml.mjs";
+
+// ---------------------------------------------------------------- generator helpers
+
+export const ints = (lo, hi) => gs.integers({ minValue: lo, maxValue: hi });
+
+/** oneOf with weights: `weighted([45, a], [55, b])` draws a 45 times in 100; shrinks towards the first choice. */
+export function weighted(...choices) {
+  if (choices.length === 1) return choices[0][1];
+  const total = choices.reduce((sum, [w]) => sum + w, 0);
+  return ints(0, total - 1).flatMap((r) => {
+    for (const [w, g] of choices) {
+      if (r < w) return g;
+      r -= w;
+    }
+    throw new Error("unreachable");
+  });
+}
+
+/** True pct percent of the time; shrinks to false. */
+export const chance = (pct) => ints(0, 99).map((r) => r >= 100 - pct);
+/** A draw from g pct percent of the time, else undefined (listed first: shrinks to absent). */
+export const maybe = (pct, g) => weighted([100 - pct, gs.just(undefined)], [pct, g]);
+/** lo-hi pieces of `pool` (strings of one or more characters) concatenated. */
+const pieces = (pool, lo, hi) => gs.arrays(gs.sampledFrom(pool), { minSize: lo, maxSize: hi }).map((xs) => xs.join(""));
+/** A tree node of kind `t` with the given fields. */
+const node = (t, fields) => gs.record({ t: gs.just(t), ...fields });
+/** A generator that draws nothing when `on` is false. */
+const when = (on, g) => (on ? g : gs.just(false));
+
+const pad = (x, w) => String(x).padStart(w, "0");
+const hex = (code, w) => pad(code.toString(16), w);
+
+// ---------------------------------------------------------------- character pools
+
+const LETTERS = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ";
+const DIGITS = "0123456789";
+const KEY_CHARS = [...LETTERS, ...DIGITS, "_", "-", " ", ".", '"', "'", "\\", "#", "=", "[", "]", "{", "}", ",", "\u{e9}", "\u{65e5}", "\u{1F600}", "\t", "\0", "\x7f", "\u{2028}"];
+const TEXT_CHARS = [...LETTERS, ...DIGITS, " ", " ", " ", "\t", ".", ",", ":", "=", "#", "[", "]", "{", "}", '"', '"', "'", "'", "\\", "\\", "/", "-", "+", "_", "\u{e9}", "\u{df}", "\u{65e5}", "\u{672c}", "\u{1F600}", "\u{10348}", "\u{2028}", "\x85", "\xa0", "\u{feff}"];
+const COMMENT_CHARS = [...LETTERS, ...DIGITS, " ", " ", "\t", "#", '"', "'", "[", "]", "=", "\\", "\u{e9}", "\u{65e5}", "\u{1F600}", "\u{2028}", "~"];
+const SPECIAL_KEYS = ["", "__proto__", "constructor", "toString", "hasOwnProperty", "valueOf", "1", "-", "true", "inf", "nan", "a.b", "1.5", "x y", "\0", "\x7f"];
+// the awkward pieces of a string: controls, the last code points of a plane, quotes in runs, backslashes
+const SPECIAL_PIECES = ["\n", "\0", "\x1b", "\x85", "\u{d7ff}", "\u{ffff}", "\u{10ffff}", '"', "'", "''", '""', "\\", "\\\\", "#", "\t\t"];
+
+const BARE = /^[A-Za-z0-9_-]+$/;
+const CTRL = /[\x00-\x08\x0a-\x1f\x7f]/;
+
+// ---------------------------------------------------------------- whitespace, comments, lines
+
+/** TOML whitespace: none 55% of the time, else 1-3 spaces or tabs. */
+const ws = weighted([55, gs.just("")], [45, pieces([" ", " ", " ", "\t"], 1, 3)]);
+const ws1 = pieces([" ", " ", " ", "\t"], 1, 3);
+/** A gap inside an array or inline table: none 55% of the time, else 1-3 spaces, tabs or newlines (`\n`, rendered as the document's line ending, or as a space where a newline may not go). */
+const gap = weighted([55, gs.just("")], [45, pieces([" ", "\t", "\n", "\n"], 1, 3)]);
+/** A comment: `#` alone 20% of the time, else with 0-12 characters. */
+const comment = weighted([20, gs.just("#")], [80, pieces(COMMENT_CHARS, 0, 12).map((s) => "#" + s)]);
+
+/** How a statement sits on its line: 12% of the time a blank line or a comment line before it, leading whitespace, and 20% of the time trailing whitespace followed by a comment 60% of that. */
+const lineStyle = gs.record({
+  before: maybe(12, weighted([50, gs.just("")], [50, gs.tuples(ws, comment).map(([w, c]) => w + c)])),
+  lead: ws,
+  tail: maybe(20, gs.tuples(ws1, maybe(60, comment)).map(([w, c]) => w + (c ?? ""))),
+});
+
+/** Appends a statement in its line style. */
+function emit(out, style, stmt) {
+  if (style.before !== undefined) out.lines.push(style.before);
+  out.lines.push(style.lead + stmt + (style.tail ?? ""));
+}
+
+// ---------------------------------------------------------------- strings
+
+/** The spelling choices of a basic string: `"` as `\"` or `"`, a tab raw or `\t`, an escaped ordinary character as `\u` or `\U`, a multi-line string opening with a newline; with v11, ESC as `\e` and a control as `\xHH`. */
+const strStyle = (v11) => gs.record({ quoteU: chance(50), tabEsc: chance(50), bigU: chance(30), leadNl: chance(30), e: when(v11, chance(30)), x: when(v11, chance(10)) });
+
+/** A piece of a string with its escape choices: one of `pool` 90% of the time, else an awkward piece; escaped as `\u`/`\U` where it need not be 15% of the time; in a multi-line basic string, preceded 8% of the time by a line-ending backslash with whitespace before it and spaces, tabs and newlines after it. */
+const piece = (pool, specials, multi) =>
+  gs.record({
+    c: weighted([90, gs.sampledFrom(pool)], [10, gs.sampledFrom(specials)]),
+    esc: chance(15),
+    cut: multi ? maybe(8, gs.tuples(ws, pieces([" ", "\t", "\n"], 0, 3))) : gs.just(undefined),
+  });
+
+const LITERAL_CHARS = TEXT_CHARS.filter((c) => c !== "'");
+const LITERAL_PIECES = SPECIAL_PIECES.filter((p) => !p.includes("'") && !p.includes("\n") && !CTRL.test(p));
+const stringOf = (kind, pool, specials, multi, v11) => node("str", { kind: gs.just(kind), pieces: gs.arrays(piece(pool, specials, multi), { maxSize: 10 }), style: strStyle(v11) });
+
+/** A string of 0-10 pieces: basic 40% of the time, literal 20, multi-line basic 20, multi-line literal 20 (the literal kinds draw from pools without a single quote or a control character). */
+const string = (v11) =>
+  weighted(
+    [40, stringOf("basic", TEXT_CHARS, SPECIAL_PIECES.filter((p) => p !== "\n"), false, v11)],
+    [20, stringOf("literal", LITERAL_CHARS, LITERAL_PIECES, false, v11)],
+    [20, stringOf("mlbasic", [...TEXT_CHARS, "\n", "\n"], SPECIAL_PIECES, true, v11)],
+    [20, stringOf("mlliteral", [...TEXT_CHARS, "\n", "\n"], [...LITERAL_PIECES, "\n", "'", "''"], true, v11)],
+  );
+
+/** The basic-string spelling of one character; `esc` asks for a `\u`/`\U` escape where none is needed. */
+function escapeChar(ch, style, esc, flags) {
+  const code = ch.codePointAt(0);
+  if (ch === '"') return style.quoteU ? "\\u0022" : '\\"';
+  if (ch === "\\") return "\\\\";
+  if (ch === "\b") return "\\b";
+  if (ch === "\t") return style.tabEsc ? "\\t" : "\t";
+  if (ch === "\n") return "\\n";
+  if (ch === "\f") return "\\f";
+  if (ch === "\r") return "\\r";
+  if (ch === "\x1b" && style.e) {
+    flags.v11 = true;
+    return "\\e";
+  }
+  if (code < 0x20 || code === 0x7f) {
+    if (style.x) {
+      flags.v11 = true;
+      return "\\x" + hex(code, 2);
+    }
+    return "\\u" + hex(code, 4);
+  }
+  if (esc) return code > 0xffff || style.bigU ? "\\U" + hex(code, 8) : "\\u" + hex(code, 4);
+  return ch;
+}
+
+/** A multi-line basic string: `cut` pieces get a line-ending backslash before them, whose trimming the whitespace that follows survives as an escape; quotes run raw up to two in a row. */
+function mlBasic(pieces, style, nl, flags) {
+  const s = pieces.map((p) => p.c).join("");
+  let out = '"""' + (s.startsWith("\n") || style.leadNl ? nl : "");
+  let canon = "";
+  let run = 0;
+  let trimming = false;
+  for (const p of pieces) {
+    if (p.cut !== undefined) {
+      out += "\\" + p.cut[0] + nl + p.cut[1].replace(/\n/g, nl);
+      run = 0;
+      trimming = true;
+    }
+    for (const ch of p.c) {
+      if (trimming && (ch === " " || ch === "\t" || ch === "\n")) {
+        // whitespace that must survive the trimming has to be escaped
+        out += ch === " " ? "\\u0020" : ch === "\t" ? "\\t" : "\\n";
+        canon += ch; // an escaped newline is always LF, whatever the document's line ending
+        continue;
+      }
+      trimming = false;
+      if (ch === "\n") {
+        out += nl;
+        canon += nl;
+        run = 0;
+        continue;
+      }
+      if (ch === '"' && run < 2 && !p.esc) {
+        out += '"';
+        run++;
+      } else {
+        out += escapeChar(ch, style, p.esc, flags);
+        run = 0;
+      }
+      canon += ch;
+    }
+  }
+  return { text: out + '"""', canon };
+}
+
+/** The text and value of a string node. */
+function renderString(node, nl, flags) {
+  const s = node.pieces.map((p) => p.c).join("");
+  switch (node.kind) {
+    case "basic":
+      return { text: '"' + node.pieces.map((p) => [...p.c].map((ch) => escapeChar(ch, node.style, p.esc, flags)).join("")).join("") + '"', canon: s };
+    case "literal":
+      return { text: "'" + s + "'", canon: s };
+    case "mlliteral": {
+      // three quotes in a row would close the string: at most two
+      const t = s.replace(/'''+/g, "''");
+      return { text: "'''" + (t.startsWith("\n") || node.style.leadNl ? nl : "") + t.replace(/\n/g, nl) + "'''", canon: t.replace(/\n/g, nl) };
+    }
+    default:
+      return mlBasic(node.pieces, node.style, nl, flags);
+  }
+}
+
+// ---------------------------------------------------------------- keys
+
+/** A key name: 1-6 bare characters 56% of the time, a special name 20% (empty, `__proto__`, numeric, dotted...), else 0-5 awkward characters. */
+const keyName = weighted([56, gs.text({ alphabet: LETTERS + DIGITS + "_-", minSize: 1, maxSize: 6 })], [20, gs.sampledFrom(SPECIAL_KEYS)], [24, pieces(KEY_CHARS, 0, 5)]);
+
+/** How a key part is spelled: quoted although bare would do 15% of the time; basic rather than literal 60% (where a literal is possible); the escape choices of a basic spelling; the whitespace around the dot that follows it. */
+const keyStyle = gs.record({ quoted: chance(15), basic: chance(60), quoteU: chance(50), bigU: chance(30), esc: chance(15), dot: gs.tuples(ws, ws) });
+
+/** The text of one key part. */
+function keyText(name, ks, flags) {
+  if (BARE.test(name) && !ks.quoted) return name;
+  if (!name.includes("'") && !CTRL.test(name) && !ks.basic) return "'" + name + "'";
+  const style = { quoteU: ks.quoteU, tabEsc: false, bigU: ks.bigU, e: false, x: false };
+  return '"' + [...name].map((ch) => escapeChar(ch, style, ks.esc, flags)).join("") + '"';
+}
+
+/** A dotted key: the parts `[name, style]` joined by dots with each part's whitespace. */
+function dottedKey(parts, flags) {
+  return parts.map(([name, ks], i) => (i ? ks.dot[0] + "." + ks.dot[1] : "") + keyText(name, ks, flags)).join("");
+}
+
+// ---------------------------------------------------------------- numbers
+
+/** Where the underscores of a number go: none 70% of the time, else 1-4 positions taken modulo the gaps between its digits. */
+const underscores = maybe(30, gs.arrays(ints(0, 63), { minSize: 1, maxSize: 4 }));
+
+/** `parts` (digit strings) with underscores at the drawn positions, counted over the gaps of all parts. */
+function underscored(parts, under) {
+  const gaps = parts.map((p) => Math.max(0, p.length - 1));
+  const total = gaps.reduce((a, b) => a + b, 0);
+  if (under === undefined || total === 0) return parts;
+  const at = parts.map(() => new Set());
+  for (const u of under) {
+    let g = u % total;
+    for (let i = 0; i < parts.length; i++) {
+      if (g < gaps[i]) {
+        at[i].add(g + 1);
+        break;
+      }
+      g -= gaps[i];
+    }
+  }
+  return parts.map((p, i) => [...p].map((d, j) => (at[i].has(j) ? "_" + d : d)).join(""));
+}
+
+const BIG_INTS = [9007199254740992n, -9007199254740992n, 9007199254740993n, 9223372036854775807n, -9223372036854775808n, 9223372036854775808n, 18446744073709551615n];
+/** An integer: -1000..1000 half the time, a product below 2^53 or so 25%, beyond 2^53 20% (negated half the time), else a boundary of 2^53, 2^63 or 2^64. */
+const intValue = weighted(
+  [50, ints(-1000, 1000).map(BigInt)],
+  [25, gs.tuples(ints(0, 2 ** 31 - 1), ints(-4194304, 4194304), ints(0, 1000)).map(([a, b, c]) => BigInt(a) * BigInt(b) + BigInt(c))],
+  [20, gs.tuples(ints(0, 2 ** 31 - 1), ints(22, 40), ints(0, 2 ** 31 - 1), chance(50)).map(([a, shift, b, negative]) => {
+    const v = (BigInt(a) << BigInt(shift)) + BigInt(b);
+    return negative ? -v : v;
+  })],
+  [5, gs.sampledFrom(BIG_INTS)],
+);
+/** An integer node: its value, its base (decimal half the time; a negative value is always decimal), upper-case hex digits, a `+` sign, underscores. */
+const integer = node("int", { v: intValue, base: gs.sampledFrom(["dec", "dec", "dec", "hex", "oct", "bin"]), upper: chance(50), plus: chance(20), under: underscores });
+
+const RADIX = { hex: [16, "x"], oct: [8, "o"], bin: [2, "b"] };
+function renderInteger(node) {
+  const negative = node.v < 0n;
+  const mag = negative ? -node.v : node.v;
+  const base = negative ? "dec" : node.base;
+  let text;
+  if (base === "dec") {
+    text = (negative ? "-" : node.plus ? "+" : "") + underscored([mag.toString()], node.under)[0];
+  } else {
+    const [radix, letter] = RADIX[base];
+    let digits = mag.toString(radix);
+    if (base === "hex" && node.upper) digits = digits.toUpperCase();
+    text = "0" + letter + underscored([digits], node.under)[0];
+  }
+  return { text, canon: cInt(node.v) };
+}
+
+/** A float's exponent: `e` or `E`, a sign 50% of the time, 0-30 (300-400 10% of the time, overflowing to infinity). */
+const exponent = gs.record({ e: gs.sampledFrom(["e", "E"]), sign: gs.sampledFrom(["", "", "-", "+"]), digits: weighted([90, ints(0, 30)], [10, ints(300, 400)]).map(String) });
+/** The integer digits of a float: `0` 20% of the time, else 1-6 digits without a leading zero. */
+const intDigits = weighted([20, gs.just("0")], [80, gs.fromRegex("[1-9][0-9]{0,5}")]);
+/** A float node: a sign (40%), integer digits, a fraction of 1-8 digits 75% of the time with an exponent 30% of that, else an exponent alone; underscores. Or one of the six spellings of infinity and NaN 12% of the time. */
+const float = weighted(
+  [88, node("float", {
+    sign: gs.sampledFrom(["", "", "", "-", "+"]),
+    parts: weighted([75, gs.record({ int: intDigits, frac: gs.text({ alphabet: DIGITS, minSize: 1, maxSize: 8 }), exp: maybe(30, exponent) })], [25, gs.record({ int: intDigits, frac: gs.just(undefined), exp: exponent })]),
+    under: underscores,
+  })],
+  [12, node("special", { v: gs.sampledFrom(["inf", "+inf", "-inf", "nan", "+nan", "-nan"]) })],
+);
+
+function renderFloat(node) {
+  if (node.t === "special") return { text: node.v, canon: cFloat(node.v.endsWith("inf") ? (node.v[0] === "-" ? -Infinity : Infinity) : NaN) };
+  const { int, frac, exp } = node.parts;
+  const [i, f, e] = underscored([int, frac ?? "", exp === undefined ? "" : exp.digits], node.under);
+  const text = node.sign + i + (frac === undefined ? "" : "." + f) + (exp === undefined ? "" : exp.e + exp.sign + e);
+  const value = Number(text.replace(/_/g, ""));
+  if (Number.isNaN(value)) throw new Error(`generator made a bad float ${text}`);
+  return { text, canon: cFloat(value) };
+}
+
+// ---------------------------------------------------------------- date-times
+
+/** A year: 1900-2100 70% of the time, a boundary year 27%, else anywhere in 1-9999 (Python's datetime has no year 0). */
+const year = weighted([70, ints(1900, 2100)], [27, gs.sampledFrom([1, 99, 100, 1000, 1600, 1970, 2000, 9999])], [3, ints(1, 9999)]);
+/** Valid date and time components: the day drawn for the month, a fraction of 1-9 digits 60% of the time. */
+const dateParts = gs.record({ y: year, mo: ints(1, 12) }).flatMap(({ y, mo }) =>
+  gs.record({ y: gs.just(y), mo: gs.just(mo), d: ints(1, daysIn(y, mo)), h: ints(0, 23), mi: ints(0, 59), s: ints(0, 59), frac: maybe(60, gs.text({ alphabet: DIGITS, minSize: 1, maxSize: 9 })) }),
+);
+/** An offset: `Z` (lower-case a third of the time) 40% of the time, else a signed hour with minutes from {0, 30, 45} 60% of the time. */
+const offset = weighted([40, gs.sampledFrom(["Z", "Z", "z"])], [60, gs.record({ sign: gs.sampledFrom(["+", "-"]), h: ints(0, 23), m: weighted([60, gs.sampledFrom([0, 30, 45])], [40, ints(0, 59)]) })]);
+
+/** A date-time node: its kind (local date 20%, local time 20, local date-time 20, offset date-time 40), components, `T`/`t`/space separator, offset; with v11 the seconds omitted 3% of the time. */
+export const dateTimeNode = (v11) =>
+  node("date", { kind: gs.sampledFrom(["ld", "lt", "ldt", "dt", "dt"]), parts: dateParts, sep: gs.sampledFrom(["T", "T", "t", " "]), offset, noSeconds: when(v11, chance(3)) });
+
+function utcInstant(p, offsetMinutes) {
+  const date = new Date(0);
+  date.setUTCFullYear(p.y, p.mo - 1, p.d);
+  date.setUTCHours(p.h, p.mi, p.s, p.ms);
+  return new Date(date.getTime() - offsetMinutes * 60000);
+}
+
+const localDateText = (p) => `${pad(p.y, 4)}-${pad(p.mo, 2)}-${pad(p.d, 2)}`;
+const localTimeText = (p) => `${pad(p.h, 2)}:${pad(p.mi, 2)}:${pad(p.s, 2)}.${pad(p.ms, 3)}`;
+
+/**
+ * The TOML text of a date-time node and its canonical value: {text, canon, kind, parts, offset,
+ * v11}. `parts` has the milliseconds of the fraction (truncated) and no seconds when they are
+ * omitted; `offset` is the offset's text for an offset date-time. An offset that would push the
+ * instant outside years 1-9999 is written `Z`.
+ */
+export function dateTime(node) {
+  const p = { ...node.parts, ms: node.parts.frac === undefined ? 0 : Number((node.parts.frac + "000").slice(0, 3)) };
+  let time = `${pad(p.h, 2)}:${pad(p.mi, 2)}`;
+  if (node.noSeconds) {
+    p.s = 0;
+    p.ms = 0;
+    p.frac = undefined;
+  } else {
+    time += `:${pad(p.s, 2)}` + (p.frac === undefined ? "" : "." + p.frac);
+  }
+  const dateT = localDateText(p);
+  const common = { kind: node.kind, parts: p, v11: node.noSeconds };
+  if (node.kind === "ld") return { ...common, text: dateT, canon: { $ld: dateT } };
+  if (node.kind === "lt") return { ...common, text: time, canon: { $lt: localTimeText(p) } };
+  if (node.kind === "ldt") return { ...common, text: dateT + node.sep + time, canon: { $ldt: dateT + "T" + localTimeText(p) } };
+  let offset = node.offset;
+  let minutes = 0;
+  if (typeof offset !== "string") {
+    minutes = (offset.sign === "-" ? -1 : 1) * (offset.h * 60 + offset.m);
+    offset = `${offset.sign}${pad(offset.h, 2)}:${pad(offset.m, 2)}`;
+  }
+  let instant = utcInstant(p, minutes);
+  if (instant.getUTCFullYear() < 1 || instant.getUTCFullYear() > 9999) {
+    offset = "Z";
+    instant = utcInstant(p, 0);
+  }
+  return { ...common, text: dateT + node.sep + time + offset, canon: { $dt: instant.toISOString() }, offset };
+}
+
+// ---------------------------------------------------------------- arrays, tables, arrays of tables
+
+/** A gap in an array: whitespace and, 20% of the time, a comment (written only in a multi-line array). */
+const arrayGap = gs.record({ ws: gap, comment: maybe(20, comment) });
+/** An array node of 0-4 items of `child`, each with the gap before it; multi-line 30% of the time (gaps may then hold newlines and comments); a trailing comma 25% of the time. */
+const array = (child) => node("arr", { multi: chance(30), open: arrayGap, items: gs.arrays(gs.record({ v: child, gap: arrayGap }), { maxSize: 4 }), trail: maybe(25, gs.tuples(arrayGap, arrayGap)), close: arrayGap });
+
+/** How an inline table is written: over several lines with a trailing comma 40% of that (TOML 1.1, with v11) 4% of the time; the gap before its closing brace. */
+const inlineStyle = (v11) => gs.record({ multi: when(v11, chance(4)), trail: maybe(40, gap), close: gap });
+
+/**
+ * A table node whose entries hold `child` values, and, with `sub` (the table node of the level
+ * below), sub-tables 22% of the time and arrays of 1-3 tables 18%. `how` is its rendering under a
+ * table body (a header section 50%, dotted keys 25%, inline 25%); `deep` whether it continues a
+ * dotted parent (60%); `implicit` whether its header is dropped when only sub-tables imply it
+ * (40%); `header` and `hws` the line and whitespace of its header; `inline` its inline style.
+ */
+function tableNode(v11, child, sub, most) {
+  const value = sub === null ? child : weighted([60, child], [22, sub], [18, node("aot", { elements: gs.arrays(sub, { minSize: 1, maxSize: 3 }), inline: chance(35), ws: gs.tuples(ws, ws, ws) })]);
+  const entry = gs.record({ order: ints(0, 99), key: keyStyle, line: lineStyle, eq: gs.tuples(ws, ws), gap, node: value });
+  return node("tbl", {
+    entries: gs.maps(keyName, entry, { maxSize: most }),
+    how: gs.sampledFrom(["header", "header", "dotted", "inline"]),
+    deep: chance(60),
+    implicit: chance(40),
+    header: lineStyle,
+    hws: gs.tuples(ws, ws),
+    inline: inlineStyle(v11),
+  });
+}
+
+/** The value node generator of a level and its table node: at the deepest level scalars only; above it arrays (8%) and inline tables (7%) of the level below. */
+function levels(v11) {
+  const scalars = [[20, integer], [8, node("bool", { v: gs.booleans() })], [30, string(v11)], [15, float], [12, dateTimeNode(v11)]];
+  let value = weighted(...scalars);
+  let table = tableNode(v11, value, null, 4);
+  for (let depth = 2; depth >= 0; depth--) {
+    value = weighted(...scalars, [8, array(value)], [7, table]);
+    table = tableNode(v11, value, table, depth === 0 ? 6 : 4);
+  }
+  return { value, table };
+}
+
+/** The entries of a table in the drawn order (equal keys keep the drawn insertion order). */
+const ordered = (entries) => [...entries].sort((a, b) => a[1].order - b[1].order);
+
+/** The text of `g`, a gap: newlines as the line ending in a multi-line container, else as spaces. */
+const gapText = (g, nl, multi) => g.replace(/\n/g, multi ? nl : " ");
+
+/** The text and value of any node written as a value (a table inline, an array of tables as an array of inline tables): {text, canon}; `flags.v11` is set when TOML 1.1 syntax is used. */
+function valueOf(node, nl, flags) {
+  switch (node.t) {
+    case "str":
+      return renderString(node, nl, flags);
+    case "int":
+      return renderInteger(node);
+    case "float":
+    case "special":
+      return renderFloat(node);
+    case "bool":
+      return { text: String(node.v), canon: node.v };
+    case "date": {
+      const d = dateTime(node);
+      if (d.v11) flags.v11 = true;
+      return { text: d.text, canon: d.canon };
+    }
+    case "arr": {
+      const gapOf = (g) => gapText(g.ws, nl, node.multi) + (node.multi && g.comment !== undefined ? g.comment + nl : "");
+      const items = node.items.map((it) => valueOf(it.v, nl, flags));
+      let text = "[" + gapOf(node.open) + node.items.map((it, i) => (i ? "," + gapOf(it.gap) : "") + items[i].text).join("");
+      if (node.items.length && node.trail !== undefined) text += gapOf(node.trail[0]) + "," + gapOf(node.trail[1]);
+      return { text: text + gapOf(node.close) + "]", canon: items.map((x) => x.canon) };
+    }
+    case "aot": {
+      const elements = node.elements.map((el) => valueOf(el, nl, flags));
+      return { text: "[" + node.ws[0] + elements.map((x) => x.text).join("," + node.ws[1]) + node.ws[2] + "]", canon: elements.map((x) => x.canon) };
+    }
+    case "tbl": {
+      const o = {};
+      const { multi, trail, close } = node.inline;
+      if (multi) flags.v11 = true;
+      let text = "{";
+      ordered(node.entries).forEach(([name, e], i) => {
+        const v = valueOf(e.node, nl, flags);
+        setKey(o, name, v.canon);
+        text += (i ? "," : "") + gapText(e.gap, nl, multi) + keyText(name, e.key, flags) + e.eq[0] + "=" + e.eq[1] + v.text;
+      });
+      if (multi && node.entries.size > 0 && trail !== undefined) text += gapText(trail, nl, multi) + ",";
+      return { text: text + gapText(close, nl, multi) + "}", canon: cTable(o) };
+    }
+  }
+  throw new Error(`unknown node kind ${node.t}`);
+}
+
+/** The canonical value of a node (the tomllib form of hegel-toml.mjs), for a document with line ending `nl`. */
+export function canonNode(node, nl) {
+  return valueOf(node, nl, {}).canon;
+}
+
+// ---------------------------------------------------------------- documents
+
+function emitKV(out, e, parts, text) {
+  emit(out, e.line, dottedKey(parts, out) + e.eq[0] + "=" + e.eq[1] + text);
+}
+
+function emitHeader(out, table, parts, aot) {
+  const [open, close] = aot ? ["[[", "]]"] : ["[", "]"];
+  emit(out, table.header, open + table.hws[0] + dottedKey(parts, out) + table.hws[1] + close);
+}
+
+/** Writes a table's entries as dotted keys under `parts`; a non-empty sub-table continues the dotted path when its `deep` says so, else it is written inline. */
+function emitDotted(out, table, parts) {
+  for (const [name, e] of ordered(table.entries)) {
+    const keys = [...parts, [name, e.key]];
+    if (e.node.t === "tbl" && e.node.entries.size > 0 && e.node.deep) emitDotted(out, e.node, keys);
+    else emitKV(out, e, keys, valueOf(e.node, out.nl, out).text);
+  }
+}
+
+/** Writes a table as a body (key/values, dotted keys, inline tables, with keys relative to the table) followed by its sections ([x] and [[x]] headers, with keys from the root); returns the body's size. */
+function renderTable(out, table, parts) {
+  const sections = [];
+  let body = 0;
+  for (const [name, e] of ordered(table.entries)) {
+    const key = [name, e.key];
+    const child = e.node;
+    if (child.t === "tbl" && child.how === "header") {
+      sections.push([[...parts, key], child]);
+    } else if (child.t === "tbl" && child.how === "dotted" && child.entries.size > 0) {
+      emitDotted(out, child, [key]);
+      body++;
+    } else if (child.t === "aot" && !child.inline) {
+      sections.push([[...parts, key], child]);
+    } else {
+      emitKV(out, e, [key], valueOf(child, out.nl, out).text);
+      body++;
+    }
+  }
+  for (const [keys, child] of sections) {
+    if (child.t === "tbl") {
+      const at = out.lines.length;
+      emitHeader(out, child, keys, false);
+      const headerLines = out.lines.length - at;
+      const size = renderTable(out, child, keys);
+      // a super-table that is only implied by its sub-tables' headers need not be declared
+      if (size === 0 && child.entries.size > 0 && child.implicit) out.lines.splice(at, headerLines);
+    } else {
+      for (const el of child.elements) {
+        emitHeader(out, el, keys, true);
+        renderTable(out, el, keys);
+      }
+    }
+  }
+  return body;
+}
+
+/** A document: its line ending (CRLF 15% of the time), a root table, a leading and a trailing comment line 10% each, a final newline 80%. With `v11` its strings, date-times and inline tables may use TOML 1.1 syntax. */
+export const document = (v11) =>
+  gs.record({
+    nl: weighted([85, gs.just("\n")], [15, gs.just("\r\n")]),
+    root: levels(v11).table,
+    head: maybe(10, comment),
+    foot: maybe(10, gs.tuples(ws, comment).map(([w, c]) => w + c)),
+    finalNl: chance(80),
+  });
+
+/** The text of a drawn document, its model value (strict canonical form) and whether it uses TOML 1.1 syntax: {text, value, v11}. */
+export function render(doc) {
+  const out = { lines: [], nl: doc.nl, v11: false };
+  if (doc.head !== undefined) out.lines.push(doc.head);
+  renderTable(out, doc.root, []);
+  if (doc.foot !== undefined) out.lines.push(doc.foot);
+  let text = out.lines.join(doc.nl);
+  if (doc.finalNl || text.endsWith("]")) text += doc.nl;
+  return { text, value: canonNode(doc.root, doc.nl), v11: out.v11 };
+}
+
+// ---------------------------------------------------------------- mutations
+
+const TOKENS = ["[", "]", "[[", "]]", "{", "}", "=", ".", ",", "#", '"', "'", '"""', "'''", "\\", "\n", "\n", " ", "\t", "\0", "\x7f", "\r", "e", "x", "_", "0", "9", "-", "+", "T", "Z", ":", "inf", "nan", "true", "1979-05-27", "07:32:00", "\\u", "\\U0000", "\\uD800", "\\e", "\\x41", "a = 1", "[a]", "[[a]]", "a.b", "\u{e9}", "\u{2028}", "\u{feff}", "1e", "0x", "1__2", "1.", ".5", "+0x1", "-0", "24:00:00", "00:60:00", "1979-02-30", "13:00:00Z", "+24:00"];
+
+const token = gs.sampledFrom(TOKENS);
+/** 1-3 edits of a text of `length` characters and `lines` lines, each: delete a character 15%, insert a token 20%, replace a character by a token 15%; duplicate a line elsewhere 15%, delete a line 15%, swap two lines 10%, strip a line's indentation 10%. Positions are drawn for the text as rendered (so an edit at its end is as likely as one at its start) and taken modulo the live size when applied. */
+function editsOf(length, lines) {
+  const at = ints(0, length);
+  const line = ints(0, lines - 1);
+  const edit = weighted(
+    [15, gs.record({ op: gs.just("delete"), at })],
+    [20, gs.record({ op: gs.just("insert"), at, token })],
+    [15, gs.record({ op: gs.just("replace"), at, token })],
+    [15, gs.record({ op: gs.just("duplicate"), i: line, j: line })],
+    [15, gs.record({ op: gs.just("cut"), i: line })],
+    [10, gs.record({ op: gs.just("swap"), i: line, j: line })],
+    [10, gs.record({ op: gs.just("unindent"), i: line })],
+  );
+  return gs.arrays(edit, { minSize: 1, maxSize: 3 });
+}
+
+/** The rejection-differential case: a rendered document ({text, value, v11}, TOML 1.1 syntax allowed) and 1-3 edits of its text. */
+export const mutationCase = document(true).flatMap((drawn) => {
+  const doc = render(drawn);
+  return gs.record({ doc: gs.just(doc), edits: editsOf(doc.text.length, doc.text.split("\n").length) });
+});
+
+/** `text` with the edits applied in turn, positions taken modulo the live text or line count. */
+export function mutate(text, edits) {
+  for (const e of edits) {
+    if (e.op === "delete" || e.op === "insert" || e.op === "replace") {
+      const i = e.at % (text.length + 1);
+      const rest = text.slice(i + (e.op === "insert" ? 0 : 1));
+      text = text.slice(0, i) + (e.op === "delete" ? "" : e.token) + rest;
+      continue;
+    }
+    const lines = text.split("\n");
+    const i = e.i % lines.length;
+    const j = e.j === undefined ? 0 : e.j % lines.length;
+    if (e.op === "duplicate") lines.splice(j, 0, lines[i]);
+    else if (e.op === "cut") lines.splice(i, 1);
+    else if (e.op === "swap") [lines[i], lines[j]] = [lines[j], lines[i]];
+    else lines[i] = lines[i].trimStart();
+    text = lines.join("\n");
+  }
+  return text;
+}
+
+// ---------------------------------------------------------------- JavaScript values for stringify
+
+const STR_POOL = ["", "a", "hello world", "\u{e9}\u{65e5}\u{1F600}", "\t", "\n", "\r\n", "\0", "\x1b", "\x7f", "\u{2028}", '"', "'", "\\", '"""', "'''", "#", "[table]", "a = 1", "\x85", "\u{feff}", "\u{d800}"];
+const NUMBERS = [0, -0, 2 ** 53 - 1, -(2 ** 53 - 1), 2 ** 53, -(2 ** 53), 1e21, -1e21, 1e300, 123456789012345680000];
+const FLOATS = [0.1, -0.5, 1.5e-7, 5e-324, 1.7976931348623157e308, NaN, Infinity, -Infinity, Math.PI];
+const BIGINTS = [0n, -0n, 9007199254740993n, -9223372036854775808n, 18446744073709551616n];
+const OFFSETS = ["Z", "+05:30", "-08:00", "+00:00"];
+
+/** A string: one of the awkward pool half the time (a lone surrogate among them), else 0-8 text characters. */
+const jsString = weighted([50, gs.sampledFrom(STR_POOL)], [50, pieces(TEXT_CHARS, 0, 8)]);
+/** A number: -1000..1000 60% of the time, else a boundary (-0, the safe range, 1e21 and beyond). */
+const jsNumber = weighted([60, ints(-1000, 1000)], [40, gs.sampledFrom(NUMBERS)]);
+/** A float: a small fraction 80% of the time, else a boundary, NaN or an infinity. */
+const jsFloat = weighted([80, gs.tuples(ints(-100000, 100000), gs.sampledFrom([4, 8, 10, 1000, 7])).map(([a, d]) => a / d)], [20, gs.sampledFrom(FLOATS)]);
+const jsBigInt = weighted([50, ints(-1000, 1000).map(BigInt)], [50, gs.sampledFrom(BIGINTS)]);
+/** A Date within about 63 years of the epoch, to the millisecond. */
+const jsDate = gs.tuples(ints(-2000000000, 2000000000), ints(0, 999)).map(([s, ms]) => new Date(s * 1000 + ms));
+/** A TomlDate: read from a date-time's text 70% of the time, else wrapped from a Date (an offset date-time in one of four offsets). */
+const jsTomlDate = gs.record({ d: dateTimeNode(false), wrap: maybe(30, gs.sampledFrom(OFFSETS)) }).map(({ d, wrap }) => {
+  const r = dateTime(d);
+  if (wrap === undefined) return new TomlDate(r.text);
+  switch (r.kind) {
+    case "dt":
+      return TomlDate.wrapAsOffsetDateTime(new Date(r.canon.$dt), wrap);
+    case "ldt":
+      return TomlDate.wrapAsLocalDateTime(new Date(r.canon.$ldt + "Z"));
+    case "ld":
+      return TomlDate.wrapAsLocalDate(new Date(r.canon.$ld + "T00:00:00Z"));
+    default:
+      return TomlDate.wrapAsLocalTime(new Date("1970-01-01T" + r.canon.$lt + "Z"));
+  }
+});
+/** A scalar: number 20%, boolean 8, string 25, float 15, bigint 10, Date 6, TomlDate 16. */
+const jsScalar = weighted([20, jsNumber], [8, gs.booleans()], [25, jsString], [15, jsFloat], [10, jsBigInt], [6, jsDate], [16, jsTomlDate]);
+
+/** What stringify ignores in a table, and what it must reject. */
+const nullish = gs.sampledFrom([null, undefined]);
+const rejected = gs.sampledFrom([() => 1, Symbol("s")]);
+
+/** A plain object of up to `most` entries with distinct keys (`__proto__` as an own property). */
+const jsTable = (child, most) =>
+  gs.maps(keyName, child, { maxSize: most }).map((m) => {
+    const o = {};
+    for (const [k, v] of m) setKey(o, k, v);
+    return o;
+  });
+/** An array of 0-4 elements: any values 60% of the time, else tables (an array of tables); 4% of the time a null or undefined is appended. */
+const jsArray = (child, table) =>
+  gs.record({ items: weighted([60, gs.arrays(child, { maxSize: 4 })], [40, gs.arrays(table, { maxSize: 4 })]), tail: maybe(4, nullish) }).map(({ items, tail }) => (tail === undefined ? items : [...items, tail]));
+
+/**
+ * A plain object for stringify, nesting four levels deep. A table's value is a scalar 55% of the
+ * time, null or undefined 7 (ignored), a function or symbol 2 (rejected), a table 16, an array 20;
+ * an array's element likewise but never null (a function or symbol 9%).
+ */
+function jsValue() {
+  let inTable = jsScalar;
+  let inArray = jsScalar;
+  let table = jsTable(inTable, 3);
+  for (let depth = 3; depth >= 0; depth--) {
+    table = jsTable(inTable, depth === 0 ? 6 : 3);
+    const array = jsArray(inArray, table);
+    inArray = weighted([55, jsScalar], [9, rejected], [16, table], [20, array]);
+    inTable = weighted([55, jsScalar], [7, nullish], [2, rejected], [16, table], [20, array]);
+  }
+  return table;
+}
+
+/** The stringify case: a plain object and whether integral numbers are written as floats. */
+export const stringifyCase = gs.record({ obj: jsValue(), numbersAsFloat: chance(50) });
+
+/** The TomlDate case: a date-time node in TOML 1.0 syntax (see `dateTime`). */
+export const dateCase = dateTimeNode(false);
