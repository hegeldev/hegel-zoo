+  if (r < 78) return chance(tc, 50);
+  if (r < 84) {
+    const ms = n(tc, -2000000000, 2000000000) * 1000 + n(tc, 0, 999);
+    return new Date(ms);
+  }
+  const d = genDateTime(tc, null);
+  if (chance(tc, 70)) return new TomlDate(d.text);
+  const js = new Date(d.kind === "dt" ? d.canon.$dt : d.kind === "ldt" ? d.canon.$ldt + "Z" : d.kind === "ld" ? d.canon.$ld + "T00:00:00Z" : "1970-01-01T" + d.canon.$lt + "Z");
+  if (d.kind === "dt") return TomlDate.wrapAsOffsetDateTime(js, pick(tc, ["Z", "+05:30", "-08:00", "+00:00"]));
+  if (d.kind === "ldt") return TomlDate.wrapAsLocalDateTime(js);
+  if (d.kind === "ld") return TomlDate.wrapAsLocalDate(js);
+  return TomlDate.wrapAsLocalTime(js);
+}
+
+/** A random plain object for stringify: {obj, model: {negZero, loneSurrogate}} (shapes: stringifyShapes). */
+export function genJsValue(tc) {
+  const model = { negZero: false, loneSurrogate: false };
+  const obj = genJsTable(tc, model, 0);
+  return { obj, model };
+}
+
+function genJsTable(tc, model, depth) {
+  const obj = {};
+  const taken = new Set();
+  const size = n(tc, 0, depth === 0 ? 6 : 3);
+  for (let i = 0; i < size; i++) {
+    const k = genKeyName(tc, taken);
+    const v = genJsAny(tc, model, depth + 1, true);
+    if (k === "__proto__") Object.defineProperty(obj, k, { value: v, enumerable: true, configurable: true, writable: true });
+    else obj[k] = v;
+  }
+  return obj;
+}
+
+function genJsAny(tc, model, depth, inTable) {
+  const r = n(tc, 0, 99);
+  if (r < 55 || depth >= 4) return genJsScalar(tc, model);
+  if (r < 62 && inTable) return chance(tc, 50) ? null : undefined; // ignored in tables
+  if (r < 64) return chance(tc, 50) ? () => 1 : Symbol("s"); // rejected
+  if (r < 80) return genJsTable(tc, model, depth);
+  const len = n(tc, 0, 4);
+  const arr = [];
+  const tables = chance(tc, 40);
+  for (let i = 0; i < len; i++) arr.push(tables ? genJsTable(tc, model, depth + 1) : genJsAny(tc, model, depth + 1, false));
+  if (chance(tc, 4)) arr.push(chance(tc, 50) ? null : undefined);
+  return arr;
+}
+
+/** Shapes of `obj` that stringify handles differently from its documentation (bugs.toml):
+ *  nullInInlineTable — a null or undefined value in a table that is written inline (an element
+ *  of an array that is not purely an array of tables, or anything below such a table). */
+export function stringifyShapes(obj) {
+  const shapes = { nullInInlineTable: false, undefinedInInlineTable: false, functionInline: false, functionInTable: false, nullInArray: false };
+  const isTable = (v) => v !== null && typeof v === "object" && !Array.isArray(v) && !(v instanceof Date);
+  const isFn = (v) => typeof v === "function" || typeof v === "symbol";
+  const walk = (v, inline) => {
+    if (Array.isArray(v)) {
+      const aot = v.length > 0 && v.every(isTable);
+      for (const x of v) {
+        if (x === null || x === undefined) shapes.nullInArray = true;
+        else if (isFn(x)) shapes.functionInline = true;
+        else walk(x, inline || !aot);
+      }
+    } else if (isTable(v)) {
+      for (const k of Object.keys(v)) {
+        const x = v[k];
+        if (x === null) {
+          if (inline) shapes.nullInInlineTable = true;
+        } else if (x === undefined) {
+          if (inline) shapes.undefinedInInlineTable = true;
+        } else if (isFn(x)) {
+          if (inline) shapes.functionInline = true;
+          else shapes.functionInTable = true;
+        } else {
+          walk(x, inline);
+        }
+      }
+    }
+  };
+  walk(obj, false);
+  return shapes;
+}
+
+/** What parse(stringify(obj, {numbersAsFloat})) must give, in strict canonical form. */
+export function expectedAfterStringify(v, numbersAsFloat) {
+  if (typeof v === "number") {
+    if (Number.isInteger(v) && !numbersAsFloat && Number.isSafeInteger(v)) return cInt(Object.is(v, -0) ? 0 : v);
+    return cFloat(v);
+  }
+  if (Array.isArray(v)) return v.map((x) => expectedAfterStringify(x, numbersAsFloat));
+  if (v !== null && typeof v === "object" && !(v instanceof Date)) {
+    const o = {};
+    for (const k of Object.keys(v)) {
+      if (v[k] !== null && v[k] !== undefined && typeof v[k] !== "function" && typeof v[k] !== "symbol") setKey(o, k, expectedAfterStringify(v[k], numbersAsFloat));
+    }
+    return cTable(o);
+  }
+  return canon(v);
+}
+
+export { count };
