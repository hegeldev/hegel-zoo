@@ -0,0 +1,274 @@
+// Hegel zoo: the tomllib oracle bridge, the canonical value form shared with it, the shapes of
+// the recorded bugs and of the oracle's limits, and what stringify's output must read back as.
+// Nothing here draws: the generators are in hegel-gen.mjs.
+
+import { execFileSync, spawn } from "node:child_process";
+import { mkdtempSync, openSync, readSync, rmSync, writeSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { dirname, join } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+
+const here = dirname(fileURLToPath(import.meta.url));
+
+// The library under test: src/ compiled by the pinned TypeScript into .hegel/dist (see
+// tsconfig.hegel.json and the target's [run] setup).
+export const lib = await import(pathToFileURL(join(here, "..", ".hegel", "dist", "index.js")));
+export const { parse, stringify, TomlDate, TomlError } = lib;
+
+// ---------------------------------------------------------------- the oracle, held open
+
+let oracle = null;
+
+function startOracle() {
+  execFileSync("python3", ["-c", "import tomllib"], { stdio: "ignore" });
+  const dir = mkdtempSync(join(tmpdir(), "hegel-toml-"));
+  const req = join(dir, "req");
+  const resp = join(dir, "resp");
+  execFileSync("mkfifo", [req, resp]);
+  const child = spawn("python3", ["-u", join(here, "hegel-toml-oracle.py"), req, resp], {
+    stdio: ["ignore", "inherit", "inherit"],
+  });
+  child.unref();
+  const wfd = openSync(req, "w");
+  const rfd = openSync(resp, "r");
+  process.on("exit", () => {
+    try { child.kill(); } catch {}
+    try { rmSync(dir, { recursive: true, force: true }); } catch {}
+  });
+  const buf = Buffer.alloc(1 << 16);
+  let pending = "";
+  return {
+    call(obj) {
+      // Lone surrogates cannot cross as UTF-8; escape every unpaired surrogate code unit.
+      const line = JSON.stringify(obj).replace(/[\u{d800}-\u{dfff}]/gu, (c) => "\\u" + c.charCodeAt(0).toString(16).padStart(4, "0"));
+      writeSync(wfd, line + "\n");
+      for (;;) {
+        const nl = pending.indexOf("\n");
+        if (nl !== -1) {
+          const answer = pending.slice(0, nl);
+          pending = pending.slice(nl + 1);
+          return JSON.parse(answer);
+        }
+        const got = readSync(rfd, buf, 0, buf.length, null);
+        if (got === 0) throw new Error("the tomllib oracle went away");
+        pending += buf.toString("utf8", 0, got);
+      }
+    },
+  };
+}
+
+/** tomllib.loads(text): {ok: true, value} in canonical form, or {ok: false, error}. */
+export function pyParse(text) {
+  oracle ??= startOracle();
+  return oracle.call({ op: "parse", text });
+}
+
+// ---------------------------------------------------------------- canonical form
+
+export function floatBits(x) {
+  if (Number.isNaN(x)) return "nan";
+  const view = new DataView(new ArrayBuffer(8));
+  view.setFloat64(0, x);
+  let s = "";
+  for (let i = 0; i < 8; i++) s += view.getUint8(i).toString(16).padStart(2, "0");
+  return s;
+}
+
+function bitsToFloat(bits) {
+  if (bits === "nan") return NaN;
+  const view = new DataView(new ArrayBuffer(8));
+  for (let i = 0; i < 8; i++) view.setUint8(i, parseInt(bits.slice(2 * i, 2 * i + 2), 16));
+  return view.getFloat64(0);
+}
+
+/** Sets an own enumerable property (a plain assignment of "__proto__" would set the prototype). */
+export function setKey(o, k, v) {
+  Object.defineProperty(o, k, { value: v, enumerable: true, writable: true, configurable: true });
+}
+
+export const cInt = (v) => ({ $i: typeof v === "bigint" ? v.toString() : String(v) });
+export const cFloat = (x) => ({ $f: floatBits(x) });
+export const cTable = (o) => ({ $m: o });
+
+const isoUTC = Date.prototype.toISOString;
+
+/** The canonical form of a value smol-toml parsed or stringify was given (TomlDate/Date aware).
+ *  `loose`: integral safe numbers count as integers (what the default and 'asNeeded' modes
+ *  return for integers and for floats such as 1.0 alike). */
+export function canon(v, loose = false) {
+  if (typeof v === "string" || typeof v === "boolean") return v;
+  if (typeof v === "bigint") return cInt(v);
+  if (typeof v === "number") {
+    if (loose && Number.isSafeInteger(v)) return cInt(v);
+    return cFloat(v);
+  }
+  if (v instanceof TomlDate) {
+    if (v.isDateTime() && !v.isLocal()) return { $dt: isoUTC.call(v) };
+    if (v.isDateTime()) return { $ldt: v.toISOString() };
+    if (v.isDate()) return { $ld: v.toISOString() };
+    if (v.isTime()) return { $lt: v.toISOString() };
+    throw new Error("invalid TomlDate in a parsed value");
+  }
+  if (v instanceof Date) return { $dt: isoUTC.call(v) };
+  if (Array.isArray(v)) return v.map((x) => canon(x, loose));
+  if (v !== null && typeof v === "object") {
+    const o = {};
+    for (const k of Object.keys(v)) setKey(o, k, canon(v[k], loose));
+    return cTable(o);
+  }
+  throw new Error(`unexpected value ${String(v)}`);
+}
+
+/** The loose view of a strict canonical value: integral safe floats become integers. */
+export function loosen(c) {
+  if (c === null || typeof c !== "object") return c;
+  if (Array.isArray(c)) return c.map(loosen);
+  if ("$f" in c) {
+    const x = bitsToFloat(c.$f);
+    return Number.isSafeInteger(x) ? cInt(x) : c;
+  }
+  if ("$m" in c) {
+    const o = {};
+    for (const k of Object.keys(c.$m)) setKey(o, k, loosen(c.$m[k]));
+    return cTable(o);
+  }
+  return c;
+}
+
+/** The canonical value with CRLF newlines inside strings turned into LF: tomllib normalises
+ *  every CRLF of the document before parsing (Python's convention), while the specification
+ *  says newlines inside multi-line strings "remain intact" (and smol-toml keeps them). */
+export function normaliseCrlf(c) {
+  if (typeof c === "string") return c.replace(/\r\n/g, "\n");
+  if (c === null || typeof c !== "object") return c;
+  if (Array.isArray(c)) return c.map(normaliseCrlf);
+  if ("$m" in c) {
+    const o = {};
+    for (const k of Object.keys(c.$m)) setKey(o, k, normaliseCrlf(c.$m[k]));
+    return cTable(o);
+  }
+  return c;
+}
+
+/** smol-toml/6's shape in a document: a quote right after a line-ending backslash (and the
+ *  whitespace it trims) in a multi-line basic string. Approximate (a literal string may match). */
+export function quoteAfterLineEndingBackslash(text) {
+  return /\\[ \t]*\r?\n[ \t\r\n]*"/.test(text);
+}
+
+/** smol-toml/7's shape: a character JavaScript's trimEnd() treats as whitespace but TOML does not
+ *  (a lone CR, form feed, vertical tab, NBSP, the Unicode spaces, the BOM) anywhere in the text. */
+export function jsOnlyWhitespace(text) {
+  return /[\x0b\x0c\x85\xa0\u{1680}\u{2000}-\u{200a}\u{2028}\u{2029}\u{202f}\u{205f}\u{3000}\u{feff}]|\r(?!\n)/u.test(text);
+}
+
+/** smol-toml/8's shape: inside an array, a comment followed by a line that does not start with a
+ *  comma, a closing bracket or another comment (approximate). */
+export function elementAfterCommentInArray(text) {
+  return /\[[^\n\]]*#[^\n]*\n[ \t\n]*[^ \t\n,\]#]/.test(text);
+}
+
+/** smol-toml/9's shape: a quoted key part containing "=" (the other quote character may appear in it; approximate). */
+export function quotedKeyWithEquals(text) {
+  return /(^|[{,\n])[ \t]*(?:'[^'\n]*=[^'\n]*'|"[^"\n]*=[^"\n]*")/.test(text);
+}
+
+/** smol-toml/10's shape: a line opening an array-of-tables header (`[[`) whose key is closed by a
+ *  single `]` followed by at most one other character (not `]`), then whitespace, a comment, a
+ *  line end, a bare CR or the end of the document (approximate). */
+export function arrayOfTablesHeaderWithOneBracket(text) {
+  return /^[ \t]*\[\[[^\n]*[^\]\n]\][^\]\r\n]?[ \t]*(?=[\r\n#]|$)/m.test(text);
+}
+
+/** Does the canonical value hold an integer outside the safe range (default mode rejects it)? */
+export function hasBigInt(c) {
+  if (c === null || typeof c !== "object") return false;
+  if (Array.isArray(c)) return c.some(hasBigInt);
+  if ("$i" in c) return !Number.isSafeInteger(Number(c.$i)) || BigInt(c.$i) !== BigInt(Number(c.$i));
+  if ("$m" in c) return Object.keys(c.$m).some((k) => hasBigInt(c.$m[k]));
+  return false;
+}
+
+// ---------------------------------------------------------------- the calendar
+
+const DAYS = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
+const isLeap = (y) => (y % 4 === 0 && y % 100 !== 0) || y % 400 === 0;
+/** The number of days of month `mo` (1-12) of year `y`. */
+export const daysIn = (y, mo) => (mo === 2 && isLeap(y) ? 29 : DAYS[mo - 1]);
+
+/** Why smol-toml might accept `text` while tomllib (TOML 1.0) rejects it: a limit key, or null. */
+export function acceptedOnlyBySmol(text) {
+  if (/\\[ex]/.test(text)) return "limit/v11-escape";
+  if (/(^|[^\d:])\d{2}:\d{2}(?![:\d])/.test(text.replace(/[+-]\d{2}:\d{2}/g, "+HH:MM"))) return "limit/v11-time-without-seconds";
+  // a newline inside an inline table, or a trailing comma before its "}" (the table may hold nested
+  // tables and arrays, so the comma is looked for on its own)
+  if (/\{[^{}]*\n/.test(text) || /,\s*\}/.test(text)) return "limit/v11-inline-table";
+  for (const m of text.matchAll(/(\d{4})-(\d{2})-(\d{2})/g)) {
+    const y = Number(m[1]);
+    const mo = Number(m[2]);
+    const d = Number(m[3]);
+    if (y === 0) return "limit/year-zero";
+    if (mo >= 1 && mo <= 12 && d > daysIn(y, mo)) return "limit/calendar-day";
+  }
+  return null;
+}
+
+// ---------------------------------------------------------------- stringify's contract
+
+/** Shapes of `obj` that stringify handles differently from its documentation (bugs.toml):
+ *  nullInInlineTable / undefinedInInlineTable: a null or undefined value in a table that is
+ *  written inline (an element of an array that is not purely an array of tables, or anything
+ *  below such a table); functionInline / functionInTable: a function or symbol there or in a
+ *  table written as a section; nullInArray: a null or undefined array element (a documented
+ *  rejection); negZero: a -0 anywhere; loneSurrogate: a string or key that is not well-formed. */
+export function stringifyShapes(obj) {
+  const shapes = { nullInInlineTable: false, undefinedInInlineTable: false, functionInline: false, functionInTable: false, nullInArray: false, negZero: false, loneSurrogate: false };
+  const isTable = (v) => v !== null && typeof v === "object" && !Array.isArray(v) && !(v instanceof Date);
+  const isFn = (v) => typeof v === "function" || typeof v === "symbol";
+  const walk = (v, inline) => {
+    if (typeof v === "number" && Object.is(v, -0)) shapes.negZero = true;
+    if (typeof v === "string" && !v.isWellFormed()) shapes.loneSurrogate = true;
+    if (Array.isArray(v)) {
+      const aot = v.length > 0 && v.every(isTable);
+      for (const x of v) {
+        if (x === null || x === undefined) shapes.nullInArray = true;
+        else if (isFn(x)) shapes.functionInline = true;
+        else walk(x, inline || !aot);
+      }
+    } else if (isTable(v)) {
+      for (const k of Object.keys(v)) {
+        if (!k.isWellFormed()) shapes.loneSurrogate = true;
+        const x = v[k];
+        if (x === null) {
+          if (inline) shapes.nullInInlineTable = true;
+        } else if (x === undefined) {
+          if (inline) shapes.undefinedInInlineTable = true;
+        } else if (isFn(x)) {
+          if (inline) shapes.functionInline = true;
+          else shapes.functionInTable = true;
+        } else {
+          walk(x, inline);
+        }
+      }
+    }
+  };
+  walk(obj, false);
+  return shapes;
+}
+
+/** What parse(stringify(obj, {numbersAsFloat})) must give, in strict canonical form. */
+export function expectedAfterStringify(v, numbersAsFloat) {
+  if (typeof v === "number") {
+    if (Number.isInteger(v) && !numbersAsFloat && Number.isSafeInteger(v)) return cInt(Object.is(v, -0) ? 0 : v);
+    return cFloat(v);
+  }
+  if (Array.isArray(v)) return v.map((x) => expectedAfterStringify(x, numbersAsFloat));
+  if (v !== null && typeof v === "object" && !(v instanceof Date)) {
+    const o = {};
+    for (const k of Object.keys(v)) {
+      if (v[k] !== null && v[k] !== undefined && typeof v[k] !== "function" && typeof v[k] !== "symbol") setKey(o, k, expectedAfterStringify(v[k], numbersAsFloat));
+    }
+    return cTable(o);
+  }
+  return canon(v);
+}
diff --git a/test/hegel-zoo.mjs b/test/hegel-zoo.mjs
new file mode 100644
index 0000000..9c7797c
--- /dev/null
+++ b/test/hegel-zoo.mjs
@@ -0,0 +1,118 @@
+// Hegel zoo: the small harness shared by the zoo's TypeScript/JavaScript targets.
+//
+// `property(name, body)` registers a node:test test that runs `body(tc)` under Hegel with
+// HEGEL_TEST_CASES cases (default 100) and the database at HEGEL_DATABASE. With ZOO_COLLECT=1
+// a `fail()` records the mismatch instead of failing, the case ends there, and the counts of
+// mismatches and of the shapes seen (`count(key)`) are printed at the end of the test, so a
+// property can be run over many cases to see every shape at once. `pin(name, body)` is a
+// plain test for one pinned bug: it must fail while the bug is present and pass once it is
+// fixed (the zoo's judge reads an unexpected pass as "fixed upstream?").
+
+import { readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+import { test as nodeTest } from "node:test";
+
+// The Hegel version these tests were written against (the zoo pins it in zoo.toml; upstream
+// would add it to devDependencies). smol-toml's package.json declares `devEngines.packageManager
+// = pnpm` with `onFail: "error"`, which makes npm refuse to install anything into the package
+// itself, so Hegel (and the TypeScript compiler that builds src/ into .hegel/dist) are installed
+// with `npm install --prefix .hegel` and imported from there. Checked at load time so a stray
+// install cannot silently change the engine.
+export const HEGEL_PIN = { "@hegeldev/hegel": "0.4.5" };
+
+const hegelDir = join(dirname(fileURLToPath(import.meta.url)), "..", ".hegel", "node_modules", "@hegeldev", "hegel");
+{
+  const installed = JSON.parse(readFileSync(join(hegelDir, "package.json"), "utf8")).version;
+  if (installed !== HEGEL_PIN["@hegeldev/hegel"]) {
+    throw new Error(`@hegeldev/hegel ${installed} is installed; these tests pin ${HEGEL_PIN["@hegeldev/hegel"]}`);
+  }
+}
+const hegel = await import(pathToFileURL(join(hegelDir, "dist", "index.js")));
+const gs = await import(pathToFileURL(join(hegelDir, "dist", "generators", "index.js")));
+
+/** Hegel's generators, re-exported so the tests import everything from one place. */
+export { gs };
+
+export const collecting = !!process.env.ZOO_COLLECT;
+
+class Collected extends Error {}
+
+let msgs = [];
+let stats = new Map();
+
+/** Report a mismatch: an error normally, a recorded line in collect mode. */
+export function fail(message) {
+  if (collecting) {
+    msgs.push(message);
+    throw new Collected(message);
+  }
+  throw new Error(message);
+}
+
+/** Bump a statistic (the shape of a pinned bug, a generator branch). */
+export function count(key) {
+  stats.set(key, (stats.get(key) || 0) + 1);
+}
+
+function settings() {
+  const s = { testCases: Number(process.env.HEGEL_TEST_CASES) || 100 };
+  if (process.env.HEGEL_DATABASE) {
+    s.database = hegel.Database.fromPath(process.env.HEGEL_DATABASE);
+  }
+  return s;
+}
+
+/** A property: `body(tc)` runs under Hegel; a thrown error (or `fail`) is a failure. */
+export function property(name, body) {
+  nodeTest(name, () => {
+    msgs = [];
+    stats = new Map();
+    hegel.test((tc) => {
+      try {
+        body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** A pin: a plain test for one recorded bug. */
+export function pin(name, body) {
+  nodeTest(name, body);
+}
+
+/** Structural equality: arrays by position, objects by key set (prototype ignored), else ===. */
+export function same(a, b) {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) {
+      return false;
+    }
+    return a.every((x, i) => same(x, b[i]));
+  }
+  if (a !== null && b !== null && typeof a === "object" && typeof b === "object") {
+    const ka = Object.keys(a).sort();
+    const kb = Object.keys(b).sort();
+    if (ka.length !== kb.length || ka.some((k, i) => k !== kb[i])) {
+      return false;
+    }
+    return ka.every((k) => same(a[k], b[k]));
+  }
+  return a === b;
+}
+
+/** A compact, unambiguous rendering for messages. */
+export function show(x) {
+  return JSON.stringify(x, (k, v) => (v === undefined ? "<undefined>" : v));
+}
diff --git a/test/hegel.test.mjs b/test/hegel.test.mjs
new file mode 100644
index 0000000..8581f65
--- /dev/null
+++ b/test/hegel.test.mjs
@@ -0,0 +1,322 @@
+// Hegel zoo: property tests for smol-toml (see README.md of the target).
+//
+// Run with `node --test --test-reporter=tap test/hegel.test.mjs` after the target's setup
+// (Hegel and TypeScript under .hegel/, src/ compiled to .hegel/dist). HEGEL_TEST_CASES sets the
+// budget, ZOO_COLLECT=1 records mismatches instead of failing at the first.
+//
+// The generators are in hegel-gen.mjs: a document is drawn as a tree of values with the style
+// each is written in and rendered by a pure function; each property draws one document, one
+// case record or one date-time node.
+
+import assert from "node:assert/strict";
+import { count, fail, pin, property, same, show } from "./hegel-zoo.mjs";
+import {
+  acceptedOnlyBySmol, arrayOfTablesHeaderWithOneBracket, canon, elementAfterCommentInArray, expectedAfterStringify, hasBigInt, jsOnlyWhitespace,
+  loosen, normaliseCrlf, parse, pyParse, quoteAfterLineEndingBackslash, quotedKeyWithEquals, stringify, stringifyShapes, TomlDate, TomlError,
+} from "./hegel-toml.mjs";
+import { dateCase, dateTime, document, mutate, mutationCase, render, stringifyCase } from "./hegel-gen.mjs";
+
+// Shapes of the recorded bugs (bugs.toml). A property skips a case that has one, so it stays
+// strict on everything else; each has a pin below that asserts the correct behaviour.
+const Known = {
+  /** smol-toml/1: stringify writes -0.0 as 0.0 under numbersAsFloat. */
+  negZeroFloat: (shapes, numbersAsFloat) => shapes.negZero && numbersAsFloat,
+  /** smol-toml/3: a null value in an inline table makes stringify throw a TypeError. */
+  nullInInlineTable: (shapes) => shapes.nullInInlineTable,
+  /** smol-toml/4: undefined, functions and symbols in inline tables and arrays are written as `undefined`. */
+  undefinedInline: (shapes) => shapes.undefinedInInlineTable || shapes.functionInline,
+  /** smol-toml/5: a lone surrogate is written as a \uD800 escape, which parse rejects. */
+  loneSurrogate: (shapes) => shapes.loneSurrogate,
+  /** smol-toml/6: a quote right after a line-ending backslash is dropped from a multi-line basic string. */
+  quoteAfterLineEndingBackslash: (text) => quoteAfterLineEndingBackslash(text),
+  /** smol-toml/7: JavaScript whitespace (a lone CR, NBSP, form feed, ...) after a number or date is accepted. */
+  jsOnlyWhitespace: (text) => jsOnlyWhitespace(text),
+  /** smol-toml/8: in an array, a comment swallows the following lines up to the next comma or bracket. */
+  elementAfterCommentInArray: (text) => elementAfterCommentInArray(text),
+  /** smol-toml/9: a quoted key containing "=" makes the parser skip to the next "=" in the document. */
+  quotedKeyWithEquals: (text) => quotedKeyWithEquals(text),
+  /** smol-toml/10: an array-of-tables header closed by a single "]" plus at most one other character is accepted. */
+  arrayOfTablesHeaderWithOneBracket: (text) => arrayOfTablesHeaderWithOneBracket(text),
+};
+
+/** tomllib normalises CRLF before parsing (see normaliseCrlf); compare modulo that when the text has any. */
+function sameModuloCrlf(text, a, b) {
+  return same(a, b) || (text.includes("\r\n") && same(normaliseCrlf(a), normaliseCrlf(b)));
+}
+
+function tomlError(e) {
+  return e instanceof TomlError;
+}
+
+function smolParse(text) {
+  try {
+    return { ok: true, value: canon(parse(text, { integersAsBigInt: true })) };
+  } catch (e) {
+    if (!tomlError(e)) fail(`parse threw a ${e.constructor.name} (not a TomlError): ${e.message}\n${show(text)}`);
+    return { ok: false, error: e.message.split("\n")[0] };
+  }
+}
+
+// a document that may use TOML 1.1 syntax, and one in TOML 1.0 (what tomllib reads)
+const anyDocument = document(true);
+const toml10Document = document(false);
+
+// ---------------------------------------------------------------- parse against the model
+
+property("TestHegelParseAgreesWithTheModel", (tc) => {
+  const doc = render(tc.draw(anyDocument));
+  if (doc.v11) count("shape/toml-1.1");
+  if (hasBigInt(doc.value)) count("shape/big-integer");
+  if (Known.quoteAfterLineEndingBackslash(doc.text)) {
+    count("known/smol-toml-6");
+    tc.assume(false);
+  }
+  let strict;
+  try {
+    strict = parse(doc.text, { integersAsBigInt: true });
+  } catch (e) {
+    fail(`parse (integersAsBigInt) threw on a valid document: ${e.message.split("\n")[0]}\n${show(doc.text)}`);
+  }
+  const got = canon(strict);
+  if (!same(got, doc.value)) fail(`parse (integersAsBigInt) differs from the model\n${show(doc.text)}\n got  ${show(got)}\n want ${show(doc.value)}`);
+  const loose = loosen(doc.value);
+  const asNeeded = canon(parse(doc.text, { integersAsBigInt: "asNeeded" }), true);
+  if (!same(asNeeded, loose)) fail(`parse (asNeeded) differs from the model\n${show(doc.text)}\n got  ${show(asNeeded)}\n want ${show(loose)}`);
+  if (hasBigInt(doc.value)) {
+    let threw = false;
+    try {
+      parse(doc.text);
+    } catch (e) {
+      threw = tomlError(e);
+    }
+    if (!threw) fail(`the default mode accepted an integer beyond 2^53\n${show(doc.text)}`);
+  } else {
+    const dflt = canon(parse(doc.text), true);
+    if (!same(dflt, loose)) fail(`parse (default) differs from the model\n${show(doc.text)}\n got  ${show(dflt)}\n want ${show(loose)}`);
+  }
+});
+
+// ---------------------------------------------------------------- parse against tomllib
+
+property("TestHegelParseAgreesWithTomllib", (tc) => {
+  const doc = render(tc.draw(toml10Document));
+  const py = pyParse(doc.text);
+  if (!py.ok) fail(`tomllib rejects the generated document (${py.error})\n${show(doc.text)}`);
+  if (!sameModuloCrlf(doc.text, py.value, doc.value)) fail(`tomllib differs from the model (a generator defect)\n${show(doc.text)}\n py   ${show(py.value)}\n want ${show(doc.value)}`);
+  if (Known.quoteAfterLineEndingBackslash(doc.text)) {
+    count("known/smol-toml-6");
+    tc.assume(false);
+  }
+  const smol = smolParse(doc.text);
+  if (!smol.ok) fail(`smol-toml rejects what tomllib accepts (${smol.error})\n${show(doc.text)}`);
+  if (!sameModuloCrlf(doc.text, smol.value, py.value)) fail(`smol-toml and tomllib disagree\n${show(doc.text)}\n smol ${show(smol.value)}\n py   ${show(py.value)}`);
+});
+
+// ---------------------------------------------------------------- rejection differential
+
+property("TestHegelMutationsAreJudgedAlike", (tc) => {
+  const { doc, edits } = tc.draw(mutationCase);
+  const text = mutate(doc.text, edits);
+  const smol = smolParse(text);
+  const py = pyParse(text);
+  // a disagreement explained by a recorded bug or an oracle limit is the verdict, not a skip
+  if (smol.ok && py.ok) {
+    count("both-accept");
+    if (!sameModuloCrlf(text, smol.value, py.value)) {
+      if (Known.quoteAfterLineEndingBackslash(text)) {
+        count("known/smol-toml-6");
+        return;
+      }
+      fail(`both accept, values differ\n${show(text)}\n smol ${show(smol.value)}\n py   ${show(py.value)}`);
+    }
+  } else if (smol.ok) {
+    const why = acceptedOnlyBySmol(text) || (doc.v11 && "limit/toml-1.1-document");
+    if (why) {
+      count(why);
+      return;
+    }
+    if (Known.jsOnlyWhitespace(text)) {
+      count("known/smol-toml-7");
+      return;
+    }
+    if (Known.elementAfterCommentInArray(text)) {
+      count("known/smol-toml-8");
+      return;
+    }
+    if (Known.quotedKeyWithEquals(text)) {
+      count("known/smol-toml-9");
+      return;
+    }
+    if (Known.arrayOfTablesHeaderWithOneBracket(text)) {
+      count("known/smol-toml-10");
+      return;
+    }
+    fail(`smol-toml accepts what tomllib rejects (${py.error})\n${show(text)}\n smol ${show(smol.value)}`);
+  } else if (py.ok) {
+    fail(`smol-toml rejects what tomllib accepts (${smol.error})\n${show(text)}\n py ${show(py.value)}`);
+  } else {
+    count("both-reject");
+  }
+});
+
+// ---------------------------------------------------------------- stringify
+
+property("TestHegelStringifyRoundTrips", (tc) => {
+  const { obj, numbersAsFloat } = tc.draw(stringifyCase);
+  const shapes = stringifyShapes(obj);
+  if (Known.nullInInlineTable(shapes)) {
+    count("known/smol-toml-3");
+    tc.assume(false);
+  }
+  if (Known.undefinedInline(shapes)) {
+    count("known/smol-toml-4");
+    tc.assume(false);
+  }
+  if (shapes.nullInArray || shapes.functionInTable) {
+    // documented rejections: null/undefined in an array, functions and symbols
+    const why = shapes.nullInArray ? "array-null" : "function";
+    count("shape/" + why);
+    let threw = null;
+    try {
+      stringify(obj, { numbersAsFloat });
+    } catch (e) {
+      threw = e;
+    }
+    if (!(threw instanceof TypeError)) fail(`stringify did not reject ${why}: ${threw ? threw.message : "no error"}\n${show(obj)}`);
+    return;
+  }
+  if (Known.negZeroFloat(shapes, numbersAsFloat)) {
+    count("known/smol-toml-1");
+    tc.assume(false);
+  }
+  if (Known.loneSurrogate(shapes)) {
+    count("known/smol-toml-5");
+    tc.assume(false);
+  }
+  let text;
+  try {
+    text = stringify(obj, { numbersAsFloat });
+  } catch (e) {
+    fail(`stringify threw ${e.constructor.name}: ${e.message}\n${show(obj)}`);
+  }
+  const want = expectedAfterStringify(obj, numbersAsFloat);
+  let back;
+  try {
+    back = canon(parse(text, { integersAsBigInt: true }));
+  } catch (e) {
+    fail(`parse rejects stringify's output (${e.message.split("\n")[0]})\n${show(text)}`);
+  }
+  if (!same(back, want)) fail(`parse(stringify(x)) differs from x\n${show(text)}\n got  ${show(back)}\n want ${show(want)}`);
+  const py = pyParse(text);
+  if (!py.ok) fail(`tomllib rejects stringify's output (${py.error})\n${show(text)}`);
+  if (!same(py.value, want)) fail(`tomllib reads stringify's output differently\n${show(text)}\n py   ${show(py.value)}\n want ${show(want)}`);
+});
+
+// ---------------------------------------------------------------- TomlDate
+
+property("TestHegelTomlDateReadsWhatItWrites", (tc) => {
+  const d = dateTime(tc.draw(dateCase));
+  const td = new TomlDate(d.text);
+  if (!td.isValid()) fail(`TomlDate rejects ${d.text}`);
+  const flags = [td.isDateTime(), td.isDate(), td.isTime(), td.isLocal()];
+  const wantFlags = { dt: [true, false, false, false], ldt: [true, false, false, true], ld: [false, true, false, true], lt: [false, false, true, true] }[d.kind];
+  if (!same(flags, wantFlags)) fail(`TomlDate(${d.text}) flags ${show(flags)}, want ${show(wantFlags)}`);
+  if (!same(canon(td), d.canon)) fail(`TomlDate(${d.text}) is ${show(canon(td))}, want ${show(d.canon)}`);
+  const p = d.parts;
+  const pad = (x, w) => String(x).padStart(w, "0");
+  const date = `${pad(p.y, 4)}-${pad(p.mo, 2)}-${pad(p.d, 2)}`;
+  const time = `${pad(p.h, 2)}:${pad(p.mi, 2)}:${pad(p.s, 2)}.${pad(p.ms, 3)}`;
+  const wantIso = { dt: `${date}T${time}${(d.offset || "").toUpperCase()}`, ldt: `${date}T${time}`, ld: date, lt: time }[d.kind];
+  const iso = td.toISOString();
+  if (iso !== wantIso) {
+    if (d.offset === "z") {
+      count("known/smol-toml-2");
+    } else {
+      fail(`TomlDate(${d.text}).toISOString() is ${iso}, want ${wantIso}`);
+    }
+  }
+  const again = new TomlDate(iso);
+  if (!same(canon(again), d.canon)) fail(`TomlDate(${iso}) (its own output for ${d.text}) is ${show(canon(again))}`);
+  const back = parse(stringify({ a: td })).a;
+  if (!same(canon(back), d.canon)) fail(`parse(stringify({a: TomlDate(${d.text})})) is ${show(canon(back))}`);
+});
+
+// ---------------------------------------------------------------- pins
+
+/** smol-toml/1 */
+pin("TestHegelPinNegativeZeroFloatKeepsItsSign", () => {
+  assert.equal(stringify({ a: -0.0 }, { numbersAsFloat: true }), "a = -0.0\n");
+});
+
+/** smol-toml/2 */
+pin("TestHegelPinLowercaseZoneDesignatorIsNormalised", () => {
+  assert.equal(new TomlDate("1979-05-27T07:32:00z").toISOString(), "1979-05-27T07:32:00.000Z");
+});
+
+/** smol-toml/3 */
+pin("TestHegelPinNullInAnInlineTableIsIgnored", () => {
+  // "undefined and null values on objects are ignored (does not produce a key/value)"
+  assert.equal(stringify({ a: [{ b: null, c: 1 }, 2] }), "a = [ { c = 1 }, 2 ]\n");
+});
+
+/** smol-toml/4 */
+pin("TestHegelPinUndefinedInAnInlineTableIsIgnored", () => {
+  assert.equal(stringify({ a: [{ b: undefined, c: 1 }, 2] }), "a = [ { c = 1 }, 2 ]\n");
+});
+
+/** smol-toml/4 */
+pin("TestHegelPinFunctionInAnArrayIsRejected", () => {
+  // "Functions, classes and symbols are rejected"
+  assert.throws(() => stringify({ a: [() => 1] }), TypeError);
+  assert.throws(() => stringify({ a: [{ b: Symbol("s") }, 1] }), TypeError);
+});
+
+/** smol-toml/6 */
+pin("TestHegelPinQuoteAfterLineEndingBackslashIsKept", () => {
+  // the string ends with four quotes, so the first is content; the line-ending backslash before
+  // it trims only whitespace and newlines
+  assert.equal(parse('a = """x\\\n""""').a, 'x"');
+  assert.equal(parse('a = """\\\n  """""').a, '""');
+});
+
+/** smol-toml/7 */
+pin("TestHegelPinOnlySpaceAndTabAreWhitespace", () => {
+  // TOML whitespace is space and tab; a newline is LF or CRLF
+  assert.throws(() => parse("a = 1\r"), TomlError);
+  assert.throws(() => parse("a = 1\xa0\n"), TomlError);
+  assert.throws(() => parse("a = 1979-05-27\f\n"), TomlError);
+});
+
+/** smol-toml/8 */
+pin("TestHegelPinArrayElementsNeedCommasAfterAComment", () => {
+  assert.throws(() => parse("a = [ 1 # c\n 2 ]\n"), TomlError);
+  assert.throws(() => parse("a = [ 1 # c\n 2, 3 ]\n"), TomlError);
+});
+
+/** smol-toml/9 */
+pin("TestHegelPinQuotedKeyWithEqualsIsFollowedByEquals", () => {
+  assert.deepEqual(parse('"a=" = 1\n'), { "a=": 1 });
+  assert.throws(() => parse('"a=" junk\nb = 1\n'), TomlError);
+});
+
+/** smol-toml/10 */
+pin("TestHegelPinArrayOfTablesHeaderNeedsBothClosingBrackets", () => {
+  // TOML: an array-of-tables header is "[[" key "]]"
+  assert.throws(() => parse("[[a]\n"), TomlError);
+  assert.throws(() => parse("[[a]\r\n[[a]]\r\n"), TomlError);
+  assert.throws(() => parse("[[a][\n"), TomlError);
+});
+
+/** smol-toml/5 */
+pin("TestHegelPinLoneSurrogateIsNotWrittenAsAnEscape", () => {
+  // a lone surrogate is not a Unicode scalar value, so TOML cannot carry it: stringify must either
+  // reject it or write something its own parser reads back
+  let text;
+  try {
+    text = stringify({ a: "\u{d800}" });
+  } catch (e) {
+    assert.ok(e instanceof TypeError, `${e}`);
+    return;
+  }
+  assert.doesNotThrow(() => parse(text));
+});
