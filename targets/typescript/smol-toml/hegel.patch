+    return s;
+  }
+  if (r < 45) {
+    const v = chance(tc, 60) ? n(tc, -1000, 1000) : pick(tc, [0, -0, 2 ** 53 - 1, -(2 ** 53 - 1), 2 ** 53, -(2 ** 53), 1e21, -1e21, 1e300, 123456789012345680000]);
+    if (Object.is(v, -0)) model.negZero = true;
+    return v;
+  }
+  if (r < 60) return chance(tc, 80) ? n(tc, -100000, 100000) / pick(tc, [4, 8, 10, 1000, 7]) : pick(tc, [0.1, -0.5, 1.5e-7, 5e-324, 1.7976931348623157e308, NaN, Infinity, -Infinity, Math.PI]);
