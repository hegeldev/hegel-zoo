index 0000000..9060d19
--- /dev/null
+++ b/test/hegel-toml-oracle.py
@@ -0,0 +1,86 @@
+"""Hegel zoo: Python's tomllib (TOML 1.0.0, CPython >= 3.11) as the oracle for smol-toml, held
+open by the tests.
+
+Reads one JSON request per line from the FIFO given as argv[1] and writes one JSON response per
+line to the FIFO given as argv[2]. Requests are {"op": "parse", "text": ...}; the response is
+{"ok": true, "value": <canonical>} or {"ok": false, "error": "<message>"}. Values cross the
+boundary in a canonical form both sides can produce:
+
+  "string" / true / false        as themselves
+  {"$i": "123"}                  an integer, in decimal
+  {"$f": "<16 hex digits>"}      a float, by its IEEE 754 bits ("nan" for any NaN)
+  {"$dt": "YYYY-MM-DDTHH:MM:SS.mmmZ"}   an offset date-time, as the UTC instant to the millisecond
+  {"$ldt": "YYYY-MM-DDTHH:MM:SS.mmm"}   a local date-time, to the millisecond
+  {"$ld": "YYYY-MM-DD"}          a local date
+  {"$lt": "HH:MM:SS.mmm"}        a local time, to the millisecond
+  [..]                           an array
+  {"$m": {key: value, ..}}       a table (key order is irrelevant; the JavaScript side compares
+                                 tables as sets of pairs)
+
+Milliseconds: JavaScript's Date carries no finer precision, and TOML lets an implementation
+truncate extra precision, so both sides truncate (never round) to the millisecond.
+"""
+import datetime
+import json
+import math
+import struct
+import sys
+import tomllib
+
+
+def float_bits(x):
+    if math.isnan(x):
+        return "nan"
+    return struct.pack(">d", x).hex()
+
+
+def canon(v):
+    if isinstance(v, bool) or isinstance(v, str):
+        return v
+    if isinstance(v, int):
+        return {"$i": str(v)}
+    if isinstance(v, float):
+        return {"$f": float_bits(v)}
+    if isinstance(v, datetime.datetime):
+        v = v.replace(microsecond=(v.microsecond // 1000) * 1000)
+        if v.tzinfo is not None:
+            v = v.astimezone(datetime.timezone.utc).replace(tzinfo=None)
+            return {"$dt": v.isoformat(timespec="milliseconds") + "Z"}
+        return {"$ldt": v.isoformat(timespec="milliseconds")}
+    if isinstance(v, datetime.date):
+        return {"$ld": v.isoformat()}
+    if isinstance(v, datetime.time):
+        v = v.replace(microsecond=(v.microsecond // 1000) * 1000)
+        return {"$lt": v.isoformat(timespec="milliseconds")}
+    if isinstance(v, list):
+        return [canon(x) for x in v]
+    if isinstance(v, dict):
+        return {"$m": {k: canon(x) for k, x in v.items()}}
+    raise TypeError(f"unexpected value {v!r}")
+
+
+def handle(req):
+    if req["op"] == "parse":
+        try:
+            return {"ok": True, "value": canon(tomllib.loads(req["text"]))}
+        except (tomllib.TOMLDecodeError, ValueError, OverflowError, RecursionError) as e:
+            return {"ok": False, "error": f"{type(e).__name__}: {e}"}
+    if req["op"] == "ping":
+        return {"ok": True, "version": sys.version}
+    return {"ok": False, "error": f"unknown op {req['op']!r}"}
+
+
+def main():
+    sys.setrecursionlimit(20000)
+    with open(sys.argv[1], "r", encoding="utf-8") as req, open(sys.argv[2], "w", encoding="utf-8") as resp:
+        for line in req:
+            try:
+                answer = handle(json.loads(line))
+            except Exception as e:  # a harness defect, not the library's
+                answer = {"ok": False, "error": f"oracle failure {type(e).__name__}: {e}"}
+            resp.write(json.dumps(answer, ensure_ascii=True) + "\n")
+            resp.flush()
+
+
+if __name__ == "__main__":
+    main()
diff --git a/test/hegel-toml.mjs b/test/hegel-toml.mjs
