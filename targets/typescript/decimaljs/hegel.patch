index 0000000..3ded6c5
--- /dev/null
+++ b/test/hegel-decimal-oracle.py
@@ -0,0 +1,479 @@
+#!/usr/bin/env python3
+"""Hegel zoo: Python's decimal module (and fractions) as the oracle for decimal.js, held open by
+the tests over two FIFOs: one JSON request per line on argv[1], one JSON answer per line on argv[2].
+
+Every request carries "fn", "args" (decimal strings as decimal.js would print them, or "NaN",
+"Infinity", "-Infinity"), "prec" (significant digits) and "rm" (decimal.js rounding mode 0-8).
+Answers are {"ok": true, "r": <string or list>} or {"ok": true, "r": null, "undecidable": true}
+(a transcendental result too close to a rounding boundary to decide at the oracle's extra
+precision) or {"ok": false, "error": "..."}.
+
+Rounding modes 7 (ROUND_HALF_CEIL) and 8 (ROUND_HALF_FLOOR) do not exist in Python: the result
+is computed with ROUND_HALF_UP and ROUND_HALF_DOWN and, when they differ (a tie), the one towards
++Infinity (7) or -Infinity (8) is taken.
+"""
+import decimal
+import json
+import math
+import sys
+from decimal import (ROUND_CEILING, ROUND_DOWN, ROUND_FLOOR, ROUND_HALF_DOWN, ROUND_HALF_EVEN,
+                     ROUND_HALF_UP, ROUND_UP, Context, Decimal, Inexact, localcontext)
+from fractions import Fraction
+
+RM = {0: ROUND_UP, 1: ROUND_DOWN, 2: ROUND_CEILING, 3: ROUND_FLOOR, 4: ROUND_HALF_UP,
+      5: ROUND_HALF_DOWN, 6: ROUND_HALF_EVEN}
+EMAX = 9 * 10 ** 15
+BIG = Context(prec=100000, rounding=ROUND_HALF_EVEN, Emin=-EMAX, Emax=EMAX, traps=[])
+decimal.setcontext(BIG)  # scaleb() and the operators round in the current context
+EXTRA = 30  # guard digits for the transcendental functions
+
+
+def ctx(prec, rm):
+    return Context(prec=prec, rounding=RM[rm], Emin=-EMAX, Emax=EMAX, traps=[])
+
+
+def dec(s):
+    return Decimal(s)
+
+
+def is_special(d):
+    return not d.is_finite()
+
+
+def round_to(value, prec, rm):
+    """value (Decimal or Fraction, exact) rounded to prec significant digits with mode rm."""
+    if isinstance(value, Fraction):
+        # exact enough: convert with far more digits than needed, then round once; a Fraction
+        # whose decimal expansion does not terminate gets a sticky digit appended
+        if value == 0:
+            return Decimal(0)
+        c = Context(prec=prec + 5, rounding=ROUND_DOWN, Emin=-EMAX, Emax=EMAX, traps=[])
+        approx = c.divide(Decimal(value.numerator), Decimal(value.denominator))
+        exact = Fraction(approx) == value
+        if not exact:
+            # append a non-zero sticky digit below the guard digits (truncated, so the true
+            # value lies strictly above approx and strictly below approx + 1 unit)
+            sign, digits, exp = approx.as_tuple()
+            approx = Decimal((sign, digits + (5,), exp - 1))
+        value = approx
+    return ctx(prec, rm).plus(value)
+
+
+def with_half_modes(f, rm):
+    """f(mode) for the composite modes 7/8: the two half results, then the one in the direction."""
+    if rm <= 6:
+        return f(rm)
+    up = f(4)
+    down = f(5)
+    if isinstance(up, Decimal) and isinstance(down, Decimal):
+        if up.is_nan() or down.is_nan() or up == down:
+            return up
+        return max(up, down) if rm == 7 else min(up, down)
+    return up if up == down else (max(up, down) if rm == 7 else min(up, down))
+
+
+def round_int(q, rm):
+    """The integer nearest to the exact Fraction q in the direction of decimal.js mode rm (0-9)."""
+    fl = q.numerator // q.denominator
+    frac = q - fl
+    if frac == 0:
+        return fl
+    neg = q < 0
+    if rm == 0:
+        return fl if neg else fl + 1          # away from zero
+    if rm == 1:
+        return fl + 1 if neg else fl          # towards zero
+    if rm == 2:
+        return fl + 1                         # ceil
+    if rm == 3:
+        return fl                             # floor
+    half = Fraction(1, 2)
+    if frac > half:
+        return fl + 1
+    if frac < half:
+        return fl
+    if rm == 4:
+        return fl if neg else fl + 1          # half away from zero
+    if rm == 5:
+        return fl + 1 if neg else fl          # half towards zero
+    if rm == 6:
+        return fl if fl % 2 == 0 else fl + 1  # half even
+    if rm == 7:
+        return fl + 1                         # half ceil
+    if rm == 8:
+        return fl                             # half floor
+    raise ValueError("mode %r" % rm)
+
+
+def boundary_free(d, prec, guard):
+    """Is the (prec + guard)-digit correctly rounded d safely away from every rounding boundary
+    at prec digits (so rounding it again to prec digits gives the correctly rounded result)?"""
+    if not d.is_finite() or d == 0:
+        return True
+    digits = "".join(str(x) for x in d.as_tuple().digits)
+    digits = digits.ljust(prec + guard, "0")
+    tail = digits[prec:prec + guard]
+    for pattern in ("0" * guard, "9" * guard, "5" + "0" * (guard - 1), "4" + "9" * (guard - 1)):
+        if tail[:len(pattern) - 6] == pattern[:len(pattern) - 6]:
+            return False
+    return True
+
+
+def transcendental(compute, prec, rm):
+    """compute(context) at prec + EXTRA digits (correctly rounded there), then round to prec.
+
+    Rounding twice is only wrong when the high-precision value sits within one of its units of
+    a rounding boundary at prec digits. Then the computation is repeated with three times the
+    guard digits; exact results (log2(256) = 8, pow(2, -1) = 0.5) are recognised there by the
+    context's Inexact flag staying clear, and a value still hugging a boundary while inexact is
+    reported as undecidable (None)."""
+    hi = Context(prec=prec + EXTRA, rounding=ROUND_HALF_EVEN, Emin=-EMAX, Emax=EMAX, traps=[])
+    d = compute(hi)
+    if not d.is_finite() or d.is_zero():  # plus() would turn -0 into 0
+        return d
+    if not boundary_free(d, prec, EXTRA):
+        hi = Context(prec=prec + 3 * EXTRA, rounding=ROUND_HALF_EVEN, Emin=-EMAX, Emax=EMAX, traps=[])
+        d = compute(hi)
+        if hi.flags[Inexact] and not boundary_free(d, prec, 3 * EXTRA):
+            return None
+    return with_half_modes(lambda m: ctx(prec, m).plus(d), rm)
+
+
+def exact_sqrt(fx, prec):
+    """sqrt of the positive Fraction fx (a decimal, so with a power-of-ten denominator) as a
+    Decimal of at least prec + 5 digits, with a sticky digit appended when the root is inexact,
+    so that one rounding to prec digits in any mode is the correctly rounded square root."""
+    k = 0
+    while True:
+        n = fx * Fraction(10) ** (2 * k)
+        if n.denominator == 1 and len(str(n.numerator)) >= 2 * (prec + 5):
+            break
+        k += 1
+        if k > 6000:
+            raise ValueError("sqrt: cannot scale")
+    N = n.numerator
+    r = math.isqrt(N)
+    d = Decimal(r)
+    if r * r != N:
+        d = Decimal(r * 10 + 5).scaleb(-1)
+    return d.scaleb(-k)
+
+
+def calc(req):
+    fn = req["fn"]
+    args = [dec(a) for a in req.get("args", [])]
+    prec = int(req.get("prec", 20))
+    rm = int(req.get("rm", 4))
+
+    if fn == "ping":
+        return {"ok": True, "python": sys.version.split()[0]}
+
+    if fn == "sqrt":  # exact integer square root (Python's sqrt always rounds half-even)
+        x = args[0]
+        if x.is_nan() or x < 0:
+            return {"ok": True, "r": "NaN"}
+        if is_special(x) or x.is_zero():
+            return {"ok": True, "r": str(x)}
+        d = exact_sqrt(Fraction(x), prec)
+        return {"ok": True, "r": str(with_half_modes(lambda m: ctx(prec, m).plus(d), rm))}
+
+    if fn in ("add", "sub", "mul", "div", "cmp", "abs", "neg"):
+        def f(m):
+            c = ctx(prec, m)
+            x = args[0]
+            if fn == "add":
+                return c.add(x, args[1])
+            if fn == "sub":
+                return c.subtract(x, args[1])
+            if fn == "mul":
+                return c.multiply(x, args[1])
+            if fn == "div":
+                return c.divide(x, args[1])
+            if fn == "sqrt":
+                return c.sqrt(x)
+            if fn == "abs":
+                return x.copy_abs()  # exact, and -0 -> 0 as in JavaScript
+            if fn == "neg":
+                return x.copy_negate()  # exact, and 0 -> -0 as in JavaScript
+            if fn == "cmp":
+                return x.compare(args[1])
+        r = with_half_modes(f, rm)
+        return {"ok": True, "r": str(r)}
+
+    if fn == "sum":
+        total = Fraction(0)
+        for a in args:
+            if is_special(a):
+                return {"ok": True, "r": str(with_half_modes(lambda m: sum(args[1:], start=ctx(prec, m).plus(args[0])) if False else _sum_special(args, ctx(prec, m)), rm))}
+            total += Fraction(a)
+        if total == 0:
+            # the sign of a zero sum as IEEE 754 / the decimal specification give it for a
+            # sequence of additions: all -0 -> -0, all +0 -> +0, otherwise -0 only under FLOOR
+            if all(a.is_zero() and a.is_signed() for a in args):
+                return {"ok": True, "r": "-0"}
+            if all(a.is_zero() and not a.is_signed() for a in args):
+                return {"ok": True, "r": "0"}
+            return {"ok": True, "r": "-0" if rm == 3 else "0"}
+        return {"ok": True, "r": str(with_half_modes(lambda m: round_to(total, prec, m), rm))}
+
+    if fn == "hypot":
+        total = Fraction(0)
+        for a in args:
+            if a.is_nan():
+                return {"ok": True, "r": "NaN"}
+            if a.is_infinite():
+                return {"ok": True, "r": "Infinity"}
+            total += Fraction(a) * Fraction(a)
+        if total == 0:
+            return {"ok": True, "r": "0"}
+        d = exact_sqrt(total, prec)  # the exact sum of squares, rooted once
+        return {"ok": True, "r": str(with_half_modes(lambda m: ctx(prec, m).plus(d), rm))}
+
+    if fn in ("mod", "divToInt"):
+        x, y = args
+        mode = int(req.get("modulo", 1))
+        if x.is_nan() or y.is_nan():
+            return {"ok": True, "r": "NaN"}
+        opposite = x.is_signed() != y.is_signed()
+        if fn == "divToInt":
+            # the specials of IEEE division (Infinity / 0.1 = Infinity, 5 / -0 = -Infinity)
+            if x.is_infinite():
+                return {"ok": True, "r": "NaN" if y.is_infinite() else ("-Infinity" if opposite else "Infinity")}
+            if y == 0:
+                return {"ok": True, "r": "NaN" if x == 0 else ("-Infinity" if opposite else "Infinity")}
+        elif x.is_infinite() or y == 0:
+            return {"ok": True, "r": "NaN"}
+        if y.is_infinite():
+            if fn == "divToInt":
+                return {"ok": True, "r": "-0" if opposite else "0"}
+            # x mod Infinity = x, rounded to precision like every mod result
+            if x.is_zero():
+                return {"ok": True, "r": str(x)}
+            return {"ok": True, "r": str(with_half_modes(lambda m: ctx(prec, m).plus(x), rm))}
+        q = Fraction(x) / Fraction(y)
+        if fn == "divToInt":
+            qi = round_int(q, 1)
+            r = Fraction(qi)
+            if qi == 0 and ((x < 0 or x.is_signed()) != (y < 0)):
+                return {"ok": True, "r": str(with_half_modes(lambda m: round_to(r, prec, m), rm)).replace("0", "-0", 1)}
+            return {"ok": True, "r": str(with_half_modes(lambda m: round_to(r, prec, m), rm))}
+        if mode == 9:
+            qi = (1 if y > 0 else -1) * (Fraction(x) / abs(Fraction(y))).__floor__()
+        else:
+            qi = round_int(q, mode)
+        r = Fraction(x) - Fraction(y) * qi
+        if r == 0:
+            # the sign of a zero remainder follows the dividend (as JavaScript's %)
+            return {"ok": True, "r": "-0" if x.is_signed() else "0"}
+        return {"ok": True, "r": str(with_half_modes(lambda m: round_to(r, prec, m), rm))}
+
+    if fn in ("exp", "ln", "log10", "log2", "log", "pow"):
+        x = args[0]
+        if fn == "exp":
+            comp = lambda c: c.exp(x)
+        elif fn == "ln":
+            comp = lambda c: c.ln(x)
+        elif fn == "log10":
+            comp = lambda c: c.log10(x)
+        elif fn == "log2":
+            comp = lambda c: c.divide(c.ln(x), c.ln(Decimal(2)))
+        elif fn == "log":
+            base = args[1]
+            if base.is_nan() or base.is_infinite() or base <= 0 or base == 1:
+                return {"ok": True, "r": "NaN"}  # decimal.js: no logarithm to such a base
+            comp = lambda c: c.divide(c.ln(x), c.ln(base))
+        else:
+            y = args[1]
+            if y.is_zero():
+                return {"ok": True, "r": "1"}  # x ** 0 = 1 for every x, as in JavaScript
+            comp = lambda c: c.power(x, y)
+        try:
+            r = transcendental(comp, prec, rm)
+        except Exception as e:  # noqa: BLE001
+            return {"ok": False, "error": "%s: %s" % (type(e).__name__, e)}
+        return {"ok": True, "r": None if r is None else str(r), "undecidable": r is None}
+
+    if fn == "cbrt":
+        x = args[0]
+        if is_special(x) or x == 0:
+            return {"ok": True, "r": str(x)}
+        # exact integer cube root with a sticky digit, then one rounding
+        neg = x < 0
+        fx = abs(Fraction(x))
+        # scale to an integer N = fx * 10^(3k) with at least 3*(prec+5) digits
+        k = 0
+        while True:
+            n = fx * Fraction(10) ** (3 * k)
+            if n.denominator == 1 and len(str(n.numerator)) >= 3 * (prec + 5):
+                break
+            k += 1
+            if k > 4000:
+                return {"ok": False, "error": "cbrt: cannot scale"}
+        N = n.numerator
+        r = icbrt(N)
+        d = Decimal(r)
+        if r ** 3 != N:
+            d = Decimal(r * 10 + 5).scaleb(-1)
+        d = d.scaleb(-k)
+        if neg:
+            d = -d
+        return {"ok": True, "r": str(with_half_modes(lambda m: ctx(prec, m).plus(d), rm))}
+
+    if fn == "toDP":  # args: x, dp -> rounded to dp decimal places (no precision limit)
+        x = args[0]
+        dp = int(req["dp"])
+        if is_special(x):
+            return {"ok": True, "r": str(x)}
+        def f(m):
+            with localcontext(BIG) as c:
+                c.rounding = RM[m]
+                return x.quantize(Decimal(1).scaleb(-dp))
+        r = with_half_modes(f, rm)
+        return {"ok": True, "r": str(r), "fixed": format(r, "f")}
+
+    if fn == "toSD":  # args: x, sd -> rounded to sd significant digits
+        x = args[0]
+        sd = int(req["sd"])
+        if is_special(x) or x.is_zero():  # plus() would turn -0 into 0
+            return {"ok": True, "r": str(x)}
+        r = with_half_modes(lambda m: ctx(sd, m).plus(x), rm)
+        return {"ok": True, "r": str(r)}
+
+    if fn == "integral":  # args: x; rm 0-8 -> whole number
+        x = args[0]
+        if is_special(x):
+            return {"ok": True, "r": str(x)}
+        def f(m):
+            with localcontext(BIG) as c:
+                return x.to_integral_value(rounding=RM[m])
+        return {"ok": True, "r": str(with_half_modes(f, rm))}
+
+    if fn == "toNearest":  # args: x, n; rm -> nearest multiple of n
+        x, nn = args
+        if x.is_nan() or nn.is_nan():
+            return {"ok": True, "r": "NaN"}
+        if x.is_infinite():
+            return {"ok": True, "r": str(x)}
+        if nn == 0:
+            return {"ok": True, "r": "-0" if x.is_signed() else "0"}
+        if nn.is_infinite():
+            # decimal.js returns Infinity with the sign of this (the code's choice; undocumented)
+            return {"ok": True, "r": "-Infinity" if x.is_signed() else "Infinity"}
+        q = Fraction(x) / Fraction(abs(nn))
+        qi = round_int(q, rm)
+        r = Fraction(qi) * Fraction(abs(nn))
+        if r == 0:
+            return {"ok": True, "r": "-0" if x.is_signed() else "0"}
+        return {"ok": True, "r": str(round_to(r, 100000, 6))}
+
+    if fn == "fraction":  # args: x [, maxd] -> [num, den] exact or limited
+        x = args[0]
+        fr = Fraction(x)
+        if len(args) > 1:
+            fr = fr.limit_denominator(int(args[1]))
+        return {"ok": True, "r": [str(fr.numerator), str(fr.denominator)]}
+
+    if fn == "closeness":  # args: x, num, den -> |x - num/den| as an exact decimal string
+        x, num, den = args
+        diff = abs(Fraction(x) - Fraction(int(num), int(den)))
+        return {"ok": True, "r": [str(diff.numerator), str(diff.denominator)]}
+
+    if fn == "parse":  # args: string in decimal.js syntax -> exact value (BigInt/hex/bin/oct)
+        s = req["s"].replace("_", "")
+        neg = s.startswith("-")
+        if neg or s.startswith("+"):
+            s = s[1:]
+        base = 10
+        p = s[:2].lower()
+        if p in ("0x", "0b", "0o"):
+            base = {"0x": 16, "0b": 2, "0o": 8}[p]
+            s = s[2:]
+        expo = 0
+        if base == 10:
+            for sep in ("e", "E"):
+                if sep in s:
+                    s, e = s.split(sep)
+                    expo = int(e)
+        else:
+            for sep in ("p", "P"):
+                if sep in s:
+                    s, e = s.split(sep)
+                    expo = int(e)
+        if "." in s:
+            ip, fp = s.split(".")
+        else:
+            ip, fp = s, ""
+        digits = (ip + fp) or "0"
+        value = Fraction(int(digits, base), base ** len(fp))
+        if base == 10:
+            value *= Fraction(10) ** expo
+        else:
+            value *= Fraction(2) ** expo
+        if neg:
+            value = -value
+        if value == 0:
+            return {"ok": True, "r": "-0" if neg else "0"}
+        return {"ok": True, "r": str(round_to(value, 100000, 6))}
+
+    if fn == "toBase":  # args: x; base, sd, rm -> exact value of x rounded to sd base-b digits
+        x = args[0]
+        b = int(req["base"])
+        sd = int(req["sd"])
+        if is_special(x) or x == 0:
+            return {"ok": True, "r": str(x)}
+        neg = x < 0
+        fx = abs(Fraction(x))
+        # find the exponent: b^e <= fx < b^(e+1)
+        e = 0
+        while fx >= b ** (e + 1):
+            e += 1
+        while fx < Fraction(b) ** e:
+            e -= 1
+        scaled = fx / Fraction(b) ** (e - sd + 1)  # sd digits before the point
+        m = round_int(-scaled if neg else scaled, rm)
+        value = Fraction(m) * Fraction(b) ** (e - sd + 1)
+        if value == 0:
+            return {"ok": True, "r": "-0" if neg else "0"}
+        return {"ok": True, "r": str(round_to(value, 100000, 6))}
+
+    return {"ok": False, "error": "unknown fn " + fn}
+
+
+def _sum_special(args, c):
+    total = c.plus(args[0])
+    for a in args[1:]:
+        total = c.add(total, a)
+    return total
+
+
+def icbrt(n):
+    """floor(cbrt(n)) for a non-negative int."""
+    if n < 2:
+        return n
+    x = 1 << ((n.bit_length() + 2) // 3)
+    while True:
+        y = (2 * x + n // (x * x)) // 3
+        if y >= x:
+            break
+        x = y
+    while x * x * x > n:
+        x -= 1
+    while (x + 1) ** 3 <= n:
+        x += 1
+    return x
+
+
+def main():
+    req_path, resp_path = sys.argv[1], sys.argv[2]
+    with open(req_path, "r", encoding="utf-8") as req, open(resp_path, "w", encoding="utf-8") as resp:
+        for line in req:
+            try:
+                ans = calc(json.loads(line))
+            except Exception as e:  # noqa: BLE001 - every failure is an answer
+                ans = {"ok": False, "error": "%s: %s" % (type(e).__name__, e)}
+            resp.write(json.dumps(ans, ensure_ascii=True) + "\n")
+            resp.flush()
+
+
+if __name__ == "__main__":
+    main()
diff --git a/test/hegel-zoo.mjs b/test/hegel-zoo.mjs
new file mode 100644
index 0000000..ef914e1
--- /dev/null
+++ b/test/hegel-zoo.mjs
@@ -0,0 +1,138 @@
+// Hegel zoo: the small harness shared by the zoo's TypeScript/JavaScript targets.
+//
+// `property(name, body)` registers a node:test test that runs `body(tc)` under Hegel with
+// HEGEL_TEST_CASES cases (default 100) and the database at HEGEL_DATABASE. With ZOO_COLLECT=1
+// a `fail()` records the mismatch instead of failing, the case ends there, and the counts of
+// mismatches and of the shapes seen (`count(key)`) are printed at the end of the test, so a
+// property can be run over many cases to see every shape at once. `pin(name, body)` is a
+// plain test for one pinned bug: it must fail while the bug is present and pass once it is
+// fixed (the zoo's judge reads an unexpected pass as "fixed upstream?").
+
+import { readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { test as nodeTest } from "node:test";
+import * as hegel from "@hegeldev/hegel";
+import * as gs from "@hegeldev/hegel/generators";
+
+// The Hegel version these tests were written against (the zoo pins it in zoo.toml and installs
+// it with `npm install --no-save @hegeldev/hegel@<version>`; upstream would add it to
+// devDependencies). Checked at load time so a stray install cannot silently change the engine.
+export const HEGEL_PIN = { "@hegeldev/hegel": "0.4.5" };
+
+{
+  let dir = dirname(fileURLToPath(import.meta.resolve("@hegeldev/hegel")));
+  while (!/[\\/]hegel$/.test(dir) && dir !== dirname(dir)) dir = dirname(dir);
+  const installed = JSON.parse(readFileSync(join(dir, "package.json"), "utf8")).version;
+  if (installed !== HEGEL_PIN["@hegeldev/hegel"]) {
+    throw new Error(`@hegeldev/hegel ${installed} is installed; these tests pin ${HEGEL_PIN["@hegeldev/hegel"]}`);
+  }
+}
+
+export const collecting = !!process.env.ZOO_COLLECT;
+
+class Collected extends Error {}
+
+let msgs = [];
+let stats = new Map();
+
+/** Report a mismatch: an error normally, a recorded line in collect mode. */
+export function fail(message) {
+  if (collecting) {
+    msgs.push(message);
+    throw new Collected(message);
+  }
+  throw new Error(message);
+}
+
+/** Bump a statistic (the shape of a pinned bug, a generator branch). */
+export function count(key) {
+  stats.set(key, (stats.get(key) || 0) + 1);
+}
+
+function settings() {
+  const s = { testCases: Number(process.env.HEGEL_TEST_CASES) || 100 };
+  if (process.env.HEGEL_DATABASE) {
+    s.database = hegel.Database.fromPath(process.env.HEGEL_DATABASE);
+  }
+  return s;
+}
+
+/** A property: `body(tc)` runs under Hegel; a thrown error (or `fail`) is a failure. */
+export function property(name, body) {
+  nodeTest(name, () => {
+    msgs = [];
+    stats = new Map();
+    hegel.test((tc) => {
+      try {
+        body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** A pin: a plain test for one recorded bug. */
+export function pin(name, body) {
+  nodeTest(name, body);
+}
+
+/** An integer in [lo, hi]. */
+export function n(tc, lo, hi) {
+  return tc.draw(gs.integers({ minValue: lo, maxValue: hi }));
+}
+
+/** One of xs. */
+export function pick(tc, xs) {
+  return xs[n(tc, 0, xs.length - 1)];
+}
+
+/** True pct percent of the time. */
+export function chance(tc, pct) {
+  return n(tc, 0, 99) < pct;
+}
+
+/** A string of `len` characters drawn from `alphabet` (an array of strings). */
+export function word(tc, alphabet, lo, hi) {
+  const len = n(tc, lo, hi);
+  let s = "";
+  for (let i = 0; i < len; i++) {
+    s += pick(tc, alphabet);
+  }
+  return s;
+}
+
+/** Structural equality: arrays by position, objects by key set (prototype ignored), else ===. */
+export function same(a, b) {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) {
+      return false;
+    }
+    return a.every((x, i) => same(x, b[i]));
+  }
+  if (a !== null && b !== null && typeof a === "object" && typeof b === "object") {
+    const ka = Object.keys(a).sort();
+    const kb = Object.keys(b).sort();
+    if (ka.length !== kb.length || ka.some((k, i) => k !== kb[i])) {
+      return false;
+    }
+    return ka.every((k) => same(a[k], b[k]));
+  }
+  return a === b;
+}
+
+/** A compact, unambiguous rendering for messages. */
+export function show(x) {
+  return JSON.stringify(x, (k, v) => (v === undefined ? "<undefined>" : v));
+}
