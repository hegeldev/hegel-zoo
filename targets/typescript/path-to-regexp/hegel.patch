diff --git a/hegel/hegel-zoo.mjs b/hegel/hegel-zoo.mjs
new file mode 100644
index 0000000..1ca6f10
--- /dev/null
+++ b/hegel/hegel-zoo.mjs
@@ -0,0 +1,163 @@
+// Hegel zoo: the small harness shared by the zoo's TypeScript/JavaScript targets.
+//
+// `property(name, body)` registers a node:test test that runs `body(tc)` under Hegel with
+// HEGEL_TEST_CASES cases (default 100) and the database at HEGEL_DATABASE. With ZOO_COLLECT=1
+// a `fail()` records the mismatch instead of failing, the case ends there, and the counts of
+// mismatches and of the shapes seen (`count(key)`) are printed at the end of the test, so a
+// property can be run over many cases to see every shape at once. `pin(name, body)` is a
+// plain test for one pinned bug: it must fail while the bug is present and pass once it is
+// fixed (the zoo's judge reads an unexpected pass as "fixed upstream?").
+
+import { readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+import { test as nodeTest } from "node:test";
+
+// The Hegel version these tests were written against (the zoo pins it in zoo.toml; upstream
+// would add it to devDependencies). Hegel and esbuild are installed with `npm install --prefix
+// .hegel` so the target's own package.json and lock file stay untouched. Checked at load time so
+// a stray install cannot silently change the engine.
+export const HEGEL_PIN = { "@hegeldev/hegel": "0.4.5" };
+
+const hegelDir = join(dirname(fileURLToPath(import.meta.url)), "..", ".hegel", "node_modules", "@hegeldev", "hegel");
+{
+  const installed = JSON.parse(readFileSync(join(hegelDir, "package.json"), "utf8")).version;
+  if (installed !== HEGEL_PIN["@hegeldev/hegel"]) {
+    throw new Error(`@hegeldev/hegel ${installed} is installed; these tests pin ${HEGEL_PIN["@hegeldev/hegel"]}`);
+  }
+}
+const hegel = await import(pathToFileURL(join(hegelDir, "dist", "index.js")));
+const gs = await import(pathToFileURL(join(hegelDir, "dist", "generators", "index.js")));
+
+export const collecting = !!process.env.ZOO_COLLECT;
+
+class Collected extends Error {}
+
+let msgs = [];
+let stats = new Map();
+
+/** Report a mismatch: an error normally, a recorded line in collect mode. */
+export function fail(message) {
+  if (collecting) {
+    msgs.push(message);
+    throw new Collected(message);
+  }
+  throw new Error(message);
+}
+
+/** Bump a statistic (the shape of a pinned bug, a generator branch). */
+export function count(key) {
+  stats.set(key, (stats.get(key) || 0) + 1);
+}
+
+function settings() {
+  const s = { testCases: Number(process.env.HEGEL_TEST_CASES) || 100 };
+  if (process.env.HEGEL_DATABASE) {
+    s.database = hegel.Database.fromPath(process.env.HEGEL_DATABASE);
+  }
+  return s;
+}
+
+/** A property: `body(tc)` runs under Hegel; a thrown error (or `fail`) is a failure. */
+export function property(name, body) {
+  nodeTest(name, () => {
+    msgs = [];
+    stats = new Map();
+    hegel.test((tc) => {
+      try {
+        body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** An async property: `body(tc)` may await; runs under Hegel's testAsync with the same settings. */
+export function propertyAsync(name, body) {
+  nodeTest(name, async () => {
+    msgs = [];
+    stats = new Map();
+    await hegel.testAsync(async (tc) => {
+      try {
+        await body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** A pin: a plain test for one recorded bug. */
+export function pin(name, body) {
+  nodeTest(name, body);
+}
+
+/** An integer in [lo, hi]. */
+export function n(tc, lo, hi) {
+  return tc.draw(gs.integers({ minValue: lo, maxValue: hi }));
+}
+
+/** One of xs. */
+export function pick(tc, xs) {
+  return xs[n(tc, 0, xs.length - 1)];
+}
+
+/** True pct percent of the time. */
+export function chance(tc, pct) {
+  return n(tc, 0, 99) < pct;
+}
+
+/** A string of `len` characters drawn from `alphabet` (an array of strings). */
+export function word(tc, alphabet, lo, hi) {
+  const len = n(tc, lo, hi);
+  let s = "";
+  for (let i = 0; i < len; i++) {
+    s += pick(tc, alphabet);
+  }
+  return s;
+}
+
+/** Structural equality: arrays by position, objects by key set (prototype ignored), else ===. */
+export function same(a, b) {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) {
+      return false;
+    }
+    return a.every((x, i) => same(x, b[i]));
+  }
+  if (a !== null && b !== null && typeof a === "object" && typeof b === "object") {
+    const ka = Object.keys(a).sort();
+    const kb = Object.keys(b).sort();
+    if (ka.length !== kb.length || ka.some((k, i) => k !== kb[i])) {
+      return false;
+    }
+    return ka.every((k) => same(a[k], b[k]));
+  }
+  return a === b;
+}
+
+/** A compact, unambiguous rendering for messages. */
+export function show(x) {
+  return JSON.stringify(x, (k, v) => (v === undefined ? "<undefined>" : v));
+}
diff --git a/hegel/hegel.test.mjs b/hegel/hegel.test.mjs
new file mode 100644
index 0000000..63d684b
--- /dev/null
+++ b/hegel/hegel.test.mjs
@@ -0,0 +1,478 @@
+// Hegel zoo: path-to-regexp's parse/stringify and compile/match round trips, its compile and
+// parse against reference models, group and array alternation, matching options, ReDoS safety
+// of the generated regular expressions (recheck) and hostile input. Run with
+// `node --test --test-reporter=tap hegel/hegel.test.mjs` (Hegel, TypeScript and recheck
+// installed under .hegel/, the library built to dist/). ZOO_COLLECT=1 counts mismatches instead
+// of failing; HEGEL_TEST_CASES widens the sweep; ZOO_NO_KNOWN=1 lifts the gates of hegel/known.mjs.
+
+import assert from "node:assert/strict";
+import { chance, count, fail, n, pick, pin, property, propertyAsync, same, show, word } from "./hegel-zoo.mjs";
+import {
+  DELIMITERS, SYNTAX_CHARS, TEXT_CHARS, VALUE_CHARS, expansions, flipCase, genParams, genPathString,
+  genTokens, modelCompile, modelParse, mutate, normalize, pathErrorMessage, plain, ptr, recheck,
+  unambiguous,
+} from "./ptr.mjs";
+import { known } from "./known.mjs";
+
+const { parse, stringify, compile, match, pathToRegexp, TokenData, PathError } = ptr;
+
+/** pathToRegexp's verdict on token data: { ok } or { error } for a PathError (anything else is rethrown). */
+function accepts(tokens, options) {
+  try {
+    pathToRegexp(new TokenData(tokens), options);
+    return { ok: true };
+  } catch (e) {
+    if (e instanceof PathError) return { error: e.message };
+    throw e;
+  }
+}
+
+/** The result of `compile(tokens)(params)`: { path } or { error: message } for a TypeError. */
+function compiled(tokens, params, options) {
+  try {
+    return { path: compile(new TokenData(tokens), options)(params) };
+  } catch (e) {
+    if (e instanceof TypeError && !(e instanceof PathError)) return { error: e.message };
+    throw e;
+  }
+}
+
+/** Number of capturing groups in a regexp. */
+function captures(regexp) {
+  return new RegExp(regexp.source + "|").exec("").length - 1;
+}
+
+// ------------------------------------------------------------------ stringify / parse
+
+property("TestHegelStringifyParseRoundTrip", (tc) => {
+  const tokens = normalize(genTokens(tc));
+  count(tokens.some((t) => t.type === "group") ? "with-groups" : "flat");
+  const s = stringify(new TokenData(tokens));
+  assert.equal(typeof s, "string");
+  const back = parse(s);
+  assert.ok(back instanceof TokenData, "parse returns TokenData");
+  assert.equal(back.originalPath, s, "originalPath is the parsed string");
+  if (!same(plain(back.tokens), tokens)) {
+    fail(`stringify/parse: ${show(tokens)} -> ${show(s)} -> ${show(plain(back.tokens))}`);
+  }
+  assert.equal(stringify(back), s, `stringify is stable on ${show(s)}`);
+  // token data need not be normalized (custom paths): empty and adjacent text tokens denote the same path
+  if (chance(tc, 30)) {
+    const loose = tokens.flatMap((t) => (t.type === "text" && chance(tc, 50) ? [{ type: "text", value: "" }, t] : chance(tc, 20) ? [t, { type: "text", value: "" }] : [t]));
+    const ls = stringify(new TokenData(loose));
+    const gate = known("stringify", { tokens: loose });
+    if (gate) count(gate);
+    else if (!same(plain(parse(ls).tokens), tokens)) fail(`stringify of unnormalized ${show(loose)} = ${show(ls)}, which parses to ${show(plain(parse(ls).tokens))}`);
+  }
+  // and the same path string, parsed twice through stringify, denotes the same regexp
+  const str = genPathString(tc);
+  let data;
+  try {
+    data = parse(str);
+  } catch (e) {
+    assert.ok(e instanceof PathError, `parse throws PathError, not ${e}`);
+    count("invalid");
+    return;
+  }
+  const again = parse(stringify(data));
+  if (!same(plain(again.tokens), plain(data.tokens))) {
+    fail(`parse/stringify/parse: ${show(str)} -> ${show(stringify(data))}: ${show(plain(data.tokens))} vs ${show(plain(again.tokens))}`);
+  }
+  const a = accepts(data.tokens);
+  const b = accepts(again.tokens);
+  if (a.ok !== b.ok) fail(`pathToRegexp accepts ${show(str)} (${a.ok}) but its restringification ${show(stringify(data))} (${b.ok})`);
+  if (a.ok) assert.equal(pathToRegexp(again).regexp.source, pathToRegexp(data).regexp.source);
+});
+
+// ------------------------------------------------------------------ parse vs the model
+
+property("TestHegelParseAgreesWithTheModel", (tc) => {
+  const str = genPathString(tc);
+  const withEncoder = chance(tc, 30);
+  const encodePath = withEncoder ? encodeURI : undefined;
+  const model = modelParse(str, encodePath);
+  let got;
+  try {
+    got = parse(str, withEncoder ? { encodePath } : undefined);
+  } catch (e) {
+    assert.ok(e instanceof PathError && e instanceof TypeError, `parse throws PathError, not ${e}`);
+    assert.equal(e.originalPath, str, "PathError.originalPath");
+    count("throws");
+    if (model.error === undefined) {
+      fail(`parse(${show(str)}) throws ${show(e.message)}; the model reads ${show(model.tokens)}`);
+    }
+    const want = pathErrorMessage(model.error, str);
+    if (e.message !== want) {
+      const gate = known("parse-error", { str });
+      if (gate) count(gate);
+      else fail(`parse(${show(str)}) throws ${show(e.message)}; expected ${show(want)}`);
+    }
+    return;
+  }
+  count(withEncoder ? "parsed-encoded" : "parsed");
+  if (model.error !== undefined) fail(`parse(${show(str)}) = ${show(plain(got.tokens))}; the model rejects it: ${model.error}`);
+  if (!same(plain(got.tokens), model.tokens)) fail(`parse(${show(str)}) = ${show(plain(got.tokens))}; model ${show(model.tokens)}`);
+});
+
+// ------------------------------------------------------------------ compile vs the model
+
+property("TestHegelCompileFollowsTheModel", (tc) => {
+  const tokens = normalize(genTokens(tc, { route: chance(tc, 50) }));
+  const encode = pick(tc, [undefined, undefined, false, (s) => s.toUpperCase()]);
+  const delimiter = pick(tc, DELIMITERS);
+  const params = chance(tc, 8) ? undefined : genParams(tc, tokens, { hostile: chance(tc, 40), rawWildcards: encode === false && chance(tc, 80) });
+  const options = { delimiter, ...(encode !== undefined ? { encode } : {}) };
+  const want = modelCompile(tokens, params, { encode: encode === undefined ? encodeURIComponent : encode, delimiter });
+  const got = compiled(tokens, params, options);
+  count(want.error ? "error" : "path");
+  const gate = known("compile", { tokens, params });
+  if (gate) count(gate);
+  else if (!same(got, want.error ? want : { path: want.path })) {
+    fail(`compile(${show(tokens)}, ${show(options)})(${show(params)}) = ${show(got)}; model ${show(want.error ? want : { path: want.path })}`);
+  }
+  // compiling the stringified path is compiling the tokens
+  const viaString = (() => {
+    try {
+      return { path: compile(stringify(new TokenData(tokens)), options)(params) };
+    } catch (e) {
+      if (e instanceof TypeError && !(e instanceof PathError)) return { error: e.message };
+      throw e;
+    }
+  })();
+  if (!same(viaString, got)) fail(`compile(${show(stringify(new TokenData(tokens)))}) = ${show(viaString)} but compile(tokens) = ${show(got)}`);
+});
+
+// ------------------------------------------------------------------ compile then match
+
+/** A route with parameters that compiles: { tokens, params, path, flat, used, options } or null. */
+function genRoute(tc, { raw = false, delimiter = "/" } = {}) {
+  const tokens = normalize(genTokens(tc, { route: true, lo: 1, hi: 6 }));
+  const acc = accepts(tokens, { delimiter });
+  if (acc.error) {
+    count("rejected");
+    return null;
+  }
+  const params = genParams(tc, tokens, { rawWildcards: raw, present: 90 });
+  const gate = known("compile", { tokens, params });
+  if (gate) {
+    count(gate);
+    return null;
+  }
+  const model = modelCompile(tokens, params, { encode: raw ? false : encodeURIComponent, delimiter });
+  if (model.error) {
+    count("missing");
+    return null;
+  }
+  const path = compile(new TokenData(tokens), { delimiter, ...(raw ? { encode: false } : {}) })(params);
+  assert.equal(path, model.path);
+  return { tokens, params, path, flat: model.flat, used: model.used, delimiter, raw };
+}
+
+property("TestHegelCompiledPathsMatchBack", (tc) => {
+  const raw = chance(tc, 25);
+  const delimiter = pick(tc, DELIMITERS);
+  const route = genRoute(tc, { raw, delimiter });
+  if (!route) return;
+  const { tokens, path, flat, used } = route;
+  const options = { delimiter, ...(raw ? { decode: false } : {}) };
+  const fn = match(new TokenData(tokens), options);
+  const clear = unambiguous(flat, used, { encode: raw ? false : encodeURIComponent, delimiter });
+  const r = fn(path);
+  if (!clear) {
+    count(r ? "ambiguous-matched" : "ambiguous-unmatched");
+    if (r) assert.equal(r.path, path);
+    return;
+  }
+  count(raw ? "raw" : "encoded");
+  if (!r) fail(`match(${show(stringify(new TokenData(tokens)))}, ${show(options)}) rejects its own compile output ${show(path)} for ${show(used)}`);
+  assert.equal(r.path, path, "the matched path is the whole input");
+  if (!same(plain(r.params), used)) {
+    fail(`match(${show(stringify(new TokenData(tokens)))}, ${show(options)})(${show(path)}).params = ${show(plain(r.params))}; compiled from ${show(used)}`);
+  }
+  assert.equal(compile(new TokenData(tokens), { delimiter, ...(raw ? { encode: false } : {}) })(r.params), path, "recompiling the match gives the path");
+  // matching is case-insensitive by default
+  const flipped = flipCase(tc, path);
+  const rf = fn(flipped);
+  if (!rf) fail(`match(${show(stringify(new TokenData(tokens)))}) rejects the case-flipped ${show(flipped)} of ${show(path)}`);
+  assert.equal(rf.path, flipped);
+});
+
+// ------------------------------------------------------------------ options
+
+property("TestHegelOptionsShapeTheMatch", (tc) => {
+  const delimiter = pick(tc, ["/", "/", ".", "-", "::", "//"]);
+  const route = genRoute(tc, { delimiter });
+  if (!route) return;
+  const { tokens, path, flat, used } = route;
+  if (!unambiguous(flat, used, { delimiter })) {
+    count("ambiguous");
+    return;
+  }
+  const grouped = tokens.some((t) => t.type === "group");
+  const lastIsWildcard = flat.length > 0 && flat[flat.length - 1].type === "wildcard";
+  const lastIsText = flat.length > 0 && flat[flat.length - 1].type === "text";
+  const end = chance(tc, 50);
+  const trailing = chance(tc, 50);
+  const sensitive = chance(tc, 40);
+  const options = { delimiter, end, trailing, sensitive };
+  const data = new TokenData(tokens);
+  const fn = match(data, options);
+  const { regexp, keys } = pathToRegexp(data, options);
+  assert.equal(regexp.flags, sensitive ? "" : "i", "flags follow sensitive");
+  assert.equal(captures(regexp), keys.length, "one key per capture");
+  assert.deepEqual(plain(keys), expansions(tokens).flatMap((seq) => seq.filter((t) => t.type !== "text")), "keys are the captures of every expansion in order");
+  const check = (input, label) => {
+    const r = fn(input);
+    const m = regexp.exec(input);
+    if (!!r !== !!m) fail(`match and pathToRegexp disagree on ${show(input)} (${label}, ${show(options)}): ${show(r)} vs ${show(m)}`);
+    if (r) assert.equal(r.path, m[0], "match.path is the regexp match");
+    return r;
+  };
+  // the path itself
+  const r0 = check(path, "path");
+  if (!r0) fail(`match(${show(stringify(data))}, ${show(options)}) rejects its own compile output ${show(path)}`);
+  assert.equal(r0.path, path);
+  if (!same(plain(r0.params), used)) fail(`match(${show(stringify(data))}, ${show(options)})(${show(path)}).params = ${show(plain(r0.params))}; want ${show(used)}`);
+  // a trailing delimiter
+  const rt = check(path + delimiter, "trailing");
+  if (trailing) {
+    if (!rt) fail(`trailing: match(${show(stringify(data))}, ${show(options)}) rejects ${show(path + delimiter)}`);
+    assert.equal(rt.path, path + delimiter);
+    if (lastIsWildcard) count("wildcard-absorbs-trailing");
+    else if (!same(plain(rt.params), used)) fail(`trailing: params of ${show(path + delimiter)} are ${show(plain(rt.params))}; want ${show(used)}`);
+  } else if (!lastIsWildcard && !end) {
+    // (end: false lets the match stop before the trailing delimiter)
+    if (!rt) fail(`end false: match(${show(stringify(data))}, ${show(options)}) rejects ${show(path + delimiter)}`);
+    assert.equal(rt.path, path);
+  } else if (!lastIsWildcard) {
+    if (rt) fail(`trailing false: match(${show(stringify(data))}, ${show(options)}) accepts ${show(path + delimiter)} as ${show(rt)}`);
+  } else {
+    count(rt ? "wildcard-absorbs-trailing" : "wildcard-trailing-rejected");
+  }
+  // more path after a delimiter, and junk glued on
+  const more = path + delimiter + "zzz";
+  const rm = check(more, "more");
+  if (end) {
+    if (rm && !lastIsWildcard) fail(`end: match(${show(stringify(data))}, ${show(options)}) accepts ${show(more)} as ${show(rm)}`);
+  } else if (lastIsWildcard) {
+    count("wildcard-absorbs-more");
+  } else {
+    if (!rm) fail(`end false: match(${show(stringify(data))}, ${show(options)}) rejects ${show(more)}`);
+    assert.equal(rm.path, path, "end false: the match stops at the delimiter");
+    if (!same(plain(rm.params), used)) fail(`end false: params of ${show(more)} are ${show(plain(rm.params))}; want ${show(used)}`);
+  }
+  const glued = path + "zzz";
+  const rg = check(glued, "glued");
+  if (lastIsText && !grouped && !/[a-z]/i.test(delimiter)) {
+    if (rg) fail(`match(${show(stringify(data))}, ${show(options)}) accepts ${show(glued)} as ${show(rg)}`);
+  } else {
+    count(rg ? "glued-matched" : "glued-rejected");
+  }
+  // case
+  if (sensitive && !grouped && !/[a-z]/i.test(delimiter)) {
+    const flippedText = compile(new TokenData(tokens.map((t) => (t.type === "text" ? { type: "text", value: flipCase(tc, t.value) } : t))), { delimiter })(route.params);
+    const rs = check(flippedText, "sensitive");
+    if (flippedText !== path && rs) fail(`sensitive: match(${show(stringify(data))}, ${show(options)}) accepts ${show(flippedText)} for ${show(path)} as ${show(rs)}`);
+    if (flippedText === path) count("no-letters");
+  } else if (!sensitive) {
+    const flipped = flipCase(tc, path);
+    const rc = check(flipped, "insensitive");
+    if (!rc) fail(`insensitive: match(${show(stringify(data))}, ${show(options)}) rejects ${show(flipped)} for ${show(path)}`);
+  }
+});
+
+// ------------------------------------------------------------------ arrays and groups
+
+property("TestHegelArraysAndGroupsAreAlternatives", (tc) => {
+  // groups expand to alternatives, in order, up to 256 of them
+  const tokens = normalize(genTokens(tc, { route: true, lo: 1, hi: n(tc, 2, 12) }));
+  const alts = expansions(tokens);
+  const data = new TokenData(tokens);
+  let whole;
+  try {
+    whole = pathToRegexp(data);
+  } catch (e) {
+    assert.ok(e instanceof PathError, `pathToRegexp throws PathError, not ${e}`);
+    if (alts.length > 256) {
+      count("too-many");
+      assert.equal(e.message, pathErrorMessage("Too many path combinations", undefined));
+      return;
+    }
+    count("rejected");
+    const bad = alts.some((seq) => accepts(seq).error);
+    if (!bad) fail(`pathToRegexp(${show(stringify(data))}) throws ${show(e.message)} but every expansion is accepted`);
+    return;
+  }
+  if (alts.length > 256) fail(`pathToRegexp(${show(stringify(data))}) accepts ${alts.length} combinations`);
+  count(alts.length > 1 ? "alternatives" : "single");
+  const asArray = pathToRegexp(alts.map((seq) => new TokenData(seq)));
+  assert.equal(whole.regexp.source, asArray.regexp.source, `${show(stringify(data))} is the alternation of its expansions`);
+  assert.deepEqual(plain(whole.keys), plain(asArray.keys));
+  // an array of plain paths is as long as one likes
+  if (chance(tc, 15)) {
+    const size = n(tc, 1, 300);
+    const paths = Array.from({ length: size }, (_, i) => `/page${i}`);
+    const gate = known("array", { paths });
+    try {
+      const fn = match(paths);
+      const i = n(tc, 0, size - 1);
+      assert.equal(fn(`/page${i}`).path, `/page${i}`);
+      assert.equal(fn("/other"), false);
+      count("array-ok");
+    } catch (e) {
+      if (gate) count(gate);
+      else fail(`match of ${size} plain paths throws ${e.message}`);
+    }
+  }
+  // an array of paths matches like the first path that matches
+  const a = normalize(genTokens(tc, { route: true, lo: 1, hi: 4 }));
+  const b = normalize(genTokens(tc, { route: true, lo: 1, hi: 4 }));
+  if (accepts(a).error || accepts(b).error) {
+    count("pair-rejected");
+    return;
+  }
+  const options = { delimiter: pick(tc, ["/", "/", "."]), end: chance(tc, 70), trailing: chance(tc, 70) };
+  const fa = match(new TokenData(a), options);
+  const fb = match(new TokenData(b), options);
+  const fab = match([new TokenData(a), stringify(new TokenData(b))], options);
+  const inputs = [];
+  for (const t of [a, b]) {
+    const params = genParams(tc, t, { present: 90 });
+    const m = modelCompile(t, params, {});
+    if (!m.error) inputs.push(m.path);
+  }
+  inputs.push(mutate(tc, inputs[0] ?? "/", TEXT_CHARS.concat(SYNTAX_CHARS)));
+  for (const input of inputs) {
+    let ra, rb, rab;
+    try {
+      ra = fa(input);
+      rb = fb(input);
+      rab = fab(input);
+    } catch (e) {
+      assert.ok(e instanceof URIError, `only URIError may escape match: ${e}`);
+      count("uri-error");
+      continue;
+    }
+    const want = ra || rb;
+    if (!same(plain(rab), plain(want))) {
+      fail(`match([${show(stringify(new TokenData(a)))}, ${show(stringify(new TokenData(b)))}], ${show(options)})(${show(input)}) = ${show(plain(rab))}; separately ${show(plain(ra))} / ${show(plain(rb))}`);
+    }
+  }
+  const kab = pathToRegexp([new TokenData(a), new TokenData(b)], options).keys;
+  assert.deepEqual(plain(kab), plain(pathToRegexp(new TokenData(a), options).keys.concat(pathToRegexp(new TokenData(b), options).keys)));
+});
+
+// ------------------------------------------------------------------ ReDoS
+
+propertyAsync("TestHegelRegExpsAreSafe", async (tc) => {
+  const tokens = normalize(genTokens(tc, { route: true, lo: 1, hi: 7 }));
+  const options = { delimiter: pick(tc, DELIMITERS), end: chance(tc, 70), trailing: chance(tc, 70), sensitive: chance(tc, 30) };
+  let regexp;
+  try {
+    regexp = pathToRegexp(new TokenData(tokens), options).regexp;
+  } catch (e) {
+    assert.ok(e instanceof PathError, `pathToRegexp throws PathError, not ${e}`);
+    count("rejected");
+    return;
+  }
+  const result = await recheck.check(regexp.source, regexp.flags, { timeout: 4000, checker: "auto" });
+  count(result.status);
+  if (result.status === "vulnerable") {
+    // confirm with the attack string itself, sized to a few thousand characters
+    const { attack, complexity } = result;
+    const pumped = (reps) => attack.pumps.map((x) => x.prefix + x.pump.repeat(reps)).join("") + attack.suffix;
+    const time = (s) => {
+      const t0 = process.hrtime.bigint();
+      regexp.test(s);
+      return Number(process.hrtime.bigint() - t0) / 1e6;
+    };
+    const ms = time(attack.string);
+    const ms4k = time(pumped(4000));
+    if (process.env.ZOO_COLLECT) console.log(`# VULN ${show(stringify(new TokenData(tokens)))} ${show(options)} ${regexp.source} ${complexity.summary} ${attack.pattern} ${ms.toFixed(1)}ms 4k:${ms4k.toFixed(0)}ms`);
+    if (ms > 100 || ms4k > 500) {
+      fail(`ReDoS: ${show(stringify(new TokenData(tokens)))} with ${show(options)} -> ${regexp} takes ${ms.toFixed(0)}ms on ${attack.pattern} and ${ms4k.toFixed(0)}ms on 4000 pumps (${complexity.summary})`);
+    }
+    count(`vulnerable-${complexity.summary}-${ms4k > 50 ? "slow" : "fast"}`);
+  }
+});
+
+// ------------------------------------------------------------------ hostile input
+
+property("TestHegelHostileInputNeverCrashes", (tc) => {
+  const str = genPathString(tc);
+  const options = {
+    ...(chance(tc, 50) ? { delimiter: pick(tc, DELIMITERS.concat([""])) } : {}),
+    ...(chance(tc, 30) ? { end: chance(tc, 50) } : {}),
+    ...(chance(tc, 30) ? { trailing: chance(tc, 50) } : {}),
+    ...(chance(tc, 30) ? { sensitive: chance(tc, 50) } : {}),
+    ...(chance(tc, 20) ? { decode: false } : {}),
+    ...(chance(tc, 20) ? { encode: false } : {}),
+  };
+  let fn;
+  try {
+    fn = match(str, options);
+  } catch (e) {
+    assert.ok(e instanceof PathError, `match(${show(str)}) throws PathError, not ${e}`);
+    assert.equal(e.originalPath, str);
+    count("rejected");
+    return;
+  }
+  count("accepted");
+  for (let i = 0; i < 3; i++) {
+    const input = chance(tc, 50) ? mutate(tc, str, VALUE_CHARS.concat(["/", "%", "%E0", "%2F"])) : word(tc, VALUE_CHARS.concat(["/", "%", "%E0", "%2F"]), 0, 8);
+    try {
+      const r = fn(input);
+      if (r !== false) {
+        assert.equal(typeof r.path, "string");
+        assert.equal(typeof r.params, "object");
+        assert.ok(input.startsWith(r.path), "the matched path is a prefix of the input");
+      }
+    } catch (e) {
+      assert.ok(e instanceof URIError, `match(${show(str)}, ${show(options)})(${show(input)}) throws ${e}`);
+      count("uri-error");
+    }
+  }
+  // compile with anything for parameters
+  const toPath = compile(str, options);
+  const tokens = parse(str).tokens;
+  const params = genParams(tc, tokens, { hostile: true, present: 60 });
+  if (chance(tc, 20)) params[pick(tc, ["extra", "__proto__", "constructor"])] = "x";
+  try {
+    const p = toPath(chance(tc, 10) ? undefined : params);
+    assert.equal(typeof p, "string");
+  } catch (e) {
+    assert.ok(e instanceof TypeError && !(e instanceof PathError), `compile(${show(str)})(${show(params)}) throws ${e}`);
+    count("compile-error");
+  }
+  // token data with an unknown token type is a TypeError from pathToRegexp and compile
+  if (chance(tc, 20)) {
+    const odd = { tokens: tokens.concat([{ type: pick(tc, ["regexp", "optional", "TEXT", ""]), value: "x" }]) };
+    assert.throws(() => pathToRegexp(odd, options), TypeError);
+    assert.throws(() => compile(odd, options)(params), TypeError);
+    assert.throws(() => stringify(odd), TypeError);
+  }
+});
+
+// ------------------------------------------------------------------ pins
+
+pin("TestHegelPinArraysOfPlainPathsHaveNoCombinationLimit", () => {
+  const paths = Array.from({ length: 257 }, (_, i) => `/page${i}`);
+  const fn = match(paths);
+  assert.equal(fn("/page256").path, "/page256");
+});
+
+pin("TestHegelPinParseErrorIndexIsAStringIndex", () => {
+  const str = "\u{1D6FC}/(";
+  assert.throws(() => parse(str), { message: pathErrorMessage(`Unexpected ( at index ${str.indexOf("(")}`, str) });
+});
+
+pin("TestHegelPinCompileReadsOwnParametersOnly", () => {
+  assert.throws(() => compile("/:constructor")({}), { message: "Missing parameters: constructor" });
+  assert.equal(compile("/x{/:toString}")({}), "/x");
+});
+
+pin("TestHegelPinStringifyQuotesNamesBeforeEmptyText", () => {
+  const tokens = [{ type: "param", name: "foo" }, { type: "text", value: "" }, { type: "text", value: "bar" }];
+  const s = stringify(new TokenData(tokens));
+  assert.deepEqual(plain(parse(s).tokens), [{ type: "param", name: "foo" }, { type: "text", value: "bar" }], `stringify gave ${s}`);
+});
diff --git a/hegel/known.mjs b/hegel/known.mjs
new file mode 100644
index 0000000..1dd3552
--- /dev/null
+++ b/hegel/known.mjs
@@ -0,0 +1,29 @@
+// Hegel zoo: the recorded bugs of path-to-regexp (bugs.toml), as gates. `known(where, ctx)`
+// returns the bug id when a case has the shape of a recorded bug, so it is counted rather than
+// judged; ZOO_NO_KNOWN=1 lifts the gates.
+
+import { hasEmptyText, hasInheritedName } from "./ptr.mjs";
+
+const lifted = !!process.env.ZOO_NO_KNOWN;
+
+export function known(where, ctx) {
+  if (lifted) return "";
+  if (where === "array") {
+    // path-to-regexp/1: an array of more than 256 paths is rejected as "Too many path combinations"
+    if (ctx.paths && ctx.paths.length > 256) return "path-to-regexp/1";
+  }
+  if (where === "parse-error") {
+    // path-to-regexp/2: the index in a parse error counts code points, not string positions
+    if (ctx.str && /[\ud800-\udfff]/.test(ctx.str)) return "path-to-regexp/2";
+  }
+  if (where === "compile") {
+    // path-to-regexp/3: a parameter named after an Object.prototype member reads the inherited value
+    // (params default to a plain object, which inherits too)
+    if (ctx.tokens && hasInheritedName(ctx.tokens) && (ctx.params == null || Object.getPrototypeOf(ctx.params) !== null)) return "path-to-regexp/3";
+  }
+  if (where === "stringify") {
+    // path-to-regexp/4: an empty text token hides the text after it from the name-quoting check
+    if (ctx.tokens && hasEmptyText(ctx.tokens)) return "path-to-regexp/4";
+  }
+  return "";
+}
diff --git a/hegel/ptr.mjs b/hegel/ptr.mjs
new file mode 100644
index 0000000..21000fe
--- /dev/null
+++ b/hegel/ptr.mjs
@@ -0,0 +1,379 @@
+// Hegel zoo: path-to-regexp's built library, generators of token data, paths and parameters,
+// and reference models of `parse`, `compile` and group expansion.
+
+import { createRequire } from "node:module";
+import { chance, n, pick, word } from "./hegel-zoo.mjs";
+
+const require = createRequire(import.meta.url);
+export const ptr = require("../dist/index.js");
+export const recheck = require("../.hegel/node_modules/recheck");
+
+// The identifier classes are Unicode's (ECMA-262 IdentifierName), as the Readme documents.
+export const ID_START = /^[$_\p{ID_Start}]$/u;
+export const ID_CONTINUE = /^[$‌‍\p{ID_Continue}]$/u;
+
+// ------------------------------------------------------------------ alphabets
+
+const ID_START_CHARS = ["a", "b", "x", "$", "_", "Z", "\u{1D6FC}", "中", "é", "ε"];
+const ID_CONTINUE_CHARS = ["a", "c", "0", "9", "$", "_", "‌", "‍", "́", "·", "\u{1D6FC}", "\u{1D7CE}"];
+const ODD_NAME_CHARS = ["a", "1", "-", ".", " ", '"', "\\", "/", ":", "*", "{", "}", "\u{1D6FC}", "́", "\n"];
+export const TEXT_CHARS = [
+  "/", "/", "/", "a", "b", "z", "A", "0", "7", "-", ".", "_", "~", "%", " ", "{", "}", "(", ")",
+  "[", "]", "+", "?", "!", ":", "*", "\\", '"', "‌", "é", "\u{1D6FC}", "́", "^", "$",
+  "|", "#", "\n",
+];
+const PLAIN_TEXT_CHARS = ["a", "b", "c", "x", "y", "Z", "0", "1", "-", ".", "_", "~", "%", " ", "é", "\u{1D6FC}", "$", "^", "|", "#"];
+export const VALUE_CHARS = ["a", "b", "x", "Y", "0", "9", "-", ".", "/", " ", "é", "%", "+", "~", "\u{1D6FC}", ":", "*", "{", "'", "&"];
+export const SYNTAX_CHARS = [":", "*", "{", "}", "\\", '"', "(", ")", "[", "]", "+", "?", "!", "/"];
+export const DELIMITERS = ["/", "/", "/", ".", "-", "::", "//", "ab", "+", "$"];
+
+// ------------------------------------------------------------------ token data
+
+/** Names that plain objects inherit from Object.prototype. */
+export const INHERITED_NAMES = ["constructor", "toString", "__proto__", "hasOwnProperty", "valueOf"];
+
+/** True when a token tree names a parameter after an Object.prototype member. */
+export function hasInheritedName(tokens) {
+  return allKeys(tokens).some((k) => INHERITED_NAMES.includes(k.name) || k.name in Object.prototype);
+}
+
+/** True when a token tree holds an empty text token. */
+export function hasEmptyText(tokens) {
+  return tokens.some((t) => (t.type === "text" && t.value === "") || (t.type === "group" && hasEmptyText(t.tokens)));
+}
+
+/** A parameter name: usually an identifier, sometimes anything (which stringify must quote). */
+export function genName(tc) {
+  if (chance(tc, 4)) return pick(tc, INHERITED_NAMES);
+  if (chance(tc, 70)) {
+    return pick(tc, ID_START_CHARS) + word(tc, ID_CONTINUE_CHARS, 0, 3);
+  }
+  return word(tc, ODD_NAME_CHARS, 1, 4);
+}
+
+/** A text token's value: usually a delimiter and a plain word, sometimes any characters. */
+export function genText(tc) {
+  if (chance(tc, 60)) return "/" + word(tc, PLAIN_TEXT_CHARS, 0, 3);
+  return word(tc, TEXT_CHARS, 1, 4);
+}
+
+/**
+ * A token list: text, params, wildcards and (up to depth 2) groups. `route` biases towards
+ * lists pathToRegexp accepts (text between captures) with a leading delimiter.
+ */
+export function genTokens(tc, { depth = 0, lo = 0, hi = 6, route = false } = {}) {
+  const tokens = [];
+  const len = n(tc, lo, hi);
+  let lastWasCapture = false;
+  for (let i = 0; i < len; i++) {
+    const r = n(tc, 0, 99);
+    if (route && lastWasCapture && r < 85) {
+      tokens.push({ type: "text", value: genText(tc) });
+      lastWasCapture = false;
+    } else if (r < 45) {
+      tokens.push({ type: "text", value: genText(tc) });
+      lastWasCapture = false;
+    } else if (r < 72) {
+      tokens.push({ type: "param", name: genName(tc) });
+      lastWasCapture = true;
+    } else if (r < 84 || depth >= 2) {
+      tokens.push({ type: "wildcard", name: genName(tc) });
+      lastWasCapture = true;
+    } else {
+      tokens.push({ type: "group", tokens: genTokens(tc, { depth: depth + 1, lo: 0, hi: 3, route }) });
+      lastWasCapture = false;
+    }
+  }
+  return tokens;
+}
+
+/** Merge adjacent text tokens and drop empty ones, as `parse` never produces either. */
+export function normalize(tokens) {
+  const out = [];
+  for (const t of tokens) {
+    if (t.type === "text") {
+      if (!t.value) continue;
+      const last = out[out.length - 1];
+      if (last && last.type === "text") {
+        out[out.length - 1] = { type: "text", value: last.value + t.value };
+      } else {
+        out.push({ type: "text", value: t.value });
+      }
+    } else if (t.type === "group") {
+      out.push({ type: "group", tokens: normalize(t.tokens) });
+    } else {
+      out.push({ type: t.type, name: t.name });
+    }
+  }
+  return out;
+}
+
+/** Every param/wildcard key in the token tree, in order (groups included). */
+export function allKeys(tokens) {
+  const keys = [];
+  for (const t of tokens) {
+    if (t.type === "group") keys.push(...allKeys(t.tokens));
+    else if (t.type !== "text") keys.push(t);
+  }
+  return keys;
+}
+
+/** The flat sequences a token list expands to, in pathToRegexp's order (with a group first, then without). */
+export function expansions(tokens) {
+  const out = [];
+  const walk = (index, acc) => {
+    while (index < tokens.length) {
+      const t = tokens[index++];
+      if (t.type === "group") {
+        for (const inner of expansions(t.tokens)) walk(index, acc.concat(inner));
+        continue;
+      }
+      acc = acc.concat([t]);
+    }
+    out.push(acc);
+  };
+  walk(0, []);
+  return out;
+}
+
+/** A path string: mostly stringified token data, some of it mutated; sometimes raw characters. */
+export function genPathString(tc) {
+  let s;
+  if (chance(tc, 65)) {
+    s = ptr.stringify({ tokens: normalize(genTokens(tc)) });
+    if (chance(tc, 45)) s = mutate(tc, s, SYNTAX_CHARS);
+  } else {
+    s = word(tc, TEXT_CHARS.concat(SYNTAX_CHARS), 0, 8);
+  }
+  return s;
+}
+
+/** Insert, delete, replace or duplicate one or two characters (code points) of s. */
+export function mutate(tc, s, alphabet) {
+  let cps = [...s];
+  const times = n(tc, 1, 2);
+  for (let k = 0; k < times; k++) {
+    const i = n(tc, 0, cps.length);
+    const op = n(tc, 0, 3);
+    if (op === 0 || cps.length === 0) cps.splice(i, 0, pick(tc, alphabet));
+    else if (op === 1) cps.splice(Math.min(i, cps.length - 1), 1);
+    else if (op === 2) cps.splice(Math.min(i, cps.length - 1), 1, pick(tc, alphabet));
+    else cps.splice(Math.min(i, cps.length - 1), 0, cps[Math.min(i, cps.length - 1)]);
+  }
+  return cps.join("");
+}
+
+/** Flip the case of some ASCII letters. */
+export function flipCase(tc, s) {
+  return [...s].map((c) => (/[a-zA-Z]/.test(c) && chance(tc, 50) ? (c === c.toLowerCase() ? c.toUpperCase() : c.toLowerCase()) : c)).join("");
+}
+
+// ------------------------------------------------------------------ parameters
+
+/** A param value: a non-empty string from VALUE_CHARS. */
+export function genValue(tc) {
+  return word(tc, VALUE_CHARS, 1, 4);
+}
+
+/**
+ * Parameters for a token tree: every key gets a value with probability `present` (per key
+ * name); wildcards get arrays unless `rawWildcards`. `hostile` mixes in wrong types.
+ */
+export function genParams(tc, tokens, { present = 85, rawWildcards = false, hostile = false } = {}) {
+  const params = {};
+  for (const key of allKeys(tokens)) {
+    if (Object.hasOwn(params, key.name)) continue;
+    if (!chance(tc, present)) {
+      if (hostile && chance(tc, 30)) params[key.name] = pick(tc, [null, undefined]);
+      continue;
+    }
+    if (hostile && chance(tc, 25)) {
+      params[key.name] = pick(tc, ["", [], 7, true, {}, [""], ["a", 1], [null], ["a", ""]]);
+      continue;
+    }
+    if (key.type === "wildcard" && !rawWildcards) {
+      const len = n(tc, 1, 3);
+      params[key.name] = Array.from({ length: len }, () => genValue(tc));
+    } else {
+      params[key.name] = genValue(tc);
+    }
+  }
+  return params;
+}
+
+// ------------------------------------------------------------------ model: compile
+
+/**
+ * A reference `compile`: returns { path, flat, used } (the flat token sequence actually
+ * emitted and the values used) or { error } with the TypeError message the Readme's rules imply.
+ */
+export function modelCompile(tokens, params, { encode = encodeURIComponent, delimiter = "/" } = {}) {
+  const enc = encode === false ? (v) => v : encode;
+  const data = params ?? {};
+  class Fail extends Error {}
+  const run = (list, missing) => {
+    let path = "";
+    let flat = [];
+    for (const t of list) {
+      if (t.type === "text") {
+        path += t.value;
+        flat.push(t);
+        continue;
+      }
+      if (t.type === "group") {
+        const before = missing.length;
+        const inner = run(t.tokens, missing);
+        if (missing.length === before) {
+          path += inner.path;
+          flat = flat.concat(inner.flat);
+        } else {
+          missing.length = before;
+        }
+        continue;
+      }
+      const value = Object.hasOwn(data, t.name) ? data[t.name] : undefined;
+      flat.push(t);
+      if (value == null) {
+        missing.push(t.name);
+        continue;
+      }
+      if (t.type === "wildcard" && encode !== false) {
+        if (!Array.isArray(value) || value.length === 0) throw new Fail(`Expected "${t.name}" to be a non-empty array`);
+        let result = "";
+        for (let i = 0; i < value.length; i++) {
+          if (typeof value[i] !== "string") throw new Fail(`Expected "${t.name}/${i}" to be a string`);
+          if (i > 0) result += delimiter;
+          result += enc(value[i]);
+        }
+        if (!result) throw new Fail(`Expected "${t.name}" to be a non-empty array`);
+        path += result;
+        continue;
+      }
+      if (typeof value !== "string" || value.length === 0) throw new Fail(`Expected "${t.name}" to be a non-empty string`);
+      path += enc(value);
+    }
+    return { path, flat };
+  };
+  try {
+    const missing = [];
+    const { path, flat } = run(tokens, missing);
+    if (missing.length) return { error: `Missing parameters: ${missing.join(", ")}` };
+    const used = {};
+    for (const t of flat) if (t.type !== "text") used[t.name] = Object.hasOwn(data, t.name) ? data[t.name] : undefined;
+    return { path, flat, used };
+  } catch (e) {
+    if (e instanceof Fail) return { error: e.message };
+    throw e;
+  }
+}
+
+/**
+ * True when matching the compiled path back cannot be ambiguous: at most one wildcard in the
+ * sequence, and no value (as emitted) shares a character with the delimiter or any text token
+ * (case-insensitively, since matching is case-insensitive by default).
+ */
+export function unambiguous(flat, used, { encode = encodeURIComponent, delimiter = "/" } = {}) {
+  if (flat.filter((t) => t.type === "wildcard").length > 1) return false;
+  const enc = encode === false ? (v) => v : encode;
+  const taboo = new Set([...delimiter.toLowerCase()]);
+  for (const t of flat) if (t.type === "text") for (const c of t.value.toLowerCase()) taboo.add(c);
+  for (const value of Object.values(used)) {
+    const parts = Array.isArray(value) ? value : [value];
+    for (const p of parts) for (const c of enc(p).toLowerCase()) if (taboo.has(c)) return false;
+  }
+  return true;
+}
+
+// ------------------------------------------------------------------ model: parse
+
+/**
+ * A reference `parse` from the Readme's grammar: text with `\` escapes, `:name` and `*name`
+ * with identifier or double-quoted names, `{...}` groups, the reserved `}()[]+?!` rejected.
+ * Returns { tokens } or { error } (the message before the path and the help link).
+ */
+export function modelParse(str, encodePath = (s) => s) {
+  const chars = [...str];
+  let i = 0;
+  class Fail extends Error {}
+  // (indices in messages are string indices: an astral character counts two)
+  const at = (k) => chars.slice(0, k).join("").length;
+  const readName = () => {
+    let name = "";
+    if (i < chars.length && ID_START.test(chars[i])) {
+      name = chars[i++];
+      while (i < chars.length && ID_CONTINUE.test(chars[i])) name += chars[i++];
+    } else if (chars[i] === '"') {
+      const start = i;
+      i++;
+      let closed = false;
+      while (i < chars.length) {
+        const c = chars[i++];
+        if (c === '"') {
+          closed = true;
+          break;
+        }
+        if (c === "\\") {
+          if (i >= chars.length) break;
+          name += chars[i++];
+          continue;
+        }
+        name += c;
+      }
+      if (!closed) throw new Fail(`Unterminated quote at index ${at(start)}`);
+    }
+    if (!name) throw new Fail(`Missing parameter name at index ${at(i)}`);
+    return name;
+  };
+  const seq = (closer) => {
+    const tokens = [];
+    let text = "";
+    const flush = () => {
+      if (text) tokens.push({ type: "text", value: encodePath(text) });
+      text = "";
+    };
+    while (i < chars.length) {
+      const c = chars[i++];
+      if (c === closer) {
+        flush();
+        return tokens;
+      }
+      if (c === "\\") {
+        if (i >= chars.length) throw new Fail(`Unexpected end after \\ at index ${at(i)}`);
+        text += chars[i++];
+        continue;
+      }
+      if (c === ":" || c === "*") {
+        const name = readName();
+        flush();
+        tokens.push({ type: c === ":" ? "param" : "wildcard", name });
+        continue;
+      }
+      if (c === "{") {
+        flush();
+        tokens.push({ type: "group", tokens: seq("}") });
+        continue;
+      }
+      if ("}()[]+?!".includes(c)) throw new Fail(`Unexpected ${c} at index ${at(i - 1)}`);
+      text += c;
+    }
+    if (closer) throw new Fail(`Unexpected end at index ${at(i)}, expected ${closer}`);
+    flush();
+    return tokens;
+  };
+  try {
+    return { tokens: seq("") };
+  } catch (e) {
+    if (e instanceof Fail) return { error: e.message };
+    throw e;
+  }
+}
+
+/** The message a PathError carries for `message` on `path`. */
+export function pathErrorMessage(message, path) {
+  return message + (path ? `: ${path}` : "") + "; visit https://git.new/pathToRegexpError for info";
+}
+
+/** Token data as a plain structure (TokenData instances and null-prototype params alike). */
+export function plain(x) {
+  return JSON.parse(JSON.stringify(x));
+}
