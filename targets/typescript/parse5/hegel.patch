+// Shared by the property modules: parse5 in the shapes the tests need, the oracle vote, the
+// line/column arithmetic of source locations and a bounded collect-mode log.
+
+import { appendFileSync } from "node:fs";
+import { collecting, count, fail, noKnown } from "./hegel-zoo.mjs";
+import { parse, parseFragment, defaultTreeAdapter } from "../packages/parse5/dist/index.js";
+import { dat } from "./dat.mjs";
+import { html5ever, html5lib } from "./oracles.mjs";
+import { Known } from "./known.mjs";
+
+export const NS_HTML = "http://www.w3.org/1999/xhtml";
+export const NS_SVG = "http://www.w3.org/2000/svg";
+export const NS_MATHML = "http://www.w3.org/1998/Math/MathML";
+
+/** The context element for a fragment context such as `"div"` or `"svg path"`. */
+export function contextElement(ctx) {
+  const parts = ctx.split(" ");
+  if (parts.length === 1) return defaultTreeAdapter.createElement(parts[0], NS_HTML, []);
+  return defaultTreeAdapter.createElement(parts[1], parts[0] === "svg" ? NS_SVG : NS_MATHML, []);
+}
+
+/** parse5's tree for `html` (a document, or a fragment in the context `ctx`) and its .dat text. */
+export function parse5(html, ctx, scripting, extra = {}) {
+  const opts = { scriptingEnabled: scripting, ...extra };
+  const root = ctx ? parseFragment(contextElement(ctx), html, opts) : parse(html, opts);
+  return { root, tree: dat(root, opts.treeAdapter ?? defaultTreeAdapter) };
+}
+
+const logged = new Map();
+
+/** In collect mode, print up to 15 findings of each kind for a human to read (the harness shows counts only). */
+export function log(kind, info, ...sections) {
+  if (!collecting) return;
+  const k = logged.get(kind) ?? 0;
+  logged.set(kind, k + 1);
+  // TAP mangles the text: ZOO_LOG_FILE gets every finding as one JSON line, unescaped
+  if (process.env.ZOO_LOG_FILE) appendFileSync(process.env.ZOO_LOG_FILE, JSON.stringify({ kind, ...info }) + "\n");
+  if (k >= 15) return;
+  let s = `# ${kind} ${JSON.stringify(info)}\n`;
+  for (let i = 0; i < sections.length; i += 2) s += `--- ${sections[i]}\n${sections[i + 1]}${sections[i + 1].endsWith("\n") ? "" : "\n"}`;
+  process.stderr.write(s);
+}
+
+/**
+ * Fail on a finding, naming the recorded bug whose shape it has ("(shape of parse5/N)" after the
+ * message, so the shrunk case reads as its bug and the property is mapped to it); under
+ * HEGEL_NO_KNOWN=1 a finding a recorded bug explains is counted and the case goes on (false). The
+ * shape is counted in both modes, so a collect run shows how often each property draws each one.
+ */
+export function verdict(kind, info, message, ...sections) {
+  const known = Known.explains(kind, info);
+  if (known) {
+    count(`known ${known}`);
+    if (noKnown) return false;
+  }
+  log(kind, known ? { ...info, known } : info, ...sections);
+  fail(`${message}${known ? ` (shape of ${known})` : ""}\n${sections.map((s, i) => (i % 2 ? s : `--- ${s}`)).join("\n")}`);
+  return true;
+}
+
+// The one deviation from the spec the two oracles share: a DOCTYPE token in the "in table text"
+// insertion mode is "anything else", which first reprocesses the pending (non-whitespace, so
+// foster-parented) characters and then the token in "in table", where it is ignored; both oracles
+// ignore a DOCTYPE outside "initial" where it stands (html5lib in its base phase, html5ever in a
+// rule ahead of the modes) and keep collecting, so the whitespace after it joins the fostered text
+// in their trees and is inserted in the table by parse5 (`<table>foo<!DOCTYPE html>\n`). Narrowed to
+// a doctype right after non-whitespace text and before whitespace, with a table start tag before.
+const ORACLES_DOCTYPE_IN_TABLE_TEXT = /<table[\s/>][^]*[^\s<>]<!doctype[^>]*>\s/i;
+
+/**
+ * The vote: parse5 agreeing with html5ever is the norm; agreeing with html5lib alone means the two
+ * oracles read different spec versions; alone against both agreeing oracles is a mismatch (a
+ * recorded bug or a failure); three different trees or a foreign fragment (html5lib has no
+ * opinion) are counted and, when collecting, printed for a human to judge. Returns html5ever's
+ * answer with `agreed` set when parse5's tree is the same.
+ */
+export function judge(html, ctx, scripting, tree) {
+  const req = { html, fragment: ctx, scripting };
+  const ever = html5ever(req);
+  if (tree === ever.tree) {
+    count("agree");
+    return { ...ever, agreed: true };
+  }
+  const lib = html5lib(req);
+  if (lib.error) {
+    count("no-vote");
+    log("no-vote", req, "parse5", tree, "html5ever", ever.tree);
+    return ever;
+  }
+  if (tree === lib.tree) {
+    count("oracles-differ");
+    return ever;
+  }
+  if (ever.tree !== lib.tree) {
+    count("three-way");
+    log("three-way", req, "parse5", tree, "html5ever", ever.tree, "html5lib", lib.tree);
+    return ever;
+  }
+  if (ORACLES_DOCTYPE_IN_TABLE_TEXT.test(html)) {
+    count("oracles-deviate");
+    log("oracles-deviate", req, "parse5", tree, "oracles", ever.tree);
+    return ever;
+  }
+  verdict("tree", { ...req, got: tree, want: ever.tree }, `parse5 differs from both oracles on ${JSON.stringify(html)} (context ${ctx}, scripting ${scripting})`, "parse5", tree, "oracles", ever.tree);
+  return ever;
+}
+
+/** Offsets at which lines start: LF, CR and CR LF each end a line, as the parser's preprocessor sees them. */
+export function lineStarts(html) {
+  const starts = [0];
+  for (let i = 0; i < html.length; i++) {
+    const c = html.charCodeAt(i);
+    if (c === 10) starts.push(i + 1);
+    else if (c === 13 && html.charCodeAt(i + 1) !== 10) starts.push(i + 1);
+  }
+  return starts;
+}
+
+/** The 1-based line and column (in UTF-16 code units) of `offset`. */
+export function lineCol(starts, offset) {
+  let lo = 0;
+  let hi = starts.length - 1;
+  while (lo < hi) {
+    const mid = (lo + hi + 1) >> 1;
+    if (starts[mid] <= offset) lo = mid;
+    else hi = mid - 1;
+  }
+  return { line: lo + 1, col: offset - starts[lo] + 1 };
+}
+
+/** CR LF and CR become LF, as the parser's preprocessor does. */
+export function newlines(s) {
+  return s.replace(/\r\n?/g, "\n");
+}
diff --git a/hegel/dat.mjs b/hegel/dat.mjs
