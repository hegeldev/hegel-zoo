+        // the fragment parser reads a noscript context as raw text whatever the scripting flag, so a
+        // serialized (escaped) fragment re-parsed in that context keeps its escapes and tags as text
+        return info.ctx === "noscript" && info.scripting === false && /[&<]/.test(info.out ?? "") ? "parse5/14" : null;
