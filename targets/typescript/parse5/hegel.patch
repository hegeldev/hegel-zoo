+        if (/<(pre|textarea|listing)[\s/>]/i.test(html) && info.gaps.every((g) => /^gap \d+\.\.\d+ "(\\n|\\r\\n|\\r|&#0*10;?|&#[xX]0*[aA];?|&NewLine;)[^"]*" before text /.test(g))) return "parse5/16";
