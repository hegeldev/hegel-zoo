+// Shared by the property modules: parse5 in the shapes the tests need, the oracle vote, the
+// line/column arithmetic of source locations and a bounded collect-mode log.
+
+import { appendFileSync } from "node:fs";
+import { collecting, count, fail } from "./hegel-zoo.mjs";
+import { parse, parseFragment, defaultTreeAdapter } from "../packages/parse5/dist/index.js";
+import { dat } from "./dat.mjs";
+import { html5ever, html5lib } from "./oracles.mjs";
+import { Known } from "./known.mjs";
+
+export const NS_HTML = "http://www.w3.org/1999/xhtml";
+export const NS_SVG = "http://www.w3.org/2000/svg";
+export const NS_MATHML = "http://www.w3.org/1998/Math/MathML";
+
+/** The context element for a fragment context such as `"div"` or `"svg path"`. */
+export function contextElement(ctx) {
+  const parts = ctx.split(" ");
+  if (parts.length === 1) return defaultTreeAdapter.createElement(parts[0], NS_HTML, []);
+  return defaultTreeAdapter.createElement(parts[1], parts[0] === "svg" ? NS_SVG : NS_MATHML, []);
+}
+
+/** parse5's tree for `html` (a document, or a fragment in the context `ctx`) and its .dat text. */
+export function parse5(html, ctx, scripting, extra = {}) {
+  const opts = { scriptingEnabled: scripting, ...extra };
+  const root = ctx ? parseFragment(contextElement(ctx), html, opts) : parse(html, opts);
+  return { root, tree: dat(root, opts.treeAdapter ?? defaultTreeAdapter) };
+}
+
+const logged = new Map();
+
+/** In collect mode, print up to 15 findings of each kind for a human to read (the harness shows counts only). */
+export function log(kind, info, ...sections) {
+  if (!collecting) return;
+  const k = logged.get(kind) ?? 0;
+  logged.set(kind, k + 1);
+  // TAP mangles the text: ZOO_LOG_FILE gets every finding as one JSON line, unescaped
+  if (process.env.ZOO_LOG_FILE) appendFileSync(process.env.ZOO_LOG_FILE, JSON.stringify({ kind, ...info }) + "\n");
+  if (k >= 15) return;
+  let s = `# ${kind} ${JSON.stringify(info)}\n`;
+  for (let i = 0; i < sections.length; i += 2) s += `--- ${sections[i]}\n${sections[i + 1]}${sections[i + 1].endsWith("\n") ? "" : "\n"}`;
+  process.stderr.write(s);
+}
+
+/** Fail unless a recorded bug explains the finding, in which case it is counted. */
+export function verdict(kind, info, message, ...sections) {
+  const known = Known.explains(kind, info);
+  if (known) {
+    count(`known ${known}`);
+    return false;
+  }
+  log(kind, info, ...sections);
+  fail(`${message}\n${sections.map((s, i) => (i % 2 ? s : `--- ${s}`)).join("\n")}`);
+  return true;
+}
+
+/**
+ * The vote: parse5 agreeing with html5ever is the norm; agreeing with html5lib alone means the two
+ * oracles read different spec versions; alone against both agreeing oracles is a mismatch (a
+ * recorded bug or a failure); three different trees or a foreign fragment (html5lib has no
+ * opinion) are counted and, when collecting, printed for a human to judge. Returns html5ever's
+ * answer with `agreed` set when parse5's tree is the same.
+ */
+export function judge(html, ctx, scripting, tree) {
+  const req = { html, fragment: ctx, scripting };
+  const ever = html5ever(req);
+  if (tree === ever.tree) {
+    count("agree");
+    return { ...ever, agreed: true };
+  }
+  const lib = html5lib(req);
+  if (lib.error) {
+    count("no-vote");
+    log("no-vote", req, "parse5", tree, "html5ever", ever.tree);
+    return ever;
+  }
+  if (tree === lib.tree) {
+    count("oracles-differ");
+    return ever;
+  }
+  if (ever.tree !== lib.tree) {
+    count("three-way");
+    log("three-way", req, "parse5", tree, "html5ever", ever.tree, "html5lib", lib.tree);
+    return ever;
+  }
+  verdict("tree", { ...req, got: tree, want: ever.tree }, `parse5 differs from both oracles on ${JSON.stringify(html)} (context ${ctx}, scripting ${scripting})`, "parse5", tree, "oracles", ever.tree);
+  return ever;
+}
+
+/** Offsets at which lines start: LF, CR and CR LF each end a line, as the parser's preprocessor sees them. */
+export function lineStarts(html) {
+  const starts = [0];
+  for (let i = 0; i < html.length; i++) {
+    const c = html.charCodeAt(i);
+    if (c === 10) starts.push(i + 1);
+    else if (c === 13 && html.charCodeAt(i + 1) !== 10) starts.push(i + 1);
+  }
+  return starts;
+}
+
+/** The 1-based line and column (in UTF-16 code units) of `offset`. */
+export function lineCol(starts, offset) {
+  let lo = 0;
+  let hi = starts.length - 1;
+  while (lo < hi) {
+    const mid = (lo + hi + 1) >> 1;
+    if (starts[mid] <= offset) lo = mid;
+    else hi = mid - 1;
+  }
+  return { line: lo + 1, col: offset - starts[lo] + 1 };
+}
+
+/** CR LF and CR become LF, as the parser's preprocessor does. */
+export function newlines(s) {
+  return s.replace(/\r\n?/g, "\n");
+}
diff --git a/hegel/dat.mjs b/hegel/dat.mjs
new file mode 100644
index 0000000..91c8813
--- /dev/null
+++ b/hegel/dat.mjs
@@ -0,0 +1,80 @@
+// The html5lib-tests .dat tree format, for any parse5 tree adapter: a port of parse5's own
+// test/utils/serialize-to-dat-file-format.ts. Every tree in these tests (parse5's, html5ever's,
+// html5lib's, parse5's through another adapter or after a streaming parse) is compared in it.
+
+const NS_SVG = "http://www.w3.org/2000/svg";
+const NS_MATHML = "http://www.w3.org/1998/Math/MathML";
+const NS_HTML = "http://www.w3.org/1999/xhtml";
+const ATTR_NS = {
+  "http://www.w3.org/1999/xlink": "xlink",
+  "http://www.w3.org/XML/1998/namespace": "xml",
+  "http://www.w3.org/2000/xmlns/": "xmlns",
+};
+
+function indentOf(indent) {
+  return "|".padEnd(indent + 2, " ");
+}
+
+function nsPrefix(element, adapter) {
+  const ns = adapter.getNamespaceURI(element);
+  return ns === NS_SVG ? "svg " : ns === NS_MATHML ? "math " : "";
+}
+
+function nodeList(nodes, indent, adapter) {
+  let out = "";
+  for (let node of nodes) {
+    out += indentOf(indent);
+    if (adapter.isCommentNode(node)) {
+      out += `<!-- ${adapter.getCommentNodeContent(node)} -->\n`;
+    } else if (adapter.isTextNode(node)) {
+      out += `"${adapter.getTextNodeContent(node)}"\n`;
+    } else if (adapter.isDocumentTypeNode(node)) {
+      const publicId = adapter.getDocumentTypeNodePublicId(node);
+      const systemId = adapter.getDocumentTypeNodeSystemId(node);
+      out += `<!DOCTYPE ${adapter.getDocumentTypeNodeName(node) || ""}`;
+      if (publicId || systemId) out += ` "${publicId}" "${systemId}"`;
+      out += ">\n";
+    } else {
+      const tn = adapter.getTagName(node);
+      out += `<${nsPrefix(node, adapter) + tn}>\n`;
+      let childIndent = indent + 2;
+      // the .dat format names the attribute's namespace (xlink, xml, xmlns) before the local name;
+      // parse5's own test serializer prints the token prefix, which differs for a bare `xmlns`
+      // (namespace XMLNS, no prefix) - the namespace is what html5lib-tests and the oracles print
+      const attrs = adapter.getAttrList(node).map((attr) => {
+        let s = indentOf(childIndent);
+        const ns = ATTR_NS[attr.namespace];
+        if (ns) s += `${ns} `;
+        else if (attr.prefix) s += `${attr.prefix} `;
+        return s + `${attr.name}="${attr.value}"\n`;
+      });
+      out += attrs.sort().join("");
+      if (tn === "template" && adapter.getNamespaceURI(node) === NS_HTML) {
+        out += `${indentOf(childIndent)}content\n`;
+        childIndent += 2;
+        node = adapter.getTemplateContent(node);
+      }
+      out += nodeList(adapter.getChildNodes(node), childIndent, adapter);
+    }
+  }
+  return out;
+}
+
+/** The children of `root` (a document or fragment) in the .dat format. */
+export function dat(root, adapter) {
+  return nodeList(adapter.getChildNodes(root), 0, adapter);
+}
+
+/** Walk every node below `root` (template contents included), parents before children. */
+export function* walk(root, adapter) {
+  for (const node of adapter.getChildNodes(root)) {
+    yield node;
+    if (adapter.isElementNode(node)) {
+      const inner =
+        adapter.getTagName(node) === "template" && adapter.getNamespaceURI(node) === NS_HTML
+          ? adapter.getTemplateContent(node)
+          : node;
+      yield* walk(inner, adapter);
+    }
+  }
+}
diff --git a/hegel/gen.mjs b/hegel/gen.mjs
new file mode 100644
index 0000000..b4fdb8d
--- /dev/null
+++ b/hegel/gen.mjs
@@ -0,0 +1,249 @@
+// Random HTML for parse5: a token soup with the shapes the HTML parsing algorithm has rules for
+// (misnested formatting, tables, selects, templates, foreign content, raw text, comments, doctypes,
+// character references, NULs, line ends), sometimes structured, sometimes mutated, always bounded.
+// Every string is well formed (no lone surrogates) so it can travel to the oracles as UTF-8.
+
+import { chance, n, pick } from "./hegel-zoo.mjs";
+
+export const VOID = ["area", "base", "br", "col", "embed", "hr", "img", "input", "link", "meta", "source", "track", "wbr"];
+export const RAWTEXT = ["script", "style", "xmp", "iframe", "noembed", "noframes"];
+export const RCDATA = ["textarea", "title"];
+export const FORMATTING = ["a", "b", "big", "code", "em", "font", "i", "nobr", "s", "small", "strike", "strong", "tt", "u"];
+export const BLOCKS = [
+  "address", "article", "aside", "blockquote", "center", "details", "dialog", "dir", "div", "dl", "fieldset",
+  "figcaption", "figure", "footer", "header", "hgroup", "main", "menu", "nav", "ol", "p", "search", "section",
+  "summary", "ul", "h1", "h2", "h3", "h4", "h5", "h6", "pre", "listing", "form", "li", "dd", "dt", "button",
+  "applet", "marquee", "object", "span", "label",
+];
+export const TABLE = ["table", "caption", "colgroup", "col", "thead", "tbody", "tfoot", "tr", "td", "th"];
+export const SELECT = ["select", "option", "optgroup", "datalist"];
+export const STRUCT = [
+  "html", "head", "body", "frameset", "frame", "noscript", "template", "image", "ruby", "rb", "rt", "rtc", "rp",
+  "keygen", "menuitem", "param", "sarcasm", "foo", "x-bar", "plaintext", "isindex", "command", "base", "basefont",
+  "bgsound", "meta", "link", "title", "style", "script",
+];
+export const FOREIGN = [
+  "svg", "math", "mi", "mo", "mn", "ms", "mtext", "annotation-xml", "foreignObject", "desc", "g", "path", "title",
+  "malignmark", "mglyph", "altGlyph", "feBlend", "textPath", "clipPath", "linearGradient",
+];
+
+const ALL_TAGS = [...new Set([...VOID, ...RAWTEXT, ...RCDATA, ...FORMATTING, ...BLOCKS, ...TABLE, ...SELECT, ...STRUCT, ...FOREIGN])];
+
+/** The HTML-namespace tags a fragment may be parsed in the context of. */
+export const CONTEXTS = [...new Set([...VOID, ...RAWTEXT, ...RCDATA, ...FORMATTING, ...BLOCKS, ...TABLE, ...SELECT, ...STRUCT])].filter(
+  (t) => !["image", "sarcasm", "x-bar", "foo", "isindex", "command"].includes(t),
+);
+export const FOREIGN_CONTEXTS = ["svg path", "svg svg", "svg desc", "svg foreignObject", "svg title", "math mi", "math math", "math annotation-xml", "math mtext"];
+
+const ATTR_NAMES = [
+  "id", "class", "href", "src", "type", "name", "value", "style", "title", "lang", "dir", "hidden", "data-x", "onclick",
+  "xlink:href", "xlink:title", "xml:lang", "xml:space", "xmlns", "xmlns:xlink", "xmlns:foo", "definitionurl", "definitionURL",
+  "encoding", "viewbox", "viewBox", "attributeName", "ATTRIBUTENAME", "zoomAndPan", "foo", "a", "x:y", "action", "prompt",
+  "FOO", "Data-Y", "id", "class",
+];
+const ATTR_VALUES = [
+  "", "x", "1", "hidden", "text/html", "application/xhtml+xml", "text/plain", "foo bar", "&amp;", "&lt;x", "&notit;", "&not",
+  "&#65;", "&#x41;", "&AMP", "a&b", "&", "&;", ">", "<", "/", "=", "'", "\"", "\u00e9", "\u0000", "\n", "\t", "  ", "\u{1F600}",
+  "-//W3C//DTD HTML 4.01//EN", "http://www.w3.org/2000/svg", "http://www.w3.org/1998/Math/MathML", "http://www.w3.org/1999/xhtml",
+];
+const WORDS = [
+  "foo", "bar", "x", "Hello", "a b", "text", "1", "\n", "  ", "\t", "\f", "\r\n", "\r", "\u0000", "\u00e9", "\u{1F600}", "\u00a0",
+  "&amp;", "&lt;", "&gt;", "&quot;", "&nbsp;", "&notit;", "&not", "&AMP", "&AMP;", "&#65;", "&#x41;", "&#0;", "&#x80;", "&#xD800;",
+  "&#x10FFFF;", "&#x110000;", "&#xD;", "&#13;", "&#x9;", "&foo;", "&", "&#", "&#x", "&#xZ", "<", "</", "</ ", "<3", "< a", ">",
+  "<!", "<!->", "<?x>", "]]>", "--", "-->", "<![CDATA[x]]>", "<![CDATA[", "\ufffd", "\u000b", "\u200b", "\u0001", "\u007f", "\u0085",
+  "&#x2028;", "&#xfdd0;", "&#xfffe;", "&#x1fffe;", "&CounterClockwiseContourIntegral;", "&ThisIsNotAnEntity;", "&am", "&ampx",
+  "x&ampx", "&#128;", "&#160;", "&#x9F;", "&#x00000041;", "&#0000000000065;", "&lt", "&ltx", "&Aacute", "&Aacutex", "&cent",
+];
+const COMMENT_BODIES = ["", "x", " x ", "-", "--", "--!", ">", "->", "-->", "<!--", "--x", "x--", "-x-", "<!", "a\nb", "\u0000", "--!>", "<!-- --"];
+const DOCTYPES = [
+  "<!DOCTYPE html>", "<!doctype html>", "<!DOCTYPE HTML>", "<!DOCTYPE>", "<!DOCTYPE html SYSTEM \"about:legacy-compat\">",
+  "<!DOCTYPE html PUBLIC \"-//W3C//DTD HTML 4.01//EN\" \"http://www.w3.org/TR/html4/strict.dtd\">",
+  "<!DOCTYPE html PUBLIC \"-//W3C//DTD HTML 4.01 Transitional//EN\">",
+  "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Frameset//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-frameset.dtd\">",
+  "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\">", "<!DOCTYPE html PUBLIC \"-//IETF//DTD HTML//EN\">",
+  "<!DOCTYPE html SYSTEM 'http://www.ibm.com/data/dtd/v11/ibmxhtml1-transitional.dtd'>", "<!DOCTYPE html PUBLIC>",
+  "<!DOCTYPE html PUBLIC \"x\">", "<!DOCTYPE html SYSTEM>", "<!DOCTYPE html SYSTEM \"x\" \"y\">", "<!DOCTYPE potato>",
+  "<!DOCTYPE html PUBLIC \"-//W3C//DTD HTML 4.01//EN\">", "<!DOCTYPE html PUBLIC \"-/W3C/DTD HTML 4.0 Transitional/EN\">",
+  "<!DOCTYPE html PUBLIC \"HTML\">", "<!DOCTYPE html PUBLIC \"-//WebTechs//DTD Mozilla HTML 2.0//EN\">", "<!DOCTYPE html\u0000>",
+  "<!DOCTYPE html \"x\">", "<!DOCTYPE html PUBLIC\"x\"\"y\">", "<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 3.2 Final//EN\">",
+];
+
+export function tagName(tc) {
+  const r = n(tc, 0, 99);
+  if (r < 14) return pick(tc, FORMATTING);
+  if (r < 40) return pick(tc, BLOCKS);
+  if (r < 52) return pick(tc, TABLE);
+  if (r < 58) return pick(tc, SELECT);
+  if (r < 65) return pick(tc, VOID);
+  if (r < 72) return pick(tc, [...RAWTEXT, ...RCDATA]);
+  if (r < 86) return pick(tc, STRUCT);
+  return pick(tc, FOREIGN);
+}
+
+function caseOf(tc, name) {
+  const r = n(tc, 0, 19);
+  if (r === 0) return name.toUpperCase();
+  if (r === 1) return name.replace(/^./, (c) => c.toUpperCase());
+  return name;
+}
+
+function attr(tc) {
+  const name = caseOf(tc, pick(tc, ATTR_NAMES));
+  const r = n(tc, 0, 9);
+  if (r === 0) return name;
+  if (r === 1) return `${name}=${pick(tc, ["x", "1", "a/b", "&amp;", "x>", "&", "foo&bar"])}`;
+  if (r === 2) return `${name}='${pick(tc, ATTR_VALUES).replaceAll("'", "")}'`;
+  if (r === 3) return `${name} = "${pick(tc, ATTR_VALUES).replaceAll('"', "")}"`;
+  return `${name}="${pick(tc, ATTR_VALUES).replaceAll('"', "")}"`;
+}
+
+export function startTag(tc, name = tagName(tc)) {
+  let s = "<" + caseOf(tc, name);
+  const k = chance(tc, 60) ? 0 : n(tc, 1, 3);
+  for (let i = 0; i < k; i++) s += pick(tc, [" ", " ", " ", "\n", "\t", "/", "  "]) + attr(tc);
+  const r = n(tc, 0, 29);
+  if (r === 0) s += "/";
+  if (r === 1) s += " /";
+  if (r === 2) s += " ";
+  if (r === 3) s += "<";
+  return s + (r === 4 ? "" : ">");
+}
+
+export function endTag(tc, name = tagName(tc)) {
+  const r = n(tc, 0, 19);
+  if (r === 0) return `</${caseOf(tc, name)} x="y">`;
+  if (r === 1) return `</${caseOf(tc, name)}/>`;
+  if (r === 2) return `</${caseOf(tc, name)} `;
+  if (r === 3) return `</${caseOf(tc, name)}`;
+  return `</${caseOf(tc, name)}>`;
+}
+
+export function text(tc) {
+  let s = "";
+  const k = n(tc, 1, 3);
+  for (let i = 0; i < k; i++) s += pick(tc, WORDS);
+  return s;
+}
+
+export function comment(tc) {
+  const r = n(tc, 0, 9);
+  const body = pick(tc, COMMENT_BODIES);
+  if (r === 0) return `<!--${body}`;
+  if (r === 1) return `<!--${body}--!>`;
+  if (r === 2) return pick(tc, ["<!-->", "<!--->", "<!x>", "<?x>", "<?", "<!", "</>", "</3>", "<! >", "<!--->x", "<!-", "<!-x", "<!doctyp>", "<![CDATA[x]]>", "<![CDATA[x", "<!DOCTYPE"]);
+  return `<!--${body}-->`;
+}
+
+export function doctype(tc) {
+  return pick(tc, DOCTYPES);
+}
+
+/** One token of soup, `open` being the tags started so far (closed randomly, mostly in order). */
+function soupToken(tc, open) {
+  const r = n(tc, 0, 99);
+  if (r < 38) {
+    const name = tagName(tc);
+    if (!VOID.includes(name)) open.push(name);
+    return startTag(tc, name);
+  }
+  if (r < 60) {
+    if (open.length && chance(tc, 75)) {
+      const i = chance(tc, 70) ? open.length - 1 : n(tc, 0, open.length - 1);
+      const name = open[i];
+      open.splice(i, 1);
+      return endTag(tc, name);
+    }
+    return endTag(tc);
+  }
+  if (r < 88) return text(tc);
+  if (r < 96) return comment(tc);
+  return doctype(tc);
+}
+
+/** A soup of up to `max` tokens. */
+export function soup(tc, max = 24) {
+  const open = [];
+  let s = "";
+  const k = n(tc, 0, max);
+  for (let i = 0; i < k; i++) s += soupToken(tc, open);
+  return s;
+}
+
+/** A nested element with children, mostly well formed. */
+function element(tc, depth) {
+  const name = tagName(tc);
+  let s = startTag(tc, name);
+  if (VOID.includes(name)) return s;
+  if (RAWTEXT.includes(name) || RCDATA.includes(name)) {
+    s += pick(tc, ["", "x", "a<b", "</", `</${name}`, `</${name} `, "<!--", "-->", "&amp;", "<script>", "</script>", "]]>", "\u0000"]);
+    return s + (chance(tc, 85) ? endTag(tc, name) : "");
+  }
+  const k = depth > 4 ? 0 : n(tc, 0, 3);
+  for (let i = 0; i < k; i++) s += chance(tc, 60) ? element(tc, depth + 1) : chance(tc, 80) ? text(tc) : comment(tc);
+  return s + (chance(tc, 80) ? endTag(tc, name) : "");
+}
+
+/** A structured document: optional doctype, a few nested elements, a little soup. */
+export function structured(tc) {
+  let s = chance(tc, 60) ? doctype(tc) : "";
+  if (chance(tc, 30)) s += startTag(tc, "html");
+  if (chance(tc, 30)) s += startTag(tc, "head") + (chance(tc, 50) ? element(tc, 3) : "") + (chance(tc, 70) ? "</head>" : "");
+  if (chance(tc, 30)) s += startTag(tc, "body");
+  const k = n(tc, 0, 4);
+  for (let i = 0; i < k; i++) s += chance(tc, 75) ? element(tc, 0) : text(tc);
+  if (chance(tc, 30)) s += soup(tc, 6);
+  if (chance(tc, 20)) s += "</body>";
+  if (chance(tc, 20)) s += "</html>";
+  if (chance(tc, 20)) s += soup(tc, 4);
+  return s;
+}
+
+const MUTATION_CHARS = ["<", ">", "/", "&", ";", "\"", "'", "=", " ", "-", "!", "\n", "\r", "\u0000", "?", "[", "]", "a", "p", "t"];
+
+/** `html` with one to three random edits, kept well formed (no split surrogate pairs). */
+export function mutate(tc, html) {
+  const k = n(tc, 1, 3);
+  for (let i = 0; i < k && html.length; i++) {
+    const at = n(tc, 0, html.length);
+    const r = n(tc, 0, 3);
+    if (r === 0) html = html.slice(0, at) + html.slice(at + 1);
+    else if (r === 1) html = html.slice(0, at) + pick(tc, MUTATION_CHARS) + html.slice(at);
+    else if (r === 2) {
+      const to = Math.min(html.length, at + n(tc, 1, 8));
+      html = html.slice(0, at) + html.slice(at, to) + html.slice(at);
+    } else {
+      const to = Math.min(html.length, at + n(tc, 1, 8));
+      html = html.slice(0, at) + html.slice(to);
+    }
+  }
+  return html.isWellFormed() ? html : html.replace(/[\ud800-\udfff]/g, "x");
+}
+
+/** A document: soup, structure or a mutation of either; at most ~600 characters. */
+export function document(tc) {
+  const r = n(tc, 0, 9);
+  let s = r < 4 ? soup(tc) : r < 8 ? structured(tc) : mutate(tc, chance(tc, 50) ? soup(tc) : structured(tc));
+  if (s.length > 600) s = s.slice(0, 600);
+  return s.isWellFormed() ? s : s.replace(/[\ud800-\udfff]/g, "x");
+}
+
+/** A fragment context: an HTML tag mostly, a foreign one sometimes (`"svg path"`). */
+export function context(tc) {
+  return chance(tc, 85) ? pick(tc, CONTEXTS) : pick(tc, FOREIGN_CONTEXTS);
+}
+
+/** Split `s` into random chunks (empty chunks included, surrogate pairs kept together). */
+export function chunks(tc, s) {
+  const out = [];
+  let i = 0;
+  while (i < s.length) {
+    let len = chance(tc, 30) ? n(tc, 0, 2) : n(tc, 1, Math.max(1, Math.min(40, s.length - i)));
+    if (len > s.length - i) len = s.length - i;
+    let j = i + len;
+    if (j > i && j < s.length && s.charCodeAt(j - 1) >= 0xd800 && s.charCodeAt(j - 1) <= 0xdbff) j++;
+    out.push(s.slice(i, j));
+    i = j;
+  }
+  if (chance(tc, 20)) out.push("");
+  return out;
+}
diff --git a/hegel/hegel-zoo.mjs b/hegel/hegel-zoo.mjs
new file mode 100644
index 0000000..1ca6f10
--- /dev/null
+++ b/hegel/hegel-zoo.mjs
@@ -0,0 +1,163 @@
+// Hegel zoo: the small harness shared by the zoo's TypeScript/JavaScript targets.
+//
+// `property(name, body)` registers a node:test test that runs `body(tc)` under Hegel with
+// HEGEL_TEST_CASES cases (default 100) and the database at HEGEL_DATABASE. With ZOO_COLLECT=1
+// a `fail()` records the mismatch instead of failing, the case ends there, and the counts of
+// mismatches and of the shapes seen (`count(key)`) are printed at the end of the test, so a
+// property can be run over many cases to see every shape at once. `pin(name, body)` is a
+// plain test for one pinned bug: it must fail while the bug is present and pass once it is
+// fixed (the zoo's judge reads an unexpected pass as "fixed upstream?").
+
+import { readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+import { test as nodeTest } from "node:test";
+
+// The Hegel version these tests were written against (the zoo pins it in zoo.toml; upstream
+// would add it to devDependencies). Hegel and esbuild are installed with `npm install --prefix
+// .hegel` so the target's own package.json and lock file stay untouched. Checked at load time so
+// a stray install cannot silently change the engine.
+export const HEGEL_PIN = { "@hegeldev/hegel": "0.4.5" };
+
+const hegelDir = join(dirname(fileURLToPath(import.meta.url)), "..", ".hegel", "node_modules", "@hegeldev", "hegel");
+{
+  const installed = JSON.parse(readFileSync(join(hegelDir, "package.json"), "utf8")).version;
+  if (installed !== HEGEL_PIN["@hegeldev/hegel"]) {
+    throw new Error(`@hegeldev/hegel ${installed} is installed; these tests pin ${HEGEL_PIN["@hegeldev/hegel"]}`);
+  }
+}
+const hegel = await import(pathToFileURL(join(hegelDir, "dist", "index.js")));
+const gs = await import(pathToFileURL(join(hegelDir, "dist", "generators", "index.js")));
+
+export const collecting = !!process.env.ZOO_COLLECT;
+
+class Collected extends Error {}
+
+let msgs = [];
+let stats = new Map();
+
+/** Report a mismatch: an error normally, a recorded line in collect mode. */
+export function fail(message) {
+  if (collecting) {
+    msgs.push(message);
+    throw new Collected(message);
+  }
+  throw new Error(message);
+}
+
+/** Bump a statistic (the shape of a pinned bug, a generator branch). */
+export function count(key) {
+  stats.set(key, (stats.get(key) || 0) + 1);
+}
+
+function settings() {
+  const s = { testCases: Number(process.env.HEGEL_TEST_CASES) || 100 };
+  if (process.env.HEGEL_DATABASE) {
+    s.database = hegel.Database.fromPath(process.env.HEGEL_DATABASE);
+  }
+  return s;
+}
+
+/** A property: `body(tc)` runs under Hegel; a thrown error (or `fail`) is a failure. */
+export function property(name, body) {
+  nodeTest(name, () => {
+    msgs = [];
+    stats = new Map();
+    hegel.test((tc) => {
+      try {
+        body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** An async property: `body(tc)` may await; runs under Hegel's testAsync with the same settings. */
+export function propertyAsync(name, body) {
+  nodeTest(name, async () => {
+    msgs = [];
+    stats = new Map();
+    await hegel.testAsync(async (tc) => {
+      try {
+        await body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** A pin: a plain test for one recorded bug. */
+export function pin(name, body) {
+  nodeTest(name, body);
+}
+
+/** An integer in [lo, hi]. */
+export function n(tc, lo, hi) {
+  return tc.draw(gs.integers({ minValue: lo, maxValue: hi }));
+}
+
+/** One of xs. */
+export function pick(tc, xs) {
+  return xs[n(tc, 0, xs.length - 1)];
+}
+
+/** True pct percent of the time. */
+export function chance(tc, pct) {
+  return n(tc, 0, 99) < pct;
+}
+
+/** A string of `len` characters drawn from `alphabet` (an array of strings). */
+export function word(tc, alphabet, lo, hi) {
+  const len = n(tc, lo, hi);
+  let s = "";
+  for (let i = 0; i < len; i++) {
+    s += pick(tc, alphabet);
+  }
+  return s;
+}
+
+/** Structural equality: arrays by position, objects by key set (prototype ignored), else ===. */
+export function same(a, b) {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) {
+      return false;
+    }
+    return a.every((x, i) => same(x, b[i]));
+  }
+  if (a !== null && b !== null && typeof a === "object" && typeof b === "object") {
+    const ka = Object.keys(a).sort();
+    const kb = Object.keys(b).sort();
+    if (ka.length !== kb.length || ka.some((k, i) => k !== kb[i])) {
+      return false;
+    }
+    return ka.every((k) => same(a[k], b[k]));
+  }
+  return a === b;
+}
+
+/** A compact, unambiguous rendering for messages. */
+export function show(x) {
+  return JSON.stringify(x, (k, v) => (v === undefined ? "<undefined>" : v));
+}
