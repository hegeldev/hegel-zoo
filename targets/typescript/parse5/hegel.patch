+  if (s.line !== loc.startLine || s.col !== loc.startCol) findings.push(`${what}: start ${loc.startLine}:${loc.startCol} is not offset ${loc.startOffset} = ${s.line}:${s.col}`);
+  const e = lineCol(starts, loc.endOffset);
+  if (e.line !== loc.endLine || e.col !== loc.endCol) findings.push(`${what}: end ${loc.endLine}:${loc.endCol} is not offset ${loc.endOffset} = ${e.line}:${e.col}`);
+  return true;
+}
+
+/** Every recorded location of the tree, in walk order, as comparable JSON. */
+export function locationsOf(root, adapter = defaultTreeAdapter) {
+  const out = [];
+  for (const node of walk(root, adapter)) out.push([node.nodeName ?? adapter.getTagName?.(node), JSON.stringify(node.sourceCodeLocation ?? null)]);
+  return out;
+}
+
+property("TestHegelLocationsPointIntoTheSource", (tc) => {
+  const html = gen.document(tc);
+  const scripting = chance(tc, 75);
+  const ctx = chance(tc, 30) ? gen.context(tc) : null;
+  const { root } = parse5(html, ctx, scripting, { sourceCodeLocationInfo: true });
+  const starts = lineStarts(html);
+  const findings = [];
+  const adapter = defaultTreeAdapter;
+  const lower = html.toLowerCase();
+  for (const node of walk(root, adapter)) {
+    const loc = node.sourceCodeLocation;
+    if (!loc) {
+      if (adapter.isElementNode(node)) count("element without location");
+      else findings.push(`${node.nodeName} has no location`);
+      continue;
+    }
+    if (!checkLocation(loc, html, starts, node.nodeName, findings)) continue;
+    const slice = html.slice(loc.startOffset, loc.endOffset);
+    if (adapter.isTextNode(node)) {
+      const text = adapter.getTextNodeContent(node);
+      if (!/[&<\0\r]/.test(slice) && !text.includes("\ufffd")) {
+        if (slice !== text) findings.push(`text ${JSON.stringify(text)} has the location of ${JSON.stringify(slice)}`);
+      } else count("text with references or tags");
+    } else if (adapter.isCommentNode(node)) {
+      if (!/^<[!?/]/.test(slice)) findings.push(`comment location holds ${JSON.stringify(slice)}`);
+      const data = adapter.getCommentNodeContent(node);
+      if (!data.includes("\ufffd") && !newlines(slice).includes(data)) findings.push(`comment ${JSON.stringify(data)} is not in its location ${JSON.stringify(slice)}`);
+    } else if (adapter.isDocumentTypeNode(node)) {
+      if (!/^<!doctype/i.test(slice)) findings.push(`doctype location holds ${JSON.stringify(slice)}`);
+    } else {
+      const tn = adapter.getTagName(node).toLowerCase();
+      if (loc.startTag) {
+        checkLocation(loc.startTag, html, starts, `<${tn}> start tag`, findings);
+        const st = lower.slice(loc.startTag.startOffset, loc.startTag.endOffset);
+        const names = tn === "img" ? ["img", "image"] : [tn];
+        if (!names.some((nm) => st.startsWith(`<${nm}`) || st.startsWith(`</${nm}`))) findings.push(`<${tn}> start tag location holds ${JSON.stringify(st)}`);
+        if (loc.startTag.startOffset !== loc.startOffset) findings.push(`<${tn}> starts at ${loc.startOffset} but its start tag at ${loc.startTag.startOffset}`);
+        for (const [name, al] of Object.entries(loc.startTag.attrs ?? {})) {
+          if (!checkLocation(al, html, starts, `attribute ${name} of <${tn}>`, findings)) continue;
+          const as = lower.slice(al.startOffset, al.endOffset);
+          if (!name.includes("\ufffd") && !as.startsWith(name.toLowerCase())) findings.push(`attribute ${name} of <${tn}> has the location of ${JSON.stringify(as)}`);
+        }
+        if (loc.attrs && JSON.stringify(loc.attrs) !== JSON.stringify(loc.startTag.attrs)) findings.push(`<${tn}> location.attrs differs from startTag.attrs`);
+      } else if (loc.startOffset !== loc.endOffset || tn === "template") count(`implicit <${tn}> with a location`);
+      if (loc.endTag) {
+        checkLocation(loc.endTag, html, starts, `</${tn}> end tag`, findings);
+        const et = lower.slice(loc.endTag.startOffset, loc.endTag.endOffset);
+        if (!et.startsWith(`</${tn}`) && !(tn === "br" && et.startsWith("</br")) && !(tn === "p" && et.startsWith("</p"))) findings.push(`</${tn}> end tag location holds ${JSON.stringify(et)}`);
+        if (loc.endTag.endOffset !== loc.endOffset) findings.push(`<${tn}> ends at ${loc.endOffset} but its end tag at ${loc.endTag.endOffset}`);
+      }
+    }
+  }
+  if (findings.length) {
+    verdict("location", { html, ctx, scripting, findings }, `source locations are wrong for ${JSON.stringify(html)} (context ${ctx}, scripting ${scripting})`, "findings", findings.join("\n"));
+  } else count("locations fine");
+});
+
+// ---------------------------------------------------------------- parse errors
+
+const CODES = new Set(Object.values(ErrorCodes));
+
+property("TestHegelParseErrorsAreReported", (tc) => {
+  const html = gen.document(tc);
+  const scripting = chance(tc, 75);
+  const ctx = chance(tc, 30) ? gen.context(tc) : null;
+  const errors = [];
+  const { tree } = parse5(html, ctx, scripting, { onParseError: (e) => errors.push(e) });
+  const plain = parse5(html, ctx, scripting).tree;
+  const findings = [];
+  if (tree !== plain) findings.push("the tree differs when parse errors are reported");
+  const starts = lineStarts(html);
+  for (const e of errors) {
+    if (!CODES.has(e.code)) findings.push(`unknown error code ${e.code}`);
+    checkLocation(e, html, starts, `error ${e.code}`, findings);
+  }
+  const { tree: tree2 } = parse5(html, ctx, scripting, { onParseError: () => {}, sourceCodeLocationInfo: true });
+  if (tree2 !== plain) findings.push("the tree differs with sourceCodeLocationInfo");
+  count(errors.length ? "errors" : "no errors");
+  if (findings.length) {
+    verdict("errors", { html, ctx, scripting, findings, errors: errors.map((e) => `${e.code}@${e.startOffset}-${e.endOffset}`) }, `parse errors are off for ${JSON.stringify(html)} (context ${ctx}, scripting ${scripting})`, "findings", findings.join("\n"));
+  }
+});
