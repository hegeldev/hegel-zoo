+ * half, and a little soup after it half the time.
+ */
+export const foreignRootClosedByAncestorCase = cased(pick(["a", "p", "div", "span", "b", "i", "button", "h1", "li"]), loudCase).flatMap((ancestor) => gs.record({
+  prefix: pick(["", "<!DOCTYPE html><body>", "<p>x", "<math><mi>", "<svg><desc>", "<svg><foreignObject>"]),
+  open: someAttrs.map((attrs) => `<${ancestor}${attrs}>`),
+  root: gs.record({ name: cased(pick(["svg", "math"]), loudCase), attrs: someAttrs }).map((t) => `<${t.name}${t.attrs}>`),
+  children: pick(["", "", "<g>", "<g></g>", "<mi>x</mi>", "x", "<desc>d</desc>"]),
+  close: cased(ancestor, loudCase).map((name) => `</${name}>`),
+  filler: pick(["", "", "x", "foo bar", "\u00e9", "&amp;", "a\nb", "\0"]),
+  trigger: weighted(
+    [50, pick(["", "x", "a]b", "]]", "<b>", "&amp;", "\n"]).map((body) => ({ shape: "cdata", text: `<![CDATA[${body}]]>` }))],
+    [50, gs.record({ tag: cased(pick([...RAWTEXT, ...RCDATA, "noscript", "plaintext"]), loudCase), content: pick(["", "x", "&amp;"]), after: pick(["", "x", "</b>"]) })
+      .map((t) => ({ shape: "raw text", text: `<${t.tag}>${t.content}<b>${t.after}` }))],
+  ),
+  tail: maybe(50, soupOf(3)),
+})).map((c) => ({ shape: c.trigger.shape, html: c.prefix + c.open + c.root + c.children + c.close + c.filler + c.trigger.text + (c.tail ?? "") }));
+
+/** parse5/16:a `<pre>`, `<textarea>` (closed at once: it reads raw text) or `<listing>` start tag, then one to three tags and no text, then a line end. */
+export const newlineAfterPreTagsCase = pick(["pre", "textarea", "listing"]).flatMap((opener) => gs.record({
+  prefix: pick(["", "<!DOCTYPE html>", "<body>", "<p>x", "<div><!--c-->"]),
+  open: gs.tuples(cased(opener, loudCase), someAttrs).map(([n, a]) => `<${n}${a}>${opener === "textarea" ? "</textarea>" : ""}`),
+  tags: gs.arrays(plainTag, { minSize: opener === "textarea" ? 0 : 1, maxSize: 3 }),
+  nl: pick(["\n", "\r\n", "\r"]),
+  suffix: pick(["", "x", "foo bar", " x", "\n", "<b>x"]),
+}).map((c) => ({ opener, html: c.prefix + c.open + c.tags.join("") + c.nl + c.suffix })));
+
+/** parse5/12: a `<style>` or `<title>` start tag inside `<select>` or `<frameset>`, which the tree builder ignores (the tokenizer stays in the data state), then text and a tag. */
+export const rawTextTagIgnoredInSelectCase = pick(["select", "frameset"]).flatMap((container) => gs.record({
+  prefix: pick(["", "<!DOCTYPE html>", "<html>", "<head></head>"]),
+  open: gs.tuples(cased(container), someAttrs).map(([n, a]) => `<${n}${a}>`),
+  inner: container === "select" ? pick(["", "", "<option>a", "<optgroup>", "<option>a</option>"]) : pick(["", "", "<frame>", "<frameset></frameset>"]),
+  raw: cased(pick(["style", "title"])),
+  rawAttrs: someAttrs,
+  content: pick(["", "x", "&amp;", "a b"]),
+  next: pick(["<b>", "</option>", "<p>y", "<!--c-->"]),
+  suffix: pick(["", `</${container}>`, "z"]),
+}).map((c) => ({ container, raw: c.raw, html: c.prefix + c.open + c.inner + `<${c.raw}${c.rawAttrs}>` + c.content + c.next + c.suffix })));
+
+/** parse5/7: `</>` after a tag (70%), a comment, a doctype or `<br/>` (after text, the text's raw span covers it), then another token or nothing. */
+export const emptyEndTagBetweenTagsCase = gs.record({
+  prefix: pick(["", "x", "<div>", "<!DOCTYPE html>"]),
+  before: weighted([70, plainTag], [30, pick(["<!--c-->", "<!DOCTYPE html>", "<br/>"])]),
+  after: pick(["", "<p>", "</div>", "<!--d-->", "<b>y", "</>"]),
+}).map((c) => c.prefix + c.before + "</>" + c.after);
+
+/** parse5/8: the input ends inside a tag that follows a tag, a comment or nothing (after text, the tag's text is flushed with the text). */
+export const unfinishedTagAtTheEndCase = cased(pick(PLAIN_TAGS), loudCase).flatMap((name) => gs.record({
+  prefix: pick(["", "<p>", "<div>x</div>", "<!--c-->", "<!DOCTYPE html>", "<br/>"]),
+  tail: pick([`<${name}`, `</${name}`, `<${name} `, `</${name} `, `<${name} a`, `<${name} a=`, `<${name} a="x`, `<${name} a='x`, `<${name} a=x`, `<${name}/`, `<${name} a="x" b`]),
+})).map((c) => c.prefix + c.tail);
+
+/** The elements whose content RewritingStream.emitText leaves unescaped. */
+export const UNESCAPED_TEXT_TAGS = ["script", "style", "xmp", "iframe", "noembed", "noframes", "plaintext", "noscript"];
+// texts whose unescaped spelling reads back as markup or as another character reference
+const ESCAPED_TEXTS = ["&lt;x", "&lt;b&gt;y", "&amp;lt;", "&amp;amp;", "x&lt;/p&gt;", "&lt;!--c--&gt;"];
+/** parse5/17: an escaped text before a raw text element (whose start tag flushes it) or after it until the next start tag (half and half; after a `<plaintext>` every text is its content, so always before). */
+export const textAroundRawTextElementCase = pick(UNESCAPED_TEXT_TAGS).flatMap((tag) => gs.record({
+  name: cased(tag, loudCase),
+  attrs: someAttrs,
+  content: pick(["", "x", "a<b"]),
+  text: pick(ESCAPED_TEXTS),
+  before: chance(50),
+  prefix: pick(["", "<!DOCTYPE html>", "<p>y"]),
+  after: pick(["", "<!--c-->", "</p>"]),
+}).map((c) => {
+  const element = `<${c.name}${c.attrs}>${c.content}${tag === "plaintext" ? "" : `</${c.name}>`}`;
+  const before = tag === "plaintext" || c.before;
+  return { before, html: c.prefix + (before ? c.text + element : element + c.text + c.after) };
+}));
+
+// the spec's foreign attribute adjustments (xml:base is none: it stays an attribute of that name)
+const PREFIXED_ATTRS = ["xlink:href", "xlink:title", "xlink:show", "xlink:actuate", "xml:lang", "xml:space", "xmlns:xlink"];
+const prefixedValue = pick(["", "x", "y", "http://www.w3.org/1999/xlink", "a b"]);
+/** parse5/9: a foreign root (or an element inside it, 4 times in 6) whose start tag carries a prefixed attribute (and up to two more attributes), which the simulator hands out adjusted as `{ prefix, name }` and emitStartTag writes by name alone. */
+export const foreignAttributePrefixCase = cased(pick(["svg", "math"]), loudCase).flatMap((root) => gs.record({
+  first: gs.tuples(cased(pick(PREFIXED_ATTRS)), prefixedValue).map(([n, v]) => `${n}="${v}"`),
+  more: gs.arrays(gs.tuples(pick([...PREFIXED_ATTRS, "id", "class", "viewBox", "href"]), prefixedValue).map(([n, v]) => `${n}="${v}"`), { maxSize: 2 }),
+  inner: weighted([2, gs.just("")], [4, cased(pick(["foreignObject", "g", "mi", "path"]))]),
+  end: pick([">", "/>", " />"]),
+  prefix: pick(["", "<!DOCTYPE html>", "<p>y"]),
+  suffix: pick(["", "x", `</${root}>`, "<b>z"]),
+}).map((c) => {
+  const attrs = [c.first, ...c.more].join(" ");
+  const tag = c.inner ? `<${root}><${c.inner} ${attrs}>` : `<${root} ${attrs}${c.end}`;
+  return { nested: !!c.inner, html: c.prefix + tag + c.suffix };
+}));
+
+/** parse5/10: a doctype without a name (its token name is null) between a little content. */
+export const namelessDoctypeCase = gs.record({
+  prefix: pick(["", "<!--c-->", " ", "\n"]),
+  doctype: pick(["<!DOCTYPE>", "<!doctype>", "<!DOCTYPE >", "<!DOCTYPE\n>", "<!DocType  >", "<!DOCTYPE\t>"]),
+  suffix: pick(["", "<p>x", "<html>", "x", "<!DOCTYPE html>"]),
+}).map((c) => c.prefix + c.doctype + c.suffix);
+
+/** parse5/6: a plain text without line ends (so the only newline the pre could hold is the one the stream inserts) with its chunks. */
+export const plainTextWithoutLineEndsCase = chunkedText(words(pick(["a", "b c", "<div>", "&amp;", "&", "<", "\0", "\t", "</pre>", "<!--", "\xe9", "\u{1F600}", " "]), 0, 6));
diff --git a/hegel/hegel-zoo.mjs b/hegel/hegel-zoo.mjs
new file mode 100644
index 0000000..0897b8e
--- /dev/null
+++ b/hegel/hegel-zoo.mjs
@@ -0,0 +1,157 @@
+// Hegel zoo: the small harness shared by the zoo's TypeScript/JavaScript targets.
+//
+// `property(name, body)` registers a node:test test that runs `body(tc)` under Hegel with
+// HEGEL_TEST_CASES cases (default 100) and the database at HEGEL_DATABASE. With ZOO_COLLECT=1
+// a `fail()` records the mismatch instead of failing, the case ends there, and the counts of
+// mismatches and of the shapes seen (`count(key)`) are printed at the end of the test, so a
+// property can be run over many cases to see every shape at once. `pin(name, body)` is a
+// plain test for one pinned bug: it must fail while the bug is present and pass once it is
+// fixed (the zoo's judge reads an unexpected pass as "fixed upstream?"). HEGEL_NO_KNOWN=1
+// (`noKnown`, read once here) asks for a run that looks past the recorded bugs: a property
+// that draws nothing but the shape of one is registered skipped (`property(name, body, { skip })`),
+// and a finding of a wide property that a recorded bug explains is counted instead of failed
+// (`verdict` in common.mjs). By default the shapes are drawn and the properties fail on them.
+// The generators are values built from Hegel's combinators (`gs`, re-exported here) in gen.mjs.
+
+import { readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+import { test as nodeTest } from "node:test";
+
+// The Hegel version these tests were written against (the zoo pins it in zoo.toml; upstream
+// would add it to devDependencies). Hegel is installed with `npm install --prefix .hegel` so the
+// target's own package.json and lock file stay untouched. Checked at load time so a stray
+// install cannot silently change the engine.
+export const HEGEL_PIN = { "@hegeldev/hegel": "0.4.5" };
+
+const hegelDir = join(dirname(fileURLToPath(import.meta.url)), "..", ".hegel", "node_modules", "@hegeldev", "hegel");
+{
+  const installed = JSON.parse(readFileSync(join(hegelDir, "package.json"), "utf8")).version;
+  if (installed !== HEGEL_PIN["@hegeldev/hegel"]) {
+    throw new Error(`@hegeldev/hegel ${installed} is installed; these tests pin ${HEGEL_PIN["@hegeldev/hegel"]}`);
+  }
+}
+const hegel = await import(pathToFileURL(join(hegelDir, "dist", "index.js")));
+const gs = await import(pathToFileURL(join(hegelDir, "dist", "generators", "index.js")));
+
+/** Hegel's generators, re-exported so the tests import everything from one place. */
+export { gs };
+
+export const collecting = !!process.env.ZOO_COLLECT;
+
+/** HEGEL_NO_KNOWN=1: look past the shapes of the recorded bugs (they are drawn, and fail, by default). */
+export const noKnown = !!process.env.HEGEL_NO_KNOWN;
+
+class Collected extends Error {}
+
+let msgs = [];
+let stats = new Map();
+
+/** Report a mismatch: an error normally, a recorded line in collect mode. */
+export function fail(message) {
+  if (collecting) {
+    msgs.push(message);
+    throw new Collected(message);
+  }
+  throw new Error(message);
+}
+
+/** Bump a statistic (the shape of a pinned bug, a generator branch). */
+export function count(key) {
+  stats.set(key, (stats.get(key) || 0) + 1);
+}
+
+function settings() {
+  const s = { testCases: Number(process.env.HEGEL_TEST_CASES) || 100 };
+  if (process.env.HEGEL_DATABASE) {
+    s.database = hegel.Database.fromPath(process.env.HEGEL_DATABASE);
+  }
+  return s;
+}
+
+// Hegel keys its example database by the test function's source text. Every property here runs
+// through the same wrapper, so without this every property would share one key and replay the
+// stored failing examples of all the others; the key is the test's name instead.
+function keyed(name, fn) {
+  fn.toString = () => name;
+  return fn;
+}
+
+/** A property: `body(tc)` runs under Hegel; a thrown error (or `fail`) is a failure. `skip` (a reason) registers it skipped. */
+export function property(name, body, { skip } = {}) {
+  nodeTest(name, { skip }, () => {
+    msgs = [];
+    stats = new Map();
+    hegel.test(keyed(name, (tc) => {
+      try {
+        body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }), settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** An async property: `body(tc)` may await; runs under Hegel's testAsync with the same settings. */
+export function propertyAsync(name, body, { skip } = {}) {
+  nodeTest(name, { skip }, async () => {
+    msgs = [];
+    stats = new Map();
+    await hegel.testAsync(keyed(name, async (tc) => {
+      try {
+        await body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }), settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** A pin: a plain test for one recorded bug. */
+export function pin(name, body) {
+  nodeTest(name, body);
+}
+
+/** Structural equality: arrays by position, objects by key set (prototype ignored), else ===. */
+export function same(a, b) {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) {
+      return false;
+    }
+    return a.every((x, i) => same(x, b[i]));
+  }
+  if (a !== null && b !== null && typeof a === "object" && typeof b === "object") {
+    const ka = Object.keys(a).sort();
+    const kb = Object.keys(b).sort();
+    if (ka.length !== kb.length || ka.some((k, i) => k !== kb[i])) {
+      return false;
+    }
+    return ka.every((k) => same(a[k], b[k]));
+  }
+  return a === b;
+}
+
+/** A compact, unambiguous rendering for messages. */
+export function show(x) {
+  return JSON.stringify(x, (k, v) => (v === undefined ? "<undefined>" : v));
+}
