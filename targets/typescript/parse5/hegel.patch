+    rw.on("startTag", (t) => rw.emitStartTag(t));
+    rw.on("endTag", (t) => rw.emitEndTag(t));
+    rw.on("text", (t) => rw.emitText(t));
+    rw.on("comment", (t) => rw.emitComment(t));
+  }
+  feed(rw, chunks);
+  await once(rw, "end");
+  return out;
