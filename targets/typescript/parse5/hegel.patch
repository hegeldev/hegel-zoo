+// Hegel properties for parse5 (see targets/typescript/parse5/README.md in the zoo).
+//
+// The oracles for the tree the parser builds are two other implementations of the same
+// algorithm, html5ever (Servo) and html5lib (Python), by vote (oracles.mjs, common.mjs); the
+// streaming packages, the serializer, the tree adapters and the source locations are checked
+// against parse5's own one-shot parse and against the input text. One process runs every module:
+// `node --test` on several files would nest the TAP output.
+
+import "./trees.mjs";
+import "./streams.mjs";
+import "./pins.mjs";
diff --git a/hegel/html5lib-oracle.py b/hegel/html5lib-oracle.py
new file mode 100644
index 0000000..6f37fdd
--- /dev/null
+++ b/hegel/html5lib-oracle.py
@@ -0,0 +1,63 @@
+#!/usr/bin/env python3
+"""html5lib (Python) as an oracle for parse5: one JSON request per stdin line, one JSON answer per line.
+
+Request: {"html": "...", "fragment": null | "div", "scripting": true}
+Answer:  {"tree": "<html5lib-tests .dat format>"} or {"error": "..."} (foreign fragment contexts and
+anything html5lib cannot parse have no opinion).
+
+html5lib's test serializer prints "#document" first, indents one space more than the .dat files and
+prefixes HTML-namespace elements with "html ": the answer is normalised to the .dat format parse5's
+own test suite prints, so the three trees (parse5, html5ever, html5lib) compare as plain strings.
+"""
+
+import json
+import sys
+
+import html5lib
+from html5lib import treebuilders
+
+TREE_BUILDER = treebuilders.getTreeBuilder("dom")
+
+
+def normalise(text):
+    lines = text.split("\n")
+    if lines and lines[0] in ("#document", "#document-fragment"):
+        lines = lines[1:]
+    out = []
+    for line in lines:
+        if line.startswith("| "):
+            line = "|" + line[2:]
+        if line.lstrip("| ").startswith("<html "):
+            line = line.replace("<html ", "<", 1)
+        out.append(line)
+    text = "\n".join(out)
+    return text + "\n" if text else ""
+
+
+def answer(req):
+    parser = html5lib.HTMLParser(tree=TREE_BUILDER)
+    scripting = bool(req.get("scripting", True))
+    fragment = req.get("fragment")
+    if fragment:
+        if " " in fragment:
+            return {"error": "html5lib has no foreign fragment contexts"}
+        node = parser.parseFragment(req["html"], container=fragment, scripting=scripting)
+    else:
+        node = parser.parse(req["html"], scripting=scripting)
+    return {"tree": normalise(parser.tree.testSerializer(node))}
+
+
+def main():
+    for line in sys.stdin:
+        if not line.strip():
+            continue
+        try:
+            reply = answer(json.loads(line))
+        except Exception as exc:  # noqa: BLE001 - any failure is "no opinion"
+            reply = {"error": repr(exc)[:300]}
+        sys.stdout.write(json.dumps(reply) + "\n")
+        sys.stdout.flush()
+
+
+if __name__ == "__main__":
+    main()
diff --git a/hegel/known.mjs b/hegel/known.mjs
new file mode 100644
index 0000000..73e8d32
--- /dev/null
+++ b/hegel/known.mjs
@@ -0,0 +1,154 @@
+// The bugs recorded in the zoo's bugs.toml for parse5, as predicates over the properties' findings:
+// `explains(kind, info)` gets the kind of check that failed and what it saw, and answers with the id
+// of the bug whose shape it has, or null. The shapes are drawn by default and the properties fail
+// on them (STYLE.md rule 11): `verdict` in common.mjs appends "(shape of parse5/N)" to the failure,
+// so the shrunk case names its bug and the property is mapped to it in target.toml beside the pin
+// in pins.mjs. Under HEGEL_NO_KNOWN=1 (`noKnown`, read once in the harness) an explained finding is
+// counted and the case goes on, for a run that looks past the recorded bugs.
+
+const RAW_TEXT_TAG = /<(title|style|xmp|iframe|noembed|noframes|noscript|textarea|plaintext)[\s/>]/i;
+const SELF_CLOSING_FOREIGN = /<(svg|math)\b[^<>]*\/>/i;
+const PREFIXED_FOREIGN_ATTR = /(xlink|xml|xmlns):[a-z]/i;
+const FOREIGN_TAG = /<(svg|math)[\s/>]/i;
+const NAMELESS_DOCTYPE = /<!doctype\s*>/i;
+const CDATA = /<!\[CDATA\[/i;
+
+/** parse5/11 without a raw text tag: a CDATA section the simulator, still in foreign content after a self-closing <svg/> or <math/>, reads as text. */
+const cdataAfterSelfClosingForeign = (html) => SELF_CLOSING_FOREIGN.test(html) && CDATA.test(html);
+
+/** A finding of TestHegelLocationsPointIntoTheSource / TestHegelParseErrorsAreReported explained by a location bug. */
+function locationBug(finding, html) {
+  if (/ (start|end) \d+:\d+ is not offset /.test(finding) && /&\r?\n|&\r/.test(html)) return "parse5/2";
+  const m = /: offsets (\d+)\.\.(\d+) out of order or out of the input \((\d+)\)/.exec(finding);
+  if (m && /^(#comment|#documentType|error \S*doctype)/.test(finding) && Number(m[2]) === Number(m[3]) + 1) return "parse5/3";
+  if (/ (start|end) \d+:\d+ is not offset /.test(finding) && /[\ud800-\udbff]/.test(html)) return "parse5/4";
+  // a bogus comment opened by an astral character starts one past its "<" (the column is right)
+  if (/^comment location holds/.test(finding) && /[\ud800-\udbff]/.test(html)) return "parse5/4";
+  // an attribute whose name opens with an astral character is located from its low surrogate
+  if (/^attribute .* has the location of "\\ud[c-f][0-9a-f]{2}/.test(finding)) return "parse5/4";
+  // a text node opened right after ignored characters (whitespace, NUL, the newline after <pre>) at a
+  // character reference, an astral character or a "<" the input ends in starts where the tokenizer
+  // finished consuming that character
+  const t = /^text (".*") has the location of (".*")$/s.exec(finding); // s: the text can hold U+2028, which "." skips
+  if (t) {
+    const [text, slice] = [JSON.parse(t[1]), JSON.parse(t[2])];
+    // the slice ends with the text after its first character (a character reference's tail, ";",
+    // can be longer than the character it denotes)
+    const rest = text.slice(text.codePointAt(0) > 0xffff ? 2 : 1);
+    if ((slice.length < text.length || html.includes("&")) && slice.endsWith(rest)) return "parse5/5";
+    // the "<" and "/" of a "</" the input ends in are both emitted at the end of the input, so the
+    // text is located there, empty
+    if (slice === "" && /^<\/?$/.test(text) && html.endsWith(text)) return "parse5/5";
+  }
+  return null;
+}
+
+/** The one bug explaining every finding of a list, or null. */
+function allExplained(findings, html) {
+  let id = null;
+  for (const f of findings) {
+    const b = locationBug(f, html);
+    if (!b) return null;
+    id ??= b;
+  }
+  return id;
+}
+
+export const Known = {
+  explains(kind, info) {
+    const html = info.html ?? "";
+    switch (kind) {
+      case "serialize": {
+        const plain = (s) => s.replaceAll("&lt;", "<").replaceAll("&gt;", ">");
+        return plain(info.got) === plain(info.want) ? "parse5/1" : null;
+      }
+      case "location":
+      case "errors":
+        return allExplained(info.findings, html);
+      case "stream-location":
+        // the line recount happens when the tokenizer retreats over the newline, which the chunk
+        // boundaries decide: streamed and one-shot lines (and the columns counted from the line
+        // start) differ after `&...\n`, the offsets agree
+        return /&[a-zA-Z#0-9]*\r?\n|&[a-zA-Z#0-9]*\r/.test(html) && info.got && info.want && info.got.replace(/"(start|end)(Line|Col)":\d+/g, "") === info.want.replace(/"(start|end)(Line|Col)":\d+/g, "") ? "parse5/2" : null;
+      case "plain-text":
+        return info.got === info.want.replace(/(\|     <pre>\n)(?:\|       "([^]*)"\n)?$/, (_, pre, body) => `${pre}|       "\n${body ?? ""}"\n`) ? "parse5/6" : null;
+      case "rewrite-raw": {
+        if (html.includes("</>") && info.got === html.replaceAll("</>", "")) return "parse5/7";
+        // the lost tail is one tag the input ends inside of (its quoted attribute values may hold anything)
