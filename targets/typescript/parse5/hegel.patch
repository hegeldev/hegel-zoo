index 0000000..8e145e0
--- /dev/null
+++ b/hegel/gen.mjs
@@ -0,0 +1,620 @@
+// Hegel zoo: random HTML for parse5, as generator values built from Hegel's combinators and the
+// pure functions that render what they draw.
+//
+// A document is a tree of nodes drawn once - a start tag with its name, its spelling, its
+// attribute records and its closing form; an end tag; a text as a list of words; a comment; a
+// doctype - in one of three shapes: a soup of tokens (whose end tags close the open tags, mostly
+// in order), a structured document (doctype, html/head/body, nested elements through a bounded
+// tower of levels) or either with a few edits applied by position modulo the live length. The
+// soup has the shapes the HTML parsing algorithm has rules for (misnested formatting, tables,
+// selects, templates, foreign content, raw text, comments, doctypes, character references, NULs,
+// line ends), is bounded (about 600 characters) and well formed (no lone surrogates) so it can
+// travel to the oracles as UTF-8. A chunking is a list of cut lengths applied to the text by a
+// pure function, the rest as one chunk. The shapes of the recorded bugs (bugs.toml) are drawn
+// like any other, so the wide properties find the bugs and fail on them (common.mjs `verdict`
+// names the shape); the last section draws each bug's shape region on its own for the narrow
+// properties. The percentages in the comments are the weights as written: the integer draw they
+// rest on leans to its first values, so the rates seen in a collect run are what counts.
+
+import { gs } from "./hegel-zoo.mjs";
+
+// ---------------------------------------------------------------- generator helpers
+
+export const ints = (lo, hi) => gs.integers({ minValue: lo, maxValue: hi });
+export const pick = (xs) => gs.sampledFrom(xs);
+
+/** oneOf with weights: `weighted([45, a], [55, b])` draws a 45 times in 100; shrinks towards the first choice. */
+export function weighted(...choices) {
+  if (choices.length === 1) return choices[0][1];
+  const total = choices.reduce((sum, [w]) => sum + w, 0);
+  return ints(0, total - 1).flatMap((r) => {
+    for (const [w, g] of choices) {
+      if (r < w) return g;
+      r -= w;
+    }
+    throw new Error("unreachable");
+  });
+}
+
+/** True pct percent of the time; shrinks to false (the draw shrinks to 0). */
+export const chance = (pct) => ints(0, 99).map((r) => r >= 100 - pct);
+/** A draw from g pct percent of the time, else undefined (listed first: shrinks to absent). */
+export const maybe = (pct, g) => weighted([100 - pct, gs.just(undefined)], [pct, g]);
+const join = (xs) => xs.join("");
+/** `lo` to `hi` draws of g, concatenated. */
+const words = (g, lo, hi) => gs.arrays(g, { minSize: lo, maxSize: hi }).map(join);
+
+// ---------------------------------------------------------------- vocabularies
+
+export const VOID = ["area", "base", "br", "col", "embed", "hr", "img", "input", "link", "meta", "source", "track", "wbr"];
+export const RAWTEXT = ["script", "style", "xmp", "iframe", "noembed", "noframes"];
+export const RCDATA = ["textarea", "title"];
+export const FORMATTING = ["a", "b", "big", "code", "em", "font", "i", "nobr", "s", "small", "strike", "strong", "tt", "u"];
+export const BLOCKS = [
+  "address", "article", "aside", "blockquote", "center", "details", "dialog", "dir", "div", "dl", "fieldset",
+  "figcaption", "figure", "footer", "header", "hgroup", "main", "menu", "nav", "ol", "p", "search", "section",
+  "summary", "ul", "h1", "h2", "h3", "h4", "h5", "h6", "pre", "listing", "form", "li", "dd", "dt", "button",
+  "applet", "marquee", "object", "span", "label",
+];
+export const TABLE = ["table", "caption", "colgroup", "col", "thead", "tbody", "tfoot", "tr", "td", "th"];
+export const SELECT = ["select", "option", "optgroup", "datalist"];
+export const STRUCT = [
+  "html", "head", "body", "frameset", "frame", "noscript", "template", "image", "ruby", "rb", "rt", "rtc", "rp",
+  "keygen", "menuitem", "param", "sarcasm", "foo", "x-bar", "plaintext", "isindex", "command", "base", "basefont",
+  "bgsound", "meta", "link", "title", "style", "script",
+];
+export const FOREIGN = [
+  "svg", "math", "mi", "mo", "mn", "ms", "mtext", "annotation-xml", "foreignObject", "desc", "g", "path", "title",
+  "malignmark", "mglyph", "altGlyph", "feBlend", "textPath", "clipPath", "linearGradient",
+];
+
+const ALL_TAGS = [...new Set([...VOID, ...RAWTEXT, ...RCDATA, ...FORMATTING, ...BLOCKS, ...TABLE, ...SELECT, ...STRUCT, ...FOREIGN])];
+
+/** The HTML-namespace tags a fragment may be parsed in the context of. */
+export const CONTEXTS = [...new Set([...VOID, ...RAWTEXT, ...RCDATA, ...FORMATTING, ...BLOCKS, ...TABLE, ...SELECT, ...STRUCT])].filter(
+  (t) => !["image", "sarcasm", "x-bar", "foo", "isindex", "command"].includes(t),
+);
+export const FOREIGN_CONTEXTS = ["svg path", "svg svg", "svg desc", "svg foreignObject", "svg title", "math mi", "math math", "math annotation-xml", "math mtext"];
+
+const ATTR_NAMES = [
+  "id", "class", "href", "src", "type", "name", "value", "style", "title", "lang", "dir", "hidden", "data-x", "onclick",
+  "xlink:href", "xlink:title", "xml:lang", "xml:space", "xmlns", "xmlns:xlink", "xmlns:foo", "definitionurl", "definitionURL",
+  "encoding", "viewbox", "viewBox", "attributeName", "ATTRIBUTENAME", "zoomAndPan", "foo", "a", "x:y", "action", "prompt",
+  "FOO", "Data-Y", "id", "class",
+];
+const ATTR_VALUES = [
+  "", "x", "1", "hidden", "text/html", "application/xhtml+xml", "text/plain", "foo bar", "&amp;", "&lt;x", "&notit;", "&not",
+  "&#65;", "&#x41;", "&AMP", "a&b", "&", "&;", ">", "<", "/", "=", "'", "\"", "\u00e9", "\u0000", "\n", "\t", "  ", "\u{1F600}",
+  "-//W3C//DTD HTML 4.01//EN", "http://www.w3.org/2000/svg", "http://www.w3.org/1998/Math/MathML", "http://www.w3.org/1999/xhtml",
+];
+const WORDS = [
+  "foo", "bar", "x", "Hello", "a b", "text", "1", "\n", "  ", "\t", "\f", "\r\n", "\r", "\u0000", "\u00e9", "\u{1F600}", "\u00a0",
+  "&amp;", "&lt;", "&gt;", "&quot;", "&nbsp;", "&notit;", "&not", "&AMP", "&AMP;", "&#65;", "&#x41;", "&#0;", "&#x80;", "&#xD800;",
+  "&#x10FFFF;", "&#x110000;", "&#xD;", "&#13;", "&#x9;", "&foo;", "&", "&#", "&#x", "&#xZ", "<", "</", "</ ", "<3", "< a", ">",
+  "<!", "<!->", "<?x>", "]]>", "--", "-->", "<![CDATA[x]]>", "<![CDATA[", "\ufffd", "\u000b", "\u200b", "\u0001", "\u007f", "\u0085",
+  "&#x2028;", "&#xfdd0;", "&#xfffe;", "&#x1fffe;", "&CounterClockwiseContourIntegral;", "&ThisIsNotAnEntity;", "&am", "&ampx",
+  "x&ampx", "&#128;", "&#160;", "&#x9F;", "&#x00000041;", "&#0000000000065;", "&lt", "&ltx", "&Aacute", "&Aacutex", "&cent",
+];
+const COMMENT_BODIES = ["", "x", " x ", "-", "--", "--!", ">", "->", "-->", "<!--", "--x", "x--", "-x-", "<!", "a\nb", "\u0000", "--!>", "<!-- --"];
+const DOCTYPES = [
+  "<!DOCTYPE html>", "<!doctype html>", "<!DOCTYPE HTML>", "<!DOCTYPE>", "<!DOCTYPE html SYSTEM \"about:legacy-compat\">",
+  "<!DOCTYPE html PUBLIC \"-//W3C//DTD HTML 4.01//EN\" \"http://www.w3.org/TR/html4/strict.dtd\">",
+  "<!DOCTYPE html PUBLIC \"-//W3C//DTD HTML 4.01 Transitional//EN\">",
+  "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Frameset//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-frameset.dtd\">",
+  "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\">", "<!DOCTYPE html PUBLIC \"-//IETF//DTD HTML//EN\">",
+  "<!DOCTYPE html SYSTEM 'http://www.ibm.com/data/dtd/v11/ibmxhtml1-transitional.dtd'>", "<!DOCTYPE html PUBLIC>",
+  "<!DOCTYPE html PUBLIC \"x\">", "<!DOCTYPE html SYSTEM>", "<!DOCTYPE html SYSTEM \"x\" \"y\">", "<!DOCTYPE potato>",
+  "<!DOCTYPE html PUBLIC \"-//W3C//DTD HTML 4.01//EN\">", "<!DOCTYPE html PUBLIC \"-/W3C/DTD HTML 4.0 Transitional/EN\">",
+  "<!DOCTYPE html PUBLIC \"HTML\">", "<!DOCTYPE html PUBLIC \"-//WebTechs//DTD Mozilla HTML 2.0//EN\">", "<!DOCTYPE html\u0000>",
+  "<!DOCTYPE html \"x\">", "<!DOCTYPE html PUBLIC\"x\"\"y\">", "<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 3.2 Final//EN\">",
+];
+
+// ---------------------------------------------------------------- names and their spelling
+
+/** The spelling of a tag or attribute name: as written 18 times in 20, upper case or capitalised once each. */
+export const nameCase = weighted([18, gs.just("as is")], [1, gs.just("upper")], [1, gs.just("capital")]);
+/** A louder spelling for the narrow properties: as written half the time, upper case or capitalised a quarter each. */
+export const loudCase = pick(["as is", "as is", "upper", "capital"]);
+export const withCase = (name, spelling) => (spelling === "upper" ? name.toUpperCase() : spelling === "capital" ? name.replace(/^./, (c) => c.toUpperCase()) : name);
+/** `name` (a generator, or a string) in a drawn spelling. */
+export const cased = (name, spelling = nameCase) => gs.tuples(typeof name === "string" ? gs.just(name) : name, spelling).map(([nm, s]) => withCase(nm, s));
+
+/** A tag name: formatting 14%, blocks 26, table 12, select 6, void 7, raw text and RCDATA 7, structural and odd 14, foreign 14. */
+export const tagName = weighted(
+  [14, pick(FORMATTING)],
+  [26, pick(BLOCKS)],
+  [12, pick(TABLE)],
+  [6, pick(SELECT)],
+  [7, pick(VOID)],
+  [7, pick([...RAWTEXT, ...RCDATA])],
+  [14, pick(STRUCT)],
+  [14, pick(FOREIGN)],
+);
+
+// ---------------------------------------------------------------- tokens: tags, text, comments, doctypes
+
+const UNQUOTED_VALUES = ["x", "1", "a/b", "&amp;", "x>", "&", "foo&bar"];
+const ATTR_SEPARATORS = [" ", " ", " ", "\n", "\t", "/", "  "];
+
+/** How an attribute's value is written: no value (the plain form, 1 in 10), double-quoted 6, unquoted, single-quoted or `name = "value"` 1 each. */
+const attrValue = weighted(
+  [1, gs.just({ kind: "bare" })],
+  [6, gs.record({ kind: gs.just("double"), value: pick(ATTR_VALUES) })],
+  [1, gs.record({ kind: gs.just("unquoted"), value: pick(UNQUOTED_VALUES) })],
+  [1, gs.record({ kind: gs.just("single"), value: pick(ATTR_VALUES) })],
+  [1, gs.record({ kind: gs.just("spaced"), value: pick(ATTR_VALUES) })],
+);
+/** An attribute: the whitespace (or `/`) before it, a name in a spelling, its value form. */
+export const attribute = gs.record({ sep: pick(ATTR_SEPARATORS), name: pick(ATTR_NAMES), spelling: nameCase, value: attrValue });
+function renderAttribute(a) {
+  const name = a.sep + withCase(a.name, a.spelling);
+  const v = a.value;
+  switch (v.kind) {
+    case "bare": return name;
+    case "unquoted": return `${name}=${v.value}`;
+    case "single": return `${name}='${v.value.replaceAll("'", "")}'`;
+    case "spaced": return `${name} = "${v.value.replaceAll('"', "")}"`;
+    default: return `${name}="${v.value.replaceAll('"', "")}"`;
+  }
+}
+
+/** How a start tag ends: `>` 25 times in 30; `/>`, ` />`, ` >`, `<>` or nothing (the input ends in the tag) once each. */
+const startTagEnd = weighted([25, gs.just(">")], [1, gs.just("/>")], [1, gs.just(" />")], [1, gs.just(" >")], [1, gs.just("<>")], [1, gs.just("")]);
+/** How an end tag ends: `>` 16 times in 20; ` x="y">`, `/>`, a space or nothing once each. */
+const endTagEnd = weighted([16, gs.just(">")], [1, gs.just(' x="y">')], [1, gs.just("/>")], [1, gs.just(" ")], [1, gs.just("")]);
+/** A start tag of the name `name` draws: its spelling, no attributes 60% of the time or 1-3, and its end. */
+export const startTagWith = (name) => gs.record({
+  kind: gs.just("start"),
+  name,
+  spelling: nameCase,
+  attrs: weighted([60, gs.just([])], [40, gs.arrays(attribute, { minSize: 1, maxSize: 3 })]),
+  end: startTagEnd,
+});
+export const startTagOf = (name) => startTagWith(gs.just(name));
+export const startTag = startTagWith(tagName);
+/** An end tag of `name`: its spelling and its end. */
+export const endTagOf = (name) => gs.record({ kind: gs.just("end"), name: gs.just(name), spelling: nameCase, end: endTagEnd });
+export function renderTag(t) {
+  const name = withCase(t.name, t.spelling);
