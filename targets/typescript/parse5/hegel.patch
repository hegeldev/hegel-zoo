index 0000000..91c8813
--- /dev/null
+++ b/hegel/dat.mjs
@@ -0,0 +1,80 @@
+// The html5lib-tests .dat tree format, for any parse5 tree adapter: a port of parse5's own
+// test/utils/serialize-to-dat-file-format.ts. Every tree in these tests (parse5's, html5ever's,
+// html5lib's, parse5's through another adapter or after a streaming parse) is compared in it.
+
+const NS_SVG = "http://www.w3.org/2000/svg";
+const NS_MATHML = "http://www.w3.org/1998/Math/MathML";
+const NS_HTML = "http://www.w3.org/1999/xhtml";
+const ATTR_NS = {
+  "http://www.w3.org/1999/xlink": "xlink",
+  "http://www.w3.org/XML/1998/namespace": "xml",
+  "http://www.w3.org/2000/xmlns/": "xmlns",
+};
+
+function indentOf(indent) {
+  return "|".padEnd(indent + 2, " ");
+}
+
+function nsPrefix(element, adapter) {
+  const ns = adapter.getNamespaceURI(element);
+  return ns === NS_SVG ? "svg " : ns === NS_MATHML ? "math " : "";
+}
+
+function nodeList(nodes, indent, adapter) {
+  let out = "";
+  for (let node of nodes) {
+    out += indentOf(indent);
+    if (adapter.isCommentNode(node)) {
+      out += `<!-- ${adapter.getCommentNodeContent(node)} -->\n`;
+    } else if (adapter.isTextNode(node)) {
+      out += `"${adapter.getTextNodeContent(node)}"\n`;
+    } else if (adapter.isDocumentTypeNode(node)) {
+      const publicId = adapter.getDocumentTypeNodePublicId(node);
+      const systemId = adapter.getDocumentTypeNodeSystemId(node);
+      out += `<!DOCTYPE ${adapter.getDocumentTypeNodeName(node) || ""}`;
+      if (publicId || systemId) out += ` "${publicId}" "${systemId}"`;
+      out += ">\n";
+    } else {
+      const tn = adapter.getTagName(node);
+      out += `<${nsPrefix(node, adapter) + tn}>\n`;
+      let childIndent = indent + 2;
+      // the .dat format names the attribute's namespace (xlink, xml, xmlns) before the local name;
+      // parse5's own test serializer prints the token prefix, which differs for a bare `xmlns`
+      // (namespace XMLNS, no prefix) - the namespace is what html5lib-tests and the oracles print
+      const attrs = adapter.getAttrList(node).map((attr) => {
+        let s = indentOf(childIndent);
+        const ns = ATTR_NS[attr.namespace];
+        if (ns) s += `${ns} `;
+        else if (attr.prefix) s += `${attr.prefix} `;
+        return s + `${attr.name}="${attr.value}"\n`;
+      });
+      out += attrs.sort().join("");
+      if (tn === "template" && adapter.getNamespaceURI(node) === NS_HTML) {
+        out += `${indentOf(childIndent)}content\n`;
+        childIndent += 2;
+        node = adapter.getTemplateContent(node);
+      }
+      out += nodeList(adapter.getChildNodes(node), childIndent, adapter);
+    }
+  }
+  return out;
+}
+
+/** The children of `root` (a document or fragment) in the .dat format. */
+export function dat(root, adapter) {
+  return nodeList(adapter.getChildNodes(root), 0, adapter);
+}
+
+/** Walk every node below `root` (template contents included), parents before children. */
+export function* walk(root, adapter) {
+  for (const node of adapter.getChildNodes(root)) {
+    yield node;
+    if (adapter.isElementNode(node)) {
+      const inner =
+        adapter.getTagName(node) === "template" && adapter.getNamespaceURI(node) === NS_HTML
+          ? adapter.getTemplateContent(node)
+          : node;
+      yield* walk(inner, adapter);
+    }
+  }
+}
diff --git a/hegel/gen.mjs b/hegel/gen.mjs
