@@ -0,0 +1,17 @@
+[package]
+name = "hegel-html5ever-oracle"
+version = "0.1.0"
+edition = "2021"
+publish = false
+
+# html5ever (Servo's HTML parser) as the second oracle of the zoo's parse5 tests: reads one JSON
+# request per line on stdin ({"html", "fragment", "scripting"}) and answers with the tree in the
+# html5lib-tests .dat format, one JSON string per line.
+
+[dependencies]
+html5ever = "0.39"
+markup5ever_rcdom = "0.39"
+serde_json = "1"
+
+[profile.release]
+debug = false
diff --git a/hegel/oracle/src/main.rs b/hegel/oracle/src/main.rs
new file mode 100644
index 0000000..e7dc0d4
--- /dev/null
+++ b/hegel/oracle/src/main.rs
@@ -0,0 +1,146 @@
+//! html5ever as an oracle for parse5: one JSON request per stdin line, one JSON answer per line.
+//!
+//! Request: {"html": "...", "fragment": null | "div" | "svg path" | "math mi", "scripting": true}
+//! Answer:  a JSON string holding the tree in the html5lib-tests .dat format (the format parse5's
+//! own test suite prints), or {"error": "..."} when the request cannot be served.
+
+use std::io::{self, BufRead, Write};
+
+use html5ever::serialize::{SerializeOpts, TraversalScope};
+use html5ever::tendril::TendrilSink;
+use html5ever::tree_builder::TreeBuilderOpts;
+use html5ever::{local_name, ns, parse_document, parse_fragment, LocalName, ParseOpts, QualName};
+use markup5ever_rcdom::{Handle, NodeData, RcDom, SerializableHandle};
+use serde_json::Value;
+
+fn pad(indent: usize) -> String {
+    format!("|{}", " ".repeat(indent + 1))
+}
+
+fn serialize(handle: &Handle, indent: usize, out: &mut String) {
+    for child in handle.children.borrow().iter() {
+        match &child.data {
+            NodeData::Document => {}
+            NodeData::Doctype { name, public_id, system_id } => {
+                out.push_str(&format!("{}<!DOCTYPE {}", pad(indent), name));
+                if !public_id.is_empty() || !system_id.is_empty() {
+                    out.push_str(&format!(" \"{}\" \"{}\"", public_id, system_id));
+                }
+                out.push_str(">\n");
+            }
+            NodeData::Text { contents } => {
+                out.push_str(&format!("{}\"{}\"\n", pad(indent), contents.borrow()));
+            }
+            NodeData::Comment { contents } => {
+                out.push_str(&format!("{}<!-- {} -->\n", pad(indent), contents));
+            }
+            NodeData::ProcessingInstruction { .. } => {}
+            NodeData::Element { name, attrs, template_contents, .. } => {
+                let prefix = match name.ns {
+                    ns!(svg) => "svg ",
+                    ns!(mathml) => "math ",
+                    _ => "",
+                };
+                out.push_str(&format!("{}<{}{}>\n", pad(indent), prefix, name.local));
+                let mut lines: Vec<String> = attrs
+                    .borrow()
+                    .iter()
+                    .map(|a| {
+                        let p = match a.name.ns {
+                            ns!(xlink) => "xlink ",
+                            ns!(xml) => "xml ",
+                            ns!(xmlns) => "xmlns ",
+                            _ => "",
+                        };
+                        format!("{}{}{}=\"{}\"\n", pad(indent + 2), p, a.name.local, a.value)
+                    })
+                    .collect();
+                lines.sort();
+                for l in lines {
+                    out.push_str(&l);
+                }
+                let is_template = name.ns == ns!(html) && name.local == local_name!("template");
+                if is_template {
+                    out.push_str(&format!("{}content\n", pad(indent + 2)));
+                    if let Some(tc) = template_contents.borrow().as_ref() {
+                        serialize(tc, indent + 4, out);
+                    }
+                } else {
+                    serialize(child, indent + 2, out);
+                }
+            }
+        }
+    }
+}
+
+/// The spec's serialization algorithm over the children of `root` (html5ever's serializer).
+fn markup(root: &Handle, scripting: bool) -> Result<String, String> {
+    let mut bytes = Vec::new();
+    let opts = SerializeOpts {
+        scripting_enabled: scripting,
+        traversal_scope: TraversalScope::ChildrenOnly(None),
+        create_missing_parent: false,
+    };
+    html5ever::serialize::serialize(&mut bytes, &SerializableHandle::from(root.clone()), opts)
+        .map_err(|e| format!("serialize: {e}"))?;
+    String::from_utf8(bytes).map_err(|e| format!("utf8: {e}"))
+}
+
+fn answer(req: &Value) -> Result<Value, String> {
+    let html = req.get("html").and_then(Value::as_str).ok_or("no html")?;
+    let scripting = req.get("scripting").and_then(Value::as_bool).unwrap_or(true);
+    let mut opts = ParseOpts::default();
+    opts.tree_builder = TreeBuilderOpts { scripting_enabled: scripting, ..Default::default() };
+    let mut tree = String::new();
+    let (dom, root) = match req.get("fragment").and_then(Value::as_str) {
+        None => {
+            let dom = parse_document(RcDom::default(), opts).one(html);
+            let root = dom.document.clone();
+            (dom, root)
+        }
+        Some(ctx) => {
+            let parts: Vec<&str> = ctx.split(' ').collect();
+            let (ns, local) = match parts.as_slice() {
+                [name] => (ns!(html), *name),
+                ["svg", name] => (ns!(svg), *name),
+                ["math", name] => (ns!(mathml), *name),
+                _ => return Err(format!("bad fragment context {ctx}")),
+            };
+            let qname = QualName::new(None, ns, LocalName::from(local));
+            let dom = parse_fragment(RcDom::default(), opts, qname, Vec::new(), false).one(html);
+            // html5ever hangs the fragment's nodes below a synthetic <html> root element.
+            let root = {
+                let doc = dom.document.children.borrow();
+                doc.iter().find(|n| matches!(n.data, NodeData::Element { .. })).ok_or("no root")?.clone()
+            };
+            (dom, root)
+        }
+    };
+    serialize(&root, 0, &mut tree);
+    let errors = dom.errors.borrow().len();
+    Ok(serde_json::json!({ "tree": tree, "html": markup(&root, scripting)?, "errors": errors }))
+}
+
+fn main() {
+    let stdin = io::stdin();
+    let stdout = io::stdout();
+    let mut w = stdout.lock();
+    for line in stdin.lock().lines() {
+        let line = match line {
+            Ok(l) => l,
+            Err(_) => break,
+        };
+        if line.trim().is_empty() {
+            continue;
+        }
+        let reply = match serde_json::from_str::<Value>(&line) {
+            Ok(req) => match answer(&req) {
+                Ok(v) => v,
+                Err(e) => serde_json::json!({ "error": e }),
+            },
+            Err(e) => serde_json::json!({ "error": format!("bad request: {e}") }),
+        };
+        writeln!(w, "{}", reply).unwrap();
+        w.flush().unwrap();
+    }
+}
diff --git a/hegel/oracles.mjs b/hegel/oracles.mjs
new file mode 100644
index 0000000..80e1409
--- /dev/null
+++ b/hegel/oracles.mjs
@@ -0,0 +1,82 @@
+// The two oracles, held open as child processes and spoken to synchronously through a pair of
+// FIFOs (the tests are synchronous Hegel bodies): html5ever (Servo's parser, built from
+// hegel/oracle by the target's setup) and html5lib (Python, in the venv the setup creates).
+//
+// Both answer with the tree in the .dat format; html5ever also returns the spec's serialization
+// of the tree and the number of parse errors. Neither is the spec: html5lib 1.1 (2020) predates
+// <template>, the <search> element, the current ruby and adoption-agency rules; html5ever follows
+// the 2025 <select> parser change that parse5 (and the html5lib-tests parse5 pins) does not have.
+// So the tests take a vote: parse5 agreeing with either oracle is accepted, parse5 alone against
+// two agreeing oracles is a mismatch.
+
+import { execFileSync, spawn } from "node:child_process";
+import { existsSync, mkdtempSync, openSync, readSync, rmSync, writeSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { dirname, join } from "node:path";
+import { fileURLToPath } from "node:url";
+
+const here = dirname(fileURLToPath(import.meta.url));
+
+function startChild(name, cmd, args) {
+  const dir = mkdtempSync(join(tmpdir(), `hegel-parse5-${name}-`));
+  const req = join(dir, "req");
+  const resp = join(dir, "resp");
+  execFileSync("mkfifo", [req, resp]);
+  // the shell opens the FIFOs as the child's stdin and stdout; the parent's opens below rendezvous with them
+  const child = spawn("sh", ["-c", 'exec "$@" <"$HEGEL_REQ" >"$HEGEL_RESP"', "sh", cmd, ...args], {
+    stdio: ["ignore", "ignore", "inherit"],
+    env: { ...process.env, HEGEL_REQ: req, HEGEL_RESP: resp },
+  });
+  child.unref();
+  const wfd = openSync(req, "w");
+  const rfd = openSync(resp, "r");
+  process.on("exit", () => {
+    try { child.kill(); } catch {}
+    try { rmSync(dir, { recursive: true, force: true }); } catch {}
+  });
+  const buf = Buffer.alloc(1 << 16);
+  let pending = "";
+  return {
+    call(obj) {
+      // lone surrogates cannot travel as UTF-8: the generator never makes them, but be safe
+      const line = JSON.stringify(obj).replace(/[\ud800-\udfff]/g, (c) => "\\u" + c.charCodeAt(0).toString(16).padStart(4, "0"));
+      writeSync(wfd, line + "\n");
+      for (;;) {
+        const nl = pending.indexOf("\n");
+        if (nl !== -1) {
+          const answer = pending.slice(0, nl);
+          pending = pending.slice(nl + 1);
+          return JSON.parse(answer);
+        }
+        const got = readSync(rfd, buf, 0, buf.length, null);
+        if (got === 0) throw new Error(`the ${name} oracle went away`);
+        pending += buf.toString("utf8", 0, got);
+      }
+    },
+  };
+}
+
+let ever = null;
+let lib = null;
+
+/** html5ever: `{ tree, html, errors }` for `{ html, fragment, scripting }`. */
+export function html5ever(req) {
+  if (!ever) {
+    const bin = join(here, "oracle", "target", "release", "hegel-html5ever-oracle");
+    if (!existsSync(bin)) throw new Error(`${bin} is missing: run the target's setup (cargo build --release in hegel/oracle)`);
+    ever = startChild("html5ever", bin, []);
+  }
+  const r = ever.call(req);
+  if (r.error) throw new Error(`html5ever: ${r.error}`);
+  return r;
+}
+
+/** html5lib: `{ tree }` or `{ error }` (no opinion) for `{ html, fragment, scripting }`. */
+export function html5lib(req) {
+  if (!lib) {
+    const py = join(here, ".venv", "bin", "python");
+    if (!existsSync(py)) throw new Error(`${py} is missing: run the target's setup (python3 -m venv hegel/.venv; pip install html5lib)`);
+    lib = startChild("html5lib", py, ["-u", join(here, "html5lib-oracle.py")]);
+  }
+  return lib.call(req);
+}
diff --git a/hegel/pins.mjs b/hegel/pins.mjs
new file mode 100644
index 0000000..7005f70
--- /dev/null
+++ b/hegel/pins.mjs
@@ -0,0 +1,117 @@
+// One plain test per bug recorded in the zoo's bugs.toml: each fails while the bug is present.
+
+import assert from "node:assert/strict";
+import { once } from "node:events";
+import { pin } from "./hegel-zoo.mjs";
+import { parse, serialize, defaultTreeAdapter } from "../packages/parse5/dist/index.js";
+import { SAXParser } from "../packages/parse5-sax-parser/dist/index.js";
+import { RewritingStream } from "../packages/parse5-html-rewriting-stream/dist/index.js";
+import { PlainTextConversionStream } from "../packages/parse5-plain-text-conversion-stream/dist/index.js";
+import { adapter as htmlparser2 } from "../packages/parse5-htmlparser2-tree-adapter/dist/index.js";
+import { walk } from "./dat.mjs";
+
+const texts = (html) => [...walk(parse(html, { sourceCodeLocationInfo: true }), defaultTreeAdapter)].filter((n) => n.nodeName === "#text");
+const comments = (html) => [...walk(parse(html, { sourceCodeLocationInfo: true }), defaultTreeAdapter)].filter((n) => n.nodeName === "#comment");
+
+async function rewritten(html, handlers) {
+  const rw = new RewritingStream();
+  let out = "";
+  rw.on("data", (d) => (out += d));
+  for (const [event, emit] of Object.entries(handlers ?? {})) rw.on(event, (t) => rw[emit](t));
+  rw.end(html);
+  await once(rw, "end");
+  return out;
+}
+
+async function saxTokens(html) {
+  const sax = new SAXParser();
+  const out = [];
+  sax.on("startTag", (t) => out.push(`<${t.tagName}>`));
+  sax.on("endTag", (t) => out.push(`</${t.tagName}>`));
+  sax.on("text", (t) => out.push(JSON.stringify(t.text)));
+  sax.resume();
+  sax.end(html);
+  await once(sax, "end");
+  return out.join(" ");
+}
+
+pin("TestHegelPinSerializeEscapesAngleBracketsInAttributes", () => {
+  // parse5/1
+  assert.equal(serialize(parse('<p title="<>">').childNodes[0].childNodes[1]), '<p title="&lt;&gt;"></p>');
+});
+
+pin("TestHegelPinANewlineAfterAnAmpersandIsOneLine", () => {
+  // parse5/2
+  const [text] = texts("a&\nx");
+  assert.equal(text.value, "a&\nx");
+  assert.deepEqual([text.sourceCodeLocation.endLine, text.sourceCodeLocation.endCol], [2, 2]);
+});
+
+pin("TestHegelPinAnUnterminatedCommentEndsAtTheInput", () => {
+  // parse5/3
+  const [comment] = comments("<!--x");
+  assert.equal(comment.sourceCodeLocation.endOffset, 5);
+});
+
+pin("TestHegelPinAnErrorAtAnAstralCharacterPointsAtIt", () => {
+  // parse5/4
+  const errors = [];
+  parse("</\u{1F600}x", { onParseError: (e) => errors.push(e) });
+  const err = errors.find((e) => e.code === "invalid-first-character-of-tag-name");
+  assert.ok(err);
+  assert.equal(err.startCol, 3);
+  assert.equal(err.startOffset, 2);
+});
+
+pin("TestHegelPinACharacterReferenceAfterANulIsLocatedWhole", () => {
+  // parse5/5
+  const [text] = texts("\u0000&gt;");
+  assert.equal(text.value, ">");
+  assert.deepEqual([text.sourceCodeLocation.startOffset, text.sourceCodeLocation.endOffset], [1, 5]);
+});
+
+pin("TestHegelPinPlainTextIsTheTextOfThePre", async () => {
+  // parse5/6
+  const stream = new PlainTextConversionStream();
+  stream.end("x");
+  await once(stream, "finish");
+  const pre = [...walk(stream.document, defaultTreeAdapter)].find((n) => n.nodeName === "pre");
+  assert.equal(pre.childNodes.map((n) => n.value).join(""), "x");
+});
+
+pin("TestHegelPinRewritingStreamKeepsAnEmptyEndTag", async () => {
+  // parse5/7
+  assert.equal(await rewritten("<div></><p>"), "<div></><p>");
+});
+
+pin("TestHegelPinRewritingStreamKeepsAnUnfinishedTag", async () => {
+  // parse5/8
+  assert.equal(await rewritten("<p><b"), "<p><b");
+});
+
+pin("TestHegelPinEmitStartTagKeepsAttributePrefixes", async () => {
+  // parse5/9
+  const out = await rewritten('<svg xmlns:xlink="x" xlink:href="y">', { startTag: "emitStartTag" });
+  assert.equal(out, '<svg xmlns:xlink="x" xlink:href="y">');
+});
+
+pin("TestHegelPinEmitDoctypeOfANamelessDoctype", async () => {
+  // parse5/10
+  assert.equal(await rewritten("<!DOCTYPE>", { doctype: "emitDoctype" }), "<!DOCTYPE>");
+});
+
+pin("TestHegelPinSaxLeavesForeignContentAfterASelfClosingSvg", async () => {
+  // parse5/11
+  assert.equal(await saxTokens("<svg/><style>x<b>"), '<svg> <style> "x<b>"');
+});
+
+pin("TestHegelPinSaxKeepsTheDataStateForAStyleInASelect", async () => {
+  // parse5/12
+  assert.equal(await saxTokens("<select><style>x<b></select>"), '<select> <style> "x" <b> </select>');
+});
+
+pin("TestHegelPinTheHtmlparser2AdapterKeepsAttributeOrder", () => {
+  // parse5/13
+  const html = '<i a="1" 2="x">';
+  assert.equal(serialize(parse(html, { treeAdapter: htmlparser2 }), { treeAdapter: htmlparser2 }), serialize(parse(html)));
+});
diff --git a/hegel/streams.mjs b/hegel/streams.mjs
new file mode 100644
index 0000000..24ae6d8
--- /dev/null
+++ b/hegel/streams.mjs
@@ -0,0 +1,251 @@
+// The streaming packages against parse5's one-shot parse of the same text: the parser stream,
+// the SAX parser (its tokens against the real parser's, its locations tiling the input), the
+// rewriting stream and the plain text conversion stream, all fed the input in random chunks.
+
+import { once } from "node:events";
+import { propertyAsync, count, fail, chance, pick, n } from "./hegel-zoo.mjs";
+import { Parser, defaultTreeAdapter } from "../packages/parse5/dist/index.js";
+import { ParserStream } from "../packages/parse5-parser-stream/dist/index.js";
+import { SAXParser } from "../packages/parse5-sax-parser/dist/index.js";
+import { RewritingStream } from "../packages/parse5-html-rewriting-stream/dist/index.js";
+import { PlainTextConversionStream } from "../packages/parse5-plain-text-conversion-stream/dist/index.js";
+import { dat } from "./dat.mjs";
+import * as gen from "./gen.mjs";
