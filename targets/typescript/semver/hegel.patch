diff --git a/test/hegel-zoo.mjs b/test/hegel-zoo.mjs
new file mode 100644
index 0000000..ef914e1
--- /dev/null
+++ b/test/hegel-zoo.mjs
@@ -0,0 +1,138 @@
+// Hegel zoo: the small harness shared by the zoo's TypeScript/JavaScript targets.
+//
+// `property(name, body)` registers a node:test test that runs `body(tc)` under Hegel with
+// HEGEL_TEST_CASES cases (default 100) and the database at HEGEL_DATABASE. With ZOO_COLLECT=1
+// a `fail()` records the mismatch instead of failing, the case ends there, and the counts of
+// mismatches and of the shapes seen (`count(key)`) are printed at the end of the test, so a
+// property can be run over many cases to see every shape at once. `pin(name, body)` is a
+// plain test for one pinned bug: it must fail while the bug is present and pass once it is
+// fixed (the zoo's judge reads an unexpected pass as "fixed upstream?").
+
+import { readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { test as nodeTest } from "node:test";
+import * as hegel from "@hegeldev/hegel";
+import * as gs from "@hegeldev/hegel/generators";
+
+// The Hegel version these tests were written against (the zoo pins it in zoo.toml and installs
+// it with `npm install --no-save @hegeldev/hegel@<version>`; upstream would add it to
+// devDependencies). Checked at load time so a stray install cannot silently change the engine.
+export const HEGEL_PIN = { "@hegeldev/hegel": "0.4.5" };
+
+{
+  let dir = dirname(fileURLToPath(import.meta.resolve("@hegeldev/hegel")));
+  while (!/[\\/]hegel$/.test(dir) && dir !== dirname(dir)) dir = dirname(dir);
+  const installed = JSON.parse(readFileSync(join(dir, "package.json"), "utf8")).version;
+  if (installed !== HEGEL_PIN["@hegeldev/hegel"]) {
+    throw new Error(`@hegeldev/hegel ${installed} is installed; these tests pin ${HEGEL_PIN["@hegeldev/hegel"]}`);
+  }
+}
+
+export const collecting = !!process.env.ZOO_COLLECT;
+
+class Collected extends Error {}
+
+let msgs = [];
+let stats = new Map();
+
+/** Report a mismatch: an error normally, a recorded line in collect mode. */
+export function fail(message) {
+  if (collecting) {
+    msgs.push(message);
+    throw new Collected(message);
+  }
+  throw new Error(message);
+}
+
+/** Bump a statistic (the shape of a pinned bug, a generator branch). */
+export function count(key) {
+  stats.set(key, (stats.get(key) || 0) + 1);
+}
+
+function settings() {
+  const s = { testCases: Number(process.env.HEGEL_TEST_CASES) || 100 };
+  if (process.env.HEGEL_DATABASE) {
+    s.database = hegel.Database.fromPath(process.env.HEGEL_DATABASE);
+  }
+  return s;
+}
+
+/** A property: `body(tc)` runs under Hegel; a thrown error (or `fail`) is a failure. */
+export function property(name, body) {
+  nodeTest(name, () => {
+    msgs = [];
+    stats = new Map();
+    hegel.test((tc) => {
+      try {
+        body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** A pin: a plain test for one recorded bug. */
+export function pin(name, body) {
+  nodeTest(name, body);
+}
+
+/** An integer in [lo, hi]. */
+export function n(tc, lo, hi) {
+  return tc.draw(gs.integers({ minValue: lo, maxValue: hi }));
+}
+
+/** One of xs. */
+export function pick(tc, xs) {
+  return xs[n(tc, 0, xs.length - 1)];
+}
+
+/** True pct percent of the time. */
+export function chance(tc, pct) {
+  return n(tc, 0, 99) < pct;
+}
+
+/** A string of `len` characters drawn from `alphabet` (an array of strings). */
+export function word(tc, alphabet, lo, hi) {
+  const len = n(tc, lo, hi);
+  let s = "";
+  for (let i = 0; i < len; i++) {
+    s += pick(tc, alphabet);
+  }
+  return s;
+}
+
+/** Structural equality: arrays by position, objects by key set (prototype ignored), else ===. */
+export function same(a, b) {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) {
+      return false;
+    }
+    return a.every((x, i) => same(x, b[i]));
+  }
+  if (a !== null && b !== null && typeof a === "object" && typeof b === "object") {
+    const ka = Object.keys(a).sort();
+    const kb = Object.keys(b).sort();
+    if (ka.length !== kb.length || ka.some((k, i) => k !== kb[i])) {
+      return false;
+    }
+    return ka.every((k) => same(a[k], b[k]));
+  }
+  return a === b;
+}
+
+/** A compact, unambiguous rendering for messages. */
+export function show(x) {
+  return JSON.stringify(x, (k, v) => (v === undefined ? "<undefined>" : v));
+}
diff --git a/test/hegel.test.mjs b/test/hegel.test.mjs
new file mode 100644
index 0000000..348a818
--- /dev/null
+++ b/test/hegel.test.mjs
@@ -0,0 +1,703 @@
+// Hegel zoo: properties of node-semver — version ordering against the SemVer 2.0.0 spec,
+// range algebra checked by membership on candidate versions, and the increment/diff/coerce
+// functions.
+//
+// Run with `node --test --test-reporter=tap test/hegel.test.mjs`; ZOO_COLLECT=1 records
+// mismatches instead of failing (see test/hegel-zoo.mjs).
+
+import semver from "../index.js";
+import { property, pin, fail, count, n, pick, chance, same, show } from "./hegel-zoo.mjs";
+
+// ---------------------------------------------------------------- versions
+
+const WORDS = ["alpha", "beta", "rc", "a", "b", "x", "pre", "a-b", "-", "Z", "0a", "1b"];
+
+function genNum(tc) {
+  const r = n(tc, 0, 99);
+  if (r < 70) return n(tc, 0, 3);
+  if (r < 95) return n(tc, 4, 30);
+  if (r < 98) return n(tc, 31, 100000);
+  return Number.MAX_SAFE_INTEGER - n(tc, 0, 2);
+}
+
+// A numeric identifier as text: no leading zero; 3% of the time beyond 2^53.
+function genNumId(tc) {
+  const r = n(tc, 0, 99);
+  if (r < 3) return pick(tc, ["9007199254740993", "9007199254740992", "18446744073709551616", "18446744073709551615", "99999999999999999999"]);
+  return String(genNum(tc));
+}
+
+function genPreIds(tc) {
+  const len = n(tc, 1, 3);
+  const out = [];
+  for (let i = 0; i < len; i++) {
+    out.push(chance(tc, 55) ? genNumId(tc) : pick(tc, WORDS));
+  }
+  return out;
+}
+
+function genBuild(tc) {
+  const len = n(tc, 1, 2);
+  const out = [];
+  for (let i = 0; i < len; i++) {
+    out.push(pick(tc, ["1", "001", "0", "sha-1", "a", "b", "10", "9"]));
+  }
+  return out;
+}
+
+// A version string in the strict grammar. `near` (optional) biases towards a neighbour of
+// another version so that ties and near-ties are common.
+function genVersion(tc, near) {
+  let M, m, p;
+  if (near && chance(tc, 60)) {
+    M = near.M;
+    m = near.m;
+    p = near.p;
+    const which = n(tc, 0, 3);
+    const step = (x) => Math.min(Number.MAX_SAFE_INTEGER, Math.max(0, x + n(tc, -1, 1)));
+    if (which === 0) M = step(M);
+    else if (which === 1) m = step(m);
+    else if (which === 2) p = step(p);
+  } else {
+    M = genNum(tc);
+    m = genNum(tc);
+    p = genNum(tc);
+  }
+  const pre = chance(tc, 45) ? genPreIds(tc) : [];
+  const build = chance(tc, 15) ? genBuild(tc) : [];
+  let s = `${M}.${m}.${p}`;
+  if (pre.length) s += "-" + pre.join(".");
+  if (build.length) s += "+" + build.join(".");
+  return { M, m, p, pre, build, s };
+}
+
+// ---------------------------------------------------------------- the spec's ordering
+
+const NUMERIC = /^[0-9]+$/;
+
+function compareIds(a, b) {
+  const an = NUMERIC.test(a);
+  const bn = NUMERIC.test(b);
+  if (an && bn) {
+    const x = BigInt(a);
+    const y = BigInt(b);
+    return x < y ? -1 : x > y ? 1 : 0;
+  }
+  if (an) return -1;
+  if (bn) return 1;
+  return a < b ? -1 : a > b ? 1 : 0;
+}
+
+// SemVer 2.0.0 §11: main numerically; a version without prerelease is higher; identifiers
+// left to right, numeric before alphanumeric, numeric numerically, alphanumeric in ASCII
+// order, and a longer identifier list is higher when all shared identifiers are equal.
+function specCompare(a, b) {
+  if (a.M !== b.M) return a.M < b.M ? -1 : 1;
+  if (a.m !== b.m) return a.m < b.m ? -1 : 1;
+  if (a.p !== b.p) return a.p < b.p ? -1 : 1;
+  if (a.pre.length === 0 && b.pre.length === 0) return 0;
+  if (a.pre.length === 0) return 1;
+  if (b.pre.length === 0) return -1;
+  const len = Math.min(a.pre.length, b.pre.length);
+  for (let i = 0; i < len; i++) {
+    const c = compareIds(a.pre[i], b.pre[i]);
+    if (c !== 0) return c;
+  }
+  return a.pre.length === b.pre.length ? 0 : a.pre.length < b.pre.length ? -1 : 1;
+}
+
+// Build metadata: not part of the spec's ordering; semver.compareBuild documents it as a
+// tie-break by the same identifier rules.
+function specCompareBuild(a, b) {
+  const c = specCompare(a, b);
+  if (c !== 0) return c;
+  const len = Math.min(a.build.length, b.build.length);
+  for (let i = 0; i < len; i++) {
+    const d = compareIds(a.build[i], b.build[i]);
+    if (d !== 0) return d;
+  }
+  return a.build.length === b.build.length ? 0 : a.build.length < b.build.length ? -1 : 1;
+}
+
+function bigIds(v) {
+  return v.pre.some((id) => NUMERIC.test(id) && BigInt(id) >= 2n ** 53n);
+}
+
+property("TestHegelOrderingMatchesTheSpec", (tc) => {
+  const a = genVersion(tc);
+  const b = genVersion(tc, a);
+  const c = genVersion(tc, a);
+  tc.note(`${a.s}  ${b.s}  ${c.s}`);
+  const sh = new Set();
+  for (const v of [a, b, c]) {
+    if (bigIds(v)) sh.add("semver/big-numeric-identifier");
+  }
+  // parsing round-trips the components
+  for (const v of [a, b, c]) {
+    const sv = semver.parse(v.s);
+    if (!sv) fail(`parse(${v.s}) is null`);
+    if (sv.major !== v.M || sv.minor !== v.m || sv.patch !== v.p) fail(`parse(${v.s}) main = ${sv.version}`);
+    const pre = sv.prerelease.map(String);
+    if (!same(pre, v.pre) && sh.size === 0) fail(`parse(${v.s}).prerelease = ${show(sv.prerelease)}`);
+    if (!same(sv.build, v.build)) fail(`parse(${v.s}).build = ${show(sv.build)}`);
+    if (semver.valid(v.s) !== sv.version) fail(`valid(${v.s}) = ${semver.valid(v.s)}`);
+    if (semver.clean(v.s) !== sv.version) fail(`clean(${v.s}) = ${semver.clean(v.s)}`); // build metadata is dropped
+    const loose = semver.parse(v.s, { loose: true });
+    if (!loose || loose.version !== sv.version || !same(loose.build, sv.build)) fail(`loose parse of ${v.s} differs: ${loose && loose.version}`);
+    const re = semver.parse(sv.format());
+    if (re.compare(sv) !== 0 || !same(re.prerelease, sv.prerelease)) fail(`re-parse of ${sv.format()} differs`);
+  }
+  const pairs = [[a, b], [b, c], [a, c], [a, a], [b, a]];
+  for (const [x, y] of pairs) {
+    const want = specCompare(x, y);
+    const got = semver.compare(x.s, y.s);
+    if (got !== want) {
+      if (sh.size > 0) {
+        count("mismatch-explained");
+        return;
+      }
+      fail(`compare(${x.s}, ${y.s}) = ${got}, spec says ${want}`);
+    }
+    if (semver.rcompare(x.s, y.s) !== -want) fail(`rcompare(${x.s}, ${y.s}) = ${semver.rcompare(x.s, y.s)}`);
+    if (semver.gt(x.s, y.s) !== (want > 0)) fail(`gt(${x.s}, ${y.s})`);
+    if (semver.lt(x.s, y.s) !== (want < 0)) fail(`lt(${x.s}, ${y.s})`);
+    if (semver.eq(x.s, y.s) !== (want === 0)) fail(`eq(${x.s}, ${y.s})`);
+    if (semver.neq(x.s, y.s) !== (want !== 0)) fail(`neq(${x.s}, ${y.s})`);
+    if (semver.gte(x.s, y.s) !== (want >= 0)) fail(`gte(${x.s}, ${y.s})`);
+    if (semver.lte(x.s, y.s) !== (want <= 0)) fail(`lte(${x.s}, ${y.s})`);
+    for (const op of ["", "=", "==", "!=", ">", ">=", "<", "<="]) {
+      const want2 = op === "" || op === "=" || op === "==" ? want === 0 : op === "!=" ? want !== 0 : op === ">" ? want > 0 : op === ">=" ? want >= 0 : op === "<" ? want < 0 : want <= 0;
+      if (semver.cmp(x.s, op, y.s) !== want2) fail(`cmp(${x.s}, ${op}, ${y.s})`);
+    }
+    const wantBuild = specCompareBuild(x, y);
+    const gotBuild = semver.compareBuild(x.s, y.s);
+    if (gotBuild !== wantBuild) {
+      if ([...x.build, ...y.build].some((id) => /^0\d/.test(id))) {
+        sh.add("semver/build-leading-zero"); // semver/6
+      } else {
+        fail(`compareBuild(${x.s}, ${y.s}) = ${gotBuild}, wanted ${wantBuild}`);
+      }
+    }
+    if (semver.compareLoose(x.s, y.s) !== want) fail(`compareLoose(${x.s}, ${y.s})`);
+    // satisfies an exact comparator iff equal
+    if (semver.satisfies(x.s, "=" + y.s.split("+")[0]) !== (want === 0)) fail(`satisfies(${x.s}, =${y.s})`);
+  }
+  const sorted = semver.sort([a.s, b.s, c.s]);
+  for (let i = 1; i < 3; i++) {
+    if (semver.compare(sorted[i - 1], sorted[i]) > 0) fail(`sort gave ${show(sorted)}`);
+  }
+  const rsorted = semver.rsort([a.s, b.s, c.s]);
+  for (let i = 1; i < 3; i++) {
+    if (semver.compare(rsorted[i - 1], rsorted[i]) < 0) fail(`rsort gave ${show(rsorted)}`);
+  }
+  for (const k of sh) count(k);
+  count(sh.size === 0 ? "clean" : "clean-despite-shape");
+});
+
+// ---------------------------------------------------------------- ranges
+
+const X = ["x", "X", "*"];
+
+// A partial version: M | M.m | M.m.p[-pre][+build], with x-parts only at the end.
+function genPartial(tc, allowPre = true) {
+  const r = n(tc, 0, 99);
+  const M = genNum(tc);
+  if (r < 8) return pick(tc, X);
+  if (r < 20) return `${M}`;
+  if (r < 28) return `${M}.${pick(tc, X)}`;
+  const m = genNum(tc);
+  if (r < 42) return `${M}.${m}`;
+  if (r < 50) return `${M}.${m}.${pick(tc, X)}`;
+  if (r < 54) return `${M}.${pick(tc, X)}.${pick(tc, X)}`;
+  let s = `${M}.${m}.${genNum(tc)}`;
+  if (allowPre && chance(tc, 35)) s += "-" + genPreIds(tc).join(".");
+  if (chance(tc, 8)) s += "+" + genBuild(tc).join(".");
+  return s;
+}
+
+function genSimple(tc) {
+  const r = n(tc, 0, 99);
+  const sp = chance(tc, 10) ? " " : "";
+  if (r < 22) return genPartial(tc);
+  if (r < 50) return pick(tc, ["<", "<=", ">", ">=", "="]) + sp + genPartial(tc);
+  if (r < 65) return pick(tc, ["~", "~>"]) + sp + genPartial(tc);
+  if (r < 80) return "^" + sp + genPartial(tc);
+  return (chance(tc, 50) ? "v" : "=v") + genPartial(tc);
+}
+
+function genHyphen(tc) {
+  return `${genPartial(tc)} - ${genPartial(tc)}`;
+}
+
+function genRange(tc) {
+  const alts = [];
+  const na = chance(tc, 70) ? 1 : n(tc, 2, 3);
+  for (let i = 0; i < na; i++) {
+    if (chance(tc, 15)) {
+      alts.push(genHyphen(tc));
+      continue;
+    }
+    const nc = chance(tc, 55) ? 1 : n(tc, 2, 3);
+    const comps = [];
+    for (let j = 0; j < nc; j++) comps.push(genSimple(tc));
+    alts.push(comps.join(chance(tc, 10) ? "  " : " "));
+  }
+  if (chance(tc, 3)) return "";
+  return alts.join(chance(tc, 10) ? "||" : " || ");
+}
+
+function genRangeOptions(tc) {
+  const o = {};
+  if (chance(tc, 35)) o.includePrerelease = true;
+  if (chance(tc, 15)) o.loose = true;
+  return o;
+}
+
+// The candidate versions for two ranges: every comparator bound of both, one step in each
+// direction, with and without a prerelease, plus a few random versions.
+function candidates(tc, ranges, o) {
+  const set = new Map();
+  const add = (s) => {
+    const v = semver.parse(s);
+    if (v && !set.has(v.version)) set.set(v.version, v);
+  };
+  for (const r of ranges) {
+    for (const comps of r.set) {
+      for (const c of comps) {
+        if (c.semver === semver.Comparator.ANY) continue;
+        const v = c.semver;
+        const main = `${v.major}.${v.minor}.${v.patch}`;
+        add(v.version);
+        add(main);
+        add(`${main}-0`);
+        add(`${main}-alpha`);
+        add(`${main}-alpha.1`);
+        add(`${main}-zz`);
+        add(`${v.major}.${v.minor}.${v.patch + 1}`);
+        add(`${v.major}.${v.minor}.${v.patch + 1}-0`);
+        add(`${v.major}.${v.minor + 1}.0`);
+        add(`${v.major}.${v.minor + 1}.0-0`);
+        add(`${v.major + 1}.0.0`);
+        add(`${v.major + 1}.0.0-0`);
+        if (v.patch > 0) add(`${v.major}.${v.minor}.${v.patch - 1}`);
+        if (v.minor > 0) add(`${v.major}.${v.minor - 1}.0`);
+        if (v.major > 0) add(`${v.major - 1}.0.0`);
+        if (v.prerelease.length) {
+          add(`${main}-${v.prerelease.join(".")}.0`);
+          add(`${main}-${v.prerelease.join(".")}0`);
+        }
+      }
+    }
+  }
+  add("0.0.0");
+  add("0.0.0-0");
+  for (let i = 0; i < 4; i++) add(genVersion(tc).s.split("+")[0]);
+  return [...set.values()];
+}
+
+function sat(v, r, o) {
+  return r.test(v);
+}
+
+property("TestHegelRangesAgreeOnMembership", (tc) => {
+  const o = genRangeOptions(tc);
+  const ra = genRange(tc);
+  const rb = genRange(tc);
+  tc.note(`a = ${show(ra)}  b = ${show(rb)}  ${show(o)}`);
+  try {
+    rangesAgree(tc, ra, rb, o);
+  } catch (e) {
+    // semver/12: a component at MAX_SAFE_INTEGER makes the desugaring (or minVersion's +1)
+    // build a version the parser rejects, and the error escapes
+    if (/900719925474099/.test(ra + rb) && /Invalid (major|minor|patch) version/.test(e.message)) {
+      count("semver/max-safe-desugar");
+      return;
+    }
+    throw e;
+  }
+});
+
+function rangesAgree(tc, ra, rb, o) {
+  const a = new semver.Range(ra, o);
+  const b = new semver.Range(rb, o);
+  const C = candidates(tc, [a, b], o);
+  const inA = C.filter((v) => sat(v, a, o));
+  const inB = C.filter((v) => sat(v, b, o));
+  const notB = new Set(C.filter((v) => !sat(v, b, o)).map((v) => v.version));
+  tc.note(`candidates ${C.length}, in a ${inA.length}, in b ${inB.length}`);
+  const sh = new Set();
+  const opts = o;
+
+  // satisfies agrees with Range.test and with the string form
+  for (const v of C) {
+    if (semver.satisfies(v.version, ra, o) !== sat(v, a, o)) fail(`satisfies(${v.version}, ${show(ra)}) disagrees with Range.test`);
+    if (semver.satisfies(v.version, a.range || "*", o) !== sat(v, a, o)) fail(`${v.version}: the formatted range ${show(a.range)} differs from ${show(ra)}`);
+    // includePrerelease only widens
+    if (!o.includePrerelease && sat(v, a, o) && !semver.satisfies(v.version, ra, { ...o, includePrerelease: true })) {
+      fail(`${v.version} satisfies ${show(ra)} but not with includePrerelease`);
+    }
+  }
+  // validRange is a normal form
+  const va = semver.validRange(ra, o);
+  if (va === null) fail(`validRange(${show(ra)}) is null`);
+  if (semver.validRange(va, o) !== va) fail(`validRange is not idempotent: ${show(ra)} -> ${show(va)} -> ${show(semver.validRange(va, o))}`);
+  // toComparators rejoined is the same range
+  const tcs = semver.toComparators(ra, o).map((cs) => cs.join(" ")).join(" || ");
+  for (const v of C) {
+    if (semver.satisfies(v.version, tcs, o) !== sat(v, a, o)) fail(`${v.version}: toComparators ${show(tcs)} differs from ${show(ra)}`);
+  }
+  // subset: sound both ways on the candidates
+  // a set with an exact prerelease comparator next to other bounds
+  const eqPre = a.set.some((comps) => comps.length > 1 && comps.some((c) => c.operator === "" && c.semver !== semver.Comparator.ANY && c.semver.prerelease.length));
+  const sub = semver.subset(ra, rb, o);
+  const witness = inA.find((v) => notB.has(v.version));
+  if (sub && witness) {
+    if (eqPre && !o.includePrerelease) {
+      sh.add("semver/subset-prerelease-eq"); // semver/13
+    } else {
+      fail(`subset(${show(ra)}, ${show(rb)}) is true but ${witness.version} satisfies a and not b`);
+    }
+  }
+  if (!semver.subset(ra, ra, o)) fail(`subset(${show(ra)}, itself) is false`);
+  if (!sub && !witness && inA.length > 0) count("subset-false-unwitnessed");
+  // intersects: sound both ways, symmetric
+  const inter = semver.intersects(ra, rb, o);
+  const both = inA.find((v) => sat(v, b, o));
+  const eqPreB = b.set.some((comps) => comps.length > 1 && comps.some((c) => c.operator === "" && c.semver !== semver.Comparator.ANY && c.semver.prerelease.length));
+  if (inter !== semver.intersects(rb, ra, o)) {
+    sh.add("semver/intersects-asymmetric"); // semver/7
+  } else if (!inter && both) {
+    if ((eqPre || eqPreB) && !o.includePrerelease) sh.add("semver/subset-prerelease-eq"); // semver/13, in intersects
+    else fail(`intersects(${show(ra)}, ${show(rb)}) is false but ${both.version} satisfies both`);
+  } else if (inter && !both) {
+    count("intersects-true-unwitnessed");
+  }
+  if (inA.length > 0 && !semver.intersects(ra, ra, o)) {
+    if (eqPre && !o.includePrerelease) sh.add("semver/subset-prerelease-eq");
+    else fail(`intersects(${show(ra)}, itself) is false though ${inA[0].version} satisfies it`);
+  }
+  // minVersion
+  // a set of the range with no satisfying candidate of its own (an unsatisfiable alternative)
+  const setStr = (comps) => comps.map((c) => c.value).join(" ") || "*";
+  const deadSet = a.set.some((comps) => !C.some((v) => semver.satisfies(v.version, setStr(comps), o)));
+  // a set with two lower bounds or two upper bounds (an exact comparator counts as both)
+  const multiBounds = a.set.some((comps) => {
+    const ops = comps.filter((c) => c.semver !== semver.Comparator.ANY).map((c) => c.operator);
+    const lower = ops.filter((op) => op === ">" || op === ">=" || op === "").length;
+    const upper = ops.filter((op) => op === "<" || op === "<=" || op === "").length;
+    return lower >= 2 || upper >= 2;
+  });
+  // a set with two comparators on the same version (>=1.1.2 <=1.1.2)
+  const equalBounds = a.set.some((comps) => {
+    const vs = comps.filter((c) => c.semver !== semver.Comparator.ANY).map((c) => c.semver.version);
+    return new Set(vs).size < vs.length;
+  });
+  const min = semver.minVersion(ra, o);
+  if (min === null) {
+    if (inA.length > 0) {
+      if (deadSet) {
+        sh.add("semver/minversion-null-alternative"); // semver/9
+      } else {
+        fail(`minVersion(${show(ra)}) is null but ${inA[0].version} satisfies it`);
+      }
+    }
+  } else {
+    if (!semver.satisfies(min, ra, o)) fail(`minVersion(${show(ra)}) = ${min.version} does not satisfy it`);
+    const lower = inA.find((v) => semver.lt(v, min));
+    if (lower) {
+      if (o.includePrerelease && lower.prerelease.length) {
+        sh.add("semver/minversion-prerelease"); // semver/4
+      } else {
+        fail(`minVersion(${show(ra)}) = ${min.version} but ${lower.version} satisfies it and is lower`);
+      }
+    }
+  }
+  // maxSatisfying / minSatisfying
+  const versions = C.map((v) => v.version);
+  const max = semver.maxSatisfying(versions, ra, o);
+  const wantMax = inA.length ? inA.reduce((x, y) => (semver.gt(y, x) ? y : x)).version : null;
+  if (max !== wantMax) fail(`maxSatisfying = ${max}, wanted ${wantMax} for ${show(ra)}`);
+  const mn = semver.minSatisfying(versions, ra, o);
+  const wantMin = inA.length ? inA.reduce((x, y) => (semver.lt(y, x) ? y : x)).version : null;
+  if (mn !== wantMin) fail(`minSatisfying = ${mn}, wanted ${wantMin} for ${show(ra)}`);
+  // gtr / ltr
+  for (const v of C) {
+    const g = semver.gtr(v.version, ra, o);
+    const l = semver.ltr(v.version, ra, o);
+    const isIn = sat(v, a, o);
+    if (isIn && (g || l)) fail(`${v.version} satisfies ${show(ra)} but gtr=${g} ltr=${l}`);
+    if (!isIn && v.prerelease.length && !o.includePrerelease && (g || l)) {
+      // semver/1: outside() treats a prerelease excluded by the prerelease rule as beyond the range
+      sh.add("semver/outside-prerelease");
+      continue;
+    }
+    if (g) {
+      const w = inA.find((x) => !semver.gt(v, x));
+      if (w && multiBounds) sh.add("semver/outside-multiple-bounds"); // semver/8
+      else if (w && equalBounds) sh.add("semver/outside-equal-bounds"); // semver/14
+      else if (w) fail(`gtr(${v.version}, ${show(ra)}) but ${w.version} satisfies it and is not lower`);
+    }
+    if (l) {
+      const w = inA.find((x) => !semver.lt(v, x));
+      if (w && multiBounds) sh.add("semver/outside-multiple-bounds");
+      else if (w && equalBounds) sh.add("semver/outside-equal-bounds");
+      else if (w) fail(`ltr(${v.version}, ${show(ra)}) but ${w.version} satisfies it and is not higher`);
+    }
+  }
+  // simplifyRange keeps the membership of the given versions
+  const copy = versions.slice();
+  const simp = semver.simplifyRange(copy, ra, o);
+  const simpStr = typeof simp === "string" ? simp : simp.range || "*";
+  if (semver.validRange(simpStr, o) === null) fail(`simplifyRange gave an invalid range ${show(simpStr)}`);
+  if (inA.length === 0 && simpStr === "") {
+    sh.add("semver/simplify-empty");
+  } else for (const v of C) {
+    if (semver.satisfies(v.version, simpStr, o) !== sat(v, a, o)) {
+      if (v.prerelease.length) {
+        sh.add("semver/simplify-prerelease"); // semver/11
+      } else {
+        fail(`${v.version}: simplifyRange ${show(simpStr)} differs from ${show(ra)}`);
+      }
+    }
+  }
+  if (!same(copy, versions)) sh.add("semver/simplify-sorts-input");
+  for (const k of sh) count(k);
+  count(sh.size === 0 ? "clean" : "clean-despite-shape");
+}
+
+// ---------------------------------------------------------------- inc, diff, coerce, truncate
+
+const RELEASES = ["major", "premajor", "minor", "preminor", "patch", "prepatch", "prerelease"];
+
+property("TestHegelIncrementsGoUp", (tc) => {
+  const v = genVersion(tc);
+  const release = pick(tc, RELEASES);
+  const identifier = chance(tc, 50) ? undefined : pick(tc, ["alpha", "beta", "rc.1", "0", "1", "a-b"]);
+  const base = pick(tc, [undefined, undefined, "0", "1", false]);
+  tc.note(`${v.s} ${release} ${identifier} ${base}`);
+  const sh = new Set();
+  if (bigIds(v)) sh.add("semver/big-numeric-identifier");
+  const r = semver.inc(v.s, release, undefined, identifier, base);
+  const expectNull = release.startsWith("pre") && !identifier && base === false;
+  if (r === null) {
+    if (expectNull) {
+      count("null-by-contract");
+    } else if (release === "prerelease" && v.pre.length && base === false && identifier === v.pre.join(".")) {
+      count("null-identifier-exists");
+    } else {
+      fail(`inc(${v.s}, ${release}, ${identifier}, ${base}) is null`);
+    }
+    return;
+  }
+  const nearMax = Math.max(v.M, v.m, v.p) >= Number.MAX_SAFE_INTEGER - 2;
+  if (semver.valid(r) !== r) {
+    if (nearMax) {
+      count("semver/inc-overflow"); // semver/10
+      return;
+    }
+    fail(`inc(${v.s}, ${release}) = ${r} is not a valid version`);
+  }
+  // an identifier that is not a prefix of the current prerelease restarts it (documented)
+  const switched = identifier && v.pre.length && !identifier.split(".").every((id, i) => v.pre[i] === id);
+  if (!semver.gt(r, v.s)) {
+    if (sh.size) {
+      count("mismatch-explained");
+      return;
+    }
+    if (switched) {
+      count("limit/identifier-switch");
+      return;
+    }
+    fail(`inc(${v.s}, ${release}, ${identifier}, ${base}) = ${r} is not higher`);
+  }
+  const rObj = semver.inc(semver.parse(v.s), release, undefined, identifier, base);
+  if (rObj !== r) fail(`inc on a SemVer gives ${rObj}, on the string ${r}`);
+  if (release.startsWith("pre") && !semver.prerelease(r)) fail(`inc(${v.s}, ${release}) = ${r} is not a prerelease`);
+  if (!release.startsWith("pre") && semver.prerelease(r)) fail(`inc(${v.s}, ${release}) = ${r} is a prerelease`);
+  if (identifier && release.startsWith("pre") && !semver.prerelease(r).join(".").startsWith(identifier)) fail(`inc(${v.s}, ${release}, ${identifier}) = ${r} does not carry the identifier`);
+  // diff
+  const d = semver.diff(v.s, r);
+  count(`diff-${release}-${d}`);
+  if (!RELEASES.includes(d)) fail(`diff(${v.s}, ${r}) = ${d}`);
+  if (semver.diff(r, v.s) !== d) fail(`diff is not symmetric for ${v.s} / ${r}`);
+  if (semver.diff(v.s, v.s) !== null) fail(`diff(${v.s}, itself) = ${semver.diff(v.s, v.s)}`);
+  const w = genVersion(tc, v);
+  const dw = semver.diff(v.s, w.s);
+  const cmpVW = specCompare(v, w);
+  if ((dw === null) !== (cmpVW === 0)) {
+    if (sh.size || bigIds(w)) {
+      count("mismatch-explained");
+    } else {
+      fail(`diff(${v.s}, ${w.s}) = ${dw} but compare = ${cmpVW}`);
+    }
+  } else if (dw !== null && v.pre.length === 0 && w.pre.length === 0) {
+    const want = v.M !== w.M ? "major" : v.m !== w.m ? "minor" : "patch";
+    if (dw !== want) fail(`diff(${v.s}, ${w.s}) = ${dw}, wanted ${want}`);
+  } else if (dw !== null) {
+    const hi = cmpVW > 0 ? v : w;
+    if (hi.pre.length && !dw.startsWith("pre")) fail(`diff(${v.s}, ${w.s}) = ${dw} though the higher version is a prerelease`);
+  }
+  // truncate
+  for (const t of RELEASES) {
+    const tr = semver.truncate(v.s, t);
+    if (tr === null) fail(`truncate(${v.s}, ${t}) is null`);
+    if (t.startsWith("pre")) {
+      if (tr !== semver.parse(v.s).version) fail(`truncate(${v.s}, ${t}) = ${tr}`);
+    } else {
+      const want = t === "major" ? `${v.M}.0.0` : t === "minor" ? `${v.M}.${v.m}.0` : `${v.M}.${v.m}.${v.p}`;
+      if (tr !== want) fail(`truncate(${v.s}, ${t}) = ${tr}, wanted ${want}`);
+    }
+  }
+  // coerce
+  const main = `${v.M}.${v.m}.${v.p}`;
+  const shortMain = v.M > 9999999999999999 ? null : main;
+  if (shortMain) {
+    const c1 = semver.coerce(v.s);
+    if (!c1 || c1.version !== main) fail(`coerce(${v.s}) = ${c1 && c1.version}`);
+    const c2 = semver.coerce(v.s, { includePrerelease: true });
+    if (!c2 || c2.raw !== v.s) {
+      if (sh.size) count("mismatch-explained");
+      else fail(`coerce(${v.s}, includePrerelease) = ${c2 && c2.raw}`);
+    }
+    const c3 = semver.coerce(`${pick(tc, ["v", "release-", "=", " "])}${v.s}${pick(tc, ["", " ", "-x", "!"])}`);
+    if (!c3 || c3.version !== main) fail(`coerce of ${v.s} in text = ${c3 && c3.version}`);
+    const c4 = semver.coerce(`${n(tc, 0, 99)}.${main}`, { rtl: true });
+    if (!c4 || c4.version !== main) fail(`coerce(N.${main}, rtl) = ${c4 && c4.version}`);
+  }
+  count(sh.size === 0 ? "clean" : "clean-despite-shape");
+});
+
+// ---------------------------------------------------------------- pins
+
+pin("TestHegelPinGtrAndLtrBothTrue", () => {
+  // semver/1: a prerelease inside a range's numeric span (excluded only by the prerelease
+  // rule) is reported both greater than and less than the range.
+  const g = semver.gtr("1.5.0-alpha", "^1.0.0");
+  const l = semver.ltr("1.5.0-alpha", "^1.0.0");
+  if (g && l) {
+    throw new Error(`gtr and ltr are both true for 1.5.0-alpha against ^1.0.0`);
+  }
+});
+
+pin("TestHegelPinBigNumericIdentifiersCompareEqual", () => {
+  // semver/2: numeric prerelease identifiers are compared as doubles, so identifiers beyond
+  // 2^53 that differ compare equal.
+  const c = semver.compare("1.0.0-9007199254740993", "1.0.0-9007199254740992");
+  if (c !== 1) {
+    throw new Error(`compare(1.0.0-9007199254740993, 1.0.0-9007199254740992) = ${c}`);
+  }
+});
+
+pin("TestHegelPinMinVersionIgnoresIncludePrerelease", () => {
+  // semver/4: minVersion tries 0.0.0 before 0.0.0-0, so with includePrerelease a range that
+  // accepts both gets the higher one.
+  const m = semver.minVersion("*", { includePrerelease: true });
+  if (m.version !== "0.0.0-0") {
+    throw new Error(`minVersion(*, includePrerelease) = ${m.version} though 0.0.0-0 satisfies it`);
+  }
+});
+
+pin("TestHegelPinSimplifyRangeOfNothingIsEverything", () => {
+  // semver/5: with no matching version simplifyRange returns "", which as a range means any
+  // version.
+  const r = semver.simplifyRange(["1.0.0", "2.0.0"], ">3.0.0 <2.0.0");
+  if (r === "" || semver.satisfies("1.0.0", String(r))) {
+    throw new Error(`simplifyRange gave ${show(String(r))}, which 1.0.0 satisfies`);
+  }
+});
+
+pin("TestHegelPinCompareBuildStopsAtLeadingZeros", () => {
+  // semver/6: compareBuild returns 0 as soon as two numeric identifiers are equal in value
+  // but differ in text (001 vs 1), instead of moving on to the next identifier.
+  const c = semver.compareBuild("1.0.0+001", "1.0.0+1.1");
+  if (c !== -1) {
+    throw new Error(`compareBuild(1.0.0+001, 1.0.0+1.1) = ${c} though compareBuild(1.0.0+1, 1.0.0+1.1) = ${semver.compareBuild("1.0.0+1", "1.0.0+1.1")}`);
+  }
+});
+
+pin("TestHegelPinIntersectsIsAsymmetricForPrereleases", () => {
+  // semver/7: * does not satisfy-intersect an exact prerelease comparator (2.0.0-alpha does not
+  // satisfy *), but intersects says true in one direction and false in the other.
+  const ab = semver.intersects("*", "2.0.0-alpha");
+  const ba = semver.intersects("2.0.0-alpha", "*");
+  if (ab !== ba || ab) {
+    throw new Error(`intersects(*, 2.0.0-alpha) = ${ab}, intersects(2.0.0-alpha, *) = ${ba}, satisfies = ${semver.satisfies("2.0.0-alpha", "*")}`);
+  }
+});
+
+pin("TestHegelPinGtrTakesTheLowestLowerBound", () => {
+  // semver/8: outside() keeps the comparator with the lowest version as the range's lower
+  // edge, so with two lower bounds a version between them is "greater than the range".
+  if (semver.gtr("3.0.0", "^3.0.0 >=3.1.2")) {
+    throw new Error("gtr(3.0.0, ^3.0.0 >=3.1.2) is true though 3.1.2 satisfies the range");
+  }
+});
+
+pin("TestHegelPinMinVersionNullFromAnUnsatisfiableAlternative", () => {
+  // semver/9: the lowest of the alternatives' lower bounds comes from an unsatisfiable
+  // alternative, does not satisfy the range, and minVersion gives up with null.
+  const m = semver.minVersion(">2.0.0 <1.0.0 || >=3.0.0");
+  if (!m || m.version !== "3.0.0") {
+    throw new Error(`minVersion(>2.0.0 <1.0.0 || >=3.0.0) = ${m && m.version}`);
+  }
+});
+
+pin("TestHegelPinIncPastMaxSafeIntegerIsInvalid", () => {
+  // semver/10: inc bumps a component past MAX_SAFE_INTEGER and returns a version string that
+  // parse rejects, instead of null.
+  const r = semver.inc("9007199254740991.0.0", "major");
+  if (r !== null && semver.valid(r) === null) {
+    throw new Error(`inc(9007199254740991.0.0, major) = ${r}, which valid() rejects`);
+  }
+});
+
+pin("TestHegelPinSimplifyRangeHyphenAdmitsPrereleases", () => {
+  // semver/11: with includePrerelease a hyphen range means >=a-0 <b+1-0, so the hyphen range
+  // simplifyRange builds from the matching versions admits a given prerelease the original
+  // did not.
+  const o = { includePrerelease: true };
+  const vs = ["1.0.0-0", "1.0.0", "1.0.1", "2.0.0"];
+  const r = String(semver.simplifyRange(vs, ">=1.0.0 <=1.0.1", o));
+  if (semver.satisfies("1.0.0-0", r, o) !== semver.satisfies("1.0.0-0", ">=1.0.0 <=1.0.1", o)) {
+    throw new Error(`simplifyRange gave ${r}, which 1.0.0-0 satisfies`);
+  }
+});
+
+pin("TestHegelPinRangeAtMaxSafeIntegerThrows", () => {
+  // semver/12: desugaring adds one to a component, so a range at MAX_SAFE_INTEGER throws
+  // "Invalid minor version" and validRange rejects it, though its versions are valid.
+  const r = semver.validRange("~1.9007199254740991");
+  if (r === null) {
+    throw new Error("validRange(~1.9007199254740991) is null; 1.9007199254740991.0 is a valid version");
+  }
+});
+
+pin("TestHegelPinSubsetTakesAnExactPrereleaseSetAsEmpty", () => {
+  // semver/13: subset and intersects check the = comparator against the >= bound alone,
+  // where the prerelease rule fails it, and conclude the set is empty: a subset of
+  // everything, intersecting nothing (not even itself).
+  const r = "3.0.3-alpha >=3.0.0";
+  if (!semver.satisfies("3.0.3-alpha", r)) {
+    throw new Error("3.0.3-alpha does not satisfy 3.0.3-alpha >=3.0.0 (the pin's premise)");
+  }
+  if (semver.subset(r, ">=30.0.0") || !semver.intersects(r, r)) {
+    throw new Error(`subset(${r}, >=30.0.0) = ${semver.subset(r, ">=30.0.0")}, intersects(${r}, itself) = ${semver.intersects(r, r)}`);
+  }
+});
+
+pin("TestHegelPinLtrWithEqualBounds", () => {
+  // semver/14: with both bounds on one version (1.1.2 - 1.1.2) outside() keeps the first
+  // comparator as both edges and reports a higher version as lower than the range.
+  if (semver.ltr("1.1.3", ">=1.1.2 <=1.1.2")) {
+    throw new Error("ltr(1.1.3, >=1.1.2 <=1.1.2) is true");
+  }
+});
+
+pin("TestHegelPinSimplifyRangeSortsItsInput", () => {
+  // semver/3: simplifyRange sorts the caller's array of versions in place.
+  const vs = ["2.0.0", "1.0.0"];
+  semver.simplifyRange(vs, "*");
+  if (vs[0] !== "2.0.0") {
+    throw new Error(`the input array is now ${show(vs)}`);
+  }
+});
