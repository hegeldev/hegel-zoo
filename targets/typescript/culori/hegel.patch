+      } else if (m === "percent-hue" && spec && spec.chans.some((k) => k.includes("hue"))) {
+        const i = spec.chans.findIndex((k) => k.includes("hue"));
+        toks[i] = { text: "50%" };
+        text = `${name}(${toks.map((t) => t.text).join(" ")})`;
+      } else if (m === "hue-elsewhere") {
+        const i = spec ? spec.chans.findIndex((k) => !k.includes("hue")) : 1;
+        toks[i] = { text: "50deg" };
+        text = `${name}(${profile ? profile + " " : ""}${toks.map((t) => t.text).join(" ")})`;
+      } else if (m === "two") {
+        text = `${name}(${profile ? profile + " " : ""}${toks[0].text} ${toks[1].text})`;
+      } else if (m === "five") {
+        text = `${name}(${profile ? profile + " " : ""}${toks.map((t) => t.text).join(" ")} 1 1)`;
