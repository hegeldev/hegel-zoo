@@ -0,0 +1,151 @@
+// The zoo's oracles for culori: colorjs.io 0.7.1 (a second implementation of the same colour
+// spaces, difference formulas and WCAG functions) and the CSS Color Level 4 sample conversion
+// code for the predefined RGB spaces (colorjs 0.7.1 has moved rec2020 to a different transfer
+// function, so that space is checked against the specification directly).
+
+import Color from "../.hegel/node_modules/colorjs.io/src/index.js";
+
+export { Color };
+
+// culori mode -> [colorjs space id, culori channel -> [colorjs coordinate index, scale], tolerance]
+// The tolerance is absolute, on the culori side's scale, after both were checked to agree to it on
+// 2000 in-gamut sRGB colours (see README: the two libraries differ in matrix precision (lab: 4e-5)
+// and in the Okhsl/Okhsv approximation of the sRGB gamut boundary (2e-3)). luv/lchuv are left
+// out: culori's are D50, colorjs's D65.
+export const SPACES = {
+  rgb: ["srgb", { r: [0, 1], g: [1, 1], b: [2, 1] }, 1e-9],
+  lrgb: ["srgb-linear", { r: [0, 1], g: [1, 1], b: [2, 1] }, 1e-9],
+  hsl: ["hsl", { h: [0, 1], s: [1, 100], l: [2, 100] }, 1e-9],
+  hsv: ["hsv", { h: [0, 1], s: [1, 100], v: [2, 100] }, 1e-9],
+  hwb: ["hwb", { h: [0, 1], w: [1, 100], b: [2, 100] }, 1e-9],
+  lab: ["lab", { l: [0, 1], a: [1, 1], b: [2, 1] }, 1e-3],
+  lch: ["lch", { l: [0, 1], c: [1, 1], h: [2, 1] }, 1e-3],
+  lab65: ["lab-d65", { l: [0, 1], a: [1, 1], b: [2, 1] }, 1e-9],
+  oklab: ["oklab", { l: [0, 1], a: [1, 1], b: [2, 1] }, 1e-9],
+  oklch: ["oklch", { l: [0, 1], c: [1, 1], h: [2, 1] }, 1e-9],
+  okhsl: ["okhsl", { h: [0, 1], s: [1, 1], l: [2, 1] }, 5e-3],
+  okhsv: ["okhsv", { h: [0, 1], s: [1, 1], v: [2, 1] }, 5e-3],
+  p3: ["p3", { r: [0, 1], g: [1, 1], b: [2, 1] }, 1e-9],
+  a98: ["a98rgb", { r: [0, 1], g: [1, 1], b: [2, 1] }, 1e-6],
+  prophoto: ["prophoto", { r: [0, 1], g: [1, 1], b: [2, 1] }, 1e-6],
+  xyz50: ["xyz-d50", { x: [0, 1], y: [1, 1], z: [2, 1] }, 1e-6],
+  xyz65: ["xyz-d65", { x: [0, 1], y: [1, 1], z: [2, 1] }, 1e-9],
+  jab: ["jzazbz", { j: [0, 1], a: [1, 1], b: [2, 1] }, 5e-4],
+  jch: ["jzczhz", { j: [0, 1], c: [1, 1], h: [2, 1] }, 5e-4],
+  itp: ["ictcp", { i: [0, 1], t: [1, 1], p: [2, 1] }, 1e-9],
+};
+
+/** colorjs's coordinates of an sRGB colour in the space paired with a culori mode. */
+export function colorjsFromRgb(rgb, mode) {
+  const [space] = SPACES[mode];
+  return new Color("srgb", [rgb.r, rgb.g, rgb.b]).to(space).coords;
+}
+
+/** A colorjs Color from a culori colour whose mode is in SPACES (used for parsing checks). */
+export function toColorjs(c) {
+  const [space, chans] = SPACES[c.mode];
+  const coords = [null, null, null];
+  for (const [ch, [idx, scale]] of Object.entries(chans)) {
+    coords[idx] = c[ch] === undefined ? null : c[ch] * scale;
+  }
+  return new Color(space, coords, c.alpha === undefined ? 1 : c.alpha);
+}
+
+/** colorjs's Lab-based difference formulas, applied to culori's lab65 coordinates directly. */
+export function colorjsLabDelta(method, a, b, opts) {
+  const ca = new Color("lab", [a.l, a.a, a.b]);
+  const cb = new Color("lab", [b.l, b.a, b.b]);
+  return ca.deltaE(cb, opts ? { method, ...opts } : method);
+}
+
+/** Relative luminance and WCAG 2.1 contrast from colorjs, for sRGB colours. */
+export function colorjsLuminance(rgb) {
+  return new Color("srgb", [rgb.r, rgb.g, rgb.b]).luminance;
+}
+export function colorjsContrast(a, b) {
+  return new Color("srgb", [a.r, a.g, a.b]).contrast(new Color("srgb", [b.r, b.g, b.b]), "WCAG21");
+}
+
+// ---- CSS Color Level 4, "Sample code for color conversions": sRGB -> HSL ---------------------
+
+/** rgbToHsl from the specification's sample code: [hue (NaN when achromatic), sat %, light %]. */
+export function specRgbToHsl({ r, g, b }) {
+  const max = Math.max(r, g, b);
+  const min = Math.min(r, g, b);
+  let hue = NaN;
+  let sat = 0;
+  const light = (min + max) / 2;
+  const d = max - min;
+  if (d !== 0) {
+    sat = light === 0 || light === 1 ? 0 : (max - light) / Math.min(light, 1 - light);
+    switch (max) {
+      case r: hue = (g - b) / d + (g < b ? 6 : 0); break;
+      case g: hue = (b - r) / d + 2; break;
+      case b: hue = (r - g) / d + 4;
+    }
+    hue = hue * 60;
+  }
+  if (sat < 0) {
+    hue += 180;
+    sat = Math.abs(sat);
+  }
+  if (hue >= 360) hue -= 360;
+  return [hue, sat * 100, light * 100];
+}
+
+// ---- CSS Color Level 4, "Sample code for color conversions": sRGB <-> rec2020 --------------
+
+function srgbToLinear(c) {
+  const abs = Math.abs(c);
+  const sign = c < 0 ? -1 : 1;
+  return abs <= 0.04045 ? c / 12.92 : sign * Math.pow((abs + 0.055) / 1.055, 2.4);
+}
+function linearToSrgb(c) {
+  const abs = Math.abs(c);
+  const sign = c < 0 ? -1 : 1;
+  return abs > 0.0031308 ? sign * (1.055 * Math.pow(abs, 1 / 2.4) - 0.055) : 12.92 * c;
+}
+const M_SRGB_TO_XYZ = [
+  [506752 / 1228815, 87881 / 245763, 12673 / 70218],
+  [87098 / 409605, 175762 / 245763, 12673 / 175545],
+  [7918 / 409605, 87881 / 737289, 1001167 / 1053270],
+];
+const M_XYZ_TO_REC2020 = [
+  [30757411 / 17917100, -6372589 / 17917100, -4539589 / 17917100],
+  [-19765991 / 29648200, 47925759 / 29648200, 467509 / 29648200],
+  [792561 / 44930125, -1921689 / 44930125, 42328811 / 44930125],
+];
+const M_REC2020_TO_XYZ = [
+  [63426534 / 99577255, 20160776 / 139408157, 47086771 / 278816314],
+  [26158966 / 99577255, 472592308 / 697040785, 8267143 / 139408157],
+  [0, 19567812 / 697040785, 295819943 / 278816314],
+];
+const M_XYZ_TO_SRGB = [
+  [12831 / 3959, -329 / 214, -1974 / 3959],
+  [-851781 / 878810, 1648619 / 878810, 36519 / 878810],
+  [705 / 12673, -2585 / 12673, 705 / 667],
+];
+const mul = (M, v) => M.map((row) => row[0] * v[0] + row[1] * v[1] + row[2] * v[2]);
+const REC_ALPHA = 1.09929682680944;
+const REC_BETA = 0.018053968510807;
+function rec2020Encode(c) {
+  const abs = Math.abs(c);
+  const sign = c < 0 ? -1 : 1;
