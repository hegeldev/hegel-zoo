@@ -0,0 +1,273 @@
+// A model of culori's documented behaviour (docs/api.md, docs/color-spaces.md and the
+// specifications they point at), independent of the library except for the mode definitions'
+// channel lists, ranges and default fixup functions, which are data.
+
+import { fixupAlpha, fixupHueShorter, getMode } from "../src/index.js";
+
+const clamp01 = (v) => Math.min(1, Math.max(0, v));
+const round2 = (v) => Math.round(v * 100) / 100;
+const byte = (v) => Math.round(clamp01(v || 0) * 255);
+const hex2 = (v) => v.toString(16).padStart(2, "0");
+
+// ---- formatting ---------------------------------------------------------------------------------
+
+/** formatHex: the sRGB colour's channels clamped and rounded to bytes, alpha omitted. */
+export function formatHex(rgb) {
+  return "#" + hex2(byte(rgb.r)) + hex2(byte(rgb.g)) + hex2(byte(rgb.b));
+}
+export function formatHex8(rgb) {
+  return formatHex(rgb) + hex2(byte(rgb.alpha === undefined ? 1 : rgb.alpha));
+}
+/** formatRgb: rgb() for opaque colours, rgba() with the alpha rounded to two decimals otherwise. */
+export function formatRgb(rgb) {
+  const r = byte(rgb.r), g = byte(rgb.g), b = byte(rgb.b);
+  if (rgb.alpha === undefined || rgb.alpha === 1) return `rgb(${r}, ${g}, ${b})`;
+  return `rgba(${r}, ${g}, ${b}, ${round2(clamp01(rgb.alpha))})`;
+}
+/** formatHsl: two decimals, saturation and lightness clamped to [0%, 100%], a missing hue as 0. */
+export function formatHsl(hsl) {
+  const h = round2(hsl.h || 0);
+  const s = round2(clamp01(hsl.s || 0) * 100) + "%";
+  const l = round2(clamp01(hsl.l || 0) * 100) + "%";
+  if (hsl.alpha === undefined || hsl.alpha === 1) return `hsl(${h}, ${s}, ${l})`;
+  return `hsla(${h}, ${s}, ${l}, ${round2(clamp01(hsl.alpha))})`;
+}
+
+const CSS_FUNCTIONS = {
+  hsl: (c) => `hsl(${c.h ?? "none"} ${c.s !== undefined ? c.s * 100 + "%" : "none"} ${c.l !== undefined ? c.l * 100 + "%" : "none"}`,
+  hwb: (c) => `hwb(${c.h ?? "none"} ${c.w !== undefined ? c.w * 100 + "%" : "none"} ${c.b !== undefined ? c.b * 100 + "%" : "none"}`,
+  lab: (c) => `lab(${c.l ?? "none"} ${c.a ?? "none"} ${c.b ?? "none"}`,
+  lch: (c) => `lch(${c.l ?? "none"} ${c.c ?? "none"} ${c.h ?? "none"}`,
+  oklab: (c) => `oklab(${c.l ?? "none"} ${c.a ?? "none"} ${c.b ?? "none"}`,
+  oklch: (c) => `oklch(${c.l ?? "none"} ${c.c ?? "none"} ${c.h ?? "none"}`,
+};
+export const CSS_PROFILES = {
+  rgb: "srgb", lrgb: "srgb-linear", p3: "display-p3", a98: "a98-rgb", prophoto: "prophoto-rgb", rec2020: "rec2020", xyz50: "xyz-d50", xyz65: "xyz-d65",
+  lab65: "--lab-d65", lch65: "--lch-d65", luv: "--luv", lchuv: "--lchuv", dlab: "--din99o-lab", dlch: "--din99o-lch", jab: "--jzazbz", jch: "--jzczhz", itp: "--ictcp", hsv: "--hsv", hsi: "--hsi", cubehelix: "--cubehelix", okhsl: "--okhsl", okhsv: "--okhsv", xyb: "--xyb", yiq: "--yiq",
+};
+
+/** formatCss as the Color Spaces page documents each mode ("Serialized as ..."). */
+export function formatCss(c) {
+  const alpha = c.alpha !== undefined && c.alpha < 1 ? ` / ${c.alpha}` : "";
+  if (CSS_FUNCTIONS[c.mode]) return CSS_FUNCTIONS[c.mode](c) + alpha + ")";
+  const chans = getMode(c.mode).channels.filter((ch) => ch !== "alpha");
+  return `color(${CSS_PROFILES[c.mode]} ${chans.map((ch) => (c[ch] === undefined ? "none" : c[ch])).join(" ")}${alpha})`;
+}
+
+/** What parse(formatCss(c)) should give: c with alpha 1 dropped, and the parsed-value clamps of the CSS functions. */
+export function cssRoundTrip(c) {
+  const out = { mode: c.mode };
+  for (const ch of getMode(c.mode).channels) {
+    if (c[ch] !== undefined) out[ch] = c[ch];
+  }
+  if (out.alpha !== undefined) {
+    if (out.alpha >= 1) delete out.alpha;
+    else out.alpha = clamp01(out.alpha);
+  }
+  if (c.mode === "lab" || c.mode === "lch") {
+    if (out.l !== undefined) out.l = Math.min(100, Math.max(0, out.l));
+    if (out.c !== undefined) out.c = Math.max(0, out.c);
+  }
+  if (c.mode === "oklab" || c.mode === "oklch") {
+    if (out.l !== undefined) out.l = clamp01(out.l);
+    if (out.c !== undefined) out.c = Math.max(0, out.c);
+  }
+  if (c.mode === "hsl" && out.s !== undefined) out.s = Math.max(0, out.s);
+  return out;
+}
+
+// ---- interpolation ------------------------------------------------------------------------------
+
+const normalizeHue = (h) => ((h % 360) + 360) % 360;
+
+/** CSS Images 4 colour-stop fixup on an array of positions (undefined = implicit). */
+export function normalizePositions(pos) {
+  const out = pos.slice();
+  // 1. implicit first and last positions
+  if (out[0] === undefined) out[0] = 0;
+  if (out[out.length - 1] === undefined) out[out.length - 1] = 1;
+  // 2. a position smaller than a specified one before it becomes the largest one before it
+  let largest = out[0];
+  for (let i = 1; i < out.length; i++) {
+    if (out[i] === undefined) continue;
+    if (out[i] < largest) out[i] = largest;
+    largest = out[i];
+  }
+  // 3. runs of implicit positions are spread evenly between their neighbours
+  for (let i = 1; i < out.length; i++) {
+    if (out[i] !== undefined) continue;
+    let j = i;
+    while (out[j] === undefined) j++;
+    const from = out[i - 1];
+    const step = (out[j] - from) / (j - i + 1);
+    for (let k = i; k < j; k++) out[k] = from + (k - i + 1) * step;
+    i = j;
+  }
+  return out;
+}
+
+function hueShorter(values) {
+  const out = [];
+  for (let i = 0; i < values.length; i++) {
+    const v = values[i];
+    if (v === undefined) {
+      out.push(undefined);
+      continue;
+    }
+    const norm = normalizeHue(v);
+    if (i === 0 || values[i - 1] === undefined) {
+      out.push(norm);
+      continue;
+    }
+    let d = norm - normalizeHue(values[i - 1]);
+    if (Math.abs(d) > 180) d -= 360 * Math.sign(d);
+    out.push(out[i - 1] + d);
+  }
+  return out;
+}
+
+function alphaFixup(values) {
+  if (values.every((v) => v === undefined)) return values;
+  return values.map((v) => (v === undefined ? 1 : v));
+}
+
+const midpointEasing = (H) => (t) => (H <= 0 ? 1 : H >= 1 ? 0 : Math.pow(t, Math.log(0.5) / Math.log(H)));
+
+/**
+ * The documented linear interpolation of `arr` (colour stops already converted to `mode`,
+ * positions, hints and easings as `interpolate` reads them) at `t`.
+ */
+export function interpolateModel(arr, mode, conv, t) {
+  const def = getMode(mode);
+  const colors = [];
+  const positions = [];
+  const fns = {};
+  for (const val of arr) {
+    if (Array.isArray(val)) {
+      colors.push(conv(val[0]));
+      positions.push(val[1]);
+    } else if (typeof val === "number" || typeof val === "function") {
+      fns[positions.length] = val;
+    } else {
+      colors.push(conv(val));
+      positions.push(undefined);
+    }
+  }
+  const pos = normalizePositions(positions);
+  const n = colors.length - 1;
+  // fixups per channel, from the mode's definition (data)
+  const fixed = {};
+  for (const ch of def.channels) {
+    const values = colors.map((c) => c[ch]);
+    const fixup = def.interpolate[ch] && def.interpolate[ch].fixup;
+    if (fixup === fixupHueShorter) fixed[ch] = hueShorter(values);
+    else if (fixup === fixupAlpha) fixed[ch] = alphaFixup(values);
+    else fixed[ch] = values;
+  }
+  t = Math.min(Math.max(0, t), 1);
+  if (t <= pos[0]) return channelsOf(colors[0], def);
+  if (t > pos[n]) return channelsOf(colors[n], def);
+  let idx = 0;
+  while (pos[idx] < t) idx++;
+  const start = pos[idx - 1];
+  const delta = pos[idx] - start;
+  let P = (t - start) / delta;
+  let fn = fns[idx] !== undefined ? fns[idx] : fns[0];
+  if (fn !== undefined) {
+    if (typeof fn === "number") fn = midpointEasing((fn - start) / delta);
+    P = fn(P);
+  }
+  // segment idx-1 -> idx at fraction P, as a global parameter over n equal segments
+  const t0 = (idx - 1 + P) / n;
+  const cls = t0 * n;
+  const seg = t0 >= 1 ? n - 1 : Math.max(Math.floor(cls), 0);
+  const frac = cls - seg;
+  const out = { mode };
+  for (const ch of def.channels) {
+    let a = fixed[ch][seg];
+    let b = fixed[ch][seg + 1];
+    if (a === undefined && b === undefined) continue;
+    if (a === undefined) a = b;
+    if (b === undefined) b = a;
+    out[ch] = a + frac * (b - a);
+  }
+  return out;
+}
+
+function channelsOf(c, def) {
+  const out = { mode: def.mode };
+  for (const ch of def.channels) if (c[ch] !== undefined) out[ch] = c[ch];
+  return out;
+}
+
+// ---- average -----------------------------------------------------------------------------------
+
+export function averageModel(colors, mode, conv) {
+  const def = getMode(mode);
+  const cc = colors.map(conv);
+  const out = { mode };
+  for (const ch of def.channels) {
+    const vals = cc.map((c) => c[ch]).filter((v) => v !== undefined);
+    if (!vals.length) continue;
+    if (def.average && def.average[ch]) {
+      // the circular mean
+      let s = 0, co = 0;
+      for (const v of vals) {
+        s += Math.sin((v * Math.PI) / 180);
+        co += Math.cos((v * Math.PI) / 180);
+      }
+      const a = (Math.atan2(s, co) * 180) / Math.PI;
+      out[ch] = a < 0 ? a + 360 : a;
+    } else {
+      out[ch] = vals.reduce((x, y) => x + y, 0) / vals.length;
+    }
+  }
+  return out;
+}
+
+// ---- blending (Compositing and Blending Level 2) -----------------------------------------------
+
+const multiply = (b, s) => b * s;
+const screen = (b, s) => b + s - b * s;
+const hardLight = (b, s) => (s <= 0.5 ? multiply(b, 2 * s) : screen(b, 2 * s - 1));
+export const BLEND_MODES = {
+  normal: (b, s) => s,
+  multiply,
+  screen,
+  overlay: (b, s) => hardLight(s, b),
+  darken: (b, s) => Math.min(b, s),
+  lighten: (b, s) => Math.max(b, s),
+  "color-dodge": (b, s) => (b === 0 ? 0 : s === 1 ? 1 : Math.min(1, b / (1 - s))),
+  "color-burn": (b, s) => (b === 1 ? 1 : s === 0 ? 0 : 1 - Math.min(1, (1 - b) / s)),
+  "hard-light": hardLight,
+  "soft-light": (b, s) => {
+    if (s <= 0.5) return b - (1 - 2 * s) * b * (1 - b);
+    const d = b <= 0.25 ? ((16 * b - 12) * b + 4) * b : Math.sqrt(b);
+    return b + (2 * s - 1) * (d - b);
+  },
+  difference: (b, s) => Math.abs(b - s),
+  exclusion: (b, s) => b + s - 2 * b * s,
+};
+
+/** Separable blending of `colors` (already in an RGB mode, alpha 1 when missing), source over backdrop. */
+export function blendModel(colors, type, mode) {
+  const fn = typeof type === "function" ? type : BLEND_MODES[type];
+  const chans = getMode(mode).channels.filter((c) => c !== "alpha");
+  colors = colors.map((c) => ({ ...c, alpha: c.alpha === undefined ? 1 : c.alpha }));
+  return colors.reduce((b, s) => {
+    if (b === undefined) return s;
+    const ab = b.alpha === undefined ? 1 : b.alpha;
+    const as = s.alpha === undefined ? 1 : s.alpha;
+    const ao = as + ab * (1 - as);
+    const out = { mode, alpha: ao };
+    for (const ch of chans) {
+      if (ao === 0) {
+        out[ch] = 0;
+        continue;
+      }
+      const co = as * (1 - ab) * s[ch] + as * ab * fn(b[ch], s[ch]) + (1 - as) * ab * b[ch];
+      out[ch] = clamp01(co / ao);
+    }
+    return out;
+  }, undefined);
+}
