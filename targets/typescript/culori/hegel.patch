+}
+
+// ---- interpolation inputs ---------------------------------------------------------------------
+
+export const EASINGS = [
+  ["square", (t) => t * t],
+  ["sqrt", (t) => Math.sqrt(t)],
+  ["identity", (t) => t],
+  ["step", (t) => (t < 0.5 ? 0 : 1)],
+  ["reverse", (t) => 1 - t],
+];
+
+/**
+ * The `colors` array of an interpolate() call: colour stops (plain or [colour, position]),
+ * interpolation hints (numbers) and easing functions, as the documentation allows them.
+ */
+export function stops(tc, { full = false } = {}) {
+  const count = n(tc, 2, 5);
+  const arr = [];
+  const tags = [];
+  if (chance(tc, 15)) {
+    const [name, fn] = pick(tc, EASINGS);
+    arr.push(fn);
+    tags.push("global:" + name);
+  }
+  let last = 0;
+  for (let i = 0; i < count; i++) {
+    const c = anyColor(tc, { missing: chance(tc, 30) });
+    if (chance(tc, 30)) {
+      // a positioned stop; positions mostly increasing, sometimes not (the fixup makes them so)
+      let pos = !full || chance(tc, 80) ? real(tc, last, 1) : real(tc, 0, 1);
+      if (chance(tc, 10)) pos = pick(tc, full ? [0, 1, last] : [1, last]);
+      arr.push([c, pos]);
+      if (pos < last) tags.push("decreasing");
+      last = Math.max(last, pos);
+      tags.push("positioned");
+    } else {
+      arr.push(c);
+    }
+    if (i < count - 1 && chance(tc, 25)) {
+      if (chance(tc, 50)) {
+        const hint = full ? real(tc, 0, 1) : real(tc, 0.05, 0.95);
+        if (hint === 0) tags.push("zero-hint");
+        arr.push(hint);
+        tags.push("hint");
+      } else {
+        const [name, fn] = pick(tc, EASINGS);
+        arr.push(fn);
+        tags.push("easing:" + name);
+      }
+    }
+  }
+  return { arr, tags };
+}
diff --git a/hegel/hegel-zoo.mjs b/hegel/hegel-zoo.mjs
new file mode 100644
index 0000000..1ca6f10
--- /dev/null
+++ b/hegel/hegel-zoo.mjs
@@ -0,0 +1,163 @@
+// Hegel zoo: the small harness shared by the zoo's TypeScript/JavaScript targets.
+//
+// `property(name, body)` registers a node:test test that runs `body(tc)` under Hegel with
+// HEGEL_TEST_CASES cases (default 100) and the database at HEGEL_DATABASE. With ZOO_COLLECT=1
+// a `fail()` records the mismatch instead of failing, the case ends there, and the counts of
+// mismatches and of the shapes seen (`count(key)`) are printed at the end of the test, so a
+// property can be run over many cases to see every shape at once. `pin(name, body)` is a
+// plain test for one pinned bug: it must fail while the bug is present and pass once it is
+// fixed (the zoo's judge reads an unexpected pass as "fixed upstream?").
+
+import { readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+import { test as nodeTest } from "node:test";
+
+// The Hegel version these tests were written against (the zoo pins it in zoo.toml; upstream
+// would add it to devDependencies). Hegel and esbuild are installed with `npm install --prefix
+// .hegel` so the target's own package.json and lock file stay untouched. Checked at load time so
+// a stray install cannot silently change the engine.
+export const HEGEL_PIN = { "@hegeldev/hegel": "0.4.5" };
+
+const hegelDir = join(dirname(fileURLToPath(import.meta.url)), "..", ".hegel", "node_modules", "@hegeldev", "hegel");
+{
+  const installed = JSON.parse(readFileSync(join(hegelDir, "package.json"), "utf8")).version;
+  if (installed !== HEGEL_PIN["@hegeldev/hegel"]) {
+    throw new Error(`@hegeldev/hegel ${installed} is installed; these tests pin ${HEGEL_PIN["@hegeldev/hegel"]}`);
+  }
+}
+const hegel = await import(pathToFileURL(join(hegelDir, "dist", "index.js")));
+const gs = await import(pathToFileURL(join(hegelDir, "dist", "generators", "index.js")));
+
+export const collecting = !!process.env.ZOO_COLLECT;
+
+class Collected extends Error {}
+
+let msgs = [];
+let stats = new Map();
+
+/** Report a mismatch: an error normally, a recorded line in collect mode. */
+export function fail(message) {
+  if (collecting) {
+    msgs.push(message);
+    throw new Collected(message);
+  }
+  throw new Error(message);
+}
+
+/** Bump a statistic (the shape of a pinned bug, a generator branch). */
+export function count(key) {
+  stats.set(key, (stats.get(key) || 0) + 1);
+}
+
+function settings() {
+  const s = { testCases: Number(process.env.HEGEL_TEST_CASES) || 100 };
+  if (process.env.HEGEL_DATABASE) {
+    s.database = hegel.Database.fromPath(process.env.HEGEL_DATABASE);
+  }
+  return s;
+}
+
+/** A property: `body(tc)` runs under Hegel; a thrown error (or `fail`) is a failure. */
+export function property(name, body) {
+  nodeTest(name, () => {
+    msgs = [];
+    stats = new Map();
+    hegel.test((tc) => {
+      try {
+        body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** An async property: `body(tc)` may await; runs under Hegel's testAsync with the same settings. */
+export function propertyAsync(name, body) {
+  nodeTest(name, async () => {
+    msgs = [];
+    stats = new Map();
+    await hegel.testAsync(async (tc) => {
+      try {
+        await body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** A pin: a plain test for one recorded bug. */
+export function pin(name, body) {
+  nodeTest(name, body);
+}
+
+/** An integer in [lo, hi]. */
+export function n(tc, lo, hi) {
+  return tc.draw(gs.integers({ minValue: lo, maxValue: hi }));
+}
+
+/** One of xs. */
+export function pick(tc, xs) {
+  return xs[n(tc, 0, xs.length - 1)];
+}
+
+/** True pct percent of the time. */
+export function chance(tc, pct) {
+  return n(tc, 0, 99) < pct;
+}
+
+/** A string of `len` characters drawn from `alphabet` (an array of strings). */
+export function word(tc, alphabet, lo, hi) {
+  const len = n(tc, lo, hi);
+  let s = "";
+  for (let i = 0; i < len; i++) {
+    s += pick(tc, alphabet);
+  }
+  return s;
+}
+
+/** Structural equality: arrays by position, objects by key set (prototype ignored), else ===. */
+export function same(a, b) {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) {
+      return false;
+    }
+    return a.every((x, i) => same(x, b[i]));
+  }
+  if (a !== null && b !== null && typeof a === "object" && typeof b === "object") {
+    const ka = Object.keys(a).sort();
+    const kb = Object.keys(b).sort();
+    if (ka.length !== kb.length || ka.some((k, i) => k !== kb[i])) {
+      return false;
+    }
+    return ka.every((k) => same(a[k], b[k]));
+  }
+  return a === b;
+}
+
+/** A compact, unambiguous rendering for messages. */
+export function show(x) {
+  return JSON.stringify(x, (k, v) => (v === undefined ? "<undefined>" : v));
+}
diff --git a/hegel/hegel.test.mjs b/hegel/hegel.test.mjs
new file mode 100644
index 0000000..b19f26c
--- /dev/null
+++ b/hegel/hegel.test.mjs
@@ -0,0 +1,615 @@
+// Hegel property tests for culori (Hegel zoo). Oracles: colorjs.io 0.7.1 for the colour spaces
+// both libraries define, the CSS Color Level 4 sample code for rec2020 and rgb->hsl, and a model
+// of the documentation (hegel/model.mjs) for parsing, formatting, interpolation, averaging and
+// blending. Run: node --test --test-reporter=tap hegel/hegel.test.mjs (HEGEL_TEST_CASES=n,
+// ZOO_COLLECT=1 to count mismatches and shapes instead of failing).
+
+import assert from "node:assert/strict";
+import * as C from "../src/index.js";
+import { chance, count, fail, n, pick, property, pin, show } from "./hegel-zoo.mjs";
+import * as G from "./gen.mjs";
+import * as M from "./model.mjs";
+import * as O from "./oracle.mjs";
+
+const full = !!process.env.ZOO_FULL;
+
+const close = (a, b, tol) => a === b || Math.abs(a - b) <= tol;
+const hueClose = (a, b, tol) => {
+  const d = Math.abs(((a - b) % 360 + 540) % 360 - 180);
+  return d <= tol;
+};
+const range = (mode, ch) => {
+  const [lo, hi] = C.getMode(mode).ranges[ch];
+  return hi - lo;
+};
+const finite = (c) => Object.values(c).every((v) => typeof v !== "number" || Number.isFinite(v));
+const CHROMA = { hsl: "s", hsv: "s", hsi: "s", okhsl: "s", okhsv: "s", cubehelix: "s", lch: "c", lch65: "c", lchuv: "c", dlch: "c", oklch: "c", jch: "c" };
+const chromaOf = (c) => (c.mode === "hwb" ? 1 - (c.w || 0) - (c.b || 0) : c[CHROMA[c.mode]]);
+
+/** Same channel set and values within tol (hue: within hueTol, and only where the colour has chroma). */
+function sameColor(a, b, tol, { hueTol = 1e-6, minChroma = 1e-4 } = {}) {
+  if (a.mode !== b.mode) return `mode ${a.mode} vs ${b.mode}`;
+  for (const ch of C.getMode(a.mode).channels) {
+    const x = a[ch], y = b[ch];
+    if (x === undefined && y === undefined) continue;
+    if (ch === "h" && (x === undefined || y === undefined)) {
+      const chroma = Math.max(Math.abs(chromaOf(a) || 0), Math.abs(chromaOf(b) || 0));
+      if (chroma <= minChroma) continue;
+      return `${ch}: ${x} vs ${y} (chroma ${chroma})`;
+    }
+    if (x === undefined || y === undefined) return `${ch}: ${x} vs ${y}`;
+    if (ch === "h") {
+      const chroma = Math.max(Math.abs(chromaOf(a) || 0), Math.abs(chromaOf(b) || 0));
+      if (chroma <= minChroma) continue;
+      if (!hueClose(x, y, hueTol)) return `${ch}: ${x} vs ${y}`;
+    } else if (!close(x, y, tol)) {
+      return `${ch}: ${x} vs ${y}`;
+    }
+  }
+  return null;
+}
+
+// ---- known bugs by shape -------------------------------------------------------------------------
+
+const KNOWN_CSS = { "number-ident": "culori/1 (a number followed by an unknown identifier)", "upper-unit": "culori/1 or culori/2 (an upper-case hue unit: a crash in the modern syntax, undefined in the legacy one)", "upper-fn": "culori/2 (upper-case function or keyword)", padded: "culori/3 (whitespace around a hex, named or legacy colour)", "hsl-oob": "culori/4 (hsl saturation or lightness outside 0..100%)" };
+function knownForCss(shapes) {
+  return shapes.map((s) => KNOWN_CSS[s]).filter(Boolean);
+}
+
+// ---- 1. conversions against colorjs and the CSS Color 4 sample code -----------------------------
+
+property("TestHegelConversionsAgreeWithColorjs", (tc) => {
+  const rgb = G.rgbColor(tc, { alpha: false });
+  const mode = pick(tc, Object.keys(O.SPACES));
+  count(mode);
+  const got = C.converter(mode)(rgb);
+  const [, chans, tol] = O.SPACES[mode];
+  const want = O.colorjsFromRgb(rgb, mode);
+  for (const [ch, [idx, scale]] of Object.entries(chans)) {
+    const x = got[ch];
+    const y = want[idx];
+    const ynone = y === null || y === undefined || Number.isNaN(y);
+    if (ch === "h") {
+      const chroma = Math.abs(chromaOf(got) || 0);
+      if (chroma <= 1e-3 * (tol > 1e-8 ? 10 : 1)) continue;
+      if (x === undefined || ynone) fail(`${mode}: hue ${x} vs colorjs ${y} for ${show(rgb)} (chroma ${chroma})`);
+      if (!hueClose(x * scale, y, tol > 1e-8 ? 1 : 1e-6)) fail(`${mode}: hue ${x * scale} vs colorjs ${y} for ${show(rgb)}`);
+      continue;
+    }
+    if (x === undefined || ynone) fail(`${mode}: ${ch} ${x} vs colorjs ${y} for ${show(rgb)}`);
+    if (!close(x * scale, y, tol)) fail(`${mode}: ${ch} ${x * scale} vs colorjs ${y} (tol ${tol}) for ${show(rgb)}`);
+  }
+  // rec2020 against the specification's own conversion code
+  const r2020 = C.rec2020(rgb);
+  const spec = O.specRgbToRec2020(rgb);
+  for (const ch of ["r", "g", "b"]) {
+    if (!close(r2020[ch], spec[ch], 1e-9)) fail(`rec2020 ${ch}: ${r2020[ch]} vs CSS Color 4 ${spec[ch]} for ${show(rgb)}`);
+  }
+  const back = C.rgb(r2020);
+  const specBack = O.specRec2020ToRgb(r2020);
+  for (const ch of ["r", "g", "b"]) {
+    if (!close(back[ch], specBack[ch], 1e-9)) fail(`rec2020 -> rgb ${ch}: ${back[ch]} vs CSS Color 4 ${specBack[ch]} for ${show(r2020)}`);
+  }
+  // rgb -> hsl against the CSS Color 4 rgbToHsl sample code, also outside the gamut in FULL
+  const src = full && chance(tc, 40) ? G.rgbColor(tc, { oog: true, alpha: false }) : rgb;
+  const hsl = C.hsl(src);
+  const [hh, ss, ll] = O.specRgbToHsl(src);
+  if (!(close(hsl.l, ll / 100, 1e-9) && close(hsl.s, ss / 100, 1e-9) && (Number.isNaN(hh) ? hsl.h === undefined || ss === 0 : hsl.h !== undefined && hueClose(hsl.h, hh, 1e-6)))) {
+    const oog = [src.r, src.g, src.b].some((v) => v < 0 || v > 1);
+    if (oog) count("oog-hsl");
+    fail(`hsl of ${show(src)}: ${show(hsl)} vs CSS Color 4 [${hh} ${ss} ${ll}]${oog ? " known culori/6 (out-of-gamut colour)" : ""}`);
+  }
+});
+
+// ---- 2. every mode round-trips sRGB; conversion paths agree ------------------------------------
+
+// The D50 spaces go through culori's rounded Bradford matrices (5e-6 at the darkest colours); the
+// Jzazbz inversion is the least exact (2e-3 at white, see README).
+const RT_TOL = { okhsl: 1e-6, okhsv: 1e-6, cubehelix: 1e-6, jab: 2e-3, jch: 2e-3, itp: 1e-6, dlab: 1e-5, dlch: 1e-5, lab: 1e-5, lch: 1e-5, luv: 1e-5, lchuv: 1e-5, xyz50: 1e-5, prophoto: 1e-5, yiq: 1e-6 };
+
+/** A stop/colour in okhsl at (or without) lightness 0 with some saturation: the shape of culori/15. */
+const okhslBlack = (c) => c && c.mode === "okhsl" && (c.l === 0 || c.l === undefined) && c.s !== undefined && c.s !== 0;
+
+property("TestHegelEveryModeRoundTripsRgb", (tc) => {
+  const rgb = G.rgbColor(tc);
+  const black = rgb.r === 0 && rgb.g === 0 && rgb.b === 0;
+  for (const mode of G.MODES) {
+    // black with alpha through luv/lchuv is the shape of culori/14 (alpha dropped at l = 0)
+    if ((mode === "luv" || mode === "lchuv") && black && rgb.alpha !== undefined && !full) continue;
+    const there = C.converter(mode)(rgb);
+    if (there.mode !== mode) fail(`converter(${mode}) gave mode ${there.mode}`);
+    if (!finite(there)) fail(`converter(${mode})(${show(rgb)}) = ${show(there)}`);
+    if (there.alpha !== rgb.alpha) fail(`converter(${mode}) alpha ${there.alpha} vs ${rgb.alpha} for ${show(rgb)}`);
+    const back = C.rgb(there);
+    const tol = RT_TOL[mode] || 1e-9;
+    for (const ch of ["r", "g", "b"]) {
+      if (!close(back[ch], rgb[ch], tol)) fail(`${mode}: rgb -> ${mode} -> rgb ${ch} ${back[ch]} vs ${rgb[ch]} for ${show(rgb)} via ${show(there)}`);
+    }
+    if (back.alpha !== rgb.alpha) {
+      if (black) count("black-alpha-" + mode);
+      fail(`${mode}: alpha lost on the way back: ${show(back)} for ${show(rgb)}${black && (mode === "luv" || mode === "lchuv") ? "; known culori/14 (l = 0 with alpha)" : ""}`);
+    }
+  }
+  // path independence: K -> M equals rgb -> M
+  const k = pick(tc, G.MODES);
+  const m = pick(tc, G.MODES);
+  // black with alpha through luv/lchuv drops the alpha (culori/14)
+  if ((k === "luv" || k === "lchuv") && black && rgb.alpha !== undefined && !full) return;
+  const viaK = C.converter(m)(C.converter(k)(rgb));
+  const direct = C.converter(m)(rgb);
+  // the cylindrical RGB spaces have no saturation or hue at black and white (a 0/0)
+  const L = m === "hwb" ? 1 - (direct.w || 0) - (direct.b || 0) : direct.l ?? direct.v ?? direct.i;
+  if (["cubehelix", "hsl", "hsv", "hsi", "hwb", "okhsl", "okhsv"].includes(m) && (L < 1e-6 || L > 1 - 1e-6)) return;
+  const tol = Math.max(RT_TOL[m] || 1e-9, RT_TOL[k] || 1e-9) * 10;
+  const diff = sameColor(viaK, direct, tol * range(m, C.getMode(m).channels[0]) * 10, { hueTol: 1e-3, minChroma: 1e-2 * range(m, CHROMA[m] || C.getMode(m).channels[0]) });
+  if (diff) fail(`${k} -> ${m} vs rgb -> ${m}: ${diff}; ${show(viaK)} vs ${show(direct)} for ${show(rgb)}`);
+});
+
+// ---- 3. parsing -----------------------------------------------------------------------------------
+
+property("TestHegelParseFollowsCssColor4", (tc) => {
+  const { text, expected, shapes } = G.cssColor(tc, { full });
+  for (const s of shapes) count(s);
+  count(expected === undefined ? "invalid" : "valid");
+  const known = knownForCss(shapes);
+  let got;
+  try {
+    got = C.parse(text);
+  } catch (e) {
+    fail(`parse(${show(text)}) threw ${e.message}${known.length ? "; known " + known.join(", ") : ""}`);
+  }
+  if (expected === undefined) {
+    if (got !== undefined) fail(`parse(${show(text)}) = ${show(got)}, expected undefined${known.length ? "; known " + known.join(", ") : ""}`);
+    return;
+  }
+  const bad = got === undefined ? "undefined" : sameColor(got, expected, 1e-9, { hueTol: 1e-9, minChroma: -1 });
+  if (bad) fail(`parse(${show(text)}) = ${show(got)}, expected ${show(expected)}: ${bad}${known.length ? "; known " + known.join(", ") : ""}`);
+  // a parsed colour has no other keys
+  if (got !== undefined && Object.keys(got).some((k) => k !== "mode" && !C.getMode(got.mode).channels.includes(k))) fail(`parse(${show(text)}) has extra keys: ${show(got)}`);
+});
+
+// ---- 4. formatting --------------------------------------------------------------------------------
+
+property("TestHegelFormatFollowsTheDocumentation", (tc) => {
+  const c = G.anyColor(tc, { missing: chance(tc, 30), outside: chance(tc, 30) });
+  count(c.mode);
+  const css = C.formatCss(c);
+  const want = M.formatCss(c);
+  if (css !== want) fail(`formatCss(${show(c)}) = ${css}, expected ${want}`);
+  const back = C.parse(css);
+  const rt = M.cssRoundTrip(c);
+  const bad = back === undefined ? "undefined" : sameColor(back, rt, 1e-12 * Math.max(1, ...Object.values(rt).filter((v) => typeof v === "number").map(Math.abs)), { hueTol: 1e-9, minChroma: -1 });
+  if (bad) fail(`parse(formatCss(${show(c)})) = ${show(back)} from ${css}, expected ${show(rt)}: ${bad}`);
+  // the legacy formatters, on the colour converted by the library
+  const rgb = C.rgb(c);
+  if (C.formatHex(c) !== M.formatHex(rgb)) fail(`formatHex(${show(c)}) = ${C.formatHex(c)}, expected ${M.formatHex(rgb)} from ${show(rgb)}`);
+  if (C.formatHex8(c) !== M.formatHex8(rgb)) fail(`formatHex8(${show(c)}) = ${C.formatHex8(c)}, expected ${M.formatHex8(rgb)}`);
+  if (C.formatRgb(c) !== M.formatRgb(rgb)) fail(`formatRgb(${show(c)}) = ${C.formatRgb(c)}, expected ${M.formatRgb(rgb)}`);
+  const hsl = C.hsl(c);
+  if (C.formatHsl(c) !== M.formatHsl(hsl)) fail(`formatHsl(${show(c)}) = ${C.formatHsl(c)}, expected ${M.formatHsl(hsl)} from ${show(hsl)}`);
+  // hex strings round-trip through formatHex
+  const hex = C.formatHex(c);
+  if (C.formatHex(hex) !== hex) fail(`formatHex(parse(${hex})) = ${C.formatHex(hex)}`);
+  if (C.formatHex8(C.formatHex8(c)) !== C.formatHex8(c)) fail(`formatHex8 round trip: ${C.formatHex8(c)} -> ${C.formatHex8(C.formatHex8(c))}`);
+});
+
+// ---- 5. interpolation -----------------------------------------------------------------------------
+
+property("TestHegelInterpolateFollowsTheDocumentation", (tc) => {
+  const { arr, tags } = G.stops(tc, { full });
+  for (const t of tags) count(t);
+  const mode = pick(tc, G.MODES);
+  const conv = C.converter(mode);
+  const t = chance(tc, 15) ? pick(tc, [0, 1, -0.5, 1.5, 0.5]) : chance(tc, 15) ? pick(tc, arr.filter(Array.isArray).map((x) => x[1]).concat([0.5])) : G.real(tc, 0, 1);
+  const got = C.interpolate(arr, mode)(t);
+  const want = M.interpolateModel(arr, mode, conv, t);
+  const tol = 1e-9 * Math.max(...C.getMode(mode).channels.map((ch) => range(mode, ch)));
+  const bad = sameColor(got, want, tol, { hueTol: 1e-7, minChroma: -1 });
+  if (bad) {
+    const known = [];
+    if (arr.some((x) => okhslBlack(Array.isArray(x) ? x[0] : x))) known.push("culori/15 (an okhsl stop at lightness 0)");
+    if (tags.includes("zero-hint")) known.push("culori/7 (a hint of 0)");
+    if (tags.includes("decreasing")) known.push("culori/18 (a position smaller than an earlier one)");
+    fail(`interpolate(${arr.length} items ${tags.join(",")}, ${mode})(${t}) = ${show(got)}, expected ${show(want)}: ${bad}${known.length ? "; known " + known.join(", ") : ""}`);
+  }
+});
+
+// ---- 6. average -----------------------------------------------------------------------------------
+
+property("TestHegelAverageFollowsTheDocumentation", (tc) => {
+  const colors = [];
+  const k = n(tc, 1, 5);
+  for (let i = 0; i < k; i++) colors.push(G.anyColor(tc, { missing: chance(tc, 30) }));
+  const mode = pick(tc, G.MODES);
+  const got = C.average(colors, mode);
+  const want = M.averageModel(colors, mode, C.converter(mode));
+  const tol = 1e-9 * Math.max(...C.getMode(mode).channels.map((ch) => range(mode, ch)));
+  const bad = sameColor(got, want, tol, { hueTol: 1e-6, minChroma: -1 });
+  if (bad) fail(`average(${show(colors)}, ${mode}) = ${show(got)}, expected ${show(want)}: ${bad}${colors.some(okhslBlack) ? "; known culori/15 (an okhsl colour at lightness 0)" : ""}`);
+});
+
+// ---- 7. blending ----------------------------------------------------------------------------------
+
+property("TestHegelBlendFollowsTheSpecification", (tc) => {
+  const k = n(tc, 1, 4);
+  const colors = [];
+  for (let i = 0; i < k; i++) colors.push(chance(tc, 20) ? C.formatRgb(G.rgbColor(tc)) : G.rgbColor(tc));
+  const type = pick(tc, Object.keys(M.BLEND_MODES));
+  const mode = pick(tc, ["rgb", "lrgb"]);
+  count(type);
+  const got = C.blend(colors, type, mode);
+  const want = M.blendModel(colors.map((c) => C.converter(mode)(c)), type, mode);
+  const bad = sameColor(got, want, 1e-12, {});
+  if (bad || !close(got.alpha ?? 1, want.alpha ?? 1, 1e-12)) fail(`blend(${show(colors)}, ${type}, ${mode}) = ${show(got)}, expected ${show(want)}: ${bad}`);
+});
+
+// ---- 8. colour difference and nearest ------------------------------------------------------------
+
+property("TestHegelDifferencesAgreeWithColorjs", (tc) => {
+  const a = G.colorIn(tc, "lab65", { alpha: false });
+  const b = chance(tc, 10) ? { ...a } : G.colorIn(tc, "lab65", { alpha: false });
+  const rel = (x, y, tol) => close(x, y, tol * Math.max(1, Math.abs(x), Math.abs(y)));
+  const checks = [
+    ["cie76", C.differenceCie76()(a, b), O.colorjsLabDelta("76", a, b)],
+    ["ciede2000", C.differenceCiede2000()(a, b), O.colorjsLabDelta("2000", a, b)],
+    ["hyab", C.differenceHyab()(a, b), Math.abs(a.l - b.l) + Math.hypot(a.a - b.a, a.b - b.b)],
+  ];
+  const l = pick(tc, [1, 2]), cc = pick(tc, [1, 2]);
+  checks.push([`cmc(${l},${cc})`, C.differenceCmc(l, cc)(a, b), O.colorjsLabDelta("CMC", a, b, { l, c: cc })]);
+  for (const [name, x, y] of checks) {
+    if (!rel(x, y, 1e-9)) fail(`${name}(${show(a)}, ${show(b)}) = ${x}, colorjs ${y}`);
+  }
+  // the metrics are symmetric where documented, zero on a colour and itself
+  for (const [name, f] of [["cie76", C.differenceCie76()], ["ciede2000", C.differenceCiede2000()], ["hyab", C.differenceHyab()], ["euclidean(lab65)", C.differenceEuclidean("lab65")]]) {
+    if (!rel(f(a, b), f(b, a), 1e-12)) fail(`${name} is not symmetric: ${f(a, b)} vs ${f(b, a)} for ${show(a)}, ${show(b)}`);
+    if (f(a, a) !== 0) fail(`${name}(a, a) = ${f(a, a)} for ${show(a)}`);
+  }
+  // ITP and OK on sRGB colours
+  const p = G.rgbColor(tc, { alpha: false }), q = G.rgbColor(tc, { alpha: false });
+  const itp = C.differenceItp()(p, q), itpj = new O.Color("srgb", [p.r, p.g, p.b]).deltaE(new O.Color("srgb", [q.r, q.g, q.b]), "ITP");
+  if (!rel(itp, itpj, 1e-6)) fail(`differenceItp(${show(p)}, ${show(q)}) = ${itp}, colorjs ${itpj}`);
+  const ok = C.differenceEuclidean("oklab")(p, q), okj = new O.Color("srgb", [p.r, p.g, p.b]).deltaE(new O.Color("srgb", [q.r, q.g, q.b]), "OK");
+  if (!rel(ok, okj, 1e-9)) fail(`differenceEuclidean(oklab)(${show(p)}, ${show(q)}) = ${ok}, colorjs ${okj}`);
+  const eu = C.differenceEuclidean()(p, q);
+  if (!rel(eu, Math.hypot(p.r - q.r, p.g - q.g, p.b - q.b), 1e-12)) fail(`differenceEuclidean(rgb) = ${eu} for ${show(p)}, ${show(q)}`);
+  // nearest against brute force
+  const k = n(tc, 1, 7);
+  const palette = [];
+  for (let i = 0; i < k; i++) palette.push(C.formatHex(G.rgbColor(tc, { alpha: false })));
+  const metric = C.differenceEuclidean();
+  const want = pick(tc, [1, n(tc, 1, k), k, k + 1, Infinity]);
+  const tau = chance(tc, 30) ? G.real(tc, 0, 1) : Infinity;
+  const near = C.nearest(palette, metric)(p, want, tau);
+  const ranked = palette.map((c, i) => ({ c, i, d: metric(p, c) })).sort((x, y) => x.d - y.d || x.i - y.i).slice(0, want).filter((x) => x.d < tau).map((x) => x.c);
+  if (show(near) !== show(ranked)) {
+    if (want >= k && k > 1) {
+      count("nearest-all");
+      if (!full) return; // culori/5: nearest never returns the whole palette
+    }
+    fail(`nearest(${show(palette)})(${show(p)}, ${want}, ${tau}) = ${show(near)}, expected ${show(ranked)}${want >= k && k > 1 ? "; known culori/5 (n >= the number of colours)" : ""}`);
+  }
+});
+
+// ---- 9. gamut functions ---------------------------------------------------------------------------
+
+const GAMUT_MODES = G.MODES.filter((m) => C.getMode(m).gamut);
+const LCH_MODES = ["lch", "oklch", "lch65", "dlch", "jch", "lchuv"];
+const inRgbRange = (c) => ["r", "g", "b"].every((ch) => c[ch] === undefined || (c[ch] >= 0 && c[ch] <= 1));
+// clipping happens in sRGB and the result is converted back: the check reconverts, so allow the
+// conversion noise (1e-5; the Jzazbz inversion is off by 2e-3, culori/19)
+const D50 = ["lab", "lch", "luv", "lchuv", "xyz50", "prophoto"];
+const gamutSlack = (mode) => (mode === "jab" || mode === "jch" ? 3e-3 : D50.includes(mode) ? 1e-3 : 1e-5);
+const HSL_FAMILY = ["hsl", "hsv", "hsi", "hwb", "okhsl", "okhsv"];
+
+property("TestHegelGamutFunctionsAreSound", (tc) => {
+  const c = G.anyColor(tc, { outside: chance(tc, 50) });
+  count(c.mode);
+  const rgb = C.rgb(c);
+  if (okhslBlack(c)) {
+    count("okhsl-black");
+    if (!finite(rgb)) fail(`rgb(${show(c)}) = ${show(rgb)}; known culori/15 (okhsl at lightness 0)`);
+    return;
+  }
+  const disp = C.displayable(c);
+  if (disp !== inRgbRange(rgb)) fail(`displayable(${show(c)}) = ${disp} but rgb is ${show(rgb)}`);
+  if (C.inGamut("rgb")(c) !== disp) fail(`inGamut('rgb') disagrees with displayable for ${show(c)}`);
+  const noGamut = pick(tc, G.MODES.filter((m) => !C.getMode(m).gamut));
+  if (C.inGamut(noGamut)(c) !== true) fail(`inGamut(${noGamut}) is not always true: ${show(c)}`);
+  // clampRgb
+  const cr = C.clampRgb(c);
+  if (cr.mode !== c.mode) fail(`clampRgb(${show(c)}) changed the mode: ${show(cr)}`);
+  if (!C.displayable(cr)) {
+    const r = C.rgb(cr);
+    const slack = gamutSlack(c.mode);
+    if (["r", "g", "b"].some((ch) => r[ch] < -slack || r[ch] > 1 + slack)) fail(`clampRgb(${show(c)}) = ${show(cr)} is not displayable: ${show(r)}`);
+  }
+  if (disp && cr !== c) fail(`clampRgb returned a new object for a displayable colour ${show(c)}`);
+  if (cr.alpha !== c.alpha) fail(`clampRgb(${show(c)}) lost alpha: ${show(cr)}`);
+  // clampGamut
+  const dest = pick(tc, GAMUT_MODES);
+  const cg = C.clampGamut(dest)(c);
+  if (cg.mode !== c.mode) fail(`clampGamut(${dest})(${show(c)}) changed the mode: ${show(cg)}`);
+  const inDest = C.inGamut(dest);
+  if (inDest(c) && cg !== c) fail(`clampGamut(${dest}) returned a new object for an in-gamut colour ${show(c)}`);
+  if (!inDest(cg)) {
+    const gamutMode = typeof C.getMode(dest).gamut === "string" ? C.getMode(dest).gamut : dest;
+    const r = C.converter(gamutMode)(cg);
+    const slack = gamutSlack(c.mode);
+    if (["r", "g", "b"].some((ch) => r[ch] < -slack || r[ch] > 1 + slack)) fail(`clampGamut(${dest})(${show(c)}) = ${show(cg)} is out of gamut: ${show(r)}`);
+  }
+  // clampChroma keeps the mode, and lightness and hue in the clamping space
+  const lchMode = pick(tc, LCH_MODES);
+  const cc = C.clampChroma(c, lchMode);
+  if (cc.mode !== c.mode) fail(`clampChroma(${show(c)}, ${lchMode}) changed the mode: ${show(cc)}`);
+  if (!C.displayable(cc)) {
+    const r = C.rgb(cc);
+    const slack = Math.max(gamutSlack(c.mode), gamutSlack(lchMode));
+    if (["r", "g", "b"].some((ch) => r[ch] < -slack || r[ch] > 1 + slack)) fail(`clampChroma(${show(c)}, ${lchMode}) = ${show(cc)} is not displayable: ${show(r)}`);
+  }
+  if (disp && cc !== c) fail(`clampChroma returned a new object for a displayable colour ${show(c)}`);
+  if (!disp) {
+    const before = C.converter(lchMode)(c);
+    const after = C.converter(lchMode)(cc);
+    const achromatic = { ...before, c: 0 };
+    if (C.displayable(achromatic)) {
+      // the bisection kept lightness and hue, and did not increase chroma
+      const L = C.getMode(lchMode).channels[0];
+      const lTol = 1e-6 * range(lchMode, L);
+      if (!close(before[L], after[L], lTol)) fail(`clampChroma(${show(c)}, ${lchMode}) changed lightness: ${show(before)} -> ${show(after)}`);
+      // a negative chroma is the same colour with the opposite hue, so |c| is the chroma
+      if (after.c > Math.abs(before.c ?? 0) + 1e-9) fail(`clampChroma(${show(c)}, ${lchMode}) increased chroma: ${show(before)} -> ${show(after)}`);
+      if (before.h !== undefined && after.h !== undefined && after.c > 1e-3 * range(lchMode, "c") && !hueClose(before.h, after.h, 1e-3)) fail(`clampChroma(${show(c)}, ${lchMode}) changed hue: ${show(before)} -> ${show(after)}`);
+    }
+  }
+  // toGamut returns a colour of the destination, in gamut, unchanged when already in gamut
+  const tg = C.toGamut(dest)(c);
+  if (tg.mode !== dest) fail(`toGamut(${dest})(${show(c)}) is in mode ${tg.mode}`);
+  if (!finite(tg)) fail(`toGamut(${dest})(${show(c)}) = ${show(tg)}`);
+  const tgChannels = C.getMode(dest).channels.filter((ch) => ch !== "alpha" && tg[ch] !== undefined).length;
+  if (tgChannels === 0) {
+    const l = C.oklch(c).l;
+    if (HSL_FAMILY.includes(dest) && (l <= 0 || l >= 1 || l === undefined)) {
+      count("togamut-empty");
+      if (!full) return; // culori/20: black and white have no channels in an HSL-family destination
+    }
+    fail(`toGamut(${dest})(${show(c)}) = ${show(tg)} has no channels${HSL_FAMILY.includes(dest) ? "; known culori/20 (black or white into an HSL-family space)" : ""}`);
+  }
+  if (!inDest(tg)) {
+    const gamutMode = typeof C.getMode(dest).gamut === "string" ? C.getMode(dest).gamut : dest;
+    const r = C.converter(gamutMode)(tg);
+    const slack = Math.max(gamutSlack(dest), gamutSlack(c.mode));
+    if (["r", "g", "b"].some((ch) => r[ch] < -slack || r[ch] > 1 + slack)) fail(`toGamut(${dest})(${show(c)}) = ${show(tg)} is out of gamut: ${show(r)}`);
+  }
+  {
+    // well inside the destination gamut (a margin keeps conversion noise from flipping the test)
+    const gamutMode = typeof C.getMode(dest).gamut === "string" ? C.getMode(dest).gamut : dest;
+    const r = C.converter(gamutMode)(c);
+    if (["r", "g", "b"].every((ch) => r[ch] >= 0.01 && r[ch] <= 0.99)) {
+      // compared as sRGB: the destination may have several spellings of one colour (hwb with w + b > 1)
+      const back = C.rgb(tg);
+      const slack = Math.max(gamutSlack(c.mode), gamutSlack(dest));
+      if (["r", "g", "b"].some((ch) => !close(back[ch], rgb[ch], slack))) fail(`toGamut(${dest}) changed an in-gamut colour ${show(c)}: ${show(tg)} is ${show(back)}, not ${show(rgb)}`);
+    }
+  }
+  if ((c.alpha === undefined) !== (tg.alpha === undefined) || (c.alpha !== undefined && !close(c.alpha, tg.alpha, 1e-12))) fail(`toGamut(${dest})(${show(c)}) alpha: ${show(tg)}`);
+});
+
+// ---- 10. WCAG -------------------------------------------------------------------------------------
+
+property("TestHegelWcagAgreesWithColorjs", (tc) => {
+  const a = G.rgbColor(tc, { alpha: false });
+  const b = G.rgbColor(tc, { alpha: false });
+  const la = C.wcagLuminance(a);
+  const lj = O.colorjsLuminance(a);
+  if (!close(la, lj, 1e-4)) fail(`wcagLuminance(${show(a)}) = ${la}, colorjs ${lj}`);
+  if (la < -1e-12 || la > 1 + 1e-12) fail(`wcagLuminance(${show(a)}) = ${la}`);
+  const ca = C.wcagContrast(a, b);
+  const cj = O.colorjsContrast(a, b);
+  if (!close(ca, cj, 1e-3 * cj)) fail(`wcagContrast(${show(a)}, ${show(b)}) = ${ca}, colorjs ${cj}`);
+  if (ca < 1 || ca > 21 + 1e-9) fail(`wcagContrast(${show(a)}, ${show(b)}) = ${ca}`);
+  if (C.wcagContrast(b, a) !== ca) fail(`wcagContrast is not symmetric: ${ca} vs ${C.wcagContrast(b, a)} for ${show(a)}, ${show(b)}`);
+  if (C.wcagContrast(a, a) !== 1) fail(`wcagContrast(a, a) = ${C.wcagContrast(a, a)} for ${show(a)}`);
+});
+
+// ---- 11. filters and random -----------------------------------------------------------------------
+
+property("TestHegelFiltersFollowTheSpecification", (tc) => {
+  const c = G.rgbColor(tc);
+  const mode = pick(tc, ["rgb", "lrgb"]);
+  const inMode = C.converter(mode)(c);
+  const same = (name, f) => {
+    const r = f(c);
+    const bad = sameColor(r, c, 1e-12, {});
+    if (bad) fail(`${name} is not the identity on ${show(c)}: ${show(r)}: ${bad}`);
+  };
+  same("filterBrightness(1)", C.filterBrightness(1, mode));
+  same("filterContrast(1)", C.filterContrast(1, mode));
+  same("filterSaturate(1)", C.filterSaturate(1, mode));
+  same("filterGrayscale(0)", C.filterGrayscale(0, mode));
+  same("filterSepia(0)", C.filterSepia(0, mode));
+  same("filterInvert(0)", C.filterInvert(0, mode));
+  same("filterHueRotate(0)", C.filterHueRotate(0, mode));
+  const amt = G.real(tc, 0, 2);
+  const br = C.converter(mode)(C.filterBrightness(amt, mode)(c));
+  for (const ch of ["r", "g", "b"]) if (!close(br[ch], inMode[ch] * amt, 1e-12)) fail(`filterBrightness(${amt}, ${mode})(${show(c)}) = ${show(br)}`);
+  const ct = C.converter(mode)(C.filterContrast(amt, mode)(c));
+  for (const ch of ["r", "g", "b"]) if (!close(ct[ch], (inMode[ch] - 0.5) * amt + 0.5, 1e-12)) fail(`filterContrast(${amt}, ${mode})(${show(c)}) = ${show(ct)}`);
+  const inv = C.converter(mode)(C.filterInvert(1, mode)(c));
+  for (const ch of ["r", "g", "b"]) if (!close(inv[ch], 1 - inMode[ch], 1e-12)) fail(`filterInvert(1, ${mode})(${show(c)}) = ${show(inv)}`);
+  const gray = C.converter(mode)(C.filterGrayscale(1, mode)(c));
+  if (!close(gray.r, gray.g, 1e-12) || !close(gray.g, gray.b, 1e-12)) fail(`filterGrayscale(1, ${mode})(${show(c)}) = ${show(gray)} is not gray`);
+  for (const f of [C.filterSepia(amt / 2, mode), C.filterSaturate(amt, mode), C.filterHueRotate(amt * 180, mode), C.filterGrayscale(amt / 2, mode)]) {
+    const r = f(c);
+    if (r.mode !== c.mode) fail(`a filter changed the mode of ${show(c)}: ${show(r)}`);
+    if (r.alpha !== c.alpha) fail(`a filter changed alpha of ${show(c)}: ${show(r)}`);
+    if (!finite(r)) fail(`a filter gave ${show(r)} for ${show(c)}`);
+  }
+  // random colours respect their constraints and ranges
+  const rmode = pick(tc, G.MODES);
+  const def = C.getMode(rmode);
+  const constraints = {};
+  for (const ch of def.channels) {
+    if (chance(tc, 40)) {
+      const [lo, hi] = def.ranges[ch];
+      constraints[ch] = chance(tc, 50) ? G.real(tc, lo, hi) : [G.real(tc, lo, hi), G.real(tc, lo, hi)].sort((x, y) => x - y);
+    }
+  }
+  const rnd = C.random(rmode, constraints);
+  if (rnd.mode !== rmode) fail(`random(${rmode}) mode ${rnd.mode}`);
+  for (const ch of def.channels) {
+    const v = rnd[ch];
+    if (ch === "alpha" && constraints.alpha === undefined) {
+      if (v !== undefined) fail(`random(${rmode}, ${show(constraints)}) has alpha: ${show(rnd)}`);
+      continue;
+    }
+    const lim = constraints[ch] === undefined ? def.ranges[ch] : Array.isArray(constraints[ch]) ? constraints[ch] : [constraints[ch], constraints[ch]];
+    if (!(v >= lim[0] && v <= lim[1])) fail(`random(${rmode}, ${show(constraints)}) ${ch} = ${v} outside ${show(lim)}: ${show(rnd)}`);
+  }
+});
