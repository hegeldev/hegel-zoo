+    assert.ok(h >= 0 && h < 360, `${s}: h = ${h}`);
+  }
+});
+
+pin("TestHegelPinBlendLeavesItsInputsAlone", () => {
+  // culori/17: blend sets alpha = 1 on the caller's colour objects
+  const c = { mode: "rgb", r: 1, g: 0, b: 0 };
+  C.blend([c, "blue"]);
+  assert.deepEqual(c, { mode: "rgb", r: 1, g: 0, b: 0 });
+});
+
+pin("TestHegelPinColorStopPositionsAreFixedUpInSpecOrder", () => {
+  // culori/18: a stop positioned before an earlier one, after implicit stops, is not moved forward
+  const c = C.interpolate([["red", 0.5], "lime", ["blue", 0.2], "black"])(0.6);
+  assert.equal(C.formatHex(c), "#0000cc");
+});
+
+pin("TestHegelPinJzazbzInvertsItself", () => {
+  // culori/19: rgb -> jab -> rgb is off by 1e-3 (white comes back as r = 1.001, so it is not displayable)
+  const back = C.rgb(C.jab("white"));
+  assert.ok(Math.abs(back.r - 1) < 1e-6 && Math.abs(back.g - 1) < 1e-6 && Math.abs(back.b - 1) < 1e-6, show(back));
+  assert.ok(C.displayable(C.jab("white")));
+});
+
+pin("TestHegelPinToGamutIntoHslGivesBlackAndWhite", () => {
+  // culori/20: toGamut into an HSL-family space returns a colour without channels for black or white
+  const black = C.toGamut("hsl")("black");
+  assert.ok(black.l !== undefined, show(black));
+  const white = C.toGamut("hsv")("white");
+  assert.ok(white.v !== undefined, show(white));
+});
+
+pin("TestHegelPinRgbToHslFollowsCssColor4OutsideTheGamut", () => {
+  // culori/6: a colour with lightness above 1 gets a negative saturation (the spec flips the hue instead)
+  const hsl = C.hsl({ mode: "rgb", r: 1.2, g: 1.1, b: 1.05 });
+  assert.ok(hsl.s >= 0, `s = ${hsl.s}`);
+  const white = C.hsl({ mode: "rgb", r: 1.5, g: 0.5, b: 1 });
+  assert.ok(Number.isFinite(white.s), `s = ${white.s}`);
+});
