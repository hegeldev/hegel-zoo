+// ---- pins: one plain test per recorded bug ------------------------------------------------------
+
+pin("TestHegelPinParseReturnsUndefinedForMalformedNumbers", () => {
+  // culori/1: parse() is documented to return undefined when no parser matches; it throws instead
+  for (const s of ["rgb(1e 0 0)", "rgb(5px 0 0)", "hsl(120DEG 50% 50%)", "lab(50 20 -30x)"]) {
+    let got;
+    assert.doesNotThrow(() => (got = C.parse(s)), `parse(${JSON.stringify(s)}) threw`);
+  }
+});
+
+pin("TestHegelPinParseIsCaseInsensitive", () => {
+  // culori/2: CSS function names, keywords and units are ASCII case-insensitive
+  assert.deepEqual(C.parse("RGB(255 0 0)"), C.parse("rgb(255 0 0)"));
+  assert.deepEqual(C.parse("HSL(120, 50%, 50%)"), C.parse("hsl(120, 50%, 50%)"));
+  assert.deepEqual(C.parse("Transparent"), C.parse("transparent"));
+  assert.deepEqual(C.parse("hsl(120DEG 50% 50%)"), C.parse("hsl(120deg 50% 50%)"));
+});
+
+pin("TestHegelPinParseIgnoresSurroundingWhitespace", () => {
+  // culori/3: whitespace around a functional colour is ignored, around a hex/named/legacy one it is not
+  assert.deepEqual(C.parse(" red "), C.parse("red"));
+  assert.deepEqual(C.parse(" #abc "), C.parse("#abc"));
+  assert.deepEqual(C.parse(" rgb(255, 0, 0) "), C.parse("rgb(255, 0, 0)"));
+});
+
+pin("TestHegelPinHslSaturationClampsAlikeInBothSyntaxes", () => {
+  // culori/4: CSS Color 4 clamps a negative saturation to 0 and nothing else; the two syntaxes disagree
+  assert.deepEqual(C.parse("hsl(120 150% 50%)"), C.parse("hsl(120, 150%, 50%)"));
+  assert.equal(C.parse("hsl(120 -50% 50%)").s, 0);
+});
+
+pin("TestHegelPinNearestCanReturnEveryColor", () => {
+  // culori/5: nearest(colors)(color, n) caps n at colors.length - 1
+  const near = C.nearest(["red", "lime", "blue"]);
+  assert.equal(near("black", 3).length, 3);
+});
+
+pin("TestHegelPinInterpolationHintOfZeroIsHonoured", () => {
+  // culori/7: a hint of 0 is looked up as `fns[idx] || fns[0]` and so ignored
+  const withHint = C.interpolate(["red", 0, "blue"])(0.25);
+  const withMidpoint = C.interpolate(["red", C.easingMidpoint(0), "blue"])(0.25);
+  assert.deepEqual(withHint, withMidpoint);
+});
+
+pin("TestHegelPinRemoveParserRemovesTheFirstParser", () => {
+  // culori/8: removeParser tests `idx > 0`, so the first registered parser function stays
+  const { parse, parseHsl, useParser, removeParser } = C;
+  removeParser(parseHsl);
+  try {
+    assert.equal(parse("hsl(120 50% 50%)"), undefined);
+  } finally {
+    useParser(parseHsl, "hsl");
+  }
+});
