+    expected = obj;
+    // mutations that make the string invalid
+    if (chance(tc, 20)) {
+      const m = pick(tc, ["comma", "percent-hue", "hue-elsewhere", "two", "five", "alpha-no-slash", "extra-paren", "unknown-fn", "unknown-profile", "trailing-ident", "empty-slash"]);
+      if (m === "comma" && !profile) {
