+    if (chance(tc, 50)) {
+      const a = alphaToken(tc, { legacy: true });
+      inner += comma() + a.text;
+      obj.alpha = a.value;
+    }
+    text = `${name}(${ows(tc)}${inner}${ows(tc)})`;
+    if (full && chance(tc, 8)) {
+      text = ws(tc) + text + (chance(tc, 50) ? ws(tc) : "");
+      shapes.push("padded");
+    }
+    return { text, expected: obj, shapes };
+  }
+  if (form === "modern" || form === "color") {
+    let name;
+    let mode;
+    let spec;
+    let profile;
+    if (form === "modern") {
+      const fn = pick(tc, Object.keys(FUNCTIONS));
+      spec = FUNCTIONS[fn];
+      name = pick(tc, spec.names);
+      mode = FN_MODES[fn];
+    } else {
+      profile = pick(tc, Object.keys(PROFILES));
+      mode = PROFILES[profile];
+      name = "color";
+    }
+    if (full && chance(tc, 6)) {
+      name = chance(tc, 50) ? name.toUpperCase() : name[0].toUpperCase() + name.slice(1);
+      shapes.push("upper-fn");
+    }
+    const chans = getMode(mode).channels.filter((c) => c !== "alpha");
+    const toks = [];
+    const obj = { mode };
+    for (let i = 0; i < 3; i++) {
+      let tok;
+      if (spec) {
+        const kinds = [...spec.chans[i], "none"];
+        const kind = pick(tc, kinds);
+        const [lo, hi] = spec.ranges[i];
+        const [plo, phi] = spec.pranges ? spec.pranges[i] : [0, 100];
+        tok = channelToken(tc, kind, { lo, hi, plo, phi, shapes: full ? shapes : null });
+        if (full && mode === "hsl" && i > 0 && chance(tc, 8)) {
+          const t = numberToken(tc, i === 1 ? -50 : 101, i === 1 ? -1 : 150, { integer: true });
