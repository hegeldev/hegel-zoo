+  text = pick(tc, ["", " ", "#", "rgb", "rgb(", "rgb()", "red)", "(255 0 0)", "255 0 0", "rgb(255 0 0 / 0.5 / 0.5)", "hsl(120 50% 50% 0.5)", "lab(50 20)", "color()", "color(srgb)", "notacolor", "rgb(255 0 0 /)", "rgb(/ 0 0)", "rgb(255, 0 0)", "hsl(120, 50, 50)", "hsl(120 50% 50%,)"]);
