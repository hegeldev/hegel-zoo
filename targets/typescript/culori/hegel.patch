+// Generators for the culori tests: colours in any mode, CSS colour strings with their expected
+// parse (from the CSS Color Level 4 grammar as culori's documentation describes it), and the
+// pieces of an interpolation call.
+
+import { chance, n, pick, word } from "./hegel-zoo.mjs";
+import { colorsNamed, getMode } from "../src/index.js";
+
+export const FULL = !!process.env.ZOO_FULL;
+
+export const MODES = ["a98", "cubehelix", "dlab", "dlch", "hsi", "hsl", "hsv", "hwb", "itp", "jab", "jch", "lab", "lab65", "lch", "lch65", "lchuv", "lrgb", "luv", "okhsl", "okhsv", "oklab", "oklch", "p3", "prophoto", "rec2020", "rgb", "xyb", "xyz50", "xyz65", "yiq"];
+export const HUE_MODES = MODES.filter((m) => getMode(m).channels.includes("h"));
+
+/** A float in [lo, hi] (1e6 steps), with the ends and the middle over-represented. */
+export function real(tc, lo, hi) {
+  if (chance(tc, 10)) return pick(tc, [lo, hi, (lo + hi) / 2]);
+  return lo + ((hi - lo) * n(tc, 0, 1000000)) / 1000000;
+}
+
+/** An sRGB colour; in gamut unless `oog`, then channels in [-1, 2]. */
+export function rgbColor(tc, { oog = false, alpha = true } = {}) {
+  const ch = () => {
+    if (oog && chance(tc, 40)) return real(tc, -1, 2);
+    if (chance(tc, 15)) return pick(tc, [0, 1, 0.5, 1 / 255, 254 / 255, 0.001]);
+    return real(tc, 0, 1);
+  };
+  const c = { mode: "rgb", r: ch(), g: ch(), b: ch() };
+  if (chance(tc, 20)) c.g = c.b = c.r; // a gray
+  if (alpha && chance(tc, 30)) c.alpha = pick(tc, [0, 1, real(tc, 0, 1)]);
+  return c;
+}
+
+/** A colour in `mode` with channels drawn from the mode's reference ranges (`missing`: some channels undefined). */
+export function colorIn(tc, mode, { missing = false, alpha = true, outside = false } = {}) {
+  const def = getMode(mode);
+  const c = { mode };
+  for (const ch of def.channels) {
+    if (ch === "alpha") continue;
+    if (missing && chance(tc, 15)) continue;
+    const [lo, hi] = def.ranges[ch];
+    c[ch] = outside && chance(tc, 25) ? real(tc, lo - (hi - lo), hi + (hi - lo)) : real(tc, lo, hi);
+  }
+  // okhsl with l = 0 (or missing) and chroma is the shape of culori/15 (NaN): CLEAN keeps clear of it
+  if (!FULL && mode === "okhsl" && (c.l === 0 || c.l === undefined)) c.l = 0.001;
+  // a negative hsl saturation is the shape of culori/4 (not clamped as CSS Color 4 says)
+  if (!FULL && mode === "hsl" && c.s < 0) c.s = -c.s;
+  if (alpha && chance(tc, 30)) c.alpha = pick(tc, [0, 1, real(tc, 0, 1)]);
+  return c;
+}
+
+/** Either an sRGB colour or a colour in a random mode. */
+export function anyColor(tc, opts = {}) {
+  return chance(tc, 40) ? rgbColor(tc, opts) : colorIn(tc, pick(tc, MODES), opts);
+}
+
+// ---- CSS colour strings -----------------------------------------------------------------------
+
+const WS = [" ", " ", " ", "  ", "\t", "\n", " \n "];
+const ws = (tc) => pick(tc, WS);
+const ows = (tc) => (chance(tc, 30) ? "" : chance(tc, 80) ? " " : ws(tc)); // optional whitespace
+const clamp01 = (v) => Math.min(1, Math.max(0, v));
+
+/** A CSS <number> as text and value; `legacy` keeps to what the legacy regex accepts. */
+function numberToken(tc, lo, hi, { integer = false, legacy = false } = {}) {
+  let text;
+  if (integer || chance(tc, 40)) {
+    text = String(n(tc, Math.ceil(lo), Math.floor(hi)));
+  } else {
+    const v = real(tc, lo, hi);
+    text = v.toFixed(n(tc, 1, 3));
+  }
+  if (chance(tc, 15) && text.startsWith("0.")) text = text.slice(1); // .5
+  if (chance(tc, 10) && !text.startsWith("-") && !text.startsWith("+")) text = "+" + text;
+  if (chance(tc, 12)) {
+    // exponent form of the same value: 12.5 -> 1.25e1 / 125e-1
+    const v = Number(text);
+    const e = pick(tc, [-2, -1, 1, 2]);
+    let mant = (v / Math.pow(10, e)).toPrecision(8);
+    mant = String(Number(mant));
+    if (!/e/i.test(mant)) text = mant + pick(tc, ["e", "E"]) + (e < 0 || chance(tc, 30) ? (e < 0 ? "-" : "+") : "") + Math.abs(e);
+  }
+  if (legacy && !/^[+-]?\d*\.?\d+(?:[eE][+-]?\d+)?$/.test(text)) text = String(Math.round(Number(text)));
+  return { text, value: Number(text) };
+}
+
+const HUE_UNITS = { deg: 1, grad: 0.9, rad: 180 / Math.PI, turn: 360 };
+
+/** A channel token: number, percentage, hue (with a unit), or none. */
+function channelToken(tc, kind, { lo, hi, plo = 0, phi = 100, legacy = false, shapes }) {
+  if (kind === "none") return { type: "none", text: "none" };
+  if (kind === "percentage") {
+    const t = numberToken(tc, plo, phi, { legacy });
+    return { type: "percentage", text: t.text + "%", value: t.value };
+  }
+  if (kind === "hue") {
+    const t = numberToken(tc, lo, hi, { legacy });
+    let unit = pick(tc, Object.keys(HUE_UNITS));
+    const factor = HUE_UNITS[unit];
+    if (shapes && chance(tc, 8)) {
+      unit = unit.toUpperCase();
+      shapes.push("upper-unit");
+    }
+    return { type: "hue", text: t.text + unit, value: t.value * factor };
+  }
+  const t = numberToken(tc, lo, hi, { legacy });
+  return { type: "number", text: t.text, value: t.value };
+}
+
+const FUNCTIONS = {
+  // channel spec: kinds allowed, number range, percent scale (100% -> value * scale / 100), clamp
+  rgb: { names: ["rgb", "rgba"], chans: [["number", "percentage"], ["number", "percentage"], ["number", "percentage"]], ranges: [[0, 255], [0, 255], [0, 255]], value: (tok) => (tok.type === "number" ? tok.value / 255 : tok.value / 100) },
+  hsl: { names: ["hsl", "hsla"], chans: [["number", "hue"], ["number", "percentage"], ["number", "percentage"]], ranges: [[-400, 800], [0, 100], [0, 100]], value: (tok, i) => (i === 0 ? tok.value : tok.value / 100) },
+  hwb: { names: ["hwb"], chans: [["number", "hue"], ["number", "percentage"], ["number", "percentage"]], ranges: [[-400, 800], [0, 100], [0, 100]], value: (tok, i) => (i === 0 ? tok.value : tok.value / 100) },
+  lab: { names: ["lab"], chans: [["number", "percentage"], ["number", "percentage"], ["number", "percentage"]], ranges: [[0, 100], [-125, 125], [-125, 125]], pranges: [[0, 100], [-100, 100], [-100, 100]], value: (tok, i) => (i === 0 ? Math.min(100, Math.max(0, tok.value)) : tok.type === "number" ? tok.value : (tok.value * 125) / 100) },
+  lch: { names: ["lch"], chans: [["number", "percentage"], ["number", "percentage"], ["number", "hue"]], ranges: [[0, 100], [0, 150], [-400, 800]], pranges: [[0, 100], [0, 100], [0, 100]], value: (tok, i) => (i === 0 ? Math.min(100, Math.max(0, tok.value)) : i === 1 ? Math.max(0, tok.type === "number" ? tok.value : (tok.value * 150) / 100) : tok.value) },
+  oklab: { names: ["oklab"], chans: [["number", "percentage"], ["number", "percentage"], ["number", "percentage"]], ranges: [[0, 1], [-0.4, 0.4], [-0.4, 0.4]], pranges: [[0, 100], [-100, 100], [-100, 100]], value: (tok, i) => (i === 0 ? Math.min(1, Math.max(0, tok.type === "number" ? tok.value : tok.value / 100)) : tok.type === "number" ? tok.value : (tok.value * 0.4) / 100) },
+  oklch: { names: ["oklch"], chans: [["number", "percentage"], ["number", "percentage"], ["number", "hue"]], ranges: [[0, 1], [0, 0.4], [-400, 800]], pranges: [[0, 100], [0, 100], [0, 100]], value: (tok, i) => (i === 0 ? Math.min(1, Math.max(0, tok.type === "number" ? tok.value : tok.value / 100)) : i === 1 ? Math.max(0, tok.type === "number" ? tok.value : (tok.value * 0.4) / 100) : tok.value) },
+};
+const FN_MODES = { rgb: "rgb", hsl: "hsl", hwb: "hwb", lab: "lab", lch: "lch", oklab: "oklab", oklch: "oklch" };
+
+// color() profiles: identifier -> mode
+export const PROFILES = {
+  srgb: "rgb", "srgb-linear": "lrgb", "display-p3": "p3", "a98-rgb": "a98", "prophoto-rgb": "prophoto", rec2020: "rec2020", xyz: "xyz65", "xyz-d50": "xyz50", "xyz-d65": "xyz65",
+  "--hsv": "hsv", "--hsi": "hsi", "--cubehelix": "cubehelix", "--din99o-lab": "dlab", "--din99o-lch": "dlch", "--ictcp": "itp", "--jzazbz": "jab", "--jzczhz": "jch", "--lab-d65": "lab65", "--lch-d65": "lch65", "--lchuv": "lchuv", "--luv": "luv", "--okhsl": "okhsl", "--okhsv": "okhsv", "--xyb": "xyb", "--yiq": "yiq",
+};
+
+function alphaToken(tc, { legacy = false } = {}) {
+  const kind = legacy ? pick(tc, ["number", "percentage"]) : pick(tc, ["number", "number", "percentage", "none"]);
+  if (kind === "none") return { type: "none", text: "none" };
+  if (kind === "percentage") {
+    const t = numberToken(tc, 0, 100, { legacy });
+    if (chance(tc, 10)) t.text = pick(tc, ["150", "-20"]), (t.value = Number(t.text));
+    return { type: "percentage", text: t.text + "%", value: clamp01(t.value / 100) };
+  }
+  const t = numberToken(tc, 0, 1, { legacy });
+  if (chance(tc, 10)) t.text = pick(tc, ["2", "-1", "1.5"]), (t.value = Number(t.text));
+  return { type: "number", text: t.text, value: clamp01(t.value) };
+}
+
+/** Sets `key` on `obj` unless the token is `none`. */
+function put(obj, key, tok, value) {
+  if (tok.type !== "none") obj[key] = value;
+}
+
+/**
+ * A CSS colour string with the object `parse` should return (`undefined` for an invalid string)
+ * and the bug shapes it exercises. `full` allows the shapes of the recorded bugs.
+ */
+export function cssColor(tc, { full = false } = {}) {
+  const shapes = [];
+  const form = pick(tc, ["hex", "named", "modern", "modern", "modern", "legacy", "color", "color", "invalid"]);
+  let text;
+  let expected;
+  const pad = (s) => {
+    if (full && chance(tc, 10)) {
+      shapes.push("padded");
+      return ws(tc) + s + ws(tc);
+    }
+    return s;
+  };
+  if (form === "hex") {
+    const len = pick(tc, [3, 4, 6, 8]);
+    const digits = word(tc, [..."0123456789abcdef"], len, len);
+    const cased = chance(tc, 30) ? digits.toUpperCase() : digits;
+    text = (chance(tc, 85) ? "#" : "") + cased;
+    const v = parseInt(digits, 16);
+    const x = (d) => d / 255;
+    if (len === 3) expected = { mode: "rgb", r: x(((v >> 8) & 0xf) * 17), g: x(((v >> 4) & 0xf) * 17), b: x((v & 0xf) * 17) };
+    else if (len === 4) expected = { mode: "rgb", r: x(((v >> 12) & 0xf) * 17), g: x(((v >> 8) & 0xf) * 17), b: x(((v >> 4) & 0xf) * 17), alpha: x((v & 0xf) * 17) };
+    else if (len === 6) expected = { mode: "rgb", r: x((v >> 16) & 0xff), g: x((v >> 8) & 0xff), b: x(v & 0xff) };
+    else expected = { mode: "rgb", r: x((v >>> 24) & 0xff), g: x((v >> 16) & 0xff), b: x((v >> 8) & 0xff), alpha: x(v & 0xff) };
+    if (full && chance(tc, 10)) {
+      // a malformed hex code
+      text = "#" + word(tc, [..."0123456789abcdefg"], pick(tc, [1, 2, 5, 7, 9]), 9);
+      expected = /^#([0-9a-f]{3}|[0-9a-f]{4}|[0-9a-f]{6}|[0-9a-f]{8})$/i.test(text) ? expected : undefined;
+      if (expected !== undefined) return cssColor(tc, { full });
+    }
+    text = pad(text);
+    if (shapes.includes("padded")) expected = expected; // CSS trims: same colour expected
+    return { text, expected, shapes };
+  }
+  if (form === "named") {
+    const names = Object.keys(colorsNamed);
+    if (chance(tc, 8)) {
+      const t = "transparent";
+      text = !full || chance(tc, 70) ? t : pick(tc, ["Transparent", "TRANSPARENT"]);
+      if (text !== t) shapes.push("upper-fn");
+      return { text: pad(text), expected: { mode: "rgb", r: 0, g: 0, b: 0, alpha: 0 }, shapes };
+    }
+    const name = pick(tc, names);
+    const v = colorsNamed[name];
+    expected = { mode: "rgb", r: ((v >> 16) & 0xff) / 255, g: ((v >> 8) & 0xff) / 255, b: (v & 0xff) / 255 };
+    text = chance(tc, 25) ? name.toUpperCase() : chance(tc, 15) ? name[0].toUpperCase() + name.slice(1) : name;
+    return { text: pad(text), expected, shapes };
+  }
+  if (form === "legacy") {
+    // rgb(a)(n, n, n[, a]) with all numbers or all percentages; hsl(a)(hue, %, %[, a])
+    const fn = pick(tc, ["rgb", "hsl"]);
+    const spec = FUNCTIONS[fn];
+    let name = pick(tc, spec.names);
+    if (full && chance(tc, 8)) {
+      name = name.toUpperCase();
+      shapes.push("upper-fn");
+    }
+    const comma = () => ows(tc) + "," + ows(tc);
+    const toks = [];
+    let obj = { mode: FN_MODES[fn] };
+    if (fn === "rgb") {
+      const kind = pick(tc, ["number", "percentage"]);
+      for (let i = 0; i < 3; i++) toks.push(channelToken(tc, kind, { lo: 0, hi: 255, legacy: true }));
+      const chans = ["r", "g", "b"];
+      toks.forEach((t, i) => (obj[chans[i]] = spec.value(t, i)));
+    } else {
+      toks.push(channelToken(tc, pick(tc, ["number", "hue"]), { lo: -400, hi: 800, legacy: true, shapes: full ? shapes : null }));
+      toks.push(channelToken(tc, "percentage", { plo: 0, phi: 100, legacy: true }));
+      toks.push(channelToken(tc, "percentage", { plo: 0, phi: 100, legacy: true }));
+      if (full && chance(tc, 10)) {
+        // saturation or lightness outside 0..100%
+        const i = pick(tc, [1, 2]);
+        const t = numberToken(tc, i === 1 ? -50 : 101, i === 1 ? -1 : 150, { integer: true });
+        toks[i] = { type: "percentage", text: t.text + "%", value: t.value };
+        shapes.push("hsl-oob");
+      }
