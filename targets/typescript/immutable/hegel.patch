diff --git a/test/hegel-zoo.mjs b/test/hegel-zoo.mjs
new file mode 100644
index 0000000..ef914e1
--- /dev/null
+++ b/test/hegel-zoo.mjs
@@ -0,0 +1,138 @@
+// Hegel zoo: the small harness shared by the zoo's TypeScript/JavaScript targets.
+//
+// `property(name, body)` registers a node:test test that runs `body(tc)` under Hegel with
+// HEGEL_TEST_CASES cases (default 100) and the database at HEGEL_DATABASE. With ZOO_COLLECT=1
+// a `fail()` records the mismatch instead of failing, the case ends there, and the counts of
+// mismatches and of the shapes seen (`count(key)`) are printed at the end of the test, so a
+// property can be run over many cases to see every shape at once. `pin(name, body)` is a
+// plain test for one pinned bug: it must fail while the bug is present and pass once it is
+// fixed (the zoo's judge reads an unexpected pass as "fixed upstream?").
+
+import { readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { test as nodeTest } from "node:test";
+import * as hegel from "@hegeldev/hegel";
+import * as gs from "@hegeldev/hegel/generators";
+
+// The Hegel version these tests were written against (the zoo pins it in zoo.toml and installs
+// it with `npm install --no-save @hegeldev/hegel@<version>`; upstream would add it to
+// devDependencies). Checked at load time so a stray install cannot silently change the engine.
+export const HEGEL_PIN = { "@hegeldev/hegel": "0.4.5" };
+
+{
+  let dir = dirname(fileURLToPath(import.meta.resolve("@hegeldev/hegel")));
+  while (!/[\\/]hegel$/.test(dir) && dir !== dirname(dir)) dir = dirname(dir);
+  const installed = JSON.parse(readFileSync(join(dir, "package.json"), "utf8")).version;
+  if (installed !== HEGEL_PIN["@hegeldev/hegel"]) {
+    throw new Error(`@hegeldev/hegel ${installed} is installed; these tests pin ${HEGEL_PIN["@hegeldev/hegel"]}`);
+  }
+}
+
+export const collecting = !!process.env.ZOO_COLLECT;
+
+class Collected extends Error {}
+
+let msgs = [];
+let stats = new Map();
+
+/** Report a mismatch: an error normally, a recorded line in collect mode. */
+export function fail(message) {
+  if (collecting) {
+    msgs.push(message);
+    throw new Collected(message);
+  }
+  throw new Error(message);
+}
+
+/** Bump a statistic (the shape of a pinned bug, a generator branch). */
+export function count(key) {
+  stats.set(key, (stats.get(key) || 0) + 1);
+}
+
+function settings() {
+  const s = { testCases: Number(process.env.HEGEL_TEST_CASES) || 100 };
+  if (process.env.HEGEL_DATABASE) {
+    s.database = hegel.Database.fromPath(process.env.HEGEL_DATABASE);
+  }
+  return s;
+}
+
+/** A property: `body(tc)` runs under Hegel; a thrown error (or `fail`) is a failure. */
+export function property(name, body) {
+  nodeTest(name, () => {
+    msgs = [];
+    stats = new Map();
+    hegel.test((tc) => {
+      try {
+        body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** A pin: a plain test for one recorded bug. */
+export function pin(name, body) {
+  nodeTest(name, body);
+}
+
+/** An integer in [lo, hi]. */
+export function n(tc, lo, hi) {
+  return tc.draw(gs.integers({ minValue: lo, maxValue: hi }));
+}
+
+/** One of xs. */
+export function pick(tc, xs) {
+  return xs[n(tc, 0, xs.length - 1)];
+}
+
+/** True pct percent of the time. */
+export function chance(tc, pct) {
+  return n(tc, 0, 99) < pct;
+}
+
+/** A string of `len` characters drawn from `alphabet` (an array of strings). */
+export function word(tc, alphabet, lo, hi) {
+  const len = n(tc, lo, hi);
+  let s = "";
+  for (let i = 0; i < len; i++) {
+    s += pick(tc, alphabet);
+  }
+  return s;
+}
+
+/** Structural equality: arrays by position, objects by key set (prototype ignored), else ===. */
+export function same(a, b) {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) {
+      return false;
+    }
+    return a.every((x, i) => same(x, b[i]));
+  }
+  if (a !== null && b !== null && typeof a === "object" && typeof b === "object") {
+    const ka = Object.keys(a).sort();
+    const kb = Object.keys(b).sort();
+    if (ka.length !== kb.length || ka.some((k, i) => k !== kb[i])) {
+      return false;
+    }
+    return ka.every((k) => same(a[k], b[k]));
+  }
+  return a === b;
+}
+
+/** A compact, unambiguous rendering for messages. */
+export function show(x) {
+  return JSON.stringify(x, (k, v) => (v === undefined ? "<undefined>" : v));
+}
diff --git a/test/hegel.test.mjs b/test/hegel.test.mjs
new file mode 100644
index 0000000..5fab61b
--- /dev/null
+++ b/test/hegel.test.mjs
@@ -0,0 +1,1056 @@
+// Hegel zoo: property tests for Immutable.js (immutable-js/immutable-js). See the target's README.md.
+// Run with `node --test test/hegel.test.mjs` after the setup has built test/.hegel/immutable.mjs
+// (test/tools/hegel-rollup.config.mjs).
+//
+// The oracles are models written here on plain JavaScript arrays (a List is an array, a Map is
+// an array of [key, value] pairs under the documented key equality, a Set an array of unique
+// keys), the documented rules of `is`/`hash`, `fromJS`/`toJS` inverses and call counters for
+// the laziness of `Seq`.
+
+import assert from "node:assert/strict";
+import * as I from "./.hegel/immutable.mjs";
+import { property, pin, fail, count, n, pick, chance, word, show } from "./hegel-zoo.mjs";
+
+const { List, Map, OrderedMap, Set, OrderedSet, Stack, Seq, Range, Repeat, Record, fromJS, is, hash } = I;
+
+// ---------------------------------------------------------------- values and their equality
+
+/** A custom value object: equal by `k`, hashing into one of a few buckets (collisions). */
+class VO {
+  constructor(k, bucket) {
+    this.k = k;
+    this.bucket = bucket;
+  }
+  equals(other) {
+    return other instanceof VO && other.k === this.k;
+  }
+  hashCode() {
+    return this.bucket;
+  }
+  toString() {
+    return `VO(${this.k})`;
+  }
+}
+
+// plain objects are keys and values by identity: a small pool of them
+const OBJECTS = [{ o: 1 }, { o: 2 }, [3]];
+
+/** SameValueZero: what `is` does for primitives (NaN equals NaN, 0 equals -0). */
+function sameValueZero(a, b) {
+  return a === b || (a !== a && b !== b);
+}
+
+/** The documented key equality: primitives by SameValueZero, value objects by equals(),
+ *  Immutable collections by value, other objects by identity. */
+function keyEq(a, b) {
+  if (a instanceof VO || b instanceof VO) return a instanceof VO && b instanceof VO && a.k === b.k;
+  if (I.isImmutable(a) || I.isImmutable(b)) {
+    if (!(I.isImmutable(a) && I.isImmutable(b))) return false;
+    return valEq(a, b);
+  }
+  return sameValueZero(a, b);
+}
+
+/** Deep value equality by the model's own means (not `is`). */
+function valEq(a, b) {
+  if (I.isList(a) || I.isList(b)) {
+    if (!(I.isList(a) && I.isList(b))) return false;
+    return arrEq(a.toArray(), b.toArray());
+  }
+  if (I.isMap(a) || I.isMap(b)) {
+    if (!(I.isMap(a) && I.isMap(b))) return false;
+    return entriesEq(a.entrySeq().toArray(), b.entrySeq().toArray());
+  }
+  if (I.isSet(a) || I.isSet(b)) {
+    if (!(I.isSet(a) && I.isSet(b))) return false;
+    return entriesEq(a.toArray().map((x) => [x, true]), b.toArray().map((x) => [x, true]));
+  }
+  return keyEq(a, b);
+}
+
+function arrEq(xs, ys) {
+  return xs.length === ys.length && xs.every((x, i) => valEq(x, ys[i]));
+}
+
+/** Two entry lists hold the same entries, in any order (keys unique). */
+function entriesEq(xs, ys) {
+  if (xs.length !== ys.length) return false;
+  const rest = ys.slice();
+  for (const [k, v] of xs) {
+    const j = rest.findIndex(([k2, v2]) => keyEq(k, k2) && valEq(v, v2));
+    if (j === -1) return false;
+    rest.splice(j, 1);
+  }
+  return rest.length === 0;
+}
+
+function showVal(x) {
+  if (x instanceof VO) return x.toString();
+  if (I.isImmutable(x)) return x.toString();
+  if (Array.isArray(x) || (x && typeof x === "object")) return `#${OBJECTS.indexOf(x)}`;
+  return show(x);
+}
+
+// ---------------------------------------------------------------- generators
+
+/** A primitive: small numbers (0 and -0, NaN), short strings ("1" is not 1), booleans, null, undefined. */
+function genPrim(tc) {
+  const r = n(tc, 0, 99);
+  if (r < 40) return n(tc, -3, 5);
+  if (r < 46) return pick(tc, [0, -0, NaN, 1.5, -2.5, 1e21, 2 ** 31]);
+  if (r < 80) return pick(tc, ["a", "b", "c", "1", "", "ab", "\u0000", "é"]);
+  if (r < 88) return pick(tc, [true, false]);
+  if (r < 94) return null;
+  return undefined;
+}
+
+/** A key: a primitive, a value object (with collisions), a List of primitives or a pooled object. */
+function genKey(tc) {
+  const r = n(tc, 0, 99);
+  if (r < 60) return genPrim(tc);
+  if (r < 80) return vo(n(tc, 0, 5));
+  if (r < 92) return List(Array.from({ length: n(tc, 0, 2) }, () => genPrim(tc)));
+  return pick(tc, OBJECTS);
+}
+
+/** A value: a primitive, a pooled object, or a small collection of primitives. */
+function genValue(tc) {
+  const r = n(tc, 0, 99);
+  if (r < 65) return genPrim(tc);
+  if (r < 75) return pick(tc, OBJECTS);
+  if (r < 85) return List(Array.from({ length: n(tc, 0, 3) }, () => genPrim(tc)));
+  if (r < 93) return Map(Array.from({ length: n(tc, 0, 2) }, () => [genPrim(tc), genPrim(tc)]));
+  return vo(n(tc, 0, 5));
+}
+
+/** A value object; equal objects must hash equally, so the bucket is a function of k (and two
+ *  buckets for six keys guarantees collisions). */
+function vo(k) {
+  return new VO(k, k % 2);
+}
+
+function genArray(tc, lo, hi, gen = genValue) {
+  return Array.from({ length: n(tc, lo, hi) }, () => gen(tc));
+}
+
+/** An index for a collection of the given size: inside, negative, or a bit beyond. */
+function genIndex(tc, size) {
+  const r = n(tc, 0, 9);
+  if (r < 5) return n(tc, 0, Math.max(0, size - 1));
+  if (r < 8) return -n(tc, 1, Math.max(1, size));
+  return size + n(tc, 0, 3);
+}
+
+/** JavaScript's index wrapping as the docs describe it (negative counts from the end). */
+function wrap(i, size) {
+  return i < 0 ? i + size : i;
+}
+
+/** Sort comparator the docs describe as the default (`<` and `>`; undefined last). */
+function defaultComparator(a, b) {
+  if (a === undefined && b === undefined) return 0;
+  if (a === undefined) return 1;
+  if (b === undefined) return -1;
+  return a > b ? 1 : a < b ? -1 : 0;
+}
+
+/** A stable sort of a copy. */
+function stableSort(xs, cmp) {
+  return xs
+    .map((x, i) => [x, i])
+    .sort((p, q) => cmp(p[0], q[0]) || p[1] - q[1])
+    .map((p) => p[0]);
+}
+
+/** Values a default-comparator sort orders totally: all numbers (no NaN) or all strings. */
+function sortable(xs) {
+  return (xs.every((x) => typeof x === "number" && x === x) || xs.every((x) => typeof x === "string"));
+}
+
+/** List#set on the model: negative indices count from the end, an index past the end grows the
+ *  list with undefined, and an index before the start (below -size) grows it at the front. */
+function modelListSet(xs, i, v) {
+  const size = xs.length;
+  const j = wrap(i, size);
+  if (j < 0) return [v, ...Array(-j - 1).fill(undefined), ...xs];
+  const out = xs.slice();
+  while (out.length <= j) out.push(undefined);
+  out[j] = v;
+  return out;
+}
+
+/** Slice bounds the way Array#slice reads them. */
+function sliceModel(xs, begin, end) {
+  return xs.slice(begin, end);
+}
+
+// ---------------------------------------------------------------- property 1: List vs array
+
+property("TestHegelListMatchesTheArrayModel", (tc) => {
+  // mostly small lists; sometimes past the 32-item tail and the 1024-item second trie level
+  const big = chance(tc, 15);
+  count(big ? "big" : "small");
+  let model = genArray(tc, 0, big ? 1500 : 12);
+  let list = List(model);
+  const snapshots = []; // [list, array] pairs that must never change
+  const check = (what) => {
+    const arr = list.toArray();
+    if (!arrEq(arr, model) || list.size !== model.length) {
+      fail(`${what}: List ${list} (size ${list.size}) != model [${model.map(showVal)}]`);
+    }
+    for (const [l, a] of snapshots) {
+      if (!arrEq(l.toArray(), a)) fail(`${what}: an earlier List changed: ${l} was [${a.map(showVal)}]`);
+    }
+  };
+  check("List(array)");
+  const steps = n(tc, 1, 12);
+  for (let s = 0; s < steps; s++) {
+    const op = pick(tc, ["push", "pop", "unshift", "shift", "set", "set", "delete", "insert", "splice", "slice", "setSize", "reverse", "concat", "sort", "sortBy", "map", "filter", "take", "skip", "update", "withMutations", "asMutable", "zip", "interleave", "flatten"]);
+    count(`op:${op}`);
+    if (chance(tc, 30)) snapshots.push([list, model.slice()]);
+    const size = model.length;
+    let what = op;
+    switch (op) {
+      case "push": {
+        const vs = genArray(tc, 0, big ? 100 : 3);
+        list = list.push(...vs);
+        model = model.concat(vs);
+        break;
+      }
+      case "pop":
+        list = list.pop();
+        model = model.slice(0, -1);
+        break;
+      case "unshift": {
+        const vs = genArray(tc, 0, 3);
+        list = list.unshift(...vs);
+        model = vs.concat(model);
+        break;
+      }
+      case "shift":
+        list = list.shift();
+        model = model.slice(1);
+        break;
+      case "set": {
+        const i = genIndex(tc, size);
+        const v = genValue(tc);
+        what = `set(${i}, ${showVal(v)})`;
+        list = list.set(i, v);
+        model = modelListSet(model, i, v);
+        break;
+      }
+      case "delete": {
+        const i = genIndex(tc, size);
+        what = `delete(${i})`;
+        list = list.delete(i);
+        const j = wrap(i, size);
+        model = model.slice();
+        if (j >= 0 && j < size) model.splice(j, 1);
+        break;
+      }
+      case "insert": {
+        const i = n(tc, 0, size);
+        const v = genValue(tc);
+        what = `insert(${i}, ${showVal(v)})`;
+        list = list.insert(i, v);
+        model = model.slice();
+        model.splice(i, 0, v);
+        break;
+      }
+      case "splice": {
+        const i = chance(tc, 30) ? -n(tc, 1, Math.max(1, size)) : n(tc, 0, size);
+        const k = n(tc, 0, 3);
+        const vs = genArray(tc, 0, 2);
+        what = `splice(${i}, ${k}, ${vs.map(showVal)})`;
+        list = list.splice(i, k, ...vs);
+        model = model.slice();
+        model.splice(i, k, ...vs);
+        break;
+      }
+      case "slice": {
+        const b = chance(tc, 30) ? undefined : genIndex(tc, size);
+        const e = chance(tc, 30) ? undefined : genIndex(tc, size);
+        what = `slice(${b}, ${e})`;
+        list = list.slice(b, e);
+        model = sliceModel(model, b, e);
+        break;
+      }
+      case "setSize": {
+        const k = n(tc, 0, size + (big ? 1100 : 3));
+        what = `setSize(${k})`;
+        list = list.setSize(k);
+        model = model.slice(0, k);
+        while (model.length < k) model.push(undefined);
+        break;
+      }
+      case "reverse":
+        list = list.reverse();
+        model = model.slice().reverse();
+        break;
+      case "concat": {
+        const vs = genArray(tc, 0, 4);
+        const asList = chance(tc, 50);
+        list = list.concat(asList ? List(vs) : vs);
+        model = model.concat(vs);
+        break;
+      }
+      case "sort": {
+        if (!sortable(model)) break;
+        list = list.sort();
+        model = stableSort(model, defaultComparator);
+        break;
+      }
+      case "sortBy": {
+        const f = (v) => typeof v; // groups by type, stable inside a group
+        list = list.sortBy(f);
+        model = stableSort(model, (a, b) => defaultComparator(f(a), f(b)));
+        break;
+      }
+      case "map": {
+        const f = (v, i) => [i, v];
+        list = list.map(f).map((p) => p[1]);
+        break;
+      }
+      case "filter": {
+        const p = (v) => typeof v === "number" || typeof v === "string";
+        list = list.filter(p);
+        model = model.filter(p);
+        break;
+      }
+      case "take": {
+        const k = n(tc, 0, size + 2);
+        what = `take(${k})`;
+        list = list.take(k);
+        model = model.slice(0, k);
+        break;
+      }
+      case "skip": {
+        const k = n(tc, 0, size + 2);
+        what = `skip(${k})`;
+        list = list.skip(k);
+        model = model.slice(k);
+        break;
+      }
+      case "update": {
+        const i = genIndex(tc, size);
+        const v = genValue(tc);
+        what = `update(${i}, f)`;
+        let seen = "UNSEEN";
+        list = list.update(i, (old) => {
+          seen = old;
+          return [old, v];
+        });
+        const j = wrap(i, size);
+        const old = j >= 0 && j < size ? model[j] : undefined;
+        if (!valEq(seen, old)) fail(`update(${i}) passed ${showVal(seen)} to the updater, expected ${showVal(old)}`);
+        model = modelListSet(model, i, [old, v]);
+        // arrays compare by identity in valEq: hold the List's own pair in the model
+        model = modelListSet(model, i, list.get(i));
+        break;
+      }
+      case "withMutations": {
+        const vs = genArray(tc, 0, 4);
+        const i = n(tc, 0, size + 2);
+        const v = genValue(tc);
+        what = `withMutations(push ${vs.length}, set(${i}), pop)`;
+        list = list.withMutations((m) => {
+          m.push(...vs);
+          m.set(i, v);
+          m.pop();
+        });
+        model = model.concat(vs);
+        while (model.length <= i) model.push(undefined);
+        model[i] = v;
+        model = model.slice(0, -1);
+        break;
+      }
+      case "asMutable": {
+        const vs = genArray(tc, 0, 3);
+        const m = list.asMutable();
+        for (const v of vs) m.push(v);
+        const frozen = m.asImmutable();
+        if (frozen.size !== size + vs.length) fail(`asMutable/asImmutable: size ${frozen.size} after ${vs.length} pushes onto ${size}`);
+        list = frozen;
+        model = model.concat(vs);
+        break;
+      }
+      case "zip": {
+        const other = genArray(tc, 0, 5);
+        const zipped = list.zip(List(other));
+        const want = model.slice(0, Math.min(size, other.length)).map((v, i) => [v, other[i]]);
+        const got = zipped.toArray();
+        if (got.length !== want.length || !got.every((p, i) => Array.isArray(p) && valEq(p[0], want[i][0]) && valEq(p[1], want[i][1]))) {
+          fail(`zip: ${zipped} vs ${want.length} pairs`);
+        }
+        const all = list.zipAll(List(other)).toArray();
+        const len = Math.max(size, other.length);
+        if (all.length !== len || !all.every((p, i) => valEq(p[0], model[i]) && valEq(p[1], other[i]))) fail(`zipAll: ${show(all.length)} pairs for ${size} and ${other.length}`);
+        break;
+      }
+      case "interleave": {
+        const other = genArray(tc, 0, 5);
+        const got = list.interleave(List(other)).toArray();
+        const k = Math.min(size, other.length);
+        const want = [];
+        for (let i = 0; i < k; i++) want.push(model[i], other[i]);
+        if (!arrEq(got, want)) fail(`interleave: ${show(got.length)} items, expected ${want.length}`);
+        break;
+      }
+      case "flatten": {
+        const wrapped = list.map((v) => (chance(tc, 50) ? List([v]) : v));
+        const flat = wrapped.flatten(true).toArray();
+        const want = [];
+        // one level: every nested collection (List, Map, Set ...) contributes its values
+        for (const v of wrapped.toArray()) (I.isCollection(v) ? want.push(...v.valueSeq().toArray()) : want.push(v));
+        if (!arrEq(flat, want)) fail(`flatten(true): ${show(flat.length)} items, expected ${want.length}`);
+        break;
+      }
+      default:
+        throw new Error(op);
+    }
+    check(what);
+  }
+  // reads
+  const size = model.length;
+  if (size > 0) {
+    const i = genIndex(tc, size);
+    const j = wrap(i, size);
+    const want = j >= 0 && j < size ? model[j] : "NOT_SET";
+    const got = list.get(i, "NOT_SET");
+    if (!valEq(got, want)) fail(`get(${i}) = ${showVal(got)}, expected ${showVal(want)}`);
+    if (list.has(i) !== (j >= 0 && j < size)) fail(`has(${i}) on size ${size}`);
+    if (!valEq(list.first(), model[0]) || !valEq(list.last(), model[size - 1])) fail(`first/last: ${showVal(list.first())} ${showVal(list.last())}`);
+    const probe = chance(tc, 60) ? model[n(tc, 0, size - 1)] : genValue(tc);
+    const idx = model.findIndex((v) => valEq(v, probe));
+    if (list.indexOf(probe) !== idx || list.includes(probe) !== (idx !== -1) || list.lastIndexOf(probe) !== findLastIndex(model, (v) => valEq(v, probe))) {
