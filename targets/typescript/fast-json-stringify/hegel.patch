index 0000000..6a9fa40
--- /dev/null
+++ b/hegel/gen.mjs
@@ -0,0 +1,337 @@
+// Generators for fast-json-stringify: a random JSON Schema (draft 7, the subset the README
+// documents) together with a generator of values conforming to it, plus the ways the schema can be
+// rewritten (refs, definitions) without changing its meaning.
+import { n, pick, chance, word } from "./hegel-zoo.mjs";
+import { expected } from "./model.mjs";
+
+export const FULL = !!process.env.ZOO_FULL;
+
+const KEYS = ["a", "b", "c", "id", "name", "value", "x_1", "x_2", "foo", "bar", "items", "type", "data", "n1", "n2"];
+// odd but harmless property names; FULL adds the ones behind known bugs (quotes, backslashes, line
+// terminators and backticks in generated code; slashes in JSON pointers; Object.prototype names;
+// `$ref`/`$id` inside a `default` value under anyOf/if taken for schema keywords)
+const ODD_KEYS = ["", " ", "with space", "unié", "1", "-", "$comment", "a~b", "a%b", "中文"];
+const BUGGY_KEYS = ["quote\"d", "back\\slash", "new\nline", "`tick`", "constructor", "toString", "a/b", "a~1b", "$ref", "$id"];
+const ALPHA = "abcxyz 0123-_\"\\é中";
+
+export function key(tc, { odd = true } = {}) {
+  if (odd && chance(tc, 12)) return pick(tc, FULL ? [...ODD_KEYS, ...BUGGY_KEYS] : ODD_KEYS);
+  return pick(tc, KEYS);
+}
+
+export function str(tc) {
+  const k = pick(tc, ["short", "short", "mid", "long", "escapes", "empty"]);
+  switch (k) {
+    case "empty": return "";
+    case "short": return word(tc, ALPHA, 1, 12);
+    case "mid": return word(tc, ALPHA, 30, 60);
+    case "long": return word(tc, ALPHA + "\n\t", 100, 400);
+    default: return word(tc, "\u0000\u0001\u001f\"\\/\b\f\n\r\t\u2028\u2029😀", 1, 8);
+  }
+}
+
+export function integer(tc) {
+  return pick(tc, [0, 1, -1, 7, 42, -273, 2 ** 31, -(2 ** 31), 2 ** 53 - 1, -(2 ** 53 - 1), n(tc, -1000, 1000), n(tc, -1e9, 1e9)]);
+}
+
+export function number(tc) {
+  const r = pick(tc, ["int", "frac", "frac", "tiny", "huge", "neg"]);
+  switch (r) {
+    case "int": return integer(tc);
+    case "frac": return n(tc, -100000, 100000) / pick(tc, [10, 100, 1000, 7, 3]);
+    case "tiny": return n(tc, 1, 999) * 10 ** -n(tc, 5, 12);
+    case "huge": return n(tc, 1, 999) * 10 ** n(tc, 15, 22);
+    default: return -n(tc, 1, 999) / 8;
+  }
+}
+
+/** Distinct keys for an object schema. */
+function keys(tc, count, { odd } = {}) {
+  const out = [];
+  while (out.length < count) {
+    const k = key(tc, { odd });
+    if (!out.includes(k)) out.push(k);
+  }
+  return out;
+}
+
+/**
+ * A random schema and a generator of conforming values: { schema, gen(tc) }.
+ * `opts.full` adds the shapes of known bugs (see README); `depth` bounds nesting.
+ */
+export function schema(tc, depth = 0, { full = FULL } = {}) {
+  const leafy = depth >= 3;
+  const kind = pick(tc, leafy
+    ? ["string", "integer", "number", "boolean", "null", "const", "multi"]
+    : ["string", "integer", "number", "boolean", "null", "object", "object", "object", "array", "array", "multi", "const", "anyOf", "oneOf", "ifthen", "allOf", "tuple", "any"]);
+  let out;
+  switch (kind) {
+    case "string": {
+      const format = chance(tc, 15) ? pick(tc, ["date-time", "date", "time"]) : undefined;
+      const s = { type: "string" };
+      if (format) s.format = format;
+      out = {
+        schema: s,
+        gen: (tc) => {
+          if (format === "date-time") return chance(tc, 50) ? new Date(n(tc, 0, 4e12)) : new Date(n(tc, 0, 4e12)).toISOString();
+          if (format === "date") return chance(tc, 50) ? new Date(n(tc, 0, 4e12)) : new Date(n(tc, 0, 4e12)).toISOString().slice(0, 10);
+          if (format === "time") return chance(tc, 50) ? new Date(n(tc, 0, 4e12)) : new Date(n(tc, 0, 4e12)).toISOString().slice(11, 19);
+          return str(tc);
+        },
+      };
+      break;
+    }
+    case "integer":
+      out = { schema: { type: "integer" }, gen: (tc) => (full && chance(tc, 10) ? BigInt(integer(tc)) : integer(tc)) };
+      break;
+    case "number":
+      out = { schema: { type: "number" }, gen: (tc) => number(tc) };
+      break;
+    case "boolean":
+      out = { schema: { type: "boolean" }, gen: (tc) => chance(tc, 50) };
+      break;
+    case "null":
+      out = { schema: { type: "null" }, gen: () => null };
+      break;
+    case "any":
+      // no type and no type-bearing keyword: serialized with JSON.stringify
+      out = { schema: chance(tc, 50) ? {} : { description: "anything" }, gen: (tc) => anyJson(tc, depth + 1) };
+      break;
+    case "const": {
+      const c = pick(tc, ["fixed", 0, 1.5, true, null, [1, "two"], { k: "v" }]);
+      out = { schema: { const: c }, gen: () => structuredClone(c) };
+      break;
+    }
+    case "multi": {
+      // several types; string next to array/object is the shape of a known bug (see README) unless full
+      const pool = full ? ["string", "integer", "number", "boolean", "null", "array", "object"] : ["string", "integer", "number", "boolean", "null"];
+      const types = [];
+      const count = n(tc, 2, 3);
+      while (types.length < count) {
+        const t = pick(tc, pool);
+        if (!types.includes(t)) types.push(t);
+      }
+      out = {
+        schema: { type: types.slice() },
+        gen: (tc) => {
+          const t = pick(tc, types);
+          switch (t) {
+            case "string": return str(tc);
+            case "integer": return integer(tc);
+            case "number": return number(tc);
+            case "boolean": return chance(tc, 50);
+            case "null": return null;
+            case "array": return [integer(tc), str(tc)];
+            default: return { k: integer(tc) };
+          }
+        },
+      };
+      break;
+    }
+    case "object": {
+      const props = keys(tc, n(tc, 0, 4), { odd: true });
+      const properties = {};
+      const gens = {};
+      for (const k of props) {
+        const sub = schema(tc, depth + 1, { full });
+        properties[k] = sub.schema;
+        gens[k] = sub;
+        if (chance(tc, 20)) {
+          const d = defaultFor(tc, sub);
+          if (d !== undefined) properties[k] = { ...sub.schema, default: d };
+        }
+      }
+      const required = props.filter(() => chance(tc, 30));
+      const s = { type: "object", properties };
+      if (chance(tc, 20)) delete s.type; // inferred from `properties`
+      if (required.length) s.required = required;
+      let pattern;
+      if (chance(tc, 25)) {
+        pattern = { prefix: pick(tc, ["p_", "q_", "num"]), sub: schema(tc, depth + 1, { full }) };
+        s.patternProperties = { [`^${pattern.prefix}`]: pattern.sub.schema };
+      }
+      let additional;
+      if (chance(tc, 40)) {
+        const r = pick(tc, [true, false, "schema"]);
+        additional = r === "schema" ? { sub: schema(tc, depth + 1, { full }) } : { flag: r };
+        s.additionalProperties = r === "schema" ? additional.sub.schema : r;
+      }
+      out = {
+        schema: s,
+        gen: (tc) => {
+          const o = {};
+          const order = chance(tc, 50) ? props : props.slice().reverse();
+          for (const k of order) {
+            if (required.includes(k) || chance(tc, 75)) o[k] = gens[k].gen(tc);
+            else if (chance(tc, 20)) o[k] = undefined;
+          }
+          if (pattern && chance(tc, 70)) {
+            for (let i = 0, m = n(tc, 1, 3); i < m; i++) o[pattern.prefix + i] = pattern.sub.gen(tc);
+          }
+          if (chance(tc, 40)) {
+            // undeclared keys: dropped, kept via additionalProperties: true, or serialized with its schema
+            for (let i = 0, m = n(tc, 1, 3); i < m; i++) {
+              const k = "extra" + i;
+              o[k] = additional && additional.sub ? additional.sub.gen(tc) : anyJson(tc, depth + 1);
+            }
+          }
+          return o;
+        },
+      };
+      break;
+    }
+    case "array": {
+      const sub = chance(tc, 85) ? schema(tc, depth + 1, { full }) : null;
+      const s = { type: "array" };
+      if (sub) s.items = sub.schema;
+      out = {
+        schema: s,
+        gen: (tc) => {
+          const len = pick(tc, [0, 1, 2, n(tc, 0, 6), n(tc, 0, 6)]);
+          const arr = [];
+          for (let i = 0; i < len; i++) arr.push(sub ? sub.gen(tc) : anyJson(tc, depth + 1));
+          return arr;
+        },
+      };
+      break;
+    }
+    case "tuple": {
+      // tuple items with a single type and non-null values unless full (known bugs: typeless/nullable items, additionalItems schema)
+      const count = n(tc, 1, 3);
+      const items = [];
+      for (let i = 0; i < count; i++) {
+        let sub = schema(tc, depth + 1, { full });
+        if (!full) {
+          let guard = 0;
+          while ((typeof sub.schema.type !== "string" || sub.schema.type === "null" || sub.schema.nullable || sub.schema.const !== undefined) && guard++ < 20) sub = schema(tc, depth + 1, { full });
+          if (typeof sub.schema.type !== "string" || sub.schema.type === "null") sub = { schema: { type: "integer" }, gen: (tc) => integer(tc) };
+        }
+        items.push(sub);
+      }
+      const s = { type: "array", items: items.map((x) => x.schema) };
+      const extra = pick(tc, [undefined, undefined, true, false, full ? "schema" : true]);
+      let extraSub;
+      if (extra === "schema") {
+        extraSub = schema(tc, depth + 1, { full });
+        s.additionalItems = extraSub.schema;
+      } else if (extra !== undefined) s.additionalItems = extra;
+      out = {
+        schema: s,
+        gen: (tc) => {
+          const len = n(tc, 0, count);
+          const arr = [];
+          for (let i = 0; i < len; i++) arr.push(items[i].gen(tc));
+          if (len === count && (extra === true || extra === "schema") && chance(tc, 60)) {
+            for (let i = 0, m = n(tc, 1, 2); i < m; i++) arr.push(extraSub ? extraSub.gen(tc) : anyJson(tc, depth + 1));
+          }
+          return arr;
+        },
+      };
+      break;
+    }
+    case "anyOf":
+    case "oneOf": {
+      // options of distinct primitive types (or objects with a distinguishing required key), so exactly one matches
+      const options = [];
+      const pool = ["string", "integer", "boolean", "null", "objectA", "objectB"];
+      const count = n(tc, 2, 3);
+      const chosen = [];
+      while (chosen.length < count) {
+        const t = pick(tc, pool);
+        if (!chosen.includes(t) && !(t === "integer" && chosen.includes("number"))) chosen.push(t);
+      }
+      for (const t of chosen) {
+        if (t === "objectA" || t === "objectB") {
+          const tag = t === "objectA" ? "alpha" : "beta";
+          const sub = schema(tc, depth + 1, { full });
+          options.push({
+            schema: { type: "object", properties: { [tag]: { type: "string" }, v: sub.schema }, required: [tag] },
+            gen: (tc) => ({ [tag]: str(tc), ...(chance(tc, 80) ? { v: sub.gen(tc) } : {}) }),
+            tag,
+          });
+        } else {
+          const sub = { string: () => ({ schema: { type: "string" }, gen: str }), integer: () => ({ schema: { type: "integer" }, gen: integer }), boolean: () => ({ schema: { type: "boolean" }, gen: (tc) => chance(tc, 50) }), null: () => ({ schema: { type: "null" }, gen: () => null }) }[t]();
+          options.push(sub);
+        }
+      }
+      out = { schema: { [kind]: options.map((o) => o.schema) }, gen: (tc) => pick(tc, options).gen(tc), options };
+      break;
+    }
+    case "allOf": {
+      // disjoint object parts merged
+      const partA = schema(tc, depth + 1, { full });
+      const kA = key(tc, { odd: false });
+      const kB = kA === "a" ? "b" : "a";
+      const partB = schema(tc, depth + 1, { full });
+      out = {
+        schema: { allOf: [{ type: "object", properties: { [kA]: partA.schema } }, { type: "object", properties: { [kB]: partB.schema }, required: [kB] }] },
+        gen: (tc) => ({ ...(chance(tc, 80) ? { [kA]: partA.gen(tc) } : {}), [kB]: partB.gen(tc) }),
+      };
+      break;
+    }
+    case "ifthen": {
+      const subT = schema(tc, depth + 1, { full });
+      const subE = schema(tc, depth + 1, { full });
+      const hasElse = chance(tc, 70);
+      const s = {
+        type: "object",
+        properties: { kind: { type: "string" } },
+        required: ["kind"],
+        if: { type: "object", properties: { kind: { const: "t" } }, required: ["kind"] },
+        then: { properties: { t: subT.schema } },
+      };
+      if (hasElse) s.else = { properties: { e: subE.schema } };
+      out = {
+        schema: s,
+        gen: (tc) => {
+          const isT = chance(tc, 50);
+          const o = { kind: isT ? "t" : pick(tc, ["e", "other", ""]) };
+          if (chance(tc, 80)) o.t = subT.gen(tc);
+          if (chance(tc, 80)) o.e = subE.gen(tc);
+          return o;
+        },
+      };
+      break;
+    }
+  }
+  // nullable wraps any schema
+  // (only with an explicit `type`: ajv, which validates anyOf/oneOf/if branches, rejects `nullable` without one)
+  if (chance(tc, 15) && out.schema.type !== undefined && out.schema.type !== "null") {
+    out.schema.nullable = true;
+    const inner = out.gen;
+    out.gen = (tc) => (chance(tc, 30) ? null : inner(tc));
+  }
+  return out;
+}
+
+/** A JSON default value that conforms to the sub-schema (the library writes defaults verbatim). */
+function defaultFor(tc, sub) {
+  for (let attempt = 0; attempt < 3; attempt++) {
+    try {
+      const d = expected(sub.schema, sub.gen(tc));
+      if (d !== undefined) return d;
+    } catch (e) {
+      // the value did not fit its own schema (anyOf option mismatch); try again
+    }
+  }
+  return undefined;
+}
+
+/** Any JSON value (for typeless schemas and additionalProperties: true). */
+export function anyJson(tc, depth = 0) {
+  const k = depth >= 3 ? pick(tc, ["str", "int", "num", "bool", "null"]) : pick(tc, ["str", "int", "num", "bool", "null", "arr", "obj"]);
+  switch (k) {
+    case "str": return str(tc);
+    case "int": return integer(tc);
+    case "num": return number(tc);
+    case "bool": return chance(tc, 50);
+    case "null": return null;
+    case "arr": { const a = []; for (let i = 0, m = n(tc, 0, 3); i < m; i++) a.push(anyJson(tc, depth + 1)); return a; }
+    default: { const o = {}; for (let i = 0, m = n(tc, 0, 3); i < m; i++) o[key(tc, { odd: false })] = anyJson(tc, depth + 1); return o; }
+  }
+}
+
+/** Deep clone that keeps Dates, RegExps and BigInts (structuredClone does too). */
+export const clone = (v) => structuredClone(v);
+
+export const ROUNDINGS = ["trunc", "ceil", "floor", "round"];
diff --git a/hegel/hegel-zoo.mjs b/hegel/hegel-zoo.mjs
