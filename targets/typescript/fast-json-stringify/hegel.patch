+    return expected(merged, value, opts);
+  }
+  if (schema.if && (schema.then || schema.else)) {
+    const { if: cond, then: thenS, else: elseS, ...rest } = schema;
+    const branch = branchMatches(cond, value) ? thenS : elseS;
+    if (!branch) return expected(rest, value, opts);
+    const merged = { ...rest, ...branch };
+    if (rest.properties && branch.properties) merged.properties = { ...rest.properties, ...branch.properties };
+    if (rest.required && branch.required) merged.required = [...rest.required, ...branch.required];
+    return expected(merged, value, opts);
+  }
+  let type = inferType(schema);
+  if (type === undefined) return jsonRoundTrip(value);
+  if (Array.isArray(type)) {
+    const t = typeOf(value, type);
+    if (t === undefined || !type.includes(t)) throw new ModelError(`value matches none of ${type.join("/")}`);
+    return expected({ ...schema, type: t }, value, opts);
+  }
+  switch (type) {
+    case "null":
+      return null;
+    case "string": {
+      if (value === null) return "";
+      if (schema.format === "date-time") {
+        if (value instanceof Date) return value.toISOString();
+        if (typeof value === "string") return value;
+        throw new ModelError("date-time from a non-date");
+      }
+      if (schema.format === "date") {
+        if (value instanceof Date) return localSlice(value, 0, 10);
+        if (typeof value === "string") return value;
+        throw new ModelError("date from a non-date");
+      }
+      if (schema.format === "time") {
+        if (value instanceof Date) return localSlice(value, 11, 19);
+        if (typeof value === "string") return value;
+        throw new ModelError("time from a non-date");
+      }
+      if (typeof value === "string") return value;
+      if (value instanceof Date) return value.toISOString();
+      if (value instanceof RegExp) return value.source;
+      return String(value);
+    }
+    case "integer": {
+      if (value === null) return 0;
+      if (typeof value === "bigint") return JSON.parse(value.toString());
+      if (Number.isInteger(value)) return value;
+      if (typeof value === "number") {
+        if (!Number.isFinite(value)) throw new ModelError("non-finite integer");
+        return Math[rounding](value);
+      }
+      if (typeof value === "boolean") return value ? 1 : 0;
+      const num = Number(value);
+      if (!Number.isFinite(num)) throw new ModelError("not an integer");
+      return Math[rounding](num);
+    }
+    case "number": {
+      if (value === null) return 0;
+      const num = typeof value === "bigint" ? Number(value) : Number(value);
+      if (Number.isNaN(num)) throw new ModelError("NaN");
+      if (!Number.isFinite(num)) return null;
+      return num;
+    }
+    case "boolean":
+      return !!value;
+    case "object": {
+      if (value === null) return {};
+      if (typeof value.toJSON === "function") return expected(schema, value.toJSON(), opts);
+      const out = {};
+      const properties = schema.properties || {};
+      const required = schema.required || [];
+      for (const k of Object.keys(properties)) {
+        const sub = properties[k];
+        if (value[k] !== undefined) out[k] = expected(sub, value[k], opts);
+        else if (sub && sub.default !== undefined) out[k] = jsonRoundTrip(sub.default);
+        else if (required.includes(k)) throw new ModelError(`${k} is required`);
+      }
+      const patterns = Object.entries(schema.patternProperties || {}).map(([p, s]) => [new RegExp(p), s]);
+      for (const k of Object.keys(value)) {
+        if (Object.prototype.hasOwnProperty.call(properties, k)) continue;
+        const v = value[k];
+        if (v === undefined || typeof v === "function" || typeof v === "symbol") continue;
+        const pat = patterns.find(([re]) => re.test(k));
+        if (pat) out[k] = expected(pat[1], v, opts);
+        else if (schema.additionalProperties === true) out[k] = jsonRoundTrip(v);
+        else if (schema.additionalProperties && typeof schema.additionalProperties === "object") out[k] = expected(schema.additionalProperties, v, opts);
+      }
+      return out;
+    }
+    case "array": {
+      if (value === null) return [];
+      if (!Array.isArray(value)) throw new ModelError("not an array");
+      if (Array.isArray(schema.items)) {
+        const items = schema.items;
+        if (value.length > items.length && !schema.additionalItems) throw new ModelError("tuple too long");
+        return value.map((v, i) => {
+          if (i < items.length) return expected(items[i], v, opts);
+          if (schema.additionalItems === true) return jsonRoundTrip(v);
+          return expected(schema.additionalItems, v, opts);
+        });
+      }
+      if (schema.items === undefined) return value.map(jsonRoundTrip);
+      return value.map((v) => expected(schema.items, v, opts));
+    }
+    default:
+      throw new ModelError(`unknown type ${type}`);
+  }
+}
+
+/**
+ * The key order the library produces for objects: required properties first (in `properties`
+ * order), then the other declared properties, then pattern/additional ones in the input order.
+ * Not documented beyond "additional properties at the end"; checked separately.
+ */
+export function expectedKeyOrder(schema, value) {
+  const properties = schema.properties || {};
+  const required = schema.required || [];
+  const declared = Object.keys(properties).filter((k) => value[k] !== undefined || (properties[k] && properties[k].default !== undefined));
+  const first = declared.filter((k) => required.includes(k));
+  const rest = declared.filter((k) => !required.includes(k));
+  const extra = Object.keys(value).filter((k) => !Object.prototype.hasOwnProperty.call(properties, k));
+  return [...first, ...rest, ...extra];
+}
+
+/** A schema with every `type` array sorted and inferred types filled in, for comparing schemas modulo those. */
+export function normalise(schema) {
+  if (Array.isArray(schema)) return schema.map(normalise);
+  if (schema === null || typeof schema !== "object") return schema;
+  const out = {};
+  for (const k of Object.keys(schema).sort()) out[k] = normalise(schema[k]);
+  if (Array.isArray(out.type)) out.type = out.type.slice().sort();
+  const t = inferType(schema);
+  if (t !== undefined && out.type === undefined) out.type = t;
+  return out;
+}
