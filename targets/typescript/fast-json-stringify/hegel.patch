+// The expected result of fast-json-stringify for a value under a schema, as a parsed JSON value:
+// the README's rules (types, formats, defaults, required, additional/pattern properties, tuples,
+// anyOf/oneOf/allOf/if-then-else, nullable, const, rounding) applied by hand.
+import { createRequire } from "node:module";
