@@ -0,0 +1,431 @@
+// Hegel properties for fast-json-stringify (see README.md in targets/typescript/fast-json-stringify).
+import assert from "node:assert/strict";
+import { createRequire } from "node:module";
+import { dirname, join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { fail, count, property, pin, n, pick, chance, same } from "./hegel-zoo.mjs";
+import { FULL, schema as genSchema, clone, integer, number, ROUNDINGS } from "./gen.mjs";
+import { expected, expectedKeyOrder, normalise, ModelError, ajv } from "./model.mjs";
+
+const require = createRequire(import.meta.url);
+const ROOT = join(dirname(fileURLToPath(import.meta.url)), "..");
+const build = require(join(ROOT, "index.js"));
+
+const GLOBAL_DEFAULTS = { largeArrayMechanism: "default", largeArraySize: 20000 };
+
+function restoreGlobals() {
+  build({ type: "array", items: { type: "integer" } }, GLOBAL_DEFAULTS);
+}
+
+function stringifyOf(schema, options) {
+  try {
