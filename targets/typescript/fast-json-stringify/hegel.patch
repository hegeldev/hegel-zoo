+const ARRAY_KW = ["items", "additionalItems", "maxItems", "minItems", "uniqueItems", "contains"];
+const STRING_KW = ["maxLength", "minLength", "pattern"];
+const NUMBER_KW = ["multipleOf", "maximum", "exclusiveMaximum", "minimum", "exclusiveMinimum"];
