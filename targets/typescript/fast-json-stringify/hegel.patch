+  if (schema === null || typeof schema !== "object") return schema;
+  if (Array.isArray(schema)) return schema.map(toBranchSchema);
+  const out = {};
+  for (const [k, v] of Object.entries(schema)) out[k] = k === "const" || k === "default" || k === "enum" ? v : toBranchSchema(v);
+  if (out.type === "string") {
+    out.fjs_type = "string";
+    out.type = ["string", "object"];
+  } else if (Array.isArray(out.type) && out.type.includes("string") && !out.type.includes("object")) {
+    out.fjs_type = "string";
+    out.type = [...out.type, "object"];
+  }
