+  weighted(
+    [17, ymd.map((p) => utc(p))],
+    [17, gs.tuples(ymd, hms).map(([p, t]) => utc(p, t))],
+    [17, ints(1, 999).map((y) => { const d = new Date(Date.UTC(2000, 0, 1)); d.setUTCFullYear(y); return d; })],
