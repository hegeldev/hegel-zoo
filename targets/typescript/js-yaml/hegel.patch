+  .record({
+    indent: maybe(40, gs.sampledFrom([1, 1, 2, 3, 4, 6, 8])),
+    seqNoIndent: maybe(30, gs.just(true)),
+    seqInlineFirst: maybe(30, gs.just(false)),
