+          [10, gs.sampledFrom([null, "", "x"])],
+          [10, gs.sampledFrom([null, true, false])],
+          [40, strings],
+          [20, num],
+          [10, shape.date ? dates : strings],
+          [10, withBytes ? bytes : num],
