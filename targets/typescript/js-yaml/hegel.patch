+
+function chompFor(s) {
+  const trimmed = s.replace(/\n+$/, "");
+  const trailing = s.length - trimmed.length;
+  const chomp = trailing === 0 ? "-" : trailing === 1 ? "" : "+";
+  return { trimmed, trailing, chomp };
