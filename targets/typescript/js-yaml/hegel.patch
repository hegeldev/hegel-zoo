index 0000000..df37565
--- /dev/null
+++ b/test/hegel-yaml-writer.mjs
@@ -0,0 +1,526 @@
+// Hegel zoo: a randomised YAML writer for the parser side of js-yaml. A tree of plain values
+// is drawn with the style of every node beside its value - how a scalar is spelled (plain,
+// single- or double-quoted with its escape choices, literal or folded with chomping and
+// indentation indicators), how a collection entry sits on its lines (block or flow, compact,
+// explicit key, indentless, comments, blank lines), how a flow collection is spaced, and how
+// the document is framed (markers, comments, an indented root) - and `writeDocument` renders
+// the tree in its style as text without drawing, staying inside what both YAML 1.2 (js-yaml's
+// CORE schema) and YAML 1.1 (PyYAML) read as the same value, so that both readers must return
+// the tree.
+
+import * as Y from "../src/index.ts";
+import { gs } from "./hegel-zoo.mjs";
+import { chance, ints, maybe, weighted } from "./hegel-yaml.mjs";
+
+const TWO53 = 2 ** 53;
+/** A tree node of kind `kind` with the given fields. */
+const node = (kind, fields) => gs.record({ kind: gs.just(kind), ...fields });
+
+// ---------------------------------------------------------------- scalars
+
+const STRING_POOL = [
+  "", " ", "a", "x y", "a: b", "a:b", "- x", "? x", "# c", "x #y", "x#y", ": x", "key:", "yes", "no", "on", "off", "y", "n",
+  "true", "false", "null", "~", "Null", "1", "-1", "+1", "0", "00", "017", "0x1f", "0o17", "0b11", "1_000", "1.5", ".5", "5.", "1e3",
+  "1.0e+3", ".inf", "-.inf", ".nan", "1:30", "12:30:45", "2001-12-14", "2001-12-14t21:59:43.10-05:00", "2001-12-14 21:59:43.10 -5",
+  "<<", "=", "---", "...", "--- x", "... x", "-", "?", ":", ",", "[", "]", "{", "}", "&a", "*a", "!x", "|", ">", "%x", "@x", "`x",
+  "'q'", "\"q\"", "\\", "a\\b", "a\nb", "a\n\nb", "a\n", "\na", "a\n\n", "  a", "a  ", "a\tb", "\t", "é", "一", "😀",
+  "\x85", "\xa0", "\u{2028}", "\u{feff}", "\x00", "\x1b", "\x7f", "a\rb", "0.5.2", "1__0", "1.e3", "-.5", "+.5", "._5",
+  "a b c d e f g", "line one\nline two\nline three", "trailing space \nnext", "x".repeat(200), "w ".repeat(50).trim(),
+];
+
+/** 1-6 lower-case letters. */
+const word = gs.text({ alphabet: "abcdefghijklmnopqrstuvwxyz", minSize: 1, maxSize: 6 });
+const PUNCTUATION = ["-", ":", "#", ",", "[", "]", "{", "}", "?", "!", "&", "*", "|", ">", "'", "\"", "%", "@", "`", "\\", "/", ".", "_", "=", "<<"];
+const NON_ASCII = ["\u{e9}", "\u{4e00}", "\u{1F600}", "\xa0", "\x85", "\u{2028}"];
+/** A piece of a composed string: a word half the time, else a number, whitespace, YAML punctuation, a non-ASCII character or a separator. */
+const piece = weighted(
+  [50, word],
+  [17, ints(0, 999).map(String)],
+  [8, gs.sampledFrom([" ", "  ", "\n", "\n\n", "\t"])],
+  [8, gs.sampledFrom(PUNCTUATION)],
+  [8, gs.sampledFrom(NON_ASCII)],
+  [9, gs.sampledFrom([" ", "-", ":", " "])],
+);
+/** A string: 1-5 pieces joined by nothing, a space, a dash or a colon 55% of the time, else one of the pool. */
+const text = weighted(
+  [55, gs.tuples(gs.arrays(piece, { minSize: 1, maxSize: 5 }), gs.sampledFrom(["", "", " ", "-", ":"])).map(([parts, sep]) => parts.join(sep))],
+  [45, gs.sampledFrom(STRING_POOL)],
+);
+
+const INT_EDGES = [0, 1, -1, 255, 256, 65535, 2147483647, -2147483648, 4294967295, TWO53 - 1, -(TWO53 - 1)];
+/** An integer: -100..100 40% of the time, within a million 30, an edge 10, else within 10^12. */
+const int = weighted([40, ints(-100, 100)], [30, ints(-1000000, 1000000)], [10, gs.sampledFrom(INT_EDGES)], [20, ints(-999999999999, 999999999999)]);
+/** A float: a small fraction 30% of the time, a special value 20, an infinity or NaN 20, a mantissa times a power of ten 10, else 1-999 with three decimals. */
+const float = weighted(
+  [30, gs.tuples(ints(-1000, 1000), gs.sampledFrom([2, 4, 8, 10, 100])).map(([a, d]) => a / d)],
+  [20, gs.sampledFrom([0.1, 0.5, 1.5, -2.5, 1e-7, 1e21, 1e300, 5e-324, 123456.789, -0.0, 0.0])],
+  [20, gs.sampledFrom([Infinity, -Infinity, NaN])],
+  [10, gs.tuples(ints(-1000000, 1000000), ints(-12, 12)).map(([m, e]) => m * 10 ** e)],
+  [20, gs.tuples(ints(1, 999), ints(0, 999)).map(([a, b]) => a + b / 1000)],
+);
+
+const NULLS = ["null", "null", "Null", "NULL", "~"];
+const TRUES = ["true", "true", "True", "TRUE"];
+const FALSES = ["false", "false", "False", "FALSE"];
+const INFS = [".inf", ".Inf", ".INF", "+.inf"];
+const NEG_INFS = ["-.inf", "-.Inf", "-.INF"];
+const NANS = [".nan", ".NaN", ".NAN"];
+const NEG_ZEROS = ["-0.0", "-0.0e+0"]; // not `-.0`: PyYAML wants a digit first
+
+/**
+ * How a string is quoted: plain when the text may be (plainPct% of the time), else single-quoted
+ * when it may be (singlePct%), else double-quoted with these escape choices - a newline as `\x0a`
+ * rather than `\n`, a tab as `\x09`, NBSP as `\xa0` rather than `\_`, a space as `\ `, a slash as
+ * `\/`, a non-ASCII character as `\u`/`\U`.
+ */
+const quoting = (plainPct, singlePct) =>
+  gs.record({ plain: chance(plainPct), single: chance(singlePct), nlHex: chance(20), tabHex: chance(30), nbspHex: chance(50), escSpace: chance(10), escSlash: chance(30), escUnicode: chance(30) });
+
+/**
+ * How a string value is written as a block scalar when its parent puts it on lines of its own
+ * and the text fits the form: literal 60% of the time, else folded 40%; the content indented
+ * `step` past the parent; an indentation indicator 20% of the time, before the chomping
+ * indicator half the time; a comment after the header 20%; an empty line written as indentation
+ * half the time; a coin per word boundary of a folded block (recycled) for a line break there.
+ */
+const blocking = gs.record({
+  literal: chance(60),
+  folded: chance(40),
+  step: ints(1, 4),
+  indicator: chance(20),
+  indicatorFirst: chance(50),
+  headerComment: chance(20),
+  padEmpty: chance(50),
+  breaks: gs.arrays(chance(40), { maxSize: 8 }),
+});
+
+/** A scalar node with its spelling: null 10% of the time, a boolean 10, an integer 20 (hexadecimal or with a `+` 30%), a float 15, a string 45. */
+const scalar = weighted(
+  [10, node("null", { text: gs.sampledFrom(NULLS) })],
+  [10, node("bool", { value: gs.booleans(), spell: ints(0, 3) })],
+  [20, node("int", { value: int, form: gs.sampledFrom(["dec", "dec", "dec", "dec", "dec", "dec", "dec", "hex", "HEX", "plus"]), zero: gs.sampledFrom(["0", "0", "+0", "0x0"]) })],
+  [15, node("float", { value: float, form: gs.sampledFrom(["plain", "plain", "exp", "EXP"]), special: ints(0, 3), stripZero: chance(20), plus: chance(15) })],
+  [45, node("string", { value: text, quote: quoting(65, 45), block: blocking })],
+);
+
+// ---------------------------------------------------------------- collections
+
+const spaces = ints(0, 2);
+const COMMENTS = [" # c", " #", "  # comment: with [flow] and 'quotes'", " # \u{65e5}\u{672c}"];
+/** A comment after a line 15% of the time. */
+const comment = maybe(15, gs.sampledFrom(COMMENTS));
+
+/** The spacing of a flow collection: spaces after the opening bracket, before each comma and after it (one, none or two), a trailing comma 15% of the time with spaces before it, spaces before the closing bracket. */
+const flowing = gs.record({ open: spaces, beforeComma: spaces, afterComma: gs.sampledFrom([" ", " ", "", "  "]), trail: maybe(15, spaces), close: spaces });
+
+/**
+ * How a mapping entry sits in a block mapping: a comment line before it 15% of the time; an
+ * explicit `? key` 8%; a null value as the bare key 30%; a non-empty collection value in block
+ * style 75% (else flow), indented `step` further, a sequence indentless 35%; spaces before a
+ * scalar value; a comment after the line; an empty line after the entry 10%. In a flow mapping,
+ * the spaces before and after its colon.
+ */
+const entryLayout = gs.record({
+  before: chance(15),
+  explicit: chance(8),
+  bareNull: chance(30),
+  block: chance(75),
+  step: ints(1, 4),
+  indentless: chance(35),
+  sp: spaces,
+  comment,
+  blank: chance(10),
+  beforeColon: spaces,
+  afterColon: spaces,
+});
+
+/** How a sequence item sits in a block sequence: a non-empty collection compact on the dash's line (`- k: v`, `- - a`) half the time, else on the lines below indented `step` further; a null as a bare dash 20%; spaces before a scalar; a comment after the line; an empty line after the item 8%. */
+const itemLayout = gs.record({ compact: chance(50), step: ints(1, 4), bareNull: chance(20), sp: spaces, comment, blank: chance(8) });
+
+/** A mapping key: 1-6 letters, with a number after them 30% of the time, 70% of the time; else a string; cut to 200 characters. */
+const keyName = weighted([70, gs.tuples(word, maybe(30, ints(0, 99))).map(([w, d]) => w + (d ?? ""))], [30, text]).map((k) => k.slice(0, 200));
+
+/** The collection nodes of a level whose children come from `child`: a sequence of 0-5 items and a mapping of 0-5 entries with distinct keys, every item and entry with its layout, every collection with its flow spacing. */
+function collections(child) {
+  const seq = node("seq", { items: gs.arrays(gs.record({ node: child, layout: itemLayout }), { maxSize: 5 }), flow: flowing });
+  const entry = gs.record({ node: child, keyQuote: quoting(75, 40), layout: entryLayout });
+  const map = node("map", { entries: gs.maps(keyName, entry, { maxSize: 5 }).map((m) => [...m].map(([key, e]) => ({ key, ...e }))), flow: flowing });
+  return [seq, map];
+}
+
+/** A tree up to three collections deep: at each level a scalar 44% of the time, a sequence 28, a mapping 28. */
+function trees() {
+  let tree = scalar;
+  for (let depth = 2; depth >= 0; depth--) {
+    const [seq, map] = collections(tree);
+    tree = weighted([44, scalar], [28, seq], [28, map]);
+  }
+  return tree;
+}
+
+/**
+ * How the document is framed: a leading comment line 20% of the time, a blank line 15, a `---`
+ * marker 30 (with a comment 30% of that); a non-empty collection in block style 80% (else flow),
+ * at an indentation of 1-3 15%; a string that fits a block scalar written as one half the time,
+ * literal rather than folded 60% of that, its content indented 1-4; a `...` marker 20%; a
+ * trailing comment 10%.
+ */
+const framing = gs.record({
+  leadingComment: chance(20),
+  blank: chance(15),
+  marker: chance(30),
+  markerComment: maybe(30, gs.sampledFrom(COMMENTS)),
+  block: chance(80),
+  rootIndent: maybe(15, ints(1, 3)),
+  blockScalar: chance(50),
+  literal: chance(60),
+  step: ints(1, 4),
+  endMarker: chance(20),
+  trailingComment: chance(10),
+});
+
+/** The parser-side case: a tree and the framing of its document. */
+export const documentCase = gs.record({ tree: trees(), framing });
+
+/** The JS value js-yaml should load for a tree. */
+export function treeToValue(t) {
+  switch (t.kind) {
+    case "null": return null;
+    case "bool": case "int": case "float": case "string": return t.value;
+    case "seq": return t.items.map((it) => treeToValue(it.node));
+    case "map": return Object.fromEntries(t.entries.map((e) => [e.key, treeToValue(e.node)]));
+  }
+  throw new Error("bad tree");
+}
+
+function isColl(t) {
+  return t.kind === "seq" || t.kind === "map";
+}
+
+function size(t) {
+  return t.kind === "seq" ? t.items.length : t.kind === "map" ? t.entries.length : 0;
+}
+
+// ---------------------------------------------------------------- writing scalars
+
+const PLAIN_BAN_FIRST = "-?:,[]{}#&*!|>'\"%@` \t";
+const CONTROL = /[\x00-\x08\x0b\x0c\x0e-\x1f\x7f\x85\u{2028}\u{2029}\u{feff}]/u;
+/** A string with an unpaired surrogate (no UTF-8 form: kept in double quotes, where it is escaped). */
+const loneSurrogate = (s) => !s.isWellFormed();
+
+// A string may be plain if both a 1.2 core reader (js-yaml's default) and a 1.1 reader
+// (js-yaml's YAML11 schema stands in for PyYAML here) give the same string back, and the
+// syntax leaves it whole. Not: empty, multi-line, tabs, leading/trailing space.
+function plainSafe(s, flow) {
+  if (s === "" || /[\n\r\t]/.test(s) || CONTROL.test(s)) return false;
+  if (PLAIN_BAN_FIRST.includes(s[0])) return false;
+  if (s.includes(": ") || s.includes(" #") || s.endsWith(":") || s.endsWith(" ")) return false;
+  if (s.startsWith("---") || s.startsWith("...")) return false;
+  if (s === "=" || s === "<<") return false; // YAML 1.1 !!value and !!merge in PyYAML
+  if (flow && /[,[\]{}:?]/.test(s)) return false;
+  if (loneSurrogate(s)) return false;
+  if (s.length > 1000) return false;
+  for (const schema of [undefined, Y.YAML11_SCHEMA]) {
+    let v;
+    try {
+      v = Y.load(s, schema ? { schema } : undefined);
+    } catch {
+      return false;
+    }
+    if (v !== s) return false;
+  }
+  return true;
+}
+
+function singleOK(s) {
+  return !/[\n\r\t]/.test(s) && !CONTROL.test(s) && !loneSurrogate(s) && s.length <= 1000;
+}
+
+const hex = (code, width) => code.toString(16).padStart(width, "0");
+
+/** `s` double-quoted, with the escapes `q` asks for where the text leaves a choice. */
+function double(s, q) {
+  let out = '"';
+  for (const ch of s) {
+    const c = ch.codePointAt(0);
+    if (ch === '"') out += '\\"';
+    else if (ch === "\\") out += "\\\\";
+    else if (ch === "\n") out += q.nlHex ? "\\x0a" : "\\n";
+    else if (ch === "\r") out += "\\r";
+    else if (ch === "\t") out += q.tabHex ? "\\x09" : "\\t";
+    else if (c === 0x85) out += "\\N";
+    else if (c === 0xa0) out += q.nbspHex ? "\\xa0" : "\\_";
+    else if (c === 0x2028) out += "\\L";
+    else if (c === 0x2029) out += "\\P";
+    else if (c === 0xfeff) out += "\\u" + hex(c, 4);
+    else if (c < 0x20 || c === 0x7f) out += "\\x" + hex(c, 2);
+    else if (c >= 0xd800 && c <= 0xdfff) out += "\\u" + hex(c, 4);
+    else if (ch === " " && q.escSpace) out += "\\ ";
+    else if (ch === "/" && q.escSlash) out += "\\/";
+    else if (c > 0x7f && q.escUnicode) out += c < 0x10000 ? "\\u" + hex(c, 4) : "\\U" + hex(c, 8);
+    else out += ch;
+  }
+  return out + '"';
+}
+
+function single(s) {
+  return "'" + s.replaceAll("'", "''") + "'";
+}
+
+// A literal block can hold s when it is multi-line, free of CR/tab/controls, not all
+// whitespace, no line ends in a space and (with keep chomping) no line starts with one.
+function literalOK(s) {
+  if (!s.includes("\n") || /[\r\t]/.test(s) || CONTROL.test(s) || s.trim() === "" || loneSurrogate(s)) return false;
+  const lines = s.split("\n");
+  if (lines.some((l) => l !== "" && l.trim() === "")) return false;
+  if (lines.some((l) => l.endsWith(" "))) return false;
+  // the indentation is detected from the first non-empty line: it must not start with a space
+  const first = lines.find((l) => l !== "");
+  if (first === undefined || first.startsWith(" ")) return false;
+  return true;
+}
+
+// A folded block can hold s when every line is non-empty-or-blank, no line starts or ends
+// with a space, no tabs, and it is not all whitespace.
+function foldedOK(s) {
+  if (!literalOK(s) && !(s.length > 0 && !s.includes("\n") && s.includes(" "))) return false;
+  if (/[\r\t]/.test(s) || CONTROL.test(s) || loneSurrogate(s)) return false;
+  const lines = s.replace(/\n+$/, "").split("\n");
+  return lines.every((l) => l !== "" && !l.startsWith(" ") && !l.endsWith(" ") && !l.includes("  "));
