@@ -0,0 +1,161 @@
+#!/usr/bin/env python3
+"""Hegel zoo: PyYAML (libyaml) as the oracle for js-yaml, held open by the tests.
+
+Reads one JSON request per line from the FIFO given as argv[1] and writes one JSON response
+per line to the FIFO given as argv[2]. Values cross the boundary in a canonical form that
+both sides can produce:
+
+  null / true / false / "string"   as themselves
+  {"$n": "123"}                     an integer (any float with an integral value below 2^53
+                                    is canonicalised to this as well, since JavaScript
+                                    cannot tell 1.0 from 1)
+  {"$f": "<16 hex digits>"}         any other float, by its IEEE 754 bits ("nan" for NaN)
+  {"$t": "YYYY-MM-DDTHH:MM:SS.mmm"} a timestamp in UTC, truncated to milliseconds
+  {"$b": "<base64>"}                bytes (!!binary)
+  {"$set": [..]}                    a set, members sorted by their JSON text
+  {"$m": [[k, v], ..]}              a mapping, pairs sorted by the JSON text of the key
+  [..]                              a sequence
+"""
+import base64
+import datetime
+import json
+import math
+import struct
+import sys
+
+import yaml
+
+TWO53 = 2 ** 53
+
+
+def key_text(x):
+    # Sorting only: raw code points, so the order matches the JavaScript side's.
+    return json.dumps(x, sort_keys=True, ensure_ascii=False)
+
+
+def canon(v, keys_as_strings):
+    if v is None or isinstance(v, (bool, str)):
+        return v
+    if isinstance(v, int):
+        if abs(v) < TWO53:
+            return {"$n": str(v)}
+        return {"$f": float_bits(float(v))}
+    if isinstance(v, float):
+        if math.isfinite(v) and v == int(v) and abs(v) < TWO53 and not (v == 0 and math.copysign(1, v) < 0):
+            return {"$n": str(int(v))}
+        return {"$f": float_bits(v)}
+    if isinstance(v, datetime.datetime):
+        if v.tzinfo is not None:
+            v = v.astimezone(datetime.timezone.utc).replace(tzinfo=None)
+        v = v.replace(microsecond=(v.microsecond // 1000) * 1000)
+        return {"$t": v.isoformat(timespec="milliseconds")}
+    if isinstance(v, datetime.date):
+        return {"$t": v.isoformat() + "T00:00:00.000"}
+    if isinstance(v, bytes):
+        return {"$b": base64.b64encode(v).decode("ascii")}
+    if isinstance(v, (list, tuple)):
+        return [canon(x, keys_as_strings) for x in v]
+    if isinstance(v, (set, frozenset)):
+        members = [canon(x, keys_as_strings) for x in v]
+        members.sort(key=key_text)
+        return {"$set": members}
+    if isinstance(v, dict):
+        pairs = []
+        for k, x in v.items():
+            ck = js_key(k) if keys_as_strings else canon(k, keys_as_strings)
+            pairs.append([ck, canon(x, keys_as_strings)])
+        pairs.sort(key=lambda p: key_text(p[0]))
+        return {"$m": pairs}
+    return {"$other": repr(v)}
+
+
+def js_key(k):
+    """What js-yaml's default object map turns a scalar key into (String(key))."""
+    if isinstance(k, str):
+        return k
+    if k is None:
+        return "null"
+    if k is True:
+        return "true"
+    if k is False:
+        return "false"
+    if isinstance(k, int):
+        return str(k)
+    if isinstance(k, float):
+        return {"$other": "float key " + repr(k)}
+    return {"$other": "key " + repr(k)}
+
+
+def float_bits(f):
+    if math.isnan(f):
+        return "nan"
+    return struct.pack(">d", f).hex()
+
+
+def uncanon(v):
+    if v is None or isinstance(v, (bool, str)):
+        return v
+    if isinstance(v, list):
+        return [uncanon(x) for x in v]
+    if "$n" in v:
+        return int(v["$n"])
+    if "$f" in v:
+        if v["$f"] == "nan":
+            return math.nan
+        return struct.unpack(">d", bytes.fromhex(v["$f"]))[0]
+    if "$t" in v:
+        return datetime.datetime.fromisoformat(v["$t"])
+    if "$b" in v:
+        return base64.b64decode(v["$b"])
+    if "$set" in v:
+        return set(uncanon(x) for x in v["$set"])
+    if "$m" in v:
+        return {uncanon(k): uncanon(x) for k, x in v["$m"]}
+    raise ValueError("bad canonical value %r" % (v,))
+
+
+def handle(req):
+    op = req["op"]
+    if op == "load":
+        loader = yaml.CBaseLoader if req.get("loader") == "base" else yaml.CSafeLoader
+        try:
+            docs = list(yaml.load_all(req["text"], Loader=loader))
+        except Exception as e:  # noqa: BLE001 - any failure is an answer
+            return {"ok": False, "error": type(e).__name__ + ": " + str(e).split("\n")[0][:200]}
+        try:
+            return {"ok": True, "docs": [canon(d, req.get("keys_as_strings", True)) for d in docs]}
+        except Exception as e:  # noqa: BLE001
+            return {"ok": False, "error": "canon: " + type(e).__name__ + ": " + str(e)[:200]}
+    if op == "dump":
+        try:
+            value = uncanon(req["value"])
+            opts = req.get("options", {})
+            text = yaml.dump(value, Dumper=yaml.CSafeDumper, allow_unicode=opts.get("allow_unicode", True),
+                             default_flow_style=opts.get("default_flow_style", False),
+                             width=opts.get("width", 80), indent=opts.get("indent", 2),
+                             default_style=opts.get("default_style", None), sort_keys=False)
+            return {"ok": True, "text": text}
+        except Exception as e:  # noqa: BLE001
+            return {"ok": False, "error": type(e).__name__ + ": " + str(e).split("\n")[0][:200]}
+    if op == "ping":
+        return {"ok": True, "pyyaml": yaml.__version__, "libyaml": yaml.__with_libyaml__}
+    return {"ok": False, "error": "unknown op"}
+
+
+def main():
+    req_path, resp_path = sys.argv[1], sys.argv[2]
+    with open(req_path, "r", encoding="utf-8") as req, open(resp_path, "w", encoding="utf-8") as resp:
+        for line in req:
+            line = line.strip()
+            if not line:
+                continue
+            try:
+                answer = handle(json.loads(line))
+            except Exception as e:  # noqa: BLE001
+                answer = {"ok": False, "error": "oracle: " + type(e).__name__ + ": " + str(e)[:200]}
+            resp.write(json.dumps(answer, ensure_ascii=True) + "\n")
+            resp.flush()
+
+
+if __name__ == "__main__":
+    main()
diff --git a/test/hegel-yaml-writer.mjs b/test/hegel-yaml-writer.mjs
