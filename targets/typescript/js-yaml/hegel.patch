+    for (let w = 1; w < words.length; w++) {
+      if (breakHere()) {
+        out.push(pad + cur);
+        cur = words[w];
+      } else cur += " " + words[w];
+    }
+    out.push(pad + cur);
+  });
+  for (let i = 1; i < trailing; i++) out.push("");
+  return out;
