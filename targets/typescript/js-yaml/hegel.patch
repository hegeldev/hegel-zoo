+    [10, gs.text({ alphabet: "abcdefgh", minSize: 1, maxSize: 6 })],
+    [30, lookalike],
+    [20, pieces(hostile, 0, 8)],
+    [10, gs.tuples(lookalike, junk).map(([a, b]) => a + b)],
+    [10, gs.tuples(junk, lookalike).map(([a, b]) => a + b)],
+    [10, multiline],
+    [10, pieces([..."abc xyz-_.:0123", "\u{e9}", "\u{1F600}"], 10, 120)],
+  );
