+
+// The lines of a string node as a block scalar after `head` (the key or `-`), or null when the text does not fit the form its style asks for.
+function blockScalarLines(t, indent) {
+  const s = t.value;
+  const b = t.block;
+  if (b.literal && literalOK(s)) return literal(s, indent, indent + b.step, b);
+  if (b.folded && foldedOK(s)) return folded(s, indent, indent + b.step, b);
