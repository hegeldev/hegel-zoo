+const EDGE_NUMBERS = [0, -0, 1, -1, 9007199254740991, -9007199254740991, 9007199254740993, 2 ** 63, 1e21, -1e21, 1e-7, 123456789012, 0.1, 0.5, 1.5, -2.5, 1e300, 5e-324, 2 ** 31, -(2 ** 31), 255, 1e16, 12345678901234567890];
