@@ -0,0 +1,116 @@
+// Hegel zoo: the small harness shared by the zoo's TypeScript/JavaScript targets.
+//
+// `property(name, body)` registers a node:test test that runs `body(tc)` under Hegel with
+// HEGEL_TEST_CASES cases (default 100) and the database at HEGEL_DATABASE. With ZOO_COLLECT=1
+// a `fail()` records the mismatch instead of failing, the case ends there, and the counts of
+// mismatches and of the shapes seen (`count(key)`) are printed at the end of the test, so a
+// property can be run over many cases to see every shape at once. `pin(name, body)` is a
+// plain test for one pinned bug: it must fail while the bug is present and pass once it is
+// fixed (the zoo's judge reads an unexpected pass as "fixed upstream?").
+
+import { readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { test as nodeTest } from "node:test";
+import * as hegel from "@hegeldev/hegel";
+import * as gs from "@hegeldev/hegel/generators";
+
+// The Hegel version these tests were written against (the zoo pins it in zoo.toml and installs
+// it with `npm install --no-save @hegeldev/hegel@<version>`; upstream would add it to
+// devDependencies). Checked at load time so a stray install cannot silently change the engine.
+export const HEGEL_PIN = { "@hegeldev/hegel": "0.4.5" };
+
+{
+  let dir = dirname(fileURLToPath(import.meta.resolve("@hegeldev/hegel")));
+  while (!/[\\/]hegel$/.test(dir) && dir !== dirname(dir)) dir = dirname(dir);
+  const installed = JSON.parse(readFileSync(join(dir, "package.json"), "utf8")).version;
+  if (installed !== HEGEL_PIN["@hegeldev/hegel"]) {
+    throw new Error(`@hegeldev/hegel ${installed} is installed; these tests pin ${HEGEL_PIN["@hegeldev/hegel"]}`);
+  }
+}
+
+/** Hegel's generators, re-exported so the tests import everything from one place. */
+export { gs };
+
+export const collecting = !!process.env.ZOO_COLLECT;
+
+class Collected extends Error {}
+
+let msgs = [];
+let stats = new Map();
+
+/** Report a mismatch: an error normally, a recorded line in collect mode. */
+export function fail(message) {
+  if (collecting) {
+    msgs.push(message);
+    throw new Collected(message);
+  }
+  throw new Error(message);
+}
+
+/** Bump a statistic (the shape of a pinned bug, a generator branch). */
+export function count(key) {
+  stats.set(key, (stats.get(key) || 0) + 1);
+}
+
+function settings() {
+  const s = { testCases: Number(process.env.HEGEL_TEST_CASES) || 100 };
+  if (process.env.HEGEL_DATABASE) {
+    s.database = hegel.Database.fromPath(process.env.HEGEL_DATABASE);
+  }
+  return s;
+}
+
+/** A property: `body(tc)` runs under Hegel; a thrown error (or `fail`) is a failure. */
+export function property(name, body) {
+  nodeTest(name, () => {
+    msgs = [];
+    stats = new Map();
+    hegel.test((tc) => {
+      try {
+        body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** A pin: a plain test for one recorded bug. */
+export function pin(name, body) {
+  nodeTest(name, body);
+}
+
+/** Structural equality: arrays by position, objects by key set (prototype ignored), else ===. */
+export function same(a, b) {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) {
+      return false;
+    }
+    return a.every((x, i) => same(x, b[i]));
+  }
+  if (a !== null && b !== null && typeof a === "object" && typeof b === "object") {
+    const ka = Object.keys(a).sort();
+    const kb = Object.keys(b).sort();
+    if (ka.length !== kb.length || ka.some((k, i) => k !== kb[i])) {
+      return false;
+    }
+    return ka.every((k) => same(a[k], b[k]));
+  }
+  return a === b;
+}
+
+/** A compact, unambiguous rendering for messages. */
+export function show(x) {
+  return JSON.stringify(x, (k, v) => (v === undefined ? "<undefined>" : v));
+}
diff --git a/test/hegel.test.mjs b/test/hegel.test.mjs
new file mode 100644
index 0000000..3f54f28
--- /dev/null
+++ b/test/hegel.test.mjs
@@ -0,0 +1,323 @@
+// Hegel zoo: property tests for js-yaml (nodeca/js-yaml), run with
+// `node --test --test-reporter=tap test/hegel.test.mjs` (tests import the TypeScript sources
+// directly, as upstream's own tests do). See test/hegel-zoo.mjs for the harness,
+// test/hegel-yaml.mjs for the PyYAML (libyaml) oracle bridge and the value generators, and
+// test/hegel-yaml-writer.mjs for the drawn documents of the parser side. Each property draws
+// one case record (a value with its options, or a tree with its document style) and renders it
+// with pure functions.
+
+import * as Y from "../src/index.ts";
+import { count, fail, gs, property, pin } from "./hegel-zoo.mjs";
+import {
+  canon, chance, deepEqual, dumpOptions, pyDump, pyDumpOptions, pyLoadAll, sameCanon, shapesOf, showValue, values,
+} from "./hegel-yaml.mjs";
+import { documentCase, treeToValue, writeDocument } from "./hegel-yaml-writer.mjs";
+
+const J = JSON.stringify;
+const REAL = Y.DUMP_SCHEMA.withTags(Y.realMapTag);
+const YAML11_REAL = Y.YAML11_SCHEMA.withTags(Y.realMapTag);
+
+function head(e) {
+  return String(e && e.message ? e.message : e).split("\n")[0];
+}
+
+// js-yaml/4: a key of the top-level mapping that begins with `--- ` or `... ` is written
+// plain at column 0, where it is a document marker. Only the top level can put a key there;
+// a Set is written as a `!!set` mapping whose keys are its members.
+const MARKER_KEY = /^(---|\.\.\.)[ \t]/;
+function hasMarkerKey(value) {
+  if (!value || typeof value !== "object" || Array.isArray(value) || value instanceof Date || value instanceof Uint8Array) return false;
+  const keys = value instanceof Map || value instanceof Set ? [...value.keys()] : Object.keys(value);
+  return keys.some((k) => typeof k === "string" && MARKER_KEY.test(k));
+}
+function markerLine(text) {
+  return /^(---|\.\.\.)[ \t]/m.test(text);
+}
+
+// PyYAML's scanners (libyaml and the pure-Python one alike) take a `?` or `:` in flow context
+// for the key or value indicator whatever follows it (`check_key`/`check_value`: any `?`/`:`
+// while `flow_level` > 0), so `[?x]` is `[{x: null}]` to them and `{:x: null}` an error; the
+// YAML 1.1 and 1.2 grammars (`ns-plain-first`) both let `?`, `:` or `-` followed by a plain-safe
+// character begin a plain scalar, which is how js-yaml writes and reads it (`-x` PyYAML reads
+// too). In block context PyYAML agrees. The shape: such a scalar at the start of a flow entry
+// (after `[`, `{` or `,`) or of a flow mapping value (after the `:` indicator, which
+// `flowSkipColonSpace` puts right against a quoted key: `{"_"::a}`), in a document written with
+// `flowLevel` (js-yaml writes flow collections only then). Approximate: the text of a quoted
+// string may match too.
+function indicatorStartsFlowScalar(text, options) {
+  return options.flowLevel !== undefined && /[[{,:][ \t]*[?:][^\s]/.test(text);
+}
+
+// ---------------------------------------------------------------- cases
+
+// The schemas of the round trip and what their values may hold: the default (CORE) schema
+// reads no Dates, Sets or bytes back, DUMP_SCHEMA does, and with realMapTag Maps keep their keys.
+const MODES = {
+  core: { schema: undefined, values: values({ shared: true, cycle: true }) },
+  yaml11: { schema: Y.DUMP_SCHEMA, values: values({ date: true, set: true, bytes: true, shared: true, cycle: true }) },
+  real: { schema: REAL, values: values({ date: true, set: true, bytes: true, map: true, shared: true, cycle: true }) },
+};
+/** The round-trip case: a mode (core half the time), a value its schema holds, the presenter options. */
+const roundTripCase = gs.sampledFrom(["core", "core", "yaml11", "real"]).flatMap((mode) => gs.record({ mode: gs.just(mode), value: MODES[mode].values, options: dumpOptions }));
+
+// What Python can hold: Sets of scalars and Maps with scalar keys (it cannot hash a list or a dict).
+const PY_KINDS = { date: true, set: true, bytes: true, hashable: true };
+const pyReadsValues = [values({ ...PY_KINDS, shared: true }), values({ ...PY_KINDS, shared: true, map: true })];
+/** The PyYAML-reads case: Maps a quarter of the time (dumped with realMapTag), a value, the presenter options. */
+const pyReadsCase = chance(25).flatMap((withMaps) => gs.record({ withMaps: gs.just(withMaps), value: pyReadsValues[+withMaps], options: dumpOptions }));
+
+// What PyYAML writes as js-yaml's YAML 1.1 schema reads it (the README's limits): no lone
+// surrogate, YAML 1.1 Unicode break, y/n or leading-dot float in a string, Dates within four-digit
+// years. libyaml tags a typed scalar it cannot write plain with a bare `!`, which js-yaml reads
+// as `!!str` (see the property): under a forced scalar style that is every typed scalar, so the
+// values are strings only (and no Sets, whose entries hold nulls); under a flow style it is every
+// timestamp (its colons are flow indicators), so there are no Dates.
+const PY_WRITES_SHAPES = {
+  block: { ...PY_KINDS, pyReadable: true },
+  flow: { ...PY_KINDS, date: false, pyReadable: true },
+  forced: { ...PY_KINDS, set: false, stringsOnly: true, pyReadable: true },
+};
+const pyWritesValues = Object.fromEntries(Object.entries(PY_WRITES_SHAPES).map(([style, shape]) => [style, [values(shape), values({ ...shape, map: true })]]));
+const pyStyleOf = (options) => (options.default_style !== undefined ? "forced" : options.default_flow_style !== undefined ? "flow" : "block");
+/** The PyYAML-writes case: Maps a quarter of the time (loaded with realMapTag), PyYAML's options, a value they can carry across. */
+const pyWritesCase = gs.tuples(chance(25), pyDumpOptions).flatMap(([withMaps, options]) =>
+  gs.record({ withMaps: gs.just(withMaps), options: gs.just(options), value: pyWritesValues[pyStyleOf(options)][+withMaps] }),
+);
+
+// ---------------------------------------------------------------- dump -> load
+
+// Whatever `dump` writes, `load` (with the same schema) reads back as the same value, in
+// every combination of the presenter's options; the text ends with one line break and
+// `loadAll` sees exactly one document.
+property("TestHegelDumpLoadsBackTheSameValue", (tc) => {
+  const { mode, value, options } = tc.draw(roundTripCase);
+  const { schema } = MODES[mode];
+  const shapes = shapesOf(value);
+  for (const s of shapes) count(s);
+  count(`mode/${mode}`);
+  const markerKey = hasMarkerKey(value);
+  if (markerKey) count("key/document-marker");
+
+  let text;
+  try {
+    text = Y.dump(value, schema ? { ...options, schema } : options);
+  } catch (e) {
+    if (shapes.has("date/invalid")) { count("limit/invalid-date-throws"); return; }
+    // noRefs asks for every repeated object to be inlined; a cycle cannot be, and the
+    // documented trade-off is the recursion running away.
+    if (options.noRefs && shapes.has("ref/cycle") && /call stack/.test(head(e))) { count("limit/cycle-with-noRefs"); return; }
+    fail(`dump threw ${head(e)} on ${showValue(value)} with ${J(options)}`);
+  }
+  if (typeof text !== "string" || !text.endsWith("\n")) fail(`dump returned ${J(text)} for ${showValue(value)}`);
+  let back;
+  try {
+    back = Y.load(text, schema ? { schema } : undefined);
+  } catch (e) {
+    if (shapes.has("date/year-outside-4-digits") && /timestamp/.test(head(e))) { count("js-yaml/3"); return; }
+    if (markerKey && markerLine(text)) { count("js-yaml/4"); return; }
+    fail(`load threw ${head(e)} on dump(${showValue(value)}, ${J(options)}) = ${J(text)}`);
+  }
+  // With realMapTag every mapping loads as a Map, plain objects included: compare the
+  // canonical forms there, the values themselves elsewhere.
+  const equal = mode === "real" ? sameCanon(canon(back), canon(value)) : deepEqual(back, value);
+  if (!equal) {
+    if (shapes.has("date/year-outside-4-digits") && mode !== "core") { count("date/year-outside-4-digits-lost"); return; }
+    if (markerKey && markerLine(text)) { count("js-yaml/4"); return; } // `... x: 1` loads as {x: 1}
+    fail(`load(dump(v)) differs: v = ${showValue(value)} options ${J(options)} text ${J(text)} back ${showValue(back)}`);
+  }
+  const all = Y.loadAll(text, schema ? { schema } : undefined);
+  if (all.length !== 1) fail(`loadAll(dump(v)) gave ${all.length} documents: ${J(text)}`);
+});
+
+// ---------------------------------------------------------------- dump -> PyYAML
+
+// js-yaml's DUMP_SCHEMA is documented to quote every scalar that a YAML 1.1 or 1.2 resolver
+// would take for something else, "for maximum compatibility": PyYAML (libyaml, YAML 1.1)
+// must read what js-yaml writes as the same value.
+property("TestHegelPyYamlReadsWhatJsYamlWrites", (tc) => {
+  const { withMaps, value, options } = tc.draw(pyReadsCase);
+  const shapes = shapesOf(value);
+  for (const s of shapes) count(s);
+  if (shapes.has("date/invalid")) { count("limit/invalid-date"); tc.assume(false); }
+  let text;
+  try {
+    text = Y.dump(value, withMaps ? { ...options, schema: REAL } : options);
+  } catch (e) {
+    fail(`dump threw ${head(e)} on ${showValue(value)} with ${J(options)}`);
+  }
+  // What Python cannot hold: a set member or a mapping key that is a collection, and a Set or
+  // Map with two members or keys Python equates (True == 1, False == 0, two datetimes of one
+  // instant; the value generator keeps them out; this is the guard).
+  if (shapes.has("set/collection-member") || shapes.has("key/collection")) { count("limit/unhashable-in-python"); tc.assume(false); }
+  if (shapes.has("key/python-folds")) { count("limit/python-folds-equal-keys"); tc.assume(false); }
+  const want = canon(value);
+  // A top-level block scalar that needs an indentation indicator (its content starts with a
+  // space): the spec has the document node at indentation -1, so js-yaml writes `|3` for
+  // two-space content and reads it back; libyaml counts the indicator from column 0 and
+  // reads one space less (or fails on the header). Neither side is going to move.
+  if (typeof value === "string" && /^ .*\n/s.test(value) && !shapes.has("str/lone-surrogate")) {
+    count("limit/top-level-indentation-indicator");
+    tc.assume(false);
+  }
+  const markerKey = hasMarkerKey(value) && markerLine(text);
+  if (markerKey) count("key/document-marker");
+  const py = pyLoadAll(text, { keysAsStrings: !withMaps });
+  if (!py.ok) {
+    if (markerKey) { count("js-yaml/4"); return; }
+    if (shapes.has("str/lone-surrogate")) { count("limit/lone-surrogate-utf8"); return; }
+    // An empty !!binary as the last flow entry is written `[!!binary]`: valid (a tag ends at
+    // a flow indicator, eemeli/yaml reads it) but libyaml wants a blank after every tag.
+    if (/![^\s\]},]*[\]}]/.test(text) && /scanning a tag/.test(py.error)) { count("limit/libyaml-tag-before-flow-indicator"); return; }
+    if (shapes.has("str/timestamp-out-of-range")) { count("js-yaml/2"); return; }
+    if (shapes.has("str/over-1024") && /flowLevel/.test(J(options))) { count("js-yaml/1"); return; }
+    if (shapes.has("date/year-outside-4-digits")) { count("js-yaml/3"); return; }
+    if (indicatorStartsFlowScalar(text, options)) { count("limit/pyyaml-indicator-starts-flow-scalar"); return; }
+    fail(`PyYAML rejects js-yaml's output: ${py.error}\n  value ${showValue(value)}\n  options ${J(options)}\n  text ${J(text)}`);
+  }
+  if (py.docs.length !== 1) fail(`PyYAML sees ${py.docs.length} documents in ${J(text)}`);
+  if (!sameCanon(py.docs[0], want)) {
+    if (markerKey) { count("js-yaml/4"); return; }
+    if (shapes.has("date/year-outside-4-digits")) { count("js-yaml/3"); return; }
+    if (indicatorStartsFlowScalar(text, options)) { count("limit/pyyaml-indicator-starts-flow-scalar"); return; }
+    fail(`PyYAML reads js-yaml's output differently:\n  value ${showValue(value)}\n  options ${J(options)}\n  text ${J(text)}\n  pyyaml ${J(py.docs[0])}\n  want   ${J(want)}`);
+  }
+});
+
+// ---------------------------------------------------------------- generated text -> load
+
+// The parser side: a tree written by the zoo's randomised YAML writer (block and flow
+// collections at random indentation, plain/single/double/literal/folded scalars, explicit
+// keys, comments, markers - inside what YAML 1.1 and 1.2 read alike) must load to the tree;
+// PyYAML reads the same document as the second opinion on whose mistake a difference is.
+property("TestHegelGeneratedDocumentsLoadToTheTreeTheyWereWrittenFrom", (tc) => {
+  const doc = tc.draw(documentCase);
+  const want = canon(treeToValue(doc.tree));
+  const { text, style } = writeDocument(doc);
+  for (const s of style) count(`style/${s}`);
+  if (/^\s*[|>]|: [|>]|- [|>]/m.test(text)) count("has/block-scalar");
+  if (/^\s*\? /m.test(text)) count("has/explicit-key");
+  let got, jsErr = null;
+  try {
+    got = Y.load(text);
+  } catch (e) {
+    jsErr = head(e);
+  }
+  const py = pyLoadAll(text);
+  const pyDiff = !py.ok ? `PyYAML: ${py.error}` : py.docs.length !== 1 ? `PyYAML sees ${py.docs.length} documents` : !sameCanon(py.docs[0], want) ? `PyYAML reads ${J(py.docs[0])}` : null;
+  const jsDiff = jsErr ? `js-yaml: ${jsErr}` : !sameCanon(canon(got), want) ? `js-yaml reads ${J(canon(got))}` : null;
+  if (jsDiff && pyDiff) fail(`test-suite defect: both readers differ from the writer\n  ${jsDiff}\n  ${pyDiff}\n  want ${J(want)}\n  text ${J(text)}`);
+  if (jsDiff) fail(`js-yaml reads the document differently (PyYAML agrees with the writer)\n  ${jsDiff}\n  want ${J(want)}\n  text ${J(text)}`);
+  if (pyDiff) fail(`test-suite defect: PyYAML differs from the writer (js-yaml agrees)\n  ${pyDiff}\n  want ${J(want)}\n  text ${J(text)}`);
+  const all = Y.loadAll(text);
+  if (all.length !== 1) fail(`loadAll sees ${all.length} documents in ${J(text)}`);
+});
+
+// ---------------------------------------------------------------- pins
+
+// js-yaml/1: an implicit key is limited to 1024 characters (YAML 1.2 section 7.4.2, and
+// every other parser enforces it). The block presenter switches to an explicit `? ` entry
+// for longer keys; the flow presenter writes them implicit, so `{flowLevel: 0}` output is
+// rejected by PyYAML/libyaml ("while parsing a flow mapping ... could not find expected ':'").
+pin("TestHegelPinLongFlowKeysAreWrittenExplicitly", () => {
+  const key = "k".repeat(1025);
+  const block = Y.dump({ [key]: 1 });
+  if (!block.startsWith("? ")) fail(`block mapping: long key not written with '? ': ${J(block.slice(0, 40))}`);
+  const flow = Y.dump({ [key]: 1 }, { flowLevel: 0 });
+  if (!/^\{\s*\?\s/.test(flow)) fail(`flow mapping: a ${key.length}-character implicit key: ${J(flow.slice(0, 20))}...${J(flow.slice(-12))}`);
+});
+
+// js-yaml/2: strings that match the YAML 1.1 timestamp pattern but hold out-of-range fields
+// are written plain (js-yaml's own resolver rejects them, so `canUsePlain` sees a string),
+// yet a YAML 1.1 reader takes them for timestamps and fails.
+pin("TestHegelPinOutOfRangeTimestampStringsAreQuoted", () => {
+  const plain = [];
+  for (const s of ["1999-12-31 23:59:60", "2001-12-14T24:00:00Z", "2001-12-14 21:59:43 +25", "2001-02-30", "2001-13-01", "0000-01-01"]) {
+    if (Y.dump(s) === s + "\n") plain.push(s);
+  }
+  if (plain.length) fail(`dumped plain, though PyYAML reads them as (invalid) timestamps: ${J(plain)}`);
+});
+
+// js-yaml/3: a Date outside years 0000-9999 dumps as `!!timestamp '+010000-01-01T...'` (from
+// toISOString), which js-yaml's own loader rejects ("cannot resolve a node with
+// !<tag:yaml.org,2002:timestamp> explicit tag"), as does PyYAML.
+pin("TestHegelPinDatesBeyondFourDigitYearsLoadBack", () => {
+  for (const d of [new Date(Date.UTC(10000, 0, 1)), new Date(Date.UTC(-1, 0, 1)), new Date(8.64e15)]) {
+    let text;
+    try {
+      text = Y.dump(d, { schema: Y.DUMP_SCHEMA });
+    } catch (e) {
+      continue; // refusing to write it would be fine too
+    }
+    let back;
+    try {
+      back = Y.load(text, { schema: Y.DUMP_SCHEMA });
+    } catch (e) {
+      fail(`dump(${d.toISOString()}) = ${J(text)}, which load rejects: ${head(e)}`);
+    }
+    if (!(back instanceof Date) || back.getTime() !== d.getTime()) fail(`dump(${d.toISOString()}) = ${J(text)} loads as ${showValue(back)}`);
+  }
+});
+
+// js-yaml/4: a top-level mapping key beginning with `--- ` or `... ` is written plain at
+// column 0, where it is a document marker: `load` then fails on `--- x: 1` ("end of the
+// stream or a document separator is expected") and reads `... x: 1` as {x: 1}. The same
+// string as a *value* is quoted.
+pin("TestHegelPinDocumentMarkerKeysAreQuoted", () => {
+  for (const key of ["--- x", "... x", "---\tx"]) {
+    const text = Y.dump({ [key]: 1 });
+    let back;
+    try {
+      back = Y.load(text);
+    } catch (e) {
+      fail(`dump({${J(key)}: 1}) = ${J(text)}, which load rejects: ${head(e)}`);
+    }
+    if (!deepEqual(back, { [key]: 1 })) fail(`dump({${J(key)}: 1}) = ${J(text)} loads as ${showValue(back)}`);
+  }
+});
+
+// ---------------------------------------------------------------- PyYAML -> load
+
+// The other direction: what PyYAML's emitter writes (YAML 1.1, every style) js-yaml loads
+// under its YAML 1.1 schema as the same value.
+property("TestHegelJsYamlReadsWhatPyYamlWrites", (tc) => {
+  const { withMaps, value, options } = tc.draw(pyWritesCase);
+  const shapes = shapesOf(value);
+  for (const s of shapes) count(s);
+  // The value generator keeps to what PyYAML writes as js-yaml reads it (pyWritesCase); a
+  // composed string can still land on one of the shapes, so each limit keeps its guard.
+  if (shapes.has("date/invalid") || shapes.has("date/year-outside-4-digits")) { count("limit/date-out-of-range"); tc.assume(false); }
+  if (shapes.has("str/lone-surrogate")) { count("limit/lone-surrogate"); tc.assume(false); }
+  if (shapes.has("set/collection-member") || shapes.has("key/collection")) { count("limit/unhashable-in-python"); tc.assume(false); }
+  if (shapes.has("key/python-folds")) { count("limit/python-folds-equal-keys"); tc.assume(false); }
+  // PyYAML leaves y/Y/n/N plain (it drops that corner of the YAML 1.1 bool type); js-yaml's
+  // YAML 1.1 schema reads them as booleans, as the type definition says.
+  if (shapes.has("str/y-n")) { count("limit/pyyaml-y-n"); tc.assume(false); }
+  // PyYAML writes U+2028/U+2029 as raw line breaks inside quotes (YAML 1.1 breaks, which
+  // fold; YAML 1.2 does not treat them as breaks at all) - not even PyYAML reads them back.
+  if (shapes.has("str/unicode-break")) { count("limit/pyyaml-unicode-breaks"); tc.assume(false); }
+  // PyYAML leaves "+.5" or "._5" plain, its float regexp wanting a digit first; js-yaml's
+  // YAML 1.1 schema (and the type definition) read them as floats.
+  if (shapes.has("str/leading-dot-float")) { count("limit/pyyaml-leading-dot-float"); tc.assume(false); }
+  const want = canon(value);
+  const pd = pyDump(want, options);
+  if (!pd.ok) { count(`limit/pyyaml-cannot-dump:${pd.error.split(":")[0]}`); return; }
+  // A forced style makes PyYAML write typed scalars as `! "1"`: under YAML 1.1 the `!`
+  // non-specific tag means "resolve as if plain", under YAML 1.2 it means `!!str`, and
+  // js-yaml takes the 1.2 reading in every schema. Not a bug either way (the value generator
+  // keeps typed scalars out of a forced style and Dates out of a flow style, see
+  // PY_WRITES_SHAPES; this is the guard).
+  if (/(^|[\s,[{])!(?=[ \t]|$)/m.test(pd.text)) { count("limit/pyyaml-bang-tag"); tc.assume(false); }
+  // A top-level block scalar with an indentation indicator: PyYAML counts it from column 0,
+  // js-yaml from the spec's document indentation of -1 (see the dump direction).
+  if (/^[|>][1-9]/.test(pd.text)) { count("limit/top-level-indentation-indicator"); tc.assume(false); }
+  let back;
+  try {
+    back = Y.load(pd.text, { schema: withMaps ? YAML11_REAL : Y.YAML11_SCHEMA });
+  } catch (e) {
+    fail(`js-yaml rejects PyYAML's output: ${head(e)}\n  value ${showValue(value)}\n  pyyaml options ${J(options)}\n  text ${J(pd.text)}`);
+  }
+  const got = canon(back);
+  if (!sameCanon(got, want)) {
+    fail(`js-yaml reads PyYAML's output differently:\n  value ${showValue(value)}\n  pyyaml options ${J(options)}\n  text ${J(pd.text)}\n  js-yaml ${J(got)}\n  want    ${J(want)}`);
+  }
+});
