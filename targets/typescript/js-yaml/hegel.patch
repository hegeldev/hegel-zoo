+
+/** The text of a string in its quoting `q`: plain or single-quoted when the text allows it and `q` asks for it, else double-quoted. */
+function quoted(s, q, flow) {
+  if (q.plain && plainSafe(s, flow)) return s;
+  if (q.single && singleOK(s)) return single(s);
+  return double(s, q);
