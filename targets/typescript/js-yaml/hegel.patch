+
+/** A whole document for the tree, as text; `style` records the top-level choice. */
+export function writeDocument(tc, t) {
+  let out = "";
+  const style = [];
+  if (chance(tc, 20)) { out += "# leading comment\n"; style.push("leading-comment"); }
+  if (chance(tc, 15)) out += "\n";
+  const marker = chance(tc, 30);
