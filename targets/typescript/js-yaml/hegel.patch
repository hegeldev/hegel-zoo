+
+function integer(t) {
+  const v = t.value;
+  if (v === 0) return t.zero;
+  if (v < 0) return String(v);
+  switch (t.form) {
+    case "hex": return "0x" + v.toString(16);
+    case "HEX": return "0x" + v.toString(16).toUpperCase();
+    case "plus": return "+" + String(v);
+    default: return String(v);
+  }
