+  if (isColl(t) && size(t) > 0 && chance(tc, 80)) {
+    if (marker) out += "---" + (chance(tc, 30) ? comment(tc) : "") + "\n";
+    let indent = 0;
+    if (chance(tc, 15)) { indent = n(tc, 1, 3); style.push("indented-root"); }
+    out += blockLines(tc, t, indent).join("\n") + "\n";
+    style.push("block");
+  } else if (isColl(t)) {
+    if (marker) out += "--- ";
+    out += flow(tc, t) + "\n";
+    style.push("flow");
+  } else if (t.kind === "string" && (literalOK(t.value) || foldedOK(t.value)) && chance(tc, 50)) {
