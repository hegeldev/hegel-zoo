+/** The in-line text of a scalar node. */
+function scalarText(t, flow) {
+  switch (t.kind) {
+    case "null": return t.text;
+    case "bool": return (t.value ? TRUES : FALSES)[t.spell];
+    case "int": return integer(t);
+    case "float": return floatText(t);
+    case "string": return quoted(t.value, t.quote, flow);
+  }
+  throw new Error("scalar of a collection");
