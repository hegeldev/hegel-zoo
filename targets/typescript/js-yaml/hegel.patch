+        lines.push(head + tail);
+      } else if (block) {
+        lines.push(head + " " + block[0], ...block.slice(1));
+        ctx.fragile = isKeep(block);
+      } else if (isColl(kid) && size(kid) > 0 && L.block) {
+        const step = kid.kind === "seq" && !explicit && L.indentless ? 0 : L.step;
+        lines.push(head + tail, ...blockLines(kid, indent + step, ctx));
+      } else if (isColl(kid)) {
+        lines.push(head + " " + flow(kid) + tail);
+      } else {
+        lines.push(head + " " + sp(L.sp) + scalarText(kid, false) + tail);
+      }
+      if (L.blank && !ctx.fragile) lines.push("");
+    }
+  } else if (t.kind === "seq") {
+    for (const { node: kid, layout: L } of t.items) {
+      ctx.fragile = false;
+      const block = kid.kind === "string" ? blockScalarLines(kid, indent) : null;
+      const tail = L.comment ?? "";
+      if (isColl(kid) && size(kid) > 0 && L.compact) {
+        // compact: "- k: v" / "- - a", the rest aligned under the first entry
+        const sub = blockLines(kid, indent + 2, ctx);
+        sub[0] = pad + "- " + sub[0].slice(indent + 2);
+        lines.push(...sub);
+      } else if (isColl(kid) && size(kid) > 0) {
+        lines.push(pad + "-" + tail, ...blockLines(kid, indent + L.step, ctx));
+      } else if (block) {
+        lines.push(pad + "- " + block[0], ...block.slice(1));
+        ctx.fragile = isKeep(block);
+      } else if (isColl(kid)) {
+        lines.push(pad + "- " + flow(kid) + tail);
+      } else if (kid.kind === "null" && L.bareNull) {
+        lines.push(pad + "-");
+      } else {
+        lines.push(pad + "- " + sp(L.sp) + scalarText(kid, false) + tail);
+      }
+      if (L.blank && !ctx.fragile) lines.push("");
+    }
+  } else {
+    lines.push(pad + scalarText(t, false));
+  }
+  return lines;
+}
+
+/** A whole document for a drawn case (its tree in its framing), as text; `style` records the top-level choice. */
+export function writeDocument({ tree: t, framing: D }) {
+  let out = "";
+  const style = [];
+  const ctx = { fragile: false };
+  if (D.leadingComment) { out += "# leading comment\n"; style.push("leading-comment"); }
+  if (D.blank) out += "\n";
+  if (D.marker) style.push("marker");
+  if (isColl(t) && size(t) > 0 && D.block) {
+    if (D.marker) out += "---" + (D.markerComment ?? "") + "\n";
+    let indent = 0;
+    if (D.rootIndent !== undefined) { indent = D.rootIndent; style.push("indented-root"); }
+    out += blockLines(t, indent, ctx).join("\n") + "\n";
+    style.push("block");
+  } else if (isColl(t)) {
+    if (D.marker) out += "--- ";
+    out += flow(t) + "\n";
+    style.push("flow");
+  } else if (t.kind === "string" && (literalOK(t.value) || foldedOK(t.value)) && D.blockScalar) {
+    // a top-level block scalar (no indentation indicator: js-yaml counts it from -1)
+    const useLiteral = literalOK(t.value) && (!foldedOK(t.value) || D.literal);
+    const lines = useLiteral ? literal(t.value, -1, D.step, t.block) : folded(t.value, -1, D.step, t.block);
+    lines[0] = lines[0].replace(/^([|>])([+-]?)[0-9]/, "$1$2").replace(/^([|>])[0-9]([+-])/, "$1$2");
+    out += (D.marker ? "--- " : "") + lines.join("\n") + "\n";
+    style.push("block-scalar");
+  } else {
+    if (D.marker) out += "--- ";
+    out += scalarText(t, false) + "\n";
+    style.push("scalar");
+  }
+  if (D.endMarker) { out += "...\n"; style.push("end-marker"); }
+  if (D.trailingComment) out += "# trailing comment\n";
+  return { text: out, style };
+}
