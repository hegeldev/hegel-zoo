+/** A collection (or scalar) in flow style, on one line. */
+function flow(t) {
+  if (t.kind === "seq") {
+    const F = t.flow;
+    if (t.items.length === 0) return "[" + sp(F.open) + "]";
+    const parts = t.items.map((it) => flow(it.node));
+    let s = "[" + sp(F.open) + parts.join(sp(F.beforeComma) + "," + F.afterComma);
+    if (F.trail !== undefined) s += sp(F.trail) + ",";
+    return s + sp(F.close) + "]";
+  }
+  if (t.kind === "map") {
+    const F = t.flow;
+    if (t.entries.length === 0) return "{" + sp(F.open) + "}";
