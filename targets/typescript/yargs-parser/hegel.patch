index 0000000..5311417
--- /dev/null
+++ b/test/hegel-zoo.mjs
@@ -0,0 +1,140 @@
+// Hegel zoo: the small harness shared by the zoo's TypeScript/JavaScript targets.
+//
+// `property(name, body)` registers a node:test test that runs `body(tc)` under Hegel with
+// HEGEL_TEST_CASES cases (default 100) and the database at HEGEL_DATABASE. With ZOO_COLLECT=1
+// a `fail()` records the mismatch instead of failing, the case ends there, and the counts of
+// mismatches and of the shapes seen (`count(key)`) are printed at the end of the test, so a
+// property can be run over many cases to see every shape at once. `pin(name, body)` is a
+// plain test for one pinned bug: it must fail while the bug is present and pass once it is
+// fixed (the zoo's judge reads an unexpected pass as "fixed upstream?").
+
+import { readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+import { test as nodeTest } from "node:test";
+
+// The Hegel version these tests were written against (the zoo pins it in zoo.toml; upstream
+// would add it to devDependencies). smol-toml's package.json declares `devEngines.packageManager
+// = pnpm` with `onFail: "error"`, which makes npm refuse to install anything into the package
+// itself, so Hegel (and the TypeScript compiler that builds src/ into .hegel/dist) are installed
+// with `npm install --prefix .hegel` and imported from there. Checked at load time so a stray
+// install cannot silently change the engine.
+export const HEGEL_PIN = { "@hegeldev/hegel": "0.4.5" };
+
+const hegelDir = join(dirname(fileURLToPath(import.meta.url)), "..", ".hegel", "node_modules", "@hegeldev", "hegel");
+{
+  const installed = JSON.parse(readFileSync(join(hegelDir, "package.json"), "utf8")).version;
+  if (installed !== HEGEL_PIN["@hegeldev/hegel"]) {
+    throw new Error(`@hegeldev/hegel ${installed} is installed; these tests pin ${HEGEL_PIN["@hegeldev/hegel"]}`);
+  }
+}
+const hegel = await import(pathToFileURL(join(hegelDir, "dist", "index.js")));
+const gs = await import(pathToFileURL(join(hegelDir, "dist", "generators", "index.js")));
+
+export const collecting = !!process.env.ZOO_COLLECT;
+
+class Collected extends Error {}
+
+let msgs = [];
+let stats = new Map();
+
+/** Report a mismatch: an error normally, a recorded line in collect mode. */
+export function fail(message) {
+  if (collecting) {
+    msgs.push(message);
+    throw new Collected(message);
+  }
+  throw new Error(message);
+}
+
+/** Bump a statistic (the shape of a pinned bug, a generator branch). */
+export function count(key) {
+  stats.set(key, (stats.get(key) || 0) + 1);
+}
+
+function settings() {
+  const s = { testCases: Number(process.env.HEGEL_TEST_CASES) || 100 };
+  if (process.env.HEGEL_DATABASE) {
+    s.database = hegel.Database.fromPath(process.env.HEGEL_DATABASE);
+  }
+  return s;
+}
+
+/** A property: `body(tc)` runs under Hegel; a thrown error (or `fail`) is a failure. */
+export function property(name, body) {
+  nodeTest(name, () => {
+    msgs = [];
+    stats = new Map();
+    hegel.test((tc) => {
+      try {
+        body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** A pin: a plain test for one recorded bug. */
+export function pin(name, body) {
+  nodeTest(name, body);
+}
+
+/** An integer in [lo, hi]. */
+export function n(tc, lo, hi) {
+  return tc.draw(gs.integers({ minValue: lo, maxValue: hi }));
+}
+
+/** One of xs. */
+export function pick(tc, xs) {
+  return xs[n(tc, 0, xs.length - 1)];
+}
+
+/** True pct percent of the time. */
+export function chance(tc, pct) {
+  return n(tc, 0, 99) < pct;
+}
+
+/** A string of `len` characters drawn from `alphabet` (an array of strings). */
+export function word(tc, alphabet, lo, hi) {
+  const len = n(tc, lo, hi);
+  let s = "";
+  for (let i = 0; i < len; i++) {
+    s += pick(tc, alphabet);
+  }
+  return s;
+}
+
+/** Structural equality: arrays by position, objects by key set (prototype ignored), else ===. */
+export function same(a, b) {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) {
+      return false;
+    }
+    return a.every((x, i) => same(x, b[i]));
+  }
+  if (a !== null && b !== null && typeof a === "object" && typeof b === "object") {
+    const ka = Object.keys(a).sort();
+    const kb = Object.keys(b).sort();
+    if (ka.length !== kb.length || ka.some((k, i) => k !== kb[i])) {
+      return false;
+    }
+    return ka.every((k) => same(a[k], b[k]));
+  }
+  return a === b;
+}
+
+/** A compact, unambiguous rendering for messages. */
+export function show(x) {
+  return JSON.stringify(x, (k, v) => (v === undefined ? "<undefined>" : v));
+}
diff --git a/test/hegel.test.mjs b/test/hegel.test.mjs
new file mode 100644
index 0000000..00f8e40
--- /dev/null
+++ b/test/hegel.test.mjs
@@ -0,0 +1,891 @@
+// Hegel zoo: property tests for yargs-parser against a model of its documented grammar.
+//
+// There is no reference option parser to compare with, so the tests build the expectation
+// themselves: a random option *spec* (names, aliases, types, defaults) and a random *intent*
+// (a sequence of assignments and positionals) are rendered into a command line in one of the
+// documented syntaxes, and the parse must give the intended values back. Around that sit the
+// laws the README states for the `configuration` switches, type and alias invariants over
+// random argument soup, the `coerce` contract, the string-vs-array input equivalence and the
+// string utilities.
+
+import assert from "node:assert/strict";
+import parser from "../build/lib/index.js";
+import { property, pin, fail, count, n, pick, chance, word, show } from "./hegel-zoo.mjs";
+
+const { camelCase, decamelize, looksLikeNumber } = parser;
+
+// ---------------------------------------------------------------------------------------------
+// Known bugs (see bugs.toml). Properties skip the shapes these describe; the pins at the end
+// assert the correct behaviour and fail while the bug exists.
+
+const Known = {
+  // yargs-parser/1: a negative number with an exponent (`-1e3`) or a trailing dot (`-5.`) is not
+  // taken as a value when it stands alone after its flag, although `looksLikeNumber` accepts it
+  // and `--num=-1e3` parses it; it is read as a group of short flags instead.
+  negativeExponent: true,
+  // yargs-parser/2: an argument like `-5.` or `-.` produces the key "" (`{"": {"": true}}`).
+  emptyKey: true,
+  // yargs-parser/3: the value a `coerce` function returns is number-coerced afterwards.
+  coerceNumber: true,
+  // yargs-parser/4: with `duplicate-arguments-array: false`, a repeated `narg` option keeps the
+  // last value under its own name but all values under its aliases and camel-case twin.
+  nargDuplicateAliases: true,
+  // yargs-parser/5: a short option takes the `--` end-of-options marker as its value.
+  shortEatsDashDash: true,
+  // yargs-parser/6: `strip-aliased` leaves the dashed twin of a camel-case alias in argv.
+  stripAliasedTwin: true,
+  // yargs-parser/7: a string or number array flag inside a short group (`-bu`) gets a placeholder
+  // element (`[""]`, `[undefined]`) where `-b -u` gives `[]`.
+  arrayInGroup: true,
+  // yargs-parser/8: the value 1 is mistaken for a count increment: `--x 1 --x 1` is `x: 2`,
+  // `--x 2 --x 1` is `x: 3`, and an array option's default of 1 is not wrapped in an array.
+  oneIsIncrement: true,
+};
+
+/** Does this token carry the value 1 in one of its spellings (the shape of known bug 8)? */
+function carriesOne(token) {
+  return /(^|=|[a-zA-Z])(1(\.0*)?|0x0*1|1e0+|1\.0*e0+)$/i.test(token);
+}
+
+// ---------------------------------------------------------------------------------------------
+// Generators
+
+const NAMES = ["alpha", "beta", "gamma", "delta", "foo-bar", "big-num", "out-dir", "zeta", "x-y-z"];
+const LETTERS = "abcdfghjkmprstuwyz".split("");
+const WORDS = ["a", "b", "c", "ab", "foo", "bar", "baz", "qux", "a.b", "x_y", "A", "Bc", "truex", "nope"];
+
+/** Kebab name -> its camel-case twin (as the parser documents it). */
+function camel(name) {
+  return name.split("-").map((s, i) => (i === 0 ? s : s[0].toUpperCase() + s.slice(1))).join("");
+}
+
+/** Deep equality with NaN equal to itself (a `number` option given `abc` is NaN). */
+function eq(a, b) {
+  if (Object.is(a, b)) return true;
+  if (typeof a !== typeof b || a === null || b === null || typeof a !== "object") return false;
+  if (Array.isArray(a) !== Array.isArray(b)) return false;
+  const ka = Object.keys(a);
+  const kb = Object.keys(b);
+  if (ka.length !== kb.length) return false;
+  return ka.every((k) => Object.prototype.hasOwnProperty.call(b, k) && eq(a[k], b[k]));
+}
+
+/** A random option spec: distinct names, distinct single-letter aliases, a type, maybe a default. */
+function genSpec(tc, { allowUntyped = true } = {}) {
+  const names = [...NAMES];
+  const letters = [...LETTERS];
+  const opts = [];
+  const cnt = n(tc, 1, 4);
+  for (let i = 0; i < cnt; i++) {
+    const name = names.splice(n(tc, 0, names.length - 1), 1)[0];
+    const kinds = ["boolean", "boolean", "string", "number", "array", "count", "narg"];
+    if (allowUntyped) kinds.push("untyped", "untyped");
+    const kind = pick(tc, kinds);
+    const opt = { name, kind, aliases: [] };
+    if (chance(tc, 60)) opt.aliases.push(letters.splice(n(tc, 0, letters.length - 1), 1)[0]);
+    if (chance(tc, 15)) opt.aliases.push(pick(tc, [`long-al${i}`, `other${"ABCD"[i]}`, `al${i}`]));
+    if (kind === "narg") opt.narg = n(tc, 1, 3);
+    if (kind === "array") opt.elem = pick(tc, ["any", "any", "string", "number", "boolean"]);
+    if (kind !== "count" && chance(tc, 30)) opt.def = genDefault(tc, opt);
+    opts.push(opt);
+  }
+  return opts;
+}
+
+/** The `opts` object for the spec. */
+function specOptions(spec, configuration) {
+  const o = { alias: {}, boolean: [], string: [], number: [], array: [], count: [], narg: {}, default: {} };
+  for (const opt of spec) {
+    if (opt.aliases.length) o.alias[opt.name] = opt.aliases.slice();
+    if (opt.kind === "boolean") o.boolean.push(opt.name);
+    else if (opt.kind === "string") o.string.push(opt.name);
+    else if (opt.kind === "number") o.number.push(opt.name);
+    else if (opt.kind === "count") o.count.push(opt.name);
+    else if (opt.kind === "narg") o.narg[opt.name] = opt.narg;
+    else if (opt.kind === "array") {
+      if (opt.elem === "any") o.array.push(opt.name);
+      else o.array.push({ key: opt.name, [opt.elem]: true });
+    }
+    if (opt.def !== undefined) o.default[opt.name] = opt.def;
+  }
+  if (configuration) o.configuration = configuration;
+  return o;
+}
+
+/** A number and one of the textual forms the parser documents as numbers. */
+function genNumber(tc, { negative = true } = {}) {
+  const r = n(tc, 0, 99);
+  let text;
+  if (r < 50) text = String(n(tc, 0, 999));
+  else if (r < 70) text = `${n(tc, 0, 99)}.${n(tc, 0, 99)}`;
+  else if (r < 80) text = `.${n(tc, 1, 99)}`;
+  else if (r < 88) text = `${n(tc, 1, 9)}e${n(tc, 0, 5)}`;
+  else if (r < 94) text = `0x${n(tc, 0, 255).toString(16)}`;
+  else text = `${n(tc, 1, 9)}.${n(tc, 0, 9)}e${n(tc, 0, 3)}`;
+  if (negative && !text.startsWith("0x") && chance(tc, 30)) text = "-" + text;
+  return { text, value: Number(text) };
+}
+
+/** A plain word value: never starts with `-`, never `true`/`false`, no quotes or spaces. */
+function genWord(tc) {
+  return pick(tc, WORDS);
+}
+
+/** The documented coercion of an untyped value: texts that look like numbers and fit. */
+function untypedCoerce(text) {
+  if (typeof text !== "string") return text;
+  if (looksLikeNumber(text) && Number.isSafeInteger(Math.floor(parseFloat(text)))) return Number(text);
+  return text;
+}
+
+/** A default value for an option, typed like the option. */
+function genDefault(tc, opt) {
+  const scalar = (kind) => {
+    switch (kind) {
+      case "boolean":
+        return chance(tc, 50);
+      case "string":
+        return chance(tc, 70) ? genWord(tc) : String(n(tc, 0, 99));
+      case "number":
+        return n(tc, -50, 50);
+      default:
+        return chance(tc, 50) ? genWord(tc) : n(tc, -50, 50);
+    }
+  };
+  if (opt.kind === "array") {
+    if (chance(tc, 30)) return scalar(opt.elem); // a scalar default of an array option
+    const out = [];
+    const k = n(tc, 0, 2);
+    for (let i = 0; i < k; i++) out.push(scalar(opt.elem));
+    return out;
+  }
+  return scalar(opt.kind);
+}
+
+/** A value for an assignment, as {text, value} (the argument text and the parsed value). */
+function genValue(tc, opt) {
+  const kind = opt.kind === "array" ? opt.elem : opt.kind;
+  switch (kind) {
+    case "boolean": {
+      const t = pick(tc, ["true", "false"]);
+      return { text: t, value: t === "true" };
+    }
+    case "string": {
+      const t = chance(tc, 70) ? genWord(tc) : genNumber(tc).text;
+      return { text: t, value: t };
+    }
+    case "number": {
+      const num = genNumber(tc);
+      return { text: num.text, value: num.value };
+    }
+    default: {
+      // an untyped value: a word, or a number-looking text that the parser coerces
+      if (chance(tc, 55)) {
+        const t = genWord(tc);
+        return { text: t, value: t };
+      }
+      const num = genNumber(tc);
+      return { text: num.text, value: untypedCoerce(num.text) };
+    }
+  }
+}
+
+/** Is this text, standing alone as the next argument, taken as a negative number by the parser? */
+function isNegativeArg(text) {
+  return /^-([0-9]+(\.[0-9]+)?|\.[0-9]+)$/.test(text);
+}
+
+/** All the keys the parser documents for an option: the name, its aliases, their twins. */
+function keysOf(opt) {
+  const keys = new Set([opt.name, ...opt.aliases]);
+  for (const k of [...keys]) {
+    if (k.includes("-")) keys.add(camel(k));
+    else if (/[A-Z]/.test(k)) keys.add(decamelize(k, "-"));
+  }
+  return [...keys];
+}
+
+// ---------------------------------------------------------------------------------------------
+// The intent -> command line -> parse round trip.
+
+/** Render one assignment of `opt` in a random documented syntax; returns the argument tokens. */
+function renderAssignment(tc, spec, opt, ev) {
+  const short = opt.aliases.find((a) => a.length === 1);
+  const long = chance(tc, 80) || !short ? opt.name : pick(tc, opt.aliases);
+  const useShort = short && chance(tc, 40);
+  const key = useShort ? `-${short}` : `--${long}`;
+  switch (opt.kind) {
+    case "boolean": {
+      const r = n(tc, 0, 99);
+      if (ev.value === false) {
+        if (r < 60) return [`--no-${long}`];
+        if (r < 80) return [`${key}=false`];
+        return [key, "false"];
+      }
+      if (r < 50) return [key];
+      if (r < 75) return [`${key}=true`];
+      if (r < 90) return [key, "true"];
+      // a short group: this flag plus another boolean's single-letter alias, both true
+      if (short) {
+        const others = spec.filter((o) => o !== opt && o.kind === "boolean" && o.aliases.some((a) => a.length === 1));
+        if (others.length) {
+          const other = pick(tc, others);
+          const os = other.aliases.find((a) => a.length === 1);
+          ev.alsoTrue = [other];
+          return [chance(tc, 50) ? `-${short}${os}` : `-${os}${short}`];
+        }
+      }
+      return [key];
+    }
+    case "count":
+      return [key];
+    case "string":
+    case "number":
+    case "untyped": {
+      const t = ev.val.text;
+      const r = n(tc, 0, 99);
+      if (r < 40) return [`${key}=${t}`];
+      if (useShort && opt.kind === "number" && r < 60 && /^-?\d+(\.\d*)?(e\d+)?$/.test(t)) return [`${key}${t}`];
+      return [key, t];
+    }
+    case "array":
+    case "narg": {
+      const texts = ev.val.map((v) => v.text);
+      if (texts.length && chance(tc, 30)) return [`${key}=${texts[0]}`, ...texts.slice(1)];
+      return [key, ...texts];
+    }
+    default:
+      throw new Error(opt.kind);
+  }
+}
+
+/** The model: fold the kept events into the expected argv. */
+function expectArgv(spec, events, trailing) {
+  const state = new Map(); // opt.name -> accumulated value
+  const positional = [];
+  for (const ev of events) {
+    if (ev.positional !== undefined) {
+      positional.push(untypedCoerce(ev.positional));
+      continue;
+    }
+    const opt = ev.opt;
+    const prev = state.get(opt.name);
+    switch (opt.kind) {
+      case "boolean":
+        state.set(opt.name, ev.value);
+        for (const o of ev.alsoTrue || []) state.set(o.name, true);
+        break;
+      case "count":
+        state.set(opt.name, (prev === undefined ? 0 : prev) + 1);
+        break;
+      case "string":
+      case "number":
+      case "untyped": {
+        const v = ev.val.value;
+        if (prev === undefined) state.set(opt.name, v);
+        else if (Array.isArray(prev)) state.set(opt.name, [...prev, v]);
+        else state.set(opt.name, [prev, v]);
+        break;
+      }
+      case "array": {
+        // `--arr` with no values contributes the default (documented) or nothing; a boolean
+        // array's bare flag is `true`
+        let vs = ev.val.map((v) => v.value);
+        if (vs.length === 0 && opt.elem === "boolean") vs = [true];
+        else if (vs.length === 0 && opt.def !== undefined) vs = [].concat(opt.def);
+        state.set(opt.name, prev === undefined ? vs : [...prev, ...vs]);
+        break;
+      }
+      case "narg": {
+        const vs = ev.val.map((v) => v.value);
+        if (prev === undefined) state.set(opt.name, vs.length === 1 ? vs[0] : vs);
+        else state.set(opt.name, [].concat(prev, vs));
+        break;
+      }
+    }
+  }
+  const argv = { _: [...positional, ...trailing] };
+  for (const opt of spec) {
+    let v = state.get(opt.name);
+    if (v === undefined) {
+      if (opt.def !== undefined) v = opt.kind === "array" ? [].concat(opt.def) : opt.def; // a scalar default of an array is wrapped
+      else if (opt.kind === "count") v = 0;
+      else continue;
+    }
+    for (const k of keysOf(opt)) argv[k] = v;
+  }
+  return argv;
+}
+
+/** A random intent for the spec: assignments and positionals. */
+function genIntent(tc, spec) {
+  const events = [];
+  const cnt = n(tc, 0, 6);
+  for (let i = 0; i < cnt; i++) {
+    if (chance(tc, 25)) {
+      events.push({ positional: chance(tc, 70) ? genWord(tc) : genNumber(tc, { negative: false }).text });
+      continue;
+    }
+    const opt = pick(tc, spec);
+    const ev = { opt };
+    if (opt.kind === "boolean") ev.value = chance(tc, 70);
+    else if (opt.kind === "array") {
+      ev.val = [];
+      const k = n(tc, 0, 3);
+      for (let j = 0; j < k; j++) ev.val.push(genValue(tc, opt));
+    } else if (opt.kind === "narg") {
+      ev.val = [];
+      for (let j = 0; j < opt.narg; j++) ev.val.push(genValue(tc, opt));
+    } else if (opt.kind !== "count") ev.val = genValue(tc, opt);
+    events.push(ev);
+  }
+  return events;
+}
+
+property("TestHegelIntentRoundTrip", (tc) => {
+  const spec = genSpec(tc);
+  const intent = genIntent(tc, spec);
+  const args = [];
+  const kept = [];
+  let hungry = false; // the last assignment was an array: it would eat a following positional
+  for (const ev of intent) {
+    if (ev.positional !== undefined) {
+      if (hungry) {
+        count("positional-dropped");
+        continue;
+      }
+      args.push(ev.positional);
+      kept.push(ev);
+      continue;
+    }
+    const opt = ev.opt;
+    const tokens = renderAssignment(tc, spec, opt, ev);
+    if (tokens.slice(1).some((a) => a.startsWith("-") && !isNegativeArg(a))) {
+      // a value like `-1e3` standing alone is read as flags (known bug 1)
+      count("known-negative-exponent");
+      continue;
+    }
+    args.push(...tokens);
+    kept.push(ev);
+    hungry = opt.kind === "array";
+  }
+  let trailing = [];
+  if (chance(tc, 25)) {
+    const k = n(tc, 0, 3);
+    for (let i = 0; i < k; i++) trailing.push(pick(tc, ["x", "-y", "--z", "5", "--"]));
+    args.push("--", ...trailing);
+  }
+  if (Known.oneIsIncrement && (args.some(carriesOne) || spec.some((o) => [].concat(o.def ?? []).includes(1)))) {
+    count("known-one");
+    return;
+  }
+  const expected = expectArgv(spec, kept, trailing);
+  const opts = specOptions(spec);
+  const detailed = parser.detailed(args, opts);
+  if (detailed.error) fail(`error ${detailed.error.message}\nargs ${show(args)}\nopts ${show(opts)}`);
+  const got = { ...detailed.argv };
+  count(`events=${kept.length}`);
+  if (!eq(got, expected)) {
+    fail(`args ${show(args)}\nopts ${show(opts)}\n     got ${show(got)}\nexpected ${show(expected)}`);
+  }
+});
+
+// ---------------------------------------------------------------------------------------------
+// Configuration laws: the same argument soup under a switch, against the default parse.
+
+/** A random argument list from a pool of documented shapes over the spec's names. */
+function genSoup(tc, spec) {
+  const args = [];
+  const cnt = n(tc, 0, 7);
