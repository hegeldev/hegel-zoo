+// Pins for the known bugs.
+
+pin("TestHegelPinNegativeExponentIsAValue", () => {
+  // yargs-parser/1
+  assert.deepEqual(parser(["--num", "-1e3"], { number: ["num"] }), { _: [], num: -1000 });
+});
+
+pin("TestHegelPinTrailingDotNumberIsAValue", () => {
+  // yargs-parser/1 (the trailing-dot form)
+  assert.deepEqual(parser(["--x", "-5."]), { _: [], x: -5 });
+});
+
+pin("TestHegelPinNoEmptyKey", () => {
+  // yargs-parser/2
+  const argv = parser(["-5.", "-."]);
+  assert.equal("" in argv, false, show(argv));
+});
+
+pin("TestHegelPinCoerceResultIsKept", () => {
+  // yargs-parser/3
+  assert.deepEqual(parser(["--x", "a"], { coerce: { x: () => "5" } }), { _: [], x: "5" });
+});
+
+pin("TestHegelPinNargDuplicatesAgreeAcrossAliases", () => {
+  // yargs-parser/4
+  const argv = parser(["-f", "1", "-f", "2"], { narg: { foo: 1 }, alias: { foo: "f" }, configuration: { "duplicate-arguments-array": false } });
+  assert.deepEqual(argv, { _: [], foo: 2, f: 2 });
+  const camelArgv = parser(["--foo-bar", "1", "--foo-bar", "2"], { narg: { "foo-bar": 1 }, configuration: { "duplicate-arguments-array": false } });
+  assert.deepEqual(camelArgv, { _: [], "foo-bar": 2, fooBar: 2 });
+});
+
+pin("TestHegelPinShortOptionDoesNotEatDashDash", () => {
+  // yargs-parser/5
+  assert.deepEqual(parser(["-x", "--", "a"]), { _: ["a"], x: true });
+});
+
+pin("TestHegelPinArrayFlagInGroupIsEmpty", () => {
+  // yargs-parser/7
+  assert.deepEqual(parser(["-bu"], { array: [{ key: "b", number: true }] }), parser(["-b", "-u"], { array: [{ key: "b", number: true }] }));
+});
+
+pin("TestHegelPinOneIsAValueNotAnIncrement", () => {
+  // yargs-parser/8
+  assert.deepEqual(parser(["--x", "1", "--x", "1"]), { _: [], x: [1, 1] });
+  assert.deepEqual(parser(["--x", "2", "--x", "1"]), { _: [], x: [2, 1] });
+  assert.deepEqual(parser([], { array: ["b"], default: { b: 1 } }), { _: [], b: [1] });
+});
+
+pin("TestHegelPinStripAliasedRemovesTheDashedTwin", () => {
+  // yargs-parser/6
+  assert.deepEqual(parser(["--x", "1"], { alias: { x: "otherA" }, configuration: { "strip-aliased": true } }), { _: [], x: 1 });
+});
