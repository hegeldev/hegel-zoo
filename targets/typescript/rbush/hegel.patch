index 0000000..3abdc6a
--- /dev/null
+++ b/hegel/hegel.test.mjs
@@ -0,0 +1,429 @@
+// Hegel properties for rbush, checked against a brute-force model.
+//
+// The model is the multiset of item references the tree should hold; `search(bbox)` must return
+// exactly the items whose bounding box intersects the query (closed intervals, as the README's
+// "items that the given bounding box intersects" and the code's `intersects` say), `collides` is
+// "search is non-empty", `all` is the whole multiset. After every operation the tree's shape is
+// checked too: balanced (every leaf at the same depth), every node's bbox is exactly the bbox of
+// its children, no node has more than maxEntries children, no non-root node is empty.
+//
+// Data formats: the default {minX, minY, maxX, maxY} objects, a subclass with toBBox/compareMinX/
+// compareMinY overridden (README "Data Format"), and the same overrides assigned on an instance
+// (as upstream's tests do), over [x0, y0, x1, y1, id] arrays.
+
+import assert from "node:assert/strict";
+import RBush from "../index.js";
+import { chance, count, fail, n, pick, pin, property, same, show } from "./hegel-zoo.mjs";
+
+const Known = {
+  spreadArguments: true, // rbush/1: all() and the containment shortcut of search() spread a node's children into push(); ~1.5e5 children overflow the stack
+  maxEntriesUnchecked: true, // rbush/2: maxEntries is not validated: NaN makes load() throw a TypeError from inside the OMT build, a fractional value builds a malformed tree that later operations trip over
+  nanPoisonsTree: true, // rbush/3: one item with a NaN (or missing) coordinate makes every ancestor bbox NaN: search/collides find nothing, remove finds nothing, all() still lists everything (the generator never makes NaN coordinates)
+};
+
+// ---------- geometry ----------
+
+function intersects(a, b) {
+  return b.minX <= a.maxX && b.minY <= a.maxY && b.maxX >= a.minX && b.maxY >= a.minY;
+}
+
+function genCoord(tc, base) {
+  const r = n(tc, 0, 99);
+  if (r < 45) return base + n(tc, -6, 6);
+  if (r < 70) return base + n(tc, -600, 600) / 10;
+  if (r < 85) return n(tc, -100000, 100000) * 1e10 + n(tc, 0, 999) / 7;
+  if (r < 93) return Math.fround(n(tc, -1000, 1000) / 3);
+  if (r < 97) return pick(tc, [-Infinity, Infinity]);
+  return pick(tc, [0, -0, 1e-9, -1e-9, Number.MAX_SAFE_INTEGER, -Number.MAX_SAFE_INTEGER]);
+}
+
+// a rectangle around a cluster centre (so that items overlap and queries hit), a point, or a line
+function genBox(tc, centre) {
+  let x0 = genCoord(tc, centre.x), y0 = genCoord(tc, centre.y);
+  let x1, y1;
+  const kind = n(tc, 0, 9);
+  if (kind < 3) { x1 = x0; y1 = y0; } // point
+  else if (kind === 3) { x1 = genCoord(tc, centre.x); y1 = y0; } // horizontal line
+  else if (kind === 4) { x1 = x0; y1 = genCoord(tc, centre.y); } // vertical line
+  else { x1 = genCoord(tc, centre.x); y1 = genCoord(tc, centre.y); }
+  if (x1 < x0) [x0, x1] = [x1, x0];
+  if (y1 < y0) [y0, y1] = [y1, y0];
+  if (Number.isNaN(x0 + x1 + y0 + y1)) return { minX: 0, minY: 0, maxX: 0, maxY: 0 }; // Infinity - Infinity is not a rectangle
+  return { minX: x0, minY: y0, maxX: x1, maxY: y1 };
+}
+
+function genQuery(tc, centre, model, fmt) {
+  const r = n(tc, 0, 9);
+  if (model.length && r < 3) {
+    // the exact bbox of an item, or a point inside it
+    const b = fmt.toBBox(pick(tc, model));
+    if (r === 0) return { ...b };
+    const px = b.minX === b.maxX || !Number.isFinite(b.minX + b.maxX) ? b.minX : b.minX + (b.maxX - b.minX) / 2;
+    const py = b.minY === b.maxY || !Number.isFinite(b.minY + b.maxY) ? b.minY : b.minY + (b.maxY - b.minY) / 2;
+    return { minX: px, minY: py, maxX: px, maxY: py };
+  }
+  if (r === 3) return { minX: -Infinity, minY: -Infinity, maxX: Infinity, maxY: Infinity };
+  const q = genBox(tc, centre);
+  if (r === 4) { // an inverted query: accepted by the API, the formula decides
+    count("inverted-query");
+    return { minX: q.maxX, minY: q.minY, maxX: q.minX, maxY: q.maxY };
+  }
+  return q;
+}
+
+// ---------- data formats ----------
+
+let nextId = 1;
+
+const FORMATS = {
+  default: {
+    name: "default",
+    make: (b) => ({ ...b, id: nextId++ }),
+    toBBox: (it) => it,
+    idOf: (it) => it.id,
+    copy: (it) => ({ ...it }),
+    tree: (maxEntries) => (maxEntries === undefined ? new RBush() : new RBush(maxEntries)),
+  },
+  subclass: {
+    name: "subclass",
+    make: (b) => ({ minLng: b.minX, minLat: b.minY, maxLng: b.maxX, maxLat: b.maxY, id: nextId++ }),
+    toBBox: (it) => ({ minX: it.minLng, minY: it.minLat, maxX: it.maxLng, maxY: it.maxLat }),
+    idOf: (it) => it.id,
+    copy: (it) => ({ ...it }),
+    tree: (maxEntries) => {
+      class LngLatRBush extends RBush {
+        toBBox(it) { return { minX: it.minLng, minY: it.minLat, maxX: it.maxLng, maxY: it.maxLat }; }
+        compareMinX(a, b) { return a.minLng - b.minLng; }
+        compareMinY(a, b) { return a.minLat - b.minLat; }
+      }
+      return maxEntries === undefined ? new LngLatRBush() : new LngLatRBush(maxEntries);
+    },
+  },
+  arrays: {
+    name: "arrays",
+    make: (b) => [b.minX, b.minY, b.maxX, b.maxY, nextId++],
+    toBBox: (it) => ({ minX: it[0], minY: it[1], maxX: it[2], maxY: it[3] }),
+    idOf: (it) => it[4],
+    copy: (it) => it.slice(),
+    tree: (maxEntries) => {
+      const t = maxEntries === undefined ? new RBush() : new RBush(maxEntries);
+      t.toBBox = (it) => ({ minX: it[0], minY: it[1], maxX: it[2], maxY: it[3] });
+      t.compareMinX = (a, b) => a[0] - b[0];
+      t.compareMinY = (a, b) => a[1] - b[1];
+      return t;
+    },
+  },
+};
+
+function genFormat(tc) {
+  const r = n(tc, 0, 9);
+  return r < 6 ? FORMATS.default : r < 8 ? FORMATS.subclass : FORMATS.arrays;
+}
+
+function genMaxEntries(tc) {
+  const r = n(tc, 0, 9);
+  if (r < 3) return undefined;
+  if (r < 7) return n(tc, 4, 12);
+  if (r === 7) return n(tc, 13, 40);
+  // documented as "the maximum number of entries in a tree node": the code clamps to >= 4
+  if (!Known.maxEntriesUnchecked && chance(tc, 30)) return pick(tc, [4.5, 6.25, 9.9]);
+  return pick(tc, [0, 1, 2, 3, -5, 200, Infinity, "8"]);
+}
+
+function effectiveMax(m) {
+  return m === undefined ? 9 : Math.max(4, m);
+}
+
+// ---------- multiset helpers ----------
+
+function counts(items) {
+  const m = new Map();
+  for (const it of items) m.set(it, (m.get(it) || 0) + 1);
+  return m;
+}
+
+function sameMultiset(a, b) {
+  if (a.length !== b.length) return false;
+  const ca = counts(a), cb = counts(b);
+  if (ca.size !== cb.size) return false;
+  for (const [k, v] of ca) if (cb.get(k) !== v) return false;
+  return true;
+}
+
+function showItems(fmt, items) {
+  return show(items.slice(0, 12).map((it) => { const b = fmt.toBBox(it); return [fmt.idOf(it), b.minX, b.minY, b.maxX, b.maxY]; })) + (items.length > 12 ? ` …(${items.length})` : "");
+}
+
+// ---------- tree shape ----------
+
+function checkShape(tree, fmt, maxEntries, model, step) {
+  const root = tree.data;
+  const M = effectiveMax(maxEntries);
+  const leafItems = [];
+  const visit = (node, depth, isRoot) => {
+    if (!Array.isArray(node.children)) return fail(`${step}: node without children array ${show(node)}`);
+    if (!isRoot && node.children.length === 0) return fail(`${step}: empty non-root node at depth ${depth}`);
+    if (node.children.length > M) return fail(`${step}: node with ${node.children.length} children, maxEntries ${M}`);
+    if (node.leaf !== (node.height === 1)) return fail(`${step}: leaf flag ${node.leaf} with height ${node.height}`);
+    const tight = { minX: Infinity, minY: Infinity, maxX: -Infinity, maxY: -Infinity };
+    for (const c of node.children) {
+      let b;
+      if (node.leaf) { leafItems.push(c); b = fmt.toBBox(c); }
+      else {
+        if (c.height !== node.height - 1) return fail(`${step}: child of height ${c.height} under a node of height ${node.height}`);
+        b = c;
+        visit(c, depth + 1, false);
+      }
+      tight.minX = Math.min(tight.minX, b.minX); tight.minY = Math.min(tight.minY, b.minY);
+      tight.maxX = Math.max(tight.maxX, b.maxX); tight.maxY = Math.max(tight.maxY, b.maxY);
+    }
+    for (const k of ["minX", "minY", "maxX", "maxY"]) {
+      if (node[k] !== tight[k]) return fail(`${step}: node bbox ${k} = ${node[k]} but its ${node.children.length} children span ${tight[k]} (height ${node.height})`);
+    }
+  };
+  visit(root, 0, true);
+  if (!sameMultiset(leafItems, model)) fail(`${step}: leaves hold ${showItems(fmt, leafItems)} vs model ${showItems(fmt, model)}`);
+}
+
+function checkQueries(tc, tree, fmt, model, centre, step) {
+  const all = tree.all();
+  if (!sameMultiset(all, model)) return fail(`${step}: all() ${showItems(fmt, all)} vs model ${showItems(fmt, model)}`);
+  for (let i = 0; i < 3; i++) {
+    const q = genQuery(tc, centre, model, fmt);
+    const want = model.filter((it) => intersects(q, fmt.toBBox(it)));
+    const got = tree.search(q);
+    if (!sameMultiset(got, want)) return fail(`${step}: search(${show(q)}) ${showItems(fmt, got)} vs brute force ${showItems(fmt, want)} over ${showItems(fmt, model)}`);
+    const c = tree.collides(q);
+    if (c !== want.length > 0) return fail(`${step}: collides(${show(q)}) ${c} but search finds ${want.length}`);
+    if (want.length) count("hit"); else count("miss");
+  }
+}
+
+// ---------- the sequence property ----------
+
+property("TestHegelSearchLikeBruteForce", (tc) => {
+  const fmt = genFormat(tc);
+  const maxEntries = genMaxEntries(tc);
+  count(`format-${fmt.name}`);
+  let tree = fmt.tree(maxEntries);
+  let model = [];
+  const centre = { x: n(tc, -50, 50), y: n(tc, -50, 50) };
+  const finite = () => model.every((it) => { const b = fmt.toBBox(it); return Number.isFinite(b.minX) && Number.isFinite(b.minY) && Number.isFinite(b.maxX) && Number.isFinite(b.maxY); });
+
+  const newItem = () => {
+    // one item in eight repeats an existing reference, one in eight copies an existing box into a new object
+    if (model.length && chance(tc, 12)) { count("duplicate-reference"); return pick(tc, model); }
+    if (model.length && chance(tc, 12)) { count("equal-box"); const c = fmt.copy(pick(tc, model)); if (Array.isArray(c)) c[4] = nextId++; else c.id = nextId++; return c; }
+    return fmt.make(genBox(tc, centre));
+  };
+
+  const steps = n(tc, 1, 30);
+  for (let s = 0; s < steps; s++) {
+    const op = pick(tc, ["insert", "insert", "insert", "load", "load", "remove", "remove", "removeEquals", "clear", "json", "noop"]);
+    let step = `${s}:${op}`;
+    switch (op) {
+      case "insert": {
+        const k = chance(tc, 70) ? 1 : n(tc, 2, 25);
+        for (let i = 0; i < k; i++) { const it = newItem(); const r = tree.insert(it); model.push(it); if (r !== tree) fail(`${step}: insert did not return the tree`); }
+        step += `(${k})`;
+        break;
+      }
+      case "load": {
+        const k = chance(tc, 30) ? n(tc, 0, 3) : n(tc, 4, 60);
+        const batch = []; for (let i = 0; i < k; i++) batch.push(newItem());
+        const copy = batch.slice();
+        const r = tree.load(batch);
+        if (r !== tree) fail(`${step}: load did not return the tree`);
+        if (!same(batch, copy)) fail(`${step}: load mutated its argument`);
+        model.push(...batch);
+        step += `(${k})`;
+        break;
+      }
+      case "remove": {
+        if (model.length && chance(tc, 85)) {
+          const it = pick(tc, model);
+          tree.remove(it);
+          model.splice(model.indexOf(it), 1);
+          count("removed");
+        } else {
+          // an item that is not in the tree (a fresh object with the box of one that is, or unrelated)
+          const foreign = model.length && chance(tc, 50) ? fmt.copy(pick(tc, model)) : fmt.make(genBox(tc, centre));
+          tree.remove(foreign);
+          count("remove-foreign");
+        }
+        break;
+      }
+      case "removeEquals": {
+        if (!model.length) break;
+        const it = pick(tc, model);
+        // the README's case is a copy loaded from a server, i.e. through JSON — which cannot carry Infinity
+        const b = fmt.toBBox(it);
+        const copy = Number.isFinite(b.minX + b.minY + b.maxX + b.maxY) ? JSON.parse(JSON.stringify(it)) : fmt.copy(it);
+        const before = counts(tree.all());
+        tree.remove(copy, (a, b2) => fmt.idOf(a) === fmt.idOf(b2));
+        // several distinct objects may share the id (duplicate references restored from JSON): remove from the model the one the tree dropped
+        const after = counts(tree.all());
+        const dropped = [...before].filter(([k, v]) => (after.get(k) || 0) !== v).map(([k]) => k);
+        if (dropped.length !== 1 || fmt.idOf(dropped[0]) !== fmt.idOf(it) || (before.get(dropped[0]) - (after.get(dropped[0]) || 0)) !== 1) return fail(`${step}: remove(copy of ${fmt.idOf(it)}, byId) dropped ${showItems(fmt, dropped)} from ${showItems(fmt, model)}`);
+        model.splice(model.indexOf(dropped[0]), 1);
+        count("removed-by-equals");
+        break;
+      }
+      case "clear": {
+        if (chance(tc, 60)) break;
+        const r = tree.clear();
+        if (r !== tree) fail(`${step}: clear did not return the tree`);
+        model = [];
+        break;
+      }
+      case "json": {
+        if (!finite()) { count("json-skipped-infinite"); break; }
+        if (!model.length) { count("json-skipped-empty"); break; } // an empty root's bbox is ±Infinity, which JSON turns into null (README note)
+        // toJSON is a plain-data tree that survives JSON; the items come back as copies, matched by id
+        const text = JSON.stringify(tree.toJSON());
+        const restored = fmt.tree(maxEntries).fromJSON(JSON.parse(text));
+        const byId = new Map();
+        for (const it of restored.all()) { const id = fmt.idOf(it); if (!byId.has(id)) byId.set(id, []); byId.get(id).push(it); }
+        const remapped = [];
+        for (const it of model) {
+          const list = byId.get(fmt.idOf(it));
+          if (!list || !list.length) return fail(`${step}: after the JSON round trip item ${fmt.idOf(it)} is missing (all: ${showItems(fmt, restored.all())})`);
+          const c = list.pop();
+          if (!same(c, JSON.parse(JSON.stringify(it)))) return fail(`${step}: item ${fmt.idOf(it)} came back as ${show(c)}`);
+          remapped.push(c);
+        }
+        for (const [id, list] of byId) if (list.length) return fail(`${step}: extra item ${id} after the JSON round trip`);
+        tree = restored; model = remapped;
+        count("json-round-trip");
+        break;
+      }
+      case "noop": {
+        // the documented no-ops
+        const before = JSON.stringify(tree.toJSON());
+        tree.insert(undefined); tree.insert(null); tree.remove(undefined); tree.remove(null); tree.load([]); tree.load(undefined); tree.load(null);
+        if (JSON.stringify(tree.toJSON()) !== before) fail(`${step}: insert/remove of undefined or load of nothing changed the tree`);
+        break;
+      }
+    }
+    checkShape(tree, fmt, maxEntries, model, step);
+    checkQueries(tc, tree, fmt, model, centre, step);
+  }
+  count(`items-${model.length < 10 ? "0-9" : model.length < 50 ? "10-49" : model.length < 150 ? "50-149" : "150+"}`);
+});
+
+// ---------- bulk load vs insertion ----------
+
+property("TestHegelLoadLikeInserts", (tc) => {
+  const fmt = genFormat(tc);
+  const maxEntries = genMaxEntries(tc);
+  const M = effectiveMax(maxEntries);
+  const centre = { x: 0, y: 0 };
+  const k = n(tc, 0, 120);
+  const batch = []; for (let i = 0; i < k; i++) batch.push(fmt.make(genBox(tc, centre)));
+  const loaded = fmt.tree(maxEntries).load(batch.slice());
+  const inserted = fmt.tree(maxEntries);
+  for (const it of batch) inserted.insert(it);
+  if (!sameMultiset(loaded.all(), inserted.all())) fail(`load ${showItems(fmt, loaded.all())} vs inserts ${showItems(fmt, inserted.all())}`);
+  checkShape(loaded, fmt, maxEntries, batch, `load(${k})`);
+  checkShape(inserted, fmt, maxEntries, batch, `insert×${k}`);
+  // the same queries answer the same on both
+  for (let i = 0; i < 5; i++) {
+    const q = genQuery(tc, centre, batch, fmt);
+    const a = loaded.search(q), b = inserted.search(q), want = batch.filter((it) => intersects(q, fmt.toBBox(it)));
+    if (!sameMultiset(a, want) || !sameMultiset(b, want)) fail(`search(${show(q)}): load ${showItems(fmt, a)}, inserts ${showItems(fmt, b)}, brute force ${showItems(fmt, want)}`);
+  }
+  // bulk load of a second batch into a non-empty tree (STLT) keeps everything
+  const k2 = n(tc, 0, 60);
+  const batch2 = []; for (let i = 0; i < k2; i++) batch2.push(fmt.make(genBox(tc, { x: n(tc, -300, 300), y: n(tc, -300, 300) })));
+  loaded.load(batch2.slice());
+  const both = batch.concat(batch2);
+  if (!sameMultiset(loaded.all(), both)) fail(`load(${k}).load(${k2}): ${showItems(fmt, loaded.all())} vs ${showItems(fmt, both)}`);
+  checkShape(loaded, fmt, maxEntries, both, `load(${k}).load(${k2})`);
+  // heights: a bulk-loaded tree of up to M items is one leaf; more items need more levels
+  if (k > 0 && k <= M && fmt.tree(maxEntries).load(batch.slice()).toJSON().height !== 1) fail(`load(${k}) with maxEntries ${M} is not a single leaf`);
+  if (k > M && Number.isFinite(M) && fmt.tree(maxEntries).load(batch.slice()).toJSON().height < 2) fail(`load(${k}) with maxEntries ${M} has height 1`);
+  count(`height-${loaded.toJSON().height}`);
+});
+
+// ---------- constructor and API surface ----------
+
+property("TestHegelApiSurface", (tc) => {
+  const m = genMaxEntries(tc);
+  const t = m === undefined ? new RBush() : new RBush(m);
+  // an empty tree
+  if (t.all().length !== 0) fail("new tree has items");
+  if (t.search({ minX: -Infinity, minY: -Infinity, maxX: Infinity, maxY: Infinity }).length !== 0) fail("search on an empty tree finds items");
+  if (t.collides({ minX: -Infinity, minY: -Infinity, maxX: Infinity, maxY: Infinity }) !== false) fail("collides on an empty tree");
+  const j = t.toJSON();
+  if (!same(j, { children: [], height: 1, leaf: true, minX: Infinity, minY: Infinity, maxX: -Infinity, maxY: -Infinity })) fail(`empty toJSON ${show(j)}`);
+  // chaining
+  const it = { minX: 1, minY: 2, maxX: 3, maxY: 4 };
+  const r = t.load([it]).insert(it).remove(it).clear().fromJSON(new RBush().toJSON());
+  if (r !== t) fail("the API is not chainable");
+  // toBBox default is the identity
+  if (t.toBBox(it) !== it) fail("toBBox is not the identity by default");
+  if (t.compareMinX({ minX: 5 }, { minX: 2 }) !== 3 || t.compareMinY({ minY: 1 }, { minY: 2 }) !== -1) fail("compareMinX/Y are not minX/minY differences");
+  // the same maxEntries on export and import: a tree rebuilt from JSON answers like the original
+  const items = []; for (let i = 0; i < n(tc, 1, 40); i++) items.push({ ...genBox(tc, { x: 0, y: 0 }), i });
+  const a = (m === undefined ? new RBush() : new RBush(m)).load(items);
+  const b = (m === undefined ? new RBush() : new RBush(m)).fromJSON(a.toJSON());
+  const q = genBox(tc, { x: 0, y: 0 });
+  if (!sameMultiset(a.search(q), b.search(q))) fail(`fromJSON(toJSON()) answers differently for ${show(q)}`);
+  if (b.data !== a.data) fail("fromJSON does not adopt the given data object");
+  count(`max-${m}`);
+});
+
+// ---------- pins ----------
+
+pin("TestHegelPinAllOnLargeLeaf", () => {
+  // rbush/1: a leaf of 300000 items — maxEntries 300000, "higher value means faster insertion and
+  // slower search" — is searched fine, but all() (and search through the containment shortcut)
+  // throws RangeError: Maximum call stack size exceeded from push(...node.children)
+  const N = 300000;
+  const items = Array.from({ length: N }, (_, i) => ({ minX: i, minY: 0, maxX: i + 1, maxY: 1 }));
+  const t = new RBush(N).load(items);
+  assert.equal(t.search({ minX: -1, minY: -1, maxX: N + 1, maxY: 2 }).length, N, "search of the whole plane");
+  let all;
+  assert.doesNotThrow(() => { all = t.all(); }, "all() on a leaf of 300000 items");
+  assert.equal(all.length, N);
+});
+
+pin("TestHegelPinMaxEntriesValidated", () => {
+  // rbush/2: the constructor keeps whatever it is given (Math.max(4, x)). new RBush(NaN) — e.g. parseInt
+  // of a missing setting — then builds an unsplittable leaf on insert() while load() of any items throws
+  // "Cannot read properties of undefined (reading 'minX')" from _build; new RBush(4.5) bulk-loads a tree
+  // whose non-leaf nodes have height 1, and a later insert() or search() throws a TypeError. Correct is
+  // a constructor error, or rounding to an integer node size.
+  const items = Array.from({ length: 5 }, (_, i) => ({ minX: i, minY: i, maxX: i, maxY: i }));
+  let t;
+  try { t = new RBush(NaN); } catch { return; } // rejecting the argument is fine
+  assert.doesNotThrow(() => t.load(items), "load() with maxEntries NaN");
+  assert.equal(t.all().length, 5);
+  let seed = 1;
+  const rnd = () => { seed = (seed * 1103515245 + 12345) & 0x7fffffff; return seed / 0x7fffffff; };
+  const box = () => { const x = Math.floor(rnd() * 100), y = Math.floor(rnd() * 100); return { minX: x, minY: y, maxX: x + Math.floor(rnd() * 10), maxY: y + Math.floor(rnd() * 10) }; };
+  const data = Array.from({ length: 112 }, box);
+  let f;
+  try { f = new RBush(4.5); } catch { return; }
+  f.load(data);
+  const extra = Array.from({ length: 20 }, box);
+  assert.doesNotThrow(() => { for (const e of extra) f.insert(e); f.search({ minX: 0, minY: 0, maxX: 100, maxY: 100 }); }, "insert() and search() after load() with maxEntries 4.5");
+  assert.equal(f.all().length, 132);
+});
+
+pin("TestHegelPinNaNItemDoesNotBlindTheTree", () => {
+  // rbush/3: an item with a misspelt property ({minx} for {minX}) has minX undefined; extend() puts
+  // Math.min(…, undefined) = NaN into every bbox on its insertion path up to the root, and since no
+  // comparison with NaN is true, search() and collides() answer nothing for the whole tree and
+  // remove() cannot find any item — not even the bad one — while all() still returns everything.
+  // Correct is a TypeError on insert, or the other items staying searchable.
+  const items = Array.from({ length: 20 }, (_, i) => ({ minX: i, minY: 0, maxX: i + 1, maxY: 1 }));
+  const t = new RBush(4).load(items);
+  const q = { minX: 3, minY: 0, maxX: 4, maxY: 1 };
+  assert.equal(t.search(q).length, 3);
+  try { t.insert({ minx: 5, minY: 0, maxX: 6, maxY: 1 }); } catch { return; } // rejecting it is fine
+  assert.equal(t.search(q).length, 3, "search after inserting an item with a missing coordinate");
+  assert.equal(t.collides(q), true);
+  t.remove(items[3]);
+  assert.equal(t.all().length, 20, "remove() after inserting an item with a missing coordinate");
+});
