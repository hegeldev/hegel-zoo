diff --git a/hegel/hegel-zoo.mjs b/hegel/hegel-zoo.mjs
new file mode 100644
index 0000000..1ca6f10
--- /dev/null
+++ b/hegel/hegel-zoo.mjs
@@ -0,0 +1,163 @@
+// Hegel zoo: the small harness shared by the zoo's TypeScript/JavaScript targets.
+//
+// `property(name, body)` registers a node:test test that runs `body(tc)` under Hegel with
+// HEGEL_TEST_CASES cases (default 100) and the database at HEGEL_DATABASE. With ZOO_COLLECT=1
+// a `fail()` records the mismatch instead of failing, the case ends there, and the counts of
+// mismatches and of the shapes seen (`count(key)`) are printed at the end of the test, so a
+// property can be run over many cases to see every shape at once. `pin(name, body)` is a
+// plain test for one pinned bug: it must fail while the bug is present and pass once it is
+// fixed (the zoo's judge reads an unexpected pass as "fixed upstream?").
+
+import { readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+import { test as nodeTest } from "node:test";
+
+// The Hegel version these tests were written against (the zoo pins it in zoo.toml; upstream
+// would add it to devDependencies). Hegel and esbuild are installed with `npm install --prefix
+// .hegel` so the target's own package.json and lock file stay untouched. Checked at load time so
+// a stray install cannot silently change the engine.
+export const HEGEL_PIN = { "@hegeldev/hegel": "0.4.5" };
+
+const hegelDir = join(dirname(fileURLToPath(import.meta.url)), "..", ".hegel", "node_modules", "@hegeldev", "hegel");
+{
+  const installed = JSON.parse(readFileSync(join(hegelDir, "package.json"), "utf8")).version;
+  if (installed !== HEGEL_PIN["@hegeldev/hegel"]) {
+    throw new Error(`@hegeldev/hegel ${installed} is installed; these tests pin ${HEGEL_PIN["@hegeldev/hegel"]}`);
+  }
+}
+const hegel = await import(pathToFileURL(join(hegelDir, "dist", "index.js")));
+const gs = await import(pathToFileURL(join(hegelDir, "dist", "generators", "index.js")));
+
+export const collecting = !!process.env.ZOO_COLLECT;
+
+class Collected extends Error {}
+
+let msgs = [];
+let stats = new Map();
+
+/** Report a mismatch: an error normally, a recorded line in collect mode. */
+export function fail(message) {
+  if (collecting) {
+    msgs.push(message);
+    throw new Collected(message);
+  }
+  throw new Error(message);
+}
+
+/** Bump a statistic (the shape of a pinned bug, a generator branch). */
+export function count(key) {
+  stats.set(key, (stats.get(key) || 0) + 1);
+}
+
+function settings() {
+  const s = { testCases: Number(process.env.HEGEL_TEST_CASES) || 100 };
+  if (process.env.HEGEL_DATABASE) {
+    s.database = hegel.Database.fromPath(process.env.HEGEL_DATABASE);
+  }
+  return s;
+}
+
+/** A property: `body(tc)` runs under Hegel; a thrown error (or `fail`) is a failure. */
+export function property(name, body) {
+  nodeTest(name, () => {
+    msgs = [];
+    stats = new Map();
+    hegel.test((tc) => {
+      try {
+        body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** An async property: `body(tc)` may await; runs under Hegel's testAsync with the same settings. */
+export function propertyAsync(name, body) {
+  nodeTest(name, async () => {
+    msgs = [];
+    stats = new Map();
+    await hegel.testAsync(async (tc) => {
+      try {
+        await body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** A pin: a plain test for one recorded bug. */
+export function pin(name, body) {
+  nodeTest(name, body);
+}
+
+/** An integer in [lo, hi]. */
+export function n(tc, lo, hi) {
+  return tc.draw(gs.integers({ minValue: lo, maxValue: hi }));
+}
+
+/** One of xs. */
+export function pick(tc, xs) {
+  return xs[n(tc, 0, xs.length - 1)];
+}
+
+/** True pct percent of the time. */
+export function chance(tc, pct) {
+  return n(tc, 0, 99) < pct;
+}
+
+/** A string of `len` characters drawn from `alphabet` (an array of strings). */
+export function word(tc, alphabet, lo, hi) {
+  const len = n(tc, lo, hi);
+  let s = "";
+  for (let i = 0; i < len; i++) {
+    s += pick(tc, alphabet);
+  }
+  return s;
+}
+
+/** Structural equality: arrays by position, objects by key set (prototype ignored), else ===. */
+export function same(a, b) {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) {
+      return false;
+    }
+    return a.every((x, i) => same(x, b[i]));
+  }
+  if (a !== null && b !== null && typeof a === "object" && typeof b === "object") {
+    const ka = Object.keys(a).sort();
+    const kb = Object.keys(b).sort();
+    if (ka.length !== kb.length || ka.some((k, i) => k !== kb[i])) {
+      return false;
+    }
+    return ka.every((k) => same(a[k], b[k]));
+  }
+  return a === b;
+}
+
+/** A compact, unambiguous rendering for messages. */
+export function show(x) {
+  return JSON.stringify(x, (k, v) => (v === undefined ? "<undefined>" : v));
+}
diff --git a/hegel/hegel.test.mjs b/hegel/hegel.test.mjs
new file mode 100644
index 0000000..000d23c
--- /dev/null
+++ b/hegel/hegel.test.mjs
@@ -0,0 +1,350 @@
+// Hegel zoo: fast-xml-parser against expat (Python's xml.parsers.expat) on generated
+// well-formed XML, the folded object shape against a model of the ordered one, the builder
+// round trip, the validator against expat on mutated documents, and hostile input.
+
+import assert from "node:assert/strict";
+import { chance, count, fail, n, pick, pin, property, same, show, word } from "./hegel-zoo.mjs";
+import {
+  ORDERED, PLAIN, XMLBuilder, XMLParser, XMLValidator, canonExpected, canonOracle, canonOrdered,
+  describe, foldElement, fxpParse, genDocument, mutate, pyParse,
+} from "./xml.mjs";
+import { known } from "./known.mjs";
+
+/** The path of the first difference between two canonical values, for messages. */
+function firstDiff(a, b, path = "$") {
+  if (Array.isArray(a) && Array.isArray(b)) {
+    for (let i = 0; i < Math.min(a.length, b.length); i++) {
+      const d = firstDiff(a[i], b[i], `${path}[${i}]`);
+      if (d) return d;
+    }
+    return a.length === b.length ? null : `${path}: ${a.length} vs ${b.length} items`;
+  }
+  if (a && b && typeof a === "object" && typeof b === "object" && !Array.isArray(a) && !Array.isArray(b)) {
+    for (const k of new Set([...Object.keys(a), ...Object.keys(b)])) {
+      const d = firstDiff(a[k], b[k], `${path}.${k}`);
+      if (d) return d;
+    }
+    return null;
+  }
+  return same(a, b) ? null : `${path}: ${show(a)} vs ${show(b)}`;
+}
+
+/** The oracle's canonical reading of a generated document, checked against the generator's
+ *  own expectation (a disagreement there is a harness bug, reported loudly). */
+function oracleOf(doc) {
+  const py = pyParse(doc.xml);
+  if (!py.ok) throw new Error(`the generator produced XML expat rejects: ${py.error} at ${py.line}:${py.col}\n${show(doc.xml)}`);
+  const want = canonOracle(py.doc);
+  const model = canonExpected(doc.expected);
+  const d = firstDiff(want, model);
+  if (d) throw new Error(`the generator's expectation disagrees with expat: ${d}\n${show(doc.xml)}`);
+  return want;
+}
+
+property("TestHegelParseAgreesWithExpat", (tc) => {
+  const doc = genDocument(tc);
+  describe(doc.expected);
+  const want = oracleOf(doc);
+  let out;
+  try {
+    out = fxpParse(doc.xml, ORDERED);
+  } catch (e) {
+    const id = known(doc, want);
+    if (id) {
+      count("known " + id);
+      return;
+    }
+    fail(`parse throws ${e.message} on well-formed XML\n xml: ${show(doc.xml)}`);
+  }
+  let got;
+  try {
+    got = canonOrdered(out);
+  } catch (e) {
+    // (a PI whose data holds a quote can also swallow the tags after it: fast-xml-parser/4)
+    const id = known(doc, want);
+    if (id) {
+      count("known " + id);
+      return;
+    }
+    fail(`ordered output not understood: ${e.message}\n xml: ${show(doc.xml)}\n out: ${show(out)}`);
+  }
+  const d = firstDiff(got, want);
+  if (d) {
+    const id = known(doc, want, got);
+    if (id) {
+      count("known " + id);
+      return;
+    }
+    fail(`parse (preserveOrder) differs from expat at ${d}\n xml: ${show(doc.xml)}\n fxp:   ${show(got)}\n expat: ${show(want)}`);
+  }
+  count("agree");
+});
+
+property("TestHegelPlainShapeMatchesTheModel", (tc) => {
+  const doc = genDocument(tc);
+  const want = oracleOf(doc);
+  const model = {};
+  model[want.root.n] = foldElement(want.root);
+  let got;
+  try {
+    got = fxpParse(doc.xml, PLAIN);
+  } catch (e) {
+    const id = known(doc, want);
+    if (id) {
+      count("known " + id);
+      return;
+    }
+    fail(`parse throws ${e.message} on well-formed XML\n xml: ${show(doc.xml)}`);
+  }
+  const d = firstDiff(got, model);
+  if (d) {
+    const id = known(doc, model, got);
+    if (id) {
+      count("known " + id);
+      return;
+    }
+    fail(`parse (default shape) differs from the model at ${d}\n xml: ${show(doc.xml)}\n fxp:   ${show(got)}\n model: ${show(model)}`);
+  }
+  count("agree");
+});
+
+/** The canonical document with every tab, LF and CR in attribute values replaced by a space. */
+function spaceAttrs(x) {
+  if (Array.isArray(x)) return x.map(spaceAttrs);
+  if (x && typeof x === "object") {
+    const out = { ...x };
+    if (x.t === "el") {
+      out.a = Object.fromEntries(Object.entries(x.a).map(([k, v]) => [k, v.replace(/[\t\n\r]/g, " ")]));
+      out.c = x.c.map(spaceAttrs);
+    } else {
+      for (const k of ["prolog", "epilog", "root"]) if (k in x) out[k] = spaceAttrs(x[k]);
+    }
+    return out;
+  }
+  return x;
+}
+
+property("TestHegelBuilderRoundTrip", (tc) => {
+  const doc = genDocument(tc);
+  const want = oracleOf(doc);
+  let out;
+  try {
+    out = fxpParse(doc.xml, ORDERED);
+  } catch {
+    count("parse throws (reported elsewhere)");
+    return;
+  }
+  let got;
+  try {
+    got = canonOrdered(out);
+  } catch {
+    count("ordered output not understood (reported elsewhere)");
+    return;
+  }
+  if (firstDiff(got, want)) {
+    count("parse differs (reported elsewhere)");
+    return;
+  }
+  const builder = new XMLBuilder({
+    preserveOrder: true, ignoreAttributes: false, attributeNamePrefix: "", commentPropName: "#comment",
+    format: false, suppressEmptyNode: false, processEntities: true,
+  });
+  let xml2;
+  try {
+    xml2 = builder.build(out);
+  } catch (e) {
+    fail(`build throws ${e.message}\n xml: ${show(doc.xml)}\n ordered: ${show(out)}`);
+  }
+  // what the builder wrote is well-formed XML meaning the same document
+  const py = pyParse(xml2);
+  if (!py.ok) {
+    fail(`the builder's output is not well-formed: ${py.error} at ${py.line}:${py.col}\n xml: ${show(doc.xml)}\n built: ${show(xml2)}`);
+  }
+  const back = canonOracle(py.doc);
+  const d = firstDiff(back, want);
+  if (d) {
+    // the builder writes a tab, LF or CR of an attribute value literally, so it reads back as a
+    // space: a bug of fast-xml-builder (a separate package the XMLBuilder export comes from), not
+    // of the target, so it is counted and not judged
+    if (same(spaceAttrs(back), spaceAttrs(want))) {
+      count("builder writes attribute whitespace literally (fast-xml-builder, not judged)");
+      return;
+    }
+    fail(`the builder's output reads differently at ${d}\n xml: ${show(doc.xml)}\n built: ${show(xml2)}\n built reads: ${show(back)}\n original:    ${show(want)}`);
+  }
+  // and parsing it again gives the same ordered object
+  const again = canonOrdered(fxpParse(xml2, ORDERED));
+  const d2 = firstDiff(again, got);
+  if (d2) {
+    fail(`parse(build(parse(xml))) differs at ${d2}\n xml: ${show(doc.xml)}\n built: ${show(xml2)}`);
+  }
+  count("round trip");
+});
+
+property("TestHegelValidatorAgreesWithExpat", (tc) => {
+  const doc = genDocument(tc);
+  oracleOf(doc);
+  if (chance(tc, 30)) {
+    // a well-formed document is valid, with and without validation on parse
+    const v = XMLValidator.validate(doc.xml);
+    if (v !== true) {
+      const id = known(doc, undefined, undefined, v);
+      if (id) {
+        count("known " + id);
+        return;
+      }
+      fail(`validate rejects well-formed XML: ${show(v)}\n xml: ${show(doc.xml)}`);
+    }
+    try {
+      fxpParse(doc.xml, ORDERED, true);
+    } catch (e) {
+      const id = known(doc, undefined, undefined, false);
+      if (id) {
+        count("known " + id);
+        return;
+      }
+      fail(`parse with validation throws on well-formed XML: ${e.message}\n xml: ${show(doc.xml)}`);
+    }
+    count("well-formed accepted");
+    return;
+  }
+  let xml = doc.xml;
+  const edits = n(tc, 1, 3);
+  for (let i = 0; i < edits; i++) xml = mutate(tc, xml);
+  const py = pyParse(xml);
+  const v = XMLValidator.validate(xml);
+  if (py.ok) {
+    if (v !== true) {
+      const id = known({ xml, mutated: true }, undefined, undefined, v);
+      if (id) {
+        count("known " + id);
+        return;
+      }
+      fail(`validate rejects XML expat accepts: ${show(v)}\n xml: ${show(xml)}`);
+    }
+    count("mutated, still well-formed, accepted");
+  } else if (v === true) {
+    // the validator is lenient by design in places; counted by expat's reason
+    count("lax: " + py.error);
+  } else {
+    count("both reject");
+  }
+});
+
+const junkChars = ["<", ">", "&", '"', "'", "/", "=", "]", "[", "!", "-", "?", ";", "#", " ", "\n", "\r", "\t", "a", "b", "x", "1", ":", ".", "_", "CDATA", "DOCTYPE", "ENTITY", "--", "<!", "<?", "</", "/>", "xml", "日", "\ud800", "\0", "%"];
+
+property("TestHegelHostileInputNeverCrashes", (tc) => {
+  let xml;
+  if (chance(tc, 50)) {
+    xml = word(tc, junkChars, 0, 30);
+  } else {
+    xml = genDocument(tc).xml;
+    const edits = n(tc, 1, 6);
+    for (let i = 0; i < edits; i++) xml = mutate(tc, xml);
+  }
+  for (const [name, options] of [["ORDERED", ORDERED], ["PLAIN", PLAIN], ["default", {}]]) {
+    for (const validate of [false, true]) {
+      const t0 = Date.now();
+      try {
+        const out = new XMLParser(options).parse(xml, validate);
+        if (out === undefined || out === null) fail(`parse gives ${out}\n xml: ${show(xml)}`);
+      } catch (e) {
+        if (!(e instanceof Error) || e instanceof TypeError || e instanceof RangeError || e instanceof ReferenceError) {
+          fail(`parse (${name}, validate ${validate}) crashes with ${e && e.constructor && e.constructor.name}: ${e && e.message}\n xml: ${show(xml)}`);
+        }
+      }
+      if (Date.now() - t0 > 2000) fail(`parse (${name}) took ${Date.now() - t0} ms\n xml: ${show(xml)}`);
+    }
+  }
+  const t0 = Date.now();
+  let v;
+  try {
+    v = XMLValidator.validate(xml);
+  } catch (e) {
+    fail(`validate throws ${e && e.constructor && e.constructor.name}: ${e && e.message}\n xml: ${show(xml)}`);
+  }
+  if (Date.now() - t0 > 2000) fail(`validate took ${Date.now() - t0} ms\n xml: ${show(xml)}`);
+  if (v !== true && !(v && v.err && typeof v.err.msg === "string")) fail(`validate gives ${show(v)}\n xml: ${show(xml)}`);
+  count(v === true ? "valid" : "invalid");
+});
+
+// Pins: one plain test per recorded bug (bugs.toml); each fails while the bug is present.
+
+pin("TestHegelPinAttributeValuesAreNormalised", () => {
+  // XML 1.0 3.3.3: a literal tab, LF or CR in an attribute value becomes a space (expat: "x y")
+  const out = fxpParse('<r a="x\ty" b="x\ny" c="x\r\ny" d="&#9;"/>', ORDERED);
+  assert.deepEqual(out[0][":@"], { a: "x y", b: "x y", c: "x y", d: "\t" });
+  // the same for the replacement text of an entity referenced in the value
+  const out2 = fxpParse('<!DOCTYPE r [<!ENTITY e "a\tb">]><r a="&e;"/>', ORDERED);
+  assert.deepEqual(out2[0][":@"], { a: "a b" });
+});
+
+pin("TestHegelPinWhitespaceBeforeMiscOutsideTheRootIsNotText", () => {
+  // whitespace between the root and a comment or PI is not character data (expat reports none)
+  assert.deepEqual(fxpParse("<r/> <!--c-->", ORDERED), [{ r: [] }, { "#comment": [{ "#text": "c" }] }]);
+  assert.deepEqual(fxpParse("<!--c-->\n<r/>", ORDERED), [{ "#comment": [{ "#text": "c" }] }, { r: [] }]);
+  assert.deepEqual(fxpParse(" <?pi x?> <r/>", PLAIN), { r: "" });
+});
+
+pin("TestHegelPinParameterEntityDeclarationIsAccepted", () => {
+  // a parameter-entity declaration in the internal subset is well-formed (expat reads y)
+  assert.deepEqual(fxpParse('<!DOCTYPE r [<!ENTITY % pe "x">]><r>y</r>', ORDERED), [{ r: [{ "#text": "y" }] }]);
+});
+
+pin("TestHegelPinPIDataMayHoldAQuote", () => {
+  // a processing instruction's data is free text: a quote in it is no error and swallows nothing
+  for (const xml of ["<?pi it's data?><r/>", "<r><?pi don't?></r>", "<r><?pi 'a?><b/><c d=\"1\"/></r>"]) {
+    const out = fxpParse(xml, PLAIN);
+    assert.ok("r" in out, `${xml} gives ${show(out)}`);
+  }
+  const out = fxpParse("<r><?pi 'a?><b/><c d=\"1\"/></r>", PLAIN);
+  assert.deepEqual(out, { r: { b: "", c: { "@_d": "1" } } });
+});
+
+pin("TestHegelPinFirstEntityDeclarationBinds", () => {
+  // XML 1.0 4.2: "If the same entity is declared more than once, the first declaration
+  // encountered is binding" (expat reads 1)
+  assert.deepEqual(fxpParse('<!DOCTYPE r [<!ENTITY a "1"><!ENTITY a "2">]><r>&a;</r>', ORDERED), [{ r: [{ "#text": "1" }] }]);
+});
+
+pin("TestHegelPinValidatorAcceptsLongEntityReferences", () => {
+  // an entity name has no length limit; the validator accepts 20 characters and refuses 21
+  const name = "e".repeat(21);
+  assert.equal(XMLValidator.validate(`<r>&${name};</r>`), true);
+  assert.doesNotThrow(() => fxpParse(`<!DOCTYPE r [<!ENTITY ${name} "x">]><r>&${name};</r>`, ORDERED, true));
+});
+
+pin("TestHegelPinValidatorReadsQuotedGreaterThanInEntityValue", () => {
+  // a '>' inside a quoted entity value does not end the DOCTYPE (the parser itself reads a>b)
+  assert.equal(XMLValidator.validate('<!DOCTYPE r [<!ENTITY e "a>b">]><r>&e;</r>'), true);
+});
+
+pin("TestHegelPinValidatorRejectsASecondRootAfterASelfClosingOne", () => {
+  // <r></r><s></s> and <r></r>tail are rejected; with a self-closing tag on either side they pass
+  for (const xml of ["<r/><s/>", "<r/>tail", "<r>a</r><s/>", "<r/><s>1</s>", "<r></r><!--c--><s/>"]) {
+    assert.notEqual(XMLValidator.validate(xml), true, `${xml} validates`);
+  }
+});
+
+pin("TestHegelPinValidatorRejectsXmlDeclarationInsideTheDocument", () => {
+  // the validator rejects a second declaration in the prolog but not one inside or after the root
+  for (const xml of ['<r><?xml version="1.0"?></r>', '<?xml version="1.0"?><r/><?xml version="1.0"?>']) {
+    assert.notEqual(XMLValidator.validate(xml), true, `${xml} validates`);
+  }
+});
+
+pin("TestHegelPinValidatorRejectsIllFormedTextAttributesReferencesAndComments", () => {
+  // each is a well-formedness error under XML 1.0 (expat: "not well-formed (invalid token)")
+  for (const xml of ["<r>]]></r>", '<r a="<"/>', "<r>&#;</r>", "<r>&#x;</r>", "<r><!-- a -- b --></r>"]) {
+    assert.notEqual(XMLValidator.validate(xml), true, `${xml} validates`);
+  }
+});
+
+pin("TestHegelPinMetaDataOffsetsIndexTheInput", () => {
+  // docs: `xml.slice(startIndex, endIndex)` is the tag's text; with a CRLF before the tag the
+  // offsets refer to the normalised string and the slice is off by the dropped CRs
+  const xml = "<r>\r\n<a><b/></a></r>";
+  const out = new XMLParser({ captureMetaData: true }).parse(xml);
+  const m = out.r.a[XMLParser.getMetaDataSymbol()];
+  assert.equal(xml.slice(m.startIndex, m.endIndex), "<a><b/></a>");
+});
diff --git a/hegel/known.mjs b/hegel/known.mjs
new file mode 100644
index 0000000..3dd705a
--- /dev/null
+++ b/hegel/known.mjs
@@ -0,0 +1,86 @@
+// Hegel zoo: the recorded bugs of fast-xml-parser (bugs.toml), as gates. `known(doc, want, got,
+// v)` returns the bug id when the generated document (`doc.xml`), the shape of the disagreement
+// between fast-xml-parser's canonical reading `got` and expat's `want`, or the validator's
+// verdict `v` has the shape of a recorded bug, so the case is counted rather than judged;
+// ZOO_NO_KNOWN=1 lifts the gates.
+
+import { same } from "./hegel-zoo.mjs";
+
+const lifted = !!process.env.ZOO_NO_KNOWN;
+
+export function known(doc, want, got, v) {
+  if (lifted) return "";
+  const xml = doc.xml;
+  // fast-xml-parser/3: a parameter-entity declaration in the internal subset throws
+  if (/<!ENTITY\s+%/.test(xml)) return "fast-xml-parser/3";
+  // fast-xml-parser/4: a processing instruction whose data holds a quote throws
+  if (/<\?(?!xml[\s?])[^\s?>]*\s(?:[^?]|\?(?!>))*['"]/.test(xml)) return "fast-xml-parser/4";
+  // fast-xml-parser/5: of two declarations of one entity the last binds
+  if (doc.dups) return "fast-xml-parser/5";
+  if (v !== undefined && v !== true) {
+    // fast-xml-parser/6: the validator refuses an entity reference of more than 20 characters
+    if (/&[^\s&;#]{21,};/.test(xml)) return "fast-xml-parser/6";
+    // fast-xml-parser/7: the validator reads a '>' inside a quoted entity value as the end of the DOCTYPE
+    if (/<!ENTITY[^>]*(?:"[^"]*>[^"]*"|'[^']*>[^']*')/.test(xml)) return "fast-xml-parser/7";
+  }
+  if (got && want) {
+    // fast-xml-parser/1: attribute values are not normalised (a literal tab, LF or CR stays)
+    let g = normaliseAttrs(got, want);
+    if (same(g, want)) return "fast-xml-parser/1";
+    // fast-xml-parser/2: whitespace before a comment or PI outside the root is a #text node
+    g = dropTopWhitespace(g);
+    if (same(g, want)) return "fast-xml-parser/2";
+  }
+  return "";
+}
+
+/** `got` with every attribute value that differs from `want`'s only by tab/LF/CR against space
+ *  replaced by `want`'s (a referenced tab must stay: only differing values are touched). */
+export function normaliseAttrs(got, want) {
+  if (Array.isArray(got)) {
+    return Array.isArray(want) ? got.map((x, i) => normaliseAttrs(x, want[i])) : got;
+  }
+  if (got && typeof got === "object") {
+    const out = {};
+    for (const k of Object.keys(got)) {
+      const w = want && typeof want === "object" ? want[k] : undefined;
+      if (k === "a" && got.t === "el" && w && typeof w === "object") {
+        out.a = {};
+        for (const an of Object.keys(got.a)) out.a[an] = normalisedValue(got.a[an], w[an]);
+      } else if (k.startsWith("@_") && typeof got[k] === "string") {
+        out[k] = normalisedValue(got[k], w);
+      } else {
+        out[k] = normaliseAttrs(got[k], w);
+      }
+    }
+    return out;
+  }
+  return got;
+}
+
+/** `w` when `g` differs from it only by literal tabs, LFs or CRs where `w` has a space (a
+ *  referenced `&#9;` stays a tab on both sides, so the comparison is by position). */
+function normalisedValue(g, w) {
+  if (typeof g !== "string" || typeof w !== "string" || g === w || g.length !== w.length) return g;
+  for (let i = 0; i < g.length; i++) {
+    if (g[i] !== w[i] && !(w[i] === " " && (g[i] === "\t" || g[i] === "\n" || g[i] === "\r"))) return g;
+  }
+  return w;
+}
+
+/** The document without whitespace-only text outside the root: prolog/epilog entries of the
+ *  ordered canon, or the top-level `#text` of the default shape. */
+export function dropTopWhitespace(doc) {
+  if (!doc || typeof doc !== "object") return doc;
+  const ws = (v) => typeof v === "string" && /^[ \t\n\r]*$/.test(v);
+  if (Array.isArray(doc.prolog)) {
+    const keep = (x) => !(x.t === "tx" && ws(x.v));
+    return { ...doc, prolog: doc.prolog.filter(keep), epilog: doc.epilog.filter(keep) };
+  }
+  if (ws(doc["#text"])) {
+    const out = { ...doc };
+    delete out["#text"];
+    return out;
+  }
+  return doc;
+}
