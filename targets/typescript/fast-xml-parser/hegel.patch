new file mode 100644
index 0000000..ef2b101
--- /dev/null
+++ b/hegel/oracle.py
@@ -0,0 +1,129 @@
+# Hegel zoo: the expat oracle for fast-xml-parser. Reads one JSON request per line from the
+# request FIFO and writes one JSON answer per line to the response FIFO (see hegel/xml.mjs).
+#
+#   {"op": "parse", "xml": "..."}  ->  {"ok": true, "doc": <document>} or
+#                                      {"ok": false, "error": "...", "code": n, "line": l, "col": c}
+#
+# The document is expat's view of the text with namespace processing off (names keep their
+# prefixes, xmlns attributes are attributes), internal entities expanded, character references
+# decoded, attribute values normalised, CRLF normalised, and adjacent character data merged:
+#   element:  {"t": "el", "n": name, "a": {name: value, ...}, "c": [children...]}
+#   text:     {"t": "tx", "v": text}          (CDATA sections are text: "cd": true)
+#   comment:  {"t": "cm", "v": text}
+#   PI:       {"t": "pi", "n": target, "v": data}
+#   document: {"decl": {"version", "encoding", "standalone"} or null,
+#              "prolog": [comments and PIs before the root], "root": element,
+#              "epilog": [comments and PIs after the root],
+#              "entities": {name: replacement text} (internal general entities declared)}
+
+import json
+import sys
+import xml.parsers.expat as expat
+
+
+def parse(text):
+    p = expat.ParserCreate(namespace_separator=None)
+    p.ordered_attributes = True
+    p.buffer_text = True
+    doc = {"decl": None, "prolog": [], "root": None, "epilog": [], "entities": {}}
+    stack = []
+    state = {"cdata": False}
+
+    def sink():
+        if stack:
+            return stack[-1]["c"]
+        return doc["prolog"] if doc["root"] is None else doc["epilog"]
+
+    def start(name, attrs):
+        el = {"t": "el", "n": name, "a": {}, "c": []}
+        for i in range(0, len(attrs), 2):
+            el["a"][attrs[i]] = attrs[i + 1]
+        if stack:
+            stack[-1]["c"].append(el)
+        else:
+            doc["root"] = el
+        stack.append(el)
+
+    def end(name):
+        stack.pop()
+
+    def chars(data):
+        if not stack:
+            return  # whitespace outside the root element
+        node = {"t": "tx", "v": data}
+        if state["cdata"]:
+            node["cd"] = True
+        stack[-1]["c"].append(node)
+
+    def comment(data):
+        if state["dtd"]:
+            return  # a comment in the internal subset is not part of the document tree
+        sink().append({"t": "cm", "v": data})
+
+    def pi(target, data):
+        if state["dtd"]:
+            return
+        sink().append({"t": "pi", "n": target, "v": data})
+
+    def dtd_start(name, sysid, pubid, has_internal_subset):
+        state["dtd"] = True
+
+    def dtd_end():
+        state["dtd"] = False
+
+    state["dtd"] = False
+    p.StartDoctypeDeclHandler = dtd_start
+    p.EndDoctypeDeclHandler = dtd_end
+
+    def decl(version, encoding, standalone):
+        doc["decl"] = {"version": version, "encoding": encoding, "standalone": standalone}
+
+    def entity(name, is_parameter, value, base, system_id, public_id, notation):
+        if not is_parameter and value is not None:
+            doc["entities"][name] = value
+
+    def cdata_start():
+        state["cdata"] = True
+
+    def cdata_end():
+        state["cdata"] = False
+
+    p.StartElementHandler = start
+    p.EndElementHandler = end
+    p.CharacterDataHandler = chars
+    p.CommentHandler = comment
+    p.ProcessingInstructionHandler = pi
+    p.XmlDeclHandler = decl
+    p.EntityDeclHandler = entity
+    p.StartCdataSectionHandler = cdata_start
+    p.EndCdataSectionHandler = cdata_end
+    try:
+        # (a lone surrogate from a mutation is passed through for expat to reject)
+        p.Parse(text.encode("utf-8", "surrogatepass"), True)
+    except expat.ExpatError as e:
+        return {"ok": False, "error": expat.ErrorString(e.code), "code": e.code,
+                "line": e.lineno, "col": e.offset}
+    return {"ok": True, "doc": doc}
+
+
+def main():
+    req, resp = sys.argv[1], sys.argv[2]
+    with open(req, "r", encoding="utf-8") as fin, open(resp, "w", encoding="utf-8") as fout:
+        for line in fin:
+            line = line.strip()
+            if not line:
+                continue
+            try:
+                q = json.loads(line)
+                if q["op"] == "parse":
+                    a = parse(q["xml"])
+                else:
+                    a = {"ok": False, "error": "unknown op " + str(q.get("op"))}
+            except Exception as e:  # noqa: BLE001
+                a = {"ok": False, "error": "oracle: " + repr(e)}
+            fout.write(json.dumps(a, ensure_ascii=True) + "\n")
+            fout.flush()
+
+
+if __name__ == "__main__":
+    main()
diff --git a/hegel/xml.mjs b/hegel/xml.mjs
new file mode 100644
index 0000000..092137d
--- /dev/null
+++ b/hegel/xml.mjs
@@ -0,0 +1,508 @@
+// Hegel zoo: the expat oracle bridge, the canonical document form shared with it, and the
+// generators used by the properties (well-formed XML documents with their expected model,
+// mutations for the rejection differential).
+
+import { execFileSync, spawn } from "node:child_process";
+import { mkdtempSync, openSync, readSync, rmSync, writeSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { dirname, join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { chance, count, n, pick, word } from "./hegel-zoo.mjs";
+import { DANGEROUS_PROPERTY_NAMES, criticalProperties } from "../src/util.js";
+
+const here = dirname(fileURLToPath(import.meta.url));
+
+// The library under test: the ESM sources.
+export const lib = await import("../src/fxp.js");
+export const { XMLParser, XMLBuilder, XMLValidator } = lib;
+
+// ---------------------------------------------------------------- the oracle, held open
+
+let oracle = null;
+
+function startOracle() {
+  execFileSync("python3", ["-c", "import xml.parsers.expat"], { stdio: "ignore" });
+  const dir = mkdtempSync(join(tmpdir(), "hegel-fxp-"));
+  const req = join(dir, "req");
+  const resp = join(dir, "resp");
+  execFileSync("mkfifo", [req, resp]);
+  const child = spawn("python3", ["-u", join(here, "oracle.py"), req, resp], {
+    stdio: ["ignore", "inherit", "inherit"],
+  });
+  child.unref();
+  const wfd = openSync(req, "w");
+  const rfd = openSync(resp, "r");
+  process.on("exit", () => {
+    try { child.kill(); } catch {}
+    try { rmSync(dir, { recursive: true, force: true }); } catch {}
+  });
+  const buf = Buffer.alloc(1 << 16);
+  let pending = "";
+  return {
+    call(obj) {
+      // Lone surrogates cannot cross as UTF-8; escape every surrogate code unit.
+      const line = JSON.stringify(obj).replace(/[\ud800-\udfff]/g, (c) => "\\u" + c.charCodeAt(0).toString(16).padStart(4, "0"));
+      writeSync(wfd, line + "\n");
+      for (;;) {
+        const nl = pending.indexOf("\n");
+        if (nl !== -1) {
+          const answer = pending.slice(0, nl);
+          pending = pending.slice(nl + 1);
+          return JSON.parse(answer);
+        }
+        const got = readSync(rfd, buf, 0, buf.length, null);
+        if (got === 0) throw new Error("the expat oracle went away");
+        pending += buf.toString("utf8", 0, got);
+      }
+    },
+  };
+}
+
+/** expat's reading of `xml`: {ok: true, doc} (see oracle.py) or {ok: false, error, line, col}. */
+export function pyParse(xml) {
+  oracle ??= startOracle();
+  return oracle.call({ op: "parse", xml });
+}
+
+// ---------------------------------------------------------------- fast-xml-parser, configured
+
+/** The parser options of the differential: everything kept, nothing trimmed or typed, character
+ *  references decoded (which needs htmlEntities), comments kept, attribute names bare. */
+export const ORDERED = {
+  preserveOrder: true,
+  ignoreAttributes: false,
+  attributeNamePrefix: "",
+  trimValues: false,
+  parseTagValue: false,
+  parseAttributeValue: false,
+  commentPropName: "#comment",
+  processEntities: true,
+  htmlEntities: true,
+};
+
+/** The same, folded into the default object shape (declaration and PIs dropped, comments off). */
+export const PLAIN = {
+  ...ORDERED,
+  preserveOrder: false,
+  attributeNamePrefix: "@_",
+  commentPropName: false,
+  ignoreDeclaration: true,
+  ignorePiTags: true,
+};
+
+export function fxpParse(xml, options = ORDERED, validate = false) {
+  return new XMLParser(options).parse(xml, validate);
+}
+
+// ---------------------------------------------------------------- canonical form
+
+/** The oracle's document as the harness compares it: adjacent text merged, empty text dropped,
+ *  PI data dropped (fast-xml-parser reads a PI's data as attributes: not compared). */
+export function canonOracle(doc) {
+  return {
+    decl: doc.decl ? { version: doc.decl.version, encoding: doc.decl.encoding, standalone: doc.decl.standalone } : null,
+    prolog: doc.prolog.map(canonNode).filter(Boolean),
+    root: canonNode(doc.root),
+    epilog: doc.epilog.map(canonNode).filter(Boolean),
+  };
+}
+
+function canonNode(node) {
+  switch (node.t) {
+    case "el":
+      return { t: "el", n: node.n, a: { ...node.a }, c: mergeText(node.c.map(canonNode)) };
+    case "tx":
+      return { t: "tx", v: node.v };
+    case "cm":
+      return { t: "cm", v: node.v };
+    case "pi":
+      return { t: "pi", n: node.n };
+  }
+  throw new Error("unknown node " + JSON.stringify(node));
+}
+
+function mergeText(nodes) {
+  const out = [];
+  for (const x of nodes) {
+    if (!x) continue;
+    if (x.t === "tx") {
+      if (x.v === "") continue;
+      if (out.length && out[out.length - 1].t === "tx") {
+        out[out.length - 1] = { t: "tx", v: out[out.length - 1].v + x.v };
+        continue;
+      }
+    }
+    out.push(x);
+  }
+  return out;
+}
+
+/** fast-xml-parser's preserveOrder output (with ORDERED) in the same canonical form. */
+export function canonOrdered(arr) {
+  const doc = { decl: null, prolog: [], root: null, epilog: [] };
+  for (const item of arr) {
+    const node = orderedNode(item);
+    if (node.t === "decl") {
+      doc.decl = node.v;
+    } else if (node.t === "el") {
+      if (doc.root) throw new Error("two root elements in the ordered output");
+      doc.root = node;
+    } else if (doc.root) {
+      doc.epilog.push(node);
+    } else {
+      doc.prolog.push(node);
+    }
+  }
+  return doc;
+}
+
+function orderedNode(item) {
+  const keys = Object.keys(item).filter((k) => k !== ":@");
+  if (keys.length !== 1) throw new Error("ordered node with keys " + JSON.stringify(Object.keys(item)));
+  const key = keys[0];
+  const attrs = item[":@"] || {};
+  if (key === "#text") return { t: "tx", v: String(item[key]) };
+  if (key === "#comment") return { t: "cm", v: String(item[key][0]?.["#text"] ?? "") };
+  if (key === "?xml") {
+    return { t: "decl", v: { version: attrs.version ?? null, encoding: attrs.encoding ?? null, standalone: attrs.standalone === undefined ? -1 : attrs.standalone === "yes" ? 1 : attrs.standalone === "no" ? 0 : attrs.standalone } };
+  }
+  if (key[0] === "?") return { t: "pi", n: key.slice(1) };
+  return { t: "el", n: key, a: { ...attrs }, c: mergeText(item[key].map(orderedNode)) };
+}
+
+/** The folded (preserveOrder: false, PLAIN) object fast-xml-parser should give for a canonical
+ *  element's children: text pieces concatenated into "#text", children grouped by name in order
+ *  of first appearance (one: the value; more: an array), a childless element "" and an element
+ *  with only text its text, attributes as "@_name". */
+export function foldChildren(children) {
+  const obj = {};
+  let text;
+  for (const c of children) {
+    if (c.t === "tx") {
+      text = (text ?? "") + c.v;
+    } else if (c.t === "el") {
+      const val = foldElement(c);
+      if (Object.prototype.hasOwnProperty.call(obj, c.n)) {
+        if (!Array.isArray(obj[c.n])) obj[c.n] = [obj[c.n]];
+        obj[c.n].push(val);
+      } else {
+        obj[c.n] = val;
+      }
+    }
+    // comments and PIs are dropped by PLAIN
+  }
+  if (text !== undefined && text.length > 0) obj["#text"] = text;
+  return obj;
+}
+
+export function foldElement(el) {
+  let val = foldChildren(el.c);
+  const attrNames = Object.keys(el.a);
+  if (attrNames.length) {
+    for (const a of attrNames) val["@_" + a] = el.a[a];
+  } else if (Object.keys(val).length === 1 && val["#text"] !== undefined) {
+    val = val["#text"];
+  } else if (Object.keys(val).length === 0) {
+    val = "";
+  }
+  return val;
+}
+
+// ---------------------------------------------------------------- generators
+
+const dangerous = new Set([...DANGEROUS_PROPERTY_NAMES, ...criticalProperties]);
+
+// (letters both XML 1.0 4th edition, which expat follows, and 5th edition accept)
+const nameStart = ["a", "b", "z", "A", "Z", "_", "x", "n", "s", "r", "t", "é", "ü", "λ", "日", "ж"];
+const nameRest = [...nameStart, "0", "9", "-", ".", "·", "̀", ":"];
+
+/** An XML Name (no dangerous property names, no leading 'xml' for element names, no colon at
+ *  the ends or doubled: expat reads a colon in a name only with namespaces off, as here). */
+export function genName(tc, { colon = true } = {}) {
+  for (;;) {
+    let s = pick(tc, nameStart) + word(tc, nameRest, 0, 5);
+    if (!colon) s = s.replace(/:/g, "_");
+    if (s.startsWith(":") || s.endsWith(":") || s.includes("::")) continue;
+    if (/^xml/i.test(s)) continue;
+    if (dangerous.has(s)) continue;
+    return s;
+  }
+}
+
+const textChars = ["a", "b", " ", "  ", "\n", "\t", "\r\n", "1", ".", ",", "!", "-", ">", "]", "]]", "?", "é", "日", "😀", "'", "\"", "(", "/", "=", ";", "#", "@", "_", "x", " ", " "];
+
+/** Text content as written in the document, and what it reads as. */
+export function genText(tc, ents, { attr = false, quote = null } = {}) {
+  let xml = "";
+  let value = "";
+  const pieces = n(tc, 1, 6);
+  for (let i = 0; i < pieces; i++) {
+    switch (n(tc, 1, 12)) {
+      case 1: xml += "&amp;"; value += "&"; break;
+      case 2: xml += "&lt;"; value += "<"; break;
+      case 3: xml += "&gt;"; value += ">"; break;
+      case 4: xml += "&quot;"; value += '"'; break;
+      case 5: xml += "&apos;"; value += "'"; break;
+      case 6: {
+        const cp = pick(tc, [0x41, 0x20, 0x3c, 0x26, 0x22, 0x27, 0xa0, 0xe9, 0x65e5, 0x1f600, 0x9, 0xa, 0xd, 0x7f, 0xd7ff, 0xe000, 0xfffd, 0x10ffff, 0x3e]);
+        const ch = String.fromCodePoint(cp);
+        xml += chance(tc, 50) ? "&#" + cp + ";" : "&#x" + cp.toString(16) + ";";
+        // in an attribute a referenced tab/LF/CR stays as it is; a literal one becomes a space
+        value += ch;
+        break;
+      }
+      case 7:
+        if (ents.length && !attr) {
+          const e = pick(tc, ents);
+          xml += "&" + e.name + ";";
+          value += e.value;
+          break;
+        }
+        if (ents.length) {
+          // (an entity's replacement text is normalised like literal attribute text)
+          const e = pick(tc, ents);
+          xml += "&" + e.name + ";";
+          value += e.value.replace(/[\t\n\r]/g, " ");
+          break;
+        }
+      // falls through
+      default: {
+        let s = word(tc, textChars, 1, 4);
+        if (attr) {
+          s = s.replace(/[<]/g, "x");
+          if (quote) s = s.split(quote).join("x");
+          // attribute-value normalisation: literal tab, LF, CR (and CRLF, one LF after line-end
+          // normalisation) each become one space
+          xml += s;
+          value += s.replace(/\r\n/g, "\n").replace(/[\t\n\r]/g, " ");
+        } else {
+          // (']]>' may not appear in text, also not across pieces: no piece starts with '>')
+          s = s.replace(/[<]/g, "x").replace(/^>+/, "").replace(/\]\]>/g, "]] >");
+          xml += s;
+          value += s.replace(/\r\n/g, "\n").replace(/\r/g, "\n");
+        }
+      }
+    }
+  }
+  return { xml, value };
+}
+
+const cdataChars = ["a", " ", "<", "&", ">", "]", "]]", "\n", "-", "?", "日", "\r\n", "'", "\""];
+
+function genCData(tc) {
+  let s = word(tc, cdataChars, 0, 6);
+  s = s.split("]]>").join("] ]>");
+  return { xml: "<![CDATA[" + s + "]]>", value: s.replace(/\r\n/g, "\n").replace(/\r/g, "\n") };
+}
+
+const commentChars = ["a", " ", "<", "&", ">", "]", "\n", "-", "?", "日", "'", "\"", "\r\n"];
+
+function genComment(tc) {
+  let s = word(tc, commentChars, 0, 6);
+  s = s.split("--").join("- ");
+  if (s.endsWith("-")) s += " ";
+  return { xml: "<!--" + s + "-->", value: s.replace(/\r\n/g, "\n").replace(/\r/g, "\n") };
+}
+
+function genPI(tc) {
+  const target = genName(tc, { colon: false });
+  let data = word(tc, ["a", " ", "=", '"', "'", "<", "&", ">", "?", "\n", "日"], 0, 6);
+  data = data.split("?>").join("? >");
+  // fast-xml-parser reads a PI's data as attributes: a name-like data is the safe common case
+  if (chance(tc, 60)) data = word(tc, ["a", "b", " "], 0, 6).trim();
+  const sep = data ? pick(tc, [" ", "\n", "\t"]) : "";
+  return { xml: "<?" + target + (data ? sep + data : "") + "?>", name: target };
+}
+
+const ws = [" ", "  ", "\n", "\t", "\r\n", " \n "];
+
+/** A generated well-formed document and its expected canonical form. */
+export function genDocument(tc) {
+  const ents = [];
+  let dups = false;
+  const decl = { version: null, encoding: null, standalone: -1 };
+  let xml = "";
+  if (chance(tc, 40)) {
+    decl.version = pick(tc, ["1.0", "1.0", "1.1"]);
+    xml = "<?xml version=" + q(tc, decl.version);
+    if (chance(tc, 50)) {
+      decl.encoding = pick(tc, ["UTF-8", "utf-8"]);
+      xml += " encoding=" + q(tc, decl.encoding);
+    }
+    if (chance(tc, 40)) {
+      decl.standalone = chance(tc, 50) ? 1 : 0;
+      xml += " standalone=" + q(tc, decl.standalone ? "yes" : "no");
+    }
+    xml += pick(tc, ["", " "]) + "?>";
+    if (chance(tc, 70)) xml += pick(tc, ws);
+  }
+  const rootName = genName(tc);
+  const prolog = [];
+  const epilog = [];
+  if (chance(tc, 30)) {
+    // an internal subset with entities (values without '&', '<' or '%': fast-xml-parser
+    // ignores entities containing '&' by design and does not re-parse markup in them)
+    const k = n(tc, 1, 3);
+    let dtd = "<!DOCTYPE " + rootName + pick(tc, [" [", " [\n", "[", "  [ "]);
+    for (let i = 0; i < k; i++) {
+      // (a name of more than 32 characters would hit @nodable/entities' cap, not judged here)
+      const name = pick(tc, ["e1", "ent", "foo", "bar", "e_2", "x.y", "e".repeat(21)]);
+      const value = word(tc, ["a", "b", " ", "'", '"', ">", "日", "é", "\n", "]", "-", "1"], 0, 6);
+      const quote = value.includes('"') ? "'" : value.includes("'") ? '"' : pick(tc, ['"', "'"]);
+      if (value.includes('"') && value.includes("'")) continue;
+      dtd += pick(tc, ["", " ", "\n  "]) + "<!ENTITY " + name + pick(tc, [" ", "  ", "\n"]) + quote + value + quote + pick(tc, ["", " "]) + ">";
+      if (ents.some((e) => e.name === name)) {
+        dups = true; // (the first declaration binds; the second is ignored)
+        continue;
+      }
+      ents.push({ name, value: value.replace(/\r\n/g, "\n").replace(/\r/g, "\n") });
+    }
+    if (chance(tc, 15)) dtd += "<!ENTITY % " + pick(tc, ["pe", "p.1"]) + ' "x">'; // a parameter entity, never referenced
+    if (chance(tc, 30)) dtd += "<!-- in the dtd -->";
+    if (chance(tc, 20)) dtd += "<!ELEMENT " + rootName + " ANY>";
+    dtd += pick(tc, ["", " ", "\n"]) + "]" + pick(tc, ["", " "]) + ">";
+    xml += dtd;
+    if (chance(tc, 70)) xml += pick(tc, ws);
+  } else if (chance(tc, 10)) {
+    xml += "<!DOCTYPE " + rootName + ">" + pick(tc, ws);
+  }
+  const miscBefore = n(tc, 0, 2);
+  for (let i = 0; i < miscBefore; i++) {
+    const m = genMisc(tc);
+    xml += m.xml + (chance(tc, 50) ? pick(tc, ws) : "");
+    prolog.push(m.node);
+  }
+  const root = genElement(tc, rootName, ents, 0);
+  xml += root.xml;
+  const miscAfter = n(tc, 0, 2);
+  for (let i = 0; i < miscAfter; i++) {
+    if (chance(tc, 50)) xml += pick(tc, ws);
+    const m = genMisc(tc);
+    xml += m.xml;
+    epilog.push(m.node);
+  }
+  if (chance(tc, 30)) xml += pick(tc, ws);
+  return { xml, ents, dups, expected: { decl: decl.version === null && decl.encoding === null && decl.standalone === -1 ? null : decl, prolog, root: root.node, epilog } };
+}
+
+function q(tc, s) {
+  const quote = s.includes('"') ? "'" : s.includes("'") ? '"' : pick(tc, ['"', "'"]);
+  return quote + s + quote;
+}
+
+function genMisc(tc) {
+  if (chance(tc, 50)) {
+    const c = genComment(tc);
+    return { xml: c.xml, node: { t: "cm", v: c.value } };
+  }
+  const p = genPI(tc);
+  return { xml: p.xml, node: { t: "pi", n: p.name } };
+}
+
+export function genElement(tc, name, ents, depth) {
+  const attrs = {};
+  let xml = "<" + name;
+  const na = depth === 0 ? n(tc, 0, 3) : n(tc, 0, 2);
+  for (let i = 0; i < na; i++) {
+    const an = chance(tc, 15) ? pick(tc, ["xmlns", "xmlns:p", "xml:lang", "xml:space"]) : genName(tc);
+    if (Object.prototype.hasOwnProperty.call(attrs, an)) continue;
+    const quote = pick(tc, ['"', "'"]);
+    const t = genText(tc, ents, { attr: true, quote });
+    xml += pick(tc, [" ", " ", "\n", "\t", "  "]) + an + pick(tc, ["=", " = ", "= ", " ="]) + quote + t.xml + quote;
+    attrs[an] = t.value;
+  }
+  const children = [];
+  if (chance(tc, 25)) {
+    xml += pick(tc, ["/>", " />", "\n/>"]);
+    return { xml, node: { t: "el", n: name, a: attrs, c: [] } };
+  }
+  xml += pick(tc, [">", ">", " >", "\n>"]);
+  const k = depth >= 4 ? n(tc, 0, 2) : n(tc, 0, 5);
+  for (let i = 0; i < k; i++) {
+    switch (n(tc, 1, 10)) {
+      case 1: case 2: case 3: {
+        const t = genText(tc, ents);
+        xml += t.xml;
+        children.push({ t: "tx", v: t.value });
+        break;
+      }
+      case 4: {
+        const c = genCData(tc);
+        xml += c.xml;
+        children.push({ t: "tx", v: c.value });
+        break;
+      }
+      case 5: {
+        const c = genComment(tc);
+        xml += c.xml;
+        children.push({ t: "cm", v: c.value });
+        break;
+      }
+      case 6: {
+        const p = genPI(tc);
+        xml += p.xml;
+        children.push({ t: "pi", n: p.name });
+        break;
+      }
+      default: {
+        // a child element; repeated names are common in XML
+        const cn = children.length && chance(tc, 30) ? (children.find((c) => c.t === "el")?.n ?? genName(tc)) : genName(tc);
+        const e = genElement(tc, cn, ents, depth + 1);
+        xml += e.xml;
+        children.push(e.node);
+      }
+    }
+  }
+  xml += "</" + name + pick(tc, ["", "", " ", "\n"]) + ">";
+  return { xml, node: { t: "el", n: name, a: attrs, c: mergeText(children) } };
+}
+
+/** The expected canonical form of a generated document, in the harness's form. */
+export function canonExpected(expected) {
+  return {
+    decl: expected.decl,
+    prolog: expected.prolog,
+    root: canonNode(expected.root),
+    epilog: expected.epilog,
+  };
+}
+
+// ---------------------------------------------------------------- mutations
+
+const mutationChars = ["<", ">", "&", '"', "'", "/", "=", "]", "!", "-", "?", ";", " ", "\n", "a", "1", "#", "x", ":", "", "", "￿", "\ud800"];
+
+/** One random edit of the document. */
+export function mutate(tc, xml) {
+  if (xml.length === 0) return pick(tc, mutationChars);
+  const i = n(tc, 0, xml.length - 1);
+  switch (n(tc, 1, 4)) {
+    case 1: return xml.slice(0, i) + xml.slice(i + 1);
+    case 2: return xml.slice(0, i) + pick(tc, mutationChars) + xml.slice(i);
+    case 3: return xml.slice(0, i) + pick(tc, mutationChars) + xml.slice(i + 1);
+    default: {
+      // duplicate or drop a whole run between two angle brackets
+      const j = xml.indexOf(">", i);
+      const k = xml.lastIndexOf("<", i);
+      if (k >= 0 && j > k) {
+        const piece = xml.slice(k, j + 1);
+        return chance(tc, 50) ? xml.slice(0, k) + xml.slice(j + 1) : xml.slice(0, j + 1) + piece + xml.slice(j + 1);
+      }
+      return xml.slice(0, i) + pick(tc, mutationChars) + xml.slice(i);
+    }
+  }
+}
+
+/** Count the shape of a document for the collect statistics. */
+export function describe(expected) {
+  const kinds = new Set();
+  const walk = (node) => {
+    if (node.t === "el") {
+      if (Object.keys(node.a).length) kinds.add("attrs");
+      node.c.forEach(walk);
+    } else kinds.add(node.t);
+  };
+  walk(expected.root);
+  if (expected.decl) kinds.add("decl");
+  if (expected.prolog.length || expected.epilog.length) kinds.add("misc");
+  for (const k of kinds) count("has " + k);
+}
