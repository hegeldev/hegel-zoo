diff --git a/hegel/canon.mjs b/hegel/canon.mjs
new file mode 100644
index 0000000..8db493b
--- /dev/null
+++ b/hegel/canon.mjs
@@ -0,0 +1,95 @@
+// Hegel zoo: a canonical rendering of a JavaScript value graph.
+//
+// `canon(v)` renders a value so that two graphs render the same text exactly when they are
+// structurally equal *including identity structure*: every object gets a label `#k` in
+// depth-first order and a later reference to the same object renders as `@k`, so shared
+// references and cycles are compared, not just contents. It distinguishes -0, NaN, bigints,
+// boxed primitives, Dates (by time value, NaN for an invalid one), RegExps (source and flags),
+// arrays with holes, Maps (entries in order), Sets (in order), typed arrays (by type and
+// elements: superjson writes elements, not buffers), Errors (name, message, cause and the own
+// enumerable properties), null-prototype objects, class instances (by constructor name),
+// registered symbols (by description) and URLs. It uses `Object.prototype.toString` tags
+// rather than `instanceof`, so values built in another realm compare with the host's.
+
+function prim(x) {
+  if (typeof x === "number") return Object.is(x, -0) ? "-0" : String(x);
+  if (typeof x === "bigint") return x + "n";
+  if (typeof x === "string") return JSON.stringify(x);
+  if (x === undefined) return "undefined";
+  if (x === null) return "null";
+  if (typeof x === "boolean") return String(x);
+  if (typeof x === "symbol") return "Symbol(" + JSON.stringify(x.description ?? "") + ")";
+  return null;
+}
+
+export function canon(v, options = {}) {
+  const seen = new Map();
+  let next = 0;
+  function go(x) {
+    const p = prim(x);
+    if (p !== null) return p;
+    if (typeof x === "function") return "function";
+    if (seen.has(x)) return "@" + seen.get(x);
+    const id = next++;
+    seen.set(x, id);
+    const head = "#" + id;
+    const tag = Object.prototype.toString.call(x).slice(8, -1);
+    switch (tag) {
+      case "Number":
+      case "String":
+      case "Boolean":
+      case "BigInt":
+        return head + tag + "(" + prim(x.valueOf()) + ")";
+      case "Date":
+        return head + "Date(" + prim(x.getTime()) + ")";
+      case "RegExp":
+        return head + "RegExp(" + JSON.stringify(x.source) + "," + x.flags + ")";
+      case "URL":
+        return head + "URL(" + JSON.stringify(x.href) + ")";
+      case "URLSearchParams":
+        return head + "URLSearchParams(" + JSON.stringify(x.toString()) + ")";
+      case "ArrayBuffer":
+        return head + "ArrayBuffer[" + Array.from(new Uint8Array(x)).join(",") + "]";
+      case "DataView":
+        return head + "DataView(" + x.byteOffset + "," + x.byteLength + ")";
+      case "Map":
+        return head + "Map{" + [...x].map(([k, y]) => go(k) + "=>" + go(y)).join(",") + "}";
+      case "Set":
+        return head + "Set{" + [...x].map(go).join(",") + "}";
+      case "Array": {
+        const parts = [];
+        for (let i = 0; i < x.length; i++) parts.push(i in x ? go(x[i]) : "<hole>");
+        return head + "[" + parts.join(",") + "]";
+      }
+      case "Error": {
+        const name = options.errorsByName === false ? "Error" : x.name;
+        const cause = "cause" in x ? "," + go(x.cause) : "";
+        // `name` is compared once, through x.name (own or inherited); the other own enumerable properties follow
+        const own = Object.keys(x).filter((k) => k !== "cause" && k !== "name").map((k) => "," + JSON.stringify(k) + ":" + go(x[k])).join("");
+        return head + "Error(" + JSON.stringify(name) + "," + JSON.stringify(x.message) + cause + own + ")";
+      }
+    }
+    if (ArrayBuffer.isView(x)) {
+      const elements = Array.from(x, (e) => prim(e)).join(",");
+      return head + (options.viewsByTag === false ? "TypedArray" : tag) + "[" + elements + "]";
+    }
+    const proto = Object.getPrototypeOf(x);
+    let name = "";
+    if (proto === null) name = options.nullProtoAsPlain ? "" : "null";
+    else if (!(proto.constructor && proto.constructor.name === "Object" && Object.getPrototypeOf(proto) === null)) {
+      name = (proto.constructor && proto.constructor.name) || "?";
+    }
+    const body = Object.keys(x).map((k) => JSON.stringify(k) + ":" + go(x[k])).join(",");
+    return head + name + "{" + body + "}";
+  }
+  return go(v);
+}
+
+/** The first index at which two renderings differ, with context, for messages. */
+export function diff(a, b) {
+  if (a === b) return "equal";
+  let i = 0;
+  while (i < a.length && i < b.length && a[i] === b[i]) i++;
+  const cut = (s) => (s.length > 160 ? s.slice(0, 160) + "..." : s);
+  return `differ at ${i}:\n  expected ...${cut(a.slice(Math.max(0, i - 40)))}\n  actual   ...${cut(b.slice(Math.max(0, i - 40)))}`;
+}
diff --git a/hegel/gen.mjs b/hegel/gen.mjs
new file mode 100644
index 0000000..655c463
--- /dev/null
+++ b/hegel/gen.mjs
@@ -0,0 +1,376 @@
+// Hegel zoo: the generators behind superjson's properties, as values built from Hegel's
+// combinators, and the pure function that builds the value graph they describe.
+//
+// A value graph is drawn as a small tree. Its leaves are the kinds superjson's README lists
+// (string, number, boolean, null, undefined, bigint, Date, RegExp, URL) plus the ones its
+// transformer handles (typed arrays, registered symbols, a custom-transformed value); its
+// containers (array, plain object, Map, Set, Error, registered class instance) hold child nodes;
+// and with `shape.share` a node may be a reference to an earlier container by index. `build`
+// renders the tree depth first and resolves a reference against the containers built so far
+// (the index taken modulo their number), so a reference to an ancestor is a cycle and one to a
+// finished container a repeated reference. Strings and object keys are shaped for superjson's
+// path encoding (dots and backslashes, empty, numeric and reserved-word keys - the three it
+// refuses by design excepted). `shape` names what may appear so a property can stay inside the
+// value space its oracle supports (structuredClone has no URL, no class instances, no symbols):
+// `shape.classes` is an array of constructors taking no arguments (an instance gets 0-3 fields),
+// `shape.symbols` an array of registered symbols, `shape.custom` a generator of values a custom
+// transformer handles, `shape.errorProps` gives every Error a `code` and an `extra` field.
+
+import { gs } from "./hegel-zoo.mjs";
+
+// ---------------------------------------------------------------- generator helpers
+
+const ints = (lo, hi) => gs.integers({ minValue: lo, maxValue: hi });
+
+/** oneOf with weights: `weighted([45, a], [55, b])` draws a 45 times in 100; shrinks towards the first choice. */
+function weighted(...choices) {
+  if (choices.length === 1) return choices[0][1];
+  const total = choices.reduce((sum, [w]) => sum + w, 0);
+  return ints(0, total - 1).flatMap((r) => {
+    for (const [w, g] of choices) {
+      if (r < w) return g;
+      r -= w;
+    }
+    throw new Error("unreachable");
+  });
+}
+
+/** True pct percent of the time; shrinks to false. */
+const chance = (pct) => ints(0, 99).map((r) => r >= 100 - pct);
+/** A draw from g pct percent of the time, else undefined (listed first: shrinks to absent). */
+const maybe = (pct, g) => weighted([100 - pct, gs.just(undefined)], [pct, g]);
+/** lo-hi pieces of `pool` (strings of one or more characters) concatenated. */
+const pieces = (pool, lo, hi) => gs.arrays(gs.sampledFrom(pool), { minSize: lo, maxSize: hi }).map((xs) => xs.join(""));
+
+// ---------------------------------------------------------------- shapes
+
+export const FULL = Object.freeze({
+  undefined: true, bigint: true, date: true, regexp: true, bin: true, map: true, set: true, error: true, url: true, share: true,
+  loneSurrogates: true,
+});
+
+/** shape minus some keys. */
+export function without(shape, ...keys) {
+  const s = { ...shape };
+  for (const k of keys) delete s[k];
+  return Object.freeze(s);
+}
+
+// ---------------------------------------------------------------- strings and keys
+
+const CHARS = ["a", "b", "z", "A", "0", "9", " ", "_", "$", "-", ".", "/", "\\", "<", ">", "&", "'", "\"", "`", "\n", "\r", "\t",
+  "\b", "\f", "\0", "\x01", "\x1f", "\x7f", "", " ", " ", " ", "﻿", "￿", "é", "ß",
+  "中", "\u{1F600}", "\u{10FFFF}", "..", "\\.", "\\\\", "NaN", "-0", "Infinity", "null", "undefined"];
+const LONE = ["\ud800", "\udc00", "\udbff", "\udfff", "\ud83d"];
+
+/** 0-6 pieces of `pool` 70% of the time, 7-30 pieces 26%, else 200-2000 characters of a three-letter alphabet. */
+const wordsFrom = (pool) => weighted([70, pieces(pool, 0, 6)], [26, pieces(pool, 7, 30)], [4, gs.text({ alphabet: "aé\u{1F600}", minSize: 200, maxSize: 2000 })]);
+const plainWords = wordsFrom(CHARS);
+const surrogateWords = wordsFrom([...CHARS, ...LONE]);
+/** A string of the characters that matter to superjson's path encoding and to JSON. */
+export const str = plainWords;
+/** A string; with shape.loneSurrogates it is drawn from a pool with unpaired surrogates 20% of the time. */
+const strFor = (shape) => (shape.loneSurrogates ? weighted([80, plainWords], [20, surrogateWords]) : plainWords);
+
+// Object keys: dots and backslashes (superjson escapes them in its annotation paths), empty,
+// numeric, reserved words, prototype-ish names other than the three it refuses.
+const KEYS = ["a", "b", "c", "k", "x", "y", "_", "$", "a.b", ".", "..", "a.", ".a", "\\", "\\\\", "a\\", "\\.", "a\\.b", "\\.\\", "if", "class", "null",
+  "0", "1", "2", "10", "01", "-1", "1.5", "4294967295", "", " ", "a b", "é", "中", "\u{1F600}", "hasOwnProperty", "toString", "valueOf",
+  "then", "__proto_", "__PROTO__", "proto", "length", "get", "set", "json", "meta", "values", "v", "referentialEqualities", "NaN", "undefined"];
+const REFUSED = new Set(["__proto__", "constructor", "prototype"]);
+
+/** An object key: one of KEYS 80% of the time, else a string; never one of the three superjson refuses by design. */
+export const key = (shape = {}) => weighted([80, gs.sampledFrom(KEYS)], [20, strFor(shape)]).filter((k) => !REFUSED.has(k));
+
+// ---------------------------------------------------------------- numbers, bigints, dates
+
+const SPECIAL_NUMBERS = [0, -0, 1, -1, 0.5, -0.5, 0.1, 1 / 3, 1e21, 1e-7, 5e-324, 1.7976931348623157e308, 2 ** 53, -(2 ** 53),
+  2 ** 31, -(2 ** 31), 4294967295, 4294967296, 123456789.125, NaN, Infinity, -Infinity, 7.99, 1e300, -1e-300];
+
+const JSON_NUMBERS = SPECIAL_NUMBERS.filter((x) => Number.isFinite(x) && !Object.is(x, -0));
+
+/** A random double: a 53-bit mantissa (two draws), a binary exponent in -70..70 and a sign (2.5 when it overflows). */
+const anyDouble = gs.record({ a: ints(0, 2 ** 52), b: ints(0, 2 ** 52), e: ints(-70, 70), negative: chance(40) }).map(({ a, b, e, negative }) => {
+  const v = (negative ? -1 : 1) * (a + b) * 2 ** e;
+  return Number.isFinite(v) ? v : 2.5;
+});
+/** A number: one of `specials` 45% of the time, a small integer 30%, else a random double. */
+const numFrom = (specials) => weighted([45, gs.sampledFrom(specials)], [30, ints(-1000, 1000)], [25, anyDouble]);
+export const num = numFrom(SPECIAL_NUMBERS);
+const jsonNum = numFrom(JSON_NUMBERS);
+
+/** A bigint: a boundary value 40% of the time, else a 41-bit integer, 30% of the time times a large prime. */
+const big = weighted(
+  [40, gs.sampledFrom([0n, 1n, -1n, 2n ** 63n, -(2n ** 63n), 2n ** 64n, 10n ** 30n, -(10n ** 40n), 2n ** 53n + 1n])],
+  [60, gs.tuples(ints(-(2 ** 40), 2 ** 40), chance(30)).map(([x, prime]) => BigInt(x) * (prime ? 1000000007n : 1n))],
+);
+
+const DATE_TIMES = [0, -1, 1, 8.64e15, -8.64e15, -62135596800000, 253402300799999, 951782400000, 1e12 + 123];
+/** A valid time value: a boundary 40% of the time, else anywhere in the range (negative 30%). */
+const validTime = weighted([40, gs.sampledFrom(DATE_TIMES)], [60, gs.tuples(chance(30), ints(0, 8.64e15)).map(([negative, t]) => (negative ? -t : t))]);
+/** A Date anywhere in the range; with `invalid`, an invalid one 15% of the time. */
+export const date = (invalid = false) => (invalid ? weighted([85, validTime], [15, gs.just(NaN)]) : validTime).map((t) => new Date(t));
+
+// ---------------------------------------------------------------- RegExps, typed arrays, URLs
+
+const SOURCES = ["a", "(?:)", "a\\/b", "[a-z]+<", "^x$", "\\d{2,}", "(?<n>a)|b", "\\u2028", "\\p{L}", "[\\q{ab}]", ".*", "a|", "(a)(b)\\2", "\\/", "[/]", "\\n\\r", "/", "a/b/c"];
+const FLAGS = ["", "g", "i", "gi", "m", "s", "y", "d", "u", "v", "gimsy", "dgimsuy", "dgimsvy"];
+
+/** A RegExp from a drawn source (one of SOURCES 80% of the time, else a string) and flags; an invalid combination falls back to the flags that take the source, then to the source `a`. */
+const regexp = gs.tuples(weighted([80, gs.sampledFrom(SOURCES)], [20, plainWords]), gs.sampledFrom(FLAGS)).map(([source, flags]) => {
+  for (const [s, f] of [[source, flags], [source, "v"], [source, "u"], ["a", flags]]) {
+    try {
+      return new RegExp(s, f);
+    } catch {
+      // an invalid combination: the next
+    }
+  }
+  return /a/g;
+});
+
+const TYPED = [Int8Array, Uint8Array, Uint8ClampedArray, Int16Array, Uint16Array, Int32Array, Uint32Array, Float32Array, Float64Array, BigInt64Array, BigUint64Array];
+const BIG_TYPED = new Set([BigInt64Array, BigUint64Array]);
+const FLOAT_TYPED = new Set([Float32Array, Float64Array]);
+/** An element of a `Ctor` array: a 64-bit bigint, a number, or a small integer. */
+const elementOf = (Ctor) => (BIG_TYPED.has(Ctor) ? big.map((x) => BigInt.asIntN(64, x)) : FLOAT_TYPED.has(Ctor) ? num : ints(-300, 300));
+/** A typed array as data: its constructor, 0-6 visible elements, and the backing store's extra elements before (30% of the time) and after (30%). */
+const typedArrayParts = gs.sampledFrom(TYPED).flatMap((Ctor) => {
+  const element = elementOf(Ctor);
+  return gs.record({
+    Ctor: gs.just(Ctor),
+    before: weighted([70, gs.just([])], [30, gs.arrays(element, { minSize: 1, maxSize: 3 })]),
+    items: gs.arrays(element, { maxSize: 6 }),
+    after: maybe(30, element),
+  });
+});
+/** A typed array (sometimes a subarray of a larger one); float arrays hold -0 only with `negativeZero`. */
+export const typedArray = (negativeZero = false) =>
+  typedArrayParts.map(({ Ctor, before, items, after }) => {
+    const backing = new Ctor(before.length + items.length + (after === undefined ? 0 : 1));
+    backing.set(after === undefined ? [...before, ...items] : [...before, ...items, after]);
+    // a tiny double underflows to -0 in a Float32Array: check after the store
+    if (!negativeZero) for (let i = 0; i < backing.length; i++) if (Object.is(backing[i], -0)) backing[i] = 0;
+    return backing.subarray(before.length, before.length + items.length);
+  });
+
+const HOSTS = ["example.com", "EXAMPLE.com", "xn--nxasmq6b.com", "é.com", "[::1]", "127.0.0.1", "a.b.c", "localhost"];
+const SCHEMES = ["http", "https", "ftp", "ws", "file", "blob", "foo"];
+const FIXED_URLS = ["data:text/plain,hi<>", "mailto:a@b.c", "file:///tmp/a%20b", "about:blank", "http://a/%zz", "http://a/b/../c/./d"];
+
+/** A URL string: one of FIXED_URLS 10% of the time, else a scheme, userinfo 20%, a host, a port 30%, a path, a query 50% and a fragment 40%. */
+const urlText = weighted(
+  [10, gs.sampledFrom(FIXED_URLS)],
+  [90, gs
+    .record({
+      scheme: gs.sampledFrom(SCHEMES),
+      userinfo: chance(20),
+      host: gs.sampledFrom(HOSTS),
+      port: maybe(30, ints(1, 65535)),
+      path: pieces(["a", "b", "/", " ", "%20", "é", "?", "#", "<", ".", ".."], 0, 8),
+      query: maybe(50, pieces(["a", "=", "&", "b", " ", "+", "é", "<"], 0, 8)),
+      fragment: maybe(40, pieces(["f", "<", " ", "é"], 0, 4)),
+    })
+    .map(({ scheme, userinfo, host, port, path, query, fragment }) => `${scheme}://${userinfo ? "u:p@" : ""}${host}${port === undefined ? "" : ":" + port}/${path}${query === undefined ? "" : "?" + query}${fragment === undefined ? "" : "#" + fragment}`)],
+);
+/** A URL (http://example.com/fallback when the text does not parse). */
+const url = urlText.map((text) => {
+  try {
+    return new URL(text);
+  } catch {
+    return new URL("http://example.com/fallback");
+  }
+});
+
+// ---------------------------------------------------------------- leaves
+
+/** A primitive or a leaf object of the shape. */
+export function leaf(shape) {
+  const choices = [[6, gs.just(null)], [6, gs.booleans()], [24, shape.jsonOnly ? jsonNum : num], [20, strFor(shape)]];
+  if (shape.undefined) choices.push([7, gs.just(undefined)]);
+  if (shape.bigint) choices.push([7, big]);
+  if (shape.date) choices.push([9, date(!!shape.invalidDates)]);
+  if (shape.regexp) choices.push([6, regexp]);
+  if (shape.bin) choices.push([8, typedArray(!!shape.negativeZero)]);
+  if (shape.url) choices.push([4, url]);
+  if (shape.symbols) choices.push([3, gs.sampledFrom(shape.symbols)]);
+  return weighted(...choices);
+}
+
+// ---------------------------------------------------------------- the tree and its rendering
+
+const ERRORS = [Error, TypeError, RangeError, SyntaxError, ReferenceError, EvalError, URIError];
+// the `extra` field of an Error under shape.errorProps: a leaf of every kind but undefined
+const errorExtra = leaf(without(FULL, "undefined"));
+
+/** A tree node of kind `k` with the given fields. */
+const node = (k, fields) => gs.record({ k: gs.just(k), ...fields });
+/** 0-5 children 80% of the time, else 6-`most`. */
+const children = (child, most) => weighted([80, gs.arrays(child, { maxSize: 5 })], [20, gs.arrays(child, { minSize: 6, maxSize: most })]);
+
+/** The container nodes of the shape, by kind, with children from `child` (a node generator) and `leaf` (a leaf node generator). */
+function containersFor(shape, child, leaf) {
+  const k = key(shape);
+  const containers = {
+    array: node("array", { items: children(child, 30), hole: shape.holes ? maybe(30, ints(0, 99)) : gs.just(undefined) }),
+    object: node("object", { entries: children(gs.tuples(k, child), 25) }),
+  };
+  // a Map key is mostly a leaf (NaN, -0, undefined, bigint included), sometimes a container; a Set element likewise
+  if (shape.map) containers.map = node("map", { entries: gs.arrays(gs.tuples(weighted([80, leaf], [20, child]), child), { maxSize: 5 }) });
+  if (shape.set) containers.set = node("set", { items: gs.arrays(weighted([70, leaf], [30, child]), { maxSize: 5 }) });
+  if (shape.error) {
+    containers.error = node("error", {
+      ctor: shape.errorSubclasses ? gs.sampledFrom(ERRORS) : gs.just(Error),
+      message: strFor(shape),
+      cause: maybe(40, child),
+      props: shape.errorProps ? gs.record({ code: num, extra: errorExtra }) : gs.just(undefined),
+    });
+  }
+  if (shape.classes) containers.instance = node("instance", { ctor: gs.sampledFrom(shape.classes), entries: gs.arrays(gs.tuples(k, child), { maxSize: 3 }) });
+  return containers;
+}
+/** The weighted choices of `table` whose kind the shape has. */
+const kinds = (containers, table) => table.filter(([, kind]) => containers[kind]).map(([w, kind]) => [w, containers[kind]]);
+
+/** `o` with the entries' values built, registered in the pool first (so a child may refer to it). */
+function fill(o, entries, pool) {
+  pool.push(o);
+  for (const [k, v] of entries) o[k] = build(v, pool);
+  return o;
+}
+
+/**
+ * The value graph a drawn tree describes. `pool` is the containers built so far, in depth-first
+ * order; a reference resolves to one of them by its index modulo their number (null when there
+ * is none yet). Errors are not in the pool: superjson restores nothing inside them.
+ */
+export function build(node, pool = []) {
+  switch (node.k) {
+    case "leaf":
+      return node.v;
+    case "ref":
+      return pool.length ? pool[node.at % pool.length] : null;
+    case "array": {
+      const a = [];
+      pool.push(a);
+      for (const item of node.items) a.push(build(item, pool));
+      if (node.hole !== undefined && a.length) delete a[node.hole % a.length];
+      return a;
+    }
+    case "object":
+      return fill({}, node.entries, pool);
+    case "instance":
+      return fill(new node.ctor(), node.entries, pool);
+    case "map": {
+      const m = new Map();
+      pool.push(m);
+      for (const [k, v] of node.entries) m.set(build(k, pool), build(v, pool));
+      return m;
+    }
+    case "set": {
+      const s = new Set();
+      pool.push(s);
+      for (const item of node.items) s.add(build(item, pool));
+      return s;
+    }
+    case "error": {
+      const e = node.cause === undefined ? new node.ctor(node.message) : new node.ctor(node.message, { cause: build(node.cause, pool) });
+      if (node.props !== undefined) {
+        e.code = node.props.code;
+        e.extra = node.props.extra;
+      }
+      return e;
+    }
+  }
+  throw new Error(`unknown node kind ${node.k}`);
+}
+
+/**
+ * Any value of the shape: a leaf 20% of the time, else a container (object 45%, array 30%, Map
+ * 10%, Set 8%, class instance 7%) nesting up to depth 4. Below the root a node is a leaf 48% of
+ * the time, else a container (array 18, object 14, Map 6, Set 5, Error 4, instance 5), and with
+ * `shape.share` a reference to an earlier container 12% of the time (a cycle when it is an
+ * ancestor), with `shape.custom` a custom-transformed value 6%.
+ */
+export function values(shape) {
+  const leafNode = leaf(shape).map((v) => ({ k: "leaf", v }));
+  const extras = [];
+  if (shape.share) extras.push([15, node("ref", { at: ints(0, 99) })]);
+  if (shape.custom) extras.push([7, shape.custom.map((v) => ({ k: "leaf", v }))]);
+  // depth 4: leaves only; depths 3 to 1: containers whose children are the level below
+  let child = weighted([100, leafNode], ...extras);
+  for (let depth = 3; depth >= 1; depth--) {
+    const containers = containersFor(shape, child, leafNode);
+    child = weighted([48, leafNode], ...kinds(containers, [[18, "array"], [14, "object"], [6, "map"], [5, "set"], [4, "error"], [5, "instance"]]), ...extras);
+  }
+  const root = weighted(...kinds(containersFor(shape, child, leafNode), [[45, "object"], [30, "array"], [10, "map"], [8, "set"], [7, "instance"]]));
+  return weighted([20, leafNode], [80, root]).map((tree) => build(tree));
+}
+
+// ---------------------------------------------------------------- the cases of the properties
+
+const JSON_ONLY = Object.freeze({ jsonOnly: true });
+
+/** The output-format case: a JSON-only value 40% of the time, else one with every kind: {special, v}. */
+export const outputCase = weighted(
+  [40, values(JSON_ONLY).map((v) => ({ special: false, v }))],
+  [60, values({ ...without(FULL, "share"), errorSubclasses: true }).map((v) => ({ special: true, v }))],
+);
+
+/** The allowProps case: 1-5 distinct keys, each with whether it is allowed and its value (a leaf of every kind). */
+export const allowPropsCase = gs.maps(key(), gs.record({ allowed: chance(50), value: leaf(FULL) }), { minSize: 1, maxSize: 5 });
+
+/** 1-4 typed arrays, -0 allowed in the float ones. */
+export const typedArraysCase = gs.arrays(typedArray(true), { minSize: 1, maxSize: 4 });
+
+/** A Node Buffer: 0-20 copies of one byte, or the UTF-8 of a string. */
+export const bufferCase = weighted(
+  [50, gs.tuples(ints(0, 20), ints(0, 255)).map(([size, byte]) => Buffer.alloc(size, byte))],
+  [50, str.map((s) => Buffer.from(s))],
+);
+
+/** 1-5 Dates, invalid ones included, and whether they go into a Map as keys. */
+export const datesCase = gs.record({ items: gs.arrays(date(true), { minSize: 1, maxSize: 5 }), asMap: chance(50) });
+
+/** The nesting case: arrays or objects, and the fraction of JSON.stringify's depth limit to ask for. */
+export const nestingCase = gs.record({ arrays: chance(50), fraction: gs.sampledFrom([0.05, 0.2, 0.4, 0.5, 0.6, 0.7, 0.75]) });
+
+// ---------------------------------------------------------------- hostile payloads
+
+const ANNOTATIONS = ["undefined", "bigint", "Date", "Error", "regexp", "set", "map", "number", "URL", ["typed-array", "Uint8Array"], ["typed-array", "Nope"], ["class", "Point"], ["class", "Object"], ["symbol", "x"], ["custom", "decimal"], "bogus", 5, null];
+const PATH_KEYS = ["a", "0", "1", "__proto__", "constructor", "prototype", "a.__proto__", "0.0", "0.1", "a\\.b", "a\\", "\\", "", "..", "x.y.z", "constructor.prototype", "a.constructor"];
+const HOSTILE_LEAVES = [null, 1, "x", "2020-01-01T00:00:00.000Z", "NaN", "12", "/a/g", true, "[object Object]"];
+
+const annotation = gs.sampledFrom(ANNOTATIONS);
+const pathKey = gs.sampledFrom(PATH_KEYS);
+/** 0-3 entries of `value` under path-shaped keys (`__proto__` among them, as an own property). */
+const keyed = (value) => gs.arrays(gs.tuples(pathKey, value), { maxSize: 3 }).map(Object.fromEntries);
+
+// a meta.values tree, nesting to depth 3: a bare annotation (only that at the bottom), an annotation with children, or children alone
+let hostileTree = annotation.map((a) => [a]);
+for (let depth = 2; depth >= 0; depth--) {
+  const children = keyed(hostileTree);
+  hostileTree = weighted([40, annotation.map((a) => [a])], [20, gs.tuples(annotation, children)], [40, children]);
+}
+// a json part, nesting to depth 3: a leaf (only that at the bottom), an array of 0-3, or an object of 0-3 entries
+let hostileJson = gs.sampledFrom(HOSTILE_LEAVES);
+for (let depth = 2; depth >= 0; depth--) hostileJson = weighted([30, gs.sampledFrom(HOSTILE_LEAVES)], [30, gs.arrays(hostileJson, { maxSize: 3 })], [40, keyed(hostileJson)]);
+
+/** 0-2 path keys. */
+const paths = gs.arrays(pathKey, { maxSize: 2 });
+/** 0-2 paths, each mapped to 0-2 paths. */
+const pathTable = gs.arrays(gs.tuples(pathKey, paths), { maxSize: 2 }).map(Object.fromEntries);
+
+/**
+ * The hostile-payload case: a meta with a version, 80% of the time a values tree and 50% of the
+ * time referential equalities in one of their three spellings; a json part; and whether the
+ * payload goes through parse (as text) or deserialize.
+ */
+export const hostileCase = gs.record({
+  meta: gs.record({
+    v: gs.sampledFrom([1, 0, undefined, 2]),
+    values: maybe(80, hostileTree),
+    referentialEqualities: maybe(50, weighted([50, pathTable], [25, paths.map((p) => [p])], [25, gs.tuples(paths, pathTable)])),
+  }),
+  json: hostileJson,
+  viaParse: chance(50),
+});
diff --git a/hegel/hegel-zoo.mjs b/hegel/hegel-zoo.mjs
new file mode 100644
index 0000000..ffb5e91
--- /dev/null
+++ b/hegel/hegel-zoo.mjs
@@ -0,0 +1,141 @@
+// Hegel zoo: the small harness shared by the zoo's TypeScript/JavaScript targets.
+//
+// `property(name, body)` registers a node:test test that runs `body(tc)` under Hegel with
+// HEGEL_TEST_CASES cases (default 100) and the database at HEGEL_DATABASE. With ZOO_COLLECT=1
+// a `fail()` records the mismatch instead of failing, the case ends there, and the counts of
+// mismatches and of the shapes seen (`count(key)`) are printed at the end of the test, so a
+// property can be run over many cases to see every shape at once. `pin(name, body)` is a
+// plain test for one pinned bug: it must fail while the bug is present and pass once it is
+// fixed (the zoo's judge reads an unexpected pass as "fixed upstream?").
+
+import { readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+import { test as nodeTest } from "node:test";
+
+// The Hegel version these tests were written against (the zoo pins it in zoo.toml; upstream
+// would add it to devDependencies). Hegel and esbuild are installed with `npm install --prefix
+// .hegel` so the target's own package.json and lock file stay untouched. Checked at load time so
+// a stray install cannot silently change the engine.
+export const HEGEL_PIN = { "@hegeldev/hegel": "0.4.5" };
+
+const hegelDir = join(dirname(fileURLToPath(import.meta.url)), "..", ".hegel", "node_modules", "@hegeldev", "hegel");
+{
+  const installed = JSON.parse(readFileSync(join(hegelDir, "package.json"), "utf8")).version;
+  if (installed !== HEGEL_PIN["@hegeldev/hegel"]) {
+    throw new Error(`@hegeldev/hegel ${installed} is installed; these tests pin ${HEGEL_PIN["@hegeldev/hegel"]}`);
+  }
+}
+const hegel = await import(pathToFileURL(join(hegelDir, "dist", "index.js")));
+const gs = await import(pathToFileURL(join(hegelDir, "dist", "generators", "index.js")));
+
+/** Hegel's generators, re-exported so the tests import everything from one place. */
+export { gs };
+
+export const collecting = !!process.env.ZOO_COLLECT;
+
+class Collected extends Error {}
+
+let msgs = [];
+let stats = new Map();
+
+/** Report a mismatch: an error normally, a recorded line in collect mode. */
+export function fail(message) {
+  if (collecting) {
+    msgs.push(message);
+    throw new Collected(message);
+  }
+  throw new Error(message);
+}
+
+/** Bump a statistic (the shape of a pinned bug, a generator branch). */
+export function count(key) {
+  stats.set(key, (stats.get(key) || 0) + 1);
+}
+
+function settings() {
+  const s = { testCases: Number(process.env.HEGEL_TEST_CASES) || 100 };
+  if (process.env.HEGEL_DATABASE) {
+    s.database = hegel.Database.fromPath(process.env.HEGEL_DATABASE);
+  }
+  return s;
+}
+
+/** A property: `body(tc)` runs under Hegel; a thrown error (or `fail`) is a failure. */
+export function property(name, body) {
+  nodeTest(name, () => {
+    msgs = [];
+    stats = new Map();
+    hegel.test((tc) => {
+      try {
+        body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** An async property: `body(tc)` may await; runs under Hegel's testAsync with the same settings. */
+export function propertyAsync(name, body) {
+  nodeTest(name, async () => {
+    msgs = [];
+    stats = new Map();
+    await hegel.testAsync(async (tc) => {
+      try {
+        await body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** A pin: a plain test for one recorded bug. */
+export function pin(name, body) {
+  nodeTest(name, body);
+}
+
+/** Structural equality: arrays by position, objects by key set (prototype ignored), else ===. */
+export function same(a, b) {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) {
+      return false;
+    }
+    return a.every((x, i) => same(x, b[i]));
+  }
+  if (a !== null && b !== null && typeof a === "object" && typeof b === "object") {
+    const ka = Object.keys(a).sort();
+    const kb = Object.keys(b).sort();
+    if (ka.length !== kb.length || ka.some((k, i) => k !== kb[i])) {
+      return false;
+    }
+    return ka.every((k) => same(a[k], b[k]));
+  }
+  return a === b;
+}
+
+/** A compact, unambiguous rendering for messages. */
+export function show(x) {
+  return JSON.stringify(x, (k, v) => (v === undefined ? "<undefined>" : v));
+}
diff --git a/hegel/hegel.test.mjs b/hegel/hegel.test.mjs
new file mode 100644
index 0000000..c38ed42
--- /dev/null
+++ b/hegel/hegel.test.mjs
@@ -0,0 +1,509 @@
+// Hegel zoo: properties of superjson (flightcontrolhq/superjson) against its README, JavaScript's
+// own semantics (`JSON.parse`/`JSON.stringify` of the output, `structuredClone` as a second
+// implementation of the same value space) and a canonical rendering that compares identity
+// structure (shared references, cycles, Map and Set order) as well as contents. Run with
+// `node --test hegel/hegel.test.mjs` from the repository root after `tsc -p hegel/tsconfig.json`;
+// HEGEL_TEST_CASES sets the case count, ZOO_COLLECT=1 collects mismatches instead of stopping.
+//
+// The generators are in gen.mjs: a value graph is drawn as a small tree (leaves, containers,
+// references to earlier containers) and built by a pure function; each property draws one value
+// or one record.
+
+import assert from "node:assert/strict";
+import { count, fail, pin, property } from "./hegel-zoo.mjs";
+import * as gen from "./gen.mjs";
+import { canon, diff } from "./canon.mjs";
+import SuperJSON from "../.hegel/dist/index.js";
+
+// ---------------------------------------------------------------------------------------------
+// Helpers
+
+function expectSame(label, expected, actual, options) {
+  const a = canon(expected, options);
+  const b = canon(actual, options);
+  if (a !== b) fail(`${label}: ${diff(a, b)}`);
+}
+
+/** stringify then parse through the given instance (the default one if none). */
+function roundTrip(v, instance = SuperJSON) {
+  let text;
+  try {
+    text = instance.stringify(v);
+  } catch (e) {
+    return fail(`stringify throws ${e.constructor.name}: ${e.message} for ${canon(v).slice(0, 200)}`);
+  }
+  try {
+    return instance.parse(text);
+  } catch (e) {
+    return fail(`parse throws ${e.constructor.name}: ${e.message} for ${text.slice(0, 300)}`);
+  }
+}
+
+class Point {
+  constructor() {}
+}
+class Shape {
+  constructor() {}
+}
+class Decimal {
+  constructor(text) {
+    this.text = text;
+  }
+}
+
+/** A fresh instance with Point (by name), Shape (under an identifier) and a Decimal transformer registered. */
+function instanceWithRegistrations(options) {
+  const s = new SuperJSON(options);
+  s.registerClass(Point);
+  s.registerClass(Shape, { identifier: "geo.Shape" });
+  s.registerCustom({ isApplicable: (v) => v instanceof Decimal, serialize: (v) => v.text, deserialize: (t) => new Decimal(t) }, "decimal");
+  return s;
+}
+const CLASSES = [Point, Shape];
+/** A value the Decimal transformer handles. */
+const decimal = gen.num.map((x) => new Decimal(String(x)));
+
+/**
+ * Known (superjson/6): superjson tracks NaN as a shared identity, so a graph with two NaNs one of
+ * which is a Set element or a Map key comes back changed. The properties that are not about that
+ * bug skip such inputs (counted) instead of failing on it.
+ */
+function knownNaNIdentityShape(v) {
+  let nans = 0;
+  let inSetOrKey = false;
+  const seen = new Set();
+  (function walk(x, setOrKey) {
+    if (Number.isNaN(x)) {
+      nans++;
+      if (setOrKey) inSetOrKey = true;
+      return;
+    }
+    if (!x || typeof x !== "object" || seen.has(x)) return;
+    seen.add(x);
+    if (Array.isArray(x)) x.forEach((y) => walk(y, false));
+    else if (x instanceof Map) for (const [k, y] of x) { walk(k, true); walk(y, false); }
+    else if (x instanceof Set) for (const y of x) walk(y, true);
+    else if (x instanceof Error) { walk(x.cause, false); for (const k of Object.keys(x)) walk(x[k], false); }
+    else if (ArrayBuffer.isView(x) || x instanceof Date || x instanceof RegExp || x instanceof URL) return;
+    else for (const k of Object.keys(x)) walk(x[k], false);
+  })(v, false);
+  return nans >= 2 && inSetOrKey;
+}
+
+/** A case with the shape of superjson/6: counted, not judged. */
+function skipKnown(tc, v) {
+  if (knownNaNIdentityShape(v)) {
+    count("known-nan-identity-skipped");
+    tc.assume(false);
+  }
+}
+
+const PROTOS = [Object.prototype, Array.prototype, Map.prototype, Set.prototype, Error.prototype, Date.prototype];
+const protoSnapshot = () => PROTOS.map((p) => Object.getOwnPropertyNames(p).join(",")).join("|");
+
+// ---------------------------------------------------------------------------------------------
+// Round trips
+
+// every kind without sharing, Error subclasses included
+const unsharedValue = gen.values({ ...gen.without(gen.FULL, "share"), errorSubclasses: true });
+// repeated references and cycles through plain objects and arrays
+const sharedPlainValue = gen.values(gen.without(gen.FULL, "map", "set", "error"));
+// the same, with Sets and Maps in the graph (a shared value may be a Set element or a Map key)
+const sharedCollectionValue = gen.values(gen.without(gen.FULL, "error"));
+// the same, with Errors and registered class instances
+const sharedInstanceValue = gen.values({ ...gen.without(gen.FULL, "map", "set"), classes: CLASSES });
+
+property("TestHegelParseStringifyRoundTrips", (tc) => {
+  const v = tc.draw(unsharedValue);
+  skipKnown(tc, v);
+  const before = canon(v);
+  const back = roundTrip(v);
+  if (canon(v) !== before) fail("stringify mutated its input");
+  expectSame("parse(stringify(v))", v, back);
+  // the lower-level pair gives the same value
+  expectSame("deserialize(serialize(v))", v, SuperJSON.deserialize(SuperJSON.serialize(v)));
+});
+
+property("TestHegelSharedReferencesAreRestored", (tc) => {
+  const v = tc.draw(sharedPlainValue);
+  expectSame("parse(stringify(v))", v, roundTrip(v));
+});
+
+property("TestHegelSharedValuesInSetsAndMapKeysAreRestored", (tc) => {
+  const v = tc.draw(sharedCollectionValue);
+  expectSame("parse(stringify(v))", v, roundTrip(v));
+});
+
+property("TestHegelSharedValuesInsideErrorsAndClassInstancesAreRestored", (tc) => {
+  const s = instanceWithRegistrations();
+  const v = tc.draw(sharedInstanceValue);
+  expectSame("parse(stringify(v))", v, roundTrip(v, s));
+});
+
+property("TestHegelDedupeModeRoundTrips", (tc) => {
+  const s = new SuperJSON({ dedupe: true });
+  const v = tc.draw(sharedPlainValue);
+  skipKnown(tc, v);
+  const text = s.stringify(v);
+  expectSame("parse(stringify(v)) with dedupe", v, roundTrip(v, s));
+  // the default instance reads a deduped payload too (the format is the same)
+  expectSame("default parse of a deduped payload", v, SuperJSON.parse(text));
+});
+
+property("TestHegelDedupeModeWithSetsAndMapsRoundTrips", (tc) => {
+  const s = new SuperJSON({ dedupe: true });
+  const v = tc.draw(sharedCollectionValue);
+  expectSame("parse(stringify(v)) with dedupe", v, roundTrip(v, s));
+});
+
+// structuredClone has no URL and no symbols; it keeps Error subclasses (compared by name)
+const clonableValue = gen.values({ ...gen.without(gen.FULL, "url", "share"), errorSubclasses: true });
+
+property("TestHegelDeserializeAgreesWithStructuredClone", (tc) => {
+  const v = tc.draw(clonableValue);
+  skipKnown(tc, v);
+  const clone = structuredClone(v);
+  expectSame("structuredClone(v) vs v", v, clone);
+  expectSame("parse(stringify(v)) vs structuredClone(v)", clone, roundTrip(v));
+});
+
+// ---------------------------------------------------------------------------------------------
+// The output format
+
+/** The first thing in x that JSON cannot carry unchanged (undefined, bigint, non-finite, -0, a non-plain object), or null. */
+function nonJson(x, path = "") {
+  if (x === null || typeof x === "string" || typeof x === "boolean") return null;
+  if (typeof x === "number") return Number.isFinite(x) && !Object.is(x, -0) ? null : `${path}: ${prim(x)}`;
+  if (typeof x !== "object") return `${path}: ${typeof x}`;
+  if (Array.isArray(x)) {
+    for (let i = 0; i < x.length; i++) {
+      if (!(i in x)) return `${path}[${i}]: hole`;
+      const r = nonJson(x[i], `${path}[${i}]`);
+      if (r) return r;
+    }
+    return null;
+  }
+  if (Object.getPrototypeOf(x) !== Object.prototype) return `${path}: ${Object.prototype.toString.call(x)}`;
+  for (const k of Object.keys(x)) {
+    const r = nonJson(x[k], `${path}.${k}`);
+    if (r) return r;
+  }
+  return null;
+}
+const prim = (x) => (Object.is(x, -0) ? "-0" : String(x));
+
+property("TestHegelSerializeOutputIsJsonAndMetaOnlyForSpecialValues", (tc) => {
+  const { special, v } = tc.draw(gen.outputCase);
+  const out = SuperJSON.serialize(v);
+  const text = SuperJSON.stringify(v);
+  if (text !== JSON.stringify(out)) fail("stringify(v) is not JSON.stringify(serialize(v))");
+  // the result is plain JSON: nothing JSON.stringify would drop or change
+  const bad = nonJson(out);
+  if (bad) fail(`serialize output is not plain JSON at ${bad}`);
+  if (!special) {
+    count("json-only");
+    if (out.meta !== undefined) fail(`meta present for a JSON-only value: ${JSON.stringify(out.meta).slice(0, 200)}`);
+    expectSame("json of a JSON-only value is the value", v, out.json);
+    // plain JSON.parse of the json part gives the value back
+    expectSame("JSON.parse(JSON.stringify(v))", JSON.parse(JSON.stringify(v)), out.json);
+  } else if (out.meta !== undefined && out.meta.v !== 1) fail(`meta.v is ${out.meta.v}`);
+});
+
+// every kind without sharing
+const plainValue = gen.values(gen.without(gen.FULL, "share"));
+
+property("TestHegelDeserializeInPlaceMatchesTheCopyingDefault", (tc) => {
+  const v = tc.draw(plainValue);
+  skipKnown(tc, v);
+  const payload = JSON.parse(SuperJSON.stringify(v));
+  const before = canon(payload);
+  const copied = SuperJSON.deserialize(payload);
+  if (canon(payload) !== before) fail("deserialize without inPlace mutated the payload");
+  expectSame("deserialize(payload)", v, copied);
+  const inPlace = SuperJSON.deserialize(payload, { inPlace: true });
+  expectSame("deserialize(payload, {inPlace: true})", v, inPlace);
+});
+
+// ---------------------------------------------------------------------------------------------
+// Registrations
+
+// registered class instances and custom-transformed values, no sharing, no Errors
+const registeredValue = gen.values({ ...gen.without(gen.FULL, "share", "error"), classes: CLASSES, custom: decimal });
+
+property("TestHegelRegisteredClassesRoundTrip", (tc) => {
+  const s = instanceWithRegistrations();
+  const v = tc.draw(registeredValue);
+  skipKnown(tc, v);
+  const back = roundTrip(v, s);
+  expectSame("parse(stringify(v)) with registered classes and a custom transformer", v, back);
+});
+
+property("TestHegelAllowPropsKeepsOnlyTheListedFields", (tc) => {
+  const s = new SuperJSON();
+  class Record {}
+  const fields = tc.draw(gen.allowPropsCase);
+  const allowed = [...fields].filter(([, f]) => f.allowed).map(([k]) => k);
+  s.registerClass(Record, { identifier: "rec", allowProps: allowed });
+  const r = new Record();
+  for (const [k, { value }] of fields) r[k] = value;
+  const expected = new Record();
+  for (const k of allowed) expected[k] = r[k];
+  const back = roundTrip([r, { r }], s);
+  if (!(back[0] instanceof Record)) fail("not a Record");
+  expectSame("only the allowed props", [expected, { r: expected }], back);
+});
+
+const SYMBOLS = [Symbol("alpha"), Symbol("with.dot"), Symbol(""), Symbol.for("registered")];
+// registered symbols among the leaves, no sharing, no Errors
+const symbolValue = gen.values({ ...gen.without(gen.FULL, "share", "error"), symbols: SYMBOLS });
+
+property("TestHegelRegisteredSymbolsRoundTrip", (tc) => {
+  const s = new SuperJSON();
+  s.registerSymbol(SYMBOLS[0]);
+  s.registerSymbol(SYMBOLS[1], "dotted");
+  s.registerSymbol(SYMBOLS[2], "empty");
+  s.registerSymbol(SYMBOLS[3]);
+  const v = tc.draw(symbolValue);
+  skipKnown(tc, v);
+  const back = roundTrip(v, s);
+  expectSame("parse(stringify(v)) with registered symbols", v, back);
+  // identity: the very same symbols come back
+  const found = [];
+  (function walk(x) {
+    if (typeof x === "symbol") found.push(x);
+    else if (Array.isArray(x)) x.forEach(walk);
+    else if (x instanceof Map) for (const [k, y] of x) { walk(k); walk(y); }
+    else if (x instanceof Set) for (const y of x) walk(y);
+    else if (x && typeof x === "object" && Object.getPrototypeOf(x) === Object.prototype) Object.values(x).forEach(walk);
+  })(back);
+  for (const sym of found) if (!SYMBOLS.includes(sym)) fail(`a foreign symbol came back: ${String(sym)}`);
+});
+
+// every kind without sharing, Error subclasses included, every Error with a `code` and an `extra` field
+const decoratedErrorValue = gen.values({ ...gen.without(gen.FULL, "share"), errorSubclasses: true, errorProps: true });
+
+property("TestHegelErrorsRoundTripWithAllowedProps", (tc) => {
+  const s = new SuperJSON();
+  s.allowErrorProps("code", "extra");
+  const v = tc.draw(decoratedErrorValue);
+  skipKnown(tc, v);
+  expectSame("parse(stringify(v)) with allowErrorProps", v, roundTrip(v, s));
+});
+
+// ---------------------------------------------------------------------------------------------
+// Leaves of note
+
+property("TestHegelTypedArraysRoundTrip", (tc) => {
+  const items = tc.draw(gen.typedArraysCase);
+  const back = roundTrip(items);
+  expectSame("typed arrays (elements, type)", items, back);
+});
+
+property("TestHegelNodeBuffersRoundTrip", (tc) => {
+  // a Buffer is a Uint8Array; its bytes should come back (as a Uint8Array at least)
+  const b = tc.draw(gen.bufferCase);
+  const back = roundTrip({ b });
+  if (!(back.b instanceof Uint8Array)) return fail(`a Buffer came back as ${canon(back.b).slice(0, 100)}`);
+  if (Buffer.compare(Buffer.from(back.b), b) !== 0) fail(`bytes differ: ${canon(back.b).slice(0, 100)} for ${canon(b).slice(0, 100)}`);
+});
+
+property("TestHegelDatesRoundTrip", (tc) => {
+  const { items, asMap } = tc.draw(gen.datesCase);
+  count(items.some((d) => Number.isNaN(d.getTime())) ? "with-invalid" : "valid-only");
+  const v = asMap ? new Map(items.map((d, i) => [d, i])) : items;
+  expectSame("dates (time value, NaN for invalid)", v, roundTrip(v));
+});
+
+// The depth at which a recursive walker overflows depends on the host's stack and on whether
+// V8 has optimised the frames yet (cold code overflows about twice as early as warm code), so
+// nothing here is a fixed depth: the limit of JSON.stringify is measured in this process and
+// superjson is asked to handle three quarters of it. (structuredClone is no oracle here: on
+// Node 22 it overflows at about 1600 nested plain objects, earlier than superjson.)
+function nested(depth, arrays) {
+  let v = arrays ? [] : {};
+  for (let i = 0; i < depth; i++) v = arrays ? [v] : { k: v };
+  return v;
+}
+function nestingDepth(v) {
+  let d = 0;
+  while (v !== null && typeof v === "object") { v = Array.isArray(v) ? v[0] : v.k; d++; }
+  return d - 1;
+}
+/** The largest depth at which `f` handles a nested value without throwing (binary search). */
+function depthLimit(f, arrays) {
+  const ok = (d) => { try { f(nested(d, arrays)); return true; } catch { return false; } };
+  let lo = 1, hi = 64;
+  while (hi < 1 << 20 && ok(hi)) { lo = hi; hi *= 2; }
+  while (hi - lo > 1) { const m = (lo + hi) >> 1; if (ok(m)) lo = m; else hi = m; }
+  return lo;
+}
+const JSON_DEPTH_LIMIT = { arrays: depthLimit((v) => JSON.stringify(v), true), objects: depthLimit((v) => JSON.stringify(v), false) };
+
+property("TestHegelNestingAsDeepAsJsonStringify", (tc) => {
+  const { arrays, fraction } = tc.draw(gen.nestingCase);
+  const limit = arrays ? JSON_DEPTH_LIMIT.arrays : JSON_DEPTH_LIMIT.objects;
+  const depth = Math.floor(limit * fraction);
+  const v = nested(depth, arrays);
+  count(depth * 2 >= limit ? "deep" : "shallow");
+  let text;
+  try {
+    text = SuperJSON.stringify(v);
+  } catch (e) {
+    return fail(`stringify throws ${e.constructor.name} at depth ${depth} where JSON.stringify handles ${limit}`);
+  }
+  const back = SuperJSON.parse(text);
+  if (nestingDepth(back) !== depth) return fail(`depth ${depth} came back as depth ${nestingDepth(back)}`);
+});
+
+// ---------------------------------------------------------------------------------------------
+// Hostile payloads
+
+property("TestHegelHostilePayloadsNeverPollutePrototypes", (tc) => {
+  const before = protoSnapshot();
+  const { meta, json, viaParse } = tc.draw(gen.hostileCase);
+  const payload = JSON.parse(JSON.stringify({ json, meta }));
+  const s = instanceWithRegistrations();
+  let outcome = "returned";
+  try {
+    if (viaParse) s.parse(JSON.stringify(payload));
+    else s.deserialize(payload);
+  } catch (e) {
+    if (!(e instanceof Error)) fail(`deserialize threw a non-Error: ${String(e)}`);
+    outcome = "threw";
+  }
+  count(outcome);
+  if (protoSnapshot() !== before) fail(`deserialize changed a builtin prototype: ${JSON.stringify(payload)}`);
+  if ({}.polluted !== undefined || [].polluted !== undefined) fail(`prototype pollution through ${JSON.stringify(payload)}`);
+});
+
+// ---------------------------------------------------------------------------------------------
+// Pins: one plain test per recorded bug (bugs.toml). Each must fail while the bug is present.
+
+const setItems = (s) => [...s];
+
+pin("TestHegelPinTwoSharedValuesInOneSetAreBothRestored", () => {
+  const a = { a: 1 }, b = { b: 1 };
+  const r = SuperJSON.parse(SuperJSON.stringify([a, b, new Set([a, b, 3])]));
+  assert.deepEqual(setItems(r[2]).map((x) => (x === r[0] ? "a" : x === r[1] ? "b" : canon(x))), ["a", "b", "3"], `Set came back as ${canon(r[2])}`);
+  const m = SuperJSON.parse(SuperJSON.stringify([a, b, new Map([[a, 1], [b, 2], [3, 3]])]));
+  assert.equal(m[2].get(m[0]), 1);
+  assert.equal(m[2].get(m[1]), 2, `Map came back as ${canon(m[2])}`);
+  assert.equal(m[2].get(3), 3);
+  assert.equal(m[2].size, 3);
+});
+
+pin("TestHegelPinDedupeKeepsTheOtherElementsBesideASharedOne", () => {
+  const s = new SuperJSON({ dedupe: true });
+  const o = {};
+  const r = s.parse(s.stringify([o, new Set([o, null])]));
+  assert.deepEqual(setItems(r[1]).map((x) => (x === r[0] ? "o" : String(x))), ["o", "null"], `Set came back as ${canon(r[1])}`);
+  const m = s.parse(s.stringify([o, new Map([[o, 1], [null, 2]])]));
+  assert.equal(m[1].get(m[0]), 1, `Map came back as ${canon(m[1])}`);
+  assert.equal(m[1].get(null), 2);
+});
+
+pin("TestHegelPinRestoringASharedSetElementKeepsItsPosition", () => {
+  const o = {};
+  const r = SuperJSON.parse(SuperJSON.stringify([o, new Set([1, o, 2])]));
+  assert.deepEqual(setItems(r[1]).map((x) => (x === r[0] ? "o" : x)), [1, "o", 2]);
+  const d = new Date(0);
+  const m = SuperJSON.parse(SuperJSON.stringify([d, new Map([[d, 1], ["k", 2]])]));
+  assert.deepEqual([...m[1].keys()].map((k) => (k instanceof Date ? "date" : k)), ["date", "k"]);
+});
+
+pin("TestHegelPinSharedReferencesInsideClassInstancesAndErrorsAreRestored", () => {
+  const s = new SuperJSON();
+  class P {}
+  s.registerClass(P);
+  const p = new P();
+  p.self = p;
+  p.k = 1;
+  const r = s.parse(s.stringify(p));
+  assert.ok(r instanceof P);
+  assert.equal(r.self, r, `p.self came back as ${canon(r.self)}`);
+  const o = { x: 1 };
+  const e = new Error("m", { cause: o });
+  const back = SuperJSON.parse(SuperJSON.stringify({ o, e }));
+  assert.equal(back.e.cause, back.o, "the Error's cause must be the shared object");
+});
+
+pin("TestHegelPinCyclesToTheRootThroughASharedObjectSurvive", () => {
+  // the cycle is recorded under the first occurrence of `post` (posts[0].author), the shorter path
+  // `featured` becomes the representative, and the root relink is applied first
+  const user = { name: "u" };
+  const post = { author: user };
+  user.posts = [post];
+  user.featured = post;
+  const r = SuperJSON.parse(SuperJSON.stringify(user));
+  assert.equal(r.featured, r.posts[0]);
+  assert.equal(r.posts[0].author, r, `posts[0].author came back as ${canon(r.posts[0].author)}`);
+  const y = {};
+  const x = { y };
+  const root = { z: y, deep: { x }, x };
+  const back = SuperJSON.parse(SuperJSON.stringify(root));
+  assert.equal(back.x, back.deep.x);
+  assert.equal(back.x.y, back.z, "x.y must be the shared object z");
+});
+
+pin("TestHegelPinNaNIsNotASharedReference", () => {
+  const r = SuperJSON.parse(SuperJSON.stringify([NaN, new Map([[NaN, 1], [2, 2]])]));
+  assert.equal(r[1].size, 2, `the Map came back as ${canon(r[1])}`);
+  assert.equal(r[1].get(NaN), 1);
+  const s = SuperJSON.parse(SuperJSON.stringify([NaN, new Set([NaN, 1])]));
+  assert.deepEqual([...s[1]], [NaN, 1]);
+  const out = SuperJSON.serialize({ a: NaN, b: NaN });
+  assert.equal(out.meta.referentialEqualities, undefined, `two NaNs are annotated as one reference: ${JSON.stringify(out.meta)}`);
+});
+
+pin("TestHegelPinInvalidDateSurvives", () => {
+  const out = SuperJSON.stringify({ d: new Date(NaN) });
+  const back = SuperJSON.parse(out);
+  assert.ok(back.d instanceof Date, `an invalid Date came back as ${canon(back.d)} (${out})`);
+  assert.ok(Number.isNaN(back.d.getTime()));
+});
+
+pin("TestHegelPinNegativeZeroInFloatArraysSurvives", () => {
+  const back = SuperJSON.parse(SuperJSON.stringify([new Float32Array([-0, 1]), new Float64Array([-0])]));
+  assert.ok(Object.is(back[0][0], -0), `Float32Array[-0] came back as ${canon(back[0])}`);
+  assert.ok(Object.is(back[1][0], -0), `Float64Array[-0] came back as ${canon(back[1])}`);
+});
+
+pin("TestHegelPinNodeBufferDeserializes", () => {
+  const out = SuperJSON.stringify(Buffer.from("abc"));
+  let back;
+  assert.doesNotThrow(() => { back = SuperJSON.parse(out); }, `parse rejects the serialisation of a Buffer: ${out}`);
+  assert.ok(back instanceof Uint8Array);
+  assert.deepEqual(Array.from(back), [97, 98, 99]);
+});
+
+pin("TestHegelPinAnonymousClassAndDescriptionlessSymbolAreRegistered", () => {
+  const s = new SuperJSON();
+  const C = (() => class {})();
+  s.registerClass(C);
+  const x = new C();
+  x.a = 1;
+  const back = s.parse(s.stringify({ x }));
+  assert.ok(back.x instanceof C, `an instance of a registered anonymous class came back as ${canon(back.x)}`);
+  const sym = Symbol();
+  s.registerSymbol(sym);
+  const r = s.parse(s.stringify([sym, "x"]));
+  assert.equal(r[0], sym, `a registered symbol without description came back as ${String(r[0])}`);
+});
+
+pin("TestHegelPinNestingAsDeepAsJsonStringify", () => {
+  // three quarters of the depth JSON.stringify handles in this process (about 4100 nested
+  // arrays on Node 22's default stack; superjson's walker overflows at 1300 cold, 2550 warm)
+  const depth = Math.floor(JSON_DEPTH_LIMIT.arrays * 0.75);
+  const v = nested(depth, true);
+  let text;
+  assert.doesNotThrow(() => { text = SuperJSON.stringify(v); }, `stringify overflows at depth ${depth} where JSON.stringify handles ${JSON_DEPTH_LIMIT.arrays}`);
+  assert.equal(nestingDepth(SuperJSON.parse(text)), depth);
+});
+
+pin("TestHegelPinDeserializedErrorsGainNoOwnEnumerableProperties", () => {
+  const s = new SuperJSON();
+  s.allowErrorProps("code");
+  const back = s.parse(s.stringify(new Error("m")));
+  assert.ok(!Object.hasOwn(back, "code"), "a deserialized Error gained an own `code` property the original never had");
+  assert.deepEqual(Object.keys(SuperJSON.parse(SuperJSON.stringify(new Error("m")))), [], "a deserialized Error has own enumerable properties (`name`) the original had not");
+});
