+  const comp = () => {
+    // brute-force components by BFS
+    const id = new Array(size).fill(-1);
+    let c = 0;
+    for (let s = 0; s < size; s++) {
+      if (id[s] >= 0) continue;
+      const stack = [s];
+      id[s] = c;
+      while (stack.length) {
+        const u = stack.pop();
+        for (const w of adj[u]) if (id[w] < 0) {
+          id[w] = c;
+          stack.push(w);
+        }
+      }
+      c++;
