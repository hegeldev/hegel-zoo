+// LRUCache (and its with-delete variants, LRUMap) against a Map kept in recency order.
+property("TestHegelLruCachesEvictTheLeastRecentlyUsed", (tc) => {
+  const kind = pick(tc, ["LRUCache", "LRUMap", "LRUCacheWithDelete", "LRUMapWithDelete"]);
+  const capacity = n(tc, 1, 4);
+  const typed = chance(tc, 30);
+  const cache = typed ? new M[kind](Uint8Array, Uint8Array, capacity) : new M[kind](capacity);
+  const withDelete = kind.endsWith("WithDelete");
+  const keys = ["1", "2", "3", "4", "5", "6"].map(Number);
+  const model = []; // most recent first: [key, value]
+  const log = [];
+  const ctx = () => `${kind}(${typed ? "Uint8Array, Uint8Array, " : ""}${capacity}): ${log.join(", ")}`;
+  const find = (k) => model.findIndex((e) => e[0] === k);
+  // once a delete or remove has run on a WithDelete cache, any divergence is the corrupt list (mnemonist/11)
+  const bail = () => {
+    if (Known.lruWithDeleteCorrupts && withDelete && log.some((l) => /^(delete|remove) /.test(l))) {
+      count("known mnemonist/11");
+      return true;
+    }
+    return false;
+  };
+  const touch = (k) => {
+    const i = find(k);
+    const e = model.splice(i, 1)[0];
+    model.unshift(e);
+  };
+  const steps = n(tc, 0, 25);
+  for (let i = 0; i < steps; i++) {
+    const k = pick(tc, keys);
+    const v = n(tc, 0, 200);
+    const ops = ["set", "set", "get", "peek", "has", "setpop", "iterate"];
+    if (withDelete) ops.push("delete", "remove");
+    const op = pick(tc, ops);
+    if (op === "set") {
+      log.push(`set ${k} ${v}`);
+      cache.set(k, v);
+      const i = find(k);
+      if (i >= 0) {
+        model[i][1] = v;
+        touch(k);
+      } else {
+        model.unshift([k, v]);
+        if (model.length > capacity) model.pop();
+      }
+    } else if (op === "setpop") {
+      log.push(`setpop ${k} ${v}`);
+      const r = cache.setpop(k, v);
+      const i = find(k);
+      let e;
+      if (i >= 0) {
+        e = { evicted: false, key: k, value: model[i][1] };
+        model[i][1] = v;
+        touch(k);
+      } else {
+        model.unshift([k, v]);
+        if (model.length > capacity) {
+          const [ek, ev] = model.pop();
+          e = { evicted: true, key: ek, value: ev };
+        } else {
+          e = null;
+        }
+      }
+      if (!same(r, e)) {
+        if (bail()) return;
+        expectEqual(`${kind}.setpop`, r, e, ctx);
+      }
+    } else if (op === "get") {
+      const r = cache.get(k);
+      const i = find(k);
+      const e = i >= 0 ? model[i][1] : undefined;
+      if (r !== e) {
+        if (bail()) return;
+        fail(`${kind}.get(${k}) gave ${show(r)}, expected ${show(e)}; ${ctx()}`);
+      }
+      if (i >= 0) touch(k);
+      log.push(`get ${k}`);
+    } else if (op === "peek") {
+      const r = cache.peek(k);
+      const i = find(k);
+      const e = i >= 0 ? model[i][1] : undefined;
+      if (r !== e) {
+        if (bail()) return;
+        fail(`${kind}.peek(${k}) gave ${show(r)}, expected ${show(e)}; ${ctx()}`);
+      }
+    } else if (op === "has") {
+      const r = cache.has(k);
+      if (r !== find(k) >= 0) {
+        if (bail()) return;
+        fail(`${kind}.has(${k}) gave ${r}; ${ctx()}`);
+      }
+    } else if (op === "delete") {
+      log.push(`delete ${k}`);
+      const r = cache.delete(k);
+      const i = find(k);
+      if (i >= 0) model.splice(i, 1);
+      if (r !== i >= 0) {
+        if (bail()) return;
+        fail(`${kind}.delete(${k}) returned ${r}, expected ${i >= 0}; ${ctx()}`);
+      }
+    } else if (op === "remove") {
+      log.push(`remove ${k}`);
+      const r = cache.remove(k);
+      const i = find(k);
+      const e = i >= 0 ? model[i][1] : undefined;
+      if (i >= 0) model.splice(i, 1);
+      if (r !== e) {
+        if (bail()) return;
+        fail(`${kind}.remove(${k}) returned ${show(r)}, expected ${show(e)}; ${ctx()}`);
+      }
+    } else {
+      expectEqual(`${kind}.keys`, [...cache.keys()], model.map((e) => e[0]), ctx);
+      expectEqual(`${kind}.values`, [...cache.values()], model.map((e) => e[1]), ctx);
+      if (!same([...cache.entries()], model)) {
+        if (bail()) return;
+        expectEqual(`${kind}.entries`, [...cache.entries()], model, ctx);
+      }
+      if (!same([...cache], model)) {
+        if (bail()) return;
+        expectEqual(`${kind} iteration`, [...cache], model, ctx);
+      }
+      const fe = [];
+      cache.forEach((vv, kk) => fe.push([kk, vv]));
+      if (!same(fe, model)) {
+        if (bail()) return;
+        expectEqual(`${kind}.forEach`, fe, model, ctx);
+      }
+    }
+    if (cache.size !== model.length) {
+      if (bail()) return;
+      fail(`${kind}.size ${cache.size}, expected ${model.length}; ${ctx()}`);
+    }
+  }
+});
