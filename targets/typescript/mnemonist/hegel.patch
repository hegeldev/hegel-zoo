+      expectEqual("BitSet iteration", [...bs], bits, ctx);
+      expectEqual("BitSet.entries", [...bs.entries()], bits.map((b, j) => [j, b]), ctx);
+      const fe = [];
+      bs.forEach((b, j) => fe.push([j, b]));
+      expectEqual("BitSet.forEach", fe, bits.map((b, j) => [j, b]), ctx);
+      expectEqual("SparseSet iteration", sortedNums(ss), setBits, ctx);
+    }
+    const size = bits.reduce((s, b) => s + b, 0);
+    if (bs.size !== size) fail(`BitSet.size ${bs.size}, expected ${size}; ${ctx()}`);
+    if (ss.size !== size) fail(`SparseSet.size ${ss.size}, expected ${size}; ${ctx()}`);
+  }
+});
