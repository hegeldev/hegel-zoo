+// LRUCache (and its with-delete variants, LRUMap) against a Map kept in recency order.
+property("TestHegelLruCachesEvictTheLeastRecentlyUsed", (tc) => {
+  const { kind, capacity, typed, ops: steps } = tc.draw(lruCase);
+  const cache = typed ? new M[kind](Uint8Array, Uint8Array, capacity) : new M[kind](capacity);
+  const model = []; // most recent first: [key, value]
+  const log = [];
+  const ctx = () => `${kind}(${typed ? "Uint8Array, Uint8Array, " : ""}${capacity}): ${log.join(", ")}`;
+  const find = (k) => model.findIndex((e) => e[0] === k);
+  const touch = (k) => {
+    const i = find(k);
+    const e = model.splice(i, 1)[0];
+    model.unshift(e);
+  };
+  for (const step of steps) {
+    const { op: name, k, v } = step;
+    if (name === "set") {
+      log.push(`set ${k} ${v}`);
+      cache.set(k, v);
+      const i = find(k);
+      if (i >= 0) {
+        model[i][1] = v;
+        touch(k);
+      } else {
+        model.unshift([k, v]);
+        if (model.length > capacity) model.pop();
+      }
+    } else if (name === "setpop") {
+      log.push(`setpop ${k} ${v}`);
+      const r = cache.setpop(k, v);
+      const i = find(k);
+      let e;
+      if (i >= 0) {
+        e = { evicted: false, key: k, value: model[i][1] };
+        model[i][1] = v;
+        touch(k);
+      } else {
+        model.unshift([k, v]);
+        if (model.length > capacity) {
+          const [ek, ev] = model.pop();
+          e = { evicted: true, key: ek, value: ev };
+        } else {
+          e = null;
+        }
+      }
+      expectEqual(`${kind}.setpop`, r, e, ctx);
+    } else if (name === "get") {
+      log.push(`get ${k}`);
+      const r = cache.get(k);
+      const i = find(k);
+      const e = i >= 0 ? model[i][1] : undefined;
+      if (r !== e) fail(`${kind}.get(${k}) gave ${show(r)}, expected ${show(e)}; ${ctx()}`);
+      if (i >= 0) touch(k);
+    } else if (name === "peek") {
+      const r = cache.peek(k);
+      const i = find(k);
+      const e = i >= 0 ? model[i][1] : undefined;
+      if (r !== e) fail(`${kind}.peek(${k}) gave ${show(r)}, expected ${show(e)}; ${ctx()}`);
+    } else if (name === "has") {
+      const r = cache.has(k);
+      if (r !== find(k) >= 0) fail(`${kind}.has(${k}) gave ${r}; ${ctx()}`);
+    } else if (name === "delete" || name === "remove") {
+      const i = find(k);
+      // recorded shape (mnemonist/11): a delete or remove of the most or the least recently used
+      // key (of two or more) corrupts the recency list, with effects that may show only later -
+      // skipped; a middle key, the only key and an absent key are deleted and checked
+      if (Known.lruWithDeleteCorrupts && i >= 0 && model.length >= 2 && (i === 0 || i === model.length - 1)) {
+        count("known mnemonist/11");
+        continue;
+      }
+      log.push(`${name} ${k}`);
+      if (name === "delete") {
+        const r = cache.delete(k);
+        if (i >= 0) model.splice(i, 1);
