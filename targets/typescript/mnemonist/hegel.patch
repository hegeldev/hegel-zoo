+property("TestHegelBitSetAndSparseSetAgreeWithABooleanArray", (tc) => {
+  const length = n(tc, 1, 70);
+  const bs = new M.BitSet(length);
+  const ss = new M.SparseSet(length);
+  const bits = new Array(length).fill(0);
+  const log = [];
+  const steps = n(tc, 0, 40);
+  for (let i = 0; i < steps; i++) {
+    const idx = n(tc, 0, length - 1);
+    const op = pick(tc, ["set", "set", "reset", "flip", "query"]);
+    if (op === "set") {
+      log.push(`set ${idx}`);
+      bs.set(idx);
+      ss.add(idx);
+      bits[idx] = 1;
+    } else if (op === "reset") {
+      log.push(`reset ${idx}`);
+      const wasClear = bits[idx] === 0;
+      const bit31 = bits[(idx & ~31) + 31] === 1;
+      bs.reset(idx);
+      const r = ss.delete(idx);
+      if (r !== (bits[idx] === 1)) fail(`SparseSet.delete(${idx}) returned ${r}; ops ${log.join(", ")}`);
+      bits[idx] = 0;
+      const size = bits.reduce((s, b) => s + b, 0);
+      if (bs.size !== size) {
+        if (Known.resetSizeWithBit31 && wasClear && bit31) {
+          count("known mnemonist/9");
+          return; // size stays wrong from here on
+        }
+        fail(`BitSet.size ${bs.size} after reset, expected ${size}; length ${length}; ops ${log.join(", ")}`);
+      }
+    } else if (op === "flip") {
+      log.push(`flip ${idx}`);
+      bs.flip(idx);
+      bits[idx] ^= 1;
+      if (bits[idx]) ss.add(idx);
+      else ss.delete(idx);
+    } else {
+      const setBits = [];
+      bits.forEach((b, j) => b && setBits.push(j));
+      for (let j = 0; j < length; j++) {
+        if (bs.get(j) !== bits[j]) fail(`BitSet.get(${j}) ${bs.get(j)}, expected ${bits[j]}; length ${length}; ops ${log.join(", ")}`);
+        if (bs.test(j) !== (bits[j] === 1)) fail(`BitSet.test(${j}) ${bs.test(j)}; length ${length}; ops ${log.join(", ")}`);
+        if (ss.has(j) !== (bits[j] === 1)) fail(`SparseSet.has(${j}) ${ss.has(j)}; length ${length}; ops ${log.join(", ")}`);
+      }
+      // rank(i): number of ones before index i; select(r): index of the r-th one (1-based), -1 if none
+      const r = n(tc, 0, length);
+      const rank = bits.slice(0, r).reduce((s, b) => s + b, 0);
+      if (bs.rank(r) !== rank) fail(`BitSet.rank(${r}) ${bs.rank(r)}, expected ${rank}; length ${length}; ops ${log.join(", ")}`);
+      const k = n(tc, 1, setBits.length + 1);
+      const sel = k <= setBits.length ? setBits[k - 1] : -1;
+      if (bs.select(k) !== sel) {
+        // a whole 32-bit word of zeros before the target bit
+        let zeroWord = false;
+        for (let w = 0; sel >= 0 && (w + 1) * 32 <= sel; w++) {
+          if (bits.slice(w * 32, w * 32 + 32).every((b) => b === 0)) zeroWord = true;
+        }
+        if (Known.selectSkipsZeroWords && zeroWord) {
+          count("known mnemonist/2");
+        } else if (Known.selectBoundedByLength && (k >= length || k > setBits.length)) {
+          count("known mnemonist/10");
+        } else {
+          fail(`BitSet.select(${k}) ${bs.select(k)}, expected ${sel}; bits ${show(setBits)}; length ${length}; ops ${log.join(", ")}`);
+        }
+      }
+      // the iterator and forEach yield every bit (0 or 1) in index order
+      expectEqual("BitSet iteration", [...bs], bits, () => `length ${length}; ops ${log.join(", ")}`);
+      expectEqual("BitSet.entries", [...bs.entries()], bits.map((b, j) => [j, b]), () => `length ${length}; ops ${log.join(", ")}`);
+      const fe = [];
+      bs.forEach((b, j) => fe.push([j, b]));
+      expectEqual("BitSet.forEach", fe, bits.map((b, j) => [j, b]), () => `length ${length}; ops ${log.join(", ")}`);
+      expectEqual("SparseSet iteration", sortedNums(ss), setBits, () => `length ${length}; ops ${log.join(", ")}`);
+    }
+    const size = bits.reduce((s, b) => s + b, 0);
+    if (bs.size !== size) fail(`BitSet.size ${bs.size}, expected ${size}; length ${length}; ops ${log.join(", ")}`);
+    if (ss.size !== size) fail(`SparseSet.size ${ss.size}, expected ${size}; length ${length}; ops ${log.join(", ")}`);
+  }
+});
