+// ---------------------------------------------------------------- k-d, vantage-point and BK trees
+
+property("TestHegelKdTreeNeighboursMatchTheScan", (tc) => {
+  const dims = n(tc, 1, 3);
+  const size = n(tc, 0, 12);
+  const points = [];
+  for (let i = 0; i < size; i++) {
+    const p = [];
+    for (let d = 0; d < dims; d++) p.push(n(tc, 0, 6));
+    points.push([`p${i}`, p]);
+  }
+  const tree = M.KDTree.from(points, dims);
+  if (tree.size !== size) fail(`KDTree.size ${tree.size}, expected ${size}`);
+  const query = [];
+  for (let d = 0; d < dims; d++) query.push(n(tc, -1, 7));
+  const dist = (p) => p.reduce((s, x, d) => s + (x - query[d]) ** 2, 0);
+  const sorted = [...points].sort((a, b) => dist(a[1]) - dist(b[1]));
+  const ctx = () => `dims ${dims} points ${show(points)} query ${show(query)}`;
+  if (size === 0) {
+    let nn;
+    let knn;
+    try {
+      nn = tree.nearestNeighbor(query);
+      knn = tree.kNearestNeighbors(1, query);
+    } catch (e) {
+      if (Known.kdTreeEmpty) {
+        count("known mnemonist/39");
+        return;
+      }
+      fail(`KDTree queries on the empty tree threw ${e.message}`);
+    }
+    if (nn !== undefined || !same(knn, [])) fail(`KDTree empty: nearestNeighbor ${show(nn)}, kNearestNeighbors ${show(knn)}`);
+    return;
+  }
+  const nn = tree.nearestNeighbor(query);
+  const best = dist(sorted[0][1]);
+  const found = points.find((p) => p[0] === nn);
+  if (!found || dist(found[1]) !== best) fail(`KDTree.nearestNeighbor ${show(nn)} at distance ${found ? dist(found[1]) : "?"}, best ${best}; ${ctx()}`);
+  const k = n(tc, 1, size + 1);
+  const knn = tree.kNearestNeighbors(k, query);
+  const wantDists = sorted.slice(0, k).map((p) => dist(p[1]));
+  const gotDists = knn.map((label) => dist(points.find((p) => p[0] === label)[1]));
+  if (knn.length !== Math.min(k, size) || !same(gotDists, wantDists) || new Set(knn).size !== knn.length) {
+    fail(`KDTree.kNearestNeighbors(${k}) ${show(knn)} distances ${show(gotDists)}, expected ${show(wantDists)}; ${ctx()}`);
+  }
+  const lin = tree.linearKNearestNeighbors(k, query);
+  const linDists = lin.map((label) => dist(points.find((p) => p[0] === label)[1]));
+  if (!same(linDists, wantDists)) fail(`KDTree.linearKNearestNeighbors(${k}) distances ${show(linDists)}, expected ${show(wantDists)}; ${ctx()}`);
+});
