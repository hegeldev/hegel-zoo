+  const { ops: steps, other: otherWord } = tc.draw(multiSetCase);
+  const ms = new M.MultiSet();
+  const model = new Map();
+  const log = [];
+  const total = () => [...model.values()].reduce((s, c) => s + c, 0);
+  const ctx = () => `ops ${log.join(", ")}`;
+  for (const step of steps) {
+    const { op: name, k, c } = step;
+    // the recorded shapes are skipped before the operation (the structure would diverge from the
+    // model and stay diverged): set on a present key (mnemonist/5), delete of an absent key (6),
+    // edit into a present key (7), edit of a key into itself (8)
+    if (name === "set" && Known.multiSetSetAdds && model.has(k)) {
+      count("known mnemonist/5");
+      continue;
+    }
+    if (name === "delete" && Known.multiSetDeleteAbsent && !model.has(k)) {
+      count("known mnemonist/6");
+      continue;
+    }
+    if (name === "edit" && model.has(k) && k === step.k2 && Known.multiSetEditSelfDeletes) {
+      count("known mnemonist/8");
+      continue;
