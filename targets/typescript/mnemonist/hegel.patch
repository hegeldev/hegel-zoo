+  const size = items.length;
+  const ctx = () => `items ${show(items)} query ${show(query)}`;
+  const dists = items.map((s) => levenshtein(s, query));
+  const sortedD = [...dists].sort((a, b) => a - b);
+  // VPTree: k nearest, then within a radius
+  const vp = new M.VPTree(levenshtein, items);
+  const k = Known.vpTreeKZero ? 1 + (kRaw % (size + 1)) : kRaw % (size + 2);
+  const near = vp.nearestNeighbors(k, query);
+  const got = near.map((m) => m.distance);
+  const want = sortedD.slice(0, k);
+  if (!same(got, want) || near.some((m) => levenshtein(m.item, query) !== m.distance)) {
+    fail(`VPTree.nearestNeighbors(${k}) ${show(near)}, expected distances ${show(want)}; ${ctx()}`);
+  }
+  const within = vp.neighbors(radius, query);
+  const wantWithin = items.map((s, i) => [s, dists[i]]).filter((p) => p[1] <= radius).map((p) => `${p[1]}:${p[0]}`).sort();
+  const gotWithin = within.map((m) => `${m.distance}:${m.item}`).sort();
+  expectEqual(`VPTree.neighbors(${radius})`, gotWithin, wantWithin, ctx);
+  // BKTree: everything within n
+  const bk = M.BKTree.from(items, levenshtein);
+  if (bk.size !== size) fail(`BKTree.size ${bk.size}, expected ${size}; ${ctx()}`);
+  const found = bk.search(radius, query).map((m) => `${m.distance}:${m.item}`).sort();
+  expectEqual(`BKTree.search(${radius})`, found, wantWithin, ctx);
+  // PassjoinIndex: everything within k
+  const pj = M.PassjoinIndex.from(items, levenshtein, kk);
+  const pjGot = sortStr([...pj.search(query)]);
+  const pjWant = sortStr([...new Set(items.filter((s, i) => dists[i] <= kk))]);
+  expectEqual(`PassjoinIndex(${kk}).search`, pjGot, pjWant, ctx);
+});
+
+// ---------------------------------------------------------------- SymSpell
+
+/** The SymSpell case: the maximum distance, the verbosity, 1 to 8 words over abc and a query word. */
+const symSpellCase = gs.record({ maxDistance: ints(1, 3), verbosity: ints(0, 2), words: gs.arrays(word("abc", 1, 5), { minSize: 1, maxSize: 8 }), query: word("abc", 1, 5) });
+
+property("TestHegelSymSpellFindsTheTermsWithinTheDistance", (tc) => {
+  const { maxDistance, verbosity, words, query } = tc.draw(symSpellCase);
+  const s = new M.SymSpell({ maxDistance, verbosity });
+  for (const w of words) s.add(w);
+  const counts = new Map();
+  for (const w of words) counts.set(w, (counts.get(w) || 0) + 1);
+  const ctx = () => `maxDistance ${maxDistance} verbosity ${verbosity} words ${show(words)} query ${show(query)}`;
+  const results = s.search(query);
+  // every result is a stored term at its true distance with its true count
+  for (const r of results) {
+    const d = damerau(r.term, query);
+    if (!counts.has(r.term) || d !== r.distance || d > maxDistance) fail(`SymSpell result ${show(r)} is wrong (true distance ${d}); ${ctx()}`);
+    if (r.count !== counts.get(r.term)) {
+      if (Known.symSpellZeroesCount && verbosity < 2) count("known mnemonist/26");
+      else fail(`SymSpell result ${show(r)} has count ${r.count}, expected ${counts.get(r.term)}; ${ctx()}`);
+    }
+  }
+  // reachable terms: SymSpell never indexes deletes of one-letter words nor the empty string, so
+  // a pair whose only common delete is the empty string is not found by design
+  const reachable = (w) => {
+    const d = damerau(w, query);
+    if (d > maxDistance) return false;
+    if (w === query) return true;
+    // common non-empty deletes of w and query within maxDistance deletions each
+    const deletes = (x) => {
+      const out = new Set([x]);
+      let frontier = [x];
+      for (let i = 0; i < maxDistance; i++) {
+        const next = [];
+        for (const y of frontier) {
+          if (y.length <= 1) continue;
+          for (let j = 0; j < y.length; j++) {
+            const z = y.slice(0, j) + y.slice(j + 1);
+            if (!out.has(z)) {
+              out.add(z);
+              next.push(z);
+            }
+          }
+        }
+        frontier = next;
+      }
+      return out;
+    };
+    const dw = deletes(w);
+    return [...deletes(query)].some((z) => z !== "" && dw.has(z));
+  };
+  const expected = [...counts.keys()].filter(reachable);
+  const minD = Math.min(...expected.map((w) => damerau(w, query)));
+  if (verbosity === 2) {
+    expectEqual("SymSpell verbosity 2 terms", sortStr(results.map((r) => r.term)), sortStr(expected), ctx);
+  } else if (verbosity === 1) {
+    const want = sortStr(expected.filter((w) => damerau(w, query) === minD));
+    const got = sortStr(results.map((r) => r.term));
+    if (!same(got, want)) {
+      if (Known.symSpellVerbosityOrder) count("known mnemonist/27");
+      else fail(`SymSpell verbosity 1 ${show(got)}, expected the nearest terms ${show(want)}; ${ctx()}`);
+    }
+  } else {
+    const ok = expected.length === 0 ? results.length === 0 : results.length === 1 && damerau(results[0].term, query) === minD;
+    if (!ok) {
+      if (Known.symSpellVerbosityOrder) count("known mnemonist/27");
+      else fail(`SymSpell verbosity 0 ${show(results)}, expected one term at distance ${minD}; ${ctx()}`);
+    }
+  }
+});
+
+// ---------------------------------------------------------------- suffix arrays
+
+/** The suffix array case: a binary or a four-letter alphabet, a string of up to 14 letters, and two or three words of 1 to 5 letters for the generalized array. */
+const suffixArrayCase = pick(["ab", "abcd"]).flatMap((alphabet) =>
+  gs.record({ s: word(alphabet, 0, 14), strings: gs.arrays(word(alphabet, 1, 5), { minSize: 2, maxSize: 3 }) }),
+);
+
+property("TestHegelSuffixArraysSortTheSuffixes", (tc) => {
+  const { s, strings } = tc.draw(suffixArrayCase);
+  const sa = new M.SuffixArray(s);
+  const want = Array.from({ length: s.length }, (_, i) => i).sort((i, j) => (s.slice(i) < s.slice(j) ? -1 : 1));
+  if (!same(Array.from(sa.array), want)) {
+    if (Known.suffixArrayModThree && s.length % 3 === 1 && s.length >= 7) count("known mnemonist/35");
+    else fail(`SuffixArray(${show(s)}).array ${show(Array.from(sa.array))}, expected ${show(want)}`);
+  }
+  // generalized: the longest common substring of several strings
+  const k = strings.length;
+  const gsa = new M.SuffixArray.GeneralizedSuffixArray(strings);
+  const lcs = gsa.longestCommonSubsequence();
+  const subs = (x) => {
+    const out = new Set();
+    for (let i = 0; i <= x.length; i++) for (let j = i; j <= x.length; j++) out.add(x.slice(i, j));
+    return out;
+  };
+  const common = [...subs(strings[0])].filter((sub) => strings.every((x) => x.includes(sub)));
+  const bestLen = Math.max(...common.map((c) => c.length));
+  const ok = typeof lcs === "string" && lcs.length === bestLen && strings.every((x) => x.includes(lcs));
+  if (!ok) {
+    // the generalized array is built over the strings joined by one separator character each
+    const total = strings.join("").length + k - 1;
+    if (Known.gsaLcsManyStrings && k >= 3) count("known mnemonist/36");
+    else if (Known.suffixArrayModThree && total % 3 === 1 && total >= 7) count("known mnemonist/35");
+    else fail(`GeneralizedSuffixArray(${show(strings)}).longestCommonSubsequence ${show(lcs)}, expected a common substring of length ${bestLen}`);
+  }
+});
+
+// ---------------------------------------------------------------- inverted index and fuzzy maps
+
+const INDEX_TOKEN = pick(["x", "y", "z", "w"]);
+/** The inverted index case: up to 8 documents of up to 4 tokens and a query of 1 to 3 tokens. */
+const invertedIndexCase = gs.record({
+  docs: gs.arrays(gs.arrays(INDEX_TOKEN, { maxSize: 4 }).map((tokens) => tokens.join(" ")), { maxSize: 8 }),
+  qTokens: gs.arrays(INDEX_TOKEN, { minSize: 1, maxSize: 3 }),
+});
+
+property("TestHegelInvertedIndexAnswersConjunctiveQueries", (tc) => {
+  const { docs, qTokens } = tc.draw(invertedIndexCase);
+  const size = docs.length;
+  const tokenize = (s) => (s === "" ? [] : s.split(" "));
+  const index = M.InvertedIndex.from(docs, tokenize);
+  if (index.size !== size) fail(`InvertedIndex.size ${index.size}, expected ${size}; docs ${show(docs)}`);
+  const vocab = new Set(docs.flatMap(tokenize));
+  if (index.dimension !== vocab.size) fail(`InvertedIndex.dimension ${index.dimension}, expected ${vocab.size}; docs ${show(docs)}`);
+  const query = qTokens.join(" ");
+  const got = sortStr(index.get(query));
+  const want = sortStr(docs.filter((d) => qTokens.every((t) => tokenize(d).includes(t))));
+  expectEqual(`InvertedIndex.get(${show(query)})`, got, want, () => `docs ${show(docs)}`);
+  expectEqual("InvertedIndex.documents", [...index.documents()], docs, () => `docs ${show(docs)}`);
+  expectEqual("InvertedIndex.tokens", sortStr(index.tokens()), sortStr(vocab), () => `docs ${show(docs)}`);
+  const seen = [];
+  index.forEach((d, i) => seen.push([d, i]));
+  if (!same(seen, docs.map((d, i) => [d, i]))) {
+    if (Known.invertedIndexForEach && size > 0) count("known mnemonist/37");
+    else expectEqual("InvertedIndex.forEach", seen, docs.map((d, i) => [d, i]), () => `docs ${show(docs)}`);
+  }
+});
+
+/** The fuzzy maps' case: Set containers half of the time and up to 10 words of one or two letters in either case. */
+const fuzzyMapsCase = gs.record({ useSet: chance(50), words: gs.arrays(word("aAbB", 1, 2), { maxSize: 10 }) });
+
+property("TestHegelFuzzyMapsGroupByTheirHash", (tc) => {
+  const { useSet, words } = tc.draw(fuzzyMapsCase);
+  const hash = (s) => s.toLowerCase();
+  const fm = new M.FuzzyMap(hash);
+  const fmm = new M.FuzzyMultiMap(hash, useSet ? Set : Array);
+  const model = new Map(); // hash -> last value (FuzzyMap) / all values (FuzzyMultiMap)
+  const multi = new Map();
+  for (const w of words) {
+    fm.add(w);
+    fmm.add(w);
+    model.set(hash(w), w);
+    if (!multi.has(hash(w))) multi.set(hash(w), []);
+    const arr = multi.get(hash(w));
+    if (!useSet || !arr.includes(w)) arr.push(w);
+  }
+  const ctx = () => `${useSet ? "Set" : "Array"} words ${show(words)}`;
+  if (fm.size !== model.size) fail(`FuzzyMap.size ${fm.size}, expected ${model.size}; ${ctx()}`);
+  const total = [...multi.values()].reduce((s, a) => s + a.length, 0);
+  if (fmm.size !== total || fmm.dimension !== multi.size) fail(`FuzzyMultiMap.size ${fmm.size}/dimension ${fmm.dimension}, expected ${total}/${multi.size}; ${ctx()}`);
+  for (const q of ["a", "A", "b", "ab", "AB", "Ba", "c"]) {
+    if (fm.get(q) !== model.get(hash(q))) fail(`FuzzyMap.get(${q}) ${show(fm.get(q))}, expected ${show(model.get(hash(q)))}; ${ctx()}`);
+    if (fm.has(q) !== model.has(hash(q))) fail(`FuzzyMap.has(${q}) ${fm.has(q)}; ${ctx()}`);
+    const got = fmm.get(q);
+    expectEqual(`FuzzyMultiMap.get(${q})`, got === undefined ? undefined : Array.from(got), multi.get(hash(q)), ctx);
+  }
+  expectEqual("FuzzyMap values", sortStr(fm), sortStr(model.values()), ctx);
+  expectEqual("FuzzyMultiMap values", sortStr(fmm), sortStr([...multi.values()].flat()), ctx);
+});
