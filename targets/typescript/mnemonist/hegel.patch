+property("TestHegelDisjointSetMatchesConnectedComponents", (tc) => {
+  const size = n(tc, 1, 10);
+  const ds = new M.StaticDisjointSet(size);
+  const adj = Array.from({ length: size }, () => new Set());
+  const unions = [];
+  const steps = n(tc, 0, 12);
+  const comp = () => {
+    // brute-force components by BFS
+    const id = new Array(size).fill(-1);
+    let c = 0;
+    for (let s = 0; s < size; s++) {
+      if (id[s] >= 0) continue;
+      const stack = [s];
+      id[s] = c;
+      while (stack.length) {
+        const u = stack.pop();
+        for (const w of adj[u]) if (id[w] < 0) {
+          id[w] = c;
+          stack.push(w);
+        }
+      }
+      c++;
+    }
+    return { id, c };
+  };
+  for (let i = 0; i < steps; i++) {
+    const a = n(tc, 0, size - 1);
+    const b = n(tc, 0, size - 1);
+    unions.push([a, b]);
+    ds.union(a, b);
+    adj[a].add(b);
+    adj[b].add(a);
+    const { id, c } = comp();
+    if (ds.dimension !== c) fail(`StaticDisjointSet.dimension ${ds.dimension}, expected ${c}; size ${size}; unions ${show(unions)}`);
+    for (let x = 0; x < size; x++) for (let y = 0; y < size; y++) {
+      const e = id[x] === id[y];
+      if (ds.connected(x, y) !== e) fail(`connected(${x}, ${y}) ${ds.connected(x, y)}, expected ${e}; size ${size}; unions ${show(unions)}`);
+      if ((ds.find(x) === ds.find(y)) !== e) fail(`find(${x}) vs find(${y}); size ${size}; unions ${show(unions)}`);
+    }
+    const mapping = Array.from(ds.mapping());
+    for (let x = 0; x < size; x++) for (let y = 0; y < size; y++) {
+      if ((mapping[x] === mapping[y]) !== (id[x] === id[y])) fail(`mapping ${show(mapping)} disagrees with components ${show(id)}; unions ${show(unions)}`);
+    }
+    const compiled = ds.compile().map((g) => sortedNums(g)).sort((p, q) => p[0] - q[0]);
+    const groups = [];
+    for (let k = 0; k < c; k++) groups.push([]);
+    id.forEach((cc, x) => groups[cc].push(x));
+    expectEqual("compile", compiled, groups.sort((p, q) => p[0] - q[0]), () => `size ${size}; unions ${show(unions)}`);
+  }
+});
