+++ b/hegel/pins.mjs
@@ -0,0 +1,370 @@
+// One plain test per recorded bug (mnemonist/N), asserting the correct behaviour so that it
+// fails while the bug exists and passes once it is fixed. Listed as expected failures in
+// target.toml.
+
+import assert from "node:assert/strict";
+import { createRequire } from "node:module";
+import { pin } from "./hegel-zoo.mjs";
+
+const require = createRequire(import.meta.url);
+const M = require("../index.js");
+const merge = require("../utils/merge.js");
+const typed = require("../utils/typed-arrays.js");
+const insertion = require("../sort/insertion.js");
+const MultiArray = require("../multi-array.js");
+const CritBitTreeMap = require("../critbit-tree-map.js");
+
+const cmpNum = (a, b) => a - b;
+
+pin("TestHegelPinNsmallestOfOneOnEmptyIsEmpty", () => {
+  assert.deepEqual(M.Heap.nsmallest(1, []), []); // mnemonist/1
+  assert.deepEqual(M.Heap.nlargest(1, []), []);
+});
+
+pin("TestHegelPinSelectSkipsNoPositions", () => {
+  const b = new M.BitSet(100);
+  b.set(40);
+  assert.equal(b.select(1), 40); // mnemonist/2
+});
+
+pin("TestHegelPinFixedStackForEachStopsAtSize", () => {
+  const s = new M.FixedStack(Array, 5);
+  s.push(1);
+  s.push(2);
+  const seen = [];
+  s.forEach((v) => seen.push(v));
+  assert.deepEqual(seen, [2, 1]); // mnemonist/3
+});
+
+pin("TestHegelPinDequeGetPastTheSizeIsUndefined", () => {
+  const d = new M.FixedDeque(Array, 3);
+  d.push(1);
+  d.push(2);
+  d.push(3);
+  d.shift();
+  d.shift();
+  assert.equal(d.get(1), undefined); // mnemonist/4
+  const c = new M.CircularBuffer(Array, 3);
+  c.push(1);
+  assert.equal(c.get(2), undefined);
+});
+
+pin("TestHegelPinMultiSetSetReplacesTheCount", () => {
+  const s = new M.MultiSet();
+  s.add("a", 3);
+  s.set("a", 2);
+  assert.equal(s.multiplicity("a"), 2); // mnemonist/5
+  assert.equal(s.size, 2);
+});
+
+pin("TestHegelPinMultiSetDeleteOfAnAbsentKeyIsFalse", () => {
+  const s = new M.MultiSet();
+  s.add("a");
+  assert.equal(s.delete("z"), false); // mnemonist/6
+  assert.equal(s.size, 1);
+  assert.equal(s.dimension, 1);
+});
+
+pin("TestHegelPinMultiSetEditMergesTheDimension", () => {
+  const s = new M.MultiSet();
+  s.add("a");
+  s.add("b");
+  s.edit("a", "b");
+  assert.equal(s.dimension, 1); // mnemonist/7
+  assert.equal(s.multiplicity("b"), 2);
+});
+
+pin("TestHegelPinMultiSetEditToItselfKeepsTheKey", () => {
+  const s = new M.MultiSet();
+  s.add("a", 2);
+  s.edit("a", "a");
+  assert.equal(s.multiplicity("a"), 2); // mnemonist/8
+  assert.equal(s.size, 2);
+});
+
+pin("TestHegelPinResetOfAClearBitKeepsTheSize", () => {
+  const b = new M.BitSet(32);
+  b.set(31);
+  b.reset(0);
+  assert.equal(b.size, 1); // mnemonist/9
+  const v = new M.BitVector(32);
+  v.set(31);
+  v.reset(0);
+  assert.equal(v.size, 1);
+});
+
+pin("TestHegelPinSelectOfTheLastOneInAFullSet", () => {
+  const b = new M.BitSet(1);
+  b.set(0);
+  assert.equal(b.select(1), 0); // mnemonist/10
+  const c = new M.BitSet(4);
+  c.set(0);
+  assert.equal(c.select(2), -1);
+});
+
+pin("TestHegelPinDeleteOfTheMostRecentKeyKeepsTheList", () => {
+  for (const C of [M.LRUCacheWithDelete, M.LRUMapWithDelete]) {
+    const c = new C(4);
+    c.set("a", 1);
+    c.set("b", 2);
+    c.set("c", 3);
+    c.set("d", 4);
+    c.get("b");
+    c.delete("b");
+    assert.deepEqual([...c.keys()], ["d", "c", "a"]); // mnemonist/11
+  }
+});
+
+pin("TestHegelPinSparseMapDeleteMovesTheValue", () => {
+  const m = new M.SparseMap(10);
+  m.set(1, "a");
+  m.set(2, "b");
+  m.delete(1);
+  assert.equal(m.get(2), "b"); // mnemonist/12
+});
+
+pin("TestHegelPinSparseQueueSetOf256Dequeues", () => {
+  const q = new M.SparseQueueSet(256);
+  q.enqueue(7);
+  q.enqueue(8);
+  q.dequeue();
+  assert.equal(q.has(7), false); // mnemonist/13
+  assert.equal(q.enqueue(7).size, 2);
+});
+
+pin("TestHegelPinBitVectorPopClearsTheBit", () => {
+  const v = new M.BitVector();
+  v.push(1);
+  v.pop();
+  v.push(0);
+  assert.equal(v.size, 0); // mnemonist/14
+  assert.equal(v.get(0), 0);
+});
+
+pin("TestHegelPinBitVectorIterationStopsAtTheLength", () => {
+  const v = new M.BitVector();
+  v.push(1);
+  v.push(0);
+  v.push(1);
+  v.grow(64);
+  assert.equal([...v.values()].length, 3); // mnemonist/15
+});
+
+pin("TestHegelPinBitVectorSetAtTheLengthThrows", () => {
+  const v = new M.BitVector(5);
+  assert.throws(() => v.set(5)); // mnemonist/16
+});
+
+pin("TestHegelPinVectorGetAtTheLengthIsUndefined", () => {
+  const v = new M.Vector(Uint8Array, 4);
+  v.push(1);
+  v.push(2);
+  v.pop();
+  assert.equal(v.get(1), undefined); // mnemonist/17
+  assert.throws(() => v.set(1, 9));
+});
+
+pin("TestHegelPinHashedArrayTreePopReadsTheLastItem", () => {
+  const a = new M.HashedArrayTree(Uint8Array, { blockSize: 2, initialCapacity: 8 });
+  a.push(1);
+  a.push(2);
+  a.push(3);
+  assert.equal(a.pop(), 3); // mnemonist/18
+});
+
