@@ -0,0 +1,50 @@
+// Recorded bugs (mnemonist/N): a switch per bug gates the input shape, on a mismatch only, so the
+// properties stay green while the pins fail. Bugs without a switch are reached by pins only.
+export const Known = {
+  nsmallestOneOnEmpty: true, // 1: nsmallest(1, []) is [Infinity], nlargest(1, []) is [-Infinity]
+  selectSkipsZeroWords: true, // 2: BitSet/BitVector.select does not advance its position over a skipped all-zero word
+  fixedStackForEachVisitsCapacity: true, // 3: FixedStack.forEach visits every slot of the capacity, empty ones included
+  dequeGetIgnoresSize: true, // 4: FixedDeque/CircularBuffer.get(i) for i >= size or i < 0 returns a stale or wrapped item
+  multiSetSetAdds: true, // 5: MultiSet.set(k, c) on a present key adds c to its count instead of replacing it
+  multiSetDeleteAbsent: true, // 6: MultiSet.delete of an absent key returns true and makes size NaN, dimension one too low
+  multiSetEditKeepsDimension: true, // 7: MultiSet.edit(a, b) into a present b leaves dimension one too high
+  multiSetEditSelfDeletes: true, // 8: MultiSet.edit(a, a) deletes a and leaves size stale
+  resetSizeWithBit31: true, // 9: BitSet/BitVector.reset of a clear bit decrements size when bit 31 of its word is set
+  selectBoundedByLength: true, // 10: BitSet.select(r) is -1 for r >= length even when the rth one exists; undefined past the last one
+  lruWithDeleteCorrupts: true, // 11: LRUCacheWithDelete/LRUMapWithDelete.delete/remove of the most or least recent key corrupts the list
+  sparseMapDeleteLosesValue: true, // 12: SparseMap.delete moves the last key into the hole but not its value
+  sparseQueueSetSentinelOverflow: true, // 13: SparseQueueSet(256).dequeue leaves the member present (sentinel wraps to 0)
+  bitVectorPopKeepsSize: true, // 14: BitVector.pop neither decrements size nor clears the bit
+  bitVectorIteratesCapacity: true, // 15: BitVector.forEach/values/entries/select run over the capacity, not the length
+  bitVectorSetAtLength: true, // 16: BitVector.set/get/test accept index == length
+  vectorGetSetAtLength: true, // 17: Vector.get(length) returns a stale value and set(length) writes past the end
+  hatPopReadsLastBlock: true, // 18: HashedArrayTree.pop reads the last allocated block, not the block of the last item
+  hatGetSetAtLength: true, // 19: HashedArrayTree.get/set accept index == length (stale value or TypeError)
+  kWayMergeEmptyArray: true, // 20: merge/unionUnique of three or more arrays crash when one is empty
+  uniqueMergeTypedArrays: true, // 21: unionUnique/intersectionUnique of two typed arrays throw (array.push)
+  intersectionUniqueShortcut: true, // 22: intersectionUnique of three or more arrays returns [x] when max first == min last though x is missing
+  linkedListStaleTail: true, // 23: LinkedList.shift of the only item leaves last() pointing at it
+  bloomErrorRateHalf: true, // 24: BloomFilter truncates to zero bytes and hash functions (small capacity or errorRate >= 0.5) and tests true for everything; errorRate > 1 throws a RangeError
+  minimalRepresentationMixedSigns: true, // 25: getMinimalRepresentation([200, -1]) picks Int8Array
+  symSpellZeroesCount: true, // 26: SymSpell (verbosity 0/1) zeroes the count of a stored word, so it is dropped or returned with count 0
+  symSpellVerbosityOrder: true, // 27: SymSpell verbosity 0 does not return the nearest term; verbosity 1 mixes distances
+  lruCachePrototypeKeys: true, // 28: LRUCache.has('constructor') is true on a fresh cache; get corrupts the list
+  setpopFalsyKey: true, // 29: setpop returns null when the evicted key is 0 or ''
+  fromOverCapacity: true, // 30: FixedStack/FixedDeque/CircularBuffer.from(array, C, capacity) with more items than capacity yields size > capacity
+  fromNonArrayIterable: true, // 31: FixedStack/FixedDeque/CircularBuffer.from(new Set(...)) throw (iterables.forEach is not a function)
+  fixedReverseHeapCapacityCheck: true, // 32: FixedReverseHeap accepts capacity 0 and non-numbers, then push throws
+  kWayMergePointerOverflow: true, // 33: merge of three or more arrays with the longest of exactly 256 items loops until a RangeError
+  multiArrayPointerOverflow: true, // 34: MultiArray (dynamic) loses items past 255 in one container
+  suffixArrayModThree: true, // 35: SuffixArray is unsorted whenever length % 3 == 1 (>= 7)
+  gsaLcsManyStrings: true, // 36: GeneralizedSuffixArray.longestCommonSubsequence of three or more strings ignores all but the first boundary and may return the separator
+  invertedIndexForEach: true, // 37: InvertedIndex.forEach never calls back
+  intervalTreeEmpty: true, // 38: new StaticIntervalTree([]) throws
+  kdTreeEmpty: true, // 39: KDTree.from([], d).nearestNeighbor overflows the stack, kNearestNeighbors throws
+  vpTreeKZero: true, // 40: VPTree.nearestNeighbors(0, q) throws
+  trieSentinelKeys: true, // 41: Trie/TrieMap keys containing '\0' collide with the value slot (has('') true, TypeError)
+  trieArrayPrototypeTokens: true, // 42: Trie(Array) with a token named like an Object.prototype property reads and writes the prototype
+  typingsDeclareMissingMembers: true, // 43: vector.d.ts clear/forEach/toJSON, bit-vector.d.ts clear and the InverseMap export do not exist at runtime
+  vectorResizeShrinks: true, // 44: Vector.resize below the capacity deallocates ("Won't deallocate")
+  critBitSixteenBitKeys: true, // 45: CritBitTreeMap/FixedCritBitTreeMap lose keys with a char code above 255
+  insertionSortGlobal: true, // 46: sort/insertion.js assigns an undeclared global i
+};
