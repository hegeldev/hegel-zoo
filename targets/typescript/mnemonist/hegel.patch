diff --git a/hegel/hegel-zoo.mjs b/hegel/hegel-zoo.mjs
new file mode 100644
index 0000000..1ca6f10
--- /dev/null
+++ b/hegel/hegel-zoo.mjs
@@ -0,0 +1,163 @@
+// Hegel zoo: the small harness shared by the zoo's TypeScript/JavaScript targets.
+//
+// `property(name, body)` registers a node:test test that runs `body(tc)` under Hegel with
+// HEGEL_TEST_CASES cases (default 100) and the database at HEGEL_DATABASE. With ZOO_COLLECT=1
+// a `fail()` records the mismatch instead of failing, the case ends there, and the counts of
+// mismatches and of the shapes seen (`count(key)`) are printed at the end of the test, so a
+// property can be run over many cases to see every shape at once. `pin(name, body)` is a
+// plain test for one pinned bug: it must fail while the bug is present and pass once it is
+// fixed (the zoo's judge reads an unexpected pass as "fixed upstream?").
+
+import { readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+import { test as nodeTest } from "node:test";
+
+// The Hegel version these tests were written against (the zoo pins it in zoo.toml; upstream
+// would add it to devDependencies). Hegel and esbuild are installed with `npm install --prefix
+// .hegel` so the target's own package.json and lock file stay untouched. Checked at load time so
+// a stray install cannot silently change the engine.
+export const HEGEL_PIN = { "@hegeldev/hegel": "0.4.5" };
+
+const hegelDir = join(dirname(fileURLToPath(import.meta.url)), "..", ".hegel", "node_modules", "@hegeldev", "hegel");
+{
+  const installed = JSON.parse(readFileSync(join(hegelDir, "package.json"), "utf8")).version;
+  if (installed !== HEGEL_PIN["@hegeldev/hegel"]) {
+    throw new Error(`@hegeldev/hegel ${installed} is installed; these tests pin ${HEGEL_PIN["@hegeldev/hegel"]}`);
+  }
+}
+const hegel = await import(pathToFileURL(join(hegelDir, "dist", "index.js")));
+const gs = await import(pathToFileURL(join(hegelDir, "dist", "generators", "index.js")));
+
+export const collecting = !!process.env.ZOO_COLLECT;
+
+class Collected extends Error {}
+
+let msgs = [];
+let stats = new Map();
+
+/** Report a mismatch: an error normally, a recorded line in collect mode. */
+export function fail(message) {
+  if (collecting) {
+    msgs.push(message);
+    throw new Collected(message);
+  }
+  throw new Error(message);
+}
+
+/** Bump a statistic (the shape of a pinned bug, a generator branch). */
+export function count(key) {
+  stats.set(key, (stats.get(key) || 0) + 1);
+}
+
+function settings() {
+  const s = { testCases: Number(process.env.HEGEL_TEST_CASES) || 100 };
+  if (process.env.HEGEL_DATABASE) {
+    s.database = hegel.Database.fromPath(process.env.HEGEL_DATABASE);
+  }
+  return s;
+}
+
+/** A property: `body(tc)` runs under Hegel; a thrown error (or `fail`) is a failure. */
+export function property(name, body) {
+  nodeTest(name, () => {
+    msgs = [];
+    stats = new Map();
+    hegel.test((tc) => {
+      try {
+        body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** An async property: `body(tc)` may await; runs under Hegel's testAsync with the same settings. */
+export function propertyAsync(name, body) {
+  nodeTest(name, async () => {
+    msgs = [];
+    stats = new Map();
+    await hegel.testAsync(async (tc) => {
+      try {
+        await body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** A pin: a plain test for one recorded bug. */
+export function pin(name, body) {
+  nodeTest(name, body);
+}
+
+/** An integer in [lo, hi]. */
+export function n(tc, lo, hi) {
+  return tc.draw(gs.integers({ minValue: lo, maxValue: hi }));
+}
+
+/** One of xs. */
+export function pick(tc, xs) {
+  return xs[n(tc, 0, xs.length - 1)];
+}
+
+/** True pct percent of the time. */
+export function chance(tc, pct) {
+  return n(tc, 0, 99) < pct;
+}
+
+/** A string of `len` characters drawn from `alphabet` (an array of strings). */
+export function word(tc, alphabet, lo, hi) {
+  const len = n(tc, lo, hi);
+  let s = "";
+  for (let i = 0; i < len; i++) {
+    s += pick(tc, alphabet);
+  }
+  return s;
+}
+
+/** Structural equality: arrays by position, objects by key set (prototype ignored), else ===. */
+export function same(a, b) {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) {
+      return false;
+    }
+    return a.every((x, i) => same(x, b[i]));
+  }
+  if (a !== null && b !== null && typeof a === "object" && typeof b === "object") {
+    const ka = Object.keys(a).sort();
+    const kb = Object.keys(b).sort();
+    if (ka.length !== kb.length || ka.some((k, i) => k !== kb[i])) {
+      return false;
+    }
+    return ka.every((k) => same(a[k], b[k]));
+  }
+  return a === b;
+}
+
+/** A compact, unambiguous rendering for messages. */
+export function show(x) {
+  return JSON.stringify(x, (k, v) => (v === undefined ? "<undefined>" : v));
+}
diff --git a/hegel/hegel.test.mjs b/hegel/hegel.test.mjs
new file mode 100644
index 0000000..0aaa504
--- /dev/null
+++ b/hegel/hegel.test.mjs
@@ -0,0 +1,833 @@
+// mnemonist against naive models: every structure is driven by a random sequence of operations
+// and compared, after each step, with the obvious implementation of the same abstract type on a
+// plain array, Map or Set (a sorted array for the heaps, brute force for the spatial and metric
+// indices, the mathematical definitions for the set algebra). Queries answered by a search
+// (k nearest neighbours, intervals containing a point, strings within an edit distance) are
+// compared with the exhaustive scan of the same items.
+
+import assert from "node:assert/strict";
+import { createRequire } from "node:module";
+import { property, pin, count, fail, n, pick, chance, word, show, same } from "./hegel-zoo.mjs";
+
+const require = createRequire(import.meta.url);
+const M = require("../index.js");
+
+import { Known } from "./known.mjs";
+import "./structures.mjs";
+import "./indices.mjs";
+import "./pins.mjs";
+
+// ---------------------------------------------------------------- helpers
+
+const cmpNum = (a, b) => a - b;
+
+function sortedNums(xs) {
+  return [...xs].sort(cmpNum);
+}
+
+function ints(tc, len, lo, hi) {
+  const out = [];
+  for (let i = 0; i < len; i++) out.push(n(tc, lo, hi));
+  return out;
+}
+
+function expectEqual(what, actual, expected, ctx) {
+  if (!same(actual, expected)) {
+    fail(`${what}: got ${show(actual)}, expected ${show(expected)}\n  ${ctx()}`);
+  }
+}
+
+// ---------------------------------------------------------------- heaps
+
+// Heap, MinHeap and MaxHeap against a sorted array; the static helpers on a raw array too.
+property("TestHegelHeapsAgreeWithASortedArray", (tc) => {
+  const kind = pick(tc, ["Heap", "MinHeap", "MaxHeap", "custom"]);
+  let heap;
+  let order; // comparator that the model sorts by (ascending = pop order)
+  if (kind === "Heap") {
+    heap = new M.Heap();
+    order = (a, b) => (a < b ? -1 : a > b ? 1 : 0);
+  } else if (kind === "MinHeap") {
+    heap = new M.MinHeap(cmpNum);
+    order = cmpNum;
+  } else if (kind === "MaxHeap") {
+    heap = new M.MaxHeap(cmpNum);
+    order = (a, b) => b - a;
+  } else {
+    // pairs ordered by the first component: ties are legal, the model uses a stable multiset.
+    heap = new M.Heap((a, b) => a[0] - b[0]);
+    order = (a, b) => a[0] - b[0];
+  }
+  const model = [];
+  const log = [];
+  const item = () => (kind === "custom" ? [n(tc, 0, 5), n(tc, 0, 99)] : n(tc, -20, 20));
+  const key = (x) => (kind === "custom" && x !== undefined ? x[0] : x);
+  const steps = n(tc, 0, 40);
+  for (let i = 0; i < steps; i++) {
+    const op = pick(tc, ["push", "push", "pop", "peek", "replace", "pushpop", "toArray", "size"]);
+    if (op === "push") {
+      const x = item();
+      log.push(`push ${show(x)}`);
+      const r = heap.push(x);
+      model.push(x);
+      model.sort(order);
+      if (r !== model.length) fail(`push returned ${r}, size is ${model.length}; ops ${log.join(", ")}`);
+    } else if (op === "pop") {
+      log.push("pop");
+      const r = heap.pop();
+      const e = model.shift();
+      if (key(r) !== key(e) && !(r === undefined && e === undefined)) {
+        fail(`${kind}.pop gave ${show(r)}, expected ${show(e)}; ops ${log.join(", ")}`);
+      }
+    } else if (op === "peek") {
+      const r = heap.peek();
+      const e = model[0];
+      if (key(r) !== key(e) && !(r === undefined && e === undefined)) {
+        fail(`${kind}.peek gave ${show(r)}, expected ${show(e)}; ops ${log.join(", ")}`);
+      }
+    } else if (op === "replace") {
+      const x = item();
+      log.push(`replace ${show(x)}`);
+      if (model.length === 0) {
+        let threw = false;
+        try {
+          heap.replace(x);
+        } catch (e) {
+          threw = true;
+        }
+        if (!threw) fail(`replace on an empty heap did not throw; ops ${log.join(", ")}`);
+        // the failed replace must not have changed the heap
+        continue;
+      }
+      const r = heap.replace(x);
+      const e = model.shift();
+      model.push(x);
+      model.sort(order);
+      if (key(r) !== key(e)) fail(`${kind}.replace gave ${show(r)}, expected ${show(e)}; ops ${log.join(", ")}`);
+    } else if (op === "pushpop") {
+      const x = item();
+      log.push(`pushpop ${show(x)}`);
+      const r = heap.pushpop(x);
+      model.push(x);
+      model.sort(order);
+      const e = model.shift();
+      if (key(r) !== key(e)) fail(`${kind}.pushpop gave ${show(r)}, expected ${show(e)}; ops ${log.join(", ")}`);
+    } else if (op === "toArray") {
+      const r = heap.toArray().map(key);
+      const e = model.map(key);
+      // toArray is documented as the sorted array (it consumes a copy)
+      expectEqual(`${kind}.toArray`, r, e, () => `ops ${log.join(", ")}`);
+    } else if (heap.size !== model.length) {
+      fail(`${kind}.size is ${heap.size}, expected ${model.length}; ops ${log.join(", ")}`);
+    }
+  }
+  const consumed = heap.consume().map(key);
+  expectEqual(`${kind}.consume`, consumed, model.map(key), () => `ops ${log.join(", ")}`);
+  if (heap.size !== 0) fail(`${kind}.size after consume is ${heap.size}`);
+});
+
+property("TestHegelHeapHelpersOnArraysMatchSorting", (tc) => {
+  const xs = ints(tc, n(tc, 0, 12), -9, 9);
+  const arr = [...xs];
+  M.Heap.heapify(cmpNum, arr);
+  const popped = [];
+  while (arr.length) popped.push(M.Heap.pop(cmpNum, arr));
+  expectEqual("heapify+pop", popped, sortedNums(xs), () => `xs ${show(xs)}`);
+
+  const arr2 = [];
+  for (const x of xs) M.Heap.push(cmpNum, arr2, x);
+  expectEqual("push+consume", M.Heap.consume(cmpNum, arr2), sortedNums(xs), () => `xs ${show(xs)}`);
+
+  const k = n(tc, 0, xs.length + 2);
+  const small = sortedNums(xs).slice(0, k);
+  const large = sortedNums(xs).reverse().slice(0, k);
+  const picks = [
+    ["nsmallest", M.Heap.nsmallest(cmpNum, k, xs), small],
+    ["nsmallest (default cmp)", M.Heap.nsmallest(k, xs), small],
+    ["nlargest", M.Heap.nlargest(cmpNum, k, xs), large],
+    ["nlargest (default cmp)", M.Heap.nlargest(k, xs), large],
+  ];
+  for (const [what, got, want] of picks) {
+    if (!same(got, want) && Known.nsmallestOneOnEmpty && k === 1 && xs.length === 0) {
+      count("known mnemonist/1");
+    } else {
+      expectEqual(what, got, want, () => `k ${k} xs ${show(xs)}`);
+    }
+  }
+
+  const h = M.Heap.from(xs, cmpNum);
+  if (h.size !== xs.length) fail(`Heap.from size ${h.size}, expected ${xs.length}`);
+  expectEqual("Heap.from.toArray", h.toArray(), sortedNums(xs), () => `xs ${show(xs)}`);
+});
+
+// FixedReverseHeap keeps the `capacity` smallest (or largest) items seen.
+property("TestHegelFixedReverseHeapKeepsTheBest", (tc) => {
+  const capacity = n(tc, 1, 6);
+  const max = chance(tc, 50);
+  const cmp = max ? (a, b) => b - a : cmpNum;
+  const h = new M.FixedReverseHeap(Array, cmp, capacity);
+  const seen = [];
+  const steps = n(tc, 0, 20);
+  for (let i = 0; i < steps; i++) {
+    const x = n(tc, -9, 9);
+    h.push(x);
+    seen.push(x);
+    seen.sort(cmp);
+    if (seen.length > capacity) seen.length = capacity;
+    if (h.size !== seen.length) fail(`FixedReverseHeap.size ${h.size}, expected ${seen.length}; seen ${show(seen)}`);
+    if (chance(tc, 30)) {
+      expectEqual("FixedReverseHeap.toArray", h.toArray(), seen, () => `capacity ${capacity} ${max ? "max" : "min"} after ${i + 1} pushes`);
+    }
+  }
+  expectEqual("FixedReverseHeap.consume", h.consume(), seen, () => `capacity ${capacity} ${max ? "max" : "min"}`);
+  if (h.size !== 0) fail(`FixedReverseHeap.size after consume ${h.size}`);
+});
+
+// ---------------------------------------------------------------- sequences
+
+// FixedDeque (throws when full), CircularBuffer (overwrites the other end when full), Queue,
+// Stack, FixedStack and LinkedList against an array.
+property("TestHegelSequencesAgreeWithAnArray", (tc) => {
+  const kind = pick(tc, ["FixedDeque", "CircularBuffer", "Queue", "Stack", "FixedStack", "LinkedList"]);
+  const capacity = n(tc, 1, 5);
+  const typed = chance(tc, 30);
+  const ArrayClass = typed ? Int8Array : Array;
+  let s;
+  if (kind === "FixedDeque") s = new M.FixedDeque(ArrayClass, capacity);
+  else if (kind === "CircularBuffer") s = new M.CircularBuffer(ArrayClass, capacity);
+  else if (kind === "FixedStack") s = new M.FixedStack(ArrayClass, capacity);
+  else s = new M[kind]();
+  const fixed = kind === "FixedDeque" || kind === "FixedStack";
+  const model = []; // front .. back
+  const log = [];
+  const ctx = () => `${kind}${fixed || kind === "CircularBuffer" ? `(${typed ? "Int8Array" : "Array"}, ${capacity})` : ""}: ${log.join(", ")}`;
+  const ops = {
+    FixedDeque: ["push", "push", "unshift", "pop", "shift", "peekFirst", "peekLast", "get", "toArray", "iterate"],
+    CircularBuffer: ["push", "push", "unshift", "pop", "shift", "peekFirst", "peekLast", "get", "toArray", "iterate"],
+    Queue: ["enqueue", "enqueue", "dequeue", "peek", "toArray", "iterate"],
+    Stack: ["push", "push", "pop", "peek", "toArray", "iterate"],
+    FixedStack: ["push", "push", "pop", "peek", "toArray", "iterate"],
+    LinkedList: ["push", "push", "unshift", "shift", "first", "last", "peek", "toArray", "iterate"],
+  }[kind];
+  const steps = n(tc, 0, 30);
+  for (let i = 0; i < steps; i++) {
+    const op = pick(tc, ops);
+    const x = n(tc, -100, 100);
+    if (op === "push" || op === "enqueue" || op === "unshift") {
+      log.push(`${op} ${x}`);
+      const full = model.length === capacity;
+      if (fixed && full) {
+        let threw = false;
+        try {
+          s[op](x);
+        } catch (e) {
+          threw = true;
+        }
+        if (!threw) fail(`${op} on a full ${kind} did not throw; ${ctx()}`);
+        continue;
+      }
+      const r = s[op](x);
+      if (op === "unshift") model.unshift(x);
+      else model.push(x);
+      if (kind === "CircularBuffer" && model.length > capacity) {
+        if (op === "unshift") model.pop();
+        else model.shift();
+      }
+      if (r !== model.length) fail(`${op} returned ${r}, size is ${model.length}; ${ctx()}`);
+    } else if (op === "pop" || op === "shift" || op === "dequeue") {
+      log.push(op);
+      const r = s[op]();
+      let e;
+      if (op === "pop") e = kind === "Stack" || kind === "FixedStack" ? model.pop() : model.pop();
+      else e = model.shift();
+      if (r !== e) fail(`${kind}.${op} gave ${show(r)}, expected ${show(e)}; ${ctx()}`);
+    } else if (op === "peekFirst" || op === "first") {
+      const r = s[op]();
+      if (r !== model[0]) fail(`${kind}.${op} gave ${show(r)}, expected ${show(model[0])}; ${ctx()}`);
+    } else if (op === "peekLast" || op === "last") {
+      const r = s[op]();
+      const e = model[model.length - 1];
+      if (r !== e) {
+        if (Known.linkedListStaleTail && kind === "LinkedList" && model.length === 0 && log.includes("shift")) count("known mnemonist/23");
+        else fail(`${kind}.${op} gave ${show(r)}, expected ${show(e)}; ${ctx()}`);
+      }
+    } else if (op === "peek") {
+      const r = s.peek();
+      // Queue/LinkedList peek the front, Stack the top.
+      const e = kind === "Stack" || kind === "FixedStack" ? model[model.length - 1] : model[0];
+      if (r !== e) fail(`${kind}.peek gave ${show(r)}, expected ${show(e)}; ${ctx()}`);
+    } else if (op === "get") {
+      const idx = n(tc, -1, capacity);
+      const r = s.get(idx);
+      const e = idx >= 0 && idx < model.length ? model[idx] : undefined;
+      if (r !== e) {
+        if (Known.dequeGetIgnoresSize && (idx < 0 || idx >= model.length)) count("known mnemonist/4");
+        else fail(`${kind}.get(${idx}) gave ${show(r)}, expected ${show(e)}; ${ctx()}`);
+      }
+    } else if (op === "toArray") {
+      const r = Array.from(s.toArray());
+      // Stacks list from the top; the deques and lists from the front.
+      const e = kind === "Stack" || kind === "FixedStack" ? [...model].reverse() : model;
+      expectEqual(`${kind}.toArray`, r, e, ctx);
+    } else {
+      const r = [...s];
+      const e = kind === "Stack" || kind === "FixedStack" ? [...model].reverse() : model;
+      expectEqual(`${kind} iteration`, r, e, ctx);
+      const ent = [...s.entries()];
+      expectEqual(`${kind}.entries`, ent, e.map((v, i) => [i, v]), ctx);
+      const fe = [];
+      s.forEach((v, i) => fe.push([i, v]));
+      const efe = e.map((v, i) => [i, v]);
+      if (!same(fe, efe) && Known.fixedStackForEachVisitsCapacity && kind === "FixedStack" && model.length < capacity) {
+        count("known mnemonist/3");
+      } else {
+        expectEqual(`${kind}.forEach`, fe, efe, ctx);
+      }
+    }
+    if (s.size !== model.length) fail(`${kind}.size is ${s.size}, expected ${model.length}; ${ctx()}`);
+  }
+  // from() rebuilds the same sequence
+  const arr = kind === "Stack" || kind === "FixedStack" ? [...model].reverse() : [...model];
+  // from() guesses the capacity from the iterable's length; a capacity must be positive, so the
+  // empty sequence gets one explicitly.
+  const built = fixed || kind === "CircularBuffer" ? M[kind].from(model, ArrayClass, Math.max(1, model.length)) : M[kind].from(model);
+  expectEqual(`${kind}.from(...).toArray`, Array.from(built.toArray()), arr, ctx);
+  if (built.size !== model.length) fail(`${kind}.from size ${built.size}, expected ${model.length}; ${ctx()}`);
+});
+
+// ---------------------------------------------------------------- sets and maps
+
+property("TestHegelSetHelpersMatchTheDefinitions", (tc) => {
+  const mk = () => new Set(ints(tc, n(tc, 0, 6), 0, 7));
+  const a = mk();
+  const b = mk();
+  const c = mk();
+  const A = [...a];
+  const B = [...b];
+  const ctx = () => `a ${show(A)} b ${show(B)} c ${show([...c])}`;
+  const S = M.set;
+  expectEqual("intersection", sortedNums(S.intersection(a, b)), sortedNums(A.filter((x) => b.has(x))), ctx);
+  expectEqual("intersection3", sortedNums(S.intersection(a, b, c)), sortedNums(A.filter((x) => b.has(x) && c.has(x))), ctx);
+  expectEqual("union", sortedNums(S.union(a, b)), sortedNums(new Set([...A, ...B])), ctx);
+  expectEqual("union3", sortedNums(S.union(a, b, c)), sortedNums(new Set([...A, ...B, ...c])), ctx);
+  expectEqual("difference", sortedNums(S.difference(a, b)), sortedNums(A.filter((x) => !b.has(x))), ctx);
+  expectEqual("symmetricDifference", sortedNums(S.symmetricDifference(a, b)), sortedNums([...A.filter((x) => !b.has(x)), ...B.filter((x) => !a.has(x))]), ctx);
+  expectEqual("isSubset", S.isSubset(a, b), A.every((x) => b.has(x)), ctx);
+  expectEqual("isSuperset", S.isSuperset(a, b), B.every((x) => a.has(x)), ctx);
+  const inter = A.filter((x) => b.has(x)).length;
+  const uni = new Set([...A, ...B]).size;
+  expectEqual("intersectionSize", S.intersectionSize(a, b), inter, ctx);
+  expectEqual("unionSize", S.unionSize(a, b), uni, ctx);
+  const jac = uni === 0 ? 0 : inter / uni;
+  if (Math.abs(S.jaccard(a, b) - jac) > 1e-12 && !(Number.isNaN(S.jaccard(a, b)) && uni === 0)) {
+    fail(`jaccard ${S.jaccard(a, b)}, expected ${jac}; ${ctx()}`);
+  }
+  const ov = Math.min(a.size, b.size) === 0 ? 0 : inter / Math.min(a.size, b.size);
+  if (Math.abs(S.overlap(a, b) - ov) > 1e-12 && !(Number.isNaN(S.overlap(a, b)) && Math.min(a.size, b.size) === 0)) {
+    fail(`overlap ${S.overlap(a, b)}, expected ${ov}; ${ctx()}`);
+  }
+  // in-place variants
+  let t = new Set(a);
+  S.add(t, b);
+  expectEqual("add", sortedNums(t), sortedNums(new Set([...A, ...B])), ctx);
+  t = new Set(a);
+  S.subtract(t, b);
+  expectEqual("subtract", sortedNums(t), sortedNums(A.filter((x) => !b.has(x))), ctx);
+  t = new Set(a);
+  S.intersect(t, b);
+  expectEqual("intersect", sortedNums(t), sortedNums(A.filter((x) => b.has(x))), ctx);
+  t = new Set(a);
+  S.disjunct(t, b);
+  expectEqual("disjunct", sortedNums(t), sortedNums([...A.filter((x) => !b.has(x)), ...B.filter((x) => !a.has(x))]), ctx);
+});
