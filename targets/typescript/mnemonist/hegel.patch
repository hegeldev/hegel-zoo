+/** Levenshtein distance. */
+function levenshtein(a, b) {
+  const m = a.length;
+  const k = b.length;
+  let prev = Array.from({ length: k + 1 }, (_, j) => j);
+  for (let i = 1; i <= m; i++) {
+    const cur = [i];
+    for (let j = 1; j <= k; j++) {
+      cur[j] = Math.min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + (a[i - 1] === b[j - 1] ? 0 : 1));
+    }
+    prev = cur;
+  }
+  return prev[k];
+}
+
+/** The unrestricted Damerau-Levenshtein distance (transpositions may be edited between), SymSpell's metric. */
+function damerau(a, b) {
+  const m = a.length;
+  const k = b.length;
+  const inf = m + k;
+  const d = Array.from({ length: m + 2 }, () => new Array(k + 2).fill(0));
+  d[0][0] = inf;
+  for (let i = 0; i <= m; i++) {
+    d[i + 1][0] = inf;
+    d[i + 1][1] = i;
+  }
+  for (let j = 0; j <= k; j++) {
+    d[0][j + 1] = inf;
+    d[1][j + 1] = j;
+  }
+  const da = new Map();
+  for (let i = 1; i <= m; i++) {
+    let db = 0;
+    for (let j = 1; j <= k; j++) {
+      const i1 = da.get(b[j - 1]) || 0;
+      const j1 = db;
+      const cost = a[i - 1] === b[j - 1] ? 0 : 1;
+      if (cost === 0) db = j;
+      d[i + 1][j + 1] = Math.min(d[i][j] + cost, d[i + 1][j] + 1, d[i][j + 1] + 1, d[i1][j1] + (i - i1 - 1) + 1 + (j - j1 - 1));
+    }
+    da.set(a[i - 1], i);
+  }
+  return d[m + 1][k + 1];
