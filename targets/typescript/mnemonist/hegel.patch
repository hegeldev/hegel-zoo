+property("TestHegelMultiSetAgreesWithAMapOfCounts", (tc) => {
+  const ms = new M.MultiSet();
+  const model = new Map();
+  const log = [];
+  const total = () => [...model.values()].reduce((s, c) => s + c, 0);
+  // The shape of the last mutation, for the known-bug gates: once the structure has diverged from
+  // the model the case ends.
+  let shape = null;
+  const diverged = () => {
+    if (ms.size !== total() || ms.dimension !== model.size) return true;
+    for (const kk of ["a", "b", "c", "d"]) if (ms.multiplicity(kk) !== (model.get(kk) || 0)) return true;
+    return false;
+  };
+  const steps = n(tc, 0, 30);
+  for (let i = 0; i < steps; i++) {
+    const k = pick(tc, ["a", "b", "c", "d"]);
+    const op = pick(tc, ["add", "add", "addN", "set", "remove", "removeN", "delete", "edit", "query", "top"]);
+    shape = null;
+    if (op === "set" && model.has(k)) shape = Known.multiSetSetAdds ? "known mnemonist/5" : null;
+    if (op === "delete" && !model.has(k)) shape = Known.multiSetDeleteAbsent ? "known mnemonist/6" : null;
+    if (op === "edit") {
+      // decided below once the second key is drawn
+    }
+    if (op === "add") {
+      log.push(`add ${k}`);
+      ms.add(k);
+      model.set(k, (model.get(k) || 0) + 1);
+    } else if (op === "addN") {
+      const c = n(tc, 0, 3);
+      log.push(`add ${k} ${c}`);
+      ms.add(k, c);
+      if (c > 0) model.set(k, (model.get(k) || 0) + c);
+    } else if (op === "set") {
+      const c = n(tc, 0, 3);
+      log.push(`set ${k} ${c}`);
+      ms.set(k, c);
+      if (c > 0) model.set(k, c);
+      else model.delete(k);
+    } else if (op === "remove") {
+      log.push(`remove ${k}`);
+      ms.remove(k);
+      if (model.has(k)) {
+        if (model.get(k) === 1) model.delete(k);
+        else model.set(k, model.get(k) - 1);
+      }
+    } else if (op === "removeN") {
+      const c = n(tc, 0, 3);
+      log.push(`remove ${k} ${c}`);
+      ms.remove(k, c);
+      if (model.has(k)) {
+        if (model.get(k) <= c) model.delete(k);
+        else model.set(k, model.get(k) - c);
+      }
+    } else if (op === "delete") {
+      log.push(`delete ${k}`);
+      const r = ms.delete(k);
+      const e = model.delete(k);
+      if (r !== e) {
+        if (shape) {
+          count(shape);
+          return;
+        }
+        fail(`MultiSet.delete(${k}) returned ${r}, expected ${e}; ops ${log.join(", ")}`);
+      }
+    } else if (op === "edit") {
+      const k2 = pick(tc, ["a", "b", "c", "d"]);
+      log.push(`edit ${k} ${k2}`);
+      if (model.has(k) && k === k2 && Known.multiSetEditSelfDeletes) shape = "known mnemonist/8";
+      else if (model.has(k) && model.has(k2) && Known.multiSetEditKeepsDimension) shape = "known mnemonist/7";
+      ms.edit(k, k2);
+      if (model.has(k) && k !== k2) {
+        model.set(k2, (model.get(k2) || 0) + model.get(k));
+        model.delete(k);
+      }
+    } else if (op === "top") {
+      const t = n(tc, 1, 5); // top(0) throws by contract
+      const r = ms.top(t);
+      const e = [...model.entries()].sort((x, y) => y[1] - x[1]).slice(0, t);
+      // ties in count may come in any order: compare counts and the multiset of keys per count
+      const norm = (xs) => xs.map(([kk, c]) => `${c}:${kk}`).sort();
+      const okCounts = same(r.map((x) => x[1]), e.map((x) => x[1]));
+      const okKeys = r.every(([kk, c]) => model.get(kk) === c);
+      if (!okCounts || !okKeys || r.length !== e.length) {
+        fail(`MultiSet.top(${t}) gave ${show(r)}, expected counts ${show(norm(e))}; ops ${log.join(", ")}`);
+      }
+    } else {
+      for (const kk of ["a", "b", "c", "d"]) {
+        const c = model.get(kk) || 0;
+        if (ms.multiplicity(kk) !== c) fail(`multiplicity(${kk}) ${ms.multiplicity(kk)}, expected ${c}; ops ${log.join(", ")}`);
+        if (ms.get(kk) !== c) fail(`get(${kk}) ${ms.get(kk)}, expected ${c}; ops ${log.join(", ")}`);
+        if (ms.has(kk) !== c > 0) fail(`has(${kk}) ${ms.has(kk)}, expected ${c > 0}; ops ${log.join(", ")}`);
+        const tot = total();
+        const f = tot === 0 ? 0 : c / tot;
+        if (Math.abs(ms.frequency(kk) - f) > 1e-12) fail(`frequency(${kk}) ${ms.frequency(kk)}, expected ${f}; ops ${log.join(", ")}`);
+      }
+    }
+    if (diverged()) {
+      if (shape) {
+        count(shape);
+        return;
+      }
+      if (ms.size !== total()) fail(`MultiSet.size ${ms.size}, expected ${total()}; ops ${log.join(", ")}`);
+      if (ms.dimension !== model.size) fail(`MultiSet.dimension ${ms.dimension}, expected ${model.size}; ops ${log.join(", ")}`);
+      for (const kk of ["a", "b", "c", "d"]) {
+        if (ms.multiplicity(kk) !== (model.get(kk) || 0)) fail(`multiplicity(${kk}) ${ms.multiplicity(kk)}, expected ${model.get(kk) || 0}; ops ${log.join(", ")}`);
+      }
+    }
+  }
+  // iteration: values() lists each key multiplicity times; multiplicities() lists pairs
+  const vals = [...ms].sort();
+  const evals = [];
+  for (const [k, c] of model) for (let i = 0; i < c; i++) evals.push(k);
+  expectEqual("MultiSet iteration", vals, evals.sort(), () => `ops ${log.join(", ")}`);
+  const mult = [...ms.multiplicities()].sort();
+  expectEqual("MultiSet.multiplicities", mult, [...model.entries()].sort(), () => `ops ${log.join(", ")}`);
+  const fe = [];
+  ms.forEachMultiplicity((c, k) => fe.push([k, c]));
+  expectEqual("MultiSet.forEachMultiplicity", fe.sort(), [...model.entries()].sort(), () => `ops ${log.join(", ")}`);
+  // subset relation against another multiset
+  const other = M.MultiSet.from(word(tc, ["a", "b", "c"], 0, 6).split("").filter((x) => x));
+  const otherCounts = new Map();
+  for (const x of other) otherCounts.set(x, (otherCounts.get(x) || 0) + 1);
+  const sub = [...model].every(([k, c]) => (otherCounts.get(k) || 0) >= c);
+  const sup = [...otherCounts].every(([k, c]) => (model.get(k) || 0) >= c);
+  expectEqual("MultiSet.isSubset", M.MultiSet.isSubset(ms, other), sub, () => `ops ${log.join(", ")}; other ${show([...other])}`);
+  expectEqual("MultiSet.isSuperset", M.MultiSet.isSuperset(ms, other), sup, () => `ops ${log.join(", ")}; other ${show([...other])}`);
+});
