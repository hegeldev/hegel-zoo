+const LRU_KINDS = ["LRUCache", "LRUMap", "LRUCacheWithDelete", "LRUMapWithDelete"];
+const LRU_KEYS = [1, 2, 3, 4, 5, 6];
+/** The LRU case: its kind, a capacity, typed key and value arrays 30% of the time, and up to 25 operations - the reads (has, peek, get, iterate) first, then set (twice the weight), setpop and, on the WithDelete kinds, delete and remove. */
+const lruCase = gs.record({ kind: pick(LRU_KINDS), capacity: ints(1, 4), typed: chance(30) }).flatMap((c) => {
+  const k = pick(LRU_KEYS);
+  const v = ints(0, 200);
+  const withDelete = c.kind.endsWith("WithDelete");
+  return gs.record({
+    ...keep(c),
+    ops: ops(
+      25,
+      [1, op("has", { k })],
+      [1, op("peek", { k })],
+      [1, op("get", { k })],
+      [1, op("iterate")],
+      [2, op("set", { k, v })],
+      [1, op("setpop", { k, v })],
+      ...(withDelete ? [[1, op("delete", { k })], [1, op("remove", { k })]] : []),
+    ),
+  });
+});
