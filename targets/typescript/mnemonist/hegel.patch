+property("TestHegelBitSetAndSparseSetAgreeWithABooleanArray", (tc) => {
+  const { length, ops: steps } = tc.draw(bitSetCase);
+  const bs = new M.BitSet(length);
+  const ss = new M.SparseSet(length);
+  const bits = new Array(length).fill(0);
+  const log = [];
+  const ctx = () => `length ${length}; ops ${log.join(", ")}`;
+  for (const step of steps) {
+    const { op: name, idx } = step;
+    if (name === "set") {
+      log.push(`set ${idx}`);
+      bs.set(idx);
+      ss.add(idx);
+      bits[idx] = 1;
+    } else if (name === "reset") {
+      // recorded shape (mnemonist/9): a reset of a clear bit whose word has bit 31 set decrements
+      // the size, which stays wrong from there on - skipped
+      if (Known.resetSizeWithBit31 && bits[idx] === 0 && bits[(idx & ~31) + 31] === 1) {
+        count("known mnemonist/9");
+        continue;
+      }
+      log.push(`reset ${idx}`);
+      bs.reset(idx);
+      const r = ss.delete(idx);
+      if (r !== (bits[idx] === 1)) fail(`SparseSet.delete(${idx}) returned ${r}; ${ctx()}`);
+      bits[idx] = 0;
+      const size = bits.reduce((s, b) => s + b, 0);
+      if (bs.size !== size) fail(`BitSet.size ${bs.size} after reset, expected ${size}; ${ctx()}`);
+    } else if (name === "flip") {
+      log.push(`flip ${idx}`);
+      bs.flip(idx);
+      bits[idx] ^= 1;
+      if (bits[idx]) ss.add(idx);
+      else ss.delete(idx);
+    } else {
+      const setBits = [];
+      bits.forEach((b, j) => b && setBits.push(j));
+      for (let j = 0; j < length; j++) {
+        if (bs.get(j) !== bits[j]) fail(`BitSet.get(${j}) ${bs.get(j)}, expected ${bits[j]}; ${ctx()}`);
+        if (bs.test(j) !== (bits[j] === 1)) fail(`BitSet.test(${j}) ${bs.test(j)}; ${ctx()}`);
+        if (ss.has(j) !== (bits[j] === 1)) fail(`SparseSet.has(${j}) ${ss.has(j)}; ${ctx()}`);
+      }
+      // rank(i): number of ones before index i; select(r): index of the r-th one (1-based), -1 if none
+      const r = step.r;
+      const rank = bits.slice(0, r).reduce((s, b) => s + b, 0);
+      if (bs.rank(r) !== rank) fail(`BitSet.rank(${r}) ${bs.rank(r)}, expected ${rank}; ${ctx()}`);
+      // the rank to select, modulo the count of ones (plus one for the rank past the last one,
+      // which select answers -1 - while mnemonist/10 stands, only the ranks of existing ones)
+      const ranks = setBits.length + (Known.selectBoundedByLength ? 0 : 1);
+      if (ranks > 0) {
+        const k = 1 + (step.k % ranks);
+        const sel = k <= setBits.length ? setBits[k - 1] : -1;
+        if (bs.select(k) !== sel) {
+          // a whole 32-bit word of zeros before the target bit
+          let zeroWord = false;
+          for (let w = 0; sel >= 0 && (w + 1) * 32 <= sel; w++) {
+            if (bits.slice(w * 32, w * 32 + 32).every((b) => b === 0)) zeroWord = true;
+          }
+          if (Known.selectSkipsZeroWords && zeroWord) {
+            count("known mnemonist/2");
+          } else if (Known.selectBoundedByLength && (k >= length || k > setBits.length)) {
+            count("known mnemonist/10");
+          } else {
