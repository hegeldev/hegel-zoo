+property("TestHegelBiMapAndMultiMapAgreeWithMaps", (tc) => {
+  // BiMap: a bijection; setting an existing value under a new key moves it.
+  const bm = new M.BiMap();
+  const fwd = new Map();
+  const log = [];
+  const steps = n(tc, 0, 20);
+  for (let i = 0; i < steps; i++) {
+    const k = n(tc, 0, 4);
+    const v = pick(tc, ["p", "q", "r", "s", "t"]);
+    const op = pick(tc, ["set", "set", "delete", "deleteInverse"]);
+    if (op === "set") {
+      log.push(`set ${k} ${v}`);
+      bm.set(k, v);
+      for (const [kk, vv] of [...fwd]) if (vv === v) fwd.delete(kk);
+      fwd.set(k, v);
+    } else if (op === "delete") {
+      log.push(`delete ${k}`);
+      const r = bm.delete(k);
+      const e = fwd.delete(k);
+      if (r !== e) fail(`BiMap.delete(${k}) returned ${r}, expected ${e}; ops ${log.join(", ")}`);
+    } else {
+      log.push(`inverse.delete ${v}`);
+      const r = bm.inverse.delete(v);
+      let e = false;
+      for (const [kk, vv] of [...fwd]) if (vv === v) {
+        fwd.delete(kk);
+        e = true;
+      }
+      if (r !== e) fail(`BiMap.inverse.delete(${v}) returned ${r}, expected ${e}; ops ${log.join(", ")}`);
+    }
+    for (const kk of [0, 1, 2, 3, 4]) {
+      if (bm.get(kk) !== fwd.get(kk)) fail(`BiMap.get(${kk}) ${show(bm.get(kk))}, expected ${show(fwd.get(kk))}; ops ${log.join(", ")}`);
+      if (bm.has(kk) !== fwd.has(kk)) fail(`BiMap.has(${kk}) ${bm.has(kk)}; ops ${log.join(", ")}`);
+    }
+    const inv = new Map([...fwd].map(([kk, vv]) => [vv, kk]));
+    for (const vv of ["p", "q", "r", "s", "t"]) {
+      if (bm.inverse.get(vv) !== inv.get(vv)) fail(`BiMap.inverse.get(${vv}) ${show(bm.inverse.get(vv))}, expected ${show(inv.get(vv))}; ops ${log.join(", ")}`);
+      if (bm.inverse.has(vv) !== inv.has(vv)) fail(`BiMap.inverse.has(${vv}) ${bm.inverse.has(vv)}; ops ${log.join(", ")}`);
+    }
+    if (bm.size !== fwd.size) fail(`BiMap.size ${bm.size}, expected ${fwd.size}; ops ${log.join(", ")}`);
+    if (bm.inverse.size !== fwd.size) fail(`BiMap.inverse.size ${bm.inverse.size}, expected ${fwd.size}; ops ${log.join(", ")}`);
+  }
+  expectEqual("BiMap.entries", [...bm.entries()].sort(), [...fwd].sort(), () => `ops ${log.join(", ")}`);
+  expectEqual("BiMap.inverse.entries", [...bm.inverse.entries()].sort(), [...fwd].map(([k, v]) => [v, k]).sort(), () => `ops ${log.join(", ")}`);
+
+  // MultiMap with Array or Set containers.
+  const useSet = chance(tc, 50);
+  const mm = new M.MultiMap(useSet ? Set : Array);
+  const model = new Map(); // key -> array of values (in insertion order, deduplicated for Set)
+  const log2 = [];
+  const steps2 = n(tc, 0, 25);
+  for (let i = 0; i < steps2; i++) {
+    const k = pick(tc, ["x", "y", "z"]);
+    const v = n(tc, 0, 3);
+    const op = pick(tc, ["set", "set", "set", "remove", "delete"]);
+    if (op === "set") {
+      log2.push(`set ${k} ${v}`);
+      mm.set(k, v);
+      if (!model.has(k)) model.set(k, []);
+      const arr = model.get(k);
+      if (!useSet || !arr.includes(v)) arr.push(v);
+    } else if (op === "remove") {
+      log2.push(`remove ${k} ${v}`);
+      const r = mm.remove(k, v);
+      const arr = model.get(k);
+      let e = false;
+      if (arr) {
+        const idx = arr.indexOf(v);
+        if (idx >= 0) {
+          arr.splice(idx, 1);
+          e = true;
+        }
+        if (arr.length === 0) model.delete(k);
+      }
+      if (r !== e) fail(`MultiMap.remove(${k}, ${v}) returned ${r}, expected ${e}; ${useSet ? "Set" : "Array"}; ops ${log2.join(", ")}`);
+    } else {
+      log2.push(`delete ${k}`);
+      const r = mm.delete(k);
+      const e = model.delete(k);
+      if (r !== e) fail(`MultiMap.delete(${k}) returned ${r}, expected ${e}; ${useSet ? "Set" : "Array"}; ops ${log2.join(", ")}`);
+    }
+    const total = [...model.values()].reduce((s, a) => s + a.length, 0);
+    if (mm.size !== total) fail(`MultiMap.size ${mm.size}, expected ${total}; ${useSet ? "Set" : "Array"}; ops ${log2.join(", ")}`);
+    if (mm.dimension !== model.size) fail(`MultiMap.dimension ${mm.dimension}, expected ${model.size}; ${useSet ? "Set" : "Array"}; ops ${log2.join(", ")}`);
+    for (const kk of ["x", "y", "z"]) {
+      const c = mm.get(kk);
+      const arr = c === undefined ? undefined : Array.from(c);
+      expectEqual(`MultiMap.get(${kk})`, arr, model.get(kk), () => `${useSet ? "Set" : "Array"}; ops ${log2.join(", ")}`);
+      if (mm.has(kk) !== model.has(kk)) fail(`MultiMap.has(${kk}) ${mm.has(kk)}; ops ${log2.join(", ")}`);
+      if (mm.multiplicity(kk) !== (model.get(kk) || []).length) fail(`MultiMap.multiplicity(${kk}) ${mm.multiplicity(kk)}, expected ${(model.get(kk) || []).length}; ops ${log2.join(", ")}`);
+    }
+  }
+  const pairs = [];
+  for (const [k, arr] of model) for (const v of arr) pairs.push([k, v]);
+  expectEqual("MultiMap.entries", [...mm.entries()].sort(), pairs.sort(), () => `${useSet ? "Set" : "Array"}; ops ${log2.join(", ")}`);
+  expectEqual("MultiMap iteration", [...mm].sort(), pairs.sort(), () => `${useSet ? "Set" : "Array"}; ops ${log2.join(", ")}`);
+  expectEqual("MultiMap.keys", [...mm.keys()].sort(), [...model.keys()].sort(), () => `ops ${log2.join(", ")}`);
+  expectEqual("MultiMap.values", [...mm.values()].sort(), pairs.map((p) => p[1]).sort(), () => `ops ${log2.join(", ")}`);
