diff --git a/hegel/structures.mjs b/hegel/structures.mjs
new file mode 100644
index 0000000..3f433f2
--- /dev/null
+++ b/hegel/structures.mjs
@@ -0,0 +1,518 @@
+// The array-backed structures and the array utilities: sparse sets and maps, bit vectors,
+// vectors and hashed array trees, the Fibonacci heap, the sorted-array merges and binary
+// searches, the Bloom filter, DefaultMap and the typed-array helpers.
+
+import { createRequire } from "node:module";
+import { property, count, fail, n, pick, chance, word, show, same } from "./hegel-zoo.mjs";
+import { Known } from "./known.mjs";
+
+const require = createRequire(import.meta.url);
+const M = require("../index.js");
+const merge = require("../utils/merge.js");
+const bsearch = require("../utils/binary-search.js");
+const typed = require("../utils/typed-arrays.js");
+
+const cmpNum = (a, b) => a - b;
+const sortedNums = (xs) => [...xs].sort(cmpNum);
+const uniq = (xs) => [...new Set(xs)];
+
+function ints(tc, len, lo, hi) {
+  const out = [];
+  for (let i = 0; i < len; i++) out.push(n(tc, lo, hi));
+  return out;
+}
+
+function expectEqual(what, actual, expected, ctx) {
+  if (!same(actual, expected)) {
+    fail(`${what}: got ${show(actual)}, expected ${show(expected)}\n  ${ctx()}`);
+  }
+}
+
+// ---------------------------------------------------------------- sparse map and queue set
+
+property("TestHegelSparseMapAgreesWithAMap", (tc) => {
+  const length = pick(tc, [1, 2, 5, 10, 255, 256, 257]);
+  const typedVals = chance(tc, 30);
+  const sm = typedVals ? new M.SparseMap(Uint8Array, length) : new M.SparseMap(length);
+  const model = new Map();
+  const log = [];
+  const ctx = () => `SparseMap(${typedVals ? "Uint8Array, " : ""}${length}): ${log.join(", ")}`;
+  const steps = n(tc, 0, 25);
+  for (let i = 0; i < steps; i++) {
+    const k = n(tc, 0, length - 1);
+    const v = n(tc, 1, 200);
+    const op = pick(tc, ["set", "set", "delete", "query"]);
+    if (op === "set") {
+      log.push(`set ${k} ${v}`);
+      sm.set(k, v);
+      model.set(k, v);
+    } else if (op === "delete") {
+      log.push(`delete ${k}`);
+      const r = sm.delete(k);
+      const e = model.delete(k);
+      if (r !== e) fail(`SparseMap.delete(${k}) returned ${r}, expected ${e}; ${ctx()}`);
+    } else {
+      for (const [kk, vv] of model) {
+        if (sm.get(kk) !== vv) {
+          if (Known.sparseMapDeleteLosesValue && log.some((l) => l.startsWith("delete "))) {
+            count("known mnemonist/12");
+            return; // the values are shuffled from here on
+          }
+          fail(`SparseMap.get(${kk}) ${show(sm.get(kk))}, expected ${vv}; ${ctx()}`);
+        }
+      }
+      for (let kk = 0; kk < Math.min(length, 12); kk++) {
+        if (sm.has(kk) !== model.has(kk)) fail(`SparseMap.has(${kk}) ${sm.has(kk)}; ${ctx()}`);
+      }
+      const entries = [...sm.entries()].sort((a, b) => a[0] - b[0]);
+      const want = [...model].sort((a, b) => a[0] - b[0]);
+      if (!same(entries, want)) {
+        if (Known.sparseMapDeleteLosesValue && log.some((l) => l.startsWith("delete "))) {
+          count("known mnemonist/12");
+          return;
+        }
+        expectEqual("SparseMap.entries", entries, want, ctx);
+      }
+      expectEqual("SparseMap.keys", sortedNums(sm.keys()), sortedNums(model.keys()), ctx);
+    }
+    if (sm.size !== model.size) fail(`SparseMap.size ${sm.size}, expected ${model.size}; ${ctx()}`);
+  }
+});
+
+property("TestHegelSparseQueueSetIsAQueueWithoutDuplicates", (tc) => {
+  const capacity = pick(tc, [1, 2, 3, 8, 255, 256, 257]);
+  const q = new M.SparseQueueSet(capacity);
+  const model = []; // front .. back, distinct members
+  const log = [];
+  const ctx = () => `SparseQueueSet(${capacity}): ${log.join(", ")}`;
+  const steps = n(tc, 0, 30);
+  for (let i = 0; i < steps; i++) {
+    const op = pick(tc, ["enqueue", "enqueue", "dequeue", "query"]);
+    if (op === "enqueue") {
+      const m = n(tc, 0, capacity - 1);
+      log.push(`enqueue ${m}`);
+      q.enqueue(m);
+      if (!model.includes(m)) model.push(m);
+    } else if (op === "dequeue") {
+      log.push("dequeue");
+      const r = q.dequeue();
+      const e = model.shift();
+      if (r !== e) fail(`SparseQueueSet.dequeue gave ${show(r)}, expected ${show(e)}; ${ctx()}`);
+    } else {
+      for (const m of ints(tc, 4, 0, capacity - 1)) {
+        if (q.has(m) !== model.includes(m)) {
+          if (Known.sparseQueueSetSentinelOverflow && (capacity === 256 || capacity === 65536) && log.includes("dequeue")) {
+            count("known mnemonist/13");
+            return;
+          }
+          fail(`SparseQueueSet.has(${m}) ${q.has(m)}, expected ${model.includes(m)}; ${ctx()}`);
+        }
+      }
+      expectEqual("SparseQueueSet iteration", [...q], model, ctx);
+    }
+    if (q.size !== model.length) {
+      if (Known.sparseQueueSetSentinelOverflow && (capacity === 256 || capacity === 65536) && log.includes("dequeue")) {
+        count("known mnemonist/13");
+        return;
+      }
+      fail(`SparseQueueSet.size ${q.size}, expected ${model.length}; ${ctx()}`);
+    }
+  }
+});
+
+// ---------------------------------------------------------------- bit vector
+
+property("TestHegelBitVectorAgreesWithAnArrayOfBits", (tc) => {
+  const initial = n(tc, 0, 40);
+  const bv = new M.BitVector(initial);
+  const bits = new Array(initial).fill(0);
+  const log = [];
+  const ctx = () => `BitVector(${initial}): ${log.join(", ")}`;
+  const steps = n(tc, 0, 40);
+  for (let i = 0; i < steps; i++) {
+    const op = pick(tc, ["push", "push", "pop", "set", "reset", "flip", "grow", "query"]);
+    if (op === "push") {
+      const b = n(tc, 0, 1);
+      log.push(`push ${b}`);
+      const r = bv.push(b);
+      bits.push(b);
+      if (r !== bits.length) fail(`BitVector.push returned ${r}, expected ${bits.length}; ${ctx()}`);
+    } else if (op === "pop") {
+      log.push("pop");
+      const r = bv.pop();
+      const e = bits.pop();
+      if (r !== e) fail(`BitVector.pop gave ${show(r)}, expected ${show(e)}; ${ctx()}`);
+      if (bv.length !== bits.length) fail(`BitVector.length ${bv.length} after pop, expected ${bits.length}; ${ctx()}`);
+    } else if (op === "grow") {
+      const c = n(tc, 0, 70);
+      log.push(`grow ${c}`);
+      bv.grow(c);
+    } else if (op === "set" || op === "reset" || op === "flip") {
+      if (bits.length === 0) continue;
+      const idx = n(tc, 0, bits.length - 1);
+      log.push(`${op} ${idx}`);
+      const wasClear = bits[idx] === 0;
+      const bit31 = bits[(idx & ~31) + 31] === 1;
+      bv[op](idx);
+      if (op === "set") bits[idx] = 1;
+      else if (op === "reset") bits[idx] = 0;
+      else bits[idx] ^= 1;
+      const size = bits.reduce((s, b) => s + b, 0);
+      if (bv.size !== size) {
+        if (op === "reset" && Known.resetSizeWithBit31 && wasClear && bit31) {
+          count("known mnemonist/9");
+          return;
+        }
+        if (Known.bitVectorPopKeepsSize && log.includes("pop")) {
+          count("known mnemonist/14");
+          return;
+        }
+        fail(`BitVector.size ${bv.size} after ${op}, expected ${size}; ${ctx()}`);
+      }
+    } else {
+      for (let j = 0; j < bits.length; j++) {
+        if (bv.get(j) !== bits[j]) {
+          if (Known.bitVectorPopKeepsSize && log.includes("pop")) {
+            count("known mnemonist/14");
+            return;
+          }
+          fail(`BitVector.get(${j}) ${bv.get(j)}, expected ${bits[j]}; ${ctx()}`);
+        }
+      }
+      const setBits = [];
+      bits.forEach((b, j) => b && setBits.push(j));
+      const r = n(tc, 0, bits.length);
+      const rank = bits.slice(0, r).reduce((s, b) => s + b, 0);
+      if (bv.rank(r) !== rank) fail(`BitVector.rank(${r}) ${bv.rank(r)}, expected ${rank}; ${ctx()}`);
+      const vals = [...bv.values()];
+      if (!same(vals, bits)) {
+        if (Known.bitVectorIteratesCapacity && bv.capacity > bits.length) count("known mnemonist/15");
+        else expectEqual("BitVector.values", vals, bits, ctx);
+      }
+      if (setBits.length > 0) {
+        const k = n(tc, 1, setBits.length);
+        const sel = bv.select(k);
+        if (sel !== setBits[k - 1]) {
+          let zeroWord = false;
+          for (let w = 0; (w + 1) * 32 <= setBits[k - 1]; w++) {
+            if (bits.slice(w * 32, w * 32 + 32).every((b) => b === 0)) zeroWord = true;
+          }
+          if (Known.bitVectorIteratesCapacity && bv.capacity > bits.length) count("known mnemonist/15");
+          else if (Known.selectSkipsZeroWords && zeroWord) count("known mnemonist/2");
+          else if (Known.selectBoundedByLength && k >= bits.length) count("known mnemonist/10");
+          else fail(`BitVector.select(${k}) ${sel}, expected ${setBits[k - 1]}; bits ${show(setBits)}; ${ctx()}`);
+        }
+      }
+    }
+    const size = bits.reduce((s, b) => s + b, 0);
+    if (bv.size !== size) {
+      if (Known.bitVectorPopKeepsSize && log.includes("pop")) {
+        count("known mnemonist/14");
+        return;
+      }
+      fail(`BitVector.size ${bv.size}, expected ${size}; ${ctx()}`);
+    }
+    if (bv.length !== bits.length) fail(`BitVector.length ${bv.length}, expected ${bits.length}; ${ctx()}`);
+  }
+  // an index equal to the length is out of bounds
+  let threw = false;
+  try {
+    bv.set(bits.length);
+  } catch (e) {
+    threw = true;
+  }
+  if (!threw) {
+    if (Known.bitVectorSetAtLength) count("known mnemonist/16");
+    else fail(`BitVector.set(${bits.length}) on length ${bits.length} did not throw; ${ctx()}`);
+  }
+});
+
+// ---------------------------------------------------------------- vectors
+
+property("TestHegelVectorsAgreeWithAnArray", (tc) => {
+  const kind = pick(tc, ["Vector", "Uint8Vector", "Int16Vector", "Float64Vector", "HashedArrayTree"]);
+  const capacity = n(tc, 1, 8);
+  let v;
+  if (kind === "Vector") v = new M.Vector(Uint8Array, capacity);
+  else if (kind === "HashedArrayTree") v = new M.HashedArrayTree(Uint8Array, { blockSize: pick(tc, [1, 2, 4]), initialCapacity: capacity });
+  else v = new M.Vector[kind](capacity);
+  const model = [];
+  const log = [];
+  const ctx = () => `${kind}(${capacity}${kind === "HashedArrayTree" ? `, blockSize ${v.blockSize}` : ""}): ${log.join(", ")}`;
+  const value = () => (kind === "Int16Vector" ? n(tc, -300, 300) : kind === "Float64Vector" ? n(tc, -5, 5) / 4 : n(tc, 1, 250));
+  const steps = n(tc, 0, 30);
+  for (let i = 0; i < steps; i++) {
+    const op = pick(tc, ["push", "push", "push", "pop", "set", "grow", "query"]);
+    if (op === "push") {
+      const x = value();
+      log.push(`push ${x}`);
+      const r = v.push(x);
+      model.push(x);
+      if (r !== model.length) fail(`${kind}.push returned ${r}, expected ${model.length}; ${ctx()}`);
+    } else if (op === "pop") {
+      log.push("pop");
+      const r = v.pop();
+      const e = model.pop();
+      if (r !== e) {
+        if (kind === "HashedArrayTree" && Known.hatPopReadsLastBlock && e !== undefined) {
+          count("known mnemonist/18");
+          return;
+        }
+        fail(`${kind}.pop gave ${show(r)}, expected ${show(e)}; ${ctx()}`);
+      }
+    } else if (op === "set") {
+      if (model.length === 0) continue;
+      const idx = n(tc, 0, model.length - 1);
+      const x = value();
+      log.push(`set ${idx} ${x}`);
+      v.set(idx, x);
+      model[idx] = x;
+    } else if (op === "grow") {
+      const c = n(tc, 0, 20);
+      log.push(`grow ${c}`);
+      v.grow(c);
+      if (v.capacity < Math.max(c, model.length)) fail(`${kind}.capacity ${v.capacity} after grow(${c}); ${ctx()}`);
+    } else {
+      for (let j = 0; j < model.length; j++) {
+        if (v.get(j) !== model[j]) fail(`${kind}.get(${j}) ${show(v.get(j))}, expected ${show(model[j])}; ${ctx()}`);
+      }
+      // one past the end is out of bounds: get gives undefined, set throws
+      let r;
+      let getThrew = false;
+      try {
+        r = v.get(model.length);
+      } catch (e) {
+        getThrew = true;
+      }
+      if (getThrew || r !== undefined) {
+        if (kind === "HashedArrayTree" && Known.hatGetSetAtLength) count("known mnemonist/19");
+        else if (kind !== "HashedArrayTree" && Known.vectorGetSetAtLength) count("known mnemonist/17");
+        else fail(`${kind}.get(${model.length}) on length ${model.length} gave ${getThrew ? "a throw" : show(r)}; ${ctx()}`);
+      }
+      if (kind !== "HashedArrayTree") {
+        const vals = [...v.values()];
+        expectEqual(`${kind}.values`, vals, model, ctx);
+        expectEqual(`${kind}.entries`, [...v.entries()], model.map((x, j) => [j, x]), ctx);
+      }
+    }
+    if (v.length !== model.length) fail(`${kind}.length ${v.length}, expected ${model.length}; ${ctx()}`);
+  }
+  // set at the length must throw and leave the length alone
+  let threw = false;
+  try {
+    v.set(model.length, 1);
+  } catch (e) {
+    threw = true;
+  }
+  if (!threw || v.length !== model.length) {
+    if (kind === "HashedArrayTree" && Known.hatGetSetAtLength) count("known mnemonist/19");
+    else if (kind !== "HashedArrayTree" && Known.vectorGetSetAtLength) count("known mnemonist/17");
+    else fail(`${kind}.set(${model.length}) on length ${model.length} ${threw ? "changed the length" : "did not throw"}; ${ctx()}`);
+  }
+});
+
+// ---------------------------------------------------------------- Fibonacci heap
+
+property("TestHegelFibonacciHeapsAgreeWithASortedArray", (tc) => {
+  const kind = pick(tc, ["FibonacciHeap", "MinFibonacciHeap", "MaxFibonacciHeap"]);
+  const h = kind === "FibonacciHeap" ? new M.FibonacciHeap() : new M.FibonacciHeap[kind](cmpNum);
+  const order = kind === "MaxFibonacciHeap" ? (a, b) => b - a : cmpNum;
+  const model = [];
+  const log = [];
+  const steps = n(tc, 0, 40);
+  for (let i = 0; i < steps; i++) {
+    const op = pick(tc, ["push", "push", "pop", "peek"]);
+    if (op === "push") {
+      const x = n(tc, -20, 20);
+      log.push(`push ${x}`);
+      const r = h.push(x);
+      model.push(x);
+      model.sort(order);
+      if (r !== model.length) fail(`${kind}.push returned ${r}, size is ${model.length}; ops ${log.join(", ")}`);
+    } else if (op === "pop") {
+      log.push("pop");
+      const r = h.pop();
+      const e = model.shift();
+      if (r !== e) fail(`${kind}.pop gave ${show(r)}, expected ${show(e)}; ops ${log.join(", ")}`);
+    } else {
+      const r = h.peek();
+      if (r !== model[0]) fail(`${kind}.peek gave ${show(r)}, expected ${show(model[0])}; ops ${log.join(", ")}`);
+    }
+    if (h.size !== model.length) fail(`${kind}.size ${h.size}, expected ${model.length}; ops ${log.join(", ")}`);
+  }
+  const built = M.FibonacciHeap.from(model, order);
+  const out = [];
+  while (built.size) out.push(built.pop());
+  expectEqual(`${kind}.from`, out, model, () => `ops ${log.join(", ")}`);
+});
+
+// ---------------------------------------------------------------- merges and binary searches
+
+property("TestHegelSortedArrayMergesMatchTheDefinitions", (tc) => {
+  const k = n(tc, 2, 4);
+  const arrays = [];
+  for (let i = 0; i < k; i++) {
+    const distinct = chance(tc, 70);
+    let xs = sortedNums(ints(tc, n(tc, 0, 6), 0, 9));
+    if (distinct) xs = uniq(xs);
+    arrays.push(xs);
+  }
+  const typedIn = k === 2 && chance(tc, 25);
+  const input = typedIn ? arrays.map((a) => Uint8Array.from(a)) : arrays;
+  const ctx = () => `${typedIn ? "Uint8Array " : ""}arrays ${show(arrays)}`;
+  const anyEmpty = arrays.some((a) => a.length === 0);
+  // merge: the sorted concatenation
+  let r;
+  try {
+    r = merge.merge(...input);
+  } catch (e) {
+    r = e;
+  }
+  const want = sortedNums(arrays.flat());
+  if (r instanceof Error || !same(Array.from(r), want)) {
+    if (Known.kWayMergeEmptyArray && k >= 3 && anyEmpty) count("known mnemonist/20");
+    else fail(`merge: got ${r instanceof Error ? r.message : show(Array.from(r))}, expected ${show(want)}; ${ctx()}`);
+  }
+  // unionUnique and intersectionUnique need distinct elements per array
+  if (arrays.every((a) => a.length === uniq(a).length)) {
+    let u;
+    try {
+      u = merge.unionUnique(...input);
+    } catch (e) {
+      u = e;
+    }
+    const wantU = sortedNums(uniq(arrays.flat()));
+    if (u instanceof Error || !same(Array.from(u), wantU)) {
+      if (Known.kWayMergeEmptyArray && k >= 3 && anyEmpty) count("known mnemonist/20");
+      else if (Known.uniqueMergeTypedArrays && typedIn) count("known mnemonist/21");
+      else fail(`unionUnique: got ${u instanceof Error ? u.message : show(Array.from(u))}, expected ${show(wantU)}; ${ctx()}`);
+    }
+    let x;
+    try {
+      x = merge.intersectionUnique(...input);
+    } catch (e) {
+      x = e;
+    }
+    const wantX = arrays[0].filter((v) => arrays.every((a) => a.includes(v)));
+    if (x instanceof Error || !same(Array.from(x), wantX)) {
+      const maxStart = Math.max(...arrays.map((a) => a[0]));
+      const minEnd = Math.min(...arrays.map((a) => a[a.length - 1]));
+      if (Known.uniqueMergeTypedArrays && typedIn) count("known mnemonist/21");
+      else if (Known.intersectionUniqueShortcut && k >= 3 && !anyEmpty && maxStart === minEnd) count("known mnemonist/22");
+      else fail(`intersectionUnique: got ${x instanceof Error ? x.message : show(Array.from(x))}, expected ${show(wantX)}; ${ctx()}`);
+    }
+  }
+  // binary searches on the first array
+  const a = arrays[0];
+  const v = n(tc, -1, 10);
+  const lb = a.findIndex((y) => y >= v) === -1 ? a.length : a.findIndex((y) => y >= v);
+  const ub = a.findIndex((y) => y > v) === -1 ? a.length : a.findIndex((y) => y > v);
+  if (bsearch.lowerBound(a, v) !== lb) fail(`lowerBound(${show(a)}, ${v}) ${bsearch.lowerBound(a, v)}, expected ${lb}`);
+  if (bsearch.upperBound(a, v) !== ub) fail(`upperBound(${show(a)}, ${v}) ${bsearch.upperBound(a, v)}, expected ${ub}`);
+  if (bsearch.lowerBoundWithComparator(cmpNum, a, v) !== lb) fail(`lowerBoundWithComparator(${show(a)}, ${v}) ${bsearch.lowerBoundWithComparator(cmpNum, a, v)}, expected ${lb}`);
+  if (bsearch.upperBoundWithComparator(cmpNum, a, v) !== ub) fail(`upperBoundWithComparator(${show(a)}, ${v}) ${bsearch.upperBoundWithComparator(cmpNum, a, v)}, expected ${ub}`);
+  const found = bsearch.search(a, v);
+  if (a.includes(v) ? a[found] !== v : found !== -1) fail(`search(${show(a)}, ${v}) ${found}`);
+  const foundC = bsearch.searchWithComparator(cmpNum, a, v);
+  if (a.includes(v) ? a[foundC] !== v : foundC !== -1) fail(`searchWithComparator(${show(a)}, ${v}) ${foundC}`);
+});
