+// The indices: tries, the static interval tree, the k-d, vantage-point and BK trees, the
+// Passjoin index and SymSpell, the suffix arrays, the inverted index and the fuzzy maps, each
+// against the exhaustive scan of the same items.
+
+import { createRequire } from "node:module";
+import { property, count, fail, n, pick, chance, word, show, same } from "./hegel-zoo.mjs";
+import { Known } from "./known.mjs";
+
+const require = createRequire(import.meta.url);
+const M = require("../index.js");
+const CritBitTreeMap = require("../critbit-tree-map.js");
+
+function expectEqual(what, actual, expected, ctx) {
+  if (!same(actual, expected)) {
+    fail(`${what}: got ${show(actual)}, expected ${show(expected)}\n  ${ctx()}`);
+  }
+}
+
+/** Levenshtein distance. */
+function levenshtein(a, b) {
+  const m = a.length;
+  const k = b.length;
+  let prev = Array.from({ length: k + 1 }, (_, j) => j);
+  for (let i = 1; i <= m; i++) {
+    const cur = [i];
+    for (let j = 1; j <= k; j++) {
+      cur[j] = Math.min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + (a[i - 1] === b[j - 1] ? 0 : 1));
+    }
+    prev = cur;
+  }
+  return prev[k];
+}
+
+/** The unrestricted Damerau-Levenshtein distance (transpositions may be edited between), SymSpell's metric. */
+function damerau(a, b) {
+  const m = a.length;
+  const k = b.length;
+  const inf = m + k;
+  const d = Array.from({ length: m + 2 }, () => new Array(k + 2).fill(0));
+  d[0][0] = inf;
+  for (let i = 0; i <= m; i++) {
+    d[i + 1][0] = inf;
+    d[i + 1][1] = i;
+  }
+  for (let j = 0; j <= k; j++) {
+    d[0][j + 1] = inf;
+    d[1][j + 1] = j;
+  }
+  const da = new Map();
+  for (let i = 1; i <= m; i++) {
+    let db = 0;
+    for (let j = 1; j <= k; j++) {
+      const i1 = da.get(b[j - 1]) || 0;
+      const j1 = db;
+      const cost = a[i - 1] === b[j - 1] ? 0 : 1;
+      if (cost === 0) db = j;
+      d[i + 1][j + 1] = Math.min(d[i][j] + cost, d[i + 1][j] + 1, d[i][j + 1] + 1, d[i1][j1] + (i - i1 - 1) + 1 + (j - j1 - 1));
+    }
+    da.set(a[i - 1], i);
+  }
+  return d[m + 1][k + 1];
+}
+
+const sortStr = (xs) => [...xs].sort();
+
+// ---------------------------------------------------------------- tries
+
+property("TestHegelTriesAgreeWithASetOfKeys", (tc) => {
+  const arrays = chance(tc, 30);
+  const alphabet = arrays ? ["a", "b", "c", "constructor", "toString"] : ["a", "b", "c"];
+  const key = () => {
+    const w = [];
+    const len = n(tc, 0, 4);
+    for (let i = 0; i < len; i++) w.push(pick(tc, alphabet));
+    return arrays ? w : w.join("");
+  };
+  const enc = (k) => (arrays ? k.join("/") : k);
+  const trie = arrays ? new M.Trie(Array) : new M.Trie();
+  const map = arrays ? new M.TrieMap(Array) : new M.TrieMap();
+  const model = new Map(); // encoded key -> [key, value]
+  const log = [];
+  const ctx = () => `${arrays ? "array" : "string"} keys: ${log.join(", ")}`;
+  const protoToken = (k) => arrays && k.some((t) => t in Object.prototype);
+  const steps = n(tc, 0, 20);
+  for (let i = 0; i < steps; i++) {
+    const k = key();
+    const op = pick(tc, ["add", "add", "delete", "query", "find"]);
+    if (op === "add") {
+      const v = n(tc, 0, 9);
+      log.push(`add ${show(k)} ${v}`);
+      trie.add(k);
+      map.set(k, v);
+      model.set(enc(k), [k, v]);
+    } else if (op === "delete") {
+      log.push(`delete ${show(k)}`);
+      const r1 = trie.delete(k);
+      const r2 = map.delete(k);
+      const e = model.delete(enc(k));
+      if (r1 !== e || r2 !== e) {
+        if (Known.trieArrayPrototypeTokens && protoToken(k)) {
+          count("known mnemonist/42");
+          return;
+        }
+        fail(`Trie.delete ${r1} / TrieMap.delete ${r2} for ${show(k)}, expected ${e}; ${ctx()}`);
+      }
+    } else if (op === "query") {
+      for (let j = 0; j < 3; j++) {
+        const q = key();
+        const has = model.has(enc(q));
+        const got1 = trie.has(q);
+        const got2 = map.has(q);
+        const got3 = map.get(q);
+        const want3 = has ? model.get(enc(q))[1] : undefined;
+        if (got1 !== has || got2 !== has || got3 !== want3) {
+          if (Known.trieArrayPrototypeTokens && (protoToken(q) || [...model.values()].some(([kk]) => protoToken(kk)))) {
+            count("known mnemonist/42");
+            return;
+          }
+          fail(`Trie.has ${got1} / TrieMap.has ${got2} / TrieMap.get ${show(got3)} for ${show(q)}, expected ${has} ${show(want3)}; ${ctx()}`);
+        }
+      }
+    } else {
+      const p = key();
+      const keys = [...model.values()].filter(([kk]) => enc(kk).startsWith(enc(p)) && (arrays ? kk.length >= p.length && p.every((t, j) => kk[j] === t) : true));
+      const want = sortStr(keys.map(([kk]) => enc(kk)));
+      const got = sortStr(trie.find(p).map(enc));
+      const gotMap = sortStr(map.find(p).map(([kk]) => enc(kk)));
+      if (!same(got, want) || !same(gotMap, want)) {
+        // the pollution of the prototype is global: a prefix with such a token sees the keys of earlier cases
+        if (Known.trieArrayPrototypeTokens && (protoToken(p) || [...model.values()].some(([kk]) => protoToken(kk)))) {
+          count("known mnemonist/42");
+          return;
+        }
+        fail(`Trie.find(${show(p)}) ${show(got)} / TrieMap.find ${show(gotMap)}, expected ${show(want)}; ${ctx()}`);
+      }
+    }
+    if (trie.size !== model.size || map.size !== model.size) {
+      if (Known.trieArrayPrototypeTokens && [...model.values()].some(([kk]) => protoToken(kk))) {
+        count("known mnemonist/42");
+        return;
+      }
+      fail(`Trie.size ${trie.size} / TrieMap.size ${map.size}, expected ${model.size}; ${ctx()}`);
+    }
+  }
+  const want = sortStr([...model.keys()]);
+  if (!same(sortStr([...trie].map(enc)), want) || !same(sortStr([...map.keys()].map(enc)), want)) {
+    if (Known.trieArrayPrototypeTokens && [...model.values()].some(([kk]) => protoToken(kk))) {
+      count("known mnemonist/42");
+      return;
+    }
+    fail(`Trie iteration ${show(sortStr([...trie].map(enc)))} / TrieMap.keys ${show(sortStr([...map.keys()].map(enc)))}, expected ${show(want)}; ${ctx()}`);
+  }
+  const entries = [...map.entries()].map(([kk, v]) => [enc(kk), v]).sort();
+  expectEqual("TrieMap.entries", entries, [...model.values()].map(([kk, v]) => [enc(kk), v]).sort(), ctx);
+});
