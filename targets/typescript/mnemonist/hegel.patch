+/** The bit set case: a length and up to 40 operations on indices below it - a query (with a rank position and a select rank taken modulo the live count of ones) first, then set (twice the weight), reset and flip. */
+const bitSetCase = ints(1, 70).flatMap((length) => {
+  const idx = ints(0, length - 1);
+  return gs.record({
+    length: gs.just(length),
+    ops: ops(40, [1, op("query", { r: ints(0, length), k: ints(0, 99) })], [2, op("set", { idx })], [1, op("reset", { idx })], [1, op("flip", { idx })]),
+  });
+});
