+// Hegel zoo: the generator helpers behind the minimatch properties, as values built from Hegel's
+// combinators. Nothing here draws from a TestCase: every generator is a value.
+
+import { gs } from "./hegel-zoo.mjs";
+
+export const ints = (lo, hi) => gs.integers({ minValue: lo, maxValue: hi });
+
+/** oneOf with weights: `weighted([45, a], [55, b])` draws a 45 times in 100; shrinks towards the first choice. */
+export function weighted(...choices) {
+  if (choices.length === 1) return choices[0][1];
+  const total = choices.reduce((sum, [w]) => sum + w, 0);
+  return ints(0, total - 1).flatMap((r) => {
+    for (const [w, g] of choices) {
+      if (r < w) return g;
+      r -= w;
+    }
+    throw new Error("unreachable");
+  });
+}
+
+/** True pct percent of the time; shrinks to false. */
+export const chance = (pct) => ints(0, 99).map((r) => r >= 100 - pct);
+/** A draw from g pct percent of the time, else undefined (listed first: shrinks to absent). */
+export const maybe = (pct, g) => weighted([100 - pct, gs.just(undefined)], [pct, g]);
+export const pick = (xs) => gs.sampledFrom(xs);
+/** lo-hi pieces of `pool` (an array of strings; a repeated entry weighs more) joined into one string. */
+export const word = (pool, lo, hi) => gs.arrays(pick(pool), { minSize: lo, maxSize: hi }).map((cs) => cs.join(""));
diff --git a/test/hegel-glob.mjs b/test/hegel-glob.mjs
new file mode 100644
index 0000000..da87361
--- /dev/null
+++ b/test/hegel-glob.mjs
@@ -0,0 +1,281 @@
+// Hegel zoo: glob-pattern, path and brace-expression generators for minimatch, and bash as the oracle
+// (filename globbing over a scratch tree; brace expansion under `set -f`). Adapted from the picomatch target.
+//
+// A pattern is drawn as data - segments of atoms, each atom carrying its text, its kind and a few
+// strings that match it - and rendered by pure functions into the pattern text, the options it runs
+// under and the flags the properties read. The candidate paths for a pattern are drawn from its
+// atoms' solutions, from those solutions with one edit applied (positions taken modulo the live
+// length) and from random names. A brace expression is a small tree (words around groups of items)
+// rendered by a pure function.
+
+import { execFileSync } from "node:child_process";
+import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { dirname, join } from "node:path";
+import { gs } from "./hegel-zoo.mjs";
+import { chance, ints, maybe, pick, weighted, word } from "./gen.mjs";
+
+const LOWER = "abcdxyz".split("");
+const UPPER = "ABX".split("");
+const LIT = [...LOWER, ...LOWER, "0", "1", ".", "-", "_"];
+const NAME_CHARS = [...LOWER, ...LOWER, ...UPPER, "0", "1", ".", "-", "_", "*", "?", "[", "]", "{", "}", "(", ")", "!", "+", "@", ",", "\\"];
+const CLASSES = ["alpha", "digit", "alnum", "lower", "upper", "punct", "xdigit", "word", "space", "blank"];
+const CLASS_SOLUTIONS = { alpha: ["a", "Q"], digit: ["0", "7"], alnum: ["a", "1"], lower: ["a", "z"], upper: ["A", "X"], punct: ["-", "_", "."], xdigit: ["a", "F", "9"], word: ["a", "_", "1"], space: [" "], blank: [" "] };
+
+// ---------------------------------------------------------------- atoms
+//
+// One glob atom of a path segment: {text, kind, solutions: [strings that match it]}. Two families of
+// atoms are drawn: the plain one, and a "classy" one whose bracket expressions may be POSIX classes
+// and whose text holds no "-" or "," (a literal "-", ",", "#" or space beside a POSIX class is
+// minimatch/2, a SyntaxError, so the recorded shape is kept out of the pattern by construction and
+// the gate in the test is a guard that should not fire).
+
+const lit = (s) => ({ text: s, kind: "lit", solutions: [s] });
+/** A glob text turned into one of the strings it matches. */
+const literalise = (s) => s.replace(/[*?\[\]]/g, "a");
+
+const star = gs.tuples(pick(LIT), word(LIT, 1, 3)).map(([c, w]) => ({ text: "*", kind: "glob", solutions: ["", c, w] }));
+const qmark = pick(LIT).map((c) => ({ text: "?", kind: "glob", solutions: [c] }));
+
+// bracket expression bodies: a list, a range, a POSIX class, an awkward form
+const bracketList = word(LOWER, 1, 3).map((s) => ({ inner: s, solutions: s.split("") }));
+const bracketRange = gs.just({ inner: "a-d", solutions: ["a", "b", "c", "d"] });
+const posixClass = pick(CLASSES).map((cls) => ({ inner: `[:${cls}:]`, solutions: CLASS_SOLUTIONS[cls] }));
+const awkward = (forms) => pick(forms).map((s) => ({ inner: s, solutions: ["a", "-", "]"] }));
+// a bracket expression over one of the bodies, one time in four negated
+const bracketOf = (body) => gs.tuples(maybe(25, pick(["!", "^"])), body).map(([neg, b]) => ({
+  text: `[${neg ?? ""}${b.inner}]`,
+  kind: "bracket",
+  solutions: neg ? ["x", "Z", "1"] : b.solutions,
+}));
+
+// an extglob. Negation is excluded (minimatch documents that `!(...)` differs from bash in the
+// greedy case); nesting is not generated (maxExtglobRecursion defaults to 2).
+const extAlt = weighted([80, word(LOWER, 1, 3)], [20, pick(["a*", "b?", "[ab]", "", "*"])]);
+const extglob = gs.record({ op: pick(["@", "*", "+", "?"]), alts: gs.arrays(extAlt, { minSize: 1, maxSize: 3 }) }).map(({ op, alts: drawn }) => {
+  // "?()" is a degenerate form bash and minimatch read differently
+  const alts = drawn.every((x) => x === "") ? ["a", ...drawn.slice(1)] : drawn;
+  const a0 = literalise(alts[0]);
+  const solutions = { "@": [a0], "*": ["", a0, a0 + a0], "+": [a0, a0 + a0], "?": ["", a0] }[op];
+  return { text: `${op}(${alts.join("|")})`, kind: "extglob", solutions };
+});
+
+// a brace list; with a single item it is not an expansion but literal text (bash and the README:
+// "only comma-delimited lists")
+const braceLiteral = word(LOWER, 1, 3).map((w) => lit(`{${w}}`));
+const braceItem = weighted([80, word(LOWER, 0, 3)], [20, pick(["a*", "?", "[ab]"])]);
+const braceList = gs.arrays(braceItem, { minSize: 2, maxSize: 3 }).map((items) => ({ text: `{${items.join(",")}}`, kind: "brace", solutions: items.map(literalise) }));
+
+// an escaped special character, literal
+const escape = pick(["*", "?", "[", "]", "{", "}", "(", ")", "!", "+", "@", "."]).map((c) => ({ text: "\\" + c, kind: "escape", solutions: [c] }));
+
+const plainAtom = weighted(
+  [50, pick(LIT).map(lit)],
+  [15, star],
+  [8, qmark],
+  [8, bracketOf(gs.oneOf(bracketList, bracketRange, awkward(["a-c0-1", "x-", "-a", "].", "a]b", "a\\-b", "\\]", "-"])))],
+  [7, extglob],
+  [7, weighted([33, braceLiteral], [67, braceList])],
+  [5, escape],
+);
+const classyAtom = weighted(
+  [40, pick(LIT.filter((c) => c !== "-")).map(lit)],
+  [15, star],
+  [8, qmark],
+  [18, bracketOf(gs.oneOf(bracketList, posixClass, awkward(["].", "a]b", "\\]"])))],
+  [7, extglob],
+  [7, braceLiteral],
+  [5, escape],
+);
+
+// ---------------------------------------------------------------- segments and patterns
+
+const isGlobAtom = (a) => a.kind !== "lit" && a.kind !== "escape";
+
+// a segment: 1-4 atoms, or one time in five-and-a-half a "**" (atoms: null)
+const segmentOf = (atom) => weighted(
+  [82, gs.arrays(atom, { minSize: 1, maxSize: 4 }).map((atoms) => {
+    const text = atoms.map((a) => a.text).join("");
+    // "." and ".." segments are path syntax, not names (minimatch's optimizationLevel folds them)
+    return text === "." || text === ".." ? { text: text + "a", atoms: [...atoms, lit("a")] } : { text, atoms };
+  })],
+  [18, gs.just({ text: "**", atoms: null })],
+);
+
+/** The pattern text of 1-4 segments joined by "/" and the options it runs under: {pattern, opts, segments, hasGlob}. */
+function mkPattern({ segments, dot, nocase }) {
+  const opts = {};
+  if (dot) opts.dot = true;
+  // bash's nocaseglob applies only to path components that contain glob characters (literal
+  // components are looked up as written), so nocase is only taken for all-glob patterns - and a
+  // brace list does not count, since its expansions ("{zdx,cdd,}" -> "zdx", "cdd") are literal words;
+  // and case-folding a bracket expression ([a-d], [[:lower:]], [^[:lower:]]) is defined differently by
+  // bash and by a regex "i" flag, so not with brackets either
+  const allGlob = segments.every((s) => s.atoms === null || s.atoms.some((a) => isGlobAtom(a) && a.kind !== "brace"));
+  const noBracket = segments.every((s) => s.atoms === null || s.atoms.every((a) => a.kind !== "bracket"));
+  if (nocase && allGlob && noBracket) opts.nocase = true;
+  const hasGlob = segments.some((s) => s.atoms === null || s.atoms.some(isGlobAtom));
+  return { pattern: segments.map((s) => s.text).join("/"), opts, segments, hasGlob };
+}
+
+const patternOf = (atom) => gs.record({ segments: gs.arrays(segmentOf(atom), { minSize: 1, maxSize: 4 }), dot: chance(30), nocase: chance(25) }).map(mkPattern);
+
+/** A glob pattern with the options it needs (dot 30%, nocase 25% where bash can follow); one pattern in five is from the classy family. */
+export const pattern = weighted([80, patternOf(plainAtom)], [20, patternOf(classyAtom)]);
+
+// ---------------------------------------------------------------- candidate paths
+
+// the names a "**" segment stands for: 0-2, one time in seven a dotfile
+const shortName = word(LOWER, 1, 2);
+const globstarNames = gs.arrays(weighted([85, shortName], [15, shortName.map((w) => "." + w)]), { maxSize: 2 });
+
+/** The path segments one segment of `pat` matches (a list: "**" can stand for none or several). */
+const segmentSolution = (seg) => (seg.atoms === null ? globstarNames : gs.tuples(...seg.atoms.map((a) => pick(a.solutions))).map((ss) => [ss.join("")]));
+/** A path the pattern matches, built from one solution per atom. */
+const solution = (pat) => gs.tuples(...pat.segments.map(segmentSolution)).map((parts) => parts.flat());
+
+// one edit of a path; `at` is taken modulo the live length when applied
+const at = ints(0, 5);
+const edit = weighted(
+  [20, gs.record({ kind: gs.just("insert"), at, name: word(NAME_CHARS, 1, 3) })],
+  [15, gs.record({ kind: gs.just("drop"), at })],
+  [20, gs.record({ kind: gs.just("extend"), at, c: pick(NAME_CHARS) })],
+  [15, gs.record({ kind: gs.just("truncate"), at })],
+  [15, gs.record({ kind: gs.just("dot"), at })],
+  [15, gs.record({ kind: gs.just("recase"), at, upper: chance(50) })],
+);
+
+function applyEdit(parts, e) {
+  const p = parts.slice();
+  if (e.kind === "insert") {
+    p.splice(e.at % (p.length + 1), 0, e.name);
+    return p;
+  }
+  if (p.length === 0) return p; // nothing to edit (dropped below as an empty path)
+  const i = e.at % p.length;
+  if (e.kind === "drop") p.splice(i, 1);
+  else if (e.kind === "extend") p[i] += e.c;
+  else if (e.kind === "truncate") p[i] = p[i].slice(1);
+  else if (e.kind === "dot") p[i] = "." + p[i];
+  else p[i] = e.upper ? p[i].toUpperCase() : p[i].toLowerCase();
+  return p;
+}
+
+const randomPath = gs.arrays(word(NAME_CHARS, 1, 4), { minSize: 1, maxSize: 3 });
+
+// a candidate: a solution, an edited solution, or a random path
+const candidate = (pat) => weighted([45, solution(pat)], [44, gs.tuples(solution(pat), edit).map(([parts, e]) => applyEdit(parts, e))], [11, randomPath]);
+
+const validName = (s) => s !== "" && s !== "." && s !== ".." && !s.includes("/") && !s.includes("\0") && !s.includes("\n");
+const validPath = (parts) => parts.length > 0 && parts.length <= 6 && parts.every(validName);
+
+/** 4-12 candidate paths for `pat`, the invalid ones dropped and duplicates merged. */
+const candidates = (pat) => gs.arrays(candidate(pat), { minSize: 4, maxSize: 12 }).map((cs) => [...new Set(cs.filter(validPath).map((p) => p.join("/")))]);
+
+/** A pattern and its candidate paths (at least one): {pat, paths}. */
+export const patternAndPaths = pattern.flatMap((pat) => candidates(pat).map((paths) => ({ pat, paths }))).filter(({ paths }) => paths.length > 0);
+
+// ---------------------------------------------------------------- the oracle
+
+const SCRIPT = `
+shopt -s globstar extglob nullglob
+shopt -u failglob dotglob nocaseglob
+[ "$3" = 1 ] && shopt -s dotglob
+[ "$4" = 1 ] && shopt -s nocaseglob
+cd "$1" || exit 3
+pat=$2
+eval "printf '%s\\\\n' $pat"
+`;
+
+let scratch = null;
+
+/**
+ * bash's filename globbing of \`pattern\` over a tree holding exactly \`paths\` (a path that is a prefix of
+ * another is a directory, the rest are files): {ok, matched: Set, dirs: Set} or {ok: false, error}.
+ * bash lists a matched directory with a trailing slash when the pattern ends in "/" or "/**"; the
+ * slash is stripped here and minimatch is given the directory paths with a trailing slash instead.
+ */
+export function bashGlob(pattern, paths, { dot = false, nocase = false } = {}) {
+  scratch ??= (() => {
+    const dir = mkdtempSync(join(tmpdir(), "hegel-glob-"));
+    process.on("exit", () => {
+      try { rmSync(dir, { recursive: true, force: true }); } catch {}
+    });
+    return dir;
+  })();
+  const root = join(scratch, "t");
+  rmSync(root, { recursive: true, force: true });
+  mkdirSync(root);
+  // a path that is a prefix of another becomes a directory; the rest are files
+  const sorted = [...paths].sort();
+  const dirs = new Set();
+  for (const p of sorted) {
+    const isDir = sorted.some((q) => q !== p && q.startsWith(p + "/"));
+    if (isDir) dirs.add(p);
+    if (isDir) mkdirSync(join(root, p), { recursive: true });
+    else {
+      mkdirSync(dirname(join(root, p)), { recursive: true });
+      writeFileSync(join(root, p), "");
+    }
+  }
+  try {
+    const out = execFileSync("bash", ["-c", SCRIPT, "--", root, pattern, dot ? "1" : "0", nocase ? "1" : "0"], {
+      env: { LC_ALL: "C", PATH: process.env.PATH },
+      stdio: ["ignore", "pipe", "pipe"],
+    }).toString();
+    const matched = new Set();
+    for (const line of out.split("\n")) {
+      if (line === "") continue;
+      matched.add(line.replace(/\/+$/, ""));
+    }
+    return { ok: true, matched, dirs };
+  } catch (e) {
+    return { ok: false, error: (e.stderr ? e.stderr.toString() : String(e)).trim().split("\n")[0] };
+  }
+}
+
+// ---------------------------------------------------------------- brace expressions
+//
+// A brace expression is a tree: a leading word, then one or two groups (one below the top level),
+// each a list of 1-3 items followed by a word; a group of one item is written bare half the time
+// (so "{a}" appears too). An item is a word (55%), a sequence (25%: letters, or numbers possibly
+// negative or zero-padded, with an optional step) or a nested expression (20%); two levels down the
+// items are words only. The nesting is an eager tower of three levels (the binding has no recursive
+// combinator), each level's items drawing the expression of the level below.
+
+const BRACE_WORD = "abcxyz01".split("");
+const SEQ_LETTERS = "abcdxyz".split("");
+
+const stepText = (step) => (step === undefined ? "" : `..${step}`);
+const letterSequence = gs.record({ a: pick(SEQ_LETTERS), b: pick(SEQ_LETTERS), step: maybe(30, ints(-2, 3)) }).map(({ a, b, step }) => `{${a}..${b}${stepText(step)}}`);
+const numberText = (pad, v) => (v < 0 ? "-" + pad + -v : pad + v);
+const numberSequence = gs.record({ a: ints(-3, 12), b: ints(-3, 12), pad: chance(25), step: maybe(30, ints(-3, 3)) }).map(({ a, b, pad, step }) => {
+  const zero = pad ? "0" : "";
+  return `{${numberText(zero, a)}..${numberText(zero, b)}${stepText(step)}}`;
+});
+const sequence = weighted([40, letterSequence], [60, numberSequence]);
+
+const renderBrace = ({ lead, groups }) => lead + groups.map(({ items, bare, tail }) => (items.length === 1 && bare ? items[0] : `{${items.join(",")}}`) + tail).join("");
+
+const braceWord = word(BRACE_WORD, 0, 3);
+/** A group over `item`: 1-3 items and the word after it; a group of one item is written bare half the time. */
+const groupOf = (item) => gs.record({ items: gs.arrays(item, { minSize: 1, maxSize: 3 }), bare: chance(50), tail: word(BRACE_WORD, 0, 2) });
+/** An expression over `item`: a leading word and 1-`groups` groups, rendered. */
+const expressionOf = (item, groups) => gs.record({ lead: word(BRACE_WORD, 0, 2), groups: gs.arrays(groupOf(item), { minSize: 1, maxSize: groups }) }).map(renderBrace);
+/** An item: a word (55%), a sequence (25%) or the expression `nested` of the level below (20%). */
+const itemOver = (nested) => weighted([55, braceWord], [25, sequence], [20, nested]);
+
+const innermost = expressionOf(braceWord, 1);
+const middle = expressionOf(itemOver(innermost), 1);
+
+/** A non-empty brace expression over letters and digits: words, comma lists (possibly nested, with a single or empty item), sequences. */
+export const braceExpression = expressionOf(itemOver(middle), 2).filter((expr) => expr !== "");
+
+/** bash's brace expansion of \`expr\` (letters, digits, braces, commas, dots and minus signs only), in order. */
+export function bashBraceExpand(expr) {
+  if (!/^[A-Za-z0-9{},.\-]*$/.test(expr)) throw new Error(`unsafe brace expression ${JSON.stringify(expr)}`);
+  const out = execFileSync("bash", ["-c", `set -f; printf '%s\\0' ${expr}`], { env: { LC_ALL: "C", PATH: process.env.PATH } }).toString();
+  const parts = out.split("\0");
+  parts.pop();
+  return parts;
+}
