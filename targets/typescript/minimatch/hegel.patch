new file mode 100644
index 0000000..5739abd
--- /dev/null
+++ b/test/hegel-glob.mjs
@@ -0,0 +1,278 @@
+// Hegel zoo: glob-pattern, path and brace-expression generators for minimatch, and bash as the oracle
+// (filename globbing over a scratch tree; brace expansion under `set -f`). Adapted from the picomatch target.
+
+import { execFileSync } from "node:child_process";
+import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { dirname, join } from "node:path";
+import { chance, n, pick, word } from "./hegel-zoo.mjs";
+
+const LOWER = "abcdxyz".split("");
+const UPPER = "ABX".split("");
+const LIT = [...LOWER, ...LOWER, "0", "1", ".", "-", "_"];
+const NAME_CHARS = [...LOWER, ...LOWER, ...UPPER, "0", "1", ".", "-", "_", "*", "?", "[", "]", "{", "}", "(", ")", "!", "+", "@", ",", "\\"];
+const CLASSES = ["alpha", "digit", "alnum", "lower", "upper", "punct", "xdigit", "word", "space", "blank"];
+
+/** One glob atom for a path segment: {text, kind, solutions: [strings that match it]}. */
+function genAtom(tc, opts) {
+  const r = n(tc, 0, 99);
+  if (r < 50) {
+    const c = pick(tc, LIT);
+    return { text: c, kind: "lit", solutions: [c] };
+  }
+  if (r < 65) return { text: "*", kind: "glob", solutions: ["", pick(tc, LIT), word(tc, LIT, 1, 3)] };
+  if (r < 73) return { text: "?", kind: "glob", solutions: [pick(tc, LIT)] };
+  if (r < 81) {
+    // a bracket expression
+    const neg = chance(tc, 25);
+    let inner;
+    let sols;
+    const k = n(tc, 0, 3);
+    if (k === 0) {
+      inner = word(tc, LOWER, 1, 3);
+      sols = inner.split("");
+    } else if (k === 1) {
+      inner = "a-d";
+      sols = ["a", "b", "c", "d"];
+    } else if (k === 2) {
+      const cls = pick(tc, CLASSES);
+      inner = `[:${cls}:]`;
+      sols = { alpha: ["a", "Q"], digit: ["0", "7"], alnum: ["a", "1"], lower: ["a", "z"], upper: ["A", "X"], punct: ["-", "_", "."], xdigit: ["a", "F", "9"], word: ["a", "_", "1"], space: [" "], blank: [" "] }[cls];
+    } else {
+      inner = pick(tc, ["a-c0-1", "x-", "-a", "].", "a]b", "a\\-b", "\\]", "-"]);
+      sols = ["a", "-", "]"];
+    }
+    return { text: `[${neg ? pick(tc, ["!", "^"]) : ""}${inner}]`, kind: "bracket", solutions: neg ? ["x", "Z", "1"] : sols };
+  }
+  if (r < 88) {
+    // an extglob. Negation is excluded (minimatch documents that `!(...)` differs from bash in the
+    // greedy case); nesting is not generated (maxExtglobRecursion defaults to 2).
+    const op = pick(tc, ["@", "*", "+", "?"]);
+    const alts = [];
+    const cnt = n(tc, 1, 3);
+    for (let i = 0; i < cnt; i++) alts.push(chance(tc, 80) ? word(tc, LOWER, 1, 3) : pick(tc, ["a*", "b?", "[ab]", "", "*"]));
+    if (alts.every((x) => x === "")) alts[0] = "a"; // "?()" is a degenerate form bash and picomatch read differently
+    const a0 = alts[0].replace(/[*?\[\]]/g, "a");
+    const sols = op === "@" ? [a0] : op === "*" ? ["", a0, a0 + a0] : op === "+" ? [a0, a0 + a0] : ["", a0];
+    return { text: `${op}(${alts.join("|")})`, kind: "extglob", solutions: sols };
+  }
+  if (r < 95) {
+    // a brace list; with a single item it is not an expansion but literal text (bash and the README:
+    // "only comma-delimited lists")
+    const items = [];
+    const cnt = n(tc, 1, 3);
+    for (let i = 0; i < cnt; i++) items.push(chance(tc, 80) ? word(tc, LOWER, 0, 3) : pick(tc, ["a*", "?", "[ab]"]));
+    if (cnt === 1) {
+      const t = `{${word(tc, LOWER, 1, 3)}}`;
+      return { text: t, kind: "lit", solutions: [t] };
+    }
+    return { text: `{${items.join(",")}}`, kind: "brace", solutions: items.map((x) => x.replace(/[*?\[\]]/g, "a")) };
+  }
+  // an escaped special character, literal
+  const c = pick(tc, ["*", "?", "[", "]", "{", "}", "(", ")", "!", "+", "@", "."]);
+  return { text: "\\" + c, kind: "escape", solutions: [c] };
+}
+
+/** A glob pattern (segments joined by "/") and its options: {pattern, opts, segments, hasGlob}. */
+export function genPattern(tc) {
+  const opts = {};
+  const segments = [];
+  const count = n(tc, 1, 4);
+  let hasGlob = false;
+  for (let i = 0; i < count; i++) {
+    if (chance(tc, 18)) {
+      segments.push({ text: "**", atoms: null });
+      hasGlob = true;
+      continue;
+    }
+    const atoms = [];
+    const k = n(tc, 1, 4);
+    for (let j = 0; j < k; j++) {
+      const a = genAtom(tc, opts);
+      if (a.kind !== "lit" && a.kind !== "escape") hasGlob = true;
+      atoms.push(a);
+    }
+    let text = atoms.map((a) => a.text).join("");
+    if (text === "." || text === "..") {
+      // "." and ".." segments are path syntax, not names (minimatch's optimizationLevel folds them)
+      atoms.push({ text: "a", kind: "lit", solutions: ["a"] });
+      text += "a";
+    }
+    segments.push({ text, atoms });
+  }
+  if (chance(tc, 30)) opts.dot = true;
+  // bash's nocaseglob applies only to path components that contain glob characters (literal
+  // components are looked up as written), so nocase is only generated for all-glob patterns; and
+  // case-folding a bracket expression ([a-d], [[:lower:]], [^[:lower:]]) is defined differently by
+  // bash and by a regex "i" flag, so not with brackets either
+  const allGlob = segments.every((s) => s.atoms === null || s.atoms.some((a) => a.kind !== "lit" && a.kind !== "escape"));
+  const noBracket = segments.every((s) => s.atoms === null || s.atoms.every((a) => a.kind !== "bracket"));
+  if (allGlob && noBracket && chance(tc, 25)) opts.nocase = true;
+  return { pattern: segments.map((s) => s.text).join("/"), opts, segments, hasGlob };
+}
+
+function validName(s) {
+  return s !== "" && s !== "." && s !== ".." && !s.includes("/") && !s.includes("\0") && !s.includes("\n");
+}
+
+/** Candidate paths for a pattern: solutions built from the atoms, their mutations, and random paths. */
+export function genCandidates(tc, pat) {
+  const out = new Set();
+  const solve = () => {
+    const parts = [];
+    for (const seg of pat.segments) {
+      if (seg.atoms === null) {
+        const k = n(tc, 0, 2);
+        for (let i = 0; i < k; i++) parts.push(chance(tc, 15) ? "." + word(tc, LOWER, 1, 2) : word(tc, LOWER, 1, 2));
+        continue;
+      }
+      let s = "";
+      for (const a of seg.atoms) s += pick(tc, a.solutions);
+      parts.push(s);
+    }
+    return parts;
+  };
+  const mutate = (parts) => {
+    const p = parts.slice();
+    const r = n(tc, 0, 99);
+    if (p.length === 0 || r < 20) p.splice(n(tc, 0, p.length), 0, word(tc, NAME_CHARS, 1, 3));
+    else if (r < 35) p.splice(n(tc, 0, p.length - 1), 1);
+    else if (r < 55) {
+      const i = n(tc, 0, p.length - 1);
+      p[i] = p[i] + pick(tc, NAME_CHARS);
+    } else if (r < 70) {
+      const i = n(tc, 0, p.length - 1);
+      p[i] = p[i].slice(1);
+    } else if (r < 85) {
+      const i = n(tc, 0, p.length - 1);
+      p[i] = "." + p[i];
+    } else {
+      const i = n(tc, 0, p.length - 1);
+      p[i] = chance(tc, 50) ? p[i].toUpperCase() : p[i].toLowerCase();
+    }
+    return p;
+  };
+  const add = (parts) => {
+    if (parts.length === 0 || parts.length > 6 || !parts.every(validName)) return;
+    out.add(parts.join("/"));
+  };
+  const total = n(tc, 4, 12);
+  for (let i = 0; i < total; i++) {
+    const s = solve();
+    if (chance(tc, 45)) add(s);
+    else if (chance(tc, 80)) add(mutate(s));
+    else {
+      const k = n(tc, 1, 3);
+      const p = [];
+      for (let j = 0; j < k; j++) p.push(word(tc, NAME_CHARS, 1, 4));
+      add(p);
+    }
+  }
+  return [...out];
+}
+
+// ---------------------------------------------------------------- the oracle
+
+const SCRIPT = `
+shopt -s globstar extglob nullglob
+shopt -u failglob dotglob nocaseglob
+[ "$3" = 1 ] && shopt -s dotglob
+[ "$4" = 1 ] && shopt -s nocaseglob
+cd "$1" || exit 3
+pat=$2
+eval "printf '%s\\\\n' $pat"
+`;
+
+let scratch = null;
+
+/**
+ * bash's filename globbing of \`pattern\` over a tree holding exactly \`paths\` (a path that is a prefix of
+ * another is a directory, the rest are files): {ok, matched: Set, dirs: Set} or {ok: false, error}.
+ * bash lists a matched directory with a trailing slash when the pattern ends in "/" or "/**"; the
+ * slash is stripped here and minimatch is given the directory paths with a trailing slash instead.
+ */
+export function bashGlob(pattern, paths, { dot = false, nocase = false } = {}) {
+  scratch ??= (() => {
+    const dir = mkdtempSync(join(tmpdir(), "hegel-glob-"));
+    process.on("exit", () => {
+      try { rmSync(dir, { recursive: true, force: true }); } catch {}
+    });
+    return dir;
+  })();
+  const root = join(scratch, "t");
+  rmSync(root, { recursive: true, force: true });
+  mkdirSync(root);
+  // a path that is a prefix of another becomes a directory; the rest are files
+  const sorted = [...paths].sort();
+  const dirs = new Set();
+  for (const p of sorted) {
+    const isDir = sorted.some((q) => q !== p && q.startsWith(p + "/"));
+    if (isDir) dirs.add(p);
+    if (isDir) mkdirSync(join(root, p), { recursive: true });
+    else {
+      mkdirSync(dirname(join(root, p)), { recursive: true });
+      writeFileSync(join(root, p), "");
+    }
+  }
+  try {
+    const out = execFileSync("bash", ["-c", SCRIPT, "--", root, pattern, dot ? "1" : "0", nocase ? "1" : "0"], {
+      env: { LC_ALL: "C", PATH: process.env.PATH },
+      stdio: ["ignore", "pipe", "pipe"],
+    }).toString();
+    const matched = new Set();
+    for (const line of out.split("\n")) {
+      if (line === "") continue;
+      matched.add(line.replace(/\/+$/, ""));
+    }
+    return { ok: true, matched, dirs };
+  } catch (e) {
+    return { ok: false, error: (e.stderr ? e.stderr.toString() : String(e)).trim().split("\n")[0] };
+  }
+}
+
+// ---------------------------------------------------------------- brace expressions
+
+const BRACE_WORD = "abcxyz01".split("");
+
+function genBraceItem(tc, depth) {
+  const r = n(tc, 0, 99);
+  if (r < 55 || depth >= 2) return word(tc, BRACE_WORD, 0, 3);
+  if (r < 80) {
+    // a sequence expression: numbers (possibly negative or zero-padded) or letters, optional step
+    if (chance(tc, 60)) {
+      const a = n(tc, -3, 12);
+      const b = n(tc, -3, 12);
+      const pad = chance(tc, 25) ? "0" : "";
+      const step = chance(tc, 30) ? `..${n(tc, -3, 3)}` : "";
+      return `{${a < 0 ? "-" + pad + -a : pad + a}..${b < 0 ? "-" + pad + -b : pad + b}${step}}`;
+    }
+    const a = pick(tc, "abcdxyz".split(""));
+    const b = pick(tc, "abcdxyz".split(""));
+    const step = chance(tc, 30) ? `..${n(tc, -2, 3)}` : "";
+    return `{${a}..${b}${step}}`;
+  }
+  return genBraceExpr(tc, depth + 1);
+}
+
+/** A brace expression over letters and digits: words, comma lists (possibly nested, possibly with a single or empty item), sequences. */
+export function genBraceExpr(tc, depth = 0) {
+  let out = word(tc, BRACE_WORD, 0, 2);
+  const groups = n(tc, 1, depth ? 1 : 2);
+  for (let g = 0; g < groups; g++) {
+    const k = n(tc, 1, 3);
+    const items = [];
+    for (let i = 0; i < k; i++) items.push(genBraceItem(tc, depth));
+    out += k === 1 && chance(tc, 50) ? items[0] : `{${items.join(",")}}`;
+    out += word(tc, BRACE_WORD, 0, 2);
+  }
+  return out;
+}
+
+/** bash's brace expansion of \`expr\` (letters, digits, braces, commas, dots and minus signs only), in order. */
+export function bashBraceExpand(expr) {
+  if (!/^[A-Za-z0-9{},.\-]*$/.test(expr)) throw new Error(`unsafe brace expression ${JSON.stringify(expr)}`);
+  const out = execFileSync("bash", ["-c", `set -f; printf '%s\\0' ${expr}`], { env: { LC_ALL: "C", PATH: process.env.PATH } }).toString();
+  const parts = out.split("\0");
+  parts.pop();
+  return parts;
+}
diff --git a/test/hegel-zoo.mjs b/test/hegel-zoo.mjs
new file mode 100644
index 0000000..ef914e1
--- /dev/null
+++ b/test/hegel-zoo.mjs
@@ -0,0 +1,138 @@
+// Hegel zoo: the small harness shared by the zoo's TypeScript/JavaScript targets.
+//
+// `property(name, body)` registers a node:test test that runs `body(tc)` under Hegel with
+// HEGEL_TEST_CASES cases (default 100) and the database at HEGEL_DATABASE. With ZOO_COLLECT=1
+// a `fail()` records the mismatch instead of failing, the case ends there, and the counts of
+// mismatches and of the shapes seen (`count(key)`) are printed at the end of the test, so a
+// property can be run over many cases to see every shape at once. `pin(name, body)` is a
+// plain test for one pinned bug: it must fail while the bug is present and pass once it is
+// fixed (the zoo's judge reads an unexpected pass as "fixed upstream?").
+
+import { readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { test as nodeTest } from "node:test";
+import * as hegel from "@hegeldev/hegel";
+import * as gs from "@hegeldev/hegel/generators";
+
+// The Hegel version these tests were written against (the zoo pins it in zoo.toml and installs
+// it with `npm install --no-save @hegeldev/hegel@<version>`; upstream would add it to
+// devDependencies). Checked at load time so a stray install cannot silently change the engine.
+export const HEGEL_PIN = { "@hegeldev/hegel": "0.4.5" };
+
+{
+  let dir = dirname(fileURLToPath(import.meta.resolve("@hegeldev/hegel")));
+  while (!/[\\/]hegel$/.test(dir) && dir !== dirname(dir)) dir = dirname(dir);
+  const installed = JSON.parse(readFileSync(join(dir, "package.json"), "utf8")).version;
+  if (installed !== HEGEL_PIN["@hegeldev/hegel"]) {
+    throw new Error(`@hegeldev/hegel ${installed} is installed; these tests pin ${HEGEL_PIN["@hegeldev/hegel"]}`);
+  }
+}
+
+export const collecting = !!process.env.ZOO_COLLECT;
+
+class Collected extends Error {}
+
+let msgs = [];
+let stats = new Map();
+
+/** Report a mismatch: an error normally, a recorded line in collect mode. */
+export function fail(message) {
+  if (collecting) {
+    msgs.push(message);
+    throw new Collected(message);
+  }
+  throw new Error(message);
+}
+
+/** Bump a statistic (the shape of a pinned bug, a generator branch). */
+export function count(key) {
+  stats.set(key, (stats.get(key) || 0) + 1);
+}
+
+function settings() {
+  const s = { testCases: Number(process.env.HEGEL_TEST_CASES) || 100 };
+  if (process.env.HEGEL_DATABASE) {
+    s.database = hegel.Database.fromPath(process.env.HEGEL_DATABASE);
+  }
+  return s;
+}
+
+/** A property: `body(tc)` runs under Hegel; a thrown error (or `fail`) is a failure. */
+export function property(name, body) {
+  nodeTest(name, () => {
+    msgs = [];
+    stats = new Map();
+    hegel.test((tc) => {
+      try {
+        body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** A pin: a plain test for one recorded bug. */
+export function pin(name, body) {
+  nodeTest(name, body);
+}
+
+/** An integer in [lo, hi]. */
+export function n(tc, lo, hi) {
+  return tc.draw(gs.integers({ minValue: lo, maxValue: hi }));
+}
+
+/** One of xs. */
+export function pick(tc, xs) {
+  return xs[n(tc, 0, xs.length - 1)];
+}
+
+/** True pct percent of the time. */
+export function chance(tc, pct) {
+  return n(tc, 0, 99) < pct;
+}
+
+/** A string of `len` characters drawn from `alphabet` (an array of strings). */
+export function word(tc, alphabet, lo, hi) {
+  const len = n(tc, lo, hi);
+  let s = "";
+  for (let i = 0; i < len; i++) {
+    s += pick(tc, alphabet);
+  }
+  return s;
+}
+
+/** Structural equality: arrays by position, objects by key set (prototype ignored), else ===. */
+export function same(a, b) {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) {
+      return false;
+    }
+    return a.every((x, i) => same(x, b[i]));
+  }
+  if (a !== null && b !== null && typeof a === "object" && typeof b === "object") {
+    const ka = Object.keys(a).sort();
+    const kb = Object.keys(b).sort();
+    if (ka.length !== kb.length || ka.some((k, i) => k !== kb[i])) {
+      return false;
+    }
+    return ka.every((k) => same(a[k], b[k]));
+  }
+  return a === b;
+}
+
+/** A compact, unambiguous rendering for messages. */
+export function show(x) {
+  return JSON.stringify(x, (k, v) => (v === undefined ? "<undefined>" : v));
+}
diff --git a/test/hegel.test.mjs b/test/hegel.test.mjs
new file mode 100644
index 0000000..faa65c3
--- /dev/null
+++ b/test/hegel.test.mjs
@@ -0,0 +1,361 @@
+// Hegel zoo: property tests for minimatch (see README.md of the target).
+//
+// Run with `node --test --test-reporter=tap test/hegel.test.mjs` after the setup in target.toml
+// (npm install of Hegel, TypeScript and brace-expansion; tsc of src/ into .hegel/dist).
+// HEGEL_TEST_CASES sets the budget, ZOO_COLLECT=1 records mismatches instead of failing at the first.
+// The differential properties need bash (>= 4.4, globstar/extglob).
+
+import assert from "node:assert/strict";
+import { createRequire } from "node:module";
+import { chance, count, fail, n, pick, pin, property, show, word } from "./hegel-zoo.mjs";
+import { bashBraceExpand, bashGlob, genBraceExpr, genCandidates, genPattern } from "./hegel-glob.mjs";
+
+const require = createRequire(import.meta.url);
+const { minimatch, Minimatch, braceExpand, escape, unescape, filter, makeRe, match } = require("../.hegel/dist/index.js");
+
+// Shapes of the recorded bugs (bugs.toml): a property skips a case that has one and stays strict
+// on everything else; each has a pin below.
+const Known = {
+  // minimatch/1: escape() leaves a leading "!" (negation) or "#" (comment) alone
+  escapeLeavesNegationOrComment: (s) => /^[!#]/.test(s),
+  // minimatch/2: a "#", "-", "," or space in a pattern with a POSIX class is regex-escaped ("\#", "\-"), which is
+  // invalid under the u flag the class needs: SyntaxError from minimatch(), false from makeRe()
+  hashWithPosixClass: (pattern) => /[#, -]/.test(pattern) && /\[[!^]?\[:/.test(pattern),
+  // minimatch/3: the fast-path test for "*<literal>"/"?<literal>" parts keeps the backslash of an escaped character
+  escapeAfterWildcardFastPath: (pattern) => pattern.split("/").some((seg) => /^[*?]+(?:[^*?[\]{}()\\]|\\.)*\\./.test(seg)),
+  // minimatch/4: makeRe() drops a trailing "/**" when an earlier segment is "**"
+  trailingGlobstarDropped: (pattern) => {
+    const segs = pattern.split("/");
+    return segs.length > 2 && segs[segs.length - 1] === "**" && segs.slice(0, -1).includes("**");
+  },
+  // minimatch/5: makeRe()'s "**" admits a dotfile directly below its parent
+  globstarDotfileInRegex: (pattern, path, opts) => !opts.dot && pattern.includes("**") && path.split("/").some((seg) => seg.startsWith(".")),
+  // minimatch/6: makeRe() of "a/**" matches "a", match() does not
+  trailingGlobstarMatchesParentInRegex: (pattern) => pattern.endsWith("/**"),
+  // minimatch/7 (brace-expansion): a comma-less brace pair stops the expansion of what follows or of what it contains
+  literalBraceStopsExpansion: (expr) => /\{[^{},]*\}/.test(expr.replace(/\{-?\w+\.\.-?\w+(?:\.\.-?\d+)?\}/g, "S")),
+  // minimatch/8: a star after a leading extglob that can match the empty string matches dotfiles
+  dotLeakThroughEmptyGroup: (pattern, path, opts) =>
+    !opts.dot && path.split("/").some((s) => s.startsWith(".")) && pattern.split("/").some((s) => /^(?:[*?]\(|@\()/.test(s)),
+  // minimatch/9: a trailing slash on the path satisfies a final "?(...)" or "*(...)" part
+  trailingSlashSatisfiesOptionalExtglob: (pattern) => /^[?*]\(/.test(pattern.split("/").pop()),
+};
+
+function mm(path, pattern, opts) {
+  try {
+    return minimatch(path, pattern, opts);
+  } catch (e) {
+    fail(`minimatch threw ${e.constructor.name}: ${e.message} for ${show(pattern)} on ${show(path)} ${show(opts)}`);
+  }
+}
+
+const NAME = "abcxyzABX01._-*?[]{}(),!#@+\\/ ".split("");
+const noDots = (p) => p.split("/").every((s) => s !== "" && s !== "." && s !== "..");
+
+// ---------------------------------------------------------------- bash differential
+
+property("TestHegelMatchesLikeBashGlobbing", (tc) => {
+  const pat = genPattern(tc);
+  const paths = genCandidates(tc, pat);
+  if (paths.length === 0) return;
+  if (Known.hashWithPosixClass(pat.pattern)) {
+    count("known/minimatch-2");
+    return;
+  }
+  const bash = bashGlob(pat.pattern, paths, pat.opts);
+  if (!bash.ok) {
+    count("skip/bash-rejects-pattern");
+    return;
+  }
+  if (pat.opts.dot) count("opt/dot");
+  if (pat.opts.nocase) count("opt/nocase");
+  const diffs = [];
+  for (const p of paths) {
+    // a directory is presented to minimatch with a trailing slash, as bash lists it
+    const mine = mm(bash.dirs.has(p) ? p + "/" : p, pat.pattern, pat.opts);
+    const theirs = bash.matched.has(p);
+    if (mine === theirs) continue;
+    if (!mine && Known.escapeAfterWildcardFastPath(pat.pattern)) {
+      count("known/minimatch-3");
+      continue;
+    }
+    if (mine && Known.dotLeakThroughEmptyGroup(pat.pattern, p, pat.opts)) {
+      count("known/minimatch-8");
+      continue;
+    }
+    diffs.push(`${show(p)}: minimatch ${mine}, bash ${theirs}`);
+  }
+  if (diffs.length) fail(`pattern ${show(pat.pattern)} ${show(pat.opts)} over ${show(paths)}\n  ${diffs.join("\n  ")}`);
+});
+
+// ---------------------------------------------------------------- brace expansion differential
+
+property("TestHegelBraceExpansionAgreesWithBash", (tc) => {
+  const expr = genBraceExpr(tc);
+  if (expr === "") return;
+  let theirs = bashBraceExpand(expr);
+  // bash removes empty words; printf without arguments still prints one empty field
+  if (theirs.length === 1 && theirs[0] === "") theirs = [];
+  let mine;
+  try {
+    mine = braceExpand(expr);
+  } catch (e) {
+    fail(`braceExpand threw ${e.message} for ${show(expr)}`);
+  }
+  if (theirs.length > 1) count("expands");
+  if (show(mine) !== show(theirs)) {
+    if (Known.literalBraceStopsExpansion(expr)) {
+      count("known/minimatch-7");
+      return;
+    }
+    fail(`braceExpand(${show(expr)}) = ${show(mine)}, bash ${show(theirs)}`);
+  }
+  if (show(braceExpand(expr, { nobrace: true })) !== show([expr])) fail(`braceExpand(${show(expr)}, {nobrace}) = ${show(braceExpand(expr, { nobrace: true }))}`);
+  // the Minimatch set has one row per distinct expansion at most
+  const m = new Minimatch(expr);
+  if (m.set.length > new Set(theirs).size) fail(`new Minimatch(${show(expr)}).set has ${m.set.length} rows for ${new Set(theirs).size} expansions`);
+  // every expansion is matched by the expression, literally
+  for (const e of theirs) {
+    if (e !== "" && !mm(e, expr)) fail(`${show(expr)} does not match its own expansion ${show(e)}`);
+  }
+});
+
+// ---------------------------------------------------------------- the API agrees with itself
+
+property("TestHegelApiIsConsistent", (tc) => {
+  const pat = genPattern(tc);
+  const paths = genCandidates(tc, pat);
+  const opts = { ...pat.opts };
+  const text = pat.pattern;
+  if (Known.hashWithPosixClass(text)) {
+    count("known/minimatch-2");
+    return;
+  }
+  const m = new Minimatch(text, opts);
+  const re = makeRe(text, opts);
+  const flt = filter(text, opts);
+  const matched = match(paths, text, opts);
+  if (m.negate || m.comment || m.empty) fail(`flags ${show({ negate: m.negate, comment: m.comment, empty: m.empty })} for ${show(text)}`);
+  if (m.set.length < 1) fail(`empty set for ${show(text)}`);
+  for (const p of paths) {
+    const a = mm(p, text, opts);
+    const b = m.match(p);
+    const c = flt(p);
+    const d = matched.includes(p);
+    const e = re && re.test(p);
+    if (a !== b || a !== c || a !== d) fail(`minimatch ${a}, Minimatch.match ${b}, filter ${c}, match(list) ${d} for ${show(text)} on ${show(p)} ${show(opts)}`);
+    if (re === false) fail(`makeRe(${show(text)}) is false although the pattern is valid`);
+    else if (a !== e) {
+      if (!a && Known.escapeAfterWildcardFastPath(text)) count("known/minimatch-3");
+      else if (!e && Known.trailingGlobstarDropped(text)) count("known/minimatch-4");
+      else if (e && Known.globstarDotfileInRegex(text, p, opts)) count("known/minimatch-5");
+      else if (e && Known.trailingGlobstarMatchesParentInRegex(text)) count("known/minimatch-6");
+      else fail(`makeRe: ${e}, match ${a} for ${show(text)} on ${show(p)} ${show(opts)}`);
+    }
+    // negation, nonegate, flipNegate (a prefix takes the first part off the fast path: skipped under minimatch/3)
+    if (Known.escapeAfterWildcardFastPath(text)) {
+      count("known/minimatch-3");
+      continue;
+    }
+    const neg = mm(p, "!" + text, opts);
+    if (neg !== !a) fail(`"!" + pattern: ${neg}, pattern: ${a} for ${show(text)} on ${show(p)} ${show(opts)}`);
+    if (mm(p, "!" + text, { ...opts, flipNegate: true }) !== a) fail(`flipNegate: "!" + pattern differs from pattern for ${show(text)} on ${show(p)}`);
+    // a leading "!" or "#" made literal; prefixing changes the meaning of a first segment "**", so those are left out
+    const prefixable = pat.segments[0].atoms !== null && pat.segments[0].text !== "**" && !p.startsWith(".");
+    if (prefixable && mm("!" + p, "!" + text, { ...opts, nonegate: true }) !== a) fail(`nonegate: "!" + pattern on "!" + path ${mm("!" + p, "!" + text, { ...opts, nonegate: true })}, pattern on path ${a} for ${show(text)} on ${show(p)}`);
+    // comments
+    if (mm("#" + p, "#" + text, opts) !== false) fail(`"#" + pattern is not a comment for ${show(text)}`);
+    if (Known.hashWithPosixClass("#" + text)) count("known/minimatch-2");
+    else {
+      if (prefixable && mm("#" + p, "#" + text, { ...opts, nocomment: true }) !== a) fail(`nocomment: "#" + pattern on "#" + path differs from pattern on path for ${show(text)} on ${show(p)}`);
+      if (prefixable && mm("#" + p, "\\#" + text, opts) !== a) fail(`"\\#" + pattern on "#" + path ${mm("#" + p, "\\#" + text, opts)}, pattern on path ${a} for ${show(text)} on ${show(p)}`);
+    }
+    // optimization levels agree on plain paths and patterns (an expansion with a "." or ".." segment is
+    // folded differently per level, as documented)
+    const dotty = braceExpand(text).some((e) => e.split("/").some((seg) => ["", ".", ".."].includes(seg.replace(/\\(.)/g, "$1"))));
+    for (const lvl of dotty ? [] : [0, 2]) {
+      const l = mm(p, text, { ...opts, optimizationLevel: lvl });
+      if (l !== a) fail(`optimizationLevel ${lvl}: ${l}, default ${a} for ${show(text)} on ${show(p)} ${show(opts)}`);
+    }
+    // a trailing slash on the path and doubled slashes are ignored by default
+    // (a last brace part with an empty alternative legitimately matches the empty segment after the slash)
+    const lastPart = text.split("/").pop();
+    if (!text.endsWith("/**") && !/\{,|,,|,\}/.test(lastPart) && mm(p + "/", text, opts) !== a) {
+      if (!a && Known.trailingSlashSatisfiesOptionalExtglob(text)) count("known/minimatch-9");
+      else fail(`trailing slash: ${mm(p + "/", text, opts)} vs ${a} for ${show(text)} on ${show(p)} ${show(opts)}`);
+    }
+    if (p.includes("/") && mm(p.replace("/", "//"), text, opts) !== a) fail(`doubled slash: ${mm(p.replace("/", "//"), text, opts)} vs ${a} for ${show(text)} on ${show(p)} ${show(opts)}`);
+    // backslashes are separators in paths on win32
+    if (p.includes("/") && !p.includes("\\") && !text.includes("\\")) {
+      const w = mm(p.replace(/\//g, "\\"), text, { ...opts, platform: "win32" });
+      if (w !== a) fail(`win32: ${w} for ${show(p.replace(/\//g, "\\"))}, posix ${a} for ${show(p)} with ${show(text)} ${show(opts)}`);
+    }
+    // partial: every prefix of a matching path is a partial match
+    if (a) {
+      const segs = p.split("/");
+      for (let k = 1; k < segs.length; k++) {
+        const prefix = segs.slice(0, k).join("/");
+        if (!mm(prefix, text, { ...opts, partial: true })) fail(`partial: ${show(prefix)} is not a partial match of ${show(text)} although ${show(p)} matches ${show(opts)}`);
+      }
+    }
+    // nocase equals lower-casing both sides (ASCII letters, no bracket expressions)
+    if (!opts.nocase && !/[\[]/.test(text)) {
+      const nc = mm(p, text, { ...opts, nocase: true });
+      const lc = mm(p.toLowerCase(), text.toLowerCase(), opts);
+      if (nc !== lc) fail(`nocase: ${nc}, lower-cased ${lc} for ${show(text)} on ${show(p)} ${show(opts)}`);
+    }
+    // matchBase: a pattern without slashes is matched against the basename
+    if (!text.includes("/") && p.includes("/")) {
+      const bn = mm(p, text, { ...opts, matchBase: true });
+      const base = mm(p.slice(p.lastIndexOf("/") + 1), text, opts);
+      if (bn !== base) fail(`matchBase: ${bn}, basename match ${base} for ${show(text)} on ${show(p)} ${show(opts)}`);
+    }
+    // noglobstar: "**" parts become "*"
+    if (text.includes("**")) {
+      const ng = mm(p, text, { ...opts, noglobstar: true });
+      const star = mm(p, text.split("/").map((s) => (s === "**" ? "*" : s)).join("/"), opts);
+      if (ng !== star) fail(`noglobstar: ${ng}, with "*" ${star} for ${show(text)} on ${show(p)} ${show(opts)}`);
+    }
+  }
+  // hasMagic: true iff some part is not a literal string; braces count only with magicalBraces
+  // (a bracket expression with a single character, "[-]" or "[a]", parses to a literal: documented under hasMagic)
+  const kinds = new Set();
+  let braceMagic = false;
+  let innerMagic = false;
+  for (const s of pat.segments) {
+    if (s.atoms === null) kinds.add("globstar");
+    else for (const a of s.atoms) {
+      kinds.add(a.kind === "bracket" && /^\[(?:\\.|[^\\])\]$/.test(a.text) ? "lit" : a.kind);
+      if (a.kind === "brace" && /[*?[]/.test(a.text)) braceMagic = true;
+      if (a.kind === "extglob" && /[*?[]/.test(a.text.slice(2))) innerMagic = true;
+    }
+  }
+  const magic = [...kinds].some((k) => k !== "lit" && k !== "escape" && k !== "brace") || braceMagic;
+  // (under nocase the literal parts become case-insensitive regexes, so hasMagic is checked without options)
+  const plain = new Minimatch(text);
+  if (plain.hasMagic() !== magic) fail(`hasMagic() is ${plain.hasMagic()} for ${show(text)} (${[...kinds].join(",")})`);
+  if (kinds.has("brace") && !magic && new Minimatch(text, { magicalBraces: true }).hasMagic() !== (plain.set.length > 1)) fail(`hasMagic() with magicalBraces is ${new Minimatch(text, { magicalBraces: true }).hasMagic()} for ${show(text)} with ${plain.set.length} rows`);
+  // disabled features are literal
+  const only = (k) => [...kinds].every((x) => x === "lit" || x === k);
+  if (only("extglob") && kinds.has("extglob") && !innerMagic && !mm(text, text, { ...opts, noext: true })) fail(`noext: ${show(text)} does not match itself`);
+  if (only("brace") && kinds.has("brace") && !braceMagic && !mm(text, text, { ...opts, nobrace: true })) fail(`nobrace: ${show(text)} does not match itself`);
+  if (!pat.hasGlob) {
+    const lit = pat.segments.map((s) => s.atoms.map((a) => a.solutions[0]).join("")).join("/");
+    if (!mm(lit, text, opts)) fail(`literal ${show(text)} does not match ${show(lit)}`);
+    for (const p of paths) {
+      const want = opts.nocase ? p.toLowerCase() === lit.toLowerCase() : p === lit;
+      if (mm(p, text, opts) !== want) fail(`literal ${show(text)} on ${show(p)}: ${mm(p, text, opts)}, want ${want} ${show(opts)}`);
+    }
+  }
+});
+
+// ---------------------------------------------------------------- escape and unescape
+
+property("TestHegelEscapeMakesALiteralPattern", (tc) => {
+  const s = word(tc, NAME, 1, 8);
+  const braces = { magicalBraces: true };
+  const esc = escape(s, braces);
+  if (Known.escapeLeavesNegationOrComment(s)) {
+    count("known/minimatch-1");
+    return;
+  }
+  // the escaped pattern matches the string itself and nothing else
+  if (!mm(s, esc, braces)) fail(`escape(${show(s)}) = ${show(esc)} does not match ${show(s)}`);
+  if (new Minimatch(esc, braces).hasMagic()) fail(`escape(${show(s)}) = ${show(esc)} has magic`);
+  const k = n(tc, 1, 3);
+  for (let i = 0; i < k; i++) {
+    let other = s;
+    const r = n(tc, 0, 2);
+    const at = n(tc, 0, s.length - 1);
+    if (r === 0) other = s.slice(0, at) + pick(tc, NAME) + s.slice(at);
+    else if (r === 1) other = s.slice(0, at) + s.slice(at + 1);
+    else other = s.slice(0, at) + pick(tc, NAME) + s.slice(at + 1);
+    if (other === s || other === "") continue;
+    // slashes are path syntax: doubled, leading and trailing slashes are not distinctions
+    const norm = (x) => x.replace(/\/+/g, "/").replace(/\/$/, "");
+    if (norm(other) === norm(s)) continue;
+    if (mm(other, esc, braces)) fail(`escape(${show(s)}) = ${show(esc)} also matches ${show(other)}`);
+  }
+  // unescape undoes escape, in both brace modes
+  if (unescape(esc, braces) !== s) fail(`unescape(escape(${show(s)})) = ${show(unescape(esc, braces))} with magicalBraces`);
+  const plain = escape(s);
+  if (unescape(plain, { magicalBraces: false }) !== s) fail(`unescape(escape(${show(s)})) = ${show(unescape(plain, { magicalBraces: false }))} without magicalBraces`);
+  if (!/[{}]/.test(s) && !mm(s, plain)) fail(`escape(${show(s)}) = ${show(plain)} (default mode) does not match ${show(s)}`);
+});
+
+// ---------------------------------------------------------------- pins
+
+// minimatch/1
+pin("TestHegelPinEscapeNeutralisesALeadingBangOrHash", () => {
+  assert.equal(minimatch("a*b", escape("a*b")), true);
+  assert.equal(minimatch("#a", escape("#a")), true);
+  assert.equal(minimatch("!a", escape("!a")), true);
+  assert.equal(minimatch("xyz", escape("!a")), false);
+});
+
+// minimatch/2
+pin("TestHegelPinHashWithAPosixClassIsAValidPattern", () => {
+  assert.equal(minimatch("x#c", "*#c"), true);
+  assert.equal(minimatch("-y7", "-y[0-9]"), true);
+  assert.equal(minimatch("-y7", "-y[[:digit:]]"), true);
+  assert.equal(minimatch("x#c", "[[:lower:]]#c"), true);
+  assert.ok(makeRe("yy/[[:upper:]]/dzx-") instanceof RegExp);
+});
+
+// minimatch/3
+pin("TestHegelPinEscapedCharacterAfterAStarMatches", () => {
+  assert.equal(minimatch("0}", "0\\}"), true);
+  assert.equal(minimatch("01}", "*1\\}"), true);
+  assert.equal(minimatch("0}", "?\\}"), true);
+  assert.equal(minimatch("0.", "*\\."), true);
+  assert.equal(minimatch("0a", "*\\a"), true);
+});
+
+// minimatch/4
+pin("TestHegelPinMakeReKeepsATrailingGlobstarAfterAnotherGlobstar", () => {
+  assert.equal(minimatch("a/x/b/y", "a/**/b/**"), true);
+  assert.equal(makeRe("a/*/b/**").test("a/x/b/y"), true);
+  assert.equal(makeRe("a/**/b/**").test("a/x/b/y"), true);
+});
+
+// minimatch/5
+pin("TestHegelPinMakeReGlobstarSkipsDotfilesBelowTheParent", () => {
+  assert.equal(minimatch("a/.b", "a/**"), false);
+  assert.equal(makeRe("a/**").test("a/x/.b"), false);
+  assert.equal(makeRe("a/**").test("a/.b"), false);
+  assert.equal(makeRe("a/**/c").test("a/.b/c"), false);
+});
+
+// minimatch/6
+pin("TestHegelPinMakeReAgreesWithMatchOnTheGlobstarParent", () => {
+  assert.equal(makeRe("a/**").test("a/"), minimatch("a/", "a/**"));
+  assert.equal(makeRe("a/**").test("a"), minimatch("a", "a/**"));
+});
+
+// minimatch/7 (brace-expansion)
+pin("TestHegelPinStarAfterAnEmptyGroupSkipsDotfiles", () => {
+  assert.equal(minimatch(".a", "*"), false);
+  assert.equal(minimatch(".a", "[b]*"), false);
+  assert.equal(minimatch(".a", "*(b)*"), false);
+  assert.equal(minimatch(".a", "?(b)*"), false);
+  assert.equal(minimatch(".a", "@(b|)*"), false);
+  assert.equal(minimatch("x/.a", "x/*(b)*"), false);
+});
+
+// minimatch/9
+pin("TestHegelPinATrailingSlashDoesNotSatisfyAnOptionalExtglob", () => {
+  assert.equal(minimatch("a/b/", "a/b/*"), false);
+  assert.equal(minimatch("a/b/", "a/b/@(x|)"), false);
+  assert.equal(minimatch("a/b/", "a/b/?(x)"), false);
+  assert.equal(minimatch("a/b/", "a/b/*(x)"), false);
+  assert.equal(minimatch("a/b/", "**/?(x)"), false);
+});
+
+// minimatch/7 (brace-expansion)
+pin("TestHegelPinALiteralBracePairDoesNotStopBraceExpansion", () => {
+  assert.deepEqual(braceExpand("{ac}{a,b}"), ["{ac}a", "{ac}b"]);
+  assert.deepEqual(braceExpand("{ac}{1..3}"), ["{ac}1", "{ac}2", "{ac}3"]);
+  assert.deepEqual(braceExpand("{{1..3}}"), ["{1}", "{2}", "{3}"]);
+});
+
+void chance;
