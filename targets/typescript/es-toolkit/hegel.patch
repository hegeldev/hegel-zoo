+// Hegel zoo: property tests for es-toolkit/compat against lodash 4.17.21, the library it promises
+// to mirror ("100% feature parity"). Every case draws inputs and calls the same function in both
+// libraries; the results (or the class of the error thrown) must agree. The inputs stay within the
+// shapes @types/lodash allows, since upstream only fixes differences reachable from typed code.
+
+import assert from "node:assert/strict";
+import { createRequire } from "node:module";
+import { property, pin, fail, count, n, pick, chance, word } from "./hegel-zoo.mjs";
+
+const require = createRequire(import.meta.url);
+// the CommonJS build of src/ made by the setup (see test/tsconfig.hegel.json)
+const C = require("../.hegel/dist/compat/index.js");
+const L = require("../.hegel/node_modules/lodash");
+
+// ---------------------------------------------------------------------------------------------
+// Known bugs (see bugs.toml) and accepted differences. Properties skip these shapes; pins assert
+// lodash's behaviour and fail while a bug exists.
+
+const Known = {
+  // es-toolkit/1: array functions split a string into code points (`[...str]`), lodash into UTF-16
+  // code units: compact("😀a") is ["😀", "a"] against ["\ud83d", "\ude00", "a"]
+  stringCodePoints: true,
+  // es-toolkit/2: an array-like object ({length: 2, 0: "x", 1: "y", extra: 1}) is iterated as a list by
+  // transform/pickBy/omitBy (its `length` and other keys are dropped) and by shuffle/sampleSize/sample
+  // (lodash samples every own value, `length` included), while findLast visits the extra keys
+  arrayLikeAsList: true,
+  // es-toolkit/3: chunk and split lack lodash's iteratee-call guard: [[1, 2]].map(chunk) gives [[]]
+  // (the index is taken as the size), ["a-b"].map(split) gives [[]]
+  chunkSplitGuard: true,
+  // es-toolkit/4: clone/cloneDeep of an arguments object keeps a `length` key
+  cloneArgumentsLength: true,
+  // es-toolkit/5: invoke/method/methodOf with a path whose parent does not exist call the method on
+  // the object itself: invoke({}, "a.toString") is "[object Object]"
+  invokeMissingParent: true,
+  // es-toolkit/6: pad/padStart/padEnd throw a RangeError for an infinite length (lodash: no padding)
+  padInfinity: true,
+  // es-toolkit/7: truncate(s, {length: undefined}) uses the default 30 (lodash: 0, so "...")
+  truncateUndefinedLength: true,
+  // es-toolkit/8: remove() on a string or array-like object throws a TypeError (lodash returns [])
+  removeThrows: true,
+  // es-toolkit/9: update/updateWith on a primitive throw a TypeError (lodash returns it unchanged)
+  updateOnPrimitive: true,
+  // es-toolkit/10: toPath differs from lodash on malformed paths: "[][\"a\"]" gives ["", "a"] (lodash
+  // ["a"]), "a]" gives ["a]"] (lodash ["a"]), "]" gives ["]"] (lodash [])
+  toPathMalformed: true,
+  // es-toolkit/11: the `_` available inside templates has no lodash functions (`_.map` is undefined)
+  templateImports: true,
+  // es-toolkit/12: clamp(-0, 0, upper) is 0, lodash keeps -0
+  clampNegativeZero: true,
+  // es-toolkit/13: merge/mergeWith copy symbol-keyed properties (lodash copies string keys only)
+  mergeSymbolKeys: true,
+  // es-toolkit/14: assign/assignIn/extend/assignWith/conformsTo throw a TypeError on a primitive or
+  // null target (lodash boxes the primitive, or starts from {} for null)
+  assignOnPrimitive: true,
+  // es-toolkit/15: merge of a Date, Map, Set, RegExp, Error or typed array source value into a plain
+  // object target replaces it with a plain object (or array), lodash assigns the object itself
+  mergeExoticSource: true,
+  // es-toolkit/16: defaultsDeep leaves an undefined array element and keeps holes (lodash fills them)
+  defaultsDeepUndefined: true,
+  // es-toolkit/17: matchesProperty(path, null) matches an undefined value (lodash: null only)
+  matchesPropertyNull: true,
+  // es-toolkit/18: matchesProperty(path, false) matches any object value (partial comparison of an
+  // object against a primitive is true)
+  partialMatchPrimitive: true,
+  // es-toolkit/19: merge/mergeWith/defaults ignore the inherited enumerable properties of a source
+  // (lodash copies them: keysIn)
+  mergeInherited: true,
+  // es-toolkit/20: isMatch with a Map/Set source is false (lodash: a source without own keys matches)
+  isMatchExoticSource: true,
+  // es-toolkit/21: the type predicates decide by prototype or Symbol.toStringTag where lodash reads the
+  // object's tag: isArguments({[Symbol.toStringTag]: "Arguments"}) and isDate(Object.create(Date.prototype)) are true
+  typeTagPredicates: true,
+  // es-toolkit/22: isMatch (and the `matches` iteratee shorthand) compare Dates, RegExps, typed arrays and
+  // boxed primitives as empty objects: isMatch({a: new Date(0)}, {a: new Date(0)}) is false
+  isMatchExoticValues: true,
+  // es-toolkit/23: cloneWith/cloneDeepWith do not apply the customizer to Map/Set entries or
+  // typed-array elements
+  cloneWithCustomizer: true,
+  // es-toolkit/24: rest(f) with a variadic f (and rest(f, -1) or NaN) groups only the last argument;
+  // lodash clamps the start to max(f.length - 1, 0) and groups them all
+  restStart: true,
+  // es-toolkit/25: trim with astral `chars` strips lone surrogates: trim("\ud83dab", "😀") is "ab"
+  trimLoneSurrogate: true,
+  // es-toolkit/26: truncate with a string `separator` treats it as a regular expression source
+  // ("." matches any character, "(" throws a SyntaxError)
+  truncateStringSeparator: true,
+  // es-toolkit/27: sortBy/orderBy with a function iteratee order undefined before null (lodash: null
+  // first, like its property iteratees)
+  sortByNullUndefined: true,
+  // es-toolkit/28: cloneDeep returns functions, WeakMaps, Promises by reference and clones Errors as
+  // Errors; lodash gives {} for all of them (clone does)
+  cloneDeepUncloneable: true,
+  // es-toolkit/29: isEqual of Maps whose keys are equal objects is false (lodash matches keys deeply)
+  isEqualMapObjectKeys: true,
+  // es-toolkit/30: isPlainObject(Object.create(Object.create(null))) is true (lodash walks to the root)
+  isPlainObjectDeepNull: true,
+  // es-toolkit/31: toNumber of an object whose valueOf returns an object falls back to toString (9),
+  // lodash gives NaN
+  toNumberValueOfObject: true,
+  // es-toolkit/32: an array iteratee of length other than 2 is a `matches` pattern (lodash: always
+  // matchesProperty(a[0], a[1]))
+  iterateeArrayLength: true,
+  // es-toolkit/33: pad/padStart/padEnd/truncate/toArray/split("") count code points; lodash counts a
+  // base character with its combining marks, a ZWJ sequence, a flag or a VS16 sequence as one symbol
+  unicodeSymbolSize: true,
+  // es-toolkit/34: concat does not flatten `arguments` objects (flatten and lodash do)
+  concatArguments: true,
+  // es-toolkit/35: an own `__proto__` data key (JSON.parse output) becomes the PROTOTYPE of the result
+  // of cloneDeep/clone/omit/pick/pickBy/omitBy/mapValues/mapKeys/assign/assignIn/zipObject/
+  // defaultsDeep/groupBy/keyBy; lodash keeps it an own key
+  ownProtoKey: true,
+  // es-toolkit/36: cloneDeep keeps a null prototype on nested null-prototype objects (the root and
+  // lodash convert to ordinary objects)
+  cloneDeepNullPrototype: true,
+  // es-toolkit/37: sortBy and orderBy ignore an object (`matches`) iteratee: sortBy(recs, { id: 4 })
+  // keeps the order
+  sortByMatchesIteratee: true,
+  // es-toolkit/38: invert/invertBy throw on a value without toString (a null-prototype object);
+  // lodash keys it "[object Object]"
+  invertNoToString: true,
+  // es-toolkit/39: startsWith/endsWith return false for a null/undefined string and an empty
+  // target; lodash converts the string to "" and "" starts (and ends) with ""
+  startsWithNullish: true,
+  // es-toolkit/40: xorBy/xorWith with three or more arrays subtract only the intersections of
+  // adjacent pairs, so a value shared by the first and third array survives
+  xorByNonAdjacent: true,
+  // es-toolkit/41: cloneDeep/cloneDeepWith copy a boxed Symbol as a plain object over
+  // Symbol.prototype, so the clone has no symbol data (`valueOf()` throws)
+  cloneDeepBoxedSymbol: true,
+  // es-toolkit/42: get/has/hasIn/at/property/unset/pick/omit drop the empty segment of a string
+  // path ("a.", ".a") that compat's own toPath, set, invoke keep, as lodash does
+  emptyPathSegment: true,
+};
+const isArgs = (x) => Object.prototype.toString.call(x) === "[object Arguments]";
+const isObj = (v) => typeof v === "object" && v !== null;
+// a read-only (or getter-only) property somewhere on o's prototype chain: lodash's sloppy-mode
+// assignment to it is ignored, es-toolkit's strict-mode one throws (README)
+const readOnlyKey = (o, k) => {
+  for (let q = o; q != null; q = Object.getPrototypeOf(q)) {
+    const d = Object.getOwnPropertyDescriptor(q, k);
+    if (d) return d.writable === false || (d.get !== undefined && d.set === undefined);
+  }
+  return false;
+};
+const overwritesReadOnly = (target, ...sources) => target != null && typeof target === "object" && sources.some((src) => src != null && typeof src === "object" && Object.keys(src).some((k) => readOnlyKey(target, k)));
+
+// Deliberate or documented design differences, listed in the README and not counted:
+const Accepted = {
+  // es-toolkit's word splitter is Unicode-aware, lodash's knows ASCII and Latin-1
+  unicodeWords: true,
+  // sortedUniq/sortedUniqBy are documented as out of scope (docs/compat/intro.md) and not exported
+  sortedUniqOutOfScope: true,
+};
+// a base character with combining marks, a ZWJ sequence, a flag or a VS16 sequence: one lodash
+// "symbol", several code points
+const COMBINING = /[\u0300-\u036f\u20d0-\u20ff\ufe20-\ufe2f\u200d\ufe0f]|[\u{1F1E6}-\u{1F1FF}\u{1F3FB}-\u{1F3FF}]/u;
+const SYMBOL_SIZE_FNS = ["pad", "padStart", "padEnd", "truncate", "toArray", "split"];
+const symbolSized = (fn, x) => Known.unicodeSymbolSize && SYMBOL_SIZE_FNS.includes(fn) && typeof x === "string" && COMBINING.test(x);
+
+function isArrayLikeObject(x) {
+  return typeof x === "object" && x !== null && !Array.isArray(x) && typeof x.length === "number" && Object.prototype.toString.call(x) !== "[object Arguments]";
+}
+
+// ---------------------------------------------------------------------------------------------
+// Describing values so that both libraries' results can be compared as strings
+
+function describe(x, seen = []) {
+  if (x === undefined) return "undefined";
+  if (x === null) return "null";
+  if (typeof x === "number") return Object.is(x, -0) ? "-0" : String(x);
+  if (typeof x === "bigint") return `${x}n`;
+  if (typeof x === "string") return JSON.stringify(x);
+  if (typeof x === "symbol") return x.toString();
+  if (typeof x === "boolean") return String(x);
+  if (typeof x === "function") return `[Function${x.name ? " " + x.name : ""}]`;
+  if (seen.includes(x)) return "[Circular]";
+  seen = seen.concat([x]);
+  const tag = Object.prototype.toString.call(x).slice(8, -1);
+  try {
+    if (x instanceof Date) return `Date(${Number.isNaN(x.getTime()) ? "Invalid" : x.toISOString()})`;
+    if (x instanceof RegExp) return `RegExp(${x.toString()} lastIndex=${x.lastIndex})`;
+    if (x instanceof Error) return `${x.constructor.name}(${x.message})`;
+    if (x instanceof Map) return `Map{${[...x].map(([k, v]) => `${describe(k, seen)} => ${describe(v, seen)}`).join(", ")}}`;
+    if (x instanceof Set) return `Set{${[...x].map((v) => describe(v, seen)).join(", ")}}`;
+  } catch {
+    return `${tag}-like(${describe(Object.getPrototypeOf(x)?.constructor?.name)})`;
+  }
+  if (ArrayBuffer.isView(x) && !(x instanceof DataView)) return `${x.constructor.name}[${Array.from(x).join(",")}]`;
+  if (x instanceof ArrayBuffer) return `ArrayBuffer[${new Uint8Array(x).join(",")}]`;
+  if (["Number", "String", "Boolean", "Symbol", "BigInt"].includes(tag)) {
+    try {
+      return `${tag}(${describe(x.valueOf())})`;
+    } catch {
+      return `${tag}(?)`;
+    }
+  }
+  const proto = Object.getPrototypeOf(x);
+  const protoTag = proto === null ? "null" : proto === Object.prototype ? "" : proto === Array.prototype ? "" : proto.constructor?.name || "?";
+  const keys = Reflect.ownKeys(x);
+  const body = [];
+  if (Array.isArray(x) || tag === "Arguments") {
+    const items = [];
+    for (let i = 0; i < x.length; i++) items.push(i in x ? describe(x[i], seen) : "<hole>");
+    const extra = keys.filter((k) => Object.getOwnPropertyDescriptor(x, k).enumerable && (typeof k === "symbol" || (!/^\d+$/.test(k) && k !== "length")));
+    for (const k of extra) items.push(`${String(k)}: ${describe(x[k], seen)}`);
+    return `${tag === "Arguments" ? "Arguments" : protoTag}[${items.join(", ")}]`;
+  }
+  for (const k of keys) {
+    const d = Object.getOwnPropertyDescriptor(x, k);
+    if (!d.enumerable) continue;
+    body.push(`${typeof k === "symbol" ? k.toString() : JSON.stringify(k)}: ${describe(x[k], seen)}`);
+  }
+  return `${protoTag}{${body.join(", ")}}`;
+}
+
+function run(f, Impl) {
+  try {
+    return describe(f(Impl));
+  } catch (e) {
+    if (!(e instanceof Error)) return `THROW ${String(e)}`;
+    return `THROW ${e.constructor.name}`;
+  }
+}
+
+/** Run `f` in both libraries; fail with `what` if they disagree. Returns the description. */
+function same(what, f) {
+  const a = run(f, C);
+  const b = run(f, L);
+  if (a !== b) fail(`${what}\n  compat: ${a}\n  lodash: ${b}`);
+  return a;
+}
+
+/** Deep-copy a value so that mutating functions can be run on two identical inputs. */
+function copy(x, seen = new Map()) {
+  if (typeof x !== "object" || x === null) return x;
+  if (seen.has(x)) return seen.get(x);
+  let out;
+  if (Array.isArray(x)) {
+    out = new Array(x.length);
+    seen.set(x, out);
+    for (let i = 0; i < x.length; i++) if (i in x) out[i] = copy(x[i], seen);
+    for (const k of Object.keys(x)) if (!/^\d+$/.test(k)) out[k] = copy(x[k], seen);
+    return out;
+  }
+  if (x instanceof Date) return new Date(x.getTime());
+  if (x instanceof RegExp) {
+    out = new RegExp(x.source, x.flags);
+    out.lastIndex = x.lastIndex;
+    return out;
+  }
+  if (x instanceof Map) {
+    out = new Map();
+    seen.set(x, out);
+    for (const [k, v] of x) out.set(copy(k, seen), copy(v, seen));
+    return out;
+  }
+  if (x instanceof Set) {
+    out = new Set();
+    seen.set(x, out);
+    for (const v of x) out.add(copy(v, seen));
+    return out;
+  }
+  if (x instanceof DataView) return new DataView(x.buffer.slice(0), x.byteOffset, x.byteLength);
+  if (ArrayBuffer.isView(x)) return new x.constructor(x);
+  if (x instanceof ArrayBuffer) return x.slice(0);
+  if (["Number", "String", "Boolean", "Symbol", "BigInt"].includes(Object.prototype.toString.call(x).slice(8, -1))) return Object(x.valueOf());
+  out = Object.create(Object.getPrototypeOf(x));
+  seen.set(x, out);
+  for (const k of Reflect.ownKeys(x)) {
+    const d = Object.getOwnPropertyDescriptor(x, k);
+    if ("value" in d) d.value = copy(d.value, seen);
+    Object.defineProperty(out, k, d);
+  }
+  return out;
+}
+
+/** Like `same` for a function that mutates its first argument: compares the result and the input after. */
+function sameMutating(what, input, f) {
+  const a = copy(input);
+  const b = copy(input);
+  const ra = run((I) => f(I, a), C);
+  const rb = run((I) => f(I, b), L);
+  const da = describe(a);
+  const db = describe(b);
+  if (ra !== rb || da !== db) fail(`${what}\n  compat: ${ra} / input after: ${da}\n  lodash: ${rb} / input after: ${db}`);
+  return ra;
+}
+
+// ---------------------------------------------------------------------------------------------
+// Generators
+
+const KEYS = ["a", "b", "c", "id", "name", "x", "y", "0", "1", "2", "length", "constructor", "toString", "valueOf", "__proto__", "user", "item", "-1", "1.5", " ", "a.b", "a[0]", ""];
+const SAFE_KEYS = ["a", "b", "c", "id", "name", "x", "y", "user", "item", "n", "0", "1", "10"];
+
+/** A primitive value from a zoo of edge cases. */
+function genPrimitive(tc) {
+  const r = n(tc, 0, 99);
+  if (r < 30) return n(tc, -5, 10);
+  if (r < 40) return pick(tc, [0, -0, NaN, Infinity, -Infinity, 0.5, -1.5, 1e21, 2 ** 53, -(2 ** 31), 1e-7, 0.1 + 0.2, 9007199254740993, 3.0000000000000004]);
+  if (r < 60) return pick(tc, ["", "a", "b", "abc", "0", "1", "-1", "1.5", "true", "null", "undefined", " ", "A", "aB", "NaN", "1e3", "0x1f", "0b11", "0o17", "  12  ", "1_000", "Infinity", "-0", " ", "ａ", "😀", "é"]);
+  if (r < 70) return pick(tc, [true, false]);
+  if (r < 80) return pick(tc, [null, undefined]);
