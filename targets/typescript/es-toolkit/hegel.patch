+
+pin("TestHegelPinOwnProtoKeyStaysAnOwnKey", () => {
+  // es-toolkit/35
+  const mk = () => JSON.parse('{"__proto__": {"isAdmin": true}, "x": 1}');
+  for (const f of [(o) => C.cloneDeep(o), (o) => C.clone(o), (o) => C.omit(o, "x"), (o) => C.pickBy(o, () => true), (o) => C.mapValues(o, (v) => v), (o) => C.assign({}, o), (o) => C.defaultsDeep({}, o)]) {
+    const r = f(mk());
+    assert.equal(Object.getPrototypeOf(r), Object.prototype);
+    assert.equal(r.isAdmin, undefined);
+  }
+  assert.equal(C.zipObject(["__proto__"], [{ isAdmin: true }]).isAdmin, undefined);
+  assert.equal(C.groupBy(["__proto__"]).isAdmin, undefined);
+  assert.equal(Object.getPrototypeOf(C.groupBy(["__proto__"])), Object.prototype);
+});
+
+pin("TestHegelPinCloneDeepConvertsNestedNullPrototypes", () => {
+  // es-toolkit/36
+  const np = Object.create(null);
+  np.a = 1;
+  const root = C.cloneDeep(np);
+  const nested = C.cloneDeep({ c: { x: np } }).c.x;
+  assert.equal(Object.getPrototypeOf(nested), Object.getPrototypeOf(root));
+});
+
+pin("TestHegelPinSortByHonoursAMatchesIteratee", () => {
+  // es-toolkit/37
+  const recs = [{ id: 4 }, { id: 2 }, { id: 1 }];
+  assert.deepEqual(C.sortBy(recs, { id: 4 }).map((r) => r.id), [2, 1, 4]);
+  assert.deepEqual(C.orderBy(recs, [{ id: 4 }]).map((r) => r.id), [2, 1, 4]);
+});
+
+pin("TestHegelPinInvertOfAValueWithoutToString", () => {
+  // es-toolkit/38
+  const np = Object.create(null);
+  assert.deepEqual(C.invert({ a: np }), { "[object Object]": "a" });
+  assert.deepEqual(C.invertBy({ a: np }), { "[object Object]": ["a"] });
+  assert.deepEqual(C.invert([{ toString: 1 }]), { "[object Object]": "0" });
+});
+
+pin("TestHegelPinNullishStringStartsWithEmpty", () => {
+  // es-toolkit/39
+  assert.equal(C.startsWith(undefined, ""), true);
+  assert.equal(C.endsWith(undefined, ""), true);
+  assert.equal(C.startsWith(null, "", 3), true);
+  assert.equal(C.endsWith(null, "", 3), true);
+});
+
+pin("TestHegelPinXorByOfThreeArrays", () => {
+  // es-toolkit/40
+  assert.deepEqual(C.xorBy([1, 2], [3], [1], (x) => x), [2, 3]);
+  assert.deepEqual(C.xorBy([2.1, 1.2], [3.4], [2.3], Math.floor), [1.2, 3.4]);
+  assert.deepEqual(C.xorWith([1, 2], [3], [1], (a, b) => a === b), [2, 3]);
+  assert.deepEqual(C.xorBy([1], [2], [3], [1], (x) => x), [2, 3]);
+});
+
+pin("TestHegelPinCloneDeepOfABoxedSymbol", () => {
+  // es-toolkit/41
+  const boxed = Object(Symbol("boxed"));
+  const r = C.cloneDeep({ s: boxed }).s;
+  assert.equal(Object.prototype.toString.call(r), "[object Symbol]");
+  assert.equal(typeof r.valueOf(), "symbol");
+  assert.equal(r.valueOf(), boxed.valueOf());
+  assert.equal(typeof C.cloneDeepWith([boxed], () => undefined)[0].valueOf(), "symbol");
+});
+
+pin("TestHegelPinEmptyPathSegmentIsAKey", () => {
+  // es-toolkit/42
+  const o = { a: { "": -3, b: 1 }, "": { a: 9 } };
+  assert.deepEqual(C.toPath("a."), ["a", ""]);
+  assert.equal(C.get(o, "a."), -3);
+  assert.equal(C.get(o, ".a"), 9);
+  assert.equal(C.has(o, "a."), true);
+  assert.equal(C.hasIn(o, ".a"), true);
+  assert.deepEqual(C.at(o, ["a."]), [-3]);
+  assert.equal(C.property("a.")(o), -3);
+  assert.equal(C.unset(o, "a."), true);
+  assert.deepEqual(o.a, { b: 1 });
+});
+
+pin("TestHegelPinFindKeyOnAString", () => {
+  // es-toolkit/43
+  assert.equal(C.findKey("abc", (v) => v === "b"), "1");
+  assert.equal(C.findLastKey("abc", (v) => v), "2");
+  assert.equal(C.findKey("abc", (v) => v === "z"), undefined);
+});
+
+pin("TestHegelPinTruncateWithANaNOrNegativeLength", () => {
+  // es-toolkit/44
+  assert.equal(C.truncate("", { length: NaN }), "");
+  assert.equal(C.truncate("", { length: -1 }), "...");
+  assert.equal(C.truncate("", { length: -1, omission: "-" }), "-");
+});
+
+pin("TestHegelPinTruncateSeparatorAtTheStartOfTheKeptPart", () => {
+  // es-toolkit/45
+  assert.equal(C.truncate("abcdefgh", { length: 7, separator: /a/ }), "...");
+  assert.equal(C.truncate("abcdefgh", { length: 7, separator: "a" }), "...");
+  assert.equal(C.truncate("abcdefgh", { length: 7, separator: "c" }), "ab...");
+});
+
+pin("TestHegelPinDefaultsDeepMergesAnArrayWithAnObject", () => {
+  // es-toolkit/46
+  assert.deepEqual(C.defaultsDeep({ a: [5] }, { a: { 1: "x" } }), { a: [5, "x"] });
