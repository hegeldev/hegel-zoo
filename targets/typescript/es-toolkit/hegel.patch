+  assert.deepEqual(Object.keys(r), []);
+  assert.equal(r.inherited, 1);
+});
+
+pin("TestHegelPinMergeDoesNotMutateItsSources", () => {
+  // es-toolkit/48
+  const s1 = { a: { x: 1 } };
+  assert.deepEqual(C.merge({ a: 1 }, s1, { a: { y: 2 } }), { a: { x: 1, y: 2 } });
+  assert.deepEqual(s1, { a: { x: 1 } });
+  const s2 = { a: { x: 1 } };
+  C.mergeWith({ a: 1 }, s2, { a: { y: 2 } }, () => undefined);
+  assert.deepEqual(s2, { a: { x: 1 } });
+  const s3 = { arr: [{ p: 1 }] };
+  assert.deepEqual(C.defaultsDeep({}, s3, { arr: [{ q: 2 }] }), { arr: [{ p: 1, q: 2 }] });
+  assert.deepEqual(s3, { arr: [{ p: 1 }] });
+});
+
+pin("TestHegelPinDefaultsDeepConvertsAnArgumentsObject", () => {
+  // es-toolkit/49
+  const args = (function () { return arguments; })(1, 2);
+  const r = C.defaultsDeep({}, { a: args }).a;
+  assert.equal(Object.prototype.toString.call(r), "[object Object]");
+  assert.deepEqual(r, { 0: 1, 1: 2 });
+});
+
+pin("TestHegelPinMergeKeepsASameValueZeroEqualTarget", () => {
+  // es-toolkit/50
+  assert.ok(Object.is(C.merge({ a: -0 }, { a: 0 }).a, -0));
+  assert.ok(Object.is(C.merge({ a: 0 }, { a: -0 }).a, 0));
+  assert.ok(Object.is(C.mergeWith({ a: -0 }, { a: 0 }, () => undefined).a, -0));
+});
+
+pin("TestHegelPinIntersectionWithDropsAString", () => {
+  // es-toolkit/51
+  assert.deepEqual(C.intersectionWith(["a"], "a", (x, y) => x === y), []);
+  assert.deepEqual(C.intersectionWith(["a", "b"], ["b"], "a", (x, y) => x === y), []);
+  assert.deepEqual(C.intersectionWith(["a"], { 0: "a", length: 1 }, (x, y) => x === y), ["a"]);
+});
+
+pin("TestHegelPinANullElementOfAnArraySourceMatchesOnlyNull", () => {
+  // es-toolkit/52
+  assert.equal(C.isMatch({ b: [0] }, { b: [null] }), false);
+  assert.equal(C.matchesProperty("b", [null])({ b: [0] }), false);
+  assert.equal(C.isMatch({ b: [null] }, { b: [null] }), true);
+});
+
+pin("TestHegelPinCloneOfAFunctionCopiesItsOwnProperties", () => {
+  // es-toolkit/53
+  const f = function named() {};
+  f.a = 1;
+  f.arr = [1];
+  assert.deepEqual(C.clone(f), { a: 1, arr: [1] });
+  assert.deepEqual(C.cloneWith(f, () => undefined), { a: 1, arr: [1] });
+  const g = () => 1;
+  g.a = 1;
+  assert.deepEqual(C.clone(g), { a: 1 });
+});
+
+pin("TestHegelPinOmitKeepsAnArrayUnderAConstructorKey", () => {
+  // es-toolkit/54
