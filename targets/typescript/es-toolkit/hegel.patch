+  [10, gs.tuples(valueOf({}, 1), primitive).map(([v, p]) => [v, [p], { a: 1 }])],
+  [7, fresh(() => new Point(1, 2))],
+  [6, pick([null, undefined, 0, "", "abc", 5, true, Symbol.for("k")])],
+  [6, fresh(() => Object.assign(Object.create({ inherited: { deep: 1 } }), { own: 1 }))],
+  [6, fresh(() => new Map([["a", 1]]))],
