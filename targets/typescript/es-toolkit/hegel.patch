+});
+
+pin("TestHegelPinDefaultsDeepLeavesAnInheritedKeyAlone", () => {
+  // es-toolkit/47
+  const target = Object.create({ inherited: 1 });
+  const r = C.defaultsDeep(target, { inherited: 2 });
