+    ? gs.tuples(pick(["user", ["user"]]), ints(0, 2).map((id) => ({ id })))
+    : gs.tuples(pick(MATCHES_PROPERTY_PATHS), weighted([70, ints(0, 3)], [30, pick(values)]));
+  const alternatives = {
+    identity: [7, tagged("identity", gs.just(undefined))],
+    path: [30, tagged("path", pick(PATHS))],
+    matches: [15, tagged("matches", weighted([50, ints(0, 4).map((id) => ({ id }))], [50, ints(0, 2).map((id) => ({ user: { id } }))]))],
+    matchesProperty: [12, tagged("matchesProperty", matchesProperty)],
+    fn: [18, pick(fns).map((which) => ({ kind: `fn${which}`, it: ITERATEE_FNS[which] }))],
+    arity: [8, tagged("arity", gs.just((v, i, coll) => [typeof i, Array.isArray(coll) || typeof coll]))],
+    constant: [10, tagged("constant", pick(constants))],
