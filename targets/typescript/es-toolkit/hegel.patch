+// Hegel zoo: the generators behind the es-toolkit/compat properties, as values built from
+// Hegel's combinators. A value is a small tree (primitives, arrays with holes, plain objects and
+// a zoo of exotic objects) built bottom-up per nesting level, since the binding has no recursive
+// combinator; the inputs of each property (collections, arrays, paths, strings, numberish values,
+// merge sources, the predicates' zoo) are weighted choices over those, with flags that keep the
+// shapes a property cannot judge (a known bug's, or an untyped call's) out by construction. Every
+// object a case holds is built inside a `map`, so no two cases share a mutable value. Nothing here
+// draws from a TestCase: every generator is a value.
+
+import { gs } from "./hegel-zoo.mjs";
+
+// ---------------------------------------------------------------- generator helpers
+
+export const ints = (lo, hi) => gs.integers({ minValue: lo, maxValue: hi });
+
+/** oneOf with weights: `weighted([45, a], [55, b])` draws a 45 times in 100; shrinks towards the first choice. */
+export function weighted(...choices) {
+  if (choices.length === 1) return choices[0][1];
+  const total = choices.reduce((sum, [w]) => sum + w, 0);
+  return ints(0, total - 1).flatMap((r) => {
+    for (const [w, g] of choices) {
+      if (r < w) return g;
+      r -= w;
+    }
+    throw new Error("unreachable");
+  });
+}
+
+/** True pct percent of the time; shrinks to false. */
+export const chance = (pct) => ints(0, 99).map((r) => r >= 100 - pct);
+/** A draw from g pct percent of the time, else undefined (listed first: shrinks to absent). */
+export const maybe = (pct, g) => weighted([100 - pct, gs.just(undefined)], [pct, g]);
+export const pick = (xs) => gs.sampledFrom(xs);
+/** A fresh value from one of the `makers` (thunks), so no case shares a mutable object with another; shrinks to the first. */
+export const fresh = (...makers) => gs.sampledFrom(makers).map((make) => make());
+/** An absent field of a built object (distinct from a present `undefined`). */
+export const ABSENT = Symbol("absent");
+/** A draw from g pct percent of the time, else ABSENT (first: shrinks to absent). */
+export const opt = (pct, g) => weighted([100 - pct, gs.just(ABSENT)], [pct, g]);
+export const without = (xs, ...drop) => xs.filter((x) => !drop.includes(x));
+export const nullish = pick([null, undefined]);
+
+// ---------------------------------------------------------------- keys and primitives
+
+export const KEYS = ["a", "b", "c", "id", "name", "x", "y", "0", "1", "2", "length", "constructor", "toString", "valueOf", "__proto__", "user", "item", "-1", "1.5", " ", "a.b", "a[0]", ""];
+export const SAFE_KEYS = ["a", "b", "c", "id", "name", "x", "y", "user", "item", "n", "0", "1", "10"];
+
+const NUMBER_EDGES = [0, -0, NaN, Infinity, -Infinity, 0.5, -1.5, 1e21, 2 ** 53, -(2 ** 31), 1e-7, 0.1 + 0.2, 9007199254740993, 3.0000000000000004];
+const STRING_EDGES = ["", "a", "b", "abc", "0", "1", "-1", "1.5", "true", "null", "undefined", " ", "A", "aB", "NaN", "1e3", "0x1f", "0b11", "0o17", "  12  ", "1_000", "Infinity", "-0", "\u{a0}", "\u{ff41}", "\u{1f600}", "\u{e9}"];
+export const SYMBOLS = [Symbol.iterator, Symbol.for("k"), Symbol("s")];
+const BIGINTS = [1n, 0n, -3n, 2n ** 64n];
+const LIMITS = [Number.MAX_SAFE_INTEGER, Number.MIN_SAFE_INTEGER, Number.EPSILON, Number.MAX_VALUE, Number.MIN_VALUE, -Number.MAX_VALUE];
+
+/** A primitive from a zoo of edge cases: a small integer 30% of the time, a number edge 10, an edge string 20, a boolean 10, null or undefined 10, 1-4 letters 8, a symbol 5 (unless `symbols` is false), a bigint 3, a numeric limit 4. */
+export const primitiveOf = ({ symbols = true } = {}) =>
+  weighted(
+    [30, ints(-5, 10)],
+    [10, pick(NUMBER_EDGES)],
+    [20, pick(STRING_EDGES)],
+    [10, gs.booleans()],
+    [10, nullish],
+    [8, gs.text({ alphabet: "abcxyz", minSize: 1, maxSize: 4 })],
+    ...(symbols ? [[5, pick(SYMBOLS)]] : []),
+    [3, pick(BIGINTS)],
+    [4, pick(LIMITS)],
+  );
+export const primitive = primitiveOf();
+const plainPrimitive = primitiveOf({ symbols: false });
+const prim = (m) => (m.symbols === false ? plainPrimitive : primitive);
+
+// ---------------------------------------------------------------- values: primitives, arrays, objects, exotics per level
+
+export class Point {
+  constructor(x, y) {
+    this.x = x;
+    this.y = y;
+  }
+  get sum() {
+    return this.x + this.y;
+  }
+  norm() {
+    return Math.hypot(this.x, this.y);
+  }
+}
+
+export const argumentsOf = (...xs) => (function () { return arguments; })(...xs);
+
+const HOLE = Symbol("hole");
+/** `xs` as an array, each HOLE element left as a hole. */
+const withHoles = (xs) => {
+  const arr = [];
+  for (const x of xs) {
+    if (x === HOLE) arr.length++;
+    else arr.push(x);
+  }
+  return arr;
+};
+
+/** A plain object from `entries` (an own `__proto__` data key defined as such) with `sym` under Symbol.for("sym") unless ABSENT. */
+export function toObject(entries, sym = ABSENT) {
+  const o = {};
+  for (const [k, v] of entries) {
+    if (k === "__proto__") Object.defineProperty(o, k, { value: v, enumerable: true, writable: true, configurable: true });
+    else o[k] = v;
+  }
+  if (sym !== ABSENT) o[Symbol.for("sym")] = sym;
+  return o;
+}
+
+/** A plain object of 0-4 distinct keys from `m.keys` (KEYS by default) with values from `below`, and a symbol-keyed primitive 8% of the time. */
+export const objectOf = (m, below) => gs.record({ entries: gs.maps(pick(m.keys ?? KEYS), below, { maxSize: 4 }), sym: opt(8, prim(m)) }).map(({ entries, sym }) => toObject(entries, sym));
+
+const DATE_TIMES = [0, 1e12, -1e12, NaN, 1700000000000];
+const REGEXPS = [["a", "g"], ["^x$", "i"], ["", ""], ["[a-z]+", "u"]];
+/** Makers of the function values: fresh per case, since path writers and mergers add own properties to a function target or source and a shared one would carry them into later cases. */
+export const FUNCTIONS = [() => function named() {}, () => () => 1, () => class K {}, () => async function af() {}, () => function* gen() {}, () => Math.max];
+export const typedArray = fresh(() => new Uint8Array([1, 2, 3]), () => new Int16Array([-1, 0, 1]), () => new Float64Array([0.5, NaN]), () => new Uint8Array(0), () => new BigInt64Array([1n]));
+const boxed = fresh(() => Object(1), () => Object("s"), () => Object(true), () => Object(Symbol.for("boxed")));
+const errors = fresh(() => new Error("e"), () => new TypeError("t"), () => new RangeError(""));
+export const point = gs.tuples(ints(-3, 3), ints(-3, 3)).map(([x, y]) => new Point(x, y));
+/** A null-prototype object with one primitive `a`. */
+export const nullProto = (m = {}) => prim(m).map((a) => Object.assign(Object.create(null), { a }));
+/** An arguments object of two primitives. */
+export const argumentsObject = (m = {}) => gs.tuples(prim(m), prim(m)).map((xs) => argumentsOf(...xs));
+/** An array-like plain object: a length of 0-3 and three indexed primitives. */
+export const arrayLike = (m = {}) => gs.tuples(ints(0, 3), prim(m), prim(m), prim(m)).map(([length, a, b, c]) => ({ length, 0: a, 1: b, 2: c }));
+/** An object inheriting `inherited` with an own enumerable primitive and a hidden one. */
+export const inheriting = (m = {}) => prim(m).map((own) => Object.create({ inherited: 1 }, { own: { value: own, enumerable: true }, hidden: { value: 2, enumerable: false } }));
+
+/** An exotic object whose nested values (a Map's) come from `below`: a Date, RegExp, Map, Set, typed array, ArrayBuffer/DataView, class instance, boxed primitive, null-prototype object, Error, function, arguments object, array-like or inheriting object. */
+function exoticLevel(m, below) {
+  return weighted(
+    [12, pick(DATE_TIMES).map((t) => new Date(t))],
+    [8, pick(REGEXPS).map(([source, flags]) => new RegExp(source, flags))],
+    [12, gs.arrays(gs.tuples(prim(m), below), { maxSize: 3 }).map((entries) => new Map(entries))],
+    [12, gs.arrays(prim(m), { maxSize: 4 }).map((xs) => new Set(xs))],
+    [8, typedArray],
+    [6, fresh(() => new ArrayBuffer(4), () => new DataView(new ArrayBuffer(2)))],
+    [8, point],
+    [6, boxed],
+    [6, nullProto(m)],
+    [6, errors],
+    [6, fresh(...FUNCTIONS)],
+    [4, argumentsObject(m)],
+    [3, arrayLike(m)],
+    [3, inheriting(m)],
+  );
+}
+
+/**
+ * One nesting level over `below` (the values one level down; null at the leaves, where only
+ * primitives are drawn): a primitive 45% of the time, an array of up to 4 (each element a hole 5%
+ * of the time) 25, a plain object 20, an exotic object 10 (none with `m.exotic` false). `m.keys`
+ * is the object key pool, `m.symbols` false keeps symbols out of the primitives and keys.
+ */
+function valueLevel(m, below) {
+  if (below === null) return prim(m);
+  const element = weighted([95, below], [5, gs.just(HOLE)]);
+  return weighted(
+    [45, prim(m)],
+    [25, gs.arrays(element, { maxSize: 4 }).map(withHoles)],
+    [20, objectOf(m, below)],
+    ...(m.exotic === false ? [] : [[10, exoticLevel(m, below)]]),
+  );
+}
+
+/** A value nested `levels` deep (2: arrays and objects whose elements may be arrays and objects of primitives). */
+export function valueOf(m = {}, levels = 2) {
+  let g = null;
+  for (let d = 0; d <= levels; d++) g = valueLevel(m, g);
+  return g;
+}
+/** A plain object whose values are nested `levels` deep. */
+export const plainObjectOf = (m = {}, levels = 2) => objectOf(m, valueOf(m, levels));
+/** An exotic object whose nested values are nested `levels` deep. */
+export const exoticOf = (m = {}, levels = 1) => exoticLevel(m, valueOf(m, levels));
+
+// ---------------------------------------------------------------- records and collections
+
+const NAMES = ["ann", "bob", "cy", "Bob", "", "ann"];
+const AGES = [1, 2, 3, NaN, null, undefined, "2", 1.5, -0, 0];
+const ACTIVES = [true, false, 0, 1, "", null];
+const tags = weighted([50, pick(["empty", null, "a"]).map((t) => (t === "empty" ? [] : t))], [50, gs.tuples(pick(["a", "b"]), pick(["a", "c"]))]);
+const user = gs.record({ id: ints(0, 2), tags });
+
+/** A record with a few well-known keys (each present with its own probability), the element type of most collection cases. */
+export const record = gs.record({
+  id: opt(80, ints(0, 4)),
+  name: opt(70, pick(NAMES)),
+  age: opt(50, pick(AGES)),
+  user: opt(40, user),
+  "a.b": opt(30, ints(0, 2)),
+  active: opt(20, pick(ACTIVES)),
+  extra: opt(10, gs.tuples(pick(KEYS), primitive)),
+}).map(({ extra, ...fields }) => {
+  const o = {};
+  for (const [k, v] of Object.entries(fields)) if (v !== ABSENT) o[k] = v;
+  if (extra !== ABSENT) o[extra[0]] = extra[1];
+  return o;
+});
+
+const COLLECTION_STRINGS = ["", "abc", "aab", "\u{1f600}a", "a b"];
+/** An array-like plain object holding `xs`. */
+const arrayLikeOf = (xs) => Object.assign({ length: xs.length }, xs);
+
+/** A collection: an array of up to 6 records 45% of the time, of primitives 20, an object of records or primitives 7, a string 6, an array-like 6, a Map 4 and a Set 3 (with `mapsAndSets`), null or undefined 3, an arguments object 3, an array of nested values 3. */
+export function collectionOf({ mapsAndSets = true } = {}) {
+  return weighted(
+    [45, gs.arrays(record, { maxSize: 6 })],
+    [20, gs.arrays(primitive, { maxSize: 6 })],
+    [7, gs.maps(pick(SAFE_KEYS), weighted([60, record], [40, primitive]), { maxSize: 6 }).map((entries) => Object.fromEntries(entries))],
+    [6, pick(COLLECTION_STRINGS)],
+    [6, gs.arrays(primitive, { maxSize: 6 }).map(arrayLikeOf)],
+    ...(mapsAndSets
+      ? [
+          [4, gs.arrays(gs.tuples(pick(SAFE_KEYS), primitive), { maxSize: 6 }).map((entries) => new Map(entries.map(([k, v], i) => [k + i, v])))],
+          [3, gs.arrays(primitive, { maxSize: 6 }).map((xs) => new Set(xs))],
+        ]
+      : []),
+    [3, nullish],
+    [3, gs.arrays(primitive, { maxSize: 6 }).map((xs) => argumentsOf(...xs))],
+    [3, gs.arrays(valueOf(), { maxSize: 6 })],
+  );
+}
+
+const SMALL_VALUES = [0, -0, 1, 2, 3, NaN, null, undefined, "a", "b", "1", true, false, 1.5, -1];
+const ARRAY_STRINGS = ["", "abc", "aab", "a b", "\u{1f600}a\u{1f600}"];
+/** An array argument: up to 7 small values 50% of the time, records 20, nested values 15, a string 5, an array-like 4, null or undefined 3, an arguments object 3. */
+export const array = weighted(
+  [50, gs.arrays(pick(SMALL_VALUES), { maxSize: 7 })],
+  [20, gs.arrays(record, { maxSize: 7 })],
+  [15, gs.arrays(valueOf(), { maxSize: 7 })],
+  [5, pick(ARRAY_STRINGS)],
+  [4, gs.arrays(primitive, { maxSize: 7 }).map(arrayLikeOf)],
+  [3, nullish],
+  [3, gs.arrays(primitive, { maxSize: 7 }).map((xs) => argumentsOf(...xs))],
+);
+const KEYISH = [0, -0, 1, 2, 3, NaN, 1.5, -1, "a", "b", "1"];
+/** An array of property keys (numbers and strings), for zipObject: the shape of List<PropertyName> the types allow. */
+export const keyArray = weighted(
+  [85, gs.arrays(pick(KEYISH), { maxSize: 7 })],
+  [6, pick(ARRAY_STRINGS)],
+  [3, gs.arrays(pick(KEYISH), { maxSize: 7 }).map(arrayLikeOf)],
+  [3, nullish],
+  [3, gs.arrays(pick(KEYISH), { maxSize: 7 }).map((xs) => argumentsOf(...xs))],
+);
+
+// ---------------------------------------------------------------- iteratees
+
+// `__proto__` is not among the paths: es-toolkit deliberately refuses it in property access (a
+// prototype-pollution guard, see tests/__proto__.spec.ts), lodash reads Object.prototype
+export const PATHS = ["id", "name", "age", "user.id", "user.tags", "user.tags[0]", "user.tags.1", ["user", "tags", 0], ["a.b"], "a.b", "active", "x", "", "0", "length", "constructor", ["id"], "user[tags][0]", "user.nope.deeper", "[0]", "toString"];
+const ITERATEE_FNS = [
+  (v) => (v && typeof v === "object" ? v.id : v),
+  (v) => typeof v === "number" && v % 2 === 0,
+  (v) => String(v && v.name),
+  (v, k) => `${k}`,
+  (v) => v,
+  (v) => (v && typeof v === "object" ? v.age : v),
+];
+export const ITERATEE_KINDS = ["identity", "path", "matches", "matchesProperty", "fn", "arity", "constant"];
+export const CONSTANTS = ["a", 1, true, "nope"];
+const MATCHES_PROPERTY_PATHS = ["id", "name", "user.id", ["user", "id"], "age"];
+const MATCHES_PROPERTY_VALUES = ["ann", NaN, undefined, null, "Bob"];
+
+/**
+ * An iteratee in one of lodash's shorthand forms, as `{ kind, it }` (`kind` for the statistics):
+ * identity (undefined) 7 times in 100, a path 30, a `matches` object 15, a `matchesProperty` pair
+ * 12 (its value a small integer 70% of the time, else a string, NaN, undefined or null - the last
+ * two only with `nullValues`, es-toolkit/17's shape; with `objectValues`, the path `user` and a
+ * `{ id }` source instead), one of six functions 18 (those of `fns`), a function reporting its
+ * arguments' types 8, a constant 10 (one of `constants`). `kinds` selects the forms.
+ */
+export function iterateeOf({ kinds = ITERATEE_KINDS, fns = [0, 1, 2, 3, 4, 5], constants = CONSTANTS, objectValues = false, nullValues = true } = {}) {
+  const tagged = (kind, g) => g.map((it) => ({ kind, it }));
+  const values = nullValues ? MATCHES_PROPERTY_VALUES : MATCHES_PROPERTY_VALUES.filter((v) => v != null);
