+
+// ---------------------------------------------------------------- paths and path targets
+
+const SEGMENTS = ["a", "b", "c", "0", "1", "-1", "01", "1.5", "x y", "", "user", "tags", "a.b", "length", "constructor", "toString", "__proto__", "prototype", "\u{ff4e}", "[0]", "'q'", '"d"'];
