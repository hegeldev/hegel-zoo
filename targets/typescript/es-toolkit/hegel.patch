+// ---------------------------------------------------------------- strings
+
+export const WORDS = ["foo", "Bar", "BAZ", "fooBar", "foo_bar", "foo-bar", "FOO_BAR", "Foo Bar", "fooBAR", "foo2bar", "2foo", "foo2", "1st", "2nd", "3RD", "caf\u{e9}", "na\u{ef}ve", "\u{c9}COLE", "\u{fc}ber", "\u{1c5}", "stra\u{df}e", "\u{130}stanbul", "don't", "l'\u{e9}t\u{e9}", "O'Neil", "\u{1f600}", "\u{1f44d}\u{1f3fd}", "a\u{1f600}b", "\u{65e5}\u{672c}\u{8a9e}", "\u{c548}\u{b155}", "hello world", "  padded  ", "tab\tsep", "new\nline", "a.b", "a,b", "A-B_C", "XMLHttpRequest", "iPhone", "HTMLElement", "__proto__", "$var", "a$b", "\u{b5}", "\u{fb01}", "e\u{301}", "\u{3a9}", "\u{3a9}MEGA", "\u{1c6}", "\u{131}", "\u{df}", "\u{1f88}", "&<>\"'`", "a&amp;b", "&#39;", "&#x27;", "&lt;x&gt;", "\\", "/", ".*+?^${}()|[]\\", "ab.c*d", "", " ", "-", "_", "--", "a--b", "a__b", "12.5", "-1e3", "0x1F", "abc123def", "camelCaseTest", "snake_case_test", "kebab-case-test", "Title Case Test", "ALL CAPS TEST", "mixed_Case-Test string"];
