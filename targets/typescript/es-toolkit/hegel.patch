+  [50, gs.arrays(valueOf({}, 1), { minSize: 1, maxSize: 4 })],
+  [40, gs.maps(pick(KEYS), valueOf({}, 1), { minSize: 1, maxSize: 4 }).map((entries) => toObject(entries))],
