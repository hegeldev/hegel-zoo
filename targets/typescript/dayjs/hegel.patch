--- /dev/null
+++ b/hegel/build.mjs
@@ -0,0 +1,20 @@
+// Hegel zoo: bundle Day.js's ES-module sources to CommonJS under .hegel/dist with esbuild, so the
+// tests can require() the core, every plugin and a few locales without the repository's own
+// rollup/babel build (its devDependencies). Run from the repository root after the .hegel install.
+import { execFileSync } from "node:child_process";
+import { mkdirSync, readdirSync, writeFileSync } from "node:fs";
+
+const esbuild = ".hegel/node_modules/esbuild/bin/esbuild";
+const common = ["--bundle", "--format=cjs", "--platform=node", "--log-level=warning"];
+const build = (entry, out, extra = []) => execFileSync(esbuild, [entry, ...common, `--outfile=${out}`, ...extra], { stdio: "inherit" });
+
+mkdirSync(".hegel/dist/plugin", { recursive: true });
+mkdirSync(".hegel/dist/locale", { recursive: true });
+build("src/index.js", ".hegel/dist/dayjs.cjs");
+for (const name of readdirSync("src/plugin")) build(`src/plugin/${name}/index.js`, `.hegel/dist/plugin/${name}.cjs`);
+// locales import the `dayjs` package: a shim under .hegel/dist/node_modules resolves it to the
+// bundled core, so a locale registers itself with the same instance the tests use
+mkdirSync(".hegel/dist/node_modules/dayjs", { recursive: true });
+writeFileSync(".hegel/dist/node_modules/dayjs/index.js", 'module.exports = require("../../dayjs.cjs").default;\n');
+for (const name of ["en-gb", "de", "fr", "ar", "zh-cn"]) build(`src/locale/${name}.js`, `.hegel/dist/locale/${name}.cjs`, ["--external:dayjs"]);
+console.log("built .hegel/dist");
diff --git a/hegel/hegel-zoo.mjs b/hegel/hegel-zoo.mjs
new file mode 100644
index 0000000..5311417
--- /dev/null
+++ b/hegel/hegel-zoo.mjs
@@ -0,0 +1,140 @@
+// Hegel zoo: the small harness shared by the zoo's TypeScript/JavaScript targets.
+//
+// `property(name, body)` registers a node:test test that runs `body(tc)` under Hegel with
+// HEGEL_TEST_CASES cases (default 100) and the database at HEGEL_DATABASE. With ZOO_COLLECT=1
+// a `fail()` records the mismatch instead of failing, the case ends there, and the counts of
+// mismatches and of the shapes seen (`count(key)`) are printed at the end of the test, so a
+// property can be run over many cases to see every shape at once. `pin(name, body)` is a
+// plain test for one pinned bug: it must fail while the bug is present and pass once it is
+// fixed (the zoo's judge reads an unexpected pass as "fixed upstream?").
+
+import { readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+import { test as nodeTest } from "node:test";
+
+// The Hegel version these tests were written against (the zoo pins it in zoo.toml; upstream
+// would add it to devDependencies). smol-toml's package.json declares `devEngines.packageManager
+// = pnpm` with `onFail: "error"`, which makes npm refuse to install anything into the package
+// itself, so Hegel (and the TypeScript compiler that builds src/ into .hegel/dist) are installed
+// with `npm install --prefix .hegel` and imported from there. Checked at load time so a stray
+// install cannot silently change the engine.
+export const HEGEL_PIN = { "@hegeldev/hegel": "0.4.5" };
+
+const hegelDir = join(dirname(fileURLToPath(import.meta.url)), "..", ".hegel", "node_modules", "@hegeldev", "hegel");
+{
+  const installed = JSON.parse(readFileSync(join(hegelDir, "package.json"), "utf8")).version;
+  if (installed !== HEGEL_PIN["@hegeldev/hegel"]) {
+    throw new Error(`@hegeldev/hegel ${installed} is installed; these tests pin ${HEGEL_PIN["@hegeldev/hegel"]}`);
+  }
+}
+const hegel = await import(pathToFileURL(join(hegelDir, "dist", "index.js")));
+const gs = await import(pathToFileURL(join(hegelDir, "dist", "generators", "index.js")));
+
+export const collecting = !!process.env.ZOO_COLLECT;
+
+class Collected extends Error {}
+
+let msgs = [];
+let stats = new Map();
+
+/** Report a mismatch: an error normally, a recorded line in collect mode. */
+export function fail(message) {
+  if (collecting) {
+    msgs.push(message);
+    throw new Collected(message);
+  }
+  throw new Error(message);
+}
+
+/** Bump a statistic (the shape of a pinned bug, a generator branch). */
+export function count(key) {
+  stats.set(key, (stats.get(key) || 0) + 1);
+}
+
+function settings() {
+  const s = { testCases: Number(process.env.HEGEL_TEST_CASES) || 100 };
+  if (process.env.HEGEL_DATABASE) {
+    s.database = hegel.Database.fromPath(process.env.HEGEL_DATABASE);
+  }
+  return s;
+}
+
+/** A property: `body(tc)` runs under Hegel; a thrown error (or `fail`) is a failure. */
+export function property(name, body) {
+  nodeTest(name, () => {
+    msgs = [];
+    stats = new Map();
+    hegel.test((tc) => {
+      try {
+        body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** A pin: a plain test for one recorded bug. */
+export function pin(name, body) {
+  nodeTest(name, body);
+}
+
+/** An integer in [lo, hi]. */
+export function n(tc, lo, hi) {
+  return tc.draw(gs.integers({ minValue: lo, maxValue: hi }));
+}
+
+/** One of xs. */
+export function pick(tc, xs) {
+  return xs[n(tc, 0, xs.length - 1)];
+}
+
+/** True pct percent of the time. */
+export function chance(tc, pct) {
+  return n(tc, 0, 99) < pct;
+}
+
+/** A string of `len` characters drawn from `alphabet` (an array of strings). */
+export function word(tc, alphabet, lo, hi) {
+  const len = n(tc, lo, hi);
+  let s = "";
+  for (let i = 0; i < len; i++) {
+    s += pick(tc, alphabet);
+  }
+  return s;
+}
+
+/** Structural equality: arrays by position, objects by key set (prototype ignored), else ===. */
+export function same(a, b) {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) {
+      return false;
+    }
+    return a.every((x, i) => same(x, b[i]));
+  }
+  if (a !== null && b !== null && typeof a === "object" && typeof b === "object") {
+    const ka = Object.keys(a).sort();
+    const kb = Object.keys(b).sort();
+    if (ka.length !== kb.length || ka.some((k, i) => k !== kb[i])) {
+      return false;
+    }
+    return ka.every((k) => same(a[k], b[k]));
+  }
+  return a === b;
+}
+
+/** A compact, unambiguous rendering for messages. */
+export function show(x) {
+  return JSON.stringify(x, (k, v) => (v === undefined ? "<undefined>" : v));
+}
diff --git a/hegel/hegel.test.mjs b/hegel/hegel.test.mjs
new file mode 100644
index 0000000..98ddea6
--- /dev/null
+++ b/hegel/hegel.test.mjs
@@ -0,0 +1,1153 @@
+// Hegel zoo: Day.js against Moment.js.
+//
+// Day.js describes itself as "a minimalist JavaScript library that parses, validates, manipulates,
+// and displays dates and times ... with a largely Moment.js-compatible API", and its own test-suite
+// compares most results with moment. These properties do the same over generated inputs: every
+// call is run through `dayjs` and through `moment` (2.31.0, with moment-timezone for the timezone
+// plugin) and the results are compared through `describe()` — a canonical rendering of an instant
+// (timestamp, validity, utcOffset), a duration, or a plain value — or through the class of the
+// error thrown. The host time zone is chosen per case (Node re-reads process.env.TZ), with the
+// generated instants biased towards DST transitions of that zone.
+//
+// Differences the documentation states (or the plugins declare) are skipped through `Accepted`
+// and listed in the README; the rest are bugs, skipped through `Known` and pinned below.
+//
+// Build: `npm install --prefix .hegel` of Hegel, moment, moment-timezone and esbuild, then
+// `node hegel/build.mjs` bundles src/ to CommonJS under .hegel/dist (see target.toml [run]).
+import assert from "node:assert/strict";
+import { createRequire } from "node:module";
+import { property, pin, fail, count, n, pick, chance } from "./hegel-zoo.mjs";
+
+const require = createRequire(import.meta.url);
+const dayjs = require("../.hegel/dist/dayjs.cjs").default;
+const moment = require("../.hegel/node_modules/moment");
+require("../.hegel/node_modules/moment-timezone"); // adds moment.tz
+moment.suppressDeprecationWarnings = true;
+
+// Plugins that add Moment API to Day.js (badMutable, devHelper, bigIntSupport, negativeYear,
+// buddhistEra, preParsePostFormat, updateLocale, isMoment change or extend behaviour Moment does
+// not have, and stay out).
+const PLUGINS = ["utc", "timezone", "customParseFormat", "duration", "isoWeek", "weekOfYear", "weekYear", "weekday", "quarterOfYear", "dayOfYear", "advancedFormat", "relativeTime", "minMax", "isBetween", "isSameOrBefore", "isSameOrAfter", "isLeapYear", "arraySupport", "objectSupport", "localizedFormat", "toArray", "toObject", "pluralGetSet", "isoWeeksInYear", "localeData", "calendar"];
+for (const p of PLUGINS) dayjs.extend(require(`../.hegel/dist/plugin/${p}.cjs`).default);
+require("../.hegel/dist/locale/en-gb.cjs");
+
+// ---------------------------------------------------------------------------------------------
+// Known bugs (each has a pin below) and accepted differences (README).
+const Known = {
+  // dayjs/1: with the localizedFormat or advancedFormat plugin loaded, `format()` of a UTC instance
+  // renders "+00:00" instead of the utc plugin's "Z" (the plugins substitute the local default
+  // format before the utc plugin sees the missing argument)
+  utcDefaultFormat: true,
+  // dayjs/2: tz() of a pre-1970 instant with milliseconds is a second off and its utcOffset()
+  // fractional (`asTS % 1000` is negative)
+  tzPre1970Millis: true,
+  // dayjs/3: an ISO 8601 ordinal date "YYYY-DDD" is parsed as year-month-day ("2019-048" is April 8)
+  ordinalDate: true,
+  // dayjs/4: set()/get() with a plugin unit (quarter, week, isoWeek, weekday, isoWeekday, dayOfYear)
+  // is a no-op / throws, while the method form works
+  setPluginUnits: true,
+  // dayjs/5: utcOffset(16) and utcOffset(-16) are taken as hours (documented: less than 16)
+  utcOffsetSixteen: true,
+  // dayjs/6: customParseFormat matches month names and meridiems case-sensitively ("3 nov 2018"
+  // is invalid, "11 PM" with the `a` token stays 11:00)
+  parseNameCase: true,
+  // dayjs/7: duration(n, "days"|"weeks"|…) bubbles the days into 365/12-day months with an hour
+  // remainder (duration(45, "days").toISOString() is "P1M14DT14H"; the object and ISO constructors keep P45D)
+  durationDaysBubble: true,
+  // dayjs/8: fractional seconds with fewer than three digits are read as milliseconds
+  // ("…00:00:00.5" is 5 ms, not 500)
+  fractionalSeconds: true,
+  // dayjs/9: fractional day/week amounts round toward +infinity (subtract(1.5, "day") removes one
+  // day, add(1.5, "day") adds two) and fractional month/year amounts are truncated
+  fractionalRounding: true,
+  // dayjs/10: toISOString of a duration whose components have mixed signs has the wrong magnitude
+  // ({ hours: -1, minutes: 30 } is "-PT1H30M")
+  durationMixedSigns: true,
+  // dayjs/11: utcOffset(n) is an hour off when the host zone's offsets at the instant and at the
+  // shifted wall time differ (a DST transition in between); dayjs.tz(string, zone) and .tz(zone)
+  // build on it and inherit the error
+  utcOffsetDst: true,
+  // dayjs/12: startOf/endOf of a sub-day unit inside the repeated hour of a DST fall-back land in
+  // the earlier occurrence (endOf("hour") an hour before the instant); isSame & co. inherit it
+  dstRepeatedHour: true,
+  // dayjs/13: strict parsing with the documented S/SS tokens always fails (format() has no S/SS)
+  strictSubsecond: true,
+  // dayjs/14: strict parsing rejects any text whose Z/ZZ offset differs from the instance's own
+  // (the strict check is a format() round trip)
+  strictOffset: true,
+  // dayjs/15: years 0–99 become 1900–1999 wherever a Date is built from components: parsing
+  // ("0001-01-01" is 1901), startOf/endOf of year/month/week, set(month|year), isoWeek, WW
+  twoDigitYear: true,
+  // dayjs/16: utcOffset(n, true) on a UTC-mode instance also shifts by the host zone's offset
+  utcOffsetKeepLocalUtc: true,
+  // dayjs/17: the weekday() setter goes through an intermediate day whose wall time may fall in a
+  // DST gap (Lord Howe 2020-10-04 02:09), shifting the result by the gap
+  weekdayGap: true,
+  // dayjs/18: an ISO 8601 duration with a leading sign ("-PT1H") loses the sign: the regex captures
+  // it and the constructor drops it
+  isoLeadingSign: true,
+  // dayjs/19: a comma decimal mark in an ISO duration ("PT14,75S") silently drops the component
+  isoComma: true,
+  // dayjs/20: customParseFormat: a word token (MMM, MMMM, A, a, Do) followed by the documented "."
+  // separator swallows the dot and the parse fails
+  dotAfterWord: true,
+  // dayjs/21: a duration built with a weeks component (P1W, {weeks: 1}) has days() 0 although it
+  // renders as P7D and P7D itself has days() 7; dayjs.add(duration) drops the weeks
+  weeksNotDays: true,
+  // dayjs/22: tz(zone, true) (keep local time) takes the target zone's offset at the original
+  // instant instead of at the kept wall time; its own "z" abbreviation disagrees with its "Z"
+  tzKeepLocalOffset: true,
+};
+/** Does dayjs's utcOffset(offMinutes) at `t` cross a host-zone transition? (bug 11) */
+const utcOffsetDstShape = (t, offMinutes) => {
+  if (!Number.isFinite(offMinutes)) return false;
+  const shifted = t + (offMinutes + new Date(t).getTimezoneOffset()) * 60000;
+  return new Date(t).getTimezoneOffset() !== new Date(shifted).getTimezoneOffset();
+};
+const Accepted = {
+  lmtOffset: true, // utcOffset() rounded to 15 minutes (see `lmt`)
+  isBetweenSwapped: true, // isBetween accepts its bounds in either order (tested upstream)
+  minMaxEmpty: true, // dayjs.min()/max() of nothing is null (moment: now)
+  untyped: true, // non-number amounts/values, unsupported units
+  lenientRegex: true, // the parse regex accepts extended dates with basic times ("2020-01-02T012345")
+  isoWeekDate: true, // "2019-W01-2" is not parsed (moment does)
+  dateLimit: true, // arithmetic within a month of the ±8.64e15 ms Date limits
+  zoneAbbr: true, // `z` where moment-timezone has no abbreviation ("+0330" vs Intl's "GMT+3:30")
+  calendarMonths: true, // relativeTime/humanize count months as 365/12 days (moment: calendar months)
+  digitString: true, // a digits-only string is not ISO 8601 (the regex reads "3303123288581" as a date)
+  lowercaseT: true, // the regex accepts a lower-case "t" separator (moment does not)
+  negativeYear: true, // years < 0 format without the negativeYear plugin
+  dstSpan: true, // relative time across a UTC-offset change counts calendar days
+  malformedIso: true, // ISO durations with per-component signs or inner decimals
+  unnormalisedIso: true, // toISOString keeps overflowing or fractional components (PT88S; valid ISO)
+  momentLongFormat: true, // moment re-tokenises an expanded localized format ("ll" + "YY" gives YYYYYY)
+  whitespace: true, // strings with surrounding whitespace are not ISO 8601
+  hoursBubble: true, // toISOString of a sub-day duration of a day or more bubbles hours into days (P1DT15H; valid ISO)
+  fractionalComponents: true, // fractional non-lowest duration components (moment: invalid, NaN)
+  overflow: true, // "2019-13-01" parses (documented: isValid does not check overflow)
+  nonIsoUtc: true, // utc() of a non-ISO string goes through the host zone's Date parser
+  extendedYear: true, // strings with a 5+ digit year (moment: expanded years; dayjs: fall-through)
+  negativeZero: true, // -0 vs 0 from duration getters
+  momentMeridiem: true, // moment's strict meridiem regex accepts a bare "P"
+  tzData: true, // Intl (ICU) and moment-timezone disagree on a zone's offset (Casablanca's Ramadan table)
+  dstGap: true, // a wall time that lands in a DST gap after day-and-up arithmetic is resolved differently
+};
+/** The zone's offset at `t` in minutes according to Intl, dayjs's source of zone data. */
+const intlOffset = (t, zone) => {
+  const name = new Intl.DateTimeFormat("en-US", { timeZone: zone, timeZoneName: "longOffset" }).formatToParts(new Date(t)).find((p) => p.type === "timeZoneName").value;
+  const m = /^GMT(?:([+-])(\d\d):(\d\d))?$/.exec(name);
+  return m && m[1] ? (m[1] === "-" ? -1 : 1) * (Number(m[2]) * 60 + Number(m[3])) : 0;
+};
+const yearOf = (t) => new Date(t).getUTCFullYear();
+const smallYear = (...ts) => ts.some((t) => Number.isFinite(t) && yearOf(t) >= 0 && yearOf(t) < 100);
+/** Is `t` inside the repeated hour after a DST fall-back in the current zone? */
+const repeatedHour = (t) => new Date(t).getTimezoneOffset() - new Date(t - 3600000).getTimezoneOffset() > 0;
+/** Is the wall time at `t` one of two occurrences (either of them)? */
+const ambiguous = (t) => repeatedHour(t) || repeatedHour(t + 3600000);
+const SUBDAY = /^(millisecond|second|minute|hour|milliseconds|seconds|minutes|hours|ms|s|m|h|Milliseconds)$/;
+
+// ---------------------------------------------------------------------------------------------
+// Canonical rendering.
+const isInstant = (x) => x != null && typeof x === "object" && (dayjs.isDayjs(x) || moment.isMoment(x));
+const isDuration = (x) => x != null && typeof x === "object" && (dayjs.isDuration?.(x) || moment.isDuration(x));
+function describe(x) {
+  if (x === undefined) return "undefined";
+  if (x === null) return "null";
+  if (typeof x === "number") return Accepted.negativeZero ? String(x) : Object.is(x, -0) ? "-0" : String(x);
+  if (typeof x === "bigint") return `${x}n`;
+  if (typeof x === "string") return JSON.stringify(x);
+  if (typeof x === "boolean" || typeof x === "symbol") return String(x);
+  if (typeof x === "function") return "[Function]";
+  if (x instanceof Date) return Number.isNaN(x.getTime()) ? "Date(Invalid)" : `Date(${x.getTime()})`;
+  if (isInstant(x)) {
+    if (!x.isValid()) return "Invalid";
+    return `T${x.valueOf()} off${x.utcOffset()}${x.isUTC() ? " utc" : ""}`;
+  }
+  if (isDuration(x)) return `Duration(${x.asMilliseconds()} ${x.toISOString()})`;
+  if (Array.isArray(x)) return `[${x.map((v) => describe(v)).join(", ")}]`;
+  return `{${Object.keys(x).sort().map((k) => `${JSON.stringify(k)}: ${describe(x[k])}`).join(", ")}}`;
+}
+const run = (f, I) => {
+  try {
+    return describe(f(I));
+  } catch (e) {
+    return `THROW ${e?.constructor?.name ?? typeof e}`;
+  }
+};
+/** Run `f` with dayjs and with moment and compare the renderings. */
+function same(what, f) {
+  const a = run(f, dayjs);
+  // moment renders an invalid instant "Invalid date", dayjs "Invalid Date" (README)
+  const b = run(f, moment).replace(/Invalid date/g, "Invalid Date");
+  if (a === b) return;
+  // a result landing under a local-mean-time offset (before ~1900): dayjs rounds it (README)
+  if (Accepted.lmtOffset && lmt(...[...b.matchAll(/T(-?\d+) off/g)].map((m) => Number(m[1])))) {
+    count("accepted-lmt-offset");
+    return;
+  }
+  fail(`${what}\n  dayjs: ${a}\n  moment: ${b}`);
+}
+
+// ---------------------------------------------------------------------------------------------
+// Generators.
+const ZONES = ["UTC", "Europe/London", "America/New_York", "Pacific/Auckland", "Asia/Kolkata", "America/Santiago", "Australia/Lord_Howe", "Asia/Tehran", "America/Sao_Paulo", "Pacific/Apia", "Europe/Paris", "America/Whitehorse"];
+// DST (or zone) transitions as UTC instants, per zone; the generator lands near them often
+const TRANSITIONS = {
+  "Europe/London": ["2020-03-29T01:00Z", "2020-10-25T01:00Z", "2021-03-28T01:00Z", "1970-10-31T02:00Z"],
+  "Europe/Paris": ["2020-03-29T01:00Z", "2020-10-25T01:00Z", "2023-10-29T01:00Z"],
+  "America/New_York": ["2020-03-08T07:00Z", "2020-11-01T06:00Z", "2007-03-11T07:00Z", "1974-01-06T07:00Z"],
+  "America/Whitehorse": ["2020-03-08T10:00Z", "2019-11-03T09:00Z", "2020-11-01T09:00Z"],
+  "Pacific/Auckland": ["2020-04-05T14:00Z", "2020-09-27T14:00Z", "2021-04-04T14:00Z"],
+  "America/Santiago": ["2020-04-05T03:00Z", "2020-09-06T04:00Z", "2022-04-03T03:00Z"],
+  "Australia/Lord_Howe": ["2020-04-05T15:00Z", "2020-10-04T15:00Z"],
+  "Asia/Tehran": ["2020-03-21T20:30Z", "2020-09-21T19:30Z", "2022-03-21T20:30Z"],
+  "America/Sao_Paulo": ["2018-11-04T03:00Z", "2019-02-17T02:00Z"],
+  "Pacific/Apia": ["2011-12-30T10:00Z", "2012-04-01T14:00Z", "2021-04-04T14:00Z"],
+  "Asia/Kolkata": ["1945-10-14T17:30Z"],
+  UTC: [],
+};
+// dayjs rounds utcOffset() to 15 minutes (a Firefox 24 workaround kept from moment 2.x, which moment
+// has since dropped), so instants under a local-mean-time offset (before ~1900 in most zones)
+// differ in every offset-bearing result (README)
+// a local mean time offset: not a multiple of 15 minutes, or carrying seconds (Whitehorse -9:00:12)
+const lmt = (...ts) => ts.some((t) => Number.isFinite(t) && (Math.abs(new Date(t).getTimezoneOffset()) % 15 !== 0 || new Date(t).getSeconds() !== new Date(t).getUTCSeconds()));
+function setZone(tc) {
+  const zone = pick(tc, ZONES);
+  process.env.TZ = zone;
+  count(`tz=${zone}`);
+  return zone;
+}
+/** A UTC timestamp: random in 1900–2100, or near a transition of the zone, or an edge. */
+function genInstant(tc, zone) {
+  const r = n(tc, 0, 99);
+  const tr = TRANSITIONS[zone] ?? [];
+  if (r < 35 && tr.length) return Date.parse(pick(tc, tr)) + n(tc, -180, 180) * 60000 + (chance(tc, 30) ? n(tc, 0, 59999) : 0);
+  if (r < 40) return pick(tc, [0, -1, 1, 86400000, -86400000, 951782400000, 951868799999, 4102444800000, -2208988800000, 253402300799999, 8640000000000000, -8640000000000000, 1e12, -62135596800000]);
+  if (r < 45) return Date.UTC(n(tc, 1900, 2100), n(tc, 0, 11), pick(tc, [1, 28, 29, 30, 31]), pick(tc, [0, 23]), pick(tc, [0, 59]), pick(tc, [0, 59]), pick(tc, [0, 999]));
+  const y = r < 50 ? n(tc, -1000, 3000) : n(tc, 1900, 2100);
+  const t = Date.UTC(2000, n(tc, 0, 11), n(tc, 1, 31), n(tc, 0, 23), n(tc, 0, 59), n(tc, 0, 59), n(tc, 0, 999));
+  const d = new Date(t);
+  d.setUTCFullYear(y);
