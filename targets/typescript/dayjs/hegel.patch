+// Pins: one per bug in bugs.toml; each fails while the bug exists.
+const inZone = (zone, body) => {
+  const old = process.env.TZ;
+  process.env.TZ = zone;
+  try {
+    return body();
+  } finally {
+    process.env.TZ = old;
+  }
+};
