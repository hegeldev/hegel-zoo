+    const op = chance(tc, 50) ? "add" : "subtract";
+    const sumMs = moment.duration(...args)[op](moment.duration(...args2)).asMilliseconds();
+    // moment keeps an object's days apart from its milliseconds and renormalises the sum's sign
+    // (README); the hours() of a sum with such an operand are not compared
+    const messy2 = (kind2 === "object" && (Object.values(args2[0]).some((v) => !Number.isInteger(v)) || new Set(Object.values(args2[0]).filter((v) => v !== 0).map((v) => Math.sign(v))).size > 1)) || (kind2 === "n,unit" && !Number.isInteger(args2[0]));
+    same(`${what}.${op}(duration(${args2.map((a) => describe(a)).join(", ")}))`, (I) => {
+      const d = I.duration(...args)[op](I.duration(...args2));
+      return [d.asMilliseconds(), Math.abs(sumMs) >= 86400000 || !Number.isInteger(sumMs) || messy2 ? "(iso skipped)" : d.toISOString(), messy2 ? "(hours skipped)" : d.hours()];
+    });
+    if (chance(tc, 40)) same(`${what}.${op}(${describe(args2[0])}, ${describe(args2[1])})`, (I) => (kind2 === "iso" || kind2 === "object" ? I.duration(...args)[op](args2[0]) : I.duration(...args)[op](args2[0], args2[1] ?? "ms")).asMilliseconds());
+  }
+});
