+// ---------------------------------------------------------------------------------------------
+// relativeTime: from/to with an explicit reference (fromNow would race the clock), calendar.
+property("TestHegelRelativeTimeLikeMoment", (tc) => {
+  const zone = setZone(tc);
+  const t1 = genInstant(tc, zone);
+  const delta = chance(tc, 60) ? pick(tc, [0, 1, 999, 1000, 44999, 45000, 89999, 90000, 44 * 60000, 45 * 60000, 89 * 60000, 90 * 60000, 21 * 3600000, 22 * 3600000, 35 * 3600000, 36 * 3600000, 25 * 86400000, 26 * 86400000, 45 * 86400000, 46 * 86400000, 319 * 86400000, 320 * 86400000, 547 * 86400000, 548 * 86400000, 11 * 2592000000, 12 * 2592000000, 30 * 86400000, 31 * 86400000, 365 * 86400000, 366 * 86400000, 10 * 365 * 86400000]) * (chance(tc, 50) ? -1 : 1) : n(tc, -1e11, 1e11);
+  const t2 = t1 + delta;
+  if (lmt(t1, t2)) {
+    count("accepted-lmt-offset");
+    return;
+  }
+  if (Accepted.negativeYear && (yearOf(t1) < 0 || yearOf(t2) < 0)) {
+    count("accepted-negative-year");
+    return;
+  }
+  count(`|delta|<${delta === 0 ? "0" : 10 ** Math.ceil(Math.log10(Math.abs(delta)))}`);
+  // dayjs rounds the calendar-month (or year) difference; moment rounds whole months plus the
+  // remainder in 30.436875-day months: skip where the two roundings disagree
+  // (both are asymmetric in their arguments: to() measures from t1 to t2, from() the reverse)
+  const op = pick(tc, ["from", "to"]);
+  const [f, g] = op === "to" ? [moment(t1), moment(t2)] : [moment(t2), moment(t1)];
+  const span = moment.duration({ from: f, to: g });
+  // dayjs: 26-45 days is "a month", beyond that the rounded calendar-month diff; moment: 26+ days
+  // go by the rounded month count of whole months plus a 30.436875-day remainder
+  const dayjsLabel = () => {
+    const dd = Math.round(Math.abs(f.diff(g, "day", true)));
+    if (dd <= 25) return "dd";
+    if (dd <= 45) return "M";
+    const mo = Math.round(Math.abs(f.diff(g, "month", true)));
+    if (mo <= 1) return "M";
+    if (mo <= 10) return `MM${mo}`;
+    if (mo <= 17) return "y";
+    return `yy${Math.round(Math.abs(f.diff(g, "year", true)))}`;
+  };
+  const momentLabel = () => {
+    if (Math.round(Math.abs(span.as("days"))) < 26) return "dd";
+    const mo = Math.round(Math.abs(span.as("months")));
+    if (mo <= 1) return "M";
+    if (mo < 11) return `MM${mo}`;
+    const yr = Math.round(Math.abs(span.as("years")));
+    if (yr <= 1) return "y";
+    return `yy${yr}`;
+  };
+  if (Accepted.calendarMonths && Math.abs(delta) >= 25 * 86400000 && dayjsLabel() !== momentLabel()) {
+    count("accepted-calendar-months");
+    return;
+  }
+  if (Accepted.dstSpan && new Date(t1).getTimezoneOffset() !== new Date(t2).getTimezoneOffset()) {
+    count("accepted-dst-span");
+    return;
+  }
+  const suffix = chance(tc, 30);
+  same(`${op}(${t1}, ${t2}${suffix ? ", true" : ""})`, (I) => I(t1)[op](I(t2), suffix));
+  if (chance(tc, 30)) same(`${op}(${t1}, raw ${t2})`, (I) => [I(t1)[op](t2), I(t1)[op](new Date(t2))]);
+  if (chance(tc, 30)) {
+    count("calendar");
+    same(`calendar(${t1}, ${t2})`, (I) => I(t1).calendar(I(t2)));
+  }
+});
