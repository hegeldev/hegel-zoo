index 0000000..766c615
--- /dev/null
+++ b/test/hegel.test.mjs
@@ -0,0 +1,625 @@
+// Hegel zoo: properties of qs (ljharb/qs) — parse∘stringify round trips across the option
+// matrix, parse as a normal form on arbitrary query strings, and agreement with the WHATWG
+// URLSearchParams on flat objects.
+//
+// Run with `node --test --test-reporter=tap test/hegel.test.mjs`; ZOO_COLLECT=1 records
+// mismatches instead of failing (see test/hegel-zoo.mjs).
+
+import qs from "../lib/index.js";
+import { property, pin, fail, count, n, pick, chance, word, same, show } from "./hegel-zoo.mjs";
+
+// ---------------------------------------------------------------- generators
+
+// Characters that mean something to the format, plus ordinary ones.
+const KEY_CHARS = ["a", "b", "k", "Z", "0", "9", "_", "-", " ", ".", "&", "=", "+", "%", ",", ";", "|", "#", "?", "/", "'", "é", "✓", "全", "😀", "\t"];
+const VALUE_CHARS = [...KEY_CHARS, "\n", "\r", "\\", '"', "~", "(", ")", "*", "@"];
+const KEY_LITERALS = ["true", "null", "", "0", "1", "10", "01", "-1", "utf8", "constructor", "toString", "__proto__", "%2E", "%5B", "a.b", "a[b]", "a[]", "[a", "a]", "&#65;", "x+y"];
+const VALUE_LITERALS = ["true", "false", "null", "undefined", "", "0", "1e21", "&#65;", "&#10003;", "%2C", "%5B%5D", "x,y", ",", "+", "a b", "utf8=%E2%9C%93", "[object Object]", "1970-01-01T00:00:00.000Z"];
+
+function genKey(tc) {
+  if (chance(tc, 20)) {
+    return pick(tc, KEY_LITERALS);
+  }
+  const k = word(tc, KEY_CHARS, 1, 6);
+  return chance(tc, 6) ? k + pick(tc, ["[", "]", "[]", "]["]) + word(tc, KEY_CHARS, 0, 2) : k;
+}
+
+// A string, 3% of the time with a lone surrogate in it.
+function genString(tc, lo, hi) {
+  const s = word(tc, VALUE_CHARS, lo, hi);
+  return chance(tc, 3) ? s + pick(tc, ["\ud800", "\udc00"]) + word(tc, VALUE_CHARS, 0, 2) : s;
+}
+
+function genScalar(tc) {
+  const r = n(tc, 0, 99);
+  if (r < 6) return true;
+  if (r < 10) return false;
+  if (r < 20) return null;
+  if (r < 24) return undefined;
+  if (r < 30) return pick(tc, [0, 1, -1, -0, 7, 1.5, 1e21, 0.1, NaN]);
+  if (r < 34) return new Date(n(tc, -1e12, 4e12));
+  if (r < 50) return pick(tc, VALUE_LITERALS);
+  return genString(tc, 0, 8);
+}
+
+// A value: a scalar, or (down to depth 0) an array or an object of values.
+function genValue(tc, depth) {
+  const r = n(tc, 0, 99);
+  if (depth > 0 && r < 22) return genArray(tc, depth);
+  if (depth > 0 && r < 40) return genObject(tc, depth - 1);
+  return genScalar(tc);
+}
+
+function genArray(tc, depth) {
+  const len = chance(tc, 5) ? n(tc, 10, 13) : n(tc, 0, 5);
+  const out = [];
+  for (let i = 0; i < len; i++) {
+    out.push(chance(tc, 80) ? genScalar(tc) : genValue(tc, depth - 1));
+  }
+  return out;
+}
+
+// An object of values with distinct keys (never __proto__: the parser's guard is documented).
+function genObject(tc, depth) {
+  const out = {};
+  const size = n(tc, 0, 5);
+  for (let i = 0; i < size; i++) {
+    const k = genKey(tc);
+    if (k in out || k === "__proto__") {
+      continue;
+    }
+    out[k] = genValue(tc, depth);
+  }
+  return out;
+}
+
+// The option record shared by stringify and parse (see stringifyOptions/parseOptions).
+function genOptions(tc) {
+  const o = {};
+  const f = n(tc, 0, 99);
+  o.arrayFormat = f < 40 ? "indices" : f < 60 ? "brackets" : f < 75 ? "repeat" : "comma";
+  o.commaRoundTrip = o.arrayFormat === "comma" && chance(tc, 50);
+  o.allowDots = chance(tc, 25);
+  o.encodeDotInKeys = o.allowDots && chance(tc, 50);
+  o.strictNullHandling = chance(tc, 30);
+  o.skipNulls = chance(tc, 15);
+  o.allowEmptyArrays = chance(tc, 30);
+  o.charset = chance(tc, 20) ? "iso-8859-1" : "utf-8";
+  o.charsetSentinel = chance(tc, 15);
+  o.parseCharset = !o.charsetSentinel || chance(tc, 50);
+  o.interpret = o.charset === "iso-8859-1" && chance(tc, 70);
+  o.format = chance(tc, 20) ? "RFC1738" : "RFC3986";
+  o.encode = !chance(tc, 8);
+  o.encodeValuesOnly = o.encode && chance(tc, 25);
+  o.delimiter = pick(tc, ["&", "&", "&", "&", "&", "&", "&", ";", ";", "|"]);
+  o.addQueryPrefix = chance(tc, 15);
+  o.sort = chance(tc, 15);
+  o.plainObjects = chance(tc, 20);
+  return o;
+}
+
+const compare = (a, b) => (a < b ? -1 : a > b ? 1 : 0);
+
+function stringifyOptions(o) {
+  const s = {
+    arrayFormat: o.arrayFormat,
+    allowDots: o.allowDots,
+    encodeDotInKeys: o.encodeDotInKeys,
+    strictNullHandling: o.strictNullHandling,
+    skipNulls: o.skipNulls,
+    allowEmptyArrays: o.allowEmptyArrays,
+    charset: o.charset,
+    charsetSentinel: o.charsetSentinel,
+    format: o.format,
+    encode: o.encode,
+    encodeValuesOnly: o.encodeValuesOnly,
+    delimiter: o.delimiter,
+    addQueryPrefix: o.addQueryPrefix,
+  };
+  if (o.arrayFormat === "comma") s.commaRoundTrip = o.commaRoundTrip;
+  if (o.sort) s.sort = compare;
+  return s;
+}
+
+function parseOptions(o) {
+  const p = {
+    comma: o.arrayFormat === "comma",
+    allowDots: o.allowDots,
+    decodeDotInKeys: o.encodeDotInKeys,
+    strictNullHandling: o.strictNullHandling,
+    allowEmptyArrays: o.allowEmptyArrays,
+    charsetSentinel: o.charsetSentinel,
+    interpretNumericEntities: o.interpret,
+    delimiter: o.delimiter,
+    ignoreQueryPrefix: o.addQueryPrefix,
+    plainObjects: o.plainObjects,
+  };
+  if (o.parseCharset) p.charset = o.charset;
+  return p;
+}
+
+// ---------------------------------------------------------------- the model
+
+// What parse(stringify(obj, o), o) should give. The format is untyped: numbers, booleans and
+// dates come back as the text stringify writes; null is '' unless strictNullHandling; undefined
+// is not written; an empty array or object is not written (an empty array is `k[]` with
+// allowEmptyArrays); under repeat a one-element array is its element and under comma one
+// element is a scalar unless commaRoundTrip; comma joins nulls and undefineds as '' and
+// drops the array when the join is empty with skipNulls; under iso-8859-1 a character above
+// U+00FF is a numeric entity unless interpretNumericEntities. Everything else comes back.
+const DROP = Symbol("drop");
+
+function expected(obj, o) {
+  const out = {};
+  for (const [k, v] of Object.entries(obj)) {
+    const r = back(v, o);
+    if (r !== DROP) out[k] = r;
+  }
+  return out;
+}
+
+function back(v, o) {
+  if (v === undefined) return DROP;
+  if (v === null) return o.skipNulls ? DROP : o.strictNullHandling ? null : "";
+  if (v instanceof Date) return strBack(v.toISOString(), o);
+  if (Array.isArray(v)) return arrayBack(v, o);
+  if (typeof v === "object") {
+    const child = expected(v, o);
+    return Object.keys(child).length === 0 ? DROP : child;
+  }
+  return strBack(String(v), o);
+}
+
+function commaText(x) {
+  if (x === undefined || x === null) return "";
+  if (x instanceof Date) return x.toISOString();
+  return String(x);
+}
+
+function arrayBack(a, o) {
+  if (a.length === 0) return o.allowEmptyArrays ? [] : DROP;
+  if (o.arrayFormat === "comma") {
+    const items = a.map(commaText);
+    if (items.join(",") === "") {
+      // one element that writes nothing: the value is null
+      const v = o.skipNulls ? DROP : o.strictNullHandling ? null : "";
+      return v === DROP ? DROP : o.commaRoundTrip ? [v] : v;
+    }
+    const mapped = items.map((s) => strBack(s, o));
+    if (a.length === 1) return o.commaRoundTrip ? mapped : mapped[0];
+    return mapped;
+  }
+  const items = [];
+  for (const x of a) {
+    if (x === undefined || (o.skipNulls && x === null)) continue;
+    const r = back(x, o);
+    if (r !== DROP) items.push(r);
+  }
+  if (items.length === 0) return DROP;
+  if (o.arrayFormat === "repeat" && items.length === 1) return items[0];
+  return items;
+}
+
+function strBack(s, o) {
+  if (o.encode && o.charset === "iso-8859-1" && !o.interpret) {
+    return s.replace(/[Ā-￿]/g, (c) => `&#${c.charCodeAt(0)};`);
+  }
+  return s;
+}
+
+// ---------------------------------------------------------------- pinned shapes and limits
+
+const UNSAFE_KEY = /[&=+%[\]|;]/;
+const UNSAFE_VALUE = /[&+%|;\]]/;
+const RAW_KEY_BREAKS = /[&=+]|%[0-9A-Fa-f]{2}/;
+
+function isIndex(k) {
+  return /^(0|[1-9][0-9]*)$/.test(k);
+}
+
+function isScalar(x) {
+  return x === null || typeof x !== "object" || x instanceof Date;
+}
+
+// The shapes of the recorded bugs and of the format's documented limits, read off the input.
+// A case with none of them must round-trip exactly; a case with some is counted and only
+// checked when it happens to round-trip anyway.
+function stringShapes(s, o, out, isKey, nested) {
+  if (!s.isWellFormed()) out.add("qs/lone-surrogate");
+  if (o.charset === "iso-8859-1" && s.includes("+")) out.add("qs/iso-plus");
+  if (o.charset === "iso-8859-1" && o.interpret && /&#\d+;/.test(s)) out.add("limit/literal-entity");
+  if (isKey) {
+    if (o.charset === "iso-8859-1" && /[Ā-￿]/.test(s)) out.add("qs/iso-key-entities");
+    if (s.includes("[") || (nested && s.includes("]"))) out.add("qs/bracket-key");
+    if (o.allowDots && !o.encodeDotInKeys && s.includes(".")) out.add("limit/dot-key");
+    if (o.encodeDotInKeys && s.includes(".") && (!o.encode || o.encodeValuesOnly)) out.add("qs/dot-single-encoded");
+    if (o.encodeDotInKeys && s.includes("%2E")) out.add("limit/literal-pct2E");
+    if ((!o.encode || o.encodeValuesOnly) && (UNSAFE_KEY.test(s) || s.includes(o.delimiter))) out.add("limit/unencoded-key");
+  } else if (!o.encode) {
+    if (UNSAFE_VALUE.test(s) || s.includes(o.delimiter) || (o.arrayFormat === "comma" && s.includes(","))) out.add("limit/unencoded-value");
+  }
+}
+
+function valueShapes(v, o, out, ctx) {
+  if (v === undefined || v === null || typeof v === "boolean") return;
+  if (typeof v === "number") {
+    stringShapes(String(v), o, out, false, true); // 1e+21 has a plus
+    return;
+  }
+  if (v instanceof Date) return;
+  if (typeof v === "string") {
+    stringShapes(v, o, out, false, true);
+    return;
+  }
+  // qs/11: the prefix's separator dots are re-encoded at the next level
+  if (ctx.dotted && o.allowDots && o.encodeDotInKeys && o.encode && !o.encodeValuesOnly) out.add("qs/dot-prefix-reencoded");
+  if (Array.isArray(v)) {
+    arrayShapes(v, o, out, ctx);
+    return;
+  }
+  objectShapes(v, o, out, ctx);
+}
+
+function arrayShapes(a, o, out, ctx) {
+  // qs/10: the `k[]` of an empty array is written without the encoder
+  if (a.length === 0 && o.allowEmptyArrays && o.encode && !o.encodeValuesOnly && ctx.unsafePath) out.add("qs/empty-array-key-unencoded");
+  const nested = a.some((x) => !isScalar(x));
+  if (o.arrayFormat === "comma") {
+    if (nested) out.add("limit/comma-nested");
+    const items = a.map(commaText);
+    if (a.length >= 2 && o.encode && !o.encodeValuesOnly) out.add("qs/comma-encoded");
+    if (a.length >= 2 && o.charset === "iso-8859-1" && o.interpret) out.add("qs/comma-entities-rejoin");
+    if (a.length === 1 && items[0] === "" && o.allowEmptyArrays && o.commaRoundTrip && !o.skipNulls) out.add("qs/empty-array-ambiguity");
+    for (const s of items) stringShapes(s, o, out, false, true);
+    return;
+  }
+  if (o.arrayFormat !== "indices" && nested) out.add("limit/nested-array-format");
+  const items = a.filter((x) => x !== undefined && !(o.skipNulls && x === null));
+  if (o.sort && o.arrayFormat !== "indices" && a.length > 10) out.add("qs/sort-reorders-arrays"); // every index is sorted, written or not
+  if (o.arrayFormat === "brackets" && o.allowEmptyArrays && items.length === 1 && (items[0] === "" || items[0] === null)) out.add("qs/empty-array-ambiguity");
+  for (const x of a) valueShapes(x, o, out, { nested: true, unsafePath: ctx.unsafePath, dotted: ctx.dotted });
+}
+
+function objectShapes(obj, o, out, ctx) {
+  for (const [k, v] of Object.entries(obj)) {
+    if (k === "") out.add("limit/empty-key");
+    if (ctx.nested && isIndex(k)) out.add("limit/numeric-key");
+    if (!o.plainObjects && Object.prototype.hasOwnProperty.call(Object.prototype, k)) out.add("limit/prototype-key");
+    stringShapes(k, o, out, true, ctx.nested);
+    const unsafePath = ctx.unsafePath || RAW_KEY_BREAKS.test(k) || k.includes(o.delimiter) || (o.encodeDotInKeys && k.includes("."));
+    // below the top level a child's prefix is `parent.k` with allowDots
+    valueShapes(v, o, out, { nested: true, unsafePath, dotted: ctx.dotted || (ctx.nested && o.allowDots) });
+  }
+}
+
+function shapes(obj, o) {
+  const out = new Set();
+  objectShapes(obj, o, out, { nested: false, unsafePath: false, dotted: false });
+  return out;
+}
+
+// ---------------------------------------------------------------- properties
+
+property("TestHegelParseUndoesStringify", (tc) => {
+  const o = genOptions(tc);
+  const obj = genObject(tc, 3);
+  tc.note(`options ${show(o)}`);
+  tc.note(`object ${show(obj)}`);
+  const s = qs.stringify(obj, stringifyOptions(o));
+  tc.note(`string ${show(s)}`);
+  const got = qs.parse(s, parseOptions(o));
+  const want = expected(obj, o);
+  const sh = shapes(obj, o);
+  for (const k of sh) count(k);
+  if (same(got, want)) {
+    count(sh.size === 0 ? "clean" : "clean-despite-shape");
+    return;
+  }
+  if (sh.size > 0) {
+    count("mismatch-explained");
+    return;
+  }
+  fail(`round trip changed the object\n  object ${show(obj)}\n  options ${show(o)}\n  string ${show(s)}\n  parsed ${show(got)}\n  wanted ${show(want)}`);
+});
+
+// A random query string, from pieces that mean something to the parser.
+const KEY_PIECES = ["a", "b", "c", "0", "1", "2", "10", "[]", "[0]", "[1]", "[b]", "[", "]", ".", ".c", "%5B", "%5D", "%2E", "%252E", "%20", "+", "%E9", "%FF", " ", "utf8", "__proto__", "constructor", "[__proto__]", "[[a]]", "x[", "%", "%E2%9C%93"];
+const VALUE_PIECES = ["", "v", "1", "a,b", ",", "%2C", "x%20y", "+", "%", "%E2%9C%93", "%26%2310003%3B", "&#65;", "é", "null", "✓", "[", "]=", "="];
+
+function genQuery(tc, delimiter) {
+  const parts = [];
+  const len = n(tc, 0, 6);
+  for (let i = 0; i < len; i++) {
+    const r = n(tc, 0, 99);
+    if (r < 4) {
+      parts.push(pick(tc, ["utf8=%E2%9C%93", "utf8=%26%2310003%3B", "utf8=x"]));
+      continue;
+    }
+    const key = word(tc, KEY_PIECES, 1, 4);
+    if (r < 12) parts.push(key);
+    else if (r < 16) parts.push("=" + pick(tc, VALUE_PIECES));
+    else parts.push(key + "=" + word(tc, VALUE_PIECES, 0, 2));
+  }
+  let s = parts.join(delimiter);
+  if (chance(tc, 10)) s = "?" + s;
+  return s;
+}
+
+function genParseOptions(tc) {
+  const p = {};
+  if (chance(tc, 30)) p.comma = true;
+  if (chance(tc, 30)) p.allowDots = true;
+  if (chance(tc, 15)) p.decodeDotInKeys = true;
+  if (chance(tc, 30)) p.strictNullHandling = true;
+  if (chance(tc, 30)) p.allowEmptyArrays = true;
+  if (chance(tc, 30)) p.duplicates = pick(tc, ["combine", "first", "last"]);
+  if (chance(tc, 30)) p.depth = pick(tc, [0, 1, 2, 3, 6, false]);
+  if (chance(tc, 30)) p.arrayLimit = pick(tc, [-1, 0, 1, 2, 3, 20, 25]);
+  if (chance(tc, 15)) p.parseArrays = false;
+  if (chance(tc, 20)) p.plainObjects = true;
+  if (chance(tc, 15)) p.allowSparse = true;
+  if (chance(tc, 15)) p.allowPrototypes = true;
+  if (chance(tc, 20)) p.charset = "iso-8859-1";
+  if (chance(tc, 20)) p.charsetSentinel = true;
+  if (chance(tc, 20)) p.interpretNumericEntities = true;
+  if (chance(tc, 20)) p.ignoreQueryPrefix = true;
+  if (chance(tc, 15)) p.strictDepth = true;
+  if (chance(tc, 15)) p.throwOnLimitExceeded = true;
+  if (chance(tc, 15)) p.parameterLimit = n(tc, 0, 8);
+  if (chance(tc, 10)) p.strictMerge = false;
+  return p;
+}
+
+function walk(v, f, path = []) {
+  f(v, path);
+  if (v !== null && typeof v === "object") {
+    for (const k of Object.keys(v)) walk(v[k], f, [...path, k]);
+  }
+}
+
+function longestArray(v) {
+  let m = 0;
+  walk(v, (x) => {
+    if (Array.isArray(x) && x.length > m) m = x.length;
+  });
+  return m;
+}
+
+function hasArray(v) {
+  let a = false;
+  walk(v, (x) => {
+    if (Array.isArray(x)) a = true;
+  });
+  return a;
+}
+
+function hasHole(v) {
+  let h = false;
+  walk(v, (x) => {
+    if (Array.isArray(x)) {
+      for (let i = 0; i < x.length; i++) if (!(i in x)) h = true;
+    }
+  });
+  return h;
+}
+
+function emptyObjects(v) {
+  let e = false;
+  walk(v, (x, path) => {
+    if (path.length > 0 && x !== null && typeof x === "object" && !Array.isArray(x) && Object.keys(x).length === 0) e = true;
+  });
+  return e;
+}
+
+function emptyArrayUnderRawKey(v) {
+  let e = false;
+  walk(v, (x, path) => {
+    if (Array.isArray(x) && x.length === 0 && path.some((k) => RAW_KEY_BREAKS.test(k))) e = true;
+  });
+  return e;
+}
+
+function hasTrue(v) {
+  let t = false;
+  walk(v, (x) => {
+    if (x === true) t = true;
+  });
+  return t;
+}
+
+function bracketKeys(v) {
+  let b = false;
+  walk(v, (x) => {
+    if (x !== null && typeof x === "object" && !Array.isArray(x)) {
+      for (const k of Object.keys(x)) if (/[[\]]/.test(k)) b = true;
+    }
+  });
+  return b;
+}
+
+property("TestHegelParseIsANormalForm", (tc) => {
+  const p = genParseOptions(tc);
+  const delimiter = pick(tc, ["&", "&", "&", ";"]);
+  if (delimiter !== "&") p.delimiter = delimiter;
+  const s = genQuery(tc, delimiter);
+  tc.note(`options ${show(p)}`);
+  tc.note(`query ${show(s)}`);
+  let r;
+  try {
+    r = qs.parse(s, p);
+  } catch (e) {
+    if (e instanceof RangeError && (p.strictDepth || p.throwOnLimitExceeded)) {
+      count("range-error");
+      return;
+    }
+    fail(`parse threw ${e}\n  query ${show(s)}\n  options ${show(p)}`);
+  }
+  tc.note(`parsed ${show(r)}`);
+  if (typeof r !== "object" || r === null || Array.isArray(r)) {
+    fail(`parse returned ${show(r)} for ${show(s)}`);
+  }
+  if (Object.keys(r).includes("__proto__")) {
+    fail(`parse produced a __proto__ key: ${show(r)} for ${show(s)}`);
+  }
+  if (!p.allowSparse && hasHole(r)) {
+    fail(`parse left a hole in an array: ${show(r)} for ${show(s)} with ${show(p)}`);
+  }
+  const limit = typeof p.arrayLimit === "number" ? p.arrayLimit : 20;
+  if (p.throwOnLimitExceeded && longestArray(r) > Math.max(limit, 0)) {
+    fail(`an array longer than arrayLimit ${limit} with throwOnLimitExceeded: ${show(r)} for ${show(s)}`);
+  }
+  // Parsing what stringify writes for the result gives the result again (indices, so every
+  // structure is spelt out; the same null/empty-array/array conventions).
+  const so = { arrayFormat: "indices", strictNullHandling: !!p.strictNullHandling, allowEmptyArrays: !!p.allowEmptyArrays };
+  const po = {
+    strictNullHandling: !!p.strictNullHandling,
+    allowEmptyArrays: !!p.allowEmptyArrays,
+    allowSparse: !!p.allowSparse,
+    plainObjects: !!p.plainObjects,
+    allowPrototypes: !!p.allowPrototypes,
+    parseArrays: p.parseArrays !== false,
+    depth: Infinity,
+  };
+  if (typeof p.arrayLimit === "number") po.arrayLimit = p.arrayLimit;
+  const t = qs.stringify(r, so);
+  const r2 = qs.parse(t, po);
+  const sh = new Set();
+  if (bracketKeys(r)) sh.add("qs/bracket-key");
+  if (emptyObjects(r) || ((p.plainObjects || p.allowPrototypes) && /\[__proto__\]/.test(s))) sh.add("qs/proto-empty-object");
+  if (p.parseArrays === false && hasArray(r)) sh.add("limit/parsearrays-duplicates");
+  if (p.strictMerge === false && hasTrue(r)) sh.add("limit/strict-merge-boolean"); // the legacy `d: true` (README)
+  if (p.allowEmptyArrays && emptyArrayUnderRawKey(r)) sh.add("qs/empty-array-key-unencoded");
+  for (const k of sh) count(k);
+  if (same(r, r2)) {
+    count(sh.size === 0 ? "clean" : "clean-despite-shape");
+    return;
+  }
+  if (sh.size > 0) {
+    count("mismatch-explained");
+    return;
+  }
+  fail(`parse∘stringify is not a normal form\n  query ${show(s)}\n  options ${show(p)}\n  parsed ${show(r)}\n  restrung ${show(t)}\n  reparsed ${show(r2)}`);
+});
+
+// Flat objects of strings: qs and the WHATWG URLSearchParams must agree in both directions.
+const FLAT_KEY_CHARS = ["a", "b", "Z", "0", "1", "_", "-", " ", ".", "]", "&", "=", "+", "%", ",", ";", "#", "?", "/", "'", "é", "✓", "😀", "\t", "*", "~"];
+
+function genFlat(tc) {
+  const out = {};
+  const size = n(tc, 1, 5);
+  for (let i = 0; i < size; i++) {
+    const k = word(tc, FLAT_KEY_CHARS, 1, 6);
+    if (k in out || Object.prototype.hasOwnProperty.call(Object.prototype, k)) continue;
+    out[k] = word(tc, VALUE_CHARS, 0, 8);
+  }
+  return out;
+}
+
+property("TestHegelAgreesWithURLSearchParams", (tc) => {
+  const obj = genFlat(tc);
+  const format = pick(tc, ["RFC3986", "RFC1738"]);
+  tc.note(`object ${show(obj)} format ${format}`);
+  const s = qs.stringify(obj, { format });
+  const viaUrl = Object.fromEntries(new URLSearchParams(s));
+  if (!same(viaUrl, obj)) {
+    fail(`URLSearchParams reads qs.stringify differently\n  object ${show(obj)}\n  string ${show(s)}\n  read ${show(viaUrl)}`);
+  }
+  const u = new URLSearchParams(obj).toString();
+  const viaQs = qs.parse(u);
+  if (!same(viaQs, obj)) {
+    fail(`qs.parse reads URLSearchParams differently\n  object ${show(obj)}\n  string ${show(u)}\n  read ${show(viaQs)}`);
+  }
+  count("clean");
+});
+
+// ---------------------------------------------------------------- pins
+
+function expectSame(obj, so, po) {
+  const s = qs.stringify(obj, so);
+  const got = qs.parse(s, po);
+  if (!same(got, obj)) {
+    throw new Error(`${show(obj)} -> ${show(s)} -> ${show(got)}`);
+  }
+}
