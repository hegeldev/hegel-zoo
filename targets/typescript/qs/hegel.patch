+pin("TestHegelPinCommaArraysAreEncoded", () => {
+  // qs/1: arrayFormat comma writes the separators as %2C, which parse({comma: true}) does not
+  // split; the README shows 'a=b,c'.
+  expectSame({ a: ["b", "c"] }, { arrayFormat: "comma" }, { comma: true });
+});
+
+pin("TestHegelPinPlusIsBareUnderLatin1", () => {
+  // qs/2: under iso-8859-1 the encoder is escape(), which leaves + alone; the decoder reads
+  // it as a space.
+  expectSame({ a: "1+1" }, { charset: "iso-8859-1" }, { charset: "iso-8859-1" });
+});
+
+pin("TestHegelPinLoneSurrogateSwallowsTheNextCharacter", () => {
+  // qs/3: a lone high surrogate is combined with the following code unit into one four-byte
+  // sequence, so "x\ud800y" comes back as "x" + one astral character.
+  const got = qs.parse(qs.stringify({ a: "x\ud800y" }));
+  if (got.a.length !== 3 || !got.a.endsWith("y")) {
+    throw new Error(`got ${show(got)}: ${[...got.a].map((c) => c.codePointAt(0).toString(16)).join(" ")}`);
+  }
+});
+
+pin("TestHegelPinBracketInKeyIsUnwritable", () => {
+  // qs/4: the encoder writes [ and ] as %5B and %5D, and the parser turns them back into
+  // brackets before it splits the key, so a key containing [ becomes nesting and a ] in a
+  // nested key ends the segment early.
+  expectSame({ "a[b": "v", c: { "d]e": "w" } }, {}, {});
+});
+
+pin("TestHegelPinEmptyArrayKeyIsNotEncoded", () => {
