index 0000000..75a94d1
--- /dev/null
+++ b/hegel/gen.mjs
@@ -0,0 +1,256 @@
+// Generators for hono's routers: small route tables over a tiny alphabet (so routes overlap) and
+// request paths derived from them (instantiated, then sometimes bent).
+//
+// Everything here is a generator value built from Hegel's combinators. A route is drawn as a list
+// of segments, the names for its parameters and a tail wish, and rendered to its path by a pure
+// function; a request is drawn as the index of the route it instantiates (taken modulo the live
+// table size), one value per segment, and an optional bend applied as data. The case generator is
+// per router: in the default run it keeps a router's routes away from the shapes of the bugs
+// recorded against it (the gates in hegel.test.mjs name the same shapes and skip what is left) and
+// from the tables the router documents it rejects; ZOO_FULL opens all of that and adds regexp
+// patterns RegExpRouter rejects.
+import { gs } from "./hegel-zoo.mjs";
+
+export const FULL = !!process.env.ZOO_FULL;
+
+// ---- helpers -----------------------------------------------------------------------------------
+
+const ints = (lo, hi) => gs.integers({ minValue: lo, maxValue: hi });
+
+/** oneOf with weights: `weighted([45, a], [55, b])` draws a 45 times in 100; shrinks towards the first choice. */
+function weighted(...choices) {
+  const total = choices.reduce((sum, [w]) => sum + w, 0);
+  return ints(0, total - 1).flatMap((r) => {
+    for (const [w, g] of choices) {
+      if (r < w) return g;
+      r -= w;
+    }
+    throw new Error("unreachable");
+  });
+}
+
+/** A draw from g pct percent of the time, else undefined (listed first: shrinks to absent). */
+const maybe = (pct, g) => weighted([100 - pct, gs.just(undefined)], [pct, g]);
+/** A draw from g pct percent of the time, else "" (shrinks to the empty string). */
+const maybeText = (pct, g) => weighted([100 - pct, gs.just("")], [pct, g]);
+
+// ---- the alphabet ------------------------------------------------------------------------------
+
+const LITERALS = ["a", "b", "c", "ab", "foo", "v2", "x.js", "$", "-"];
+const NAMES = ["id", "name", "x", "y"];
+/** Regexp sub-patterns, each with a generator of strings it matches (one segment unless it eats slashes). */
+export const REGEXES = {
+  "[0-9]+": ints(0, 999).map(String),
+  "[a-z]+": gs.sampledFrom(["abc", "foo", "x", "zz"]),
+  "\\d{1,3}": ints(0, 999).map(String),
+  "[a-z]+\\.js": gs.sampledFrom(["main.js", "x.js"]),
+  "(?:foo|bar)": gs.sampledFrom(["foo", "bar"]),
+  ".+": gs.sampledFrom(["abc", "a/b", "a/b/c", "1"]),
+  "[^/]+": gs.sampledFrom(["abc", "42", "x.js"]),
+  // (FULL: patterns RegExpRouter rejects)
+  ...(FULL
+    ? {
+        "(foo|bar)": gs.sampledFrom(["foo", "bar"]),
+        ".*": gs.sampledFrom(["", "abc", "a/b"]),
+        "foo(?:bar)?": gs.sampledFrom(["foo", "foobar"]),
+        "[a-z]": gs.sampledFrom(["a", "b"]),
+      }
+    : {}),
+};
+export const VALUES = ["1", "42", "abc", "foo", "a", "a-b", "x.js", "%20", "A"];
+const value = gs.sampledFrom(VALUES);
+
+export const ROUTE_METHODS = ["GET", "GET", "POST", "ALL"];
+export const REQUEST_METHODS = ["GET", "GET", "GET", "POST", "PUT"];
+
+// ---- routes ------------------------------------------------------------------------------------
+
+// one route segment: { kind: "lit", text } | { kind: "param" } | { kind: "re", re } | { kind: "star" };
+// a route's parameters take their names from its name list in order
+const literal = gs.sampledFrom(LITERALS).map((text) => ({ kind: "lit", text }));
+const param = gs.just({ kind: "param" });
+const regexp = gs.sampledFrom(Object.keys(REGEXES)).map((re) => ({ kind: "re", re }));
+const star = gs.just({ kind: "star" });
+const segment = weighted([4, literal], [2, param], [1, regexp], [1, star]);
+
+// (CLEAN: distinct names within a route, bug 6; PatternRouter rejects duplicate names anyway)
+const names = gs.arrays(gs.sampledFrom(NAMES), { minSize: 4, maxSize: 4, unique: !FULL });
+
+// the tail wish: "" | "/*" (trailing wildcard) | "*" (suffix wildcard, glued to a last literal) |
+// "?" (last parameter optional) | "??" (the last two, when both are parameters); applied where it fits
+const tail = weighted([68, gs.just("")], [15, gs.just("/*")], [7, gs.just("*")], [6, gs.just("?")], [4, gs.just("??")]);
+
+const segmentText = (s) => (s.kind === "lit" ? s.text : s.kind === "param" ? `:${s.name}` : s.kind === "re" ? `:${s.name}{${s.re}}` : "*");
+
+/** A route from its drawn parts: { path, segments, tail } with the tail as it was applied. */
+function mkRoute({ segments: drawn, names, tail: wish }) {
+  let j = 0;
+  const segments = drawn.map((s) => {
+    const named = s.kind === "param" || s.kind === "re" ? { ...s, name: names[j++] } : s;
+    return { ...named, text: segmentText(named) };
+  });
+  const last = segments[segments.length - 1];
+  const prev = segments[segments.length - 2];
+  const optional = last.kind === "param" || (FULL && last.kind === "re");
+  const tail = wish === "*" ? (last.kind === "lit" ? "*" : "") : wish === "?" || wish === "??" ? (optional ? (wish === "??" && prev?.kind === "param" ? "??" : "?") : "") : wish;
+  const texts = segments.map((s) => s.text);
+  if (tail === "?" || tail === "??") texts[texts.length - 1] += "?";
+  if (tail === "??") texts[texts.length - 2] += "?";
+  const path = "/" + texts.join("/") + (tail === "/*" ? "/*" : tail === "*" ? "*" : "");
+  return { path, segments, tail };
+}
+
+const STAR_ROUTE = { path: "*", segments: [], tail: "*", star: true };
+const ROOT_ROUTE = { path: "/", segments: [], tail: "" };
+const segmentsRoute = gs.record({ segments: gs.arrays(segment, { minSize: 1, maxSize: 4 }), names, tail }).map(mkRoute);
+
+/** A route: the root, "*", or 1-4 segments with a tail. */
+export const route = weighted([4, gs.just(ROOT_ROUTE)], [5, gs.just(STAR_ROUTE)], [91, segmentsRoute]);
+
+// ---- the shapes of the recorded bugs -----------------------------------------------------------
+
+/** SmartRouter is RegExpRouter when it accepts the table, TrieRouter otherwise: both routers' shapes apply. */
+export const routerIs = (router, ...names) => (router === "SmartRouter" ? names.includes("RegExpRouter") || names.includes("TrieRouter") : names.includes(router));
+
+// the shapes one route path shows, with the routers they are gated for (see README)
+const ROUTE_SHAPES = [
+  ["greedy-then-dynamic", /\{\.[+*]\}\/(?::|\*)/, null], // ":a{.+}/:b": TrieRouter/LinearRouter never match (bug 2)
+  ["star-then-tail", /(^|\/)\*\/\*$/, null], // "/*/*" on "/a": TrieRouter/LinearRouter say no (bug 3)
+  // ":x{re}/$", and ":x{.+}/c*" where the suffix wildcard's "*" quantifies: the literal is not escaped in the lookahead (bug 5)
+  ["meta-after-regexp", /\}\/[^/]*[.$()+?]|\}\/[^/*]+\*$/, ["TrieRouter", "LinearRouter"]],
+  ["slash-in-regexp-middleware", /\{[^}]*\/[^}]*\}\/.*\*$/, ["RegExpRouter"]], // ":x{[^/]+}/:y/*" loses its handler in RegExpRouter (bug 1)
+  ["star-then-optional", /\*\/[^/]*\?$/, null], // "/foo/*/:y?": matched twice by TrieRouter/PatternRouter, once by RegExpRouter (bug 7)
+];
+
+/** The recorded bug shapes of one route path that `router` is gated for: [[label, regexp]]. */
+export const routeShapes = (router) => ROUTE_SHAPES.filter(([, , routers]) => routers === null || routerIs(router, ...routers)).map(([label, re]) => [label, re]);
+
+/** "*" as one segment against an empty segment: routers disagree (bug 4). */
+export const MIDDLE_STAR = /(^|\/)\*\//;
+
+// hono/8: RegExpRouter attaches a middleware to
+// the other routes by testing its path regexp against their path text, in which a middle "*" is a
+// literal star (and a middle "*" of the middleware itself is escaped), so a middleware and a route
+// with a "*" and a ":label" at the same segment position never meet: `GET /*/x.js -> h0; GET /:x/*
+// -> mw` on "/foo/x.js" returns h0 alone, and so does `GET /:y/a/x.js -> h0; GET /*/a/* -> mw` on
+// "/foo/a/x.js"; TrieRouter and PatternRouter return both. (A literal at the star's position is
+// rejected as unsupported, and "*" against "*" matches textually.)
+export function starMeetsLabel(routes) {
+  const middleStar = (r, i) => r.segments[i].kind === "star" && i < r.segments.length - 1;
+  const label = (s) => s !== undefined && (s.kind === "param" || s.kind === "re");
+  const meet = (a, b) => a.segments.some((s, i) => middleStar(a, i) && label(b.segments[i]));
+  return routes.some((m) => m.path.endsWith("*") && m.path !== "*" && routes.some((r) => r !== m && (meet(m.route, r.route) || meet(r.route, m.route))));
+}
+
+// hono/9 (the same text comparison): a trailing
+// wildcard "P/*" and a suffix wildcard "P*" over the same base P are both middleware, the matcher
+// tries "P.*" before "P(?:|/.*)", and the handlers of "P*" were gathered by testing "^P(?:|/.*)$"
+// against the text "P*", which fails, so `GET /ab/* -> h0; GET /ab* -> h1` on "/ab/x" (or "/ab")
+// returns h1 alone in RegExpRouter; TrieRouter, PatternRouter and LinearRouter return both.
+export function tailMeetsSuffix(routes) {
+  return routes.some((a) => a.path.endsWith("/*") && routes.some((b) => b.path === a.path.slice(0, -2) + "*"));
+}
+
+// hono/10: TrieRouter and LinearRouter compile a
+// regexp parameter followed by a literal L as `^re(?=/L)` (utils/url.ts getPattern), a lookahead with
+// no segment terminator, so a slash-eating `.+` greedily runs to the last place where "/L" begins and
+// swallows the literal segment itself: `GET /:y{.+}/ab/:name -> h` on "/q/ab/abc" (or "/q/ab/ab") is
+// `[]` there, while RegExpRouter and PatternRouter return y = "q", name = "abc"; on "/q/ab/q" all agree.
+// The shape: such a route and a request in which "/L" begins at two or more places.
+export function greedyOvershoots(routes, req) {
+  return routes.some((r) => {
+    const m = /\{\.[+*]\}\/([^/{}:*?]+)/.exec(r.path);
+    return m !== null && req.path.split("/" + m[1]).length > 2;
+  });
+}
+
+// ---- tables ------------------------------------------------------------------------------------
+
+/** A route `router` is judged on in this run: not a recorded bug shape (CLEAN), and not one it documents it rejects. */
+const routeFor = (router) => {
+  const shapes = FULL ? [] : routeShapes(router).map(([, re]) => re);
+  // LinearRouter rejects a label mixed with a wildcard (UnsupportedPathError)
+  const mixed = (r) => router === "LinearRouter" && r.path.includes("*") && r.path.includes(":");
+  return route.filter((r) => !mixed(r) && !shapes.some((re) => re.test(r.path)));
+};
+
+/** A route table for `router`: [{ method, path, handler, route }], 1-6 routes, handlers h0, h1, ... */
+const tableFor = (router) => {
+  const routes = gs.arrays(gs.record({ method: gs.sampledFrom(ROUTE_METHODS), route: routeFor(router) }), { minSize: 1, maxSize: 6 }).map((rs) =>
+    rs.map(({ method, route }, i) => ({ method, path: route.path, handler: `h${i}`, route })),
+  );
+  // (CLEAN: the hono/8 shape is a pair of routes, so the table steers clear of it)
+  return !FULL && routerIs(router, "RegExpRouter") ? routes.filter((rs) => !starMeetsLabel(rs)) : routes;
+};
+
+// ---- requests ----------------------------------------------------------------------------------
+
+/** A string the segment matches: its text, a value of its regexp, or any value. */
+const segmentValue = (s) => (s.kind === "lit" ? gs.just(s.text) : s.kind === "re" ? REGEXES[s.re] : value);
+/** "/v" or "/v/w": what a wildcard tail may stand for. */
+const oneOrTwoValues = gs.tuples(value, maybeText(30, value.map((v) => "/" + v))).map(([a, b]) => "/" + a + b);
+/** What follows the instantiated segments: nothing, or (60% of the time) something a "/*" or "*" tail matches. */
+const extensionFor = (tail) =>
+  tail === "/*" ? maybeText(60, oneOrTwoValues) : tail === "*" ? maybeText(60, weighted([50, gs.sampledFrom(["-v2", "x", ".map"])], [50, value.map((v) => "/" + v)])) : gs.just("");
+
+/** A request path instantiating `route`: parameters filled in, optional parameters dropped or not, the tail extended or not. */
+const instance = (route) =>
+  route.star
+    ? gs.tuples(value, maybeText(50, value.map((v) => "/" + v))).map(([a, b]) => "/" + a + b)
+    : gs
+        .record({
+          parts: gs.tuples(...route.segments.map(segmentValue)),
+          drop: route.tail === "?" ? ints(0, 1) : route.tail === "??" ? ints(0, 2) : gs.just(0),
+          extension: extensionFor(route.tail),
+        })
+        .map(({ parts, drop, extension }) => "/" + parts.slice(0, parts.length - drop).join("/") + extension);
+
+/** A path of one literal, half the time with a value after it. */
+const randomPath = gs.tuples(gs.sampledFrom(LITERALS), maybeText(50, value.map((v) => "/" + v))).map(([l, v]) => "/" + l + v);
+
+// one bend of a path: a segment dropped or appended, a trailing slash, an empty segment, a literal
+// swapped in, the path doubled; `at` is taken modulo the live number of segments when applied
+const at = ints(0, 5);
+const drop = gs.just({ kind: "drop" });
+const append = value.map((value) => ({ kind: "append", value }));
+const slash = gs.just({ kind: "slash" });
+const empty = at.map((at) => ({ kind: "empty", at }));
+const swap = gs.record({ kind: gs.just("swap"), at, lit: gs.sampledFrom(LITERALS) });
+const double = gs.just({ kind: "double" });
+
+/** Bend a path as `b` says. */
+function applyBend(path, b) {
+  const parts = path.split("/").slice(1);
+  switch (b.kind) {
+    case "drop":
+      return parts.length > 1 ? "/" + parts.slice(0, -1).join("/") : path;
+    case "append":
+      return (path === "/" ? "" : path) + "/" + b.value;
+    case "slash":
+      return path.endsWith("/") ? path : path + "/";
+    case "empty":
+      parts.splice(b.at % (parts.length + 1), 0, "");
+      return "/" + parts.join("/");
+    case "swap":
+      parts[b.at % parts.length] = b.lit;
+      return "/" + parts.join("/");
+    default:
+      return path + path;
+  }
+}
+
+/** A request for the table: one of the routes instantiated (or a random path one time in ten), bent 30% of the time. */
+const requestFor = (routes, trailingSlash) =>
+  gs
+    .record({
+      method: gs.sampledFrom(REQUEST_METHODS),
+      path: weighted([10, randomPath], [90, ints(0, 5).flatMap((i) => instance(routes[i % routes.length].route))]),
+      bend: maybe(30, trailingSlash ? gs.oneOf(drop, append, slash, empty, swap, double) : gs.oneOf(drop, append, empty, swap, double)),
+    })
+    .map(({ method, path, bend }) => ({ method, path: bend === undefined ? path : applyBend(path, bend) }));
+
+/** A route table for `router` and a request for it: { routes, req }. LinearRouter and PatternRouter allow a trailing slash (documented), so their requests carry none in the default run. */
+export const routingCase = (router) => {
+  const trailingSlash = FULL || !routerIs(router, "LinearRouter", "PatternRouter");
+  return tableFor(router).flatMap((routes) => requestFor(routes, trailingSlash).map((req) => ({ routes, req })));
+};
diff --git a/hegel/hegel-zoo.mjs b/hegel/hegel-zoo.mjs
