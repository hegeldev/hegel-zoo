index 0000000..6cd4588
--- /dev/null
+++ b/hegel/gen.mjs
@@ -0,0 +1,151 @@
+// Generators for hono's routers: small route tables over a tiny alphabet (so routes overlap) and
+// request paths derived from them (instantiated, then sometimes bent).
+import { n, pick, chance } from "./hegel-zoo.mjs";
+
+export const FULL = !!process.env.ZOO_FULL;
+
+const LITERALS = ["a", "b", "c", "ab", "foo", "v2", "x.js", "$", "-"];
+const NAMES = ["id", "name", "x", "y"];
+// regexp sub-patterns and a generator of strings they match (one segment unless they contain a slash-eater)
+export const REGEXES = {
+  "[0-9]+": (tc) => String(n(tc, 0, 999)),
+  "[a-z]+": (tc) => pick(tc, ["abc", "foo", "x", "zz"]),
+  "\\d{1,3}": (tc) => String(n(tc, 0, 999)),
+  "[a-z]+\\.js": (tc) => pick(tc, ["main.js", "x.js"]),
+  "(?:foo|bar)": (tc) => pick(tc, ["foo", "bar"]),
+  ".+": (tc) => pick(tc, ["abc", "a/b", "a/b/c", "1"]),
+  "[^/]+": (tc) => pick(tc, ["abc", "42", "x.js"]),
+};
+const FULL_REGEXES = {
+  "(foo|bar)": (tc) => pick(tc, ["foo", "bar"]),
+  ".*": (tc) => pick(tc, ["", "abc", "a/b"]),
+  "foo(?:bar)?": (tc) => pick(tc, ["foo", "foobar"]),
+  "[a-z]": (tc) => pick(tc, ["a", "b"]),
+};
+export const VALUES = ["1", "42", "abc", "foo", "a", "a-b", "x.js", "%20", "A"];
+
+export function regexKeys() {
+  return FULL ? [...Object.keys(REGEXES), ...Object.keys(FULL_REGEXES)] : Object.keys(REGEXES);
+}
+export function regexValue(tc, re) {
+  return (REGEXES[re] || FULL_REGEXES[re])(tc);
+}
+
+/** One route segment: { kind: 'lit'|'param'|'re'|'star', text, name?, re? }. */
+export function segment(tc) {
+  const k = pick(tc, ["lit", "lit", "lit", "lit", "param", "param", "re", "star"]);
+  switch (k) {
+    case "lit":
+      return { kind: "lit", text: pick(tc, LITERALS) };
+    case "param": {
+      const name = pick(tc, NAMES);
+      return { kind: "param", name, text: `:${name}` };
+    }
+    case "re": {
+      const name = pick(tc, NAMES);
+      const re = pick(tc, regexKeys());
+      return { kind: "re", name, re, text: `:${name}{${re}}` };
+    }
+    default:
+      return { kind: "star", text: "*" };
+  }
+}
+
+/**
+ * A route: { path, segments, tail } where tail is '' | '/*' (trailing wildcard) | '*' (suffix
+ * wildcard glued to the last literal) | '?' (last param optional) | '??' (last two params optional).
+ */
+export function route(tc) {
+  if (chance(tc, 5)) return { path: "*", segments: [], tail: "*", star: true };
+  if (chance(tc, 4)) return { path: "/", segments: [], tail: "" };
+  const count = n(tc, 1, 4);
+  const segments = [];
+  for (let i = 0; i < count; i++) segments.push(segment(tc));
+  let tail = "";
+  const last = segments[segments.length - 1];
+  const r = n(tc, 0, 99);
+  if (r < 15) tail = "/*";
+  else if (r < 22 && last.kind === "lit") tail = "*";
+  else if (r < 32 && last.kind === "param" || (r < 32 && last.kind === "re" && FULL)) tail = "?";
+  if (tail === "?" && segments.length >= 2 && segments[segments.length - 2].kind === "param" && chance(tc, 40)) tail = "??";
+  let path = "/" + segments.map((s) => s.text).join("/");
+  if (tail === "/*") path += "/*";
+  else if (tail === "*") path += "*";
+  else if (tail === "?") path += "?";
+  else if (tail === "??") {
+    const parts = path.split("/");
+    parts[parts.length - 2] += "?";
+    parts[parts.length - 1] += "?";
+    path = parts.join("/");
+  }
+  return { path, segments, tail };
+}
+
+export const ROUTE_METHODS = ["GET", "GET", "POST", "ALL"];
+export const REQUEST_METHODS = ["GET", "GET", "GET", "POST", "PUT"];
+
+/** A route table: [{ method, path, handler }]. */
+export function table(tc) {
+  const count = n(tc, 1, 6);
+  const routes = [];
+  for (let i = 0; i < count; i++) {
+    const r = route(tc);
+    routes.push({ method: pick(tc, ROUTE_METHODS), path: r.path, handler: `h${i}`, route: r });
+  }
+  return routes;
+}
+
+/** A request path instantiating a route (params filled in), then bent with some probability. */
+export function requestFor(tc, r) {
+  if (r.star) return "/" + pick(tc, VALUES) + (chance(tc, 50) ? "/" + pick(tc, VALUES) : "");
+  const parts = [];
+  const segs = r.segments;
+  let optionalDrop = 0;
+  if (r.tail === "?") optionalDrop = chance(tc, 50) ? 1 : 0;
+  if (r.tail === "??") optionalDrop = n(tc, 0, 2);
+  for (let i = 0; i < segs.length - optionalDrop; i++) {
+    const s = segs[i];
+    if (s.kind === "lit") parts.push(s.text);
+    else if (s.kind === "param" || s.kind === "star") parts.push(pick(tc, VALUES));
+    else parts.push(regexValue(tc, s.re));
+  }
+  let path = "/" + parts.join("/");
+  if (r.tail === "/*" && chance(tc, 60)) path += "/" + pick(tc, VALUES) + (chance(tc, 30) ? "/" + pick(tc, VALUES) : "");
+  if (r.tail === "*" && chance(tc, 60)) path += chance(tc, 50) ? pick(tc, ["-v2", "x", ".map"]) : "/" + pick(tc, VALUES);
+  return path;
+}
+
+/** Bend a path: extra/missing segment, trailing slash, empty segment, changed literal. */
+export function bend(tc, path) {
+  const k = pick(tc, ["drop", "append", "slash", "empty", "swap", "double"]);
+  const parts = path.split("/").slice(1);
+  switch (k) {
+    case "drop":
+      return parts.length > 1 ? "/" + parts.slice(0, -1).join("/") : path;
+    case "append":
+      return (path === "/" ? "" : path) + "/" + pick(tc, VALUES);
+    case "slash":
+      return path.endsWith("/") ? path : path + "/";
+    case "empty": {
+      const i = n(tc, 0, parts.length);
+      parts.splice(i, 0, "");
+      return "/" + parts.join("/");
+    }
+    case "swap": {
+      if (parts.length === 0) return path;
+      parts[n(tc, 0, parts.length - 1)] = pick(tc, LITERALS);
+      return "/" + parts.join("/");
+    }
+    default:
+      return path + path;
+  }
+}
+
+export function request(tc, routes) {
+  const method = pick(tc, REQUEST_METHODS);
+  let path;
+  if (chance(tc, 10)) path = "/" + pick(tc, LITERALS) + (chance(tc, 50) ? "/" + pick(tc, VALUES) : "");
+  else path = requestFor(tc, pick(tc, routes).route);
+  if (chance(tc, 30)) path = bend(tc, path);
+  return { method, path };
+}
diff --git a/hegel/hegel-zoo.mjs b/hegel/hegel-zoo.mjs
new file mode 100644
index 0000000..1ca6f10
--- /dev/null
+++ b/hegel/hegel-zoo.mjs
@@ -0,0 +1,163 @@
+// Hegel zoo: the small harness shared by the zoo's TypeScript/JavaScript targets.
+//
+// `property(name, body)` registers a node:test test that runs `body(tc)` under Hegel with
+// HEGEL_TEST_CASES cases (default 100) and the database at HEGEL_DATABASE. With ZOO_COLLECT=1
+// a `fail()` records the mismatch instead of failing, the case ends there, and the counts of
+// mismatches and of the shapes seen (`count(key)`) are printed at the end of the test, so a
+// property can be run over many cases to see every shape at once. `pin(name, body)` is a
+// plain test for one pinned bug: it must fail while the bug is present and pass once it is
+// fixed (the zoo's judge reads an unexpected pass as "fixed upstream?").
+
+import { readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+import { test as nodeTest } from "node:test";
+
+// The Hegel version these tests were written against (the zoo pins it in zoo.toml; upstream
+// would add it to devDependencies). Hegel and esbuild are installed with `npm install --prefix
+// .hegel` so the target's own package.json and lock file stay untouched. Checked at load time so
+// a stray install cannot silently change the engine.
+export const HEGEL_PIN = { "@hegeldev/hegel": "0.4.5" };
+
+const hegelDir = join(dirname(fileURLToPath(import.meta.url)), "..", ".hegel", "node_modules", "@hegeldev", "hegel");
+{
+  const installed = JSON.parse(readFileSync(join(hegelDir, "package.json"), "utf8")).version;
+  if (installed !== HEGEL_PIN["@hegeldev/hegel"]) {
+    throw new Error(`@hegeldev/hegel ${installed} is installed; these tests pin ${HEGEL_PIN["@hegeldev/hegel"]}`);
+  }
+}
+const hegel = await import(pathToFileURL(join(hegelDir, "dist", "index.js")));
+const gs = await import(pathToFileURL(join(hegelDir, "dist", "generators", "index.js")));
+
+export const collecting = !!process.env.ZOO_COLLECT;
+
+class Collected extends Error {}
+
+let msgs = [];
+let stats = new Map();
+
+/** Report a mismatch: an error normally, a recorded line in collect mode. */
+export function fail(message) {
+  if (collecting) {
+    msgs.push(message);
+    throw new Collected(message);
+  }
+  throw new Error(message);
+}
+
+/** Bump a statistic (the shape of a pinned bug, a generator branch). */
+export function count(key) {
+  stats.set(key, (stats.get(key) || 0) + 1);
+}
+
+function settings() {
+  const s = { testCases: Number(process.env.HEGEL_TEST_CASES) || 100 };
+  if (process.env.HEGEL_DATABASE) {
+    s.database = hegel.Database.fromPath(process.env.HEGEL_DATABASE);
+  }
+  return s;
+}
+
+/** A property: `body(tc)` runs under Hegel; a thrown error (or `fail`) is a failure. */
+export function property(name, body) {
+  nodeTest(name, () => {
+    msgs = [];
+    stats = new Map();
+    hegel.test((tc) => {
+      try {
+        body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** An async property: `body(tc)` may await; runs under Hegel's testAsync with the same settings. */
+export function propertyAsync(name, body) {
+  nodeTest(name, async () => {
+    msgs = [];
+    stats = new Map();
+    await hegel.testAsync(async (tc) => {
+      try {
+        await body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** A pin: a plain test for one recorded bug. */
+export function pin(name, body) {
+  nodeTest(name, body);
+}
+
+/** An integer in [lo, hi]. */
+export function n(tc, lo, hi) {
+  return tc.draw(gs.integers({ minValue: lo, maxValue: hi }));
+}
+
+/** One of xs. */
+export function pick(tc, xs) {
+  return xs[n(tc, 0, xs.length - 1)];
+}
+
+/** True pct percent of the time. */
+export function chance(tc, pct) {
+  return n(tc, 0, 99) < pct;
+}
+
+/** A string of `len` characters drawn from `alphabet` (an array of strings). */
+export function word(tc, alphabet, lo, hi) {
+  const len = n(tc, lo, hi);
+  let s = "";
+  for (let i = 0; i < len; i++) {
+    s += pick(tc, alphabet);
+  }
+  return s;
+}
+
+/** Structural equality: arrays by position, objects by key set (prototype ignored), else ===. */
+export function same(a, b) {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) {
+      return false;
+    }
+    return a.every((x, i) => same(x, b[i]));
+  }
+  if (a !== null && b !== null && typeof a === "object" && typeof b === "object") {
+    const ka = Object.keys(a).sort();
+    const kb = Object.keys(b).sort();
+    if (ka.length !== kb.length || ka.some((k, i) => k !== kb[i])) {
+      return false;
+    }
+    return ka.every((k) => same(a[k], b[k]));
+  }
+  return a === b;
+}
+
+/** A compact, unambiguous rendering for messages. */
+export function show(x) {
+  return JSON.stringify(x, (k, v) => (v === undefined ? "<undefined>" : v));
+}
diff --git a/hegel/hegel.test.mjs b/hegel/hegel.test.mjs
new file mode 100644
index 0000000..7c1ccf2
--- /dev/null
+++ b/hegel/hegel.test.mjs
@@ -0,0 +1,155 @@
+// Hegel properties for hono's routers (see README.md in targets/typescript/hono).
+import assert from "node:assert/strict";
+import { fail, count, property, pin, n, pick, chance } from "./hegel-zoo.mjs";
+import { FULL, table, request } from "./gen.mjs";
+import { matchAll } from "./model.mjs";
+import { LinearRouter, PatternRouter, RegExpRouter, TrieRouter, SmartRouter, UnsupportedPathError } from "./routers.mjs";
+
+const ROUTERS = { TrieRouter, RegExpRouter, LinearRouter, PatternRouter };
+
+/** Build a router from a table and match one request: { result } | { unsupported } | { error }. */
+export function run(Router, routes, req) {
+  const router = Router === SmartRouter ? new SmartRouter({ routers: [new RegExpRouter(), new TrieRouter()] }) : new Router();
+  try {
+    for (const r of routes) router.add(r.method, r.path, r.handler);
+    return { result: normalise(router.match(req.method, req.path)) };
+  } catch (e) {
+    if (e instanceof UnsupportedPathError) return { unsupported: true };
+    return { error: e };
+  }
+}
+
+/** [[handler, params]] with params resolved from a stash and undefined values dropped. */
+export function normalise(res) {
+  const [matches, stash] = res;
+  return matches.map(([handler, p]) => {
+    const params = {};
+    for (const k of Object.keys(p).sort()) {
+      const v = stash ? stash[p[k]] : p[k];
+      if (v !== undefined) params[k] = v;
+    }
+    return [handler, params];
+  });
+}
+
+export const showTable = (routes) => routes.map((r) => `${r.method} ${r.path} -> ${r.handler}`).join("; ");
+export const showResult = (r) => (r.unsupported ? "UnsupportedPathError" : r.error ? `THROWS ${r.error.message}` : JSON.stringify(r.result));
+
+// Shapes of known bugs and documented differences, gated in the default run (see README):
+const GREEDY_THEN_DYNAMIC = /\{\.[+*]\}\/(?::|\*)/; // ":a{.+}/:b": TrieRouter/LinearRouter never match (bug 2)
+const STAR_THEN_TAIL = /(^|\/)\*\/\*$/; // "/*/*" on "/a": TrieRouter/LinearRouter say no (bug 3)
+const MIDDLE_STAR = /(^|\/)\*\//; // "*" as one segment against an empty segment: routers disagree (bug 4)
+const META_AFTER_REGEXP = /\}\/[^/]*[.$()+?]/; // ":x{re}/$": the literal is not escaped in the lookahead (bug 5)
+const SLASH_IN_REGEXP_MIDDLEWARE = /\{[^}]*\/[^}]*\}\/.*\*$/; // ":x{[^/]+}/:y/*" loses its handler in RegExpRouter (bug 1)
+
+const STAR_THEN_OPTIONAL = /\*\/[^/]*\?$/; // "/foo/*/:y?": matched twice by TrieRouter/PatternRouter, once by RegExpRouter (bug 7)
+
+/** A duplicate parameter name (bug 6: which occurrence wins depends on the router and the shape). */
+function hasDuplicateName(path) {
+  const names = [...path.matchAll(/:([A-Za-z0-9_]+)/g)].map((m) => m[1]);
+  return new Set(names).size !== names.length;
+}
+
+function known(name, routes, req) {
+  // SmartRouter is RegExpRouter when it accepts the table, TrieRouter otherwise: both sets of gates apply
+  const is = (...names) => (name === "SmartRouter" ? names.includes("RegExpRouter") || names.includes("TrieRouter") : names.includes(name));
+  if (!FULL) {
+    if (is("LinearRouter", "PatternRouter") && req.path.length > 1 && req.path.endsWith("/")) return "trailing-slash";
+    if (routes.some((r) => GREEDY_THEN_DYNAMIC.test(r.path))) return "greedy-then-dynamic";
+    if (routes.some((r) => STAR_THEN_TAIL.test(r.path))) return "star-then-tail";
+    if (req.path.includes("//") && routes.some((r) => MIDDLE_STAR.test(r.path))) return "empty-segment-star";
+    if (is("TrieRouter", "LinearRouter") && routes.some((r) => META_AFTER_REGEXP.test(r.path))) return "meta-after-regexp";
+    if (is("RegExpRouter") && routes.some((r) => SLASH_IN_REGEXP_MIDDLEWARE.test(r.path))) return "slash-in-regexp-middleware";
+    if (routes.some((r) => hasDuplicateName(r.path))) return "duplicate-name";
+    if (routes.some((r) => STAR_THEN_OPTIONAL.test(r.path))) return "star-then-optional";
+  }
+  return null;
+}
+
+function check(name, Router, tc) {
+  const routes = table(tc);
+  const req = request(tc, routes);
+  const k = known(name, routes, req);
+  if (k) {
+    count(`known-${k}`);
+    return;
+  }
+  const want = matchAll(routes, req.method, req.path);
+  const got = run(Router, routes, req);
+  if (got.unsupported) {
+    count("unsupported");
+    return;
+  }
+  if (got.error) fail(`${name} threw ${got.error.message}\n${showTable(routes)}\n${req.method} ${req.path}`);
+  if (JSON.stringify(got.result) !== JSON.stringify(want)) {
+    fail(`${name} ${showResult(got)}\nmodel ${JSON.stringify(want)}\n${showTable(routes)}\n${req.method} ${req.path}`);
+  }
+  count("ok");
+}
+
+property("TestHegelTrieRouterFollowsTheRoutingRules", (tc) => check("TrieRouter", TrieRouter, tc));
+property("TestHegelRegExpRouterFollowsTheRoutingRules", (tc) => check("RegExpRouter", RegExpRouter, tc));
+property("TestHegelLinearRouterFollowsTheRoutingRules", (tc) => check("LinearRouter", LinearRouter, tc));
+property("TestHegelPatternRouterFollowsTheRoutingRules", (tc) => check("PatternRouter", PatternRouter, tc));
+property("TestHegelSmartRouterFollowsTheRoutingRules", (tc) => check("SmartRouter", SmartRouter, tc));
+
+// ---- pins: one test per recorded bug --------------------------------------------------------------
+
+function matched(Router, routes, method, path) {
+  const r = run(Router, routes, { method, path });
+  if (r.unsupported) return "unsupported";
+  if (r.error) throw r.error;
+  return r.result;
+}
+const R = (method, path, handler) => ({ method, path, handler });
+
+pin("TestHegelPinRegExpRouterKeepsMiddlewareWithSlashInRegexp", () => {
+  const routes = [R("ALL", "/:name{[^/]+}/:x/*", "mw"), R("GET", "*", "h")];
+  assert.deepEqual(matched(TrieRouter, routes, "GET", "/v2/abc/abc"), [["mw", { name: "v2", x: "abc" }], ["h", {}]]);
+  assert.deepEqual(matched(RegExpRouter, routes, "GET", "/v2/abc/abc"), [["mw", { name: "v2", x: "abc" }], ["h", {}]]);
+});
+
+pin("TestHegelPinSlashSpanningRegexpBeforeParamMatches", () => {
+  const routes = [R("GET", "/:id{.+}/:name", "h")];
+  assert.deepEqual(matched(RegExpRouter, routes, "GET", "/b/42/foo"), [["h", { id: "b/42", name: "foo" }]]);
+  assert.deepEqual(matched(TrieRouter, routes, "GET", "/b/42/foo"), [["h", { id: "b/42", name: "foo" }]]);
+  assert.deepEqual(matched(LinearRouter, routes, "GET", "/b/42/foo"), [["h", { id: "b/42", name: "foo" }]]);
+});
+
+pin("TestHegelPinTrailingWildcardAfterMiddleWildcardMatchesTheParent", () => {
+  const routes = [R("GET", "/*/*", "h")];
+  assert.deepEqual(matched(RegExpRouter, routes, "GET", "/a"), [["h", {}]]);
+  assert.deepEqual(matched(TrieRouter, routes, "GET", "/a"), [["h", {}]]);
+  assert.deepEqual(matched(LinearRouter, routes, "GET", "/a"), [["h", {}]]);
+});
+
+pin("TestHegelPinRoutersAgreeOnEmptySegmentsAgainstWildcard", () => {
+  const routes = [R("GET", "/a/*/b", "h")];
+  const results = [TrieRouter, RegExpRouter, LinearRouter, PatternRouter].map((Router) => JSON.stringify(matched(Router, routes, "GET", "/a//b")));
+  assert.equal(new Set(results).size, 1, `routers disagree: ${results.join(" | ")}`);
+});
+
+pin("TestHegelPinLiteralAfterRegexpParamIsEscaped", () => {
+  const routes = [R("GET", "/:x{[0-9]+}/$", "h")];
+  assert.deepEqual(matched(RegExpRouter, routes, "GET", "/654/$"), [["h", { x: "654" }]]);
+  assert.deepEqual(matched(TrieRouter, routes, "GET", "/654/$"), [["h", { x: "654" }]]);
+  assert.deepEqual(matched(LinearRouter, routes, "GET", "/654/$"), [["h", { x: "654" }]]);
+});
+
+pin("TestHegelPinDuplicateParamNamesTakeTheFirstValue", () => {
+  // the documented case, then the same rule for other shapes
+  for (const Router of [TrieRouter, RegExpRouter, LinearRouter]) {
+    assert.deepEqual(matched(Router, [R("GET", "/:id/:id", "h")], "GET", "/65/42"), [["h", { id: "65" }]], Router.name);
+  }
+  assert.deepEqual(matched(TrieRouter, [R("GET", "/:id{[0-9]+}/:id{[0-9]+}", "h")], "GET", "/65/42"), [["h", { id: "65" }]]);
+  assert.deepEqual(matched(TrieRouter, [R("GET", "/:x/:x/c/a", "h")], "GET", "/a/b/c/a"), [["h", { x: "a" }]]);
+  assert.deepEqual(matched(RegExpRouter, [R("GET", "/:n/:n/:n/:x", "h")], "GET", "/1/2/3/4"), [["h", { n: "1", x: "4" }]]);
+});
+
+pin("TestHegelPinOptionalParamAfterWildcardMatchesOnce", () => {
+  const routes = [R("GET", "/foo/*/:y?", "h")];
+  const trie = matched(TrieRouter, routes, "GET", "/foo/a/b");
+  const regexp = matched(RegExpRouter, routes, "GET", "/foo/a/b");
+  assert.deepEqual(trie, regexp);
+  assert.equal(trie.length, 1);
+});
