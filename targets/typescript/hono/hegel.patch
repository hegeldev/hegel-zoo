@@ -0,0 +1,106 @@
+// A model of hono's routing rules (docs/api/routing and the routers' shared test cases): every
+// route is a regular expression over the request path; handlers come back in registration order.
+//
+//   literal segment      the literal, exactly
+//   :name                one non-empty segment without a slash
+//   :name{re}            the regexp `re`, which may span slashes (`.+` "including slashes")
+//   * in the middle      one segment
+//   trailing /*          nothing, or a slash and anything ("/path/*" matches "/path" and "/path/to")
+//   suffix *             any tail ("/assets*" matches "/assets", "/assets-v2", "/assets/app.js")
+//   *                    everything
+//   :name?               optional trailing parameter(s): "/a/:b?/:c?" is "/a", "/a/:b", "/a/:b/:c"
+//   trailing slash       "/book/" does not match "/book" (LinearRouter/PatternRouter allow it: documented)
+//   method               the route's method or ALL
+//   duplicate :name      the first value wins
+import { createRequire } from "node:module";
+
+const require = createRequire(import.meta.url);
+
+const escapeRe = (s) => s.replace(/[.\\+*?[^\]$(){}=!<>|:\-#]/g, "\\$&");
+
+/** "/a/:b?/:c?" -> ["/a", "/a/:b", "/a/:b/:c"] (the library's checkOptionalParameter, as documented). */
+export function expandOptional(path) {
+  if (!path.endsWith("?") || !path.includes(":")) return [path];
+  const segments = path.split("/");
+  const results = [];
+  let base = "";
+  for (const seg of segments) {
+    if (seg === "") continue;
+    if (!seg.includes(":")) {
+      base += "/" + seg;
+    } else if (seg.endsWith("?")) {
+      results.push(results.length === 0 && base === "" ? "/" : base);
+      base += "/" + seg.slice(0, -1);
+      results.push(base);
+    } else {
+      base += "/" + seg;
+    }
+  }
+  return results.filter((v, i, a) => a.indexOf(v) === i);
+}
+
+/** Compile one (non-optional) route path into { re, names }. */
+export function compile(path) {
+  if (path === "*") return { re: /^.*$/, names: [] };
+  const names = [];
+  let src = "";
+  let tail = "";
+  let body = path;
+  if (body.endsWith("/*")) {
+    body = body.slice(0, -2);
+    tail = "(?:|/.*)";
+  } else if (body.endsWith("*")) {
+    body = body.slice(0, -1);
+    tail = ".*";
+  }
+  // split into segments, keeping braces intact
+  const segs = [];
+  let depth = 0;
+  let cur = "";
+  for (const ch of body) {
+    if (ch === "{") depth++;
+    if (ch === "}") depth--;
+    if (ch === "/" && depth === 0) {
+      segs.push(cur);
+      cur = "";
+    } else cur += ch;
+  }
+  segs.push(cur);
+  if (segs[0] === "") segs.shift();
+  for (const seg of segs) {
+    src += "/";
+    if (seg === "*") {
+      src += "[^/]+";
+      continue;
+    }
+    const m = seg.match(/^:([^{}]+)(?:\{(.+)\})?$/);
+    if (m) {
+      names.push(m[1]);
+      src += "(" + (m[2] || "[^/]+") + ")";
+    } else src += escapeRe(seg);
+  }
+  if (segs.length === 0 && tail === "") src = "/";
+  return { re: new RegExp(`^${src}${tail}$`), names };
+}
+
+/** All handlers matching a request, in registration order: [[handler, params]]. */
+export function matchAll(routes, method, path) {
+  const out = [];
+  for (const r of routes) {
+    if (r.method !== method && r.method !== "ALL") continue;
+    for (const p of expandOptional(r.path)) {
+      const { re, names } = compile(p);
+      const m = re.exec(path);
+      if (!m) continue;
+      const params = {};
+      names.forEach((name, i) => {
+        if (!(name in params) && m[i + 1] !== undefined) params[name] = m[i + 1];
+      });
+      out.push([r.handler, sortKeys(params)]);
+      // (the expansions are registered as separate routes; "/a/*/:b?" can match twice)
+    }
+  }
+  return out;
+}
+
+const sortKeys = (o) => Object.fromEntries(Object.keys(o).sort().map((k) => [k, o[k]]));
