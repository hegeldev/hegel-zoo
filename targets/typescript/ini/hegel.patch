index 0000000..53b3b56
--- /dev/null
+++ b/test/hegel.test.mjs
@@ -0,0 +1,342 @@
+// Hegel zoo: properties of ini (npm/ini) — decode∘encode round trips, unsafe∘safe round
+// trips, and decode's stability on arbitrary text.
+//
+// Run with `node --test --test-reporter=tap test/hegel.test.mjs`; ZOO_COLLECT=1 records
+// mismatches instead of failing (see test/hegel-zoo.mjs).
+
+import ini from "../lib/ini.js";
+import { property, pin, fail, count, n, pick, chance, word, same, show } from "./hegel-zoo.mjs";
+
+// ---------------------------------------------------------------- generators
+
+// Characters that mean something to the format, plus ordinary ones.
+const KEY_CHARS = ["a", "b", "k", "Z", "0", "9", "_", "-", " ", ".", ";", "#", "=", "[", "]", '"', "'", "\\", "é", "全", "\t"];
+const VALUE_CHARS = [...KEY_CHARS, "\n", "\r", ",", ":", "/"];
+const LITERALS = ["true", "false", "null", "undefined", "1", "0", "-0", "1.5", "1e3", "0x10", "yes", "on", "[]", "[a]", '""', "''", "'", '"', "\\", "\\;", " "];
+
+function genKey(tc) {
+  if (chance(tc, 15)) {
+    return pick(tc, LITERALS);
+  }
+  return word(tc, KEY_CHARS, 1, 8);
+}
+
+function genScalar(tc) {
+  const r = n(tc, 0, 99);
+  if (r < 8) return true;
+  if (r < 12) return false;
+  if (r < 16) return null;
+  if (r < 24) return pick(tc, LITERALS);
+  if (r < 30) return pick(tc, [0, 1, -1, 7, 1.5, 1e21, 42]);
+  return word(tc, VALUE_CHARS, 0, 10);
+}
+
+function genArray(tc) {
+  const len = n(tc, 0, 4);
+  const out = [];
+  for (let i = 0; i < len; i++) {
+    out.push(genScalar(tc));
+  }
+  return out;
+}
+
+// An object of scalars, arrays and (down to depth 0) nested objects, with distinct keys.
+function genObject(tc, depth) {
+  const out = {};
+  const count_ = n(tc, 0, 5);
+  for (let i = 0; i < count_; i++) {
+    const k = genKey(tc);
+    if (k in out || k === "__proto__") {
+      continue;
+    }
+    const r = n(tc, 0, 99);
+    if (r < 15) {
+      out[k] = genArray(tc);
+    } else if (r < 40 && depth > 0) {
+      out[k] = genObject(tc, depth - 1);
+    } else {
+      out[k] = genScalar(tc);
+    }
+  }
+  return out;
+}
+
+function genOptions(tc) {
+  const opt = {};
+  if (chance(tc, 30)) opt.whitespace = true;
+  if (chance(tc, 20)) opt.align = true;
+  if (chance(tc, 30)) opt.sort = true;
+  if (chance(tc, 20)) opt.newline = true;
+  if (chance(tc, 20)) opt.platform = "win32";
+  if (chance(tc, 25)) opt.bracketedArray = false;
+  if (chance(tc, 20)) opt.section = word(tc, ["s", "t", "1", " ", ";", "]", "=", "\\", '"'], 1, 4);
+  return opt;
+}
+
+// ---------------------------------------------------------------- the model
+
+// What decode(encode(obj, opt)) should give: the format is untyped (numbers come back as
+// their decimal text) and cannot express an empty array or an empty section, and with
+// bracketedArray off a one-element array is indistinguishable from a scalar; everything else
+// must come back as it went in.
+function expected(obj, opt) {
+  const out = {};
+  for (const [k, v] of Object.entries(obj)) {
+    if (Array.isArray(v)) {
+      const items = v.map(scalarBack);
+      if (items.length === 0) continue;
+      out[k] = opt.bracketedArray === false && items.length === 1 ? items[0] : items;
+    } else if (v !== null && typeof v === "object") {
+      const child = expected(v, opt);
+      if (Object.keys(child).length === 0) continue;
+      out[k] = child;
+    } else {
+      out[k] = scalarBack(v);
+    }
+  }
+  return out;
+}
+
+function scalarBack(v) {
+  if (typeof v === "number") return JSON.stringify(v);
+  return v;
+}
+
+// ---------------------------------------------------------------- pinned shapes
+
+// The shapes of the recorded bugs, read off the input (keys, values, section names). A case
+// with none of them must round-trip exactly; a case with some is counted and only checked
+// when it happens to round-trip anyway (the pins hold the bugs themselves).
+function strShapes(s, out) {
+  if (/\\[\\;#]/.test(s)) out.add("ini/backslash");
+  if (s === "'") out.add("ini/lone-quote");
+}
+
+function valueShapes(v, out) {
+  if (typeof v === "string") {
+    if (v === "true" || v === "false" || v === "null") out.add("ini/literal-string");
+    strShapes(v, out);
+  }
+}
+
+function hasSectionChild(obj) {
+  return Object.values(obj).some((v) => v !== null && typeof v === "object" && !Array.isArray(v) && Object.keys(v).length > 0);
+}
+
+// With bracketedArray off, the decoder counts duplicate keys over the whole file, not per
+// section: a leaf key that appears in two sections comes back as an array in the second.
+function leafNames(obj, into = new Map(), section = 0) {
+  for (const [k, v] of Object.entries(obj)) {
+    if (v !== null && typeof v === "object" && !Array.isArray(v)) {
+      leafNames(v, into, section + 1 + into.size * 1000);
+    } else if (!Array.isArray(v) || v.length > 0) {
+      const set = into.get(k) || new Set();
+      set.add(section);
+      into.set(k, set);
+    }
+  }
+  return into;
+}
+
+function shapes(obj, opt, top, out = new Set()) {
+  if (top && opt.bracketedArray === false) {
+    for (const sections of leafNames(obj).values()) {
+      if (sections.size > 1) out.add("ini/duplicates-across-sections");
+    }
+  }
+  for (const [k, v] of Object.entries(obj)) {
+    const isSection = v !== null && typeof v === "object" && !Array.isArray(v);
+    strShapes(k, out);
+    if (isSection) {
+      if (Object.keys(v).length === 0) continue;
+      if (k === "") out.add("ini/empty-key");
+      if (k.includes("]")) out.add("ini/section-bracket");
+      if (k.includes(".") && hasSectionChild(v)) out.add("ini/dotted-parent");
+      if (k.includes("\\.") || (k.endsWith("\\") && hasSectionChild(v))) out.add("ini/backslash-dot");
+      shapes(v, opt, false, out);
+    } else {
+      if (Array.isArray(v) && v.length === 0) continue;
+      if (k === "") out.add("ini/empty-key");
+      if (k.includes("=")) out.add("ini/key-equals");
+      if (k.endsWith("[]") && (opt.bracketedArray !== false ? k.length > 2 : Array.isArray(v) && v.length > 1)) out.add("ini/key-brackets");
+      // with bracketedArray off a one-element array comes back as its element
+      const eff = opt.bracketedArray === false && Array.isArray(v) && v.length === 1 ? v[0] : v;
+      if (eff === null && top && !opt.section && k.includes(".")) out.add("ini/null-dotted");
+      if (Array.isArray(v)) v.forEach((x) => valueShapes(x, out));
+      else valueShapes(v, out);
+    }
+  }
+  if (top && opt.section) {
+    strShapes(opt.section, out);
+    if (opt.section.includes("]")) out.add("ini/section-bracket");
+    if (opt.section.includes("\\.") || (opt.section.endsWith("\\") && hasSectionChild(obj))) out.add("ini/backslash-dot");
+  }
+  return out;
+}
+
+// ---------------------------------------------------------------- properties
+
+property("TestHegelEncodeDecodeRoundTrips", (tc) => {
+  const obj = genObject(tc, 2);
+  const opt = genOptions(tc);
+  const text = ini.encode(obj, { ...opt });
+  tc.note(`encode(${show(obj)}, ${show(opt)}) =\n${text}`);
+  let back;
+  try {
+    back = ini.decode(text, { ...opt });
+  } catch (e) {
+    fail(`decode threw ${e} on\n${text}`);
+  }
+  const want = opt.section ? { [opt.section]: expected(obj, opt) } : expected(obj, opt);
+  if (opt.section && Object.keys(want[opt.section]).length === 0) {
+    delete want[opt.section];
+  }
+  const sh = shapes(obj, opt, true);
+  for (const k of sh) count(k);
+  if (!same(back, want)) {
+    if (sh.size === 0) {
+      fail(`round trip of ${show(obj)} with ${show(opt)}:\n${text}\ngave ${show(back)}\nwant ${show(want)}`);
+    }
+    count("explained");
+  } else if (sh.size > 0) {
+    count("shape-but-ok");
+  }
+});
+
+property("TestHegelUnsafeUndoesSafe", (tc) => {
+  const s = chance(tc, 25) ? pick(tc, LITERALS) : word(tc, VALUE_CHARS, 0, 10);
+  const safe = ini.safe(s);
+  const back = ini.unsafe(safe);
+  const sh = new Set();
+  strShapes(s, sh);
+  for (const k of sh) count(k);
+  if (back !== s) {
+    if (sh.size === 0) {
+      fail(`unsafe(safe(${show(s)})) = unsafe(${show(safe)}) = ${show(back)}`);
+    }
+    count("explained");
+  } else if (sh.size > 0) {
+    count("shape-but-ok");
+  }
+});
+
+// Random INI-ish text: decode must not throw, and decoding again what it encodes must give
+// the same object (the parse is a normal form).
+const LINE_CHARS = ["a", "b", "=", "[", "]", ";", "#", " ", ".", "\\", '"', "'", "1", "\t"];
+
+property("TestHegelDecodeIsStable", (tc) => {
+  const lines = n(tc, 0, 6);
+  let text = "";
+  for (let i = 0; i < lines; i++) {
+    const r = n(tc, 0, 99);
+    if (r < 20) {
+      text += "[" + word(tc, LINE_CHARS, 0, 6) + "]";
+    } else if (r < 30) {
+      text += pick(tc, [";", "#"]) + word(tc, LINE_CHARS, 0, 6);
+    } else {
+      text += word(tc, LINE_CHARS, 0, 5) + (chance(tc, 80) ? "=" + word(tc, LINE_CHARS, 0, 6) : "");
+    }
+    text += pick(tc, ["\n", "\r\n", "\n\n"]);
+  }
+  const opt = chance(tc, 25) ? { bracketedArray: false } : {};
+  let once;
+  try {
+    once = ini.decode(text, { ...opt });
+  } catch (e) {
+    fail(`decode threw ${e} on ${show(text)}`);
+  }
+  const again = ini.decode(ini.encode(once, { ...opt }), { ...opt });
+  const sh = shapes(once, opt, true);
+  for (const k of sh) count(k);
+  // empty sections are not written, so they are the one thing the normal form loses
+  const want = expected(once, opt);
+  if (!same(want, again)) {
+    if (sh.size > 0) {
+      count("explained");
+      return;
+    }
+    fail(`decode(${show(text)}) = ${show(once)}, but decode(encode(that)) = ${show(again)}, expected ${show(want)}\n${ini.encode(once, { ...opt })}`);
+  }
+});
+
+// ---------------------------------------------------------------- pins
+
+function roundTrip(obj, opt = {}) {
+  return ini.decode(ini.encode(obj, { ...opt }), { ...opt });
+}
+
+function expectSame(obj, opt, want = obj) {
+  const back = roundTrip(obj, opt);
+  if (!same(back, want)) {
+    throw new Error(`${show(obj)} with ${show(opt)} encodes as ${show(ini.encode(obj, { ...opt }))} and decodes as ${show(back)}, expected ${show(want)}`);
+  }
+}
+
+// ini/1
+pin("TestHegelPinLiteralStringsBecomeValues", () => {
+  expectSame({ a: "true", b: "false", c: "null" }, {});
+});
+
+// ini/2
+pin("TestHegelPinKeyWithEqualsSplits", () => {
+  expectSame({ "a=b": "v" }, {});
+});
+
+// ini/3
+pin("TestHegelPinKeyEndingInBracketsBecomesAnArray", () => {
+  expectSame({ "a[]": "v" }, {});
+});
+
+// ini/4
+pin("TestHegelPinDottedSectionWithChildrenKeepsTheEscape", () => {
+  expectSame({ "a.b": { c: { x: "1" } } }, {});
+});
+
+// ini/5
+pin("TestHegelPinBackslashBeforeSemicolonIsLost", () => {
+  const s = "x\\;y";
+  if (ini.unsafe(ini.safe(s)) !== s) {
+    throw new Error(`unsafe(safe(${show(s)})) = unsafe(${show(ini.safe(s))}) = ${show(ini.unsafe(ini.safe(s)))}`);
+  }
+  expectSame({ a: s }, {});
+});
+
+// ini/6
+pin("TestHegelPinSectionNameWithBracketIsUnreadable", () => {
+  expectSame({ "a]b": { x: "1" } }, {});
+});
+
+// ini/7
+pin("TestHegelPinNullUnderDottedKeyBecomesASection", () => {
+  expectSame({ "a.b": null }, {});
+});
+
+// ini/8
+pin("TestHegelPinLoneQuoteBecomesEmpty", () => {
+  if (ini.unsafe(ini.safe("'")) !== "'") {
+    throw new Error(`unsafe(safe("'")) = ${show(ini.unsafe(ini.safe("'")))}`);
+  }
+  expectSame({ a: "'" }, {});
+});
+
+// ini/9
+pin("TestHegelPinDuplicateKeysAreCountedAcrossSections", () => {
+  expectSame({ a: "1", s: { a: "2" } }, { bracketedArray: false });
+});
+
+// ini/10
+pin("TestHegelPinRepeatedBracketKeyLosesItsName", () => {
+  expectSame({ "k[]": ["1", "2"] }, { bracketedArray: false });
+});
+
+// ini/11
+pin("TestHegelPinBackslashDotInSectionNameIsAnEscape", () => {
+  expectSame({ "a\\.b": { x: "1" } }, {});
+  expectSame({ "a\\": { b: { x: "1" } } }, {});
+  expectSame({ b: { x: "1" } }, { section: "s\\" }, { "s\\": { b: { x: "1" } } });
+});
+
+// ini/12
+pin("TestHegelPinEmptyKeyIsWrittenUnreadably", () => {
+  expectSame({ "": "v" }, {});
+});
