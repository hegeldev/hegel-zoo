diff --git a/test/hegel-zoo.mjs b/test/hegel-zoo.mjs
new file mode 100644
index 0000000..cceb064
--- /dev/null
+++ b/test/hegel-zoo.mjs
@@ -0,0 +1,126 @@
+// Hegel zoo: the small harness shared by the zoo's TypeScript/JavaScript targets.
+//
+// `property(name, body)` registers a node:test test that runs `body(tc)` under Hegel with
+// HEGEL_TEST_CASES cases (default 100) and the database at HEGEL_DATABASE. With ZOO_COLLECT=1
+// a `fail()` records the mismatch instead of failing, the case ends there, and the counts of
+// mismatches and of the shapes seen (`count(key)`) are printed at the end of the test, so a
+// property can be run over many cases to see every shape at once. `pin(name, body)` is a
+// plain test for one pinned bug: it must fail while the bug is present and pass once it is
+// fixed (the zoo's judge reads an unexpected pass as "fixed upstream?"). HEGEL_NO_KNOWN=1
+// (`noKnown`, read once here) asks for a run that looks past the recorded bugs: the properties
+// then skip their shapes, and a property that draws nothing but such a shape is registered
+// skipped (`property(name, body, { skip })`).
+
+import { readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { test as nodeTest } from "node:test";
+import * as hegel from "@hegeldev/hegel";
+
+// The Hegel version these tests were written against (the zoo pins it in zoo.toml and installs
+// it with `npm install --no-save @hegeldev/hegel@<version>`; upstream would add it to
+// devDependencies). Checked at load time so a stray install cannot silently change the engine.
+export const HEGEL_PIN = { "@hegeldev/hegel": "0.4.5" };
+
+{
+  let dir = dirname(fileURLToPath(import.meta.resolve("@hegeldev/hegel")));
+  while (!/[\\/]hegel$/.test(dir) && dir !== dirname(dir)) dir = dirname(dir);
+  const installed = JSON.parse(readFileSync(join(dir, "package.json"), "utf8")).version;
+  if (installed !== HEGEL_PIN["@hegeldev/hegel"]) {
+    throw new Error(`@hegeldev/hegel ${installed} is installed; these tests pin ${HEGEL_PIN["@hegeldev/hegel"]}`);
+  }
+}
+
+export const collecting = !!process.env.ZOO_COLLECT;
+
+/** HEGEL_NO_KNOWN=1: skip the shapes of the recorded bugs (they are drawn, and fail, by default). */
+export const noKnown = !!process.env.HEGEL_NO_KNOWN;
+
+class Collected extends Error {}
+
+let msgs = [];
+let stats = new Map();
+
+/** Report a mismatch: an error normally, a recorded line in collect mode. */
+export function fail(message) {
+  if (collecting) {
+    msgs.push(message);
+    throw new Collected(message);
+  }
+  throw new Error(message);
+}
+
+/** Bump a statistic (the shape of a pinned bug, a generator branch). */
+export function count(key) {
+  stats.set(key, (stats.get(key) || 0) + 1);
+}
+
+function settings() {
+  const s = { testCases: Number(process.env.HEGEL_TEST_CASES) || 100 };
+  if (process.env.HEGEL_DATABASE) {
+    s.database = hegel.Database.fromPath(process.env.HEGEL_DATABASE);
+  }
+  return s;
+}
+
+// Hegel keys its example database by the test function's source text. Every property here runs
+// through the same wrapper, so without this every property would share one key and replay the
+// stored failing examples of all the others; the key is the test's name instead.
+function keyed(name, fn) {
+  fn.toString = () => name;
+  return fn;
+}
+
+/** A property: `body(tc)` runs under Hegel; a thrown error (or `fail`) is a failure. */
+export function property(name, body, { skip } = {}) {
+  nodeTest(name, { skip }, () => {
+    msgs = [];
+    stats = new Map();
+    hegel.test(keyed(name, (tc) => {
+      try {
+        body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }), settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** A pin: a plain test for one recorded bug. */
+export function pin(name, body) {
+  nodeTest(name, body);
+}
+
+/** Structural equality: arrays by position, objects by key set (prototype ignored), else ===. */
+export function same(a, b) {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) {
+      return false;
+    }
+    return a.every((x, i) => same(x, b[i]));
+  }
+  if (a !== null && b !== null && typeof a === "object" && typeof b === "object") {
+    const ka = Object.keys(a).sort();
+    const kb = Object.keys(b).sort();
+    if (ka.length !== kb.length || ka.some((k, i) => k !== kb[i])) {
+      return false;
+    }
+    return ka.every((k) => same(a[k], b[k]));
+  }
+  return a === b;
+}
+
+/** A compact, unambiguous rendering for messages. */
+export function show(x) {
+  return JSON.stringify(x, (k, v) => (v === undefined ? "<undefined>" : v));
+}
diff --git a/test/hegel.test.mjs b/test/hegel.test.mjs
new file mode 100644
index 0000000..b9b1213
--- /dev/null
+++ b/test/hegel.test.mjs
@@ -0,0 +1,467 @@
+// Hegel zoo: properties of ini (npm/ini) — decode∘encode round trips, unsafe∘safe round
+// trips, and decode's stability on arbitrary text.
+//
+// Run with `node --test --test-reporter=tap test/hegel.test.mjs`; ZOO_COLLECT=1 records
+// mismatches instead of failing (see test/hegel-zoo.mjs).
+// HEGEL_NO_KNOWN=1 skips the shapes of the recorded bugs (bugs.toml), which the properties
+// otherwise draw and fail on: see "known shapes" below.
+
+import ini from "../lib/ini.js";
+import * as gs from "@hegeldev/hegel/generators";
+import { property, pin, fail, count, same, show, noKnown } from "./hegel-zoo.mjs";
+
+// ---------------------------------------------------------------- generators
+
+// Characters that mean something to the format, plus ordinary ones.
+const KEY_CHARS = "abkZ09_- .;#=[]\"'\\é全\t";
+const VALUE_CHARS = KEY_CHARS + "\n\r,:/";
+const SECTION_CHARS = "st1 ;]=\\\"";
+const LITERALS = ["true", "false", "null", "undefined", "1", "0", "-0", "1.5", "1e3", "0x10", "yes", "on", "[]", "[a]", '""', "''", "'", '"', "\\", "\\;", " "];
+
+// The shapes of the recorded bugs are drawn by default and the properties fail on them (they
+// are the expected failures; the pins at the end hold one example each). Under HEGEL_NO_KNOWN=1
+// the generators leave out what makes the shapes common - `=` (ini/2), `]` (ini/6) and `\`
+// (ini/5, ini/11) in keys and section names, `\` in values, the literals true/false/null
+// (ini/1), a lone quote (ini/8) and `\;` (ini/5), the empty key (ini/12) - and the residue (a
+// dotted section with sub-sections, a key ending in `[]`, a key repeated across sections, null
+// under a dotted key) is filtered out of the case by the classifier the gates use, `shapes()`.
+const KNOWN_LITERALS = ["true", "false", "null", "'", "\\;"];
+const without = (alphabet, drop) => [...alphabet].filter((c) => !drop.includes(c)).join("");
+// The plain alphabets: nothing that has a recorded shape of its own (the per-bug properties
+// below draw their filler from them).
+const PLAIN_KEY_CHARS = without(KEY_CHARS, "=]\\'.");
+const PLAIN_VALUE_CHARS = without(VALUE_CHARS, "\\'");
+const PLAIN_SECTION_CHARS = without(SECTION_CHARS, "]\\");
+const plainLiterals = LITERALS.filter((s) => !KNOWN_LITERALS.includes(s));
+const keyChars = noKnown ? without(KEY_CHARS, "=]\\") : KEY_CHARS;
+const valueChars = noKnown ? without(VALUE_CHARS, "\\") : VALUE_CHARS;
+const sectionChars = noKnown ? PLAIN_SECTION_CHARS : SECTION_CHARS;
+const literals = noKnown ? plainLiterals : LITERALS;
+const keyLiterals = noKnown ? plainLiterals.filter((s) => !s.includes("]")) : LITERALS;
+
+/** A string of minSize–maxSize characters from alphabet. */
+const chars = (alphabet, minSize, maxSize) => gs.text({ alphabet, minSize, maxSize });
+
+/** oneOf with integer weights: `weighted([3, a], [1, b])` draws from a three times in four. */
+const weighted = (...choices) => gs.oneOf(...choices.flatMap(([w, g]) => Array(w).fill(g)));
+
+/** value pct percent of the time, else undefined (listed first: oneOf shrinks towards its first alternative). */
+const maybe = (pct, value) => weighted([100 - pct, gs.just(undefined)], [pct, gs.just(value)]);
+
+// Plain text first (the shrink target: a key shrinks to the empty key, ini/12), then the literals.
+const key = weighted([85, chars(keyChars, noKnown ? 1 : 0, 8)], [15, gs.sampledFrom(keyLiterals)]);
+
+/** A scalar: a boolean, null, a literal from pool, a number, or text over alphabet. */
+const scalars = (pool, alphabet) =>
+  weighted(
+    [8, gs.just(true)],
+    [4, gs.just(false)],
+    [4, gs.just(null)],
+    [8, gs.sampledFrom(pool)],
+    [6, gs.sampledFrom([0, 1, -1, 7, 1.5, 1e21, 42])],
+    [70, chars(alphabet, 0, 10)],
+  );
+const scalar = scalars(literals, valueChars);
+
+const array = gs.arrays(scalar, { maxSize: 4 });
+
+/** An object of scalars, arrays and (down to depth 0) nested objects, with distinct keys. */
+function object(depth) {
+  const value = depth > 0 ? weighted([60, scalar], [15, array], [25, object(depth - 1)]) : weighted([85, scalar], [15, array]);
+  return gs.maps(key, value, { maxSize: 5 }).map((entries) => {
+    const out = {};
+    for (const [k, v] of entries) {
+      if (!(k in out) && k !== "__proto__") {
+        out[k] = v;
+      }
+    }
+    return out;
+  });
+}
+
+/** encode/decode options; a key is absent rather than undefined. `fixed` replaces fields. */
+const optionFields = {
+  whitespace: maybe(30, true),
+  align: maybe(20, true),
+  sort: maybe(30, true),
+  newline: maybe(20, true),
+  platform: maybe(20, "win32"),
+  bracketedArray: maybe(25, false),
+  section: weighted([80, gs.just(undefined)], [20, chars(sectionChars, 1, 4)]),
+};
+const optionsWith = (fixed) => gs.record({ ...optionFields, ...fixed }).map((opt) => Object.fromEntries(Object.entries(opt).filter(([, v]) => v !== undefined)));
+const options = optionsWith({});
+
+/** A case of the round-trip property; under HEGEL_NO_KNOWN one without a recorded shape. */
+const roundTripCase = gs.record({ obj: object(2), opt: options });
+const roundTripCases = noKnown ? roundTripCase.filter(({ obj, opt }) => shapes(obj, opt, true).size === 0) : roundTripCase;
+
+// ---------------------------------------------------------------- the model
+
+// What decode(encode(obj, opt)) should give: the format is untyped (numbers come back as
+// their decimal text) and cannot express an empty array or an empty section, and with
+// bracketedArray off a one-element array is indistinguishable from a scalar; everything else
+// must come back as it went in.
+function expected(obj, opt) {
+  const out = {};
+  for (const [k, v] of Object.entries(obj)) {
+    if (Array.isArray(v)) {
+      const items = v.map(scalarBack);
+      if (items.length === 0) continue;
+      out[k] = opt.bracketedArray === false && items.length === 1 ? items[0] : items;
+    } else if (v !== null && typeof v === "object") {
+      const child = expected(v, opt);
+      if (Object.keys(child).length === 0) continue;
+      out[k] = child;
+    } else {
+      out[k] = scalarBack(v);
+    }
+  }
+  return out;
+}
+
+function scalarBack(v) {
+  if (typeof v === "number") return JSON.stringify(v);
+  return v;
+}
+
+// ---------------------------------------------------------------- known shapes
+
+// The shapes of the recorded bugs, read off the input (keys, values, section names). A
+// property counts them (a collect run shows which the generator reached) and names them in a
+// mismatch; under HEGEL_NO_KNOWN=1 a case that has one is skipped (`gate`).
+function strShapes(s, out) {
+  if (/\\[\\;#]/.test(s)) out.add("ini/backslash");
+  if (s === "'") out.add("ini/lone-quote");
+}
+
+function valueShapes(v, out) {
+  if (typeof v === "string") {
+    if (v === "true" || v === "false" || v === "null") out.add("ini/literal-string");
+    strShapes(v, out);
+  }
+}
+
+function hasSectionChild(obj) {
+  return Object.values(obj).some((v) => v !== null && typeof v === "object" && !Array.isArray(v) && Object.keys(v).length > 0);
+}
+
+// With bracketedArray off, the decoder counts duplicate keys over the whole file, not per
+// section: a leaf key that appears in two sections comes back as an array in the second.
+function leafNames(obj, into = new Map(), section = 0) {
+  for (const [k, v] of Object.entries(obj)) {
+    if (v !== null && typeof v === "object" && !Array.isArray(v)) {
+      leafNames(v, into, section + 1 + into.size * 1000);
+    } else if (!Array.isArray(v) || v.length > 0) {
+      const set = into.get(k) || new Set();
+      set.add(section);
+      into.set(k, set);
+    }
+  }
+  return into;
+}
+
+function shapes(obj, opt, top, out = new Set()) {
+  if (top && opt.bracketedArray === false) {
+    for (const sections of leafNames(obj).values()) {
+      if (sections.size > 1) out.add("ini/duplicates-across-sections");
+    }
+  }
+  for (const [k, v] of Object.entries(obj)) {
+    const isSection = v !== null && typeof v === "object" && !Array.isArray(v);
+    strShapes(k, out);
+    if (isSection) {
+      if (Object.keys(v).length === 0) continue;
+      if (k === "") out.add("ini/empty-key");
+      if (k.includes("]")) out.add("ini/section-bracket");
+      if (k.includes(".") && hasSectionChild(v)) out.add("ini/dotted-parent");
+      if (k.includes("\\.") || (k.endsWith("\\") && hasSectionChild(v))) out.add("ini/backslash-dot");
+      shapes(v, opt, false, out);
+    } else {
+      if (Array.isArray(v) && v.length === 0) continue;
+      if (k === "") out.add("ini/empty-key");
+      if (k.includes("=")) out.add("ini/key-equals");
+      if (k.endsWith("[]") && (opt.bracketedArray !== false ? k.length > 2 : Array.isArray(v) && v.length > 1)) out.add("ini/key-brackets");
+      // with bracketedArray off a one-element array comes back as its element
+      const eff = opt.bracketedArray === false && Array.isArray(v) && v.length === 1 ? v[0] : v;
+      if (eff === null && top && !opt.section && k.includes(".")) out.add("ini/null-dotted");
+      if (Array.isArray(v)) v.forEach((x) => valueShapes(x, out));
+      else valueShapes(v, out);
+    }
+  }
+  if (top && opt.section) {
+    strShapes(opt.section, out);
+    if (opt.section.includes("]")) out.add("ini/section-bracket");
+    if (opt.section.includes("\\.") || (opt.section.endsWith("\\") && hasSectionChild(obj))) out.add("ini/backslash-dot");
+  }
+  return out;
+}
+
+/** Count a case's recorded shapes; under HEGEL_NO_KNOWN=1 skip the case when it has one. */
+function gate(tc, sh) {
+  for (const k of sh) count(k);
+  if (noKnown && sh.size > 0) {
+    count("skipped-known");
+    tc.assume(false);
+  }
+}
+
+const named = (sh) => (sh.size > 0 ? `recorded shapes: ${[...sh].join(" ")}` : "no recorded shape");
+
+// ---------------------------------------------------------------- properties
+
+/** decode(encode(obj, opt), opt) against the model. */
+function checkRoundTrip(tc, obj, opt) {
+  const sh = shapes(obj, opt, true);
+  gate(tc, sh);
+  const text = ini.encode(obj, { ...opt });
+  tc.note(`encode(${show(obj)}, ${show(opt)}) =\n${text}`);
+  let back;
+  try {
+    back = ini.decode(text, { ...opt });
+  } catch (e) {
+    fail(`decode threw ${e} on\n${text}`);
+  }
+  const want = opt.section ? { [opt.section]: expected(obj, opt) } : expected(obj, opt);
+  if (opt.section && Object.keys(want[opt.section]).length === 0) {
+    delete want[opt.section];
+  }
+  if (!same(back, want)) {
+    fail(`round trip of ${show(obj)} with ${show(opt)}:\n${text}\ngave ${show(back)}\nwant ${show(want)}\n${named(sh)}`);
+  }
+}
+
+property("TestHegelEncodeDecodeRoundTrips", (tc) => {
+  const { obj, opt } = tc.draw(roundTripCases);
+  checkRoundTrip(tc, obj, opt);
+});
+
+/** unsafe(safe(s)) === s. */
+function checkUnsafeUndoesSafe(tc, s) {
+  const sh = new Set();
+  strShapes(s, sh);
+  gate(tc, sh);
+  const safe = ini.safe(s);
+  const back = ini.unsafe(safe);
+  if (back !== s) {
+    fail(`unsafe(safe(${show(s)})) = unsafe(${show(safe)}) = ${show(back)}\n${named(sh)}`);
+  }
+}
+
+const safeInput = weighted([75, chars(valueChars, 0, 10)], [25, gs.sampledFrom(literals)]);
+
+property("TestHegelUnsafeUndoesSafe", (tc) => {
+  checkUnsafeUndoesSafe(tc, tc.draw(safeInput));
+});
+
+// Random INI-ish text: decode must not throw, and decoding again what it encodes must give
+// the same object (the parse is a normal form). Under HEGEL_NO_KNOWN the text has no backslash
+// and no single quote (ini/5, ini/8), and a header or key that decode would read as the empty
+// name (blank, a comment start, an empty quoted string) or a header with a blank dot-part
+// (the merge pass makes it an empty section) gets a letter in front: both are ini/12.
+const LINE_CHARS = "ab=[];# .\\\"'1\t";
+const lineChars = noKnown ? without(LINE_CHARS, "\\'") : LINE_CHARS;
+const lineText = (lo, hi) => chars(lineChars, lo, hi);
+const unnamed = (s) => s.trim() === "" || /^[;#]/.test(s.trim()) || ["''", '""'].includes(s.trim());
+const nameText = (lo, hi) => (noKnown ? lineText(lo, hi).map((s) => (unnamed(s) ? `a${s}` : s)) : lineText(lo, hi));
+const blankPart = (p) => p.split(/[;#]/)[0].trim() === "";
+const dotted = (s) => (noKnown ? s.split(".").map((p) => (blankPart(p) ? `a${p}` : p)).join(".") : s);
+const iniLine = weighted(
+  [20, nameText(0, 6).map((s) => `[${dotted(s)}]`)],
+  [10, gs.tuples(gs.sampledFrom([";", "#"]), lineText(0, 6)).map(([c, s]) => c + s)],
+  [56, gs.tuples(nameText(0, 5), lineText(0, 6)).map(([k, v]) => `${k}=${v}`)],
+  [14, nameText(0, 5)],
+);
+const iniText = gs.arrays(gs.tuples(iniLine, gs.sampledFrom(["\n", "\r\n", "\n\n"])), { maxSize: 6 }).map((ls) => ls.map(([l, nl]) => l + nl).join(""));
+const stabilityOptions = weighted([75, gs.just({})], [25, gs.just({ bracketedArray: false })]);
+
+property("TestHegelDecodeIsStable", (tc) => {
+  const text = tc.draw(iniText);
+  const opt = tc.draw(stabilityOptions);
+  let once;
+  try {
+    once = ini.decode(text, { ...opt });
+  } catch (e) {
+    fail(`decode threw ${e} on ${show(text)}`);
+  }
+  const sh = shapes(once, opt, true);
+  gate(tc, sh);
+  const again = ini.decode(ini.encode(once, { ...opt }), { ...opt });
+  // empty sections are not written, so they are the one thing the normal form loses
+  const want = expected(once, opt);
+  if (!same(want, again)) {
+    fail(`decode(${show(text)}) = ${show(once)}, but decode(encode(that)) = ${show(again)}, expected ${show(want)}\n${ini.encode(once, { ...opt })}\n${named(sh)}`);
+  }
+});
+
+// ---------------------------------------------------------------- one property per recorded bug
+
+// The three properties above each shrink to one bug; these find the others, one property per
+// bug, over that bug's shape region with random contents around it and the same oracle. The
+// filler (plain keys and values, plain section options) has no recorded shape of its own and
+// the case is filtered to exactly the shape under test, so the shrunk failure is that bug and
+// no other. They draw nothing but the shape, so HEGEL_NO_KNOWN=1 skips them whole.
+const KNOWN = { skip: noKnown && "draws only a recorded bug's shape" };
+const plainKey = chars(PLAIN_KEY_CHARS, 1, 6);
+const plainScalar = scalars(plainLiterals, PLAIN_VALUE_CHARS);
+const plainLeaves = gs.maps(plainKey, plainScalar, { maxSize: 3 }).map((entries) => Object.fromEntries(entries));
+const plainSection = gs.maps(plainKey, plainScalar, { minSize: 1, maxSize: 3 }).map((entries) => Object.fromEntries(entries));
+const plainSectionOption = weighted([80, gs.just(undefined)], [20, chars(PLAIN_SECTION_CHARS, 1, 4)]);
+const plainOptionsWith = (fixed) => optionsWith({ section: plainSectionOption, ...fixed });
+const plainOptions = plainOptionsWith({});
+
+/** A section that has a sub-section beside some leaves. */
+const sectionWithChild = gs.tuples(plainLeaves, plainKey, plainSection).map(([leaves, k, child]) => ({ ...leaves, [k]: child }));
+
+/** Plain leaves plus one entry `[key, value]` of the shape under test. */
+const withEntry = (entry) => gs.tuples(plainLeaves, entry).map(([leaves, [k, v]]) => ({ ...leaves, [k]: v }));
+
+/** Two plain pieces of lo-hi characters around mid. */
+const around = (mid, lo, hi) => gs.tuples(chars(PLAIN_KEY_CHARS, lo, hi), chars(PLAIN_KEY_CHARS, lo, hi)).map(([a, b]) => a + mid + b);
+
+const caseOf = (obj, opt = plainOptions) => gs.record({ obj, opt });
+
+/** The body of a round-trip property over the cases that have exactly the recorded shape id. */
+function roundTripOf(id, cases) {
+  const exact = cases.filter(({ obj, opt }) => {
+    const sh = shapes(obj, opt, true);
+    return sh.size === 1 && sh.has(id);
+  });
+  return (tc) => {
+    const { obj, opt } = tc.draw(exact);
+    checkRoundTrip(tc, obj, opt);
+  };
+}
+
+// ini/1: a value that is the text true, false or null
+property("TestHegelLiteralStringValuesRoundTrip", roundTripOf("ini/literal-string", caseOf(withEntry(gs.tuples(plainKey, gs.sampledFrom(["true", "false", "null"]))))), KNOWN);
+
+// ini/2: a key with = in it
+property("TestHegelKeysContainingEqualsRoundTrip", roundTripOf("ini/key-equals", caseOf(withEntry(gs.tuples(around("=", 0, 4), plainScalar)))), KNOWN);
+
+// ini/3: a key ending in [] with a scalar value, bracketedArray on
+property("TestHegelKeysEndingInBracketsRoundTrip", roundTripOf("ini/key-brackets", caseOf(withEntry(gs.tuples(chars(PLAIN_KEY_CHARS, 1, 4).map((k) => `${k}[]`), plainScalar)), plainOptionsWith({ bracketedArray: gs.just(undefined) }))), KNOWN);
+
+// ini/4: a section with a dot in its name and a sub-section
+property("TestHegelDottedSectionsWithChildrenRoundTrip", roundTripOf("ini/dotted-parent", caseOf(withEntry(gs.tuples(around(".", 0, 4), sectionWithChild)))), KNOWN);
+
+// ini/5: a backslash before a backslash, semicolon or hash
+const backslashBeforeEscapable = gs.tuples(chars(PLAIN_VALUE_CHARS, 0, 4), gs.sampledFrom(["\\\\", "\\;", "\\#"]), chars(PLAIN_VALUE_CHARS, 0, 4)).map((parts) => parts.join(""));
+
+property("TestHegelBackslashBeforeEscapableUndoesSafe", (tc) => {
+  checkUnsafeUndoesSafe(tc, tc.draw(backslashBeforeEscapable));
+}, KNOWN);
+
+// ini/6: a section with ] in its name
+property("TestHegelSectionNamesContainingBracketRoundTrip", roundTripOf("ini/section-bracket", caseOf(withEntry(gs.tuples(around("]", 0, 4), plainSection)))), KNOWN);
+
+// ini/7: null under a dotted key at the top level
+property("TestHegelNullUnderDottedKeysRoundTrip", roundTripOf("ini/null-dotted", caseOf(withEntry(gs.tuples(around(".", 0, 4), gs.just(null))), plainOptionsWith({ section: gs.just(undefined) }))), KNOWN);
+
+// ini/8: a lone single quote as a value or a key
+property("TestHegelLoneQuotesRoundTrip", roundTripOf("ini/lone-quote", caseOf(withEntry(gs.oneOf(gs.tuples(plainKey, gs.just("'")), gs.tuples(gs.just("'"), plainScalar))))), KNOWN);
+
+// ini/9: the same key in two sections (or the globals and a section), bracketedArray off
+const repeatedAcrossSections = gs.oneOf(
+  gs.tuples(plainKey, plainScalar, plainScalar, plainKey).map(([k, v1, v2, s]) => ({ [k]: v1, [s]: { [k]: v2 } })),
+  gs.tuples(plainKey, plainScalar, plainScalar, plainKey, plainKey).map(([k, v1, v2, s1, s2]) => ({ [s1]: { [k]: v1 }, [s2]: { [k]: v2 } })),
+);
+
+property("TestHegelRepeatedKeysAcrossSectionsRoundTrip", roundTripOf("ini/duplicates-across-sections", caseOf(gs.tuples(plainLeaves, repeatedAcrossSections).map(([leaves, dup]) => ({ ...leaves, ...dup })), plainOptionsWith({ bracketedArray: gs.just(false) }))), KNOWN);
+
+// ini/10: a key ending in [] repeated for an array, bracketedArray off
+property("TestHegelRepeatedBracketKeysRoundTrip", roundTripOf("ini/key-brackets", caseOf(withEntry(gs.tuples(chars(PLAIN_KEY_CHARS, 0, 4).map((k) => `${k}[]`), gs.arrays(plainScalar, { minSize: 2, maxSize: 4 }))), plainOptionsWith({ bracketedArray: gs.just(false) }))), KNOWN);
+
+// ini/11: a backslash before a dot in a section name, or a section name (or section option) ending in a backslash with a sub-section
+const backslashDotSectionNames = gs.oneOf(
+  caseOf(withEntry(gs.tuples(around("\\.", 0, 4), plainSection))),
+  caseOf(withEntry(gs.tuples(chars(PLAIN_KEY_CHARS, 0, 4).map((k) => `${k}\\`), sectionWithChild))),
+  caseOf(sectionWithChild, plainOptionsWith({ section: chars(PLAIN_KEY_CHARS, 0, 3).map((s) => `${s}\\`) })),
+);
+
+property("TestHegelBackslashDotSectionNamesRoundTrip", roundTripOf("ini/backslash-dot", backslashDotSectionNames), KNOWN);
+
+// ini/12: the empty key
+property("TestHegelEmptyKeysRoundTrip", roundTripOf("ini/empty-key", caseOf(withEntry(gs.tuples(gs.just(""), plainScalar)))), KNOWN);
+
+// ---------------------------------------------------------------- pins
+
+function roundTrip(obj, opt = {}) {
+  return ini.decode(ini.encode(obj, { ...opt }), { ...opt });
+}
+
+function expectSame(obj, opt, want = obj) {
+  const back = roundTrip(obj, opt);
+  if (!same(back, want)) {
+    throw new Error(`${show(obj)} with ${show(opt)} encodes as ${show(ini.encode(obj, { ...opt }))} and decodes as ${show(back)}, expected ${show(want)}`);
+  }
+}
+
+// ini/1
+pin("TestHegelPinLiteralStringsBecomeValues", () => {
+  expectSame({ a: "true", b: "false", c: "null" }, {});
+});
+
