index 0000000..01f84cf
--- /dev/null
+++ b/test/hegel-zoo.mjs
@@ -0,0 +1,112 @@
+// Hegel zoo: the small harness shared by the zoo's TypeScript/JavaScript targets.
+//
+// `property(name, body)` registers a node:test test that runs `body(tc)` under Hegel with
+// HEGEL_TEST_CASES cases (default 100) and the database at HEGEL_DATABASE. With ZOO_COLLECT=1
+// a `fail()` records the mismatch instead of failing, the case ends there, and the counts of
+// mismatches and of the shapes seen (`count(key)`) are printed at the end of the test, so a
+// property can be run over many cases to see every shape at once. `pin(name, body)` is a
+// plain test for one pinned bug: it must fail while the bug is present and pass once it is
+// fixed (the zoo's judge reads an unexpected pass as "fixed upstream?").
+
+import { readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { test as nodeTest } from "node:test";
+import * as hegel from "@hegeldev/hegel";
+
+// The Hegel version these tests were written against (the zoo pins it in zoo.toml and installs
+// it with `npm install --no-save @hegeldev/hegel@<version>`; upstream would add it to
+// devDependencies). Checked at load time so a stray install cannot silently change the engine.
+export const HEGEL_PIN = { "@hegeldev/hegel": "0.4.5" };
+
+{
+  let dir = dirname(fileURLToPath(import.meta.resolve("@hegeldev/hegel")));
+  while (!/[\\/]hegel$/.test(dir) && dir !== dirname(dir)) dir = dirname(dir);
+  const installed = JSON.parse(readFileSync(join(dir, "package.json"), "utf8")).version;
+  if (installed !== HEGEL_PIN["@hegeldev/hegel"]) {
+    throw new Error(`@hegeldev/hegel ${installed} is installed; these tests pin ${HEGEL_PIN["@hegeldev/hegel"]}`);
+  }
+}
+
+export const collecting = !!process.env.ZOO_COLLECT;
+
+class Collected extends Error {}
+
+let msgs = [];
+let stats = new Map();
+
+/** Report a mismatch: an error normally, a recorded line in collect mode. */
+export function fail(message) {
+  if (collecting) {
+    msgs.push(message);
+    throw new Collected(message);
+  }
+  throw new Error(message);
+}
+
+/** Bump a statistic (the shape of a pinned bug, a generator branch). */
+export function count(key) {
+  stats.set(key, (stats.get(key) || 0) + 1);
+}
+
+function settings() {
+  const s = { testCases: Number(process.env.HEGEL_TEST_CASES) || 100 };
+  if (process.env.HEGEL_DATABASE) {
+    s.database = hegel.Database.fromPath(process.env.HEGEL_DATABASE);
+  }
+  return s;
+}
+
+/** A property: `body(tc)` runs under Hegel; a thrown error (or `fail`) is a failure. */
+export function property(name, body) {
+  nodeTest(name, () => {
+    msgs = [];
+    stats = new Map();
+    hegel.test((tc) => {
+      try {
+        body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** A pin: a plain test for one recorded bug. */
+export function pin(name, body) {
+  nodeTest(name, body);
+}
+
+/** Structural equality: arrays by position, objects by key set (prototype ignored), else ===. */
+export function same(a, b) {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) {
+      return false;
+    }
+    return a.every((x, i) => same(x, b[i]));
+  }
+  if (a !== null && b !== null && typeof a === "object" && typeof b === "object") {
+    const ka = Object.keys(a).sort();
+    const kb = Object.keys(b).sort();
+    if (ka.length !== kb.length || ka.some((k, i) => k !== kb[i])) {
+      return false;
+    }
+    return ka.every((k) => same(a[k], b[k]));
+  }
+  return a === b;
+}
+
+/** A compact, unambiguous rendering for messages. */
+export function show(x) {
+  return JSON.stringify(x, (k, v) => (v === undefined ? "<undefined>" : v));
+}
diff --git a/test/hegel.test.mjs b/test/hegel.test.mjs
new file mode 100644
index 0000000..61089c5
--- /dev/null
+++ b/test/hegel.test.mjs
@@ -0,0 +1,332 @@
+// Hegel zoo: properties of ini (npm/ini) — decode∘encode round trips, unsafe∘safe round
+// trips, and decode's stability on arbitrary text.
+//
+// Run with `node --test --test-reporter=tap test/hegel.test.mjs`; ZOO_COLLECT=1 records
+// mismatches instead of failing (see test/hegel-zoo.mjs).
+
+import ini from "../lib/ini.js";
+import * as gs from "@hegeldev/hegel/generators";
+import { property, pin, fail, count, same, show } from "./hegel-zoo.mjs";
+
+// ---------------------------------------------------------------- generators
+
+// Characters that mean something to the format, plus ordinary ones.
+const KEY_CHARS = "abkZ09_- .;#=[]\"'\\é全\t";
+const VALUE_CHARS = KEY_CHARS + "\n\r,:/";
+const LITERALS = ["true", "false", "null", "undefined", "1", "0", "-0", "1.5", "1e3", "0x10", "yes", "on", "[]", "[a]", '""', "''", "'", '"', "\\", "\\;", " "];
+
+/** A string of minSize–maxSize characters from alphabet. */
+const chars = (alphabet, minSize, maxSize) => gs.text({ alphabet, minSize, maxSize });
+
+/** oneOf with integer weights: `weighted([3, a], [1, b])` draws from a three times in four. */
+const weighted = (...choices) => gs.oneOf(...choices.flatMap(([w, g]) => Array(w).fill(g)));
+
+/** value pct percent of the time, else undefined. */
+const maybe = (pct, value) => weighted([pct, gs.just(value)], [100 - pct, gs.just(undefined)]);
+
+const key = weighted([15, gs.sampledFrom(LITERALS)], [85, chars(KEY_CHARS, 1, 8)]);
+
+const scalar = weighted(
+  [8, gs.just(true)],
+  [4, gs.just(false)],
+  [4, gs.just(null)],
+  [8, gs.sampledFrom(LITERALS)],
+  [6, gs.sampledFrom([0, 1, -1, 7, 1.5, 1e21, 42])],
+  [70, chars(VALUE_CHARS, 0, 10)],
+);
+
+const array = gs.arrays(scalar, { maxSize: 4 });
+
+/** An object of scalars, arrays and (down to depth 0) nested objects, with distinct keys. */
+function object(depth) {
+  const value = depth > 0 ? weighted([15, array], [25, object(depth - 1)], [60, scalar]) : weighted([15, array], [85, scalar]);
+  return gs.maps(key, value, { maxSize: 5 }).map((entries) => {
+    const out = {};
+    for (const [k, v] of entries) {
+      if (!(k in out) && k !== "__proto__") {
+        out[k] = v;
+      }
+    }
+    return out;
+  });
+}
+
+/** encode/decode options; a key is absent rather than undefined. */
+const options = gs
+  .record({
+    whitespace: maybe(30, true),
+    align: maybe(20, true),
+    sort: maybe(30, true),
+    newline: maybe(20, true),
+    platform: maybe(20, "win32"),
+    bracketedArray: maybe(25, false),
+    section: weighted([20, chars("st1 ;]=\\\"", 1, 4)], [80, gs.just(undefined)]),
+  })
+  .map((opt) => Object.fromEntries(Object.entries(opt).filter(([, v]) => v !== undefined)));
+
+// ---------------------------------------------------------------- the model
+
+// What decode(encode(obj, opt)) should give: the format is untyped (numbers come back as
+// their decimal text) and cannot express an empty array or an empty section, and with
+// bracketedArray off a one-element array is indistinguishable from a scalar; everything else
+// must come back as it went in.
+function expected(obj, opt) {
+  const out = {};
+  for (const [k, v] of Object.entries(obj)) {
+    if (Array.isArray(v)) {
+      const items = v.map(scalarBack);
+      if (items.length === 0) continue;
+      out[k] = opt.bracketedArray === false && items.length === 1 ? items[0] : items;
+    } else if (v !== null && typeof v === "object") {
+      const child = expected(v, opt);
+      if (Object.keys(child).length === 0) continue;
+      out[k] = child;
+    } else {
+      out[k] = scalarBack(v);
+    }
+  }
+  return out;
+}
+
+function scalarBack(v) {
+  if (typeof v === "number") return JSON.stringify(v);
+  return v;
+}
+
+// ---------------------------------------------------------------- pinned shapes
+
+// The shapes of the recorded bugs, read off the input (keys, values, section names). A case
+// with none of them must round-trip exactly; a case with some is counted and only checked
+// when it happens to round-trip anyway (the pins hold the bugs themselves).
+function strShapes(s, out) {
+  if (/\\[\\;#]/.test(s)) out.add("ini/backslash");
+  if (s === "'") out.add("ini/lone-quote");
+}
+
+function valueShapes(v, out) {
+  if (typeof v === "string") {
+    if (v === "true" || v === "false" || v === "null") out.add("ini/literal-string");
+    strShapes(v, out);
+  }
+}
+
+function hasSectionChild(obj) {
+  return Object.values(obj).some((v) => v !== null && typeof v === "object" && !Array.isArray(v) && Object.keys(v).length > 0);
+}
+
+// With bracketedArray off, the decoder counts duplicate keys over the whole file, not per
+// section: a leaf key that appears in two sections comes back as an array in the second.
+function leafNames(obj, into = new Map(), section = 0) {
+  for (const [k, v] of Object.entries(obj)) {
+    if (v !== null && typeof v === "object" && !Array.isArray(v)) {
+      leafNames(v, into, section + 1 + into.size * 1000);
+    } else if (!Array.isArray(v) || v.length > 0) {
+      const set = into.get(k) || new Set();
+      set.add(section);
+      into.set(k, set);
+    }
+  }
+  return into;
+}
+
+function shapes(obj, opt, top, out = new Set()) {
+  if (top && opt.bracketedArray === false) {
+    for (const sections of leafNames(obj).values()) {
+      if (sections.size > 1) out.add("ini/duplicates-across-sections");
+    }
+  }
+  for (const [k, v] of Object.entries(obj)) {
+    const isSection = v !== null && typeof v === "object" && !Array.isArray(v);
+    strShapes(k, out);
+    if (isSection) {
+      if (Object.keys(v).length === 0) continue;
+      if (k === "") out.add("ini/empty-key");
+      if (k.includes("]")) out.add("ini/section-bracket");
+      if (k.includes(".") && hasSectionChild(v)) out.add("ini/dotted-parent");
+      if (k.includes("\\.") || (k.endsWith("\\") && hasSectionChild(v))) out.add("ini/backslash-dot");
+      shapes(v, opt, false, out);
+    } else {
+      if (Array.isArray(v) && v.length === 0) continue;
+      if (k === "") out.add("ini/empty-key");
+      if (k.includes("=")) out.add("ini/key-equals");
+      if (k.endsWith("[]") && (opt.bracketedArray !== false ? k.length > 2 : Array.isArray(v) && v.length > 1)) out.add("ini/key-brackets");
+      // with bracketedArray off a one-element array comes back as its element
+      const eff = opt.bracketedArray === false && Array.isArray(v) && v.length === 1 ? v[0] : v;
+      if (eff === null && top && !opt.section && k.includes(".")) out.add("ini/null-dotted");
+      if (Array.isArray(v)) v.forEach((x) => valueShapes(x, out));
+      else valueShapes(v, out);
+    }
+  }
+  if (top && opt.section) {
+    strShapes(opt.section, out);
+    if (opt.section.includes("]")) out.add("ini/section-bracket");
+    if (opt.section.includes("\\.") || (opt.section.endsWith("\\") && hasSectionChild(obj))) out.add("ini/backslash-dot");
+  }
+  return out;
+}
+
+// ---------------------------------------------------------------- properties
+
+property("TestHegelEncodeDecodeRoundTrips", (tc) => {
+  const obj = tc.draw(object(2));
+  const opt = tc.draw(options);
+  const text = ini.encode(obj, { ...opt });
+  tc.note(`encode(${show(obj)}, ${show(opt)}) =\n${text}`);
+  let back;
+  try {
+    back = ini.decode(text, { ...opt });
+  } catch (e) {
+    fail(`decode threw ${e} on\n${text}`);
+  }
+  const want = opt.section ? { [opt.section]: expected(obj, opt) } : expected(obj, opt);
+  if (opt.section && Object.keys(want[opt.section]).length === 0) {
+    delete want[opt.section];
+  }
+  const sh = shapes(obj, opt, true);
+  for (const k of sh) count(k);
+  if (!same(back, want)) {
+    if (sh.size === 0) {
+      fail(`round trip of ${show(obj)} with ${show(opt)}:\n${text}\ngave ${show(back)}\nwant ${show(want)}`);
+    }
+    count("explained");
+  } else if (sh.size > 0) {
+    count("shape-but-ok");
+  }
+});
+
+const safeInput = weighted([25, gs.sampledFrom(LITERALS)], [75, chars(VALUE_CHARS, 0, 10)]);
+
+property("TestHegelUnsafeUndoesSafe", (tc) => {
+  const s = tc.draw(safeInput);
+  const safe = ini.safe(s);
+  const back = ini.unsafe(safe);
+  const sh = new Set();
+  strShapes(s, sh);
+  for (const k of sh) count(k);
+  if (back !== s) {
+    if (sh.size === 0) {
+      fail(`unsafe(safe(${show(s)})) = unsafe(${show(safe)}) = ${show(back)}`);
+    }
+    count("explained");
+  } else if (sh.size > 0) {
+    count("shape-but-ok");
+  }
+});
+
+// Random INI-ish text: decode must not throw, and decoding again what it encodes must give
+// the same object (the parse is a normal form).
+const LINE_CHARS = "ab=[];# .\\\"'1\t";
+const lineText = (lo, hi) => chars(LINE_CHARS, lo, hi);
+const iniLine = weighted(
+  [20, lineText(0, 6).map((s) => `[${s}]`)],
+  [10, gs.tuples(gs.sampledFrom([";", "#"]), lineText(0, 6)).map(([c, s]) => c + s)],
+  [56, gs.tuples(lineText(0, 5), lineText(0, 6)).map(([k, v]) => `${k}=${v}`)],
+  [14, lineText(0, 5)],
+);
+const iniText = gs.arrays(gs.tuples(iniLine, gs.sampledFrom(["\n", "\r\n", "\n\n"])), { maxSize: 6 }).map((ls) => ls.map(([l, nl]) => l + nl).join(""));
+const stabilityOptions = weighted([25, gs.just({ bracketedArray: false })], [75, gs.just({})]);
+
+property("TestHegelDecodeIsStable", (tc) => {
+  const text = tc.draw(iniText);
+  const opt = tc.draw(stabilityOptions);
+  let once;
+  try {
+    once = ini.decode(text, { ...opt });
+  } catch (e) {
+    fail(`decode threw ${e} on ${show(text)}`);
+  }
+  const again = ini.decode(ini.encode(once, { ...opt }), { ...opt });
+  const sh = shapes(once, opt, true);
+  for (const k of sh) count(k);
+  // empty sections are not written, so they are the one thing the normal form loses
+  const want = expected(once, opt);
+  if (!same(want, again)) {
+    if (sh.size > 0) {
+      count("explained");
+      return;
+    }
+    fail(`decode(${show(text)}) = ${show(once)}, but decode(encode(that)) = ${show(again)}, expected ${show(want)}\n${ini.encode(once, { ...opt })}`);
+  }
+});
+
+// ---------------------------------------------------------------- pins
+
+function roundTrip(obj, opt = {}) {
+  return ini.decode(ini.encode(obj, { ...opt }), { ...opt });
+}
+
+function expectSame(obj, opt, want = obj) {
+  const back = roundTrip(obj, opt);
+  if (!same(back, want)) {
+    throw new Error(`${show(obj)} with ${show(opt)} encodes as ${show(ini.encode(obj, { ...opt }))} and decodes as ${show(back)}, expected ${show(want)}`);
+  }
+}
+
+// ini/1
+pin("TestHegelPinLiteralStringsBecomeValues", () => {
+  expectSame({ a: "true", b: "false", c: "null" }, {});
+});
+
+// ini/2
+pin("TestHegelPinKeyWithEqualsSplits", () => {
+  expectSame({ "a=b": "v" }, {});
+});
+
+// ini/3
+pin("TestHegelPinKeyEndingInBracketsBecomesAnArray", () => {
+  expectSame({ "a[]": "v" }, {});
+});
+
+// ini/4
+pin("TestHegelPinDottedSectionWithChildrenKeepsTheEscape", () => {
+  expectSame({ "a.b": { c: { x: "1" } } }, {});
+});
+
+// ini/5
+pin("TestHegelPinBackslashBeforeSemicolonIsLost", () => {
+  const s = "x\\;y";
+  if (ini.unsafe(ini.safe(s)) !== s) {
+    throw new Error(`unsafe(safe(${show(s)})) = unsafe(${show(ini.safe(s))}) = ${show(ini.unsafe(ini.safe(s)))}`);
+  }
+  expectSame({ a: s }, {});
+});
+
+// ini/6
+pin("TestHegelPinSectionNameWithBracketIsUnreadable", () => {
+  expectSame({ "a]b": { x: "1" } }, {});
+});
+
+// ini/7
+pin("TestHegelPinNullUnderDottedKeyBecomesASection", () => {
+  expectSame({ "a.b": null }, {});
+});
+
+// ini/8
+pin("TestHegelPinLoneQuoteBecomesEmpty", () => {
+  if (ini.unsafe(ini.safe("'")) !== "'") {
+    throw new Error(`unsafe(safe("'")) = ${show(ini.unsafe(ini.safe("'")))}`);
+  }
+  expectSame({ a: "'" }, {});
+});
+
+// ini/9
+pin("TestHegelPinDuplicateKeysAreCountedAcrossSections", () => {
+  expectSame({ a: "1", s: { a: "2" } }, { bracketedArray: false });
+});
+
+// ini/10
+pin("TestHegelPinRepeatedBracketKeyLosesItsName", () => {
+  expectSame({ "k[]": ["1", "2"] }, { bracketedArray: false });
+});
+
+// ini/11
+pin("TestHegelPinBackslashDotInSectionNameIsAnEscape", () => {
+  expectSame({ "a\\.b": { x: "1" } }, {});
+  expectSame({ "a\\": { b: { x: "1" } } }, {});
+  expectSame({ b: { x: "1" } }, { section: "s\\" }, { "s\\": { b: { x: "1" } } });
+});
+
+// ini/12
+pin("TestHegelPinEmptyKeyIsWrittenUnreadably", () => {
+  expectSame({ "": "v" }, {});
+});
