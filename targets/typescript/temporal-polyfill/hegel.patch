--- /dev/null
+++ b/polyfill/test/hegel-zoo.mjs
@@ -0,0 +1,131 @@
+// Hegel zoo: the small harness shared by the zoo's TypeScript/JavaScript targets.
+//
+// `property(name, body)` registers a node:test test that runs `body(tc)` under Hegel with
+// HEGEL_TEST_CASES cases (default 100) and the database at HEGEL_DATABASE. With ZOO_COLLECT=1
+// a `fail()` records the mismatch instead of failing, the case ends there, and the counts of
+// mismatches and of the shapes seen (`count(key)`) are printed at the end of the test, so a
+// property can be run over many cases to see every shape at once. `pin(name, body)` is a
+// plain test for one pinned bug: it must fail while the bug is present and pass once it is
+// fixed (the zoo's judge reads an unexpected pass as "fixed upstream?"). HEGEL_NO_KNOWN=1
+// (`noKnown`, read once here) asks for a run that looks past the recorded bugs: the generators
+// then draw the region beside their shapes, and a mismatch that has one is skipped.
+
+import { readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+import { test as nodeTest } from "node:test";
+
+// The Hegel version these tests were written against (the zoo pins it in zoo.toml; upstream
+// would add it to devDependencies). The repository is a pnpm workspace whose dist is not
+// committed, so Hegel, the TypeScript compiler that builds src/ into .hegel/dist and the
+// reference implementation are installed with `npm install --prefix .hegel` and imported from
+// there. Checked at load time so a stray install cannot silently change the engine.
+export const HEGEL_PIN = { "@hegeldev/hegel": "0.4.5" };
+
+const hegelDir = join(dirname(fileURLToPath(import.meta.url)), "..", ".hegel", "node_modules", "@hegeldev", "hegel");
+{
+  const installed = JSON.parse(readFileSync(join(hegelDir, "package.json"), "utf8")).version;
+  if (installed !== HEGEL_PIN["@hegeldev/hegel"]) {
+    throw new Error(`@hegeldev/hegel ${installed} is installed; these tests pin ${HEGEL_PIN["@hegeldev/hegel"]}`);
+  }
+}
+const hegel = await import(pathToFileURL(join(hegelDir, "dist", "index.js")));
+const gs = await import(pathToFileURL(join(hegelDir, "dist", "generators", "index.js")));
+
+/** Hegel's generators, re-exported so the tests import everything from one place. */
+export { gs };
+
+export const collecting = !!process.env.ZOO_COLLECT;
+
+/** HEGEL_NO_KNOWN=1: draw beside the shapes of the recorded bugs (they are drawn, and fail, by default). */
+export const noKnown = !!process.env.HEGEL_NO_KNOWN;
+
+class Collected extends Error {}
+
+let msgs = [];
+let stats = new Map();
+
+/** Report a mismatch: an error normally, a recorded line in collect mode. */
+export function fail(message) {
+  if (collecting) {
+    msgs.push(message);
+    throw new Collected(message);
+  }
+  throw new Error(message);
+}
+
+/** Bump a statistic (the shape of a pinned bug, a generator branch). */
+export function count(key) {
+  stats.set(key, (stats.get(key) || 0) + 1);
+}
+
+function settings() {
+  const s = { testCases: Number(process.env.HEGEL_TEST_CASES) || 100 };
+  if (process.env.HEGEL_DATABASE) {
+    s.database = hegel.Database.fromPath(process.env.HEGEL_DATABASE);
+  }
+  return s;
+}
+
+// Hegel keys its example database by the test function's source text. Every property here runs
+// through the same wrapper, so without this every property would share one key and replay the
+// stored failing examples of all the others; the key is the test's name instead.
+function keyed(name, fn) {
+  fn.toString = () => name;
+  return fn;
+}
+
+/** A property: `body(tc)` runs under Hegel; a thrown error (or `fail`) is a failure. */
+export function property(name, body, { skip } = {}) {
+  nodeTest(name, { skip }, () => {
+    msgs = [];
+    stats = new Map();
+    hegel.test(keyed(name, (tc) => {
+      if (collecting) count("cases");
+      try {
+        body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }), settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** A pin: a plain test for one recorded bug. */
+export function pin(name, body) {
+  nodeTest(name, body);
+}
+
+/** Structural equality: arrays by position, objects by key set (prototype ignored), else ===. */
+export function same(a, b) {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) {
+      return false;
+    }
+    return a.every((x, i) => same(x, b[i]));
+  }
+  if (a !== null && b !== null && typeof a === "object" && typeof b === "object") {
+    const ka = Object.keys(a).sort();
+    const kb = Object.keys(b).sort();
+    if (ka.length !== kb.length || ka.some((k, i) => k !== kb[i])) {
+      return false;
+    }
+    return ka.every((k) => same(a[k], b[k]));
+  }
+  return a === b;
+}
+
+/** A compact, unambiguous rendering for messages. */
+export function show(x) {
+  return JSON.stringify(x, (k, v) => (v === undefined ? "<undefined>" : v));
+}
diff --git a/polyfill/test/hegel.test.mjs b/polyfill/test/hegel.test.mjs
new file mode 100644
index 0000000..2d849e4
--- /dev/null
+++ b/polyfill/test/hegel.test.mjs
@@ -0,0 +1,681 @@
+// Hegel zoo: property tests for temporal-polyfill against @js-temporal/polyfill, the TC39
+// champions' reference polyfill of the same Temporal specification. Every case is one record
+// drawn from test/gen.mjs (dates and times as fields, durations as unit maps, RFC 9557 strings
+// as their parts) and rendered by pure functions; both implementations get the same plain data
+// (ISO strings, property bags, epoch nanoseconds, option bags) and the results are compared
+// (canonical `toString()`, fields, or the class of the error thrown). The spec's own laws
+// (until/add round trips, compare antisymmetry, negation) are checked on the polyfill alone.
+//
+// The shapes of the recorded bugs (bugs.toml) are drawn like any other and the properties fail
+// on them, naming the shape in the failure; each bug also has a property over its shape alone
+// (the section before the pins) and a pin. HEGEL_NO_KNOWN=1 asks for a run that looks past the
+// known bugs: the generators then draw the region beside each shape, a parser check whose
+// string has a shape is counted and skipped, and a mismatch recognised as a shape only when it
+// happens is skipped. Where the reference lags the specification (`OracleLimits`) the polyfill
+// is judged by the specification, or the check is counted and skipped.
+
+import assert from "node:assert/strict";
+import { createRequire } from "node:module";
+import { count, fail, noKnown, pin, property, show } from "./hegel-zoo.mjs";
+import * as gen from "./gen.mjs";
+import { CALENDARS, DATE_UNITS, PARSERS, PLAIN_TYPES, TIME_UNITS, UNITS, dropUndefined, isoDate, isoMonthDay, isoTime, isoYearMonth, pad, renderAnnotation } from "./gen.mjs";
+
+const require = createRequire(import.meta.url);
+// the CommonJS build of polyfill/src (with utils/src) made by the setup, see test/tsconfig.hegel.json
+const { Temporal: T } = require("../.hegel/dist/polyfill/src/classApi/full/index.js");
+const { Temporal: O } = require("../.hegel/node_modules/@js-temporal/polyfill");
+
+// ---------------------------------------------------------------------------------------------
+// The recorded bugs (bugs.toml) whose shapes the generators draw, by id: what the shape is. A
+// property that meets one fails naming it; under HEGEL_NO_KNOWN=1 the generators draw beside
+// the shape (gen.mjs, `shaped`), and a check whose input still has one is counted and skipped.
+
+const SHAPE = {
+  "temporal-polyfill/1": "directional rounding (trunc, expand, ceil/floor) of an Instant before 1970 in toString/round, and of ZonedDateTime.toString, treats the epoch nanoseconds as signed instead of as if positive (trunc lands toward 1970 instead of toward the past, expand away from 1970)",
+  "temporal-polyfill/2": "PlainTime.from accepts a string whose date part is not a valid date (2011-02-30T13:12:50)",
+  "temporal-polyfill/3": "PlainTime.from rejects a date-time string carrying a calendar annotation that is not iso8601 (2048-10-24T02:08[u-ca=persian])",
+  "temporal-polyfill/4": "PlainYearMonth.add/subtract accept units below months next to a year or month part (the specification throws), and a negative mixed duration lands a month early",
+  "temporal-polyfill/5": "a bracketed UTC offset with seconds ([+05:30:15]) is accepted as a time zone by the Plain types' parsers",
+  "temporal-polyfill/6": "a UTC offset with an hour of 24 or more, or a minute of 60, is accepted by the Plain types' parsers",
+  "temporal-polyfill/7": "a negative duration that rounds to zero in toString keeps its minus sign (-PT0.000S)",
+  "temporal-polyfill/8": "a time zone annotation placed after another annotation ([foo=bar][UTC]) is accepted by every parser",
+  "temporal-polyfill/9": "until/since with largestUnit year from Adar I (M05L) of a Hebrew leap year to a later day of Shevat (M05) of an earlier common year counts one year fewer and twelve months (-P49Y12M15D for -P50Y15D)",
+};
+
+/** The suffix of a failure message naming the recorded shapes `ids`. */
+const recorded = (ids) => ` (recorded shape${ids.length > 1 ? "s" : ""} ${ids.map((id) => `${id}: ${SHAPE[id]}`).join("; ")})`;
