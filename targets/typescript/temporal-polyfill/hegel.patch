@@ -0,0 +1,140 @@
+// Hegel zoo: the small harness shared by the zoo's TypeScript/JavaScript targets.
+//
+// `property(name, body)` registers a node:test test that runs `body(tc)` under Hegel with
+// HEGEL_TEST_CASES cases (default 100) and the database at HEGEL_DATABASE. With ZOO_COLLECT=1
+// a `fail()` records the mismatch instead of failing, the case ends there, and the counts of
+// mismatches and of the shapes seen (`count(key)`) are printed at the end of the test, so a
+// property can be run over many cases to see every shape at once. `pin(name, body)` is a
+// plain test for one pinned bug: it must fail while the bug is present and pass once it is
+// fixed (the zoo's judge reads an unexpected pass as "fixed upstream?").
+
+import { readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+import { test as nodeTest } from "node:test";
+
+// The Hegel version these tests were written against (the zoo pins it in zoo.toml; upstream
+// would add it to devDependencies). smol-toml's package.json declares `devEngines.packageManager
+// = pnpm` with `onFail: "error"`, which makes npm refuse to install anything into the package
+// itself, so Hegel (and the TypeScript compiler that builds src/ into .hegel/dist) are installed
+// with `npm install --prefix .hegel` and imported from there. Checked at load time so a stray
+// install cannot silently change the engine.
+export const HEGEL_PIN = { "@hegeldev/hegel": "0.4.5" };
+
+const hegelDir = join(dirname(fileURLToPath(import.meta.url)), "..", ".hegel", "node_modules", "@hegeldev", "hegel");
+{
+  const installed = JSON.parse(readFileSync(join(hegelDir, "package.json"), "utf8")).version;
+  if (installed !== HEGEL_PIN["@hegeldev/hegel"]) {
+    throw new Error(`@hegeldev/hegel ${installed} is installed; these tests pin ${HEGEL_PIN["@hegeldev/hegel"]}`);
+  }
+}
+const hegel = await import(pathToFileURL(join(hegelDir, "dist", "index.js")));
+const gs = await import(pathToFileURL(join(hegelDir, "dist", "generators", "index.js")));
+
+export const collecting = !!process.env.ZOO_COLLECT;
+
+class Collected extends Error {}
+
+let msgs = [];
+let stats = new Map();
+
+/** Report a mismatch: an error normally, a recorded line in collect mode. */
+export function fail(message) {
+  if (collecting) {
+    msgs.push(message);
+    throw new Collected(message);
+  }
+  throw new Error(message);
+}
+
+/** Bump a statistic (the shape of a pinned bug, a generator branch). */
+export function count(key) {
+  stats.set(key, (stats.get(key) || 0) + 1);
+}
+
+function settings() {
+  const s = { testCases: Number(process.env.HEGEL_TEST_CASES) || 100 };
+  if (process.env.HEGEL_DATABASE) {
+    s.database = hegel.Database.fromPath(process.env.HEGEL_DATABASE);
+  }
+  return s;
+}
+
+/** A property: `body(tc)` runs under Hegel; a thrown error (or `fail`) is a failure. */
+export function property(name, body) {
+  nodeTest(name, () => {
+    msgs = [];
+    stats = new Map();
+    hegel.test((tc) => {
+      try {
+        body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** A pin: a plain test for one recorded bug. */
+export function pin(name, body) {
+  nodeTest(name, body);
+}
+
+/** An integer in [lo, hi]. */
+export function n(tc, lo, hi) {
+  return tc.draw(gs.integers({ minValue: lo, maxValue: hi }));
+}
+
+/** One of xs. */
+export function pick(tc, xs) {
+  return xs[n(tc, 0, xs.length - 1)];
+}
+
+/** True pct percent of the time. */
+export function chance(tc, pct) {
+  return n(tc, 0, 99) < pct;
+}
+
+/** A string of `len` characters drawn from `alphabet` (an array of strings). */
+export function word(tc, alphabet, lo, hi) {
+  const len = n(tc, lo, hi);
+  let s = "";
+  for (let i = 0; i < len; i++) {
+    s += pick(tc, alphabet);
+  }
+  return s;
+}
+
+/** Structural equality: arrays by position, objects by key set (prototype ignored), else ===. */
+export function same(a, b) {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) {
+      return false;
+    }
+    return a.every((x, i) => same(x, b[i]));
+  }
+  if (a !== null && b !== null && typeof a === "object" && typeof b === "object") {
+    const ka = Object.keys(a).sort();
+    const kb = Object.keys(b).sort();
+    if (ka.length !== kb.length || ka.some((k, i) => k !== kb[i])) {
+      return false;
+    }
+    return ka.every((k) => same(a[k], b[k]));
+  }
+  return a === b;
+}
+
+/** A compact, unambiguous rendering for messages. */
+export function show(x) {
+  return JSON.stringify(x, (k, v) => (v === undefined ? "<undefined>" : v));
+}
diff --git a/polyfill/test/hegel.test.mjs b/polyfill/test/hegel.test.mjs
new file mode 100644
index 0000000..085331c
--- /dev/null
+++ b/polyfill/test/hegel.test.mjs
@@ -0,0 +1,736 @@
+// Hegel zoo: property tests for temporal-polyfill against @js-temporal/polyfill, the TC39
+// champions' reference polyfill of the same Temporal specification. Every case builds the same
+// value from plain data (ISO strings, property bags, epoch nanoseconds) in both implementations
+// and compares the results (canonical `toString()`, fields, or the class of the error thrown).
+// The spec's own laws (until/add round trips, compare antisymmetry, negation) are checked on the
+// polyfill alone.
+
+import assert from "node:assert/strict";
+import { createRequire } from "node:module";
+import { property, pin, fail, count, n, pick, chance, word, show } from "./hegel-zoo.mjs";
+
+const require = createRequire(import.meta.url);
+// the CommonJS build of polyfill/src (with utils/src) made by the setup, see test/tsconfig.hegel.json
+const { Temporal: T } = require("../.hegel/dist/polyfill/src/classApi/full/index.js");
+const { Temporal: O } = require("../.hegel/node_modules/@js-temporal/polyfill");
+
+// ---------------------------------------------------------------------------------------------
+// Known bugs (see bugs.toml) and oracle limits. Properties skip these shapes; pins assert the
+// correct behaviour and fail while a bug exists.
+
+const Known = {
+  // temporal-polyfill/1: directional rounding (trunc, expand, ceil/floor asymmetries) of a
+  // pre-1970 Instant in toString/round, and of ZonedDateTime.toString, rounds toward 1970
+  // instead of toward the past (`-34959986330n` to seconds is 23:59:26Z, spec 23:59:25Z).
+  negativeInstantRounding: true,
+  // temporal-polyfill/2: PlainTime.from accepts a string whose date part is invalid
+  // ("2011-02-30T13:12:50").
+  plainTimeInvalidDate: true,
+  // temporal-polyfill/3: PlainTime.from rejects a non-ISO calendar annotation ("T02:08[u-ca=persian]").
+  plainTimeCalendar: true,
+  // temporal-polyfill/4: PlainYearMonth.add/subtract accept units below months when a
+  // year/month part is present, and a negative mixed duration lands a month early.
+  yearMonthLowerUnits: true,
+  // temporal-polyfill/5: a bracketed offset with seconds ([+05:30:15]) is accepted by the Plain
+  // types' parsers (ZonedDateTime rejects it).
+  bracketSubMinuteOffset: true,
+  // temporal-polyfill/6: the Plain types' parsers accept a UTC offset with an hour of 24 or more
+  // ("1969-10-20T01:51:57+24:00", "+25:00", "+23:60"); Instant, ZonedDateTime and PlainTime
+  // reject the same offset.
+  offsetHourTooLarge: true,
+  // temporal-polyfill/7: a negative duration that rounds to zero in toString keeps its minus sign
+  // ("-PT0.000S", "-PT0S"); the rounded duration's sign is 0 and the spec prints "PT0.000S".
+  zeroDurationSign: true,
+  // temporal-polyfill/8: a time zone annotation placed after another annotation
+  // ("...T15:46[foo=bar][UTC]") is accepted by every parser; the grammar puts the time zone first.
+  timeZoneAfterAnnotation: true,
+};
+
+// Divergences where the reference polyfill (0.5.1, March 2025) is behind the specification or
+// hampered by this Node's ICU, documented in the README rather than counted:
+const OracleLimits = {
+  // weekOfYear/yearOfWeek are only defined for iso8601 in the current spec; the reference still
+  // computes them for other calendars
+  weekOfYearNonIso: true,
+  // the reference mis-parses ICU's Chinese/Dangi leap-month codes on this Node ("Mo1")
+  chineseMonthCodes: true,
+  // era codes: the polyfill uses the spec's 2024 era codes (ce, be, am, ap, ah, shaka, ...); the
+  // reference returns undefined or ICU's names (gregory)
+  eraCodes: true,
+  // the reference throws on coptic/ethiopic dates on this Node's ICU
+  referenceThrows: true,
+  // the reference accepts time strings that are ambiguous with a MonthDay/YearMonth ("11-17")
+  ambiguousTimeStrings: true,
+  // the reference lets `offset: "ignore"` override a `Z` designator (the spec reads Z as exact)
+  zWithOffsetIgnore: true,
+  // the reference still accepts PlainYearMonth.add with units below months (spec: RangeError)
+  yearMonthLowerUnits: true,
+  // ICU switches to the Julian calendar before 1582 and the umalqura table covers 1882–2077; the
+  // non-ISO calendar field comparisons stay inside 1650–2047 (arithmetic of up to 30 years), the
+  // year-month/month-day parses with a non-ISO calendar inside 1600–2077
+  calendarRange: true,
+  // the spec dropped the `islamic` and `islamic-rgsa` calendar ids in 2025 (the polyfill rejects
+  // them); the reference still accepts them
+  retiredCalendarIds: true,
+  // calendar ids are ASCII case-insensitive; the reference rejects "2020-09[u-ca=ISO8601]" and
+  // "09-22[u-ca=ISO8601]" (test262 argument-string-calendar-case-insensitive)
+  calendarIdCase: true,
+  // the reference still applies `overflow: "reject"` to the end-of-month intermediate date of a
+  // PlainYearMonth subtraction (test262 subtract/overflow: the option has no effect in ISO 8601)
+  yearMonthRejectOverflow: true,
+  // the reference accepts a UTC offset with mixed separators ("-0145:32", "-01:4532"); the
+  // grammar requires all-extended or all-basic
+  mixedOffsetSeparators: true,
+};
+
+/** Does the string carry a shape a known bug or oracle limit covers, for this type's parser? */
+function parseSkip(type, s) {
+  if (Known.bracketSubMinuteOffset && /\[!?[+-]\d\d:?\d\d:/.test(s)) return "bracket-sub-minute";
+  if (OracleLimits.calendarRange && (type === "PlainYearMonth" || type === "PlainMonthDay") && /\[!?u-ca=(?!iso8601\])/i.test(s)) {
+    const m = s.match(/^([+-]?\d{4,6})-?\d\d/);
+    if (m && !(Number(m[1]) >= 1600 && Number(m[1]) <= 2077)) return "calendar-range";
+  }
+  if (Known.timeZoneAfterAnnotation && /\]\[!?[^\]=]*\]/.test(s)) return "time-zone-after-annotation";
+  if (OracleLimits.mixedOffsetSeparators && /[+-]\d{4}:\d\d|[+-]\d\d:\d{4}/.test(s.replace(/\[.*$/, ""))) return "mixed-offset-separators";
+  if (Known.offsetHourTooLarge && /[Tt ]\d\d:?\d\d(:?\d\d([.,]\d+)?)?[+-](2[4-9]|[3-9]\d|\d\d:?6\d)/.test(s)) return "offset-hour";
+  if (OracleLimits.retiredCalendarIds && /\[!?u-ca=islamic(-rgsa)?\]/i.test(s)) return "retired-calendar-id";
+  if (OracleLimits.referenceThrows && (type === "PlainYearMonth" || type === "PlainMonthDay") && /\[!?u-ca=(coptic|ethiopic)\]/i.test(s)) return "reference-throws-calendar";
+  if (OracleLimits.calendarIdCase && (type === "PlainYearMonth" || type === "PlainMonthDay") && /\[!?u-ca=iso8601\]/i.test(s) && !/\[!?u-ca=iso8601\]/.test(s)) return "calendar-id-case";
+  if (type === "PlainTime") {
+    if (Known.plainTimeCalendar && /\[!?u-ca=(?!iso8601\])/i.test(s)) return "plain-time-calendar";
+    if (Known.plainTimeInvalidDate && /^[+-]?\d{4,6}-?\d\d-?\d\d[Tt ]/.test(s) && !validDatePart(s)) return "plain-time-invalid-date";
+    if (OracleLimits.ambiguousTimeStrings && /^(--)?\d\d-?\d\d(\[|$)/.test(s.split(/[Tt ]/)[0]) && !/[Tt]/.test(s)) return "ambiguous-time";
+  }
+  return null;
+}
+
+function validDatePart(s) {
+  const m = s.match(/^([+-]?\d{4,6})-?(\d\d)-?(\d\d)/);
+  if (!m) return true;
+  try {
+    O.PlainDate.from(`${m[1]}-${m[2]}-${m[3]}`, { overflow: "reject" });
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+// ---------------------------------------------------------------------------------------------
+// Comparing the two implementations
+
+function describe(x) {
+  if (x === undefined) return "undefined";
+  if (typeof x === "bigint") return `${x}n`;
+  if (typeof x !== "object" || x === null) return String(x);
+  if (x instanceof T.Duration || x instanceof O.Duration) {
+    return `Duration(${UNITS.map((u) => `${u}=${x[u]}`).join(" ")} sign=${x.sign} blank=${x.blank})`;
+  }
+  if (typeof x.toString === "function" && (x.constructor?.name in T)) return `${x.constructor.name}(${x.toString()})`;
+  if (Array.isArray(x)) return `[${x.map(describe).join(", ")}]`;
+  return JSON.stringify(x, (k, v) => (typeof v === "bigint" ? `${v}n` : v));
+}
+
+function run(f, Impl) {
+  try {
+    return describe(f(Impl));
+  } catch (e) {
+    if (!(e instanceof Error)) return `THROW ${String(e)}`;
+    return `THROW ${e.constructor.name}`;
+  }
+}
+
+/** Run `f` in both implementations; fail with `what` if they disagree. */
+function same(what, f) {
+  const a = run(f, T);
+  const b = run(f, O);
+  if (a !== b) fail(`${what}\n  polyfill:  ${a}\n  reference: ${b}`);
+  return a;
+}
+
+const UNITS = ["years", "months", "weeks", "days", "hours", "minutes", "seconds", "milliseconds", "microseconds", "nanoseconds"];
+const SINGULAR = { years: "year", months: "month", weeks: "week", days: "day", hours: "hour", minutes: "minute", seconds: "second", milliseconds: "millisecond", microseconds: "microsecond", nanoseconds: "nanosecond" };
+const ROUNDING_MODES = ["ceil", "floor", "expand", "trunc", "halfCeil", "halfFloor", "halfExpand", "halfTrunc", "halfEven"];
+const TIME_ZONES = ["UTC", "America/New_York", "Europe/London", "Asia/Kolkata", "Australia/Lord_Howe", "Pacific/Apia", "America/Sao_Paulo", "Asia/Tokyo", "+05:30", "-03:00", "+00:00"];
+const CALENDARS = ["iso8601", "gregory", "hebrew", "islamic-umalqura", "japanese", "persian", "buddhist", "indian", "coptic", "ethiopic", "roc"];
+
+// ---------------------------------------------------------------------------------------------
+// Generators
+
+function pad(x, w) {
+  return String(x).padStart(w, "0");
+}
+
+/** A year: mostly modern, sometimes at the ends of the supported range or negative. */
+function genYear(tc) {
+  const r = n(tc, 0, 99);
+  if (r < 70) return n(tc, 1900, 2100);
+  if (r < 85) return n(tc, 1, 9999);
+  if (r < 92) return n(tc, -9999, 0);
+  if (r < 96) return n(tc, -271821, -271000);
+  return n(tc, 275000, 275760);
+}
+
+/** An ISO date as fields (day may overflow the month: the parse/from options decide). */
+function genDateFields(tc, { valid = true } = {}) {
+  const year = genYear(tc);
+  const month = valid ? n(tc, 1, 12) : pick(tc, [n(tc, 1, 12), 0, 13]);
+  const day = valid ? n(tc, 1, 28) : pick(tc, [n(tc, 1, 28), 29, 30, 31, 0, 32]);
+  return { year, month, day };
+}
+
+function genTimeFields(tc) {
+  const r = n(tc, 0, 99);
+  const t = { hour: n(tc, 0, 23), minute: n(tc, 0, 59), second: n(tc, 0, 59), millisecond: 0, microsecond: 0, nanosecond: 0 };
+  if (r < 30) return t;
+  t.millisecond = n(tc, 0, 999);
+  if (r < 60) return t;
+  t.microsecond = n(tc, 0, 999);
+  t.nanosecond = n(tc, 0, 999);
+  if (r < 90) return t;
+  return { hour: pick(tc, [0, 23]), minute: pick(tc, [0, 59]), second: pick(tc, [0, 59]), millisecond: 999, microsecond: 999, nanosecond: 999 };
+}
+
+/** A PlainDate string (ISO, days constrained) built through the reference. */
+function dateString(f) {
+  return O.PlainDate.from(f, { overflow: "constrain" }).toString();
+}
+
+function timeString(t) {
+  return O.PlainTime.from(t).toString();
+}
+
+/** A Duration property bag: a few units, all of one sign, sometimes large. */
+function genDurationFields(tc, { dateUnits = true, big = true } = {}) {
+  const d = {};
+  const units = dateUnits ? UNITS : UNITS.slice(4);
+  const k = n(tc, 1, 3);
+  const sign = chance(tc, 25) ? -1 : 1;
+  for (let i = 0; i < k; i++) {
+    const u = pick(tc, units);
+    const r = n(tc, 0, 99);
+    let v;
+    if (r < 60) v = n(tc, 0, 5);
+    else if (r < 85) v = n(tc, 0, 400);
+    else if (big) v = n(tc, 0, 1e6);
+    else v = n(tc, 0, 1000);
+    d[u] = sign * v;
+  }
+  return d;
+}
+
+/** An ISO-8601-ish string for the parsers: mostly valid, with documented variants and mutations. */
+function genIsoString(tc) {
+  const f = genDateFields(tc, { valid: chance(tc, 85) });
+  const parts = [];
+  // date
+  let y;
+  if (f.year < 0 || f.year > 9999 || chance(tc, 5)) y = (f.year < 0 ? "-" : "+") + pad(Math.abs(f.year), 6);
+  else y = pad(f.year, 4);
+  if (chance(tc, 3)) y = "-000000";
+  const sep = chance(tc, 85) ? "-" : "";
+  let s = `${y}${sep}${pad(f.month, 2)}${sep}${pad(f.day, 2)}`;
+  const r = n(tc, 0, 99);
+  if (r < 8) s = `${sep ? "" : ""}${pad(f.month, 2)}-${pad(f.day, 2)}`; // month-day
+  else if (r < 16) s = `${y}-${pad(f.month, 2)}`; // year-month
+  else if (r < 20) s = `--${pad(f.month, 2)}-${pad(f.day, 2)}`;
+  parts.push(s);
+  // time
+  if (chance(tc, 60)) {
+    const t = genTimeFields(tc);
+    let ts = `${pad(t.hour, 2)}:${pad(t.minute, 2)}`;
+    if (chance(tc, 70)) ts += `:${pad(t.second, 2)}`;
+    if (chance(tc, 40)) {
+      const frac = `${pad(t.millisecond, 3)}${pad(t.microsecond, 3)}${pad(t.nanosecond, 3)}`.slice(0, n(tc, 1, 9));
+      ts += pick(tc, [".", ","]) + frac;
+    }
+    if (chance(tc, 10)) ts = ts.replace(/:/g, "");
+    if (chance(tc, 3)) ts = "24:00";
+    parts.push(pick(tc, ["T", "t", " "]) + ts);
+    // offset
+    const o = n(tc, 0, 99);
+    if (o < 30) parts.push(pick(tc, ["Z", "z"]));
+    else if (o < 60) {
+      const sign = pick(tc, ["+", "-"]);
+      const oh = n(tc, 0, 23);
+      const om = pick(tc, [0, 30, 45, n(tc, 0, 59)]);
+      let os = `${sign}${pad(oh, 2)}:${pad(om, 2)}`;
+      if (chance(tc, 20)) os = os.replace(":", "");
+      if (chance(tc, 15)) os = `${sign}${pad(oh, 2)}`;
+      if (chance(tc, 10)) os += `:${pad(n(tc, 0, 59), 2)}${chance(tc, 50) ? "." + pad(n(tc, 0, 999), 3) : ""}`;
+      if (chance(tc, 5)) os = `${sign}24:00`;
+      parts.push(os);
+    }
+  }
+  // annotations
+  if (chance(tc, 40)) {
+    const crit = chance(tc, 20) ? "!" : "";
+    parts.push(`[${crit}${pick(tc, TIME_ZONES.concat(["Etc/GMT+5", "america/new_york", "Not/AZone", "+05:30:15"]))}]`);
+  }
+  if (chance(tc, 30)) {
+    const crit = chance(tc, 20) ? "!" : "";
+    parts.push(`[${crit}u-ca=${pick(tc, CALENDARS.concat(["ISO8601", "nope", "islamic"]))}]`);
+  }
+  if (chance(tc, 8)) parts.push(`[${chance(tc, 50) ? "!" : ""}${pick(tc, ["foo=bar", "u-ca=iso8601", "x-y=z", "_a=1"])}]`);
+  let out = parts.join("");
+  // mutations
+  const m = n(tc, 0, 99);
+  if (m < 5) out = out.slice(0, n(tc, 0, out.length));
+  else if (m < 8) out = out + pick(tc, [" ", "Z", "T", "-", ":00", "[UTC]", "a"]);
+  else if (m < 11) out = out.toLowerCase();
+  else if (m < 13) out = out.replace(/\d/, pick(tc, ["a", " ", "9"]));
+  return out;
+}
+
+/** A Duration ISO string: through the reference from fields, or a raw spelling. */
+function genDurationString(tc) {
+  const r = n(tc, 0, 99);
+  if (r < 55) return O.Duration.from(genDurationFields(tc)).toString();
+  if (r < 70) {
+    // fractional forms and lower case
+    const unit = pick(tc, ["H", "M", "S"]);
+    const whole = n(tc, 0, 50);
+    const frac = pad(n(tc, 0, 999999999), n(tc, 1, 9)).slice(0, 9);
+    return `${chance(tc, 20) ? "-" : ""}P${chance(tc, 30) ? `${n(tc, 0, 3)}D` : ""}T${whole}${pick(tc, [".", ","])}${frac}${unit}`.replace(/^(-?)P/, chance(tc, 10) ? "$1p" : "$1P");
+  }
