+// Hegel zoo: the generators behind the temporal-polyfill properties, as values built from
+// Hegel's combinators, and the pure functions that render what they draw.
+//
+// A case is a small record (a date as fields, a time as fields, a duration as a map of units,
+// an RFC 9557 string as its parts plus a mutation, an operation with its option bag) drawn once
+// and rendered by pure functions; the reference implementation is never consulted while
+// drawing. The shapes of the recorded bugs (bugs.toml) are drawn like any other, so the
+// properties find the bugs and fail on them; `shaped(known, past)` marks the places whose shape
+// is switched off under HEGEL_NO_KNOWN=1 (`noKnown`), where `past` is the region beside the
+// shape. The last section draws each bug's shape region on its own for the one-bug properties.
+
+import { gs, noKnown } from "./hegel-zoo.mjs";
+
+// ---------------------------------------------------------------- generator helpers
+
+export const ints = (lo, hi) => gs.integers({ minValue: lo, maxValue: hi });
+export const pick = (xs) => gs.sampledFrom(xs);
+
+/** oneOf with weights: `weighted([45, a], [55, b])` draws a 45 times in 100; shrinks towards the first choice. */
+export function weighted(...choices) {
+  if (choices.length === 1) return choices[0][1];
+  const total = choices.reduce((sum, [w]) => sum + w, 0);
+  return ints(0, total - 1).flatMap((r) => {
+    for (const [w, g] of choices) {
+      if (r < w) return g;
+      r -= w;
+    }
+    throw new Error("unreachable");
+  });
+}
+
+/** True pct percent of the time; shrinks to false (the draw shrinks to 0). */
+export const chance = (pct) => ints(0, 99).map((r) => r >= 100 - pct);
+/** A draw from g pct percent of the time, else undefined (listed first: shrinks to absent). */
+export const maybe = (pct, g) => weighted([100 - pct, gs.just(undefined)], [pct, g]);
+/** `known` by default, `past` under HEGEL_NO_KNOWN=1: the region beside a recorded bug's shape. */
+export const shaped = (known, past) => (noKnown ? past : known);
+/** The record without its undefined fields: an option bag from `maybe` fields. */
+export const dropUndefined = (o) => Object.fromEntries(Object.entries(o).filter(([, v]) => v !== undefined));
+/** An option bag: a record of (mostly `maybe`) fields with the absent ones left out. */
+export const options = (fields) => gs.record(fields).map(dropUndefined);
+
+// ---------------------------------------------------------------- vocabularies
+
+export const UNITS = ["years", "months", "weeks", "days", "hours", "minutes", "seconds", "milliseconds", "microseconds", "nanoseconds"];
+export const SINGULAR = { years: "year", months: "month", weeks: "week", days: "day", hours: "hour", minutes: "minute", seconds: "second", milliseconds: "millisecond", microseconds: "microsecond", nanoseconds: "nanosecond" };
+export const SINGULAR_UNITS = UNITS.map((u) => SINGULAR[u]);
+/** The duration units of a time (hours and below). */
+export const TIME_DURATION_UNITS = UNITS.slice(4);
+export const DATE_UNITS = ["year", "month", "week", "day"];
+export const TIME_UNITS = ["hour", "minute", "second", "millisecond", "microsecond", "nanosecond"];
+export const ROUNDING_MODES = ["ceil", "floor", "expand", "trunc", "halfCeil", "halfFloor", "halfExpand", "halfTrunc", "halfEven"];
+export const TIME_ZONES = ["UTC", "America/New_York", "Europe/London", "Asia/Kolkata", "Australia/Lord_Howe", "Pacific/Apia", "America/Sao_Paulo", "Asia/Tokyo", "+05:30", "-03:00", "+00:00"];
+export const CALENDARS = ["iso8601", "gregory", "hebrew", "islamic-umalqura", "japanese", "persian", "buddhist", "indian", "coptic", "ethiopic", "roc"];
+/** The types whose parser discards an offset and a bracketed time zone (the Plain types). */
+export const PLAIN_TYPES = ["PlainDate", "PlainDateTime", "PlainTime", "PlainYearMonth", "PlainMonthDay"];
+/** Every `from` that reads a string. */
+export const PARSERS = [...PLAIN_TYPES, "Instant", "ZonedDateTime", "Duration"];
+
+// ---------------------------------------------------------------- renderers (pure)
+
+export const pad = (x, w) => String(Math.abs(x)).padStart(w, "0");
+/** A year as an ISO string: four digits, or a sign and six digits outside 0-9999 (or when `extended`). */
+export const isoYear = (y, extended = false) => (y < 0 || y > 9999 || extended ? (y < 0 ? "-" : "+") + pad(y, 6) : pad(y, 4));
+/** `{year, month, day}` as an extended (or basic) ISO date. */
+export const isoDate = ({ year, month, day }, sep = "-") => `${isoYear(year)}${sep}${pad(month, 2)}${sep}${pad(day, 2)}`;
+/** Time fields as `HH:MM:SS` with the fraction that is needed (Temporal's `auto` precision). */
+export function isoTime(t) {
+  const frac = `${pad(t.millisecond, 3)}${pad(t.microsecond, 3)}${pad(t.nanosecond, 3)}`.replace(/0+$/, "");
+  return `${pad(t.hour, 2)}:${pad(t.minute, 2)}:${pad(t.second, 2)}${frac ? "." + frac : ""}`;
+}
+export const isoYearMonth = ({ year, month }) => `${isoYear(year)}-${pad(month, 2)}`;
+export const isoMonthDay = ({ month, day }) => `${pad(month, 2)}-${pad(day, 2)}`;
+/** A duration property bag as its ISO 8601 string, the sub-second units folded into the seconds. */
+export function isoDuration(d) {
+  const v = (u) => Math.abs(d[u] ?? 0);
+  const sign = UNITS.some((u) => (d[u] ?? 0) < 0) ? "-" : "";
+  let date = "";
+  for (const [u, letter] of [["years", "Y"], ["months", "M"], ["weeks", "W"], ["days", "D"]]) if (v(u)) date += `${v(u)}${letter}`;
+  let time = "";
+  if (v("hours")) time += `${v("hours")}H`;
+  if (v("minutes")) time += `${v("minutes")}M`;
+  const ns = BigInt(v("seconds")) * 1000000000n + BigInt(v("milliseconds")) * 1000000n + BigInt(v("microseconds")) * 1000n + BigInt(v("nanoseconds"));
+  if (ns > 0n || (date === "" && time === "")) {
+    const frac = String(ns % 1000000000n).padStart(9, "0").replace(/0+$/, "");
+    time += `${ns / 1000000000n}${frac ? "." + frac : ""}S`;
+  }
+  return `${sign}P${date}${time ? "T" + time : ""}`;
+}
+
+// ---------------------------------------------------------------- dates, times, durations, epochs
+
+/** A year every month of which is a valid PlainDate: modern 70% of the time, 1-9999 15, negative 7, and 4 each near the ends of the supported range (-271821-04-19 to 275760-09-13). */
+export const year = weighted([70, ints(1900, 2100)], [15, ints(1, 9999)], [7, ints(-9999, 0)], [4, ints(-271820, -271000)], [4, ints(275000, 275759)]);
+/** A month and a day every month has. */
+export const validDate = gs.record({ year, month: ints(1, 12), day: ints(1, 28) });
+/** A month that may be 0 or 13 (two times in three) and a day that may be 0, 29-31 or 32 (five times in six); the year one of the range's end years one time in five. */
+export const looseMonth = weighted([1, ints(1, 12)], [2, pick([0, 13])]);
+export const looseDay = weighted([1, ints(1, 28)], [5, pick([29, 30, 31, 0, 32])]);
+export const looseDate = gs.record({ year: weighted([4, year], [1, pick([-271821, 275760])]), month: looseMonth, day: looseDay });
+
+const clock = { hour: ints(0, 23), minute: ints(0, 59), second: ints(0, 59) };
+const thousandth = ints(0, 999);
+const zero = gs.just(0);
+/** Time fields: whole seconds 30% of the time, milliseconds 30, nanoseconds 30, and the extremes of every field 10. */
+export const timeFields = weighted(
+  [30, gs.record({ ...clock, millisecond: zero, microsecond: zero, nanosecond: zero })],
+  [30, gs.record({ ...clock, millisecond: thousandth, microsecond: zero, nanosecond: zero })],
+  [30, gs.record({ ...clock, millisecond: thousandth, microsecond: thousandth, nanosecond: thousandth })],
+  [10, gs.record({ hour: pick([0, 23]), minute: pick([0, 59]), second: pick([0, 59]), millisecond: gs.just(999), microsecond: gs.just(999), nanosecond: gs.just(999) })],
+);
+
+/** A unit's magnitude: 0-5 60% of the time, 0-400 25, up to a million (or a thousand when not `big`) 15. */
+const magnitude = (big) => weighted([60, ints(0, 5)], [25, ints(0, 400)], [15, ints(0, big ? 1000000 : 1000)]);
+/** A Duration property bag: one to three distinct `units`, all of one sign (negative 25% of the time). */
+export const durationFields = ({ units = UNITS, big = true } = {}) =>
+  gs.record({ negative: chance(25), parts: gs.maps(pick(units), magnitude(big), { minSize: 1, maxSize: 3 }) })
+    .map(({ negative, parts }) => Object.fromEntries([...parts].map(([u, v]) => [u, negative && v !== 0 ? -v : v])));
+
+const NS_LIMIT = 8640000000000000000000n;
+/** Epoch nanoseconds: a millisecond epoch with a sub-millisecond part 60% of the time, whole seconds across the range 20, the epoch and a day around it 10, the range's limits and one past them 10. */
+export const epochNs = weighted(
+  [60, gs.record({ ms: ints(-2000000000000, 4000000000000), sub: ints(0, 999999) }).map(({ ms, sub }) => BigInt(ms) * 1000000n + BigInt(sub))],
+  [20, ints(-8640000000000, 8640000000000).map((s) => BigInt(s) * 1000000000n)],
+  [10, pick([0n, 1n, -1n, 86400000000000n, -86400000000000n])],
+  [10, pick([NS_LIMIT, -NS_LIMIT, NS_LIMIT + 1n, -NS_LIMIT - 1n])],
+);
+/** The same epochs mirrored onto 1970 and after (the region beside temporal-polyfill/1). */
+export const epochNsSince1970 = epochNs.map((ns) => (ns < 0n ? -ns : ns));
+
+// ---------------------------------------------------------------- option bags
+
+const UNIT_MAX = { hour: 24, minute: 60, second: 60, millisecond: 1000, microsecond: 1000, nanosecond: 1000 };
+const DIVISORS = [1, 2, 4, 5, 10, 20, 100, 200, 250, 500, 3, 6, 12, 15, 30];
+/** A roundingIncrement for `unit`: a proper divisor of the unit's span 70% of the time, else 1, the span itself, 7 or 1000; for a date unit 1, 2, 3 or 7. */
+export function increment(unit) {
+  const max = UNIT_MAX[unit];
+  if (max === undefined) return pick([1, 1, 2, 3, 7]);
+  return weighted([70, pick(DIVISORS.filter((d) => max % d === 0 && d < max))], [30, pick([1, max, 7, 1000])]);
+}
+/** The options of until/since/round over `units`: largestUnit 60% of the time, smallestUnit 60, an increment fit for it 40, a rounding mode 50. */
+export const diffOptions = (units) =>
+  maybe(60, pick(units)).flatMap((smallestUnit) => options({
+    largestUnit: maybe(60, pick([...units, "auto"])),
+    smallestUnit: gs.just(smallestUnit),
+    roundingIncrement: maybe(40, increment(smallestUnit ?? "day")),
+    roundingMode: maybe(50, pick(ROUNDING_MODES)),
+  }));
+export const overflowOption = maybe(50, pick(["constrain", "reject"]));
+/** The toString options of an Instant or PlainTime: a smallest unit, fractional digits and a rounding mode, each present half the time. */
+export const timeStringOptions = options({
+  smallestUnit: maybe(50, pick(["minute", "second", "millisecond", "microsecond", "nanosecond"])),
+  fractionalSecondDigits: maybe(50, pick(["auto", 0, 1, 3, 5, 9])),
+  roundingMode: maybe(50, pick(ROUNDING_MODES)),
+});
+
+// ---------------------------------------------------------------- RFC 9557 strings
+
+/** A UTC offset: extended `+HH:MM` 60% of the time, basic `+HHMM` 20, hours only 15, basic hours and minutes before extended seconds 5 (an oracle limit: the grammar rejects the mixed form); seconds 10%, half of them with a fraction. KNOWN: an hour of 24 or more (6%) or a minute of 60 (3%) is temporal-polyfill/6's shape, not drawn under HEGEL_NO_KNOWN=1. */
+const offset = gs.record({
+  sign: pick(["+", "-"]),
+  hour: shaped(weighted([94, ints(0, 23)], [6, pick([24, 25, 99])]), ints(0, 23)),
+  minute: shaped(weighted([72, pick([0, 30, 45])], [25, ints(0, 59)], [3, gs.just(60)]), weighted([75, pick([0, 30, 45])], [25, ints(0, 59)])),
+  style: weighted([60, gs.just("extended")], [20, gs.just("basic")], [15, gs.just("hour")], [5, gs.just("mixed")]),
+  seconds: maybe(10, gs.record({ second: ints(0, 59), fraction: maybe(50, thousandth) })),
+});
+function renderOffset(o) {
+  const hh = pad(o.hour, 2);
+  const mm = pad(o.minute, 2);
+  const ss = o.seconds ? `${pad(o.seconds.second, 2)}${o.seconds.fraction !== undefined ? "." + pad(o.seconds.fraction, 3) : ""}` : "";
+  if (o.style === "hour") return `${o.sign}${hh}`;
+  if (o.style === "basic") return `${o.sign}${hh}${mm}${ss}`;
+  if (o.style === "mixed") return `${o.sign}${hh}${mm}:${ss || "00"}`;
+  return `${o.sign}${hh}:${mm}${ss ? ":" + ss : ""}`;
+}
+
+/** The time part of a string: fields, seconds 70% of the time, a fraction of 1-9 digits after `.` or `,` 40, basic format 10, `24:00` 3, a `T`/`t`/space designator, and no offset 40%, `Z`/`z` 30, an offset 30. */
+const timePart = gs.record({
+  fields: timeFields,
+  seconds: chance(70),
+  fraction: maybe(40, gs.record({ digits: ints(1, 9), sep: pick([".", ","]) })),
+  basic: chance(10),
+  h24: chance(3),
+  designator: pick(["T", "t", " "]),
+  offset: weighted([40, gs.just(undefined)], [30, pick(["Z", "z"])], [30, offset]),
+});
+function renderTimePart(t) {
+  const f = t.fields;
+  let ts = `${pad(f.hour, 2)}:${pad(f.minute, 2)}`;
+  if (t.seconds) ts += `:${pad(f.second, 2)}`;
+  if (t.fraction) ts += t.fraction.sep + `${pad(f.millisecond, 3)}${pad(f.microsecond, 3)}${pad(f.nanosecond, 3)}`.slice(0, t.fraction.digits);
+  if (t.basic) ts = ts.replace(/:/g, "");
+  if (t.h24) ts = "24:00";
+  const off = t.offset === undefined ? "" : typeof t.offset === "string" ? t.offset : renderOffset(t.offset);
+  return t.designator + ts + off;
+}
+
+export const TZ_IDS = [...TIME_ZONES, "Etc/GMT+5", "america/new_york", "Not/AZone"];
+/** A time zone annotation, critical 20% of the time. KNOWN: the bracketed offset with seconds is temporal-polyfill/5's shape, not in the pool under HEGEL_NO_KNOWN=1. */
+export const tzAnnotation = gs.record({ kind: gs.just("tz"), crit: chance(20), id: pick(shaped([...TZ_IDS, "+05:30:15"], TZ_IDS)) });
+/** A calendar annotation: a known calendar, an upper-case ISO, an unknown one or the retired `islamic`. */
+export const calendarAnnotation = gs.record({ kind: gs.just("calendar"), crit: chance(20), id: pick([...CALENDARS, "ISO8601", "nope", "islamic"]) });
+/** Another `key=value` annotation, critical half the time. */
+export const otherAnnotation = gs.record({ kind: gs.just("other"), crit: chance(50), text: pick(["foo=bar", "u-ca=iso8601", "x-y=z", "_a=1"]) });
+const annotation = weighted([50, tzAnnotation], [35, calendarAnnotation], [15, otherAnnotation]);
+const tzFirst = (xs) => [...xs.filter((a) => a.kind === "tz"), ...xs.filter((a) => a.kind !== "tz")];
+/** 0-3 annotations in the drawn order. KNOWN: a time zone annotation after another annotation is temporal-polyfill/8's shape; under HEGEL_NO_KNOWN=1 the time zone annotations come first. */
+const annotations = shaped(gs.arrays(annotation, { maxSize: 3 }), gs.arrays(annotation, { maxSize: 3 }).map(tzFirst));
+export const renderAnnotation = (a) => `[${a.crit ? "!" : ""}${a.kind === "tz" ? a.id : a.kind === "calendar" ? "u-ca=" + a.id : a.text}]`;
+
+/** A mutation of the finished string: none 87% of the time, a truncation 5, an appended piece 3, lower case 3, a digit replaced 2. */
+const mutation = weighted(
+  [87, gs.just({ kind: "none" })],
+  [5, gs.record({ kind: gs.just("truncate"), at: ints(0, 999) })],
+  [3, gs.record({ kind: gs.just("append"), text: pick([" ", "Z", "T", "-", ":00", "[UTC]", "a"]) })],
+  [3, gs.just({ kind: "lower" })],
+  [2, gs.record({ kind: gs.just("digit"), to: pick(["a", " ", "9"]) })],
+);
+function mutate(s, m) {
+  switch (m.kind) {
+    case "truncate": return s.slice(0, m.at % (s.length + 1));
+    case "append": return s + m.text;
+    case "lower": return s.toLowerCase();
+    case "digit": return s.replace(/\d/, m.to);
+    default: return s;
+  }
+}
+
+/**
+ * An RFC 9557 string for the parsers: a date (valid 85% of the time), its year in four digits
+ * (or six with a sign 5%, or `-000000` 3%), extended or basic (15%) format, as a date 80% of the
+ * time, a month-day 8, a year-month 8 or a `--MM-DD` 4; a time part 60%; annotations; a mutation.
+ */
+export const isoString = gs.record({
+  date: weighted([85, validDate], [15, looseDate]),
+  yearStyle: weighted([92, gs.just("auto")], [5, gs.just("extended")], [3, gs.just("negative-zero")]),
+  basic: chance(15),
+  form: weighted([80, gs.just("date")], [8, gs.just("month-day")], [8, gs.just("year-month")], [4, gs.just("--month-day")]),
+  time: maybe(60, timePart),
+  annotations,
+  mutation,
+}).map(renderIso);
+function renderIso(r) {
+  const sep = r.basic ? "" : "-";
+  const y = r.yearStyle === "negative-zero" ? "-000000" : isoYear(r.date.year, r.yearStyle === "extended");
+  const mm = pad(r.date.month, 2);
+  const dd = pad(r.date.day, 2);
+  const date = { date: `${y}${sep}${mm}${sep}${dd}`, "month-day": `${mm}-${dd}`, "year-month": `${y}-${mm}`, "--month-day": `--${mm}-${dd}` }[r.form];
+  return mutate(date + (r.time ? renderTimePart(r.time) : "") + r.annotations.map(renderAnnotation).join(""), r.mutation);
+}
+
+const RAW_DURATIONS = ["P", "PT", "P1Y2M3W4DT5H6M7S", "PT1.5H30M", "P1W1D", "PT0S", "P0D", "-PT0S", "+P1D", "P1DT", "P1.5D", "PT36H", "P1Y-2M", "P1M1W", "PT1H1.5M", "P99999999999Y", "PT1S1M", "P1YT", "T1S", "P1DT24H", "PT00S", "PT1e3S", "P\u{2212}1D"];
+/** A Duration string: the ISO form of a property bag 55% of the time, a fractional time unit (with days 30%, lower-case `p` 10%) 15, a raw spelling 30. */
+export const durationString = weighted(
+  [55, durationFields().map(isoDuration)],
+  [15, gs.record({ negative: chance(20), days: maybe(30, ints(0, 3)), whole: ints(0, 50), sep: pick([".", ","]), digits: ints(1, 9), frac: ints(0, 999999999), unit: pick(["H", "M", "S"]), lower: chance(10) })
+    .map((d) => `${d.negative ? "-" : ""}${d.lower ? "p" : "P"}${d.days !== undefined ? d.days + "D" : ""}T${d.whole}${d.sep}${pad(d.frac, d.digits).slice(0, 9)}${d.unit}`)],
+  [30, pick(RAW_DURATIONS)],
+);
+
+/** The parse case: a date-time string 80% of the time, a duration string 20, and the options every parser may get. */
+export const parseCase = gs.record({
+  text: weighted([80, isoString], [20, durationString]),
+  options: options({
+    overflow: maybe(30, pick(["constrain", "reject"])),
+    disambiguation: maybe(50, pick(["compatible", "earlier", "later", "reject"])),
+    offset: maybe(50, pick(["use", "prefer", "ignore", "reject"])),
+  }),
+});
+
+// ---------------------------------------------------------------- the cases of the other properties
+
+/** A `with` bag for a PlainDate/PlainDateTime: year, month, day half the time each, a monthCode (`M00`-`M13`, `L` 10%) 30%, an hour 0-24 20%; `{day: 1}` when nothing was drawn. */
+const withFields = options({
+  year: maybe(50, year),
+  month: maybe(50, looseMonth),
+  monthCode: maybe(30, gs.record({ m: ints(0, 13), leap: chance(10) }).map(({ m, leap }) => `M${pad(m, 2)}${leap ? "L" : ""}`)),
+  day: maybe(50, looseDay),
+  hour: maybe(20, ints(0, 24)),
+}).map((w) => (Object.keys(w).length === 0 ? { day: 1 } : w));
+
+/** The PlainDate/PlainDateTime case: two dates and times, a duration, an overflow, the largest unit of the round-trip law, and one of six operations. */
+export const dateArithmeticCase = gs.record({
+  a: validDate,
+  b: validDate,
+  ta: timeFields,
+  tb: timeFields,
+  dur: durationFields(),
+  overflow: pick([undefined, "constrain", "reject"]),
+  largestUnit: pick(DATE_UNITS),
+  op: gs.oneOf(
+    gs.just({ kind: "date-add" }),
+    gs.record({ kind: gs.just("date-until"), options: diffOptions(DATE_UNITS) }),
+    gs.just({ kind: "datetime-add" }),
+    gs.record({ kind: gs.just("datetime-until"), options: diffOptions([...DATE_UNITS, ...TIME_UNITS]) }),
+    pick(["day", ...TIME_UNITS]).flatMap((unit) => gs.record({
