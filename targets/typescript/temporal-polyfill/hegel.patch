+      same(`PlainMonthDay(${mdStr}).with({day: ${day}}, ${show(oo)})`, (I) => I.PlainMonthDay.from(mdStr).with({ day }, oo));
+      same(`PlainDate(${isoDate(f)}).toPlainYearMonth/MonthDay`, (I) => {
+        const x = I.PlainDate.from(isoDate(f));
+        return [x.toPlainYearMonth(), x.toPlainMonthDay(), x.toPlainDateTime(t), x.toZonedDateTime({ timeZone: "UTC", plainTime: t })];
+      });
+      break;
+    }
+    default:
+      throw new Error(`unknown op ${op.kind}`);
+  }
+});
+
+// ---------------------------------------------------------------------------------------------
+// Calendar fields
+
+/** The polyfill alone: the date's fields rebuild it, in its calendar, through every bag and through its year-month and month-day. */
+function checkCalendarLaws(iso, cal) {
+  const x = T.PlainDate.from(iso).withCalendar(cal);
+  const bags = [
+    { calendar: cal, year: x.year, month: x.month, day: x.day },
+    { calendar: cal, year: x.year, monthCode: x.monthCode, day: x.day },
+    ...(x.era === undefined ? [] : [{ calendar: cal, era: x.era, eraYear: x.eraYear, monthCode: x.monthCode, day: x.day }]),
+  ];
+  for (const bag of bags) {
+    const back = T.PlainDate.from(bag);
+    if (!back.equals(x)) fail(`PlainDate(${iso}).withCalendar(${cal}) is ${x}, but PlainDate.from(${show(bag)}) is ${back}`);
+  }
+  const viaYearMonth = x.toPlainYearMonth().toPlainDate({ day: x.day });
+  if (!viaYearMonth.equals(x)) fail(`PlainDate(${iso}).withCalendar(${cal}).toPlainYearMonth().toPlainDate({day: ${x.day}}) is ${viaYearMonth}, not ${x}`);
+  const viaMonthDay = x.toPlainMonthDay().toPlainDate({ year: x.year });
+  if (!viaMonthDay.equals(x)) fail(`PlainDate(${iso}).withCalendar(${cal}).toPlainMonthDay().toPlainDate({year: ${x.year}}) is ${viaMonthDay}, not ${x}`);
+}
+
+property("TestHegelCalendarFieldsLikeTheReference", (tc) => {
+  const { calendar: cal, date, dur, overflow, date2, largestUnit, w } = tc.draw(gen.calendarCase);
+  const iso = isoDate(date);
+  const oo = overflow === undefined ? undefined : { overflow };
+  count(cal);
+  checkCalendarLaws(iso, cal);
+  if (OracleLimits.referenceThrows && run((I) => I.PlainDate.from(iso).withCalendar(cal).year, O).startsWith("THROW")) {
+    // the reference cannot compute this date (coptic/ethiopic on this ICU): the laws above are the verdict
+    count(`oracle-throws ${cal}`);
+    return;
+  }
+  const fields = (x) => {
+    const out = [x.calendarId, x.year, x.month, x.monthCode, x.day, x.dayOfWeek, x.dayOfYear, x.daysInWeek, x.daysInMonth, x.daysInYear, x.monthsInYear, x.inLeapYear];
+    if (cal === "iso8601" || !OracleLimits.eraCodes) out.push(x.era, x.eraYear);
+    if (cal === "iso8601" || !OracleLimits.weekOfYearNonIso) out.push(x.weekOfYear, x.yearOfWeek);
+    return out;
+  };
+  same(`PlainDate(${iso}).withCalendar(${cal}) fields`, (I) => fields(I.PlainDate.from(iso).withCalendar(cal)));
+  // the fields rebuild the date, in that calendar and back in ISO
+  same(`PlainDate(${iso}).withCalendar(${cal}) round trip through fields`, (I) => {
+    const x = I.PlainDate.from(iso).withCalendar(cal);
+    const bag = { calendar: cal, year: x.year, month: x.month, day: x.day };
+    const byCode = { calendar: cal, year: x.year, monthCode: x.monthCode, day: x.day };
+    const byEra = x.era !== undefined ? { calendar: cal, era: x.era, eraYear: x.eraYear, monthCode: x.monthCode, day: x.day } : bag;
+    return [I.PlainDate.from(bag).withCalendar("iso8601"), I.PlainDate.from(byCode).toString(), I.PlainDate.from(byEra).toString(), x.toPlainYearMonth().toString(), x.toPlainMonthDay().toString()];
+  });
+  // arithmetic in the calendar
+  same(`PlainDate(${iso}).withCalendar(${cal}).add(${show(dur)}, ${show(oo)})`, (I) => I.PlainDate.from(iso).withCalendar(cal).add(dur, oo).toString());
+  const iso2 = isoDate(date2);
+  same(`PlainDate(${iso}).withCalendar(${cal}).until(${iso2}, {largestUnit: ${largestUnit}})`, (I) => I.PlainDate.from(iso).withCalendar(cal).until(I.PlainDate.from(iso2).withCalendar(cal), { largestUnit }), tc, leapMonthUntilShapes(cal, iso, iso2, largestUnit));
+  same(`PlainDate(${iso}).withCalendar(${cal}).with(${show(w)}, ${show(oo)})`, (I) => I.PlainDate.from(iso).withCalendar(cal).with(w, oo).toString());
+});
+
+// ---------------------------------------------------------------------------------------------
+// One property per recorded bug: the wide properties above reach the recorded shapes at their
+// natural rates; these draw one bug's shape region with random contents around it (gen.mjs,
+// last section) and check it with the same oracle (the reference, or the specification where
+// the reference is wrong, as the pins do), so every bug has a property that finds it in every
+// run. Under HEGEL_NO_KNOWN=1 each draws the region beside the shape and passes.
+
+// temporal-polyfill/1: a directional rounding of an Instant before 1970 (toString, round,
+// ZonedDateTime.toString) rounds toward the past like the reference
+property("TestHegelPreEpochInstantsRoundTowardThePast", (tc) => {
+  const { ns, op } = tc.draw(gen.preEpochRoundingCase);
+  if (op.kind === "toString") same(`Instant(${ns}).toString(${show(op.options)})`, (I) => new I.Instant(ns).toString(op.options));
+  else if (op.kind === "round") same(`Instant(${ns}).round(${show(op.options)})`, (I) => new I.Instant(ns).round(op.options));
+  else same(`Instant(${ns}).toZonedDateTimeISO(${op.tz}).toString(${show(op.options)})`, (I) => new I.Instant(ns).toZonedDateTimeISO(op.tz).toString(op.options));
+});
+
+// temporal-polyfill/2: PlainTime.from of a date-time string whose date part is invalid
+property("TestHegelPlainTimeRejectsInvalidDateParts", (tc) => {
+  const { date, time, designator, basic } = tc.draw(gen.invalidDatePartTimeCase);
+  const text = `${isoDate(date, basic ? "" : "-")}${designator}${basic ? isoTime(time).replace(/:/g, "") : isoTime(time)}`;
+  same(`PlainTime.from(${show(text)})`, (I) => I.PlainTime.from(text));
+});
+
+// temporal-polyfill/3: PlainTime.from of a date-time string with a calendar annotation that is not iso8601
+property("TestHegelPlainTimeIgnoresCalendarAnnotations", (tc) => {
+  const { date, time, calendar, crit, designator } = tc.draw(gen.calendarAnnotatedTimeCase);
+  const text = `${isoDate(date)}${designator}${isoTime(time)}[${crit ? "!" : ""}u-ca=${calendar}]`;
+  same(`PlainTime.from(${show(text)})`, (I) => I.PlainTime.from(text));
+});
+
+// temporal-polyfill/4: PlainYearMonth.add/subtract of a duration with a year or month part and
+// a nonzero unit below months: the specification throws (the reference accepts, so the polyfill
+// is judged by the specification); beside the shape (years and months only) both agree
+property("TestHegelYearMonthArithmeticRejectsUnitsBelowMonths", (tc) => {
+  const { ym, dur, op, overflow } = tc.draw(gen.yearMonthLowerUnitsCase);
+  const ymStr = isoYearMonth(ym);
+  const oo = overflow === undefined ? undefined : { overflow };
+  const what = `PlainYearMonth(${ymStr}).${op}(${show(dur)}, ${show(oo)})`;
+  if (UNITS.slice(2).some((u) => dur[u])) {
+    spec(what, (I) => I.PlainYearMonth.from(ymStr)[op](dur, oo), "THROW RangeError", "PlainYearMonth arithmetic rejects a duration with a nonzero unit below months (test262 PlainYearMonth/prototype/add/argument-lower-units)");
+  } else {
+    same(what, (I) => I.PlainYearMonth.from(ymStr)[op](dur, yearMonthOverflow(oo, I)));
+  }
+});
+
+// temporal-polyfill/5: a bracketed UTC offset with seconds is not a time zone (the grammar is
+// UTCOffset[~SubMinutePrecision]) for any Plain type's parser
+property("TestHegelBracketedOffsetsWithSecondsAreRejected", (tc) => {
+  const { date, time, type, crit, basic, offset } = tc.draw(gen.bracketedOffsetCase);
+  const sep = basic ? "" : ":";
+  const bracket = `[${crit ? "!" : ""}${offset.sign}${pad(offset.hour, 2)}${sep}${pad(offset.minute, 2)}${offset.second === undefined ? "" : sep + pad(offset.second, 2)}]`;
+  const text = `${isoDate(date)}${time === undefined ? "" : "T" + isoTime(time)}${bracket}`;
+  same(`${type}.from(${show(text)})`, (I) => I[type].from(text));
+});
+
+// temporal-polyfill/6: a UTC offset with an hour above 23 or a minute above 59 is rejected by
+// every Plain type's parser
+property("TestHegelOffsetsBeyondTheGrammarAreRejected", (tc) => {
+  const { date, time, type, sign, basic, offset } = tc.draw(gen.offsetHourCase);
+  const text = `${isoDate(date)}T${isoTime(time)}${sign}${pad(offset.hour, 2)}${basic ? "" : ":"}${pad(offset.minute, 2)}`;
+  same(`${type}.from(${show(text)})`, (I) => I[type].from(text));
+});
+
+// temporal-polyfill/7: a negative duration whose units all lie below the unit toString rounds
+// to prints as the zero duration, without a sign
+property("TestHegelDurationsThatRoundToZeroPrintWithoutASign", (tc) => {
+  const { dur, options } = tc.draw(gen.zeroRoundedDurationCase);
+  same(`Duration(${show(dur)}).toString(${show(options)})`, (I) => I.Duration.from(dur).toString(options));
+});
+
+// temporal-polyfill/8: a time zone annotation after another annotation is a syntax error
+// (Annotations ::: TimeZoneAnnotation? Annotation*) for every parser
+property("TestHegelTimeZoneAnnotationsComeBeforeOtherAnnotations", (tc) => {
+  const { date, time, type, other, tz, order } = tc.draw(gen.annotationOrderCase);
+  const annotations = order === "tz-last" ? [other, tz] : [tz, other];
+  const text = `${isoDate(date)}${time === undefined ? "" : "T" + isoTime(time.fields) + (time.z ? "Z" : "")}${annotations.map(renderAnnotation).join("")}`;
+  same(`${type}.from(${show(text)})`, (I) => I[type].from(text));
+});
+
+// temporal-polyfill/9: until/since with largestUnit "year" from Adar I (M05L) of a Hebrew leap
+// year to a later day of Shevat (M05) of an earlier common year: the specification's
+// NonISODateUntil takes the largest number of years whose constrained intermediate date (M05L
+// becomes M06 in a common year) does not surpass the target, so the years are whole and no
+// twelve months remain; beside the shape (Tevet or Adar as the end month) both agree
+property("TestHegelYearsUntilAnEarlierShevatFromAdarIAreWhole", (tc) => {
+  const { type, op, start, end, time } = tc.draw(gen.leapMonthUntilCase);
+  const build = (I, d) => {
+    const date = I.PlainDate.from({ ...d, calendar: "hebrew" });
+    if (type === "PlainDate") return date;
+    const dateTime = date.toPlainDateTime(I.PlainTime.from(time));
+    return type === "PlainDateTime" ? dateTime : dateTime.toZonedDateTime("UTC");
+  };
+  same(`${type}(${show(start)}).${op}(${show(end)}, {largestUnit: year})`, (I) => build(I, start)[op](build(I, end), { largestUnit: "year" }).toString());
+});
+
+// ---------------------------------------------------------------------------------------------
+// Pins for the known bugs (each asserts the specification's answer).
+
+pin("TestHegelPinNegativeInstantRoundsTowardThePast", () => {
+  // temporal-polyfill/1: "rounding down is towards the Big Bang, not the epoch"
+  assert.equal(new T.Instant(-34959986330n).toString({ smallestUnit: "second" }), "1969-12-31T23:59:25Z");
+  assert.equal(new T.Instant(-1500500000n).toString({ smallestUnit: "millisecond", roundingMode: "trunc" }), "1969-12-31T23:59:58.499Z");
+  assert.equal(new T.Instant(-34959986330n).round({ smallestUnit: "second", roundingMode: "trunc" }).toString(), "1969-12-31T23:59:25Z");
+  assert.equal(T.ZonedDateTime.from("1960-12-31T23:59:25.5[UTC]").toString({ smallestUnit: "second", roundingMode: "trunc" }), "1960-12-31T23:59:25+00:00[UTC]");
+});
+
+pin("TestHegelPinPlainTimeRejectsAnInvalidDatePart", () => {
+  // temporal-polyfill/2
+  assert.throws(() => T.PlainTime.from("2011-02-30T13:12:50"), RangeError);
+  assert.throws(() => T.PlainTime.from("2011-00-09T13:12:50"), RangeError);
+});
+
+pin("TestHegelPinPlainTimeIgnoresTheCalendarAnnotation", () => {
+  // temporal-polyfill/3
+  assert.equal(T.PlainTime.from("2048-10-24T02:08[u-ca=persian]").toString(), "02:08:00");
+  assert.equal(T.PlainTime.from("T02:08[u-ca=discord]").toString(), "02:08:00");
+});
+
+pin("TestHegelPinYearMonthRejectsUnitsBelowMonths", () => {
+  // temporal-polyfill/4
+  assert.throws(() => T.PlainYearMonth.from("2040-09").add({ months: 1, days: 1 }), RangeError);
+  assert.throws(() => T.PlainYearMonth.from("2040-09").subtract({ months: 1, days: 1 }), RangeError);
+  assert.throws(() => T.PlainYearMonth.from("2040-09").add({ years: 1, hours: 1 }), RangeError);
+});
+
+pin("TestHegelPinBracketedOffsetHasNoSeconds", () => {
+  // temporal-polyfill/5
+  assert.throws(() => T.PlainDate.from("2052-11-23[+05:30:15]"), RangeError);
+  assert.throws(() => T.PlainDateTime.from("2052-11-23T00:00[+05:30:15]"), RangeError);
+  assert.throws(() => T.Instant.from("2052-11-23T00:00Z[+05:30:15]"), RangeError);
+});
+
+pin("TestHegelPinOffsetHourIsAtMost23", () => {
+  // a UTC offset's hour is 00-23 and its minute 00-59 (the reference rejects all four strings)
+  for (const s of ["1969-10-20T01:51:57+24:00", "1969-10-20T01:51:57-24:00", "1969-10-20T01:51:57+25:00", "1969-10-20T01:51:57+23:60"]) {
+    for (const type of ["PlainDate", "PlainDateTime", "PlainYearMonth", "PlainMonthDay"]) {
+      assert.throws(() => T[type].from(s), RangeError, `${type}.from(${JSON.stringify(s)})`);
+    }
+  }
+});
+
+pin("TestHegelPinZeroDurationHasNoSign", () => {
+  // temporal-polyfill/7
+  assert.equal(T.Duration.from({ nanoseconds: -5 }).toString({ smallestUnit: "millisecond" }), "PT0.000S");
+  assert.equal(T.Duration.from({ milliseconds: -5 }).toString({ fractionalSecondDigits: 0 }), "PT0S");
+  assert.equal(T.Duration.from({ nanoseconds: -5 }).toString({ smallestUnit: "second" }), "PT0S");
+});
+
+pin("TestHegelPinTimeZoneAnnotationComesFirst", () => {
+  // temporal-polyfill/8: Annotations ::: TimeZoneAnnotation? Annotation* - "[UTC]" is not an
+  // Annotation (no key=value), so it may only come directly after the date-time
+  for (const type of ["PlainDate", "PlainDateTime", "PlainTime", "PlainYearMonth", "PlainMonthDay", "ZonedDateTime"]) {
+    assert.throws(() => T[type].from("2059-07-23T15:46:00[u-ca=iso8601][UTC]"), RangeError, `${type}.from(...[u-ca=iso8601][UTC])`);
+    assert.throws(() => T[type].from("2059-07-23T15:46:00[foo=bar][+01:00]"), RangeError, `${type}.from(...[foo=bar][+01:00])`);
+  }
+  assert.throws(() => T.Instant.from("2059-07-23T15:46:00Z[foo=bar][UTC]"), RangeError);
+});
+
+pin("TestHegelPinUntilFromAdarIToAnEarlierShevatCountsWholeYears", () => {
+  // temporal-polyfill/9: NonISODateUntil (proposal-intl-era-monthcode) takes the largest number of
+  // years whose intermediate (Adar I constrained to Adar in the common year 5360) does not
+  // surpass the target: 50 years and 15 days, not 49 years and 12 months
+  const a = T.PlainDate.from("1650-02-02").withCalendar("hebrew"); // 5410 M05L 1
+  const b = T.PlainDate.from("1600-02-01").withCalendar("hebrew"); // 5360 M05 16
+  assert.equal(a.until(b, { largestUnit: "year" }).toString(), "-P50Y15D");
+  assert.equal(a.since(b, { largestUnit: "year" }).toString(), "P50Y15D");
+  const c = T.PlainDate.from({ year: 5784, monthCode: "M05L", day: 10, calendar: "hebrew" });
+  const d = T.PlainDate.from({ year: 5783, monthCode: "M05", day: 20, calendar: "hebrew" });
+  assert.equal(c.until(d, { largestUnit: "year" }).toString(), "-P1Y20D");
+});
