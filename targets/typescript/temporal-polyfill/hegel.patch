+      options: options({ smallestUnit: gs.just(unit), roundingIncrement: maybe(60, increment(unit)), roundingMode: maybe(60, pick(ROUNDING_MODES)) }),
+      asUnit: chance(20),
+    })),
+    gs.record({ kind: gs.just("with"), fields: withFields, calendarName: pick(["auto", "always", "never", "critical"]) }),
+  ),
+});
+
+/** A relativeTo: none half the time, a date a quarter, a zoned date-time a quarter. */
+const relativeTo = weighted(
+  [50, gs.just(undefined)],
+  [25, validDate.map((d) => isoDate(d))],
+  [25, gs.record({ date: validDate, time: timeFields, tz: pick(TIME_ZONES) }).map(({ date, time, tz }) => `${isoDate(date)}T${isoTime(time)}[${tz}]`)],
+);
+/** The Duration case: a duration, a relativeTo, and one of six operations (with their own second operands). */
+export const durationCase = gs.record({
+  d: durationFields(),
+  relativeTo,
+  op: gs.oneOf(
+    gs.record({ kind: gs.just("unary"), d2: durationFields() }),
+    gs.record({ kind: gs.just("compare"), d2: durationFields() }),
+    gs.record({ kind: gs.just("add"), t1: durationFields({ units: TIME_DURATION_UNITS }), t2: durationFields({ units: TIME_DURATION_UNITS }) }),
+    gs.record({ kind: gs.just("total"), unit: pick(SINGULAR_UNITS) }),
+    gs.record({
+      kind: gs.just("toString"),
+      options: options({
+        smallestUnit: maybe(50, pick(["second", "millisecond", "microsecond", "nanosecond", "minute"])),
+        fractionalSecondDigits: maybe(50, pick(["auto", 0, 1, 3, 5, 9, 10, -1])),
+        roundingMode: maybe(50, pick(ROUNDING_MODES)),
+      }),
+    }),
+    gs.record({ kind: gs.just("round"), options: diffOptions(SINGULAR_UNITS) }),
+  ),
+});
+
+/** The Instant case: one of five operations, each with its epochs. KNOWN: rounding an Instant before 1970 (round, toString) is temporal-polyfill/1's shape; under HEGEL_NO_KNOWN=1 those two draw epochs since 1970. */
+export const instantCase = gs.oneOf(
+  gs.record({ kind: gs.just("epoch"), ns: epochNs, ns2: epochNs, ms: ints(-8640000000000000, 8640000000000000), tz: pick(TIME_ZONES) }),
+  gs.record({ kind: gs.just("add"), ns: epochNs, dur: weighted([85, durationFields({ units: TIME_DURATION_UNITS })], [15, durationFields()]) }),
+  gs.record({ kind: gs.just("until"), ns: epochNs, ns2: epochNs, options: diffOptions(TIME_UNITS), largestDateUnit: maybe(10, pick(DATE_UNITS)) }),
+  pick(TIME_UNITS).flatMap((unit) => gs.record({
+    kind: gs.just("round"),
+    ns: shaped(epochNs, epochNsSince1970),
+    options: options({ smallestUnit: gs.just(unit), roundingIncrement: maybe(60, weighted([80, increment(unit)], [20, pick([24, 86400, 1000000])])), roundingMode: maybe(60, pick(ROUNDING_MODES)) }),
+  })),
+  gs.record({
+    kind: gs.just("toString"),
+    ns: shaped(epochNs, epochNsSince1970),
+    options: options({
+      timeZone: maybe(50, pick(TIME_ZONES)),
+      smallestUnit: maybe(50, pick(["minute", "second", "millisecond", "microsecond", "nanosecond"])),
+      fractionalSecondDigits: maybe(50, pick(["auto", 0, 1, 3, 5, 9])),
+      roundingMode: maybe(50, pick(ROUNDING_MODES)),
+    }),
+  }),
+);
+
+/** A `with` bag for a PlainTime: an hour -1..24, a minute 0..60, a nanosecond 0..1000, each half the time; `{second: 0}` when nothing was drawn. */
+const timeWith = options({ hour: maybe(50, ints(-1, 24)), minute: maybe(50, ints(0, 60)), nanosecond: maybe(50, ints(0, 1000)) })
+  .map((w) => (Object.keys(w).length === 0 ? { second: 0 } : w));
+/** The PlainTime/PlainYearMonth/PlainMonthDay case. KNOWN: a PlainYearMonth duration with a unit below months is temporal-polyfill/4's shape; under HEGEL_NO_KNOWN=1 it has years and months only. */
+export const monthTypesCase = gs.record({
+  t: timeFields,
+  t2: timeFields,
+  f: validDate,
+  op: gs.oneOf(
+    gs.record({ kind: gs.just("time-arithmetic"), dur: weighted([85, durationFields({ units: TIME_DURATION_UNITS })], [15, durationFields()]), options: diffOptions(TIME_UNITS) }),
+    gs.record({ kind: gs.just("time-fields"), options: timeStringOptions, fields: timeWith, overflow: overflowOption }),
+    gs.record({
+      kind: gs.just("year-month"),
+      dur: shaped(durationFields(), durationFields({ units: ["years", "months"] })),
+      overflow: overflowOption,
+      ym2: gs.record({ year, month: ints(1, 12) }),
+      options: diffOptions(["year", "month"]),
+    }),
+    gs.record({ kind: gs.just("month-day"), day: pick([1, 15, 28, 29, 30, 31, 0, 32]), overflow: overflowOption }),
+  ),
+});
+
+/** The calendar case, built per calendar: the date inside the years the reference's ICU agrees on (1650-2047, arithmetic up to 30 years) unless ISO, a one-unit duration, a second date for `until`, a largest unit, and a `with` bag. */
+export const calendarCase = pick(CALENDARS).flatMap((calendar) => gs.record({
+  calendar: gs.just(calendar),
+  date: calendar === "iso8601" ? validDate : gs.record({ year: ints(1650, 2047), month: ints(1, 12), day: ints(1, 28) }),
+  dur: gs.record({ unit: pick(["years", "months", "weeks", "days"]), n: ints(-30, 30) }).map(({ unit, n }) => ({ [unit]: n })),
+  overflow: overflowOption,
+  date2: gs.record({ year: calendar === "iso8601" ? ints(1, 9999) : ints(1600, 2077), month: ints(1, 12), day: ints(1, 28) }),
+  largestUnit: pick(DATE_UNITS),
+  w: weighted(
+    [50, gs.record({ day: pick([1, 29, 30, 31]) })],
+    [25, gs.record({ month: pick([1, 12, 13]) })],
+    [25, gs.record({ monthCode: pick(["M01", "M12", "M13", "M05L", "M06L"]) })],
+  ),
+}));
+
+// ---------------------------------------------------------------- the shapes of the recorded bugs
+
+// Each recorded bug's shape region (bugs.toml) on its own, with random contents around it, for
+// the property that checks that one shape (the section before the pins in hegel.test.mjs).
+// Under HEGEL_NO_KNOWN=1 each draws the region beside the shape instead, so the same check runs
+// where the library is right.
+
+/** Seconds within about 95 years of 1970 and a nonzero sub-second part, before the epoch (temporal-polyfill/1's region) or mirrored after it. */
+const secondsAndFraction = gs.record({ s: ints(0, 3000000000), sub: ints(1, 999999999) });
+export const epochBefore1970 = secondsAndFraction.map(({ s, sub }) => -(BigInt(s) * 1000000000n + BigInt(sub)));
+export const epochAfter1970 = secondsAndFraction.map(({ s, sub }) => BigInt(s) * 1000000000n + BigInt(sub));
+const DIRECTIONAL_MODES = ["trunc", "ceil", "floor", "expand"];
+const STRING_UNITS = ["minute", "second", "millisecond", "microsecond"];
+/** temporal-polyfill/1: a directional rounding (trunc by default, ceil, floor or expand) of an Instant before 1970 in toString (with a time zone 30% of the time), round, or ZonedDateTime.toString. */
+export const preEpochRoundingCase = gs.record({
+  ns: shaped(epochBefore1970, epochAfter1970),
+  op: gs.oneOf(
+    gs.record({ kind: gs.just("toString"), options: options({ timeZone: maybe(30, pick(TIME_ZONES)), smallestUnit: pick(STRING_UNITS), roundingMode: maybe(50, pick(DIRECTIONAL_MODES)) }) }),
+    pick(STRING_UNITS).flatMap((unit) => gs.record({ kind: gs.just("round"), options: options({ smallestUnit: gs.just(unit), roundingIncrement: maybe(40, increment(unit)), roundingMode: pick(DIRECTIONAL_MODES) }) })),
+    gs.record({ kind: gs.just("zoned"), tz: pick(TIME_ZONES), options: options({ smallestUnit: pick(STRING_UNITS), roundingMode: maybe(50, pick(DIRECTIONAL_MODES)) }) }),
+  ),
+});
+
+/** A date part no calendar has: month 0 or 13+, day 0 or 32+, February 30/31, or the 31st of a 30-day month. */
+const invalidDate = gs.oneOf(
+  gs.record({ year, month: pick([0, 13, 14, 19, 99]), day: ints(1, 28) }),
+  gs.record({ year, month: ints(1, 12), day: pick([0, 32, 40, 99]) }),
+  gs.record({ year, month: gs.just(2), day: pick([30, 31]) }),
+  gs.record({ year, month: pick([4, 6, 9, 11]), day: gs.just(31) }),
+);
+/** temporal-polyfill/2: a time string whose date part is invalid, in extended or basic (15%) format with any designator. */
+export const invalidDatePartTimeCase = gs.record({ date: shaped(invalidDate, validDate), time: timeFields, designator: pick(["T", "t", " "]), basic: chance(15) });
+
+const NON_ISO_CALENDARS = CALENDARS.filter((c) => c !== "iso8601");
+/** temporal-polyfill/3: a date-time string with a calendar annotation that is not iso8601 (a known calendar, or an unknown one), critical 20% of the time, for PlainTime. */
+export const calendarAnnotatedTimeCase = gs.record({
+  date: validDate,
+  time: timeFields,
+  calendar: shaped(pick([...NON_ISO_CALENDARS, "nope", "discord", "chinese"]), gs.just("iso8601")),
+  crit: chance(20),
+  designator: pick(["T", "t", " "]),
+});
+
+const LOWER_UNITS = UNITS.slice(2);
+/** temporal-polyfill/4: a PlainYearMonth added to or subtracted from a duration with a nonzero year or month part and one or two nonzero units below months (none beside the shape), all of one sign, with an overflow half the time. */
+export const yearMonthLowerUnitsCase = gs.record({
+  ym: gs.record({ year, month: ints(1, 12) }),
+  negative: chance(50),
+  major: gs.record({ unit: pick(["years", "months"]), value: ints(1, 12) }),
+  minor: shaped(gs.maps(pick(LOWER_UNITS), ints(1, 40), { minSize: 1, maxSize: 2 }), gs.just(new Map())),
+  op: pick(["add", "subtract"]),
+  overflow: overflowOption,
+}).map(({ negative, major, minor, ...rest }) => ({ ...rest, dur: Object.fromEntries([[major.unit, major.value], ...minor].map(([u, v]) => [u, negative ? -v : v])) }));
+
+/** temporal-polyfill/5: a date (with a time 80% of the time) and a bracketed UTC offset with seconds (none beside the shape), critical 20%, basic format 20%, for a Plain type. */
+export const bracketedOffsetCase = gs.record({
+  date: validDate,
+  time: maybe(80, timeFields),
+  type: pick(PLAIN_TYPES),
+  crit: chance(20),
+  basic: chance(20),
+  offset: gs.record({ sign: pick(["+", "-"]), hour: ints(0, 23), minute: ints(0, 59), second: shaped(ints(0, 59), gs.just(undefined)) }),
+});
+
+/** temporal-polyfill/6: a date-time with a UTC offset whose hour is 24-99 or whose minute is 60-99 (an in-range offset beside the shape), extended or basic (20%), for a Plain type. */
+export const offsetHourCase = gs.record({
+  date: validDate,
+  time: timeFields,
+  type: pick(PLAIN_TYPES),
+  sign: pick(["+", "-"]),
+  basic: chance(20),
+  offset: shaped(
+    gs.oneOf(gs.record({ hour: ints(24, 99), minute: ints(0, 59) }), gs.record({ hour: ints(0, 23), minute: ints(60, 99) })),
+    gs.record({ hour: ints(0, 23), minute: ints(0, 59) }),
+  ),
+});
+
+/** The duration units strictly below a smallest unit. */
+const BELOW = { minute: ["seconds", "milliseconds", "microseconds", "nanoseconds"], second: ["milliseconds", "microseconds", "nanoseconds"], millisecond: ["microseconds", "nanoseconds"], microsecond: ["nanoseconds"] };
+/** The rounding modes under which an amount below half a unit rounds to zero (floor and expand round a negative one away from zero). */
+const ZERO_MODES = ["trunc", "ceil", "halfExpand", "halfTrunc", "halfEven", "halfCeil", "halfFloor"];
+/** One or two units of 1-5 each. */
+const smallParts = (units) => gs.maps(pick(units), ints(1, 5), { minSize: 1, maxSize: 2 });
+/** temporal-polyfill/7: a negative (positive beside the shape) duration whose units all lie below the smallest unit (or the fractional digits) toString rounds to, under a mode that rounds it to zero. */
+export const zeroRoundedDurationCase = gs.record({
+  negative: shaped(gs.just(true), gs.just(false)),
+  rounding: gs.oneOf(
+    pick(["minute", "second", "millisecond", "microsecond"]).flatMap((unit) => gs.record({ options: options({ smallestUnit: gs.just(unit), roundingMode: maybe(50, pick(ZERO_MODES)) }), parts: smallParts(BELOW[unit]) })),
+    pick([0, 1, 2]).flatMap((digits) => gs.record({ options: options({ fractionalSecondDigits: gs.just(digits), roundingMode: maybe(50, pick(ZERO_MODES)) }), parts: smallParts(["microseconds", "nanoseconds"]) })),
+  ),
+}).map(({ negative, rounding }) => ({ options: rounding.options, dur: Object.fromEntries([...rounding.parts].map(([u, v]) => [u, negative ? -v : v])) }));
+
+/** The calendar ids the reference handles for every parser (no coptic/ethiopic, retired or upper-case ids: OracleLimits), plus an unknown one. */
+const AGREED_CALENDARS = [...CALENDARS.filter((c) => c !== "coptic" && c !== "ethiopic"), "nope"];
+/** temporal-polyfill/8: a date within the reference's calendar range (a time 70% of the time, `Z` after it 20%), a calendar (iso8601 for PlainTime, whose other calendars are temporal-polyfill/3) or other annotation and a time zone annotation, the time zone last (first beside the shape), for any parser but Duration. */
+export const annotationOrderCase = pick([...PLAIN_TYPES, "Instant", "ZonedDateTime"]).flatMap((type) => gs.record({
+  type: gs.just(type),
+  date: gs.record({ year: ints(1600, 2077), month: ints(1, 12), day: ints(1, 28) }),
+  time: maybe(70, gs.record({ fields: timeFields, z: chance(20) })),
+  other: weighted([60, gs.record({ kind: gs.just("calendar"), crit: chance(20), id: pick(type === "PlainTime" ? ["iso8601"] : AGREED_CALENDARS) })], [40, otherAnnotation]),
+  tz: gs.record({ kind: gs.just("tz"), crit: chance(20), id: pick(TZ_IDS) }),
+  order: shaped(gs.just("tz-last"), gs.just("tz-first")),
+}));
+
+/** Hebrew years by 19-year cycle: the years with a leap month (Adar I, M05L) are those with (7y+1) mod 19 < 7, i.e. y mod 19 in LEAP_K. */
+const LEAP_K = [0, 3, 6, 8, 11, 14, 17];
+const COMMON_K = [1, 2, 4, 5, 7, 9, 10, 12, 13, 15, 16, 18];
+/**
+ * temporal-polyfill/9: an until/since with largestUnit "year" from Adar I (M05L) of a leap year to
+ * Shevat (M05) of an earlier common year on a later day of the month (the cycles keep both years
+ * within the reference's 1600-2077 range); beside the shape the end lies in Tevet or Adar instead.
+ */
+export const leapMonthUntilCase = ints(284, 306).flatMap((cycle) => gs.record({
+  type: pick(["PlainDate", "PlainDateTime", "ZonedDateTime"]),
+  op: pick(["until", "since"]),
+  start: gs.record({ year: pick(LEAP_K).map((k) => cycle * 19 + k), monthCode: gs.just("M05L"), day: ints(1, 28) }),
+  end: gs.record({ year: gs.record({ back: ints(1, cycle - 283), k: pick(COMMON_K) }).map(({ back, k }) => (cycle - back) * 19 + k), monthCode: shaped(gs.just("M05"), pick(["M04", "M06"])), day: ints(1, 29) }),
+  time: timeFields,
+}).map(({ start, end, ...rest }) => ({ ...rest, start, end: { ...end, day: end.monthCode === "M05" ? Math.max(end.day, start.day + 1) : end.day } })));
