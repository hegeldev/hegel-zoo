+  const w = chance(tc, 50) ? { day: pick(tc, [1, 29, 30, 31]) } : chance(tc, 50) ? { month: pick(tc, [1, 12, 13]) } : { monthCode: pick(tc, ["M01", "M12", "M13", "M05L", "M06L"]) };
+  same(`PlainDate(${iso}).withCalendar(${cal}).with(${show(w)}, ${show(oo)})`, (I) => I.PlainDate.from(iso).withCalendar(cal).with(w, oo).toString());
+  void got;
+});
+
+// ---------------------------------------------------------------------------------------------
+// Pins for the known bugs (each asserts the specification's answer).
+
+pin("TestHegelPinNegativeInstantRoundsTowardThePast", () => {
+  // temporal-polyfill/1: "rounding down is towards the Big Bang, not the epoch"
+  assert.equal(new T.Instant(-34959986330n).toString({ smallestUnit: "second" }), "1969-12-31T23:59:25Z");
+  assert.equal(new T.Instant(-1500500000n).toString({ smallestUnit: "millisecond", roundingMode: "trunc" }), "1969-12-31T23:59:58.499Z");
+  assert.equal(new T.Instant(-34959986330n).round({ smallestUnit: "second", roundingMode: "trunc" }).toString(), "1969-12-31T23:59:25Z");
+  assert.equal(T.ZonedDateTime.from("1960-12-31T23:59:25.5[UTC]").toString({ smallestUnit: "second", roundingMode: "trunc" }), "1960-12-31T23:59:25+00:00[UTC]");
+});
+
+pin("TestHegelPinPlainTimeRejectsAnInvalidDatePart", () => {
+  // temporal-polyfill/2
+  assert.throws(() => T.PlainTime.from("2011-02-30T13:12:50"), RangeError);
+  assert.throws(() => T.PlainTime.from("2011-00-09T13:12:50"), RangeError);
+});
+
+pin("TestHegelPinPlainTimeIgnoresTheCalendarAnnotation", () => {
+  // temporal-polyfill/3
+  assert.equal(T.PlainTime.from("2048-10-24T02:08[u-ca=persian]").toString(), "02:08:00");
+  assert.equal(T.PlainTime.from("T02:08[u-ca=discord]").toString(), "02:08:00");
+});
+
+pin("TestHegelPinYearMonthRejectsUnitsBelowMonths", () => {
+  // temporal-polyfill/4
+  assert.throws(() => T.PlainYearMonth.from("2040-09").add({ months: 1, days: 1 }), RangeError);
+  assert.throws(() => T.PlainYearMonth.from("2040-09").subtract({ months: 1, days: 1 }), RangeError);
+  assert.throws(() => T.PlainYearMonth.from("2040-09").add({ years: 1, hours: 1 }), RangeError);
+});
+
+pin("TestHegelPinBracketedOffsetHasNoSeconds", () => {
+  // temporal-polyfill/5
+  assert.throws(() => T.PlainDate.from("2052-11-23[+05:30:15]"), RangeError);
+  assert.throws(() => T.PlainDateTime.from("2052-11-23T00:00[+05:30:15]"), RangeError);
+  assert.throws(() => T.Instant.from("2052-11-23T00:00Z[+05:30:15]"), RangeError);
+});
+
+pin("TestHegelPinOffsetHourIsAtMost23", () => {
+  // a UTC offset's hour is 00–23 and its minute 00–59 (the reference rejects all four strings)
+  for (const s of ["1969-10-20T01:51:57+24:00", "1969-10-20T01:51:57-24:00", "1969-10-20T01:51:57+25:00", "1969-10-20T01:51:57+23:60"]) {
+    for (const type of ["PlainDate", "PlainDateTime", "PlainYearMonth", "PlainMonthDay"]) {
+      assert.throws(() => T[type].from(s), RangeError, `${type}.from(${JSON.stringify(s)})`);
+    }
+  }
+});
+
+pin("TestHegelPinZeroDurationHasNoSign", () => {
+  // temporal-polyfill/7
+  assert.equal(T.Duration.from({ nanoseconds: -5 }).toString({ smallestUnit: "millisecond" }), "PT0.000S");
+  assert.equal(T.Duration.from({ milliseconds: -5 }).toString({ fractionalSecondDigits: 0 }), "PT0S");
+  assert.equal(T.Duration.from({ nanoseconds: -5 }).toString({ smallestUnit: "second" }), "PT0S");
+});
+
+pin("TestHegelPinTimeZoneAnnotationComesFirst", () => {
+  // temporal-polyfill/8: Annotations ::: TimeZoneAnnotation? Annotation* — "[UTC]" is not an
+  // Annotation (no key=value), so it may only come directly after the date-time
+  for (const type of ["PlainDate", "PlainDateTime", "PlainTime", "PlainYearMonth", "PlainMonthDay", "ZonedDateTime"]) {
+    assert.throws(() => T[type].from("2059-07-23T15:46:00[u-ca=iso8601][UTC]"), RangeError, `${type}.from(...[u-ca=iso8601][UTC])`);
+    assert.throws(() => T[type].from("2059-07-23T15:46:00[foo=bar][+01:00]"), RangeError, `${type}.from(...[foo=bar][+01:00])`);
+  }
+  assert.throws(() => T.Instant.from("2059-07-23T15:46:00Z[foo=bar][UTC]"), RangeError);
+});
