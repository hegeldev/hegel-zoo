diff --git a/hegel/build.mjs b/hegel/build.mjs
new file mode 100644
index 0000000..7b08f8a
--- /dev/null
+++ b/hegel/build.mjs
@@ -0,0 +1,13 @@
+// Hegel zoo: bundle src/index.ts (TypeScript, ESM) to .hegel/dist/index.mjs with the esbuild binary
+// installed under .hegel/ by the target's setup. tshy (upstream's build) is not needed: the tests
+// import the bundle directly, and node:diagnostics_channel is left external by --platform=node.
+import { execFileSync } from "node:child_process";
+import { dirname, join } from "node:path";
+import { fileURLToPath } from "node:url";
+
+const root = join(dirname(fileURLToPath(import.meta.url)), "..");
+execFileSync(
+  join(root, ".hegel", "node_modules", "esbuild", "bin", "esbuild"),
+  ["src/index.ts", "--bundle", "--platform=node", "--format=esm", "--target=node22", "--log-level=warning", "--outfile=.hegel/dist/index.mjs"],
+  { cwd: root, stdio: "inherit" },
+);
diff --git a/hegel/hegel-zoo.mjs b/hegel/hegel-zoo.mjs
new file mode 100644
index 0000000..1ca6f10
--- /dev/null
+++ b/hegel/hegel-zoo.mjs
@@ -0,0 +1,163 @@
+// Hegel zoo: the small harness shared by the zoo's TypeScript/JavaScript targets.
+//
+// `property(name, body)` registers a node:test test that runs `body(tc)` under Hegel with
+// HEGEL_TEST_CASES cases (default 100) and the database at HEGEL_DATABASE. With ZOO_COLLECT=1
+// a `fail()` records the mismatch instead of failing, the case ends there, and the counts of
+// mismatches and of the shapes seen (`count(key)`) are printed at the end of the test, so a
+// property can be run over many cases to see every shape at once. `pin(name, body)` is a
+// plain test for one pinned bug: it must fail while the bug is present and pass once it is
+// fixed (the zoo's judge reads an unexpected pass as "fixed upstream?").
+
+import { readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+import { test as nodeTest } from "node:test";
+
+// The Hegel version these tests were written against (the zoo pins it in zoo.toml; upstream
+// would add it to devDependencies). Hegel and esbuild are installed with `npm install --prefix
+// .hegel` so the target's own package.json and lock file stay untouched. Checked at load time so
+// a stray install cannot silently change the engine.
+export const HEGEL_PIN = { "@hegeldev/hegel": "0.4.5" };
+
+const hegelDir = join(dirname(fileURLToPath(import.meta.url)), "..", ".hegel", "node_modules", "@hegeldev", "hegel");
+{
+  const installed = JSON.parse(readFileSync(join(hegelDir, "package.json"), "utf8")).version;
+  if (installed !== HEGEL_PIN["@hegeldev/hegel"]) {
+    throw new Error(`@hegeldev/hegel ${installed} is installed; these tests pin ${HEGEL_PIN["@hegeldev/hegel"]}`);
+  }
+}
+const hegel = await import(pathToFileURL(join(hegelDir, "dist", "index.js")));
+const gs = await import(pathToFileURL(join(hegelDir, "dist", "generators", "index.js")));
+
+export const collecting = !!process.env.ZOO_COLLECT;
+
+class Collected extends Error {}
+
+let msgs = [];
+let stats = new Map();
+
+/** Report a mismatch: an error normally, a recorded line in collect mode. */
+export function fail(message) {
+  if (collecting) {
+    msgs.push(message);
+    throw new Collected(message);
+  }
+  throw new Error(message);
+}
+
+/** Bump a statistic (the shape of a pinned bug, a generator branch). */
+export function count(key) {
+  stats.set(key, (stats.get(key) || 0) + 1);
+}
+
+function settings() {
+  const s = { testCases: Number(process.env.HEGEL_TEST_CASES) || 100 };
+  if (process.env.HEGEL_DATABASE) {
+    s.database = hegel.Database.fromPath(process.env.HEGEL_DATABASE);
+  }
+  return s;
+}
+
+/** A property: `body(tc)` runs under Hegel; a thrown error (or `fail`) is a failure. */
+export function property(name, body) {
+  nodeTest(name, () => {
+    msgs = [];
+    stats = new Map();
+    hegel.test((tc) => {
+      try {
+        body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** An async property: `body(tc)` may await; runs under Hegel's testAsync with the same settings. */
+export function propertyAsync(name, body) {
+  nodeTest(name, async () => {
+    msgs = [];
+    stats = new Map();
+    await hegel.testAsync(async (tc) => {
+      try {
+        await body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** A pin: a plain test for one recorded bug. */
+export function pin(name, body) {
+  nodeTest(name, body);
+}
+
+/** An integer in [lo, hi]. */
+export function n(tc, lo, hi) {
+  return tc.draw(gs.integers({ minValue: lo, maxValue: hi }));
+}
+
+/** One of xs. */
+export function pick(tc, xs) {
+  return xs[n(tc, 0, xs.length - 1)];
+}
+
+/** True pct percent of the time. */
+export function chance(tc, pct) {
+  return n(tc, 0, 99) < pct;
+}
+
+/** A string of `len` characters drawn from `alphabet` (an array of strings). */
+export function word(tc, alphabet, lo, hi) {
+  const len = n(tc, lo, hi);
+  let s = "";
+  for (let i = 0; i < len; i++) {
+    s += pick(tc, alphabet);
+  }
+  return s;
+}
+
+/** Structural equality: arrays by position, objects by key set (prototype ignored), else ===. */
+export function same(a, b) {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) {
+      return false;
+    }
+    return a.every((x, i) => same(x, b[i]));
+  }
+  if (a !== null && b !== null && typeof a === "object" && typeof b === "object") {
+    const ka = Object.keys(a).sort();
+    const kb = Object.keys(b).sort();
+    if (ka.length !== kb.length || ka.some((k, i) => k !== kb[i])) {
+      return false;
+    }
+    return ka.every((k) => same(a[k], b[k]));
+  }
+  return a === b;
+}
+
+/** A compact, unambiguous rendering for messages. */
+export function show(x) {
+  return JSON.stringify(x, (k, v) => (v === undefined ? "<undefined>" : v));
+}
diff --git a/hegel/hegel.test.mjs b/hegel/hegel.test.mjs
new file mode 100644
index 0000000..a4f1a3b
--- /dev/null
+++ b/hegel/hegel.test.mjs
@@ -0,0 +1,1106 @@
+// Hegel zoo: property-based tests for lru-cache (isaacs/node-lru-cache), run with `node --test`.
+//
+// Oracle: a small model of the documented behaviour — an insertion-ordered Map (least recently
+// used first) of {value, size, ttl, start} entries, a mocked clock (`perf: { now }`, as the
+// README's testing section recommends), and a log of the dispose / disposeAfter / onInsert calls.
+// Every operation is applied to the model and to a real LRUCache (sometimes one built from
+// another cache with the copy-constructor form the docs describe), and the results, the
+// `status` objects, the iteration order, the sizes and the callbacks are compared after each
+// step. Recency: `get`, `set` and `fetch` hits move an entry to the most-recently-used end;
+// `has`, `peek`, `info`, iteration and `dump` do not. Staleness: an entry with a ttl is stale
+// once `now - start > ttl`; stale entries stay in the cache (they count towards `size`) until a
+// `get` (deleted unless noDeleteOnStaleGet, returned only with allowStale), `purgeStale`, an
+// eviction or a `delete`. `has` is false for stale entries, `peek` returns them only with
+// allowStale, iteration skips them unless the cache's allowStale is set, `dump` always includes
+// them and `pop` returns them. Sizes: with maxSize, an entry larger than maxEntrySize (which
+// defaults to maxSize) is not stored and deletes an existing value; otherwise least-recently-used
+// entries are evicted until the total fits.
+//
+// `fetch` (async) is covered by a second, smaller model: fetchMethod calls are counted and
+// their resolution is controlled by the test, so coalescing, stale-while-revalidate, rejection
+// and abort handling can be checked against the documented rules.
+//
+// ttlResolution is 0 in every cache here: with the default (1 ms) the cache reads its clock at
+// most once per millisecond of real time, so a burst of synchronous operations on a mocked clock
+// would see a frozen time.
+//
+// ZOO_COLLECT=1 turns mismatches into `# COLLECT` counts instead of failures; HEGEL_TEST_CASES
+// sets the number of cases (default 100).
+
+import assert from "node:assert/strict";
+import { chance, count, fail, n, pick, pin, property, propertyAsync, same, show } from "./hegel-zoo.mjs";
+
+const { LRUCache } = await import("../.hegel/dist/index.mjs");
+
+// Known bugs (see bugs.toml): the properties skip the shape of each while the switch is on. The
+// pins at the end assert the correct behaviour and fail while the bug exists.
+const Known = {
+  zeroStart: true, // lru-cache/1: an entry whose start time is 0 (clock at 0, or start: 0) never expires
+  oversizeEntry: true, // lru-cache/2: an entry larger than maxSize but within maxEntrySize empties the cache and leaves calculatedSize negative
+  delayedDisposeAfter: true, // lru-cache/3: noDisposeOnSet postpones the disposeAfter calls of the evictions made by that set()
+  sameValueSize: true, // lru-cache/4: set(k, sameValue, { size }) keeps the old size
+};
+
+// ---------------------------------------------------------------------------------------------
+// Generators
+
+const KEYS = ["a", "b", "c", "d", "e", 1, 2, 3];
+const OBJ_KEY = { id: "shared object key" };
+const OBJ_VALUE = { some: "object value" };
+
+function genKey(tc) {
+  return chance(tc, 8) ? OBJ_KEY : pick(tc, KEYS);
+}
+
+function genValue(tc) {
+  // undefined is an alias for delete; objects are compared by identity
+  const r = n(tc, 0, 99);
+  if (r < 5) return undefined;
+  if (r < 15) return OBJ_VALUE;
+  if (r < 30) return pick(tc, ["x", "yy", "zzz", "", "hello"]);
+  return n(tc, 1, 6);
+}
+
+/** The size the cache's sizeCalculation gives a value (deterministic). */
+function sizeOf(v, k) {
+  if (typeof v === "string") return v.length + 1;
+  if (typeof v === "number") return (v % 4) + 1;
+  return typeof k === "object" ? 3 : 2;
+}
+
+function genOptions(tc, withCallbacks) {
+  const bound = pick(tc, ["max", "max", "maxSize", "both", "ttl"]);
+  const o = {};
+  if (bound === "max" || bound === "both") o.max = n(tc, 1, 6);
+  if (bound === "maxSize" || bound === "both") {
+    o.maxSize = n(tc, 3, 20);
+    if (chance(tc, 30)) o.maxEntrySize = Known.oversizeEntry ? n(tc, 1, o.maxSize) : n(tc, 1, o.maxSize + 8);
+  } else if (chance(tc, 15)) {
+    o.maxEntrySize = n(tc, 1, 8); // entry limit without a total limit
+  }
+  if (bound === "ttl" || chance(tc, 40)) o.ttl = n(tc, 1, 30);
+  if (o.maxSize !== undefined || o.maxEntrySize !== undefined) {
+    if (chance(tc, 70)) o.sizeCalculation = sizeOf;
+  }
+  o.ttlResolution = 0;
+  for (const flag of ["allowStale", "noDeleteOnStaleGet", "updateAgeOnGet", "updateAgeOnHas", "noUpdateTTL"]) {
+    if (chance(tc, 30)) o[flag] = true;
+  }
+  if (withCallbacks) {
+    o.callbacks = { dispose: chance(tc, 60), disposeAfter: chance(tc, 40), onInsert: chance(tc, 40) };
+  } else {
+    o.callbacks = { dispose: false, disposeAfter: false, onInsert: false };
+  }
+  // lru-cache/3: noDisposeOnSet postpones disposeAfter, so the two are not combined while the bug exists
+  if (chance(tc, 20) && !(Known.delayedDisposeAfter && o.callbacks.disposeAfter)) o.noDisposeOnSet = true;
+  return o;
+}
+
+// ---------------------------------------------------------------------------------------------
+// The model
+
+class Model {
+  constructor(o, clock, log) {
+    this.o = o;
+    this.clock = clock;
+    this.log = log;
+    this.map = new Map(); // key -> {value, size, ttl, start}; insertion order = least recently used first
+    this.after = [];
+    this.sizing = !!(o.maxSize || o.maxEntrySize);
+    this.maxEntrySize = o.maxEntrySize || o.maxSize || 0;
+  }
+  now() {
+    return this.clock.t;
+  }
+  get size() {
+    return this.map.size;
+  }
+  get calculatedSize() {
+    let s = 0;
+    for (const e of this.map.values()) s += e.size;
+    return s;
+  }
+  isStale(e) {
+    return !!e.ttl && !!e.start && this.now() - e.start > e.ttl;
+  }
+  remaining(e) {
+    return !e.ttl || !e.start ? Infinity : e.ttl - (this.now() - e.start);
+  }
+  dispose(e, k, reason) {
+    if (this.o.callbacks.dispose) this.log.push(["dispose", e.value, k, reason]);
+    if (this.o.callbacks.disposeAfter) this.after.push(["after", e.value, k, reason]);
+  }
+  flush() {
+    for (const a of this.after) this.log.push(a);
+    this.after = [];
+  }
+  remove(k, reason) {
+    const e = this.map.get(k);
+    if (!e) return false;
+    this.dispose(e, k, reason);
+    this.map.delete(k);
+    return true;
+  }
+  evictLRU() {
+    const [k] = this.map.keys();
+    this.remove(k, "evict");
+  }
+  touch(k, e) {
+    this.map.delete(k);
+    this.map.set(k, e);
+  }
+  // MRU-first list of [k, e] the iterators see (stale skipped unless the cache's allowStale)
+  visible(allowStale = !!this.o.allowStale) {
+    return [...this.map].reverse().filter(([, e]) => allowStale || !this.isStale(e));
+  }
+
+  set(k, v, opts = {}) {
+    const status = {};
+    status.op = "set";
+    status.key = k;
+    if (v !== undefined) status.value = v;
+    if (v === undefined) {
+      status.set = "deleted";
+      this.delete(k, "delete");
+      return status;
+    }
+    const noDisposeOnSet = opts.noDisposeOnSet ?? !!this.o.noDisposeOnSet;
+    let noUpdateTTL = opts.noUpdateTTL ?? !!this.o.noUpdateTTL;
+    const ttl = opts.ttl ?? this.o.ttl ?? 0;
+    let size = 0;
+    if (this.sizing) {
+      size = opts.size || (opts.sizeCalculation ?? this.o.sizeCalculation)(v, k);
+    }
+    if (this.maxEntrySize && size > this.maxEntrySize) {
+      this.remove(k, "set");
+      status.set = "miss";
+      status.maxEntrySizeExceeded = true;
+      this.flush();
+      return status;
+    }
+    const existing = this.map.get(k);
+    if (!existing) {
+      if (this.o.max && this.map.size === this.o.max) this.evictLRU();
+      const e = { value: v, size: 0, ttl: 0, start: 0 };
+      this.map.set(k, e);
+      this.addSize(e, size);
+      if (this.sizing) {
+        status.entrySize = size;
+        status.totalCalculatedSize = this.calculatedSize;
+      }
+      status.set = "add";
+      noUpdateTTL = false;
+      if (this.o.callbacks.onInsert) this.log.push(["insert", v, k, "add"]);
+      this.setTTL(e, ttl, opts.start);
+      this.statusTTL(status, e);
+    } else {
+      this.touch(k, existing);
+      if (v !== existing.value) {
+        if (!noDisposeOnSet) this.dispose(existing, k, "set");
+        const oldValue = existing.value;
+        this.addSize(existing, size);
+        if (this.sizing) {
+          status.entrySize = size;
+          status.totalCalculatedSize = this.calculatedSize;
+        }
+        existing.value = v;
+        status.set = "replace";
+        status.oldValue = oldValue;
+        if (this.o.callbacks.onInsert) this.log.push(["insert", v, k, "replace"]);
+      } else {
+        status.set = "update";
+        if (this.o.callbacks.onInsert) this.log.push(["insert", v, k, "update"]);
+      }
+      if (!noUpdateTTL) this.setTTL(existing, ttl, opts.start);
+      this.statusTTL(status, existing);
+    }
+    if (!noDisposeOnSet) this.flush();
+    return status;
+  }
+  addSize(e, size) {
+    // the entry is already the most recently used, so it is evicted last
+    e.size = 0;
+    if (this.o.maxSize) {
+      while (this.calculatedSize > this.o.maxSize - size) this.evictLRU();
+    }
+    e.size = size;
+  }
+  setTTL(e, ttl, start) {
+    e.ttl = ttl;
+    e.start = ttl !== 0 ? (start ?? this.now()) : 0;
+  }
+  statusTTL(status, e) {
+    if (e.ttl && e.start) {
+      status.ttl = e.ttl;
+      status.start = e.start;
+      status.now = this.now();
+      status.remainingTTL = e.ttl - (status.now - e.start);
+    }
+  }
+
+  get(k, opts = {}) {
+    const status = { op: "get", key: k };
+    const allowStale = opts.allowStale ?? !!this.o.allowStale;
+    const updateAgeOnGet = opts.updateAgeOnGet ?? !!this.o.updateAgeOnGet;
+    const noDeleteOnStaleGet = opts.noDeleteOnStaleGet ?? !!this.o.noDeleteOnStaleGet;
+    const e = this.map.get(k);
+    let result;
+    if (!e) {
+      status.get = "miss";
+    } else {
+      this.statusTTL(status, e);
+      if (this.isStale(e)) {
+        if (!noDeleteOnStaleGet) {
+          this.remove(k, "expire");
+          this.flush();
+        }
+        status.get = "stale";
+        if (allowStale) {
+          status.returnedStale = true;
+          result = e.value;
+        }
+      } else {
+        status.get = "hit";
+        this.touch(k, e);
+        if (updateAgeOnGet && e.ttl) e.start = this.now();
+        result = e.value;
+      }
+    }
+    if (result !== undefined) status.value = result;
+    return { result, status };
+  }
+
+  has(k, opts = {}) {
+    const status = { op: "has", key: k };
+    const updateAgeOnHas = opts.updateAgeOnHas ?? !!this.o.updateAgeOnHas;
+    const e = this.map.get(k);
+    let result = false;
+    if (!e) status.has = "miss";
+    else if (!this.isStale(e)) {
+      if (updateAgeOnHas && e.ttl) e.start = this.now();
+      status.has = "hit";
+      this.statusTTL(status, e);
+      result = true;
+    } else {
+      status.has = "stale";
+      this.statusTTL(status, e);
+    }
+    return { result, status };
+  }
+
+  peek(k, opts = {}) {
+    const status = { op: "peek", key: k };
+    const allowStale = opts.allowStale ?? !!this.o.allowStale;
+    const e = this.map.get(k);
+    let result;
+    if (!e) status.peek = "miss";
+    else if (!allowStale && this.isStale(e)) status.peek = "stale";
+    else {
+      status.peek = "hit";
+      status.value = e.value;
+      result = e.value;
+    }
+    return { result, status };
+  }
+
+  delete(k, reason = "delete") {
+    const r = this.remove(k, reason);
+    this.flush();
+    return r;
+  }
+
+  clear() {
+    for (const [k, e] of this.map) this.dispose(e, k, "delete");
+    this.map.clear();
+    this.flush();
+  }
+
+  pop() {
+    let result;
+    for (const [k, e] of this.map) {
+      this.remove(k, "evict");
+      result = e.value;
+      break;
+    }
+    this.flush();
+    return result;
+  }
+
+  purgeStale() {
+    let any = false;
+    for (const [k, e] of [...this.map]) {
+      if (this.isStale(e)) {
+        this.remove(k, "expire");
+        this.flush(); // each expiry is a delete of its own, with its disposeAfter drained at once
+        any = true;
+      }
+    }
+    return any;
+  }
+
+  keys() {
+    return this.visible().map(([k]) => k);
+  }
+  values() {
+    return this.visible().map(([, e]) => e.value);
+  }
+  entries() {
+    return this.visible().map(([k, e]) => [k, e.value]);
+  }
+  find(fn, getOptions) {
+    for (const [k, e] of this.visible()) {
+      if (fn(e.value, k)) return this.get(k, getOptions).result;
+    }
+    return undefined;
+  }
+  info(k) {
+    const e = this.map.get(k);
+    if (!e) return undefined;
+    const entry = { value: e.value };
+    if (e.ttl && e.start) entry.ttl = e.ttl - (this.now() - e.start);
+    if (this.sizing) entry.size = e.size;
+    return entry;
+  }
+  getRemainingTTL(k) {
+    const e = this.map.get(k);
+    return e ? this.remaining(e) : 0;
+  }
+  /** [k, {value, size?, ttl?}] least recently used first, stale included (start is checked separately). */
+  dump() {
+    return [...this.map].map(([k, e]) => {
+      const entry = { value: e.value };
+      if (this.sizing) entry.size = e.size;
+      return [k, entry];
+    });
+  }
+}
+
+// ---------------------------------------------------------------------------------------------
+// Comparing
+
+const STATUS_KEYS = ["op", "key", "value", "set", "get", "has", "peek", "oldValue", "returnedStale", "maxEntrySizeExceeded", "entrySize", "totalCalculatedSize", "ttl", "start", "now", "remainingTTL"];
+
+function showKey(k) {
+  return typeof k === "object" ? "<obj>" : JSON.stringify(k);
+}
+function showVal(v) {
+  return v === OBJ_VALUE ? "<objval>" : v === undefined ? "<undefined>" : JSON.stringify(v);
+}
+function showStatus(s) {
+  if (!s) return "<none>";
+  const parts = [];
+  for (const key of STATUS_KEYS) {
