+  const expectMaxEntry = o.maxEntrySize || expectMaxSize;
+  if (c.max !== expectMax || c.maxSize !== expectMaxSize || c.maxEntrySize !== expectMaxEntry || c.ttl !== (o.ttl || 0)) fail(`options readback: max ${c.max}/${expectMax} maxSize ${c.maxSize}/${expectMaxSize} maxEntrySize ${c.maxEntrySize}/${expectMaxEntry} ttl ${c.ttl}/${o.ttl || 0}`);
+  for (const flag of ["allowStale", "noDeleteOnStaleGet", "updateAgeOnGet", "updateAgeOnHas", "noUpdateTTL", "noDisposeOnSet"]) {
+    if (c[flag] !== !!o[flag]) fail(`options readback: ${flag} ${c[flag]} vs ${!!o[flag]}`);
+  }
+  if (Object.prototype.toString.call(c) !== "[object LRUCache]") fail(`toStringTag: ${Object.prototype.toString.call(c)}`);
+  // ttlResolution: invalid values fall back to 1, 0 is kept
+  const r = pick(tc, [0, 1, 7, -1, 0.5, "x"]);
+  const cr = new LRUCache({ max: 1, ttlResolution: r });
+  const want = r === 0 || (Number.isInteger(r) && r > 0) ? r : 1;
+  if (cr.ttlResolution !== want) fail(`ttlResolution ${show(r)} read back as ${cr.ttlResolution}, expected ${want}`);
+});
+
+// ---------------------------------------------------------------------------------------------
+// fetch: async, against a small scripted model
+
+function deferred() {
+  let resolve, reject;
+  const promise = new Promise((res, rej) => {
+    resolve = res;
+    reject = rej;
+  });
+  return { promise, resolve, reject };
+}
+
+const tick = () => new Promise((res) => setImmediate(res));
+
+propertyAsync("TestHegelFetch", async (tc) => {
+  const clock = { t: n(tc, 1, 1000) };
+  const ttl = chance(tc, 70) ? n(tc, 1, 30) : 0;
+  const allowStale = chance(tc, 40);
+  const noDeleteOnFetchRejection = chance(tc, 30);
+  const allowStaleOnFetchRejection = chance(tc, 30);
+  const pending = new Map(); // key -> deferred of the in-flight fetchMethod call
+  const calls = [];
+  const disposed = [];
+  const cache = new LRUCache({
+    max: n(tc, 3, 6), // three keys are used, so nothing is ever evicted by count
+    ttl,
+    ttlResolution: 0,
+    allowStale,
+    noDeleteOnFetchRejection,
+    allowStaleOnFetchRejection,
+    perf: { now: () => clock.t },
+    dispose: (v, k, r) => disposed.push([v, k, r]),
+    fetchMethod: (k, stale, { signal, options, context }) => {
+      calls.push({ k, stale, context, signal, options });
+      if (pending.has(k)) fail(`fetchMethod(${showKey(k)}) called while a fetch of the same key is in flight`);
+      const d = deferred();
+      pending.set(k, d);
+      signal.addEventListener("abort", () => {
+        if (pending.get(k) === d) pending.delete(k);
+      });
+      return d.promise;
+    },
+  });
+  // model: the entries {value, start, ttl} and which keys have a fetch in flight (with the stale value they cover)
+  const model = new Map();
+  const inflight = new Map(); // key -> {stale, promises: [...], waiters}
+  const isStale = (e) => !!e.ttl && clock.t - e.start > e.ttl;
+  const steps = n(tc, 1, 25);
+  for (let i = 0; i < steps; i++) {
+    const op = pick(tc, ["fetch", "fetch", "fetch", "resolve", "resolve", "reject", "set", "get", "advance", "delete"]);
+    const k = pick(tc, ["a", "b", "c"]);
+    let step = `${op}(${k}) at ${clock.t}`;
+    switch (op) {
+      case "fetch": {
+        const forceRefresh = chance(tc, 15);
+        const context = chance(tc, 30) ? { i } : undefined;
+        step = `fetch(${k}, forceRefresh=${forceRefresh}) at ${clock.t}`;
+        const status = {};
+        const before = calls.length;
+        const p = cache.fetch(k, { forceRefresh, context, status });
+        p.catch(() => {}); // settled below through allSettled; this keeps an early rejection from being "unhandled"
+        const e = model.get(k);
+        const fl = inflight.get(k);
+        if (fl) {
+          // coalesced: no new call; with allowStale and a stale value, resolves to it now
+          if (calls.length !== before) fail(`${step}: a second fetchMethod call while in flight`);
+          if (status.fetch !== "inflight") fail(`${step}: status.fetch ${status.fetch}, expected inflight`);
+          if (allowStale && fl.stale !== undefined) {
+            const v = await p;
+            if (v !== fl.stale) fail(`${step}: coalesced fetch with allowStale resolved ${showVal(v)}, expected the stale ${showVal(fl.stale)}`);
+          } else fl.promises.push(p);
+        } else if (e && !isStale(e) && !forceRefresh) {
+          if (calls.length !== before) fail(`${step}: fetchMethod called on a fresh hit`);
+          if (status.fetch !== "hit") fail(`${step}: status.fetch ${status.fetch}, expected hit`);
+          const v = await p;
+          if (v !== e.value) fail(`${step}: hit resolved ${showVal(v)}, expected ${showVal(e.value)}`);
+          // a hit refreshes recency: model has no order here, nothing to do
+        } else {
+          if (calls.length !== before + 1) fail(`${step}: fetchMethod called ${calls.length - before} times, expected 1`);
+          const call = calls[before];
+          if (call.k !== k) fail(`${step}: fetchMethod key ${showKey(call.k)}`);
+          if (call.stale !== (e ? e.value : undefined)) fail(`${step}: fetchMethod stale value ${showVal(call.stale)}, expected ${showVal(e && e.value)}`);
+          if (call.context !== context) fail(`${step}: fetchMethod context ${show(call.context)}, expected ${show(context)}`);
+          const expected = !e ? "miss" : isStale(e) ? "stale" : "refresh";
+          if (status.fetch !== expected) fail(`${step}: status.fetch ${status.fetch}, expected ${expected}`);
+          if (!status.fetchDispatched) fail(`${step}: status.fetchDispatched not set`);
+          const stale = e ? e.value : undefined;
+          inflight.set(k, { stale, promises: [], startedStale: e ? isStale(e) : false });
+          if (allowStale && stale !== undefined) {
+            // stale-while-revalidate: resolves to the stale value immediately
+            const v = await p;
+            if (v !== stale) fail(`${step}: fetch over a stale value with allowStale resolved ${showVal(v)}, expected ${showVal(stale)}`);
+            if (!status.returnedStale && isStale(e)) fail(`${step}: status.returnedStale not set`);
+          } else inflight.get(k).promises.push(p);
+          // while in flight: has() is false unless a stale value is covered; get() sees the stale value only with allowStale
+          const hasNow = cache.has(k);
+          const wantHas = stale !== undefined && !isStale(e);
+          if (hasNow !== wantHas) fail(`${step}: has() during the fetch ${hasNow}, expected ${wantHas}`);
+        }
+        break;
+      }
+      case "resolve": {
+        const d = pending.get(k);
+        const fl = inflight.get(k);
+        if (!d || !fl) {
+          count("resolve-nothing");
+          break;
+        }
+        const v = chance(tc, 15) ? undefined : `v${i}`;
+        step = `resolve(${k}, ${showVal(v)}) at ${clock.t}`;
+        d.resolve(v);
+        pending.delete(k);
+        await tick();
+        const results = await Promise.all(fl.promises);
+        inflight.delete(k);
+        if (v === undefined) {
+          // resolving to undefined deletes the entry (or restores the stale value it covered)
+          for (const r of results) if (r !== undefined) fail(`${step}: fetch resolved ${showVal(r)}, expected undefined`);
+          if (fl.stale !== undefined) {
+            if (cache.peek(k, { allowStale: true }) !== fl.stale) fail(`${step}: stale value ${showVal(fl.stale)} not restored, got ${showVal(cache.peek(k, { allowStale: true }))}`);
+          } else {
+            model.delete(k);
+            if (cache.has(k) || cache.peek(k, { allowStale: true }) !== undefined) fail(`${step}: entry still present after fetchMethod resolved undefined`);
+          }
+        } else {
+          for (const r of results) if (r !== v) fail(`${step}: fetch resolved ${showVal(r)}, expected ${showVal(v)}`);
+          model.set(k, { value: v, start: clock.t, ttl });
+          if (cache.peek(k) !== v) fail(`${step}: peek after resolution ${showVal(cache.peek(k))}, expected ${showVal(v)}`);
+        }
+        break;
+      }
+      case "reject": {
+        const d = pending.get(k);
+        const fl = inflight.get(k);
+        if (!d || !fl) {
+          count("reject-nothing");
+          break;
+        }
+        step = `reject(${k}) at ${clock.t}`;
+        const err = new Error(`boom ${i}`);
+        d.reject(err);
+        pending.delete(k);
+        await tick();
+        inflight.delete(k);
+        const settled = await Promise.allSettled(fl.promises);
+        if (allowStaleOnFetchRejection) {
+          // errors are suppressed: resolves to the stale value or undefined; the stale value stays
+          for (const s of settled) {
+            if (s.status !== "fulfilled" || s.value !== fl.stale) fail(`${step}: with allowStaleOnFetchRejection ${show(s)}, expected the stale ${showVal(fl.stale)}`);
+          }
+          if (fl.stale !== undefined && cache.peek(k, { allowStale: true }) !== fl.stale) fail(`${step}: stale value gone after a suppressed rejection`);
+          else if (fl.stale === undefined && cache.peek(k, { allowStale: true }) !== undefined) fail(`${step}: something cached after a rejected miss`);
+        } else {
+          for (const s of settled) {
+            if (s.status !== "rejected" || s.reason !== err) fail(`${step}: fetch ${show(s)}, expected rejection with the error`);
+          }
+          const kept = noDeleteOnFetchRejection && fl.stale !== undefined;
+          const got = cache.peek(k, { allowStale: true });
+          if (kept ? got !== fl.stale : got !== undefined) fail(`${step}: after rejection peek is ${showVal(got)}, expected ${kept ? showVal(fl.stale) : "undefined"} (noDeleteOnFetchRejection=${noDeleteOnFetchRejection})`);
+          if (!kept) model.delete(k);
+        }
+        break;
+      }
+      case "set": {
+        const v = `s${i}`;
+        step = `set(${k}, ${v}) at ${clock.t}`;
+        const fl = inflight.get(k);
+        cache.set(k, v);
+        model.set(k, { value: v, start: clock.t, ttl });
+        if (fl) {
+          // setting over a background fetch aborts it: the fetch promises reject with the abort reason (or resolve to the stale value)
+          await tick();
+          const settled = await Promise.allSettled(fl.promises);
+          for (const s of settled) {
+            if (s.status === "fulfilled" && s.value !== undefined && s.value !== fl.stale) fail(`${step}: an aborted fetch resolved ${showVal(s.value)}`);
+            if (s.status === "rejected" && !/replaced/.test(String(s.reason))) fail(`${step}: an aborted fetch rejected with ${s.reason}`);
+          }
+          inflight.delete(k);
+          pending.delete(k);
+          if (cache.peek(k) !== v) fail(`${step}: set over a fetch lost the value: ${showVal(cache.peek(k))}`);
+        }
+        break;
+      }
+      case "delete": {
+        step = `delete(${k}) at ${clock.t}`;
+        const fl = inflight.get(k);
+        cache.delete(k);
+        model.delete(k);
+        if (fl) {
+          await tick();
+          const settled = await Promise.allSettled(fl.promises);
+          for (const s of settled) {
+            if (s.status === "fulfilled" && s.value !== undefined && s.value !== fl.stale) fail(`${step}: a fetch aborted by delete resolved ${showVal(s.value)}`);
+          }
+          inflight.delete(k);
+          pending.delete(k);
+          if (cache.peek(k, { allowStale: true }) !== undefined) fail(`${step}: entry present after delete during a fetch`);
+        }
+        break;
+      }
+      case "get": {
+        const r = cache.get(k);
+        const e = model.get(k);
+        const fl = inflight.get(k);
+        if (fl) {
+          // the covered value is returned while it is still fresh (a forceRefresh), or when stale only with allowStale
+          const want = fl.stale !== undefined && (allowStale || (e && !isStale(e))) ? fl.stale : undefined;
+          if (r !== want) fail(`${step}: get during a fetch ${showVal(r)}, expected ${showVal(want)}`);
+        } else if (!e) {
+          if (r !== undefined) fail(`${step}: get of a missing key ${showVal(r)}`);
+        } else if (isStale(e)) {
+          if (r !== (allowStale ? e.value : undefined)) fail(`${step}: get of a stale entry ${showVal(r)} (allowStale=${allowStale})`);
+          model.delete(k);
+        } else if (r !== e.value) fail(`${step}: get ${showVal(r)}, expected ${showVal(e.value)}`);
+        break;
+      }
+      case "advance": {
+        clock.t += pick(tc, [1, 5, 10, 31]);
+        break;
+      }
+    }
+  }
+  // settle everything so no fetch outlives the case
+  for (const [k, d] of pending) d.resolve(`end-${k}`);
+  await Promise.allSettled([...inflight.values()].flatMap((f) => f.promises));
+  await tick();
+  // without a fetchMethod, fetch is an async get
+  const plain = new LRUCache({ max: 2 });
+  plain.set("k", 1);
+  if ((await plain.fetch("k")) !== 1 || (await plain.fetch("nope")) !== undefined) fail("fetch without fetchMethod is not Promise.resolve(get())");
+  await assert.rejects(plain.forceFetch("nope"), /undefined/);
+});
+
+// ---------------------------------------------------------------------------------------------
+// Pins for the recorded bugs (each must fail while the bug exists)
+
+pin("TestHegelPinZeroStartExpires", () => {
+  // lru-cache/1: the README's testing recipe starts its clock at 0
+  let t = 0;
+  const c = new LRUCache({ max: 10, ttl: 1000, ttlResolution: 0, perf: { now: () => t } });
+  c.set("a", 1);
+  t = 5000;
+  assert.equal(c.has("a"), false, "an entry set at clock 0 is stale after its ttl");
+  assert.equal(c.get("a"), undefined);
+  const c2 = new LRUCache({ max: 10, ttl: 1000, ttlResolution: 0, perf: { now: () => t } });
+  c2.set("b", 1, { start: 0 });
+  assert.ok(c2.getRemainingTTL("b") < 0, `start: 0 means an expired entry, remaining ${c2.getRemainingTTL("b")}`);
+});
+
+pin("TestHegelPinOversizeEntryRejected", () => {
+  // lru-cache/2: maxEntrySize above maxSize
+  const c = new LRUCache({ maxSize: 10, maxEntrySize: 20 });
+  c.set("a", 1, { size: 8 });
+  c.set("b", 2, { size: 15 });
+  assert.ok(c.calculatedSize >= 0, `calculatedSize ${c.calculatedSize}`);
+  assert.equal(c.calculatedSize, [...c.keys()].reduce((s, k) => s + c.info(k).size, 0), "calculatedSize is the sum of the entry sizes");
+  assert.ok(c.has("a") || c.has("b"), "an entry that cannot fit does not empty the cache");
+});
+
+pin("TestHegelPinDisposeAfterEviction", () => {
+  // lru-cache/3
+  const log = [];
+  const c = new LRUCache({ max: 1, noDisposeOnSet: true, disposeAfter: (v, k, r) => log.push([k, r]) });
+  c.set("a", 1);
+  c.set("b", 2);
+  assert.deepEqual(log, [["a", "evict"]], "disposeAfter runs for the eviction within the set() that caused it");
+});
+
+pin("TestHegelPinSameValueSetSize", () => {
+  // lru-cache/4
+  const c = new LRUCache({ maxSize: 100 });
+  c.set("k", "v", { size: 5 });
+  c.set("k", "v", { size: 50 });
+  assert.equal(c.info("k").size, 50);
+  assert.equal(c.calculatedSize, 50);
+});
