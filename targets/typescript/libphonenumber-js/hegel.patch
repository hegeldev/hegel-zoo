@@ -0,0 +1,457 @@
+// Hegel zoo: the generators behind the libphonenumber-js properties, as values built from
+// Hegel's combinators, and the pure functions that render what they draw.
+//
+// A case is a phone number - calling code, national number, region - drawn from the metadata both
+// libraries share (Google's example numbers, examples with a few digits edited, digit strings of
+// the region's possible lengths, noise) and, independently, a `notation` record: the way the number
+// is written down (E.164, international with separators, national with or without the national
+// prefix, IDD-dialled, RFC 3966 tel: URI, the calling code without a plus, an extension in one of
+// eleven spellings, whitespace around the text), which `render` turns into text. The shapes of the
+// recorded bugs (bugs.toml) are drawn like any other, so the properties find the bugs and fail on
+// them; the last section draws each bug's shape region on its own and, under HEGEL_NO_KNOWN=1
+// (`noKnown`), the neighbouring region instead.
+
+import { createRequire } from "node:module";
+import fs from "node:fs";
+import { gs, noKnown } from "./hegel-zoo.mjs";
+import Metadata, { getExtPrefix } from "../source/metadata.js";
+import parsePhoneNumber from "../source/parsePhoneNumber.js";
+
+const require = createRequire(import.meta.url);
+export const G = require("../.hegel/node_modules/google-libphonenumber");
+export const util = G.PhoneNumberUtil.getInstance();
+export const PNF = G.PhoneNumberFormat;
+export const metadata = JSON.parse(fs.readFileSync(new URL("./metadata.json", import.meta.url)));
+const allExamples = JSON.parse(fs.readFileSync(new URL("./metadata.examples.json", import.meta.url)));
+// the shape of the package's examples.mobile.json: one national number per country (mobile, else fixed line)
+export const examples = Object.fromEntries(Object.entries(allExamples).map(([c, ex]) => [c, ex.mobile || ex.fixed_line]).filter(([, v]) => v));
+
+/** ZOO_FULL=1: the documented differences from the oracle are drawn and checked too (text around the number, full-width digits, the as-you-type text; see README). */
+export const FULL = !!process.env.ZOO_FULL;
+
+export const TYPES = Object.keys(G.PhoneNumberType).filter((t) => t !== "UNKNOWN");
+export const TYPE_NUM = Object.fromEntries(TYPES.map((t) => [t, G.PhoneNumberType[t]]));
+export const NUM_TYPE = Object.fromEntries(TYPES.map((t) => [G.PhoneNumberType[t], t]));
+
+export const COUNTRIES = new Metadata(metadata).getCountries().sort();
+// the non-geographic calling codes (800, 808, 870, ...) as strings
+export const NON_GEO = util.getSupportedGlobalNetworkCallingCodes().map(String);
+// a few countries with rich metadata get extra weight
+const COMMON = ["US", "GB", "DE", "FR", "RU", "BR", "IN", "CN", "JP", "AU", "IT", "ES", "MX", "AR", "CO", "NG", "ZA", "KR", "PL", "NL"];
+
+// ---------------------------------------------------------------- metadata lookups (pure, cached)
+
+const plans = new Map();
+/** The library's metadata with the numbering plan of `region` (a country or a calling code) selected. */
+export function plan(region) {
+  if (!plans.has(region)) {
+    const m = new Metadata(metadata);
+    m.selectNumberingPlan(region);
+    plans.set(region, m);
+  }
+  return plans.get(region);
+}
+export const callingCode = (region) => String(util.getCountryCodeForRegion(region));
+export const mainCountry = (cc) => util.getRegionCodeForCountryCode(Number(cc));
+const exampleTypesOf = new Map();
+/** The types Google has an example number of `region` for. */
+export function exampleTypes(region) {
+  if (!exampleTypesOf.has(region)) exampleTypesOf.set(region, TYPES.filter((t) => util.getExampleNumberForType(region, TYPE_NUM[t])));
+  return exampleTypesOf.get(region);
+}
+/** Google's example national significant number of `region` for `type`. */
+export const exampleNational = (region, type) => util.getNationalSignificantNumber(util.getExampleNumberForType(region, TYPE_NUM[type]));
+/** Whether `country`'s extension prefix differs from its calling code's main country's, which it does not inherit (libphonenumber-js/9). */
+export function extPrefixNotInherited(country) {
+  if (!country) return false;
+  const main = mainCountry(callingCode(country));
+  return country !== main && getExtPrefix(country, metadata) !== getExtPrefix(main, metadata);
+}
+
+// ---------------------------------------------------------------- generator helpers
+
+export const ints = (lo, hi) => gs.integers({ minValue: lo, maxValue: hi });
+
+/** oneOf with weights: `weighted([45, a], [55, b])` draws a 45 times in 100; shrinks towards the first choice. */
+export function weighted(...choices) {
+  if (choices.length === 1) return choices[0][1];
+  const total = choices.reduce((sum, [w]) => sum + w, 0);
+  return ints(0, total - 1).flatMap((r) => {
+    for (const [w, g] of choices) {
+      if (r < w) return g;
+      r -= w;
+    }
+    throw new Error("unreachable");
+  });
+}
+
+/** True pct percent of the time; shrinks to false. */
+export const chance = (pct) => ints(0, 99).map((r) => r >= 100 - pct);
+/** A draw from g pct percent of the time, else undefined (listed first: shrinks to absent). */
+export const maybe = (pct, g) => weighted([100 - pct, gs.just(undefined)], [pct, g]);
+export const pick = (xs) => gs.sampledFrom(xs);
+/** A string constant as a generator, a generator as it is. */
+const lift = (p) => (typeof p === "string" ? gs.just(p) : p);
+/** The texts of `parts` (generators or string constants) concatenated. */
+export const cat = (...parts) => gs.tuples(...parts.map(lift)).map((xs) => xs.join(""));
+/** `lo` to `hi` decimal digits. */
+export const digits = (lo, hi) => gs.text({ alphabet: "0123456789", minSize: lo, maxSize: hi });
+const DIGIT = pick([..."0123456789"]);
+const NONZERO = pick([..."123456789"]);
+
+// ---------------------------------------------------------------- phone numbers
+
+/** A country: one of twenty with rich metadata 40% of the time, else any. */
+export const country = weighted([40, pick(COMMON)], [60, pick(COUNTRIES)]);
+
+/** Google's example national number of `region` for a drawn type. */
+const exampleOf = (region) => pick(exampleTypes(region)).map((type) => exampleNational(region, type));
+
+/** Edits to a national number: 1-3 digits replaced (positions modulo the length), a digit appended 20% of the time, the last one dropped 20%. */
+const mutation = gs.record({ edits: gs.arrays(gs.record({ at: ints(0, 99), digit: DIGIT }), { minSize: 1, maxSize: 3 }), push: maybe(20, DIGIT), pop: chance(20) });
+export function mutate(national, { edits, push, pop }) {
+  const chars = national.split("");
+  for (const { at, digit } of edits) chars[at % chars.length] = digit;
+  if (push !== undefined) chars.push(push);
+  if (pop && chars.length > 2) chars.pop();
+  return chars.join("");
+}
+
+/** A digit string of one of `lengths`, its first digit nonzero 80% of the time. */
+const ofLength = (lengths) => pick(lengths).flatMap((len) => weighted([80, cat(NONZERO, digits(len - 1, len - 1))], [20, digits(len, len)]));
+
+/**
+ * A national number for `region` with the shape it came from: Google's example of a drawn type
+ * (2 in 7), an example with a few digits edited (2), a digit string of one of the region's
+ * possible lengths (2), 1-17 noise digits (1).
+ */
+export function nationalNumber(region) {
+  const choices = [];
+  if (exampleTypes(region).length > 0) {
+    const example = exampleOf(region);
+    choices.push([2, example.map((national) => ({ national, shape: "example" }))]);
+    choices.push([2, gs.tuples(example, mutation).map(([ex, m]) => ({ national: mutate(ex, m), shape: "mutated" }))]);
+  }
+  const lengths = plan(region).possibleLengths();
+  if (lengths && lengths.length > 0) choices.push([2, ofLength(lengths).map((national) => ({ national, shape: "length" }))]);
+  choices.push([1, digits(1, 17).map((national) => ({ national, shape: "noise" }))]);
+  return weighted(...choices);
+}
+
+/** A geographic number: a country, its calling code and a national number for it. */
+const geographic = country.flatMap((region) => nationalNumber(region).map(({ national, shape }) => ({ cc: callingCode(region), national, region, shape })));
+
+/** A number of a non-geographic calling code (800, 808, 870, ...): Google's example for it 60% of the time, else 4-12 digits. */
+const nonGeographic = pick(NON_GEO).flatMap((cc) => {
+  const ex = util.getExampleNumberForNonGeoEntity(Number(cc));
+  const national = ex ? weighted([60, gs.just(util.getNationalSignificantNumber(ex))], [40, digits(4, 12)]) : digits(4, 12);
+  return national.map((n) => ({ cc, national: n, region: undefined, shape: "non-geo" }));
+});
+
+/** A complete number { cc, national, region, shape }: geographic 95% of the time, non-geographic 5% (region undefined). */
+export const phoneNumber = weighted([95, geographic], [5, nonGeographic]);
+
+// ---------------------------------------------------------------- notations
+
+const SEPARATORS = [" ", "-", ".", "  ", " - ", "/"];
+/** Digit grouping: a separator and group sizes recycled over the digits. */
+const grouping = gs.record({ sep: pick(SEPARATORS), sizes: gs.arrays(ints(1, 4), { minSize: 1, maxSize: 6 }) });
+/** `ds` in groups per `g` (as they are when g is undefined or there are two digits or fewer). */
+export function group(ds, g) {
+  if (!g || ds.length <= 2) return ds;
+  let out = "";
+  for (let i = 0, k = 0; i < ds.length; k++) {
+    const n = g.sizes[k % g.sizes.length];
+    out += (out ? g.sep : "") + ds.slice(i, i + n);
+    i += n;
+  }
+  return out;
+}
+
+export const NOTATIONS = ["e164", "e164", "international", "international", "national", "national", "national-prefix", "idd", "rfc3966", "plus-cc-grouped", "digits-cc"];
+export const EXT_SHAPES = [" ext. ", " ext ", " x", " x. ", ";ext=", " extension ", " #", "#", " ~", " int. ", "extn"];
+const WHITESPACE = gs.record({ before: pick(["", " ", "\t"]), after: pick(["", " ", "\n"]) });
+const JUNK = gs.record({ before: pick(["Call: ", "tel ", "phone: ", "  "]), after: pick(["", " (home)", ".", " today"]) });
+
+/**
+ * How a number is written down, independent of the number: the notation (E.164, international
+ * and national twice as often as the rest), no default country half the time where the text
+ * carries the calling code, digit grouping 70% of the time, the area code in parentheses 30%
+ * (national notation), a space after the national prefix 50%, the country dialled from (IDD
+ * notation; also the default country of a `digits-cc` text 30% of the time), an extension 20%
+ * in one of eleven spellings, whitespace around the text 10%; under ZOO_FULL, text around the
+ * number 10% and full-width digits 5%.
+ */
+export const notation = gs.record({
+  how: pick(NOTATIONS),
+  noDefault: chance(50),
+  grouping: maybe(70, grouping),
+  parens: chance(30),
+  prefixSpace: chance(50),
+  from: country,
+  fromDefault: chance(30),
+  ext: maybe(20, gs.record({ digits: digits(1, 5), spelling: pick(EXT_SHAPES) })),
+  whitespace: maybe(10, WHITESPACE),
+  junk: FULL ? maybe(10, JUNK) : gs.just(undefined),
+  fullwidth: FULL ? chance(5) : gs.just(false),
+});
+
+/**
+ * The text of `pn` in notation `st`: { text, defaultCountry, ext, shapes, how }, where `ext` is
+ * the extension the text carries (or undefined) and `shapes` lists the notations used. A
+ * national notation of a non-geographic number, or an IDD notation from a country whose prefix
+ * is not plain digits, falls back to E.164.
+ */
+export function render(pn, st) {
+  const { cc, national, region } = pn;
+  const shapes = [];
+  const e164 = `+${cc}${national}`;
+  let defaultCountry = region;
+  let text;
+  const international = () => {
+    if (st.noDefault) defaultCountry = undefined;
+  };
+  switch (st.how) {
+    case "e164":
+      text = e164;
+      international();
+      break;
+    case "international":
+      text = `+${cc} ${group(national, st.grouping)}`;
+      international();
+      break;
+    case "plus-cc-grouped":
+      text = `+${group(cc + national, st.grouping)}`;
+      international();
+      break;
+    case "national":
+      if (!region) { text = e164; break; }
+      // the national significant number, grouped, sometimes with the area code in parentheses
+      text = st.parens && national.length > 4 ? `(${national.slice(0, 3)}) ${group(national.slice(3), st.grouping)}` : group(national, st.grouping);
+      break;
+    case "national-prefix": {
+      if (!region) { text = e164; break; }
+      const ndd = util.getNddPrefixForRegion(region, true);
+      if (!ndd) { text = group(national, st.grouping); break; }
+      text = `${ndd}${st.prefixSpace ? " " : ""}${group(national, st.grouping)}`;
+      shapes.push("national-prefix");
+      break;
+    }
+    case "idd": {
+      // dialled from `st.from` with its international prefix
+      const idd = plan(st.from).IDDPrefix();
+      if (!idd || /[^0-9]/.test(idd)) { text = e164; break; }
+      defaultCountry = st.from;
+      text = `${idd} ${cc} ${group(national, st.grouping)}`;
+      shapes.push("idd");
+      break;
+    }
+    case "rfc3966":
+      text = `tel:+${cc}-${national.match(/.{1,4}/g).join("-")}`;
+      shapes.push("rfc3966");
+      international();
+      break;
+    case "digits-cc":
+      // the country calling code without a plus: read as a national number of the default country
+      text = `${cc}${national}`;
+      if (!region || st.fromDefault) defaultCountry = st.from;
+      shapes.push("digits-cc");
+      break;
+  }
+  let ext;
+  if (st.ext !== undefined && national.length >= 3) {
+    ext = st.ext.digits;
+    text += (st.how === "rfc3966" ? ";ext=" : st.ext.spelling) + ext;
+    shapes.push("ext");
+  }
+  if (st.junk !== undefined) {
+    text = st.junk.before + text + st.junk.after;
+    shapes.push("junk");
+  }
+  if (st.fullwidth) {
+    text = text.replace(/[0-9]/g, (d) => String.fromCharCode(0xff10 + Number(d)));
+    shapes.push("fullwidth");
+  }
+  if (st.whitespace !== undefined && st.whitespace.before + st.whitespace.after !== "") {
+    text = st.whitespace.before + text + st.whitespace.after;
+    shapes.push("whitespace");
+  }
+  return { text, defaultCountry, ext, shapes, how: st.how };
+}
+
+/** Text that is not a phone number (or barely one). */
+export const JUNK_TEXTS = ["", " ", "+", "abc", "+1", "1", "12", "()", "tel:", "+-", "000", "ext. 123", "1 2", "+999 12345678", "+0 12345"];
+
+// ---------------------------------------------------------------- the recorded bugs' shape regions
+//
+// One generator per bug in bugs.toml over the region where the bug shows, with random contents
+// (Google's example numbers with their last digits replaced, random extensions, groupings and
+// whitespace); under HEGEL_NO_KNOWN=1 the neighbouring region, where the same checks pass.
+
+const WITH_EXAMPLES = COUNTRIES.filter((c) => exampleTypes(c).length > 0);
+/** A valid number: Google's example of a drawn type of a drawn country, with its region and type. */
+export const validNumber = pick(WITH_EXAMPLES).flatMap((region) => pick(exampleTypes(region)).map((type) => ({ region, type, cc: callingCode(region), national: exampleNational(region, type) })));
+
+/** 1-2 replacement digits for the end of a number (the prefix that selects the country, the type and the format stays). */
+const tailEdit = digits(1, 2);
+/** `national` with its last digits replaced by `t`. */
+export const withTail = (national, t) => national.slice(0, Math.max(0, national.length - t.length)) + t;
+/** Google's example of `type` in `region` with its last 1-2 digits replaced. */
+const editedExample = (region, type) => tailEdit.map((t) => ({ region, type, cc: callingCode(region), national: withTail(exampleNational(region, type), t) }));
+/** Whether the library's parse of `pn`'s E.164 text attributes it to `pn.region` (a shared pattern can put a dependency's number in the main country). */
+const attributed = (pn) => {
+  const parsed = parsePhoneNumber(`+${pn.cc}${pn.national}`, { extract: false }, metadata);
+  return parsed !== undefined && parsed.country === pn.region;
+};
+
+const hasType = (region, t) => !!plan(region).type(t);
+/** The countries whose plan has a fixed-line pattern and no mobile one (Tristan da Cunha alone), and those with both and a fixed-line example. */
+export const NO_MOBILE_COUNTRIES = WITH_EXAMPLES.filter((c) => hasType(c, "FIXED_LINE") && !hasType(c, "MOBILE") && exampleTypes(c).includes("FIXED_LINE"));
+const BOTH_TYPES_COUNTRIES = WITH_EXAMPLES.filter((c) => hasType(c, "FIXED_LINE") && hasType(c, "MOBILE") && exampleTypes(c).includes("FIXED_LINE"));
+/** libphonenumber-js/1: a fixed-line number (the example with its last digits replaced) of a country without a mobile pattern; under HEGEL_NO_KNOWN=1 of a country with both patterns. */
+export const fixedLineWithoutMobile = pick(noKnown ? BOTH_TYPES_COUNTRIES : NO_MOBILE_COUNTRIES).flatMap((region) => editedExample(region, "FIXED_LINE"));
+
+/**
+ * libphonenumber-js/2: a valid number as an RFC 3966 tel: URI - `tel:+<cc>-` and the national
+ * number in groups of 1-4 digits behind dashes, an extension 30% of the time; under
+ * HEGEL_NO_KNOWN=1 the same text without the `tel:` scheme.
+ */
+export const telUri = gs.record({ pn: validNumber, sizes: gs.arrays(ints(1, 4), { minSize: 1, maxSize: 4 }), ext: maybe(30, digits(1, 5)) }).map(({ pn, sizes, ext }) => ({
+  pn,
+  ext,
+  text: `${noKnown ? "" : "tel:"}+${pn.cc}-${group(pn.national, { sep: "-", sizes })}${ext === undefined ? "" : `;ext=${ext}`}`,
+}));
+
+const LEADING = [" ", "\t", "\n", "  ", " \t"];
+const TRAILING = [" ", "\n", "\t", "  ", "\r\n"];
+/**
+ * libphonenumber-js/3: a valid number in E.164 or national notation with whitespace before it,
+ * after it or both; under HEGEL_NO_KNOWN=1 only the placements the strict parse accepts (spaces
+ * after the number, spaces before a national number's first digit).
+ */
+export const spacedNumber = gs.record({
+  pn: validNumber,
+  national: chance(50),
+  where: pick(["before", "after", "both"]),
+  before: pick(noKnown ? [" ", "  "] : LEADING),
+  after: pick(noKnown ? [" ", "  "] : TRAILING),
+}).map(({ pn, national, where, before, after }) => {
+  const useNational = national || (noKnown && where !== "after");
+  const body = useNational ? pn.national : `+${pn.cc}${pn.national}`;
+  return { pn, text: (where === "after" ? "" : before) + body + (where === "before" ? "" : after), defaultCountry: useNational ? pn.region : undefined };
+});
+
+// libphonenumber-js/4: the (country, type) pairs whose Google example, typed one digit at a time,
+// formats differently from the same digits given at once, with the input modes that show it
+// (probed over every example number of the shared metadata, 2026-09-26), and the +800 numbers.
+const CHUNKING_SHAPES = [
+  ["AD", "TOLL_FREE", "national", "international"], ["CN", "FIXED_LINE", "international"], ["CN", "FIXED_LINE_OR_MOBILE", "international"],
+  ["IR", "FIXED_LINE", "international"], ["IR", "FIXED_LINE_OR_MOBILE", "international"], ["MV", "PREMIUM_RATE", "national", "international"],
+  ["NF", "FIXED_LINE", "national"], ["NF", "FIXED_LINE_OR_MOBILE", "national"], ["PH", "FIXED_LINE", "international"], ["PH", "FIXED_LINE_OR_MOBILE", "international"],
+  ["PM", "TOLL_FREE", "international"], ["PM", "PREMIUM_RATE", "international"], ["TJ", "MOBILE", "national", "international"],
+  ["UY", "FIXED_LINE", "national", "international"], ["UY", "FIXED_LINE_OR_MOBILE", "national", "international"], ["WF", "TOLL_FREE", "national", "international"],
+];
+const CHUNKING_REGIONS = new Set(CHUNKING_SHAPES.map(([region]) => region));
+/** The as-you-type input for `pn` in `mode`: the national number with its region as the default country, or +cc and the number with none. */
+const typedInput = (pn, mode) => (mode === "national" ? { chars: pn.national, defaultCountry: pn.region, cc: pn.cc } : { chars: `+${pn.cc}${pn.national}`, defaultCountry: undefined, cc: pn.cc });
+/**
+ * libphonenumber-js/4: one of those examples with its last digits replaced, in a mode that shows
+ * the shape, or a +800 number (Google's example with its last digits replaced) 1 time in 8;
+ * under HEGEL_NO_KNOWN=1 an edited example of any other country in either mode.
+ */
+export const chunkedNumber = noKnown
+  ? gs.record({ pn: validNumber.filter((pn) => !CHUNKING_REGIONS.has(pn.region)), t: tailEdit, mode: pick(["international", "national"]) }).map(({ pn, t, mode }) => typedInput({ ...pn, national: withTail(pn.national, t) }, mode))
+  : weighted(
+    [7, pick(CHUNKING_SHAPES).flatMap(([region, type, ...modes]) => gs.tuples(editedExample(region, type), pick(modes)).map(([pn, mode]) => typedInput(pn, mode)))],
+    [1, tailEdit.map((t) => typedInput({ cc: "800", national: withTail(util.getNationalSignificantNumber(util.getExampleNumberForNonGeoEntity(800)), t), region: undefined }, "international"))],
+  );
+
+/** The territories of calling code 1 other than its main country (their metadata carries leadingDigits). */
+export const NANPA_TERRITORIES = WITH_EXAMPLES.filter((c) => callingCode(c) === "1" && c !== mainCountry("1") && typeof plan(c).leadingDigits() === "string");
+/**
+ * libphonenumber-js/5: a ten-digit number of such a territory (Google's example of a drawn type
+ * with its last digits replaced) typed in national mode with the territory as the default
+ * country; under HEGEL_NO_KNOWN=1 typed as +1 and the number.
+ */
+export const nanpaTerritoryNumber = pick(NANPA_TERRITORIES).flatMap((region) => pick(exampleTypes(region)).flatMap((type) => editedExample(region, type))).map((pn) => typedInput(pn, noKnown ? "international" : "national"));
+
+/**
+ * libphonenumber-js/6: a valid number (Google's example, its last digits replaced half the time)
+ * for the one-argument PhoneNumber constructor (its E.164 text); under HEGEL_NO_KNOWN=1 an
+ * example the parse attributes to its country, for the two-argument form (country, national number).
+ */
+export const constructedNumber = noKnown
+  ? validNumber.filter(attributed)
+  : gs.record({ pn: validNumber, t: maybe(50, tailEdit) }).map(({ pn, t }) => (t === undefined ? pn : { ...pn, national: withTail(pn.national, t) }));
+
+// libphonenumber-js/7: the (country, type) pairs whose Google example starts with what the plan's
+// nationalPrefixForParsing matches (Russia's, Kazakhstan's and Belarus's 8xx numbers, Lithuania's
+// 8xx numbers under its old prefix, Norfolk Island's six-digit numbers and their transform rule)
+// while the number is possible as typed (probed over every example, 2026-09-26).
+const NATIONAL_PREFIX_SHAPES = [
+  ["BY", "TOLL_FREE"], ["KZ", "TOLL_FREE"], ["KZ", "PREMIUM_RATE"], ["KZ", "PERSONAL_NUMBER"], ["LT", "TOLL_FREE"], ["LT", "SHARED_COST"], ["LT", "VOIP"],
+  ["NF", "FIXED_LINE"], ["NF", "FIXED_LINE_OR_MOBILE"], ["RU", "TOLL_FREE"], ["RU", "PREMIUM_RATE"], ["RU", "PERSONAL_NUMBER"],
+];
+const isPrefixShape = (region, type) => NATIONAL_PREFIX_SHAPES.some(([r, t]) => r === region && t === type);
+const NATIONAL_PREFIX_REGIONS = [...new Set(NATIONAL_PREFIX_SHAPES.map(([region]) => region))];
+/** The other (country, type) pairs of the same countries: numbers the national prefix rules leave alone. */
+const NATIONAL_PREFIX_NEIGHBOURS = NATIONAL_PREFIX_REGIONS.flatMap((region) => exampleTypes(region).filter((t) => !isPrefixShape(region, t)).map((t) => [region, t]));
+/** libphonenumber-js/7: one of those examples with its last digits replaced, for national-mode input; under HEGEL_NO_KNOWN=1 an edited example of another type of the same countries. */
+export const nationalPrefixNumber = pick(noKnown ? NATIONAL_PREFIX_NEIGHBOURS : NATIONAL_PREFIX_SHAPES).flatMap(([region, type]) => editedExample(region, type));
+
+/** The countries whose international (IDD) prefix is plain digits (00, 011, 810, ...). */
+export const DIGIT_IDD_COUNTRIES = COUNTRIES.filter((c) => /^[0-9]+$/.test(plan(c).IDDPrefix() || ""));
+/**
+ * libphonenumber-js/8: a valid number of any country dialled from such a country in national
+ * mode as its IDD prefix, the calling code and the national number; under HEGEL_NO_KNOWN=1 as
+ * `+`, the calling code and the national number, with the same default country.
+ */
+export const iddDialled = gs.record({ from: pick(DIGIT_IDD_COUNTRIES), pn: validNumber }).map(({ from, pn }) => ({
+  chars: `${noKnown ? "+" : plan(from).IDDPrefix()}${pn.cc}${pn.national}`,
+  defaultCountry: from,
+  cc: pn.cc,
+}));
+
+/** The countries that do not inherit the extension prefix of their calling code's main country (the +44 dependencies of GB), and those main countries. */
+export const INHERITED_EXT_COUNTRIES = WITH_EXAMPLES.filter(extPrefixNotInherited);
+const EXT_MAIN_COUNTRIES = [...new Set(INHERITED_EXT_COUNTRIES.map((c) => mainCountry(callingCode(c))))];
+/** The (country, type) pairs of those countries whose example the parse attributes to the country (the mobile and other shared patterns put a dependency's example in the main country). */
+const attributedPairs = (countries) => countries.flatMap((region) => exampleTypes(region).filter((type) => attributed({ region, cc: callingCode(region), national: exampleNational(region, type) })).map((type) => [region, type]));
+const INHERITED_EXT_PAIRS = attributedPairs(INHERITED_EXT_COUNTRIES);
+const EXT_MAIN_PAIRS = attributedPairs(EXT_MAIN_COUNTRIES);
+/** libphonenumber-js/9: a valid number of such a country (the example, its last digits replaced half the time, attributed to the country) with a 1-5 digit extension; under HEGEL_NO_KNOWN=1 a number of the main country. */
+export const numberWithInheritedExt = pick(noKnown ? EXT_MAIN_PAIRS : INHERITED_EXT_PAIRS).flatMap(([region, type]) =>
+  gs.record({ pn: gs.tuples(maybe(50, tailEdit)).map(([t]) => ({ region, type, cc: callingCode(region), national: t === undefined ? exampleNational(region, type) : withTail(exampleNational(region, type), t) })).filter(attributed), ext: digits(1, 5) }).map(({ pn, ext }) => ({ ...pn, ext })),
+);
+
+/** libphonenumber-js/10: a digit IDD prefix typed in national mode followed by a 0 and 1-8 digits (no calling code starts with 0); under HEGEL_NO_KNOWN=1 followed by the calling code and national number of a valid number. */
+export const iddWithoutCallingCode = noKnown
+  ? gs.record({ from: pick(DIGIT_IDD_COUNTRIES), pn: validNumber }).map(({ from, pn }) => ({ chars: `${plan(from).IDDPrefix()}${pn.cc}${pn.national}`, defaultCountry: from }))
+  : gs.record({ from: pick(DIGIT_IDD_COUNTRIES), rest: digits(1, 8) }).map(({ from, rest }) => ({ chars: `${plan(from).IDDPrefix()}0${rest}`, defaultCountry: from }));
+
+/**
+ * libphonenumber-js/11: the countries where the formatter, typed one digit at a time, drops the
+ * default country's calling code from the front of digits that are no valid number of the country
+ * while the parse keeps it (probed over every country with its example number lengthened or
+ * prefixed by a digit, 2026-09-26; the shape needs the remainder to be invalid and is met in about
+ * half of such numbers of these countries).
+ */
+const OWN_CALLING_CODE_COUNTRIES = ["WS", "PH", "TH", "UY", "CH", "FJ", "RU", "IL", "IN", "BZ", "CX", "PA"];
+/** The calling code in front of a variant of the country's example national number - a digit appended, two appended, or one prepended - so that the remainder is no valid number; under HEGEL_NO_KNOWN=1 the example itself. */
+export const ownCallingCodeNumber = pick(OWN_CALLING_CODE_COUNTRIES).flatMap((region) =>
+  pick(exampleTypes(region)).flatMap((type) => {
+    const nsn = exampleNational(region, type);
+    const variant = noKnown ? gs.just(nsn) : weighted([1, digits(1, 1).map((d) => nsn + d)], [1, digits(2, 2).map((d) => nsn + d)], [1, ints(1, 9).map((d) => d + nsn)]);
+    return variant.map((national) => ({ chars: callingCode(region) + national, defaultCountry: region }));
+  }),
+);
+
+/** libphonenumber-js/12: the countries where the parse strips a national prefix written after the calling code of an international number and the formatter keeps it (probed over every country with a digit national prefix and random national numbers, 2026-09-26). */
+const PREFIX_AFTER_CALLING_CODE_COUNTRIES = ["UY", "BY", "CO"];
+/** `+`, the calling code, the national prefix and a random national number of the example's length (first digit nonzero); under HEGEL_NO_KNOWN=1 without the national prefix. */
+export const internationalWithNationalPrefix = pick(PREFIX_AFTER_CALLING_CODE_COUNTRIES).flatMap((region) =>
+  pick(exampleTypes(region)).flatMap((type) => {
+    const len = exampleNational(region, type).length;
+    return gs.tuples(ints(1, 9), digits(len - 1, len - 1)).map(([d, rest]) => `+${callingCode(region)}${noKnown ? "" : plan(region).nationalPrefix()}${d}${rest}`);
+  }),
+);
diff --git a/hegel/generate-metadata.mjs b/hegel/generate-metadata.mjs
new file mode 100644
index 0000000..e66f904
--- /dev/null
+++ b/hegel/generate-metadata.mjs
@@ -0,0 +1,20 @@
+// Generates libphonenumber-js "max" metadata (with phone number type patterns) from the copy of
+// Google's PhoneNumberMetadata.xml that matches the oracle's release, so both sides of the
+// differential run on the same metadata. Usage: node hegel/generate-metadata.mjs <xml> <out.json>
+import fs from "node:fs";
+import { createRequire } from "node:module";
+
+// The package's ESM entry uses extensionless imports, so the CommonJS build is loaded instead.
+const require = createRequire(import.meta.url);
+const { generate, minify } = require("../.hegel/node_modules/libphonenumber-metadata-generator/index.commonjs.js");
+
+const [xmlPath, outPath] = process.argv.slice(2);
+const xml = fs.readFileSync(xmlPath, "utf8");
+const full = await generate(xml, { withPhoneNumberTypes: true, withPhoneNumberTypeExamples: true });
+fs.writeFileSync(outPath, JSON.stringify(minify(full)));
+const examples = {};
+for (const [country, { examples: ex }] of Object.entries(full.countries)) {
+  if (ex) examples[country] = ex;
+}
+fs.writeFileSync(outPath.replace(/\.json$/, ".examples.json"), JSON.stringify(examples));
+console.log(`wrote ${outPath} (${fs.statSync(outPath).size} bytes), ${Object.keys(full.countries).length} countries`);
diff --git a/hegel/hegel-zoo.mjs b/hegel/hegel-zoo.mjs
new file mode 100644
index 0000000..98df203
--- /dev/null
+++ b/hegel/hegel-zoo.mjs
@@ -0,0 +1,116 @@
+// Hegel zoo: the small harness shared by the zoo's TypeScript/JavaScript targets.
+//
+// `property(name, body)` registers a node:test test that runs `body(tc)` under Hegel with
+// HEGEL_TEST_CASES cases (default 100) and the database at HEGEL_DATABASE. With ZOO_COLLECT=1
+// a `fail()` records the mismatch instead of failing, the case ends there, and the counts of
+// mismatches and of the shapes seen (`count(key)`) are printed at the end of the test, so a
+// property can be run over many cases to see every shape at once. `pin(name, body)` is a
+// plain test for one pinned bug: it must fail while the bug is present and pass once it is
+// fixed (the zoo's judge reads an unexpected pass as "fixed upstream?"). HEGEL_NO_KNOWN=1
+// (`noKnown`, read once here) asks for a run that looks past the recorded bugs: the properties
+// then skip the checks their shapes falsify, and the one-bug properties draw the neighbouring
+// region instead.
+
+import { readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+import { test as nodeTest } from "node:test";
+
+// The Hegel version these tests were written against (the zoo pins it in zoo.toml; upstream
+// would add it to devDependencies). Hegel and the oracle are installed with `npm install --prefix
+// .hegel` so the target's own package.json and lock file stay untouched. Checked at load time so
+// a stray install cannot silently change the engine.
+export const HEGEL_PIN = { "@hegeldev/hegel": "0.4.5" };
+
+const hegelDir = join(dirname(fileURLToPath(import.meta.url)), "..", ".hegel", "node_modules", "@hegeldev", "hegel");
+{
+  const installed = JSON.parse(readFileSync(join(hegelDir, "package.json"), "utf8")).version;
+  if (installed !== HEGEL_PIN["@hegeldev/hegel"]) {
+    throw new Error(`@hegeldev/hegel ${installed} is installed; these tests pin ${HEGEL_PIN["@hegeldev/hegel"]}`);
+  }
+}
+const hegel = await import(pathToFileURL(join(hegelDir, "dist", "index.js")));
+const gs = await import(pathToFileURL(join(hegelDir, "dist", "generators", "index.js")));
+
+/** Hegel's generators, re-exported so the tests import everything from one place. */
+export { gs };
+
+export const collecting = !!process.env.ZOO_COLLECT;
+
+/** HEGEL_NO_KNOWN=1: look past the shapes of the recorded bugs (they are drawn, and fail, by default). */
+export const noKnown = !!process.env.HEGEL_NO_KNOWN;
+
+class Collected extends Error {}
+
+let msgs = [];
+let stats = new Map();
+
+/** Report a mismatch: an error normally, a recorded line in collect mode. */
+export function fail(message) {
+  if (collecting) {
+    msgs.push(message);
+    throw new Collected(message);
+  }
+  throw new Error(message);
+}
+
+/** Bump a statistic (the shape of a pinned bug, a generator branch). */
+export function count(key) {
+  stats.set(key, (stats.get(key) || 0) + 1);
+}
+
+function settings() {
+  const s = { testCases: Number(process.env.HEGEL_TEST_CASES) || 100 };
+  if (process.env.HEGEL_DATABASE) {
+    s.database = hegel.Database.fromPath(process.env.HEGEL_DATABASE);
+  }
+  return s;
+}
+
+// Hegel keys its example database by the test function's source text. Every property here runs
+// through the same wrapper, so without this every property would share one key and replay the
+// stored failing examples of all the others; the key is the test's name instead.
+function keyed(name, fn) {
+  fn.toString = () => name;
+  return fn;
+}
+
+function report(name) {
+  if (collecting) {
+    const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+    console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+    for (const m of msgs.slice(0, 25)) {
+      console.log(`#   ${m.split("\n").join("\n#   ")}`);
+    }
+  }
+}
+
+/** A property: `body(tc)` runs under Hegel; a thrown error (or `fail`) is a failure. */
+export function property(name, body, { skip } = {}) {
+  nodeTest(name, { skip }, () => {
+    msgs = [];
+    stats = new Map();
+    hegel.test(keyed(name, (tc) => {
+      if (collecting) count("cases");
+      try {
+        body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }), settings());
+    report(name);
+  });
+}
+
+/** A pin: a plain test for one recorded bug. */
+export function pin(name, body) {
+  nodeTest(name, body);
+}
+
+/** A compact, unambiguous rendering for messages. */
+export function show(x) {
+  return JSON.stringify(x, (k, v) => (v === undefined ? "<undefined>" : v));
+}
diff --git a/hegel/hegel.test.mjs b/hegel/hegel.test.mjs
new file mode 100644
index 0000000..650bb35
--- /dev/null
+++ b/hegel/hegel.test.mjs
@@ -0,0 +1,798 @@
+// Hegel properties for libphonenumber-js, run on metadata generated from the same Google
+// PhoneNumberMetadata.xml release that the oracle (google-libphonenumber, the Closure port of
+// Google's library) is compiled with, so every disagreement is code, not data. Each property draws
+// one case record (see gen.mjs for the generators) and renders it with pure functions. The shapes
+// of the recorded bugs (bugs.toml) are drawn like any other and the properties fail on them, naming
+// the shape in the failure; each bug also has a property over its shape alone (the section before
+// the pins) and a pin. HEGEL_NO_KNOWN=1 asks for a run that looks past the known bugs: the wide
+// properties then skip the one check a recorded shape falsifies (the rest of the case is still
+// judged) and the one-bug properties draw the neighbouring region instead. ZOO_FULL=1 draws and
+// checks the documented differences from the oracle too (README).
+import assert from "node:assert/strict";
+import { property, pin, fail, count, gs, noKnown, show } from "./hegel-zoo.mjs";
+import * as Gen from "./gen.mjs";
+import { chance, digits, maybe, pick, weighted } from "./gen.mjs";
+import parsePhoneNumber from "../source/parsePhoneNumber.js";
+import parsePhoneNumberWithError from "../source/parsePhoneNumberWithError.js";
+import isValidPhoneNumber from "../source/isValidPhoneNumber.js";
+import isPossiblePhoneNumber from "../source/isPossiblePhoneNumber.js";
+import validatePhoneNumberLength from "../source/validatePhoneNumberLength.js";
+import AsYouType from "../source/AsYouType.js";
+import PhoneNumber from "../source/PhoneNumber.js";
+import getCountries from "../source/getCountries.js";
+import getExampleNumber from "../source/getExampleNumber.js";
+import formatIncompletePhoneNumber from "../source/formatIncompletePhoneNumber.js";
+import Metadata, { getCountryCallingCode, isSupportedCountry } from "../source/metadata.js";
+import { chooseFormatForNumber } from "../source/format.js";
+
+const { G, util, PNF, metadata, examples, TYPE_NUM, NUM_TYPE, FULL } = Gen;
+
+// The recorded bugs (bugs.toml) whose shapes the generators draw, by id: what the shape is. A
+// property that meets one fails naming it; under HEGEL_NO_KNOWN=1 that one check is counted and
+// skipped instead (`known`).
+const SHAPE = {
+  "libphonenumber-js/1": "getType() is FIXED_LINE_OR_MOBILE for a fixed-line number of a country whose metadata has no mobile pattern (TA)",
+  "libphonenumber-js/2": "extract: false rejects an RFC 3966 tel: URI, the library's own format('RFC3966') output included",
+  "libphonenumber-js/3": "extract: false rejects a leading space before + and a trailing newline, and accepts other whitespace",
+  "libphonenumber-js/4": "AsYouType formats the same characters differently typed one at a time and given at once",
+  "libphonenumber-js/5": "AsYouType.getNumber() typed one digit at a time in a non-main NANPA territory prepends its leading digits",
+  "libphonenumber-js/6": "new PhoneNumber(e164) leaves country undefined (and validity wrong for non-main countries) where parsePhoneNumber derives it",
+  "libphonenumber-js/7": "AsYouType.getNumber() strips a national prefix (or applies its transform rule) that parsePhoneNumber and Google keep",
+  "libphonenumber-js/8": "AsYouType.getChars() reports an extra + for an IDD prefix typed in national mode",
+  "libphonenumber-js/9": "the extension prefix is not inherited from the calling code's main country (+44 IM, JE, GG format ' ext. ' where GB has ' x')",
+  "libphonenumber-js/10": "AsYouType.getNumber() is undefined for an IDD prefix typed one digit at a time in national mode with no calling code after it (GB 0005), where parsePhoneNumber gives +440005",
+  "libphonenumber-js/11": "AsYouType typed one digit at a time drops the default country's calling code at the front of a national number even when the remainder is no better number (JP 818111818181118), where the same text at once and parsePhoneNumber keep it",
+  "libphonenumber-js/12": "AsYouType in international mode keeps a national prefix after the calling code that parsePhoneNumber and Google strip (+7 8 1012345672 is +781012345672, parse +71012345672)",
+};
+const recorded = (id) => ` (recorded shape ${id}: ${SHAPE[id]})`;
+
+/** A check that the recorded shape `id` falsifies: fails naming it; under HEGEL_NO_KNOWN=1 the check is counted and skipped (true), the rest of the case judged. */
+function known(id, message) {
+  count((noKnown ? "skip " : "known ") + id);
+  if (noKnown) return true;
+  fail(message + recorded(id));
+}
+/** A failure of a one-bug property: names the shape by default (under HEGEL_NO_KNOWN=1 the neighbouring region is drawn, so a failure there is news). */
+const shaped = (id, message) => fail(noKnown ? message : message + recorded(id));
+
+// ---- oracle helpers ----------------------------------------------------------------------------
+
+/** Whether the library's metadata has a number format for this number (the generator drops some; see README). */
+function hasFormat(lp) {
+  const meta = new Metadata(metadata);
+  meta.selectNumberingPlan(lp.country || lp.countryCallingCode);
+  return !!chooseFormatForNumber(meta.formats(), lp.nationalNumber);
+}
+
+/** Google's parse, as { ok, number } or { ok: false, error }. */
+function googleParse(text, region) {
+  try {
+    return { ok: true, number: util.parse(text, region || undefined) };
+  } catch (e) {
+    return { ok: false, error: e.message || String(e) };
+  }
+}
+
+/** libphonenumber-js's strict parse (the whole string is the number), as { ok, number | error }; `loose` parses with the default extract. */
+function lpnParse(text, defaultCountry, loose = false) {
+  try {
+    const number = parsePhoneNumberWithError(text, loose ? { defaultCountry } : { defaultCountry, extract: false }, metadata);
+    return { ok: true, number };
+  } catch (e) {
+    return { ok: false, error: e.message };
+  }
+}
+
+const VR = Object.fromEntries(Object.entries(G.PhoneNumberUtil.ValidationResult).map(([k, v]) => [v, k]));
+
+function gType(pn) {
+  const t = util.getNumberType(pn);
+  return t === G.PhoneNumberType.UNKNOWN ? undefined : NUM_TYPE[t];
+}
+
+const stripDashes = (s) => s.replace(/-/g, "");
+// the library's international notation uses spaces where Google's keeps the metadata's dashes and dots (README: "+1 213 373 4253")
+const spaces = (s) => s.replace(/[-.\/]/g, " ");
+const e164Of = (pn) => `+${pn.cc}${pn.national}`;
+
+
+/** The recorded shape of a strict parse rejecting `shapes` of a text Google parses: a tel: URI (libphonenumber-js/2), whitespace around it (/3), or null. */
+const strictShape = (shapes) => (shapes.includes("rfc3966") ? "libphonenumber-js/2" : shapes.includes("whitespace") ? "libphonenumber-js/3" : null);
+
+// ---- 1. parsing, validation and formatting against Google ------------------------------------
+
+property("TestHegelParseAgreesWithGoogle", (tc) => {
+  const { pn, notation, iddFrom } = tc.draw(gs.record({ pn: Gen.phoneNumber, notation: Gen.notation, iddFrom: maybe(30, Gen.country) }));
+  const { text, defaultCountry, shapes, how } = Gen.render(pn, notation);
+  for (const s of shapes) count(s);
+  count("how:" + how);
+  const g = googleParse(text, defaultCountry);
+  // a tel: URI or whitespace around the text is parsed strictly like everything else (libphonenumber-js/2
+  // and /3 reject it); under HEGEL_NO_KNOWN=1 with the default extract, so the rest of the case is judged
+  const shape = strictShape(shapes);
+  const loose = noKnown && shape !== null;
+  if (loose) count("skip " + shape);
+  const l = lpnParse(text, defaultCountry, loose);
+  const ctx = `parse(${show(text)}, ${show(defaultCountry)}${loose ? "" : ", extract: false"})`;
+  if (g.ok !== l.ok) {
+    if (!g.ok && /too short after IDD/.test(g.error) && text.replace(/\D/g, "").length <= 4) {
+      count("short-after-idd"); // a few digits that happen to start with the country's IDD prefix ("0 01" in KR): noise
+      return;
+    }
+    count("ok-mismatch");
+    const message = `${ctx}: google ${g.ok ? "parsed " + util.format(g.number, PNF.E164) : "failed: " + g.error}, libphonenumber-js ${l.ok ? "parsed " + l.number.number : "failed: " + l.error}`;
+    if (g.ok && shape !== null) known(shape, message);
+    fail(message);
+  }
+  if (!g.ok) return;
+  const gp = g.number, lp = l.number;
+  const gNational = util.getNationalSignificantNumber(gp);
+  if (lp.nationalNumber.length >= 16 || gNational.length >= 16) {
+    count("oracle-precision");
+    return; // google-libphonenumber stores the national number in a double: 16+ digits are not exact on its side
+  }
+  const gExt = gp.getExtension() || undefined;
+  if (String(gp.getCountryCode()) !== lp.countryCallingCode) fail(`${ctx}: country calling code ${lp.countryCallingCode}, google ${gp.getCountryCode()}`);
+  if (gNational !== lp.nationalNumber && !util.isValidNumber(gp) && !lp.isValid() && (lp.nationalNumber.endsWith(gNational) || gNational.endsWith(lp.nationalNumber))) {
+    count("invalid-prefix-strip"); // the two libraries strip a national prefix differently from a number neither finds valid
+    return;
+  }
+  if (gNational !== lp.nationalNumber) fail(`${ctx}: national number ${lp.nationalNumber}, google ${gNational}`);
+  if (gExt !== lp.ext) fail(`${ctx}: ext ${show(lp.ext)}, google ${show(gExt)}`);
+  const gValid = util.isValidNumber(gp);
+  if (gValid !== lp.isValid()) fail(`${ctx}: isValid ${lp.isValid()}, google ${gValid} (${lp.number})`);
+  const gPossible = util.isPossibleNumber(gp);
+  const gReason = VR[util.isPossibleNumberWithReason(gp)];
+  if (gReason === "IS_POSSIBLE_LOCAL_ONLY") {
+    // the library's metadata carries no local-only lengths: such a number is "not possible" to it
+    count("local-only"); // local-only lengths are ignored by the library (see README): no expectation
+  } else if (gPossible !== lp.isPossible() && lp.country && lp.country !== Gen.mainCountry(lp.countryCallingCode)) {
+    count("possible-non-main"); // Google checks lengths against the calling code's main country, the library against the number's own
+  } else if (gPossible !== lp.isPossible()) fail(`${ctx}: isPossible ${lp.isPossible()}, google ${gPossible} (${lp.number})`);
+  const gRegion = util.getRegionCodeForNumber(gp);
+  const lCountry = lp.country;
+  if (gRegion === "001") {
+    if (lCountry !== undefined) fail(`${ctx}: country ${lCountry} for a non-geographic number, google 001`);
+    if (!lp.isNonGeographic()) fail(`${ctx}: isNonGeographic false for ${lp.number}`);
+  } else if (gRegion) {
+    if (lCountry !== gRegion) fail(`${ctx}: country ${show(lCountry)}, google ${gRegion} (${lp.number})`);
+  } else if (lCountry !== undefined && lCountry !== defaultCountry) {
+    // Google has no region for an invalid number; the library may keep the default country
+    count("country-of-invalid");
+    fail(`${ctx}: country ${lCountry} for a number google gives no region (${lp.number})`);
+  }
+  const lType = lp.getType();
+  const gt = gType(gp);
+  if (lType !== gt) {
+    const message = `${ctx}: getType ${show(lType)}, google ${show(gt)} (${lp.number})`;
+    if (lp.country === "TA" && gt === "FIXED_LINE" && lType === "FIXED_LINE_OR_MOBILE") known("libphonenumber-js/1", message);
+    else fail(message);
+  }
+  // formatting
+  const e164 = util.format(gp, PNF.E164);
+  if (lp.number !== e164) fail(`${ctx}: number ${lp.number}, google E164 ${e164}`);
+  if (lp.format("E.164") !== e164) fail(`${ctx}: format(E.164) ${lp.format("E.164")}, google ${e164}`);
+  const intl = util.format(gp, PNF.INTERNATIONAL);
+  const nat = util.format(gp, PNF.NATIONAL);
+  if (!hasFormat(lp) && (/\D/.test(nat) || intl !== `+${lp.countryCallingCode} ${gNational}`)) {
+    count("no-format");
+    return; // libphonenumber-metadata-generator drops some formats (e.g. CN 7- and 8-digit numbers) that Google applies: not this library's bug
+  }
+  // a mismatch of a format carrying the extension of a number whose country does not inherit the main
+  // country's extension prefix is libphonenumber-js/9's shape
+  const extShape = lp.ext !== undefined && Gen.extPrefixNotInherited(lp.country);
+  const formatMismatch = (message) => {
+    if (extShape) known("libphonenumber-js/9", message);
+    else fail(message);
+  };
+  if (spaces(lp.format("INTERNATIONAL")) !== spaces(intl)) formatMismatch(`${ctx}: format(INTERNATIONAL) ${show(lp.format("INTERNATIONAL"))}, google ${show(intl)}`);
+  if (lp.format("NATIONAL") !== nat) formatMismatch(`${ctx}: format(NATIONAL) ${show(lp.format("NATIONAL"))}, google ${show(nat)}`);
+  const rfc = util.format(gp, PNF.RFC3966);
+  if (stripDashes(lp.format("RFC3966")) !== stripDashes(rfc)) {
