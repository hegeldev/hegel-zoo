+    if (ayt.getNumberValue() !== parsed.number) fail(`getNumberValue() = ${show(ayt.getNumberValue())}, parse gives ${parsed.number}`);
+    if (ayt.isValid() !== parsed.isValid()) fail(`AsYouType.isValid() = ${ayt.isValid()}, parse().isValid() = ${parsed.isValid()} for ${show(chars)}`);
+    if (ayt.isPossible() !== parsed.isPossible()) fail(`AsYouType.isPossible() = ${ayt.isPossible()}, parse().isPossible() = ${parsed.isPossible()} for ${show(chars)}`);
