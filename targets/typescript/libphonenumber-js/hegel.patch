+  if (chance(tc, 30)) {
+    const from = Gen.country(tc);
+    const gIdd = util.formatOutOfCountryCallingNumber(gp, from);
+    const lIdd = lp.format("IDD", { fromCountry: from });
+    if (lIdd !== undefined && spaces(lIdd) !== spaces(gIdd)) fail(`${ctx}: format(IDD from ${from}) ${show(lIdd)}, google ${show(gIdd)}`);
