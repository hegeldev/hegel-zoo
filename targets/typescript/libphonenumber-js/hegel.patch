diff --git a/hegel/gen.mjs b/hegel/gen.mjs
new file mode 100644
index 0000000..2de4fbf
--- /dev/null
+++ b/hegel/gen.mjs
@@ -0,0 +1,199 @@
+// Generators for the libphonenumber-js properties: phone numbers built from the metadata both
+// libraries share (Google's example numbers mutated, digits of the country's possible lengths,
+// arbitrary digit strings) and the many ways of writing one down.
+import { createRequire } from "node:module";
+import fs from "node:fs";
+import { n, pick, chance } from "./hegel-zoo.mjs";
+import Metadata from "../source/metadata.js";
+
+const require = createRequire(import.meta.url);
+export const G = require("../.hegel/node_modules/google-libphonenumber");
+export const util = G.PhoneNumberUtil.getInstance();
+export const PNF = G.PhoneNumberFormat;
+export const metadata = JSON.parse(fs.readFileSync(new URL("./metadata.json", import.meta.url)));
+const allExamples = JSON.parse(fs.readFileSync(new URL("./metadata.examples.json", import.meta.url)));
+// the shape of the package's examples.mobile.json: one national number per country (mobile, else fixed line)
+export const examples = Object.fromEntries(Object.entries(allExamples).map(([c, ex]) => [c, ex.mobile || ex.fixed_line]).filter(([, v]) => v));
+
+export const FULL = !!process.env.ZOO_FULL;
+
+export const TYPES = Object.keys(G.PhoneNumberType).filter((t) => t !== "UNKNOWN");
+export const TYPE_NUM = Object.fromEntries(TYPES.map((t) => [t, G.PhoneNumberType[t]]));
+export const NUM_TYPE = Object.fromEntries(TYPES.map((t) => [G.PhoneNumberType[t], t]));
+
+export const COUNTRIES = new Metadata(metadata).getCountries().sort();
+// the non-geographic calling codes (800, 808, 870, ...) as strings
+export const NON_GEO = util.getSupportedGlobalNetworkCallingCodes().map(String);
+// a few countries with rich metadata get extra weight
+const COMMON = ["US", "GB", "DE", "FR", "RU", "BR", "IN", "CN", "JP", "AU", "IT", "ES", "MX", "AR", "CO", "NG", "ZA", "KR", "PL", "NL"];
+
+export function country(tc) {
+  return chance(tc, 40) ? pick(tc, COMMON) : pick(tc, COUNTRIES);
+}
+
+export function digits(tc, len) {
+  let s = "";
+  for (let i = 0; i < len; i++) s += n(tc, 0, 9);
+  return s;
+}
+
+/** Google's example national significant number of a country for a random type, or undefined. */
+export function exampleNational(tc, region) {
+  const types = TYPES.filter((t) => util.getExampleNumberForType(region, TYPE_NUM[t]));
+  if (types.length === 0) return undefined;
+  const ex = util.getExampleNumberForType(region, TYPE_NUM[pick(tc, types)]);
+  return util.getNationalSignificantNumber(ex);
+}
+
+/** A national number for a region: an example (possibly mutated), a possible-length digit string, or noise. */
+export function nationalNumber(tc, region) {
+  const meta = new Metadata(metadata);
+  meta.selectNumberingPlan(region);
+  const lengths = meta.possibleLengths();
+  const kind = pick(tc, ["example", "example", "mutated", "mutated", "length", "length", "noise"]);
+  const ex = exampleNational(tc, region);
+  if (kind === "example" && ex) return { national: ex, shape: "example" };
+  if (kind === "mutated" && ex) {
+    const chars = ex.split("");
+    const k = n(tc, 1, Math.min(3, chars.length));
+    for (let i = 0; i < k; i++) chars[n(tc, 0, chars.length - 1)] = String(n(tc, 0, 9));
+    if (chance(tc, 20)) chars.push(String(n(tc, 0, 9)));
+    if (chance(tc, 20) && chars.length > 2) chars.pop();
+    return { national: chars.join(""), shape: "mutated" };
+  }
+  if (kind === "length" && lengths && lengths.length) {
+    const len = pick(tc, lengths);
+    let s = digits(tc, len);
+    if (s[0] === "0" && chance(tc, 80)) s = String(n(tc, 1, 9)) + s.slice(1);
+    return { national: s, shape: "length" };
+  }
+  return { national: digits(tc, n(tc, 1, 17)), shape: "noise" };
+}
+
+/** A complete number: country calling code, national number, its region (or undefined for non-geographic). */
+export function phoneNumber(tc) {
+  if (chance(tc, 5)) {
+    const cc = pick(tc, NON_GEO);
+    const ex = util.getExampleNumberForNonGeoEntity(Number(cc));
+    const national = ex && chance(tc, 60) ? util.getNationalSignificantNumber(ex) : digits(tc, n(tc, 4, 12));
+    return { cc, national, region: undefined, shape: "non-geo" };
+  }
+  const region = country(tc);
+  const cc = String(util.getCountryCodeForRegion(region));
+  const { national, shape } = nationalNumber(tc, region);
+  return { cc, national, region, shape };
+}
+
+const SEPARATORS = [" ", "-", ".", "  ", " - ", "/"];
+
+/** Insert separators between digit groups. */
+export function group(tc, ds) {
+  if (ds.length <= 2 || chance(tc, 30)) return ds;
+  const sep = pick(tc, SEPARATORS);
+  let out = "";
+  let i = 0;
+  while (i < ds.length) {
+    const k = n(tc, 1, 4);
+    out += (out ? sep : "") + ds.slice(i, i + k);
+    i += k;
+  }
+  return out;
+}
+
+export const EXT_SHAPES = [" ext. ", " ext ", " x", " x. ", ";ext=", " extension ", " #", "#", " ~", " int. ", "extn"];
+
+/**
+ * A way of writing `pn` down: returns { text, defaultCountry, ext, shapes } where `ext` is the
+ * extension the text carries (or undefined) and `shapes` lists the notations used.
+ */
+export function render(tc, pn, { full = FULL } = {}) {
+  const { cc, national, region } = pn;
+  const shapes = [];
+  let text;
+  let defaultCountry = region;
+  const how = pick(tc, ["e164", "e164", "international", "international", "national", "national", "national-prefix", "idd", "rfc3966", "plus-cc-grouped", "digits-cc"]);
+  switch (how) {
+    case "e164":
+      text = `+${cc}${national}`;
+      if (chance(tc, 50)) defaultCountry = undefined;
+      break;
+    case "international":
+      text = `+${cc} ${group(tc, national)}`;
+      if (chance(tc, 50)) defaultCountry = undefined;
+      break;
+    case "plus-cc-grouped":
+      text = `+${group(tc, cc + national)}`;
+      if (chance(tc, 50)) defaultCountry = undefined;
+      break;
+    case "national": {
+      if (!region) { text = `+${cc}${national}`; break; }
+      // the national significant number, grouped, sometimes with the area code in parentheses
+      const g = group(tc, national);
+      text = chance(tc, 30) && national.length > 4 ? `(${national.slice(0, n(tc, 1, 3))}) ${group(tc, national.slice(national.length - (national.length - n(tc, 1, 3))))}` : g;
+      if (text.startsWith("(")) text = `(${national.slice(0, 3)}) ${group(tc, national.slice(3))}`;
+      break;
+    }
+    case "national-prefix": {
+      if (!region) { text = `+${cc}${national}`; break; }
+      const ndd = util.getNddPrefixForRegion(region, true);
+      if (!ndd) { text = group(tc, national); break; }
+      text = `${ndd}${chance(tc, 50) ? " " : ""}${group(tc, national)}`;
+      shapes.push("national-prefix");
+      break;
+    }
+    case "idd": {
+      // dialled from `defaultCountry` with its international prefix
+      const from = country(tc);
+      const meta = new Metadata(metadata);
+      meta.selectNumberingPlan(from);
+      const idd = meta.IDDPrefix();
+      if (!idd || /[^0-9]/.test(idd)) { text = `+${cc}${national}`; break; }
+      defaultCountry = from;
+      text = `${idd} ${cc} ${group(tc, national)}`;
+      shapes.push("idd");
+      break;
+    }
+    case "rfc3966":
+      text = `tel:+${cc}-${national.match(/.{1,4}/g).join("-")}`;
+      shapes.push("rfc3966");
+      if (chance(tc, 50)) defaultCountry = undefined;
+      break;
+    case "digits-cc":
+      // the country calling code without a plus and no default country: read as a national number
+      text = `${cc}${national}`;
+      if (!region || chance(tc, 30)) defaultCountry = country(tc);
+      shapes.push("digits-cc");
+      break;
+  }
+  let ext;
+  if (chance(tc, 20) && !text.startsWith("tel:") && national.length >= 3) {
+    ext = digits(tc, n(tc, 1, 5));
+    let shape = pick(tc, EXT_SHAPES);
+    if (!full && (shape === "#" || shape === " #" || shape === "extn" || shape === " ~" || shape === " int. ")) shape = " ext. ";
+    text += shape + ext;
+    shapes.push("ext");
+  } else if (chance(tc, 10) && text.startsWith("tel:") && national.length >= 3) {
+    ext = digits(tc, n(tc, 1, 5));
+    text += `;ext=${ext}`;
+    shapes.push("ext");
+  }
+  if (full && chance(tc, 10)) {
+    text = pick(tc, ["Call: ", "tel ", "phone: ", "  "]) + text + pick(tc, ["", " (home)", ".", " today"]);
+    shapes.push("junk");
+  }
+  if (full && chance(tc, 5)) {
+    // full-width digits
+    text = text.replace(/[0-9]/g, (d) => String.fromCharCode(0xff10 + Number(d)));
+    shapes.push("fullwidth");
+  }
+  if (chance(tc, 10)) {
+    text = pick(tc, [" ", "\t", ""]) + text + pick(tc, [" ", "\n", ""]);
+    shapes.push("whitespace");
+  }
+  return { text, defaultCountry, ext, shapes, how };
+}
+
+/** Text that is not a phone number (or barely one). */
+export function junkText(tc) {
+  return pick(tc, ["", " ", "+", "abc", "+1", "1", "12", "()", "tel:", "+-", "000", "ext. 123", "1 2", "+999 12345678", "+0 12345"]);
+}
diff --git a/hegel/generate-metadata.mjs b/hegel/generate-metadata.mjs
new file mode 100644
index 0000000..e66f904
--- /dev/null
+++ b/hegel/generate-metadata.mjs
@@ -0,0 +1,20 @@
+// Generates libphonenumber-js "max" metadata (with phone number type patterns) from the copy of
+// Google's PhoneNumberMetadata.xml that matches the oracle's release, so both sides of the
+// differential run on the same metadata. Usage: node hegel/generate-metadata.mjs <xml> <out.json>
+import fs from "node:fs";
+import { createRequire } from "node:module";
+
+// The package's ESM entry uses extensionless imports, so the CommonJS build is loaded instead.
+const require = createRequire(import.meta.url);
+const { generate, minify } = require("../.hegel/node_modules/libphonenumber-metadata-generator/index.commonjs.js");
+
+const [xmlPath, outPath] = process.argv.slice(2);
+const xml = fs.readFileSync(xmlPath, "utf8");
+const full = await generate(xml, { withPhoneNumberTypes: true, withPhoneNumberTypeExamples: true });
+fs.writeFileSync(outPath, JSON.stringify(minify(full)));
+const examples = {};
+for (const [country, { examples: ex }] of Object.entries(full.countries)) {
+  if (ex) examples[country] = ex;
+}
+fs.writeFileSync(outPath.replace(/\.json$/, ".examples.json"), JSON.stringify(examples));
+console.log(`wrote ${outPath} (${fs.statSync(outPath).size} bytes), ${Object.keys(full.countries).length} countries`);
diff --git a/hegel/hegel-zoo.mjs b/hegel/hegel-zoo.mjs
new file mode 100644
index 0000000..1ca6f10
--- /dev/null
+++ b/hegel/hegel-zoo.mjs
@@ -0,0 +1,163 @@
+// Hegel zoo: the small harness shared by the zoo's TypeScript/JavaScript targets.
+//
+// `property(name, body)` registers a node:test test that runs `body(tc)` under Hegel with
+// HEGEL_TEST_CASES cases (default 100) and the database at HEGEL_DATABASE. With ZOO_COLLECT=1
+// a `fail()` records the mismatch instead of failing, the case ends there, and the counts of
+// mismatches and of the shapes seen (`count(key)`) are printed at the end of the test, so a
+// property can be run over many cases to see every shape at once. `pin(name, body)` is a
+// plain test for one pinned bug: it must fail while the bug is present and pass once it is
+// fixed (the zoo's judge reads an unexpected pass as "fixed upstream?").
+
+import { readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+import { test as nodeTest } from "node:test";
+
+// The Hegel version these tests were written against (the zoo pins it in zoo.toml; upstream
+// would add it to devDependencies). Hegel and esbuild are installed with `npm install --prefix
+// .hegel` so the target's own package.json and lock file stay untouched. Checked at load time so
+// a stray install cannot silently change the engine.
+export const HEGEL_PIN = { "@hegeldev/hegel": "0.4.5" };
+
+const hegelDir = join(dirname(fileURLToPath(import.meta.url)), "..", ".hegel", "node_modules", "@hegeldev", "hegel");
+{
+  const installed = JSON.parse(readFileSync(join(hegelDir, "package.json"), "utf8")).version;
+  if (installed !== HEGEL_PIN["@hegeldev/hegel"]) {
+    throw new Error(`@hegeldev/hegel ${installed} is installed; these tests pin ${HEGEL_PIN["@hegeldev/hegel"]}`);
+  }
+}
+const hegel = await import(pathToFileURL(join(hegelDir, "dist", "index.js")));
+const gs = await import(pathToFileURL(join(hegelDir, "dist", "generators", "index.js")));
+
+export const collecting = !!process.env.ZOO_COLLECT;
+
+class Collected extends Error {}
+
+let msgs = [];
+let stats = new Map();
+
+/** Report a mismatch: an error normally, a recorded line in collect mode. */
+export function fail(message) {
+  if (collecting) {
+    msgs.push(message);
+    throw new Collected(message);
+  }
+  throw new Error(message);
+}
+
+/** Bump a statistic (the shape of a pinned bug, a generator branch). */
+export function count(key) {
+  stats.set(key, (stats.get(key) || 0) + 1);
+}
+
+function settings() {
+  const s = { testCases: Number(process.env.HEGEL_TEST_CASES) || 100 };
+  if (process.env.HEGEL_DATABASE) {
+    s.database = hegel.Database.fromPath(process.env.HEGEL_DATABASE);
+  }
+  return s;
+}
+
+/** A property: `body(tc)` runs under Hegel; a thrown error (or `fail`) is a failure. */
+export function property(name, body) {
+  nodeTest(name, () => {
+    msgs = [];
+    stats = new Map();
+    hegel.test((tc) => {
+      try {
+        body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** An async property: `body(tc)` may await; runs under Hegel's testAsync with the same settings. */
+export function propertyAsync(name, body) {
+  nodeTest(name, async () => {
+    msgs = [];
+    stats = new Map();
+    await hegel.testAsync(async (tc) => {
+      try {
+        await body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** A pin: a plain test for one recorded bug. */
+export function pin(name, body) {
+  nodeTest(name, body);
+}
+
+/** An integer in [lo, hi]. */
+export function n(tc, lo, hi) {
+  return tc.draw(gs.integers({ minValue: lo, maxValue: hi }));
+}
+
+/** One of xs. */
+export function pick(tc, xs) {
+  return xs[n(tc, 0, xs.length - 1)];
+}
+
+/** True pct percent of the time. */
+export function chance(tc, pct) {
+  return n(tc, 0, 99) < pct;
+}
+
+/** A string of `len` characters drawn from `alphabet` (an array of strings). */
+export function word(tc, alphabet, lo, hi) {
+  const len = n(tc, lo, hi);
+  let s = "";
+  for (let i = 0; i < len; i++) {
+    s += pick(tc, alphabet);
+  }
+  return s;
+}
+
+/** Structural equality: arrays by position, objects by key set (prototype ignored), else ===. */
+export function same(a, b) {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) {
+      return false;
+    }
+    return a.every((x, i) => same(x, b[i]));
+  }
+  if (a !== null && b !== null && typeof a === "object" && typeof b === "object") {
+    const ka = Object.keys(a).sort();
+    const kb = Object.keys(b).sort();
+    if (ka.length !== kb.length || ka.some((k, i) => k !== kb[i])) {
+      return false;
+    }
+    return ka.every((k) => same(a[k], b[k]));
+  }
+  return a === b;
+}
+
+/** A compact, unambiguous rendering for messages. */
+export function show(x) {
+  return JSON.stringify(x, (k, v) => (v === undefined ? "<undefined>" : v));
+}
diff --git a/hegel/hegel.test.mjs b/hegel/hegel.test.mjs
new file mode 100644
index 0000000..ac8c6b9
--- /dev/null
+++ b/hegel/hegel.test.mjs
@@ -0,0 +1,499 @@
+// Hegel properties for libphonenumber-js, run on metadata generated from the same Google
+// PhoneNumberMetadata.xml release that the oracle (google-libphonenumber, the Closure port of
+// Google's library) is compiled with, so every disagreement is code, not data.
+import assert from "node:assert/strict";
+import { property, pin, fail, count, n, pick, chance, show } from "./hegel-zoo.mjs";
+import * as Gen from "./gen.mjs";
+import parsePhoneNumber from "../source/parsePhoneNumber.js";
+import parsePhoneNumberWithError from "../source/parsePhoneNumberWithError.js";
+import isValidPhoneNumber from "../source/isValidPhoneNumber.js";
+import isPossiblePhoneNumber from "../source/isPossiblePhoneNumber.js";
+import validatePhoneNumberLength from "../source/validatePhoneNumberLength.js";
+import AsYouType from "../source/AsYouType.js";
+import PhoneNumber from "../source/PhoneNumber.js";
+import getCountries from "../source/getCountries.js";
+import getExampleNumber from "../source/getExampleNumber.js";
+import formatIncompletePhoneNumber from "../source/formatIncompletePhoneNumber.js";
+import Metadata, { getCountryCallingCode, isSupportedCountry } from "../source/metadata.js";
+import { chooseFormatForNumber } from "../source/format.js";
+
+/** Whether the library's metadata has a number format for this number (the generator drops some; see README). */
+function hasFormat(lp) {
+  const meta = new Metadata(metadata);
+  meta.selectNumberingPlan(lp.country || lp.countryCallingCode);
+  return !!chooseFormatForNumber(meta.formats(), lp.nationalNumber);
+}
+
+const { G, util, PNF, metadata, examples, TYPES, TYPE_NUM, NUM_TYPE, COUNTRIES } = Gen;
+const full = Gen.FULL;
+
+// ---- helpers --------------------------------------------------------------------------------------
+
+/** Google's parse, as { ok, number } or { ok: false, error }. */
+function googleParse(text, region) {
+  try {
+    return { ok: true, number: util.parse(text, region || undefined) };
+  } catch (e) {
+    return { ok: false, error: e.message || String(e) };
+  }
+}
+
+/** libphonenumber-js's strict parse (the whole string is the number), as { ok, number | error }. */
+function lpnParse(text, defaultCountry, loose = false) {
+  try {
+    const number = parsePhoneNumberWithError(text, loose ? { defaultCountry } : { defaultCountry, extract: false }, metadata);
+    return { ok: true, number };
+  } catch (e) {
+    return { ok: false, error: e.message };
+  }
+}
+
+const VR = Object.fromEntries(Object.entries(G.PhoneNumberUtil.ValidationResult).map(([k, v]) => [v, k]));
+
+function gType(pn) {
+  const t = util.getNumberType(pn);
+  return t === G.PhoneNumberType.UNKNOWN ? undefined : NUM_TYPE[t];
+}
+
+const stripDashes = (s) => s.replace(/-/g, "");
+// the library's international notation uses spaces where Google's keeps the metadata's dashes and dots (README: "+1 213 373 4253")
+const spaces = (s) => s.replace(/[-.\/]/g, " ");
+
+// ---- 1. parsing, validation and formatting against Google ------------------------------------
+
+property("TestHegelParseAgreesWithGoogle", (tc) => {
+  const pn = Gen.phoneNumber(tc);
+  const { text, defaultCountry, ext, shapes, how } = Gen.render(tc, pn);
+  for (const s of shapes) count(s);
+  count("how:" + how);
+  const g = googleParse(text, defaultCountry);
+  // libphonenumber-js/2 and /3: a tel: URI or surrounding whitespace is not accepted under extract: false
+  const loose = !full && (shapes.includes("rfc3966") || shapes.includes("whitespace"));
+  if (loose) count("loose-parse");
+  const l = lpnParse(text, defaultCountry, loose);
+  const ctx = `parse(${show(text)}, ${show(defaultCountry)}${loose ? "" : ", extract: false"})`;
+  if (g.ok !== l.ok) {
+    if (!g.ok && /too short after IDD/.test(g.error) && text.replace(/\D/g, "").length <= 4) {
+      count("short-after-idd"); // a few digits that happen to start with the country's IDD prefix ("0 01" in KR): noise
+      return;
+    }
+    count("ok-mismatch");
+    fail(`${ctx}: google ${g.ok ? "parsed " + util.format(g.number, PNF.E164) : "failed: " + g.error}, libphonenumber-js ${l.ok ? "parsed " + l.number.number : "failed: " + l.error}`);
+  }
+  if (!g.ok) return;
+  const gp = g.number, lp = l.number;
+  const gNational = util.getNationalSignificantNumber(gp);
+  if (lp.nationalNumber.length >= 16 || gNational.length >= 16) {
+    count("oracle-precision");
+    return; // google-libphonenumber stores the national number in a double: 16+ digits are not exact on its side
+  }
+  const gExt = gp.getExtension() || undefined;
+  if (String(gp.getCountryCode()) !== lp.countryCallingCode) fail(`${ctx}: country calling code ${lp.countryCallingCode}, google ${gp.getCountryCode()}`);
+  if (gNational !== lp.nationalNumber && !util.isValidNumber(gp) && !lp.isValid() && (lp.nationalNumber.endsWith(gNational) || gNational.endsWith(lp.nationalNumber))) {
+    count("invalid-prefix-strip"); // the two libraries strip a national prefix differently from a number neither finds valid
+    return;
+  }
+  if (gNational !== lp.nationalNumber) fail(`${ctx}: national number ${lp.nationalNumber}, google ${gNational}`);
+  if (gExt !== lp.ext) fail(`${ctx}: ext ${show(lp.ext)}, google ${show(gExt)}`);
+  const gValid = util.isValidNumber(gp);
+  if (gValid !== lp.isValid()) fail(`${ctx}: isValid ${lp.isValid()}, google ${gValid} (${lp.number})`);
+  const gPossible = util.isPossibleNumber(gp);
+  const gReason = VR[util.isPossibleNumberWithReason(gp)];
+  if (gReason === "IS_POSSIBLE_LOCAL_ONLY") {
+    // the library's metadata carries no local-only lengths: such a number is "not possible" to it
+    count("local-only"); // local-only lengths are ignored by the library (see README): no expectation
+  } else if (gPossible !== lp.isPossible() && lp.country && lp.country !== util.getRegionCodeForCountryCode(Number(lp.countryCallingCode))) {
+    count("possible-non-main"); // Google checks lengths against the calling code's main country, the library against the number's own
+  } else if (gPossible !== lp.isPossible()) fail(`${ctx}: isPossible ${lp.isPossible()}, google ${gPossible} (${lp.number})`);
+  const gRegion = util.getRegionCodeForNumber(gp);
+  const lCountry = lp.country;
+  if (gRegion === "001") {
+    if (lCountry !== undefined) fail(`${ctx}: country ${lCountry} for a non-geographic number, google 001`);
