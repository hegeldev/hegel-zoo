+
+pin("TestHegelPinAsYouTypeCharsAreTheTypedCharacters", () => {
+  // libphonenumber-js/8: an international prefix typed in national mode shows up as an extra "+" in getChars()
+  const ayt = new AsYouType("DE", metadata);
+  assert.equal(ayt.input("00"), "00");
