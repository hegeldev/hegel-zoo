+pin("TestHegelPinAsYouTypeKeepsTheNationalPrefixWhenParseDoes", () => {
+  // libphonenumber-js/7: the formatter strips a national prefix that the parser (and Google) keeps
+  assert.equal(parsePhoneNumber("8005553535", "RU", metadata).number, "+78005553535");
+  assert.equal(util.format(util.parse("8005553535", "RU"), PNF.E164), "+78005553535");
+  const ru = new AsYouType("RU", metadata);
+  ru.input("8005553535");
+  assert.equal(ru.getNumber().number, "+78005553535");
+  assert.equal(parsePhoneNumber("003316740", "NG", metadata).number, "+234003316740");
+  const ng = new AsYouType("NG", metadata);
+  ng.input("003316740");
+  assert.equal(ng.getNumber().number, "+234003316740");
+});
+
+pin("TestHegelPinAsYouTypeCharsAreTheTypedCharacters", () => {
+  // libphonenumber-js/8: an international prefix typed in national mode shows up as an extra "+" in getChars()
+  const ayt = new AsYouType("DE", metadata);
+  assert.equal(ayt.input("00"), "00");
+  assert.equal(ayt.getTemplate(), "xx");
+  assert.equal(ayt.getChars(), "00");
+});
+
+pin("TestHegelPinExtensionPrefixIsInheritedFromTheMainCountry", () => {
+  // libphonenumber-js/9: +44 numbers of the Isle of Man and Jersey format their extension as " ext. " where GB (and Google) use " x"
+  const gb = parsePhoneNumber("+442079460958", metadata);
+  gb.setExt("7");
+  assert.equal(gb.format("INTERNATIONAL"), "+44 20 7946 0958 x7");
+  const im = parsePhoneNumber("+441624756789", metadata);
+  im.setExt("7");
+  assert.equal(im.country, "IM");
+  assert.equal(util.format(util.parse("+441624756789 x7", "ZZ"), PNF.INTERNATIONAL), "+44 1624 756789 x7");
+  assert.equal(im.format("INTERNATIONAL"), "+44 1624 756789 x7");
+});
