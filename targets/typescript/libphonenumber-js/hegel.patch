+// ---- 2. every format parses back to the same number ---------------------------------------
+
+property("TestHegelFormatsRoundTrip", (tc) => {
+  const pn = Gen.phoneNumber(tc);
+  const l = lpnParse(`+${pn.cc}${pn.national}`, undefined);
+  if (!l.ok) return;
+  const num = l.number;
+  if (num.nationalNumber !== pn.national) {
+    count("non-canonical"); // a national prefix was stripped: parsing is not idempotent on doubled prefixes (Google neither)
+    return;
+  }
+  if (chance(tc, 30) && num.nationalNumber.length >= 3) num.setExt(Gen.digits(tc, n(tc, 1, 5)));
+  for (const fmt of ["E.164", "RFC3966", "INTERNATIONAL", "NATIONAL"]) {
+    const opts = fmt === "NATIONAL" && chance(tc, 50) ? { nationalPrefix: false } : undefined;
+    const text = num.format(fmt, opts);
+    if (typeof text !== "string" || text === "") fail(`format(${fmt}) of ${num.number} = ${show(text)}`);
+    // national notation needs the country; the others carry the calling code
+    const dc = fmt === "NATIONAL" ? num.country || undefined : undefined;
+    const wantExt = fmt === "E.164" ? undefined : num.ext;
+    const strict = fmt === "RFC3966" && !full ? {} : { extract: false }; // libphonenumber-js/2
+    if (fmt === "RFC3966" && !full) count("rfc-loose");
+    if (fmt === "NATIONAL" && !dc) {
+      // a national format of a number without a country: parse with its calling code
+      const back = parsePhoneNumber(text, { defaultCallingCode: num.countryCallingCode, extract: false }, metadata);
+      if (!back || back.number !== num.number || back.ext !== wantExt) fail(`parse(format(NATIONAL) = ${show(text)}, +${num.countryCallingCode}) = ${show(back && back.number)} for ${num.number}${num.ext ? " ext " + num.ext : ""}`);
+      continue;
+    }
+    const back = parsePhoneNumber(text, { defaultCountry: dc, ...strict }, metadata);
+    if (!back && !googleParse(text, dc).ok) {
+      count("google-rejects-format"); // a number that is not a phone number to either library (e.g. TW 00216#4)
+      continue;
+    }
+    if (!back) fail(`parse(format(${fmt}) = ${show(text)}, ${show(dc)}) = undefined for ${num.number}`);
+    if (back.number !== num.number) {
+      const g = googleParse(text, dc);
+      if (g.ok && util.format(g.number, PNF.E164) === back.number) {
+        count("google-agrees"); // an invalid number written with its national prefix: both libraries keep the prefix on the way back
+        continue;
+      }
+    }
+    if (back.number !== num.number || back.ext !== wantExt) fail(`parse(format(${fmt}) = ${show(text)}, ${show(dc)}) = ${back.number}${back.ext ? " ext " + back.ext : ""}, expected ${num.number}${num.ext ? " ext " + num.ext : ""} (from ${show(pn)}, national ${num.nationalNumber})`);
+    if (fmt !== "E.164" && !back.isEqual(num)) fail(`isEqual false after ${fmt} round trip of ${num.number}`);
+    if (back.isValid() !== num.isValid()) fail(`isValid changed after ${fmt} round trip of ${num.number}: ${back.isValid()} vs ${num.isValid()}`);
+  }
+  // the URI helpers
+  if (num.getURI() !== num.format("RFC3966")) fail(`getURI ${num.getURI()} vs format(RFC3966) ${num.format("RFC3966")}`);
+  if (num.formatNational() !== num.format("NATIONAL")) fail(`formatNational differs from format(NATIONAL) for ${num.number}`);
+  if (num.formatInternational() !== num.format("INTERNATIONAL")) fail(`formatInternational differs from format(INTERNATIONAL) for ${num.number}`);
+});
