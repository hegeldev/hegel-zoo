+    }
+  } else if (withError.ok === false) {
+    // the length check reports the parse error's code, or a length reason for short numbers
+    if (len === undefined) fail(`validatePhoneNumberLength(${show(text)}, ${show(defaultCountry)}) = undefined but parse failed: ${withError.error}`);
+  }
+});
