+  const { pn, ext, text } = tc.draw(Gen.telUri);
+  const g = googleParse(text, undefined), l = lpnParse(text, undefined);
+  if (!g.ok) fail(`google rejects ${show(text)}: ${g.error}`);
+  const gNumber = util.format(g.number, PNF.E164);
+  if (!l.ok) shaped("libphonenumber-js/2", `parse(${show(text)}, extract: false) failed: ${l.error}; google parsed ${gNumber}`);
+  if (l.number.number !== gNumber || l.number.number !== e164Of(pn)) fail(`parse(${show(text)}, extract: false) = ${l.number.number}, google ${gNumber}, expected ${e164Of(pn)}`);
+  if (l.number.ext !== ext) fail(`parse(${show(text)}, extract: false).ext = ${show(l.number.ext)}, expected ${show(ext)}`);
+  const valid = isValidPhoneNumber(text, metadata);
+  if (valid !== util.isValidNumber(g.number)) shaped("libphonenumber-js/2", `isValidPhoneNumber(${show(text)}) = ${valid}, google ${util.isValidNumber(g.number)}`);
+});
+
+// libphonenumber-js/3: whitespace around a number is ignored by the strict parse as Google ignores it
+property("TestHegelStrictParseIgnoresSurroundingWhitespace", (tc) => {
+  const { pn, text, defaultCountry } = tc.draw(Gen.spacedNumber);
+  const g = googleParse(text, defaultCountry), l = lpnParse(text, defaultCountry);
+  if (!g.ok) fail(`google rejects ${show(text)} (${show(defaultCountry)}): ${g.error}`);
+  const gNumber = util.format(g.number, PNF.E164);
+  if (!l.ok) shaped("libphonenumber-js/3", `parse(${show(text)}, ${show(defaultCountry)}, extract: false) failed: ${l.error}; google parsed ${gNumber}`);
+  if (l.number.number !== gNumber) fail(`parse(${show(text)}, ${show(defaultCountry)}, extract: false) = ${l.number.number}, google ${gNumber} (from ${e164Of(pn)})`);
+});
+
+// libphonenumber-js/4: the formatter's output for characters typed one at a time is its output for the same text at once
+property("TestHegelAsYouTypeFormatsTypedCharactersLikeTheWholeText", (tc) => {
+  const { chars, defaultCountry, cc } = tc.draw(Gen.chunkedNumber);
+  checkAsYouType(tc, chars, defaultCountry, cc);
+});
+
+// libphonenumber-js/5: the number typed digit by digit in a NANPA territory is the number the same digits parse to
+property("TestHegelAsYouTypeNumberTypedInANanpaTerritoryIsTheParsedNumber", (tc) => {
+  const { chars, defaultCountry, cc } = tc.draw(Gen.nanpaTerritoryNumber);
+  checkAsYouType(tc, chars, defaultCountry, cc);
+});
+
+// libphonenumber-js/6: a PhoneNumber built from an E.164 text has the country, validity and type of the parsed text
+property("TestHegelPhoneNumberBuiltFromE164DerivesItsCountry", (tc) => {
+  const pn = tc.draw(Gen.constructedNumber);
+  const e164 = e164Of(pn);
+  const parsed = parsePhoneNumber(e164, { extract: false }, metadata);
+  tc.assume(parsed !== undefined);
+  // (under HEGEL_NO_KNOWN=1 the two-argument form, for a number the parse attributes to that country)
+  if (noKnown) tc.assume(parsed.country === pn.region);
+  const built = noKnown ? new PhoneNumber(pn.region, pn.national, metadata) : new PhoneNumber(e164, metadata);
+  const what = noKnown ? `new PhoneNumber(${pn.region}, ${pn.national})` : `new PhoneNumber(${e164})`;
+  if (built.number !== parsed.number) fail(`${what}.number = ${built.number}, parse gives ${parsed.number}`);
+  if (built.country !== parsed.country) shaped("libphonenumber-js/6", `${what}.country = ${show(built.country)}, parse gives ${show(parsed.country)}`);
+  if (validity(built) !== validity(parsed)) shaped("libphonenumber-js/6", `${what} validity differs from parse: ${validity(built)} vs ${validity(parsed)}`);
+  if (built.format("INTERNATIONAL") !== parsed.format("INTERNATIONAL")) fail(`${what} formats as ${built.format("INTERNATIONAL")}, parse as ${parsed.format("INTERNATIONAL")}`);
+});
+
+// libphonenumber-js/7: the formatter keeps a national prefix that the parser and Google keep
+property("TestHegelAsYouTypeKeepsANationalPrefixThatParseKeeps", (tc) => {
+  const pn = tc.draw(Gen.nationalPrefixNumber);
+  const parsed = parsePhoneNumber(pn.national, { defaultCountry: pn.region, extract: false }, metadata);
+  const g = googleParse(pn.national, pn.region);
+  if (!parsed || !g.ok) fail(`parse(${pn.national}, ${pn.region}): libphonenumber-js ${parsed ? "parsed" : "failed"}, google ${g.ok ? "parsed" : g.error}`);
+  if (parsed.number !== util.format(g.number, PNF.E164)) fail(`parse(${pn.national}, ${pn.region}) = ${parsed.number}, google ${util.format(g.number, PNF.E164)}`);
+  const ayt = new AsYouType(pn.region, metadata);
+  ayt.input(pn.national);
+  const num = ayt.getNumber();
+  if (!num) fail(`AsYouType(${pn.region}).input(${pn.national}).getNumber() is undefined, parse gives ${parsed.number}`);
+  if (num.number !== parsed.number) shaped("libphonenumber-js/7", `AsYouType(${pn.region}).input(${pn.national}).getNumber().number = ${num.number}, parse (and google) ${parsed.number}`);
+});
+
+// libphonenumber-js/8: the characters of a number dialled with an IDD prefix are the typed ones
+property("TestHegelAsYouTypeCharsOfAnIddDialledNumberAreTheTypedOnes", (tc) => {
+  const { chars, defaultCountry, cc } = tc.draw(Gen.iddDialled);
+  checkAsYouType(tc, chars, defaultCountry, cc);
+});
+
+// libphonenumber-js/9: a number with an extension formats as Google formats it, whichever country of the calling code it belongs to
+property("TestHegelExtensionsFormatLikeTheMainCountryOfTheCallingCode", (tc) => {
+  const { region, cc, national, ext } = tc.draw(Gen.numberWithInheritedExt);
+  const e164 = `+${cc}${national}`;
+  const parsed = parsePhoneNumber(e164, { extract: false }, metadata);
+  tc.assume(parsed !== undefined && parsed.country === region);
+  parsed.setExt(ext);
+  const g = googleParse(`${e164} ext. ${ext}`, undefined);
+  if (!g.ok || g.number.getExtension() !== ext) fail(`google parse(${e164} ext. ${ext}): ${g.ok ? "ext " + g.number.getExtension() : g.error}`);
+  const intl = util.format(g.number, PNF.INTERNATIONAL);
+  if (spaces(parsed.format("INTERNATIONAL")) !== spaces(intl)) shaped("libphonenumber-js/9", `format(INTERNATIONAL) of ${e164} ext ${ext} (${region}) = ${show(parsed.format("INTERNATIONAL"))}, google ${show(intl)}`);
+  const nat = util.format(g.number, PNF.NATIONAL);
+  if (parsed.format("NATIONAL") !== nat) shaped("libphonenumber-js/9", `format(NATIONAL) of ${e164} ext ${ext} (${region}) = ${show(parsed.format("NATIONAL"))}, google ${show(nat)}`);
+  const rfc = util.format(g.number, PNF.RFC3966);
+  if (stripDashes(parsed.format("RFC3966")) !== stripDashes(rfc)) fail(`format(RFC3966) of ${e164} ext ${ext} = ${show(parsed.format("RFC3966"))}, google ${show(rfc)}`);
+});
+
+/** getNumber().number after typing `chars` one character at a time into an AsYouType with `defaultCountry`. */
+function typedNumber(chars, defaultCountry) {
+  const ayt = new AsYouType(defaultCountry, metadata);
+  for (const ch of chars) ayt.input(ch);
+  return ayt.getNumber()?.number;
+}
+
+// libphonenumber-js/10: an IDD prefix typed in national mode followed by digits that form no calling
+// code (a 0 first) builds the number the parse builds from the same text; under HEGEL_NO_KNOWN=1 the
+// IDD prefix is followed by a calling code and a valid national number
+property("TestHegelAsYouTypeNumberAfterAnIddPrefixWithoutACallingCodeIsTheParsedNumber", (tc) => {
+  const { chars, defaultCountry } = tc.draw(Gen.iddWithoutCallingCode);
+  const parsed = parsePhoneNumber(chars, { defaultCountry, extract: false }, metadata)?.number;
+  const typed = typedNumber(chars, defaultCountry);
+  if (parsed === undefined) return;
+  if (typed === undefined) shaped("libphonenumber-js/10", `AsYouType(${defaultCountry}).getNumber() undefined after typing ${show(chars)}, parse gives ${parsed}`);
+  if (typed !== parsed) fail(`AsYouType(${defaultCountry}).getNumber().number = ${typed} after typing ${show(chars)}, parse gives ${parsed}`);
+});
+
+// libphonenumber-js/11: the default country's own calling code typed in front of digits that are no
+// valid number of the country stays part of the number, as the parse (and the same text given at
+// once) keep it; under HEGEL_NO_KNOWN=1 the digits are a valid national number, which both read as
+// an international number
+property("TestHegelAsYouTypeKeepsTheDefaultCountrysCallingCodeWhenParseDoes", (tc) => {
+  const { chars, defaultCountry } = tc.draw(Gen.ownCallingCodeNumber);
+  const parsed = parsePhoneNumber(chars, { defaultCountry, extract: false }, metadata)?.number;
+  const typed = typedNumber(chars, defaultCountry);
+  if (typed !== parsed) shaped("libphonenumber-js/11", `AsYouType(${defaultCountry}).getNumber().number = ${show(typed)} after typing ${show(chars)}, parse gives ${show(parsed)}`);
+});
+
+// libphonenumber-js/12: a national prefix after the calling code of an international number is
+// stripped by the formatter as the parse (and Google) strip it; under HEGEL_NO_KNOWN=1 the number
+// carries no national prefix
+property("TestHegelAsYouTypeStripsANationalPrefixAfterTheCallingCodeLikeParse", (tc) => {
+  const chars = tc.draw(Gen.internationalWithNationalPrefix);
+  const parsed = parsePhoneNumber(chars, { extract: false }, metadata)?.number;
+  const typed = typedNumber(chars, undefined);
+  if (typed !== parsed) shaped("libphonenumber-js/12", `AsYouType().getNumber().number = ${show(typed)} for ${show(chars)}, parse gives ${show(parsed)}`);
+});
+
+// ---- pins ---------------------------------------------------------------------------------------------
+
+pin("TestHegelPinTristanDaCunhaFixedLineIsFixedLine", () => {
+  // libphonenumber-js/1: TA has fixed-line numbers and no mobile pattern; Google types 8999 as FIXED_LINE
+  const p = parsePhoneNumber("+2908999", { extract: false }, metadata);
+  assert.equal(p.country, "TA");
+  assert.equal(gType(util.parse("+2908999")), "FIXED_LINE");
+  assert.equal(p.getType(), "FIXED_LINE");
+});
+
+pin("TestHegelPinStrictParseAcceptsTelUris", () => {
+  // libphonenumber-js/2: extract: false rejects RFC 3966 tel: URIs, including the library's own format("RFC3966")
+  const num = parsePhoneNumber("+12133734253", metadata);
+  assert.equal(num.format("RFC3966"), "tel:+12133734253");
+  assert.equal(util.format(util.parse("tel:+12133734253", "ZZ"), PNF.E164), "+12133734253");
+  assert.equal(isValidPhoneNumber("tel:+12133734253", metadata), true);
+  const back = parsePhoneNumber(num.format("RFC3966"), { extract: false }, metadata);
+  assert.equal(back && back.number, "+12133734253");
+});
+
+pin("TestHegelPinStrictParseIgnoresLeadingWhitespace", () => {
+  // libphonenumber-js/3: leading whitespace is rejected under extract: false while trailing whitespace is accepted
+  assert.equal(isValidPhoneNumber("+12133734253 ", metadata), true);
+  assert.equal(util.format(util.parse(" +12133734253", "ZZ"), PNF.E164), "+12133734253");
+  assert.equal(isValidPhoneNumber(" +12133734253", metadata), true);
+});
+
+function typed(chars, defaultCountry) {
+  const ayt = new AsYouType(defaultCountry, metadata);
+  let out = "";
+  for (const ch of chars) out = ayt.input(ch);
+  return { out, ayt };
+}
+
+pin("TestHegelPinAsYouTypeOutputDoesNotDependOnChunking", () => {
+  // libphonenumber-js/4: the same characters typed one at a time and at once format differently
+  const once = new AsYouType(undefined, metadata).input("+80012345");
+  assert.equal(once, "+800 1234 5");
+  assert.equal(typed("+80012345", undefined).out, once);
+  const cn = new AsYouType("CN", metadata).input("28110746360");
+  assert.equal(cn, "28 110 746 360");
+  assert.equal(typed("28110746360", "CN").out, cn);
+});
+
+pin("TestHegelPinAsYouTypeNumberDoesNotDependOnChunking", () => {
+  // libphonenumber-js/5: typed one digit at a time with default country AI, a NANPA number gets the country's leading digits prepended
+  const once = new AsYouType("AI", metadata);
+  once.input("5002345678");
+  assert.equal(once.getNumber().number, "+15002345678");
+  assert.equal(parsePhoneNumber("5002345678", "AI", metadata).number, "+15002345678");
+  const { ayt } = typed("5002345678", "AI");
+  assert.equal(ayt.getNumber().number, "+15002345678");
+});
+
+pin("TestHegelPinPhoneNumberConstructorDerivesTheCountry", () => {
+  // libphonenumber-js/6: new PhoneNumber(e164) leaves country undefined (and validity follows) where parse finds it
+  assert.equal(parsePhoneNumber("+14413701234", metadata).country, "BM");
+  assert.equal(parsePhoneNumber("+14413701234", metadata).isValid(), true);
+  const built = new PhoneNumber("+14413701234", metadata);
+  assert.equal(built.isValid(), true);
+  assert.equal(built.country, "BM");
+  assert.equal(new PhoneNumber("+12133734253", metadata).country, "US");
+});
+
+pin("TestHegelPinAsYouTypeKeepsTheNationalPrefixWhenParseDoes", () => {
+  // libphonenumber-js/7: the formatter strips a national prefix that the parser (and Google) keeps
+  assert.equal(parsePhoneNumber("8005553535", "RU", metadata).number, "+78005553535");
+  assert.equal(util.format(util.parse("8005553535", "RU"), PNF.E164), "+78005553535");
+  const ru = new AsYouType("RU", metadata);
+  ru.input("8005553535");
+  assert.equal(ru.getNumber().number, "+78005553535");
