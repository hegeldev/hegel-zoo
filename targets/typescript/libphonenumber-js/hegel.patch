+// ---- 3. the shortcut functions ------------------------------------------------------------------
+
+const REASONS = { IS_POSSIBLE: undefined, INVALID_COUNTRY_CODE: "INVALID_COUNTRY", TOO_SHORT: "TOO_SHORT", INVALID_LENGTH: "INVALID_LENGTH", TOO_LONG: "TOO_LONG" };
+
+property("TestHegelShortcutsMatchParsing", (tc) => {
+  const useJunk = chance(tc, 15);
+  const pn = Gen.phoneNumber(tc);
+  const r = useJunk ? { text: Gen.junkText(tc), defaultCountry: chance(tc, 50) ? Gen.country(tc) : undefined } : Gen.render(tc, pn);
+  const { text, defaultCountry } = r;
+  const opts = { defaultCountry, extract: false };
+  const parsed = parsePhoneNumber(text, opts, metadata);
+  const valid = isValidPhoneNumber(text, opts, metadata);
+  const possible = isPossiblePhoneNumber(text, opts, metadata);
+  if (valid !== (parsed ? parsed.isValid() : false)) fail(`isValidPhoneNumber(${show(text)}, ${show(defaultCountry)}) = ${valid}, parse().isValid() = ${parsed && parsed.isValid()}`);
+  if (possible !== (parsed ? parsed.isPossible() : false)) fail(`isPossiblePhoneNumber(${show(text)}, ${show(defaultCountry)}) = ${possible}, parse().isPossible() = ${parsed && parsed.isPossible()}`);
+  if (valid && !possible) fail(`isValidPhoneNumber true but isPossiblePhoneNumber false for ${show(text)}, ${show(defaultCountry)}`);
+  // parsePhoneNumber is parsePhoneNumberWithError without the throw
+  const withError = lpnParse(text, defaultCountry);
+  if (withError.ok !== !!parsed) fail(`parsePhoneNumber(${show(text)}) ${parsed ? "parsed" : "undefined"} but parsePhoneNumberWithError ${withError.ok ? "parsed" : "threw " + withError.error}`);
+  if (parsed && withError.number.number !== parsed.number) fail(`parsePhoneNumber and parsePhoneNumberWithError disagree: ${parsed.number} vs ${withError.number.number}`);
+  // validatePhoneNumberLength against Google's isPossibleNumberWithReason
+  const len = validatePhoneNumberLength(text, opts, metadata);
+  if (len !== undefined && !["NOT_A_NUMBER", "INVALID_COUNTRY", "TOO_SHORT", "TOO_LONG", "INVALID_LENGTH"].includes(len)) fail(`validatePhoneNumberLength(${show(text)}) = ${show(len)}`);
+  if (parsed) {
+    if ((len === undefined) !== parsed.isPossible()) fail(`validatePhoneNumberLength(${show(text)}, ${show(defaultCountry)}) = ${show(len)} but isPossible() = ${parsed.isPossible()}`);
+    const g = googleParse(text, defaultCountry);
+    if (g.ok) {
+      const reason = VR[util.isPossibleNumberWithReason(g.number)];
+      const expected = REASONS[reason];
+      if (reason === "IS_POSSIBLE_LOCAL_ONLY") {
+        count("local-only");
