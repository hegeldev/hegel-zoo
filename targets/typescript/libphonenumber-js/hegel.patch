+pin("TestHegelPinAsYouTypeStripsANationalPrefixAfterTheCallingCode", () => {
+  // libphonenumber-js/12: +7 8 1012345672 is an 11-digit Russian number only with its national prefix 8
+  // stripped, as the parse and Google do
+  assert.equal(parsePhoneNumber("+781012345672", { extract: false }, metadata)?.number, "+71012345672");
