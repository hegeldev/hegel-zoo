+const varFunction = (values) => cat("var(", ows, customIdent, optText(50, cat(",", ows, optText(70, values))), ows, ")");
+/** A function over `values`: var(), a math function, or any other of FUNCTIONS with values inside (none 20% of the time). */
+const functionOf = (values) => pick(FUNCTIONS).flatMap((name) => (name === "var" ? varFunction(values) : MATH_FUNCTIONS.includes(name) ? mathFunction(name) : cat(name, "(", ows, optText(80, values), ows, ")")));
+
+/**
+ * One component of a value whose nested values come from `values` (null at the innermost
+ * depth): an ident 14% of the time, a number 10, a dimension 12, a percentage 6, a string 8, a
+ * hash 6, a url 6, a unicode range 4, an operator 3, a comment 4, and, when there is a level
+ * below, a parenthesised value 5, a bracketed one 3 and a function 19 (else an ident).
+ */
+function componentOf(values) {
+  const leaf = (identWeight) => [
+    [identWeight, ident], [10, num], [12, dimension], [6, percentage], [8, str], [6, hash], [6, url],
+    [4, pick(UNICODE_RANGES)], [3, pick(VALUE_OPERATORS)], [4, comment],
+  ];
+  if (values === null) return weighted(...leaf(41));
+  return weighted(...leaf(14), [5, cat("(", ows, values, ows, ")")], [3, cat("[", ows, values, ows, "]")], [19, functionOf(values)]);
+}
+/** Whether a component ending `left` can be glued to the next one without the two merging into one token (or a comment). */
+const gluable = (left) => /(\)|"|'|\]|%|\*\/)$/.test(left);
+/** 1-5 components, each after the first behind a space, comma, slash, newline or nothing (a space instead where nothing would merge the two into one token, and after a slash before a `*`, which would open a comment). */
+const valuesOf = (component) =>
+  gs.tuples(component, gs.arrays(gs.tuples(pick(VALUE_SEPARATORS), component), { maxSize: 4 })).map(([first, rest]) =>
+    rest.reduce((s, [sep, next]) => {
+      const between = sep === "" && !gluable(s) ? " " : sep;
+      return s + between + ((s + between).endsWith("/") && next.startsWith("*") ? " " : "") + next;
+    }, first),
+  );
+
+/** A declaration value, its functions and groups nested two deep. */
+export const values = [0, 1, 2].reduce((below, depth) => valuesOf(componentOf(depth === 0 ? null : below)), null);
+
+const IMPORTANT = ["!important", " !important", "! important", "!IMPORTANT", "!  important", " ! ie", "!ie", "!\nimportant"];
+/** The `!important` tail of a declaration: none 4 times in 14, one of eight spellings 8, with a comment before or after it 1 each. */
+export const important = weighted([4, gs.just("")], [8, pick(IMPORTANT)], [1, cat(comment, "!important")], [1, cat("!important", comment)]);
+
+export const PROPERTIES = ["color", "margin", "margin-top", "background", "width", "z-index", "font", "font-family", "content", "display", "border",
+  "grid-template-areas", "transition", "-webkit-box-shadow", "-moz-appearance", "*color", "_width", "//x", "$y", "#z", "+w", "/r",
+  "--x", "--custom-prop", "--Case", "COLOR", "Margin-Top", "src", "unicode-range", "filter", "animation", "unknown-property", "cx"];
+// A custom property value: anything balanced without a top-level ; or }.
+const CUSTOM_VALUES = ["", "", "", "1", "{a:b}", "[x]", "(y)", " a b c ", " red , blue ", "!important", "{;}", "url(x)", "'s'", "/*c*/", " /*c*/ 1 /*d*/ ", "\n2\n"];
+
+/** A declaration: a custom property with a raw value (and an important tail 30% of the time, unless the value is one), else a property, a value (none 8%) and the important tail, with optional whitespace at the colon. */
+export const declaration = pick(PROPERTIES).flatMap((name) =>
+  name.startsWith("--")
+    ? cat(name, ows, ":", gs.tuples(pick(CUSTOM_VALUES), optText(30, important)).map(([value, tail]) => (value.includes("!") ? value : value + tail)))
+    : cat(name, ows, ":", ows, optText(92, values), ows, important),
+);
+
+// ---------------------------------------------------------------- selectors
+
+const OTHER_SIMPLE_SELECTORS = ["*", "ns|a", "*|*", "|a", "ns|*", "&"];
+const ATTRIBUTE_NAMES = ["a", "data-x", "ns|attr", "*|a", "|a"];
+/** The matcher of an attribute selector: none, or an operator with a string or ident, some with a case flag. */
+const attributeMatcher = gs.oneOf(gs.just(""), cat("=", str), cat("~=", ident), cat("|=", ident), cat("^=", str), cat("$=", ident), cat("*=", str), cat("=", ident, " i"), cat("=", str, " S"), cat("= ", str, "\ti"));
+const attribute = cat("[", ows, pick(ATTRIBUTE_NAMES), ows, attributeMatcher, ows, "]");
+const PSEUDO_CLASSES = [":hover", ":first-child", ":nth-child(2n+1)", ":nth-child(odd)", ":nth-child( -n + 3 )", ":nth-last-of-type(even)", ":nth-of-type(3)", ":lang(en)", ":lang(en, fr-CA)", ":dir(rtl)", ":host", ":host(.a)", ":host-context(.b)", ":root", ":FIRST-CHILD", ":-moz-focusring", ":nth-child(2n of .a, .b)", ":empty"];
