index 0000000..234f7a3
--- /dev/null
+++ b/hegel/model.mjs
@@ -0,0 +1,142 @@
+// Small models the css-tree properties compare against.
+
+import { List } from "../lib/index.js";
+
+// Line and column of `offset` in `source`, counting newlines as css-tree documents them
+// (LF, CR LF, CR and FF each end a line), from a given starting line and column.
+export function lineCol(source, offset, startLine = 1, startColumn = 1) {
+  let line = startLine;
+  let column = startColumn;
+  for (let i = 0; i < offset; i++) {
+    const c = source.charCodeAt(i);
+    if (c === 0x0d && source.charCodeAt(i + 1) === 0x0a) {
+      i++;
+      if (i >= offset) return { line, column: column + 1 };
+      line++;
+      column = 1;
+    } else if (c === 0x0a || c === 0x0d || c === 0x0c) {
+      line++;
+      column = 1;
+    } else {
+      column++;
+    }
+  }
+  return { line, column };
+}
+
+// The first path where two plain values differ, with both values, or null when equal.
+export function firstDiff(a, b, path = "$") {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b)) return { path, a, b };
+    if (a.length !== b.length) return { path: path + ".length", a: a.length, b: b.length };
+    for (let i = 0; i < a.length; i++) {
+      const d = firstDiff(a[i], b[i], `${path}[${i}]`);
+      if (d) return d;
+    }
+    return null;
+  }
+  if (a && b && typeof a === "object" && typeof b === "object") {
+    const keys = [...new Set([...Object.keys(a), ...Object.keys(b)])];
+    for (const k of keys) {
+      const d = firstDiff(a[k], b[k], `${path}.${k}`);
+      if (d) return d;
+    }
+    return null;
+  }
+  return a === b ? null : { path, a, b };
+}
+
+// A plain, loc-free copy of an AST (Lists become arrays) for structural comparison.
+export function plain(ast) {
+  return JSON.parse(JSON.stringify(ast, (k, v) => (k === "loc" ? undefined : v)));
+}
+
+// The node fields of an AST node in traversal order: `structure[type].docs` when the lexer
+// knows the type (the order the walker uses), else key order.
+export function nodeFields(structure, node) {
+  const docs = structure && structure[node.type] && structure[node.type].docs;
+  const keys = docs ? Object.keys(docs) : Object.keys(node);
+  const fields = [];
+  for (const key of keys) {
+    if (key === "type" || key === "loc") continue;
+    const v = node[key];
+    if (v instanceof List || Array.isArray(v)) fields.push({ key, list: true });
+    else if (v && typeof v === "object" && typeof v.type === "string") fields.push({ key, list: false });
+  }
+  return fields;
+}
+
+// Preorder traversal of an AST: [{node, parent, inList, ancestors}] in the walker's natural order
+// (fields in structure order, children first to last), or reversed when `reverse`.
+export function traverse(structure, root, reverse = false) {
+  const out = [];
+  const walk = (node, parent, inList, ancestors, depth) => {
+    out.push({ node, parent, inList, ancestors, depth });
+    const kids = [];
+    for (const f of nodeFields(structure, node)) {
+      const v = node[f.key];
+      if (f.list) {
+        const arr = v instanceof List ? v.toArray() : v;
+        for (const child of arr) kids.push([child, true]);
+      } else {
+        kids.push([v, false]);
+      }
+    }
+    if (reverse) kids.reverse();
+    for (const [child, inL] of kids) walk(child, node, inL, [node, ...ancestors], depth + 1);
+  };
+  walk(root, null, false, [], 0);
+  return out;
+}
+
+// Postorder (leave) sequence matching `traverse`.
+export function traverseLeave(structure, root, reverse = false) {
+  const out = [];
+  const walk = (node) => {
+    const kids = [];
+    for (const f of nodeFields(structure, node)) {
+      const v = node[f.key];
+      if (f.list) for (const child of (v instanceof List ? v.toArray() : v)) kids.push(child);
+      else kids.push(v);
+    }
+    if (reverse) kids.reverse();
+    for (const child of kids) walk(child);
+    out.push(node);
+  };
+  walk(root);
+  return out;
+}
+
+// Preorder with the subtrees below nodes of type `skipType` left out (the node itself kept).
+export function traverseSkipping(structure, root, skipType) {
+  const out = [];
+  const walk = (node) => {
+    out.push(node);
+    if (node.type === skipType) return;
+    for (const f of nodeFields(structure, node)) {
+      const v = node[f.key];
+      if (f.list) for (const child of (v instanceof List ? v.toArray() : v)) walk(child);
+      else walk(v);
+    }
+  };
+  walk(root);
+  return out;
+}
+
+// CSSOM "serialize a string" for strings without control characters (css-tree shortens the
+// code-point escapes of control characters, so those are checked by round trip only).
+export function cssomString(s, apostrophe) {
+  const q = apostrophe ? "'" : '"';
+  let out = q;
+  for (const ch of s) {
+    if (ch === "\0") out += "�";
+    else if (ch === q || ch === "\\") out += "\\" + ch;
+    else out += ch;
+  }
+  return out + q;
+}
+
+// A pool of characters for the encoder tests: quotes, backslashes, controls, hex digits,
+// spaces, newlines, NUL, DEL, non-ASCII, an astral character (no U+0080-U+00B6: the two tokenizers
+// follow different editions of the spec on which non-ASCII code points are ident code points).
+export const ENCODE_CHARS = ["a", "b", "z", "A", "0", "9", "f", "F", "-", "_", " ", " ", "\t", "\n", "\r", "\f", "\x01", "\x1f", "\x7f", "\0", "\"", "'", "\\", "(", ")", "/", "*", ",", ";", ":", "!", "%", "#", ".", "\u00fc", "\u65e5", "\u{1f600}", "\ufffd"];
