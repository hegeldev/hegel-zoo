+
+/** A term of a math function: a number, dimension or percentage, `var(--x)`, a parenthesised sum, or a constant (e, pi, infinity, -infinity, NaN). */
+const mathTerm = weighted([1, num], [1, dimension], [1, percentage], [1, gs.just("var(--x)")], [1, cat("(", num, " + ", dimension, ")")], [5, pick(["e", "pi", "infinity", "-infinity", "NaN"])]);
+/** A math function of `name`: a term and 0-3 more, each after an operator. */
+const mathFunction = (name) => cat(name, "(", ows, mathTerm, many(cat(pick([" + ", " - ", "*", " * ", "/", " / ", ","]), mathTerm), 3), ows, ")");
