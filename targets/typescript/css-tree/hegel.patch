+  const { before, control, after } = tc.draw(gs.record({ before: encodeChars(3), control: gs.sampledFrom(["\t", "\x01", "\x1f", "\x7f", "\x0b", "\n"]), after: encodeChars(3) }));
+  checkEncoders(tc, before + control + "\0" + (after === "" ? "a" : after));
