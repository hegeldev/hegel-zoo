+  const simpleSelector = simpleSelectorOf(below);
+  const selector = selectorOf(simpleSelector);
+  return { simpleSelector, selector, selectorList: selectorListOf(selector) };
+}, null);
+export const selector = selectors.selector;
+export const selectorList = selectors.selectorList;
+
+// ---------------------------------------------------------------- at-rule preludes
+
+/** A condition over `term`: a term and 0-2 more behind one of `and`/`or` 80% of the time, else `not` and a term. */
+const conditionOf = (term) => weighted([80, cat(term, pick([" and ", " or "]).flatMap((op) => many(cat(op, term), 2)))], [20, cat("not ", term)]);
+
+const MEDIA_FEATURES = ["(min-width: 100px)", "(max-width:1e3px)", "(width >= 600px)", "(400px < width < 700px)", "(width<=1px)", "(orientation: landscape)", "(color)", "(min-resolution: 2dppx)",
