+/** A supports condition nested up to two deep: a term is an atom, or, above depth 0, a parenthesised condition of the depth below 6% of the time (parsed fully with a spurious error, css-tree/11). */
+export const supportsCondition = [0, 1, 2].reduce((below, depth) => conditionOf(depth === 0 ? supportsAtom : weighted([94, supportsAtom], [6, cat("(", below, ")")])), null);
+
+const CONTAINER_ATOMS = ["(width > 400px)", "(min-width: 30em)", "(inline-size >= 30em)", "(orientation: portrait)", "style(--x: 1)", "style(--responsive: true)", "(200px <= width <= 300px)", "(aspect-ratio > 1)"];
