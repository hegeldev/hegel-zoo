@@ -0,0 +1,245 @@
+// One deterministic reproduction per bug in bugs.toml; each is listed under [expected_failures]
+// in target.toml and should pass once upstream fixes it.
+
+import { pin } from "./hegel-zoo.mjs";
+import * as ct from "../lib/index.js";
+
+const { parse, walk, find, findAll, tokenize, tokenNames } = ct;
+const refTokenizer = await import(new URL("../.hegel/node_modules/@csstools/css-tokenizer/dist/index.mjs", import.meta.url));
+
+function tokens(source) {
+  const out = [];
+  tokenize(source, (type, start, end) => out.push({ type: tokenNames[type], raw: source.slice(start, end), start, end }));
+  return out;
+}
+
+pin("TestHegelPinBadStringTokenStopsBeforeTheNewline", () => {
+  // css-tree/1: CSS Syntax Level 3 § 4.3.5 - on a newline, "reconsume the current input code
+  // point, create a <bad-string-token>, and return it": the newline is not part of the token.
+  const source = '"bad\nstr"';
+  const shape = tokens(source).map((t) => t.type + ":" + JSON.stringify(t.raw)).join(" ");
+  const want = 'bad-string-token:"\\"bad" whitespace-token:"\\n" ident-token:"str" string-token:"\\""';
+  if (shape !== want) throw new Error(`tokenize(${JSON.stringify(source)}) gives ${shape}, expected ${want}`);
+});
+
+pin("TestHegelPinBackslashAtEndOfInputIsAnEscape", () => {
+  // css-tree/2: CSS Syntax Level 3 § 4.3.8 - a backslash is a valid escape unless followed by a
+  // newline, and § 4.3.7 decodes an escape at EOF as U+FFFD; so `a\` is one ident "a�".
+  const ref = refTokenizer.tokenize({ css: "a\\" }).filter((t) => t[0] !== "EOF-token").map((t) => t[0]).join(" ");
+  if (ref !== "ident-token") throw new Error(`reference tokenizer gives ${ref}`);
+  const got = tokens("a\\").map((t) => t.type).join(" ");
+  if (got !== "ident-token") throw new Error(`tokenize("a\\\\") gives ${got}, expected one ident-token`);
+  if (ct.ident.decode("a\\") !== "a�") throw new Error(`ident.decode("a\\\\") = ${JSON.stringify(ct.ident.decode("a\\"))}, expected "a\\uFFFD"`);
+});
+
+pin("TestHegelPinUrlWithOnlyWhitespaceDecodesToEmpty", () => {
+  // css-tree/3: `url( )` is a <url-token> whose value is the empty string (the whitespace is
+  // consumed, CSS Syntax § 4.3.6); css-tree keeps one space.
+  if (ct.url.decode("url( )") !== "") throw new Error(`url.decode("url( )") = ${JSON.stringify(ct.url.decode("url( )"))}, expected ""`);
+  if (ct.url.decode("url(  )") !== "") throw new Error(`url.decode("url(  )") = ${JSON.stringify(ct.url.decode("url(  )"))}, expected ""`);
+  const node = parse("url( )", { context: "value" }).children.first;
+  if (node.type !== "Url" || node.value !== "") throw new Error(`parse("url( )") gives ${node.type} ${JSON.stringify(node.value)}, expected Url ""`);
+});
+
+pin("TestHegelPinNulIsReplacedByTheReplacementCharacter", () => {
+  // css-tree/4: CSS Syntax § 3.3 preprocesses U+0000 to U+FFFD, a name code point, so a NUL
+  // between two letters is inside one ident; css-tree tokenizes the NUL as a delim.
+  const source = "a\u0000b"; // U+0000 written as an escape so the file stays text
+  const types = tokens(source).map((t) => t.type).join(" ");
+  if (types !== "ident-token") throw new Error(`tokenize("a\\u0000b") gives ${types}, expected one ident-token`);
+});
+
+pin("TestHegelPinVisitDeclarationReachesSupportsPreludes", () => {
+  // css-tree/5: docs/traversal.md says walk with `visit: 'Declaration'` is equivalent to testing
+  // node.type in enter; a declaration in a @supports prelude is reached only by the latter.
+  const ast = parse("@supports (display: grid) {}");
+  const byType = findAll(ast, (node) => node.type === "Declaration").length;
+  let byVisit = 0;
+  walk(ast, { visit: "Declaration", enter: () => byVisit++ });
+  if (byType !== 1) throw new Error(`expected one Declaration node, found ${byType}`);
+  if (byVisit !== byType) throw new Error(`visit:'Declaration' enters ${byVisit} nodes, the type test ${byType}`);
+});
+
+pin("TestHegelPinPropertyDescriptorIsSharedAcrossSpellings", () => {
+  // css-tree/6: docs/utils.md - property() "returns the same immutable (frozen) object for the
+  // same input (input after normalization)", `property('name') === property('NAME')`.
+  const upper = ct.property("ZOO-PIN-PROPERTY");
+  const lower = ct.property("zoo-pin-property");
+  if (upper !== lower) throw new Error("property('ZOO-PIN-PROPERTY') !== property('zoo-pin-property') when the upper-case spelling is asked first");
+});
+
+pin("TestHegelPinDescendantCombinatorHasALocation", () => {
+  // css-tree/7: with positions:true every node gets a loc (docs/ast.md); the whitespace
+  // combinator between `a` and `b` is created with loc null (scope/selector.js onWhiteSpace).
+  const ast = parse("a b{}", { positions: true });
+  const comb = find(ast, (node) => node.type === "Combinator");
+  if (!comb) throw new Error("no Combinator node");
+  if (comb.loc === null) throw new Error("the descendant Combinator has loc null with positions: true");
+  if (comb.loc.start.offset !== 1 || comb.loc.end.offset !== 2) throw new Error(`descendant Combinator at ${comb.loc.start.offset}-${comb.loc.end.offset}, expected 1-2`);
+});
+
+pin("TestHegelPinUrlDecodeKeepsAnEscapedTrailingSpace", () => {
+  // css-tree/8: `url(a\ )` is the URL "a " (an escaped space is part of the value); css-tree
+  // trims the escaped space as whitespace and then returns " )" - the encoder produces exactly
+  // this form for a value ending in a space, so url.decode(url.encode("a ")) is " )".
+  const got = ct.url.decode("url(a\\ )");
+  if (got !== "a ") throw new Error(`url.decode("url(a\\\\ )") = ${JSON.stringify(got)}, expected "a "`);
+  const round = ct.url.decode(ct.url.encode("a "));
+  if (round !== "a ") throw new Error(`url.decode(url.encode("a ")) = ${JSON.stringify(round)}`);
+});
+
+pin("TestHegelPinGenerateIsIdempotentOnBackslashNewline", () => {
+  // css-tree/9: a backslash followed by a newline is a delim plus whitespace; generate() writes
+  // a newline after the backslash and then the whitespace too, so each round adds a newline.
+  const source = "a{--x:\\\n1}";
+  const once = ct.generate(parse(source));
+  const twice = ct.generate(parse(once));
+  if (once !== source) throw new Error(`generate(parse(${JSON.stringify(source)})) = ${JSON.stringify(once)}`);
+  if (twice !== once) throw new Error(`generate is not idempotent: ${JSON.stringify(once)} then ${JSON.stringify(twice)}`);
+});
+
+pin("TestHegelPinBadUrlTokenStopsAtItsClosingParenthesis", () => {
+  // css-tree/10: CSS Syntax 4.3.15 (consume the remnants of a bad url) ends a <bad-url-token> at
+  // the first unescaped ) and consumes escapes as escapes. css-tree's remnants loop advances one
+  // more code point after each escape, so the ) after `\41` is skipped and the token swallows
+  // everything up to the next ) or the end of the input (one past it when the escape is last).
+  const source = "url(a b\\41)c{d:e}";
+  const got = tokens(source);
+  const bad = got[0];
+  if (bad.type !== "bad-url-token" || bad.end !== 11 || got.length !== 7) {
+    throw new Error(`tokenize gives ${got.map((t) => `${t.type}@${t.start}-${t.end}`).join(" ")}, expected bad-url-token@0-11 followed by 6 tokens`);
+  }
+});
+
+pin("TestHegelPinGeneratedChildCombinatorAfterDoubleHyphenReparses", () => {
+  // css-tree/14: `--` is a valid ident and so a valid type selector; generate() emits no space
+  // between it and a child combinator, and the output `-->b{}` starts with a CDC token.
+  const source = "-- > b {}";
+  const out = ct.generate(ct.parse(source));
+  const again = ct.parse(out);
+  const rule = again.children.first;
+  if (rule.type !== "Rule" || rule.prelude.type !== "SelectorList" || rule.prelude.children.size !== 1 || rule.prelude.children.first.children.size !== 3) {
+    throw new Error(`generate gives ${JSON.stringify(out)}, which parses back as ${JSON.stringify(ct.toPlainObject(again).children.map((c) => c.type))}`);
+  }
+});
+
+pin("TestHegelPinValidNestedMediaConditionReportsNoParseError", () => {
+  // css-tree/11: `((hover) and (color))` is a <media-in-parens> wrapping a <media-condition>
+  // (Media Queries 4, 3.2). css-tree parses it into a nested Condition node with no Raw content,
+  // yet calls onParseError ("Number, dimension, ratio or identifier is expected") because the
+  // first parse attempt (a feature) failed before the nested-condition fallback succeeded.
+  const errors = [];
+  const ast = ct.parse("@media ((hover) and (color)) {}", { onParseError: (e) => errors.push(e.message) });
+  if (ct.find(ast, (node) => node.type === "Raw") !== null) throw new Error("the tree has a Raw node");
+  if (errors.length !== 0) throw new Error(`onParseError was called: ${JSON.stringify(errors)}`);
+});
+
+pin("TestHegelPinNestedRuleWithoutNestingSelectorIsARule", () => {
+  // css-tree/12 (upstream #268): CSS Nesting allows a nested style rule whose selector does not
+  // start with &; css-tree parses `a { .x {} }` as a Raw node ".x {}" and reports a parse error.
+  const ast = ct.parse("a { .x { color: red } }");
+  const inner = ast.children.first.block.children.first;
+  if (inner.type !== "Rule") throw new Error(`the nested rule is a ${inner.type} node: ${JSON.stringify(ct.generate(inner))}`);
+});
+
+pin("TestHegelPinNestedLayerBlockHoldsDeclarations", () => {
+  // css-tree/13: CSS Nesting lets @layer (like @media, @supports, @container, @scope and
+  // @starting-style) nest inside a style rule, where its block is a style block. css-tree's
+  // @layer parser ignores the nesting flag the others honour, so the declaration becomes Raw.
+  const ast = ct.parse("a { @layer x { color: red } }");
+  const inner = ast.children.first.block.children.first.block.children.first;
+  if (inner.type !== "Declaration") throw new Error(`the nested @layer block holds a ${inner.type} node: ${JSON.stringify(ct.generate(inner))}`);
+});
+
+pin("TestHegelPinEscapedUrlNameStartsAUrlToken", () => {
+  // css-tree/15: CSS Syntax 4.3.4 (consume an ident-like token) compares the *decoded* ident
+  // sequence with "url", so `\url(a)` (an escaped u) starts a <url-token>; css-tree compares the raw
+  // text and gives a function-token, an ident-token and a )-token.
+  const got = tokens("\\url(a)").map((t) => t.type).join(" ");
+  if (got !== "url-token") throw new Error(`tokenize("\\\\url(a)") gives ${got}, expected one url-token`);
+});
+
+pin("TestHegelPinStringEncodeRoundTripsAControlCharacterBeforeNul", () => {
+  // css-tree/16: string.encode writes "\t" as the hex escape `\9` and remembers that a space is
+  // needed before a following hex digit or whitespace; a NUL (written as U+FFFD) skips that
+  // bookkeeping, so the space is inserted after the U+FFFD instead: "\t\0a" -> "\9� a", which
+  // decodes to "\t� a". url.encode has the same flaw; ident.encode does not.
+  const s = "\t\0a";
+  const enc = ct.string.encode(s);
+  const dec = ct.string.decode(enc);
+  if (dec !== "\t�a") throw new Error(`string.decode(string.encode("\\t\\0a")) = ${JSON.stringify(dec)} via ${JSON.stringify(enc)}, expected "\\t\\uFFFDa"`);
+});
+
+pin("TestHegelPinMediaTypeBeforeSpacedCommaParses", () => {
+  // css-tree/17: Media Queries 4 allows whitespace around the commas of a <media-query-list>; when the
+  // query before the comma ends in a media type, the @media prelude parser leaves the whitespace token
+  // over and fails with "Semicolon or block is expected", keeping a Raw prelude.
+  const errors = [];
+  const ast = parse("@media print , screen {}", { onParseError: (e) => errors.push(e.message.split("\n")[0]) });
+  const prelude = ast.children.first.prelude;
+  if (errors.length !== 0 || prelude.type !== "AtrulePrelude") throw new Error(`@media print , screen {} gives a ${prelude.type} prelude with errors ${JSON.stringify(errors)}; "@media print, screen {}" parses`);
+});
+
+pin("TestHegelPinUnicodeRangeBeforeSignedNumberReparses", () => {
+  // css-tree/18: generate() writes no space between an open-ended UnicodeRange and a following signed
+  // number, so `U+26 -1px` comes out as `U+26-1px`, which the parser reads as a range with a dash.
+  const out = ct.generate(parse("a{b:U+26 -1px}"));
+  const value = parse(out, { onParseError() {} }).children.first.block.children.first.value;
+  const shape = value.type === "Raw" ? "Raw " + JSON.stringify(value.value) : value.children.toArray().map((n) => n.type).join(" ");
+  if (shape !== "UnicodeRange Dimension") throw new Error(`generate gives ${JSON.stringify(out)}, which re-parses as ${shape}, expected UnicodeRange Dimension`);
+});
+
+pin("TestHegelPinUnterminatedStringEscapedQuoteIsContent", () => {
+  // css-tree/19: CSS Syntax 4.3.5 ends a string at EOF and treats an escaped quote inside it as content,
+  // so the four characters `"a\"` decode to `a"`; string.decode takes the final quote as the closing one.
+  const raw = '"a\\"';
+  const got = ct.string.decode(raw);
+  if (got !== 'a"') throw new Error(`string.decode(${JSON.stringify(raw)}) = ${JSON.stringify(got)}, expected ${JSON.stringify('a"')}`);
+});
+
+pin("TestHegelPinOperatorWhitespaceSurvivesGenerate", () => {
+  // css-tree/20: an Operator's value keeps the whitespace around it in the source; after a comment the
+  // `-` has "- ", generate() writes a space before it, and the re-parsed tree has " - ".
+  const ops = (ast) => { const out = []; walk(ast, (n) => { if (n.type === "Operator") out.push(n.value); }); return JSON.stringify(out); };
+  const ast = parse("a{b:x/*c*/- 1}");
+  const out = ct.generate(ast);
+  const again = parse(out);
+  if (ops(ast) !== ops(again)) throw new Error(`the Operator values are ${ops(ast)} before and ${ops(again)} after generate (${JSON.stringify(out)})`);
+});
+
+pin("TestHegelPinQuotedTokenBeforeCommaMatches", () => {
+  // css-tree/21: the lexer never matches a quoted grammar token (`'*'`, `'+'`, `']'`) that is directly
+  // followed by a comma; `'*' <ident-token>` matches `* a`, and the list `#foo, *` matches.
+  const res = ct.lexer.match("'*' , <ident-token>", parse("*, a", { context: "value" }));
+  if (res.error) throw new Error(`lexer.match("'*' , <ident-token>", "*, a") fails: ${res.error.message.split("\n")[0]}`);
+  const list = ct.lexer.matchType("compound-selector-list", "*, #foo");
+  if (list.error) throw new Error(`matchType("compound-selector-list", "*, #foo") fails: ${list.error.message.split("\n")[0]}`);
+});
+
+pin("TestHegelPinGenerateSeparatesAnEUnitFromAPlusSignedNumber", () => {
+  // css-tree/22: a Dimension with the unit `e` followed by a `+`-signed number is written without a
+  // space, so `1e +1` comes out as `1e+1`, one number with an exponent (`1e -1` keeps its space).
+  const shape = (ast) => ast.children.first.block.children.first.value.children.toArray().map((n) => n.type + ":" + n.value + (n.unit || "")).join(" ");
+  const ast = parse("a{b:1e +1}");
+  const out = ct.generate(ast);
+  const again = parse(out);
+  if (shape(ast) !== shape(again)) throw new Error(`generate gives ${JSON.stringify(out)}: ${shape(again)}, expected ${shape(ast)}`);
+});
+
+pin("TestHegelPinContainerStyleWithRawContentPassesCheckStructure", () => {
+  // css-tree/23: FeatureFunction's structure admits Declaration and Selector values, yet its parser falls
+  // back to a Raw value when the style() content is not a declaration, so checkStructure warns on the
+  // parser's own output.
+  const ast = parse("@container style(--a!) {}", { onParseError() {} });
+  const warns = ct.lexer.checkStructure(ast);
+  if (warns !== false) throw new Error(`checkStructure warns ${JSON.stringify(warns.map((w) => w.message))} on the parser's output for "@container style(--a!) {}"`);
+});
+
+pin("TestHegelPinUnclosedBlockAtEndOfInputIsAParseError", () => {
+  // css-tree/24: CSS Syntax 5.4.8 (consume a simple block): reaching the end of the input is a parse
+  // error. css-tree reports nothing for `a{b:(`, and for `a{b:expression([(}` the Raw swallows the
+  // `}` silently while generate() adds the closers, so the output re-parses to a different tree.
+  const errors = [];
+  parse("a{b:(", { onParseError: (e) => errors.push(e.message.split("\n")[0]) });
+  if (errors.length === 0) throw new Error('parse("a{b:(") calls onParseError 0 times; the block and the parenthesis are unclosed at the end of the input');
+});
