@@ -0,0 +1,759 @@
+// Hegel zoo: the generators behind the css-tree properties, as values built from Hegel's
+// combinators, and the pure functions that render what they draw.
+//
+// CSS text is a grammar of generator values: a stylesheet is a list of rules, at-rules,
+// comments and stray tokens; a rule a selector list and a declaration block; a value a list of
+// components (idents, numbers, dimensions, strings, urls, functions, nested parentheses) with
+// the separator drawn between each pair; and the whitespace at every gap is drawn where it is
+// written, so a case shrinks to the plain spelling. The recursive constructs (values inside
+// functions, selectors inside pseudo-classes, blocks inside blocks) are bounded by building each
+// depth's generators from the ones below, since the binding has no recursive combinator. A
+// "soup" of CSS-flavoured pieces (NUL, BOM, escapes, unterminated constructs) covers the
+// tokenizer's error paths. `valueFromSyntax` derives a value from one of the lexer's own
+// definition-syntax grammars: that derivation is a composite, since every choice depends on the
+// grammar node reached and on the budget spent so far; `grammarAst` draws a definition-syntax
+// tree for the round trip of that parser.
+
+import { gs } from "./hegel-zoo.mjs";
+
+// ---------------------------------------------------------------- generator helpers
+
+export const ints = (lo, hi) => gs.integers({ minValue: lo, maxValue: hi });
+
+/** oneOf with weights: `weighted([45, a], [55, b])` draws a 45 times in 100; shrinks towards the first choice. */
+export function weighted(...choices) {
+  if (choices.length === 1) return choices[0][1];
+  const total = choices.reduce((sum, [w]) => sum + w, 0);
+  return ints(0, total - 1).flatMap((r) => {
+    for (const [w, g] of choices) {
+      if (r < w) return g;
+      r -= w;
+    }
+    throw new Error("unreachable");
+  });
+}
+
+/** True pct percent of the time; shrinks to false. */
+export const chance = (pct) => ints(0, 99).map((r) => r >= 100 - pct);
+/** A draw from g pct percent of the time, else undefined (listed first: shrinks to absent). */
+export const maybe = (pct, g) => weighted([100 - pct, gs.just(undefined)], [pct, g]);
+/** A string constant as a generator, a generator as it is. */
+const lift = (p) => (typeof p === "string" ? gs.just(p) : p);
+/** The text of g pct percent of the time, else the empty text (first: shrinks to nothing). */
+const optText = (pct, g) => weighted([100 - pct, gs.just("")], [pct, lift(g)]);
+/** The texts of `parts` (generators or string constants) concatenated. */
+export const cat = (...parts) => gs.tuples(...parts.map(lift)).map((xs) => xs.join(""));
+/** `min` to `max` texts of g concatenated. */
+const many = (g, max, min = 0) => gs.arrays(g, { minSize: min, maxSize: max }).map((xs) => xs.join(""));
+const pick = (xs) => gs.sampledFrom(xs);
+
+// ---------------------------------------------------------------- whitespace, idents, tokens
+
+export const WS = [" ", " ", " ", "  ", "\n", "\t", "\r\n", "\f", " \n ", "\r"];
+export const ws = pick(WS);
+/** Optional whitespace: none 65% of the time. */
+export const ows = weighted([65, gs.just("")], [35, ws]);
+
+// Valid identifiers (escapes and non-ASCII included); no CSS-wide keywords.
+export const IDENTS = ["a", "b", "div", "span", "color", "margin-top", "background", "width", "z-index",
+  "font-family", "content", "x1", "-webkit-flex", "\u{fc}", "\\31 23", "e\\:x", "A", "Bc", "hyphenated-long-name",
+  "-x", "_y", "\\-", "i\\64 1", "\u{65e5}\u{672c}", "\u{1f600}x", "--", "-\\-", "red", "none", "auto", "e3", "n", "odd"];
+export const ident = pick(IDENTS);
+export const customIdent = pick(["--x", "--custom-prop", "--0", "--\\31", "---", "--\u{65e5}"]);
+
+export const STRINGS = ['"a"', "'b'", '""', "''", '"a;b"', '"{"', "'}'", '"\\""', "'\\''", '"a\\\nb"', '"( "', '")"',
+  '"/*"', '"*/"', '"\\61"', '"\\61 b"', '"\\0"', '"\\110000"', '"a\\\r\nb"', "'\u{fc}\\9 x'", '"\\1F600"', '"tab\there"'];
