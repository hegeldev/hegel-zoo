+  [15, pick(MEDIA_TYPES)],
+  [15, cat(pick(["screen", "not print", "only screen", "all"]), " and ", mediaTerms[1], many(cat(" and ", mediaTerms[1]), 2))],
+  [70, mediaConditions[2]],
+);
+/** A media query list: a query and 0-2 more behind commas (KNOWN: whitespace before a comma that follows a media type fails to parse, css-tree/17; under HEGEL_NO_KNOWN=1 no comma has whitespace before it). */
