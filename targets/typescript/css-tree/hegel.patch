@@ -0,0 +1,596 @@
+// Generators for the css-tree properties: CSS text (stylesheets built from the constructs the
+// parser knows, and token soup), and values built from css-tree's own value definition syntax.
+
+import { chance, n, pick, word } from "./hegel-zoo.mjs";
+
+// ---------- whitespace, idents, tokens ----------
+
+export const WS = [" ", " ", " ", "  ", "\n", "\t", "\r\n", "\f", " \n ", "\r"];
+export const ws = (tc) => pick(tc, WS);
+export const ows = (tc) => (chance(tc, 65) ? "" : ws(tc));
+
+// Valid identifiers (escapes and non-ASCII included); no CSS-wide keywords.
+export const IDENTS = ["a", "b", "div", "span", "color", "margin-top", "background", "width", "z-index",
+  "font-family", "content", "x1", "-webkit-flex", "ü", "\\31 23", "e\\:x", "A", "Bc", "hyphenated-long-name",
+  "-x", "_y", "\\-", "i\\64 1", "日本", "😀x", "--", "-\\-", "red", "none", "auto", "e3", "n", "odd"];
+export const ident = (tc) => pick(tc, IDENTS);
+export const customIdent = (tc) => pick(tc, ["--x", "--custom-prop", "--0", "--\\31", "---", "--日"]);
+
+export const STRINGS = ['"a"', "'b'", '""', "''", '"a;b"', '"{"', "'}'", '"\\""', "'\\''", '"a\\\nb"', '"( "', '")"',
+  '"/*"', '"*/"', '"\\61"', '"\\61 b"', '"\\0"', '"\\110000"', '"a\\\r\nb"', "'ü\\9 x'", '"\\1F600"', '"tab\there"'];
+export const str = (tc) => pick(tc, STRINGS);
+
+export const NUMBERS = ["0", "1", "-1", "+1", ".5", "-.5", "1.5", "1e3", "1E-3", "1.5e+2", "007", "0.0", "-0", "1e0", "100", "12.50"];
+export const num = (tc) => pick(tc, NUMBERS);
+
+export const UNITS = {
+  length: ["cm", "mm", "q", "in", "pt", "pc", "px", "em", "rem", "ex", "rex", "cap", "rcap", "ch", "rch", "ic", "ric", "lh", "rlh",
+    "vw", "svw", "lvw", "dvw", "vh", "svh", "lvh", "dvh", "vi", "svi", "lvi", "dvi", "vb", "svb", "lvb", "dvb",
+    "vmin", "svmin", "lvmin", "dvmin", "vmax", "svmax", "lvmax", "dvmax", "cqw", "cqh", "cqi", "cqb", "cqmin", "cqmax"],
+  angle: ["deg", "grad", "rad", "turn"],
+  time: ["s", "ms"],
+  frequency: ["hz", "khz"],
+  resolution: ["dpi", "dpcm", "dppx", "x"],
+  flex: ["fr"],
+  decibel: ["db"],
+  semitones: ["st"],
+};
+const ALL_UNITS = Object.values(UNITS).flat();
+
+export function dimension(tc) {
+  return num(tc) + pick(tc, [...ALL_UNITS, "PX", "Em", "foo", "\\31", "e", "-x"]);
+}
+export const percentage = (tc) => num(tc) + "%";
+export const hash = (tc) => pick(tc, ["#fff", "#aabbcc", "#1", "#-x", "#\\31 ", "#ffff0000", "#abcd", "#x-y_z", "#日"]);
+export const url = (tc) => pick(tc, ["url(a.png)", "url( a.png )", "url('a b')", 'url( "q" )', "url(a\\)b)", "url()", "url( )",
+  "url(a%20b)", "url(http://x/y?z=1&w=2)", "URL(x)", "url(\\\"q)", "url(#frag)", "url(data:image/png;base64,AAAA)"]);
+
+export function comment(tc) {
+  const body = pick(tc, ["c", " c ", "", " ", "\n", "multi\nline", "!bang", " * ", "a{b:c}", ";", '"', "/", "**", "*", " x\r\n y ", "ü"]);
+  return "/*" + body + "*/";
+}
+
+// ---------- values ----------
+
+const FUNCTIONS = ["rgb", "rgba", "hsl", "calc", "min", "max", "clamp", "var", "env", "attr", "counter", "counters",
+  "translate", "rotate", "linear-gradient", "image-set", "cubic-bezier", "steps", "format", "local", "--custom-fn",
+  "-webkit-gradient", "expression", "selector", "round", "sign", "light-dark", "color-mix"]; // no url(: unquoted arguments make a <bad-url-token>
+
+export function component(tc, depth) {
+  const r = n(tc, 0, 99);
+  if (r < 14) return ident(tc);
+  if (r < 24) return num(tc);
+  if (r < 36) return dimension(tc);
+  if (r < 42) return percentage(tc);
+  if (r < 50) return str(tc);
+  if (r < 56) return hash(tc);
+  if (r < 62) return url(tc);
+  if (r < 66) return pick(tc, ["U+26", "U+0-7F", "u+4??", "U+1F600-1F64F", "U+???", "u+a"]);
+  if (r < 69) return pick(tc, ["/", "+", "-", "*", ","]);
+  if (r < 70) return pick(tc, ["!", "=", "<", ">", "%", "^", "~", "&", "|", "$", "?", "@x", "<!--", "-->"]); // junk: css-tree turns the value into Raw
+  if (r < 73) return comment(tc);
+  if (depth <= 0) return ident(tc);
+  if (r < 78) return "(" + ows(tc) + values(tc, depth - 1) + ows(tc) + ")";
+  if (r < 81) return "[" + ows(tc) + values(tc, depth - 1) + ows(tc) + "]";
+  const f = pick(tc, FUNCTIONS);
+  if (f === "var") return "var(" + ows(tc) + customIdent(tc) + (chance(tc, 50) ? "," + ows(tc) + (chance(tc, 30) ? "" : values(tc, depth - 1)) : "") + ows(tc) + ")";
+  if (f === "calc" || f === "min" || f === "max" || f === "clamp") {
+    const term = () => pick(tc, [num(tc), dimension(tc), percentage(tc), "var(--x)", "(" + num(tc) + " + " + dimension(tc) + ")", "e", "pi", "infinity", "-infinity", "NaN"]);
+    let s = term();
+    const k = n(tc, 0, 3);
+    for (let i = 0; i < k; i++) s += pick(tc, [" + ", " - ", "*", " * ", "/", " / ", ","]) + term();
+    return f + "(" + ows(tc) + s + ows(tc) + ")";
+  }
+  return f + "(" + ows(tc) + (chance(tc, 20) ? "" : values(tc, depth - 1)) + ows(tc) + ")";
+}
+
+export function values(tc, depth = 2) {
+  const k = n(tc, 1, 5);
+  let s = component(tc, depth);
+  for (let i = 1; i < k; i++) {
+    s += pick(tc, [" ", " ", " ", ", ", ",", " / ", "/", "", "\n", " , "]) + component(tc, depth);
+  }
+  return s;
+}
+
+export function important(tc) {
+  return pick(tc, ["", "", "", "", "!important", " !important", "! important", "!IMPORTANT", "!  important", " ! ie", "!ie", comment(tc) + "!important", "!important" + comment(tc), "!\nimportant"]);
+}
+
+export const PROPERTIES = ["color", "margin", "margin-top", "background", "width", "z-index", "font", "font-family", "content", "display", "border",
+  "grid-template-areas", "transition", "-webkit-box-shadow", "-moz-appearance", "*color", "_width", "//x", "$y", "#z", "+w", "/r",
+  "--x", "--custom-prop", "--Case", "COLOR", "Margin-Top", "src", "unicode-range", "filter", "animation", "unknown-property", "cx"];
+export const property = (tc) => pick(tc, PROPERTIES);
+
+// A custom property value: anything balanced without a top-level ; or }.
+export function customValue(tc) {
+  return pick(tc, ["", " ", "1", " 1 ", "{a:b}", "[x]", "(y)", "a b c", " red , blue ", "!important", "{;}", "url(x)", "'s'", "/*c*/", " /*c*/ 1 /*d*/ ", "\n2\n", "{", "(", "!"]);
+}
+
+export function declaration(tc) {
+  const p = property(tc);
+  if (p.startsWith("--")) {
+    return p + ows(tc) + ":" + pick(tc, ["", "", "", "1", "{a:b}", "[x]", "(y)", " a b c ", " red , blue ", "!important", "{;}", "url(x)", "'s'", "/*c*/", " /*c*/ 1 /*d*/ ", "\n2\n"]) + (chance(tc, 30) ? important(tc) : "");
+  }
+  return p + ows(tc) + ":" + ows(tc) + (chance(tc, 8) ? "" : values(tc)) + ows(tc) + important(tc);
+}
+
+// ---------- selectors ----------
+
+export function simpleSelector(tc, depth) {
+  const r = n(tc, 0, 99);
+  if (r < 15) return ident(tc);
+  if (r < 30) return "." + ident(tc);
+  if (r < 40) return "#" + ident(tc);
+  if (r < 44) return pick(tc, ["*", "ns|a", "*|*", "|a", "ns|*", "&"]);
+  if (r < 56) return "[" + ows(tc) + pick(tc, ["a", "data-x", "ns|attr", "*|a", "|a"]) + ows(tc) + pick(tc, ["", "=" + str(tc), "~=" + ident(tc), "|=" + ident(tc), "^=" + str(tc), "$=" + ident(tc), "*=" + str(tc), "=" + ident(tc) + " i", "=" + str(tc) + " S", "= " + str(tc) + "\ti"]) + ows(tc) + "]";
+  if (r < 72) return pick(tc, [":hover", ":first-child", ":nth-child(2n+1)", ":nth-child(odd)", ":nth-child( -n + 3 )", ":nth-last-of-type(even)", ":nth-of-type(3)", ":lang(en)", ":lang(en, fr-CA)", ":dir(rtl)", ":host", ":host(.a)", ":host-context(.b)", ":root", ":FIRST-CHILD", ":-moz-focusring", ":nth-child(2n of .a, .b)", ":empty"]);
+  if (r < 82) return pick(tc, ["::before", "::after", ":before", "::slotted(span)", "::part(x)", "::cue(b)", "::-webkit-scrollbar", "::highlight(h)", "::view-transition-group(*)"]);
+  if (depth <= 0) return "." + ident(tc);
+  const f = pick(tc, [":not", ":is", ":where", ":has", ":matches", ":-webkit-any", ":nth-child", "::slotted", ":host"]);
+  if (f === ":has") return ":has(" + ows(tc) + pick(tc, ["> ", "+ ", "~ ", ""]) + selector(tc, depth - 1) + ows(tc) + ")";
+  if (f === ":nth-child") return ":nth-child(" + pick(tc, ["2n+1", "odd", "-n+3", "n"]) + " of " + selectorList(tc, depth - 1) + ")";
+  if (f === "::slotted" || f === ":host") return f + "(" + ows(tc) + simpleSelector(tc, depth - 1) + ows(tc) + ")"; // one compound selector
+  return f + "(" + ows(tc) + selectorList(tc, depth - 1) + ows(tc) + ")";
+}
+
+export function selector(tc, depth = 2) {
+  let s = simpleSelector(tc, depth);
+  const k = n(tc, 0, 3);
+  for (let i = 0; i < k; i++) {
+    const comb = pick(tc, [" ", ">", " > ", "+", " ~ ", "", "", " + ", "\n>\n", " /deep/ "]); // no column combinator ||: css-tree does not parse it
+    let next = simpleSelector(tc, depth);
+    if (comb === "" && !/^[.#:\[&*]/.test(next)) next = "." + next; // keep a compound selector a compound
+    s += comb + next;
+  }
+  return s;
+}
+
+export function selectorList(tc, depth = 2) {
+  let s = selector(tc, depth);
+  const k = n(tc, 0, 2);
+  for (let i = 0; i < k; i++) s += pick(tc, [",", ", ", " ,", ",\n"]) + selector(tc, depth);
+  return s;
+}
+
+// ---------- at-rules and blocks ----------
+
+export function mediaQuery(tc) {
+  const feature = () => pick(tc, ["(min-width: 100px)", "(max-width:1e3px)", "(width >= 600px)", "(400px < width < 700px)", "(width<=1px)", "(orientation: landscape)", "(color)", "(min-resolution: 2dppx)",
+    "(aspect-ratio: 16/9)", "(min-aspect-ratio: 16 / 9)", "(prefers-color-scheme: dark)", "(-webkit-min-device-pixel-ratio: 2)", "(hover: hover)", "(color-gamut: p3)", "(grid: 0)", "(update)", "( width : 1px )", "(--custom)", "(min-width: calc(1px + 2px))"]);
+  const inParens = (d) => (d > 0 && chance(tc, 25) ? "(" + condition(d - 1) + ")" : chance(tc, 8) ? pick(tc, ["general(enclosed)", "(x y z)", "(1px)"]) : feature());
+  const condition = (d) => {
+    if (chance(tc, 20)) return "not " + inParens(d);
+    let s = inParens(d);
+    const k = n(tc, 0, 2);
+    const op = pick(tc, [" and ", " or "]);
+    for (let i = 0; i < k; i++) s += op + inParens(d);
+    return s;
+  };
+  const r = n(tc, 0, 99);
+  if (r < 15) return pick(tc, ["screen", "print", "all", "not print", "only screen", "ONLY Screen", "speech", "tty", "unknown-type"]);
+  if (r < 30) return pick(tc, ["screen", "not print", "only screen", "all"]) + " and " + condition(1);
+  return condition(2);
+}
+
+export function mediaQueryList(tc) {
+  let s = mediaQuery(tc);
+  const k = n(tc, 0, 2);
+  for (let i = 0; i < k; i++) s += pick(tc, [", ", ",", " , "]) + mediaQuery(tc);
+  return s;
+}
+
+export function supportsCondition(tc, depth = 2) {
+  const atom = () => pick(tc, ["(display: grid)", "(display:grid)", "( display : grid )", "(--x: 1)", "(color: rgb(0 0 0 / 50%))", "selector(:has(a))", "selector(a > b)", "font-tech(color-COLRv1)", "font-format(woff2)", "(x)", "(1px)", "general(enclosed)"]);
+  const inner = () => (depth > 0 && chance(tc, 30) ? "(" + supportsCondition(tc, depth - 1) + ")" : atom());
+  if (chance(tc, 20)) return "not " + inner();
+  let s = inner();
+  const k = n(tc, 0, 2);
+  const op = pick(tc, [" and ", " or "]);
+  for (let i = 0; i < k; i++) s += op + inner();
+  return s;
+}
+
+export function containerCondition(tc) {
+  const atom = () => pick(tc, ["(width > 400px)", "(min-width: 30em)", "(inline-size >= 30em)", "(orientation: portrait)", "style(--x: 1)", "style(--responsive: true)", "(200px <= width <= 300px)", "(aspect-ratio > 1)", "scroll-state(stuck: top)"]);
+  let s = chance(tc, 15) ? "not " + atom() : atom();
+  const k = n(tc, 0, 2);
+  const op = pick(tc, [" and ", " or "]);
+  for (let i = 0; i < k; i++) s += op + atom();
+  return (chance(tc, 35) ? pick(tc, ["card", "sidebar", "my-container"]) + " " : "") + s;
+}
+
+export function declarationBlock(tc, depth) {
+  const k = n(tc, 0, 4);
+  const items = [];
+  for (let i = 0; i < k; i++) {
+    const r = n(tc, 0, 99);
+    if (r < 72 || depth <= 0) items.push(declaration(tc));
+    else if (r < 82) items.push(comment(tc));
+    else if (r < 92) items.push(nestedRule(tc, depth - 1));
+    else items.push(atrule(tc, depth - 1, true)); // nested in a style rule: its block is a style block
+  }
+  let s = "{" + ows(tc);
+  for (let i = 0; i < items.length; i++) {
+    s += items[i];
+    if (i < items.length - 1 || chance(tc, 50)) s += ows(tc) + ";" + ows(tc);
+    else s += ows(tc);
+  }
+  return s + "}";
+}
+
+// The block of a conditional group rule at the top level: rules and at-rules (a declaration here
+// is junk that css-tree wraps in Raw, so it is rare).
+export function ruleBlock(tc, depth) {
+  const k = n(tc, 0, 3);
+  let s = "{" + ows(tc);
+  for (let i = 0; i < k; i++) {
+    const r = n(tc, 0, 99);
+    if (r < 62 || depth <= 0) s += rule(tc, depth - 1);
+    else if (r < 82) s += atrule(tc, depth - 1);
+    else if (r < 97) s += comment(tc);
+    else s += declaration(tc) + ";";
+    s += ows(tc);
+  }
+  return s + "}";
+}
+
+export function rule(tc, depth = 2) {
+  return selectorList(tc) + ows(tc) + declarationBlock(tc, depth);
+}
+
+// A style rule nested in a declaration block. css-tree only parses nested rules whose selectors
+// start with the nesting selector (relaxed nesting is Raw, css-tree/12), so every selector does.
+export function nestedRule(tc, depth) {
+  const one = () => "&" + pick(tc, ["", " ", ".x", ":hover", " > .y", " + b", "[a]", " &", " .x &", "::before"]);
+  let s = one();
+  const k = n(tc, 0, 1);
+  for (let i = 0; i < k; i++) s += pick(tc, [", ", ","]) + one();
+  return s + ows(tc) + declarationBlock(tc, depth);
+}
+
+export function atrule(tc, depth = 2, nested = false) {
+  const block = nested ? declarationBlock : ruleBlock; // a conditional at-rule nested in a style rule holds declarations
+  const kind = pick(tc, ["media", "media", "supports", "container", "layer", "import", "namespace", "charset", "font-face", "keyframes", "page", "property", "scope", "starting-style", "counter-style", "font-feature-values", "unknown", "document", "nest"]);
+  const at = "@" + (chance(tc, 10) ? kind.toUpperCase() : kind);
+  switch (kind) {
+    case "media": return at + ws(tc) + (chance(tc, 10) ? "" : mediaQueryList(tc)) + ows(tc) + (chance(tc, 8) ? ";" : block(tc, depth));
+    case "supports": return at + ws(tc) + supportsCondition(tc) + ows(tc) + block(tc, depth);
+    case "container": return at + ws(tc) + containerCondition(tc) + ows(tc) + block(tc, depth);
+    case "layer": return at + pick(tc, [" a", " a, b", " a.b", " a.b, c", "", " A"]) + ows(tc) + (nested || chance(tc, 50) ? ";" : block(tc, depth)); // css-tree/13: a nested @layer block is not a style block
+    case "import": return at + ws(tc) + pick(tc, ['"a.css"', "url(a.css)", "url('a.css')", "URL(x)"]) + pick(tc, ["", " layer", " layer(a.b)", " supports(display: grid)", " supports(selector(a))", " screen and (min-width: 1px)", " layer(x) supports(--y: 1) print", ""]) + ows(tc) + ";";
+    case "namespace": return at + ws(tc) + pick(tc, ["", "svg ", "ns\t"]) + pick(tc, ['"http://x"', "url(http://x)"]) + ows(tc) + ";";
+    case "charset": return at + pick(tc, [' "utf-8"', ' "UTF-8"', " \"iso-8859-1\""]) + ";";
+    case "font-face": return at + ows(tc) + declarationBlock(tc, 0);
+    case "keyframes": {
+      const name = pick(tc, ["k", "slide-in", '"quoted"', "-webkit-x"]);
+      const k = n(tc, 0, 3);
+      let s = (chance(tc, 30) ? "@-webkit-keyframes" : at) + ws(tc) + name + ows(tc) + "{" + ows(tc);
+      for (let i = 0; i < k; i++) s += pick(tc, ["from", "to", "50%", "0%, 100%", "FROM", "33.3%", "0%,50%,100%"]) + ows(tc) + declarationBlock(tc, 0) + ows(tc);
+      return s + "}";
+    }
+    case "page": return at + pick(tc, ["", " :first", " :left", " named", " named:first", ":blank"]) + ows(tc) + "{" + ows(tc) + (chance(tc, 60) ? declaration(tc) + ";" : "") + (chance(tc, 50) ? "@top-left" + ows(tc) + declarationBlock(tc, 0) : "") + ows(tc) + "}";
+    case "property": return at + ws(tc) + customIdent(tc) + ows(tc) + "{" + pick(tc, ["syntax: '<length>'; inherits: false; initial-value: 0px;", " syntax : \"*\" ; inherits : true ", ""]) + "}";
+    case "scope": return at + pick(tc, [" (.a)", " (.a) to (.b)", "", " to (.b)"]) + ows(tc) + block(tc, depth);
+    case "starting-style": return at + ows(tc) + (depth > 0 && chance(tc, 50) ? block(tc, depth) : declarationBlock(tc, 0));
+    case "counter-style": return at + ws(tc) + ident(tc) + ows(tc) + declarationBlock(tc, 0);
+    case "font-feature-values": return at + " Font One" + ows(tc) + "{" + ows(tc) + (chance(tc, 60) ? "@swash { x: 1; y: 2 }" : "") + ows(tc) + "}";
+    case "nest": return at + ws(tc) + selectorList(tc) + ows(tc) + declarationBlock(tc, 0);
+    case "document": return "@-moz-document url-prefix()" + ows(tc) + block(tc, depth);
+    default: return at + pick(tc, ["-x", "foo", "--y"]) + pick(tc, ["", " bar baz", " 1 2", " (a: b)", " \"s\"", " url(x)"]) + ows(tc) + (chance(tc, 50) ? ";" : chance(tc, 50) ? declarationBlock(tc, 0) : block(tc, depth));
+  }
+}
+
+export function stylesheet(tc) {
+  const k = n(tc, 0, 5);
+  let s = "";
+  for (let i = 0; i < k; i++) {
+    const r = n(tc, 0, 99);
+    if (r < 55) s += rule(tc);
+    else if (r < 85) s += atrule(tc);
+    else if (r < 93) s += comment(tc);
+    else if (r < 98) s += pick(tc, ["<!--", "-->"]); // no stray BOM: css-tree drops one at offset 0 only, so generate/parse would not be a fixpoint
+    else s += pick(tc, [";", ";;"]); // junk: a top-level ; starts a Raw qualified rule
+    s += ows(tc);
+  }
+  return (chance(tc, 30) ? ws(tc) : "") + s;
+}
+
+// ---------- token soup ----------
+
+const SOUP = ["a", "b", "z", "A", "Z", "0", "1", "9", "-", "-", "_", "+", ".", ",", ":", ";", "!", "?", "*", "/", "/", "\\", "\\", "'", '"', '"', "(", ")", "[", "]", "{", "}", "<", ">",
+  "@", "#", "%", "&", "|", "~", "^", "=", "$", " ", " ", "\n", "\r", "\f", "\t", "ü", "日", "😀", "␀", "", "", "﻿", "e", "E", "n", "u", "U",
+  "/*", "*/", "url(", "url( ", "<!--", "-->", "U+", "u+", "\\61 ", "\\1F600", "1e", "1e-", "!important", "important", "px", "%", "1.", ".5", "@media", "#x", "--x", "-->", "\r\n", "\\\n"].filter((c) => !/[\u0080-\u00b6]/.test(c));
+export function soup(tc) {
+  return word(tc, SOUP, 0, 24);
+}
+
+// A mix of the structured CSS and soup, for parser robustness.
+export function anyCss(tc) {
+  const r = n(tc, 0, 99);
+  if (r < 50) return stylesheet(tc);
+  if (r < 75) return soup(tc);
+  // a stylesheet with a soup splice
+  const a = stylesheet(tc);
+  const at = n(tc, 0, a.length);
+  return a.slice(0, at) + soup(tc) + a.slice(at);
+}
+
+// ---------- values from css-tree's value definition syntax ----------
+
+export class Unsupported extends Error {}
+// Thrown when the search for a producible derivation runs too long; an Unsupported so callers skip.
+export class TooManyCalls extends Unsupported {}
+
+const CSS_WIDE = new Set(["initial", "inherit", "unset", "revert", "revert-layer", "default"]);
+const SAFE_IDENTS = ["foo", "my-ident", "Bar", "_x", "z9", "\u00fc", "a\\31 b"]; // a hex escape eats one following space, so it cannot end an ident
+
+function shuffle(tc, xs) {
+  const a = xs.slice();
+  for (let i = a.length - 1; i > 0; i--) {
+    const j = n(tc, 0, i);
+    [a[i], a[j]] = [a[j], a[i]];
+  }
+  return a;
+}
+
+function numberIn(tc, range, { integer = false, unitless = false } = {}) {
+  let lo = -5;
+  let hi = 20;
+  if (range && range.type === "Range") {
+    if (typeof range.min === "number") lo = range.min;
+    else if (range.min !== null) lo = 0; // a dimension bound: stay non-negative
+    if (typeof range.max === "number") hi = range.max;
+    else if (range.max !== null) hi = Math.max(lo, 5);
+  }
+  if (hi < lo) throw new Unsupported("empty range");
+  if (integer || chance(tc, 50)) {
+    const v = n(tc, Math.ceil(lo), Math.floor(hi));
+    return chance(tc, 10) && v >= 0 ? "+" + v : String(v);
+  }
+  const v = lo + (hi - lo) * n(tc, 0, 4) / 4;
+  let s = String(Math.round(v * 100) / 100);
+  if (chance(tc, 15) && Math.abs(v) < 1 && v !== 0) s = s.replace(/^(-?)0\./, "$1.");
+  if (chance(tc, 10) && Number.isInteger(v) && v !== 0) s = v + "e0";
+  if (unitless && v === 0) s = "0";
+  return s;
+}
+
+function generic(tc, name, range) {
+  const unit = (kind) => pick(tc, UNITS[kind]);
+  switch (name) {
+    case "length": return chance(tc, 10) && (!range || range.min === null || range.min <= 0) && (!range || range.max === null || range.max >= 0) ? "0" : numberIn(tc, range) + unit("length");
+    case "angle": case "time": case "frequency": case "resolution": case "flex": case "decibel": case "semitones":
+      return numberIn(tc, range) + unit(name);
+    case "dimension": return numberIn(tc, range) + pick(tc, ALL_UNITS);
+    case "percentage": return numberIn(tc, range) + "%";
+    case "number": return numberIn(tc, range);
+    case "integer": return numberIn(tc, range, { integer: true });
+    case "zero": return "0";
+    case "string": return pick(tc, ['"s"', "'t'", '""', '"a b"', '"\\61"']);
+    case "ident": return pick(tc, SAFE_IDENTS);
+    case "custom-ident": return pick(tc, SAFE_IDENTS);
+    case "dashed-ident": case "custom-property-name": return pick(tc, ["--x", "--my-var", "--0"]);
+    case "hex-color": return "#" + word(tc, "0123456789abcdefABCDEF".split(""), 1, 1).repeat(pick(tc, [3, 4, 6, 8]));
+    case "id-selector": return "#" + pick(tc, SAFE_IDENTS);
+    case "an-plus-b": return pick(tc, ["odd", "even", "2n+1", "-n+3", "3n", "n", "+n-2", "5", "2n + 1", "-2n - 1", "0n+0"]);
+    case "urange": return pick(tc, ["U+26", "U+0-7F", "U+4??", "u+1f600-1f64f", "U+???", "U+0025-00FF"]);
+    case "declaration-value": case "any-value": return pick(tc, ["a", "1px solid red", "a b c", "f(1)", "[x]", '"s"', "1"]);
+    case "attr-unit": return pick(tc, ["px", "em", "%", "deg", "s"]);
+    case "ident-token": return pick(tc, SAFE_IDENTS);
+    case "hash-token": return "#" + pick(tc, SAFE_IDENTS);
+    case "string-token": return '"s"';
+    case "url-token": return "url(x)";
+    case "number-token": return numberIn(tc, null);
+    case "percentage-token": return numberIn(tc, null) + "%";
+    case "dimension-token": return numberIn(tc, null) + "px";
+    case "whitespace-token": return " ";
+    case "comma-token": return ",";
+    case "colon-token": return ":";
+    case "at-keyword-token": return "@x";
+    case "CDO-token": return "<!--";
+    case "CDC-token": return "-->";
+    default: throw new Unsupported("generic " + name);
+  }
+}
+
+// One value string derived from `syntax` (a definition-syntax AST) by taking each choice at
+// random; `lexer` resolves <type> and <'property'> references. Throws Unsupported when the
+// grammar reaches something this generator cannot produce. Commas follow the elision rule of
+// CSS Values 4 (a comma next to omitted terms, at the start or end of a list or doubled, goes).
+const COMMA = Symbol("comma");
+export function valueFromSyntax(tc, lexer, syntax, budget = { nodes: 60, calls: 400 }) {
+  function gen(node, range, depth) {
+    if (--budget.nodes < 0) throw new Unsupported("too big");
+    if (--budget.calls < 0) throw new TooManyCalls();
+    switch (node.type) {
+      case "Group": {
+        let result;
+        const nonEmpty = (r) => r.some((piece) => piece !== COMMA); // commas alone are elided later
+        for (let attempt = 0; ; attempt++) {
+          result = group(node, range, depth);
+          if (nonEmpty(result) || !node.disallowEmpty || attempt >= 3) break;
+        }
+        if (!nonEmpty(result) && node.disallowEmpty) throw new Unsupported("[ ]! stayed empty");
+        return result;
+      }
+      case "Multiplier": {
+        const min = node.min;
+        let max = node.max === 0 ? min + 2 : node.max;
+        if (depth < 0) max = min;
+        max = Math.min(max, min + 2);
+        const count = n(tc, min, max);
+        const parts = [];
+        for (let i = 0; i < count; i++) {
+          const s = gen(node.term, range, depth);
+          if (s.length === 0) continue;
+          if (parts.length > 0 && node.comma) parts.push(COMMA);
+          parts.push(...s);
+        }
+        return parts;
+      }
+      case "Keyword": return [node.name];
+      case "Comma": return [COMMA];
+      case "Token": return [node.value === ")" ? { close: ")" } : node.value];
+      case "String": return [node.value.replace(/^'(.*)'$/, "$1")];
+      case "AtKeyword": return ["@" + node.name];
+      case "Function": return [{ open: node.name + "(" }];
+      case "Type": {
+        const ref = lexer.getType(node.name);
+        if (!ref) throw new Unsupported("unknown type " + node.name);
+        const r = node.opts || range;
+        if (!ref.syntax) return [generic(tc, node.name, r)];
+        return gen(ref.syntax, r, depth - 1);
+      }
+      case "Property": {
+        const ref = lexer.getProperty(node.name);
+        if (!ref || !ref.syntax) throw new Unsupported("unknown property " + node.name);
+        // a <'property'> reference excludes the property's top-level comma multiplier (CSS Values 4, 2.3;
+        // Lexer.js syntaxHasTopLevelCommaMultiplier): <'animation-duration'> inside <single-animation> is one time
+        let syntax = ref.syntax;
+        if (syntax.type === "Group" && !syntax.explicit && syntax.terms.length === 1 && syntax.terms[0].type === "Multiplier" && syntax.terms[0].comma) {
+          syntax = syntax.terms[0].term;
+        }
+        return gen(syntax, range, depth - 1);
+      }
+      default: throw new Unsupported("node " + node.type);
+    }
+  }
+  function group(node, range, depth) {
+    const terms = node.terms;
+    switch (node.combinator) {
+      case " ": return terms.flatMap((t) => gen(t, range, depth));
+      case "&&": return shuffle(tc, terms).flatMap((t) => gen(t, range, depth));
+      case "||": {
+        const chosen = shuffle(tc, terms).slice(0, n(tc, 1, depth < 0 ? 1 : terms.length));
+        return chosen.flatMap((t) => gen(t, range, depth));
+      }
+      case "|": {
+        // When the budget is spent prefer the simplest alternatives, otherwise a random one;
+        // an alternative this generator cannot produce is skipped.
+        let order = shuffle(tc, terms);
+        if (depth < 0) order = order.slice().sort((a, b) => weight(a) - weight(b));
+        let lastError = null;
+        for (const t of order) {
+          const saved = budget.nodes;
+          try {
+            return gen(t, range, depth);
+          } catch (e) {
+            if (!(e instanceof Unsupported)) throw e;
+            lastError = e;
+            budget.nodes = saved; // the failed branch does not count, but budget.calls does
+          }
+        }
+        throw lastError || new Unsupported("empty choice");
+      }
+      default: throw new Unsupported("combinator " + node.combinator);
+    }
+  }
+  return render(gen(syntax, null, 4), tc);
+}
+
+// Join the pieces of a generated value, applying comma elision per parenthesis level.
+function render(pieces, tc) {
+  // forward: a comma right after a list start or another comma goes
+  let out = [];
+  const prev = ["start"];
+  for (const piece of pieces) {
+    if (piece === COMMA) {
+      if (prev[prev.length - 1] === "start" || prev[prev.length - 1] === "comma") continue;
+      prev[prev.length - 1] = "comma";
+      out.push(piece);
+    } else if (piece && piece.open) {
+      prev[prev.length - 1] = "item";
+      prev.push("start");
+      out.push(piece);
+    } else if (piece && piece.close) {
+      prev.pop();
+      if (prev.length === 0) prev.push("item");
+      prev[prev.length - 1] = "item";
+      out.push(piece);
+    } else {
+      prev[prev.length - 1] = "item";
+      out.push(piece);
+    }
+  }
+  // backward: a comma right before a list end goes
+  const kept = [];
+  const next = ["end"];
+  for (let i = out.length - 1; i >= 0; i--) {
+    const piece = out[i];
+    if (piece === COMMA) {
+      if (next[next.length - 1] === "end") continue;
+      next[next.length - 1] = "item";
+      kept.push(piece);
+    } else if (piece && piece.close) {
+      next[next.length - 1] = "item";
+      next.push("end");
+      kept.push(piece);
+    } else if (piece && piece.open) {
+      next.pop();
+      if (next.length === 0) next.push("item");
+      next[next.length - 1] = "item";
+      kept.push(piece);
+    } else {
+      next[next.length - 1] = "item";
+      kept.push(piece);
+    }
+  }
+  kept.reverse();
+  return kept.map((piece) => (piece === COMMA ? pick(tc, [",", ",", " ,"]) : piece.open || piece.close || piece)).join(" ").replace(/ ,/g, ",");
+}
+
+function weight(node) {
+  switch (node.type) {
+    case "Keyword": case "Token": case "String": case "Comma": return 0;
+    case "Type": return node.name === "length" || node.name === "number" || node.name === "percentage" || node.name === "integer" || node.name === "ident" ? 1 : 3;
+    case "Multiplier": return weight(node.term) + node.min;
+    case "Group": return 2 + node.terms.length;
+    default: return 5;
+  }
+}
+
+function join(parts) {
+  return parts.filter((s) => s !== "").join(" ");
+}
+
+// A random definition-syntax AST (as the generate() side of the round trip expects it).
+export function grammarAst(tc, depth = 3) {
+  const leaf = () => {
+    switch (n(tc, 0, 7)) {
+      case 0: return { type: "Keyword", name: pick(tc, ["auto", "none", "foo-bar", "A", "-x"]) };
+      case 1: return { type: "Type", name: pick(tc, ["length", "color", "foo", "length-percentage"]), opts: chance(tc, 30) ? { type: "Range", min: pick(tc, [null, 0, -1, 5]), max: pick(tc, [null, 10, 0]) } : null };
+      case 2: return { type: "Property", name: pick(tc, ["width", "font-size", "--x"]) };
+      case 3: return { type: "Group", terms: [{ type: "Function", name: pick(tc, ["rgb", "calc", "-webkit-gradient"]) }, { type: "Keyword", name: "x" }, { type: "Token", value: ")" }], combinator: " ", disallowEmpty: false, explicit: true };
+      case 4: return { type: "Token", value: pick(tc, ["/", ":", "=", "%"]) };
+      case 5: return { type: "String", value: pick(tc, ["'+'", "'-'", "'['"]) };
+      case 6: return { type: "Comma" };
+      default: return { type: "AtKeyword", name: pick(tc, ["media", "x"]) };
+    }
+  };
+  const term = (d) => {
+    if (d <= 0 || chance(tc, 45)) return leaf();
+    if (chance(tc, 35)) {
+      const m = pick(tc, [
+        { comma: false, min: 0, max: 1 }, { comma: false, min: 0, max: 0 }, { comma: false, min: 1, max: 0 }, { comma: true, min: 1, max: 0 }, { comma: true, min: 0, max: 0 },
+        { comma: false, min: 2, max: 3 }, { comma: false, min: 3, max: 0 }, { comma: false, min: 3, max: 3 }, { comma: true, min: 3, max: 3 }, { comma: true, min: 2, max: 0 }, { comma: true, min: 1, max: 4 },
+      ]);
+      let inner = term(d - 1);
+      if (inner.type === "Comma" || inner.type === "AtKeyword") inner = { type: "Keyword", name: "k" }; // no multipliers on those
+      return { type: "Multiplier", ...m, term: inner.type === "Multiplier" ? { type: "Group", terms: [inner], combinator: " ", disallowEmpty: false, explicit: true } : inner };
+    }
+    const combinator = pick(tc, [" ", "|", "||", "&&"]);
+    const k = n(tc, 1, 3);
+    const terms = [];
+    for (let i = 0; i < k; i++) {
+      let t = term(d - 1);
+      // a nested group with a different combinator must be explicit to survive generate/parse
+      if (t.type === "Group" && !t.explicit) t = { ...t, explicit: true };
+      terms.push(t);
+    }
+    return { type: "Group", terms, combinator: k === 1 ? " " : combinator, disallowEmpty: chance(tc, 15), explicit: true };
+  };
+  const root = term(depth);
+  if (root.type === "Group") return root;
+  return { type: "Group", terms: [root], combinator: " ", disallowEmpty: false, explicit: false };
+}
diff --git a/hegel/hegel-zoo.mjs b/hegel/hegel-zoo.mjs
new file mode 100644
index 0000000..1ca6f10
--- /dev/null
+++ b/hegel/hegel-zoo.mjs
@@ -0,0 +1,163 @@
+// Hegel zoo: the small harness shared by the zoo's TypeScript/JavaScript targets.
+//
+// `property(name, body)` registers a node:test test that runs `body(tc)` under Hegel with
+// HEGEL_TEST_CASES cases (default 100) and the database at HEGEL_DATABASE. With ZOO_COLLECT=1
+// a `fail()` records the mismatch instead of failing, the case ends there, and the counts of
+// mismatches and of the shapes seen (`count(key)`) are printed at the end of the test, so a
+// property can be run over many cases to see every shape at once. `pin(name, body)` is a
+// plain test for one pinned bug: it must fail while the bug is present and pass once it is
+// fixed (the zoo's judge reads an unexpected pass as "fixed upstream?").
+
+import { readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+import { test as nodeTest } from "node:test";
+
+// The Hegel version these tests were written against (the zoo pins it in zoo.toml; upstream
+// would add it to devDependencies). Hegel and esbuild are installed with `npm install --prefix
+// .hegel` so the target's own package.json and lock file stay untouched. Checked at load time so
+// a stray install cannot silently change the engine.
+export const HEGEL_PIN = { "@hegeldev/hegel": "0.4.5" };
+
+const hegelDir = join(dirname(fileURLToPath(import.meta.url)), "..", ".hegel", "node_modules", "@hegeldev", "hegel");
+{
+  const installed = JSON.parse(readFileSync(join(hegelDir, "package.json"), "utf8")).version;
+  if (installed !== HEGEL_PIN["@hegeldev/hegel"]) {
+    throw new Error(`@hegeldev/hegel ${installed} is installed; these tests pin ${HEGEL_PIN["@hegeldev/hegel"]}`);
+  }
+}
+const hegel = await import(pathToFileURL(join(hegelDir, "dist", "index.js")));
+const gs = await import(pathToFileURL(join(hegelDir, "dist", "generators", "index.js")));
+
+export const collecting = !!process.env.ZOO_COLLECT;
+
+class Collected extends Error {}
+
+let msgs = [];
+let stats = new Map();
+
+/** Report a mismatch: an error normally, a recorded line in collect mode. */
+export function fail(message) {
+  if (collecting) {
+    msgs.push(message);
+    throw new Collected(message);
+  }
+  throw new Error(message);
+}
+
+/** Bump a statistic (the shape of a pinned bug, a generator branch). */
+export function count(key) {
+  stats.set(key, (stats.get(key) || 0) + 1);
+}
+
+function settings() {
+  const s = { testCases: Number(process.env.HEGEL_TEST_CASES) || 100 };
+  if (process.env.HEGEL_DATABASE) {
+    s.database = hegel.Database.fromPath(process.env.HEGEL_DATABASE);
+  }
+  return s;
+}
+
+/** A property: `body(tc)` runs under Hegel; a thrown error (or `fail`) is a failure. */
+export function property(name, body) {
+  nodeTest(name, () => {
+    msgs = [];
+    stats = new Map();
+    hegel.test((tc) => {
+      try {
+        body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** An async property: `body(tc)` may await; runs under Hegel's testAsync with the same settings. */
+export function propertyAsync(name, body) {
+  nodeTest(name, async () => {
+    msgs = [];
+    stats = new Map();
+    await hegel.testAsync(async (tc) => {
+      try {
+        await body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** A pin: a plain test for one recorded bug. */
+export function pin(name, body) {
+  nodeTest(name, body);
+}
+
+/** An integer in [lo, hi]. */
+export function n(tc, lo, hi) {
+  return tc.draw(gs.integers({ minValue: lo, maxValue: hi }));
+}
+
+/** One of xs. */
+export function pick(tc, xs) {
+  return xs[n(tc, 0, xs.length - 1)];
+}
+
+/** True pct percent of the time. */
+export function chance(tc, pct) {
+  return n(tc, 0, 99) < pct;
+}
+
+/** A string of `len` characters drawn from `alphabet` (an array of strings). */
+export function word(tc, alphabet, lo, hi) {
+  const len = n(tc, lo, hi);
+  let s = "";
+  for (let i = 0; i < len; i++) {
+    s += pick(tc, alphabet);
+  }
+  return s;
+}
+
+/** Structural equality: arrays by position, objects by key set (prototype ignored), else ===. */
+export function same(a, b) {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) {
+      return false;
+    }
+    return a.every((x, i) => same(x, b[i]));
+  }
+  if (a !== null && b !== null && typeof a === "object" && typeof b === "object") {
+    const ka = Object.keys(a).sort();
+    const kb = Object.keys(b).sort();
+    if (ka.length !== kb.length || ka.some((k, i) => k !== kb[i])) {
+      return false;
+    }
+    return ka.every((k) => same(a[k], b[k]));
+  }
+  return a === b;
+}
+
+/** A compact, unambiguous rendering for messages. */
+export function show(x) {
+  return JSON.stringify(x, (k, v) => (v === undefined ? "<undefined>" : v));
+}
