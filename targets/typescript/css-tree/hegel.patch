+  mediaConditions.push(conditionOf(term));
+}
+const MEDIA_TYPES = ["screen", "print", "all", "not print", "only screen", "ONLY Screen", "speech", "tty", "unknown-type"];
+/** A media query: a type 15% of the time, a type and 1-3 terms joined by `and` 15 (no `not` or `or` after a type: Media Queries 4, media-condition-without-or), else a condition nested up to two deep. */
