+  gs.tuples(simpleSelector, gs.arrays(gs.record({ comb: pick(COMBINATORS), next: simpleSelector, childAfterDoubleHyphen: chance(20) }), { maxSize: 3 })).map(([first, rest]) =>
+    rest.reduce((s, { comb, next, childAfterDoubleHyphen }) => {
