+// ends of an integer range about 1% of the time each, so a last alternative of 1 in 100 comes
+// up 2%): css-tree/9 makes generate/parse of it a non-fixpoint, so it is only gated at.
+const hasEscapedNewline = (s) => /\\[\n\r]/.test(s);
+const plainStr = pick(STRINGS.filter((s) => !hasEscapedNewline(s)));
+export const str = weighted([90, plainStr], [10, weighted([90, plainStr], [10, pick(STRINGS.filter(hasEscapedNewline))])]);
+
+export const NUMBERS = ["0", "1", "-1", "+1", ".5", "-.5", "1.5", "1e3", "1E-3", "1.5e+2", "007", "0.0", "-0", "1e0", "100", "12.50"];
+export const num = pick(NUMBERS);
+
+export const UNITS = {
+  length: ["cm", "mm", "q", "in", "pt", "pc", "px", "em", "rem", "ex", "rex", "cap", "rcap", "ch", "rch", "ic", "ric", "lh", "rlh",
+    "vw", "svw", "lvw", "dvw", "vh", "svh", "lvh", "dvh", "vi", "svi", "lvi", "dvi", "vb", "svb", "lvb", "dvb",
+    "vmin", "svmin", "lvmin", "dvmin", "vmax", "svmax", "lvmax", "dvmax", "cqw", "cqh", "cqi", "cqb", "cqmin", "cqmax"],
+  angle: ["deg", "grad", "rad", "turn"],
+  time: ["s", "ms"],
+  frequency: ["hz", "khz"],
+  resolution: ["dpi", "dpcm", "dppx", "x"],
+  flex: ["fr"],
+  decibel: ["db"],
+  semitones: ["st"],
+};
+const ALL_UNITS = Object.values(UNITS).flat();
+
+/** A number with a unit css-tree knows, or an upper-case, unknown, escaped or odd one. */
+export const dimension = cat(num, pick([...ALL_UNITS, "PX", "Em", "foo", "\\31", "e", "-x"]));
+export const percentage = cat(num, "%");
+export const hash = pick(["#fff", "#aabbcc", "#1", "#-x", "#\\31 ", "#ffff0000", "#abcd", "#x-y_z", "#\u{65e5}"]);
+const URLS = ["url(a.png)", "url( a.png )", "url('a b')", 'url( "q" )', "url(a\\)b)", "url()",
+  "url(a%20b)", "url(http://x/y?z=1&w=2)", "URL(x)", 'url(\\"q)', "url(#frag)", "url(data:image/png;base64,AAAA)"];
