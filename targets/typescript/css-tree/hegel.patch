+    const dec = ct.url.decode(enc);
+    if (dec !== want2) {
+      if (Known.urlEscapedTrailingSpace && /\s$/.test(want2)) count("known css-tree/8 url ending in whitespace");
+      else if (Known.spaceAfterNulInEncode && /[\x01-\x1f\x7f]\0/.test(s)) count("known css-tree/16 space after NUL in encode");
+      else fail(`url.decode(url.encode(${show(s)})) = ${show(dec)} via ${show(enc)}`);
+    }
+    oneToken(enc, "url-token", "url.encode");
+  }
+  // decoding what the tokenizer produced (a string literal with escapes) agrees with the reference
+  const ref = refTokens(lit);
+  if (ref.length === 1 && ref[0].type === "string-token" && ct.string.decode(lit) !== ref[0].extra.value) {
+    fail(`string.decode(${show(lit)}) = ${show(ct.string.decode(lit))}, reference ${show(ref[0].extra.value)}`);
+  }
+});
+
+// ---------- 9. definition syntax ----------
+
+/** The definition-syntax case: a drawn grammar tree half the time, else one of the lexer's own grammars (a property's or a type's). */
+const definitionSyntaxCase = gs.oneOf(
+  gs.record({ kind: gs.just("drawn"), ast: gen.grammarAst }),
+  gs.oneOf(
+    gs.sampledFrom(PROPERTY_NAMES).map((name) => ({ kind: "property", name })),
+    gs.sampledFrom(TYPE_NAMES).map((name) => ({ kind: "type", name })),
+  ),
+);
+
+property("TestHegelDefinitionSyntaxRoundTrips", (tc) => {
+  const c = tc.draw(definitionSyntaxCase);
+  if (c.kind === "drawn") {
+    const { ast } = c;
+    const text = ds.generate(ast);
+    let parsed;
+    try {
+      parsed = ds.parse(text);
+    } catch (e) {
+      fail(`definitionSyntax.parse rejects its own generate output ${show(text)}: ${e.message.split("\n")[0]}\n  ast ${show(ast)}`);
+    }
+    if (!same(parsed, ast)) fail(`generate/parse changes the grammar ${show(text)}\n  before ${show(ast)}\n  after  ${show(parsed)}`);
+    const again = ds.generate(parsed);
+    if (again !== text) fail(`generate is not idempotent on grammars: ${show(text)} then ${show(again)}`);
+    const compact = ds.generate(ast, { compact: true });
+    if (!same(ds.parse(compact), ast)) fail(`compact grammar ${show(compact)} parses differently from ${show(text)}`);
+    if (compact.length > text.length) fail(`compact grammar ${show(compact)} is longer than ${show(text)}`);
+    // walk enters every node once, leaves in postorder
+    const enters = [];
+    const leaves = [];
+    ds.walk(ast, { enter: (node) => enters.push(node), leave: (node) => leaves.push(node) });
+    const all = [];
+    const collect = (node) => {
+      all.push(node);
+      if (node.terms) node.terms.forEach(collect);
+      if (node.term) collect(node.term);
+    };
+    collect(ast);
+    if (enters.length !== all.length || enters.some((x, i) => x !== all[i])) fail(`definitionSyntax.walk enters ${enters.length} nodes, expected ${all.length} for ${show(text)}`);
+    if (leaves.length !== all.length || leaves[leaves.length - 1] !== ast) fail(`definitionSyntax.walk leaves ${leaves.length} nodes`);
+    // decorate wraps every generated piece
+    const decorated = ds.generate(ast, { decorate: (str, node) => "<" + node.type + ">" + str });
+    const stripped = decorated.replace(/<[A-Za-z]+>/g, "");
+    if (stripped !== text) count("decorate output differs from plain (types interleaved)");
+  } else {
+    const fromProperty = c.kind === "property";
+    const { name } = c;
+    const syntax = fromProperty ? lexer.getProperty(name).syntax : lexer.getType(name).syntax;
+    const text = ds.generate(syntax);
+    const parsed = ds.parse(text);
+    if (!same(plainGrammar(parsed), plainGrammar(syntax))) fail(`the grammar of ${fromProperty ? "" : "<"}${name}${fromProperty ? "" : ">"} does not survive generate/parse: ${show(text)}\n  stored ${show(plainGrammar(syntax))}\n  parsed ${show(plainGrammar(parsed))}`);
+    if (ds.generate(parsed) !== text) fail(`generate(parse(${show(text)})) = ${show(ds.generate(parsed))}`);
+    const compact = ds.generate(syntax, { compact: true });
+    if (!same(plainGrammar(ds.parse(compact)), plainGrammar(syntax))) fail(`compact grammar ${show(compact)} of ${name} parses differently`);
+    // the lexer's own dump lists it (compactly when not pretty)
+    const dumped = lexer.dump(false, false);
+    const entry = fromProperty ? dumped.properties[name] : dumped.types[name];
+    if (entry !== compact) fail(`lexer.dump() has ${show(entry)} for ${name}, compact generate gives ${show(compact)}`);
+    const pretty = lexer.dump(false, true);
+    if ((fromProperty ? pretty.properties[name] : pretty.types[name]) !== text) fail(`lexer.dump(pretty) has ${show(fromProperty ? pretty.properties[name] : pretty.types[name])} for ${name}, generate gives ${show(text)}`);
+  }
+});
+
+function plainGrammar(node) {
+  return JSON.parse(JSON.stringify(node));
+}
