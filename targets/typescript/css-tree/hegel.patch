+  const leaf = (classWeight) => [
+    [15, ident], [classWeight, cat(".", ident)], [10, cat("#", ident)], [4, pick(OTHER_SIMPLE_SELECTORS)],
+    [12, attribute], [16, pick(PSEUDO_CLASSES)], [10, pick(PSEUDO_ELEMENTS)],
+  ];
