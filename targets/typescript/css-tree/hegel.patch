@@ -0,0 +1,901 @@
+// Hegel zoo: the generators behind the css-tree properties, as values built from Hegel's
+// combinators, and the pure functions that render what they draw.
+//
+// CSS text is a grammar of generator values: a stylesheet is a list of rules, at-rules,
+// comments and stray tokens; a rule a selector list and a declaration block; a value a list of
+// components (idents, numbers, dimensions, strings, urls, functions, nested parentheses) with
+// the separator drawn between each pair; and the whitespace at every gap is drawn where it is
+// written, so a case shrinks to the plain spelling. The recursive constructs (values inside
+// functions, selectors inside pseudo-classes, blocks inside blocks) are bounded by building each
+// depth's generators from the ones below, since the binding has no recursive combinator. A
+// "soup" of CSS-flavoured pieces (NUL, BOM, escapes, unterminated constructs) covers the
+// tokenizer's error paths. `valueFromSyntax` derives a value from one of the lexer's own
+// definition-syntax grammars: that derivation is a composite, since every choice depends on the
+// grammar node reached and on the budget spent so far; `grammarAst` draws a definition-syntax
+// tree for the round trip of that parser.
+//
+// The shapes of the recorded bugs (bugs.toml) are drawn like any other, so the properties find
+// the bugs and fail on them; the `KNOWN:` comments mark the places that draw them, and the last
+// section draws each bug's shape region on its own. Under HEGEL_NO_KNOWN=1 (`noKnown`) those
+// places leave the shape out, for a run that looks past the known bugs.
+
+import { gs, noKnown } from "./hegel-zoo.mjs";
+
+// ---------------------------------------------------------------- generator helpers
+
+export const ints = (lo, hi) => gs.integers({ minValue: lo, maxValue: hi });
+
+/** oneOf with weights: `weighted([45, a], [55, b])` draws a 45 times in 100; shrinks towards the first choice. */
+export function weighted(...choices) {
+  if (choices.length === 1) return choices[0][1];
+  const total = choices.reduce((sum, [w]) => sum + w, 0);
+  return ints(0, total - 1).flatMap((r) => {
+    for (const [w, g] of choices) {
+      if (r < w) return g;
+      r -= w;
+    }
+    throw new Error("unreachable");
+  });
+}
+
+/** True pct percent of the time; shrinks to false. */
+export const chance = (pct) => ints(0, 99).map((r) => r >= 100 - pct);
+/** A draw from g pct percent of the time, else undefined (listed first: shrinks to absent). */
+export const maybe = (pct, g) => weighted([100 - pct, gs.just(undefined)], [pct, g]);
+/** A string constant as a generator, a generator as it is. */
+const lift = (p) => (typeof p === "string" ? gs.just(p) : p);
+/** The text of g pct percent of the time, else the empty text (first: shrinks to nothing). */
+const optText = (pct, g) => weighted([100 - pct, gs.just("")], [pct, lift(g)]);
+/** The texts of `parts` (generators or string constants) concatenated. */
+export const cat = (...parts) => gs.tuples(...parts.map(lift)).map((xs) => xs.join(""));
+/** `min` to `max` texts of g concatenated. */
+const many = (g, max, min = 0) => gs.arrays(g, { minSize: min, maxSize: max }).map((xs) => xs.join(""));
+const pick = (xs) => gs.sampledFrom(xs);
+
+// ---------------------------------------------------------------- whitespace, idents, tokens
+
+export const WS = [" ", " ", " ", "  ", "\n", "\t", "\r\n", "\f", " \n ", "\r"];
+export const ws = pick(WS);
+/** Optional whitespace: none 65% of the time. */
+export const ows = weighted([65, gs.just("")], [35, ws]);
+
+// Valid identifiers (escapes and non-ASCII included); no CSS-wide keywords.
+export const IDENTS = ["a", "b", "div", "span", "color", "margin-top", "background", "width", "z-index",
+  "font-family", "content", "x1", "-webkit-flex", "\u{fc}", "\\31 23", "e\\:x", "A", "Bc", "hyphenated-long-name",
+  "-x", "_y", "\\-", "i\\64 1", "\u{65e5}\u{672c}", "\u{1f600}x", "--", "-\\-", "red", "none", "auto", "e3", "n", "odd"];
+export const ident = pick(IDENTS);
+export const customIdent = pick(["--x", "--custom-prop", "--0", "--\\31", "---", "--\u{65e5}"]);
+
+export const STRINGS = ['"a"', "'b'", '""', "''", '"a;b"', '"{"', "'}'", '"\\""', "'\\''", '"a\\\nb"', '"( "', '")"',
+  '"/*"', '"*/"', '"\\61"', '"\\61 b"', '"\\0"', '"\\110000"', '"a\\\r\nb"', "'\u{fc}\\9 x'", '"\\1F600"', '"tab\there"'];
+export const str = pick(STRINGS);
+
+export const NUMBERS = ["0", "1", "-1", "+1", ".5", "-.5", "1.5", "1e3", "1E-3", "1.5e+2", "007", "0.0", "-0", "1e0", "100", "12.50"];
+export const num = pick(NUMBERS);
+
+export const UNITS = {
+  length: ["cm", "mm", "q", "in", "pt", "pc", "px", "em", "rem", "ex", "rex", "cap", "rcap", "ch", "rch", "ic", "ric", "lh", "rlh",
+    "vw", "svw", "lvw", "dvw", "vh", "svh", "lvh", "dvh", "vi", "svi", "lvi", "dvi", "vb", "svb", "lvb", "dvb",
+    "vmin", "svmin", "lvmin", "dvmin", "vmax", "svmax", "lvmax", "dvmax", "cqw", "cqh", "cqi", "cqb", "cqmin", "cqmax"],
+  angle: ["deg", "grad", "rad", "turn"],
+  time: ["s", "ms"],
+  frequency: ["hz", "khz"],
+  resolution: ["dpi", "dpcm", "dppx", "x"],
+  flex: ["fr"],
+  decibel: ["db"],
+  semitones: ["st"],
+};
+const ALL_UNITS = Object.values(UNITS).flat();
+
+/** A number with a unit css-tree knows, or an upper-case, unknown, escaped or odd one. */
+export const dimension = cat(num, pick([...ALL_UNITS, "PX", "Em", "foo", "\\31", "e", "-x"]));
+export const percentage = cat(num, "%");
+export const hash = pick(["#fff", "#aabbcc", "#1", "#-x", "#\\31 ", "#ffff0000", "#abcd", "#x-y_z", "#\u{65e5}"]);
+const URLS = ["url(a.png)", "url( a.png )", "url('a b')", 'url( "q" )', "url(a\\)b)", "url()",
+  "url(a%20b)", "url(http://x/y?z=1&w=2)", "URL(x)", 'url(\\"q)', "url(#frag)", "url(data:image/png;base64,AAAA)"];
+/** A url; the whitespace-only `url( )` 2% of the time (KNOWN: its value keeps a space, so generate/parse is not a fixpoint, css-tree/3; not under HEGEL_NO_KNOWN=1). */
+export const url = noKnown ? pick(URLS) : weighted([98, pick(URLS)], [2, gs.just("url( )")]);
+
+const COMMENT_BODIES = ["c", " c ", "", " ", "\n", "multi\nline", "!bang", " * ", "a{b:c}", ";", '"', "/", "**", "*", " x\r\n y ", "\u{fc}"];
+export const comment = pick(COMMENT_BODIES).map((body) => "/*" + body + "*/");
+
+// ---------------------------------------------------------------- values
+
+const FUNCTIONS = ["rgb", "rgba", "hsl", "calc", "min", "max", "clamp", "var", "env", "attr", "counter", "counters",
+  "translate", "rotate", "linear-gradient", "image-set", "cubic-bezier", "steps", "format", "local", "--custom-fn",
+  "-webkit-gradient", "expression", "selector", "round", "sign", "light-dark", "color-mix"]; // no url(: unquoted arguments make a <bad-url-token>
+const MATH_FUNCTIONS = ["calc", "min", "max", "clamp"];
+const UNICODE_RANGES = ["U+26", "U+0-7F", "u+4??", "U+1F600-1F64F", "U+???", "u+a"];
+const VALUE_OPERATORS = ["/", "+", "-", "*", ","];
+// No junk tokens (`!`, `=`, `<`, `@x`, ...) in a value: css-tree wraps the value in Raw, and one
+// Raw anywhere leaves the whole stylesheet to the fixpoint property's weak path; `anyCss` covers
+// that path by splicing soup into a stylesheet.
+const VALUE_SEPARATORS = [" ", " ", " ", ", ", ",", " / ", "/", "", "\n", " , "];
+
+/** A term of a math function: a number, dimension or percentage, `var(--x)`, a parenthesised sum, or a constant (e, pi, infinity, -infinity, NaN). */
+const mathTerm = weighted([1, num], [1, dimension], [1, percentage], [1, gs.just("var(--x)")], [1, cat("(", num, " + ", dimension, ")")], [5, pick(["e", "pi", "infinity", "-infinity", "NaN"])]);
+/** A math function of `name`: a term and 0-3 more, each after an operator. */
+const mathFunction = (name) => cat(name, "(", ows, mathTerm, many(cat(pick([" + ", " - ", "*", " * ", "/", " / ", ","]), mathTerm), 3), ows, ")");
+/** `var()` of a custom property, with a fallback half the time (empty 30% of those). */
+const varFunction = (values) => cat("var(", ows, customIdent, optText(50, cat(",", ows, optText(70, values))), ows, ")");
+/** A function over `values`: var(), a math function, or any other of FUNCTIONS with values inside (none 20% of the time). */
+const functionOf = (values) => pick(FUNCTIONS).flatMap((name) => (name === "var" ? varFunction(values) : MATH_FUNCTIONS.includes(name) ? mathFunction(name) : cat(name, "(", ows, optText(80, values), ows, ")")));
+
+/**
+ * One component of a value whose nested values come from `values` (null at the innermost
+ * depth): an ident 14% of the time, a number 10, a dimension 12, a percentage 6, a string 8, a
+ * hash 6, a url 6, a unicode range 4, an operator 3, a comment 4, and, when there is a level
+ * below, a parenthesised value 5, a bracketed one 3 and a function 19 (else an ident).
+ */
+function componentOf(values) {
+  const leaf = (identWeight) => [
+    [identWeight, ident], [10, num], [12, dimension], [6, percentage], [8, str], [6, hash], [6, url],
+    [4, pick(UNICODE_RANGES)], [3, pick(VALUE_OPERATORS)], [4, comment],
+  ];
+  if (values === null) return weighted(...leaf(41));
+  return weighted(...leaf(14), [5, cat("(", ows, values, ows, ")")], [3, cat("[", ows, values, ows, "]")], [19, functionOf(values)]);
+}
+/** Whether a component ending `left` can be glued to the next one without the two merging into one token (or a comment). */
+const gluable = (left) => /(\)|"|'|\]|%|\*\/)$/.test(left);
+/** 1-5 components, each after the first behind a space, comma, slash, newline or nothing (a space instead where nothing would merge the two into one token, and after a slash before a `*`, which would open a comment). */
+const valuesOf = (component) =>
+  gs.tuples(component, gs.arrays(gs.tuples(pick(VALUE_SEPARATORS), component), { maxSize: 4 })).map(([first, rest]) =>
+    rest.reduce((s, [sep, next]) => {
+      const between = sep === "" && !gluable(s) ? " " : sep;
+      return s + between + ((s + between).endsWith("/") && next.startsWith("*") ? " " : "") + next;
+    }, first),
+  );
+
+/** A declaration value, its functions and groups nested two deep. */
+export const values = [0, 1, 2].reduce((below, depth) => valuesOf(componentOf(depth === 0 ? null : below)), null);
+
+const IMPORTANT = ["!important", " !important", "! important", "!IMPORTANT", "!  important", " ! ie", "!ie", "!\nimportant"];
+/** The `!important` tail of a declaration: none 4 times in 14, one of eight spellings 8, with a comment before or after it 1 each. */
+export const important = weighted([4, gs.just("")], [8, pick(IMPORTANT)], [1, cat(comment, "!important")], [1, cat("!important", comment)]);
+
+export const PROPERTIES = ["color", "margin", "margin-top", "background", "width", "z-index", "font", "font-family", "content", "display", "border",
+  "grid-template-areas", "transition", "-webkit-box-shadow", "-moz-appearance", "*color", "_width", "//x", "$y", "#z", "+w", "/r",
+  "--x", "--custom-prop", "--Case", "COLOR", "Margin-Top", "src", "unicode-range", "filter", "animation", "unknown-property", "cx"];
+// A custom property value: anything balanced without a top-level ; or }. (KNOWN: the last two
+// hold a backslash before a newline, which generate() doubles on every pass, css-tree/9; not
+// under HEGEL_NO_KNOWN=1.)
+const CUSTOM_VALUES = ["", "", "", "1", "{a:b}", "[x]", "(y)", " a b c ", " red , blue ", "!important", "{;}", "url(x)", "'s'", "/*c*/", " /*c*/ 1 /*d*/ ", "\n2\n",
+  ...(noKnown ? [] : ["\\\n1", " a\\\r\nb"])];
+
+/** A declaration: a custom property with a raw value (and an important tail 30% of the time, unless the value is one), else a property, a value (none 8%) and the important tail, with optional whitespace at the colon. */
+export const declaration = pick(PROPERTIES).flatMap((name) =>
+  name.startsWith("--")
+    ? cat(name, ows, ":", gs.tuples(pick(CUSTOM_VALUES), optText(30, important)).map(([value, tail]) => (value.includes("!") ? value : value + tail)))
+    : cat(name, ows, ":", ows, optText(92, values), ows, important),
+);
+
+// ---------------------------------------------------------------- selectors
+
+const OTHER_SIMPLE_SELECTORS = ["*", "ns|a", "*|*", "|a", "ns|*", "&"];
+const ATTRIBUTE_NAMES = ["a", "data-x", "ns|attr", "*|a", "|a"];
+/** The matcher of an attribute selector: none, or an operator with a string or ident, some with a case flag. */
+const attributeMatcher = gs.oneOf(gs.just(""), cat("=", str), cat("~=", ident), cat("|=", ident), cat("^=", str), cat("$=", ident), cat("*=", str), cat("=", ident, " i"), cat("=", str, " S"), cat("= ", str, "\ti"));
+const attribute = cat("[", ows, pick(ATTRIBUTE_NAMES), ows, attributeMatcher, ows, "]");
+const PSEUDO_CLASSES = [":hover", ":first-child", ":nth-child(2n+1)", ":nth-child(odd)", ":nth-child( -n + 3 )", ":nth-last-of-type(even)", ":nth-of-type(3)", ":lang(en)", ":lang(en, fr-CA)", ":dir(rtl)", ":host", ":host(.a)", ":host-context(.b)", ":root", ":FIRST-CHILD", ":-moz-focusring", ":nth-child(2n of .a, .b)", ":empty"];
+const PSEUDO_ELEMENTS = ["::before", "::after", ":before", "::slotted(span)", "::part(x)", "::cue(b)", "::-webkit-scrollbar", "::highlight(h)", "::view-transition-group(*)"];
+const FUNCTIONAL_PSEUDOS = [":not", ":is", ":where", ":has", ":matches", ":-webkit-any", ":nth-child", "::slotted", ":host"];
+
+/**
+ * A simple selector whose nested selectors come from `below` (the level below's simple
+ * selector, complex selector and selector list; null at the innermost depth): a type selector
+ * 15% of the time, a class 15, an id 10, a universal, namespaced or nesting selector 4, an
+ * attribute selector 12, a pseudo-class 16, a pseudo-element 10, and a functional pseudo-class
+ * over the level below 18 (else a class): `:has()` a relative selector, `:nth-child(.. of)` a
+ * list, `::slotted()` and `:host()` one compound selector, the rest a selector list.
+ */
+function simpleSelectorOf(below) {
+  const leaf = (classWeight) => [
+    [15, ident], [classWeight, cat(".", ident)], [10, cat("#", ident)], [4, pick(OTHER_SIMPLE_SELECTORS)],
+    [12, attribute], [16, pick(PSEUDO_CLASSES)], [10, pick(PSEUDO_ELEMENTS)],
+  ];
+  if (below === null) return weighted(...leaf(33));
+  const functional = pick(FUNCTIONAL_PSEUDOS).flatMap((name) => {
+    if (name === ":has") return cat(":has(", ows, pick(["> ", "+ ", "~ ", ""]), below.selector, ows, ")");
+    if (name === ":nth-child") return cat(":nth-child(", pick(["2n+1", "odd", "-n+3", "n"]), " of ", below.selectorList, ")");
+    if (name === "::slotted" || name === ":host") return cat(name, "(", ows, below.simpleSelector, ows, ")");
+    return cat(name, "(", ows, below.selectorList, ows, ")");
+  });
+  return weighted(...leaf(15), [18, functional]);
+}
+
+const COMBINATORS = [" ", ">", " > ", "+", " ~ ", "", "", " + ", "\n>\n", " /deep/ "]; // no column combinator ||: css-tree does not parse it
+/**
+ * A complex selector: a simple selector and 0-3 more, each behind a combinator. Behind the
+ * empty combinator a type selector is made a class, so a compound stays a compound (a universal
+ * or namespaced one gets a descendant combinator instead). A `>` right after the selector `--`
+ * would make a CDC token: it gets a space before it when `childAfterDoubleHyphen` (20%; KNOWN:
+ * generate drops that space again, css-tree/14, so never under HEGEL_NO_KNOWN=1) and is a
+ * descendant combinator otherwise.
+ */
+const childAfterDoubleHyphen = noKnown ? gs.just(false) : chance(20);
+const selectorOf = (simpleSelector) =>
+  gs.tuples(simpleSelector, gs.arrays(gs.record({ comb: pick(COMBINATORS), next: simpleSelector, childAfterDoubleHyphen }), { maxSize: 3 })).map(([first, rest]) =>
+    rest.reduce((s, { comb, next, childAfterDoubleHyphen }) => {
+      if (comb === "" && !/^[.#:[&]/.test(next)) return s + (next.startsWith("*") || next.includes("|") ? " " + next : "." + next);
+      if (/--$/.test(s) && comb.startsWith(">")) return s + (childAfterDoubleHyphen ? " " + comb : " ") + next;
+      return s + comb + next;
+    }, first),
+  );
+/** A selector list: a selector and 0-2 more behind commas. */
+const selectorListOf = (selector) => cat(selector, many(cat(pick([",", ", ", " ,", ",\n"]), selector), 2));
+
+/** The selector generators, functional pseudo-classes nested two deep. */
+const selectors = [0, 1, 2].reduce((below) => {
+  const simpleSelector = simpleSelectorOf(below);
+  const selector = selectorOf(simpleSelector);
+  return { simpleSelector, selector, selectorList: selectorListOf(selector) };
+}, null);
+export const selector = selectors.selector;
+export const selectorList = selectors.selectorList;
+
+// ---------------------------------------------------------------- at-rule preludes
+
+/** A condition over `term`: a term and 0-2 more behind one of `and`/`or` 80% of the time, else `not` and a term. */
+const conditionOf = (term) => weighted([80, cat(term, pick([" and ", " or "]).flatMap((op) => many(cat(op, term), 2)))], [20, cat("not ", term)]);
+
+const MEDIA_FEATURES = ["(min-width: 100px)", "(max-width:1e3px)", "(width >= 600px)", "(400px < width < 700px)", "(width<=1px)", "(orientation: landscape)", "(color)", "(min-resolution: 2dppx)",
+  "(aspect-ratio: 16/9)", "(min-aspect-ratio: 16 / 9)", "(prefers-color-scheme: dark)", "(-webkit-min-device-pixel-ratio: 2)", "(hover: hover)", "(color-gamut: p3)", "(grid: 0)", "(update)", "( width : 1px )", "(--custom)", "(min-width: calc(1px + 2px))"];
+const MEDIA_JUNK = ["general(enclosed)", "(x y z)", "(1px)"];
+/** Media conditions by nesting depth: a term is a feature (a general-enclosed one, which css-tree parses as Raw, 2% of the time), and, above depth 0, a parenthesised condition of the depth below 6% (css-tree parses it fully but reports an error, css-tree/11, which sends a stylesheet with any Raw node to the fixpoint property's weak path). */
+const mediaTerms = [];
+const mediaConditions = [];
+for (let depth = 0; depth <= 2; depth++) {
+  const term = depth === 0
+    ? weighted([98, pick(MEDIA_FEATURES)], [2, pick(MEDIA_JUNK)])
+    : weighted([92, pick(MEDIA_FEATURES)], [2, pick(MEDIA_JUNK)], [6, cat("(", mediaConditions[depth - 1], ")")]);
