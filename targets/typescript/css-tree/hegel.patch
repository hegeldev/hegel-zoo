+++ b/hegel/hegel.test.mjs
@@ -0,0 +1,1051 @@
+// Hegel properties for css-tree: the tokenizer against a second spec tokenizer, parse/generate as
+// a fixpoint, the lexer against values built from its own grammar, the walker, positions, clone
+// and plain-object conversion, List against an array, the name and value encoders against their
+// docs and the CSSOM idioms they cite, and the definition-syntax parser/generator round trip.
+// Each property draws one case record (see gen.mjs for the generators) and renders it with pure
+// functions; an operation list is applied with positions taken modulo the live size.
+
+import { count, fail, gs, pin, property, same, show } from "./hegel-zoo.mjs";
+import * as ct from "../lib/index.js";
+import * as gen from "./gen.mjs";
+import { chance, ints, maybe, weighted } from "./gen.mjs";
+import { ENCODE_CHARS, cssomString, firstDiff, lineCol, plain, traverse, traverseLeave, traverseSkipping } from "./model.mjs";
+import "./pins.mjs";
+
+const hegelModules = "../.hegel/node_modules/";
+const { tokenize: refTokenize } = await import(new URL(hegelModules + "@csstools/css-tokenizer/dist/index.mjs", import.meta.url));
+
+const { parse, generate, walk, find, findLast, findAll, toPlainObject, fromPlainObject, clone, lexer, List, tokenize, tokenNames, definitionSyntax: ds } = ct;
+
+const Known = {
+  badStringEatsNewline: true, // css-tree/1: a <bad-string-token> includes the newline that ended it (CSS Syntax 4.3.5 reconsumes the newline)
+  backslashAtEof: true, // css-tree/2: a backslash at the end of the input is not treated as an escape (CSS Syntax 4.3.8 makes it one, decoding to U+FFFD)
+  urlWhitespaceOnly: true, // css-tree/3: url.decode (and the Url node) of url( ) with only whitespace inside keeps one space instead of the empty string
+  nulNotReplaced: true, // css-tree/4: U+0000 is not replaced by U+FFFD (CSS Syntax 3.3), so it tokenizes as a delim and ends an escape
+  visitMissesPreludeDeclarations: true, // css-tree/5: walk with visit:'Declaration' skips declarations inside at-rule preludes (@supports, @container style(), @import supports())
+  propertyCacheBySpelling: true, // css-tree/6: property() caches its descriptor under the spelling asked, so property('NAME') !== property('name') when the upper-case one comes first
+  descendantCombinatorNoLoc: true, // css-tree/7: the descendant combinator (whitespace) has loc null with positions:true
+  urlEscapedTrailingSpace: true, // css-tree/8: url.decode of a url whose last character is an escaped whitespace (what url.encode emits for a value ending in a space) returns " )"
+  spuriousParseErrors: true, // css-tree/11: onParseError is called for valid CSS that parses completely (nested conditions in @media/@supports/@container, general-enclosed terms, @import supports(<condition>)): every parseWithFallback reports its first attempt's error even when the fallback is a full parse
+  nestedLayerBlockIsNotAStyleBlock: true, // css-tree/13: @layer nested in a style rule parses its block as a rule list (Block(false)) while @media/@supports/@container/@scope/@starting-style pass the nesting flag on, so `a { @layer x { color: red } }` gets a Raw declaration; the generator only nests statement-form @layer
+  relaxedNestingIsRaw: true, // css-tree/12: a nested style rule whose selector does not start with & is wrapped in a Raw node (upstream #268); the generator only emits &-prefixed nested rules
+  badUrlEscapeOverrun: true, // css-tree/10: consumeBadUrlRemnants skips the code point after an escape, so a <bad-url-token> containing an escape runs past the ) that ends it (swallowing what follows) and one past the end of the input at EOF
+  spaceAfterNulInEncode: true, // css-tree/16: string.encode and url.encode keep the "space needed after a hex escape" flag across a NUL (written as U+FFFD), so "\t\0a" encodes to `"\9<U+FFFD> a"` and decodes to a different string
+  escapedUrlNameIsAFunction: true, // css-tree/15: `\url(a)` (an escape in the name) is a function-token, while CSS Syntax 4.3.4 compares the decoded ident sequence with "url" and makes it a url-token
+  cdcFromDoubleHyphenSelector: true, // css-tree/14: generate() writes the type or class selector `--` and a following child combinator as `-->`, which re-tokenizes as a CDC token
+  backslashNewlineDoubles: true, // css-tree/9: generate() emits a newline after every backslash delim, so a backslash-newline in a Raw value grows by one newline per generate/parse round
+  unicodeRangeGluedToSignedNumber: true, // css-tree/18: generate() writes no space between a UnicodeRange without an end (`U+26`, not `U+26-7F` or `U+4??`) and a following signed Number, Dimension or Percentage, so `U+26 -1px` comes out as `U+26-1px` (re-parsed as Raw: the `-` is read as the range's dash) and `U+26 -1` as `U+26-1` (one UnicodeRange)
+  unterminatedStringEscapedQuote: true, // css-tree/19: string.decode of an unterminated string whose last characters are an escaped quote (`"a\"` at the end of the input, a string-token for both tokenizers) takes that quote as the closing one and returns `"` instead of `a"`
+  operatorWhitespaceNotAFixpoint: true, // css-tree/20: an Operator's value keeps the whitespace around it in the source (`x/*c*/- 1` and `f()- 1` give "- ", `x -/*c*/-1` gives " -"), while generate() writes a space before a `-` that follows an ident, `)` or comment, so parse(generate(ast)) has " - " where ast has "- ": the trees differ in the Operator values only
+  operatorBeforeCommaNeverMatches: true, // css-tree/21: the lexer never matches a quoted grammar token (`'*'`, `'+'`, `'/'`, `']'`: a String node of the definition syntax, not the `)` Token node of a function) that is directly followed by a comma: lexer.match("'*' , <ident-token>", "*, a"), lexer.match("'+'#", "+, +"), lexer.match("'[' <ident-token> ']' , <ident-token>", "[ a ], b") and matchType("compound-selector-list", "*, #foo") are Mismatch, while "'*' <ident-token>" matches "* a", "'(' <ident-token> ')' , <ident-token>" matches "( a ), b" and "#foo, *" matches the list; for the `]` case only a parsed value fails (matchType("compound-selector-list", parse("[ foo ], #foo", { context: "value" })) is Mismatch, the same text as a string matches)
+  mediaTypeSpaceBeforeComma: true, // css-tree/17: a media query list whose query ends in a media type and has whitespace before the following comma (`@media print , screen {}`, `@media only screen , print {}`, `@import url(x) print , screen;`) fails with "Semicolon or block is expected" and a Raw prelude, while `print, screen` and `(color) , screen` parse (Media Queries 4 allows whitespace around the comma)
+  eUnitGluedToPlusNumber: true, // css-tree/22: generate() writes no space between a Dimension whose unit is `e` and a following `+`-signed Number, Dimension or Percentage (`1e +1` comes out as `1e+1`, one number with an exponent; `0e +1st` as the dimension 0e+1st), while `1e -1` keeps its space
+  featureFunctionRawFailsStructure: true, // css-tree/23: `@container style(...)` whose content is not a declaration parses into a FeatureFunction with a Raw value (with a parse error), which the node's own structure (`value: ['Declaration', 'Selector']`) does not admit, so lexer.checkStructure warns "Bad value for `FeatureFunction.value`" on the parser's output
+  unclosedBlockAtEof: true, // css-tree/24: the end of the input inside a block is not reported to onParseError (CSS Syntax 5.4.8 calls it a parse error: `a{`, `a{b:(` report nothing), and the Raw of an expression() value swallows the rest of the input silently, so generate() writes closers the source lacked and `a{b:expression([(}` generates `a{b:expression([(})}`, which re-parses with `[(})` as the Raw
+};
+
+const diffText = (a, b) => {
+  const d = firstDiff(a, b);
+  if (!d) return "(equal)";
+  if (typeof d.a === "string" && typeof d.b === "string" && !/\.type$|\.length$/.test(d.path)) {
+    let k = 0;
+    while (k < d.a.length && k < d.b.length && d.a[k] === d.b[k]) k++;
+    return `at ${d.path} (char ${k}): ${show(d.a.slice(Math.max(0, k - 20), k + 30))} vs ${show(d.b.slice(Math.max(0, k - 20), k + 30))}`;
+  }
+  const parentPath = d.path.replace(/\.[a-zA-Z]+$|\[\d+\]$|\.length$/, "");
+  const get = (root, path) => { let cur = root; for (const seg of path.slice(1).split(/\.|\[|\]/).filter(Boolean)) cur = cur == null ? cur : cur[/^\d+$/.test(seg) ? Number(seg) : seg]; return cur; };
+  return `at ${d.path}: ${show(d.a)} vs ${show(d.b)}\n  parent before ${show(get(a, parentPath)).slice(0, 400)}\n  parent after  ${show(get(b, parentPath)).slice(0, 400)}`;
+};
+
+// The tree with every Operator's value stripped of its whitespace (an Operator keeps the whitespace around it in `value`).
+const trimOps = (tree) => JSON.parse(JSON.stringify(tree, (k, v) => (v && v.type === "Operator" && typeof v.value === "string" ? { ...v, value: v.value.trim() } : v)));
+
+// Two trees are the same; or differ only in the whitespace of Operator values (css-tree/20), counted and let through.
+function sameTree(a, b) {
+  if (same(a, b)) return true;
+  if (Known.operatorWhitespaceNotAFixpoint && same(trimOps(a), trimOps(b))) {
+    count("known css-tree/20 operator whitespace differs after generate");
+    return true;
+  }
+  return false;
+}
+
+// A Url value that css-tree cannot carry through generate/parse (bugs 3 and 8).
+function urlValueKnownBroken(ast) {
+  let known = null;
+  walk(ast, (node) => {
+    if (node.type === "Url" && /^\s*$/.test(node.value) && node.value !== "") known = "known css-tree/3 url( )";
+    else if (node.type === "Url" && /\s$/.test(node.value) && !known) known = "known css-tree/8 url ending in whitespace";
+  });
+  return known;
+}
+
+// ---------- helpers ----------
+
+function ctTokens(source) {
+  const out = [];
+  tokenize(source, (type, start, end) => out.push({ type: tokenNames[type], start, end, raw: source.slice(start, end) }));
+  return out;
+}
+
+function refTokens(source) {
+  return refTokenize({ css: source })
+    .filter((t) => t[0] !== "EOF-token")
+    .map((t) => ({ type: t[0] === "comment" ? "comment-token" : t[0], start: t[2], end: t[3] + 1, raw: t[1], extra: t[4] }));
+}
+
+function fixNul(s) {
+  return s.replace(/\0/g, "\u{fffd}");
+}
+
+const PROPERTY_NAMES = Object.keys(lexer.properties).filter((p) => lexer.properties[p].syntax && !p.startsWith("--"));
+const TYPE_NAMES = Object.keys(lexer.types).filter((t) => lexer.types[t].syntax);
+// The names whose grammar can spell a value at all (a selector list, a keyframe block or an
+// @-keyword cannot; see gen.isValueGrammar): the lexer property matches values.
+const VALUE_PROPERTY_NAMES = PROPERTY_NAMES.filter((p) => gen.isValueGrammar(lexer, lexer.getProperty(p).syntax));
+// Not the type var() itself: the lexer refuses any value holding a var() ("Matching for a tree
+// with var() is not supported", Lexer.matchSyntax), a documented limit, not a match to check.
+const VALUE_TYPE_NAMES = TYPE_NAMES.filter((t) => t !== "var()" && gen.isValueGrammar(lexer, lexer.getType(t).syntax));
+
+// ---------- 1. tokenizer ----------
+
+/** The tokenizer's source: token soup 55% of the time, else structured CSS (a stylesheet, soup, or a stylesheet with soup spliced in). */
+const tokenizerCase = weighted([55, gen.soup], [45, gen.anyCss]);
+
+property("TestHegelTokenizerAgreesWithTheReferenceTokenizer", (tc) => {
+  const source = tc.draw(tokenizerCase).replace(/^\u{feff}+/u, ""); // css-tree skips a leading BOM, the reference keeps it (both defensible)
+  const a = ctTokens(source);
+  const b = refTokens(source);
+  const shape = (ts) => ts.map((t) => `${t.type}@${t.start}-${t.end}`).join(" ");
+  // the token stream covers the source contiguously
+  let pos = 0;
+  for (const t of a) {
+    if (t.start !== pos || t.end <= t.start) fail(`token ${t.type} at ${t.start}-${t.end} does not continue from ${pos} in ${show(source)}`);
+    pos = t.end;
+  }
+  if (pos !== source.length) {
+    if (Known.badUrlEscapeOverrun && pos === source.length + 1 && a[a.length - 1].type === "bad-url-token") {
+      count("known css-tree/10 bad-url escape overrun");
+      return;
+    }
+    fail(`tokens end at ${pos}, source has ${source.length} chars: ${show(source)}`);
+  }
+  if (shape(a) !== shape(b)) {
+    if (Known.badStringEatsNewline && a.some((t) => t.type === "bad-string-token" && /[\n\r\f]$/.test(t.raw))) {
+      count("known css-tree/1 bad-string newline");
+    } else if (Known.nulNotReplaced && source.includes("\0")) {
+      count("known css-tree/4 NUL");
+    } else if (Known.escapedUrlNameIsAFunction && a.some((t) => t.type === "function-token" && t.raw.includes("\\") && ct.ident.decode(t.raw.slice(0, -1)).toLowerCase() === "url")) {
+      count("known css-tree/15 escaped url( name");
+    } else if (Known.badUrlEscapeOverrun && a.some((t) => t.type === "bad-url-token" && /\\[^\n\r\f]/.test(t.raw))) {
+      count("known css-tree/10 bad-url escape overrun");
+    } else if (Known.backslashAtEof && /\\$/.test(source) && /\\+$/.exec(source)[0].length % 2 === 1) {
+      // an odd run of backslashes at the end: the last one is a lone backslash at EOF (an even run is escaped backslashes)
+      count("known css-tree/2 backslash at EOF");
+    } else if (Known.backslashAtEof && /\\$/.test(source)) {
+      count("backslash run at EOF (unclassified)");
+      fail(`tokens differ on ${show(source)}\n  css-tree:  ${shape(a)}\n  reference: ${shape(b)}`);
+    } else {
+      fail(`tokens differ on ${show(source)}\n  css-tree:  ${shape(a)}\n  reference: ${shape(b)}`);
+    }
+    return;
+  }
+  // token values: css-tree's decoders against the reference's decoded values
+  for (const t of b) {
+    if (!t.extra || t.raw.includes("\0")) continue;
+    const info = () => ` for ${t.type} ${show(t.raw)} in ${show(source)}`;
+    switch (t.type) {
+      case "ident-token":
+        if (ct.ident.decode(t.raw) !== t.extra.value) fail(`ident.decode gives ${show(ct.ident.decode(t.raw))}, reference ${show(t.extra.value)}${info()}`);
+        break;
+      case "function-token":
+        if (ct.ident.decode(t.raw.slice(0, -1)) !== t.extra.value) fail(`ident.decode of a function name gives ${show(ct.ident.decode(t.raw.slice(0, -1)))}, reference ${show(t.extra.value)}${info()}`);
+        break;
+      case "at-keyword-token":
+      case "hash-token":
+        if (ct.ident.decode(t.raw.slice(1)) !== t.extra.value) fail(`ident.decode gives ${show(ct.ident.decode(t.raw.slice(1)))}, reference ${show(t.extra.value)}${info()}`);
+        break;
+      case "string-token":
+        if (ct.string.decode(t.raw) !== t.extra.value) {
+          // unterminated, ending in an escaped quote: an odd number of backslashes before the last character, a quote
+          if (Known.unterminatedStringEscapedQuote && /(^|[^\\])(\\\\)*\\["']$/.test(t.raw)) count("known css-tree/19 unterminated string ending in an escaped quote");
+          else fail(`string.decode gives ${show(ct.string.decode(t.raw))}, reference ${show(t.extra.value)}${info()}`);
+        }
+        break;
+      case "url-token":
+        if (ct.url.decode(t.raw) !== t.extra.value) {
+          if (Known.urlWhitespaceOnly && /^url\(\s+\)?$/i.test(t.raw)) count("known css-tree/3 url( )");
+          else fail(`url.decode gives ${show(ct.url.decode(t.raw))}, reference ${show(t.extra.value)}${info()}`);
