+property("TestHegelValidNestedConditionsReportNoParseError", (tc) => checkFixpoint(tc, tc.draw(gen.spuriousParseErrorSheet), null), KNOWN);
+property("TestHegelRelaxedNestedRulesParseAsRules", (tc) => checkFixpoint(tc, tc.draw(gen.relaxedNestedRuleSheet), null), KNOWN);
+property("TestHegelNestedLayerBlocksHoldDeclarations", (tc) => checkFixpoint(tc, tc.draw(gen.nestedLayerSheet), null), KNOWN);
+property("TestHegelChildCombinatorAfterDoubleHyphenReparses", (tc) => checkFixpoint(tc, tc.draw(gen.doubleHyphenBeforeChildSheet), null), KNOWN);
+property("TestHegelMediaTypeBeforeASpacedCommaParses", (tc) => checkFixpoint(tc, tc.draw(gen.mediaTypeBeforeSpacedCommaSheet), null), KNOWN);
+property("TestHegelUnicodeRangeBeforeASignedNumberReparses", (tc) => checkFixpoint(tc, tc.draw(gen.unicodeRangeBeforeSignedNumberSheet), null), KNOWN);
+property("TestHegelMinusAfterACommentOrGroupIsAFixpoint", (tc) => checkFixpoint(tc, tc.draw(gen.minusAfterGroupSheet), null), KNOWN);
+property("TestHegelEUnitBeforeAPlusSignedNumberReparses", (tc) => checkFixpoint(tc, tc.draw(gen.eUnitBeforePlusSignedNumberSheet), null), KNOWN);
+property("TestHegelContainerStyleWithRawContentPassesCheckStructure", (tc) => checkFixpoint(tc, tc.draw(gen.containerStyleJunkSheet), null), KNOWN);
+property("TestHegelUnclosedBlockAtTheEndOfInputIsAParseError", (tc) => checkFixpoint(tc, tc.draw(gen.unclosedBlockSheet), null), KNOWN);
+
+property("TestHegelQuotedGrammarTokenBeforeACommaMatches", (tc) => {
