@@ -0,0 +1,854 @@
+// Hegel properties for css-tree: the tokenizer against a second spec tokenizer, parse/generate as
+// a fixpoint, the lexer against values built from its own grammar, the walker, positions, clone
+// and plain-object conversion, List against an array, the name and value encoders against their
+// docs and the CSSOM idioms they cite, and the definition-syntax parser/generator round trip.
+
+import { createRequire } from "node:module";
+import { chance, count, fail, n, pick, pin, property, same, show, word } from "./hegel-zoo.mjs";
+import * as ct from "../lib/index.js";
+import * as gen from "./gen.mjs";
+import { ENCODE_CHARS, cssomString, firstDiff, lineCol, plain, traverse, traverseLeave, traverseSkipping } from "./model.mjs";
+import "./pins.mjs";
+
+const require = createRequire(import.meta.url);
+const hegelModules = "../.hegel/node_modules/";
+const { tokenize: refTokenize } = await import(new URL(hegelModules + "@csstools/css-tokenizer/dist/index.mjs", import.meta.url));
+
+const { parse, generate, walk, find, findLast, findAll, toPlainObject, fromPlainObject, clone, lexer, List, tokenize, tokenNames, definitionSyntax: ds } = ct;
+
+const Known = {
+  badStringEatsNewline: true, // css-tree/1: a <bad-string-token> includes the newline that ended it (CSS Syntax 4.3.5 reconsumes the newline)
+  backslashAtEof: true, // css-tree/2: a backslash at the end of the input is not treated as an escape (CSS Syntax 4.3.8 makes it one, decoding to U+FFFD)
+  urlWhitespaceOnly: true, // css-tree/3: url.decode (and the Url node) of url( ) with only whitespace inside keeps one space instead of the empty string
+  nulNotReplaced: true, // css-tree/4: U+0000 is not replaced by U+FFFD (CSS Syntax 3.3), so it tokenizes as a delim and ends an escape
+  visitMissesPreludeDeclarations: true, // css-tree/5: walk with visit:'Declaration' skips declarations inside at-rule preludes (@supports, @container style(), @import supports())
+  propertyCacheBySpelling: true, // css-tree/6: property() caches its descriptor under the spelling asked, so property('NAME') !== property('name') when the upper-case one comes first
+  descendantCombinatorNoLoc: true, // css-tree/7: the descendant combinator (whitespace) has loc null with positions:true
+  urlEscapedTrailingSpace: true, // css-tree/8: url.decode of a url whose last character is an escaped whitespace (what url.encode emits for a value ending in a space) returns " )"
+  spuriousParseErrors: true, // css-tree/11: onParseError is called for valid CSS that parses completely (nested conditions in @media/@supports/@container, general-enclosed terms, @import supports(<condition>)): every parseWithFallback reports its first attempt's error even when the fallback is a full parse
+  nestedLayerBlockIsNotAStyleBlock: true, // css-tree/13: @layer nested in a style rule parses its block as a rule list (Block(false)) while @media/@supports/@container/@scope/@starting-style pass the nesting flag on, so `a { @layer x { color: red } }` gets a Raw declaration; the generator only nests statement-form @layer
+  relaxedNestingIsRaw: true, // css-tree/12: a nested style rule whose selector does not start with & is wrapped in a Raw node (upstream #268); the generator only emits &-prefixed nested rules
+  badUrlEscapeOverrun: true, // css-tree/10: consumeBadUrlRemnants skips the code point after an escape, so a <bad-url-token> containing an escape runs past the ) that ends it (swallowing what follows) and one past the end of the input at EOF
+  spaceAfterNulInEncode: true, // css-tree/16: string.encode and url.encode keep the "space needed after a hex escape" flag across a NUL (written as U+FFFD), so "\t\0a" encodes to "\9� a" and decodes to a different string
