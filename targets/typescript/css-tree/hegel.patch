+/** A rule of an ident selector and one plain declaration: no Raw node anywhere in it (a custom property's value, a pseudo-element's argument are Raw). */
+const plainRule = cat(ident, ows, "{", ows, pick(["color", "width", "b"]), ows, ":", ows, pick(["red", "1px", "0"]), ows, "}");
+/** A rule block of 0-2 plain rules. */
+const plainRuleBlock = cat("{", ows, many(cat(plainRule, ows), 2), "}");
+/** css-tree/11: an at-rule whose prelude css-tree parses completely yet reports a parse error: a parenthesised condition in @media (30% of the time) or @supports (30), a general-enclosed term (15), `@import ... supports(selector())` (15), `@container (x y z)` (10); a plain rule before and after it half the time each (nothing that is Raw when parsed, so the error is the only thing wrong). */
+export const spuriousParseErrorSheet = cat(
+  optText(50, cat(plainRule, ows)),
+  weighted(
+    [30, cat(pick(["@media", "@MEDIA"]), ws, "(", mediaConditions[1], ")", optText(30, cat(" and ", mediaTerms[0])), ows, plainRuleBlock)],
+    [30, cat("@supports ", optText(20, "not "), "(", supportsCondition, ")", ows, plainRuleBlock)],
+    [15, cat(pick(["@media ", "@supports "]), pick(["general(enclosed)", "foo(bar)", "foo( a b )"]), ows, plainRuleBlock)],
+    [15, cat("@import url(a.css) supports(selector(", selector, "));")],
+    [10, cat("@container ", optText(35, "card "), "(x y z)", ows, plainRuleBlock)],
+  ),
+  optText(50, cat(ows, plainRule)),
+);
+
+/** css-tree/12: a rule whose block holds a nested rule with a selector that does not start with `&`, a declaration before it and after it half the time each. */
+export const relaxedNestedRuleSheet = cat(selectorList, ows, "{", ows, optText(50, cat(declaration, ";", ows)), relaxedSelector, ows, levels[0].declarationBlock, ows, optText(50, cat(declaration, optText(50, ";"), ows)), "}");
+
+/** css-tree/13: a rule whose block holds a @layer block of 1-3 declarations, a declaration before it and after it half the time each. */
+export const nestedLayerSheet = cat(selectorList, ows, "{", ows, optText(50, cat(declaration, ";", ows)), pick(["@layer", "@LAYER"]), pick(LAYER_NAMES), ows, "{", ows, declarations, ows, "}", ows, optText(50, cat(declaration, ows)), "}");
+
+/** css-tree/14: a rule whose selector has the type or class selector `--` right before a child combinator, a selector and combinator before that half the time. */
+export const doubleHyphenBeforeChildSheet = cat(optText(50, cat(selector, pick([" ", " > ", " + "]))), pick(["--", ".--", "*.--", "a.--"]), pick([">", " > ", " >", "> "]), selector, ows, levels[0].declarationBlock);
+
+/** css-tree/15: an escaped spelling of `url(` with an unquoted url of 0-4 pieces inside it, closed 80% of the time, soup around it. */
+export const escapedUrlNameSource = cat(plainSoup, " ", pick(["\\url(", "\\75rl(", "u\\rl(", "ur\\6c (", "\\55RL(", "U\\52L(", "\\75 rl("]), optText(30, " "), many(pick(["a", "b", ".", "/", "1", "-"]), 4), optText(30, " "), optText(80, ")"), plainSoup);
+
+/** css-tree/17: @media (70% of the time) or @import with a media type, whitespace, a comma and 1-2 more queries; a stylesheet before it 40%. */
+export const mediaTypeBeforeSpacedCommaSheet = cat(
+  optText(40, cat(stylesheet, ows)),
+  weighted(
+    [70, cat(pick(["@media", "@MEDIA"]), ws, pick(MEDIA_TYPES), ws, ",", ows, mediaQuery, optText(30, cat(ows, ",", ows, mediaQuery)), ows, weighted([80, ruleBlock], [20, gs.just(";")]))],
+    [30, cat("@import ", pick(['"a.css"', "url(a.css)"]), " ", pick(MEDIA_TYPES), ws, ",", ows, mediaQuery, ";")],
+  ),
+);
+
+/** A number that starts with a digit, as a plain integer, a dimension or an exponent. */
+const digitFirstNumber = pick(["1", "1px", "1e3", "2em", "12", "10"]);
+const DIGITS = "0123456789".split("");
+/** css-tree/18: a value with an open-ended unicode range of 1-4 decimal digits, whitespace and a `-`-signed digit-first number (a range with hex letters, or a percentage after the `-`, is written with the space and re-parses the same); a component before and after it 30% of the time each. */
+export const unicodeRangeBeforeSignedNumberSheet = cat(ident, ows, "{", ows, pick(["unicode-range", "b", "content", "src"]), ows, ":", ows, optText(30, cat(pick(["a", "1px", "'s'"]), " ")), pick(["U+", "u+"]), many(pick(DIGITS), 4, 1), pick([" ", "  ", "\n", "\t"]), "-", digitFirstNumber, optText(30, cat(" ", pick(["a", "1"]))), ows, "}");
+
+/** css-tree/19: an unterminated string at the end of the input whose last character is an escaped quote (an escaped backslash before it 30% of the time), soup before it. */
+export const unterminatedStringEscapedQuoteSource = quote.flatMap((q) => cat(plainSoup, " ", q, stringBody, optText(30, "\\\\"), "\\", q));
+
+/** css-tree/20: a value with a `-` right after a comment, a `)` or a `%` and whitespace (or a comment) before a number, or ` -`, a comment and a `-`-signed number. */
+export const minusAfterGroupSheet = cat(ident, ows, "{", ows, pick(["b", "width", "margin", "z-index"]), ows, ":", ows, weighted(
+  [80, cat(weighted([3, cat(ident, comment)], [2, cat(ident, "()")], [2, cat(ident, "(", num, ")")], [2, cat("(", ident, ")")], [1, cat("(", num, ")")], [2, percentage]), pick(["-", " -"]), pick([" ", "\n", "  ", "/*c*/", " /*c*/ "]), pick(["1", "1px", "2", "10%"]))],
+  [20, cat(ident, " -", comment, "-", pick(["1", "2px"]))],
+), ows, "}");
+
+/** css-tree/21: a selector list, as a lexer value, with `*` or a bracket group right before a comma; a selector before that 30% of the time and after 30%. */
+export const quotedTokenBeforeComma = cat(optText(30, cat(pick(["a", "#c", "b"]), ",", ows)), pick(["*", "[a]", "[data-x]"]), ",", ows, pick(["a", "#c", "[d]", "b"]), optText(30, cat(",", ows, pick(["a", "b"]))));
+
+/** css-tree/22: a value with a dimension whose unit is `e`, whitespace and a `+`-signed digit-first number; an ident before and after it 30% of the time each. */
+export const eUnitBeforePlusSignedNumberSheet = cat(ident, ows, "{", ows, pick(["b", "width", "content"]), ows, ":", ows, optText(30, cat(ident, " ")), pick(["1", "0", "12", "1.5"]), pick(["e", "E"]), pick([" ", "  ", "\n", "\t"]), "+", pick(["1", "2px", "1st", "1%", "10"]), optText(30, cat(" ", ident)), ows, "}");
+
+/** css-tree/23: @container with a style() feature whose content is not a declaration, a container atom before it 30% of the time and after it 30%, and a rule block. */
+export const containerStyleJunkSheet = cat(pick(["@container", "@CONTAINER"]), ws, optText(35, cat(pick(["card", "sidebar"]), " ")), optText(30, cat(pick(CONTAINER_ATOMS), " and ")), "style(", pick(["--a!", "--a", "--a b: 1", "x y", "", "1px", "a", "a b c"]), ")", optText(30, cat(pick([" and ", " or "]), pick(CONTAINER_ATOMS))), ows, ruleBlock);
+
+/** css-tree/24: a stylesheet whose last block is left open at the end of the input: a rule's block (40% of the time), a group or function opened in a declaration's value (40) or a conditional group rule's block (20); a stylesheet before it half the time. */
+export const unclosedBlockSheet = cat(
+  optText(50, cat(stylesheet, ows)),
+  weighted(
+    [40, cat(selectorList, ows, "{", ows, optText(60, cat(declaration, optText(60, ";"), ows)))],
+    [40, cat(selectorList, ows, "{", ows, optText(40, cat(declaration, ";", ows)), pick(["b", "--x", "width"]), ows, ":", ows, optText(50, cat(pick(["1", "a"]), " ")), pick(["(", "[", "f(", "expression([(", "(x", "calc(1px", "[{"]))],
+    [20, cat(pick(["@media (color)", "@supports (display: grid)", "@layer a"]), ows, "{", ows, optText(50, cat(levels[0].rule, ows)))],
+  ),
+);
diff --git a/hegel/hegel-zoo.mjs b/hegel/hegel-zoo.mjs
