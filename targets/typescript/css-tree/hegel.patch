+  const functional = pick(FUNCTIONAL_PSEUDOS).flatMap((name) => {
+    if (name === ":has") return cat(":has(", ows, pick(["> ", "+ ", "~ ", ""]), below.selector, ows, ")");
+    if (name === ":nth-child") return cat(":nth-child(", pick(["2n+1", "odd", "-n+3", "n"]), " of ", below.selectorList, ")");
