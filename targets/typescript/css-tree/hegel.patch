+    default: throw new Unsupported("generic " + name); // colon-token, at-keyword-token, CDO-token, CDC-token: not values
+  }
+}
+
+/** `xs` in a drawn order: a stable sort by one drawn key per element, so all-equal keys (the shrink target) keep the declared order. */
+function permuted(tc, xs) {
+  const keys = tc.draw(gs.arrays(ints(0, 99), { minSize: xs.length, maxSize: xs.length }));
+  return xs.map((x, i) => [x, keys[i], i]).sort((a, b) => a[1] - b[1] || a[2] - b[2]).map(([x]) => x);
+}
+
+// The pieces of a derived value: texts, a COMMA (elided by `render` where CSS Values 4 says so),
+// and the open and close of a function.
+const COMMA = Symbol("comma");
+
+/**
+ * One derivation of `syntax`: each choice taken by a draw, `lexer` resolving <type> and
+ * <'property'> references, within a budget of 60 nodes (a failed alternative's nodes are given
+ * back) and 400 calls (never given back, so a backtracking search cannot go exponential).
+ * Throws Unsupported when the grammar reaches something this generator cannot spell, or that
+ * the value parser would not read as part of a value.
+ */
+function derive(tc, lexer, syntax) {
+  const budget = { nodes: 60, calls: 400 };
+  function gen(node, range, depth) {
+    if (--budget.nodes < 0) throw new Unsupported("too big");
+    if (--budget.calls < 0) throw new TooManyCalls();
+    switch (node.type) {
+      case "Group": {
+        let result;
+        const nonEmpty = (r) => r.some((piece) => piece !== COMMA); // commas alone are elided later
+        for (let attempt = 0; ; attempt++) {
+          result = group(node, range, depth);
+          if (nonEmpty(result) || !node.disallowEmpty || attempt >= 3) break;
+        }
+        if (!nonEmpty(result) && node.disallowEmpty) throw new Unsupported("[ ]! stayed empty");
+        return result;
+      }
+      case "Multiplier": {
+        const min = node.min;
+        let max = node.max === 0 ? min + 2 : node.max;
+        if (depth < 0) max = min;
+        max = Math.min(max, min + 2);
+        const count = tc.draw(ints(min, max));
+        const parts = [];
+        for (let i = 0; i < count; i++) {
+          const s = gen(node.term, range, depth);
+          if (s.length === 0) continue;
+          if (parts.length > 0 && node.comma) parts.push(COMMA);
+          parts.push(...s);
+        }
+        return parts;
+      }
+      case "Keyword":
+        if (!IDENT_LIKE.test(node.name)) throw new Unsupported("keyword " + node.name);
+        return [node.name];
+      case "Comma": return [COMMA];
+      case "Token":
+        if (!VALUE_TOKENS.has(node.value)) throw new Unsupported("token " + node.value);
+        return [node.value === ")" ? { close: ")" } : node.value];
+      case "String": {
+        const text = node.value.replace(/^'(.*)'$/, "$1");
+        if (!isValueText(text)) throw new Unsupported("string " + text);
+        return [text];
+      }
+      case "AtKeyword": throw new Unsupported("at-keyword " + node.name);
+      case "Function": return [{ open: node.name + "(" }];
+      case "Type": {
+        const ref = lexer.getType(node.name);
+        if (!ref) throw new Unsupported("unknown type " + node.name);
+        const r = node.opts || range;
+        if (!ref.syntax) return [tc.draw(generic(node.name, r))];
+        return gen(ref.syntax, r, depth - 1);
+      }
+      case "Property": {
+        const ref = lexer.getProperty(node.name);
+        if (!ref || !ref.syntax) throw new Unsupported("unknown property " + node.name);
+        // a <'property'> reference excludes the property's top-level comma multiplier (CSS Values 4, 2.3;
+        // Lexer.js syntaxHasTopLevelCommaMultiplier): <'animation-duration'> inside <single-animation> is one time
+        let s = ref.syntax;
+        if (s.type === "Group" && !s.explicit && s.terms.length === 1 && s.terms[0].type === "Multiplier" && s.terms[0].comma) {
+          s = s.terms[0].term;
+        }
+        return gen(s, range, depth - 1);
+      }
+      default: throw new Unsupported("node " + node.type);
+    }
+  }
+  function group(node, range, depth) {
+    const terms = node.terms;
+    switch (node.combinator) {
+      case " ": return terms.flatMap((t) => gen(t, range, depth));
+      case "&&": return permuted(tc, terms).flatMap((t) => gen(t, range, depth));
+      case "||": {
+        const chosen = permuted(tc, terms).slice(0, tc.draw(ints(1, depth < 0 ? 1 : terms.length)));
+        return chosen.flatMap((t) => gen(t, range, depth));
+      }
+      case "|": {
+        // The alternatives are tried from a drawn one on, round robin (shrinking to the declared
+        // order); when the budget is spent the simplest first. One this generator cannot
+        // produce is skipped.
+        const start = tc.draw(ints(0, terms.length - 1));
+        let order = [...terms.slice(start), ...terms.slice(0, start)];
+        if (depth < 0) order = order.slice().sort((a, b) => weight(a) - weight(b));
+        let lastError = null;
+        for (const t of order) {
+          const saved = budget.nodes;
+          try {
+            return gen(t, range, depth);
+          } catch (e) {
+            if (!(e instanceof Unsupported)) throw e;
+            lastError = e;
+            budget.nodes = saved; // the failed branch does not count, but budget.calls does
+          }
+        }
+        throw lastError || new Unsupported("empty choice");
+      }
+      default: throw new Unsupported("combinator " + node.combinator);
+    }
+  }
+  return render(gen(syntax, null, 4), tc);
+}
+
+/**
+ * A value derived from `syntax` (a definition-syntax AST), `lexer` resolving its references:
+ * the pieces of one derivation joined with spaces, its commas (one drawn spelling each) elided
+ * where CSS Values 4 says so, or null when four derivations in a row met something this
+ * generator cannot spell. A composite: every choice depends on the grammar node reached and on
+ * the budget spent so far.
+ */
+export const valueFromSyntax = (lexer, syntax) =>
+  gs.composite((tc) => {
+    for (let attempt = 0; attempt < 4; attempt++) {
+      try {
+        return derive(tc, lexer, syntax);
+      } catch (e) {
+        if (!(e instanceof Unsupported)) throw e;
+      }
+    }
+    return null;
+  });
+
+// Join the pieces of a generated value, applying comma elision per parenthesis level (a comma
+// next to omitted terms, at the start or end of a list or doubled, goes).
+function render(pieces, tc) {
+  // forward: a comma right after a list start or another comma goes
+  const out = [];
+  const prev = ["start"];
+  for (const piece of pieces) {
+    if (piece === COMMA) {
+      if (prev[prev.length - 1] === "start" || prev[prev.length - 1] === "comma") continue;
+      prev[prev.length - 1] = "comma";
+      out.push(piece);
+    } else if (piece && piece.open) {
+      prev[prev.length - 1] = "item";
+      prev.push("start");
+      out.push(piece);
+    } else if (piece && piece.close) {
+      prev.pop();
+      if (prev.length === 0) prev.push("item");
+      prev[prev.length - 1] = "item";
+      out.push(piece);
+    } else {
+      prev[prev.length - 1] = "item";
+      out.push(piece);
+    }
+  }
+  // backward: a comma right before a list end goes
+  const kept = [];
+  const next = ["end"];
+  for (let i = out.length - 1; i >= 0; i--) {
+    const piece = out[i];
+    if (piece === COMMA) {
+      if (next[next.length - 1] === "end") continue;
+      next[next.length - 1] = "item";
+      kept.push(piece);
+    } else if (piece && piece.close) {
+      next[next.length - 1] = "item";
+      next.push("end");
+      kept.push(piece);
+    } else if (piece && piece.open) {
+      next.pop();
+      if (next.length === 0) next.push("item");
+      next[next.length - 1] = "item";
+      kept.push(piece);
+    } else {
+      next[next.length - 1] = "item";
+      kept.push(piece);
+    }
+  }
+  kept.reverse();
+  return kept.map((piece) => (piece === COMMA ? tc.draw(pick([",", ",", " ,"])) : piece.open || piece.close || piece)).join(" ").replace(/ ,/g, ",");
+}
+
+function weight(node) {
+  switch (node.type) {
+    case "Keyword": case "Token": case "String": case "Comma": return 0;
+    case "Type": return node.name === "length" || node.name === "number" || node.name === "percentage" || node.name === "integer" || node.name === "ident" ? 1 : 3;
+    case "Multiplier": return weight(node.term) + node.min;
+    case "Group": return 2 + node.terms.length;
+    default: return 5;
+  }
+}
+
+// ---------------------------------------------------------------- definition-syntax trees
+
+const explicitGroup = (terms, combinator = " ") => ({ type: "Group", terms, combinator, disallowEmpty: false, explicit: true });
+/** A leaf of a definition-syntax tree: a keyword, a type (with a range 30% of the time), a property reference, a function call group, a token, a quoted string, a comma or an at-keyword. */
+const grammarLeaf = gs.oneOf(
+  gs.record({ type: gs.just("Keyword"), name: pick(["auto", "none", "foo-bar", "A", "-x"]) }),
+  gs.record({ type: gs.just("Type"), name: pick(["length", "color", "foo", "length-percentage"]), opts: weighted([70, gs.just(null)], [30, gs.record({ type: gs.just("Range"), min: pick([null, 0, -1, 5]), max: pick([null, 10, 0]) })]) }),
+  gs.record({ type: gs.just("Property"), name: pick(["width", "font-size", "--x"]) }),
+  pick(["rgb", "calc", "-webkit-gradient"]).map((name) => explicitGroup([{ type: "Function", name }, { type: "Keyword", name: "x" }, { type: "Token", value: ")" }])),
+  gs.record({ type: gs.just("Token"), value: pick(["/", ":", "=", "%"]) }),
+  gs.record({ type: gs.just("String"), value: pick(["'+'", "'-'", "'['"]) }),
+  gs.record({ type: gs.just("Comma") }),
+  gs.record({ type: gs.just("AtKeyword"), name: pick(["media", "x"]) }),
+);
+const MULTIPLIERS = [
+  { comma: false, min: 0, max: 1 }, { comma: false, min: 0, max: 0 }, { comma: false, min: 1, max: 0 }, { comma: true, min: 1, max: 0 }, { comma: true, min: 0, max: 0 },
+  { comma: false, min: 2, max: 3 }, { comma: false, min: 3, max: 0 }, { comma: false, min: 3, max: 3 }, { comma: true, min: 3, max: 3 }, { comma: true, min: 2, max: 0 }, { comma: true, min: 1, max: 4 },
+];
+
+/**
+ * A definition-syntax term over `below` (the terms of the depth below; null at the innermost
+ * depth): a leaf 45% of the time, a multiplied term 19 (a comma or at-keyword under it becomes
+ * a keyword, a multiplier under it is wrapped in a group: no multipliers on those), else a
+ * group of 1-3 terms with a combinator (a nested group made explicit, so it survives
+ * generate/parse; ` ` when there is one term) and `!` 15%.
+ */
