+
+/** 0-6 characters of the encoder pool. */
+const encodeChars = (max) => gs.arrays(gs.sampledFrom(ENCODE_CHARS), { maxSize: max }).map((xs) => xs.join(""));
+property("TestHegelUrlEncodeRoundTripsAValueEndingInASpace", (tc) => checkEncoders(tc, tc.draw(encodeChars(6)) + " "), KNOWN);
+property("TestHegelEncodersRoundTripAControlCharacterBeforeNul", (tc) => {
