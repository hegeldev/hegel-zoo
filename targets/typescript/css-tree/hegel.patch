+const CONTAINER_STYLE_JUNK = ["style(--a!)", "style(--a)", "style(--a b: 1)", "style(x y)", "style()"];
+/** A container query atom; a scroll-state() query, which this css-tree does not know (Raw), 3% of the time, and a style() query with content that is not a declaration 3%. */
+const containerAtom = noKnown
+  ? weighted([97, pick(CONTAINER_ATOMS)], [3, gs.just("scroll-state(stuck: top)")])
+  : weighted([94, pick(CONTAINER_ATOMS)], [3, gs.just("scroll-state(stuck: top)")], [3, pick(CONTAINER_STYLE_JUNK)]);
+/** A container condition: a name 35% of the time, an atom (`not` before it 15%) and 0-2 more behind one of `and`/`or`. */
+export const containerCondition = cat(optText(35, cat(pick(["card", "sidebar", "my-container"]), " ")), weighted([85, containerAtom], [15, cat("not ", containerAtom)]), pick([" and ", " or "]).flatMap((op) => many(cat(op, containerAtom), 2)));
+
+// ---------------------------------------------------------------- blocks, rules, at-rules
+
+/** A block of up to `max` items from `item`: `{`, whitespace, each item with whitespace after it and a `;` (with whitespace after it) between items and, half the time, after the last, `}`. */
+const declarationBlockOf = (item, max) =>
+  gs.record({ open: ows, items: gs.arrays(gs.record({ item, before: ows, after: ows }), { maxSize: max }), trailing: chance(50) }).map(({ open, items, trailing }) => {
+    let s = "{" + open;
+    items.forEach(({ item: text, before, after }, i) => {
+      s += text + before;
+      if (i < items.length - 1 || trailing) s += ";" + after;
+    });
+    return s + "}";
+  });
+
+// The block of a conditional group rule at the top level: 0-3 rules and at-rules, each with
+// whitespace after it (no declarations: css-tree parses them as broken rules, Raw; soup covers that).
+const ruleBlockOf = (item) => cat("{", ows, many(cat(item, ows), 3), "}");
+
+// A style rule nested in a declaration block: its selectors start with the nesting selector, or,
+// 15% of the time, are any selector (KNOWN: css-tree parses a nested rule whose first selector
+// does not start with `&` as a Raw node, css-tree/12; under HEGEL_NO_KNOWN=1 every selector
+// starts with `&`).
+const nestingSelector = cat("&", pick(["", " ", ".x", ":hover", " > .y", " + b", "[a]", " &", " .x &", "::before"]));
+const relaxedSelector = selector.filter((s) => !s.startsWith("&"));
+const nestedSelector = noKnown ? nestingSelector : weighted([85, nestingSelector], [15, relaxedSelector]);
+const nestedRuleOf = (declarationBlock) => cat(nestedSelector, many(cat(pick([", ", ","]), nestedSelector), 1), ows, declarationBlock);
+
+const LAYER_NAMES = [" a", " a, b", " a.b", " a.b, c", "", " A"];
+const IMPORT_TAILS = ["", " layer", " layer(a.b)", " supports(display: grid)", " supports(selector(a))", " screen and (min-width: 1px)", " layer(x) supports(--y: 1) print", ""];
+const KEYFRAME_SELECTORS = ["from", "to", "50%", "0%, 100%", "FROM", "33.3%", "0%,50%,100%"];
+const PROPERTY_DESCRIPTORS = ["syntax: '<length>'; inherits: false; initial-value: 0px;", " syntax : \"*\" ; inherits : true ", ""];
+
+/**
+ * An at-rule at nesting depth `depth`, whose group block is `block` (a declaration block when
+ * `nested` in a style rule, else a rule block) and whose innermost declaration block is
+ * `declarations`: a charset, namespace, import or layer statement, @media (twice as often),
+ * @supports, @container, @scope, @starting-style, @font-face, @keyframes, @page, @property,
+ * @counter-style, @font-feature-values, @nest, @-moz-document, or an unknown at-rule; the name
+ * upper-case 10% of the time. @layer is a statement half the time, else a block (KNOWN: a
+ * nested @layer's block is not parsed as a style block, css-tree/13, so under HEGEL_NO_KNOWN=1
+ * a nested @layer is always a statement).
+ */
+function atruleOf(depth, nested, block, declarations) {
+  const at = (name) => chance(10).map((upper) => "@" + (upper ? name.toUpperCase() : name));
+  return weighted(
+    [1, cat(at("charset"), pick([' "utf-8"', ' "UTF-8"', ' "iso-8859-1"']), ";")],
+    [1, cat(at("namespace"), ws, pick(["", "svg ", "ns\t"]), pick(['"http://x"', "url(http://x)"]), ows, ";")],
+    [1, cat(at("import"), ws, pick(['"a.css"', "url(a.css)", "url('a.css')", "URL(x)"]), pick(IMPORT_TAILS), ows, ";")],
+    [1, cat(at("layer"), pick(LAYER_NAMES), ows, nested && noKnown ? gs.just(";") : weighted([50, gs.just(";")], [50, block]))],
+    [2, cat(at("media"), ws, optText(90, mediaQueryList), ows, weighted([92, block], [8, gs.just(";")]))],
+    [1, cat(at("supports"), ws, supportsCondition, ows, block)],
+    [1, cat(at("container"), ws, containerCondition, ows, block)],
+    [1, cat(at("scope"), pick([" (.a)", " (.a) to (.b)", "", " to (.b)"]), ows, block)],
+    [1, cat(at("starting-style"), ows, block)],
+    [1, cat(at("font-face"), ows, declarations)],
+    [1, cat(weighted([70, at("keyframes")], [30, gs.just("@-webkit-keyframes")]), ws, pick(["k", "slide-in", '"quoted"', "-webkit-x"]), ows, "{", ows, many(cat(pick(KEYFRAME_SELECTORS), ows, declarations, ows), 3), "}")],
+    [1, cat(at("page"), pick(["", " :first", " :left", " named", " named:first", ":blank"]), ows, "{", ows, optText(60, cat(declaration, ";")), optText(50, cat("@top-left", ows, declarations)), ows, "}")],
+    [1, cat(at("property"), ws, customIdent, ows, "{", pick(PROPERTY_DESCRIPTORS), "}")],
+    [1, cat(at("counter-style"), ws, ident, ows, declarations)],
+    [1, cat(at("font-feature-values"), " Font One", ows, "{", ows, optText(60, "@swash { x: 1; y: 2 }"), ows, "}")],
+    [1, cat(at("nest"), ws, selectorList, ows, declarations)],
+    [1, cat("@-moz-document url-prefix()", ows, block)],
+    [1, cat(at("unknown"), pick(["-x", "foo", "--y"]), pick(["", " bar baz", " 1 2", " (a b)", ' "s"', " url(x)"]), ows, weighted([50, gs.just(";")], [25, declarations], [25, block]))],
+  );
+}
+
+/**
+ * The block-level generators by nesting depth. A declaration block at depth 0 holds
+ * declarations only; above it, a declaration 72% of the time, a comment 10, a nested rule 10
+ * and a nested at-rule 8 (whose block is a style block), all of the depth below. A rule block at
+ * depth 0 holds rules; above it, a rule of the depth below 65%, an at-rule 20 and a comment 15.
+ */
+const levels = [];
+for (let depth = 0; depth <= 2; depth++) {
+  const below = depth === 0 ? null : levels[depth - 1];
+  const declarationItem = below === null ? declaration : weighted([72, declaration], [10, comment], [10, below.nestedRule], [8, below.nestedAtrule]);
+  const declarationBlock = declarationBlockOf(declarationItem, 4);
+  const rule = cat(selectorList, ows, declarationBlock);
+  const ruleItem = below === null ? rule : weighted([65, below.rule], [20, below.atrule], [15, comment]);
+  const ruleBlock = ruleBlockOf(ruleItem);
+  const declarations = depth === 0 ? declarationBlock : levels[0].declarationBlock;
+  levels.push({
+    declarationBlock,
+    rule,
+    nestedRule: nestedRuleOf(declarationBlock),
+    atrule: atruleOf(depth, false, ruleBlock, declarations),
+    nestedAtrule: atruleOf(depth, true, declarationBlock, declarations),
+  });
+}
+
+/** A rule, blocks nested two deep. */
+export const rule = levels[2].rule;
+/** An at-rule at the top level, blocks nested two deep. */
+export const atrule = levels[2].atrule;
+
+/** A stylesheet item: a rule 57% of the time, an at-rule 30, a comment 8, a CDO or CDC token 5. No stray `;` (a top-level ; starts a Raw qualified rule; soup covers it) and no stray BOM: css-tree drops one at offset 0 only, so generate/parse would not be a fixpoint. */
+const stylesheetItem = weighted([57, rule], [30, atrule], [8, comment], [5, pick(["<!--", "-->"])]);
+/** A stylesheet: leading whitespace 30% of the time, then 0-5 items each with whitespace after it. */
+export const stylesheet = cat(optText(30, ws), many(cat(stylesheetItem, ows), 5));
+
+// ---------------------------------------------------------------- token soup
+
+// (KNOWN: a NUL, which css-tree does not replace by U+FFFD, css-tree/4, and an escaped `url(`
+// name, which it tokenizes as a function, css-tree/15; neither under HEGEL_NO_KNOWN=1)
+const KNOWN_SOUP = noKnown ? [] : ["\x00", "\\url("];
+// A backslash first: alone it is the smallest recorded shape (css-tree/2), so a tokenizer failure in soup shrinks to it.
+const SOUP = ["\\", "a", "b", "z", "A", "Z", "0", "1", "9", "-", "-", "_", "+", ".", ",", ":", ";", "!", "?", "*", "/", "/", "\\", "'", '"', '"', "(", ")", "[", "]", "{", "}", "<", ">",
+  "@", "#", "%", "&", "|", "~", "^", "=", "$", " ", " ", "\n", "\r", "\f", "\t", "\u{fc}", "\u{65e5}", "\u{1f600}", ...KNOWN_SOUP, "\x7f", "\x80", "\u{feff}", "e", "E", "n", "u", "U",
+  "/*", "*/", "url(", "url( ", "<!--", "-->", "U+", "u+", "\\61 ", "\\1F600", "1e", "1e-", "!important", "important", "px", "%", "1.", ".5", "@media", "#x", "--x", "-->", "\r\n", "\\\n"].filter((c) => !/[\x80-\xb6]/.test(c));
+/** 0-24 pieces of CSS-flavoured soup. */
+export const soup = many(pick(SOUP), 24);
+
+/** A mix of the structured CSS and soup, for parser robustness: a stylesheet half the time, soup a quarter, else a stylesheet with soup spliced in at a code point position taken modulo its length (between code points, so no surrogate pair is cut in half: CSS input is a sequence of code points). */
+export const anyCss = weighted(
+  [50, stylesheet],
+  [25, soup],
+  [25, gs.record({ sheet: stylesheet, at: ints(0, 999), splice: soup }).map(({ sheet, at, splice }) => {
+    const points = [...sheet];
+    const i = at % (points.length + 1);
+    return points.slice(0, i).join("") + splice + points.slice(i).join("");
+  })],
+);
+
+// ---------------------------------------------------------------- values from css-tree's value definition syntax
+
+export class Unsupported extends Error {}
+// Thrown when the search for a producible derivation runs too long; an Unsupported so callers skip.
+export class TooManyCalls extends Unsupported {}
+
+const SAFE_IDENTS = ["foo", "my-ident", "Bar", "_x", "z9", "\u{fc}", "a\\31 b"]; // a hex escape eats one following space, so it cannot end an ident
+const HEX_DIGITS = "0123456789abcdefABCDEF".split("");
+
+// What the value parser accepts between components: the tokens css-tree reads as operators or
+// groups. A grammar node spelling any other token (`:` of a pseudo-class, `<` of a range feature,
+// `|` of a namespace, `{` of a block, an at-keyword) cannot be part of a value.
+const VALUE_TOKENS = new Set(["/", "*", ",", "+", "-", "(", ")", "[", "]"]);
+const NON_VALUE_GENERICS = new Set(["colon-token", "at-keyword-token", "CDO-token", "CDC-token"]);
+const IDENT_LIKE = /^-{0,2}[a-zA-Z_][\w-]*$/;
+const isValueText = (text) => VALUE_TOKENS.has(text) || IDENT_LIKE.test(text);
+
+const valueGrammars = new Map();
+/**
+ * Whether `syntax` can spell a value the value parser accepts at all: a `|` group needs one such
+ * alternative, any other group every term, a multiplier from zero nothing; a token must be one
+ * of the value operators or brackets, a keyword or quoted string ident-like or such an operator,
+ * and an at-keyword or a colon/at-keyword/CDO/CDC token type never is. Types and properties are
+ * followed through `lexer`, a reference met again while it is being decided counted as fine.
+ */
+export function isValueGrammar(lexer, syntax) {
+  const ok = (node) => {
+    switch (node.type) {
+      case "Group": return node.combinator === "|" ? node.terms.some(ok) : node.terms.every(ok);
+      case "Multiplier": return node.min === 0 || ok(node.term);
+      case "Keyword": return IDENT_LIKE.test(node.name);
+      case "Comma": case "Function": return true;
+      case "Token": return VALUE_TOKENS.has(node.value);
+      case "String": return isValueText(node.value.replace(/^'(.*)'$/, "$1"));
+      case "AtKeyword": return false;
+      case "Type": {
+        const ref = lexer.getType(node.name);
+        if (!ref) return false;
+        if (!ref.syntax) return !NON_VALUE_GENERICS.has(node.name);
+        return named("t:" + node.name, ref.syntax);
+      }
+      case "Property": {
+        const ref = lexer.getProperty(node.name);
+        return ref && ref.syntax ? named("p:" + node.name, ref.syntax) : false;
+      }
+      default: return false;
+    }
+  };
+  const named = (key, s) => {
+    if (valueGrammars.has(key)) return valueGrammars.get(key);
+    valueGrammars.set(key, true);
+    const result = ok(s);
+    valueGrammars.set(key, result);
+    return result;
+  };
+  return ok(syntax);
+}
+
+/**
+ * The text of a number in `range` (a definition-syntax Range, or null for -5..20): an integer
+ * (with a `+` sign 10% of the time) half the time or always with `integer`, else one of the
+ * five quarter points of the range to two decimals, a leading `0.` dropped 15% of the time and
+ * a whole number written with `e0` 10%. A dimension bound keeps the range non-negative.
+ */
+function numberIn(range, { integer = false } = {}) {
+  let lo = -5;
+  let hi = 20;
+  if (range && range.type === "Range") {
+    if (typeof range.min === "number") lo = range.min;
+    else if (range.min !== null) lo = 0; // a dimension bound: stay non-negative
+    if (typeof range.max === "number") hi = range.max;
+    else if (range.max !== null) hi = Math.max(lo, 5);
+  }
+  if (hi < lo) throw new Unsupported("empty range");
+  const whole = Math.ceil(lo) <= Math.floor(hi)
+    ? gs.record({ v: ints(Math.ceil(lo), Math.floor(hi)), plus: chance(10) }).map(({ v, plus }) => (plus && v >= 0 ? "+" + v : String(v)))
+    : null;
+  if (integer) {
+    if (whole === null) throw new Unsupported("no integer in range");
+    return whole;
+  }
+  const fraction = gs.record({ quarter: ints(0, 4), dropZero: chance(15), exponent: chance(10) }).map(({ quarter, dropZero, exponent }) => {
+    const v = lo + ((hi - lo) * quarter) / 4;
+    let s = String(Math.round(v * 100) / 100);
+    if (dropZero && Math.abs(v) < 1 && v !== 0) s = s.replace(/^(-?)0\./, "$1.");
+    if (exponent && Number.isInteger(v) && v !== 0) s = v + "e0";
+    return s;
+  });
+  return whole === null ? fraction : weighted([50, whole], [50, fraction]);
+}
+
+/** A generator for the generic type `name` (one the lexer has no grammar for) in `range`; throws Unsupported for one this generator cannot spell. */
+function generic(name, range) {
+  const unit = (kind) => pick(UNITS[kind]);
+  switch (name) {
+    case "length": {
+      const zeroFits = (!range || range.min === null || range.min <= 0) && (!range || range.max === null || range.max >= 0);
+      const length = cat(numberIn(range), unit("length"));
+      return zeroFits ? weighted([10, gs.just("0")], [90, length]) : length;
+    }
+    case "angle": case "time": case "frequency": case "resolution": case "flex": case "decibel": case "semitones":
+      return cat(numberIn(range), unit(name));
+    case "dimension": return cat(numberIn(range), pick(ALL_UNITS));
+    case "percentage": return cat(numberIn(range), "%");
+    case "number": return numberIn(range);
+    case "integer": return numberIn(range, { integer: true });
+    case "zero": return gs.just("0");
+    case "string": return pick(['"s"', "'t'", '""', '"a b"', '"\\61"']);
+    case "ident": return pick(SAFE_IDENTS);
+    case "custom-ident": return pick(SAFE_IDENTS);
+    case "dashed-ident": case "custom-property-name": return pick(["--x", "--my-var", "--0"]);
+    case "hex-color": return gs.tuples(pick(HEX_DIGITS), pick([3, 4, 6, 8])).map(([digit, k]) => "#" + digit.repeat(k));
+    case "id-selector": return cat("#", pick(SAFE_IDENTS));
+    case "an-plus-b": return pick(["odd", "even", "2n+1", "-n+3", "3n", "n", "+n-2", "5", "2n + 1", "-2n - 1", "0n+0"]);
+    case "urange": return pick(["U+26", "U+0-7F", "U+4??", "u+1f600-1f64f", "U+???", "U+0025-00FF"]);
+    case "declaration-value": case "any-value": return pick(["a", "1px solid red", "a b c", "f(1)", "[x]", '"s"', "1"]);
+    case "attr-unit": return pick(["px", "em", "%", "deg", "s"]);
+    case "ident-token": return pick(SAFE_IDENTS);
+    case "hash-token": return cat("#", pick(SAFE_IDENTS));
+    case "string-token": return gs.just('"s"');
+    case "url-token": return gs.just("url(x)");
+    case "number-token": return numberIn(null);
+    case "percentage-token": return cat(numberIn(null), "%");
+    case "dimension-token": return cat(numberIn(null), "px");
+    case "whitespace-token": return gs.just(" ");
