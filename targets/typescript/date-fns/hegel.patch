+  const e0 = M.dayOf(end);
+  const noMidnight = M.midnight(s0).getHours() !== 0 ? "known date-fns/10 (no midnight)" : undefined;
+  const offsetsDiffer = start.getTimezoneOffset() !== end.getTimezoneOffset() ? "known date-fns/13 (offsets differ)" : undefined;
+  if (e0 - s0 <= 60) {
+    const days = [];
+    for (let k = s0; k <= e0; k++) {
+      const m = M.midnight(k);
+      if (M.dayOf(m) === k) days.push(m); // a whole day skipped by the zone (Pacific/Apia, 30 December 2011) has no midnight of its own
+    }
+    // a midnight that occurs twice (Newfoundland's fall-back at 00:01) makes the day's start chronologically earlier than the end of the previous day
+    const ambiguousMidnight = [...days, M.midnight(e0 + 1)].some(ambiguousWall) ? "skipped: ambiguous midnight" : undefined;
+    list("eachDayOfInterval", F.eachDayOfInterval({ start, end }), days, ambiguousMidnight);
+    list("eachDayOfInterval reversed", F.eachDayOfInterval({ start: end, end: start }), days.slice().reverse(), ambiguousMidnight);
+    const step = n(tc, 2, 5);
