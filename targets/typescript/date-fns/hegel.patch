+// Hegel zoo: a model of the proleptic Gregorian calendar in the process's local time zone, the
+// oracle for date-fns. Everything is computed from a Date's local fields (getFullYear ...
+// getMilliseconds) with day arithmetic done in UTC, where every day is 86400000 ms, and turned
+// back into an instant with `local(...)`, which is the one place JavaScript's own rule for
+// non-existent and ambiguous wall-clock times applies. So the model knows nothing about time
+// zone rules and still gives exact answers in any zone: a "day" is a calendar day, a month is a
+// month, and where the wall clock jumps the model and the library face the same JS Date.
+//
+// Definitions followed: ISO 8601 for week dates (weeks start on Monday, week 1 holds January 4);
+// date-fns's documented `weekStartsOn` / `firstWeekContainsDate` generalization for local weeks
+// (week 1 is the week that contains January `firstWeekContainsDate`); Unicode TR35 for the
+// format tokens (with date-fns's documented additions); ISO 8601 / RFC 3339 for the ISO formats.
+
+const MS_DAY = 86400000;
+
+// ---------------------------------------------------------------------------------------------
+// Instants and fields
+
+/** The local fields of an instant. */
+export function fields(d) {
+  return { y: d.getFullYear(), mo: d.getMonth(), d: d.getDate(), h: d.getHours(), mi: d.getMinutes(), s: d.getSeconds(), ms: d.getMilliseconds(), wd: d.getDay() };
+}
+
+/** The instant of a local wall-clock time (JavaScript's rule where the time does not exist or exists twice). Any year, including 0-99 and negative. */
+export function local(y, mo = 0, d = 1, h = 0, mi = 0, s = 0, ms = 0) {
+  const r = new Date(0);
+  r.setFullYear(y, mo, d);
+  r.setHours(h, mi, s, ms);
+  return r;
+}
+
+/** A UTC instant from fields, any year. */
+export function utc(y, mo = 0, d = 1, h = 0, mi = 0, s = 0, ms = 0) {
+  const r = new Date(0);
+  r.setUTCFullYear(y, mo, d);
+  r.setUTCHours(h, mi, s, ms);
+  return r;
+}
+
+/** The civil day number (days since 1970-01-01) of a calendar date; the date may be out of range (month 13, day 0) and is normalized. */
+export function civil(y, mo, d) {
+  return Math.round(utc(y, mo, d) / MS_DAY);
+}
+
+/** The calendar date of a civil day number. */
+export function fromCivil(n) {
+  const u = new Date(n * MS_DAY);
+  return { y: u.getUTCFullYear(), mo: u.getUTCMonth(), d: u.getUTCDate(), wd: u.getUTCDay() };
+}
+
+export const isLeap = (y) => y % 400 === 0 || (y % 4 === 0 && y % 100 !== 0);
+export const daysInMonth = (y, mo) => civil(y, mo + 1, 1) - civil(y, mo, 1);
+export const daysInYear = (y) => (isLeap(y) ? 366 : 365);
+
+/** The civil day of the date's local calendar day. */
+export const dayOf = (d) => civil(d.getFullYear(), d.getMonth(), d.getDate());
+/** Milliseconds since the local midnight of the date's calendar day, by wall clock (not by instant). */
+export const wall = (d) => ((d.getHours() * 60 + d.getMinutes()) * 60 + d.getSeconds()) * 1000 + d.getMilliseconds();
+
+/** The local midnight starting civil day n. */
+export function midnight(n) {
+  const c = fromCivil(n);
+  return local(c.y, c.mo, c.d);
+}
+
+/**
+ * The instant with the given local fields, resolving an ambiguous wall time (the repeated hour
+ * after a DST fall-back) to the occurrence with the same UTC offset as `ref` when there is one,
+ * and otherwise like `local` (the first occurrence).
+ */
+export function near(ref, y, mo = 0, d = 1, h = 0, mi = 0, s = 0, ms = 0) {
+  const t = local(y, mo, d, h, mi, s, ms);
+  const o1 = t.getTimezoneOffset();
+  const o2 = ref.getTimezoneOffset();
+  if (o1 !== o2) {
+    const t2 = new Date(+t + (o2 - o1) * 60000);
+    if (t2.getFullYear() === t.getFullYear() && t2.getMonth() === t.getMonth() && t2.getDate() === t.getDate() && t2.getHours() === t.getHours() && t2.getMinutes() === t.getMinutes() && t2.getSeconds() === t.getSeconds() && t2.getMilliseconds() === t.getMilliseconds()) return t2;
+  }
+  return t;
+}
+
+/** The local wall time of `d` moved to civil day n (same wall clock, same offset when ambiguous). */
+export function onDay(d, n) {
+  const c = fromCivil(n);
+  return near(d, c.y, c.mo, c.d, d.getHours(), d.getMinutes(), d.getSeconds(), d.getMilliseconds());
+}
+
+// ---------------------------------------------------------------------------------------------
+// Weeks
+
+/** Civil day of the start of the week (starting on weekday `wso`) that contains civil day n. */
+export function startOfWeekCivil(n, wso = 0) {
+  const wd = fromCivil(n).wd;
+  return n - ((wd - wso + 7) % 7);
+}
+
+/** Civil day of the first day of week 1 of week-year Y (the week containing January `fwcd`). */
+export function startOfWeekYearCivil(Y, wso, fwcd) {
+  return startOfWeekCivil(civil(Y, 0, fwcd), wso);
+}
+
+/** The local week-numbering year of civil day n. */
+export function weekYear(n, wso = 0, fwcd = 1) {
+  const y = fromCivil(n).y;
+  if (n >= startOfWeekYearCivil(y + 1, wso, fwcd)) return y + 1;
+  if (n >= startOfWeekYearCivil(y, wso, fwcd)) return y;
+  return y - 1;
+}
+
+/** The local week number of civil day n. */
+export function week(n, wso = 0, fwcd = 1) {
+  const Y = weekYear(n, wso, fwcd);
+  return (startOfWeekCivil(n, wso) - startOfWeekYearCivil(Y, wso, fwcd)) / 7 + 1;
+}
+
+/** Number of weeks in week-year Y. */
+export function weeksInYear(Y, wso = 0, fwcd = 1) {
+  return (startOfWeekYearCivil(Y + 1, wso, fwcd) - startOfWeekYearCivil(Y, wso, fwcd)) / 7;
+}
+
+export const isoWeekYear = (n) => weekYear(n, 1, 4);
+export const isoWeek = (n) => week(n, 1, 4);
+export const isoWeeksInYear = (Y) => weeksInYear(Y, 1, 4);
+/** ISO weekday 1 (Monday) .. 7 (Sunday). */
+export const isoDay = (wd) => (wd === 0 ? 7 : wd);
+
+// ---------------------------------------------------------------------------------------------
+// Arithmetic
+
+/** Add n calendar months keeping the day of month, clamped to the target month's length, and the wall time. */
+export function addMonths(d, n) {
+  const f = fields(d);
+  const total = f.y * 12 + f.mo + n;
+  const y = Math.floor(total / 12);
+  const mo = total - y * 12;
+  return local(y, mo, Math.min(f.d, daysInMonth(y, mo)), f.h, f.mi, f.s, f.ms);
+}
+
+/** Add n calendar days keeping the wall time. */
+export function addDays(d, n) {
+  return onDay(d, dayOf(d) + n);
+}
+
+/** Difference in calendar days between the local dates of a and b. */
+export const calendarDays = (a, b) => dayOf(a) - dayOf(b);
+export const calendarMonths = (a, b) => (a.getFullYear() - b.getFullYear()) * 12 + a.getMonth() - b.getMonth();
+export const calendarYears = (a, b) => a.getFullYear() - b.getFullYear();
+export const quarter = (d) => Math.floor(d.getMonth() / 3) + 1;
+export const calendarQuarters = (a, b) => (a.getFullYear() - b.getFullYear()) * 4 + quarter(a) - quarter(b);
+export const calendarWeeks = (a, b, wso = 0) => (startOfWeekCivil(dayOf(a), wso) - startOfWeekCivil(dayOf(b), wso)) / 7;
+
+/**
+ * Full days from b to a, by the calendar as date-fns documents it: the calendar days between
+ * them, less one when a's wall clock, moved onto b's day (a time skipped by DST resolving
+ * forward), is on the wrong side of b's wall clock. Zero when they share a day.
+ */
+export function fullDays(a, b) {
+  const cd = calendarDays(a, b);
+  if (cd === 0) return 0;
+  const sign = Math.sign(cd);
+  const shifted = onDay(a, dayOf(b));
+  const notFull = Math.sign(wall(shifted) - wall(b)) === -sign ? 1 : 0;
+  return cd - sign * notFull;
+}
+
+/** Full months from b to a: the largest n with addMonths(b, n) <= a. */
+export function fullMonths(a, b) {
+  if (+a < +b) return -fullMonths(b, a);
+  let n = calendarMonths(a, b);
+  while (n > 0 && +addMonths(b, n) > +a) n--;
+  return n;
+}
+
+export function fullYears(a, b) {
+  if (+a < +b) return -fullYears(b, a);
+  let n = calendarYears(a, b);
+  while (n > 0 && +addMonths(b, 12 * n) > +a) n--;
+  return n;
+}
+
+/** Whole units of an instant difference, truncated toward zero. */
+export const fullUnits = (a, b, unit) => Math.trunc((+a - +b) / unit);
+
+// ---------------------------------------------------------------------------------------------
+// Format tokens (Unicode TR35 as date-fns documents them, en-US)
+
+const MONTHS = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
+const DAYS = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
+const pad = (n, w) => {
+  const s = String(Math.abs(n));
+  return (n < 0 ? "-" : "") + (s.length >= w ? s : "0".repeat(w - s.length) + s);
+};
+export function ordinal(n) {
+  const r = n % 100;
+  if (r > 20 || r < 10) {
+    switch (r % 10) {
+      case 1:
+        return n + "st";
+      case 2:
+        return n + "nd";
+      case 3:
+        return n + "rd";
+    }
+  }
+  return n + "th";
+}
+function offsetString(d, style) {
+  const off = -d.getTimezoneOffset(); // minutes east of UTC
+  const sign = off < 0 ? "-" : "+";
+  const a = Math.abs(off);
+  const hh = pad(Math.trunc(a / 60), 2);
+  const mm = pad(a % 60, 2);
+  switch (style) {
+    case "X":
+      return off === 0 ? "Z" : a % 60 === 0 ? sign + hh : sign + hh + mm;
+    case "XX":
+      return off === 0 ? "Z" : sign + hh + mm;
+    case "XXX":
+      return off === 0 ? "Z" : sign + hh + ":" + mm;
+    case "x":
+      return a % 60 === 0 ? sign + hh : sign + hh + mm;
+    case "xx":
+      return sign + hh + mm;
+    case "xxx":
+      return sign + hh + ":" + mm;
+    case "O":
+      return "GMT" + sign + Math.trunc(a / 60) + (a % 60 === 0 ? "" : ":" + mm);
+    case "OOOO":
+      return "GMT" + sign + hh + ":" + mm;
+  }
+}
+
+/**
+ * The expected output of `format(d, token)` for one token. Tokens covered: G y Y R u Q q M L w I
+ * d D E i e c a b h H K k m s S X x O t T (every length date-fns lists), with `o` ordinals.
+ * Options: weekStartsOn, firstWeekContainsDate.
+ */
+export function formatToken(d, token, opts = {}) {
+  const wso = opts.weekStartsOn ?? 0;
+  const fwcd = opts.firstWeekContainsDate ?? 1;
+  const f = fields(d);
+  const n = dayOf(d);
+  const c = token[0];
+  const len = token.length;
+  const ord = token.endsWith("o") && len === 2;
+  const era = f.y > 0 ? 1 : 0;
+  const eraYear = f.y > 0 ? f.y : 1 - f.y; // 1 BC is year 0
+  const dayName = (l, wd) => (l <= 3 ? DAYS[wd].slice(0, 3) : l === 4 ? DAYS[wd] : l === 5 ? DAYS[wd][0] : DAYS[wd].slice(0, 2));
+  const monthName = (l, mo) => (l === 3 ? MONTHS[mo].slice(0, 3) : l === 4 ? MONTHS[mo] : MONTHS[mo][0]);
+  const localDay = ((f.wd - wso + 7) % 7) + 1; // 1..7 with the week's first day as 1
+  const wy = weekYear(n, wso, fwcd);
+  const eraWy = wy > 0 ? wy : 1 - wy;
+  switch (c) {
+    case "G":
+      return len === 5 ? (era ? "A" : "B") : len === 4 ? (era ? "Anno Domini" : "Before Christ") : era ? "AD" : "BC";
+    case "y":
+      if (ord) return ordinal(eraYear);
+      if (len === 2) return pad(eraYear % 100, 2);
+      return pad(eraYear, len);
+    case "Y":
+      if (ord) return ordinal(eraWy);
+      if (len === 2) return pad(eraWy % 100, 2);
+      return pad(eraWy, len);
+    case "R":
+      return pad(isoWeekYear(n), len);
+    case "u":
+      return pad(f.y, len);
+    case "Q":
+    case "q": {
+      const q = quarter(d);
+      if (ord) return ordinal(q);
+      if (len === 1) return String(q);
+      if (len === 2) return pad(q, 2);
+      if (len === 3) return "Q" + q;
+      if (len === 4) return ordinal(q) + " quarter";
+      return String(q);
+    }
+    case "M":
+    case "L":
+      if (ord) return ordinal(f.mo + 1);
+      if (len === 1) return String(f.mo + 1);
+      if (len === 2) return pad(f.mo + 1, 2);
+      return monthName(len, f.mo);
+    case "w": {
+      const w = week(n, wso, fwcd);
+      return ord ? ordinal(w) : pad(w, len);
+    }
+    case "I": {
+      const w = isoWeek(n);
+      return ord ? ordinal(w) : pad(w, len);
+    }
+    case "d":
+      return ord ? ordinal(f.d) : pad(f.d, len);
+    case "D": {
+      const doy = n - civil(f.y, 0, 1) + 1;
+      return ord ? ordinal(doy) : pad(doy, len);
+    }
+    case "E":
+      return dayName(len, f.wd);
+    case "i": {
+      const id = isoDay(f.wd);
+      if (ord) return ordinal(id);
+      if (len === 1) return String(id);
+      if (len === 2) return pad(id, 2);
+      return dayName(len, f.wd); // iii=abbr, iiii=wide, iiiii=narrow, iiiiii=short
+    }
+    case "e":
+    case "c":
+      if (ord) return ordinal(localDay);
+      if (len === 1) return String(localDay);
+      if (len === 2) return pad(localDay, 2);
+      return dayName(len, f.wd); // eee=abbr, eeee=wide, eeeee=narrow, eeeeee=short
+    case "a": {
+      const pm = f.h >= 12;
+      if (len <= 2) return pm ? "PM" : "AM";
+      if (len === 3) return pm ? "pm" : "am";
+      if (len === 4) return pm ? "p.m." : "a.m.";
+      return pm ? "p" : "a";
+    }
+    case "b": {
+      const which = f.h === 12 ? "noon" : f.h === 0 ? "midnight" : f.h >= 12 ? "pm" : "am"; // by the hour alone (the whole hour 12 is "noon")
+      const table = {
+        noon: ["noon", "noon", "noon", "n"],
+        midnight: ["midnight", "midnight", "midnight", "mi"],
+        am: ["AM", "am", "a.m.", "a"],
+        pm: ["PM", "pm", "p.m.", "p"],
+      }[which];
+      return len <= 2 ? table[0] : len === 3 ? table[1] : len === 4 ? table[2] : table[3];
+    }
+    case "h": {
+      const h = f.h % 12 === 0 ? 12 : f.h % 12;
+      return ord ? ordinal(h) : pad(h, len);
+    }
+    case "H":
+      return ord ? ordinal(f.h) : pad(f.h, len);
+    case "K":
+      return ord ? ordinal(f.h % 12) : pad(f.h % 12, len);
+    case "k": {
+      const k = f.h === 0 ? 24 : f.h;
+      return ord ? ordinal(k) : pad(k, len);
+    }
+    case "m":
+      return ord ? ordinal(f.mi) : pad(f.mi, len);
+    case "s":
+      return ord ? ordinal(f.s) : pad(f.s, len);
+    case "S": {
+      // the fraction of the second to `len` digits: truncated, zero-padded on the right
+      return String(Math.trunc(f.ms * Math.pow(10, len - 3))).padStart(len, "0");
+    }
+    case "X":
+      return offsetString(d, len === 1 ? "X" : len === 2 || len === 4 ? "XX" : "XXX");
+    case "x":
+      return offsetString(d, len === 1 ? "x" : len === 2 || len === 4 ? "xx" : "xxx");
+    case "O":
+    case "z":
+      return offsetString(d, len <= 3 ? "O" : "OOOO");
+    case "t":
+      return pad(Math.trunc(+d / 1000), len);
+    case "T":
+      return pad(+d, len);
+  }
+  throw new Error(`no model for token ${token}`);
+}
+
+// ---------------------------------------------------------------------------------------------
+// ISO 8601 / RFC 3339 renderings
+
+export function isoOffset(d) {
+  const off = -d.getTimezoneOffset();
+  if (off === 0) return "Z";
+  const a = Math.abs(off);
+  return (off < 0 ? "-" : "+") + pad(Math.trunc(a / 60), 2) + ":" + pad(a % 60, 2);
+}
+
+/** ISO 8601 extended date-time with offset, calendar years 0-9999 only. */
+export function isoString(d) {
+  const f = fields(d);
+  return `${pad(f.y, 4)}-${pad(f.mo + 1, 2)}-${pad(f.d, 2)}T${pad(f.h, 2)}:${pad(f.mi, 2)}:${pad(f.s, 2)}${isoOffset(d)}`;
+}
+
+export function rfc7231(d) {
+  const days = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
+  return `${days[d.getUTCDay()]}, ${pad(d.getUTCDate(), 2)} ${MONTHS[d.getUTCMonth()].slice(0, 3)} ${pad(d.getUTCFullYear(), 4)} ${pad(d.getUTCHours(), 2)}:${pad(d.getUTCMinutes(), 2)}:${pad(d.getUTCSeconds(), 2)} GMT`;
+}
+
+/**
+ * The instant denoted by an ISO 8601 date/time string in the profile parseISO documents (calendar,
+ * ordinal and week dates, basic or extended, expanded years with a sign and 4 + `additionalDigits`
+ * digits, times to seconds with a decimal fraction on the last field, offsets Z / +hh / +hh:mm /
+ * +hhmm), or null when the string is not one. A string without an offset is local time.
+ */
+export function parseIso(str, additionalDigits = 2) {
+  // year: 4 digits, or a sign and exactly 4 + additionalDigits digits
+  const re = new RegExp(`^(\\d{4}|[+-]\\d{${4 + additionalDigits}})(?:-?(\\d{2})(?:-?(\\d{2}))?|-?(\\d{3})|-?W(\\d{2})(?:-?(\\d))?)?(?:[T ](\\d{2})(?:(:?)(\\d{2})(?:\\8(\\d{2}))?)?([.,]\\d+)?(Z|[+-]\\d{2}(?::?\\d{2})?)?)?$`, "i");
+  const m = re.exec(str);
+  if (!m) return null;
+  const [, ys, mm, dd, ddd, ww, wdd, hh, , mi, ss, frac, zone] = m;
+  const y = Number(ys);
+  let day;
+  if (mm !== undefined) {
+    const mo = Number(mm) - 1;
+    if (mo < 0 || mo > 11) return null;
+    const d = dd === undefined ? 1 : Number(dd);
+    if (d < 1 || d > daysInMonth(y, mo)) return null;
+    day = civil(y, mo, d);
+  } else if (ddd !== undefined) {
