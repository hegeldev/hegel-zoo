+pin("TestHegelPinParseIsoKeepsTheMilliseconds", () => {
+  setUTC();
+  assert.equal(F.parseISO("1970-01-01T00:00:01.023Z").toISOString(), "1970-01-01T00:00:01.023Z");
+  assert.equal(F.parseISO("1969-12-31T23:59:59.1234Z").toISOString(), "1969-12-31T23:59:59.123Z", "fractions before 1970 round up");
+});
