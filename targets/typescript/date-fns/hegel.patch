+    if (n < 1 || n > daysInYear(y)) return null;
+    day = civil(y, 0, 1) + n - 1;
+  } else if (ww !== undefined) {
+    const w = Number(ww);
+    const wd = wdd === undefined ? 1 : Number(wdd);
+    if (w < 1 || w > isoWeeksInYear(y) || wd < 1 || wd > 7) return null;
+    day = startOfWeekYearCivil(y, 1, 4) + (w - 1) * 7 + (wd - 1);
+  } else {
+    day = civil(y, 0, 1);
+  }
+  let ms = 0;
+  if (hh !== undefined) {
+    const f = frac === undefined ? 0 : Number("0." + frac.slice(1));
+    const h = Number(hh);
+    const minute = mi === undefined ? 0 : Number(mi);
+    const second = ss === undefined ? 0 : Number(ss);
+    if (h > 24 || minute > 59 || second > 59) return null;
+    if (h === 24 && (minute !== 0 || second !== 0 || f !== 0)) return null;
+    // the fraction belongs to the smallest field present
+    if (ss !== undefined) ms = ((h * 60 + minute) * 60 + second + f) * 1000;
+    else if (mi !== undefined) ms = (h * 60 + minute + f) * 60 * 1000;
+    else ms = (h + f) * 3600 * 1000;
+    ms = Math.round(ms * 1000) / 1000;
+    ms = Math.trunc(ms); // parseISO keeps whole milliseconds
+  }
+  if (zone !== undefined) {
+    let off = 0;
+    if (zone.toUpperCase() !== "Z") {
+      const zm = /^([+-])(\d{2}):?(\d{2})?$/.exec(zone);
+      const oh = Number(zm[2]);
+      const om = zm[3] === undefined ? 0 : Number(zm[3]);
+      if (oh > 23 || om > 59) return null;
+      off = (zm[1] === "-" ? -1 : 1) * (oh * 60 + om) * 60000;
+    }
+    return new Date(day * MS_DAY + ms - off);
+  }
+  // local time: the wall clock of that calendar day (hour 24 = midnight ending the day)
+  const c = fromCivil(day);
+  const r = local(c.y, c.mo, c.d);
+  return new Date(+r + ms - 0 + (wallShift(r, ms)));
+}
+
+/** Local time `ms` after the local midnight `r`, by wall clock: the difference between wall arithmetic and instant arithmetic across a DST change. */
+function wallShift(r, ms) {
+  const h = Math.floor(ms / 3600000);
+  const rest = ms - h * 3600000;
+  const mi = Math.floor(rest / 60000);
+  const s = Math.floor((rest - mi * 60000) / 1000);
+  const mss = rest - mi * 60000 - s * 1000;
+  const t = local(r.getFullYear(), r.getMonth(), r.getDate(), h, mi, s, mss);
+  return +t - (+r + ms);
+}
