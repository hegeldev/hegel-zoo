+  const d = new Date(Date.UTC(2010, 10, 7, 6, 0, 0)); // 01:00:00 EST, the second 01:00 of the day
+  assert.equal(+F.startOfSecond(d), +d, `startOfSecond moves the instant to ${F.startOfSecond(d).toISOString()}`);
+  assert.equal(+F.startOfMinute(d), +d, `startOfMinute moves the instant to ${F.startOfMinute(d).toISOString()}`);
+  assert.ok(+F.endOfHour(d) >= +d, `endOfHour(d) = ${F.endOfHour(d).toISOString()} is before d = ${d.toISOString()}`);
+  gen.setZone("Pacific/Chatham"); // 1995-10-01: the clocks jump from 02:45 to 03:45, so hour 03 begins at 03:45
+  const c = new Date(Date.UTC(1995, 8, 30, 14, 0)); // 03:45 +13:45
+  assert.equal(c.getHours(), 3);
+  assert.ok(+F.startOfHour(c) <= +c, `startOfHour(c) = ${F.startOfHour(c).toString()} is after c = ${c.toString()}`);
+  gen.setZone("America/Santiago");
+  const s = new Date(Date.UTC(1995, 2, 12, 3)); // Sat 11 Mar 1995 23:00 -04:00, after the fall-back at midnight
+  assert.ok(+F.endOfDay(s) >= +s, `endOfDay(s) = ${F.endOfDay(s).toISOString()} is before s = ${s.toISOString()}`);
+});
+
+pin("TestHegelPinYearsBetweenTwoMinutesApartIsZero", () => {
+  gen.setZone("America/New_York"); // 1996-10-27: 01:57:49 EDT then, two minutes later, 01:00:01 EST
+  const a = new Date(Date.UTC(1996, 9, 27, 6, 0, 1));
+  const b = new Date(Date.UTC(1996, 9, 27, 5, 57, 49));
+  assert.equal(F.differenceInYears(a, b), 0, `differenceInYears(a, b) = ${F.differenceInYears(a, b)} for a two-minute interval`);
+  const dur = F.intervalToDuration({ start: b, end: a });
+  assert.deepEqual(dur, { minutes: 2, seconds: 12 }, `intervalToDuration gives ${JSON.stringify(dur)}`);
+});
+
+pin("TestHegelPinParseJsonKeepsYearsBelow100", () => {
+  setUTC();
+  assert.equal(+F.parseJSON("0004-10-18T01:07:00.000Z"), +M.utc(4, 9, 18, 1, 7), `parseJSON gives ${F.parseJSON("0004-10-18T01:07:00.000Z").toISOString()}`);
+});
+
+pin("TestHegelPinParseKeepsTheHourAfterADstGap", () => {
+  gen.setZone("Pacific/Chatham"); // DST starts 1995-10-01 at 02:45, clocks jump to 03:45
+  const ref = new Date(Date.UTC(2000, 0, 1));
+  const zoned = F.parse("1995-10-01 03:45:00 +13:45", "yyyy-MM-dd HH:mm:ss xxx", ref);
+  assert.equal(zoned.toISOString(), "1995-09-30T14:00:00.000Z", "03:45:00 +13:45 is 14:00Z whatever the process zone");
