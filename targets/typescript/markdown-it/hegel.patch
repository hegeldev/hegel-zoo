+// Hegel zoo: markdown-it (typescript/markdown-it). See targets/typescript/markdown-it/README.md.
+//
+// Run from the repo root (the pinned upstream checkout) with the TypeScript sources loaded
+// directly: `node --experimental-strip-types --test hegel/hegel.test.mjs`. Oracles under .hegel/:
+// commonmark.js (the reference implementation), micromark (+ GFM), markdown-it 14.3.0 (the last
+// release before the TypeScript rewrite).
+import assert from "node:assert/strict";
+import { readFileSync, readdirSync } from "node:fs";
+import { property, pin, n, pick, chance, word, fail, count, collecting, show } from "./hegel-zoo.mjs";
+
+const markdownit = (await import("../src/index.ts")).default;
+const markdownit14 = (await import("../.hegel/node_modules/markdown-it/index.mjs")).default;
+const cm = await import("../.hegel/node_modules/commonmark/dist/commonmark.mjs").catch(
+  async () => await import("../.hegel/node_modules/commonmark/lib/index.js"));
+const { micromark } = await import("../.hegel/node_modules/micromark/index.js");
+const { gfm, gfmHtml } = await import("../.hegel/node_modules/micromark-extension-gfm/index.js");
+const entities = await import("entities");
+
+const reader = new cm.Parser();
+const writer = new cm.HtmlRenderer();
+const mdC = markdownit("commonmark");
+const mdC14 = markdownit14("commonmark");
+const mdD = markdownit();
+const mdD14 = markdownit14();
+const mdZ = markdownit("zero");
+
+// The recorded bugs (bugs.toml) whose shapes the properties draw, by the name a gate or a
+// classifier files a case under. The shapes are drawn by default and a mismatch on one fails
+// naming its bug (STYLE.md rule 11, DESIGN.md decision 3), so the property is mapped to the bug
+// it shrinks to beside the pin; under HEGEL_NO_KNOWN=1 (`NO_KNOWN`, read once below) a case with
+// a known shape is counted and skipped, or not drawn, for a run that looks past the recorded bugs.
+const KNOWN = {
+  "known-bom": "markdown-it/1", // a leading U+FEFF is kept as text
+  "known-invalid-entity": "markdown-it/2", // unescapeAll leaves &#0; &#x110000; &#xD800; literal
+  "known-fence-eof": "markdown-it/3", // an unclosed fence at EOF without a final newline loses its last line's newline
+  "known-indented-quote": "markdown-it/4", // ">\n    >" is one quote, not quote + code (at any container depth)
+  "known-indented-inline": "markdown-it/5", // "- <a\n     b>" keeps the indent in the tag
+  "known-bracketed-space": "markdown-it/6", // [a](<x >) gives href="x", not "x%20"
+  "known-tight-item-block": "markdown-it/7", // "- a\n  ```" renders <li>a<pre>
+  "known-loose-fence": "markdown-it/8", // "- ```\n\n- b" becomes a loose list
+  "known-table-header": "markdown-it/9", // "- a|b\n-|-" is a table, not a list
+  "known-lazy-after-definition": "markdown-it/10", // "- [r]: /u\n x" ends the item before x
+  "known-block-after-definition": "markdown-it/10", // the nested forms of /10 (and of /12), read off the parsers' structures
+  "known-partial-tab": "markdown-it/11", // ">\t<div>" keeps the tab (spec: two spaces)
+  "known-lazy-indent": "markdown-it/12", // " 5)  a\n    ***" ends the item, code follows
+  "known-empty-title": "markdown-it/13", // "[a]: /u\n'' x" is no definition at all
+  "known-bracket-host": "markdown-it/14", // <http://[x]> links to http://x with text http://x
+  "known-link-end-flanking": "markdown-it/15", // [**a_*]() gets emphasis, the ] is not seen
+  "known-long-tilde-run": "markdown-it/16", // ~~a~~~ strikes a (GFM: three or more tildes never do)
+  "known-backslash-newline-destination": "markdown-it/17", // [a](u\<newline>'b') is a link: the backslash swallows the line ending
+  "known-link-around-image-link": "markdown-it/18", // [![[foo](u1)](u2)](u3) is a link around the image
+};
+const NO_KNOWN = process.env.HEGEL_NO_KNOWN === "1";
+
+// The verdict on a mismatch: it fails, naming the recorded bug when the case has a known shape
+// (the shape is counted where it is recognised). Under NO_KNOWN a known shape is not a failure.
+function verdict(known, message) {
+  if (known && NO_KNOWN) return;
+  fail(known ? `${message} (shape of ${KNOWN[known]}: ${known})` : message);
+}
+
+// markdown-it/10: a reference definition (which the spec takes out of a paragraph) followed by a
+// line that would have continued that paragraph lazily: short of the item's content offset,
+// outside the quote, or indented four or more at the top level.
+function lazyAfterDefinitionShape(src) {
+  const lines = src.split("\n");
+  const item = /^( {0,3})([-+*]|\d{1,9}[.)])( {1,4}|\t)(?=\S|$)/;
+  // A line that starts a block (a marker, a heading, a fence, a thematic break, an HTML block of
+  // types 1-6) is no lazy continuation.
+  const blockStart = /^(?:[-+*](?:[ \t]|$)|\d{1,9}[.)](?:[ \t]|$)|#{1,6}(?:[ \t]|$)|`{3}|~{3}|(?:[-*_][ \t]*){3,}$|<(?:script|pre|textarea|style|!|\?|\/?(?:div|table|del|h[1-6]|p|ul|ol|li|blockquote|hr|tr|td|th|thead|tbody|section|nav|header|footer|form|details|summary|figure|dl|dd|dt|main|menu|iframe|html|body|head|title)(?:[ \t>\/]|$)))/i;
+  let offset = 0;
+  for (let i = 0; i + 1 < lines.length; i++) {
+    const m = item.exec(lines[i]);
+    const ind = columns(/^[ \t]*/.exec(lines[i])[0]);
+    if (m) offset = columns(m[0]);
+    else if (lines[i].trim() && ind < offset) offset = 0;
+    const rest = m ? lines[i].slice(m[0].length) : lines[i];
+    const pre = /^[ \t>]*/.exec(rest)[0];
+    if (!/^\[[^\]\n]*\]:/.test(rest.slice(pre.length))) continue;
+    // Four or more columns before the bracket (after the last quote marker and its space) make
+    // it indented code, not a definition.
+    const ws = pre.slice(pre.lastIndexOf(">") + 1);
+    const wsCols = pre.includes(">") ? columns(ws) - (/^[ \t]/.test(ws) ? 1 : 0) : columns((m ? m[0] : "") + ws) - (m ? offset : 0);
+    if (wsCols >= 4) continue;
+    // The definition may continue on indented lines (destination, title); the lazy line is the
+    // first one that is not indented to the item's content.
+    let j = i + 1;
+    while (j < lines.length && lines[j].trim() && offset && columns(/^[ \t]*/.exec(lines[j])[0]) >= offset) j++;
+    if (j >= lines.length) continue;
+    const next = lines[j];
+    if (!next.trim() || blockStart.test(next.replace(/^[ \t>]*/, ""))) continue;
+    const nind = columns(/^[ \t]*/.exec(next)[0]);
+    if (/^[ \t]*>/.test(next)) continue; // a quote's continuation or a new quote (the nested forms: containerShape)
+    if (/^[ \t]*>/.test(lines[i])) return true;
+    if (offset ? nind < offset : nind >= 4) return true;
+  }
+  return false;
+}
+
+// markdown-it/12: after a list item's paragraph, a line indented four or more columns but short
+// of the item's content offset is a lazy continuation; markdown-it closes the item and starts
+// indented code.
+function lazyIndentShape(src) {
+  const lines = src.split("\n");
+  for (let i = 0; i + 1 < lines.length; i++) {
+    const m = /^( {0,3})([-+*]|\d{1,9}[.)])( {1,4})\S/.exec(lines[i]);
+    if (!m) continue;
+    const offset = m[1].length + m[2].length + m[3].length;
+    const ind = /^[ \t]*/.exec(lines[i + 1])[0].replace(/\t/g, "    ").length;
+    if (ind >= 4 && ind < offset && lines[i + 1].trim()) return true;
+  }
+  return false;
+}
+
+// markdown-it/4 at any depth: while a quote is open (in items or quotes, through its lazy
+// continuation lines), a line whose next `>` marker is indented four or more columns at some depth
+// up to the quote's (the spec: a marker is indented at most three columns, so that is indented
+// code or lazy text). The item markers' widths are stripped first: a quote's continuation lines
+// padded to an item's content offset are not the shape. The chain of open containers is kept from
+// line to line (an item's width is its marker plus one when its first line is blank or its
+// content is indented five or more); a non-blank line that falls short of the chain keeps it (it
+// may be a lazy continuation) unless it opens a quote or an item of its own, a blank line closes
+// the quotes it does not reach.
+function indentedQuoteShape(src) {
+  const quote = /^ {0,3}> ?/, item = /^( {0,3}(?:[-+*]|\d{1,9}[.)]))([ \t]+(?=\S)|[ \t]*$)/;
+  // The text of `s` (which starts at column `from`) after column `to`, with the spaces a tab
+  // reaches past it; null when the whitespace falls short.
+  const strip = (s, from, to) => {
+    let c = from, i = 0;
+    for (; c < to; i++) {
+      if (s[i] === " ") c++;
+      else if (s[i] === "\t") c += 4 - (c % 4);
+      else return null;
+    }
+    return " ".repeat(c - to) + s.slice(i);
+  };
+  let chain = []; // ">" for a quote, an item's width in columns from its container's content
+  for (const line of src.split("\n")) {
+    let rest = line, col = 0;
+    const open = [];
+    for (const m of chain) {
+      if (m === ">") {
+        if (/^( {4,}| {0,3}\t)[ \t]*>/.test(rest)) return true;
+        const q = quote.exec(rest);
+        if (!q) break;
+        rest = rest.slice(q[0].length);
+        col += q[0].length;
+      } else {
+        const r = strip(rest, col, col + m);
+        if (r === null) break;
+        rest = r;
+        col += m;
+      }
+      open.push(m);
+    }
+    if (open.length < chain.length && rest.trim() && !quote.test(rest) && !item.test(rest)) continue;
+    for (let m; (m = quote.exec(rest) || item.exec(rest));) {
+      if (/^ {0,3}>/.test(m[0])) {
+        open.push(">");
+        rest = rest.slice(m[0].length);
+        col += m[0].length;
+        continue;
+      }
+      const marker = columns(m[1], col), content = columns(m[2], marker);
+      const code = content - marker >= 5; // the item's content is indented code: no container opens in it
+      open.push((code || m[0].length === rest.length ? marker + 1 : content) - col);
+      if (code) break;
+      rest = rest.slice(m[0].length);
+      col = content;
+    }
+    chain = open;
+  }
+  return false;
+}
+
+// The container shapes of markdown-it/10 and /12 in the nested forms the text patterns of the
+// gates above miss, read off the two parsers' structures: on the line after a reference
+// definition (which commonmark.js removes, leaving its lines in no leaf block) or on a line that
+// continues a paragraph in commonmark.js (a lazy line, or one indented four or more columns but
+// short of the item's offset), markdown-it sits in a different number of containers or starts a
+// different kind of block.
+function containerShape(src) {
+  const lines = src.split("\n");
+  const shape = () => lines.map(() => ({ depth: 0, kind: null }));
+  const md = shape(), cm = shape();
+  for (const t of mdC.parse(src, {})) {
+    if (!t.map || t.nesting === -1 || t.type === "inline" || t.type.endsWith("list_open")) continue;
+    if (t.type === "blockquote_open" || t.type === "list_item_open") for (let l = t.map[0]; l < t.map[1]; l++) md[l].depth++;
+    else md[t.map[0]].kind = { fence: "code_block", hr: "thematic_break" }[t.type] || t.type.replace(/_open$/, "");
+  }
+  const checked = new Set(), covered = new Set();
+  const walker = reader.parse(src).walker();
+  for (let e; (e = walker.next());) {
+    if (!e.entering || !e.node.sourcepos || e.node.type === "document" || e.node.type === "list") continue;
+    const [[first], [last]] = e.node.sourcepos; // 1-based, inclusive
+    if (e.node.type === "block_quote" || e.node.type === "item") {
+      for (let l = first - 1; l < last; l++) cm[l].depth++;
+    } else {
+      cm[first - 1].kind = e.node.type;
+      for (let l = first - 1; l < last; l++) covered.add(l);
+      if (e.node.type === "paragraph") for (let l = first; l < last; l++) checked.add(l);
+    }
+  }
+  // The lines no leaf block covers: a definition's (blank lines and markers are not content).
+  const content = (l) => /\S/.test(lines[l].replace(/^[ \t>]*([-+*]|\d{1,9}[.)])?[ \t]*/, ""));
+  for (let l = 1; l < lines.length; l++) if (!covered.has(l - 1) && content(l - 1)) checked.add(l);
+  for (const l of checked) {
+    if (md[l].depth !== cm[l].depth || md[l].kind !== cm[l].kind) return "known-block-after-definition";
+  }
+  return null;
+}
+
+// markdown-it/8 wherever the paragraph sits in the item: a tight rendering and a loose one agree
+// once the paragraphs inside list items lose their <p> wrappers.
+function unwrapItemParagraphs(h) {
+  let depth = 0;
+  return h.replace(/<li>\n<p>|<li>|<\/li>|<p>|<\/p>\n(?=<\/li>)|<\/p>/g, (t) => {
+    if (t.startsWith("<li>")) { depth++; return "<li>"; }
+    if (t === "</li>") { depth--; return t; }
+    return depth > 0 ? "" : t;
+  });
+}
+
+// #1201 (fixed in 15.0.0): 14.3.0's lookahead for a link or image label's closing bracket ran the
+// code span rule, whose position cache then hid the code spans it had passed: from a `[` to its
+// `]` (or the end of the paragraph), a code span followed by a backtick run without a closer. The
+// lookahead skipped a code span whole, so a `]` inside one (a span opened in the brackets and
+// closed after them: "[a``a](u)``a``") was not the label's end.
+function lookaheadHidCodeSpan(src) {
+  for (const para of src.split(/\n[ \t]*\n/)) {
+    for (let p = para.indexOf("["); p !== -1; p = para.indexOf("[", p + 1)) {
+      let depth = 1, end = para.length;
+      for (let i = p + 1; i < para.length && end === para.length; i++) {
+        if (para[i] === "\\") i++;
+        else if (para[i] === "`") {
+          const run = /^`+/.exec(para.slice(i))[0].length;
+          const closer = new RegExp(`(?<!\`)\`{${run}}(?!\`)`).exec(para.slice(i + run));
+          i += run - 1 + (closer ? closer.index + run : 0);
+        }
+        else if (para[i] === "[") depth++;
+        else if (para[i] === "]" && --depth === 0) end = i;
+      }
+      const runs = [...para.slice(p + 1, end).matchAll(/`+/g)].map((r) => r[0].length);
+      for (let i = 0, pairs = 0; i < runs.length; i++) {
+        const j = runs.indexOf(runs[i], i + 1);
+        if (j !== -1) { pairs++; i = j; } else if (pairs) return true;
+      }
+    }
+  }
+  return false;
+}
+
+// markdown-it/18: forming a link deactivates every `[` opener
+// before it (spec 6.3, "links may not contain other links, at any level of nesting"), through an
+// image's alt text too; markdown-it's label scan skips an image as one token and never sees the
+// link inside it, so it forms the outer link (TestHegelLinkTextWithALinkInsideAnImageIsNotALink).
+function linkAroundImageWithLink(src) {
+  const hasLink = (children) => children.some((c) => c.type === "link_open" || (c.type === "image" && hasLink(c.children)));
+  return mdC.parse(src, {}).some((t) => {
+    if (t.type !== "inline") return false;
+    let depth = 0;
+    return t.children.some((c) => {
+      if (c.type === "link_open") depth++;
+      else if (c.type === "link_close") depth--;
+      return c.type === "image" && depth > 0 && hasLink(c.children);
+    });
+  });
+}
+
+// Output shapes of recorded bugs (KNOWN) and of accepted differences, checked only after the
+// byte-exact comparison has failed: `shapes(got) === shapes(want)` files the case under its name
+// (`classify`: by default a known shape names the bug the mismatch fails with, under NO_KNOWN it
+// explains the mismatch as the accepted ones do).
+const SHAPES = [
+  // markdown-it/5: indentation of a continuation line inside a raw HTML tag or code span is kept
