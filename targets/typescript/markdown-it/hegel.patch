+pin("TestHegelPinUpstreamFixturesStillPass", () => {
+  const spec = readFileSync(new URL("../test/fixtures/commonmark/spec.txt", import.meta.url), "utf8").replace(/→/g, "\t");
+  let count = 0;
+  for (const t of mdC.parse(spec, {})) {
+    if (t.tag !== "code" || t.info.trim() !== "example") continue;
+    const [md, html] = t.content.split(/^\.\s*?$/m, 2);
+    assert.equal(mdC.render(md), html.replace(/^\n/, "").replace(/<blockquote>\n<\/blockquote>/g, "<blockquote></blockquote>"), `spec line ${t.map[0]}`);
+    count++;
+  }
+  assert.ok(count > 600, `only ${count} spec examples found`);
+  const dir = new URL("../test/fixtures/markdown-it/", import.meta.url);
+  const md = markdownit({ html: true, langPrefix: "", typographer: true, linkify: true });
+  for (const f of readdirSync(dir)) {
+    if (!f.endsWith(".txt")) continue;
+    for (const fx of parseFixtureFile(readFileSync(new URL(f, dir), "utf8"))) {
+      assert.equal(md.render(fx.md), fx.html, `${f} line ${fx.line}`);
+    }
+  }
+});
