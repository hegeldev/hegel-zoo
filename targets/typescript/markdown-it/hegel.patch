+      assert.equal(md.render(fx.md), fx.html, `${f} line ${fx.line}`);
+    }
+  }
+});
+
+// ---------------------------------------------------------------- pins (one per recorded bug)
+
+const bq = (h) => h.replace(/<blockquote>\n<\/blockquote>/g, "<blockquote></blockquote>");
+
+pin("TestHegelPinLeadingBomIsNotText", () => {
+  // markdown-it/1: commonmark.js, micromark and cmark all skip a leading U+FEFF; markdown-it keeps it.
+  assert.equal(mdC.render("\ufeffa\n"), "<p>a</p>\n");
+});
+
+pin("TestHegelPinInvalidCharacterReferenceInDestinationBecomesReplacementChar", () => {
+  // markdown-it/2: the spec replaces invalid code points by U+FFFD; unescapeAll (destinations,
+  // titles, info strings) leaves them literal, so the href is "&amp;#0;".
+  assert.equal(mdC.render("[a](&#0;)\n"), '<p><a href="%EF%BF%BD">a</a></p>\n');
+  assert.equal(mdC.render("[a](&#x110000;)\n"), '<p><a href="%EF%BF%BD">a</a></p>\n');
+});
+
+pin("TestHegelPinUnclosedFenceAtEofKeepsItsLastLine", () => {
+  // markdown-it/3: the last line of an unclosed fence at the end of a document without a final
+  // newline loses its newline, or the whole line if it is whitespace only.
+  assert.equal(mdC.render("```\na"), "<pre><code>a\n</code></pre>\n");
+  assert.equal(mdC.render("```\n   "), "<pre><code>   \n</code></pre>\n");
+});
+
+pin("TestHegelPinIndentedQuoteMarkerIsCodeOrLazyText", () => {
+  // markdown-it/4: a ">" indented four columns after a blockquote line is indented code (or lazy
+  // paragraph text), not another quote marker.
+  assert.equal(bq(mdC.render(">\n    >\n")), "<blockquote></blockquote>\n<pre><code>&gt;\n</code></pre>\n");
+  assert.equal(mdC.render("> a\n\t> b\n"), "<blockquote>\n<p>a\n&gt; b</p>\n</blockquote>\n");
+});
+
+pin("TestHegelPinContinuationIndentIsStrippedInsideInlines", () => {
+  // markdown-it/5: paragraph continuation lines lose their leading whitespace (spec 4.8); inside a
+  // raw HTML tag or a code span spanning lines markdown-it keeps the indentation beyond the
+  // container's content offset.
+  assert.equal(mdC.render("- <a\n     b>\n"), "<ul>\n<li><a\nb></li>\n</ul>\n");
+  assert.equal(mdC.render("4. `a\n    b`\n"), '<ol start="4">\n<li><code>a b</code></li>\n</ol>\n');
+});
+
+pin("TestHegelPinBracketedDestinationKeepsItsWhitespace", () => {
+  // markdown-it/6: whitespace inside <...> is part of the destination and is percent-encoded.
+  assert.equal(mdC.render("[a](<x >)\n"), '<p><a href="x%20">a</a></p>\n');
+  assert.equal(mdC.render("[a](<x\ty>)\n"), '<p><a href="x%09y">a</a></p>\n');
+});
+
+pin("TestHegelPinBlockAfterTightItemParagraphStartsOnItsOwnLine", () => {
+  // markdown-it/7: the renderer puts a newline before a block that follows a hidden paragraph,
+  // except for fences and HTML blocks, whose rules do not check the previous token.
+  assert.equal(mdC.render("- a\n  ```\n  x\n  ```\n"), "<ul>\n<li>a\n<pre><code>x\n</code></pre>\n</li>\n</ul>\n");
+  assert.equal(mdC.render("- a\n  <div>\n"), "<ul>\n<li>a\n<div>\n</li>\n</ul>\n");
+});
+
+pin("TestHegelPinBlankLinesInsideAnUnclosedFenceKeepTheListTight", () => {
+  // markdown-it/8: the blank lines belong to the fence's content; the list stays tight.
+  const html = mdC.render("- ```\n\n- b\n");
+  assert.ok(html.includes("<li>b</li>"), `the list became loose: ${JSON.stringify(html)}`);
+});
+
+pin("TestHegelPinTableHeaderRowCannotStartAnotherBlock", () => {
+  // markdown-it/9: GFM (and GitHub) read the container or leaf block first; a list item or heading
+  // followed by a delimiter row is not a table.
+  assert.equal(mdD.render("- a|b\n-|-\n"), "<ul>\n<li>a|b\n-|-</li>\n</ul>\n");
+  assert.equal(mdD.render("# a|b\n-|-\n"), "<h1>a|b</h1>\n<p>-|-</p>\n");
+});
+
+pin("TestHegelPinLazyLineAfterDefinitionStaysInTheItem", () => {
+  // markdown-it/10: definitions are taken from paragraphs, so the paragraph's lazy continuation
+  // line stays in the list item.
+  assert.equal(mdC.render("- [r]: /u\n x\n"), "<ul>\n<li>x</li>\n</ul>\n");
+  assert.equal(mdC.render("> [a]: /u\nx\n"), "<blockquote>\n<p>x</p>\n</blockquote>\n");
+  // ... and at the top level an indented line after the definition is the paragraph, not code.
+  assert.equal(mdC.render("[a]: /u\n    x\n"), "<p>x</p>\n");
+});
+
+pin("TestHegelPinPartialTabAfterQuoteMarkerExpandsToSpaces", () => {
+  // markdown-it/11: the part of a tab not consumed by the quote marker counts as spaces (spec 2.2);
+  // HTML block lines keep the tab, and nested markers with a space before the tab lose a column.
+  assert.equal(mdC.render(">\t<div>\n"), "<blockquote>\n  <div>\n</blockquote>\n");
+  assert.equal(mdC.render(">>  \ta\n"), "<blockquote>\n<blockquote>\n<pre><code> a\n</code></pre>\n</blockquote>\n</blockquote>\n");
+});
+
+pin("TestHegelPinIndentedLineShortOfItemOffsetIsLazyText", () => {
+  // markdown-it/12: indented code cannot interrupt a paragraph, so the line continues the item's
+  // paragraph instead of closing the list.
+  assert.equal(mdC.render(" 5)  a\n    ***\n"), '<ol start="5">\n<li>a\n***</li>\n</ol>\n');
+});
+
+pin("TestHegelPinDefinitionSurvivesAnEmptyTitleFollowedByText", () => {
+  // markdown-it/13: spec example 216 — an invalid title line leaves the definition without a title
+  // and becomes a paragraph; with an empty quoted title markdown-it drops the definition.
+  assert.equal(mdC.render("[a]: /u\n'' x\n\n[a]\n"), "<p>'' x</p>\n<p><a href=\"/u\">a</a></p>\n");
+});
+
+pin("TestHegelPinBracketedHostThatIsNotAnAddressIsKept", () => {
+  // markdown-it/14: normalizeLink/normalizeLinkText drop the brackets of a host that is not an
+  // IPv6 literal, changing the link text as well ("http://[x]" becomes "http://x").
+  assert.equal(mdC.render("<http://[x]>\n"), '<p><a href="http://%5Bx%5D">http://[x]</a></p>\n');
+  assert.equal(mdC.render("[t](http://[]/x)\n"), '<p><a href="http://%5B%5D/x">t</a></p>\n');
+});
+
+pin("TestHegelPinClosingBracketCountsForFlankingInsideLinkText", () => {
+  // markdown-it/15: the "*" before "]" is followed by punctuation, so it can open as well as close
+  // and the rule of three forbids matching "**"; "**a_*]" alone renders literally, "[**a_*]()" not.
+  assert.equal(mdC.render("[**a_*]()\n"), '<p><a href="">**a_*</a></p>\n');
+});
+
+pin("TestHegelPinBackslashBeforeLineEndingEndsTheDestination", () => {
+  // markdown-it/17: the backslash before the line ending is literal (spec 2.4: only ASCII
+  // punctuation is escapable) and ends the destination; parseLinkDestination skips the character
+  // after any backslash, so the href swallows the line ending and the title, or the text that
+  // would have made the link fail.
+  assert.equal(mdC.render("[a](u\\\n'b')\n"), '<p><a href="u%5C" title="b">a</a></p>\n');
+  assert.equal(mdC.render("[a](u\\\nb)\n"), "<p>[a](u<br />\nb)</p>\n");
+});
+
+pin("TestHegelPinLinkTextWithALinkInsideAnImageIsNotALink", () => {
+  // markdown-it/18: forming the inner link deactivates every `[` opener before it (spec 6.3), the
+  // outer one included, so the outer brackets are text; markdown-it's label scan skips the image as
+  // one token and never sees the link inside it.
+  assert.equal(mdC.render("[![[foo](u1)](u2)](u3)\n"), '<p>[<img src="u2" alt="foo" />](u3)</p>\n');
+});
+
+pin("TestHegelPinThreeOrMoreTildesDoNotStrike", () => {
+  // markdown-it/16: the strikethrough rule cuts a delimiter run into `~~` pairs (one `~` of text
+  // first when the run is odd), so "~~a~~~" strikes "a" and "~~a~~~~b~~" strikes "a" and "b"
+  // separately; GFM: "Three or more tildes do not create a strikethrough" (micromark, cmark-gfm).
+  assert.equal(mdD.render("~~a~~~\n"), "<p>~~a~~~</p>\n");
+  assert.equal(mdD.render("~~a~~~~b~~\n"), "<p><s>a~~~~b</s></p>\n");
+});
