+// ---------------------------------------------------------------- pins (one per recorded bug)
+
+const bq = (h) => h.replace(/<blockquote>\n<\/blockquote>/g, "<blockquote></blockquote>");
+
+pin("TestHegelPinLeadingBomIsNotText", () => {
+  // markdown-it/1: commonmark.js, micromark and cmark all skip a leading U+FEFF; markdown-it keeps it.
+  assert.equal(mdC.render("\ufeffa\n"), "<p>a</p>\n");
+});
+
+pin("TestHegelPinInvalidCharacterReferenceInDestinationBecomesReplacementChar", () => {
+  // markdown-it/2: the spec replaces invalid code points by U+FFFD; unescapeAll (destinations,
+  // titles, info strings) leaves them literal, so the href is "&amp;#0;".
+  assert.equal(mdC.render("[a](&#0;)\n"), '<p><a href="%EF%BF%BD">a</a></p>\n');
+  assert.equal(mdC.render("[a](&#x110000;)\n"), '<p><a href="%EF%BF%BD">a</a></p>\n');
+});
+
+pin("TestHegelPinUnclosedFenceAtEofKeepsItsLastLine", () => {
+  // markdown-it/3: the last line of an unclosed fence at the end of a document without a final
+  // newline loses its newline, or the whole line if it is whitespace only.
+  assert.equal(mdC.render("```\na"), "<pre><code>a\n</code></pre>\n");
+  assert.equal(mdC.render("```\n   "), "<pre><code>   \n</code></pre>\n");
+});
+
+pin("TestHegelPinIndentedQuoteMarkerIsCodeOrLazyText", () => {
+  // markdown-it/4: a ">" indented four columns after a blockquote line is indented code (or lazy
+  // paragraph text), not another quote marker.
+  assert.equal(bq(mdC.render(">\n    >\n")), "<blockquote></blockquote>\n<pre><code>&gt;\n</code></pre>\n");
+  assert.equal(mdC.render("> a\n\t> b\n"), "<blockquote>\n<p>a\n&gt; b</p>\n</blockquote>\n");
+});
+
+pin("TestHegelPinContinuationIndentIsStrippedInsideInlines", () => {
+  // markdown-it/5: paragraph continuation lines lose their leading whitespace (spec 4.8); inside a
+  // raw HTML tag or a code span spanning lines markdown-it keeps the indentation beyond the
+  // container's content offset.
+  assert.equal(mdC.render("- <a\n     b>\n"), "<ul>\n<li><a\nb></li>\n</ul>\n");
+  assert.equal(mdC.render("4. `a\n    b`\n"), '<ol start="4">\n<li><code>a b</code></li>\n</ol>\n');
+});
+
+pin("TestHegelPinBracketedDestinationKeepsItsWhitespace", () => {
+  // markdown-it/6: whitespace inside <...> is part of the destination and is percent-encoded.
+  assert.equal(mdC.render("[a](<x >)\n"), '<p><a href="x%20">a</a></p>\n');
+  assert.equal(mdC.render("[a](<x\ty>)\n"), '<p><a href="x%09y">a</a></p>\n');
+});
+
+pin("TestHegelPinBlockAfterTightItemParagraphStartsOnItsOwnLine", () => {
+  // markdown-it/7: the renderer puts a newline before a block that follows a hidden paragraph,
+  // except for fences and HTML blocks, whose rules do not check the previous token.
+  assert.equal(mdC.render("- a\n  ```\n  x\n  ```\n"), "<ul>\n<li>a\n<pre><code>x\n</code></pre>\n</li>\n</ul>\n");
+  assert.equal(mdC.render("- a\n  <div>\n"), "<ul>\n<li>a\n<div>\n</li>\n</ul>\n");
+});
+
+pin("TestHegelPinBlankLinesInsideAnUnclosedFenceKeepTheListTight", () => {
+  // markdown-it/8: the blank lines belong to the fence's content; the list stays tight.
+  const html = mdC.render("- ```\n\n- b\n");
