+  if (/[ \t\n\r"<>`]/.test(once) || /[^\x21-\x7e]/.test(once)) fail(`normalizeLink(${show(u)}) = ${show(once)} keeps unencodable characters`);
+  // validateLink: the documented blacklist (docs/safety.md) — javascript:, vbscript:, file:, and
+  // data: except for images; matched case-insensitively after trimming (anything else in the
+  // scheme is percent-encoded by normalizeLink, which makes it harmless).
+  const v = pick(tc, ["javascript:alert(1)", "JAVASCRIPT:x", "java\tscript:x", "vbscript:x", "file:///etc/passwd", "data:text/html;base64,x", "data:image/png;base64,x",
+    "data:image/svg+xml;base64,x", "data:image/gif,x", "DATA:IMAGE/PNG,x", "http://x", "mailto:a@b", "javascript&colon;x", "&#106;avascript:x", " javascript:x",
+    "\u0001javascript:x", "jav\u0000ascript:x", "javascript\u200b:x", "data:image/webp;base64,x", "data:IMAGE/PNG,x", "data:image/x-icon,x", "data:,x", "file:x", "javascript:", "vbscript", "x:javascript:y", "//javascript:x"]);
+  const stripped = v.trim().toLowerCase();
+  const expect = !(/^(javascript|vbscript|file):/.test(stripped) || (/^data:/.test(stripped) && !/^data:image\/(gif|png|jpeg|webp);/.test(stripped)));
+  if (md.validateLink(v) !== expect) {
+    count("validateLink");
+    fail(`validateLink(${show(v)}) = ${md.validateLink(v)}, expected ${expect}`);
+  }
+});
