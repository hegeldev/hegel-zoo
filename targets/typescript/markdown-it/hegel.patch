+// ---------------------------------------------------------------- typographer
+
+property("TestHegelReplacementsMatchTheDocumentedTable", (tc) => {
+  // Plain text without markup: the typographer's replacements rule per docs (README, replacements.ts):
+  // (c) (r) (tm) +- ... , ?.... !.... , -- ---
+  const parts = [];
+  for (let i = 0; i < n(tc, 1, 8); i++) parts.push(pick(tc, ["a", "b ", " c", "(c)", "(C)", "(r)", "(TM)", "(p)", "+-", "...", "....", ".....", "?....", "!....", "!!!!!!", "????", ",,", "--", "---", "----", "-", "a--b", "x---y", "1-2", "(c", "c)", "( c)", "(tm", "+", "-+"]));
+  const src = parts.join("");
+  if (/^\s*$|^\s*(#|-|\+|>|\d+[.)])|\n/.test(src) || /^(\s*[-+]\s*)+$/.test(src)) return;
+  const md = markdownit({ typographer: true });
+  const html = md.render(src);
+  const m = /^<p>([^]*)<\/p>\n$/.exec(html);
+  if (!m) return count("not-a-paragraph");
+  let want = src.trim().replace(/[ \t]+$/gm, "");
+  want = want.replace(/\+-/g, "±")
+    .replace(/\.{2,}/g, "…").replace(/([?!])…/g, "$1..").replace(/([?!]){4,}/g, "$1$1$1").replace(/,{2,}/g, ",");
+  want = want.replace(/(^|[^-])---(?=[^-]|$)/mg, "$1\u2014").replace(/(^|\s)--(?=\s|$)/mg, "$1\u2013").replace(/(^|[^-\s])--(?=[^-\s]|$)/mg, "$1\u2013");
+  want = want.replace(/\((c|tm|r)\)/gi, (mm, k) => ({ c: "©", tm: "™", r: "®" })[k.toLowerCase()]);
+  want = mdD.utils.escapeHtml(want);
+  if (m[1] !== want) fail(`typographer renders ${show(src)} as ${show(m[1])}; the documented table gives ${show(want)}`);
+});
+
+// ---------------------------------------------------------------- performance
+
+function timeRender(md, src) {
+  const t = process.hrtime.bigint();
+  md.render(src);
+  return Number(process.hrtime.bigint() - t) / 1e6;
+}
+
+property("TestHegelRenderingTimeIsNotSuperLinear", (tc) => {
+  const unit = pick(tc, ["*", "_", "**", "[", "]", "[a", "a]", "![", "`", "``", "<", ">", "#", "> ", "- ", "1. ", "&", "&#", "&amp", "\\", "\"", "'", "~~", "|", "|-", "*a ", "[a](", "[a]: ", "<a", "<!--", "www.", "http://", "a@", "(", ")", "\n", "  \n", " ", "\t", "a", "*a **a ", "[[", "]]", "![a]", "`a", "a`", "*]", "_(", "-\n", "``` \n", "> - ", "- - ", "1) ", "[x]: y\n", "<b>", "\n\n#", "a  \n"]);
+  const tail = chance(tc, 50) ? pick(tc, ["a", "*", "_", "]", ")", "`", ">", "\n", "**", " a** a*", "`a`", "&x;", "\n\n"]) : "";
+  const opts = { linkify: chance(tc, 30), typographer: chance(tc, 30), breaks: chance(tc, 20), html: chance(tc, 50) };
+  const md = markdownit(opts);
+  const mk = (k) => unit.repeat(k) + "a" + tail.repeat(k) + "\n";
+  const N1 = 1500, N2 = 6000;
+  timeRender(md, mk(50)); // warm up the code paths
+  const t1 = Math.max(timeRender(md, mk(N1)), 3);
+  const t2 = timeRender(md, mk(N2));
+  count(t2 > 400 ? "slow" : "fast");
+  // 4x the input: linear is 4x, tolerate 25x before calling it quadratic; also an absolute budget.
+  if (t2 > 25 * t1 || t2 > 3000) {
+    fail(`unit ${show(unit)} tail ${show(tail)} opts ${show(opts)}: ${N1} repeats take ${t1.toFixed(1)} ms, ${N2} take ${t2.toFixed(1)} ms`);
+  }
+});
+
+// ---------------------------------------------------------------- fixtures
+
+function parseFixtureFile(input) {
+  const ls = input.split(/\r?\n/g);
+  const out = [];
+  let i = 0;
+  while (i < ls.length) {
+    if (ls[i] !== ".") { i++; continue; }
+    i++;
+    const a = i;
+    while (i < ls.length && ls[i] !== ".") i++;
+    if (i >= ls.length) break;
+    const first = ls.slice(a, i).join("\n");
+    i++;
+    const b = i;
+    while (i < ls.length && ls[i] !== ".") i++;
+    if (i >= ls.length) break;
+    const second = ls.slice(b, i).join("\n");
+    i++;
+    out.push({ line: a - 1, md: first.length ? first + "\n" : first, html: second.length ? second + "\n" : second });
+  }
+  return out;
+}
