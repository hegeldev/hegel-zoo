+// Hegel zoo: markdown-it (typescript/markdown-it). See targets/typescript/markdown-it/README.md.
+//
+// Run from the repo root (the pinned upstream checkout) with the TypeScript sources loaded
+// directly: `node --experimental-strip-types --test hegel/hegel.test.mjs`. Oracles under .hegel/:
+// commonmark.js (the reference implementation), micromark (+ GFM), markdown-it 14.3.0 (the last
+// release before the TypeScript rewrite).
+import assert from "node:assert/strict";
+import { readFileSync, readdirSync } from "node:fs";
+import { property, pin, n, pick, chance, word, fail, count, collecting, show } from "./hegel-zoo.mjs";
+
+const markdownit = (await import("../src/index.ts")).default;
+const markdownit14 = (await import("../.hegel/node_modules/markdown-it/index.mjs")).default;
+const cm = await import("../.hegel/node_modules/commonmark/dist/commonmark.mjs").catch(
+  async () => await import("../.hegel/node_modules/commonmark/lib/index.js"));
+const { micromark } = await import("../.hegel/node_modules/micromark/index.js");
+const { gfm, gfmHtml } = await import("../.hegel/node_modules/micromark-extension-gfm/index.js");
+const entities = await import("entities");
+
+const reader = new cm.Parser();
+const writer = new cm.HtmlRenderer();
+const mdC = markdownit("commonmark");
+const mdC14 = markdownit14("commonmark");
+const mdD = markdownit();
+const mdD14 = markdownit14();
+const mdZ = markdownit("zero");
+
+// Known bugs: each switch keeps a property away from one recorded bug's shape (see bugs.toml).
+const Known = {
+  bomRenderedAsText: true,          // markdown-it/1: a leading U+FEFF is kept as text
+  invalidEntityKeptInDestinations: true, // markdown-it/2: unescapeAll leaves &#0; &#x110000; &#xD800; literal
+  unclosedFenceAtEofDropsNewline: true, // markdown-it/3: an unclosed fence at EOF without a final newline
+  indentedQuoteMarkerContinuesQuote: true, // markdown-it/4: ">\n    >" is one quote, not quote + code
+  continuationIndentKeptInsideInlines: true, // markdown-it/5: "- <a\n     b>" keeps the indent in the tag
+  bracketedDestinationWhitespaceDropped: true, // markdown-it/6: [a](<x >) gives href="x", not "x%20"
+  blockAfterTightParagraphNotSeparated: true, // markdown-it/7: "- a\n  ```" renders <li>a<pre>
+  unclosedFenceBlankLinesLoosenList: true, // markdown-it/8: "- ```\n\n- b" becomes a loose list
+  tableHeaderSwallowsBlockStarts: true, // markdown-it/9: "- a|b\n-|-" is a table, not a list
+  lazyLineAfterDefinitionDropped: true, // markdown-it/10: "- [r]: /u\n x" ends the item before x
+  partialTabKeptInHtmlBlock: true, // markdown-it/11: ">\t<div>" keeps the tab (spec: two spaces)
+  lazyLineShortOfItemOffsetIsCode: true, // markdown-it/12: " 5)  a\n    ***" ends the item, code follows
+  emptyTitleRejectsDefinition: true, // markdown-it/13: "[a]: /u\n'' x" is no definition at all
+  bracketHostStripped: true, // markdown-it/14: <http://[x]> links to http://x with text http://x
+  linkTextEndIgnoredForFlanking: true, // markdown-it/15: [**a_*]() gets emphasis, the ] is not seen
+  longTildeRunSplitIntoPairs: true, // markdown-it/16: ~~a~~~ strikes a (GFM: three or more tildes never do)
+};
+
+// markdown-it/10: a reference definition (which the spec takes out of a paragraph) followed by a
+// line that would have continued that paragraph lazily: short of the item's content offset,
+// outside the quote, or indented four or more at the top level.
+function lazyAfterDefinitionShape(src) {
+  const lines = src.split("\n");
+  let offset = 0;
+  for (let i = 0; i + 1 < lines.length; i++) {
+    const m = /^( {0,3})([-+*]|\d{1,9}[.)])( {1,4}|\t)(\S|$)/.exec(lines[i]);
+    const ind = /^[ \t]*/.exec(lines[i])[0].replace(/\t/g, "    ").length;
+    if (m) {
+      const base = m[1].length + m[2].length;
+      offset = base + (m[3] === "\t" ? 4 - (base % 4) : m[3].length);
+    }
+    else if (lines[i].trim() && ind < offset) offset = 0;
+    if (!/^[ \t>]*\[[^\]\n]*\]:/.test(lines[i].replace(/^( {0,3})([-+*]|\d{1,9}[.)])( {1,4}|\t)/, ""))) continue;
+    // The definition may continue on indented lines (destination, title); the lazy line is the
+    // first one that is not indented to the item's content.
+    let j = i + 1;
+    while (j < lines.length && lines[j].trim() && offset && /^[ \t]*/.exec(lines[j])[0].replace(/\t/g, "    ").length >= offset) j++;
+    if (j >= lines.length) continue;
+    const next = lines[j];
+    if (!next.trim()) continue;
+    const nind = /^[ \t]*/.exec(next)[0].replace(/\t/g, "    ").length;
+    if (/^[ \t]*>/.test(lines[i]) && !/^[ \t]*>/.test(next)) return true;
+    if (offset ? nind < offset : nind >= 4) return true;
+  }
+  return false;
+}
+
+// markdown-it/12: after a list item's paragraph, a line indented four or more columns but short
+// of the item's content offset is a lazy continuation; markdown-it closes the item and starts
+// indented code.
+function lazyIndentShape(src) {
+  const lines = src.split("\n");
+  for (let i = 0; i + 1 < lines.length; i++) {
+    const m = /^( {0,3})([-+*]|\d{1,9}[.)])( {1,4})\S/.exec(lines[i]);
+    if (!m) continue;
+    const offset = m[1].length + m[2].length + m[3].length;
+    const ind = /^[ \t]*/.exec(lines[i + 1])[0].replace(/\t/g, "    ").length;
+    if (ind >= 4 && ind < offset && lines[i + 1].trim()) return true;
+  }
+  return false;
+}
+
+// markdown-it/4: a line indented four or more columns whose first character is ">" directly after
+// a blockquote line is read as another quote marker (the spec: indented code, or lazy text).
+const INDENTED_QUOTE = /(^|\n)[ \t]*>[^\n]*\n(?: {4}| {0,3}\t)[ \t]*>/;
+
+// Output shapes of the remaining known bugs and of accepted differences, checked only after the
+// byte-exact comparison has failed: `shapes(got) === shapes(want)` files the case under its name.
+const SHAPES = [
+  // markdown-it/5: indentation of a continuation line inside a raw HTML tag or code span is kept.
+  ["known-indented-inline", (h) => Known.continuationIndentKeptInsideInlines ? h.replace(/(<code>[^]*?<\/code>|<[a-zA-Z!?/][^>]*>)/g, (t) => t.replace(/\n[ \t]+/g, "\n").replace(/[ \t]{2,}/g, " ")) : h],
+  // markdown-it/3: an unclosed fence at EOF without a final newline loses the last line's newline
+  // (or the whole line when it is whitespace only).
+  ["known-fence-eof", (h) => Known.unclosedFenceAtEofDropsNewline ? h.replace(/(\n[ \t]*)*\n<\/code><\/pre>\n(?=(<\/li>\n|<\/ul>\n|<\/ol>\n|<\/blockquote>\n)*$)/, "</code></pre>\n").replace(/<code([^>]*)>[ \t]*<\/code><\/pre>\n(?=(<\/li>\n|<\/ul>\n|<\/ol>\n|<\/blockquote>\n)*$)/, "<code$1></code></pre>\n") : h],
+  // markdown-it/7: a fence or HTML block right after a tight list item's paragraph is not separated.
+  ["known-tight-item-block", (h) => Known.blockAfterTightParagraphNotSeparated ? h.replace(/([^>\n])\n(<pre><code|<!--|<\/?[a-zA-Z][^>]*>)/g, "$1$2") : h],
+  // markdown-it/8: blank lines closing an unclosed fence at the end of a list item make the list loose.
+  ["known-loose-fence", (h) => Known.unclosedFenceBlankLinesLoosenList ? h.replace(/<li>\n<p>/g, "<li>").replace(/<\/p>\n(?=<\/li>)/g, "").replace(/<\/p>\n(?=<pre>|<ul>|<ol>|<blockquote>|<h\d>|<hr)/g, "\n") : h],
+  // Accepted: markdown-it punycodes non-ASCII hosts (documented in normalizeLink) where the
+  // oracles percent-encode them; it keeps the brackets of IPv6 hosts (#1204) where commonmark.js
+  // encodes them; it escapes raw HTML inside an image's alt text where commonmark.js copies it
+  // verbatim (unescaped!); an HTML block at the end of a document without a final newline gets
+  // none (micromark agrees).
+  ["accepted-idn-host", (h) => h.replace(/href="[^"]*"|src="[^"]*"/g, (t) => /xn--|%[89A-F][0-9A-F]/i.test(t) ? "href=\"idn\"" : t)],
+  ["accepted-ipv6-brackets", (h) => h.replace(/%5B(:[^"]*?)%5D/g, "[$1]")],
+  ["accepted-alt-raw-html", (h) => h.replace(/ alt="[^]*?"( \/>| title=)/g, (t) => /[<&]/.test(t) ? ' alt=""' + t.slice(t.lastIndexOf('"') + 1) : t)],
+  ["accepted-html-block-eof", (h) => h.replace(/\n$/, "").replace(/(<[^<>\n]*>|-->) ?\n?(<\/blockquote>|<\/li>)/g, "$1$2")],
+];
+
+// micromark's own readings, accepted: trailing whitespace-only lines kept in indented code at
+// EOF, trailing tabs before a soft break stripped (commonmark.js keeps them, as markdown-it does),
+// image sources limited to http(s) (src="" otherwise).
+function classifyMicromark(got, want) {
+  const shape = (h) => h.replace(/(\n[ \t]*)+\n<\/code><\/pre>/g, "\n</code></pre>").replace(/[ \t]+\n/g, "\n").replace(/<a href="[^"]*">([^<]*)<\/a>/g, "$1").replace(/ (src|href)="[^"]*"/g, ' $1=""');
+  return shape(got) === shape(want) ? "accepted-micromark" : null;
+}
+
+function classify(got, want) {
+  let g = got, w = want;
+  for (const [name, shape] of SHAPES) {
+    g = shape(g);
+    w = shape(w);
+    if (g === w) return name;
+  }
+  return null;
+}
+
+function knownShape(src) {
+  if (Known.indentedQuoteMarkerContinuesQuote && INDENTED_QUOTE.test(src)) return "known-indented-quote";
+  if (Known.bracketedDestinationWhitespaceDropped && /\]\(<[^>\n]*[ \t][^>\n]*>|\]:[ \t]*\n?[ \t]*<[^>\n]*[ \t][^>\n]*>/.test(src)) return "known-bracketed-space";
+  if (Known.partialTabKeptInHtmlBlock && /(^|\n) {0,3}(> ?)*>[ ]*\t/.test(src)) return "known-partial-tab";
+  if (Known.bracketHostStripped && /:\/\/\[/.test(src)) return "known-bracket-host";
+  if (Known.lazyLineShortOfItemOffsetIsCode && lazyIndentShape(src)) return "known-lazy-indent";
+  if (Known.emptyTitleRejectsDefinition && /\]:[^\n]*\n([^\n]*\n)?[ \t>]*(''|""|\(\))[^\n]*\S/.test(src)) return "known-empty-title";
+  // markdown-it/15: a closing delimiter run at the very end of link text, preceded by punctuation.
+  if (Known.linkTextEndIgnoredForFlanking && /[!-\/:-@\[-`{-~][*_]+\]/.test(src)) return "known-link-end-flanking";
+  // markdown-it/10: a reference definition opening a list item or quote, followed by a line that
+  // would be a lazy continuation of the paragraph the definition was taken from.
+  if (Known.lazyLineAfterDefinitionDropped && lazyAfterDefinitionShape(src)) return "known-lazy-after-definition";
+  // markdown-it/9: a delimiter row after a line that starts another block makes a table of it.
+  if (Known.tableHeaderSwallowsBlockStarts && /(^|\n)[^\n]*\|[^\n]*\n {0,3}\|?[ \t]*:?-+:?[ \t]*(\|[ \t]*:?-+:?[ \t]*)*\|?[ \t]*(\n|$)/.test(src)) return "known-table-header";
+  if (Known.invalidEntityKeptInDestinations && /&#(0+|x0*(d[89a-f]|[1-9a-f][0-9a-f]{5,})|[0-9]{7,})?;/i.test(src)) return "known-invalid-entity";
+  return null;
+}
+
+// Generator switches set by the properties: unsafe URL schemes (markdown-it drops those links on
+// purpose, the CommonMark oracles keep them) and bare URLs (GFM autolink literals).
+let unsafeUrls = true;
+let bareUrls = true;
+
+// ---------------------------------------------------------------- oracles and normalisation
+
+function commonmarkJs(src) {
+  // commonmark.js writes "<blockquote>\n</blockquote>" for an empty quote; markdown-it (and the
+  // upstream spec test) write it without the newline.
+  return writer.render(reader.parse(src)).replace(/<blockquote>\n<\/blockquote>/g, "<blockquote></blockquote>");
+}
+
+function micromarkCm(src) {
+  return micromark(src, { allowDangerousHtml: true, allowDangerousProtocol: true })
+    .replace(/<blockquote>\n<\/blockquote>/g, "<blockquote></blockquote>");
+}
+
+function micromarkGfm(src) {
+  // markdown-it's strikethrough needs two tildes (documented), so single tildes are off here.
+  return micromark(src, { extensions: [gfm({ singleTilde: false })], htmlExtensions: [gfmHtml()] });
+}
+
+// GFM-flavoured differences of presentation between markdown-it's default preset and micromark's
+// GFM extension: alignment attribute and the strikethrough tag.
+function gfmShape(html) {
+  return html
+    .replace(/ style="text-align:(left|center|right)"/g, ' align="$1"')
+    .replace(/<(\/?)s>/g, "<$1del>")
+    .replace(/<(hr|br|img [^>]*?) \/>/g, "<$1>")
+    .replace(/<blockquote>\n<\/blockquote>/g, "<blockquote></blockquote>");
+}
+
+// ---------------------------------------------------------------- Markdown generator
+
+const WORDS = ["a", "b", "foo", "bar", "baz", "x", "yz", "qux", "Hello", "world", "α", "日本", "e\u0301",
+  "tab", "1", "42", "3.14", "-", "+", "_", "*", "~", "|", "#", "!", ".", ")", "(", "'", '"', "&", "<", ">", ":", "/"];
+const SCHEMES = ["http://", "https://", "ftp://", "mailto:", "", "/", "./", "#", "javascript:", "data:image/png;base64,", "vbscript:", "file:///"];
+
+function url(tc) {
+  let u = pick(tc, SCHEMES) + word(tc, "abcxyz.-_", 0, 8);
+  if (!unsafeUrls) u = u.replace(/^(javascript|vbscript|file|data):[^/]*\/?\/?/i, "http://");
+  if (chance(tc, 30)) u += "/" + word(tc, "abc%20/?=&#[]{}|^`\\ αß'\"()", 0, 8);
+  if (chance(tc, 10)) u = "<" + u + (chance(tc, 30) ? " " : "") + ">";
+  return u;
+}
+
+function title(tc) {
+  const q = pick(tc, ['"', "'", "("]);
+  const c = q === "(" ? ")" : q;
+  return q + word(tc, "abc &\"'()\\", 0, 6) + c;
+}
+
+function entity(tc) {
+  return pick(tc, ["&amp;", "&lt;", "&gt;", "&quot;", "&copy;", "&#35;", "&#x41;", "&#X41;", "&nbsp;", "&bogus;",
+    "&amp", "&#0;", "&#xD800;", "&#1114112;", "&ouml", "&ouml;", "&ngE;", "&#x0;", "&AMP;", "&Amp;", "& b", "&;", "&#;"]);
+}
+
+function rawHtmlInline(tc) {
+  return pick(tc, ["<b>", "</b>", "<a href='x'>", "<a href=\"y\" >", "<br/>", "<!-- c -->", "<!---->", "<?php x ?>",
+    "<!X y>", "<![CDATA[z]]>", "<b x=y>", "<b x = 'y'>", "<3", "< b>", "<b/ >", "<a.b>", "<a-b>", "<b x=\"y\"z>",
+    "<img src=x>", "<!-->", "<!--->", "<!-- -- -->", "<x:y>", "<ab@c.d>", "<foo\nbar>"]);
+}
+
+function codeSpan(tc) {
+  const ticks = "`".repeat(n(tc, 1, 3));
+  let inner = word(tc, "ab ` *_[]<&", 0, 8);
+  if (chance(tc, 20)) inner = pick(tc, [" ", "  ", " a ", "``", " `` ", "a\nb", "\n", " \n "]);
+  return ticks + inner + ticks;
+}
+
+const REFS = ["ref", "Ref", "r e f", "ΑΒΓ", "αβγ", "ﬀ", "a\\]b", "*x*", "x[y", "1", "a  b", "İϴΩKÅ"];
+
+function inlineAtom(tc, depth) {
+  const k = n(tc, 0, 99);
+  if (k < 30 || depth > 3) return pick(tc, WORDS);
+  if (k < 34) return pick(tc, [" ", "  ", "\n", "  \n", "\\\n", " \\\n", "\t", "\n ", "\n\t"]);
+  if (k < 44) {
+    const m = pick(tc, ["*", "**", "_", "__", "***", "___", "*_", "_*", "~~", "~", "**_", "*__"]);
+    const inner = inline(tc, depth + 1, n(tc, 0, 3));
+    return m + inner + (chance(tc, 80) ? m.split("").reverse().join("") : pick(tc, ["*", "_", "**", "__", ""]));
+  }
+  if (k < 50) return codeSpan(tc);
+  if (k < 60) {
+    const bang = chance(tc, 30) ? "!" : "";
+    const text = inline(tc, depth + 1, n(tc, 0, 3));
+    const style = n(tc, 0, 4);
