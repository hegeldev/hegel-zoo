+      // WHATWG folds ISO-8859-1/9, ASCII, TIS-620 and others into their Windows code pages; iconv-lite
+      // keeps the ISO tables: the two must still agree on ASCII
+      if (asciiCompatible(label, td.encoding)) count("whatwg-unified");
+      // the utf-16 label is iconv-lite's endianness-detecting codec, not WHATWG's UTF-16LE (documented)
+      else if (td.encoding === "utf-16le" && iconv.getCodec(label) === iconv.getCodec("utf16")) count("utf16-auto");
+      else fail(`WHATWG label ${show(label)} resolves to ${iconv.getCodec(label).encodingName ?? "?"}, TextDecoder says ${td.encoding}`);
+    }
+  }
+});
+
+// ------------------------------------------------------------------ streams
+
+propertyAsync("TestHegelStreamsMatchOneShot", async (tc) => {
+  const enc = pick(tc, TEXT_CODECS);
+  const s = UNICODE.includes(enc) ? genUnicodeText(tc, { lone: true }) : genText(tc, enc);
+  if (chance(tc, 50)) {
+    let bytes = chance(tc, 60) ? iconv.encode(s, enc) : mutateBytes(tc, iconv.encode(s, enc));
+    if (BOM_AWARE.includes(enc) && chance(tc, 20)) bytes = Buffer.concat([iconv.encode(BOM, enc), bytes]);
+    const parts = chunks(tc, bytes).filter((p) => p.length > 0);
+    const once = iconv.decode(bytes, enc);
+    const got = await new Promise((resolve, reject) => {
+      Readable.from(parts).pipe(iconv.decodeStream(enc)).collect((err, res) => (err ? reject(err) : resolve(res)));
+    });
+    count("decode");
+    if (got !== once) {
+      const k = known("stream-decode", { enc, bytes, text: once });
+      if (k) { count(k); return; }
+      fail(`${enc}: decodeStream of ${hex(bytes)} in ${show(parts.map(hex))} = ${show(got)}, one-shot ${show(once)}`);
+    }
+  } else {
+    const parts = stringChunks(tc, s).filter((p) => p.length > 0);
+    const once = iconv.encode(s, enc);
+    const got = await new Promise((resolve, reject) => {
+      Readable.from(parts).pipe(iconv.encodeStream(enc)).collect((err, res) => (err ? reject(err) : resolve(res)));
+    });
+    count("encode");
+    const agree = enc === "utf7" ? iconv.decode(got, enc) === iconv.decode(once, enc) : got.equals(once);
+    if (!agree) fail(`${enc}: encodeStream of ${show(parts)} = ${hex(got)}, one-shot ${hex(once)}`);
+  }
+});
+
+// ------------------------------------------------------------------ hostile input
+
+property("TestHegelHostileInputNeverCrashes", (tc) => {
+  const label = pick(tc, ALIASES);
+  const codec = iconv.getCodec(label);
+  const enc = ALL.find((e) => iconv.getCodec(e) === codec) ?? label;
+  // decode: junk, in a Buffer, a Uint8Array, or an unaligned view
+  const junk = chance(tc, 50) ? junkBytes(tc, 16) : mutateBytes(tc, iconv.encode(genUnicodeText(tc, { lone: true }), label));
+  const shift = n(tc, 0, 3);
+  const backing = new Uint8Array(junk.length + shift + 3);
+  backing.set(junk, shift);
+  const view = new Uint8Array(backing.buffer, shift, junk.length);
+  const options = pick(tc, [undefined, {}, { stripBOM: false }, { stripBOM: 42 }, { stripBOM: () => {} }, { addBOM: "yes" }, { defaultEncoding: "utf-16be" }, { defaultEncoding: "utf-32be" }]);
+  const a = iconv.decode(junk, label, options);
+  const b = iconv.decode(view, label, options);
+  if (typeof a !== "string" || typeof b !== "string") fail(`${label}: decode returned ${typeof a}/${typeof b}`);
+  if (a !== b) fail(`${label}: decode of a Buffer and of an unaligned Uint8Array view differ for ${hex(junk)} (shift ${shift}): ${show(a)} vs ${show(b)}`);
+  // encode: any string, any options
+  const s = genUnicodeText(tc, { lone: true, hi: 8 });
+  const e = iconv.encode(s, label, options);
+  if (!Buffer.isBuffer(e)) fail(`${label}: encode returned ${show(e)}`);
+  // fatal: an Error at most, and only where the codec is TextDecoder-backed or UTF-32
+  if (chance(tc, 30)) {
+    try { iconv.decode(junk, label, { fatal: true }); } catch (err) {
+      if (!(err instanceof Error)) fail(`${label}: fatal decode threw a non-Error ${show(err)}`);
+      const fatalAware = ["utf8", "cesu8", "utf16le", "utf16be", "utf16", "utf32le", "utf32be", "utf32"].includes(enc);
+      if (!fatalAware) fail(`${label}: fatal decode threw (${err.message}) though the codec has no fatal mode`);
+    }
+  }
+  // wrong argument types are TypeErrors
+  assert.throws(() => iconv.decode("text", label), TypeError);
+  assert.throws(() => iconv.encode(Buffer.alloc(1), label), TypeError);
+  count(UNICODE.includes(enc) ? "unicode" : DBCS.includes(enc) ? "dbcs" : "other");
+});
+
+// ------------------------------------------------------------------ pins
+
+pin("TestHegelPinCESU8TruncatedSequenceDecodesToReplacement", () => {
+  // iconv-lite/1
+  assert.equal(iconv.decode(Buffer.from([0x41, 0xe0, 0x80]), "cesu8"), "A" + REPL);
+});
+
+pin("TestHegelPinMultiByteStreamKeepsCharactersAfterABadLead", () => {
+  // iconv-lite/2
+  assert.equal(decodeStream("shiftjis", [Buffer.from([0x81]), Buffer.from([0x20])]), iconv.decode(Buffer.from([0x81, 0x20]), "shiftjis"));
+});
+
+pin("TestHegelPinUTF7RunKeepsItsCharactersBeforeABadTail", () => {
+  // iconv-lite/3
+  assert.equal(iconv.decode(Buffer.from("+AGEAY-"), "utf7"), "a" + REPL);
+});
+
+pin("TestHegelPinHexEncoderIsStateful", () => {
+  // iconv-lite/4
+  assert.equal(hex(encodeStream("hex", ["0", "1ff"])), "01ff");
+});
+
+pin("TestHegelPinReplacementCharacterEncodesAsQuestionMark", () => {
+  // iconv-lite/5
+  assert.deepEqual(Array.from(iconv.encode(REPL, "windows-1252")), [0x3f]);
+});
+
+pin("TestHegelPinTruncatedFourByteTailIsOneReplacement", () => {
+  // iconv-lite/6
+  assert.equal(iconv.decode(Buffer.from([0x41, 0x81, 0x30]), "gb18030"), "A" + REPL);
+});
+
+pin("TestHegelPinGB18030OutOfRangeFourByteSequenceIsReplaced", () => {
+  // iconv-lite/7
+  assert.equal(iconv.decode(Buffer.from([0xf4, 0x32, 0xc6, 0x33]), "gb18030"), REPL);
+});
diff --git a/hegel/known.mjs b/hegel/known.mjs
new file mode 100644
index 0000000..d87a488
--- /dev/null
+++ b/hegel/known.mjs
@@ -0,0 +1,78 @@
+// Hegel zoo: the recorded bugs of iconv-lite (bugs.toml), as gates. `known(where, ctx)` returns
+// the bug id when a case has the shape of a recorded bug, so it is counted rather than judged;
+// ZOO_NO_KNOWN=1 lifts the gates.
+
+import { DBCS, REPL } from "./enc.mjs";
+
+const lifted = !!process.env.ZOO_NO_KNOWN;
+
+/** The base64 runs of a UTF-7 byte string: text after each shift-in up to the first non-base64 byte. */
+function utf7Runs(bytes, shiftIn, extra) {
+  const runs = [];
+  const text = Buffer.from(bytes).toString("latin1");
+  const re = new RegExp("\\" + shiftIn + "([A-Za-z0-9+/" + extra + "]*)", "g");
+  for (const m of text.matchAll(re)) runs.push(m[1]);
+  return runs;
+}
+
+/** True when the CESU-8 byte string ends inside a multi-byte sequence (a lead byte awaiting continuation). */
+function cesu8Truncated(bytes) {
+  let i = bytes.length - 1;
+  let cont = 0;
+  while (i >= 0 && (bytes[i] & 0xc0) === 0x80) { cont++; i--; }
+  if (i < 0) return false;
+  const lead = bytes[i];
+  if (lead < 0x80) return false;
+  const need = lead < 0xe0 ? 1 : lead < 0xf0 ? 2 : 0;
+  return need > cont;
+}
+
+/** True when the bytes hold a four-byte GB18030 sequence whose linear pointer is outside both defined ranges. */
+function gb18030OutOfRange(bytes) {
+  for (let i = 0; i + 3 < bytes.length; i++) {
+    const [a, b, c, d] = [bytes[i], bytes[i + 1], bytes[i + 2], bytes[i + 3]];
+    if (a >= 0x81 && a <= 0xfe && b >= 0x30 && b <= 0x39 && c >= 0x81 && c <= 0xfe && d >= 0x30 && d <= 0x39) {
+      const ptr = (a - 0x81) * 12600 + (b - 0x30) * 1260 + (c - 0x81) * 10 + (d - 0x30);
+      if ((ptr > 39419 && ptr < 189000) || ptr > 1237575) return true;
+    }
+  }
+  return false;
+}
+
+export function known(where, ctx) {
+  if (lifted) return "";
+  const enc = ctx.enc ?? "";
+  if (where === "decode" || where === "stream-decode" || where === "python-decode") {
+    // iconv-lite/1: a CESU-8 stream ending in an incomplete sequence decodes to "0" + U+FFFD
+    if (enc === "cesu8" && ctx.bytes && cesu8Truncated(ctx.bytes)) return "iconv-lite/1";
+    // iconv-lite/3: a UTF-7 base64 run of length 1 mod 4 loses the characters decoded before its bad tail
+    if ((enc === "utf7" || enc === "utf7imap") && ctx.bytes) {
+      const runs = enc === "utf7" ? utf7Runs(ctx.bytes, "+", "") : utf7Runs(ctx.bytes, "&", ",");
+      if (runs.some((r) => r.length % 4 === 1)) return "iconv-lite/3";
+    }
+  }
+  if (where === "python-decode") {
+    // iconv-lite/6: a multi-byte sequence truncated at the end of input is re-parsed byte by
+    // byte after the first, so a GB18030 four-byte or EUC-JP three-byte tail yields extra characters
+    if (enc === "gb18030" && ctx.bytes && /(?:[\x81-\xfe][\x30-\x39][\x81-\xfe]?)$/.test(Buffer.from(ctx.bytes).toString("latin1"))) return "iconv-lite/6";
+    if (enc === "eucjp" && ctx.bytes && /\x8f[\xa1-\xfe]$/.test(Buffer.from(ctx.bytes).toString("latin1"))) return "iconv-lite/6";
+    // iconv-lite/7: a GB18030 four-byte sequence outside the defined ranges decodes to arbitrary
+    // code points or lone surrogates instead of U+FFFD
+    if (enc === "gb18030" && ctx.bytes && gb18030OutOfRange(ctx.bytes)) return "iconv-lite/7";
+  }
+  if (where === "stream-decode") {
+    // iconv-lite/2: a multi-byte decoder loses characters when a chunk boundary falls inside a
+    // sequence that turns out invalid (the output buffer is sized for the new chunk only)
+    // (a bad sequence re-parsed, or an astral character, both worth more output than the chunk)
+    if (DBCS.includes(enc) && ctx.text && /[\ufffd\ud800-\udfff]/.test(ctx.text)) return "iconv-lite/2";
+  }
+  if (where === "stream-encode") {
+    // iconv-lite/4: the hex encoder is stateless, so an odd-length chunk loses a nibble
+    if (enc === "hex" && ctx.parts && ctx.parts.some((p) => p.length % 2 === 1)) return "iconv-lite/4";
+  }
+  if (where === "encode" || where === "python-encode") {
+    // iconv-lite/5: a single-byte encoder maps U+FFFD to the code page's undefined byte, not "?"
+    if (ctx.text && ctx.text.includes(REPL) && ctx.sbcs) return "iconv-lite/5";
+  }
+  return "";
+}
diff --git a/hegel/oracle.py b/hegel/oracle.py
new file mode 100644
index 0000000..609519e
--- /dev/null
+++ b/hegel/oracle.py
@@ -0,0 +1,112 @@
+# Hegel zoo: the Python `codecs` oracle for iconv-lite. Reads one JSON request per line from the
+# request FIFO and writes one JSON answer per line to the response FIFO (see hegel/enc.mjs).
+# Bytes travel as base64; text as JSON strings (lone surrogates escaped as \uXXXX).
+#
+#   {"op": "decode", "enc": e, "b64": s, "errors": "replace"|"strict"}
+#       -> {"ok": true, "text": t} or {"ok": false, "error": msg}
+#   {"op": "encode", "enc": e, "text": t, "errors": "replace"|"strict"}
+#       -> {"ok": true, "b64": s} or {"ok": false, "error": msg}
+#   {"op": "table", "enc": e, "prefix": [bytes...], "lo": a, "hi": b}
+#       -> {"cells": [t or null for each byte a..hi-1 appended to prefix]}   (decode, strict; null = invalid)
+#   {"op": "cells", "enc": e, "seqs": [hex strings]} -> {"cells": [t or null]}   (decode, strict)
+#   {"op": "enctable", "enc": e}
+#       -> {"cells": {hex code point: hex bytes}} for every BMP code point the codec can encode
+#   {"op": "cesu8", "dir": "encode", "units": [code units]} -> {"b64": s}
+#   {"op": "cesu8", "dir": "decode", "b64": s} -> {"ok": true, "units": [...]} or {"ok": false}
+
+import base64
+import codecs
+import json
+import sys
+
+
+def b64(b):
+    return base64.b64encode(b).decode("ascii")
+
+
+def unb64(s):
+    return base64.b64decode(s)
+
+
+def decode(req):
+    try:
+        return {"ok": True, "text": unb64(req["b64"]).decode(req["enc"], req.get("errors", "replace"))}
+    except Exception as e:  # noqa: BLE001
+        return {"ok": False, "error": type(e).__name__ + ": " + str(e)[:200]}
+
+
+def encode(req):
+    try:
+        return {"ok": True, "b64": b64(req["text"].encode(req["enc"], req.get("errors", "replace")))}
+    except Exception as e:  # noqa: BLE001
+        return {"ok": False, "error": type(e).__name__ + ": " + str(e)[:200]}
+
+
+def table(req):
+    prefix = bytes(req.get("prefix", []))
+    cells = []
+    for byte in range(req.get("lo", 0), req.get("hi", 256)):
+        try:
+            cells.append((prefix + bytes([byte])).decode(req["enc"]))
+        except Exception:  # noqa: BLE001
+            cells.append(None)
+    return {"cells": cells}
+
+
+def cells(req):
+    out = []
+    for h in req["seqs"]:
+        try:
+            out.append(bytes.fromhex(h).decode(req["enc"]))
+        except Exception:  # noqa: BLE001
+            out.append(None)
+    return {"cells": out}
+
+
+def enctable(req):
+    cells = {}
+    for cp in range(0x80, 0x10000):
+        if 0xD800 <= cp < 0xE000:
+            continue
+        try:
+            cells["%x" % cp] = chr(cp).encode(req["enc"]).hex()
+        except Exception:  # noqa: BLE001
+            pass
+    return {"cells": cells}
+
+
+def cesu8(req):
+    if req["dir"] == "encode":
+        out = b"".join(chr(u).encode("utf-8", "surrogatepass") for u in req["units"])
+        return {"b64": b64(out)}
+    try:
+        text = unb64(req["b64"]).decode("utf-8", "surrogatepass")
+    except Exception as e:  # noqa: BLE001
+        return {"ok": False, "error": str(e)[:200]}
+    # a valid CESU-8 stream never holds a 4-byte sequence: those are UTF-8, not CESU-8
+    if any(ord(c) > 0xFFFF for c in text):
+        return {"ok": False, "error": "four-byte sequence"}
+    return {"ok": True, "units": [ord(c) for c in text]}
+
+
+OPS = {"decode": decode, "encode": encode, "table": table, "cells": cells, "enctable": enctable, "cesu8": cesu8}
+
+
+def main():
+    req_path, resp_path = sys.argv[1], sys.argv[2]
+    with open(req_path, "r", encoding="utf-8") as req, open(resp_path, "w", encoding="utf-8") as resp:
+        for line in req:
+            line = line.strip()
+            if not line:
+                continue
+            r = json.loads(line)
+            try:
+                answer = OPS[r["op"]](r)
+            except Exception as e:  # noqa: BLE001
+                answer = {"ok": False, "error": "oracle: " + type(e).__name__ + ": " + str(e)[:200]}
+            resp.write(json.dumps(answer, ensure_ascii=True) + "\n")
+            resp.flush()
+
+
+if __name__ == "__main__":
+    main()
