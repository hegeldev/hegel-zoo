+const TEXT_CODECS = ALL.filter((e) => e !== "base64" && e !== "hex");
+const BOM = "﻿";
+
+function decodeStream(enc, parts, options) {
+  const d = iconv.getDecoder(enc, options);
+  let s = "";
+  for (const p of parts) s += d.write(p);
+  const t = d.end();
+  return t ? s + t : s;
+}
+
+function encodeStream(enc, parts, options) {
+  const e = iconv.getEncoder(enc, options);
+  const out = [];
+  for (const p of parts) out.push(e.write(p));
+  const t = e.end();
+  if (t && t.length) out.push(t);
+  return Buffer.concat(out);
+}
+
+function noLone(s) {
+  return !/[\ud800-\udbff](?![\udc00-\udfff])|(?<![\ud800-\udbff])[\udc00-\udfff]/.test(s);
+}
+
+// ------------------------------------------------------------------ round trips
+
+property("TestHegelRoundTripsThroughEveryEncoding", (tc) => {
+  const enc = pick(tc, TEXT_CODECS);
+  const s = UNICODE.includes(enc) ? genUnicodeText(tc, { lone: false, hi: 16 }) : genText(tc, enc, { strangers: 0, hi: 16 });
+  count(DBCS.includes(enc) ? "dbcs" : UNICODE.includes(enc) ? "unicode" : "sbcs");
+  const bom = BOM_AWARE.includes(enc) && chance(tc, 25);
+  const bytes = iconv.encode(s, enc, bom ? { addBOM: true } : undefined);
+  assert.ok(Buffer.isBuffer(bytes), `encode(${enc}) must return a Buffer`);
+  // (without addBOM a leading U+FEFF of s itself would be taken for a BOM and stripped: keep it)
+  const auto = enc === "utf16" || enc === "utf32"; // these add a BOM by default
+  const back = iconv.decode(bytes, enc, bom || auto ? undefined : { stripBOM: false });
+  if (back !== s) {
+    fail(`${enc}: decode(encode(s)) differs\n  s=${show(s)}\n  bytes=${hex(bytes)}\n  back=${show(back)}`);
+  }
+  if (bom) {
+    const kept = iconv.decode(bytes, enc, { stripBOM: false });
+    if (kept !== BOM + s) fail(`${enc}: stripBOM:false must keep the BOM: ${show(kept)} for ${show(s)}`);
+  }
+  // the internal hex codec: bytes <-> their hex text
+  const h = hex(junkBytes(tc, 6));
+  const hb = iconv.encode(h, "hex");
+  if (iconv.decode(hb, "hex") !== h) fail(`hex round trip: ${h} -> ${hex(hb)} -> ${iconv.decode(hb, "hex")}`);
+});
+
+// ------------------------------------------------------------------ streaming == one-shot
+
+property("TestHegelStreamingMatchesOneShot", (tc) => {
+  const enc = pick(tc, ALL);
+  if (chance(tc, 55)) {
+    // decoding: valid, mutated or junk bytes, maybe a BOM in front, in random chunks
+    let bytes;
+    const s = UNICODE.includes(enc) ? genUnicodeText(tc, { lone: true }) : genText(tc, enc);
+    if (enc === "hex") bytes = junkBytes(tc, 8);
+    else if (enc === "base64") bytes = junkBytes(tc, 8);
+    else if (chance(tc, 40)) { bytes = iconv.encode(s, enc); count("valid"); }
+    else if (chance(tc, 70)) { bytes = mutateBytes(tc, iconv.encode(s, enc)); count("mutated"); }
+    else { bytes = junkBytes(tc, 16); count("junk"); }
