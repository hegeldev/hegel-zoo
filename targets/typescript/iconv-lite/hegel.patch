+      ? iconv.decode(streamed, enc) === iconv.decode(once, enc) // the UTF-7 encoder is stateless: runs differ, text agrees
+      : streamed.equals(once);
+    if (!agree) {
+      const k = known("stream-encode", { enc, parts });
+      if (k) { count(k); return; }
+      fail(`${enc}: streamed encode differs from one-shot\n  s=${show(s)} chunks=${show(parts)}\n  once=${hex(once)}\n  streamed=${hex(streamed)}`);
+    }
+  }
+});
