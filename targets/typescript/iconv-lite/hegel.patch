+    const once = iconv.decode(bytes, enc, options);
+    const parts = chunks(tc, bytes);
+    const streamed = decodeStream(enc, parts, options);
+    if (streamed !== once) {
+      const k = known("stream-decode", { enc, bytes, text: once });
+      if (k) { count(k); return; }
+      fail(`${enc}: streamed decode differs from one-shot\n  bytes=${hex(bytes)} chunks=${show(parts.map(hex))}\n  once=${show(once)}\n  streamed=${show(streamed)}`);
+    }
+  } else {
+    // encoding: text in random string chunks (surrogate pairs may be split)
+    let s;
+    if (enc === "hex") s = hex(junkBytes(tc, 6));
+    else if (enc === "base64") s = junkBytes(tc, 8).toString("base64");
+    else s = UNICODE.includes(enc) || chance(tc, 30) ? genUnicodeText(tc, { lone: true }) : genText(tc, enc);
