index 0000000..0cfda39
--- /dev/null
+++ b/hegel/enc.mjs
@@ -0,0 +1,338 @@
+// Hegel zoo: the Python codecs oracle bridge, the library under test, the encoding lists with
+// their Python names, the table-agreement sets (cells where iconv-lite's tables and Python's
+// disagree are recorded, not judged), and the generators (text biased to an encoding's
+// repertoire, byte strings valid or noisy, chunkings).
+
+import { execFileSync, spawn } from "node:child_process";
+import { mkdtempSync, openSync, readSync, rmSync, writeSync } from "node:fs";
+import { createRequire } from "node:module";
+import { tmpdir } from "node:os";
+import { dirname, join } from "node:path";
+import { StringDecoder } from "node:string_decoder";
+import { fileURLToPath } from "node:url";
+import { chance, count, n, pick } from "./hegel-zoo.mjs";
+
+const here = dirname(fileURLToPath(import.meta.url));
+const require = createRequire(import.meta.url);
+
+// The library under test (CommonJS, the Node backend).
+export const iconv = require("../lib/index-node.js");
+const encodingsModule = require("../encodings");
+
+// ---------------------------------------------------------------- the oracle, held open
+
+let oracle = null;
+
+function startOracle() {
+  execFileSync("python3", ["-c", "import codecs"], { stdio: "ignore" });
+  const dir = mkdtempSync(join(tmpdir(), "hegel-iconv-"));
+  const req = join(dir, "req");
+  const resp = join(dir, "resp");
+  execFileSync("mkfifo", [req, resp]);
+  const child = spawn("python3", ["-u", join(here, "oracle.py"), req, resp], {
+    stdio: ["ignore", "inherit", "inherit"],
+  });
+  child.unref();
+  const wfd = openSync(req, "w");
+  const rfd = openSync(resp, "r");
+  process.on("exit", () => {
+    try { child.kill(); } catch {}
+    try { rmSync(dir, { recursive: true, force: true }); } catch {}
+  });
+  const buf = Buffer.alloc(1 << 16);
+  const utf8 = new StringDecoder("utf8");
+  let pending = "";
+  return {
+    call(obj) {
+      const line = JSON.stringify(obj).replace(/[\ud800-\udfff]/g, (c) => "\\u" + c.charCodeAt(0).toString(16).padStart(4, "0"));
+      writeSync(wfd, line + "\n");
+      for (;;) {
+        const nl = pending.indexOf("\n");
+        if (nl !== -1) {
+          const answer = pending.slice(0, nl);
+          pending = pending.slice(nl + 1);
+          return JSON.parse(answer);
+        }
+        const got = readSync(rfd, buf, 0, buf.length, null);
+        if (got === 0) throw new Error("the codecs oracle went away");
+        pending += utf8.write(buf.subarray(0, got));
+      }
+    },
+  };
+}
+
+export function py(obj) {
+  oracle ??= startOracle();
+  return oracle.call(obj);
+}
+
+/** Python's decode with errors=replace (or strict): {ok, text|error}. */
+export function pyDecode(pyEnc, bytes, errors = "replace") {
+  return py({ op: "decode", enc: pyEnc, b64: Buffer.from(bytes).toString("base64"), errors });
+}
+
+/** Python's encode with errors=replace (or strict): {ok, bytes|error}. */
+export function pyEncode(pyEnc, text, errors = "replace") {
+  const r = py({ op: "encode", enc: pyEnc, text, errors });
+  if (r.ok) r.bytes = Buffer.from(r.b64, "base64");
+  return r;
+}
+
+// ---------------------------------------------------------------- the encodings
+
+/** iconv-lite name -> Python codec name (null: Python has none). */
+const PY_NAMES = {
+  utf8: "utf-8", utf16le: "utf-16-le", utf16be: "utf-16-be", utf16: "utf-16",
+  utf32le: "utf-32-le", utf32be: "utf-32-be", utf32: "utf-32", utf7: "utf-7",
+  cesu8: null, utf7imap: null, binary: "latin-1", base64: null, hex: null,
+  ascii: "ascii", windows874: "cp874", maccenteuro: "mac_latin2", maccroatian: "mac_croatian",
+  maccyrillic: "mac_cyrillic", macgreek: "mac_greek", maciceland: "mac_iceland", macroman: "mac_roman",
+  macromania: "mac_romanian", macturkish: "mac_turkish", macintosh: "mac_roman", koi8r: "koi8_r",
+  koi8u: "koi8_u", koi8t: "koi8_t", rk1048: "kz1048", pt154: "ptcp154", tis620: "tis_620",
+  shiftjis: "cp932", eucjp: "euc_jp", cp936: "cp936", gbk: "gbk", gb18030: "gb18030",
+  cp949: "cp949", cp950: "cp950", big5hkscs: "big5hkscs",
+  cp808: null, mik: null, cp922: null, cp1046: null, cp1124: null, cp1129: null, cp1133: null,
+  cp1161: null, cp1162: null, cp1163: null, macthai: null, macukraine: null, koi8ru: null,
+  armscii8: null, tcvn: null, georgianacademy: null, georgianps: null, viscii: null,
+  iso646cn: null, iso646jp: null, hproman8: null,
+};
+
+export function pyName(enc) {
+  if (enc in PY_NAMES) return PY_NAMES[enc];
+  if (enc.startsWith("windows")) return "cp" + enc.slice(7);
+  if (enc.startsWith("iso8859")) return "iso8859_" + enc.slice(7);
+  if (/^cp\d+$/.test(enc)) return enc;
+  return null;
+}
+
+/** Every codec's canonical iconv-lite name (not the aliases), by family. */
+export const ALL = Object.keys(encodingsModule).filter((k) => typeof encodingsModule[k] !== "string" && !k.startsWith("_"));
+export const UNICODE = ["utf8", "utf16le", "utf16be", "utf16", "utf32le", "utf32be", "utf32", "utf7", "utf7imap", "cesu8"];
+export const INTERNAL = ["binary", "base64", "hex"];
+export const DBCS = ["shiftjis", "eucjp", "cp936", "gbk", "gb18030", "cp949", "cp950", "big5hkscs"];
+export const SBCS = ALL.filter((e) => !UNICODE.includes(e) && !INTERNAL.includes(e) && !DBCS.includes(e));
+/** The codecs iconv-lite marks bomAware. */
+export const BOM_AWARE = ALL.filter((e) => iconv.getCodec(e).bomAware);
+/** All aliases, for the label properties. */
+export const ALIASES = Object.keys(encodingsModule).filter((k) => !k.startsWith("_"));
+
+export const REPL = "�";
+
+// ---------------------------------------------------------------- table agreement
+
+const cellCache = new Map();
+
+/** Python's strict decode of prefix+byte for every byte (null = invalid), from the oracle. */
+function pyCells(pyEnc, seqs) {
+  return py({ op: "cells", enc: pyEnc, seqs: seqs.map((s) => Buffer.from(s).toString("hex")) }).cells;
+}
+
+function iconvCell(enc, bytes) {
+  const s = iconv.decode(Buffer.from(bytes), enc);
+  return s.includes(REPL) ? null : s;
+}
+
+/**
+ * For a multi-byte encoding: the set of byte sequences (hex) on which iconv-lite's tables and
+ * Python's disagree (one decodes what the other does not, or to a different character), for
+ * single bytes >= 0x80, all two-byte sequences with a lead >= 0x80, EUC-JP's 0x8F three-byte
+ * plane, and GB18030's four-byte BMP plane (0x81-0x84).
+ */
+export function disagreeingCells(enc) {
+  if (cellCache.has(enc)) return cellCache.get(enc);
+  const pyEnc = pyName(enc);
+  const set = new Set();
+  const compare = (seqs) => {
+    const theirs = pyCells(pyEnc, seqs);
+    seqs.forEach((seq, i) => {
+      if (iconvCell(enc, seq) !== theirs[i]) set.add(Buffer.from(seq).toString("hex"));
+    });
+  };
+  const singles = [];
+  for (let b = 0x80; b < 256; b++) singles.push([b]);
+  compare(singles);
+  for (let lead = 0x80; lead < 256 && DBCS.includes(enc); lead++) {
+    const seqs = [];
+    for (let t = 0; t < 256; t++) seqs.push([lead, t]);
+    compare(seqs);
+  }
+  if (enc === "eucjp") {
+    for (let second = 0xa1; second <= 0xfe; second++) {
+      const seqs = [];
+      for (let t = 0xa1; t <= 0xfe; t++) seqs.push([0x8f, second, t]);
+      compare(seqs);
+    }
+  }
+  if (enc === "gb18030") {
+    for (let first = 0x81; first <= 0x84; first++) {
+      for (let second = 0x30; second <= 0x39; second++) {
+        const seqs = [];
+        for (let third = 0x81; third <= 0xfe; third++) for (let fourth = 0x30; fourth <= 0x39; fourth++) seqs.push([first, second, third, fourth]);
+        compare(seqs);
+      }
+    }
+  }
+  cellCache.set(enc, set);
+  return set;
+}
+
+/** True when some 1-4 byte window of `bytes` is a cell the two tables disagree on. */
+export function touchesDisagreement(enc, bytes) {
+  const set = disagreeingCells(enc);
+  if (set.size === 0) return false;
+  for (let i = 0; i < bytes.length; i++) {
+    for (let len = 1; len <= 4 && i + len <= bytes.length; len++) {
+      if (set.has(Buffer.from(bytes.subarray(i, i + len)).toString("hex"))) return true;
+    }
+  }
+  return false;
+}
+
+const encCache = new Map();
+
+/** For an encoding with a Python codec: the set of BMP characters the two encoders disagree on. */
+export function disagreeingChars(enc) {
+  if (encCache.has(enc)) return encCache.get(enc);
+  const theirs = py({ op: "enctable", enc: pyName(enc) }).cells;
+  const set = new Set();
+  for (let cp = 0x80; cp < 0x10000; cp++) {
+    if (cp >= 0xd800 && cp < 0xe000) continue;
+    const ch = String.fromCharCode(cp);
+    const mine = iconv.encode(ch, enc);
+    const mineHex = mine.length === 1 && mine[0] === 0x3f ? undefined : mine.toString("hex");
+    if (mineHex !== theirs[cp.toString(16)]) set.add(ch);
+  }
+  encCache.set(enc, set);
+  return set;
+}
+
+// ---------------------------------------------------------------- generators
+
+const ASCII = "abcXYZ019 \t\n\r+-/,.=&%~?!:;'\"()[]{}<>|\\@#$^_`*";
+const INTERESTING = ["␀", "", "", " ", "é", "ÿ", "Ā", "߿", "ࠀ", "あ", "中", "퟿", "", "﻿", "�", "￾", "￿", "\u{10000}", "\u{1f600}", "\u{10ffff}", " ", "​", "́", "̄"];
+
+/** A random Unicode code point (BMP-biased), or a lone surrogate when `lone` allows. */
+export function codePoint(tc, { lone = false } = {}) {
+  const r = n(tc, 0, 99);
+  if (r < 30) return ASCII.charCodeAt(n(tc, 0, ASCII.length - 1));
+  if (r < 45) return n(tc, 0x80, 0x7ff);
+  if (r < 70) return n(tc, 0x800, 0xd7ff);
+  if (r < 80) return n(tc, 0xe000, 0xffff);
+  if (r < 90) return n(tc, 0x10000, 0x10ffff);
+  if (lone && r < 95) return n(tc, 0xd800, 0xdfff);
+  return INTERESTING[n(tc, 0, INTERESTING.length - 1)].codePointAt(0);
+}
+
+/** Unicode text: code points (and lone surrogates when allowed), 0..hi long. */
+export function genUnicodeText(tc, { lone = false, lo = 0, hi = 12 } = {}) {
+  const len = n(tc, lo, hi);
+  let s = "";
+  for (let i = 0; i < len; i++) {
+    const cp = codePoint(tc, { lone });
+    s += cp >= 0xd800 && cp <= 0xdfff ? String.fromCharCode(cp) : String.fromCodePoint(cp);
+  }
+  return s;
+}
+
+/** A character the encoding can represent, found by decoding a random valid byte sequence. */
+export function repertoireChar(tc, enc) {
+  for (let tries = 0; tries < 8; tries++) {
+    let bytes;
+    if (DBCS.includes(enc)) {
+      if (chance(tc, 25)) bytes = [n(tc, 0, 0x7f)];
+      else if (enc === "gb18030" && chance(tc, 15)) bytes = [n(tc, 0x81, 0x84), n(tc, 0x30, 0x39), n(tc, 0x81, 0xfe), n(tc, 0x30, 0x39)];
+      else if (enc === "gb18030" && chance(tc, 10)) bytes = [n(tc, 0x90, 0xe3), n(tc, 0x30, 0x39), n(tc, 0x81, 0xfe), n(tc, 0x30, 0x39)];
+      else if (enc === "eucjp" && chance(tc, 15)) bytes = [0x8f, n(tc, 0xa1, 0xfe), n(tc, 0xa1, 0xfe)];
+      else if (enc === "eucjp" && chance(tc, 10)) bytes = [0x8e, n(tc, 0xa1, 0xdf)];
+      else bytes = [n(tc, 0x81, 0xfe), n(tc, 0x40, 0xfe)];
+    } else if (UNICODE.includes(enc)) {
+      return String.fromCodePoint(codePoint(tc));
+    } else {
+      bytes = [n(tc, 0, 255)];
+    }
+    const s = iconv.decode(Buffer.from(bytes), enc);
+    // Shift_JIS decodes its user-defined area (0xF040-0xF9FC) to private-use characters that it
+    // does not encode (WHATWG's index has no pointers for them): not part of the repertoire
+    if (enc === "shiftjis" && /[\ue000-\uf8ff]/.test(s)) continue;
+    if (s.length > 0 && !s.includes(REPL)) return s;
+  }
+  return pick(tc, ["a", " ", "0"]);
+}
+
+/** Text in the encoding's repertoire (mostly), with some ASCII and a few strangers. */
+export function genText(tc, enc, { lo = 0, hi = 12, strangers = 10 } = {}) {
+  const len = n(tc, lo, hi);
+  let s = "";
+  for (let i = 0; i < len; i++) {
+    if (chance(tc, strangers)) s += String.fromCodePoint(codePoint(tc));
+    else s += repertoireChar(tc, enc);
+  }
+  return s;
+}
+
+/** Split a buffer into random chunks (some empty), as an array of Buffers. */
+export function chunks(tc, buf) {
+  const out = [];
+  let i = 0;
+  let empties = 0;
+  while (i < buf.length) {
+    const len = empties < 2 && chance(tc, 10) ? 0 : n(tc, 1, Math.min(buf.length - i, chance(tc, 50) ? 3 : 20));
+    empties = len === 0 ? empties + 1 : 0;
+    out.push(buf.subarray(i, i + len));
+    i += len;
+  }
+  if (chance(tc, 20)) out.push(buf.subarray(buf.length));
+  if (out.length === 0) out.push(buf);
+  return out;
+}
+
+/** Split a string into random chunks (some empty), possibly inside surrogate pairs. */
+export function stringChunks(tc, s) {
+  const out = [];
+  let i = 0;
+  let empties = 0;
+  while (i < s.length) {
+    const len = empties < 2 && chance(tc, 10) ? 0 : n(tc, 1, Math.min(s.length - i, chance(tc, 50) ? 2 : 10));
+    empties = len === 0 ? empties + 1 : 0;
+    out.push(s.slice(i, i + len));
+    i += len;
+  }
+  if (out.length === 0) out.push(s);
+  return out;
+}
+
+/** Random mutation of a byte string: insert, delete, replace or duplicate a few bytes. */
+export function mutateBytes(tc, buf) {
+  const bytes = Array.from(buf);
+  const ops = n(tc, 1, 3);
+  for (let k = 0; k < ops; k++) {
+    const i = n(tc, 0, bytes.length);
+    const b = chance(tc, 50) ? n(tc, 0x80, 0xff) : pick(tc, [0x00, 0x20, 0x2b, 0x2d, 0x26, 0x3f, 0x41, 0x7f, 0x80, 0x81, 0x8e, 0x8f, 0xa0, 0xc0, 0xe0, 0xed, 0xef, 0xf0, 0xfe, 0xff]);
+    switch (n(tc, 0, 3)) {
+      case 0: bytes.splice(i, 0, b); break;
+      case 1: if (bytes.length) bytes.splice(Math.min(i, bytes.length - 1), 1); break;
+      case 2: if (bytes.length) bytes[Math.min(i, bytes.length - 1)] = b; break;
+      default: if (bytes.length) bytes.splice(i, 0, bytes[Math.min(i, bytes.length - 1)]);
+    }
+  }
+  return Buffer.from(bytes);
+}
+
+/** Random bytes, biased to the encoding's structure. */
+export function junkBytes(tc, hi = 12) {
+  const len = n(tc, 0, hi);
+  const out = [];
+  for (let i = 0; i < len; i++) out.push(chance(tc, 40) ? n(tc, 0, 0x7f) : n(tc, 0x80, 0xff));
+  return Buffer.from(out);
+}
+
+/** Collapse each run of U+FFFD to one, for comparisons across replacement-counting styles. */
+export function collapse(s) {
+  return s.replace(/�+/g, REPL);
+}
+
+export function hex(buf) {
+  return Buffer.from(buf).toString("hex");
+}
+
+export { count };
diff --git a/hegel/hegel-zoo.mjs b/hegel/hegel-zoo.mjs
new file mode 100644
index 0000000..1ca6f10
--- /dev/null
+++ b/hegel/hegel-zoo.mjs
@@ -0,0 +1,163 @@
+// Hegel zoo: the small harness shared by the zoo's TypeScript/JavaScript targets.
+//
+// `property(name, body)` registers a node:test test that runs `body(tc)` under Hegel with
+// HEGEL_TEST_CASES cases (default 100) and the database at HEGEL_DATABASE. With ZOO_COLLECT=1
+// a `fail()` records the mismatch instead of failing, the case ends there, and the counts of
+// mismatches and of the shapes seen (`count(key)`) are printed at the end of the test, so a
+// property can be run over many cases to see every shape at once. `pin(name, body)` is a
+// plain test for one pinned bug: it must fail while the bug is present and pass once it is
+// fixed (the zoo's judge reads an unexpected pass as "fixed upstream?").
+
+import { readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+import { test as nodeTest } from "node:test";
+
+// The Hegel version these tests were written against (the zoo pins it in zoo.toml; upstream
+// would add it to devDependencies). Hegel and esbuild are installed with `npm install --prefix
+// .hegel` so the target's own package.json and lock file stay untouched. Checked at load time so
+// a stray install cannot silently change the engine.
+export const HEGEL_PIN = { "@hegeldev/hegel": "0.4.5" };
+
+const hegelDir = join(dirname(fileURLToPath(import.meta.url)), "..", ".hegel", "node_modules", "@hegeldev", "hegel");
+{
+  const installed = JSON.parse(readFileSync(join(hegelDir, "package.json"), "utf8")).version;
+  if (installed !== HEGEL_PIN["@hegeldev/hegel"]) {
+    throw new Error(`@hegeldev/hegel ${installed} is installed; these tests pin ${HEGEL_PIN["@hegeldev/hegel"]}`);
+  }
+}
+const hegel = await import(pathToFileURL(join(hegelDir, "dist", "index.js")));
+const gs = await import(pathToFileURL(join(hegelDir, "dist", "generators", "index.js")));
+
+export const collecting = !!process.env.ZOO_COLLECT;
+
+class Collected extends Error {}
+
+let msgs = [];
+let stats = new Map();
+
+/** Report a mismatch: an error normally, a recorded line in collect mode. */
+export function fail(message) {
+  if (collecting) {
+    msgs.push(message);
+    throw new Collected(message);
+  }
+  throw new Error(message);
+}
+
+/** Bump a statistic (the shape of a pinned bug, a generator branch). */
+export function count(key) {
+  stats.set(key, (stats.get(key) || 0) + 1);
+}
+
+function settings() {
+  const s = { testCases: Number(process.env.HEGEL_TEST_CASES) || 100 };
+  if (process.env.HEGEL_DATABASE) {
+    s.database = hegel.Database.fromPath(process.env.HEGEL_DATABASE);
+  }
+  return s;
+}
+
+/** A property: `body(tc)` runs under Hegel; a thrown error (or `fail`) is a failure. */
+export function property(name, body) {
+  nodeTest(name, () => {
+    msgs = [];
+    stats = new Map();
+    hegel.test((tc) => {
+      try {
+        body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** An async property: `body(tc)` may await; runs under Hegel's testAsync with the same settings. */
+export function propertyAsync(name, body) {
+  nodeTest(name, async () => {
+    msgs = [];
+    stats = new Map();
+    await hegel.testAsync(async (tc) => {
+      try {
+        await body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** A pin: a plain test for one recorded bug. */
+export function pin(name, body) {
+  nodeTest(name, body);
+}
+
+/** An integer in [lo, hi]. */
+export function n(tc, lo, hi) {
+  return tc.draw(gs.integers({ minValue: lo, maxValue: hi }));
+}
+
+/** One of xs. */
+export function pick(tc, xs) {
+  return xs[n(tc, 0, xs.length - 1)];
+}
+
+/** True pct percent of the time. */
+export function chance(tc, pct) {
+  return n(tc, 0, 99) < pct;
+}
+
+/** A string of `len` characters drawn from `alphabet` (an array of strings). */
+export function word(tc, alphabet, lo, hi) {
+  const len = n(tc, lo, hi);
+  let s = "";
+  for (let i = 0; i < len; i++) {
+    s += pick(tc, alphabet);
+  }
+  return s;
+}
+
+/** Structural equality: arrays by position, objects by key set (prototype ignored), else ===. */
+export function same(a, b) {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) {
+      return false;
+    }
+    return a.every((x, i) => same(x, b[i]));
+  }
+  if (a !== null && b !== null && typeof a === "object" && typeof b === "object") {
+    const ka = Object.keys(a).sort();
+    const kb = Object.keys(b).sort();
+    if (ka.length !== kb.length || ka.some((k, i) => k !== kb[i])) {
+      return false;
+    }
+    return ka.every((k) => same(a[k], b[k]));
+  }
+  return a === b;
+}
+
+/** A compact, unambiguous rendering for messages. */
+export function show(x) {
+  return JSON.stringify(x, (k, v) => (v === undefined ? "<undefined>" : v));
+}
