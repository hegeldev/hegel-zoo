+// Hegel zoo: iconv-lite's codecs against Python's codecs module, their own round trips, and
+// their streaming forms. Run with `node --test --test-reporter=tap hegel/hegel.test.mjs`
+// (Hegel installed under .hegel/). ZOO_COLLECT=1 counts mismatches instead of failing;
+// HEGEL_TEST_CASES widens the sweep; ZOO_NO_KNOWN=1 lifts the gates of hegel/known.mjs.
+
+import assert from "node:assert/strict";
+import { Readable } from "node:stream";
+import { chance, count, fail, n, pick, pin, property, propertyAsync, show } from "./hegel-zoo.mjs";
