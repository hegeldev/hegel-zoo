+++ b/hegel/gen.mjs
@@ -0,0 +1,627 @@
+// Generators and the model for the mutative properties.
+//
+// A base state is a tree of plain objects, arrays, Maps and Sets over primitive leaves (numbers
+// including -0 and NaN, strings, booleans, null, undefined, bigints) and Dates (atomic, never
+// drafted). A script is a list of ordinary JavaScript operations on that tree, each addressed by
+// a path from the root; `exec(root, op)` performs the operation on whatever `root` is - a plain
+// clone (the model), a mutative draft or an immer draft - so the three see the same mutations.
+// Ops are generated against the live model, so indexes and keys are always valid at the moment
+// they are drawn, and are then replayed on the drafts.
+
+import { n, pick, chance } from "./hegel-zoo.mjs";
+
+export const KEYS = ["a", "b", "c", "d", "0", "1", "x y", "~/", ""];
+export const STRINGS = ["", "a", "b", "0", "1", "hello", "~/", "x y"];
+export const NUMBERS = [0, -0, 1, -1, 2, 7, 1.5, -2.5, 1e21, 2 ** 53, NaN, Infinity, -Infinity];
+
+/** A primitive (or Date) leaf. */
+export function genLeaf(tc) {
+  switch (n(tc, 0, 9)) {
+    case 0: return pick(tc, STRINGS);
+    case 1: return pick(tc, STRINGS);
+    case 2: return pick(tc, NUMBERS);
+    case 3: return pick(tc, NUMBERS);
+    case 4: return n(tc, -3, 3);
+    case 5: return chance(tc, 50);
+    case 6: return null;
+    case 7: return undefined;
+    case 8: return new Date(n(tc, 0, 2_000_000_000) * 1000);
+    default: return BigInt(n(tc, -5, 5));
+  }
+}
+
+/** A leaf or, with depth left, a container. */
+export function genValue(tc, depth) {
+  if (depth <= 0 || chance(tc, 35)) {
+    return genLeaf(tc);
+  }
+  return genContainer(tc, depth);
+}
+
+/** A container: object, array, Map or Set. */
+export function genContainer(tc, depth) {
+  if (classy && chance(tc, 25)) {
+    return new Pt(genValue(tc, depth - 1), genValue(tc, depth - 1));
+  }
+  switch (n(tc, 0, 5)) {
+    case 0:
+    case 1: {
+      const o = {};
+      const k = n(tc, 0, 4);
+      for (let i = 0; i < k; i++) {
+        o[pick(tc, KEYS)] = genValue(tc, depth - 1);
+      }
+      return o;
+    }
+    case 2:
+    case 3: {
+      const a = [];
+      const k = n(tc, 0, 4);
+      for (let i = 0; i < k; i++) {
+        a.push(genValue(tc, depth - 1));
+      }
+      return a;
+    }
+    case 4: {
+      const m = new Map();
+      const k = n(tc, 0, 3);
+      for (let i = 0; i < k; i++) {
+        m.set(genMapKey(tc), genValue(tc, depth - 1));
+      }
+      return m;
+    }
+    default: {
+      const s = new Set();
+      const k = n(tc, 0, 3);
+      for (let i = 0; i < k; i++) {
+        s.add(chance(tc, 50) ? genLeaf(tc) : genValue(tc, depth - 1));
+      }
+      return s;
+    }
+  }
+}
+
+/** A Map key: mostly strings and numbers, sometimes a boolean/null/undefined. */
+export function genMapKey(tc) {
+  switch (n(tc, 0, 5)) {
+    case 0:
+    case 1:
+    case 2: return pick(tc, KEYS);
+    case 3: return n(tc, 0, 3);
+    case 4: return pick(tc, [true, false, null, undefined, -0, NaN]);
+    default: return pick(tc, STRINGS);
+  }
+}
+
+/** A base state: always a container at the root. */
+export function genBase(tc) {
+  return genContainer(tc, n(tc, 1, 4));
+}
+
+/** A class instance for the `mark` properties: drafted only when marked immutable/immerable. */
+export class Pt {
+  constructor(x, y) {
+    this.x = x;
+    this.y = y;
+  }
+}
+
+let classy = false;
+/** Let genContainer produce Pt instances (holding two values). */
+export function setClassy(flag) {
+  classy = flag;
+}
+
+/** A fresh copy of a template value (Dates copied, structure copied, identities new). */
+export function materialize(v) {
+  if (v === null || typeof v !== "object") return v;
+  if (v instanceof Date) return new Date(v.getTime());
+  if (Array.isArray(v)) return v.map(materialize);
+  if (v instanceof Map) return new Map([...v].map(([k, x]) => [materialize(k), materialize(x)]));
+  if (v instanceof Set) return new Set([...v].map(materialize));
+  if (v instanceof Pt) return new Pt(materialize(v.x), materialize(v.y));
+  const o = {};
+  for (const k of Object.keys(v)) o[k] = materialize(v[k]);
+  return o;
+}
+
+/** Every path to a leaf (non-container) value. */
+export function leafPaths(root, limit = 80) {
+  const out = [];
+  const seen = new Set();
+  const walk = (node, path) => {
+    if (out.length >= limit || seen.has(node)) return;
+    seen.add(node);
+    for (const [s, child] of entries(node)) {
+      if (isContainer(child)) walk(child, path.concat([s]));
+      else out.push(path.concat([s]));
+    }
+  };
+  walk(root, []);
+  return out;
+}
+
+export const clone = materialize;
+
+// ---------------------------------------------------------------- paths and navigation
+
+/** True for a revoked Proxy (a draft that outlived its create): every trap throws. */
+export function isRevoked(v) {
+  if (v === null || typeof v !== "object") return false;
+  try {
+    Object.getPrototypeOf(v);
+    return false;
+  } catch (e) {
+    return true;
+  }
+}
+
+export function isContainer(v) {
+  if (isRevoked(v)) return false;
+  return v !== null && typeof v === "object" && !(v instanceof Date)
+    && (Array.isArray(v) || v instanceof Map || v instanceof Set || v instanceof Pt || Object.getPrototypeOf(v) === Object.prototype || Object.getPrototypeOf(v) === null);
+}
+
+export function kind(v) {
+  if (Array.isArray(v)) return "array";
+  if (v instanceof Map) return "map";
+  if (v instanceof Set) return "set";
+  return "object";
+}
+
+/** One step down: key for objects, index for arrays, key for Maps, iteration index for Sets. */
+export function step(node, s) {
+  switch (kind(node)) {
+    case "array": return node[s];
+    case "map": return node.get(s);
+    case "set": return [...node][s];
+    default: return node[s];
+  }
+}
+
+export function getAt(root, path) {
+  let v = root;
+  for (const s of path) {
+    if (!isContainer(v)) return undefined;
+    v = step(v, s);
+  }
+  return v;
+}
+
+/** Every container path in the tree (root first, then depth first), with an identity guard for aliases. */
+export function containerPaths(root, limit = 60) {
+  const out = [];
+  const seen = new Set();
+  const walk = (node, path) => {
+    if (out.length >= limit) return;
+    out.push(path);
+    if (seen.has(node)) return;
+    seen.add(node);
+    for (const [s, child] of entries(node)) {
+      if (isContainer(child)) walk(child, path.concat([s]));
+    }
+  };
+  walk(root, []);
+  return out;
+}
+
+/** [step, child] pairs of a container. */
+export function entries(node) {
+  switch (kind(node)) {
+    case "array": return node.map((x, i) => [i, x]);
+    case "map": return [...node.entries()];
+    case "set": return [...node].map((x, i) => [i, x]);
+    default: return Object.keys(node).map((k) => [k, node[k]]);
+  }
+}
+
+/** True when `target` is `node` or is reachable from it. */
+export function reaches(node, target, seen = new Set()) {
+  if (node === target) return true;
+  if (!isContainer(node) || seen.has(node)) return false;
+  seen.add(node);
+  return entries(node).some(([, child]) => reaches(child, target, seen));
+}
+
+function isPrefix(p, q) {
+  return p.length <= q.length && p.every((s, i) => Object.is(s, q[i]));
+}
+
+// ---------------------------------------------------------------- ops
+
+/**
+ * Draw one op against the live model (and perform it there). `allowAlias` permits ops that
+ * move a subtree of the tree to another place (a shared draft). `own(path, node)` says whether
+ * the model's `node` at `path` stands for the base's own node at that path: `restore` ops are
+ * drawn only there, where the draft drafts the member assigned back (the get trap drafts
+ * `original[key]` only). Restored anywhere else - into a container an op moved, aliased or
+ * freshly assigned - the base's member comes back from the draft undrafted, and a later op on it
+ * would write into the base itself, as plain JavaScript and immer do: outside what `create` can
+ * promise, so not drawn.
+ */
+export function genOp(tc, model, allowAlias, pristine = null, own = () => true) {
+  const paths = containerPaths(model);
+  const path = pick(tc, paths);
+  const node = getAt(model, path);
+  const k = kind(node);
+  let undef = false;
+  const value = () => {
+    const v = genValue(tc, n(tc, 0, 2));
+    if (v === undefined) undef = true;
+    return v;
+  };
+  let op;
+  // The base's node at this path, when it is a container of the same kind: `restore` ops assign
+  // one of its members (the very object of the base, for a draft) back into the tree.
+  const baseNode = pristine ? getAt(pristine, path) : undefined;
+  const restorable = isContainer(baseNode) && kind(baseNode) === k && k !== "set" && own(path, node);
+  if (restorable && chance(tc, 12)) {
+    const keys = k === "map" ? [...baseNode.keys()] : k === "array" ? baseNode.map((_, i) => i).filter((i) => i < node.length) : Object.keys(baseNode);
+    if (keys.length) {
+      op = { t: "restore", key: pick(tc, keys), path, kind: k };
+      const member = k === "map" ? baseNode.get(op.key) : baseNode[op.key];
+      if (member === undefined) op.undef = true;
+      exec(model, op, { aliasRoot: model, baseRoot: pristine, copyBase: true });
+      return op;
+    }
+  }
+  const aliasSource = () => {
+    // A container elsewhere whose subtree does not hold the target (no cycles, aliases included).
+    const cands = paths.filter((p) => !isPrefix(p, path) && !reaches(getAt(model, p), node));
+    return cands.length ? pick(tc, cands) : null;
+  };
+  const maybeAlias = (setter) => {
+    if (allowAlias && chance(tc, 25)) {
+      const src = aliasSource();
+      if (src) {
+        return { ...setter, alias: src, aliasKind: kind(getAt(model, src)), wrap: chance(tc, 30) ? pick(tc, ["object", "array"]) : null };
+      }
+    }
+    return { ...setter, value: value() };
+  };
+  switch (k) {
+    case "object": {
+      const keys = Object.keys(node);
+      switch (n(tc, 0, 5)) {
+        case 0:
+        case 1:
+        case 2: op = maybeAlias({ t: "set", key: chance(tc, 60) && keys.length ? pick(tc, keys) : pick(tc, KEYS) }); break;
+        case 3: op = { t: "delete", key: keys.length && chance(tc, 80) ? pick(tc, keys) : pick(tc, KEYS) }; break;
+        case 4: op = { t: "assign", key: pick(tc, KEYS), value: value() }; break;
+        default: op = keys.length ? { t: "setSame", key: pick(tc, keys) } : { t: "set", key: pick(tc, KEYS), value: value() }; break;
+      }
+      break;
+    }
+    case "array": {
+      const len = node.length;
+      switch (n(tc, 0, 11)) {
+        case 0: op = maybeAlias({ t: "push" }); break;
+        case 1: op = { t: "pop" }; break;
+        case 2: op = { t: "shift" }; break;
+        case 3: op = maybeAlias({ t: "unshift" }); break;
+        case 4: op = { t: "splice", index: n(tc, 0, len), del: n(tc, 0, 2), values: [value(), value()].slice(0, n(tc, 0, 2)) }; break;
+        case 11: op = { t: "fill", value: value(), start: n(tc, 0, len), end: n(tc, 0, len) }; break;
+        case 5: op = { t: "reverse" }; break;
+        case 6: op = { t: "sort" }; break;
+        case 7: op = maybeAlias({ t: "setIndex", index: n(tc, 0, len) }); break;
+        case 8: op = { t: "length", value: n(tc, 0, len) }; break;
+        case 9: op = { t: "fill", value: value(), start: n(tc, 0, len), end: n(tc, 0, len) }; break;
+        case 10: op = { t: "copyWithin", target: n(tc, 0, len), start: n(tc, 0, len) }; break;
+        default: op = len ? { t: "setSame", key: n(tc, 0, len - 1) } : { t: "push", value: value() }; break;
+      }
+      break;
+    }
+    case "map": {
+      const keys = [...node.keys()];
+      switch (n(tc, 0, 4)) {
+        case 0:
+        case 1: op = maybeAlias({ t: "mapSet", key: chance(tc, 50) && keys.length ? pick(tc, keys) : genMapKey(tc) }); break;
+        case 2: op = { t: "mapDelete", key: keys.length && chance(tc, 80) ? pick(tc, keys) : genMapKey(tc) }; break;
+        case 3: op = { t: "mapClear" }; break;
+        default: op = { t: "mapSetSame", key: keys.length ? pick(tc, keys) : genMapKey(tc) }; break;
+      }
+      break;
+    }
+    default: {
+      const size = node.size;
+      switch (n(tc, 0, 4)) {
+        case 0:
+        case 1: op = maybeAlias({ t: "setAdd" }); break;
+        case 2: op = size ? { t: "setDeleteAt", index: n(tc, 0, size - 1) } : { t: "setAdd", value: value() }; break;
+        case 3: op = { t: "setClear" }; break;
+        default: op = { t: "setDeleteFresh", value: value() }; break;
+      }
+    }
+  }
+  op.path = path;
+  op.kind = k;
+  if (undef) op.undef = true;
+  // Ops that can move a Set draft to another key: structural array ops over an array holding a
+  // Set, and assignments of an aliased Set (mutative/1).
+  const structural = ["reverse", "sort", "unshift", "shift", "splice", "copyWithin", "pop", "fill", "length"];
+  if ((op.alias && op.aliasKind === "set") || (k === "array" && structural.includes(op.t) && node.some((x) => x instanceof Set))) {
+    op.movesSet = true;
+  }
+  // Ops that move a container child to another index (mutative/10: its inner patches keep the old path).
+  if (k === "array" && structural.includes(op.t) && node.some(isContainer)) {
+    op.movesChild = true;
+  }
+  // A sort reads every element deeply (the comparator renders them), which drafts an element's
+  // container members and copies a Set element outright; such an element, moved by the sort,
+  // finalizes to a shallow copy (mutative/12).
+  if (k === "array" && op.t === "sort" && node.some((x) => x instanceof Set || (isContainer(x) && entries(x).some(([, c]) => isContainer(c))))) {
+    op.deepMove = true;
+  }
+  // Deleting a key whose value is undefined: the inverse patch re-adds undefined, which a later
+  // replay over a state that has the key again ignores (mutative/4 by the patches route).
+  if (op.t === "delete" && Object.prototype.hasOwnProperty.call(node, op.key) && node[op.key] === undefined) op.undef = true;
+  // A structural op over an array holding undefined writes undefined into slots that existed in
+  // the base (mutative/4 when the slot was vacated first).
+  if (k === "array" && structural.includes(op.t) && node.includes(undefined)) op.undef = true;
+  exec(model, op, { aliasRoot: model });
+  return op;
+}
+
+/**
+ * Perform `op` on the tree at `root` (a clone, a draft): the standard JavaScript operation.
+ * `ctx.aliasRoot` (default `root`) is where alias sources are read from; `ctx.baseRoot` is the
+ * base state `restore` ops take their member from (copied when `ctx.copyBase`, so a plain model
+ * never shares structure with the base; the very object for a draft).
+ */
+export function exec(root, op, ctx = {}) {
+  const aliasRoot = ctx.aliasRoot ?? root;
+  const node = getAt(root, op.path);
+  const v = () => {
+    if (op.alias) {
+      const src = getAt(aliasRoot, op.alias);
+      return op.wrap === "object" ? { inner: src } : op.wrap === "array" ? [src] : src;
+    }
+    return materialize(op.value);
+  };
+  switch (op.t) {
+    case "restore": {
+      const baseNode = getAt(ctx.baseRoot, op.path);
+      const member = kind(baseNode) === "map" ? baseNode.get(op.key) : baseNode[op.key];
+      const val = ctx.copyBase ? materialize(member) : member;
+      if (kind(node) === "map") node.set(op.key, val);
+      else node[op.key] = val;
+      return;
+    }
+    case "set": node[op.key] = v(); return;
+    case "delete": delete node[op.key]; return;
+    case "assign": Object.assign(node, { [op.key]: v() }); return;
+    case "setSame": node[op.key] = node[op.key]; return;
+    case "push": node.push(v()); return;
+    case "pop": node.pop(); return;
+    case "shift": node.shift(); return;
+    case "unshift": node.unshift(v()); return;
+    case "splice": node.splice(op.index, op.del, ...op.values.map(materialize)); return;
+    case "reverse": node.reverse(); return;
+    case "sort": node.sort((x, y) => (rank(x) < rank(y) ? -1 : rank(x) > rank(y) ? 1 : 0)); return;
+    case "setIndex": node[op.index] = v(); return;
+    case "length": node.length = op.value; return;
+    case "fill": node.fill(materialize(op.value), op.start, op.end); return;
+    case "copyWithin": node.copyWithin(op.target, op.start); return;
+    case "mapSet": node.set(op.key, v()); return;
+    case "mapDelete": node.delete(op.key); return;
+    case "mapClear": node.clear(); return;
+    case "mapSetSame": node.set(op.key, node.get(op.key)); return;
+    case "setAdd": node.add(v()); return;
+    case "setDeleteAt": node.delete([...node][op.index]); return;
+    case "setClear": node.clear(); return;
+    case "setDeleteFresh": node.delete(materialize(op.value)); return;
+    default: throw new Error(`unknown op ${op.t}`);
+  }
+}
+
+/** A total order on values for sorting: by a stable rendering. */
+function rank(x) {
+  return typeof x + ":" + render(x);
+}
+
+// ---------------------------------------------------------------- equality and rendering
+
+/** Deep equality: Object.is on leaves, Dates by time, Maps and Sets in iteration order, objects by own keys. */
+export function eq(a, b, order = false) {
+  if (Object.is(a, b)) return true;
+  if (a === null || b === null || typeof a !== "object" || typeof b !== "object") return false;
+  if (isRevoked(a) || isRevoked(b)) return false;
+  if (a instanceof Date || b instanceof Date) {
+    return a instanceof Date && b instanceof Date && Object.is(a.getTime(), b.getTime());
+  }
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) return false;
+    for (let i = 0; i < a.length; i++) {
+      if ((i in a) !== (i in b) || !eq(a[i], b[i], order)) return false;
+    }
+    return true;
+  }
+  if (a instanceof Map || b instanceof Map) {
+    if (!(a instanceof Map) || !(b instanceof Map) || a.size !== b.size) return false;
+    const ea = [...a], eb = [...b];
+    for (let i = 0; i < ea.length; i++) {
+      if (!eq(ea[i][0], eb[i][0], order) || !eq(ea[i][1], eb[i][1], order)) return false;
+    }
+    return true;
+  }
+  if (a instanceof Set || b instanceof Set) {
+    if (!(a instanceof Set) || !(b instanceof Set) || a.size !== b.size) return false;
+    const ea = [...a], eb = [...b];
+    for (let i = 0; i < ea.length; i++) {
+      if (!eq(ea[i], eb[i], order)) return false;
+    }
+    return true;
+  }
+  if (Object.getPrototypeOf(a) !== Object.getPrototypeOf(b)) return false;
+  const ka = Object.keys(a), kb = Object.keys(b);
+  if (ka.length !== kb.length) return false;
+  if (order) {
+    for (let i = 0; i < ka.length; i++) if (ka[i] !== kb[i]) return false;
+  }
+  for (const k of ka) {
+    if (!Object.prototype.hasOwnProperty.call(b, k) || !eq(a[k], b[k], order)) return false;
+  }
+  return true;
+}
+
+/**
+ * Equality up to order: object keys in any order, Map entries matched by key, Set elements as a
+ * multiset. Patches cannot restore the position of a re-added key or element, so replays are
+ * judged with this.
+ */
+export function looseEq(a, b) {
+  if (Object.is(a, b)) return true;
+  if (a === null || b === null || typeof a !== "object" || typeof b !== "object") return false;
+  if (isRevoked(a) || isRevoked(b)) return false;
+  if (a instanceof Date || b instanceof Date) {
+    return a instanceof Date && b instanceof Date && Object.is(a.getTime(), b.getTime());
+  }
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) return false;
+    for (let i = 0; i < a.length; i++) {
+      if ((i in a) !== (i in b) || !looseEq(a[i], b[i])) return false;
+    }
+    return true;
+  }
+  if (a instanceof Map || b instanceof Map) {
+    if (!(a instanceof Map) || !(b instanceof Map) || a.size !== b.size) return false;
+    const eb = [...b];
+    return [...a].every(([k, v]) => {
+      const hit = eb.find(([k2]) => looseEq(k, k2));
+      return hit !== undefined && looseEq(v, hit[1]);
+    });
+  }
+  if (a instanceof Set || b instanceof Set) {
+    if (!(a instanceof Set) || !(b instanceof Set) || a.size !== b.size) return false;
+    const ra = [...a].map((x) => render(x)).sort(), rb = [...b].map((x) => render(x)).sort();
+    return ra.every((x, i) => x === rb[i]);
+  }
+  if (Object.getPrototypeOf(a) !== Object.getPrototypeOf(b)) return false;
+  const ka = Object.keys(a), kb = Object.keys(b);
+  if (ka.length !== kb.length) return false;
+  return ka.every((k) => Object.prototype.hasOwnProperty.call(b, k) && looseEq(a[k], b[k]));
+}
+
+/** True when some Set in the tree holds a container (mutative addresses such elements by index in patches). */
+export function setsHoldContainers(root) {
+  return allNodes(root).some(([, node]) => node instanceof Set && [...node].some(isContainer));
+}
+
+/** A compact rendering that distinguishes everything eq distinguishes (identities aside). */
+export function render(v, depth = 0) {
+  if (depth > 12) return "...";
+  if (v === undefined) return "undefined";
+  if (v === null) return "null";
+  if (typeof v === "bigint") return `${v}n`;
+  if (typeof v === "number") return Object.is(v, -0) ? "-0" : String(v);
+  if (typeof v === "string") return JSON.stringify(v);
+  if (typeof v !== "object") return String(v);
+  if (isRevoked(v)) return "<revoked draft>";
+  if (v instanceof Date) return `Date(${v.getTime()})`;
+  if (Array.isArray(v)) return `[${v.map((x) => render(x, depth + 1)).join(",")}]`;
+  if (v instanceof Map) return `Map{${[...v].map(([k, x]) => `${render(k, depth + 1)}=>${render(x, depth + 1)}`).join(",")}}`;
+  if (v instanceof Set) return `Set{${[...v].map((x) => render(x, depth + 1)).join(",")}}`;
+  const proto = Object.getPrototypeOf(v);
+  const tag = proto === Object.prototype || proto === null ? "" : (proto.constructor?.name || "?");
+  return `${tag}{${Object.keys(v).map((k) => `${JSON.stringify(k)}:${render(v[k], depth + 1)}`).join(",")}}`;
+}
+
+export function showOp(op) {
+  const p = op.path.map((s) => render(s)).join("/");
+  const rest = { ...op };
+  delete rest.path;
+  return `${op.t}@${p || "/"} ${render(rest)}`;
+}
+
+export function showScript(ops) {
+  return ops.map(showOp).join("; ");
+}
+
+/** Ops that permute the children of their target: each keeps its identity but not its path. */
+const MOVERS = new Set(["reverse", "sort", "unshift"]);
+/** Ops that may drop or overwrite children of their target (which ones depends on the live size). */
+const DROPPERS = new Set(["shift", "pop", "splice", "length", "copyWithin", "fill", "setDeleteAt", "setDeleteFresh", "setClear", "mapClear"]);
+/** Ops that replace or drop the child at one key of their target. */
+const KEYED = new Set(["set", "assign", "setIndex", "mapSet", "restore", "delete", "mapDelete"]);
+
+/**
+ * Every base path that still holds the base's own untouched node: not an op's target or above
+ * one, not the child an op wrote, assigned back or deleted at its key (a fresh value `eq` to
+ * the old one is still a new object), and not below a container whose children an op moved,
+ * dropped or overwrote (the node at such a path, if any, is another one).
+ */
+export function untouchedPaths(base, ops) {
+  const touched = (p) => ops.some((op) => {
+    if (isPrefix(p, op.path)) return true;
+    if (op.path.length < p.length && isPrefix(op.path, p) && (MOVERS.has(op.t) || DROPPERS.has(op.t))) return true;
+    const key = op.t === "setIndex" ? op.index : op.key;
+    return KEYED.has(op.t) && isPrefix(op.path.concat([key]), p);
+  });
+  return containerPaths(base).filter((p) => !touched(p));
+}
+
+/** True when `op` (an op later in the script) replaces, drops or moves the node that was at `path`. */
+export function disturbs(op, path) {
+  if (!(op.path.length < path.length && isPrefix(op.path, path))) return false;
+  if (MOVERS.has(op.t) || DROPPERS.has(op.t)) return true;
+  const key = op.t === "setIndex" ? op.index : op.key;
+  return KEYED.has(op.t) && op.path.length + 1 === path.length && Object.is(path[path.length - 1], key);
+}
+
+/**
+ * The pristine node each node of a freshly cloned model stands for (the draft's `original`),
+ * by identity: built before any op runs, it follows the nodes when ops move them.
+ */
+export function originMap(model, pristine) {
+  const a = allNodes(model), b = allNodes(pristine);
+  return new Map(a.map(([, node], i) => [node, b[i][1]]));
+}
+
+/**
+ * True when some array's slot holds 0 where its original holds -0 or the other way round:
+ * mutative/11 emits no patch for such a slot (`copy[index] !== original[index]` in
+ * src/patch.ts), so the replays keep the original's zero.
+ */
+export function zeroSignFlips(origin) {
+  for (const [node, orig] of origin) {
+    if (!Array.isArray(node) || !Array.isArray(orig)) continue;
+    for (let i = 0; i < Math.min(node.length, orig.length); i++) {
+      if (node[i] === orig[i] && !Object.is(node[i], orig[i])) return true;
+    }
+  }
+  return false;
+}
+
+/** Deep-freeze a tree in place (containers only). */
+export function deepFreeze(v) {
+  if (!isContainer(v) || Object.isFrozen(v)) return v;
+  Object.freeze(v);
+  for (const [, child] of entries(v)) deepFreeze(child);
+  return v;
+}
+
+/** Every container in the tree, with its path. */
+export function allNodes(root) {
+  const out = [];
+  const seen = new Set();
+  const walk = (node, path) => {
+    if (seen.has(node)) return;
+    seen.add(node);
+    out.push([path, node]);
+    for (const [s, child] of entries(node)) {
+      if (isContainer(child)) walk(child, path.concat([s]));
+    }
+  };
+  walk(root, []);
+  return out;
+}
+
+/** True when the tree holds nothing but JSON-representable data (no Map/Set/Date/undefined/bigint/non-finite). */
+export function isJsonLike(v) {
+  if (v === null || typeof v === "string" || typeof v === "boolean") return true;
+  if (typeof v === "number") return Number.isFinite(v) && !Object.is(v, -0);
+  if (typeof v !== "object") return false;
+  if (Array.isArray(v)) return v.every(isJsonLike);
+  if (v instanceof Map || v instanceof Set || v instanceof Date) return false;
+  return Object.keys(v).every((k) => isJsonLike(v[k]));
+}
diff --git a/hegel/hegel-zoo.mjs b/hegel/hegel-zoo.mjs
new file mode 100644
index 0000000..771db82
--- /dev/null
+++ b/hegel/hegel-zoo.mjs
@@ -0,0 +1,175 @@
+// Hegel zoo: the small harness shared by the zoo's TypeScript/JavaScript targets.
+//
+// `property(name, body)` registers a node:test test that runs `body(tc)` under Hegel with
+// HEGEL_TEST_CASES cases (default 100) and the database at HEGEL_DATABASE. With ZOO_COLLECT=1
+// a `fail()` records the mismatch instead of failing, the case ends there, and the counts of
+// mismatches and of the shapes seen (`count(key)`) are printed at the end of the test, so a
+// property can be run over many cases to see every shape at once. `pin(name, body)` is a
+// plain test for one pinned bug: it must fail while the bug is present and pass once it is
+// fixed (the zoo's judge reads an unexpected pass as "fixed upstream?").
+
+import { readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+import { test as nodeTest } from "node:test";
+
+// The Hegel version these tests were written against (the zoo pins it in zoo.toml; upstream
+// would add it to devDependencies). Hegel and esbuild are installed with `npm install --prefix
+// .hegel` so the target's own package.json and lock file stay untouched. Checked at load time so
+// a stray install cannot silently change the engine.
+export const HEGEL_PIN = { "@hegeldev/hegel": "0.4.5" };
+
+const hegelDir = join(dirname(fileURLToPath(import.meta.url)), "..", ".hegel", "node_modules", "@hegeldev", "hegel");
+{
+  const installed = JSON.parse(readFileSync(join(hegelDir, "package.json"), "utf8")).version;
+  if (installed !== HEGEL_PIN["@hegeldev/hegel"]) {
+    throw new Error(`@hegeldev/hegel ${installed} is installed; these tests pin ${HEGEL_PIN["@hegeldev/hegel"]}`);
+  }
+}
+const hegel = await import(pathToFileURL(join(hegelDir, "dist", "index.js")));
+const gs = await import(pathToFileURL(join(hegelDir, "dist", "generators", "index.js")));
+
+export const collecting = !!process.env.ZOO_COLLECT;
+
+/** HEGEL_NO_KNOWN=1: skip the shapes of the recorded bugs (they are drawn, and fail, by default). */
+export const noKnown = !!process.env.HEGEL_NO_KNOWN;
+
+/** The error `fail` throws: a property's own verdict, distinguishable from the library's errors. */
+export class Failure extends Error {}
+const Collected = Failure;
+
+let msgs = [];
+let stats = new Map();
+
+/** Report a mismatch: an error normally, a recorded line in collect mode. */
+export function fail(message) {
+  if (collecting) {
+    msgs.push(message);
+  }
+  throw new Failure(message);
+}
+
+/** Bump a statistic (the shape of a pinned bug, a generator branch). */
+export function count(key) {
+  stats.set(key, (stats.get(key) || 0) + 1);
+}
+
+function settings() {
+  const s = { testCases: Number(process.env.HEGEL_TEST_CASES) || 100 };
+  if (process.env.HEGEL_DATABASE) {
+    s.database = hegel.Database.fromPath(process.env.HEGEL_DATABASE);
+  }
+  return s;
+}
+
+// Hegel keys its example database by the test function's source text. Every property here runs
+// through the same wrapper, so without this every property would share one key and replay the
+// stored failing examples of all the others; the key is the test's name instead.
+function keyed(name, fn) {
+  fn.toString = () => name;
+  return fn;
+}
+
+/** A property: `body(tc)` runs under Hegel; a thrown error (or `fail`) is a failure. `skip` (a reason) registers it skipped. */
+export function property(name, body, { skip } = {}) {
+  nodeTest(name, { skip }, () => {
+    msgs = [];
+    stats = new Map();
+    hegel.test(keyed(name, (tc) => {
+      try {
+        body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }), settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** An async property: `body(tc)` may await; runs under Hegel's testAsync with the same settings. */
+export function propertyAsync(name, body) {
+  nodeTest(name, async () => {
+    msgs = [];
+    stats = new Map();
+    await hegel.testAsync(keyed(name, async (tc) => {
+      try {
+        await body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }), settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** A pin: a plain test for one recorded bug. */
+export function pin(name, body) {
+  nodeTest(name, body);
+}
+
+/** An integer in [lo, hi]. */
+export function n(tc, lo, hi) {
+  return tc.draw(gs.integers({ minValue: lo, maxValue: hi }));
+}
+
+/** One of xs. */
+export function pick(tc, xs) {
+  return xs[n(tc, 0, xs.length - 1)];
+}
+
+/** True pct percent of the time. */
+export function chance(tc, pct) {
+  return n(tc, 0, 99) < pct;
+}
+
+/** A string of `len` characters drawn from `alphabet` (an array of strings). */
+export function word(tc, alphabet, lo, hi) {
+  const len = n(tc, lo, hi);
+  let s = "";
+  for (let i = 0; i < len; i++) {
+    s += pick(tc, alphabet);
+  }
+  return s;
+}
+
+/** Structural equality: arrays by position, objects by key set (prototype ignored), else ===. */
+export function same(a, b) {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) {
+      return false;
+    }
+    return a.every((x, i) => same(x, b[i]));
+  }
+  if (a !== null && b !== null && typeof a === "object" && typeof b === "object") {
+    const ka = Object.keys(a).sort();
+    const kb = Object.keys(b).sort();
+    if (ka.length !== kb.length || ka.some((k, i) => k !== kb[i])) {
+      return false;
+    }
+    return ka.every((k) => same(a[k], b[k]));
+  }
+  return a === b;
+}
+
+/** A compact, unambiguous rendering for messages. */
+export function show(x) {
+  return JSON.stringify(x, (k, v) => (v === undefined ? "<undefined>" : v));
+}
diff --git a/hegel/hegel.test.mjs b/hegel/hegel.test.mjs
new file mode 100644
index 0000000..2699091
--- /dev/null
+++ b/hegel/hegel.test.mjs
@@ -0,0 +1,1465 @@
+// Hegel properties for mutative: `create` against a plain-JavaScript model (the same operations
+// on a clone) and against immer, structural sharing, patches replayed forwards and backwards
+// through `apply`, immer's `applyPatches` and fast-json-patch, `current`/`original` during the
+// draft, reads through the draft, frozen bases and auto-freeze, the curried/async/makeCreator
+// forms, return values, class instances under `mark`, and strict mode.
+//
+//   npm install --prefix .hegel ... (see target.toml)   then   node --test hegel/hegel.test.mjs
+//   ZOO_COLLECT=1 HEGEL_TEST_CASES=2000 node --test hegel/hegel.test.mjs   # every mismatch shape
+//
+// The recorded bugs (bugs.toml) are drawn by default and the properties fail on them (STYLE.md
+// rule 11): a mismatch whose scenario has a bug's shape fails with "(shape of mutative/N)" on its
+// first line. HEGEL_NO_KNOWN=1 (`noKnown`, read once in the harness) looks past them: such a
+// mismatch is counted as `known mutative/N` and the case is skipped (assume) or the check left
+// out. Each bug also has a narrow property over its shape region (before the pins) and a pin.
+
+import { createRequire } from "node:module";
+import { property, propertyAsync, pin, fail, count, n, pick, chance, Failure, noKnown } from "./hegel-zoo.mjs";
+import {
+  genBase, genValue, genLeaf, genContainer, genOp, exec, clone, eq, render, showScript, untouchedPaths, getAt,
+  containerPaths, allNodes, isContainer, deepFreeze, isJsonLike, materialize, Pt, setClassy, leafPaths, isRevoked,
+  looseEq, setsHoldContainers, originMap, zeroSignFlips, disturbs, kind, genMapKey, KEYS, NUMBERS,
+} from "./gen.mjs";
+
+const require = createRequire(import.meta.url);
+globalThis.__DEV__ = true;
+const M = require("../.hegel/dist/index.js");
+const immer = require("../.hegel/node_modules/immer");
+const jsonpatch = require("../.hegel/node_modules/fast-json-patch");
+immer.enableMapSet();
+immer.enablePatches();
+immer.setAutoFreeze(false);
+Pt.prototype[immer.immerable] = true;
+
+const { create, apply, current, original, isDraft, isDraftable, rawReturn, unsafe, makeCreator } = M;
+
+// The dev build warns on console for some return shapes; keep the TAP output clean.
+const realWarn = console.warn;
+console.warn = () => {};
+
+// ---------------------------------------------------------------- helpers
+
+/** Draw a base and a script of ops (performed on `model`); `run(baseRoot)` replays it on a draft. */
+function scenario(tc, { alias = 40, maxOps = 8 } = {}) {
+  const base = genBase(tc);
+  const pristine = clone(base);
+  const model = clone(base);
+  const allowAlias = chance(tc, alias);
+  // The model's nodes move as the draft's do: `origin` names the base node each stands for,
+  // `touched` the base nodes some op's live path ran through (the draft copies those).
+  const origin = originMap(model, base);
+  const touched = new Set();
+  const ops = [];
+  const k = n(tc, 0, maxOps);
+  for (let i = 0; i < k; i++) {
+    const op = genOp(tc, model, allowAlias, pristine, (path, node) => origin.get(node) === getAt(base, path));
+    for (let j = 0; j <= op.path.length; j++) {
+      const b = origin.get(getAt(model, op.path.slice(0, j)));
+      if (b) touched.add(b);
+    }
+    ops.push(op);
+  }
+  // A draft aliased to another place whose original place a later op overwrites or moves: its
+  // own patches still carry the old path (mutative/10 by the alias route rather than unshift).
+  ops.forEach((op, i) => {
+    if (op.alias && op.aliasKind !== "set" && ops.slice(i + 1).some((later) => disturbs(later, op.alias))) op.movesChild = true;
+  });
+  count(`ops=${Math.min(k, 8)}`);
+  if (ops.some((op) => op.alias)) count("aliased");
+  if (ops.some((op) => op.t === "restore")) count("restore");
+  const run = (baseRoot) => (d) => { for (const op of ops) exec(d, op, { baseRoot }); };
+  const setOfArrays = allNodes(base).some(([, node]) => node instanceof Set && [...node].some(Array.isArray))
+    || ops.some((op) => op.t === "setAdd" && op.alias && !op.wrap && op.aliasKind === "array");
+  const setsHoldContainersLater = setsHoldContainers(model);
+  const zeroSign = zeroSignFlips(origin);
+  if (zeroSign) count("array slot changed between 0 and -0");
+  return { base, pristine, model, ops, run, allowAlias, setOfArrays, setsHoldContainersLater, origin, touched, zeroSign };
+}
+
+/** The recorded bug a mismatch of this scenario may be, or null. */
+function knownShape(s, what) {
+  const { ops } = s;
+  // "patches-copy": a replay on a copy of the base, where Set patches (which carry the removed
+  // element by reference, `base.delete(patch.value)` in src/apply.ts, as immer's do) cannot
+  // remove a Date or object element.
+  const patchy = what === "patches" || what === "patches-copy";
+  if (what === "patches-copy" && [s.base, s.model].some((root) => allNodes(root).some(([, node]) => node instanceof Set && [...node].some((v) => typeof v === "object" && v !== null)))) {
+    return "convention: Set patches carry elements by reference";
+  }
+  if (what === "state" || patchy) {
+    if (ops.some((op) => op.movesSet)) return "mutative/1";
+    if (s.setOfArrays) return "mutative/5";
+    if (ops.some((op) => op.undef)) return "mutative/4";
+  }
+  if (patchy && ops.some((op) => op.t === "restore" && op.kind === "object")) return "mutative/3";
+  if (patchy && (setsHoldContainers(s.base) || s.setsHoldContainersLater)) return "mutative/9";
+  if (patchy && ops.some((op) => op.movesChild)) return "mutative/10";
+  if (patchy && aliasUnderReplacedContainer(ops)) return "mutative/14";
+  if (patchy && s.zeroSign) return "mutative/11";
+  if (what === "current" && /setMap/.test(s.lastError || "")) return "mutative/8";
+  // current() overflows the stack once a Set keeps the array element the model deleted (the
+  // second iteration yielded null, so the delete was a no-op) and the script puts the Set into it.
+  if (what === "current" && s.setOfArrays) return "mutative/5";
+  if (patchy && s.stringPaths && [s.base, s.model, s.model2].filter(Boolean).some((root) => allNodes(root).some(([, node]) => node instanceof Map && [...node.keys()].some((k) => typeof k !== "string")))) {
+    return "convention: string paths stringify Map keys";
+  }
+  return null;
+}
+
+/**
+ * An op assigned a draft (an unwrapped alias) into a container that a later op replaced by a
+ * primitive: the draft's patch is still emitted at the vanished path and the inverse cannot be
+ * applied (mutative/14). Replacing the container by null, a Date or another container, or
+ * wrapping the draft in a fresh object, does not reach the shape.
+ */
+function aliasUnderReplacedContainer(ops) {
+  return ops.some((op, i) => op.alias && !op.wrap && ops.slice(i + 1).some((later) => {
+    if (later.alias || !["set", "assign", "setIndex", "mapSet"].includes(later.t)) return false;
+    const v = materialize(later.value);
+    if (v === null || typeof v === "object") return false;
+    const target = [...later.path, later.t === "setIndex" ? later.index : later.key];
+    return target.length === op.path.length && target.every((seg, k) => String(seg) === String(op.path[k]));
+  }));
+}
+
+/**
+ * fail() on a mismatch, naming the recorded bug whose shape the scenario has; a documented
+ * convention (an oracle difference, not a bug) is counted and ends the case instead, and so is
+ * a recorded bug's shape under HEGEL_NO_KNOWN=1.
+ */
+function mismatch(s, what, message) {
+  const known = knownShape(s, what);
+  if (known && known.startsWith("convention")) {
+    count(known);
+    throw new Known(known, false);
+  }
+  if (skipKnown(known)) throw new Known(known, true);
+  fail(withShape(message, known));
+}
+
+/** The message with the recorded bug's shape named on its first line, so the shrunk failure reads its mapping. */
+function withShape(message, shape) {
+  return shape ? message.replace(/\n|$/, ` (shape of ${shape})$&`) : message;
+}
+
+/** Under HEGEL_NO_KNOWN=1 a mismatch with a recorded bug's shape is counted and skipped: true says skip. */
+function skipKnown(shape) {
+  if (!shape || !noKnown) return false;
+  count(`known ${shape}`);
+  return true;
+}
+
+/** A case ended early: by a convention (quietly) or by a recorded bug's shape under HEGEL_NO_KNOWN=1 (rejected). */
+class Known extends Error {
+  constructor(shape, reject) {
+    super(shape);
+    this.reject = reject;
+  }
+}
+
+/** Run a property body that may end in a Known: a convention ends the case quietly, a known shape rejects it. */
+function guarded(tc, body) {
+  try {
+    body();
+  } catch (e) {
+    if (e instanceof Known) {
+      tc.assume(!e.reject);
+      return;
+    }
+    throw e;
+  }
+}
+
+/** The value or the error message of `f()`; a property's own verdicts (Failure, Known) pass through. */
+function attempt(f) {
+  try {
+    return { value: f() };
+  } catch (e) {
+    if (e instanceof Failure || e instanceof Known) throw e;
+    return { error: String((e && e.message) || e) };
+  }
+}
+
+function hasDraft(v, seen = new Set()) {
+  if (v === null || typeof v !== "object" || seen.has(v)) return false;
+  seen.add(v);
+  if (isRevoked(v) || isDraft(v)) return true;
+  if (v instanceof Map) return [...v].some(([k, x]) => hasDraft(k, seen) || hasDraft(x, seen));
+  if (v instanceof Set) return [...v].some((x) => hasDraft(x, seen));
+  if (Array.isArray(v)) return v.some((x) => hasDraft(x, seen));
+  return Object.keys(v).some((k) => hasDraft(v[k], seen));
+}
+
+function describe(s) {
+  return `base ${render(s.base)}\nscript ${showScript(s.ops)}`;
+}
+
+/** immer's result for the same script on its own clone of the base, or an error string. */
+function immerRun(s) {
+  const ib = clone(s.base);
+  const r = attempt(() => immer.produce(ib, s.run(ib)));
+  if (r.error) return r;
+  // immer can leave a revoked draft in its result (its own bug); such results are unusable.
+  if (attempt(() => hasDraft(r.value)).error || hasDraft(r.value)) return { error: "immer result holds a draft" };
+  return r;
+}
+
+function jsonOf(v) {
+  return JSON.stringify(v, (k, x) => (typeof x === "bigint" ? `${x}n` : x));
+}
+
+/** A copy with every -0 (leaves and Map keys) as +0, for a comparison blind to the sign of zeros. */
+function plusZeros(v) {
+  if (Object.is(v, -0)) return 0;
+  if (v === null || typeof v !== "object" || v instanceof Date) return v;
+  if (Array.isArray(v)) return v.map(plusZeros);
+  if (v instanceof Map) return new Map([...v].map(([k, x]) => [plusZeros(k), plusZeros(x)]));
+  if (v instanceof Set) return new Set([...v].map(plusZeros));
+  const o = {};
+  for (const k of Object.keys(v)) o[k] = plusZeros(v[k]);
+  return o;
+}
+
+/** The state mutative produces for the scenario, or a Known/fail. */
+function mutativeState(s, options) {
+  const r = attempt(() => create(s.base, s.run(s.base), options));
