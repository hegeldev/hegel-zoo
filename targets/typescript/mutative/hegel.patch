+  const hasPt = allNodes(base).some(([, node]) => node instanceof Pt) || s.ops.some((op) => op.value instanceof Pt);
+  if (!hasPt) count("no class instance");
+  const mark = (target) => (target instanceof Pt ? "immutable" : undefined);
+  const r = attempt(() => create(base, s.run(base), { mark, enablePatches: true }));
+  if (r.error) mismatch(s, "state", `create with mark threw ${r.error}\n${describe(s)}`);
+  const [state, patches, inverse] = r.value;
+  if (!eq(state, model, true)) mismatch(s, "state", `state with mark differs from the model\n${describe(s)}\nstate ${render(state)}`);
+  const im = immerRun(s);
+  if (im.error) count("immer unusable");
+  else if (!eq(im.value, model, true)) count("immer differs from the model");
+  const fwd = attempt(() => apply(base, patches, { mark }));
+  if (fwd.error) mismatch(s, "patches", `apply with mark threw ${fwd.error}\n${describe(s)}\npatches ${render(patches)}`);
+  else if (!looseEq(fwd.value, state)) mismatch(s, "patches", `apply(base, patches, mark) ${render(fwd.value)} != state\n${describe(s)}\npatches ${render(patches)}`);
+  const back = attempt(() => apply(state, inverse, { mark }));
+  if (back.error) mismatch(s, "patches", `apply inverse with mark threw ${back.error}\n${describe(s)}\ninverse ${render(inverse)}`);
+  else if (!looseEq(back.value, base)) mismatch(s, "patches", `apply(state, inverse, mark) ${render(back.value)} != base\n${describe(s)}\ninverse ${render(inverse)}`);
+  // Without the mark, class instances are atoms: the ops on them mutate the base in place.
+  if (hasPt) {
+    for (const [p, node] of allNodes(state)) {
+      if (node instanceof Pt && !isDraftable(node, { mark })) fail(`isDraftable(Pt, mark) is false`);
+    }
+  }
+}));
+
+property("TestHegelStrictModeGuardsNonDraftables", (tc) => guarded(() => {
+  const base = genBase(tc);
+  const dates = leafPaths(base).filter((p) => getAt(base, p) instanceof Date);
+  const others = leafPaths(base).filter((p) => !(getAt(base, p) instanceof Date));
+  const setOfArrays = allNodes(base).some(([, node]) => node instanceof Set && [...node].some(Array.isArray));
+  const r = attempt(() => create(base, (d) => {
+    for (const p of dates) {
+      if (p.some((_, i) => getAt(base, p.slice(0, i)) instanceof Set)) { count("date in a set"); continue; }
+      const parent = getAt(d, p.slice(0, -1));
+      if (parent === null && setOfArrays) { count("known mutative/5"); continue; }
+      const a = attempt(() => getAt(d, p));
+      if (!a.error) fail(`strict: reading the Date at ${render(p)} did not throw\nbase ${render(base)}`);
+      const u = attempt(() => unsafe(() => getAt(d, p)));
+      if (u.error) fail(`strict: unsafe read of the Date at ${render(p)} threw ${u.error}\nbase ${render(base)}`);
+      if (!eq(u.value, getAt(base, p))) fail(`strict: unsafe read of ${render(p)} gave ${render(u.value)}\nbase ${render(base)}`);
+    }
+    for (const p of others) {
+      // Iterating a Set draft visits every element, so a Set holding a Date cannot be read at all in strict mode.
+      if (p.some((_, i) => { const anc = getAt(base, p.slice(0, i)); return anc instanceof Set && [...anc].some((x) => x instanceof Date); })) { count("date in a set"); continue; }
+      const a = attempt(() => getAt(d, p));
+      if (a.error) fail(`strict: reading the leaf at ${render(p)} threw ${a.error}\nbase ${render(base)}`);
+      if (!eq(a.value, getAt(base, p))) {
+        if (a.value === undefined && setOfArrays) { count("known mutative/5"); continue; }
+        fail(`strict: leaf ${render(p)} read as ${render(a.value)}\nbase ${render(base)}`);
+      }
+    }
+  }, { strict: true }));
+  if (r.error) fail(`strict create threw ${r.error}\nbase ${render(base)}`);
+  if (r.value !== base) fail(`strict create with reads only returned a new state\nbase ${render(base)}`);
+  // Without Dates in the tree, a strict create equals the plain one.
+  const noDates = stripDates(base);
+  const pristine = clone(noDates);
+  const model = clone(noDates);
+  const ops = [];
+  const k = n(tc, 0, 6);
+  for (let i = 0; i < k; i++) ops.push(genOp(tc, model, false, pristine));
+  const s = { base: noDates, pristine, model, ops, run: (b) => (d) => { for (const op of ops) exec(d, op, { baseRoot: b }); }, allowAlias: false, setOfArrays: allNodes(noDates).some(([, node]) => node instanceof Set && [...node].some(Array.isArray)) };
+  const strictOps = ops.filter((op) => !op.undef);
+  const q = attempt(() => create(noDates, s.run(noDates), { strict: true }));
+  if (q.error) {
+    if (/strict|unsafe|draftable/i.test(q.error)) { count(`strict rejected an op: ${q.error.slice(0, 60)}`); return; }
+    mismatch(s, "state", `strict create threw ${q.error}\n${describe(s)}`);
+  }
+  if (!eq(q.value, model, true)) mismatch(s, "state", `strict state differs from the model\n${describe(s)}\nstate ${render(q.value)}`);
+  void strictOps;
+}));
+
+function stripDates(v) {
+  if (v instanceof Date) return v.getTime();
+  if (v === null || typeof v !== "object") return v;
+  if (Array.isArray(v)) return v.map(stripDates);
+  if (v instanceof Map) return new Map([...v].map(([k, x]) => [stripDates(k), stripDates(x)]));
+  if (v instanceof Set) return new Set([...v].map(stripDates));
+  if (v instanceof Pt) return new Pt(stripDates(v.x), stripDates(v.y));
+  const o = {};
+  for (const k of Object.keys(v)) o[k] = stripDates(v[k]);
+  return o;
+}
+
+void realWarn;
+void materialize;
+
+// ---------------------------------------------------------------- pins: one plain test per recorded bug
+
+import assert from "node:assert/strict";
+
+pin("TestHegelPinMovedSetDraftKeepsItsChanges", () => {
+  // mutative/1: a Set draft moved to another key finalizes to its unmodified value.
+  assert.deepEqual(create([new Set([1]), 2], (d) => { d.reverse(); d[1].add(3); }), [2, new Set([1, 3])]);
+  assert.deepEqual(create({ a: new Set([1]) }, (d) => { d.b = d.a; delete d.a; d.b.add(3); }), { b: new Set([1, 3]) });
+  assert.deepEqual(create({ c: new Set(["0", "b"]) }, (d) => { d.c.delete("b"); d.c = [d.c]; }), { c: [new Set(["0"])] });
+});
+
+pin("TestHegelPinSetDraftIteratesZeroForNegativeZero", () => {
+  // mutative/2: a Set holds +0 for -0; the draft iterates the -0 it was given.
+  let seen;
+  const state = create(new Set([1]), (d) => { d.add(-0); seen = [...d]; });
+  assert.ok(Object.is([...state][1], 0), "the finished Set holds +0");
+  assert.ok(Object.is(seen[1], 0), `the draft iterated ${Object.is(seen[1], -0) ? "-0" : seen[1]}`);
+});
+
+pin("TestHegelPinAssigningTheOriginalChildBackEmitsNoRemovePatch", () => {
+  // mutative/3: `draft.a = base.a` after modifying draft.a yields a `remove` patch.
+  const base = { a: { b: 1 }, k: 0 };
+  const [state, patches] = create(base, (d) => { d.a.b = 2; d.k = 1; d.a = base.a; }, { enablePatches: true });
+  assert.deepEqual(state, { a: { b: 1 }, k: 1 });
+  assert.deepEqual(apply(base, patches), state, `patches ${JSON.stringify(patches)}`);
+});
+
+pin("TestHegelPinUndefinedAssignedAfterDeleteIsKept", () => {
+  // mutative/4: assigning undefined to a key removed earlier in the draft is ignored.
+  const o = create({ a: 1 }, (d) => { delete d.a; d.a = undefined; });
+  assert.ok(Object.prototype.hasOwnProperty.call(o, "a"), "own property a expected");
+  const a = create([1], (d) => { d.pop(); d[0] = undefined; });
+  assert.equal(a.length, 1);
+  // The same slot written by unshift moving the base's own undefined: a hole where JavaScript has an element.
+  const u = create([undefined, 5], (d) => { d.pop(); d.unshift(true); });
+  assert.deepEqual(Object.keys(u), ["0", "1"], `unshift over undefined: ${JSON.stringify(u)}`);
+});
+
+pin("TestHegelPinSetDraftYieldsItsArrayElementOnEveryIteration", () => {
+  // mutative/5: the second iteration of a Set draft yields null for a drafted array element.
+  create(new Set([[1]]), (d) => {
+    const first = [...d][0];
+    const second = [...d][0];
+    assert.notEqual(second, null, "second iteration yields null");
+    assert.equal(first, second);
+  });
+});
+
+pin("TestHegelPinApplyReplaysARootReplaceToADate", () => {
+  // mutative/6: create can return a Date and emits a root replace patch that apply rejects.
+  const base = { a: 1 };
+  const [state, patches] = create(base, () => new Date(5), { enablePatches: true });
+  assert.equal(state.getTime(), 5);
+  assert.equal(apply(base, patches).getTime(), 5);
+});
+
+pin("TestHegelPinReturningAChildDraftAfterMutatingTheRootThrows", () => {
+  // mutative/7: the mutate-and-return guard misses an untouched child draft.
+  assert.throws(() => create({ x: { c: 0 }, y: 1 }, (d) => { d.y = 2; return d.x; }));
+});
+
+pin("TestHegelPinCurrentWorksWithAPlainSetHoldingADraft", () => {
+  // mutative/8: current() throws when a Set added to the draft holds a draft, or a NaN.
+  create({ a: { b: 1 } }, (d) => {
+    d.s = new Set();
+    d.s.add(d.a);
+    const c = current(d);
+    assert.deepEqual(c, { a: { b: 1 }, s: new Set([{ b: 1 }]) });
+  });
+  create({}, (d) => {
+    d.s = new Set([NaN]);
+    assert.deepEqual(current(d), { s: new Set([NaN]) });
+  });
+});
+
+pin("TestHegelPinMovedArrayPatchesUseItsNewIndex", () => {
+  // mutative/10: an array with a modified element draft, moved by its parent's unshift and modified
+  // again, emits its element patches under its old index; the inverse cannot be applied.
+  const mk = () => [[new Map([["k", 1]]), 7], true];
+  const base = mk();
+  const [state, patches, inverse] = create(base, (d) => { d[0][0].clear(); d.unshift(1.5); d[1].unshift(new Set([-1])); }, { enablePatches: true });
+  assert.deepEqual(state, [1.5, [new Set([-1]), new Map(), 7], true]);
+  assert.deepEqual(apply(mk(), patches), state, `forward: ${JSON.stringify(patches)}`);
+  assert.deepEqual(apply(state, inverse), base, `inverse: ${JSON.stringify(inverse)}`);
+});
+
+pin("TestHegelPinSetElementChangePatchesInvertBesideARemoval", () => {
+  // mutative/9: a modified Set element is emitted by path and as remove/add; the inverse fails.
+  const mk = () => new Set([{ a: 1 }, 7]);
+  const base = mk();
+  const [state, patches, inverse] = create(base, (d) => { [...d][0].a = 2; d.delete(7); }, { enablePatches: true });
+  assert.deepEqual(state, new Set([{ a: 2 }]));
+  assert.deepEqual(apply(mk(), patches), state, `forward on a copy: ${JSON.stringify(patches)}`);
+  assert.deepEqual(apply(state, inverse), base, `inverse: ${JSON.stringify(inverse)}`);
+});
