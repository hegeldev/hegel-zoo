index 0000000..83c078d
--- /dev/null
+++ b/test/hegel.test.mjs
@@ -0,0 +1,810 @@
+// Hegel zoo: properties of shell-quote (ljharb/shell-quote) — `quote` output read back by
+// real shells (dash and bash) and by `parse`; `parse` against bash's own word splitting, in
+// the default mode and under `splitUnquoted`; operators and comments against a model.
+//
+// Run with `node --test --test-reporter=tap test/hegel.test.mjs`; needs `bash` and `dash`
+// on PATH (the oracles). ZOO_COLLECT=1 records mismatches instead of failing (see
+// test/hegel-zoo.mjs). The shapes of the recorded bugs (bugs.toml) are drawn like any other
+// and the properties fail on them, naming the shape in the failure; each bug also has a
+// property over its shape alone (the last section but one) and a pin. HEGEL_NO_KNOWN=1 asks
+// for a run that looks past the known bugs: the generators then draw less of the shapes, a
+// mismatch that has one is skipped, and the one-bug properties are skipped whole.
+
+import assert from "node:assert/strict";
+import { execFileSync } from "node:child_process";
+import { mkdtempSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import sq from "../index.js";
+import { property, pin, fail, count, gs, same, show, collecting, noKnown } from "./hegel-zoo.mjs";
+
+const { parse, quote } = sq;
+
+// ---------------------------------------------------------------- the shell oracle
+
+// An empty directory to run the shells in, so a glob that slipped through matches nothing.
+const EMPTY = mkdtempSync(join(tmpdir(), "hegel-shell-quote-"));
+
+function shSingle(s) {
+  return "'" + s.replace(/'/g, "'\\''") + "'";
+}
+
+// The words `script` denotes to `shell`, via `printf "%s\0"`: pathname expansion off, a fixed
+// first word so an empty script still yields a well-formed record, `env` the only variables.
+function shellWords(shell, script, env = {}, ifs) {
+  const pre = "set -f; " + (ifs === undefined ? "" : "IFS=" + shSingle(ifs) + "; ");
+  const out = execFileSync(shell, ["-c", pre + 'printf "%s\\0" x ' + script], {
+    env: { PATH: process.env.PATH, HOME: EMPTY, ...env },
+    cwd: EMPTY,
+  });
+  const parts = out.toString("utf8").split("\0");
+  parts.pop();
+  parts.shift();
+  return parts;
+}
+
+// ---------------------------------------------------------------- alphabets
+
+const BARE = ["a", "b", "z", "Z", "0", "9", "-", "_", ".", "/", "=", ":", "+", "%", "@", "^", "!", ",", "é", "全", "😀"];
+// Characters a bare word may carry that the shell treats as ordinary but a JavaScript `\s`
+// does not (CR, VT, FF, NBSP, U+2028, BOM): the shape `parse/unicode-space`.
+const ODD_SPACE = ["\r", "\v", "\f", "\u00a0", "\u2028", "\ufeff"];
+const ESCAPABLE = ["a", " ", "\t", '"', "'", "$", "`", "\\", "|", "&", ";", "<", ">", "(", ")", "#", "*", "?", "!", "="];
+const SQ_CHARS = [...BARE, " ", "\t", "\n", '"', "$", "\\", "#", "*", "!", "`", "|", "&", ";", "~"];
+const DQ_CHARS = [...BARE, " ", "\t", "\n", "'", "#", "*", "?", "!", "|", "&", ";", "~", "\\"];
+const VALUE_CHARS = [...BARE, " ", " ", ":", "*", "'", '"', "\\", "$", "#", "!", "`", "\t", "\n", "|"];
+const NAMES = ["A", "B", "C", "E", "W", "N"]; // E empty, W blanks, N unset
+const NAME_CHARS = ["a", "b", "z", "Z", "0", "9", "_"]; // what may follow the first character of a name
+const DIGITS = ["1", "2", "9"]; // ($0 is the shell's name, not a positional parameter)
+// Object.prototype's members that do not start with `_` (those are read as `$_` first: shell-quote/6)
+const PROTO_NAMES = ["constructor", "toString", "valueOf", "hasOwnProperty", "isPrototypeOf", "propertyIsEnumerable", "toLocaleString"];
+// one-character parameters that bash expands to nothing in `bash -c` (no positional parameters,
+// no background job; `"$@"` alone would vanish where `"$*"` is an empty word)
+const SPECIAL_PARAMS = ["*", "!"];
+
+// ---------------------------------------------------------------- the recorded shapes
+//
+// The shapes of the recorded bugs (bugs.toml), by the key the generators mark them with. A
+// mismatch names the shapes of its case; under HEGEL_NO_KNOWN=1 it is skipped instead.
+const BUG = {
+  "quote/bang-in-double-quotes": "shell-quote/1",
+  "parse/backtick-in-double-quotes": "shell-quote/2",
+  "parse/hash-in-word": "shell-quote/3",
+  "parse/escaped-backslash-before-quote": "shell-quote/4",
+  "parse/line-continuation": "shell-quote/5",
+  "parse/underscore-name": "shell-quote/6",
+  "parse/dropped-character-after-parameter": "shell-quote/7",
+  "parse/digit-name": "shell-quote/8",
+  "parse/prototype-env": "shell-quote/9",
+  "parse/unicode-space": "shell-quote/10",
+  "parse/escaped-glob-char": "shell-quote/11",
+  "parse/split-then-glob": "shell-quote/12",
+  "parse/object-env-value": "shell-quote/13",
+  "parse/escaped-backslash-before-blank": "shell-quote/14",
+  "parse/empty-ifs-keeps-empty-word": "shell-quote/15",
+  "parse/split-drops-empty-quoted": "shell-quote/16",
+  "parse/split-drops-leading-empty-quoted": "shell-quote/17",
+};
+// the shapes that are bugs only under splitUnquoted
+const SPLIT_ONLY = ["parse/split-then-glob", "parse/split-drops-empty-quoted", "parse/split-drops-leading-empty-quoted"];
+
+/** Count the shapes a case draws (collect mode's `shape/...`). */
+function drawn(shapes) {
+  for (const s of shapes) count("shape/" + s);
+}
+
+/**
+ * The recorded shapes of a mismatch, as the suffix of its failure message; under
+ * HEGEL_NO_KNOWN=1 a mismatch that has one is counted and skipped instead.
+ */
+function recorded(tc, shapes) {
+  for (const s of shapes) count((noKnown ? "skip/" : "known/") + s);
+  if (noKnown && shapes.size) tc.assume(false);
+  if (!shapes.size) return "";
+  return ` (recorded shape${shapes.size > 1 ? "s" : ""} ${[...shapes].map((s) => `${s} = ${BUG[s]}`).join(", ")})`;
+}
+
+// ---------------------------------------------------------------- generator helpers
+
+const ints = (lo, hi) => gs.integers({ minValue: lo, maxValue: hi });
+
+/** oneOf with weights: `weighted([45, a], [55, b])` draws a 45 times in 100; shrinks towards the first choice. */
+function weighted(...choices) {
+  const total = choices.reduce((sum, [w]) => sum + w, 0);
+  return ints(0, total - 1).flatMap((r) => {
+    for (const [w, g] of choices) {
+      if (r < w) return g;
+      r -= w;
+    }
+    throw new Error("unreachable");
+  });
+}
+
+/** True pct percent of the time; shrinks to false. */
+const chance = (pct) => ints(0, 99).map((r) => r >= 100 - pct);
+/** A draw from g pct percent of the time, else undefined (listed first: shrinks to absent). */
+const maybe = (pct, g) => weighted([100 - pct, gs.just(undefined)], [pct, g]);
+/** lo–hi characters from `alphabet`, an array of strings (a repeated entry weighs more, and an
+ * astral character stays whole — neither of which gs.text's alphabet, a set of code units, gives). */
+const text = (alphabet, lo, hi) => gs.arrays(gs.sampledFrom(alphabet), { minSize: lo, maxSize: hi }).map((cs) => cs.join(""));
+const dropUndefined = (o) => Object.fromEntries(Object.entries(o).filter(([, v]) => v !== undefined));
+/** The parts of `gens` in order, each a generator of one part or of a list of parts. */
+const cat = (...gens) => gs.tuples(...gens).map((ps) => ps.flat());
+
+// ---------------------------------------------------------------- a word program
+//
+// A word is a run of parts (bare text, a backslash escape, a single-quoted or double-quoted
+// span, an unquoted expansion). The generators below draw the parts as data; `mkWord` renders
+// them under the drawn `env` into the three texts of a word — `sq` for parse, `bashD` for bash
+// standing in for parse's default mode (unquoted expansions wrapped in double quotes, since
+// that mode never field-splits), `bashS` for bash under field splitting — plus a `model` of
+// the word bash yields in default mode, `glob` (bash would glob it), `exp` (it holds an
+// unquoted expansion) and the `flags` of recorded shapes the word touches.
+
+// The variables: E empty, W blanks, A/B/C hostile values, one time in three an `_x`.
+const env = gs
+  .record({
+    E: gs.just(""),
+    W: gs.sampledFrom([" ", "  ", " \t", "\n"]),
+    A: text(VALUE_CHARS, 0, 5),
+    B: text(VALUE_CHARS, 0, 5),
+    C: text(VALUE_CHARS, 0, 5),
+    _x: maybe(30, text(BARE, 1, 3)),
+  })
+  .map(dropUndefined);
+
+// A part whose rendering does not depend on env: the same text for parse and bash.
+const lit = (s, model, { flags = [], glob = false } = {}) => ({ kind: "lit", sq: s, model, flags, glob });
+const LINE_CONTINUATION = lit("\\\n", "", { flags: ["parse/line-continuation"] });
+const isGlobChar = (c) => c === "*" || c === "?";
+const isName = (s) => /^[A-Za-z_][A-Za-z0-9_]*$/.test(s);
+
+// bare text; one time in thirty-three a `#`, a glob character or an odd space inside it (under
+// HEGEL_NO_KNOWN=1 only a glob character)
+const SPECIAL = noKnown ? ["*", "?"] : ["#", "*", "*", "?", "?", ...ODD_SPACE];
+const bareText = text(BARE, 1, 4);
+const bareWith = (specials) => gs.tuples(bareText, gs.sampledFrom(specials), text(BARE, 0, 2)).map(([a, c, b]) => lit(a + c + b, a + c + b, isGlobChar(c) ? { glob: true } : { flags: [c === "#" ? "parse/hash-in-word" : "parse/unicode-space"] }));
+const bare = weighted([97, bareText.map((s) => lit(s, s))], [3, bareWith(SPECIAL)]);
+// a backslash escape; one time in fifty a backslash-newline (under HEGEL_NO_KNOWN=1 neither
+// that nor a glob character)
+const escapeOf = (chars) => gs.sampledFrom(chars).map((c) => lit("\\" + c, c, { flags: isGlobChar(c) ? ["parse/escaped-glob-char"] : [] }));
+const escape = noKnown ? escapeOf(ESCAPABLE.filter((c) => !isGlobChar(c))) : weighted([98, escapeOf(ESCAPABLE)], [2, gs.just(LINE_CONTINUATION)]);
+const singleQuoted = text(SQ_CHARS, 0, 5).map((s) => lit("'" + s + "'", s));
+// inside double quotes: a character (a backslash before an ordinary character stays), an
+// escaped `"` `\` `$` `` ` ``, a backslash-newline, or a `$VAR`/`${VAR}` (under HEGEL_NO_KNOWN=1
+// no `` \` `` and no backslash-newline, and a span never ends in an escaped backslash)
+const dqLit = gs.sampledFrom(DQ_CHARS).map((c) => ({ t: "lit", s: c === "\\" ? "\\a" : c }));
+const dqEsc = (chars) => gs.sampledFrom(chars).map((c) => ({ t: "esc", c }));
+const dqVar = (names) => gs.record({ t: gs.just("var"), name: gs.sampledFrom(names), braces: chance(40) });
+const dqItem = noKnown
+  ? weighted([60, dqLit], [23, dqEsc(['"', "\\", "\\", "$", "$"])], [15, dqVar(NAMES)])
+  : weighted([60, dqLit], [23, dqEsc(['"', "\\", "\\", "$", "$", "`"])], [2, gs.just({ t: "lc" })], [15, dqVar(NAMES)]);
+const isBackslashEsc = (it) => it.t === "esc" && it.c === "\\";
+const trimmed = (items) => (noKnown && items.length && isBackslashEsc(items[items.length - 1]) ? trimmed(items.slice(0, -1)) : items);
+const doubleQuoted = gs.arrays(dqItem, { maxSize: 5 }).map((items) => ({ kind: "dq", items: trimmed(items) }));
+// an unquoted expansion; one time in seventeen a name of a recorded shape (`${1x}` is a bad
+// substitution in bash, so a digit name is never braced; not under HEGEL_NO_KNOWN=1)
+const exp = (name, braces = false) => ({ kind: "exp", name, braces });
+const expOf = (names) => gs.record({ kind: gs.just("exp"), name: gs.sampledFrom(names), braces: chance(40) }).map((p) => (/^\d/.test(p.name) ? { ...p, braces: false } : p));
+const expansion = noKnown ? expOf(NAMES) : weighted([94, expOf(NAMES)], [6, expOf(["_x", "1x", "constructor", ...SPECIAL_PARAMS])]);
+const part = weighted([35, bare], [15, escape], [15, singleQuoted], [20, doubleQuoted], [15, expansion]);
+// a word: 1–3 parts
+const rawWord = gs.arrays(part, { minSize: 1, maxSize: 3 });
+
+/** The value of `name` as bash reads it: an own property of env; `$1x` is `$1` (empty) then `x`; else empty. */
+const valueOf = (env, name) => (Object.hasOwn(env, name) ? env[name] : /^\d/.test(name) ? name.slice(1) : "");
+/** The recorded shape of an expansion by its name, if any. */
+const nameShape = (name) => (/^_/.test(name) ? "parse/underscore-name" : /^\d/.test(name) ? "parse/digit-name" : PROTO_NAMES.includes(name) ? "parse/prototype-env" : null);
+const NOTHING = { sq: "", bash: "", bashS: "", model: "", glob: false, exp: false, flags: [] };
+
+// The renderings of one part under env: `sq` for parse, `bash` for bash in the default mode,
+// `bashS` for bash under field splitting, the `model` word, `glob`, `exp` and its flags.
+function renderPart(p, env) {
+  if (p.kind === "lit") return { ...NOTHING, sq: p.sq, bash: p.sq, bashS: p.sq, model: p.model, glob: p.glob, flags: p.flags };
+  if (p.kind === "dq") {
+    let inner = "";
+    let model = "";
+    const flags = [];
+    p.items.forEach((it, i) => {
+      if (it.t === "lit") {
+        inner += it.s;
+        model += it.s;
+      } else if (it.t === "esc") {
+        if (it.c === "`") flags.push("parse/backtick-in-double-quotes");
+        inner += "\\" + it.c;
+        model += it.c;
+      } else if (it.t === "lc") {
+        flags.push("parse/line-continuation");
+        inner += "\\\n";
+      } else {
+        // A `$NAME` directly followed by a name character (even across a line continuation,
+        // which the shell removes first) would read a longer name: brace it. (Only a real
+        // expansion of a name: an escaped `\$` before a letter is text, and a one-character
+        // parameter takes no more, so both stay unbraced.)
+        let next = p.items[i + 1];
+        for (let j = i + 2; next && next.t === "lc"; j++) next = p.items[j];
+        const glued = isName(it.name) && next && next.t === "lit" && /^[A-Za-z0-9_]/.test(next.s);
+        inner += it.braces || glued ? "${" + it.name + "}" : "$" + it.name;
+        model += valueOf(env, it.name);
+        const shape = nameShape(it.name);
+        if (shape) flags.push(shape);
+        // the character after a one-character parameter is dropped
+        if (SPECIAL_PARAMS.includes(it.name) && next) flags.push("parse/dropped-character-after-parameter");
+      }
+    });
+    if (inner.endsWith("\\\\")) flags.push("parse/escaped-backslash-before-quote");
+    const s = '"' + inner + '"';
+    return { ...NOTHING, sq: s, bash: s, bashS: s, model, flags };
+  }
+  // an unquoted expansion: bash reads $1x as $1 (empty) then x; a prototype name is unset
+  const ref = p.braces ? "${" + p.name + "}" : "$" + p.name;
+  const shape = nameShape(p.name);
+  return { sq: ref, bash: '"' + ref + '"', bashS: ref, model: valueOf(env, p.name), glob: false, exp: true, flags: shape ? [shape] : [], name: p.name };
+}
+
+// The word the parts make under env.
+function mkWord(parts, env) {
+  const rendered = parts.map((p) => renderPart(p, env));
+  // an unbraced expansion directly followed by a name character would read a longer name:
+  // brace it (a digit name cannot be braced: drop it; braced, `$_x` is read right)
+  const rs = rendered.map((r, i) => {
+    const next = rendered[i + 1];
+    if (!(r.exp && /^\$[A-Za-z_0-9]+$/.test(r.sq) && next && /^[A-Za-z0-9_]/.test(next.sq))) return r;
+    if (/^\d/.test(r.name)) return NOTHING;
+    return { ...r, sq: "${" + r.name + "}", bash: '"${' + r.name + '}"', bashS: "${" + r.name + "}", flags: r.flags.filter((f) => f !== "parse/underscore-name") };
+  });
+  const flags = new Set(rs.flatMap((r) => r.flags));
+  const glob = rs.some((r) => r.glob);
+  const exp = rs.some((r) => r.exp);
+  const w = { sq: "", bashD: "", bashS: "", model: "", glob, exp, flags, quoted: rs.some((r) => /^['"]/.test(r.sq)) };
+  let afterExp = false;
+  let emptyQuoted = false;
+  rs.forEach((r, i) => {
+    // an empty quoted span after a split expansion is a word the shell keeps and parse drops
+    if (afterExp && /^['"]/.test(r.sq) && r.model === "") flags.add("parse/split-drops-empty-quoted");
+    // an empty quoted span before a split expansion whose value starts with an IFS character is
+    // a word the shell keeps and parse drops when a field follows (which characters split, and so
+    // whether one follows, depends on the IFS drawn later: the shape is flagged whenever the
+    // expansion is non-empty, and a flag only names or excuses a mismatch)
+    if (emptyQuoted && w.model === "" && r.exp && r.model !== "") flags.add("parse/split-drops-leading-empty-quoted");
+    if (/^['"]/.test(r.sq) && r.model === "") emptyQuoted = true;
+    // the character after a one-character parameter is dropped
+    if (r.exp && SPECIAL_PARAMS.includes(r.name) && rs.slice(i + 1).some((n) => n.sq !== "")) flags.add("parse/dropped-character-after-parameter");
+    // an escaped backslash before a quote or the end of the word: the chunker reads the second
+    // backslash as escaping what follows (`\\ x` is one word to parse, two to the shell)
+    if (r.sq === "\\\\" && (i === rs.length - 1 || /^['"]/.test(rs[i + 1].sq))) flags.add("parse/escaped-backslash-before-blank");
