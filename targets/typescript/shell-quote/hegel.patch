index 0000000..f231153
--- /dev/null
+++ b/test/hegel.test.mjs
@@ -0,0 +1,529 @@
+// Hegel zoo: properties of shell-quote (ljharb/shell-quote) — `quote` output read back by
+// real shells (dash and bash) and by `parse`; `parse` against bash's own word splitting, in
+// the default mode and under `splitUnquoted`; operators and comments against a model.
+//
+// Run with `node --test --test-reporter=tap test/hegel.test.mjs`; needs `bash` and `dash`
+// on PATH (the oracles). ZOO_COLLECT=1 records mismatches instead of failing (see
+// test/hegel-zoo.mjs).
+
+import assert from "node:assert/strict";
+import { execFileSync } from "node:child_process";
+import { mkdtempSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import sq from "../index.js";
+import { property, pin, fail, count, n, pick, chance, word, same, show, collecting } from "./hegel-zoo.mjs";
+
+const { parse, quote } = sq;
+
+// ---------------------------------------------------------------- the shell oracle
+
+// An empty directory to run the shells in, so a glob that slipped through matches nothing.
+const EMPTY = mkdtempSync(join(tmpdir(), "hegel-shell-quote-"));
+
+function shSingle(s) {
+  return "'" + s.replace(/'/g, "'\\''") + "'";
+}
+
+// The words `script` denotes to `shell`, via `printf "%s\0"`: pathname expansion off, a fixed
+// first word so an empty script still yields a well-formed record, `env` the only variables.
+function shellWords(shell, script, env = {}, ifs) {
+  const pre = "set -f; " + (ifs === undefined ? "" : "IFS=" + shSingle(ifs) + "; ");
+  const out = execFileSync(shell, ["-c", pre + 'printf "%s\\0" x ' + script], {
+    env: { PATH: process.env.PATH, HOME: EMPTY, ...env },
+    cwd: EMPTY,
+  });
+  const parts = out.toString("utf8").split("\0");
+  parts.pop();
+  parts.shift();
+  return parts;
+}
+
+// ---------------------------------------------------------------- alphabets
+
+const BARE = ["a", "b", "z", "Z", "0", "9", "-", "_", ".", "/", "=", ":", "+", "%", "@", "^", "!", ",", "é", "全", "😀"];
+// Characters a bare word may carry that the shell treats as ordinary but a JavaScript `\s`
+// does not (CR, VT, FF, NBSP, U+2028, BOM): the shape `parse/unicode-space`.
+const ODD_SPACE = ["\r", "\v", "\f", "\u00a0", "\u2028", "\ufeff"];
+const ESCAPABLE = ["a", " ", "\t", '"', "'", "$", "`", "\\", "|", "&", ";", "<", ">", "(", ")", "#", "*", "?", "!", "="];
+const SQ_CHARS = [...BARE, " ", "\t", "\n", '"', "$", "\\", "#", "*", "!", "`", "|", "&", ";", "~"];
+const DQ_CHARS = [...BARE, " ", "\t", "\n", "'", "#", "*", "?", "!", "|", "&", ";", "~", "\\"];
+const VALUE_CHARS = [...BARE, " ", " ", ":", "*", "'", '"', "\\", "$", "#", "!", "`", "\t", "\n", "|"];
+const NAMES = ["A", "B", "C", "E", "W", "N"]; // E empty, W blanks, N unset
+
+// ---------------------------------------------------------------- a word program
+//
+// A word is a run of parts (bare text, a backslash escape, a single-quoted or double-quoted
+// span, an unquoted expansion). Each word carries three renderings — `sq` for parse, `bashD`
+// for bash standing in for parse's default mode (unquoted expansions wrapped in double quotes,
+// since that mode never field-splits), `bashS` for bash under field splitting — a `model` of
+// the word bash yields in default mode, `glob` (bash would glob it) and the flags of pinned
+// shapes the word touches.
+
+function genEnv(tc) {
+  const env = { E: "", W: pick(tc, [" ", "  ", " \t", "\n"]) };
+  for (const k of ["A", "B", "C"]) {
+    env[k] = word(tc, VALUE_CHARS, 0, 5);
+  }
+  if (chance(tc, 30)) env._x = word(tc, BARE, 1, 3);
+  return env;
+}
+
+function genPart(tc, env, w, next) {
+  const r = n(tc, 0, 99);
+  if (r < 35) {
+    let s = word(tc, BARE, 1, 4);
+    if (chance(tc, 3)) {
+      const c = pick(tc, ["#", "*", "*", "?", "?", ...ODD_SPACE]);
+      if (c === "#") w.flags.add("parse/hash-in-word");
+      else if (c === "*" || c === "?") w.glob = true;
+      else w.flags.add("parse/unicode-space");
+      s += c + word(tc, BARE, 0, 2);
+    }
+    if (w.sq === "" && s.startsWith("#")) s = "x" + s; // a leading # would start a comment
+    return { sq: s, bash: s, model: s };
+  }
+  if (r < 50) {
+    if (chance(tc, 2)) {
+      w.flags.add("parse/line-continuation");
+      return { sq: "\\\n", bash: "\\\n", model: "" };
+    }
+    const c = pick(tc, ESCAPABLE);
+    if (c === "*" || c === "?") w.flags.add("parse/escaped-glob-char");
+    return { sq: "\\" + c, bash: "\\" + c, model: c };
+  }
+  if (r < 65) {
+    const s = word(tc, SQ_CHARS, 0, 5);
+    return { sq: "'" + s + "'", bash: "'" + s + "'", model: s };
+  }
+  if (r < 85) {
+    let sq = "";
+    let model = "";
+    const k = n(tc, 0, 5);
+    for (let i = 0; i < k; i++) {
+      const q = n(tc, 0, 99);
+      if (q < 60) {
+        const c = pick(tc, DQ_CHARS);
+        if (c === "\\") {
+          // a backslash before an ordinary character stays
+          sq += "\\a";
+          model += "\\a";
+        } else {
+          sq += c;
+          model += c;
+        }
+      } else if (q < 83) {
+        const c = pick(tc, ['"', "\\", "\\", "$", "$", "`"]);
+        if (c === "`") w.flags.add("parse/backtick-in-double-quotes");
+        sq += "\\" + c;
+        model += c;
+      } else if (q < 85) {
+        w.flags.add("parse/line-continuation");
+        sq += "\\\n";
+      } else {
+        const name = pick(tc, NAMES);
+        const braces = chance(tc, 40);
+        sq += braces ? "${" + name + "}" : "$" + name;
+        model += env[name] ?? "";
+      }
+    }
+    if (sq.endsWith("\\\\")) w.flags.add("parse/escaped-backslash-before-quote");
+    // A `$NAME` directly followed by a name character (even across a line continuation, which
+    // the shell removes first) would read a longer name: brace it.
+    sq = sq.replace(/\$([A-Z])(?=[A-Za-z0-9_]|\\\n[A-Za-z0-9_])/g, "${$1}");
+    return { sq: '"' + sq + '"', bash: '"' + sq + '"', model };
+  }
+  // an unquoted expansion
+  let name = pick(tc, NAMES);
+  let model = env[name] ?? "";
+  let braces = chance(tc, 40);
+  if (chance(tc, 6)) {
+    const odd = pick(tc, ["_x", "1x", "constructor"]);
+    if (odd === "_x") {
+      w.flags.add("parse/underscore-name");
+      model = env._x ?? "";
+    } else if (odd === "1x") {
+      w.flags.add("parse/digit-name");
+      braces = false; // ${1x} is a bad substitution in bash
+      model = "x";
+    } else {
+      w.flags.add("parse/prototype-env");
+      model = "";
+    }
+    name = odd;
+  }
+  if (!braces && next && /^[A-Za-z0-9_]/.test(next)) braces = name !== "1x";
+  if (name === "1x" && next && /^[A-Za-z0-9_]/.test(next)) return { sq: "", bash: "", model: "" };
+  const ref = braces ? "${" + name + "}" : "$" + name;
+  w.exp = true;
+  if (w.glob) w.flags.add("parse/split-then-glob");
+  return { sq: ref, bash: '"' + ref + '"', bashS: ref, model, exp: true };
+}
+
+function genWord(tc, env) {
+  const w = { sq: "", bashD: "", bashS: "", model: "", glob: false, exp: false, flags: new Set() };
+  const k = n(tc, 1, 3);
+  // draw the parts first so a part can look at what follows it
+  const parts = [];
+  for (let i = 0; i < k; i++) {
+    parts.push(genPart(tc, env, w, undefined));
+  }
+  // an expansion followed by a name character is braced (see genPart); redo those
+  for (let i = 0; i < parts.length; i++) {
+    const p = parts[i];
+    if (p.exp && i + 1 < parts.length && /^\$[A-Za-z_0-9]+$/.test(p.sq) && /^[A-Za-z0-9_]/.test(parts[i + 1].sq)) {
+      const name = p.sq.slice(1);
+      if (name === "1x") {
+        parts[i] = { sq: "", bash: "", model: "" };
+      } else {
+        parts[i] = { ...p, sq: "${" + name + "}", bash: '"${' + name + '}"', bashS: "${" + name + "}" };
+      }
+    }
+  }
+  let afterExp = false;
+  for (const p of parts) {
+    w.sq += p.sq;
+    w.bashD += p.bash;
+    w.bashS += p.bashS ?? p.bash;
+    w.model += p.model;
+    // an empty quoted span after a split expansion is a word the shell keeps and parse drops
+    if (afterExp && /^['"]/.test(p.sq) && p.model === "") w.flags.add("parse/split-drops-empty-quoted");
+    if (p.exp) afterExp = true;
+  }
+  if (w.sq.replace(/\\\n/g, "") === "") {
+    // nothing, or only line continuations: no word at all to the shell
+    w.sq = w.bashD = w.bashS = w.model = "y";
+    w.flags.clear();
+  }
+  // an even run of backslashes before a quote or the end of the word: the chunker reads the
+  // last one as escaping what follows (`\\ x` is one word to parse, two to the shell)
+  if (/(^|[^\\])(\\\\)+(["']|$)/.test(w.sq)) w.flags.add("parse/escaped-backslash-before-blank");
+  // an unquoted glob character after an unquoted expansion: the split-then-glob shape
+  if (w.exp && w.glob) w.flags.add("parse/split-then-glob");
+  return w;
+}
+
+// A program of 1–5 words with blank separators; 4% of the joins are a backslash-newline,
+// which glues the two words in the shell (the `parse/line-continuation` shape).
+function genProgram(tc, env) {
+  const words = [];
+  const k = n(tc, 1, 5);
+  for (let i = 0; i < k; i++) {
+    const w = genWord(tc, env);
+    if (words.length && chance(tc, 2)) {
+      const prev = words[words.length - 1];
+      prev.sq += "\\\n" + w.sq;
+      prev.bashD += "\\\n" + w.bashD;
+      prev.bashS += "\\\n" + w.bashS;
+      prev.model += w.model;
+      prev.glob = prev.glob || w.glob;
+      prev.exp = prev.exp || w.exp;
+      for (const f of w.flags) prev.flags.add(f);
+      prev.flags.add("parse/line-continuation");
+    } else {
+      words.push(w);
+    }
+  }
+  const sep = () => pick(tc, [" ", " ", "\t", "  ", " \t"]);
+  const lead = chance(tc, 20) ? sep() : "";
+  const trail = chance(tc, 20) ? sep() : "";
+  let sq = lead;
+  let bashD = lead;
+  let bashS = lead;
+  words.forEach((w, i) => {
+    const s = i ? sep() : "";
+    sq += s + w.sq;
+    bashD += s + w.bashD;
+    bashS += s + w.bashS;
+  });
+  return { words, sq: sq + trail, bashD: bashD + trail, bashS: bashS + trail };
+}
+
+// Do parse's tokens denote the shell's words? A glob token stands for its pattern.
+function tokensMatch(tokens, wordsOut, program) {
+  if (tokens.length !== wordsOut.length) return false;
+  for (let i = 0; i < tokens.length; i++) {
+    const t = tokens[i];
+    if (typeof t === "string") {
+      if (t !== wordsOut[i]) return false;
+    } else if (t && t.op === "glob") {
+      if (t.pattern !== wordsOut[i]) return false;
+    } else {
+      return false;
+    }
+  }
+  return true;
+}
+
+// The pinned shapes a program touches; count them all and say whether there were any.
+function explain(program) {
+  let any = false;
+  for (const w of program.words) {
+    for (const f of w.flags) {
+      count(f);
+      any = true;
+    }
+  }
+  return any;
+}
+
+// ---------------------------------------------------------------- properties
+
+// quote: what dash and bash read back from quote(xs) is xs, and so does parse.
+const STR_CHARS = [...BARE, ...ODD_SPACE, " ", "\t", "\n", "'", '"', "\\", "$", "`", "!", "#", "*", "?", "[", "]", "{", "}", "~", "|", "&", ";", "<", ">", "(", ")", "\x01"];
+const STR_LITERALS = ["", "it's!", "it's `x`", "C:\\x", "~", "-n", "--", "1e21", "a=b", " ", "'", '"', "\\", "$HOME", "*", "#x"];
+const OPS = ["||", "&&", ";;", "|&", "<(", "<<<", ">>", ">&", "<&", "&", ";", "(", ")", "|", "<", ">"];
+const GLOB_CHARS = [...BARE, "*", "?", "[", "]", " ", "'", '"', "\\", "$", "!", "#", "~", "|", ";"];
+
+property("TestHegelQuotedWordsSurviveTheShell", (tc) => {
+  const xs = [];
+  const want = []; // the words the shell should read
+  const wantParse = []; // and parse's tokens for them
+  const shapes = new Set();
+  const k = n(tc, 0, 6);
+  let comment = null;
+  for (let i = 0; i < k; i++) {
+    const r = n(tc, 0, 99);
+    if (r < 62) {
+      const s = chance(tc, 25) ? pick(tc, STR_LITERALS) : word(tc, STR_CHARS, 0, 6);
+      xs.push(s);
+      want.push(s);
+      wantParse.push(s);
+      const dq = /["'\s]/.test(s) && !(/["\s\\]/.test(s) && !/'/.test(s)); // quote's double-quote branch
+      if (dq && /!/.test(s)) shapes.add("quote/bang-in-double-quotes");
+      if (dq && /`/.test(s)) shapes.add("parse/backtick-in-double-quotes");
+      if (dq && s.endsWith("\\")) shapes.add("parse/escaped-backslash-before-quote"); // quote writes \\ before the closing "
+      if (!/["\s\\']/.test(s) && /[*?]/.test(s)) shapes.add("parse/escaped-glob-char");
+    } else if (r < 70) {
+      const v = pick(tc, [0, 1, -1, 7, 1.5, 1e21, true, false, null, undefined]);
+      xs.push(v);
+      want.push(String(v));
+      wantParse.push(String(v));
+    } else if (r < 84) {
+      const op = pick(tc, OPS);
+      xs.push({ op });
+      want.push(op); // quote makes an operator a literal word (documented)
+      wantParse.push(op);
+    } else if (r < 94) {
+      const pattern = word(tc, GLOB_CHARS, 1, 5);
+      xs.push({ op: "glob", pattern });
+      want.push(pattern);
+      // parse reports a glob only for * and ? (a bracket class is a plain word: limit/bracket-glob)
+      wantParse.push(/[*?]/.test(pattern) ? { op: "glob", pattern } : pattern);
+      if (!/[*?]/.test(pattern) && /[[\]]/.test(pattern)) count("limit/bracket-glob");
+      if (pattern.endsWith("\\")) shapes.add("parse/escaped-backslash-before-blank"); // quote writes \\ before the blank
+    } else {
+      comment = word(tc, [...BARE, " ", "'", '"', "$", "\\", "#"], 0, 5);
+      xs.push({ comment });
+      break; // a comment runs to the end of the line
+    }
+  }
+  const q = quote(xs);
+  for (const shell of ["dash", "bash"]) {
+    const got = shellWords(shell, q);
+    if (!same(got, want)) {
+      if (shapes.size) {
+        for (const s of shapes) count(s);
+        return;
+      }
+      fail(`${shell} reads ${show(q)} (quote of ${show(xs)}) as ${show(got)}, not ${show(want)}`);
+    }
+  }
+  const p = parse(q);
+  const wantTokens = comment === null ? wantParse : [...wantParse, { comment }];
+  if (!same(p, wantTokens)) {
+    if (shapes.size) {
+      for (const s of shapes) count(s);
+      return;
+    }
+    fail(`parse(${show(q)}) (quote of ${show(xs)}) = ${show(p)}, not ${show(wantTokens)}`);
+  }
+});
+
+// parse, default mode: the tokens of a program are the words bash reads when each unquoted
+// expansion is double-quoted (parse never splits an expansion unless asked to).
+property("TestHegelParseAgreesWithBash", (tc) => {
+  const env = genEnv(tc);
+  const program = genProgram(tc, env);
+  const want = shellWords("bash", program.bashD, env);
+  const model = program.words.map((w) => w.model);
+  if (!same(model, want)) {
+    // the model is a check on the generator, not on parse
+    count("model-differs");
+    if (collecting) console.log(`# model ${show(program.bashD)} ${show(env)}: model ${show(model)}, bash ${show(want)}`);
+  }
+  let got;
+  try {
+    got = parse(program.sq, env);
+  } catch (e) {
+    fail(`parse(${show(program.sq)}, ${show(env)}) threw ${e.message}`);
+  }
+  if (!tokensMatch(got, want, program)) {
+    if (explain(program)) return;
+    fail(`parse(${show(program.sq)}, ${show(env)}) = ${show(got)}; bash reads ${show(program.bashD)} as ${show(want)}`);
+  }
+  // a glob token must come from an unquoted, unescaped * or ?
+  got.forEach((t, i) => {
+    if (t && t.op === "glob" && !program.words[i]?.glob) {
+      if (explain(program)) return;
+      fail(`parse(${show(program.sq)}) reports ${show(t)} as a glob, but the shell would not expand it`);
+    }
+  });
+});
+
+// parse with splitUnquoted: the tokens are the words bash reads with IFS set the same way.
+property("TestHegelSplitUnquotedAgreesWithBash", (tc) => {
+  const env = genEnv(tc);
+  const program = genProgram(tc, env);
+  const opt = pick(tc, [true, true, ":", " :", ",", "\t\n", ":\t", ""]);
+  const ifs = opt === true ? " \t\n" : opt;
+  const want = shellWords("bash", program.bashS, env, ifs);
+  let got;
+  try {
+    got = parse(program.sq, env, { splitUnquoted: opt });
+  } catch (e) {
+    fail(`parse(${show(program.sq)}, ${show(env)}, {splitUnquoted: ${show(opt)}}) threw ${e.message}`);
+  }
+  if (!tokensMatch(got, want, program)) {
+    if (explain(program)) return;
+    // an empty IFS: no splitting, but the shell still drops an unquoted expansion that is empty
+    if (opt === "" && program.words.some((w) => w.exp)) {
+      count("parse/empty-ifs-keeps-empty-word");
+      return;
+    }
+    fail(`parse(${show(program.sq)}, ${show(env)}, {splitUnquoted: ${show(opt)}}) = ${show(got)}; bash with IFS=${show(ifs)} reads it as ${show(want)}`);
+  }
+});
+
+// parse: words, operators and a trailing comment tokenize as written, the words as the model
+// says (the model is checked against bash above).
+property("TestHegelOperatorsAndCommentsTokenize", (tc) => {
+  const env = genEnv(tc);
+  const items = [];
+  const want = [];
+  const k = n(tc, 1, 7);
+  let flagged = false;
+  for (let i = 0; i < k; i++) {
+    if (chance(tc, 35)) {
+      const op = pick(tc, OPS);
+      items.push({ op });
+      want.push({ op });
+    } else {
+      let w = genWord(tc, env);
+      for (let tries = 0; tries < 5 && w.flags.size; tries++) w = genWord(tc, env); // plain words only here
+      if (w.flags.size) flagged = true;
+      items.push(w);
+      want.push(w.glob ? { op: "glob", pattern: w.model } : w.model);
+    }
+  }
+  let s = chance(tc, 20) ? " " : "";
+  for (let i = 0; i < items.length; i++) {
+    const it = items[i];
+    const prev = items[i - 1];
+    if (i) {
+      // two operators or two words need a blank between them; a word and an operator need not
+      const need = (it.op && prev.op) || (!it.op && !prev.op);
+      s += need || chance(tc, 60) ? pick(tc, [" ", "\t", "  "]) : "";
+    }
+    s += it.op ? it.op : it.sq;
+  }
+  let comment = null;
+  if (chance(tc, 15)) {
+    comment = word(tc, [...BARE, " ", "'", '"', "$", "\\", "#", "|", ";"], 0, 6);
+    s += (s === "" || /[ \t]$/.test(s) ? "" : " ") + "#" + comment; // a comment starts a word
+    want.push({ comment });
+  }
+  const got = parse(s, env);
+  if (!same(got, want)) {
+    if (flagged) {
+      count("flagged-word");
+      return;
+    }
+    fail(`parse(${show(s)}, ${show(env)}) = ${show(got)}, not ${show(want)}`);
+  }
+});
+
+// ---------------------------------------------------------------- pins
+
+pin("TestHegelPinBangInDoubleQuotesIsEscaped", () => {
+  // quote/1: the double-quote branch writes \! and the shell keeps the backslash
+  assert.deepEqual(shellWords("dash", quote(["it's!"])), ["it's!"]);
+});
+
+pin("TestHegelPinBacktickInDoubleQuotesKeepsTheBackslash", () => {
+  // quote/2: bash reads "a\`b" as a`b; parse keeps the backslash (and so cannot read quote's own output)
+  assert.deepEqual(parse('"a\\`b"'), ["a`b"]);
+});
+
+pin("TestHegelPinHashInsideAWordIsNotAComment", () => {
+  // quote/3
+  assert.deepEqual(parse("a#b"), ["a#b"]);
+});
+
+pin("TestHegelPinEscapedBackslashBeforeTheClosingQuote", () => {
+  // quote/4: the chunker reads the second backslash and the closing quote as an escaped quote
+  assert.deepEqual(parse('"\\\\" "x"'), ["\\", "x"]);
+});
+
+pin("TestHegelPinBackslashNewlineIsALineContinuation", () => {
+  // quote/5
+  assert.deepEqual(parse("a\\\nb"), ["ab"]);
+});
+
+pin("TestHegelPinUnderscoreStartsAVariableName", () => {
+  // quote/6: $_foo is the variable _foo, not $_ followed by text
+  assert.deepEqual(parse("$_foo", { _foo: "X" }), ["X"]);
+});
+
+pin("TestHegelPinCharacterAfterAOneCharacterParameterIsKept", () => {
+  // quote/7: $*x with * looked up in env is the value followed by x
+  assert.deepEqual(parse("$*x", { "*": "S" }), ["Sx"]);
+});
+
+pin("TestHegelPinDigitDoesNotStartAVariableName", () => {
+  // quote/8: bash reads $1x as $1 followed by x
+  assert.deepEqual(parse("$1x", {}), ["x"]);
+});
+
+pin("TestHegelPinEnvLookupIgnoresThePrototype", () => {
+  // quote/9: an unset variable expands to '', even one named like an Object.prototype member
+  assert.deepEqual(parse("$constructor", {}), [""]);
+});
+
+pin("TestHegelPinCarriageReturnDoesNotSplitAWord", () => {
+  // quote/10: the shell splits on space, tab and newline only
+  assert.deepEqual(parse("a\rb"), ["a\rb"]);
+});
+
+pin("TestHegelPinEscapedStarIsNotAGlob", () => {
+  // quote/11
+  assert.deepEqual(parse("\\*"), ["*"]);
+});
+
+pin("TestHegelPinFieldsBeforeAGlobAreKept", () => {
+  // quote/12: with splitUnquoted, the fields split off before a glob character vanish
+  assert.deepEqual(parse("a$V*", { V: "x y" }, { splitUnquoted: true }), ["ax", { op: "glob", pattern: "y*" }]);
+});
+
+pin("TestHegelPinEscapedBackslashDoesNotEscapeTheBlank", () => {
+  // quote/14: `\\ x` is a backslash and a word; the chunker reads the second backslash as escaping the blank
+  assert.deepEqual(parse("\\\\ x"), ["\\", "x"]);
+});
+
+pin("TestHegelPinEmptyIfsDropsAnEmptyExpansion", () => {
+  // quote/15: splitUnquoted: '' (no splitting) should still drop an unquoted empty expansion, as
+  // splitUnquoted: true does and as the shell does under IFS=''
+  assert.deepEqual(parse("a $E b", { E: "" }, { splitUnquoted: "" }), ["a", "b"]);
+});
+
+pin("TestHegelPinEmptyQuotesAfterASplitExpansionAreAWord", () => {
+  // quote/16: with splitUnquoted, the empty word `""` after a split expansion vanishes
+  assert.deepEqual(parse('a$W""', { W: " " }, { splitUnquoted: true }), ["a", ""]);
+});
+
+pin("TestHegelPinObjectValueDoesNotLeakTheMarker", () => {
+  // quote/13: an object value in an object env comes out as the internal marker string
+  const got = parse("$F", { F: { k: 1 } });
+  assert.equal(got.length, 1);
+  assert.ok(typeof got[0] === "object" || !/[0-9a-f]{8}\./.test(got[0]), show(got));
+});
