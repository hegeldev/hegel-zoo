+const MARKER = /[0-9a-f]{8}\./; // parse's per-process token is four hex numbers with fractions
+const NON_NAME = BARE.filter((c) => !/^[A-Za-z0-9_]/.test(c));
+const jsonValue = gs.oneOf(text(BARE, 0, 3), ints(-5, 5), gs.sampledFrom([true, false, null]));
+const objectValue = gs.oneOf(gs.maps(text(NAME_CHARS, 1, 3), jsonValue, { maxSize: 3 }).map((m) => Object.fromEntries(m)), gs.arrays(jsonValue, { maxSize: 3 }));
+const objectEnvCase = gs.record({ value: objectValue, how: weighted([70, gs.just("object")], [30, gs.just("function")]), before: text(BARE, 0, 2), braces: chance(40), after: text(NON_NAME, 0, 2), glob: gs.sampledFrom(["*", "?"]) }).map(({ value, how, before, braces, after, glob }) => ({
+  value,
+  how,
+  word: before + (braces ? "${F}" : "$F") + after + (how === "function" ? glob : ""),
+}));
+
+property("TestHegelObjectEnvValuesDoNotLeakTheMarker", (tc) => {
+  const { value, how, word } = tc.draw(objectEnvCase);
+  const env = how === "object" ? { F: value } : (key) => (key === "F" ? value : undefined);
+  const got = parse(word, env);
+  const leaks = (t) => (typeof t === "string" ? MARKER.test(t) : isGlob(t) && MARKER.test(t.pattern));
+  if (got.some(leaks)) fail(`parse(${show(word)}, ${how} env with F = ${show(value)}) = ${show(got)}: the internal marker leaks${recorded(tc, new Set(["parse/object-env-value"]))}`);
+}, KNOWN);
+
+// shell-quote/14: an escaped backslash ending a word before a blank and another word, or before
+// a double-quoted span with a blank in it (the chunker reads the second backslash as an escape)
+const escapedBackslash = gs.just(lit("\\\\", "\\"));
+const dqWithBlank = dqOf(cat(gs.arrays(plainDqItem, { maxSize: 3 }), gs.sampledFrom([" ", "\t"]).map((s) => ({ t: "lit", s })), gs.arrays(plainDqItem, { maxSize: 3 })));
+const backslashThenBlank = programAround(withEnv(cat(fillers, escapedBackslash)), { after: plainWords(1, 2) });
+const backslashThenQuote = programAround(withEnv(cat(fillers, escapedBackslash, dqWithBlank, fillers)));
+
+property("TestHegelEscapedBackslashBeforeABlankAgreesWithBash", (tc) => {
+  const { env, program } = tc.draw(gs.oneOf(backslashThenBlank, backslashThenQuote));
+  checkParse(tc, env, program);
+}, KNOWN);
+
+// The split shapes: the option, and the variable S = left + one IFS character (a blank when
+// `blank`) + right, expanded in a word of `around`'s parts ([before, after] it); the text on
+// either side holds no IFS character of any option, so the one drawn is the only split.
+const splitOptions = gs.sampledFrom([true, true, ":", " :", ",", "\t\n", ":\t"]);
+const blankSplitOptions = gs.sampledFrom([true, true, " :", "\t\n", ":\t"]);
+const FIELD_CHARS = BARE.filter((c) => c !== ":" && c !== ",");
+const field = (lo, hi) => text(FIELD_CHARS, lo, hi);
+const splitCore = (opts, left, right, around, blank = false) =>
+  gs.record({ env, opt: opts, at: ints(0, 2), left, right, braces: chance(40), around }).map(({ env, opt, at, left, right, braces, around: [before, after] }) => {
+    const chars = [...ifsOf(opt)].filter((c) => !blank || /[ \t\n]/.test(c));
+    return { env: { ...env, S: left + chars[at % chars.length] + right }, opt, parts: [...before, exp("S", braces), ...after] };
+  });
+const emptyQuoted = gs.oneOf(gs.just(lit("''", "")), gs.just(lit('""', "")), dqOf(dqVar(["E"]).map((v) => [v])));
+const globBare = gs.tuples(field(0, 2), gs.sampledFrom(["*", "?"]), field(0, 2)).map(([a, c, b]) => lit(a + c + b, a + c + b, { glob: true }));
+
+// shell-quote/12: under splitUnquoted, an expansion that splits (a field before the last) and an unquoted glob character in one word
+property("TestHegelSplitFieldsBeforeAGlobAgreeWithBash", splitParsing(splitCore(splitOptions, field(1, 2), field(0, 2), gs.tuples(fillers, globBare.map((g) => [g])))), KNOWN);
+
+// shell-quote/15: splitUnquoted: '' (no splitting) and a word that is only empty unquoted expansions
+property("TestHegelEmptyIfsAgreesWithBash", splitParsing(gs.record({ env, parts: gs.arrays(expOf(["E", "N"]), { minSize: 1, maxSize: 2 }), opt: gs.just("") })), KNOWN);
+
+// shell-quote/16: under splitUnquoted, an empty quoted string right after an expansion that ends in an IFS character
+property("TestHegelEmptyQuotesAfterASplitExpansionAgreeWithBash", splitParsing(splitCore(splitOptions, field(1, 2), gs.just(""), gs.tuples(fillers, emptyQuoted.map((q) => [q])))), KNOWN);
+
+// shell-quote/17: under splitUnquoted, an empty quoted string right before an expansion that starts with a blank of the IFS
+property("TestHegelEmptyQuotesBeforeASplitExpansionAgreeWithBash", splitParsing(splitCore(blankSplitOptions, gs.just(""), field(1, 2), gs.tuples(emptyQuoted.map((q) => [q]), unglued), true)), KNOWN);
+
+// ---------------------------------------------------------------- pins
+
+pin("TestHegelPinBangInDoubleQuotesIsEscaped", () => {
+  // quote/1: the double-quote branch writes \! and the shell keeps the backslash
+  assert.deepEqual(shellWords("dash", quote(["it's!"])), ["it's!"]);
+});
+
+pin("TestHegelPinBacktickInDoubleQuotesKeepsTheBackslash", () => {
+  // quote/2: bash reads "a\`b" as a`b; parse keeps the backslash (and so cannot read quote's own output)
+  assert.deepEqual(parse('"a\\`b"'), ["a`b"]);
+});
+
+pin("TestHegelPinHashInsideAWordIsNotAComment", () => {
+  // quote/3
+  assert.deepEqual(parse("a#b"), ["a#b"]);
+});
+
+pin("TestHegelPinEscapedBackslashBeforeTheClosingQuote", () => {
+  // quote/4: the chunker reads the second backslash and the closing quote as an escaped quote
+  assert.deepEqual(parse('"\\\\" "x"'), ["\\", "x"]);
+});
+
+pin("TestHegelPinBackslashNewlineIsALineContinuation", () => {
+  // quote/5
+  assert.deepEqual(parse("a\\\nb"), ["ab"]);
+});
+
+pin("TestHegelPinUnderscoreStartsAVariableName", () => {
+  // quote/6: $_foo is the variable _foo, not $_ followed by text
+  assert.deepEqual(parse("$_foo", { _foo: "X" }), ["X"]);
+});
+
+pin("TestHegelPinCharacterAfterAOneCharacterParameterIsKept", () => {
+  // quote/7: $*x with * looked up in env is the value followed by x
+  assert.deepEqual(parse("$*x", { "*": "S" }), ["Sx"]);
+});
+
+pin("TestHegelPinDigitDoesNotStartAVariableName", () => {
+  // quote/8: bash reads $1x as $1 followed by x
+  assert.deepEqual(parse("$1x", {}), ["x"]);
+});
+
+pin("TestHegelPinEnvLookupIgnoresThePrototype", () => {
+  // quote/9: an unset variable expands to '', even one named like an Object.prototype member
+  assert.deepEqual(parse("$constructor", {}), [""]);
+});
+
+pin("TestHegelPinCarriageReturnDoesNotSplitAWord", () => {
+  // quote/10: the shell splits on space, tab and newline only
+  assert.deepEqual(parse("a\rb"), ["a\rb"]);
+});
+
+pin("TestHegelPinEscapedStarIsNotAGlob", () => {
+  // quote/11
+  assert.deepEqual(parse("\\*"), ["*"]);
+});
+
+pin("TestHegelPinFieldsBeforeAGlobAreKept", () => {
+  // quote/12: with splitUnquoted, the fields split off before a glob character vanish
+  assert.deepEqual(parse("a$V*", { V: "x y" }, { splitUnquoted: true }), ["ax", { op: "glob", pattern: "y*" }]);
+});
+
+pin("TestHegelPinEscapedBackslashDoesNotEscapeTheBlank", () => {
+  // quote/14: `\\ x` is a backslash and a word; the chunker reads the second backslash as escaping the blank
+  assert.deepEqual(parse("\\\\ x"), ["\\", "x"]);
+});
+
+pin("TestHegelPinEmptyIfsDropsAnEmptyExpansion", () => {
+  // quote/15: splitUnquoted: '' (no splitting) should still drop an unquoted empty expansion, as
+  // splitUnquoted: true does and as the shell does under IFS=''
+  assert.deepEqual(parse("a $E b", { E: "" }, { splitUnquoted: "" }), ["a", "b"]);
+});
+
+pin("TestHegelPinEmptyQuotesAfterASplitExpansionAreAWord", () => {
+  // quote/16: with splitUnquoted, the empty word `""` after a split expansion vanishes
+  assert.deepEqual(parse('a$W""', { W: " " }, { splitUnquoted: true }), ["a", ""]);
+});
+
+pin("TestHegelPinEmptyQuotesBeforeASplitExpansionAreAWord", () => {
+  // quote/17: with splitUnquoted, the empty word `""` before a split expansion vanishes when a
+  // field follows (the mirror of quote/16)
+  assert.deepEqual(parse('""$W$C', { W: " ", C: "c" }, { splitUnquoted: true }), ["", "c"]);
+});
+
+pin("TestHegelPinObjectValueDoesNotLeakTheMarker", () => {
+  // quote/13: an object value in an object env comes out as the internal marker string
+  const got = parse("$F", { F: { k: 1 } });
+  assert.equal(got.length, 1);
+  assert.ok(typeof got[0] === "object" || !/[0-9a-f]{8}\./.test(got[0]), show(got));
+});
