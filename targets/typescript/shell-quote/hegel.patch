index 0000000..cb7ee72
--- /dev/null
+++ b/test/hegel.test.mjs
@@ -0,0 +1,558 @@
+// Hegel zoo: properties of shell-quote (ljharb/shell-quote) — `quote` output read back by
+// real shells (dash and bash) and by `parse`; `parse` against bash's own word splitting, in
+// the default mode and under `splitUnquoted`; operators and comments against a model.
+//
+// Run with `node --test --test-reporter=tap test/hegel.test.mjs`; needs `bash` and `dash`
+// on PATH (the oracles). ZOO_COLLECT=1 records mismatches instead of failing (see
+// test/hegel-zoo.mjs).
+
+import assert from "node:assert/strict";
+import { execFileSync } from "node:child_process";
+import { mkdtempSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import sq from "../index.js";
+import { property, pin, fail, count, gs, same, show, collecting } from "./hegel-zoo.mjs";
+
+const { parse, quote } = sq;
+
+// ---------------------------------------------------------------- the shell oracle
+
+// An empty directory to run the shells in, so a glob that slipped through matches nothing.
+const EMPTY = mkdtempSync(join(tmpdir(), "hegel-shell-quote-"));
+
+function shSingle(s) {
+  return "'" + s.replace(/'/g, "'\\''") + "'";
+}
+
+// The words `script` denotes to `shell`, via `printf "%s\0"`: pathname expansion off, a fixed
+// first word so an empty script still yields a well-formed record, `env` the only variables.
+function shellWords(shell, script, env = {}, ifs) {
+  const pre = "set -f; " + (ifs === undefined ? "" : "IFS=" + shSingle(ifs) + "; ");
+  const out = execFileSync(shell, ["-c", pre + 'printf "%s\\0" x ' + script], {
+    env: { PATH: process.env.PATH, HOME: EMPTY, ...env },
+    cwd: EMPTY,
+  });
+  const parts = out.toString("utf8").split("\0");
+  parts.pop();
+  parts.shift();
+  return parts;
+}
+
+// ---------------------------------------------------------------- alphabets
+
+const BARE = ["a", "b", "z", "Z", "0", "9", "-", "_", ".", "/", "=", ":", "+", "%", "@", "^", "!", ",", "é", "全", "😀"];
+// Characters a bare word may carry that the shell treats as ordinary but a JavaScript `\s`
+// does not (CR, VT, FF, NBSP, U+2028, BOM): the shape `parse/unicode-space`.
+const ODD_SPACE = ["\r", "\v", "\f", "\u00a0", "\u2028", "\ufeff"];
+const ESCAPABLE = ["a", " ", "\t", '"', "'", "$", "`", "\\", "|", "&", ";", "<", ">", "(", ")", "#", "*", "?", "!", "="];
+const SQ_CHARS = [...BARE, " ", "\t", "\n", '"', "$", "\\", "#", "*", "!", "`", "|", "&", ";", "~"];
+const DQ_CHARS = [...BARE, " ", "\t", "\n", "'", "#", "*", "?", "!", "|", "&", ";", "~", "\\"];
+const VALUE_CHARS = [...BARE, " ", " ", ":", "*", "'", '"', "\\", "$", "#", "!", "`", "\t", "\n", "|"];
+const NAMES = ["A", "B", "C", "E", "W", "N"]; // E empty, W blanks, N unset
+
+// ---------------------------------------------------------------- generator helpers
+
+const ints = (lo, hi) => gs.integers({ minValue: lo, maxValue: hi });
+
+/** oneOf with weights: `weighted([45, a], [55, b])` draws a 45 times in 100; shrinks towards the first choice. */
+function weighted(...choices) {
+  const total = choices.reduce((sum, [w]) => sum + w, 0);
+  return ints(0, total - 1).flatMap((r) => {
+    for (const [w, g] of choices) {
+      if (r < w) return g;
+      r -= w;
+    }
+    throw new Error("unreachable");
+  });
+}
+
+/** True pct percent of the time; shrinks to false. */
+const chance = (pct) => ints(0, 99).map((r) => r >= 100 - pct);
+/** A draw from g pct percent of the time, else undefined (listed first: shrinks to absent). */
+const maybe = (pct, g) => weighted([100 - pct, gs.just(undefined)], [pct, g]);
+/** lo–hi characters from `alphabet`, an array of strings (a repeated entry weighs more, and an
+ * astral character stays whole — neither of which gs.text's alphabet, a set of code units, gives). */
+const text = (alphabet, lo, hi) => gs.arrays(gs.sampledFrom(alphabet), { minSize: lo, maxSize: hi }).map((cs) => cs.join(""));
+const dropUndefined = (o) => Object.fromEntries(Object.entries(o).filter(([, v]) => v !== undefined));
+
+// ---------------------------------------------------------------- a word program
+//
+// A word is a run of parts (bare text, a backslash escape, a single-quoted or double-quoted
+// span, an unquoted expansion). The generators below draw the parts as data; `mkWord` renders
+// them under the drawn `env` into the three texts of a word — `sq` for parse, `bashD` for bash
+// standing in for parse's default mode (unquoted expansions wrapped in double quotes, since
+// that mode never field-splits), `bashS` for bash under field splitting — plus a `model` of
+// the word bash yields in default mode, `glob` (bash would glob it), `exp` (it holds an
+// unquoted expansion) and the `flags` of pinned shapes the word touches.
+
+// The variables: E empty, W blanks, A/B/C hostile values, one time in three an `_x`.
+const env = gs
+  .record({
+    E: gs.just(""),
+    W: gs.sampledFrom([" ", "  ", " \t", "\n"]),
+    A: text(VALUE_CHARS, 0, 5),
+    B: text(VALUE_CHARS, 0, 5),
+    C: text(VALUE_CHARS, 0, 5),
+    _x: maybe(30, text(BARE, 1, 3)),
+  })
+  .map(dropUndefined);
+
+// A part whose rendering does not depend on env: the same text for parse and bash.
+const lit = (s, model, { flags = [], glob = false } = {}) => ({ kind: "lit", sq: s, model, flags, glob });
+const LINE_CONTINUATION = lit("\\\n", "", { flags: ["parse/line-continuation"] });
+const isGlobChar = (c) => c === "*" || c === "?";
+
+// bare text; one time in thirty-three a `#`, a glob character or an odd space inside it
+const SPECIAL = ["#", "*", "*", "?", "?", ...ODD_SPACE];
+const bareText = text(BARE, 1, 4);
+const bare = weighted(
+  [97, bareText.map((s) => lit(s, s))],
+  [3, gs.tuples(bareText, gs.sampledFrom(SPECIAL), text(BARE, 0, 2)).map(([a, c, b]) => lit(a + c + b, a + c + b, isGlobChar(c) ? { glob: true } : { flags: [c === "#" ? "parse/hash-in-word" : "parse/unicode-space"] }))],
+);
+// a backslash escape; one time in fifty a backslash-newline
+const escape = weighted(
+  [98, gs.sampledFrom(ESCAPABLE).map((c) => lit("\\" + c, c, { flags: isGlobChar(c) ? ["parse/escaped-glob-char"] : [] }))],
+  [2, gs.just(LINE_CONTINUATION)],
+);
+const singleQuoted = text(SQ_CHARS, 0, 5).map((s) => lit("'" + s + "'", s));
+// inside double quotes: a character (a backslash before an ordinary character stays), an
+// escaped `"` `\` `$` `` ` ``, a backslash-newline, or a `$VAR`/`${VAR}`
+const dqItem = weighted(
+  [60, gs.sampledFrom(DQ_CHARS).map((c) => ({ t: "lit", s: c === "\\" ? "\\a" : c }))],
+  [23, gs.sampledFrom(['"', "\\", "\\", "$", "$", "`"]).map((c) => ({ t: "esc", c }))],
+  [2, gs.just({ t: "lc" })],
+  [15, gs.record({ t: gs.just("var"), name: gs.sampledFrom(NAMES), braces: chance(40) })],
+);
+const doubleQuoted = gs.arrays(dqItem, { maxSize: 5 }).map((items) => ({ kind: "dq", items }));
+// an unquoted expansion; one time in seventeen a name of a pinned shape (`${1x}` is a bad
+// substitution in bash, so that one is never braced)
+const expansion = weighted(
+  [94, gs.record({ kind: gs.just("exp"), name: gs.sampledFrom(NAMES), braces: chance(40) })],
+  [6, gs.record({ kind: gs.just("exp"), name: gs.sampledFrom(["_x", "1x", "constructor"]), braces: chance(40) }).map((p) => (p.name === "1x" ? { ...p, braces: false } : p))],
+);
+const part = weighted([35, bare], [15, escape], [15, singleQuoted], [20, doubleQuoted], [15, expansion]);
+// a word: 1–3 parts
+const rawWord = gs.arrays(part, { minSize: 1, maxSize: 3 });
+
+const EXP_FLAGS = { _x: "parse/underscore-name", "1x": "parse/digit-name", constructor: "parse/prototype-env" };
+const NOTHING = { sq: "", bash: "", bashS: "", model: "", glob: false, exp: false, flags: [] };
+
+// The renderings of one part under env: `sq` for parse, `bash` for bash in the default mode,
+// `bashS` for bash under field splitting, the `model` word, `glob`, `exp` and its flags.
+function renderPart(p, env) {
+  if (p.kind === "lit") return { ...NOTHING, sq: p.sq, bash: p.sq, bashS: p.sq, model: p.model, glob: p.glob, flags: p.flags };
+  if (p.kind === "dq") {
+    let inner = "";
+    let model = "";
+    const flags = [];
+    p.items.forEach((it, i) => {
+      if (it.t === "lit") {
+        inner += it.s;
+        model += it.s;
+      } else if (it.t === "esc") {
+        if (it.c === "`") flags.push("parse/backtick-in-double-quotes");
+        inner += "\\" + it.c;
+        model += it.c;
+      } else if (it.t === "lc") {
+        flags.push("parse/line-continuation");
+        inner += "\\\n";
+      } else {
+        // A `$NAME` directly followed by a name character (even across a line continuation,
+        // which the shell removes first) would read a longer name: brace it. (Only a real
+        // expansion: an escaped `\$` before a letter is text, and must stay unbraced.)
+        let next = p.items[i + 1];
+        for (let j = i + 2; next && next.t === "lc"; j++) next = p.items[j];
+        const glued = next && next.t === "lit" && /^[A-Za-z0-9_]/.test(next.s);
+        inner += it.braces || glued ? "${" + it.name + "}" : "$" + it.name;
+        model += env[it.name] ?? "";
+      }
+    });
+    if (inner.endsWith("\\\\")) flags.push("parse/escaped-backslash-before-quote");
+    const s = '"' + inner + '"';
+    return { ...NOTHING, sq: s, bash: s, bashS: s, model, flags };
+  }
+  // an unquoted expansion: bash reads $1x as $1 (empty) then x; `constructor` is unset
+  const ref = p.braces ? "${" + p.name + "}" : "$" + p.name;
+  const model = p.name === "1x" ? "x" : p.name === "constructor" ? "" : env[p.name] ?? "";
+  const flags = p.name in EXP_FLAGS ? [EXP_FLAGS[p.name]] : [];
+  return { sq: ref, bash: '"' + ref + '"', bashS: ref, model, glob: false, exp: true, flags, name: p.name };
+}
+
+// The word the parts make under env.
+function mkWord(parts, env) {
+  const rendered = parts.map((p) => renderPart(p, env));
+  const flags = new Set(rendered.flatMap((r) => r.flags));
+  const glob = rendered.some((r) => r.glob);
+  const exp = rendered.some((r) => r.exp);
+  // an unbraced expansion directly followed by a name character would read a longer name:
+  // brace it ($1x cannot be braced: drop it)
+  const rs = rendered.map((r, i) => {
+    const next = rendered[i + 1];
+    if (!(r.exp && /^\$[A-Za-z_0-9]+$/.test(r.sq) && next && /^[A-Za-z0-9_]/.test(next.sq))) return r;
+    if (r.name === "1x") return NOTHING;
+    return { ...r, sq: "${" + r.name + "}", bash: '"${' + r.name + '}"', bashS: "${" + r.name + "}" };
+  });
+  const w = { sq: "", bashD: "", bashS: "", model: "", glob, exp, flags };
+  let afterExp = false;
+  let emptyQuoted = false;
+  rs.forEach((r, i) => {
+    // an empty quoted span after a split expansion is a word the shell keeps and parse drops
+    if (afterExp && /^['"]/.test(r.sq) && r.model === "") flags.add("parse/split-drops-empty-quoted");
+    // an empty quoted span before a split expansion whose value starts with an IFS character is
+    // a word the shell keeps and parse drops when a field follows (which characters split, and so
+    // whether one follows, depends on the IFS drawn later: the shape is flagged whenever the
+    // expansion is non-empty, and a flag only excuses a mismatch)
+    if (emptyQuoted && w.model === "" && r.exp && r.model !== "") flags.add("parse/split-drops-leading-empty-quoted");
+    if (/^['"]/.test(r.sq) && r.model === "") emptyQuoted = true;
+    w.sq += r.sq;
+    w.bashD += r.bash;
+    w.bashS += r.bashS;
+    w.model += r.model;
+    if (r.exp) afterExp = true;
+  });
+  if (w.sq.replace(/\\\n/g, "") === "") {
+    // nothing, or only line continuations: no word at all to the shell
+    w.sq = w.bashD = w.bashS = w.model = "y";
+    flags.clear();
+  }
+  // an even run of backslashes before a quote or the end of the word: the chunker reads the
+  // last one as escaping what follows (`\\ x` is one word to parse, two to the shell)
+  if (/(^|[^\\])(\\\\)+(["']|$)/.test(w.sq)) flags.add("parse/escaped-backslash-before-blank");
+  // an unquoted glob character and an unquoted expansion in one word: the split-then-glob shape
+  if (exp && glob) flags.add("parse/split-then-glob");
+  return w;
+}
+
+// A program of 1–5 words with blank separators (a leading and a trailing blank one time in
+// five); 2% of the joins are a backslash-newline, which glues the two words in the shell (the
+// `parse/line-continuation` shape).
+const sep = gs.sampledFrom([" ", " ", "\t", "  ", " \t"]);
+const rawProgram = gs.record({
+  words: gs.arrays(gs.record({ parts: rawWord, glued: chance(2), sep }), { minSize: 1, maxSize: 5 }),
+  lead: maybe(20, sep),
+  trail: maybe(20, sep),
+});
+
+function mkProgram(raw, env) {
+  const words = [];
+  const seps = [];
+  for (const { parts, glued, sep: s } of raw.words) {
+    const w = mkWord(parts, env);
+    const prev = words[words.length - 1];
+    if (prev && glued) {
+      prev.sq += "\\\n" + w.sq;
+      prev.bashD += "\\\n" + w.bashD;
+      prev.bashS += "\\\n" + w.bashS;
+      prev.model += w.model;
+      prev.glob = prev.glob || w.glob;
+      prev.exp = prev.exp || w.exp;
+      for (const f of w.flags) prev.flags.add(f);
+      prev.flags.add("parse/line-continuation");
+    } else {
+      words.push(w);
+      seps.push(prev ? s : "");
+    }
+  }
+  const lead = raw.lead ?? "";
+  const trail = raw.trail ?? "";
+  const joined = (key) => lead + words.map((w, i) => seps[i] + w[key]).join("") + trail;
+  return { words, sq: joined("sq"), bashD: joined("bashD"), bashS: joined("bashS") };
+}
+
+// The variables and a program rendered under them.
+const envAndProgram = gs.record({ env, raw: rawProgram }).map(({ env, raw }) => ({ env, program: mkProgram(raw, env) }));
+
+// Do parse's tokens denote the shell's words? A glob token stands for its pattern.
+function tokensMatch(tokens, wordsOut, program) {
+  if (tokens.length !== wordsOut.length) return false;
+  for (let i = 0; i < tokens.length; i++) {
+    const t = tokens[i];
+    if (typeof t === "string") {
+      if (t !== wordsOut[i]) return false;
+    } else if (t && t.op === "glob") {
+      if (t.pattern !== wordsOut[i]) return false;
+    } else {
+      return false;
+    }
+  }
+  return true;
+}
+
+// The pinned shapes a program touches; count them all and say whether there were any.
+function explain(program) {
+  let any = false;
+  for (const w of program.words) {
+    for (const f of w.flags) {
+      count(f);
+      any = true;
+    }
+  }
+  return any;
+}
+
+// ---------------------------------------------------------------- properties
+
+// quote: what dash and bash read back from quote(xs) is xs, and so does parse.
+const STR_CHARS = [...BARE, ...ODD_SPACE, " ", "\t", "\n", "'", '"', "\\", "$", "`", "!", "#", "*", "?", "[", "]", "{", "}", "~", "|", "&", ";", "<", ">", "(", ")", "\x01"];
+const STR_LITERALS = ["", "it's!", "it's `x`", "C:\\x", "~", "-n", "--", "1e21", "a=b", " ", "'", '"', "\\", "$HOME", "*", "#x"];
+const OPS = ["||", "&&", ";;", "|&", "<(", "<<<", ">>", ">&", "<&", "&", ";", "(", ")", "|", "<", ">"];
+const GLOB_CHARS = [...BARE, "*", "?", "[", "]", " ", "'", '"', "\\", "$", "!", "#", "~", "|", ";"];
+const VALUES = [0, 1, -1, 7, 1.5, 1e21, true, false, null, undefined];
+
+// one argument: a string (random, or one time in four a literal), a number/boolean/null,
+// an operator token, a glob pattern, a comment
+const arg = weighted(
+  [62, weighted([75, text(STR_CHARS, 0, 6)], [25, gs.sampledFrom(STR_LITERALS)])],
+  [8, gs.sampledFrom(VALUES)],
+  [14, gs.sampledFrom(OPS).map((op) => ({ op }))],
+  [10, text(GLOB_CHARS, 1, 5).map((pattern) => ({ op: "glob", pattern }))],
+  [6, text([...BARE, " ", "'", '"', "$", "\\", "#"], 0, 5).map((comment) => ({ comment }))],
+);
+const isComment = (x) => x !== null && typeof x === "object" && "comment" in x;
+// up to six arguments; a comment runs to the end of the line, so nothing follows the first one
+const args = gs.arrays(arg, { maxSize: 6 }).map((xs) => {
+  const i = xs.findIndex(isComment);
+  return i < 0 ? xs : xs.slice(0, i + 1);
+});
+
+property("TestHegelQuotedWordsSurviveTheShell", (tc) => {
+  const xs = tc.draw(args);
+  const want = []; // the words the shell should read
+  const wantParse = []; // and parse's tokens for them
+  const shapes = new Set();
+  let comment = null;
+  for (const x of xs) {
+    if (typeof x === "string") {
+      want.push(x);
+      wantParse.push(x);
+      const dq = /["'\s]/.test(x) && !(/["\s\\]/.test(x) && !/'/.test(x)); // quote's double-quote branch
+      if (dq && /!/.test(x)) shapes.add("quote/bang-in-double-quotes");
+      if (dq && /`/.test(x)) shapes.add("parse/backtick-in-double-quotes");
+      if (dq && x.endsWith("\\")) shapes.add("parse/escaped-backslash-before-quote"); // quote writes \\ before the closing "
+      if (!/["\s\\']/.test(x) && /[*?]/.test(x)) shapes.add("parse/escaped-glob-char");
+    } else if (x === null || typeof x !== "object") {
+      want.push(String(x));
+      wantParse.push(String(x));
+    } else if (isComment(x)) {
+      comment = x.comment;
+    } else if (x.op === "glob") {
+      const { pattern } = x;
+      want.push(pattern);
+      // parse reports a glob only for * and ? (a bracket class is a plain word: limit/bracket-glob)
+      wantParse.push(/[*?]/.test(pattern) ? { op: "glob", pattern } : pattern);
+      if (!/[*?]/.test(pattern) && /[[\]]/.test(pattern)) count("limit/bracket-glob");
+      if (pattern.endsWith("\\")) shapes.add("parse/escaped-backslash-before-blank"); // quote writes \\ before the blank
+    } else {
+      want.push(x.op); // quote makes an operator a literal word (documented)
+      wantParse.push(x.op);
+    }
+  }
+  const q = quote(xs);
+  for (const shell of ["dash", "bash"]) {
+    const got = shellWords(shell, q);
+    if (!same(got, want)) {
+      if (shapes.size) {
+        for (const s of shapes) count(s);
+        return;
+      }
+      fail(`${shell} reads ${show(q)} (quote of ${show(xs)}) as ${show(got)}, not ${show(want)}`);
+    }
+  }
+  const p = parse(q);
+  const wantTokens = comment === null ? wantParse : [...wantParse, { comment }];
+  if (!same(p, wantTokens)) {
+    if (shapes.size) {
+      for (const s of shapes) count(s);
+      return;
+    }
+    fail(`parse(${show(q)}) (quote of ${show(xs)}) = ${show(p)}, not ${show(wantTokens)}`);
+  }
+});
+
+// parse, default mode: the tokens of a program are the words bash reads when each unquoted
+// expansion is double-quoted (parse never splits an expansion unless asked to).
+property("TestHegelParseAgreesWithBash", (tc) => {
+  const { env, program } = tc.draw(envAndProgram);
+  const want = shellWords("bash", program.bashD, env);
+  const model = program.words.map((w) => w.model);
+  if (!same(model, want)) {
+    // the model is a check on the generator, not on parse
+    count("model-differs");
+    if (collecting) console.log(`# model ${show(program.bashD)} ${show(env)}: model ${show(model)}, bash ${show(want)}`);
+  }
+  let got;
+  try {
+    got = parse(program.sq, env);
+  } catch (e) {
+    fail(`parse(${show(program.sq)}, ${show(env)}) threw ${e.message}`);
+  }
+  if (!tokensMatch(got, want, program)) {
+    if (explain(program)) return;
+    fail(`parse(${show(program.sq)}, ${show(env)}) = ${show(got)}; bash reads ${show(program.bashD)} as ${show(want)}`);
+  }
+  // a glob token must come from an unquoted, unescaped * or ?
+  got.forEach((t, i) => {
+    if (t && t.op === "glob" && !program.words[i]?.glob) {
+      if (explain(program)) return;
+      fail(`parse(${show(program.sq)}) reports ${show(t)} as a glob, but the shell would not expand it`);
+    }
+  });
+});
+
+// splitUnquoted: true (IFS space/tab/newline) or a custom IFS ('' disables splitting)
+const splitOption = gs.sampledFrom([true, true, ":", " :", ",", "\t\n", ":\t", ""]);
+
+// parse with splitUnquoted: the tokens are the words bash reads with IFS set the same way.
+property("TestHegelSplitUnquotedAgreesWithBash", (tc) => {
+  const { env, program } = tc.draw(envAndProgram);
+  const opt = tc.draw(splitOption);
+  const ifs = opt === true ? " \t\n" : opt;
+  const want = shellWords("bash", program.bashS, env, ifs);
+  let got;
+  try {
+    got = parse(program.sq, env, { splitUnquoted: opt });
+  } catch (e) {
+    fail(`parse(${show(program.sq)}, ${show(env)}, {splitUnquoted: ${show(opt)}}) threw ${e.message}`);
+  }
+  if (!tokensMatch(got, want, program)) {
+    if (explain(program)) return;
+    // an empty IFS: no splitting, but the shell still drops an unquoted expansion that is empty
+    if (opt === "" && program.words.some((w) => w.exp)) {
+      count("parse/empty-ifs-keeps-empty-word");
+      return;
+    }
+    fail(`parse(${show(program.sq)}, ${show(env)}, {splitUnquoted: ${show(opt)}}) = ${show(got)}; bash with IFS=${show(ifs)} reads it as ${show(want)}`);
+  }
+});
+
+// Words and operators for the tokenizer: the words from the program generator, those touching
+// a pinned shape filtered out (plain words only here); each item carries the blank that may
+// go before it (`shown` decides when the grammar does not force one).
+const plainWordFor = (env) => rawWord.map((parts) => mkWord(parts, env)).filter((w) => w.flags.size === 0);
+const gap = gs.record({ blank: gs.sampledFrom([" ", "\t", "  "]), shown: chance(60) });
+const tokenizeInput = env.flatMap((env) =>
+  gs.record({
+    env: gs.just(env),
+    items: gs.arrays(gs.record({ item: weighted([65, plainWordFor(env)], [35, gs.sampledFrom(OPS).map((op) => ({ op }))]), gap }), { minSize: 1, maxSize: 7 }),
+    lead: chance(20),
+    comment: maybe(15, text([...BARE, " ", "'", '"', "$", "\\", "#", "|", ";"], 0, 6)),
+  }),
+);
+
+// parse: words, operators and a trailing comment tokenize as written, the words as the model
+// says (the model is checked against bash above).
+property("TestHegelOperatorsAndCommentsTokenize", (tc) => {
+  const { env, items, lead, comment } = tc.draw(tokenizeInput);
+  const want = [];
+  let s = lead ? " " : "";
+  items.forEach(({ item, gap: g }, i) => {
+    if (i) {
+      // two operators or two words need a blank between them; a word and an operator need not
+      const prev = items[i - 1].item;
+      const need = (item.op && prev.op) || (!item.op && !prev.op);
+      s += need || g.shown ? g.blank : "";
+    }
+    s += item.op ? item.op : item.sq;
+    want.push(item.op ? { op: item.op } : item.glob ? { op: "glob", pattern: item.model } : item.model);
+  });
+  if (comment !== undefined) {
+    s += (s === "" || /[ \t]$/.test(s) ? "" : " ") + "#" + comment; // a comment starts a word
+    want.push({ comment });
+  }
+  const got = parse(s, env);
+  if (!same(got, want)) {
+    fail(`parse(${show(s)}, ${show(env)}) = ${show(got)}, not ${show(want)}`);
+  }
+});
+
+// ---------------------------------------------------------------- pins
+
+pin("TestHegelPinBangInDoubleQuotesIsEscaped", () => {
+  // quote/1: the double-quote branch writes \! and the shell keeps the backslash
+  assert.deepEqual(shellWords("dash", quote(["it's!"])), ["it's!"]);
+});
+
+pin("TestHegelPinBacktickInDoubleQuotesKeepsTheBackslash", () => {
+  // quote/2: bash reads "a\`b" as a`b; parse keeps the backslash (and so cannot read quote's own output)
+  assert.deepEqual(parse('"a\\`b"'), ["a`b"]);
+});
+
+pin("TestHegelPinHashInsideAWordIsNotAComment", () => {
+  // quote/3
+  assert.deepEqual(parse("a#b"), ["a#b"]);
+});
+
+pin("TestHegelPinEscapedBackslashBeforeTheClosingQuote", () => {
+  // quote/4: the chunker reads the second backslash and the closing quote as an escaped quote
+  assert.deepEqual(parse('"\\\\" "x"'), ["\\", "x"]);
+});
+
+pin("TestHegelPinBackslashNewlineIsALineContinuation", () => {
+  // quote/5
+  assert.deepEqual(parse("a\\\nb"), ["ab"]);
+});
+
+pin("TestHegelPinUnderscoreStartsAVariableName", () => {
+  // quote/6: $_foo is the variable _foo, not $_ followed by text
+  assert.deepEqual(parse("$_foo", { _foo: "X" }), ["X"]);
+});
+
+pin("TestHegelPinCharacterAfterAOneCharacterParameterIsKept", () => {
+  // quote/7: $*x with * looked up in env is the value followed by x
+  assert.deepEqual(parse("$*x", { "*": "S" }), ["Sx"]);
+});
+
+pin("TestHegelPinDigitDoesNotStartAVariableName", () => {
+  // quote/8: bash reads $1x as $1 followed by x
+  assert.deepEqual(parse("$1x", {}), ["x"]);
+});
+
+pin("TestHegelPinEnvLookupIgnoresThePrototype", () => {
+  // quote/9: an unset variable expands to '', even one named like an Object.prototype member
+  assert.deepEqual(parse("$constructor", {}), [""]);
+});
+
+pin("TestHegelPinCarriageReturnDoesNotSplitAWord", () => {
+  // quote/10: the shell splits on space, tab and newline only
+  assert.deepEqual(parse("a\rb"), ["a\rb"]);
+});
+
+pin("TestHegelPinEscapedStarIsNotAGlob", () => {
+  // quote/11
+  assert.deepEqual(parse("\\*"), ["*"]);
+});
+
+pin("TestHegelPinFieldsBeforeAGlobAreKept", () => {
+  // quote/12: with splitUnquoted, the fields split off before a glob character vanish
+  assert.deepEqual(parse("a$V*", { V: "x y" }, { splitUnquoted: true }), ["ax", { op: "glob", pattern: "y*" }]);
+});
+
+pin("TestHegelPinEscapedBackslashDoesNotEscapeTheBlank", () => {
+  // quote/14: `\\ x` is a backslash and a word; the chunker reads the second backslash as escaping the blank
+  assert.deepEqual(parse("\\\\ x"), ["\\", "x"]);
+});
+
+pin("TestHegelPinEmptyIfsDropsAnEmptyExpansion", () => {
+  // quote/15: splitUnquoted: '' (no splitting) should still drop an unquoted empty expansion, as
+  // splitUnquoted: true does and as the shell does under IFS=''
+  assert.deepEqual(parse("a $E b", { E: "" }, { splitUnquoted: "" }), ["a", "b"]);
+});
+
+pin("TestHegelPinEmptyQuotesAfterASplitExpansionAreAWord", () => {
+  // quote/16: with splitUnquoted, the empty word `""` after a split expansion vanishes
+  assert.deepEqual(parse('a$W""', { W: " " }, { splitUnquoted: true }), ["a", ""]);
+});
+
+pin("TestHegelPinEmptyQuotesBeforeASplitExpansionAreAWord", () => {
+  // quote/17: with splitUnquoted, the empty word `""` before a split expansion vanishes when a
+  // field follows (the mirror of quote/16)
+  assert.deepEqual(parse('""$W$C', { W: " ", C: "c" }, { splitUnquoted: true }), ["", "c"]);
+});
+
+pin("TestHegelPinObjectValueDoesNotLeakTheMarker", () => {
+  // quote/13: an object value in an object env comes out as the internal marker string
+  const got = parse("$F", { F: { k: 1 } });
+  assert.equal(got.length, 1);
+  assert.ok(typeof got[0] === "object" || !/[0-9a-f]{8}\./.test(got[0]), show(got));
+});
