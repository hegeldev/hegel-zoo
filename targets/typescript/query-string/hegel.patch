@@ -0,0 +1,311 @@
+// Hegel zoo: a model of query-string's documented behaviour (readme, "API"), written from the
+// documentation rather than from base.js: the W3C "collect URL parameters" rules the readme
+// points at (`&`-separated pairs split at the first `=`, a missing `=` giving null, `+` read as a
+// space, percent-decoding), the seven array formats with their examples, the value-typing options
+// (parseNumbers, parseBooleans, types) and stringify's encoding and skipping rules.
+
+/** Strict percent-encoding: encodeURIComponent plus RFC 3986's `!'()*`. */
+import decodeComponent from "decode-uri-component";
+
+export function encodeStrict(s) {
+  return encodeURIComponent(s).replace(/[!'()*]/g, (c) => "%" + c.charCodeAt(0).toString(16).toUpperCase());
+}
+
+export const encodeLoose = (s) => encodeURIComponent(s);
+
+/** Percent-decoding as the readme documents it: "URL components are decoded with decode-uri-component"
+ * (which decodes what it can of a malformed string and leaves the rest as written). */
+export function decode(s) {
+  return decodeComponent(s);
+}
+
+export const ARRAY_FORMATS = ["none", "bracket", "index", "comma", "separator", "bracket-separator", "colon-list-separator"];
+const SEPARATED = new Set(["comma", "separator", "bracket-separator"]);
+
+// ---------------------------------------------------------------------------------------------
+// stringify
+
+/** The string a scalar value is written as (the readme: string, number, bigint, boolean). */
+export function scalar(v) {
+  return String(v);
+}
+
+/**
+ * The documented stringification of a plain object: keys in code-unit order (or `sort`'s order,
+ * or insertion order for `sort: false`), undefined skipped, null as a bare key, arrays per the
+ * format, `skipNull`/`skipEmptyString` applied to both top-level values and array elements.
+ */
+export function stringify(obj, options = {}) {
+  const o = { encode: true, strict: true, arrayFormat: "none", arrayFormatSeparator: ",", ...options };
+  const enc = (s) => (o.encode ? (o.strict ? encodeStrict(s) : encodeLoose(s)) : s);
+  const skip = (v) => v === undefined || (o.skipNull && v === null) || (o.skipEmptyString && v === "");
+  let keys = Object.keys(obj).filter((k) => !skip(obj[k]));
+  if (o.sort !== false) keys = keys.slice().sort(o.sort === true || o.sort === undefined ? undefined : o.sort);
+  const parts = [];
+  for (const key of keys) {
+    const v = obj[key];
+    const k = enc(key);
+    if (v === null) {
+      parts.push(k);
+      continue;
+    }
+    if (!Array.isArray(v)) {
+      parts.push(`${k}=${enc(scalar(v))}`);
+      continue;
+    }
+    const items = v.filter((x) => !skip(x));
+    const sep = o.arrayFormatSeparator;
+    if (items.length === 0 && v.length > 0) continue; // every element skipped: nothing is written (not even `key[]`)
+    const sub = []; // one array is one part, its elements joined with `&` (so `""` elements of the key "" stay)
+    switch (o.arrayFormat) {
+      case "bracket":
+        for (const x of items) sub.push(x === null ? `${k}[]` : `${k}[]=${enc(scalar(x))}`);
+        break;
+      case "index":
+        items.forEach((x, i) => sub.push(x === null ? `${k}[${i}]` : `${k}[${i}]=${enc(scalar(x))}`));
+        break;
+      case "colon-list-separator":
+        for (const x of items) sub.push(`${k}:list=${x === null ? "" : enc(scalar(x))}`);
+        break;
+      case "comma":
+      case "separator":
+        if (items.length > 0) sub.push(`${k}=${items.map((x) => (x === null ? "" : enc(scalar(x)))).join(sep)}`);
+        break;
+      case "bracket-separator":
+        sub.push(`${k}[]${items.length > 0 ? "=" + items.map((x) => (x === null ? "" : enc(scalar(x)))).join(sep) : ""}`);
+        break;
+      default:
+        for (const x of items) sub.push(x === null ? k : `${k}=${enc(scalar(x))}`);
+    }
+    parts.push(sub.join("&"));
+  }
+  return parts.filter((p) => p.length > 0).join("&"); // an empty key with a null value is an empty part: nothing
+}
+
+// ---------------------------------------------------------------------------------------------
+// parse
+
+/** Split a query string into [key, value|null] pairs (raw, still percent-encoded; `+` handled by the caller). */
+export function pairs(query) {
+  let q = query.trim();
+  if (/^[?#&]/.test(q)) q = q.slice(1);
+  const out = [];
+  for (const part of q.split("&")) {
+    if (part === "") continue;
+    const i = part.indexOf("=");
+    out.push(i === -1 ? [part, null] : [part.slice(0, i), part.slice(i + 1)]);
+  }
+  return out;
+}
+
+/**
+ * The documented typing of one value: the key's `types` entry "takes precedence over options
+ * such as parseNumbers, parseBooleans", so it is tried first, and a value it does not apply to
+ * (a `boolean` key holding "x", a `number` key holding "abc") falls through to the general options.
+ */
+export function typeValue(v, type, o) {
+  if (typeof v !== "string") return type === "boolean" && v === null ? true : v;
+  if (type === "string") return v;
+  if (typeof type === "function") return type(v);
+  const l = v.toLowerCase();
+  if (type === "boolean") {
+    if (l === "true" || l === "1") return true;
+    if (l === "false" || l === "0") return false;
+  }
+  if (type === "number" && isNumeric(v)) return Number(v);
+  if (o.parseBooleans && (l === "true" || l === "false")) return l === "true";
+  if (o.parseNumbers && isNumeric(v)) return Number(v);
+  return v;
+}
+
+const isNumeric = (v) => v.trim() !== "" && !Number.isNaN(Number(v));
+
+/**
+ * The documented parse: pairs, `+` as space and percent-decoding (decode: true), arrays per the
+ * format (array markers are looked for on the raw key, before decoding: `foo%5B%5D` is a plain
+ * key named `foo[]`), duplicates of a plain key collected in order, typing, then keys in
+ * code-unit order unless `sort` says otherwise. Returns a null-prototype object.
+ */
+export function parse(query, options = {}) {
+  const o = { decode: true, sort: true, arrayFormat: "none", arrayFormatSeparator: ",", parseNumbers: false, parseBooleans: false, types: {}, ...options };
+  const dec = (s) => (s === null ? null : o.decode ? decode(s.replace(/\+/g, " ")) : s);
+  const result = Object.create(null);
+  const isArrayKey = new Set();
+  const push = (key, v) => {
+    if (!(key in result)) {
+      result[key] = [v];
+      isArrayKey.add(key);
+    } else if (isArrayKey.has(key)) result[key].push(v);
+    else {
+      result[key] = [result[key], v];
+      isArrayKey.add(key);
+    }
+  };
+  for (const [rawKey, rawValue] of pairs(query)) {
+    const sep = o.arrayFormatSeparator;
+    switch (o.arrayFormat) {
+      case "bracket": {
+        const m = /^(.*)\[]$/.exec(rawKey);
+        if (m) push(dec(m[1]), dec(rawValue));
+        else setPlain(result, isArrayKey, dec(rawKey), dec(rawValue), true);
+        break;
+      }
+      case "index": {
+        const m = /^(.*)\[(\d*)]$/.exec(rawKey);
+        if (m) pushIndexed(result, isArrayKey, dec(m[1]), m[2], dec(rawValue));
+        else setPlain(result, isArrayKey, dec(rawKey), dec(rawValue), true);
+        break;
+      }
+      case "colon-list-separator": {
+        const m = /^(.*):list$/.exec(rawKey);
+        if (m) push(dec(m[1]), dec(rawValue));
+        else setPlain(result, isArrayKey, dec(rawKey), dec(rawValue), true);
+        break;
+      }
+      case "comma":
+      case "separator": {
+        const key = dec(rawKey);
+        if (rawValue !== null && rawValue.includes(sep)) {
+          result[key] = rawValue.split(sep).map(dec);
+          isArrayKey.add(key);
+        } else setPlain(result, isArrayKey, key, dec(rawValue), true);
+        break;
+      }
+      case "bracket-separator": {
+        const m = /^(.*)\[]$/.exec(rawKey);
+        if (m) {
+          const key = dec(m[1]);
+          const items = rawValue === null ? [] : rawValue.split(sep).map(dec);
+          if (!(key in result)) result[key] = [];
+          else if (!isArrayKey.has(key)) result[key] = [result[key]];
+          isArrayKey.add(key);
+          result[key].push(...items);
+        } else setPlain(result, isArrayKey, dec(rawKey), dec(rawValue), true);
+        break;
+      }
+      default:
+        if (!(rawKey === undefined)) {
+          const key = dec(rawKey);
+          if (key in result) push(key, dec(rawValue));
+          else result[key] = dec(rawValue);
+        }
+    }
+  }
+  // indexed arrays: elements in numeric index order
+  for (const key of Object.keys(result)) {
+    const v = result[key];
+    if (v && typeof v === "object" && !Array.isArray(v)) {
+      result[key] = Object.keys(v)
+        .sort((a, b) => Number(a) - Number(b) || (a < b ? -1 : a > b ? 1 : 0))
+        .map((i) => v[i]);
+      isArrayKey.add(key);
+    }
+  }
+  // typing
+  for (const key of Object.keys(result)) {
+    const type = o.types[key];
+    const v = result[key];
+    if (Array.isArray(v)) {
+      if (type === "string") result[key] = v.map((x) => (x === null ? "" : x)).join(o.arrayFormatSeparator);
+      else result[key] = v.map((x) => typeValue(x, typeof type === "function" ? type : type === undefined ? undefined : type.replace("[]", ""), o));
+    } else if (type === "string[]" && o.arrayFormat !== "none" && typeof v === "string") {
+      result[key] = [v]; // a lone value under an array type is a one-element array
+    } else if (type === "number[]" && o.arrayFormat !== "none" && typeof v === "string" && isNumeric(v)) {
+      result[key] = [Number(v)];
+    } else {
+      result[key] = typeValue(v, type === "string[]" || type === "number[]" ? undefined : type, o);
+    }
+  }
+  if (o.sort === false) return result;
+  const out = Object.create(null);
+  for (const key of Object.keys(result).sort(o.sort === true ? undefined : o.sort)) out[key] = result[key];
+  return out;
+}
+
+function setPlain(result, isArrayKey, key, v, overwrite = false) {
+  if (overwrite || !(key in result)) {
+    result[key] = v;
+    isArrayKey.delete(key);
+    return;
+  }
+  if (isArrayKey.has(key)) result[key].push(v);
+  else {
+    result[key] = [result[key], v];
+    isArrayKey.add(key);
+  }
+}
+
+function pushIndexed(result, isArrayKey, key, index, v) {
+  if (!(key in result) || typeof result[key] !== "object" || result[key] === null || Array.isArray(result[key])) {
+    // a plain value or an array seen before is superseded by the indexed form (the index parser keeps a map of indices)
+    result[key] = {};
+  }
+  result[key][index] = v;
+}
+
+// ---------------------------------------------------------------------------------------------
+// Round-trip expectations
+
+/**
+ * What parse(stringify(obj, o), o) should give for a well-formed object, by the documentation:
+ * undefined dropped; values as strings; null kept for the formats that write a bare key
+ * (none, bracket, index) and read back as "" for the separator formats and colon-list;
+ * one-element arrays collapse to the element for none/comma/separator (the string cannot say
+ * "array"); empty arrays vanish except under bracket-separator; skipNull/skipEmptyString drop.
+ */
+export function roundTripExpectation(obj, options = {}) {
+  const o = { arrayFormat: "none", ...options };
+  const skip = (v) => v === undefined || (o.skipNull && v === null) || (o.skipEmptyString && v === "");
+  const out = Object.create(null);
+  const item = (x) => (x === null ? (["none", "bracket", "index"].includes(o.arrayFormat) ? null : "") : scalar(x));
+  for (const key of Object.keys(obj)) {
+    const v = obj[key];
+    if (skip(v)) continue;
+    if (key === "" && v === null) continue; // written as an empty part, which parse skips
+    if (!Array.isArray(v)) {
+      out[key] = v === null ? null : scalar(v);
+      continue;
+    }
+    let items = v.filter((x) => !skip(x)).map(item);
+    if (key === "" && o.arrayFormat === "none") items = items.filter((x) => x !== null); // empty parts again
+    if (items.length === 0) {
+      // an empty array is written as `key[]` under bracket-separator and not at all otherwise;
+      // an array whose every element is skipped is not written at all
+      if (o.arrayFormat === "bracket-separator" && v.length === 0) out[key] = [];
+      continue;
+    }
+    if (items.length === 1 && ["none", "comma", "separator"].includes(o.arrayFormat)) {
+      out[key] = items[0];
+      continue;
+    }
+    out[key] = items;
+  }
+  return out;
+}
+
+/** Structural equality of parse results (null-prototype objects, arrays, primitives). */
+export function same(a, b) {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) return false;
+    return a.every((x, i) => same(x, b[i]));
+  }
+  if (a !== null && typeof a === "object" && b !== null && typeof b === "object") {
+    const ka = Object.keys(a);
+    const kb = Object.keys(b);
+    if (ka.length !== kb.length) return false;
+    return ka.every((k) => k in b && same(a[k], b[k]));
+  }
+  return Object.is(a, b) || (typeof a === "number" && typeof b === "number" && Number.isNaN(a) && Number.isNaN(b));
+}
+
+/** A readable rendering of a parse result (arrays, null, key order kept). */
+export function render(v) {
+  if (v === undefined) return "undefined";
+  if (typeof v === "bigint") return `${v}n`;
+  if (typeof v === "symbol") return String(v);
+  if (typeof v === "function") return "[function]";
+  if (Array.isArray(v)) return `[${v.map(render).join(", ")}]`;
+  if (typeof v === "number") return Object.is(v, -0) ? "-0" : String(v); // JSON would say null for Infinity and NaN
+  if (v !== null && typeof v === "object") return `{${Object.keys(v).map((k) => `${JSON.stringify(k)}: ${render(v[k])}`).join(", ")}}`;
+  return JSON.stringify(v);
+}
