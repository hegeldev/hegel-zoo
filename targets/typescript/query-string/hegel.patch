diff --git a/hegel/gen.mjs b/hegel/gen.mjs
new file mode 100644
index 0000000..eaa414c
--- /dev/null
+++ b/hegel/gen.mjs
@@ -0,0 +1,181 @@
+// Hegel zoo: generators for query-string. Objects to stringify (keys and values with the
+// characters that matter to a query string: `&`, `=`, `+`, `%`, brackets, `:list`, spaces,
+// separators, non-ASCII), raw query strings to parse, options for both, and URLs with a query
+// and a fragment. Two shape spaces: CLEAN leaves out every shape a recorded bug (bugs.toml) is
+// about, FULL has them all; `known(shape)` names the bugs a case's shapes are about.
+
+import { chance, n, pick, word } from "./hegel-zoo.mjs";
+import { ARRAY_FORMATS } from "./model.mjs";
+
+export const FULL = {
+  markerKeys: true, // keys ending in `[]`, `[n]` or `:list` (bug 5)
+  separatorInElement: true, // an array element containing the separator under bracket-separator (bug 1)
+  plusSeparator: true, // `+` as the arrayFormatSeparator (bug 6)
+  mixedIndex: true, // a key both plain and indexed under `index` (bug 2)
+  unsortedIndex: true, // `sort: false` with the index format (bug 3)
+  encodedFragment: true, // a fragment with percent-encoded characters through pick/exclude (bug 4)
+  unsupportedValues: true, // objects and functions as values (bug 7)
+};
+export const CLEAN = Object.fromEntries(Object.keys(FULL).map((k) => [k, false]));
+
+// ---------------------------------------------------------------------------------------------
+// Strings
+
+const PLAIN = ["a", "b", "foo", "bar", "id", "q", "name", "x1", "Z", "k-9", "_", "~", ".", "0", "10", "01"];
+const SPICY = ["", " ", "a b", "a&b", "a=b", "a+b", "100%", "%20", "%2C", "%5B%5D", "café", "日本", "\u{1F600}", "a,b", "a|b", "a;b", "a:b", "#", "?", "/", "'", "(", ")", "*", "!", "\"", "true", "false", "1", "0", "1e3", "Infinity", "-0", " 1", "0x10", "null", "undefined", "[object Object]", "\\", "\n", "\t", "%", "%zz", "%E0%A4%A"];
+
+/** A string for a key or a value. */
+export function text(tc) {
+  const k = n(tc, 0, 9);
+  if (k < 4) return pick(tc, PLAIN);
+  if (k < 8) return pick(tc, SPICY);
+  return word(tc, ALPHABET, 0, 6);
+}
+
+const ALPHABET = [..."abcxyzAZ019 _-.~!*'()&=+%[]:;,|/?#\u00e9\u65e5"];
+
+/** A key: a plain string, sometimes ending in an array marker (FULL). */
+export function key(tc, flags, format) {
+  let k = text(tc);
+  if (flags.markerKeys && chance(tc, 10)) k += pick(tc, ["[]", "[0]", "[1]", ":list"]);
+  if (k.endsWith("[]") || /\[\d*]$/.test(k) || k.endsWith(":list")) {
+    if (!flags.markerKeys) k += "_";
+  }
+  return k;
+}
+
+/** A separator for the separator formats. */
+export function separator(tc, flags) {
+  if (flags.plusSeparator && chance(tc, 8)) return "+";
+  return pick(tc, [",", ",", "|", ";", ":", "/", "$", "@"]);
+}
+
+// ---------------------------------------------------------------------------------------------
+// Options
+
+/** Options shared by parse and stringify: arrayFormat, arrayFormatSeparator, sort. */
+export function formatOptions(tc, flags) {
+  const o = {};
+  o.arrayFormat = chance(tc, 20) ? "none" : pick(tc, ARRAY_FORMATS);
+  if (["separator", "bracket-separator"].includes(o.arrayFormat) || chance(tc, 20)) o.arrayFormatSeparator = separator(tc, flags);
+  const s = n(tc, 0, 9);
+  if (s < 5) {
+    /* default: sorted */
+  } else if (s < 8) o.sort = false;
+  else o.sort = (a, b) => (a < b ? 1 : a > b ? -1 : 0); // reverse code-unit order
+  if (o.sort === false && o.arrayFormat === "index" && !flags.unsortedIndex) delete o.sort;
+  return o;
+}
+
+/** Stringify options on top of the shared ones. */
+export function stringifyOptions(tc, flags) {
+  const o = formatOptions(tc, flags);
+  if (chance(tc, 30)) o.strict = false;
+  if (chance(tc, 25)) o.skipNull = true;
+  if (chance(tc, 25)) o.skipEmptyString = true;
+  return o;
+}
+
+/** Parse options on top of the shared ones (typing sometimes). */
+export function parseOptions(tc, flags, keys = []) {
+  const o = formatOptions(tc, flags);
+  if (chance(tc, 20)) o.parseNumbers = true;
+  if (chance(tc, 20)) o.parseBooleans = true;
+  if (keys.length > 0 && chance(tc, 30)) {
+    o.types = {};
+    for (const k of keys) if (chance(tc, 50)) o.types[k] = pick(tc, ["string", "number", "boolean", "string[]", "number[]", (v) => v + "!"]);
+  }
+  return o;
+}
+
+// ---------------------------------------------------------------------------------------------
+// Objects to stringify
+
+/** A scalar value: string mostly, else number, boolean, bigint, null, undefined. */
+export function scalarValue(tc, flags, sep) {
+  const k = n(tc, 0, 19);
+  if (k < 11) {
+    let s = text(tc);
+    if (sep && flags.separatorInElement && chance(tc, 15)) s = pick(tc, ["a", "", "x1"]) + sep + pick(tc, ["b", "", "10"]); // the separator inside an element
+    if (!flags.separatorInElement && sep && s.includes(sep)) s = s.split(sep).join("_");
+    return s;
+  }
+  if (k < 13) return pick(tc, [0, 1, -1, 42, 3.5, 1e21, -0, NaN, Infinity]);
+  if (k < 14) return pick(tc, [true, false]);
+  if (k < 15) return pick(tc, [0n, 12345678901234567890n]);
+  if (k < 18) return null;
+  return undefined;
+}
+
+/** An object to stringify: 0-5 keys, values scalars or arrays of 0-4 scalars (objects/functions in FULL). */
+export function object(tc, flags, options) {
+  const sep = ["comma", "separator", "bracket-separator"].includes(options.arrayFormat) ? options.arrayFormatSeparator ?? "," : null;
+  const out = {};
+  const count = n(tc, 0, 5);
+  for (let i = 0; i < count; i++) {
+    const k = key(tc, flags, options.arrayFormat);
+    if (flags.unsupportedValues && chance(tc, 5)) {
+      out[k] = pick(tc, [{}, { a: 1 }, () => 1, new Date(0), [[1, 2]]]);
+      continue;
+    }
+    if (chance(tc, 35)) {
+      const len = n(tc, 0, 4);
+      const arr = [];
+      for (let j = 0; j < len; j++) arr.push(scalarValue(tc, flags, sep));
+      out[k] = arr;
+    } else out[k] = scalarValue(tc, flags, sep);
+  }
+  return out;
+}
+
+// ---------------------------------------------------------------------------------------------
+// Query strings to parse
+
+/** A raw query string: pairs of encoded or raw text with markers, duplicates, `+`, bare keys, odd separators. */
+export function queryString(tc, flags, options) {
+  const parts = [];
+  const count = n(tc, 0, 5);
+  const keysUsed = [];
+  for (let i = 0; i < count; i++) {
+    let k = chance(tc, 30) && keysUsed.length > 0 ? pick(tc, keysUsed) : rawText(tc);
+    keysUsed.push(k);
+    const marker = n(tc, 0, 9);
+    if (marker === 0) k += "[]";
+    else if (marker === 1) k += `[${pick(tc, ["", "0", "1", "2", "10"])}]`;
+    else if (marker === 2) k += ":list";
+    const v = n(tc, 0, 9);
+    if (v < 2) parts.push(k);
+    else if (v < 3) parts.push(`${k}=`);
+    else if (v < 5) parts.push(`${k}=${rawText(tc)}${options.arrayFormatSeparator ?? ","}${rawText(tc)}`);
+    else parts.push(`${k}=${rawText(tc)}`);
+  }
+  let q = parts.join(pick(tc, ["&", "&", "&", "&&"]));
+  if (chance(tc, 20)) q = pick(tc, ["?", "#", "&", " ", "?&"]) + q;
+  if (chance(tc, 10)) q += pick(tc, ["&", " ", "="]);
+  return q;
+}
+
+/** Raw text as it appears in a query string: encoded or not. */
+export function rawText(tc) {
+  const k = n(tc, 0, 9);
+  if (k < 4) return pick(tc, PLAIN);
+  if (k < 6) return encodeURIComponent(pick(tc, SPICY));
+  if (k < 8) return pick(tc, ["a+b", "%20", "%2B", "%26", "%3D", "%5B%5D", "%3Alist", "caf%C3%A9", "%", "%zz", "100%25", "a%2Cb", "a%7Cb", "1%2C2", "true", "01", "1e3", ""]);
+  return word(tc, [..."abcxyz019-_.~%+*!"], 1, 5);
+}
+
+// ---------------------------------------------------------------------------------------------
+// URLs
+
+/** A URL with a query string and sometimes a fragment: { url, base, query, fragment }. */
+export function url(tc, flags, options) {
+  const base = pick(tc, ["https://foo.bar", "https://foo.bar/path", "http://x/p%20q", "https://user:pw@h:8080/a/b", "/relative", "", "file:///tmp/x", "https://x/?"]).replace(/\?$/, "");
+  const q = queryString(tc, flags, options).replace(/^[?#& ]+/, "").replace(/#/g, "%23");
+  let fragment = null;
+  if (chance(tc, 50)) {
+    fragment = pick(tc, ["hello", "a-b", "", "x=1&y=2", "a?b", "café", "%20", "a%26b", "%23", "a b", "100%", "#"]);
+    if (!flags.encodedFragment) fragment = fragment.replace(/%[0-9A-Fa-f]{2}/g, "x").replace(/[ #%]/g, "x");
+  }
+  const text = base + (q ? "?" + q : "") + (fragment === null ? "" : "#" + fragment);
+  return { url: text, base, query: q, fragment };
+}
diff --git a/hegel/hegel-zoo.mjs b/hegel/hegel-zoo.mjs
new file mode 100644
index 0000000..ef914e1
--- /dev/null
+++ b/hegel/hegel-zoo.mjs
@@ -0,0 +1,138 @@
+// Hegel zoo: the small harness shared by the zoo's TypeScript/JavaScript targets.
+//
+// `property(name, body)` registers a node:test test that runs `body(tc)` under Hegel with
+// HEGEL_TEST_CASES cases (default 100) and the database at HEGEL_DATABASE. With ZOO_COLLECT=1
+// a `fail()` records the mismatch instead of failing, the case ends there, and the counts of
+// mismatches and of the shapes seen (`count(key)`) are printed at the end of the test, so a
+// property can be run over many cases to see every shape at once. `pin(name, body)` is a
+// plain test for one pinned bug: it must fail while the bug is present and pass once it is
+// fixed (the zoo's judge reads an unexpected pass as "fixed upstream?").
+
+import { readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { test as nodeTest } from "node:test";
+import * as hegel from "@hegeldev/hegel";
+import * as gs from "@hegeldev/hegel/generators";
+
+// The Hegel version these tests were written against (the zoo pins it in zoo.toml and installs
+// it with `npm install --no-save @hegeldev/hegel@<version>`; upstream would add it to
+// devDependencies). Checked at load time so a stray install cannot silently change the engine.
+export const HEGEL_PIN = { "@hegeldev/hegel": "0.4.5" };
+
+{
+  let dir = dirname(fileURLToPath(import.meta.resolve("@hegeldev/hegel")));
+  while (!/[\\/]hegel$/.test(dir) && dir !== dirname(dir)) dir = dirname(dir);
+  const installed = JSON.parse(readFileSync(join(dir, "package.json"), "utf8")).version;
+  if (installed !== HEGEL_PIN["@hegeldev/hegel"]) {
+    throw new Error(`@hegeldev/hegel ${installed} is installed; these tests pin ${HEGEL_PIN["@hegeldev/hegel"]}`);
+  }
+}
+
+export const collecting = !!process.env.ZOO_COLLECT;
+
+class Collected extends Error {}
+
+let msgs = [];
+let stats = new Map();
+
+/** Report a mismatch: an error normally, a recorded line in collect mode. */
+export function fail(message) {
+  if (collecting) {
+    msgs.push(message);
+    throw new Collected(message);
+  }
+  throw new Error(message);
+}
+
+/** Bump a statistic (the shape of a pinned bug, a generator branch). */
+export function count(key) {
+  stats.set(key, (stats.get(key) || 0) + 1);
+}
+
+function settings() {
+  const s = { testCases: Number(process.env.HEGEL_TEST_CASES) || 100 };
+  if (process.env.HEGEL_DATABASE) {
+    s.database = hegel.Database.fromPath(process.env.HEGEL_DATABASE);
+  }
+  return s;
+}
+
+/** A property: `body(tc)` runs under Hegel; a thrown error (or `fail`) is a failure. */
+export function property(name, body) {
+  nodeTest(name, () => {
+    msgs = [];
+    stats = new Map();
+    hegel.test((tc) => {
+      try {
+        body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** A pin: a plain test for one recorded bug. */
+export function pin(name, body) {
+  nodeTest(name, body);
+}
+
+/** An integer in [lo, hi]. */
+export function n(tc, lo, hi) {
+  return tc.draw(gs.integers({ minValue: lo, maxValue: hi }));
+}
+
+/** One of xs. */
+export function pick(tc, xs) {
+  return xs[n(tc, 0, xs.length - 1)];
+}
+
+/** True pct percent of the time. */
+export function chance(tc, pct) {
+  return n(tc, 0, 99) < pct;
+}
+
+/** A string of `len` characters drawn from `alphabet` (an array of strings). */
+export function word(tc, alphabet, lo, hi) {
+  const len = n(tc, lo, hi);
+  let s = "";
+  for (let i = 0; i < len; i++) {
+    s += pick(tc, alphabet);
+  }
+  return s;
+}
+
+/** Structural equality: arrays by position, objects by key set (prototype ignored), else ===. */
+export function same(a, b) {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) {
+      return false;
+    }
+    return a.every((x, i) => same(x, b[i]));
+  }
+  if (a !== null && b !== null && typeof a === "object" && typeof b === "object") {
+    const ka = Object.keys(a).sort();
+    const kb = Object.keys(b).sort();
+    if (ka.length !== kb.length || ka.some((k, i) => k !== kb[i])) {
+      return false;
+    }
+    return ka.every((k) => same(a[k], b[k]));
+  }
+  return a === b;
+}
+
+/** A compact, unambiguous rendering for messages. */
+export function show(x) {
+  return JSON.stringify(x, (k, v) => (v === undefined ? "<undefined>" : v));
+}
diff --git a/hegel/hegel.test.mjs b/hegel/hegel.test.mjs
new file mode 100644
index 0000000..a2d292a
--- /dev/null
+++ b/hegel/hegel.test.mjs
@@ -0,0 +1,305 @@
+// Hegel zoo: properties of query-string (sindresorhus/query-string) against a model of its
+// documented behaviour (hegel/model.mjs): parse as the inverse of stringify for every array
+// format, parse and stringify against the readme's rules, the stability of stringify after
+// parse, and the URL functions (parseUrl, stringifyUrl, extract, pick, exclude). Run with
+// `node --test hegel/hegel.test.mjs` from the package root; HEGEL_TEST_CASES sets the case
+// count, ZOO_COLLECT=1 collects mismatches instead of stopping at the first.
+
+import assert from "node:assert/strict";
+import { chance, count, fail, pick, pin, property, show } from "./hegel-zoo.mjs";
+import * as gen from "./gen.mjs";
+import * as M from "./model.mjs";
+import queryString from "../index.js";
+
+const Q = queryString;
+const render = M.render;
+
+/** Names of the recorded bugs whose shapes an object/options pair has (for stringify-then-parse). */
+function knownForObject(obj, o) {
+  const ids = [];
+  const sep = o.arrayFormatSeparator ?? ",";
+  for (const k of Object.keys(obj)) {
+    const v = obj[k];
+    if ((o.arrayFormat === "bracket" || o.arrayFormat === "bracket-separator") && k.endsWith("[]")) ids.push("query-string/5 (key ends in [])");
+    if (o.arrayFormat === "index" && /\[\d*]$/.test(k)) ids.push("query-string/5 (key ends in [n])");
+    if (o.arrayFormat === "colon-list-separator" && k.endsWith(":list")) ids.push("query-string/5 (key ends in :list)");
+    if (o.arrayFormat === "bracket-separator" && Array.isArray(v) && v.some((x) => typeof x === "string" && x.includes(sep))) ids.push("query-string/1 (separator in an element)");
+    if (v !== null && typeof v === "object" && !Array.isArray(v)) ids.push("query-string/7 (object value)");
+    if (typeof v === "function") ids.push("query-string/7 (function value)");
+    if (Array.isArray(v) && v.some((x) => (x !== null && typeof x === "object") || typeof x === "function")) ids.push("query-string/7 (object in an array)");
+  }
+  if (["comma", "separator", "bracket-separator"].includes(o.arrayFormat) && sep === "+") ids.push("query-string/6 (plus separator)");
+  if (o.arrayFormat === "index" && o.sort === false) ids.push("query-string/3 (index arrays unsorted)");
+  return ids;
+}
+
+/** Names of the recorded bugs whose shapes a raw query string has under `o`. */
+function knownForQuery(q, o) {
+  const ids = [];
+  const marker = { bracket: /\[]$/, "bracket-separator": /\[]$/, index: /\[\d*]$/, "colon-list-separator": /:list$/ }[o.arrayFormat];
+  const rawKeys = M.pairs(q).map(([k]) => k);
+  // a percent-encoded marker (`foo%5B%5D`) is read as a marker: the key cannot be written plain
+  if (marker && rawKeys.some((k) => !marker.test(k) && marker.test(M.decode(k.replace(/\+/g, " "))))) ids.push("query-string/5 (encoded marker in a key)");
+  if (o.arrayFormat === "index") {
+    const plain = new Set();
+    const indexed = new Set();
+    for (const k0 of rawKeys) {
+      const k = M.decode(k0.replace(/\+/g, " "));
+      const m = /^(.*)\[\d*]$/.exec(k);
+      if (m) indexed.add(m[1]);
+      else plain.add(k);
+    }
+    if ([...indexed].some((k) => plain.has(k))) ids.push("query-string/2 (key both plain and indexed)");
+    if (o.sort === false) ids.push("query-string/3 (index arrays unsorted)");
+  }
+  if (["comma", "separator", "bracket-separator"].includes(o.arrayFormat) && (o.arrayFormatSeparator ?? ",") === "+") ids.push("query-string/6 (plus separator)");
+  if (o.arrayFormat === "bracket-separator" && /\[\]=[^&]*%(7C|2C|3B|3A|2F|24|40)/i.test(q)) ids.push("query-string/1 (encoded separator in an element)");
+  return ids;
+}
+
+const describeOptions = (o) => show({ ...o, sort: typeof o.sort === "function" ? "reverse" : o.sort, types: o.types && Object.fromEntries(Object.entries(o.types).map(([k, v]) => [k, typeof v === "function" ? "fn" : v])) });
+
+// ---------------------------------------------------------------------------------------------
+// parse(stringify(o)) is o, up to the documented losses
+
+property("TestHegelParseInvertsStringify", (tc) => {
+  const flags = chance(tc, 50) ? gen.CLEAN : gen.FULL;
+  const o = gen.stringifyOptions(tc, flags);
+  const obj = gen.object(tc, flags, o);
+  const known = knownForObject(obj, o);
+  const parseOptions = Object.fromEntries(Object.entries({ arrayFormat: o.arrayFormat, arrayFormatSeparator: o.arrayFormatSeparator, sort: o.sort }).filter(([, v]) => v !== undefined));
+  let text;
+  try {
+    text = Q.stringify(obj, o);
+  } catch (e) {
+    if (known.some((k) => k.startsWith("query-string/7"))) {
+      count("documented throw on an unsupported value");
+      return;
+    }
+    fail(`stringify(${render(obj)}, ${describeOptions(o)}) throws ${e.constructor.name}: ${e.message}`);
+  }
+  const expected = M.roundTripExpectation(obj, o);
+  let actual;
+  try {
+    actual = Q.parse(text, parseOptions);
+  } catch (e) {
+    fail(`parse(${show(text)}, ${describeOptions(parseOptions)}) throws ${e.constructor.name}: ${e.message}\n  from stringify(${render(obj)})`);
+  }
+  if (!M.same(actual, expected)) {
+    if (known.length > 0) {
+      count(`known ${known[0]}`);
+      return;
+    }
+    fail(`stringify(${render(obj)}, ${describeOptions(o)}) = ${show(text)}\n  parse back: ${render(actual)}\n  expected:   ${render(expected)}`);
+  }
+  if (known.some((k) => k.startsWith("query-string/7"))) {
+    // the documentation says objects and functions throw; they were written instead
+    count("known query-string/7 (unsupported value written)");
+    return;
+  }
+  count(o.arrayFormat);
+});
+
+// ---------------------------------------------------------------------------------------------
+// stringify against the documented rules
+
+property("TestHegelStringifyFollowsTheDocumentation", (tc) => {
+  const flags = chance(tc, 50) ? gen.CLEAN : gen.FULL;
+  const o = gen.stringifyOptions(tc, flags);
+  const obj = gen.object(tc, flags, o);
+  const known = knownForObject(obj, o);
+  let actual;
+  try {
+    actual = Q.stringify(obj, o);
+  } catch (e) {
+    if (known.some((k) => k.startsWith("query-string/7"))) {
+      count("documented throw on an unsupported value");
+      return;
+    }
+    fail(`stringify(${render(obj)}, ${describeOptions(o)}) throws ${e.constructor.name}: ${e.message}`);
+  }
+  if (known.some((k) => k.startsWith("query-string/7"))) {
+    count("known query-string/7 (unsupported value written)");
+    return;
+  }
+  const expected = M.stringify(obj, o);
+  if (actual !== expected) fail(`stringify(${render(obj)}, ${describeOptions(o)})\n  query-string: ${show(actual)}\n  model:        ${show(expected)}`);
+  count(o.arrayFormat);
+});
+
+// ---------------------------------------------------------------------------------------------
+// parse against the documented rules
+
+property("TestHegelParseFollowsTheDocumentation", (tc) => {
+  const flags = chance(tc, 50) ? gen.CLEAN : gen.FULL;
+  const o0 = gen.formatOptions(tc, flags);
+  const q = gen.queryString(tc, flags, o0);
+  const keys = [...new Set(M.pairs(q).map(([k]) => M.decode(k.replace(/\+/g, " ")).replace(/\[\d*]$|\[]$|:list$/, "")))];
+  const o = { ...gen.parseOptions(tc, flags, keys), arrayFormat: o0.arrayFormat, arrayFormatSeparator: o0.arrayFormatSeparator, sort: o0.sort };
+  if (o.arrayFormatSeparator === undefined) delete o.arrayFormatSeparator;
+  if (o.sort === undefined) delete o.sort;
+  const known = knownForQuery(q, o);
+  if (!flags.mixedIndex && known.some((k) => k.startsWith("query-string/2"))) {
+    count("skipped: mixed index key in CLEAN");
+    return;
+  }
+  let actual;
+  try {
+    actual = Q.parse(q, o);
+  } catch (e) {
+    if (known.some((k) => k.startsWith("query-string/2"))) {
+      count("known query-string/2 (throws)");
+      return;
+    }
+    fail(`parse(${show(q)}, ${describeOptions(o)}) throws ${e.constructor.name}: ${e.message}`);
+  }
+  const expected = M.parse(q, o);
+  if (!M.same(actual, expected)) {
+    if (known.length > 0) {
+      count(`known ${known[0]}`);
+      return;
+    }
+    fail(`parse(${show(q)}, ${describeOptions(o)})\n  query-string: ${render(actual)}\n  model:        ${render(expected)}`);
+  }
+  // key order follows sort, up to the engine's own rule for plain objects: keys that are canonical
+  // array indices ("10", not "01") always come first in numeric order, whatever the insertion order
+  const order = Object.keys(actual);
+  const sorted = o.sort === false ? order : order.slice().sort(o.sort === true || o.sort === undefined ? undefined : o.sort);
+  const isIndex = (k) => /^(0|[1-9]\d*)$/.test(k) && Number(k) < 2 ** 32 - 1;
+  const wanted = [...sorted.filter(isIndex).sort((x, y) => Number(x) - Number(y)), ...sorted.filter((k) => !isIndex(k))];
+  if (order.join("␀") !== wanted.join("␀")) fail(`parse(${show(q)}, ${describeOptions(o)}) keys in order ${show(order)}, sort wants ${show(wanted)}`);
+  count(o.arrayFormat);
+});
+
+// stringify(parse(q)) parses to the same object again
+property("TestHegelStringifyAfterParseIsStable", (tc) => {
+  const flags = chance(tc, 50) ? gen.CLEAN : gen.FULL;
+  const o = gen.formatOptions(tc, flags);
+  const q = gen.queryString(tc, flags, o);
+  const known = knownForQuery(q, o);
+  if (known.length > 0) {
+    count(`skipped: ${known[0]}`);
+    return;
+  }
+  const first = Q.parse(q, o);
+  const sep = o.arrayFormatSeparator ?? ",";
+  if (o.arrayFormat === "bracket-separator" && Object.values(first).some((v) => Array.isArray(v) && v.some((x) => typeof x === "string" && x.includes(sep)))) {
+    count("skipped: query-string/1 (separator in a parsed element)"); // a plain `k=a/b` joined by a later `k[]` cannot be written back
+    return;
+  }
+  const text = Q.stringify(first, o);
+  const second = Q.parse(text, o);
+  // documented losses on the way back: one-element arrays collapse under none/comma/separator, empty arrays vanish (except bracket-separator), nulls in separator formats become ""
+  const expected = M.roundTripExpectation(first, o);
+  if (!M.same(second, expected)) {
+    fail(`parse(${show(q)}, ${describeOptions(o)}) = ${render(first)}\n  stringify: ${show(text)}\n  parse again: ${render(second)}\n  expected:    ${render(expected)}`);
+  }
+  count(o.arrayFormat);
+});
+
+// ---------------------------------------------------------------------------------------------
+// URLs
+
+property("TestHegelUrlFunctionsAgree", (tc) => {
+  const flags = chance(tc, 50) ? gen.CLEAN : gen.FULL;
+  const o = gen.formatOptions(tc, flags);
+  const u = gen.url(tc, flags, o);
+  const knownQ = knownForQuery(u.query, o);
+  if (knownQ.length > 0) {
+    count(`skipped: ${knownQ[0]}`);
+    return;
+  }
+  const where = `url ${show(u.url)} options ${describeOptions(o)}`;
+  // extract and parseUrl
+  const extracted = Q.extract(u.url);
+  if (extracted !== u.query) fail(`${where}\n  extract: ${show(extracted)}\n  expected: ${show(u.query)}`);
+  const parsed = Q.parseUrl(u.url, { ...o, parseFragmentIdentifier: true });
+  if (parsed.url !== u.base) fail(`${where}\n  parseUrl().url: ${show(parsed.url)}\n  expected: ${show(u.base)}`);
+  const expectedQuery = M.parse(u.query, o);
+  if (o.arrayFormat === "bracket-separator" && Object.values(expectedQuery).some((v) => Array.isArray(v) && v.some((x) => typeof x === "string" && x.includes(o.arrayFormatSeparator ?? ",")))) {
+    count("skipped: query-string/1 (separator in a parsed element)"); // stringifyUrl cannot write such an element back
+    return;
+  }
+  if (!M.same(parsed.query, expectedQuery)) fail(`${where}\n  parseUrl().query: ${render(parsed.query)}\n  expected: ${render(expectedQuery)}`);
+  const expectedFragment = u.fragment === null ? undefined : u.fragment === "" ? undefined : M.decode(u.fragment);
+  if (parsed.fragmentIdentifier !== expectedFragment) fail(`${where}\n  parseUrl().fragmentIdentifier: ${show(parsed.fragmentIdentifier)}\n  expected: ${show(expectedFragment)}`);
+  // stringifyUrl of parseUrl keeps the base and the fragment's meaning
+  const back = Q.stringifyUrl(parsed, o);
+  const backParsed = Q.parseUrl(back, { ...o, parseFragmentIdentifier: true });
+  const expectedBack = M.roundTripExpectation(expectedQuery, o); // nulls in the separator formats come back as ""
+  if (backParsed.url !== u.base || !M.same(backParsed.query, expectedBack) || backParsed.fragmentIdentifier !== expectedFragment) {
+    fail(`${where}\n  stringifyUrl(parseUrl(u)) = ${show(back)}\n  which parses to ${render(backParsed)}`);
+  }
+  // pick keeps exactly the chosen keys, exclude the others; both keep the base and the fragment as written
+  const keys = Object.keys(parsed.query);
+  const chosen = keys.filter(() => chance(tc, 50));
+  const picked = Q.pick(u.url, chosen, o);
+  const excluded = Q.exclude(u.url, chosen, o);
+  const fragmentText = u.fragment === null || u.fragment === "" ? "" : "#" + u.fragment; // an empty fragment is dropped, like none
+  const encodedFragment = u.fragment !== null && /[%# ]/.test(u.fragment);
+  for (const [name, result, wantKeys] of [
+    ["pick", picked, chosen],
+    ["exclude", excluded, keys.filter((k) => !chosen.includes(k))],
+  ]) {
+    const r = Q.parseUrl(result, { ...o, parseFragmentIdentifier: true });
+    const hash = result.includes("#") ? result.slice(result.indexOf("#")) : "";
+    if (r.url !== u.base) fail(`${where}\n  ${name}(${show(chosen)}) = ${show(result)}: base ${show(r.url)}, expected ${show(u.base)}`);
+    const gotKeys = Object.keys(r.query).sort();
+    if (gotKeys.join("␀") !== wantKeys.slice().sort().join("␀")) fail(`${where}\n  ${name}(${show(chosen)}) = ${show(result)}: keys ${show(gotKeys)}, expected ${show(wantKeys.slice().sort())}`);
+    for (const k of wantKeys) if (!M.same(r.query[k], expectedBack[k])) fail(`${where}\n  ${name}(${show(chosen)}) = ${show(result)}: ${show(k)} is ${render(r.query[k])}, expected ${render(expectedQuery[k])}`);
+    if (hash !== fragmentText) {
+      if (encodedFragment) count("known query-string/4 (fragment rewritten)");
+      else fail(`${where}\n  ${name}(${show(chosen)}) = ${show(result)}: fragment ${show(hash)}, expected ${show(fragmentText)}`);
+    }
+  }
+  count(u.fragment === null ? "no fragment" : "fragment");
+});
+
+// ---------------------------------------------------------------------------------------------
+// Pins: one plain test per recorded bug; each fails while the bug is present.
+
+pin("TestHegelPinBracketSeparatorElementsMayContainTheSeparator", () => {
+  const o = { arrayFormat: "bracket-separator", arrayFormatSeparator: "|" };
+  const text = Q.stringify({ foo: ["a|b", "c"] }, o);
+  assert.equal(text, "foo[]=a%7Cb|c");
+  assert.deepEqual({ ...Q.parse(text, o) }, { foo: ["a|b", "c"] }, `parse(${text}) splits the percent-encoded separator`);
+});
+
+pin("TestHegelPinIndexParserAcceptsAPlainAndIndexedKey", () => {
+  assert.doesNotThrow(() => Q.parse("foo=1&foo[0]=2", { arrayFormat: "index" }));
+  assert.doesNotThrow(() => Q.parse("foo&foo[0]=2", { arrayFormat: "index" }));
+});
+
+pin("TestHegelPinIndexArraysAreArraysWithoutSorting", () => {
+  const r = Q.parse("foo[0]=a&foo[1]=b", { arrayFormat: "index", sort: false });
+  assert.ok(Array.isArray(r.foo), `parse gives ${render(r)}`);
+  assert.deepEqual(r.foo, ["a", "b"]);
+});
+
+pin("TestHegelPinPickKeepsTheFragmentAsWritten", () => {
+  assert.equal(Q.pick("https://x?a=1&b=2#a%26b", ["a"]), "https://x?a=1#a%26b");
+  assert.equal(Q.exclude("https://x?a=1&b=2#foo%20bar", ["b"]), "https://x?a=1#foo%20bar");
+  assert.equal(Q.pick("https://x?a=1#%23", ["a"]), "https://x?a=1#%23");
+});
+
+pin("TestHegelPinKeysEndingInArrayMarkersRoundTrip", () => {
+  for (const [obj, o] of [
+    [{ "foo[0]": "x" }, { arrayFormat: "index" }],
+    [{ "foo[]": "x" }, { arrayFormat: "bracket" }],
+    [{ "foo:list": "x" }, { arrayFormat: "colon-list-separator" }],
+  ]) {
+    const text = Q.stringify(obj, o);
+    assert.deepEqual({ ...Q.parse(text, o) }, obj, `stringify(${render(obj)}) = ${text}, which parses to ${render(Q.parse(text, o))}`);
+  }
+});
+
+pin("TestHegelPinPlusIsAUsableSeparator", () => {
+  const o = { arrayFormat: "separator", arrayFormatSeparator: "+" };
+  const text = Q.stringify({ foo: ["a", "b"] }, o);
+  assert.deepEqual({ ...Q.parse(text, o) }, { foo: ["a", "b"] }, `stringify gives ${text}, which parses to ${render(Q.parse(text, o))}`);
+});
+
+pin("TestHegelPinUnsupportedValuesThrow", () => {
+  assert.throws(() => Q.stringify({ a: {} }), "an object value is documented to throw");
+  assert.throws(() => Q.stringify({ a: () => 1 }), "a function value is documented to throw");
+});
