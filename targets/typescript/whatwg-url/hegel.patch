+  [60, chars(ALNUM, 1, 8)],
+  [10, gs.tuples(chars(ALNUM, 1, 4), chars(ALNUM, 1, 4)).map(([a, b]) => `${a}-${b}`)],
+  [10, chars(UPPER, 1, 6)],
+  [20, gs.sampledFrom(UNICODE_LABELS)],
+);
