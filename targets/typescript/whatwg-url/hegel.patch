+// combinators, and the pure functions that render what they draw.
+//
+// A URL string is drawn as a small tree - a scheme with its kind, an authority (slashes, userinfo,
+// a host with its kind, a port) or an opaque path, a path as segments with their separators, a
+// query, a fragment, and the whitespace and hostile characters to decorate the text with - and
+// rendered by pure functions; the shapes a case exercises (the counts) are derived from the same
+// data. The setter steps and the URLSearchParams operations are lists of records applied in order.
+
+import { gs } from "./hegel-zoo.mjs";
+
+// ---------------------------------------------------------------- generator helpers
+
+const ints = (lo, hi) => gs.integers({ minValue: lo, maxValue: hi });
+
+/** oneOf with weights: `weighted([45, a], [55, b])` draws a 45 times in 100; shrinks towards the first choice. */
+function weighted(...choices) {
+  const total = choices.reduce((sum, [w]) => sum + w, 0);
+  return ints(0, total - 1).flatMap((r) => {
+    for (const [w, g] of choices) {
+      if (r < w) return g;
+      r -= w;
+    }
+    throw new Error("unreachable");
+  });
+}
+
+/** True pct percent of the time; shrinks to false. */
+const chance = (pct) => ints(0, 99).map((r) => r >= 100 - pct);
+/** A draw from g pct percent of the time, else undefined (listed first: shrinks to absent). */
+const maybe = (pct, g) => weighted([100 - pct, gs.just(undefined)], [pct, g]);
+/** lo-hi pieces of `pool` (strings of one or more characters) concatenated. */
+const pieces = (pool, lo, hi) => gs.arrays(gs.sampledFrom(pool), { minSize: lo, maxSize: hi }).map((xs) => xs.join(""));
+/** lo-hi characters of `alphabet`. */
+const chars = (alphabet, lo, hi) => gs.text({ alphabet, minSize: lo, maxSize: hi });
+/** k draws of g, as an array. */
+const fixed = (g, k) => gs.tuples(...Array(k).fill(g));
+/** The draws of `gens` joined with dots. */
+const dotted = (...gens) => gs.tuples(...gens).map((xs) => xs.join("."));
+
+// ---------------------------------------------------------------- alphabets
+
+const ALNUM = "abcdefghijklmnopqrstuvwxyz0123456789";
+const UPPER = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
+/** The characters the parser strips, encodes, forbids or reads as delimiters. */
+const HOSTILE = ["%", "%4", "%41", "%zz", "%2e", "%2E", "%2F", "%3F", "%23", " ", "\t", "\n", "\r", "\\", "/", "?", "#", "@", ":", "[", "]", "<", ">", "^", "|", "`", "{", "}", "\"", "'", "\u0000", "\u001f", "\u007f", "\u0080", "\u00a0", "é", "ß", "一", "😀", "\ud800", "\udc00", "\ufeff", "\uffff", ".", "..", "...", ";", "=", "&", "+", "~", "*", "$", "!", "(", ")", ","];
+const HOSTILE_ALNUM = [...ALNUM, ...HOSTILE];
+
+// ---------------------------------------------------------------- schemes
+
+const SPECIAL_RE = /^(https?|wss?|ftp|file)$/i;
+const schemeOf = (kind) => (s) => ({ s, kind });
+/** A scheme that parses: special (plain or mixed case) or other (from a list, or 1-5 alphanumerics). */
+const validScheme = weighted(
+  [45, gs.sampledFrom(["http", "https", "ws", "wss", "ftp", "file"]).map(schemeOf("special"))],
+  [10, gs.sampledFrom(["HTTP", "Https", "FILE", "Ws"]).map(schemeOf("special"))],
