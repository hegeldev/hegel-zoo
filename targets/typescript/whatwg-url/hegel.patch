+    slashes: weighted([92, gs.just("//")], [8, gs.sampledFrom(["/", "///", "\\\\", "/\\"])]),
+    userinfo: maybe(25, gs.record({ user: userinfo, pass: maybe(50, userinfo) })),
+    host,
+    port: maybe(25, port),
