+
+/** 0-12 pieces: alphanumerics, escapes valid, cut short and malformed, UTF-8 sequences, non-ASCII, NUL, a lone surrogate. */
+export const percentInput = pieces([...ALNUM, "%", "%2", "%20", "%zz", "%C3%A9", "%c3%a9", "%E2%82%AC", "%F0%9F%98%80", "%ff", "%FF", "%%", "%%41", "é", "😀", "\u0000", "+", "%2B", "\ud800"], 0, 12);
diff --git a/test/hegel-zoo.mjs b/test/hegel-zoo.mjs
new file mode 100644
index 0000000..6be29e8
--- /dev/null
+++ b/test/hegel-zoo.mjs
@@ -0,0 +1,116 @@
+// Hegel zoo: the small harness shared by the zoo's TypeScript/JavaScript targets.
+//
+// `property(name, body)` registers a node:test test that runs `body(tc)` under Hegel with
+// HEGEL_TEST_CASES cases (default 100) and the database at HEGEL_DATABASE. With ZOO_COLLECT=1
+// a `fail()` records the mismatch instead of failing, the case ends there, and the counts of
+// mismatches and of the shapes seen (`count(key)`) are printed at the end of the test, so a
+// property can be run over many cases to see every shape at once. `pin(name, body)` is a
+// plain test for one pinned bug: it must fail while the bug is present and pass once it is
+// fixed (the zoo's judge reads an unexpected pass as "fixed upstream?").
+
+import { readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { test as nodeTest } from "node:test";
+import * as hegel from "@hegeldev/hegel";
+import * as gs from "@hegeldev/hegel/generators";
+
+/** Hegel's generators, re-exported so the tests import everything from one place. */
+export { gs };
+
+// The Hegel version these tests were written against (the zoo pins it in zoo.toml and installs
+// it with `npm install --no-save @hegeldev/hegel@<version>`; upstream would add it to
+// devDependencies). Checked at load time so a stray install cannot silently change the engine.
+export const HEGEL_PIN = { "@hegeldev/hegel": "0.4.5" };
+
+{
+  let dir = dirname(fileURLToPath(import.meta.resolve("@hegeldev/hegel")));
+  while (!/[\\/]hegel$/.test(dir) && dir !== dirname(dir)) dir = dirname(dir);
+  const installed = JSON.parse(readFileSync(join(dir, "package.json"), "utf8")).version;
+  if (installed !== HEGEL_PIN["@hegeldev/hegel"]) {
+    throw new Error(`@hegeldev/hegel ${installed} is installed; these tests pin ${HEGEL_PIN["@hegeldev/hegel"]}`);
+  }
+}
+
+export const collecting = !!process.env.ZOO_COLLECT;
+
+class Collected extends Error {}
+
+let msgs = [];
+let stats = new Map();
+
+/** Report a mismatch: an error normally, a recorded line in collect mode. */
+export function fail(message) {
+  if (collecting) {
+    msgs.push(message);
+    throw new Collected(message);
+  }
+  throw new Error(message);
+}
+
+/** Bump a statistic (the shape of a pinned bug, a generator branch). */
+export function count(key) {
+  stats.set(key, (stats.get(key) || 0) + 1);
+}
+
+function settings() {
+  const s = { testCases: Number(process.env.HEGEL_TEST_CASES) || 100 };
+  if (process.env.HEGEL_DATABASE) {
+    s.database = hegel.Database.fromPath(process.env.HEGEL_DATABASE);
+  }
+  return s;
+}
+
+/** A property: `body(tc)` runs under Hegel; a thrown error (or `fail`) is a failure. */
+export function property(name, body) {
+  nodeTest(name, () => {
+    msgs = [];
+    stats = new Map();
+    hegel.test((tc) => {
+      try {
+        body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** A pin: a plain test for one recorded bug. */
+export function pin(name, body) {
+  nodeTest(name, body);
+}
+
+/** Structural equality: arrays by position, objects by key set (prototype ignored), else ===. */
+export function same(a, b) {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) {
+      return false;
+    }
+    return a.every((x, i) => same(x, b[i]));
+  }
+  if (a !== null && b !== null && typeof a === "object" && typeof b === "object") {
+    const ka = Object.keys(a).sort();
+    const kb = Object.keys(b).sort();
+    if (ka.length !== kb.length || ka.some((k, i) => k !== kb[i])) {
+      return false;
+    }
+    return ka.every((k) => same(a[k], b[k]));
+  }
+  return a === b;
+}
+
+/** A compact, unambiguous rendering for messages. */
+export function show(x) {
+  return JSON.stringify(x, (k, v) => (v === undefined ? "<undefined>" : v));
+}
diff --git a/test/hegel.test.mjs b/test/hegel.test.mjs
new file mode 100644
index 0000000..02d769f
--- /dev/null
+++ b/test/hegel.test.mjs
@@ -0,0 +1,329 @@
+// Hegel zoo: properties of whatwg-url (jsdom/whatwg-url) - the URL Standard's parser, serializer,
+// URL and URLSearchParams against Node's native implementation (Ada) of the same standard, plus
+// the library's own consistency (idempotent serialization, the record API, percent-decoding).
+//
+// Run with `node --test --test-reporter=tap test/hegel.test.mjs` after the setup in target.toml
+// (`npm install` of the dev tree - webidl2js is needed - and `node scripts/transform.js`, which
+// generates lib/URL.js and lib/URLSearchParams.js as upstream's `prepare` does). ZOO_COLLECT=1
+// records mismatches instead of failing (see test/hegel-zoo.mjs).
+//
+// The generators are in gen.mjs: a URL is drawn as a small tree (scheme, authority, path, query,
+// fragment, decoration) and rendered by pure functions; setter steps and URLSearchParams
+// operations are lists of records applied in order. Each property draws one record.
+
+import * as W from "../index.js";
+import { property, fail, count, show } from "./hegel-zoo.mjs";
+import { parseCase, percentInput, searchParamsCase, settersCase } from "./gen.mjs";
+
+// ---------------------------------------------------------------- observation
+
+const FIELDS = ["href", "protocol", "username", "password", "host", "hostname", "port", "pathname", "search", "hash", "origin"];
+
+/** The URL as {ok, fields} from a constructor, or {ok: false, error}. */
+function observe(Ctor, input, base) {
+  try {
+    const u = base === undefined ? new Ctor(input) : new Ctor(input, base);
+    const out = {};
+    for (const f of FIELDS) out[f] = u[f];
+    return { ok: true, u, fields: out };
+  } catch (e) {
+    return { ok: false, error: e.message };
+  }
+}
+
+function differences(a, b) {
+  return FIELDS.filter((f) => a[f] !== b[f]);
+}
+
+function describe(r) {
+  return r.ok ? r.fields.href : `rejected (${r.error})`;
+}
+
+const IDNA_LIKE = /[^\x00-\x7f]|xn--/i;
+
+/** Differences between Node's Ada and the URL Standard's text that whatwg-url follows: not
+ *  counted against whatwg-url. `nf` and `lf` are the two sides' fields; a limit name or null. */
+function knownOracleDivergence(nf, lf) {
+  const diff = differences(nf, lf);
+  // where the path ends in the serialization: at the first "?" or "#" (neither can appear
+  // unencoded before the query), or at the end (`search`/`hash` are "" for a bare "?"/"#")
+  const pathEnd = nf.href.search(/[?#]/) === -1 ? nf.href.length : nf.href.search(/[?#]/);
+  // the path percent-encode set includes U+005E (^) (whatwg/url, 2024); Ada leaves it bare
+  if (diff.every((f) => f === "href" || f === "pathname") && nf.pathname.replaceAll("^", "%5E") === lf.pathname) {
+    if (nf.href.slice(0, pathEnd - nf.pathname.length) + lf.pathname + nf.href.slice(pathEnd) === lf.href) return "limit/ada-caret-in-path";
+  }
+  // a double-dot segment on an empty non-special path appends an empty segment ("foo://h/.."
+  // is "foo://h/" in the spec's path state); Ada leaves the path empty ("foo://h")
+  if (diff.every((f) => f === "href" || f === "pathname") && nf.pathname === "" && lf.pathname === "/") {
+    if (nf.href.slice(0, pathEnd) + "/" + nf.href.slice(pathEnd) === lf.href) return "limit/ada-double-dot-on-empty-path";
+  }
+  // a trailing space of an opaque path before "?" or "#" is percent-encoded (opaque path
+  // state, since 2024); Ada leaves it ("x-y.z:a ?q")
+  if (diff.every((f) => f === "href" || f === "pathname") && / $/.test(nf.pathname) && nf.pathname.replace(/ +$/, (m) => "%20".repeat(m.length)) === lf.pathname && nf.href.replace(nf.pathname, lf.pathname) === lf.href) {
+    return "limit/ada-trailing-space-in-opaque-path";
+  }
+  // shortening a file URL's path keeps only a *normalized* Windows drive letter (exactly "C:");
+  // Ada also keeps a longer first segment that starts like one ("file:///C:a/../|")
+  if (diff.every((f) => f === "href" || f === "pathname") && nf.protocol === "file:" && /^\/[A-Za-z][:|][^/]+\//.test(nf.pathname) && nf.pathname.replace(/^\/[A-Za-z][:|][^/]+/, "") === lf.pathname && nf.href.replace(nf.pathname, lf.pathname) === lf.href) {
+    return "limit/ada-file-drive-letter-prefix-kept";
+  }
+  // hostname = "" on a non-special URL without a host gives the empty host (non-null, so the
+  // serialization gains "//": "c:/x" → "c:///x"); Ada leaves the host null
+  if (diff.every((f) => f === "href") && lf.host === "" && nf.host === "" && nf.protocol + "//" + nf.href.slice(nf.protocol.length) === lf.href) {
+    return "limit/ada-empty-host-stays-null";
+  }
+  // a setter that leaves a port whatwg-url keeps (port 0 after a protocol change; a port with
+  // more than five digits in the host setter of a non-special URL) is dropped by Ada
+  if (diff.every((f) => f === "href" || f === "host" || f === "port") && lf.port !== "" && nf.port === "" && lf.href.replace(":" + lf.port, "") === nf.href) {
+    return "limit/ada-drops-port";
+  }
+  return null;
+}
+
+/** whatwg-url's fields `lf` as Ada rewrites them when it re-parses a URL that went through `protocol = "file"`: the host "localhost" becomes the empty host, a first-segment drive letter "c|" becomes "c:". */
+function adaFileRenormalization(lf) {
+  let { href, host, hostname, pathname } = lf;
+  if (lf.protocol === "file:" && hostname === "localhost") {
+    href = href.replace("//localhost", "//");
+    host = "";
+    hostname = "";
+  }
+  if (/^\/[A-Za-z]\|/.test(pathname)) {
+    const colon = pathname.replace("|", ":");
+    href = href.replace(pathname, colon);
+    pathname = colon;
+  }
+  return { href, host, hostname, pathname };
+}
+
+/** A case Node and whatwg-url read differently for a reason recorded against Node: counted, not judged. */
+function skipDivergence(tc, name) {
+  count(name);
+  tc.assume(false);
+}
+
+// ---------------------------------------------------------------- properties
+
+// Parsing: whatwg-url and Node accept the same inputs and give the same components; the record
+// API agrees with the class.
+property("TestHegelParsingAgreesWithNodeUrl", (tc) => {
+  const { url: { text: input, shapes }, base: drawnBase } = tc.draw(parseCase);
+  const base = drawnBase?.text;
+  for (const s of shapes) count(s);
+  if (drawnBase !== undefined) count(drawnBase.shape);
+  const node = observe(URL, input, base);
+  const lib = observe(W.URL, input, base);
+  const idna = IDNA_LIKE.test(input) || (base !== undefined && IDNA_LIKE.test(base));
+  // the record API takes the scalar value string the class gets after USVString conversion:
+  // a lone surrogate is U+FFFD before parsing, so a pair split by a stripped "\r" stays two
+  const usv = input.toWellFormed();
+  const baseRecord = base === undefined ? undefined : W.parseURL(base.toWellFormed());
+  if (node.ok !== lib.ok) {
+    if (idna) skipDivergence(tc, "idna/acceptance-differs");
+    if (node.ok && !lib.ok && base !== undefined && baseRecord !== null && typeof baseRecord.path === "string" && !/^[\u0000-\u0020]*#/.test(input) && input.includes("#")) {
+      // the no-scheme state fails for a base with an opaque path unless the input starts with
+      // "#"; Ada resolves any input that contains a "#" against such a base as a relative path
+      skipDivergence(tc, "limit/ada-relative-to-opaque-base");
+    }
+    fail(`${show(input)}${base !== undefined ? " with base " + show(base) : ""}: Node ${describe(node)}, whatwg-url ${describe(lib)}`);
+  }
+  // canParse and the record API tell the same story
+  const can = base === undefined ? W.URL.canParse(input) : W.URL.canParse(input, base);
+  if (can !== lib.ok) fail(`URL.canParse(${show(input)}, ${show(base)}) = ${can} but the constructor ${lib.ok ? "accepts" : "rejects"}`);
+  const parsed = base === undefined ? W.URL.parse(input) : W.URL.parse(input, base);
+  if ((parsed !== null) !== lib.ok || (parsed !== null && parsed.href !== lib.fields.href)) fail(`URL.parse(${show(input)}, ${show(base)}) gives ${parsed === null ? "null" : show(parsed.href)} but the constructor ${describe(lib)}`);
+  const record = base !== undefined && baseRecord === null ? null : W.parseURL(usv, { baseURL: baseRecord ?? undefined });
+  if ((record !== null) !== lib.ok) fail(`parseURL(${show(input)}, base ${show(base)}) ${record === null ? "fails" : "succeeds"} but the constructor ${lib.ok ? "accepts" : "rejects"}`);
+  if (!lib.ok) return; // both reject, and canParse, parse and parseURL agree: nothing more to compare
+  const diff = differences(node.fields, lib.fields);
+  if (diff.length) {
+    if (idna && diff.every((f) => ["href", "host", "hostname", "origin"].includes(f))) skipDivergence(tc, "idna/host-differs");
+    const known = knownOracleDivergence(node.fields, lib.fields);
+    if (known) skipDivergence(tc, known);
+    fail(`${show(input)}${base !== undefined ? " with base " + show(base) : ""}: ${diff.map((f) => `${f}: whatwg-url ${show(lib.fields[f])}, Node ${show(node.fields[f])}`).join("; ")}`);
+  }
+  const ser = W.serializeURL(record);
+  if (ser !== lib.fields.href) fail(`serializeURL(parseURL(${show(input)})) = ${show(ser)}, URL.href = ${show(lib.fields.href)}`);
+  const origin = W.serializeURLOrigin(record);
+  if (origin !== lib.fields.origin) fail(`serializeURLOrigin gives ${show(origin)}, URL.origin ${show(lib.fields.origin)}`);
+  if (W.serializePath(record) !== lib.fields.pathname) fail(`serializePath gives ${show(W.serializePath(record))}, URL.pathname ${show(lib.fields.pathname)}`);
+  if (record.host !== null && W.serializeHost(record.host) !== lib.fields.hostname) fail(`serializeHost gives ${show(W.serializeHost(record.host))}, URL.hostname ${show(lib.fields.hostname)}`);
+  if (lib.u.toJSON() !== lib.fields.href || String(lib.u) !== lib.fields.href) fail(`toJSON/toString differ from href for ${show(lib.fields.href)}`);
+  if (record.port !== null && W.serializeInteger(record.port) !== lib.fields.port) fail(`serializeInteger(${show(record.port)}) = ${show(W.serializeInteger(record.port))}, URL.port ${show(lib.fields.port)}`);
+  if (W.hasAnOpaquePath(record) !== (typeof record.path === "string")) fail(`hasAnOpaquePath disagrees with the record's path ${show(record.path)}`);
+  const cannot = record.host === null || record.host === "" || record.scheme === "file";
+  if (W.cannotHaveAUsernamePasswordPort(record) !== cannot) fail(`cannotHaveAUsernamePasswordPort = ${!cannot} for host ${show(record.host)}, scheme ${record.scheme}`);
+  // serializing is idempotent, and the serialization parses to the same thing everywhere
+  const again = observe(W.URL, lib.fields.href);
+  if (!again.ok || again.fields.href !== lib.fields.href) fail(`href ${show(lib.fields.href)} does not survive a second parse: ${describe(again)}`);
+  const nodeAgain = observe(URL, lib.fields.href);
+  if (!nodeAgain.ok || nodeAgain.fields.href !== lib.fields.href) fail(`Node reads whatwg-url's href ${show(lib.fields.href)} as ${describe(nodeAgain)}`);
+  // validation errors and the validator
+  const { url: withErrors, validationErrors } = W.parseURLWithValidationErrors(usv, { baseURL: baseRecord ?? undefined });
+  if (W.serializeURL(withErrors) !== ser) fail(`parseURLWithValidationErrors gives ${show(W.serializeURL(withErrors))}, parseURL ${show(ser)}`);
+  const valid = W.isValidURLString(usv, { baseURL: baseRecord ?? undefined });
+  count(valid ? "valid" : "invalid");
+  if (valid !== (validationErrors.length === 0)) fail(`isValidURLString(${show(input)}) = ${valid} but the parser reports ${show(validationErrors)}`);
+});
+
+// Setters: from a URL both sides read alike, random assignments to the attributes leave both
+// sides alike.
+property("TestHegelSettersAgreeWithNodeUrl", (tc) => {
+  const { start, steps } = tc.draw(settersCase);
+  const node = observe(URL, start);
+  const lib = observe(W.URL, start);
+  // the start is a URL both sides read alike (the generator is shaped towards those; the rest is skipped)
+  if (!node.ok || !lib.ok || differences(node.fields, lib.fields).length) tc.assume(false);
+  const idnaStart = IDNA_LIKE.test(start);
+  for (const [i, { attr, value }] of steps.entries()) {
+    count(`set/${attr}`);
+    let nodeThrew = null;
+    let libThrew = null;
+    try { node.u[attr] = value; } catch (e) { nodeThrew = e.message; }
+    try { lib.u[attr] = value; } catch (e) { libThrew = e.message; }
+    if ((nodeThrew === null) !== (libThrew === null)) {
+      if (attr === "href" && IDNA_LIKE.test(value)) skipDivergence(tc, "idna/acceptance-differs");
+      fail(`${show(start)} then ${attr} = ${show(value)}: Node ${nodeThrew === null ? "accepts" : "throws " + nodeThrew}, whatwg-url ${libThrew === null ? "accepts" : "throws " + libThrew}`);
+    }
+    const nf = {};
+    const lf = {};
+    for (const f of FIELDS) {
+      nf[f] = node.u[f];
+      lf[f] = lib.u[f];
+    }
+    const diff = differences(nf, lf);
+    if (diff.length) {
+      // (a host value with a port that one side refuses on IDNA grounds leaves that side's port alone too)
+      const idnaFields = attr === "host" && value.includes(":") ? ["href", "host", "hostname", "origin", "port"] : ["href", "host", "hostname", "origin"];
+      if ((idnaStart || IDNA_LIKE.test(value)) && diff.every((f) => idnaFields.includes(f))) skipDivergence(tc, "idna/host-differs");
+      // pathname = "//" on a URL without a host gets the "/." prefix in the serialization;
+      // Ada then loses the query and fragment ("x:/a?q#f" → "x:/.//", whatwg-url "x:/.//?q#f";
+      // a bare "?" or "#", an empty query or fragment, goes the same way)
+      if (attr === "pathname" && diff.every((f) => f === "href" || f === "search" || f === "hash") && nf.search === "" && nf.hash === "" && lf.pathname.startsWith("//") && lf.href.startsWith(nf.href) && /^[?#]/.test(lf.href.slice(nf.href.length))) {
+        skipDivergence(tc, "limit/ada-pathname-setter-drops-query-and-fragment");
+      }
+      // host = ":80" (nothing before the colon) on a non-special URL: the host state has an
+      // empty buffer at ":" → host-missing → failure, so the setter changes nothing (whatwg-url);
+      // Ada sets the empty host and takes the port ("blob://!:80/" then host = ":" → "blob://:80/",
+      // "blob://hh/" then host = ":80" → "blob://:80/", with Node's `host` reading "" beside port "80")
+      if ((attr === "host" || attr === "hostname") && value.startsWith(":") && nf.hostname === "" && lf.hostname !== "" && diff.every((f) => ["href", "host", "hostname", "port"].includes(f)) && lf.href.replace(lf.host, nf.port === "" ? "" : ":" + nf.port) === nf.href) {
+        skipDivergence(tc, "limit/ada-host-setter-empty-before-colon");
+      }
+      // after protocol = "file" on "https://localhost/c|/x" (both sides: "file://localhost/c|/x"),
+      // Ada re-parses on the next setter call of any kind (even a refused protocol change) and
+      // applies the file host state's normalizations - host "localhost" becomes the empty host,
+      // the drive letter "c|" becomes "c:" - which no setter does in the standard (they belong
+      // to parsing: the file host state and the path state)
+      if (steps.slice(0, i + 1).some((s) => s.attr === "protocol" && /^file(:|$)/i.test(s.value))) {
+        const renormalized = adaFileRenormalization(lf);
+        if (diff.every((f) => ["href", "host", "hostname", "pathname"].includes(f) && nf[f] === renormalized[f])) skipDivergence(tc, "limit/ada-file-normalizations-by-later-setter");
+      }
+      // a file URL whose host is "localhost" (reached through protocol = "file" on "https://localhost/",
+      // since only the file host state maps localhost to the empty host) may leave "file:" - the
+      // scheme state refuses the switch only for an *empty* host; Ada refuses it for localhost too
+      if (attr === "protocol" && nf.protocol === "file:" && lf.protocol !== "file:" && nf.hostname === "localhost" && diff.every((f) => ["href", "protocol", "origin"].includes(f)) && nf.href.replace(/^file:/, lf.protocol) === lf.href) {
+        skipDivergence(tc, "limit/ada-file-localhost-keeps-scheme");
+      }
+      const known = knownOracleDivergence(nf, lf);
+      if (known) skipDivergence(tc, known);
+      fail(`${show(start)} then ${attr} = ${show(value)} (step ${i + 1}${i ? ", after " + steps.slice(0, i).map((s) => `${s.attr} = ${show(s.value)}`).join(", ") : ""}): ${diff.map((f) => `${f}: whatwg-url ${show(lf[f])}, Node ${show(nf[f])}`).join("; ")}`);
+    }
+  }
+});
+
+// URLSearchParams: the same operations on the same input give the same list, string and
+// answers, and the params reflect into the URL and back as Node's do.
+function snapshot(sp) {
+  return { list: [...sp].map(([k, v]) => [k, v]), text: String(sp), size: sp.size };
+}
+
+property("TestHegelSearchParamsAgreeWithNode", (tc) => {
+  const { params: { init, kind }, ops, href, name0, del, sort, newSearch } = tc.draw(searchParamsCase);
+  count(`init/${kind}`);
+  const make = (Ctor) => (init === undefined ? new Ctor() : new Ctor(kind === "pairs" ? init.map((p) => [...p]) : kind === "record" ? { ...init } : init));
+  let node;
+  let lib;
+  try { node = make(URLSearchParams); } catch (e) { node = e.message; }
+  try { lib = make(W.URLSearchParams); } catch (e) { lib = e.message; }
+  if ((typeof node === "string") !== (typeof lib === "string")) fail(`new URLSearchParams(${show(init)}): Node ${typeof node === "string" ? "throws " + node : "accepts"}, whatwg-url ${typeof lib === "string" ? "throws " + lib : "accepts"}`);
+  if (typeof node === "string") return; // both throw: nothing more to compare
+  const check = (what) => {
+    const a = snapshot(node);
+    const b = snapshot(lib);
+    if (show(a) !== show(b)) fail(`after ${what} on ${show(init)}: whatwg-url ${show(b)}, Node ${show(a)}`);
+  };
