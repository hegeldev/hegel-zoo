+/** `s` with `piece` inserted at position `at` modulo the length (an empty string is left alone). */
+function insert(s, { at, text }) {
+  if (!s.length) return s;
+  const i = at % (s.length + 1);
+  return s.slice(0, i) + text + s.slice(i);
