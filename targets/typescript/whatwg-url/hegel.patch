+  .record({ labels: gs.arrays(label, { minSize: 1, maxSize: 4 }), dot: labelDot, trailingDot: chance(8), leadingDot: chance(5) })
+  .map(({ labels, dot, trailingDot, leadingDot }) => {
+    const h = (leadingDot ? "." : "") + labels.join(dot) + (trailingDot ? "." : "");
+    return { h, kind: /^[\x00-\x7f]*$/.test(h) ? "domain" : "domain-unicode" };
+  });
+
+const octet = ints(0, 255);
+const hex = (x) => x.toString(16);
+const quad = dotted(octet, octet, octet, octet);
+/** An IPv4 address in every notation the standard accepts or rejects. */
+const ipv4ish = gs.oneOf(
+  quad,
+  dotted(octet, octet, ints(0, 70000)),
+  dotted(octet, ints(0, 20000000)),
+  ints(0, 4294967295).map(String),
+  ints(4294967296, 5000000000).map(String),
+  ints(0, 0xffffffff).map((x) => `0x${hex(x)}`),
+  fixed(octet, 4).map(([a, b, c, d]) => `0x${hex(a)}.${b}.${c}.0X${hex(d)}`),
+  fixed(octet, 4).map(([a, b, c, d]) => `0${a.toString(8)}.0${b.toString(8)}.${c}.${d}`),
