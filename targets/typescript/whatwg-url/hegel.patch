+/** `s` decorated. */
+export function decorate(s, { lead, trail, inner, hostile }) {
+  if (lead !== undefined) s = lead + s;
+  if (trail !== undefined) s += trail;
+  if (inner !== undefined) s = insert(s, inner);
+  if (hostile !== undefined) s = insert(s, hostile);
+  return s;
