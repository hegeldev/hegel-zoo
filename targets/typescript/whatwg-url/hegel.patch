+  trail: maybe(10, gs.sampledFrom([" ", "\t", "\n", "\r", "\u0000", "\u001f", " \n"])),
+  inner: maybe(10, gs.record({ at, text: gs.sampledFrom(["\t", "\n", "\r", "\t\n"]) })),
