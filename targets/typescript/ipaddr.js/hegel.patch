+# Hegel zoo: the Python `ipaddress` / `socket.inet_aton` oracle for ipaddr.js. Reads one JSON
+# request per line from the request FIFO and writes one JSON answer per line to the response
+# FIFO (see hegel/ip.mjs).
+#
+#   {"op": "v6", "text": s}     -> {"ok": true, "bytes": [16 ints], "str": compressed, "exploded": e,
+#                                   "zone": scope id or null} or {"ok": false, "error": msg}
+#   {"op": "v4", "text": s}     -> {"strict": {"ok", "bytes"|"error"}, "aton": {"ok", "bytes"|"error"}}
+#                                  (ipaddress.IPv4Address, and glibc inet_aton for the loose forms)
+#   {"op": "cidr", "text": s}   -> {"ok": true, "network": [bytes], "broadcast": [bytes], "netmask": [bytes],
+#                                   "prefix": n, "kind": 4|6} or {"ok": false, "error": msg}
+#                                  (ipaddress.ip_interface: the host bits are kept and masked)
+#   {"op": "contains", "addr": s, "net": s} -> {"ok": true, "in": bool}
+#   {"op": "mask", "bytes": [..]} -> {"prefix": n or null}   (a valid netmask's prefix length)
+#   {"op": "range", "addr": s, "table": [[name, "net/bits"], ...]} -> {"name": first match or null}
+
+import ipaddress
+import json
+import re
+import socket
+import sys
+
+
+def b(addr):
+    return list(addr.packed)
+
+
+ZONE = re.compile(r"^[0-9A-Za-z]+$")
+
+
+def v6(text):
+    # this Python rejects zone ids in IPv6Address: split them here (RFC 4007 <addr>%<zone>, the
+    # zone taken as ipaddr.js documents it: letters and digits)
+    zone = None
+    if "%" in text:
+        text, _, zone = text.partition("%")
+        if not ZONE.match(zone):
+            return {"ok": False, "error": "bad zone id %r" % zone}
+    try:
+        a = ipaddress.IPv6Address(text)
+    except Exception as e:
+        return {"ok": False, "error": str(e)}
+    return {"ok": True, "bytes": b(a), "str": str(a), "exploded": a.exploded, "zone": zone}
+
+
+def v4(text):
+    out = {}
+    try:
+        a = ipaddress.IPv4Address(text)
+        out["strict"] = {"ok": True, "bytes": b(a)}
+    except Exception as e:
+        out["strict"] = {"ok": False, "error": str(e)}
+    try:
+        out["aton"] = {"ok": True, "bytes": list(socket.inet_aton(text))}
+    except Exception as e:
+        out["aton"] = {"ok": False, "error": str(e)}
+    return out
+
+
+def cidr(text):
+    try:
+        i = ipaddress.ip_interface(text)
+    except Exception as e:
+        return {"ok": False, "error": str(e)}
+    n = i.network
+    return {"ok": True, "network": b(n.network_address), "broadcast": b(n.broadcast_address),
+            "netmask": b(n.netmask), "prefix": n.prefixlen, "kind": i.version, "host": b(i.ip)}
+
+
+def contains(addr, net):
+    try:
+        a = ipaddress.ip_address(addr)
+        n = ipaddress.ip_network(net, strict=False)
+    except Exception as e:
+        return {"ok": False, "error": str(e)}
+    if a.version != n.version:
+        return {"ok": True, "in": False}
+    return {"ok": True, "in": a in n}
+
+
+def mask(bs):
+    bits = "".join(format(x, "08b") for x in bs)
+    ones = len(bits) - len(bits.lstrip("1"))
+    if bits[ones:].strip("0") == "":
+        return {"prefix": ones}
+    return {"prefix": None}
+
+
+def rng(addr, table):
+    a = ipaddress.ip_address(addr)
+    for name, net in table:
+        n = ipaddress.ip_network(net, strict=False)
+        if n.version == a.version and a in n:
+            return {"name": name}
+    return {"name": None}
+
+
+def main(req_path, resp_path):
+    req = open(req_path, "r", encoding="utf-8", errors="surrogatepass")
+    resp = open(resp_path, "w", encoding="utf-8", errors="surrogatepass")
+    for line in req:
+        try:
+            q = json.loads(line)
+            op = q["op"]
+            if op == "v6":
+                a = v6(q["text"])
+            elif op == "v4":
+                a = v4(q["text"])
+            elif op == "cidr":
+                a = cidr(q["text"])
+            elif op == "contains":
+                a = contains(q["addr"], q["net"])
+            elif op == "mask":
+                a = mask(q["bytes"])
+            elif op == "range":
+                a = rng(q["addr"], q["table"])
+            else:
+                a = {"ok": False, "error": "unknown op %r" % op}
+        except Exception as e:  # never let the oracle die on one request
+            a = {"ok": False, "error": "oracle: %s: %s" % (type(e).__name__, e)}
+        resp.write(json.dumps(a, ensure_ascii=True) + "\n")
+        resp.flush()
+
+
+if __name__ == "__main__":
+    main(sys.argv[1], sys.argv[2])
