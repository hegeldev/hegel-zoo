index 0000000..3ff295f
--- /dev/null
+++ b/hegel/ip.mjs
@@ -0,0 +1,80 @@
+// Hegel zoo: the Python ipaddress oracle bridge, the library under test, and the two model
+// helpers the properties share (parts to bytes, the SpecialRanges table as CIDR strings). The
+// generators are in gen.mjs.
+
+import { execFileSync, spawn } from "node:child_process";
+import { mkdtempSync, openSync, readSync, rmSync, writeSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { dirname, join } from "node:path";
+import { fileURLToPath } from "node:url";
+
+const here = dirname(fileURLToPath(import.meta.url));
+
+// The library under test: the ES module.
+export const ipaddr = await import("../lib/ipaddr.js");
+export const { IPv4, IPv6 } = ipaddr;
+
+// ---------------------------------------------------------------- the oracle, held open
+
+let oracle = null;
+
+function startOracle() {
+  execFileSync("python3", ["-c", "import ipaddress"], { stdio: "ignore" });
+  const dir = mkdtempSync(join(tmpdir(), "hegel-ip-"));
+  const req = join(dir, "req");
+  const resp = join(dir, "resp");
+  execFileSync("mkfifo", [req, resp]);
+  const child = spawn("python3", ["-u", join(here, "oracle.py"), req, resp], {
+    stdio: ["ignore", "inherit", "inherit"],
+  });
+  child.unref();
+  const wfd = openSync(req, "w");
+  const rfd = openSync(resp, "r");
+  process.on("exit", () => {
+    try { child.kill(); } catch {}
+    try { rmSync(dir, { recursive: true, force: true }); } catch {}
+  });
+  const buf = Buffer.alloc(1 << 16);
+  let pending = "";
+  return {
+    call(obj) {
+      const line = JSON.stringify(obj).replace(/[\ud800-\udfff]/g, (c) => "\\u" + c.charCodeAt(0).toString(16).padStart(4, "0"));
+      writeSync(wfd, line + "\n");
+      for (;;) {
+        const nl = pending.indexOf("\n");
+        if (nl !== -1) {
+          const answer = pending.slice(0, nl);
+          pending = pending.slice(nl + 1);
+          return JSON.parse(answer);
+        }
+        const got = readSync(rfd, buf, 0, buf.length, null);
+        if (got === 0) throw new Error("the ipaddress oracle went away");
+        pending += buf.toString("utf8", 0, got);
+      }
+    },
+  };
+}
+
+export function py(obj) {
+  oracle ??= startOracle();
+  return oracle.call(obj);
+}
+
+// ---------------------------------------------------------------- model helpers
+
+/** The 16 bytes of 8 16-bit parts. */
+export function partsToBytes(parts) {
+  const out = [];
+  for (const p of parts) out.push(p >> 8, p & 0xff);
+  return out;
+}
+
+/** ipaddr.js's SpecialRanges as [[name, "addr/bits"], ...] in the object order it walks. */
+export function rangeTable(cls) {
+  const out = [];
+  for (const [name, entry] of Object.entries(cls.SpecialRanges)) {
+    const subnets = entry[0] && !Array.isArray(entry[0]) ? [entry] : entry;
+    for (const [addr, bits] of subnets) out.push([name, `${addr.toString()}/${bits}`]);
+  }
+  return out;
+}
