+++ b/hegel/known.mjs
@@ -0,0 +1,169 @@
+// Hegel zoo: the recorded bugs of jsonrepair (bugs.toml), as gates. `known(where, ctx)` returns
+// the bug id when a case has the shape of a recorded bug, so it is counted rather than judged;
+// ZOO_NO_KNOWN=1 lifts the gates.
+
+const lifted = !!process.env.ZOO_NO_KNOWN;
+
+const SPECIAL_WS = "[ ᠎ -​  　﻿]";
+const WS_ANY = "[ \\t\\r\\n ᠎ -​  　﻿]";  // regular or special whitespace
+const CALL = /[A-Za-z_$][A-Za-z0-9_$]*[ \t\r\n]*\(/;
+
+function occurrences(s, ch) {
+  let k = 0;
+  for (const c of s) if (c === ch) k++;
+  return k;
+}
+
+function unbalanced(s, open, close) {
+  return typeof s === "string" && occurrences(s, open) > occurrences(s, close);
+}
+
+/** jsonrepair/1: a container whose last string holds an unmatched bracket of the container's kind. */
+function lastStringUnbalanced(v) {
+  if (Array.isArray(v)) {
+    if (v.length > 0 && unbalanced(v.at(-1), "[", "]")) return true;
+    return v.some(lastStringUnbalanced);
+  }
+  if (v !== null && typeof v === "object") {
+    const keys = Object.keys(v);
+    if (keys.length > 0 && unbalanced(v[keys.at(-1)], "{", "}")) return true;
+    return keys.some((k) => lastStringUnbalanced(v[k]));
+  }
+  return false;
+}
+
+function anyString(v, pred) {
+  if (typeof v === "string") return pred(v);
+  if (Array.isArray(v)) return v.some((x) => anyString(x, pred));
+  if (v !== null && typeof v === "object") return Object.keys(v).some((k) => pred(k) || anyString(v[k], pred));
+  return false;
+}
+
+/** Whitespace before a closing quote (raw or escaped) and after one removed, for jsonrepair/6. */
+function normUnquotedWs(out) {
+  return out.replace(/\\[tnr]|[ \t\r\n]/g, "").replace(/"undefined"/g, "null");
+}
+
+const MISSING_COLON_WORD = new RegExp(`["'“”‘’\`´;]${WS_ANY}+(true|false|null|True|False|None|undefined|-|[A-Za-z_$])`);
+const WS = "[ \\t\\r\\n" + SPECIAL_WS.slice(1);
+const ELLIPSIS_COMMA_WS = new RegExp(`\\.\\.\\.${WS}*,${WS}`);
+
+/** The text without its comments (a comment counts as whitespace for the gates). */
+function uncommented(text) {
+  return text.replace(/\/\*[\s\S]*?\*\//g, " ").replace(/\/\/[^\n]*/g, " ");
+}
+const ADJACENT_COMMENTS = /\*\/\/[/*]/;
+const SLASH_COMMENT = /\/\*\//;
+const NDJSON_ENTITY_START = /\n[ \t\r\n]*&(quot|#34|#x22);/i;
+
+function isJSON(s) {
+  try {
+    JSON.parse(s);
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+function streamingGate(text, r, s) {
+  // jsonrepair/12: two comments without whitespace between them
+  if (ADJACENT_COMMENTS.test(text)) return "jsonrepair/12";
+  // jsonrepair/17: a block comment whose body starts with a slash (regular gives strings, streaming throws)
+  if (SLASH_COMMENT.test(text)) return "jsonrepair/17";
+  // jsonrepair/20: a colon inside an array (regular turns the rest of the element into a string, streaming throws)
+  if (r.out !== undefined && s.error && /^Unexpected character ":"/.test(s.error.message)) return "jsonrepair/20";
+  // jsonrepair/21: the streaming implementation loses the comma it inserts before an object that then needs a
+  // repair itself ({{ after a value or a newline-delimited document): the outputs are equal up to commas
+  if (/\n[ \t\r]*\{[ \t\r\n]*\{/.test(text)) return "jsonrepair/21";
+  if (r.out !== undefined && s.out !== undefined && !isJSON(s.out) && r.out.replace(/,/g, "") === s.out.replace(/,/g, "")) return "jsonrepair/21";
+  // jsonrepair/7 again: any other character the regular implementation reads as an unquoted string after a value
+  // ([0(], [1 ;x]) where the streaming one throws
+  if (r.out !== undefined && s.error && /^Unexpected character/.test(s.error.message)) return "jsonrepair/7";
+  // jsonrepair/9 (and 13): the two implementations handle a call shape - an identifier followed by "(" - differently
+  // wherever it appears (empty or truncated output, {a(a read as a call by one and as a key by the other, ...)
+  if (CALL.test(text)) return "jsonrepair/9";
+  // jsonrepair/4: streaming rejects newline-delimited JSON followed by a redundant closing bracket
+  if (r.out !== undefined && s.error && /^Unexpected end/.test(s.error.message) && r.out.startsWith("[\n")) return "jsonrepair/4";
+  // jsonrepair/5: repeated commas are repaired differently
+  if (/,[ \t\r\n]*,/.test(text)) return "jsonrepair/5";
+  // jsonrepair/6: streaming keeps the trailing whitespace of an unquoted string
+  if (r.out !== undefined && s.out !== undefined && normUnquotedWs(r.out) === normUnquotedWs(s.out)) return "jsonrepair/6";
+  // jsonrepair/7: a missing comma before something that does not start like a value (an ellipsis, punctuation)
+  if (/(^|[^,\[{ \t\r\n])[ \t\r\n]*\.\.\./.test(text) || /[ \t\r\n][^ \t\r\n,\[\]{}:"'\w\-\/&“”‘’`´.]/.test(text)) return "jsonrepair/7";
+  // jsonrepair/7 again: a missing comma before a regular-expression literal ([1/x/]): regular repairs, streaming throws
+  if (r.out !== undefined && s.error && /^Unexpected character "\/"/.test(s.error.message)) return "jsonrepair/7";
+  // jsonrepair/14: streaming fails on a leading comma followed by an ellipsis
+  if (/[\[{][ \t\r\n]*,[ \t\r\n]*\.\.\./.test(text)) return "jsonrepair/14";
+  // jsonrepair/2: the regular implementation mishandles an ellipsis followed by a comma and whitespace in an object
+  // (Object key expected, or the whitespace swallowed into the next key: {..., a: 1} gives {" a": 1})
+  if (/\{/.test(text) && ELLIPSIS_COMMA_WS.test(uncommented(text))) return "jsonrepair/2";
+  return "";
+}
+
+export function known(where, ctx) {
+  if (lifted) return "";
+  // jsonrepair/22: the streaming implementation never returns (an array after a property value, {"a":1 [1]});
+  // the guarded drivers report it as a verdict after their watchdog fires
+  if (ctx.streaming && ctx.streaming.hang) return "jsonrepair/22";
+  if (where === "invalid-output") {
+    // jsonrepair/15: a backslash before a raw control character leaves the raw character in the output
+    if (/\\[\r\t\b\f]/.test(ctx.text)) return "jsonrepair/15";
+    // jsonrepair/19: in a single-quoted string an escaped backslash followed by a double quote leaves the quote unescaped
+    if (/\\\\"/.test(ctx.text)) return "jsonrepair/19";
+    // jsonrepair/9: a function call without a parsable argument gives an empty output
+    if (CALL.test(ctx.text) && ctx.out === "") return "jsonrepair/9";
+  }
+  if (where === "valid") {
+    if (lastStringUnbalanced(ctx.value)) return "jsonrepair/1";
+  }
+  if (where === "not-idempotent") {
+    // jsonrepair/1: the (valid) output's last string in a container holds an unmatched bracket
+    try {
+      if (lastStringUnbalanced(JSON.parse(ctx.out))) return "jsonrepair/1";
+    } catch {
+      // the output was checked to be valid JSON before
+    }
+    if (SLASH_COMMENT.test(ctx.text)) return "jsonrepair/17";
+  }
+  if (where === "repair-error" || where === "repair-value") {
+    if (lastStringUnbalanced(ctx.expect)) return "jsonrepair/1";
+    if (ctx.flags.mongo && anyString(ctx.expect, (s) => unbalanced(s, "(", ")"))) return "jsonrepair/1";
+    if (/\{/.test(ctx.text) && ELLIPSIS_COMMA_WS.test(uncommented(ctx.text))) return "jsonrepair/2";
+    if (new RegExp(`[0-9.A-Za-z_$]${WS_ANY}*${SPECIAL_WS}`).test(ctx.text)) return "jsonrepair/3";
+    // jsonrepair/13: an unquoted string inside a function call swallows the closing parenthesis
+    if (ctx.shape === "jsonp" && ctx.unquotedBody) return "jsonrepair/13";
+    // jsonrepair/17: a block comment whose body starts with a slash is closed at its opening asterisk
+    if (ctx.flags.comments && SLASH_COMMENT.test(ctx.text)) return "jsonrepair/17";
+    // jsonrepair/18: in newline-delimited JSON a document starting with an entity quote is not recognised
+    if (ctx.shape.startsWith("ndjson") && NDJSON_ENTITY_START.test(ctx.text)) return "jsonrepair/18";
+    // jsonrepair/16: inside a string with entity or special quotes, an embedded quote followed by a backslash ends the string
+    if ((ctx.flags.entityQuotes || ctx.flags.specialQuotes) && /["“”'‘’`´]\\/.test(ctx.text)) return "jsonrepair/16";
+    // jsonrepair/11: a missing colon before a keyword, an unquoted string or a negative number, with another property after it
+    // (uncommented() is naive about comment markers inside strings, so the raw text is tried too)
+    if (ctx.flags.missingColon && (MISSING_COLON_WORD.test(ctx.text) || MISSING_COLON_WORD.test(uncommented(ctx.text)))) return "jsonrepair/11";
+    if (ctx.flags.comments && ADJACENT_COMMENTS.test(ctx.text)) return "jsonrepair/12";
+  }
+  if (where === "streaming" || where === "small-buffer") {
+    return streamingGate(ctx.text, ctx.regular, ctx.streaming);
+  }
+  if (where === "finite-buffer") {
+    // jsonrepair/10: whitespace and the token after it are read in one step, one character past the token
+    if (ctx.bufferSize <= ctx.longestStep + 1) return "jsonrepair/10";
+    return streamingGate(ctx.text, ctx.regular, ctx.streaming);
+  }
+  if (where === "transform") {
+    if (ctx.asBuffers) {
+      const dec = new TextDecoder("utf-8", { fatal: true });
+      for (const c of ctx.chunks) {
+        try {
+          dec.decode(c);
+        } catch {
+          // jsonrepair/8: Buffer chunks are decoded one by one, so a multibyte character split across chunks is lost
+          return "jsonrepair/8";
+        }
+      }
+    }
+    return streamingGate(ctx.text, ctx.regular, ctx.transform);
+  }
+  return "";
+}
diff --git a/hegel/stream-worker.mjs b/hegel/stream-worker.mjs
new file mode 100644
index 0000000..eca665c
--- /dev/null
+++ b/hegel/stream-worker.mjs
@@ -0,0 +1,22 @@
+// Worker thread that runs the streaming implementation (core or Node Transform) on request, so the
+// main thread can wait with a timeout and report a hang as a verdict (jsonrepair/22): a synchronous
+// infinite loop cannot be interrupted in the thread that runs it. See streamingGuarded in jr.mjs.
+import { workerData } from "node:worker_threads";
+import { streaming, transformed } from "./jr.mjs";
+
+const { port, sab } = workerData;
+const flag = new Int32Array(sab);
+
+port.on("message", async ({ kind, chunks, options }) => {
+  const cs = chunks.map((c) => (typeof c === "string" ? c : Buffer.from(c.buffer, c.byteOffset, c.byteLength)));
+  const opts = options === undefined ? undefined : { ...options, bufferSize: options.bufferSize === null ? Number.POSITIVE_INFINITY : options.bufferSize };
+  let result;
+  try {
+    result = kind === "transform" ? await transformed(cs, opts) : streaming(cs, opts);
+  } catch (e) {
+    result = { error: { name: e.constructor.name, message: e.message, position: e.position } };
+  }
+  port.postMessage(result);
+  Atomics.store(flag, 0, 1);
+  Atomics.notify(flag, 0);
+});
