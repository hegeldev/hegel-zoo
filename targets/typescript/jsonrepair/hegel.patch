+    const m = text.match(/[\]}]+$/);
+    const drop = n(tc, 1, m[0].length);
+    shape = "dropped-closers";
+    text = text.slice(0, text.length - drop);
+  } else if (escapable) {
+    shape = "escaped";
+    text = JSON.stringify(text).slice(1, -1);
+  } else if (wrapper === 5 && !body.unquoted) {
+    shape = "ndjson";
+    const docs = [body];
+    const values = [v];
+    const k = n(tc, 1, 3);
+    for (let i = 0; i < k; i++) {
+      const w = genValue(tc, 2);
+      values.push(w);
+      docs.push(corrupt(tc, f, w));
+    }
+    text = docs.map((d) => d.text).join(pick(tc, ["\n", "\r\n", "\n\n", ",\n"]));
+    if (f.trailingCommas && chance(tc, 30)) text += ",";
+    if (docs.some((d) => d.unquoted)) shape = "ndjson-unquoted";
+    expect = values;
+  }
+  count(`shape-${shape}`);
+  return { text, expect, shape, unquotedBody: body.unquoted };
+}
+
+// ---------------------------------------------------------------- mutations and random text
+
+/** Mutate a text a few times: delete, insert, replace, duplicate, truncate, swap quotes. */
+export function mutate(tc, text) {
+  const times = n(tc, 1, 3);
+  let s = text;
+  for (let t = 0; t < times; t++) {
+    const k = n(tc, 0, 6);
+    const i = s.length ? n(tc, 0, s.length - 1) : 0;
+    if (k === 0 && s.length) s = s.slice(0, i) + s.slice(i + 1);
+    else if (k === 1) s = s.slice(0, i) + pick(tc, JSONISH) + s.slice(i);
+    else if (k === 2 && s.length) s = s.slice(0, i) + pick(tc, JSONISH) + s.slice(i + 1);
+    else if (k === 3 && s.length) s = s.slice(0, i) + s.slice(i, i + n(tc, 1, 4)) + s.slice(i);
+    else if (k === 4) s = s.slice(0, n(tc, 0, s.length));
+    else if (k === 5) s = s.replace(/"/g, () => pick(tc, QUOTES));
+    else s = s.slice(0, i) + pick(tc, WORDS) + s.slice(i);
+  }
+  return s;
+}
+
+/** Random JSON-ish text. */
+export function randomText(tc) {
+  return word(tc, JSONISH, 0, 40);
+}
+
+// ---------------------------------------------------------------- running the implementations
+
+/** jsonrepair's verdict: { out } or { error: { name, message, position } }. */
+export function regular(text) {
+  trace("regular", { text });
+  try {
+    return { out: jsonrepair(text) };
+  } catch (e) {
+    if (e instanceof JSONRepairError) return { error: { name: "JSONRepairError", message: e.message, position: e.position } };
+    return { error: { name: e.constructor.name, message: e.message, position: e.position } };
+  }
+}
+
+/** The streaming core's verdict on the same text fed in `chunks` with the given buffer options. */
+export function streaming(chunks, options) {
+  const parts = [];
+  trace("streaming", { chunks, options: options && { bufferSize: String(options.bufferSize), chunkSize: options.chunkSize } });
+  try {
+    const core = jsonrepairCore({ ...options, onData: (c) => parts.push(c) });
+    for (const c of chunks) core.transform(c);
+    core.flush();
+    return { out: parts.join("") };
+  } catch (e) {
+    if (e instanceof JSONRepairError) return { error: { name: "JSONRepairError", message: e.message, position: e.position } };
+    return { error: { name: e.constructor.name, message: e.message, position: e.position } };
+  }
+}
+
+/** The Node Transform's verdict on `chunks` (strings or Buffers). */
+export async function transformed(chunks, options) {
+  const parts = [];
+  let error = null;
+  const t = jsonrepairTransform(options);
+  t.on("error", (e) => { if (!error) error = e; });
+  // a pipeline that never settles would hang the whole run: report it as an error instead
+  let timer;
+  const timeout = new Promise((_, reject) => { timer = setTimeout(() => reject(new Error("the Transform pipeline did not settle in 20 s")), 20000); });
+  try {
+    await Promise.race([pipeline(Readable.from(chunks, { objectMode: true }), t, new Writable({
+      write(chunk, _enc, cb) { parts.push(chunk.toString()); cb(); },
+    })), timeout]);
+  } catch (e) {
+    if (!error) error = e;
+  } finally {
+    clearTimeout(timer);
+  }
+  if (error) {
+    const e = error;
+    return { error: { name: e instanceof JSONRepairError ? "JSONRepairError" : e.constructor.name, message: e.message, position: e.position } };
+  }
+  return { out: parts.join("") };
+}
+
+// The streaming implementation can loop forever (jsonrepair/22). The guarded drivers run it in a
+// worker thread and wait with a watchdog; a verdict { hang: true } comes back after `ms`
+// milliseconds, the worker is killed and a fresh one is started for the next call.
+let worker = null;
+let workerPort = null;
+let workerFlag = null;
+function spawnWorker() {
+  const { port1, port2 } = new MessageChannel();
+  const sab = new SharedArrayBuffer(4);
+  workerFlag = new Int32Array(sab);
+  workerPort = port1;
+  worker = new Worker(new URL("./stream-worker.mjs", import.meta.url), { workerData: { port: port2, sab }, transferList: [port2] });
+  worker.unref();
+}
+export function stopWorker() {
+  if (worker) { worker.terminate(); worker = null; }
+}
+function guarded(kind, chunks, options, ms) {
+  if (!worker) spawnWorker();
+  Atomics.store(workerFlag, 0, 0);
+  const opts = options === undefined ? undefined : { ...options, bufferSize: options.bufferSize === Number.POSITIVE_INFINITY ? null : options.bufferSize };
+  workerPort.postMessage({ kind, chunks, options: opts });
+  const w = Atomics.wait(workerFlag, 0, 0, ms);
+  if (w === "timed-out") {
+    stopWorker();
+    return { hang: true, ms };
+  }
+  return receiveMessageOnPort(workerPort).message;
+}
+/** The streaming core's verdict, or { hang: true } when it does not return within `ms`. */
+export function streamingGuarded(chunks, options, ms = 5000) {
+  return guarded("core", chunks, options, ms);
+}
+/** The Node Transform's verdict, or { hang: true } when it does not settle within `ms`. */
+export function transformedGuarded(chunks, options, ms = 5000) {
+  return guarded("transform", chunks, options, ms);
+}
+
+/** Split text into random chunks at code-point boundaries (never inside a surrogate pair). */
+export function chunk(tc, text) {
+  const chunks = [];
+  let i = 0;
+  while (i < text.length) {
+    let len = n(tc, 1, Math.max(1, Math.min(text.length - i, chance(tc, 50) ? 3 : 12)));
+    let end = i + len;
+    if (end < text.length && /[\ud800-\udbff]/.test(text[end - 1]) && /[\udc00-\udfff]/.test(text[end])) end++;
+    chunks.push(text.slice(i, end));
+    i = end;
+  }
+  if (chance(tc, 20)) chunks.push("");
+  return chunks;
+}
+
+/** The longest token of a valid JSON text (string literal, whitespace run, number, keyword), for buffer sizing. */
+export function longestToken(text) {
+  let max = 0;
+  const re = /"(?:[^"\\]|\\.)*"|[ \t\n\r]+|-?\d+(?:\.\d+)?(?:[eE][+-]?\d+)?|true|false|null|[\[\]{}:,]/g;
+  let m;
+  while ((m = re.exec(text)) !== null) max = Math.max(max, m[0].length);
+  return max;
+}
+
+/** The longest parsing step of a valid JSON text: a token together with the whitespace runs before
+ * and after it (the streaming parser reads whitespace, a token and the whitespace after it in one
+ * step, then peeks one character further). */
+export function longestStep(text) {
+  const parts = text.match(/[ \t\n\r]+|"(?:[^"\\]|\\.)*"|-?\d+(?:\.\d+)?(?:[eE][+-]?\d+)?|true|false|null|[\[\]{}:,]/g) || [];
+  let max = 0;
+  for (let i = 0; i < parts.length; i++) {
+    if (/^[ \t\n\r]/.test(parts[i])) continue;
+    const before = i > 0 && /^[ \t\n\r]/.test(parts[i - 1]) ? parts[i - 1].length : 0;
+    const after = i + 1 < parts.length && /^[ \t\n\r]/.test(parts[i + 1]) ? parts[i + 1].length : 0;
+    max = Math.max(max, before + parts[i].length + after);
+  }
+  return max;
+}
+
+/** Same verdicts? Errors compare by name and message (positions are compared by the caller). */
+export function sameVerdict(a, b) {
+  if (a.hang || b.hang) return false;
+  if (a.out !== undefined || b.out !== undefined) return a.out === b.out;
+  return a.error.name === b.error.name && a.error.message === b.error.message;
+}
+
+export function showVerdict(v) {
+  if (v.hang) return `HANG (did not return in ${v.ms} ms)`;
+  return v.out !== undefined ? `out ${JSON.stringify(v.out)}` : `${v.error.name}: ${v.error.message} @${v.error.position}`;
+}
