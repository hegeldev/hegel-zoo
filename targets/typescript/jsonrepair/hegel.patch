+  texts[at] = `${blanks(tc)}undefined${blanks(tc)}:${blanks(tc)}${JSON.stringify(values[at])}`;
+  const expect = asObject(values);
+  delete expect[`k${at}`];
+  expect.undefined = values[at];
+  checkRepairedValue(`{${texts.join(`,${blanks(tc)}`)}}`, expect, "an unquoted key undefined");
+}, KNOWN);
+
+// jsonrepair/25: a string in HTML-entity quotes holding a numeric entity (decimal or hexadecimal) for a
+// control character among plain content, at the root or among plain values
+property("TestHegelEntityEncodedControlCharactersAreEscaped", (tc) => {
+  const code = n(tc, 0, 0x1f);
+  const entity = chance(tc, 50) ? `&#x${code.toString(16)};` : `&#${code};`;
+  const quote = pick(tc, ["&quot;", "&#34;", "&#x22;"]);
+  const literal = `${quote}${plainString(tc)}${entity}${plainString(tc)}${quote}`;
+  const values = plainValues(tc, 0, 2).map((v) => JSON.stringify(v));
+  values.splice(n(tc, 0, values.length), 0, literal);
+  const text = chance(tc, 30) ? literal : `[${values.join(`,${blanks(tc)}`)}]`;
+  checkVerdict(tc, text, regular(text), "a numeric entity for a control character in an entity-quoted string");
+}, KNOWN);
+
+// jsonrepair/26: a JSON-stringified document (the Readme's escaped string) of plain values in which one
+// string value, or one key, is empty; with a space after its commas and colons or not
+property("TestHegelEscapedEmptyStringsInAStringifiedDocumentAreRepaired", (tc) => {
+  const isArray = chance(tc, 50);
+  const values = plainValues(tc, 1, 3).map(noEmptyStrings);
+  const at = n(tc, 0, values.length - 1);
+  values[at] = "";
+  const v = isArray ? values : asObject(values);
+  if (!isArray && chance(tc, 40)) {
+    delete v[`k${at}`];
+    v[""] = noEmptyStrings(plainValue(tc, 1));
+  }
+  const sp = pick(tc, ["", " "]);
+  const text = JSON.stringify(JSON.stringify(v).replace(/([,:])/g, `$1${sp}`)).slice(1, -1);
+  checkRepairedValue(text, v, "an escaped empty string in a JSON-stringified document");
+}, KNOWN);
+
+// jsonrepair/27: an object of plain values, one property (in any position) missing its colon before a
+// string value that starts with a bracket, a parenthesis, a comma, a slash or a plus
+property("TestHegelMissingColonsBeforeBracketStringsAreRepaired", (tc) => {
+  const values = plainValues(tc, 1, 4);
+  const at = n(tc, 0, values.length - 1);
+  values[at] = `${pick(tc, ["[", "]", "{", "}", "(", ")", ",", "/", "+"])}${plainString(tc)}`;
+  const texts = asProps(values, false);
+  texts[at] = `"k${at}"${word(tc, [" ", "\t"], 1, 2)}${JSON.stringify(values[at])}`;
+  const { text, expect } = container(values, false, texts, `,${blanks(tc)}`);
+  checkRepairedValue(text, expect, "a missing colon before a string starting with a bracket");
+}, KNOWN);
+
+// jsonrepair/28: a JSON-stringified document (an object of plain values) missing the comma after a
+// string-valued property that is not the last, with one or two spaces in its place
+property("TestHegelMissingCommasInAStringifiedDocumentAreInserted", (tc) => {
+  const values = plainValues(tc, 2, 4).map(noEmptyStrings);
+  const at = n(tc, 0, values.length - 2);
+  values[at] = plainString(tc, 1);
+  const sp = pick(tc, ["", " "]);
+  const props = asProps(values, false).map((p) => p.replace(":", `:${sp}`));
+  const doc = `{${props.map((p, i) => (i === 0 ? p : i === at + 1 ? `${" ".repeat(n(tc, 1, 2))}${p}` : `,${sp}${p}`)).join("")}}`;
+  checkRepairedValue(JSON.stringify(doc).slice(1, -1), asObject(values), "a missing comma in a JSON-stringified document");
+}, KNOWN);
+
+// jsonrepair/29: a block or line comment with a plain body before a fenced code block around a plain value
+property("TestHegelCommentsBeforeAMarkdownFenceAreStripped", (tc) => {
+  const v = plainValue(tc);
+  const text = `${comment(tc)}${chance(tc, 30) ? " " : ""}${pick(tc, ["```", "```json", "```JSON"])}\n${JSON.stringify(v)}\n\`\`\``;
+  checkRepairedValue(text, v, "a comment before a markdown fence");
+}, KNOWN);
+
+// jsonrepair/30: a container of plain values whose last item is a string followed by whitespace and an
+// ellipsis without a comma, with more text after the container: a newline-delimited number or keyword
+// document, the next property of the object it is the value of, or a later string item of the array it
+// is an item of (a bracket right after the container is read correctly)
+property("TestHegelEllipsisAfterAStringWithoutACommaIsSkipped", (tc) => {
+  const isArray = chance(tc, 50);
+  const values = [...plainValues(tc, 0, 2), plainString(tc)];
+  const texts = asProps(values, isArray);
+  texts[texts.length - 1] = `${texts.at(-1)}${word(tc, [" ", "\t"], 1, 2)}...${blanks(tc)}`;
+  const inner = container(values, isArray, texts, `,${blanks(tc)}`);
+  const k = n(tc, 0, 2);
+  if (k === 0) {
+    const doc = chance(tc, 50) ? pick(tc, [true, false, null]) : genNumber(tc);
+    checkRepairedValue(`${inner.text}${pick(tc, [",", ", ", ",\n", "\n", "\r\n"])}${JSON.stringify(doc)}`, [inner.expect, doc],
+      "an ellipsis after a string without a comma, followed by another document");
+  } else if (k === 1) {
+    const after = Array.from({ length: n(tc, 1, 2) }, () => plainValue(tc, 0));
+    const props = [`"a":${inner.text}`, ...after.map((x, i) => `"k${i}":${JSON.stringify(x)}`)];
+    checkRepairedValue(`{${props.join(`,${blanks(tc)}`)}}`, { a: inner.expect, ...asObject(after) },
+      "an ellipsis after a string without a comma, followed by another property");
+  } else {
+    const after = [...Array.from({ length: n(tc, 0, 2) }, () => plainValue(tc, 0)), plainString(tc)];
+    checkRepairedValue(`[${[inner.text, ...after.map((x) => JSON.stringify(x))].join(`,${blanks(tc)}`)}]`, [inner.expect, ...after],
+      "an ellipsis after a string without a comma, followed by a string item");
+  }
+}, KNOWN);
+
+// jsonrepair/31: a container of one-digit numbers (under one-letter keys) with a trailing comma followed
+// by a whitespace run, chunked small, and a buffer of the run's length plus one: too small for the run
+// (the Readme's condition), so an error is promised
+property("TestHegelTooSmallBuffersOnTrailingCommaWhitespaceFailLoudly", (tc) => {
+  const isArray = chance(tc, 50);
+  const values = Array.from({ length: n(tc, 1, 3) }, () => n(tc, 0, 9));
+  const texts = isArray ? values.map(String) : values.map((v, i) => `"${LETTERS[i]}":${v}`);
+  const run = word(tc, [" ", " ", "\t", "\n"], 2, 4);
+  const text = `${isArray ? "[" : "{"}${texts.join(",")},${run}${isArray ? "]" : "}"}`;
+  const bufferSize = run.length + 1;
+  const chunkSize = n(tc, 1, 3);
+  const chunks = [];
+  for (let i = 0; i < text.length; i += chunkSize) chunks.push(text.slice(i, i + chunkSize));
+  checkSmallBuffer(tc, text, bufferSize, chunkSize, chunks, regular(text), streamingGuarded(chunks, { bufferSize, chunkSize }));
+}, KNOWN);
+
+// ---------------------------------------------------------------- pins
+
+/** The streaming core on one text with an infinite buffer. */
+function core(text, options = { bufferSize: Number.POSITIVE_INFINITY, chunkSize: 65536 }, chunks = [text]) {
+  return streamingGuarded(chunks, options);
+}
+
+/** jsonrepair's output on text, which must be valid JSON. */
+function repairedValue(text) {
+  const out = jsonrepair(text);
+  return JSON.parse(out);
+}
+
+// jsonrepair/1: valid JSON whose last string in a container holds an unmatched bracket of the
+// container's kind is rejected or rewritten ("only count the brackets inside the string when
+// the quote is directly followed by a closing bracket").
+pin("TestHegelPinValidJSONWithABracketInItsLastStringIsUnchanged", () => {
+  assert.equal(jsonrepair('{"a":"{"}'), '{"a":"{"}');
+  assert.equal(jsonrepair('["["]'), '["["]');
+});
+
+// jsonrepair/2: an ellipsis in an object followed by a comma and whitespace.
+pin("TestHegelPinEllipsisFollowedByCommaAndSpaceInAnObject", () => {
+  assert.deepEqual(repairedValue('{..., "a": 1}'), { a: 1 });
+  assert.deepEqual(repairedValue('{"a": 1,\n..., "b": 2}'), { a: 1, b: 2 });
+});
+
+// jsonrepair/3: a number followed by a special whitespace character becomes a string.
+pin("TestHegelPinNumberBeforeSpecialWhitespaceStaysANumber", () => {
+  assert.deepEqual(repairedValue("[1 ,2]"), [1, 2]);
+  assert.deepEqual(repairedValue('{"a": 1　}'), { a: 1 });
+});
+
+// jsonrepair/4: newline-delimited JSON followed by a redundant closing bracket.
+pin("TestHegelPinStreamingAcceptsNDJSONWithARedundantBracket", () => {
+  const text = '{"a":1}\n{"b":2}]';
+  assert.deepEqual(core(text), regular(text));
+  assert.deepEqual(core("1\n2\n}"), regular("1\n2\n}"));
+});
+
+// jsonrepair/5: repeated commas.
+pin("TestHegelPinRepeatedCommasAreRepairedTheSameWay", () => {
+  assert.deepEqual(repairedValue("[1,,2]"), [1, 2]);
+  assert.deepEqual(core('{"a":1,,"b":2}'), regular('{"a":1,,"b":2}'));
+});
+
+// jsonrepair/6: trailing whitespace of an unquoted string.
+pin("TestHegelPinStreamingTrimsUnquotedStrings", () => {
+  assert.deepEqual(core("[a ,b]"), regular("[a ,b]"));
+  assert.deepEqual(core("[a\t]"), regular("[a\t]"));
+});
+
+// jsonrepair/7: a missing comma before something that does not start like a value.
+pin("TestHegelPinStreamingRepairsAMissingCommaBeforeAnyValue", () => {
+  assert.deepEqual(core("[1 ...]"), regular("[1 ...]"));
+  assert.deepEqual(core("[1 ;x]"), regular("[1 ;x]"));
+});
+
+// jsonrepair/13: an unquoted string inside a function call.
+pin("TestHegelPinUnquotedStringInsideAFunctionCall", () => {
+  assert.deepEqual(repairedValue("callback(undefined);"), null);
+  assert.deepEqual(repairedValue("f(abc)"), "abc");
+});
+
+// jsonrepair/14: a leading comma followed by an ellipsis, in the streaming implementation.
+pin("TestHegelPinStreamingStripsALeadingCommaBeforeAnEllipsis", () => {
+  assert.deepEqual(core("[[, ...], 1]"), regular("[[, ...], 1]"));
+  assert.deepEqual(core("[{, ...}, 1]"), regular("[{, ...}, 1]"));
+});
+
+// jsonrepair/8: Buffer chunks split inside a multibyte character.
+pin("TestHegelPinTransformDecodesMultibyteCharactersAcrossChunks", async () => {
+  const text = '["héllo"]';
+  const buf = Buffer.from(text, "utf8");
+  const t = transformedGuarded([buf.subarray(0, 4), buf.subarray(4)]);
+  assert.deepEqual(t, { out: text });
+});
+
+// jsonrepair/9: a function call without a parsable argument.
+pin("TestHegelPinFunctionCallWithoutAnArgumentGivesValidJSON", () => {
+  for (const text of ["f()", "f(}", "NumberLong()"]) {
+    let out;
+    try {
+      out = jsonrepair(text);
+    } catch (e) {
+      assert.ok(e instanceof JSONRepairError, `${show(text)}: ${e}`);
+      continue;
+    }
+    assert.doesNotThrow(() => JSON.parse(out), `jsonrepair(${show(text)}) = ${show(out)} is not valid JSON`);
+    assert.notEqual(JSON.parse(out), ")", `jsonrepair(${show(text)}) = ${show(out)} turned the closing parenthesis into a string`);
+  }
+  const s = core("o (}{  });");
+  assert.ok(s.error || parsed(s.out).value !== undefined, `streaming: ${showVerdict(s)}`);
+});
+
+// jsonrepair/11: a missing colon before a keyword is repaired only for the last property.
+pin("TestHegelPinMissingColonBeforeAKeywordIsRepairedInAnyProperty", () => {
+  assert.deepEqual(repairedValue('{"a" true}'), { a: true });
+  assert.deepEqual(repairedValue('{"a" true, "b": 1}'), { a: true, b: 1 });
+});
+
+// jsonrepair/12: two comments without whitespace between them.
+pin("TestHegelPinAdjacentCommentsAreBothStripped", () => {
+  assert.deepEqual(repairedValue('{"a":1/**//**/,"b":2}'), { a: 1, b: 2 });
+  assert.deepEqual(repairedValue('[1/**//**/,2]'), [1, 2]);
+});
+
+// jsonrepair/15: a backslash before a raw control character.
+pin("TestHegelPinEscapedRawControlCharacterGivesValidJSON", () => {
+  for (const text of ['"a\\\rb"', '"a\\\tb"']) {
+    const out = jsonrepair(text);
+    assert.doesNotThrow(() => JSON.parse(out), `jsonrepair(${show(text)}) = ${show(out)} is not valid JSON`);
+  }
+});
+
+// jsonrepair/16: an embedded quote followed by a backslash inside an entity-quoted string.
+pin("TestHegelPinEscapedQuoteAfterAQuoteInAnEntityQuotedString", () => {
+  // &quot;"\"b&quot; holds the value "\"b (two quotes and a b); &quot;"b&quot; and &quot;\"b&quot; are repaired
+  const text = '&quot;"\\"b&quot;';
+  let out;
+  assert.doesNotThrow(() => { out = jsonrepair(text); }, `jsonrepair(${show(text)}) throws`);
+  assert.strictEqual(typeof JSON.parse(out), "string", `jsonrepair(${show(text)}) = ${show(out)} is not a string`);
+});
+
+// jsonrepair/17: a block comment whose body starts with a slash.
+pin("TestHegelPinBlockCommentStartingWithASlashIsStripped", () => {
+  const text = "[1/*/x*/,0]";
+  assert.strictEqual(jsonrepair(text), "[1,0]", `jsonrepair(${show(text)})`);
+  const s = core(text, { bufferSize: Number.POSITIVE_INFINITY }, [text]);
+  assert.strictEqual(s.out, "[1,0]", `streaming on ${show(text)}: ${showVerdict(s)}`);
+});
+
+// jsonrepair/18: newline-delimited JSON whose next document starts with an entity quote.
+pin("TestHegelPinNDJSONDocumentStartingWithAnEntityQuoteIsAccepted", () => {
+  const text = "{}\n&quot;a&quot;";
+  let out;
+  assert.doesNotThrow(() => { out = jsonrepair(text); }, `jsonrepair(${show(text)}) throws`);
+  assert.deepStrictEqual(JSON.parse(out), [{}, "a"], `jsonrepair(${show(text)}) = ${show(out)}`);
+});
+
+// jsonrepair/19: an escaped backslash followed by a double quote in a single-quoted string.
+pin("TestHegelPinEscapedBackslashBeforeAQuoteInASingleQuotedString", () => {
+  const text = "'a\\\\\"b'";
+  const out = jsonrepair(text);
+  assert.doesNotThrow(() => JSON.parse(out), `jsonrepair(${show(text)}) = ${show(out)} is not valid JSON`);
+});
+
+// jsonrepair/20: a colon inside an array.
+pin("TestHegelPinColonInsideAnArrayIsRepairedTheSameWay", () => {
+  const text = "[1: 2]";
+  const r = regular(text);
+  const s = core(text, { bufferSize: Number.POSITIVE_INFINITY }, [text]);
+  assert.ok(sameVerdict(r, s), `regular ${showVerdict(r)} but streaming ${showVerdict(s)} on ${show(text)}`);
+});
+
+// jsonrepair/21: newline-delimited JSON whose next document starts with a doubled brace.
+pin("TestHegelPinStreamingKeepsTheCommaBeforeADoubledBraceDocument", () => {
+  const text = "{}\n{{}";
+  const s = core(text, { bufferSize: Number.POSITIVE_INFINITY }, [text]);
+  assert.ok(s.out !== undefined, `streaming on ${show(text)}: ${showVerdict(s)}`);
+  assert.doesNotThrow(() => JSON.parse(s.out), `streaming on ${show(text)} = ${show(s.out)} is not valid JSON`);
+});
+
+// jsonrepair/22: the streaming implementation never returns when an array follows a property value.
+// The worker-thread watchdog turns the hang into a verdict.
+pin("TestHegelPinStreamingTerminatesOnAnArrayAfterAPropertyValue", () => {
+  const text = '{"a":1 [1]}';
+  const s = core(text, { bufferSize: Number.POSITIVE_INFINITY }, [text]);
+  assert.ok(!s.hang, `jsonrepairCore on ${show(text)} did not return in ${s.ms} ms`);
+});
+
+// jsonrepair/10: a buffer larger than every string and whitespace run is documented to suffice.
+pin("TestHegelPinBufferLargerThanEveryStringAndWhitespaceRunSuffices", () => {
+  const text = '[1,     "abcdef", 2]'; // longest string 8, longest whitespace 5
+  const chunks = [];
+  for (let i = 0; i < text.length; i += 3) chunks.push(text.slice(i, i + 3));
+  assert.deepEqual(core(text, { bufferSize: 9, chunkSize: 3 }, chunks), { out: text });
+});
+
+// jsonrepair/23: the Transform pushes its output in pieces of chunkSize UTF-16 units, so a surrogate pair
+// split between two pieces becomes two replacement characters.
+pin("TestHegelPinTransformOutputKeepsSurrogatePairsTogether", () => {
+  const text = '"\u{1d6fc}"';
+  assert.deepEqual(transformedGuarded([text], { chunkSize: 1 }), { out: text });
+});
+
+// jsonrepair/24: an unquoted key undefined is written as the unquoted word null.
+pin("TestHegelPinUndefinedKeyIsQuoted", () => {
+  assert.deepEqual(repairedValue("{undefined:1}"), { undefined: 1 });
+});
+
+// jsonrepair/25: a numeric entity for a control character inside an entity-quoted string is decoded raw.
+pin("TestHegelPinEntityEncodedControlCharacterIsEscaped", () => {
+  const text = "&#34;a&#3;&#34;";
+  const out = jsonrepair(text);
+  assert.doesNotThrow(() => JSON.parse(out), `jsonrepair(${show(text)}) = ${show(out)} is not valid JSON`);
+});
+
+// jsonrepair/26: an escaped empty string in a JSON-stringified document.
+pin("TestHegelPinEscapedEmptyStringInAStringifiedDocument", () => {
+  assert.deepEqual(repairedValue('[\\"\\"]'), [""]);
+  assert.deepEqual(repairedValue('{\\"\\":null}'), { "": null });
+});
+
+// jsonrepair/27: a missing colon before a string value that starts with a bracket.
+pin("TestHegelPinMissingColonBeforeAStringStartingWithABracket", () => {
+  assert.deepEqual(repairedValue('{"a" "]"}'), { a: "]" });
+  assert.deepEqual(repairedValue('{"a" "[b"}'), { a: "[b" });
+});
+
+// jsonrepair/28: a missing comma between the properties of a JSON-stringified document.
+pin("TestHegelPinMissingCommaInAStringifiedDocument", () => {
+  assert.deepEqual(repairedValue('{\\"a\\":\\"b\\" \\"c\\":1}'), { a: "b", c: 1 });
+});
+
+// jsonrepair/29: a comment before a markdown fence.
+pin("TestHegelPinCommentBeforeAMarkdownFence", () => {
+  assert.deepEqual(repairedValue("/*c*/```json\n1\n```"), 1);
+  assert.deepEqual(repairedValue("//c\n```json\n1\n```"), 1);
+});
+
+// jsonrepair/30: a string followed by whitespace and an ellipsis without a comma, with text after the container.
+pin("TestHegelPinEllipsisAfterAStringWithoutAComma", () => {
+  assert.deepEqual(repairedValue('["a" ...],1'), [["a"], 1]);
+});
+
+// jsonrepair/31: a buffer too small for the whitespace around a trailing comma returns invalid output.
+pin("TestHegelPinTooSmallBufferOnATrailingCommaThrows", () => {
+  const text = "[1,2,  ]";
+  const s = core(text, { bufferSize: 3, chunkSize: 1 }, [...text]);
+  assert.ok(s.error || s.out === regular(text).out, `streaming with bufferSize 3, chunkSize 1 on ${show(text)}: ${showVerdict(s)} (regular: ${showVerdict(regular(text))})`);
+});
