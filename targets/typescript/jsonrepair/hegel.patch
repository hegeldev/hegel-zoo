diff --git a/hegel/hegel-zoo.mjs b/hegel/hegel-zoo.mjs
new file mode 100644
index 0000000..1b5eedc
--- /dev/null
+++ b/hegel/hegel-zoo.mjs
@@ -0,0 +1,180 @@
+// Hegel zoo: the small harness shared by the zoo's TypeScript/JavaScript targets.
+//
+// `property(name, body)` registers a node:test test that runs `body(tc)` under Hegel with
+// HEGEL_TEST_CASES cases (default 100) and the database at HEGEL_DATABASE. With ZOO_COLLECT=1
+// a `fail()` records the mismatch instead of failing, the case ends there, and the counts of
+// mismatches and of the shapes seen (`count(key)`) are printed at the end of the test, so a
+// property can be run over many cases to see every shape at once. `pin(name, body)` is a
+// plain test for one pinned bug: it must fail while the bug is present and pass once it is
+// fixed (the zoo's judge reads an unexpected pass as "fixed upstream?"). HEGEL_NO_KNOWN=1
+// (`noKnown`, read once here) asks for a run that looks past the recorded bugs: the generators
+// then draw less of their shapes, a mismatch that has one is skipped, and a property that draws
+// nothing but such a shape is registered skipped (`property(name, body, { skip })`).
+
+import { readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+import { test as nodeTest } from "node:test";
+
+// The Hegel version these tests were written against (the zoo pins it in zoo.toml; upstream
+// would add it to devDependencies). Hegel and esbuild are installed with `npm install --prefix
+// .hegel` so the target's own package.json and lock file stay untouched. Checked at load time so
+// a stray install cannot silently change the engine.
+export const HEGEL_PIN = { "@hegeldev/hegel": "0.4.5" };
+
+const hegelDir = join(dirname(fileURLToPath(import.meta.url)), "..", ".hegel", "node_modules", "@hegeldev", "hegel");
+{
+  const installed = JSON.parse(readFileSync(join(hegelDir, "package.json"), "utf8")).version;
+  if (installed !== HEGEL_PIN["@hegeldev/hegel"]) {
+    throw new Error(`@hegeldev/hegel ${installed} is installed; these tests pin ${HEGEL_PIN["@hegeldev/hegel"]}`);
+  }
+}
+const hegel = await import(pathToFileURL(join(hegelDir, "dist", "index.js")));
+const gs = await import(pathToFileURL(join(hegelDir, "dist", "generators", "index.js")));
+
+/** Hegel's generators, re-exported so the tests import everything from one place. */
+export { gs };
+
+export const collecting = !!process.env.ZOO_COLLECT;
+
+/** HEGEL_NO_KNOWN=1: skip the shapes of the recorded bugs (they are drawn, and fail, by default). */
+export const noKnown = !!process.env.HEGEL_NO_KNOWN;
+
+class Collected extends Error {}
+
+let msgs = [];
+let stats = new Map();
+
+/** Report a mismatch: an error normally, a recorded line in collect mode. */
+export function fail(message) {
+  if (collecting) {
+    msgs.push(message);
+    throw new Collected(message);
+  }
+  throw new Error(message);
+}
+
+/** Bump a statistic (the shape of a pinned bug, a generator branch). */
+export function count(key) {
+  stats.set(key, (stats.get(key) || 0) + 1);
+}
+
+function settings() {
+  const s = { testCases: Number(process.env.HEGEL_TEST_CASES) || 100 };
+  if (process.env.HEGEL_DATABASE) {
+    s.database = hegel.Database.fromPath(process.env.HEGEL_DATABASE);
+  }
+  return s;
+}
+
+// Hegel keys its example database by the test function's source text. Every property here runs
+// through the same wrapper, so without this every property would share one key and replay the
+// stored failing examples of all the others; the key is the test's name instead.
+function keyed(name, fn) {
+  fn.toString = () => name;
+  return fn;
+}
+
+function report(name) {
+  if (collecting) {
+    const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+    console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+    for (const m of msgs.slice(0, 25)) {
+      console.log(`#   ${m.split("\n").join("\n#   ")}`);
+    }
+  }
+}
+
+/** A property: `body(tc)` runs under Hegel; a thrown error (or `fail`) is a failure. */
+export function property(name, body, { skip } = {}) {
+  nodeTest(name, { skip }, () => {
+    msgs = [];
+    stats = new Map();
+    hegel.test(keyed(name, (tc) => {
+      if (collecting) count("cases");
+      try {
+        body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }), settings());
+    report(name);
+  });
+}
+
+/** An async property: `body(tc)` may await; runs under Hegel's testAsync with the same settings. */
+export function propertyAsync(name, body, { skip } = {}) {
+  nodeTest(name, { skip }, async () => {
+    msgs = [];
+    stats = new Map();
+    await hegel.testAsync(keyed(name, async (tc) => {
+      if (collecting) count("cases");
+      try {
+        await body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }), settings());
+    report(name);
+  });
+}
+
+/** A pin: a plain test for one recorded bug. */
+export function pin(name, body) {
+  nodeTest(name, body);
+}
+
+/** An integer in [lo, hi]. */
+export function n(tc, lo, hi) {
+  return tc.draw(gs.integers({ minValue: lo, maxValue: hi }));
+}
+
+/** One of xs. */
+export function pick(tc, xs) {
+  return xs[n(tc, 0, xs.length - 1)];
+}
+
+/** True pct percent of the time; shrinks to false (the draw shrinks to 0). */
+export function chance(tc, pct) {
+  return n(tc, 0, 99) >= 100 - pct;
+}
+
+/** A string of `len` characters drawn from `alphabet` (an array of strings). */
+export function word(tc, alphabet, lo, hi) {
+  const len = n(tc, lo, hi);
+  let s = "";
+  for (let i = 0; i < len; i++) {
+    s += pick(tc, alphabet);
+  }
+  return s;
+}
+
+/** Structural equality: arrays by position, objects by key set (prototype ignored), else ===. */
+export function same(a, b) {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) {
+      return false;
+    }
+    return a.every((x, i) => same(x, b[i]));
+  }
+  if (a !== null && b !== null && typeof a === "object" && typeof b === "object") {
+    const ka = Object.keys(a).sort();
+    const kb = Object.keys(b).sort();
+    if (ka.length !== kb.length || ka.some((k, i) => k !== kb[i])) {
+      return false;
+    }
+    return ka.every((k) => same(a[k], b[k]));
+  }
+  return a === b;
+}
+
+/** A compact, unambiguous rendering for messages. */
+export function show(x) {
+  return JSON.stringify(x, (k, v) => (v === undefined ? "<undefined>" : v));
+}
diff --git a/hegel/hegel.test.mjs b/hegel/hegel.test.mjs
new file mode 100644
index 0000000..ce6cc01
--- /dev/null
+++ b/hegel/hegel.test.mjs
@@ -0,0 +1,987 @@
+// Hegel zoo: jsonrepair leaves valid JSON unchanged, returns valid JSON or throws
+// JSONRepairError on anything, gives back the value a document had before each of the repairs
+// the Readme documents was needed, and its two implementations (regular and streaming) agree
+// with each other, through the core and through the Node Transform, with infinite and finite
+// buffers. Run with `node --test --test-reporter=tap hegel/hegel.test.mjs` (Hegel and TypeScript
+// installed under .hegel/, the library compiled to .hegel/dist). ZOO_COLLECT=1 counts mismatches
+// instead of failing; HEGEL_TEST_CASES widens the sweep. The shapes of the recorded bugs
+// (bugs.toml) are drawn like any other and the properties fail on them, naming the shape in the
+// failure (hegel/known.mjs tells the shapes); each bug also has a property over its shape alone
+// (the section before the pins) and a pin. HEGEL_NO_KNOWN=1 asks for a run that looks past the
+// known bugs: the generators then draw less of the shapes, a mismatch that has one is skipped,
+// and the one-bug properties are skipped whole. A mismatch with the shape of a bug reproduced
+// but not yet recorded (a `candidate/typescript/jsonrepair-N` shape in known.mjs) is skipped in
+// every run.
+
+import assert from "node:assert/strict";
+import { chance, count, fail, n, noKnown, pick, pin, property, propertyAsync, same, show, word } from "./hegel-zoo.mjs";
+import {
+  DIGITS, JSONRepairError, LETTERS, SPECIAL_WS, chunk, corruptDoc, fmt, genFlags, genNumber, genValue, isIdentifier, jsonrepair, longestStep,
+  longestToken, mutate, randomText, regular, sameVerdict, showVerdict, streamingGuarded, transformedGuarded,
+} from "./jr.mjs";
+import { known } from "./known.mjs";
+
+/** JSON.parse's verdict: the value, or a thrown SyntaxError as { syntaxError }. */
+function parsed(text) {
+  try {
+    return { value: JSON.parse(text) };
+  } catch (e) {
+    return { syntaxError: e.message };
+  }
+}
+
+/**
+ * The recorded shape of a mismatch (see known.mjs), as the suffix of its failure message; under
+ * HEGEL_NO_KNOWN=1 a mismatch that has one is counted and skipped instead.
+ */
+function recorded(tc, where, ctx) {
+  const id = known(where, ctx);
+  if (!id) return "";
+  // (a candidate - reproduced, not yet recorded - is skipped in every run)
+  const skip = noKnown || id.startsWith("candidate/");
+  count((skip ? "skip " : "known ") + id);
+  if (skip) tc.assume(false);
+  return ` (recorded shape ${id})`;
+}
+
+/** Check a verdict of jsonrepair on `text`: valid JSON out, or a positioned JSONRepairError. */
+function checkVerdict(tc, text, v, what) {
+  if (v.out !== undefined) {
+    const p = parsed(v.out);
+    if (p.syntaxError !== undefined) {
+      const shape = recorded(tc, "invalid-output", { text, out: v.out });
+      fail(`${what}: jsonrepair(${show(text)}) = ${show(v.out)} is not valid JSON: ${p.syntaxError}${shape}`);
+    }
+    const again = regular(v.out);
+    if (again.out !== v.out) {
+      const shape = recorded(tc, "not-idempotent", { text, out: v.out });
+      fail(`${what}: jsonrepair is not idempotent on ${show(text)}: ${show(v.out)} -> ${showVerdict(again)}${shape}`);
+    }
+    return true;
+  }
+  const e = v.error;
+  if (e.name !== "JSONRepairError") {
+    fail(`${what}: jsonrepair(${show(text)}) threw ${e.name}: ${e.message}`);
+  }
+  if (!(Number.isInteger(e.position) && e.position >= 0 && e.position <= text.length)) {
+    fail(`${what}: jsonrepair(${show(text)}) threw ${e.message} with position ${e.position} outside [0, ${text.length}]`);
+  }
+  count(`error-${e.message.replace(/ .*/, "")}`);
+  return false;
+}
+
+// Valid JSON is returned unchanged, whatever its whitespace and escapes.
+property("TestHegelValidJSONIsReturnedUnchanged", (tc) => {
+  const v = genValue(tc, 3);
+  const text = fmt(tc, v);
+  assert.deepEqual(JSON.parse(text), v, "the rendering is valid JSON for the value");
+  const r = regular(text);
+  if (r.out !== text) {
+    const shape = recorded(tc, "valid", { text, value: v });
+    fail(`jsonrepair changed valid JSON ${show(text)}: ${showVerdict(r)}${shape}`);
+  }
+});
+
+// On anything, the result is valid JSON (and a fixed point) or a positioned JSONRepairError.
+property("TestHegelRepairedOutputIsValidJSON", (tc) => {
+  const k = n(tc, 0, 3);
+  let text;
+  if (k === 0) text = randomText(tc);
+  else if (k === 1) text = mutate(tc, fmt(tc, genValue(tc, 2)));
+  else if (k === 2) text = mutate(tc, corruptDoc(tc, genFlags(tc), genValue(tc, 2)).text);
+  else text = corruptDoc(tc, genFlags(tc), genValue(tc, 2)).text;
+  count(k === 0 ? "random" : k === 3 ? "corrupted" : "mutated");
+  checkVerdict(tc, text, regular(text), "any input");
+});
+
+// Each documented repair gives back the value the document had before it was needed.
+property("TestHegelDocumentedRepairsPreserveTheValue", (tc) => {
+  const f = genFlags(tc);
+  const v = genValue(tc, 3);
+  const { text, expect, shape, unquotedBody } = corruptDoc(tc, f, v);
+  const flags = Object.keys(f).filter((x) => f[x]).join(",");
+  const r = regular(text);
+  if (r.out === undefined) {
+    const known = recorded(tc, "repair-error", { text, shape, flags: f, error: r.error, expect, unquotedBody });
+    fail(`jsonrepair(${show(text)}) [${shape}; ${flags}] threw ${r.error.message} @${r.error.position}; expected ${show(expect)}${known}`);
+  }
+  const p = parsed(r.out);
+  if (p.syntaxError !== undefined) {
+    const known = recorded(tc, "invalid-output", { text, out: r.out });
+    fail(`jsonrepair(${show(text)}) [${shape}] = ${show(r.out)} is not valid JSON: ${p.syntaxError}${known}`);
+  }
+  if (!same(p.value, expect)) {
+    const known = recorded(tc, "repair-value", { text, shape, flags: f, out: r.out, expect, unquotedBody });
+    fail(`jsonrepair(${show(text)}) [${shape}; ${flags}] = ${show(r.out)}, parsed ${show(p.value)}; expected ${show(expect)}${known}`);
+  }
+});
+
+/** Inputs for the differentials: valid, corrupted, mutated and random texts. */
+function anyText(tc) {
+  const k = n(tc, 0, 4);
+  if (k === 0) return { text: fmt(tc, genValue(tc, 2)), valid: true };
+  if (k === 1) return { text: corruptDoc(tc, genFlags(tc), genValue(tc, 2)).text };
+  if (k === 2) return { text: mutate(tc, corruptDoc(tc, genFlags(tc), genValue(tc, 2)).text) };
+  if (k === 3) return { text: mutate(tc, fmt(tc, genValue(tc, 2))) };
+  return { text: randomText(tc) };
+}
+
+/** Compare the regular verdict with a streaming one; errors agree when both are errors (the
+ * messages and positions of the two implementations differ in places, counted, not judged). */
+function compareStreaming(tc, where, text, r, s, extra, describe) {
+  if (r.error && s.error) {
+    count(r.error.message === s.error.message ? (r.error.position === s.error.position ? "agree-error" : "error-position-differs") : "error-message-differs");
+    return;
+  }
+  if (!sameVerdict(r, s)) {
+    const shape = recorded(tc, where, { text, regular: r, streaming: s, transform: s, ...extra });
+    fail(`${describe} on ${show(text)}:\n  regular:   ${showVerdict(r)}\n  streaming: ${showVerdict(s)}${shape}`);
+  }
+  count("agree-output");
+}
+
+// With an infinite buffer the streaming implementation works the same as the regular one
+// (Readme, Develop): same output, or an error from both.
+property("TestHegelStreamingMatchesRegular", (tc) => {
+  const { text } = anyText(tc);
+  const r = regular(text);
+  const chunks = chunk(tc, text);
+  const s = streamingGuarded(chunks, { bufferSize: Number.POSITIVE_INFINITY, chunkSize: n(tc, 1, 64) });
+  compareStreaming(tc, "streaming", text, r, s, {}, "regular and streaming disagree");
+});
+
+// A finite buffer larger than the longest string and whitespace run (Readme: the bufferSize
+// "must be larger than the length of the largest string and whitespace in the JSON data")
+// repairs valid JSON exactly like the regular implementation, chunked anyhow.
+property("TestHegelFiniteBuffersRepairLikeTheRegularImplementation", (tc) => {
+  const v = genValue(tc, 3);
+  const text = fmt(tc, v);
+  const longest = longestToken(text);
+  // (a buffer not larger than the longest parsing step - the whitespace before a token, the token, the
+  // whitespace after it and one more character - is jsonrepair/10's shape, drawn like any other; under
+  // HEGEL_NO_KNOWN=1 the buffer is larger than that too)
+  const bufferSize = (noKnown ? Math.max(longest, longestStep(text) + 1) : longest) + (chance(tc, 50) ? n(tc, 1, 3) : n(tc, 1, 16));
+  const chunkSize = n(tc, 1, bufferSize);
+  const chunks = chunk(tc, text);
+  const r = regular(text);
+  const s = streamingGuarded(chunks, { bufferSize, chunkSize });
+  compareStreaming(tc, "finite-buffer", text, r, s, { bufferSize, chunkSize, longestStep: longestStep(text) },
+    `streaming with bufferSize ${bufferSize} (longest token ${longest}), chunkSize ${chunkSize}, chunks ${show(chunks)} differs from regular`);
+});
+
+/** A too-small buffer's verdict `s` against the regular one `r`: the same output, or an error (the Readme's
+ * promise); a silently different output fails (the oracle of the small-buffer property). */
+function checkSmallBuffer(tc, text, bufferSize, chunkSize, chunks, r, s) {
+  if (sameVerdict(r, s)) { count("same"); return; }
+  if (s.error) {
+    count(/Index out of range|already flushed from the buffer/.test(s.error.message) ? "documented-error" : "other-error");
+    return;
+  }
+  const shape = recorded(tc, "small-buffer", { text, bufferSize, chunkSize, regular: r, streaming: s });
+  fail(`streaming with bufferSize ${bufferSize}, chunkSize ${chunkSize}, chunks ${show(chunks)} silently differs from regular on ${show(text)}:\n  regular:   ${showVerdict(r)}\n  streaming: ${showVerdict(s)}${shape}`);
+}
+
+// A buffer too small for the data fails (Readme: "otherwise an error is thrown"), never
+// silently returning something else than the regular implementation.
+property("TestHegelSmallBuffersFailLoudly", (tc) => {
+  const { text } = anyText(tc);
+  const bufferSize = n(tc, 1, 12);
+  const chunkSize = n(tc, 1, 12);
+  const chunks = chunk(tc, text);
+  const r = regular(text);
+  const s = streamingGuarded(chunks, { bufferSize, chunkSize });
+  checkSmallBuffer(tc, text, bufferSize, chunkSize, chunks, r, s);
+});
+
+// The Node Transform gives the same result as the regular implementation: string chunks split
+// anywhere, Buffer chunks split at any byte.
+propertyAsync("TestHegelTransformMatchesRegular", async (tc) => {
+  const { text } = anyText(tc);
+  const r = regular(text);
+  const asBuffers = chance(tc, 50);
+  // a lone surrogate cannot pass through a byte stream (Node encodes string chunks as UTF-8, and
+  // Buffer.from replaces it before the Transform sees it): not compared
+  if (!text.isWellFormed()) { count("lone-surrogate"); return; }
+  let chunks;
+  if (asBuffers && noKnown) {
+    // (a multibyte character split across two Buffer chunks is jsonrepair/8's shape, drawn like any
+    // other below; under HEGEL_NO_KNOWN=1 the Buffer chunks are cut at code-point boundaries)
+    chunks = chunk(tc, text).map((c) => Buffer.from(c, "utf8"));
+    if (chunks.length === 0) chunks.push(Buffer.alloc(0));
+  } else if (asBuffers) {
+    const buf = Buffer.from(text, "utf8");
+    chunks = [];
+    let i = 0;
+    while (i < buf.length) {
+      const end = Math.min(buf.length, i + n(tc, 1, chance(tc, 50) ? 3 : 16));
+      chunks.push(buf.subarray(i, end));
+      i = end;
+    }
+    if (chunks.length === 0) chunks.push(Buffer.alloc(0));
+  } else {
+    chunks = chunk(tc, text);
+    if (chunks.length === 0) chunks.push("");
+  }
+  const options = chance(tc, 50) ? undefined : { bufferSize: Number.POSITIVE_INFINITY, chunkSize: n(tc, 1, 64) };
+  const t = transformedGuarded(chunks, options);
+  compareStreaming(tc, "transform", text, r, t, { asBuffers, chunks },
+    `the Transform (${asBuffers ? "Buffer" : "string"} chunks ${show(chunks.map(String))}, options ${show(options)}) differs from regular`);
+  count(asBuffers ? "buffers" : "strings");
+});
+
+// ---------------------------------------------------------------- one property per recorded bug
+//
+// The wide properties above reach the recorded shapes at their natural rates and shrink to one
+// bug each; these draw one bug's shape region with random contents around it - plain values,
+// keys and whitespace that have no recorded shape of their own - and check it with the same
+// oracles (JSON.parse, the value the document had, the other implementation), so every bug has a
+// property that finds it in every run. They draw nothing but the shape, so HEGEL_NO_KNOWN=1
+// skips them whole.
+const KNOWN = { skip: noKnown && "draws only a recorded bug's shape" };
+
+const PLAIN_CHARS = [...LETTERS, ...DIGITS, " "];
+/** A plain string: letters, digits and spaces. */
+const plainString = (tc, lo = 0, hi = 8) => word(tc, PLAIN_CHARS, lo, hi);
+/** An identifier that is not a keyword. */
+const identifier = (tc) => word(tc, LETTERS, 1, 6).replace(/^(true|false|null|True|False|None|undefined)$/, "$1_");
+/** A JSON value whose strings are plain; `depth` bounds the nesting. */
+function plainValue(tc, depth = 2) {
+  const k = n(tc, 0, depth > 0 ? 6 : 3);
+  if (k === 0) return null;
+  if (k === 1) return chance(tc, 50);
+  if (k === 2) return genNumber(tc);
+  if (k === 3) return plainString(tc);
+  if (k <= 5) return Array.from({ length: n(tc, 0, 3) }, () => plainValue(tc, depth - 1));
+  const o = {};
+  for (let i = n(tc, 0, 3); i > 0; i--) o[plainString(tc, 1, 5)] = plainValue(tc, depth - 1);
+  return o;
+}
+/** `lo`-`hi` plain values. */
+const plainValues = (tc, lo, hi) => Array.from({ length: n(tc, lo, hi) }, () => plainValue(tc, 1));
+/** JSON whitespace, `lo`-`hi` characters. */
+const blanks = (tc, lo = 0, hi = 2) => word(tc, [" ", " ", "\t", "\n"], lo, hi);
+/** The items of an array or the properties of an object as JSON texts (the keys `k0`, `k1`, ...). */
+const asProps = (values, isArray) => values.map((v, i) => (isArray ? JSON.stringify(v) : `"k${i}":${JSON.stringify(v)}`));
+/** The object with the keys `k0`, `k1`, ... for `values`. */
+const asObject = (values) => Object.fromEntries(values.map((v, i) => [`k${i}`, v]));
+/** A container of `values` (an array, or an object under the keys `k0`, ...) with `texts` for its items and `sep` between them. */
+function container(values, isArray, texts, sep = ",") {
+  return { text: isArray ? `[${texts.join(sep)}]` : `{${texts.join(sep)}}`, expect: isArray ? values : asObject(values) };
+}
+
+/** The regular implementation gives back `expect` from `text` (the oracle of the value-preservation property). */
+function checkRepairedValue(text, expect, what) {
+  const r = regular(text);
+  if (r.out === undefined) fail(`${what}: jsonrepair(${show(text)}) threw ${r.error.message} @${r.error.position}; expected ${show(expect)}`);
+  const p = parsed(r.out);
+  if (p.syntaxError !== undefined) fail(`${what}: jsonrepair(${show(text)}) = ${show(r.out)} is not valid JSON: ${p.syntaxError}`);
+  if (!same(p.value, expect)) fail(`${what}: jsonrepair(${show(text)}) = ${show(r.out)}, parsed ${show(p.value)}; expected ${show(expect)}`);
+}
+
+/** The streaming core with an infinite buffer, fed in random chunks, agrees with the regular implementation on `text` (the oracle of the differential). */
+function checkStreamingAgrees(tc, text, what) {
+  const r = regular(text);
+  const s = streamingGuarded(chunk(tc, text), { bufferSize: Number.POSITIVE_INFINITY, chunkSize: n(tc, 1, 64) });
+  if (r.error && s.error) { count("agree-error"); return; }
+  if (!sameVerdict(r, s)) fail(`${what} on ${show(text)}:\n  regular:   ${showVerdict(r)}\n  streaming: ${showVerdict(s)}`);
+  count("agree-output");
+}
+
+/** The Node Transform on `chunks` with `options` agrees with the regular implementation on `text` (the oracle of the Transform differential). */
+function checkTransformAgrees(text, chunks, options, what) {
+  const r = regular(text);
+  const t = transformedGuarded(chunks, options);
