diff --git a/hegel/hegel-zoo.mjs b/hegel/hegel-zoo.mjs
new file mode 100644
index 0000000..1ca6f10
--- /dev/null
+++ b/hegel/hegel-zoo.mjs
@@ -0,0 +1,163 @@
+// Hegel zoo: the small harness shared by the zoo's TypeScript/JavaScript targets.
+//
+// `property(name, body)` registers a node:test test that runs `body(tc)` under Hegel with
+// HEGEL_TEST_CASES cases (default 100) and the database at HEGEL_DATABASE. With ZOO_COLLECT=1
+// a `fail()` records the mismatch instead of failing, the case ends there, and the counts of
+// mismatches and of the shapes seen (`count(key)`) are printed at the end of the test, so a
+// property can be run over many cases to see every shape at once. `pin(name, body)` is a
+// plain test for one pinned bug: it must fail while the bug is present and pass once it is
+// fixed (the zoo's judge reads an unexpected pass as "fixed upstream?").
+
+import { readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+import { test as nodeTest } from "node:test";
+
+// The Hegel version these tests were written against (the zoo pins it in zoo.toml; upstream
+// would add it to devDependencies). Hegel and esbuild are installed with `npm install --prefix
+// .hegel` so the target's own package.json and lock file stay untouched. Checked at load time so
+// a stray install cannot silently change the engine.
+export const HEGEL_PIN = { "@hegeldev/hegel": "0.4.5" };
+
+const hegelDir = join(dirname(fileURLToPath(import.meta.url)), "..", ".hegel", "node_modules", "@hegeldev", "hegel");
+{
+  const installed = JSON.parse(readFileSync(join(hegelDir, "package.json"), "utf8")).version;
+  if (installed !== HEGEL_PIN["@hegeldev/hegel"]) {
+    throw new Error(`@hegeldev/hegel ${installed} is installed; these tests pin ${HEGEL_PIN["@hegeldev/hegel"]}`);
+  }
+}
+const hegel = await import(pathToFileURL(join(hegelDir, "dist", "index.js")));
+const gs = await import(pathToFileURL(join(hegelDir, "dist", "generators", "index.js")));
+
+export const collecting = !!process.env.ZOO_COLLECT;
+
+class Collected extends Error {}
+
+let msgs = [];
+let stats = new Map();
+
+/** Report a mismatch: an error normally, a recorded line in collect mode. */
+export function fail(message) {
+  if (collecting) {
+    msgs.push(message);
+    throw new Collected(message);
+  }
+  throw new Error(message);
+}
+
+/** Bump a statistic (the shape of a pinned bug, a generator branch). */
+export function count(key) {
+  stats.set(key, (stats.get(key) || 0) + 1);
+}
+
+function settings() {
+  const s = { testCases: Number(process.env.HEGEL_TEST_CASES) || 100 };
+  if (process.env.HEGEL_DATABASE) {
+    s.database = hegel.Database.fromPath(process.env.HEGEL_DATABASE);
+  }
+  return s;
+}
+
+/** A property: `body(tc)` runs under Hegel; a thrown error (or `fail`) is a failure. */
+export function property(name, body) {
+  nodeTest(name, () => {
+    msgs = [];
+    stats = new Map();
+    hegel.test((tc) => {
+      try {
+        body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** An async property: `body(tc)` may await; runs under Hegel's testAsync with the same settings. */
+export function propertyAsync(name, body) {
+  nodeTest(name, async () => {
+    msgs = [];
+    stats = new Map();
+    await hegel.testAsync(async (tc) => {
+      try {
+        await body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }, settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** A pin: a plain test for one recorded bug. */
+export function pin(name, body) {
+  nodeTest(name, body);
+}
+
+/** An integer in [lo, hi]. */
+export function n(tc, lo, hi) {
+  return tc.draw(gs.integers({ minValue: lo, maxValue: hi }));
+}
+
+/** One of xs. */
+export function pick(tc, xs) {
+  return xs[n(tc, 0, xs.length - 1)];
+}
+
+/** True pct percent of the time. */
+export function chance(tc, pct) {
+  return n(tc, 0, 99) < pct;
+}
+
+/** A string of `len` characters drawn from `alphabet` (an array of strings). */
+export function word(tc, alphabet, lo, hi) {
+  const len = n(tc, lo, hi);
+  let s = "";
+  for (let i = 0; i < len; i++) {
+    s += pick(tc, alphabet);
+  }
+  return s;
+}
+
+/** Structural equality: arrays by position, objects by key set (prototype ignored), else ===. */
+export function same(a, b) {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) {
+      return false;
+    }
+    return a.every((x, i) => same(x, b[i]));
+  }
+  if (a !== null && b !== null && typeof a === "object" && typeof b === "object") {
+    const ka = Object.keys(a).sort();
+    const kb = Object.keys(b).sort();
+    if (ka.length !== kb.length || ka.some((k, i) => k !== kb[i])) {
+      return false;
+    }
+    return ka.every((k) => same(a[k], b[k]));
+  }
+  return a === b;
+}
+
+/** A compact, unambiguous rendering for messages. */
+export function show(x) {
+  return JSON.stringify(x, (k, v) => (v === undefined ? "<undefined>" : v));
+}
diff --git a/hegel/hegel.test.mjs b/hegel/hegel.test.mjs
new file mode 100644
index 0000000..4cc3e58
--- /dev/null
+++ b/hegel/hegel.test.mjs
@@ -0,0 +1,380 @@
+// Hegel zoo: jsonrepair leaves valid JSON unchanged, returns valid JSON or throws
+// JSONRepairError on anything, gives back the value a document had before each of the repairs
+// the Readme documents was needed, and its two implementations (regular and streaming) agree
+// with each other, through the core and through the Node Transform, with infinite and finite
+// buffers. Run with `node --test --test-reporter=tap hegel/hegel.test.mjs` (Hegel and TypeScript
+// installed under .hegel/, the library compiled to .hegel/dist). ZOO_COLLECT=1 counts mismatches
+// instead of failing; HEGEL_TEST_CASES widens the sweep; ZOO_NO_KNOWN=1 lifts the gates of
+// hegel/known.mjs.
+
+import assert from "node:assert/strict";
+import { chance, count, fail, n, pin, property, propertyAsync, same, show } from "./hegel-zoo.mjs";
+import {
+  JSONRepairError, chunk, corruptDoc, fmt, genFlags, genValue, jsonrepair, longestStep, longestToken, mutate, randomText,
+  regular, sameVerdict, showVerdict, streamingGuarded, transformedGuarded,
+} from "./jr.mjs";
+import { known } from "./known.mjs";
+
+/** JSON.parse's verdict: the value, or a thrown SyntaxError as { syntaxError }. */
+function parsed(text) {
+  try {
+    return { value: JSON.parse(text) };
+  } catch (e) {
+    return { syntaxError: e.message };
+  }
+}
+
+/** Check a verdict of jsonrepair on `text`: valid JSON out, or a positioned JSONRepairError. */
+function checkVerdict(text, v, what) {
+  if (v.out !== undefined) {
+    const p = parsed(v.out);
+    if (p.syntaxError !== undefined) {
+      const k = known("invalid-output", { text, out: v.out });
+      if (k) { count(k); return false; }
+      fail(`${what}: jsonrepair(${show(text)}) = ${show(v.out)} is not valid JSON: ${p.syntaxError}`);
+    }
+    const again = regular(v.out);
+    if (again.out !== v.out) {
+      const k = known("not-idempotent", { text, out: v.out });
+      if (k) { count(k); return false; }
+      fail(`${what}: jsonrepair is not idempotent on ${show(text)}: ${show(v.out)} -> ${showVerdict(again)}`);
+    }
+    return true;
+  }
+  const e = v.error;
+  if (e.name !== "JSONRepairError") {
+    fail(`${what}: jsonrepair(${show(text)}) threw ${e.name}: ${e.message}`);
+  }
+  if (!(Number.isInteger(e.position) && e.position >= 0 && e.position <= text.length)) {
+    fail(`${what}: jsonrepair(${show(text)}) threw ${e.message} with position ${e.position} outside [0, ${text.length}]`);
+  }
+  count(`error-${e.message.replace(/ .*/, "")}`);
+  return false;
+}
+
+// Valid JSON is returned unchanged, whatever its whitespace and escapes.
+property("TestHegelValidJSONIsReturnedUnchanged", (tc) => {
+  const v = genValue(tc, 3);
+  const text = fmt(tc, v);
+  assert.deepEqual(JSON.parse(text), v, "the rendering is valid JSON for the value");
+  const r = regular(text);
+  if (r.out !== text) {
+    const k = known("valid", { text, value: v });
+    if (k) { count(k); return; }
+    fail(`jsonrepair changed valid JSON ${show(text)}: ${showVerdict(r)}`);
+  }
+});
+
+// On anything, the result is valid JSON (and a fixed point) or a positioned JSONRepairError.
+property("TestHegelRepairedOutputIsValidJSON", (tc) => {
+  const k = n(tc, 0, 3);
+  let text;
+  if (k === 0) text = randomText(tc);
+  else if (k === 1) text = mutate(tc, fmt(tc, genValue(tc, 2)));
+  else if (k === 2) text = mutate(tc, corruptDoc(tc, genFlags(tc), genValue(tc, 2)).text);
+  else text = corruptDoc(tc, genFlags(tc), genValue(tc, 2)).text;
+  count(k === 0 ? "random" : k === 3 ? "corrupted" : "mutated");
+  checkVerdict(text, regular(text), "any input");
+});
+
+// Each documented repair gives back the value the document had before it was needed.
+property("TestHegelDocumentedRepairsPreserveTheValue", (tc) => {
+  const f = genFlags(tc);
+  const v = genValue(tc, 3);
+  const { text, expect, shape, unquotedBody } = corruptDoc(tc, f, v);
+  const flags = Object.keys(f).filter((x) => f[x]).join(",");
+  const r = regular(text);
+  if (r.out === undefined) {
+    const k = known("repair-error", { text, shape, flags: f, error: r.error, expect, unquotedBody });
+    if (k) { count(k); return; }
+    fail(`jsonrepair(${show(text)}) [${shape}; ${flags}] threw ${r.error.message} @${r.error.position}; expected ${show(expect)}`);
+  }
+  const p = parsed(r.out);
+  if (p.syntaxError !== undefined) {
+    fail(`jsonrepair(${show(text)}) [${shape}] = ${show(r.out)} is not valid JSON: ${p.syntaxError}`);
+  }
+  if (!same(p.value, expect)) {
+    const k = known("repair-value", { text, shape, flags: f, out: r.out, expect, unquotedBody });
+    if (k) { count(k); return; }
+    fail(`jsonrepair(${show(text)}) [${shape}; ${flags}] = ${show(r.out)}, parsed ${show(p.value)}; expected ${show(expect)}`);
+  }
+});
+
+/** Inputs for the differentials: valid, corrupted, mutated and random texts. */
+function anyText(tc) {
+  const k = n(tc, 0, 4);
+  if (k === 0) return { text: fmt(tc, genValue(tc, 2)), valid: true };
+  if (k === 1) return { text: corruptDoc(tc, genFlags(tc), genValue(tc, 2)).text };
+  if (k === 2) return { text: mutate(tc, corruptDoc(tc, genFlags(tc), genValue(tc, 2)).text) };
+  if (k === 3) return { text: mutate(tc, fmt(tc, genValue(tc, 2))) };
+  return { text: randomText(tc) };
+}
+
+/** Compare the regular verdict with a streaming one; errors agree when both are errors (the
+ * messages and positions of the two implementations differ in places, counted, not judged). */
+function compareStreaming(where, text, r, s, extra, describe) {
+  if (r.error && s.error) {
+    count(r.error.message === s.error.message ? (r.error.position === s.error.position ? "agree-error" : "error-position-differs") : "error-message-differs");
+    return;
+  }
+  if (!sameVerdict(r, s)) {
+    const k = known(where, { text, regular: r, streaming: s, transform: s, ...extra });
+    if (k) { count(k); return; }
+    fail(`${describe} on ${show(text)}:\n  regular:   ${showVerdict(r)}\n  streaming: ${showVerdict(s)}`);
+  }
+  count("agree-output");
+}
+
+// With an infinite buffer the streaming implementation works the same as the regular one
+// (Readme, Develop): same output, or an error from both.
+property("TestHegelStreamingMatchesRegular", (tc) => {
+  const { text } = anyText(tc);
+  const r = regular(text);
+  const chunks = chunk(tc, text);
+  const s = streamingGuarded(chunks, { bufferSize: Number.POSITIVE_INFINITY, chunkSize: n(tc, 1, 64) });
+  compareStreaming("streaming", text, r, s, {}, "regular and streaming disagree");
+});
+
+// A finite buffer larger than the longest string and whitespace run (Readme: the bufferSize
+// "must be larger than the length of the largest string and whitespace in the JSON data")
+// repairs valid JSON exactly like the regular implementation, chunked anyhow.
+property("TestHegelFiniteBuffersRepairLikeTheRegularImplementation", (tc) => {
+  const v = genValue(tc, 3);
+  const text = fmt(tc, v);
+  const longest = longestToken(text);
+  const bufferSize = longest + n(tc, 1, 16);
+  const chunkSize = n(tc, 1, bufferSize);
+  const chunks = chunk(tc, text);
+  const r = regular(text);
+  const s = streamingGuarded(chunks, { bufferSize, chunkSize });
+  compareStreaming("finite-buffer", text, r, s, { bufferSize, chunkSize, longestStep: longestStep(text) },
+    `streaming with bufferSize ${bufferSize} (longest token ${longest}), chunkSize ${chunkSize}, chunks ${show(chunks)} differs from regular`);
+});
+
+// A buffer too small for the data fails (Readme: "otherwise an error is thrown"), never
+// silently returning something else than the regular implementation.
+property("TestHegelSmallBuffersFailLoudly", (tc) => {
+  const { text } = anyText(tc);
+  const bufferSize = n(tc, 1, 12);
+  const chunkSize = n(tc, 1, 12);
+  const chunks = chunk(tc, text);
+  const r = regular(text);
+  const s = streamingGuarded(chunks, { bufferSize, chunkSize });
+  if (sameVerdict(r, s)) { count("same"); return; }
+  if (s.error) {
+    count(/Index out of range|already flushed from the buffer/.test(s.error.message) ? "documented-error" : "other-error");
+    return;
+  }
+  const k = known("small-buffer", { text, bufferSize, chunkSize, regular: r, streaming: s });
+  if (k) { count(k); return; }
+  fail(`streaming with bufferSize ${bufferSize}, chunkSize ${chunkSize}, chunks ${show(chunks)} silently differs from regular on ${show(text)}:\n  regular:   ${showVerdict(r)}\n  streaming: ${showVerdict(s)}`);
+});
+
+// The Node Transform gives the same result as the regular implementation: string chunks split
+// anywhere, Buffer chunks split at any byte.
+propertyAsync("TestHegelTransformMatchesRegular", async (tc) => {
+  const { text } = anyText(tc);
+  const r = regular(text);
+  const asBuffers = chance(tc, 50);
+  let chunks;
+  if (asBuffers) {
+    const buf = Buffer.from(text, "utf8");
+    chunks = [];
+    let i = 0;
+    while (i < buf.length) {
+      const end = Math.min(buf.length, i + n(tc, 1, chance(tc, 50) ? 3 : 16));
+      chunks.push(buf.subarray(i, end));
+      i = end;
+    }
+    if (chunks.length === 0) chunks.push(Buffer.alloc(0));
+  } else {
+    // a lone surrogate cannot pass through a byte stream (Node encodes string chunks as UTF-8): not compared
+    if (!text.isWellFormed()) { count("lone-surrogate"); return; }
+    chunks = chunk(tc, text);
+    if (chunks.length === 0) chunks.push("");
+  }
+  const options = chance(tc, 50) ? undefined : { bufferSize: Number.POSITIVE_INFINITY, chunkSize: n(tc, 1, 64) };
+  const t = transformedGuarded(chunks, options);
+  compareStreaming("transform", text, r, t, { asBuffers, chunks },
+    `the Transform (${asBuffers ? "Buffer" : "string"} chunks ${show(chunks.map(String))}, options ${show(options)}) differs from regular`);
+  count(asBuffers ? "buffers" : "strings");
+});
+
+// ---------------------------------------------------------------- pins
+
+/** The streaming core on one text with an infinite buffer. */
+function core(text, options = { bufferSize: Number.POSITIVE_INFINITY, chunkSize: 65536 }, chunks = [text]) {
+  return streamingGuarded(chunks, options);
+}
+
+/** jsonrepair's output on text, which must be valid JSON. */
+function repairedValue(text) {
+  const out = jsonrepair(text);
+  return JSON.parse(out);
+}
+
+// jsonrepair/1: valid JSON whose last string in a container holds an unmatched bracket of the
+// container's kind is rejected or rewritten ("only count the brackets inside the string when
+// the quote is directly followed by a closing bracket").
+pin("TestHegelPinValidJSONWithABracketInItsLastStringIsUnchanged", () => {
+  assert.equal(jsonrepair('{"a":"{"}'), '{"a":"{"}');
+  assert.equal(jsonrepair('["["]'), '["["]');
+});
+
+// jsonrepair/2: an ellipsis in an object followed by a comma and whitespace.
+pin("TestHegelPinEllipsisFollowedByCommaAndSpaceInAnObject", () => {
+  assert.deepEqual(repairedValue('{..., "a": 1}'), { a: 1 });
+  assert.deepEqual(repairedValue('{"a": 1,\n..., "b": 2}'), { a: 1, b: 2 });
+});
+
+// jsonrepair/3: a number followed by a special whitespace character becomes a string.
+pin("TestHegelPinNumberBeforeSpecialWhitespaceStaysANumber", () => {
+  assert.deepEqual(repairedValue("[1 ,2]"), [1, 2]);
+  assert.deepEqual(repairedValue('{"a": 1　}'), { a: 1 });
+});
+
+// jsonrepair/4: newline-delimited JSON followed by a redundant closing bracket.
+pin("TestHegelPinStreamingAcceptsNDJSONWithARedundantBracket", () => {
+  const text = '{"a":1}\n{"b":2}]';
+  assert.deepEqual(core(text), regular(text));
+  assert.deepEqual(core("1\n2\n}"), regular("1\n2\n}"));
+});
+
+// jsonrepair/5: repeated commas.
+pin("TestHegelPinRepeatedCommasAreRepairedTheSameWay", () => {
+  assert.deepEqual(repairedValue("[1,,2]"), [1, 2]);
+  assert.deepEqual(core('{"a":1,,"b":2}'), regular('{"a":1,,"b":2}'));
+});
+
+// jsonrepair/6: trailing whitespace of an unquoted string.
+pin("TestHegelPinStreamingTrimsUnquotedStrings", () => {
+  assert.deepEqual(core("[a ,b]"), regular("[a ,b]"));
+  assert.deepEqual(core("[a\t]"), regular("[a\t]"));
+});
+
+// jsonrepair/7: a missing comma before something that does not start like a value.
+pin("TestHegelPinStreamingRepairsAMissingCommaBeforeAnyValue", () => {
+  assert.deepEqual(core("[1 ...]"), regular("[1 ...]"));
+  assert.deepEqual(core("[1 ;x]"), regular("[1 ;x]"));
+});
+
+// jsonrepair/13: an unquoted string inside a function call.
+pin("TestHegelPinUnquotedStringInsideAFunctionCall", () => {
+  assert.deepEqual(repairedValue("callback(undefined);"), null);
+  assert.deepEqual(repairedValue("f(abc)"), "abc");
+});
+
+// jsonrepair/14: a leading comma followed by an ellipsis, in the streaming implementation.
+pin("TestHegelPinStreamingStripsALeadingCommaBeforeAnEllipsis", () => {
+  assert.deepEqual(core("[[, ...], 1]"), regular("[[, ...], 1]"));
+  assert.deepEqual(core("[{, ...}, 1]"), regular("[{, ...}, 1]"));
+});
+
+// jsonrepair/8: Buffer chunks split inside a multibyte character.
+pin("TestHegelPinTransformDecodesMultibyteCharactersAcrossChunks", async () => {
+  const text = '["héllo"]';
+  const buf = Buffer.from(text, "utf8");
+  const t = transformedGuarded([buf.subarray(0, 4), buf.subarray(4)]);
+  assert.deepEqual(t, { out: text });
+});
+
+// jsonrepair/9: a function call without a parsable argument.
+pin("TestHegelPinFunctionCallWithoutAnArgumentGivesValidJSON", () => {
+  for (const text of ["f()", "f(}", "NumberLong()"]) {
+    let out;
+    try {
+      out = jsonrepair(text);
+    } catch (e) {
+      assert.ok(e instanceof JSONRepairError, `${show(text)}: ${e}`);
+      continue;
+    }
+    assert.doesNotThrow(() => JSON.parse(out), `jsonrepair(${show(text)}) = ${show(out)} is not valid JSON`);
+    assert.notEqual(JSON.parse(out), ")", `jsonrepair(${show(text)}) = ${show(out)} turned the closing parenthesis into a string`);
+  }
+  const s = core("o (}{  });");
+  assert.ok(s.error || parsed(s.out).value !== undefined, `streaming: ${showVerdict(s)}`);
+});
+
+// jsonrepair/11: a missing colon before a keyword is repaired only for the last property.
+pin("TestHegelPinMissingColonBeforeAKeywordIsRepairedInAnyProperty", () => {
+  assert.deepEqual(repairedValue('{"a" true}'), { a: true });
+  assert.deepEqual(repairedValue('{"a" true, "b": 1}'), { a: true, b: 1 });
+});
+
+// jsonrepair/12: two comments without whitespace between them.
+pin("TestHegelPinAdjacentCommentsAreBothStripped", () => {
+  assert.deepEqual(repairedValue('{"a":1/**//**/,"b":2}'), { a: 1, b: 2 });
+  assert.deepEqual(repairedValue('[1/**//**/,2]'), [1, 2]);
+});
+
+// jsonrepair/15: a backslash before a raw control character.
+pin("TestHegelPinEscapedRawControlCharacterGivesValidJSON", () => {
+  for (const text of ['"a\\\rb"', '"a\\\tb"']) {
+    const out = jsonrepair(text);
+    assert.doesNotThrow(() => JSON.parse(out), `jsonrepair(${show(text)}) = ${show(out)} is not valid JSON`);
+  }
+});
+
+// jsonrepair/16: an embedded quote followed by a backslash inside an entity-quoted string.
+pin("TestHegelPinEscapedQuoteAfterAQuoteInAnEntityQuotedString", () => {
+  // &quot;"\"b&quot; holds the value "\"b (two quotes and a b); &quot;"b&quot; and &quot;\"b&quot; are repaired
+  const text = '&quot;"\\"b&quot;';
+  let out;
+  assert.doesNotThrow(() => { out = jsonrepair(text); }, `jsonrepair(${show(text)}) throws`);
+  assert.strictEqual(typeof JSON.parse(out), "string", `jsonrepair(${show(text)}) = ${show(out)} is not a string`);
+});
+
+// jsonrepair/17: a block comment whose body starts with a slash.
+pin("TestHegelPinBlockCommentStartingWithASlashIsStripped", () => {
+  const text = "[1/*/x*/,0]";
+  assert.strictEqual(jsonrepair(text), "[1,0]", `jsonrepair(${show(text)})`);
+  const s = core(text, { bufferSize: Number.POSITIVE_INFINITY }, [text]);
+  assert.strictEqual(s.out, "[1,0]", `streaming on ${show(text)}: ${showVerdict(s)}`);
+});
+
+// jsonrepair/18: newline-delimited JSON whose next document starts with an entity quote.
+pin("TestHegelPinNDJSONDocumentStartingWithAnEntityQuoteIsAccepted", () => {
+  const text = "{}\n&quot;a&quot;";
+  let out;
