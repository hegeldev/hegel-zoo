@@ -0,0 +1,661 @@
+// Hegel zoo: generators and helpers for jsonrepair. Values, their valid JSON renderings with
+// random whitespace and escapes, a corrupting serializer that applies the repairs the Readme
+// documents (unquoted keys, single and special quotes, comments, trailing and missing commas,
+// Python constants, ellipsis, fenced code blocks, JSONP, MongoDB wrappers, concatenated and
+// escaped strings, NDJSON, truncated and redundant brackets) while knowing the value the repair
+// must give back, random mutations, and the two implementations under test. The shapes of the
+// recorded bugs (bugs.toml) are drawn like any other, so the properties find the bugs; the
+// comments naming a bug mark the places that draw its shape, and under HEGEL_NO_KNOWN=1
+// (`noKnown`) those places leave the shape out, for a run that looks past the known bugs.
+
+import { Readable, Writable } from "node:stream";
+import { MessageChannel, Worker, receiveMessageOnPort } from "node:worker_threads";
+import { appendFileSync } from "node:fs";
+const TRACE = process.env.ZOO_TRACE;
+function trace(kind, payload) {
+  if (TRACE) appendFileSync(TRACE, JSON.stringify({ kind, ...payload }) + "\n");
+}
+import { pipeline } from "node:stream/promises";
+import { chance, count, n, noKnown, pick, word } from "./hegel-zoo.mjs";
+import { unbalanced } from "./known.mjs";
+
+export const lib = await import(new URL("../.hegel/dist/index.js", import.meta.url));
+export const { jsonrepair, JSONRepairError } = lib;
+export const { jsonrepairCore } = await import(new URL("../.hegel/dist/streaming/core.js", import.meta.url));
+export const { jsonrepairTransform } = await import(new URL("../.hegel/dist/stream.js", import.meta.url));
+
+// ---------------------------------------------------------------- alphabets
+
+export const LETTERS = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_$".split("");
+export const DIGITS = "0123456789".split("");
+export const PUNCT = " ,:;.-+/\\*#@!?=<>()[]{}&%|~^".split("");
+export const QUOTES = ['"', "'", "“", "”", "‘", "’", "`", "´"];
+export const CONTROL = ["\n", "\t", "\r", "\b", "\f"];
+export const BAD_CONTROL = ["\u0000", "\u0001", "\u001f", "\u007f"];
+export const UNICODE = ["é", "ü", "ß", "日", "本", "語", " ", " ", "​", "　", "﻿", "᠎", " ", " ", "\u{1f600}", "\u{1d6fc}"];
+export const SPECIAL_WS = [" ", "᠎", " ", " ", "​", " ", " ", "　", "﻿"];
+export const WORDS = ["true", "false", "null", "True", "False", "None", "undefined", "NaN", "Infinity", "...", "//", "/*", "*/", "```", "```json", "&quot;", "&amp;", "&#34;", "&#x27;", "&apos;", "http://", "https://x.y/z?q=1", "e", "E", "0x1F", "NumberLong", "ISODate", "callback", "\\u12", "\\n", "\\\"", "\\'", "\\"];
+export const JSONISH = [...LETTERS.slice(0, 8), ...DIGITS.slice(0, 4), ...PUNCT, ...QUOTES, ...CONTROL, ...UNICODE.slice(0, 4), ...WORDS.slice(0, 12), "\\", " ", " ", "\n"];
+
+const KEYWORDISH = new Set(["true", "false", "null", "True", "False", "None", "undefined"]);
+
+export function isIdentifier(s) {
+  return /^[A-Za-z_$][A-Za-z0-9_$]*$/.test(s);
+}
+
+// ---------------------------------------------------------------- values
+
+/** A random string for a value or key. */
+export function genString(tc) {
+  const flavour = n(tc, 0, 9);
+  if (flavour === 0) return "";
+  if (flavour <= 3) return word(tc, LETTERS, 1, 8);
+  if (flavour === 4) return word(tc, [...LETTERS, ...DIGITS, " "], 1, 12);
+  if (flavour === 5) return word(tc, [...LETTERS, ...DIGITS, ...PUNCT], 1, 12);
