+// ---------------------------------------------------------------- one property per recorded bug
+
+// The wide properties above reach the recorded bugs at the shapes' natural rates (the bash
+// differential fails on whichever of its seven it meets first and shrinks to one of them, the
+// scan checks to picomatch/1); these draw one bug's shape region each, with random contents
+// around it (`shapes` in hegel-glob.mjs), and check it with the same oracle, so every bug has a
+// property that finds it in every run. They draw nothing but the shape, so HEGEL_NO_KNOWN=1
+// skips them whole.
+const KNOWN = { skip: noKnown && "draws only a recorded bug's shape" };
+/** The body of the property over the shape of bug `id`, checked by `check`. */
+const shaped = (id, check) => (tc) => {
+  const { pat, paths } = tc.draw(shapes[id]);
+  check(tc, pat, paths);
+};
+
+property("TestHegelScanSeesGlobsAfterALiteralBraceGroup", shaped("picomatch/1", checkLiteralsAndScan), KNOWN);
