+property("TestHegelStarAfterAnEmptyGroupSkipsDotfiles", shaped("picomatch/3", checkAgainstBash), KNOWN);
+property("TestHegelScanTreatsAnEscapedBraceAsLiteral", shaped("picomatch/4", checkLiteralsAndScan), KNOWN);
+property("TestHegelQuestionMarkAfterAGroupMatchesOneCharacter", shaped("picomatch/5", checkAgainstBash), KNOWN);
+property("TestHegelGlobstarNextToAGroupStaysInTheSegment", shaped("picomatch/6", checkAgainstBash), KNOWN);
+property("TestHegelGlobstarSegmentNeedsTheSlashBeforeAnOptionalGroup", shaped("picomatch/7", checkAgainstBash), KNOWN);
+property("TestHegelNegatedPosixClassExcludesTheSlash", shaped("picomatch/8", checkAgainstBash), KNOWN);
+property("TestHegelPosixClassAfterGlobstarKeepsTheExplicitDot", shaped("picomatch/9", checkAgainstBash), KNOWN);
+property("TestHegelNegatedBracketExcludesTheWindowsSeparator", shaped("picomatch/10", checkPosixAndWindows), KNOWN);
