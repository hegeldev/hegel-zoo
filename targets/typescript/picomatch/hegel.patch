+// ---------------------------------------------------------------- posix entry point
+
+/** picomatch/posix answers as the main entry point, and a backslash path under windows: true as its slash form. */
+function checkPosixAndWindows(tc, pat, paths) {
+  for (const p of paths) {
+    const a = isMatchSafe(p, pat.pattern, pat.opts);
+    let b;
+    try {
+      b = posix.isMatch(p, pat.pattern, pat.opts);
+    } catch (e) {
+      fail(`posix.isMatch threw ${e.message}`);
+    }
+    if (a !== b) fail(`picomatch ${a} vs picomatch/posix ${b} for ${show(pat.pattern)} on ${show(p)} ${show(pat.opts)}`);
+    // backslashes are path separators only with windows: true
+    const w = p.replace(/\//g, "\\");
+    if (w !== p && !pat.pattern.includes("\\") && !p.includes("\\")) {
+      const win = isMatchSafe(w, pat.pattern, { ...pat.opts, windows: true });
+      if (win !== a) {
+        const shape = Known.negatedBracketMatchesWindowsSeparator(pat.pattern, p) ? "picomatch/10" : null;
+        if (!known(shape)) fail(`windows: ${win} for ${show(w)}, posix ${a} for ${show(p)} with ${show(pat.pattern)} ${show(pat.opts)}${named(shape)}`);
+      }
+    }
+  }
+}
+
+property("TestHegelPosixEntryPointAgrees", (tc) => {
+  const { pat, paths } = tc.draw(patternAndPaths);
+  checkPosixAndWindows(tc, pat, paths);
+});
