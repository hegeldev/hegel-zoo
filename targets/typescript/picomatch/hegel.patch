+// Hegel zoo: glob-pattern and path generators for picomatch, and bash's filename globbing as the oracle.
+//
+// A pattern is drawn as data - segments of atoms, each atom carrying its text, its kind and a few
+// strings that match it - and rendered by pure functions into the pattern text, the options it
+// needs and the flags the properties read. The candidate paths for a pattern are drawn from its
+// atoms' solutions, from those solutions with one edit applied (positions taken modulo the live
+// length) and from random names. The shapes of the recorded bugs (bugs.toml) are drawn like any
+// other; the last section draws each bug's shape region on its own, for the property that finds
+// that bug in every run. Under HEGEL_NO_KNOWN=1 the two shapes that would otherwise skip a good
+// part of the scan checks (a brace group without a comma, an escaped brace) are left out.
+
+import { execFileSync } from "node:child_process";
+import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { dirname, join } from "node:path";
+import { gs, noKnown } from "./hegel-zoo.mjs";
+
+const LOWER = "abcdxyz".split("");
+const UPPER = "ABX".split("");
+const LIT = [...LOWER, ...LOWER, "0", "1", ".", "-", "_"];
+const NAME_CHARS = [...LOWER, ...LOWER, ...UPPER, "0", "1", ".", "-", "_", "*", "?", "[", "]", "{", "}", "(", ")", "!", "+", "@", ",", "\\"];
+const CLASSES = ["alpha", "digit", "alnum", "lower", "upper", "punct", "xdigit", "word", "space", "blank"];
+const CLASS_SOLUTIONS = { alpha: ["a", "Q"], digit: ["0", "7"], alnum: ["a", "1"], lower: ["a", "z"], upper: ["A", "X"], punct: ["-", "_", "."], xdigit: ["a", "F", "9"], word: ["a", "_", "1"], space: [" "], blank: [" "] };
+
+// ---------------------------------------------------------------- generator helpers
+
+const ints = (lo, hi) => gs.integers({ minValue: lo, maxValue: hi });
+
+/** oneOf with weights: `weighted([45, a], [55, b])` draws a 45 times in 100; shrinks towards the first choice. */
+function weighted(...choices) {
+  const total = choices.reduce((sum, [w]) => sum + w, 0);
+  return ints(0, total - 1).flatMap((r) => {
+    for (const [w, g] of choices) {
+      if (r < w) return g;
+      r -= w;
+    }
+    throw new Error("unreachable");
+  });
+}
+
+/** True pct percent of the time; shrinks to false. */
+const chance = (pct) => ints(0, 99).map((r) => r >= 100 - pct);
+/** A draw from g pct percent of the time, else undefined (listed first: shrinks to absent). */
+const maybe = (pct, g) => weighted([100 - pct, gs.just(undefined)], [pct, g]);
+/** lo-hi characters from `alphabet`, an array of strings (a repeated entry weighs more). */
+const text = (alphabet, lo, hi) => gs.arrays(gs.sampledFrom(alphabet), { minSize: lo, maxSize: hi }).map((cs) => cs.join(""));
+
+// ---------------------------------------------------------------- atoms
+//
+// One glob atom of a path segment: {text, kind, solutions: [strings that match it]}; a POSIX
+// class carries `posix: true` (the pattern then needs the posix option).
+
+const lit = (s) => ({ text: s, kind: "lit", solutions: [s] });
+/** A glob text turned into one of the strings it matches. */
+const literalise = (s) => s.replace(/[*?\[\]]/g, "a");
+
+const literal = gs.sampledFrom(LIT).map(lit);
+const star = gs.tuples(gs.sampledFrom(LIT), text(LIT, 1, 3)).map(([c, w]) => ({ text: "*", kind: "glob", solutions: ["", c, w] }));
+const qmark = gs.sampledFrom(LIT).map((c) => ({ text: "?", kind: "glob", solutions: [c] }));
+
+// a bracket expression: a list, a range, a POSIX class or an awkward form, one time in four negated
+const bracketList = text(LOWER, 1, 3).map((s) => ({ inner: s, solutions: s.split("") }));
+const bracketRange = gs.just({ inner: "a-d", solutions: ["a", "b", "c", "d"] });
+const bracketClass = gs.sampledFrom(CLASSES).map((cls) => ({ inner: `[:${cls}:]`, solutions: CLASS_SOLUTIONS[cls], posix: true }));
+const bracketAwkward = gs.sampledFrom(["a-c0-1", "x-", "-a", "].", "a]b", "a\\-b", "\\]", "-"]).map((s) => ({ inner: s, solutions: ["a", "-", "]"] }));
+const bracketBody = gs.oneOf(bracketList, bracketRange, bracketClass, bracketAwkward);
+const bracket = gs.tuples(maybe(25, gs.sampledFrom(["!", "^"])), bracketBody).map(([neg, b]) => ({
+  text: `[${neg ?? ""}${b.inner}]`,
+  kind: "bracket",
+  solutions: neg ? ["x", "Z", "1"] : b.solutions,
+  ...(b.posix ? { posix: true } : {}),
+}));
+
+// an extglob. Negation is excluded (picomatch documents that it differs from bash there), so is
+// a "?" right after the "(" (picomatch reads "(?" as a regex group, documented under "regex
+// features"); empty and "*"/"?"-only alternatives are generated but the differential skips the
+// patterns picomatch literalises under its documented maxExtglobRecursion safeguard.
+const extAlt = weighted([80, text(LOWER, 1, 3)], [20, gs.sampledFrom(["a*", "b?", "[ab]", "", "*"])]);
+const extglob = gs.record({ op: gs.sampledFrom(["@", "*", "+", "?"]), alts: gs.arrays(extAlt, { minSize: 1, maxSize: 3 }) }).map(({ op, alts: drawn }) => {
+  // "?()" is a degenerate form bash and picomatch read differently
+  const alts = drawn.every((x) => x === "") ? ["a", ...drawn.slice(1)] : drawn;
+  const a0 = literalise(alts[0]);
+  const solutions = { "@": [a0], "*": ["", a0, a0 + a0], "+": [a0, a0 + a0], "?": ["", a0] }[op];
+  return { text: `${op}(${alts.join("|")})`, kind: "extglob", solutions };
+});
+
+// a brace list; with a single item it is not an expansion but literal text (bash and the README:
+// "only comma-delimited lists"), the shape of picomatch/1 in scan(), left out under HEGEL_NO_KNOWN=1
+const braceItem = weighted([80, text(LOWER, 0, 3)], [20, gs.sampledFrom(["a*", "?", "[ab]"])]);
+const literalBrace = text(LOWER, 1, 3).map((w) => lit(`{${w}}`));
+const braceList = gs.arrays(braceItem, { minSize: 2, maxSize: 3 }).map((items) => ({ text: `{${items.join(",")}}`, kind: "brace", solutions: items.map(literalise) }));
+const brace = noKnown ? braceList : weighted([33, literalBrace], [67, braceList]);
+
+// an escaped special character, literal ("\{" is the shape of picomatch/4 in scan(), left out
+// under HEGEL_NO_KNOWN=1)
+const ESCAPABLE = ["*", "?", "[", "]", "{", "}", "(", ")", "!", "+", "@", "."];
+const escapeOf = (chars) => gs.sampledFrom(chars).map((c) => ({ text: "\\" + c, kind: "escape", solutions: [c] }));
+const escape = escapeOf(noKnown ? ESCAPABLE.filter((c) => c !== "{") : ESCAPABLE);
+
+const atom = weighted([50, literal], [15, star], [8, qmark], [8, bracket], [7, extglob], [7, brace], [5, escape]);
+
+// ---------------------------------------------------------------- segments and patterns
+
+const isGlobAtom = (a) => a.kind !== "lit" && a.kind !== "escape";
+
+/** The segment made of `atoms`: "." and ".." are path syntax, not names (picomatch strips a leading "./"). */
+function mkSegment(atoms) {
+  const text = atoms.map((a) => a.text).join("");
+  return text === "." || text === ".." ? { text: text + "a", atoms: [...atoms, lit("a")] } : { text, atoms };
+}
+const globstar = { text: "**", atoms: null };
+
+// a segment: 1-4 atoms, or one time in five-and-a-half a "**" (atoms: null)
+const segment = weighted([82, gs.arrays(atom, { minSize: 1, maxSize: 4 }).map(mkSegment)], [18, gs.just(globstar)]);
+
+/** The pattern text of 1-4 segments joined by "/" and the options it runs under: {pattern, opts, segments, hasGlob}. */
+function mkPattern({ segments, dot, nocase }) {
+  const atoms = segments.flatMap((s) => s.atoms ?? []);
+  const opts = {};
+  if (atoms.some((a) => a.posix)) opts.posix = true;
+  if (dot) opts.dot = true;
+  // bash's nocaseglob applies only to path components that contain glob characters (literal
+  // components are looked up as written), so nocase is only taken for all-glob patterns - and a
+  // brace list does not count, since its expansions ("cb{x,y}" -> "cbx", "cby") are literal words;
+  // and case-folding a bracket expression ([a-d], [[:lower:]], [^[:lower:]]) is defined differently
+  // by bash and by a regex "i" flag, so not with brackets either
+  const allGlob = segments.every((s) => s.atoms === null || s.atoms.some((a) => isGlobAtom(a) && a.kind !== "brace"));
+  const noBracket = atoms.every((a) => a.kind !== "bracket");
+  if (nocase && allGlob && noBracket) opts.nocase = true;
+  const hasGlob = segments.some((s) => s.atoms === null || s.atoms.some(isGlobAtom));
+  return { pattern: segments.map((s) => s.text).join("/"), opts, segments, hasGlob };
+}
+
+/** A glob pattern with the options it needs (dot 30%, nocase 25% where bash can follow). */
+export const pattern = gs.record({ segments: gs.arrays(segment, { minSize: 1, maxSize: 4 }), dot: chance(30), nocase: chance(25) }).map(mkPattern);
+
+// ---------------------------------------------------------------- candidate paths
+
+// the names a "**" segment stands for: 0-2, one time in seven a dotfile
+const shortName = text(LOWER, 1, 2);
+const globstarNames = gs.arrays(weighted([85, shortName], [15, shortName.map((w) => "." + w)]), { maxSize: 2 });
+
+/** The path segments one segment of `pat` matches (a list: "**" can stand for none or several). */
+const segmentSolution = (seg) => (seg.atoms === null ? globstarNames : gs.tuples(...seg.atoms.map((a) => gs.sampledFrom(a.solutions))).map((ss) => [ss.join("")]));
+/** A path the pattern matches, built from one solution per atom. */
+const solution = (pat) => gs.tuples(...pat.segments.map(segmentSolution)).map((parts) => parts.flat());
+
+// one edit of a path; `at` is taken modulo the live length when applied
+const at = ints(0, 5);
+const edit = weighted(
+  [20, gs.record({ kind: gs.just("insert"), at, name: text(NAME_CHARS, 1, 3) })],
+  [15, gs.record({ kind: gs.just("drop"), at })],
+  [20, gs.record({ kind: gs.just("extend"), at, c: gs.sampledFrom(NAME_CHARS) })],
+  [15, gs.record({ kind: gs.just("truncate"), at })],
+  [15, gs.record({ kind: gs.just("dot"), at })],
+  [15, gs.record({ kind: gs.just("recase"), at, upper: chance(50) })],
+);
+
+function applyEdit(parts, e) {
+  const p = parts.slice();
+  if (e.kind === "insert") {
+    p.splice(e.at % (p.length + 1), 0, e.name);
+    return p;
+  }
+  if (p.length === 0) return p; // nothing to edit (dropped below as an empty path)
+  const i = e.at % p.length;
+  if (e.kind === "drop") p.splice(i, 1);
+  else if (e.kind === "extend") p[i] += e.c;
+  else if (e.kind === "truncate") p[i] = p[i].slice(1);
+  else if (e.kind === "dot") p[i] = "." + p[i];
+  else p[i] = e.upper ? p[i].toUpperCase() : p[i].toLowerCase();
+  return p;
+}
+
+const randomPath = gs.arrays(text(NAME_CHARS, 1, 4), { minSize: 1, maxSize: 3 });
+
+// a candidate: a solution, an edited solution, or a random path
+const candidate = (pat) => weighted([45, solution(pat)], [44, gs.tuples(solution(pat), edit).map(([parts, e]) => applyEdit(parts, e))], [11, randomPath]);
+
+const validName = (s) => s !== "" && s !== "." && s !== ".." && !s.includes("/") && !s.includes("\0") && !s.includes("\n");
+const validPath = (parts) => parts.length > 0 && parts.length <= 6 && parts.every(validName);
+
+/** 4-12 candidate paths for `pat`, the invalid ones dropped and duplicates merged. */
+const candidates = (pat) => gs.arrays(candidate(pat), { minSize: 4, maxSize: 12 }).map((cs) => [...new Set(cs.filter(validPath).map((p) => p.join("/")))]);
+
+/** A pattern and its candidate paths (at least one): {pat, paths}. */
+export const patternAndPaths = pattern.flatMap((pat) => candidates(pat).map((paths) => ({ pat, paths }))).filter(({ paths }) => paths.length > 0);
+
+// ---------------------------------------------------------------- the shapes of the recorded bugs
+//
+// One generator per recorded bug: the bug's shape region with random contents around it, as
+// {pat, paths} like `patternAndPaths`, the random candidates joined by a witness path built from
+// the drawn solutions (the path the bug gets wrong). The filler is plain - no star, no group, no
+// negated bracket, no escaped brace, so no recorded shape of its own - and exact: its solutions
+// are solutions (no awkward bracket form) and never a "." (a name of its own), so the witness is
+// a valid path; and a glob atom never precedes the shape where scan() would already have seen it.
+// So each property's failure is its own bug and no other.
+
+const PLAIN = LIT.filter((c) => c !== ".");
+const plainLiteral = gs.sampledFrom(PLAIN).map(lit);
+const plainQmark = gs.sampledFrom(PLAIN).map((c) => ({ text: "?", kind: "glob", solutions: [c] }));
+const plainBracket = gs.oneOf(bracketList, bracketRange, bracketClass).map((b) => ({ text: `[${b.inner}]`, kind: "bracket", solutions: b.solutions, ...(b.posix ? { posix: true } : {}) }));
+const plainEscape = escapeOf(ESCAPABLE.filter((c) => c !== "{" && c !== "}" && c !== "."));
+const plainAtom = weighted([60, plainLiteral], [15, plainQmark], [15, plainBracket], [10, plainEscape]);
+const bareAtom = weighted([70, plainLiteral], [15, plainQmark], [15, plainBracket]); // no backslash (the windows check)
+const globAtom = weighted([50, star], [25, plainQmark], [25, plainBracket]);
+const atoms = (g, lo, hi) => gs.arrays(g, { minSize: lo, maxSize: hi });
+const segments = (g, lo, hi) => gs.arrays(g, { minSize: lo, maxSize: hi });
+const word = text(LOWER, 1, 3);
+const letter = gs.sampledFrom(LOWER).map(lit);
+/** The concatenation of `parts`, each a generator of a list or of one element. */
+const cat = (...parts) => gs.tuples(...parts).map((ps) => ps.flat());
+/** The segment of the atoms in `parts`. */
+const seg = (...parts) => cat(...parts).map(mkSegment);
+/** Segments: each part a list of segments or one segment. */
+const segs = cat;
+// filler segments start with a letter: a name starting with "." is picomatch/3's shape to the
+// classifier whenever the pattern also holds a group
+const plainSegment = seg(letter, atoms(plainAtom, 0, 2));
+const bareSegment = seg(letter, atoms(bareAtom, 0, 2));
+/** One solution per atom of `atoms`, joined. */
+const solutionOf = (atoms) => gs.tuples(...atoms.map((a) => gs.sampledFrom(a.solutions))).map((ss) => ss.join(""));
+/** One path segment per segment of `segs` (none has "**"). */
+const solutionsOf = (segs) => gs.tuples(...segs.map((s) => solutionOf(s.atoms)));
+
+/**
+ * {pat, paths} for a shape: the drawn segments as a pattern (dot 30% unless `dot` is fixed, no
+ * nocase), the random candidates plus the path (a list of names) `witness(pat)` draws; the
+ * witness is dropped when it is not a valid path (a "." name), which leaves the random ones.
+ */
+const shapeCase = (segments, witness, dot = chance(30)) =>
+  gs.record({ segments, dot, nocase: gs.just(false) }).map(mkPattern).flatMap((pat) =>
+    gs.tuples(witness(pat), candidates(pat)).map(([w, paths]) => ({ pat, paths: [...new Set([...(validPath(w) ? [w.join("/")] : []), ...paths])] }))).filter(({ paths }) => paths.length > 0);
+
+// a group that can match the empty string: "*(w)", "?(w)", "@(w|)" and "{w,}" - the last not
+// after a "/**/", where bash expands "a/**/{b,}" to "a/**/" and lists "a" too (the "+(w|)" form
+// is literalised by the maxExtglobRecursion safeguard, so not drawn)
+const emptyExtglob = gs.oneOf(
+  word.map((w) => ({ text: `*(${w})`, kind: "extglob", solutions: ["", w] })),
+  word.map((w) => ({ text: `?(${w})`, kind: "extglob", solutions: ["", w] })),
+  word.map((w) => ({ text: `@(${w}|)`, kind: "extglob", solutions: ["", w] })),
+);
+const emptyGroup = gs.oneOf(emptyExtglob, word.map((w) => ({ text: `{${w},}`, kind: "brace", solutions: ["", w] })));
+// a brace list of words
+const wordList = gs.arrays(word, { minSize: 2, maxSize: 3 }).map((items) => ({ text: `{${items.join(",")}}`, kind: "brace", solutions: items }));
+// an extglob whose safeguard-safe alternatives are words ("+"/"*" with one, since an alternative
+// that is a prefix of another is literalised)
+const groupOf = (ops, maxAlts) => gs.tuples(gs.sampledFrom(ops), gs.arrays(word, { minSize: 1, maxSize: maxAlts })).map(([op, alts]) => ({ text: `${op}(${alts.join("|")})`, kind: "extglob", solutions: op === "@" || op === "+" ? [alts[0]] : ["", alts[0]] }));
+const group = gs.oneOf(groupOf(["@", "?"], 2), groupOf(["*", "+"], 1));
+const posixClass = gs.sampledFrom(CLASSES);
+const negation = gs.sampledFrom(["!", "^"]);
+const doubleStar = { text: "**", kind: "glob", solutions: ["", "a", "ab"] };
+
+// picomatch/1: a brace group without a comma, then (in it or in a later segment) the first glob
+const literalBraceThenGlob = shapeCase(
+  segs(segments(atoms(plainLiteral, 1, 3).map(mkSegment), 0, 1), gs.oneOf(
+    segs(seg(atoms(plainLiteral, 0, 2), literalBrace, globAtom, atoms(plainAtom, 0, 1)), segments(plainSegment, 0, 1)),
+    segs(seg(atoms(plainLiteral, 0, 2), literalBrace, atoms(plainLiteral, 0, 1)), segments(seg(atoms(plainAtom, 0, 2), globAtom, atoms(plainAtom, 0, 1)), 1, 2)),
+  )),
+  () => gs.just([]),
+);
+
+// picomatch/4: an escaped "{" (and no "}" anywhere), then the first glob
+const escapedBrace = { text: "\\{", kind: "escape", solutions: ["{"] };
+const escapedBraceThenGlob = shapeCase(
+  segs(segments(atoms(plainLiteral, 1, 3).map(mkSegment), 0, 1), gs.oneOf(
+    segs(seg(atoms(plainLiteral, 0, 2), gs.just(escapedBrace), globAtom, atoms(plainAtom, 0, 1)), segments(plainSegment, 0, 1)),
+    segs(seg(atoms(plainLiteral, 0, 2), gs.just(escapedBrace), atoms(plainLiteral, 0, 1)), segments(seg(atoms(plainAtom, 0, 2), globAtom, atoms(plainAtom, 0, 1)), 1, 2)),
+  )),
+  () => gs.just([]),
+);
+
+// picomatch/2: a segment ending in a star, then trailing "**" segments; the witness is the path
+// of the segments before them (a lone "*" stands for a letter)
+const starSegmentThenGlobstar = shapeCase(
+  segs(segments(plainSegment, 0, 2), seg(atoms(plainAtom, 0, 3), star), gs.arrays(gs.just(globstar), { minSize: 1, maxSize: 2 })),
+  (pat) => gs.tuples(solutionsOf(pat.segments.filter((s) => s.atoms !== null)), gs.sampledFrom(LOWER)).map(([parts, c]) => parts.map((p) => p || c)),
+);
+
+// picomatch/3: a segment that starts with a group matching the empty string and a star, without
+// the dot option; the witness dots that segment
+const emptyGroupThenStar = shapeCase(
+  segs(segments(plainSegment, 0, 1), seg(emptyGroup, star, atoms(plainAtom, 0, 1))),
+  (pat) => {
+    const last = pat.segments.length - 1;
+    return gs.tuples(solutionsOf(pat.segments.slice(0, last)), word, solutionOf(pat.segments[last].atoms.slice(2))).map(([pre, w, tail]) => [...pre, "." + w + tail]);
+  },
+  gs.just(false),
+);
+
+// picomatch/5: an extglob followed by "?"; the witness is a solution of the group plus one character
+const groupThenQmark = shapeCase(
+  segs(segments(plainSegment, 0, 1), seg(atoms(plainAtom, 0, 1), group, qmark, atoms(plainAtom, 0, 1)), segments(plainSegment, 0, 1)),
+  (pat) => {
+    const at = pat.segments.findIndex((s) => s.atoms.some((a) => a.kind === "extglob"));
+    const i = pat.segments[at].atoms.findIndex((a) => a.kind === "extglob");
+    const a = pat.segments[at].atoms;
+    return gs.tuples(solutionsOf(pat.segments.slice(0, at)), solutionOf(a.slice(0, i + 1)), gs.sampledFrom(PLAIN), solutionOf(a.slice(i + 2)), solutionsOf(pat.segments.slice(at + 1))).map(([pre, head, c, tail, post]) => [...pre, head + c + tail, ...post]);
+  },
+);
+
+// picomatch/6: "**" starting a segment before a brace list or "@(...)", or ending it after an
+// extglob; the witness puts a name before (or after) the segment's solution (a literal after the
+// group, since a "?" there is picomatch/5)
+const globstarBesideGroup = shapeCase(
+  segs(segments(plainSegment, 0, 1), gs.oneOf(
+    seg(gs.just(doubleStar), gs.oneOf(wordList, groupOf(["@"], 2)), atoms(plainLiteral, 0, 1)),
+    seg(atoms(plainAtom, 0, 1), group, gs.just(doubleStar)),
+  )),
+  (pat) => {
+    const last = pat.segments.length - 1;
+    const a = pat.segments[last].atoms;
+    const crossing = a[0].text === "**" ? gs.tuples(word, solutionOf(a.slice(1))).map(([name, s]) => [name, s]) : gs.tuples(solutionOf(a.slice(0, -1)), word, word).map(([s, w, name]) => [s + w, name]);
+    return gs.tuples(solutionsOf(pat.segments.slice(0, last)), crossing).map(([pre, tail]) => [...pre, ...tail]);
+  },
+);
+
+// picomatch/7: "/**/" then an extglob that can match the empty string; the witness is the parent path
+const globstarThenEmptyGroup = shapeCase(
+  segs(segments(plainSegment, 1, 2), gs.just(globstar), seg(emptyExtglob)),
+  (pat) => solutionsOf(pat.segments.slice(0, pat.segments.findIndex((s) => s.atoms === null))),
+);
+
+// picomatch/8: a negated bracket expression holding a POSIX class (other than punct, which holds
+// the "/") between plain atoms; the witness puts the separator where the bracket is
+const negatedPosixBracket = shapeCase(
+  segs(segments(plainSegment, 0, 1), seg(atoms(plainAtom, 1, 2), gs.tuples(negation, gs.sampledFrom(CLASSES.filter((c) => c !== "punct")), maybe(30, gs.sampledFrom(LOWER))).map(([neg, cls, extra]) => ({ text: `[${neg}[:${cls}:]${extra ?? ""}]`, kind: "bracket", solutions: ["/"], posix: true })), atoms(plainAtom, 1, 2)), segments(plainSegment, 0, 1)),
+  (pat) => gs.tuples(...pat.segments.map((s) => (s.atoms.some((a) => a.solutions[0] === "/") ? solutionOf(s.atoms).map((s) => s.split("/")) : solutionOf(s.atoms).map((s) => [s])))).map((parts) => parts.flat()),
+);
+
+// picomatch/9: a leading "**/", a segment naming a dotfile explicitly, and a POSIX class in it or
+// in a later segment, without the dot option; the witness is the path without the "**"
+const posixBracket = posixClass.map((cls) => ({ text: `[[:${cls}:]]`, kind: "bracket", solutions: CLASS_SOLUTIONS[cls], posix: true }));
+const dotSegment = (rest) => seg(gs.just(lit(".")), letter, rest);
+const posixClassAfterGlobstarDot = shapeCase(
+  segs(gs.just(globstar), gs.oneOf(
+    segs(dotSegment(cat(atoms(plainAtom, 0, 1), posixBracket, atoms(plainAtom, 0, 1))), segments(plainSegment, 0, 1)),
+    segs(dotSegment(atoms(plainAtom, 0, 2)), segments(plainSegment, 0, 1), seg(atoms(plainAtom, 0, 1), posixBracket, atoms(plainAtom, 0, 1))),
+  )),
+  (pat) => solutionsOf(pat.segments.slice(1)),
+  gs.just(false),
+);
+
+// picomatch/10: a negated bracket expression (no POSIX class) and a star after plain atoms, no
+// backslash anywhere; the witness (in its slash form) has a separator then a glob-special
+// character where the bracket is
+const WINDOWS_SPECIALS = "*+?^${}(|)[]".split("");
+const negatedBracket = gs.tuples(negation, gs.oneOf(text(LOWER, 1, 3), gs.just("a-d"))).map(([neg, inner]) => ({ text: `[${neg}${inner}]`, kind: "bracket", solutions: ["x", "Z", "1"] }));
+const negatedBracketBeforeWindowsSpecial = shapeCase(
+  segs(segments(bareSegment, 0, 1), seg(atoms(bareAtom, 1, 2), negatedBracket, star)),
+  (pat) => {
+    const last = pat.segments.length - 1;
+    const a = pat.segments[last].atoms;
+    return gs.tuples(solutionsOf(pat.segments.slice(0, last)), solutionOf(a.slice(0, -2)), gs.sampledFrom(WINDOWS_SPECIALS), text(LOWER, 0, 2)).map(([pre, head, c, w]) => [...pre, head, c + w]);
+  },
+);
+
+/** The shape generators by bug id. */
+export const shapes = {
+  "picomatch/1": literalBraceThenGlob,
+  "picomatch/2": starSegmentThenGlobstar,
+  "picomatch/3": emptyGroupThenStar,
+  "picomatch/4": escapedBraceThenGlob,
+  "picomatch/5": groupThenQmark,
+  "picomatch/6": globstarBesideGroup,
+  "picomatch/7": globstarThenEmptyGroup,
+  "picomatch/8": negatedPosixBracket,
+  "picomatch/9": posixClassAfterGlobstarDot,
+  "picomatch/10": negatedBracketBeforeWindowsSpecial,
+};
+
+// ---------------------------------------------------------------- the oracle
+
+const SCRIPT = `
+shopt -s globstar extglob nullglob
+shopt -u failglob dotglob nocaseglob
+[ "$3" = 1 ] && shopt -s dotglob
+[ "$4" = 1 ] && shopt -s nocaseglob
+cd "$1" || exit 3
+pat=$2
+eval "printf '%s\\\\n' $pat"
+# a trailing "/**" matches only below a directory in bash, whereas picomatch also matches the
+# directory itself (and a file of that name): add the matches of the pattern without it
+while case $pat in */'**') true ;; *) false ;; esac; do
+  pat=\${pat%/\\*\\*}
+  eval "printf '%s\\\\n' $pat"
+done
+`;
+
+let scratch = null;
+
+/** bash's filename globbing of \`pattern\` over a tree holding exactly \`paths\`: {ok, matched: Set} or {ok: false, error}. */
+export function bashGlob(pattern, paths, { dot = false, nocase = false } = {}) {
+  scratch ??= (() => {
+    const dir = mkdtempSync(join(tmpdir(), "hegel-glob-"));
+    process.on("exit", () => {
+      try { rmSync(dir, { recursive: true, force: true }); } catch {}
+    });
+    return dir;
+  })();
+  const root = join(scratch, "t");
+  rmSync(root, { recursive: true, force: true });
+  mkdirSync(root);
+  // a path that is a prefix of another becomes a directory; the rest are files
+  const sorted = [...paths].sort();
+  for (const p of sorted) {
+    const isDir = sorted.some((q) => q !== p && q.startsWith(p + "/"));
+    if (isDir) mkdirSync(join(root, p), { recursive: true });
+    else {
+      mkdirSync(dirname(join(root, p)), { recursive: true });
+      writeFileSync(join(root, p), "");
+    }
+  }
+  try {
+    const out = execFileSync("bash", ["-c", SCRIPT, "--", root, pattern, dot ? "1" : "0", nocase ? "1" : "0"], {
+      env: { LC_ALL: "C", PATH: process.env.PATH },
+      stdio: ["ignore", "pipe", "pipe"],
+    }).toString();
+    const matched = new Set();
+    for (const line of out.split("\n")) {
+      if (line === "") continue;
+      matched.add(line.replace(/\/+$/, ""));
+    }
+    return { ok: true, matched };
+  } catch (e) {
+    return { ok: false, error: (e.stderr ? e.stderr.toString() : String(e)).trim().split("\n")[0] };
+  }
+}
diff --git a/test/hegel-zoo.mjs b/test/hegel-zoo.mjs
new file mode 100644
index 0000000..e1622f1
--- /dev/null
+++ b/test/hegel-zoo.mjs
@@ -0,0 +1,130 @@
+// Hegel zoo: the small harness shared by the zoo's TypeScript/JavaScript targets.
+//
+// `property(name, body)` registers a node:test test that runs `body(tc)` under Hegel with
+// HEGEL_TEST_CASES cases (default 100) and the database at HEGEL_DATABASE. With ZOO_COLLECT=1
+// a `fail()` records the mismatch instead of failing, the case ends there, and the counts of
+// mismatches and of the shapes seen (`count(key)`) are printed at the end of the test, so a
+// property can be run over many cases to see every shape at once. `pin(name, body)` is a
+// plain test for one pinned bug: it must fail while the bug is present and pass once it is
+// fixed (the zoo's judge reads an unexpected pass as "fixed upstream?"). HEGEL_NO_KNOWN=1
+// (`noKnown`, read once here) asks for a run that looks past the recorded bugs: the properties
+// then skip their shapes, and a property that draws nothing but such a shape is registered
+// skipped (`property(name, body, { skip })`).
+
+import { readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { test as nodeTest } from "node:test";
+import * as hegel from "@hegeldev/hegel";
+import * as gs from "@hegeldev/hegel/generators";
+
+// The Hegel version these tests were written against (the zoo pins it in zoo.toml and installs
+// it with `npm install --no-save @hegeldev/hegel@<version>`; upstream would add it to
+// devDependencies). Checked at load time so a stray install cannot silently change the engine.
+export const HEGEL_PIN = { "@hegeldev/hegel": "0.4.5" };
+
+{
+  let dir = dirname(fileURLToPath(import.meta.resolve("@hegeldev/hegel")));
+  while (!/[\\/]hegel$/.test(dir) && dir !== dirname(dir)) dir = dirname(dir);
+  const installed = JSON.parse(readFileSync(join(dir, "package.json"), "utf8")).version;
+  if (installed !== HEGEL_PIN["@hegeldev/hegel"]) {
+    throw new Error(`@hegeldev/hegel ${installed} is installed; these tests pin ${HEGEL_PIN["@hegeldev/hegel"]}`);
+  }
+}
+
+export const collecting = !!process.env.ZOO_COLLECT;
+
+/** HEGEL_NO_KNOWN=1: skip the shapes of the recorded bugs (they are drawn, and fail, by default). */
+export const noKnown = !!process.env.HEGEL_NO_KNOWN;
+
+class Collected extends Error {}
+
+let msgs = [];
+let stats = new Map();
+
+/** Report a mismatch: an error normally, a recorded line in collect mode. */
+export function fail(message) {
+  if (collecting) {
+    msgs.push(message);
+    throw new Collected(message);
+  }
+  throw new Error(message);
+}
+
+/** Bump a statistic (the shape of a pinned bug, a generator branch). */
+export function count(key) {
+  stats.set(key, (stats.get(key) || 0) + 1);
+}
+
+function settings() {
+  const s = { testCases: Number(process.env.HEGEL_TEST_CASES) || 100 };
+  if (process.env.HEGEL_DATABASE) {
+    s.database = hegel.Database.fromPath(process.env.HEGEL_DATABASE);
+  }
+  return s;
+}
+
+// Hegel keys its example database by the test function's source text. Every property here runs
+// through the same wrapper, so without this every property would share one key and replay the
+// stored failing examples of all the others; the key is the test's name instead.
+function keyed(name, fn) {
+  fn.toString = () => name;
+  return fn;
+}
+
+/** A property: `body(tc)` runs under Hegel; a thrown error (or `fail`) is a failure. */
+export function property(name, body, { skip } = {}) {
+  nodeTest(name, { skip }, () => {
+    msgs = [];
+    stats = new Map();
+    hegel.test(keyed(name, (tc) => {
+      try {
+        body(tc);
+      } catch (e) {
+        if (collecting && e instanceof Collected) {
+          return;
+        }
+        throw e;
+      }
+    }), settings());
+    if (collecting) {
+      const shapes = [...stats].map(([k, v]) => `${k}=${v}`).join(" ");
+      console.log(`# COLLECT ${name}: ${msgs.length} mismatches; stats ${shapes}`);
+      for (const m of msgs.slice(0, 25)) {
+        console.log(`#   ${m.split("\n").join("\n#   ")}`);
+      }
+    }
+  });
+}
+
+/** A pin: a plain test for one recorded bug. */
+export function pin(name, body) {
+  nodeTest(name, body);
+}
+
+/** Hegel's generators, re-exported so the tests import everything from one place. */
+export { gs };
+
+/** Structural equality: arrays by position, objects by key set (prototype ignored), else ===. */
+export function same(a, b) {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) {
+      return false;
+    }
+    return a.every((x, i) => same(x, b[i]));
+  }
+  if (a !== null && b !== null && typeof a === "object" && typeof b === "object") {
+    const ka = Object.keys(a).sort();
+    const kb = Object.keys(b).sort();
+    if (ka.length !== kb.length || ka.some((k, i) => k !== kb[i])) {
+      return false;
+    }
+    return ka.every((k) => same(a[k], b[k]));
+  }
+  return a === b;
+}
+
+/** A compact, unambiguous rendering for messages. */
+export function show(x) {
+  return JSON.stringify(x, (k, v) => (v === undefined ? "<undefined>" : v));
+}
diff --git a/test/hegel.test.mjs b/test/hegel.test.mjs
new file mode 100644
index 0000000..8e37d4d
--- /dev/null
+++ b/test/hegel.test.mjs
@@ -0,0 +1,440 @@
+// Hegel zoo: property tests for picomatch (see README.md of the target).
+//
+// Run with `node --test --test-reporter=tap test/hegel.test.mjs` after `npm install --no-save
+// @hegeldev/hegel@0.4.5`. HEGEL_TEST_CASES sets the budget, ZOO_COLLECT=1 records mismatches
+// instead of failing at the first. The differential property needs bash (>= 4.4, globstar/extglob).
+// HEGEL_NO_KNOWN=1 skips the shapes of the recorded bugs (bugs.toml), which the properties
+// otherwise draw and fail on: see "known shapes" below.
+
+import assert from "node:assert/strict";
+import picomatch from "../index.js";
+import posix from "../posix.js";
+import { count, fail, gs, noKnown, pin, property, show } from "./hegel-zoo.mjs";
+import { bashGlob, pattern, patternAndPaths, shapes } from "./hegel-glob.mjs";
+
+// ---------------------------------------------------------------- known shapes
+//
+// The shapes of the recorded bugs (bugs.toml), read off the pattern and the path. The wide
+// properties draw them like any other shape and fail on them (they are the expected failures,
+// with the shape named in the failure); each bug also has a property of its own below that
+// draws nothing but its shape, and a pin. Under HEGEL_NO_KNOWN=1 a mismatch or a check that has
+// a recorded shape is counted and skipped instead, for a run that looks past the known bugs.
+const Known = {
+  // picomatch/1: scan() stops at a brace group without a comma and reports isGlob false
+  scanStopsAtLiteralBrace: (pattern) => /\{[^,{}]*\}/.test(pattern),
+  // picomatch/2: a trailing "/**" after a segment ending in a single "*" does not match the segment itself
+  // (a segment "a**" or ".***" is "a*"/".*" per the README, so it counts as ending in a star)
+  trailingGlobstarAfterStar: (pattern) => {
+    const segs = pattern.split("/");
+    if (segs.length < 2 || segs[segs.length - 1] !== "**") return false;
+    while (segs.length && segs[segs.length - 1] === "**") segs.pop();
+    return segs.length > 0 && segs[segs.length - 1].endsWith("*");
+  },
+  // picomatch/3: a "*" after a leading extglob or brace group that can match the empty string matches
+  // dotfiles ("+(...)" too when one of its alternatives is empty or a bare "*": "+(*)aa" matches ".aaa")
+  dotLeakThroughEmptyGroup: (pattern, path, opts) =>
+    !opts.dot && path.split("/").some((s) => s.startsWith(".")) && pattern.split("/").some((s) => /^(?:[*?]\(|\{|@\()/.test(s) || /^\+\((?:[^)|]*\|)*\*?(?:\||\))/.test(s)),
+  // picomatch/4: scan() treats an escaped "\{" as a brace group
+  scanEscapedBrace: (pattern) => /\\\{/.test(pattern),
+  // picomatch/5: a "?" right after a ")" is a regex quantifier, not a one-character wildcard
+  qmarkAfterParen: (pattern) => /\)\?/.test(pattern),
+  // picomatch/6: "**" next to a brace group or an "@(...)" in the same segment crosses path separators
+  globstarNextToGroup: (pattern) => pattern.split("/").some((s) => s !== "**" && /\*\*[{@]|\)\*\*/.test(s)),
+  // picomatch/7: "a/**/?(b)" (a group that can match nothing after "/**/") matches the bare "a"
+  emptyGroupAfterGlobstar: (pattern) => /\/\*\*\/(?:[?*]\(|\{|@\()/.test(pattern),
+  // picomatch/8: a negated bracket expression holding a POSIX class compiles to "[^A-Z]" without
+  // excluding "/", so "a[![:upper:]]b" matches "a/b" ("a[!x]b" gives "[^x/]")
+  negatedPosixClassMatchesSlash: (pattern) => /\[[!^][^\]]*\[:\w+:\]/.test(pattern),
+  // picomatch/9: a POSIX class anywhere in a pattern that starts with "**/" prepends "(?!\.)" to the
+  // whole regex, so "**/.a/[[:digit:]]" rejects ".a/0" (and accepts "x/.a/0")
+  posixClassAfterGlobstarBlocksLeadingDot: (pattern, path) => pattern.startsWith("**/") && /\[:\w+:\]/.test(pattern) && path.startsWith("."),
+  // picomatch/10: under windows a backslash before a glob-special character is kept as an escape
+  // (utils.toPosixSlashes, REGEX_BACKSLASH) and a negated bracket excludes "/" but not "\", so
+  // "a[!a]*" matches "a\*" while "a/*" does not
+  negatedBracketMatchesWindowsSeparator: (pattern, path) => /\/[*+?^${}(|)[\]]/.test(path) && /\[[!^]/.test(pattern),
+};
+
+/** The recorded bug a mismatch of picomatch (`mine`) and bash on `path` has the shape of, or null. */
+function knownMatchShape(pattern, path, opts, mine) {
+  if (!mine && Known.trailingGlobstarAfterStar(pattern)) return "picomatch/2";
+  if (mine && Known.dotLeakThroughEmptyGroup(pattern, path, opts)) return "picomatch/3";
+  if (Known.qmarkAfterParen(pattern)) return "picomatch/5";
+  if (mine && Known.globstarNextToGroup(pattern)) return "picomatch/6";
+  if (mine && Known.emptyGroupAfterGlobstar(pattern)) return "picomatch/7";
+  if (mine && Known.negatedPosixClassMatchesSlash(pattern)) return "picomatch/8";
+  if (!mine && Known.posixClassAfterGlobstarBlocksLeadingDot(pattern, path)) return "picomatch/9";
+  return null;
+}
+
+/** Count a recorded shape; true when the check that met it is to be skipped (HEGEL_NO_KNOWN=1). */
+function known(shape) {
+  if (shape) count(`known/${shape}`);
+  return noKnown && !!shape;
+}
+
+const named = (shape) => (shape ? ` (recorded shape ${shape})` : "");
+
+// A documented deviation: "more than two consecutive stars in a glob path segment are regarded as
+// a single star" (README), so in "***(b)" the star of the "*(...)" extglob joins the run and the
+// "(b)" left over is a regex group: "[^/]*?(b)", which rejects "a"; bash reads "**" then "*(b)".
+const starRunSwallowsStarExtglob = (pattern) => /\*\*\*\(/.test(pattern);
+
+// An oracle limit of brace expansion: a segment whose atoms are brace lists with an empty
+// alternative, alone or with stars, expands to a word bash reads differently from picomatch's
+// segment-wise grammar. Without stars the segment is empty: "x/{,a}" -> "x/" (a directory bash
+// lists with the trailing slash the oracle strips) and "a/{b,}/c" -> "a//c" (read as "a/c"); with
+// two or more stars it is a bare "**": "{,}**" -> "**", a globstar to bash, while picomatch keeps
+// "{,}**" as "*" because the "**" is not alone in its segment. picomatch matches the words as written.
+function emptyBraceLimit(pat) {
+  for (const s of pat.segments) {
+    if (s.atoms === null || !s.atoms.some((a) => a.kind === "brace")) continue;
+    if (!s.atoms.every((a) => (a.kind === "brace" && a.solutions.includes("")) || a.text === "*")) continue;
+    const stars = s.atoms.filter((a) => a.text === "*").length;
+    if (stars === 0) return "limit/empty-brace-alternative-empties-a-segment";
+    if (stars >= 2) return "limit/empty-brace-alternative-bares-a-globstar";
+  }
+  return null;
+}
+
+/** True when picomatch's documented maxExtglobRecursion safeguard turns an extglob of the pattern literal. */
+function literalisedExtglob(pattern, opts) {
+  return picomatch.makeRe(pattern, opts).source !== picomatch.makeRe(pattern, { ...opts, maxExtglobRecursion: false }).source;
+}
+
+function isMatchSafe(path, pattern, opts) {
+  try {
+    return picomatch.isMatch(path, pattern, opts);
+  } catch (e) {
+    fail(`isMatch threw ${e.constructor.name}: ${e.message} for ${show(pattern)} on ${show(path)} ${show(opts)}`);
+  }
+}
+
+// ---------------------------------------------------------------- bash differential
+
+/** picomatch.isMatch agrees with bash on every path of `paths`; a mismatch names its recorded shape. */
+function checkAgainstBash(tc, pat, paths) {
+  const bash = bashGlob(pat.pattern, paths, pat.opts);
+  if (!bash.ok) count("skip/bash-rejects-pattern");
+  tc.assume(bash.ok);
+  const literalised = literalisedExtglob(pat.pattern, pat.opts);
+  if (literalised) count("skip/risky-extglob-literalised");
+  tc.assume(!literalised);
+  if (pat.opts.dot) count("opt/dot");
+  if (pat.opts.nocase) count("opt/nocase");
+  if (pat.opts.posix) count("opt/posix");
+  const diffs = [];
+  for (const p of paths) {
+    const mine = isMatchSafe(p, pat.pattern, pat.opts);
+    const theirs = bash.matched.has(p);
+    if (mine === theirs) continue;
+    const shape = knownMatchShape(pat.pattern, p, pat.opts, mine);
+    if (shape) {
+      if (!known(shape)) diffs.push(`${show(p)}: picomatch ${mine}, bash ${theirs}${named(shape)}`);
+      continue;
+    }
+    if (!mine && starRunSwallowsStarExtglob(pat.pattern)) {
+      count("limit/star-run-swallows-star-extglob");
+      continue;
+    }
+    const limit = !mine && emptyBraceLimit(pat);
+    if (limit) {
+      count(limit);
+      continue;
+    }
+    if (mine && !pat.opts.dot && p.split("/").some((s) => s.startsWith(".")) && pat.pattern.split("/").some((s) => s.startsWith("["))) {
+      // picomatch's own tests let a bracket expression match a dot (test/posix-classes.js: `[[:punct:]]`
+      // matches "."); bash needs a literal dot for a leading one
+      count("limit/bracket-matches-leading-dot");
+      continue;
+    }
+    diffs.push(`${show(p)}: picomatch ${mine}, bash ${theirs}`);
+  }
+  if (diffs.length) fail(`pattern ${show(pat.pattern)} ${show(pat.opts)} over ${show(paths)}\n  ${diffs.join("\n  ")}`);
+}
+
+property("TestHegelMatchesLikeBashGlobbing", (tc) => {
+  const { pat, paths } = tc.draw(patternAndPaths);
+  checkAgainstBash(tc, pat, paths);
+});
+
+// ---------------------------------------------------------------- the API agrees with itself
+
+// a pattern with its paths, and a second pattern for the union, ignore and callback checks
+const patternPathsAndOther = gs.record({ main: patternAndPaths, other: pattern });
+
+property("TestHegelApiIsConsistent", (tc) => {
+  const { main: { pat, paths }, other } = tc.draw(patternPathsAndOther);
+  const opts = { ...pat.opts };
+  const re = picomatch.makeRe(pat.pattern, opts);
+  const matcher = picomatch(pat.pattern, opts);
+  const stateMatcher = picomatch(pat.pattern, opts, true);
+  for (const p of paths) {
+    const a = isMatchSafe(p, pat.pattern, opts);
+    const b = matcher(p);
+    const c = re.test(p);
+    const d = picomatch.test(p, re, opts).isMatch;
+    const e = stateMatcher(p, true);
+    if (a !== b || a !== c || a !== d || a !== e.isMatch) fail(`isMatch ${a}, matcher ${b}, makeRe ${c}, test ${d}, state ${e.isMatch} for ${show(pat.pattern)} on ${show(p)} ${show(opts)}`);
+    if (e.input !== p || e.glob !== pat.pattern || e.output !== p) fail(`state object ${show(e)} for ${show(pat.pattern)} on ${show(p)}`);
+    // contains: anchors dropped, so every match stays a match
+    if (a && !isMatchSafe(p, pat.pattern, { ...opts, contains: true })) fail(`contains: ${show(pat.pattern)} no longer matches ${show(p)} ${show(opts)}`);
+    // capture: the match array is returned
+    const cap = picomatch.test(p, picomatch.makeRe(pat.pattern, { ...opts, capture: true }), { ...opts, capture: true });
+    // (picomatch/5: a ")?" is a lazy quantifier without capture, "((...)+)?" an optional group with it, so the two disagree)
+    if (cap.isMatch !== a || (a && !Array.isArray(cap.match))) {
+      const shape = cap.isMatch !== a && Known.qmarkAfterParen(pat.pattern) ? "picomatch/5" : null;
+      if (!known(shape)) fail(`capture: ${show(cap)} vs isMatch ${a} for ${show(pat.pattern)} on ${show(p)} ${show(opts)}${named(shape)}`);
+    }
+    // negation
+    const neg = isMatchSafe(p, "!" + pat.pattern, opts);
+    if (neg !== !a) fail(`"!" + pattern: ${neg}, pattern: ${a} for ${show(pat.pattern)} on ${show(p)} ${show(opts)}`);
+    if (isMatchSafe(p, "!" + pat.pattern, { ...opts, nonegate: true }) !== false && a && !p.startsWith("!")) {
+      // with nonegate the leading "!" is literal, so the path must start with "!"
+      fail(`nonegate: "!" + pattern still negates for ${show(pat.pattern)} on ${show(p)}`);
+    }
+    // arrays of patterns are a union
+    const or = isMatchSafe(p, [pat.pattern, other.pattern], opts);
+    const o2 = isMatchSafe(p, other.pattern, opts);
+    if (or !== (a || o2)) fail(`array of patterns: ${or}, parts ${a} and ${o2} for ${show([pat.pattern, other.pattern])} on ${show(p)} ${show(opts)}`);
+    // ignore removes matches of the ignore pattern
+    const ign = isMatchSafe(p, pat.pattern, { ...opts, ignore: other.pattern });
+    if (ign !== (a && !o2)) fail(`ignore: ${ign}, match ${a}, ignored ${o2} for ${show(pat.pattern)} ignoring ${show(other.pattern)} on ${show(p)} ${show(opts)}`);
+    // nocase: matching the lower-cased path against the lower-cased pattern (ASCII letters only)
+    if (!opts.nocase && !pat.opts.posix && /^[^[]*$/.test(pat.pattern)) {
+      const nc = isMatchSafe(p, pat.pattern, { ...opts, nocase: true });
+      const lc = isMatchSafe(p.toLowerCase(), pat.pattern.toLowerCase(), opts);
+      if (nc !== lc) fail(`nocase: ${nc}, lower-cased ${lc} for ${show(pat.pattern)} on ${show(p)} ${show(opts)}`);
+    }
+    // basename: a pattern without slashes is matched against the basename
+    if (!pat.pattern.includes("/") && p.includes("/")) {
+      const bn = isMatchSafe(p, pat.pattern, { ...opts, basename: true });
+      const base = isMatchSafe(p.slice(p.lastIndexOf("/") + 1), pat.pattern, opts);
+      if (bn !== base) fail(`basename: ${bn}, basename match ${base} for ${show(pat.pattern)} on ${show(p)} ${show(opts)}`);
+    }
+  }
+  // callbacks: onResult for every input, onMatch for the matches, onIgnore for the ignored
+  const seen = { result: 0, match: 0, ignore: 0 };
+  const cb = picomatch(pat.pattern, { ...opts, ignore: other.pattern, onResult: () => seen.result++, onMatch: () => seen.match++, onIgnore: () => seen.ignore++ });
+  let matches = 0;
+  let ignored = 0;
+  for (const p of paths) {
+    if (cb(p)) matches++;
+    else if (isMatchSafe(p, pat.pattern, opts) && isMatchSafe(p, other.pattern, opts)) ignored++;
+  }
+  if (seen.result !== paths.length || seen.match !== matches || seen.ignore !== ignored) fail(`callbacks ${show(seen)} for ${paths.length} inputs, ${matches} matches, ${ignored} ignored (${show(pat.pattern)} ignoring ${show(other.pattern)})`);
+  // maxLength limits the pattern (see README of the target: the option table's "input string" is
+  // the glob, not the string tested)
+  let threw = null;
+  try {
+    picomatch.makeRe(pat.pattern, { ...opts, maxLength: 3 });
+  } catch (e) {
+    threw = e;
+  }
+  if (pat.pattern.length > 3 && !(threw instanceof SyntaxError)) fail(`maxLength 3 accepted the ${pat.pattern.length}-character pattern ${show(pat.pattern)} (${threw})`);
+  if (pat.pattern.length <= 3 && threw) fail(`maxLength 3 rejected the ${pat.pattern.length}-character pattern ${show(pat.pattern)}: ${threw.message}`);
+});
+
+// ---------------------------------------------------------------- literal patterns and disabled features
+
+/** Disabled features are literal, a glob-free pattern is literal, and scan() describes the pattern. */
+function checkLiteralsAndScan(tc, pat, paths) {
+  const text = pat.pattern;
+  // every pattern matches its own text once its glob features are switched off, unless it still
+  // contains a feature that stays enabled or an escape (which matches the escaped character)
+  const kinds = new Set();
+  for (const s of pat.segments) {
+    if (s.atoms === null) kinds.add("globstar");
+    else for (const a of s.atoms) kinds.add(a.kind);
+  }
+  const noExt = { ...pat.opts, noextglob: true };
+  const noBrace = { ...pat.opts, nobrace: true };
+  const noBracket = { ...pat.opts, nobracket: true };
+  const only = (k) => [...kinds].every((x) => x === "lit" || x === k);
+  if (only("extglob") && kinds.has("extglob") && !isMatchSafe(text, text, noExt)) fail(`noextglob: ${show(text)} does not match itself`);
+  if (only("brace") && kinds.has("brace") && !isMatchSafe(text, text, noBrace)) fail(`nobrace: ${show(text)} does not match itself`);
+  if (only("bracket") && kinds.has("bracket") && !isMatchSafe(text, text, noBracket)) fail(`nobracket: ${show(text)} does not match itself`);
+  // a literal pattern (no glob atoms at all) matches exactly its own text
+  if (!pat.hasGlob) {
+    const lit = pat.segments.map((s) => s.atoms.map((a) => a.solutions[0]).join("")).join("/");
+    if (!isMatchSafe(lit, text, pat.opts)) fail(`literal ${show(text)} does not match ${show(lit)}`);
+    for (const p of paths) {
+      const m = isMatchSafe(p, text, pat.opts);
+      const want = pat.opts.nocase ? p.toLowerCase() === lit.toLowerCase() : p === lit;
+      if (m !== want) fail(`literal ${show(text)} on ${show(p)}: ${m}, want ${want} ${show(pat.opts)}`);
+    }
+  }
+  // scan: isGlob, the base/glob split, the negation flag and the parts (picomatch/1 and /4 are
+  // scan() stopping at a brace group without a comma or at an escaped brace)
+  const sc = picomatch.scan(text);
+  const shape = Known.scanStopsAtLiteralBrace(text) ? "picomatch/1" : Known.scanEscapedBrace(text) ? "picomatch/4" : null;
+  if (!known(shape)) {
+    if (sc.isGlob !== pat.hasGlob) fail(`scan(${show(text)}).isGlob is ${sc.isGlob} although the pattern has ${[...kinds].join(",")}${named(shape)}`);
+    const rebuilt = sc.prefix + (sc.base && sc.glob ? sc.base + "/" + sc.glob : sc.base + sc.glob);
+    if (rebuilt !== text) fail(`scan(${show(text)}) base ${show(sc.base)} and glob ${show(sc.glob)} do not rebuild the pattern${named(shape)}`);
+    if (sc.isGlob && picomatch.scan(text, { parts: true }).isGlob !== sc.isGlob) fail(`scan(${show(text)}).isGlob differs with parts: true${named(shape)}`);
+    if (sc.glob && sc.glob !== text) {
+      // whatever the pattern matches is the base (a trailing "/**" matches it) or lies below it
+      const base = sc.base.replace(/\\(.)/g, "$1");
+      const below = (p, b) => p === b || p.startsWith(b + "/");
+      for (const p of paths) {
+        if (isMatchSafe(p, text, pat.opts) && !below(p, base) && !(pat.opts.nocase && below(p.toLowerCase(), base.toLowerCase()))) fail(`scan base ${show(sc.base)} is not a prefix of the match ${show(p)} of ${show(text)} ${show(pat.opts)}${named(shape)}`);
+      }
+    }
+  }
+  const scn = picomatch.scan("!" + text);
+  if (scn.negated !== true) fail(`scan("!" + ${show(text)}).negated is ${scn.negated}`);
+  const sc2 = picomatch.scan(text, { parts: true });
+  if (sc2.parts && sc2.parts.join("/") !== text.replace(/^\.\//, "")) fail(`scan parts ${show(sc2.parts)} do not rebuild ${show(text)}`);
+}
+
+property("TestHegelDisabledFeaturesAreLiteral", (tc) => {
+  const { pat, paths } = tc.draw(patternAndPaths);
+  checkLiteralsAndScan(tc, pat, paths);
+});
