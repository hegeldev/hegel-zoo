#!/usr/bin/env python3
"""zoo — fetch, apply, run and check the Hegel zoo's targets.

Standard library only (Python 3.11+). Run from anywhere inside the repository.

  zoo fetch  <target>...        clone upstream into work/<lang>/<name> at the pinned base commit
  zoo apply  <target>...        fetch, reset to base, git apply hegel.patch
  zoo test   <target>...        apply, run the tests, judge against expected_failures
  zoo save   <target>           regenerate hegel.patch from the working tree in work/
  zoo check  [<target>...]      static consistency checks (add --apply to also verify patches apply)
  zoo drift  [<target>...]      compare base.commit with upstream's default branch (ls-remote, no clone)
  zoo bump   <target>... [--to <commit>] [--accept-fixed] [--finish]
                                rebase hegel.patch onto upstream HEAD (or --to), run, record the
                                outcome: [[bug.observed]] rows, [base], README history line
  zoo bump-hegel <lang> <ver>   rewrite zoo.toml and every patch's dependency line for <lang>
  zoo report                    regenerate TROPHIES.md from all bugs.toml files
  zoo new    <lang> <name> <upstream-url>   scaffold a target directory
  zoo list   [<lang>]           list targets

A <target> is "<lang>/<name>" (e.g. rust/humantime), or "<lang>" for every target in that
language, or "all".
"""

from __future__ import annotations

import argparse
import datetime as dt
import os
import re
import shutil
import subprocess
import sys
import tomllib
from dataclasses import dataclass, field
from pathlib import Path

LANGUAGES = ("rust", "go", "typescript", "java", "cpp", "ocaml")
OPEN_STATUSES = {"open", "reported", "duplicate", "disputed"}  # bug still present upstream
ALL_STATUSES = OPEN_STATUSES | {"fixed", "wontfix", "retired"}


# --------------------------------------------------------------------------- helpers

def find_root() -> Path:
    p = Path.cwd().resolve()
    for cand in (p, *p.parents):
        if (cand / "zoo.toml").is_file() and (cand / "targets").is_dir():
            return cand
    sys.exit("zoo: not inside the zoo (no zoo.toml above the current directory)")


ROOT = find_root()
TARGETS = ROOT / "targets"
WORK = ROOT / "work"


def die(msg: str) -> None:
    sys.exit(f"zoo: {msg}")


def log(msg: str) -> None:
    print(f"zoo: {msg}", file=sys.stderr, flush=True)


def run(cmd: list[str], cwd: Path | None = None, check: bool = True, capture: bool = False,
        env: dict | None = None) -> subprocess.CompletedProcess:
    full_env = dict(os.environ)
    if env:
        full_env.update(env)
    return subprocess.run(cmd, cwd=cwd, check=check, text=True, env=full_env,
                          stdout=subprocess.PIPE if capture else None,
                          stderr=subprocess.STDOUT if capture else None)


def toml_str(s: str) -> str:
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


# --------------------------------------------------------------------------- model

@dataclass
class Target:
    lang: str
    name: str
    dir: Path
    meta: dict
    bugs: list[dict] = field(default_factory=list)

    @property
    def id(self) -> str:
        return f"{self.lang}/{self.name}"

    @property
    def patch(self) -> Path:
        return self.dir / "hegel.patch"

    @property
    def work(self) -> Path:
        return WORK / self.lang / self.name

    @property
    def src(self) -> Path:
        """Directory inside the checkout where the package lives and tests run."""
        sub = self.meta.get("subdir", "")
        return self.work / sub if sub else self.work

    @property
    def expected_failures(self) -> dict[str, str]:
        """test name -> bug id. Values in target.toml are either "bug/id" or
        { bug = "bug/id", intermittent = true } for tests that reach the bug only on some runs."""
        out = {}
        for name, v in self.meta.get("expected_failures", {}).items():
            out[name] = v["bug"] if isinstance(v, dict) else v
        return out

    @property
    def intermittent(self) -> set[str]:
        return {n for n, v in self.meta.get("expected_failures", {}).items()
                if isinstance(v, dict) and v.get("intermittent")}


def load_pins() -> dict:
    return tomllib.loads((ROOT / "zoo.toml").read_text())


def load_target(lang: str, name: str) -> Target:
    d = TARGETS / lang / name
    tf = d / "target.toml"
    if not tf.is_file():
        die(f"no such target {lang}/{name} ({tf} missing)")
    meta = tomllib.loads(tf.read_text())
    bugs = []
    bf = d / "bugs.toml"
    if bf.is_file():
        bugs = tomllib.loads(bf.read_text()).get("bug", [])
    return Target(lang, name, d, meta, bugs)


def all_targets(lang: str | None = None) -> list[Target]:
    out = []
    for ld in sorted(TARGETS.iterdir()):
        if not ld.is_dir() or (lang and ld.name != lang):
            continue
        for td in sorted(ld.iterdir()):
            if (td / "target.toml").is_file():
                out.append(load_target(ld.name, td.name))
    return out


def resolve(specs: list[str]) -> list[Target]:
    if not specs or specs == ["all"]:
        return all_targets()
    out: list[Target] = []
    for s in specs:
        if s in LANGUAGES:
            out.extend(all_targets(s))
        elif "/" in s:
            lang, name = s.split("/", 1)
            out.append(load_target(lang, name))
        else:
            die(f"bad target spec {s!r}: use <lang>/<name>, <lang> or all")
    return out


# --------------------------------------------------------------------------- backends

class Backend:
    """Per-language mechanics. Subclasses override what differs."""
    lang = ""
    dep_re: re.Pattern  # matches the dependency line in a patch, group 'v' = version

    def patch_versions(self, patch_text: str) -> set[str]:
        return {m.group("v") for m in self.dep_re.finditer(patch_text)}

    def rewrite_version(self, patch_text: str, new: str) -> str:
        return self.dep_re.sub(lambda m: m.group(0).replace(m.group("v"), new), patch_text)

    def default_command(self, t: Target) -> list[str]:
        raise NotImplementedError(f"no {self.lang} backend yet")

    def default_env(self, t: Target) -> dict:
        return {}

    def parse_results(self, output: str) -> dict[str, str]:
        """test name -> 'ok' | 'FAILED' | 'ignored'."""
        raise NotImplementedError

    def patch_excludes(self) -> list[str]:
        return []

    def package_version(self, t: Target) -> str:
        """Upstream's own version string at the checked-out commit ("" if unknown)."""
        return ""


class Rust(Backend):
    lang = "rust"
    # +hegeltest = "0.44.1"   |   +hegeltest = { version = "0.44.1", features = [...] }
    # also the table form:  +[dev-dependencies.hegeltest]\n+version = "0.44.1"
    dep_re = re.compile(r'^\+\s*hegeltest\s*=\s*(?:"(?P<v>[^"]+)"|\{[^}\n]*version\s*=\s*"(?P<v2>[^"]+)")'
                        r'|^\+\[dev-dependencies\.hegeltest\]\n(?:\+(?!\[)[^\n]*\n)*?\+version\s*=\s*"(?P<v3>[^"]+)"',
                        re.M)

    def patch_versions(self, patch_text: str) -> set[str]:
        return {m.group("v") or m.group("v2") or m.group("v3") for m in self.dep_re.finditer(patch_text)}

    def rewrite_version(self, patch_text: str, new: str) -> str:
        def sub(m: re.Match) -> str:
            old = m.group("v") or m.group("v2") or m.group("v3")
            return m.group(0).replace(f'"{old}"', f'"{new}"', 1)
        return self.dep_re.sub(sub, patch_text)

    def default_command(self, t: Target) -> list[str]:
        cmd = ["cargo", "test", "--no-fail-fast"]
        if pkg := t.meta.get("package"):
            cmd += ["-p", pkg]
        return cmd

    def default_env(self, t: Target) -> dict:
        # Cargo is happy to build a crate whose rust-version is older than hegeltest's MSRV;
        # tell it not to fail resolution on that (predecessor patches were made this way).
        return {"CARGO_RESOLVER_INCOMPATIBLE_RUST_VERSIONS": "allow", "CARGO_TERM_COLOR": "never",
                # keep Hegel's failure database out of the upstream checkout (and of hegel.patch)
                "HEGEL_DATABASE": str(WORK / t.lang / f"{t.name}.hegel")}

    # "test a::b ... ok" | "test a::b - should panic ... ok" | "test src/x.rs - f (line 3) ... ok"
    _line = re.compile(r"^test (.+?)(?: - should panic)? \.\.\. (ok|FAILED|ignored)(?:,.*)?$", re.M)

    def parse_results(self, output: str) -> dict[str, str]:
        res: dict[str, str] = {}
        for m in self._line.finditer(output):
            name, verdict = m.group(1), m.group(2)
            # a name seen twice with different verdicts (two test binaries) — keep the worse
            if name in res and res[name] == "FAILED":
                continue
            res[name] = verdict
        return res

    def patch_excludes(self) -> list[str]:
        return [":(exclude,glob)**/Cargo.lock"]

    def package_version(self, t: Target) -> str:
        """[package] version of the crate in t.src, following workspace inheritance; when the
        subdir is only a test harness (snap's test/), the root package's version."""
        def load(p: Path) -> dict:
            try:
                return tomllib.loads((p / "Cargo.toml").read_text())
            except Exception:
                return {}
        pkg = load(t.src).get("package", {})
        root = load(t.work)
        if t.src != t.work and pkg.get("name") != t.name and root.get("package", {}).get("name") == t.name:
            pkg = root["package"]
        v = pkg.get("version", "")
        if isinstance(v, dict) and v.get("workspace"):
            v = root.get("workspace", {}).get("package", {}).get("version", "")
        return v if isinstance(v, str) else ""


BACKENDS: dict[str, Backend] = {b.lang: b for b in (Rust(),)}


def backend(t: Target) -> Backend:
    b = BACKENDS.get(t.lang)
    if b is None:
        die(f"{t.id}: no backend for language {t.lang!r} yet")
    return b


# --------------------------------------------------------------------------- git plumbing

def git(t: Target, *args: str, check: bool = True, capture: bool = False) -> subprocess.CompletedProcess:
    return run(["git", *args], cwd=t.work, check=check, capture=capture)


def fetch(t: Target) -> None:
    base = t.meta["base"]["commit"]
    upstream = t.meta["upstream"]
    w = t.work
    if not (w / ".git").is_dir():
        w.mkdir(parents=True, exist_ok=True)
        run(["git", "init", "-q"], cwd=w)
        run(["git", "remote", "add", "origin", upstream], cwd=w)
    have = git(t, "cat-file", "-e", f"{base}^{{commit}}", check=False, capture=True).returncode == 0
    if not have:
        log(f"{t.id}: fetching {base[:12]} from {upstream}")
        r = None
        if len(base) == 40:
            r = git(t, "fetch", "-q", "--depth", "1", "origin", base, check=False)
        if r is None or r.returncode != 0:  # abbreviated sha, or server refuses fetch-by-sha
            log(f"{t.id}: fetching full history")
            git(t, "fetch", "-q", "origin")
    if len(base) < 40:  # imported targets carry the predecessor's 12-hex sha: resolve and record it
        full = git(t, "rev-parse", "--verify", f"{base}^{{commit}}", capture=True).stdout.strip()
        tt = t.dir / "target.toml"
        tt.write_text(tt.read_text().replace(f'commit = "{base}"', f'commit = "{full}"', 1))
        t.meta["base"]["commit"] = base = full
        log(f"{t.id}: resolved base commit to {full}")
    if git(t, "ls-files", "-u", capture=True).stdout.strip():  # a conflicted `zoo bump` left unmerged entries
        log(f"{t.id}: dropping the unmerged state left in {t.work.relative_to(ROOT)}")
        git(t, "reset", "-q", "--hard")
    git(t, "checkout", "-q", "--detach", base)


def reset_to_base(t: Target) -> None:
    base = t.meta["base"]["commit"]
    git(t, "checkout", "-q", "--detach", base)
    git(t, "reset", "-q", "--hard")
    # -d for directories, no -x: keep ignored build artefacts (target/, node_modules/) for speed
    git(t, "clean", "-fdq")


def apply(t: Target) -> None:
    fetch(t)
    reset_to_base(t)
    if not t.patch.is_file() or t.patch.stat().st_size == 0:
        die(f"{t.id}: hegel.patch missing or empty")
    r = git(t, "apply", "--3way", str(t.patch), check=False, capture=True)
    if r.returncode != 0:
        print(r.stdout)
        die(f"{t.id}: hegel.patch does not apply to {t.meta['base']['commit'][:12]}")


def save(t: Target) -> None:
    if not (t.work / ".git").is_dir():
        die(f"{t.id}: nothing in {t.work}; run `zoo apply` and edit there first")
    excludes = [":(exclude,glob)**/.hegel/**", *backend(t).patch_excludes()]
    git(t, "add", "-N", "--all")  # make new files show up in diff
    # diff against the base commit, not the index: `apply --3way` leaves the patch staged
    r = git(t, "diff", "--binary", "HEAD", "--", ".", *excludes, capture=True)
    text = r.stdout
    if not text.strip():
        die(f"{t.id}: working tree in {t.work} has no changes against base")
    t.patch.write_text(text)
    log(f"{t.id}: wrote {t.patch.relative_to(ROOT)} ({text.count(chr(10))} lines)")


# --------------------------------------------------------------------------- test

@dataclass
class Verdict:
    passed: list[str]
    expected_failed: list[str]
    unexpected_failed: list[str]
    unexpected_passed: list[str]   # listed as expected failures but passed: bug fixed?
    missing: list[str]             # expected failures that did not run at all
    ignored: list[str]
    intermittent_passed: list[str] = field(default_factory=list)  # intermittent ones that passed this run
    upstream_failed: list[str] = field(default_factory=list)      # upstream's own tests failing: reported, not judged
    not_run: list[str] = field(default_factory=list)              # tests the patch adds that the run never reached

    @property
    def ok(self) -> bool:
        return not (self.unexpected_failed or self.unexpected_passed or self.missing or self.not_run)


_ADDED_TEST = re.compile(r"^\+\s*#\[(?:hegel::)?test\b[^\n]*\n(?:\+\s*#\[[^\n]*\n)*\+\s*(?:pub(?:\([^)]*\))? )?(?:async )?fn (\w+)", re.M)


def patch_tests(t: Target) -> set[str]:
    """Names of the test functions hegel.patch adds. Only these are judged: upstream's own
    suite can fail for reasons that are not ours (patches exclude lockfiles, so dependencies
    float; toolchain drift), and that is reported, not counted against the target."""
    return set(_ADDED_TEST.findall(t.patch.read_text())) if t.patch.is_file() else set()


def judge(t: Target, results: dict[str, str]) -> Verdict:
    exp = t.expected_failures
    inter = t.intermittent
    ours = patch_tests(t)
    v = Verdict([], [], [], [], [], [])
    for name, r in results.items():
        base = name.rsplit("::", 1)[-1]
        if r == "ignored":
            v.ignored.append(name)
        elif r == "FAILED" and ours and base not in ours and name not in exp:
            v.upstream_failed.append(name)
        elif r == "FAILED":
            (v.expected_failed if name in exp else v.unexpected_failed).append(name)
        elif name in inter:
            v.intermittent_passed.append(name)
        elif name in exp:
            v.unexpected_passed.append(name)
        else:
            v.passed.append(name)
    v.missing = [n for n in exp if n not in results]
    # a patch test that never ran (a workspace member `cargo test` in the subdir does not reach,
    # a test target behind `required-features`, a module behind a cfg) would otherwise pass silently
    ran = {name.rsplit("::", 1)[-1] for name in results}
    v.not_run = sorted(n for n in ours if n not in ran)
    return v


def run_tests(t: Target, test_cases: int | None, no_apply: bool) -> Verdict | None:
    """Apply (unless no_apply), run the suite, judge it and print the verdict. None when no
    test result could be parsed at all (build failure): the tail of the log is printed."""
    b = backend(t)
    if not no_apply:
        apply(t)
    for step in t.meta.get("run", {}).get("setup", []):
        log(f"{t.id}: setup: {step}")
        subprocess.run(step, shell=True, cwd=t.src, check=True)
    cmd_s = t.meta.get("run", {}).get("command")
    cmd = cmd_s.split() if cmd_s else b.default_command(t)
    env = b.default_env(t)
    env.update(t.meta.get("run", {}).get("env", {}))
    if test_cases:
        env["HEGEL_TEST_CASES"] = str(test_cases)
    log(f"{t.id}: running {' '.join(cmd)} in {t.src.relative_to(ROOT)}")
    r = run(cmd, cwd=t.src, check=False, capture=True, env=env)
    logfile = WORK / t.lang / f"{t.name}.log"
    logfile.write_text(r.stdout)
    results = b.parse_results(r.stdout)
    if not results:
        print(r.stdout[-4000:])
        log(f"{t.id}: no test results parsed (exit {r.returncode}); full log at {logfile}")
        return None
    v = judge(t, results)
    flag = "OK " if v.ok else "BAD"
    print(f"{flag} {t.id}: {len(v.passed)} passed, {len(v.expected_failed)} expected failures, "
          f"{len(v.ignored)} ignored, {len(v.unexpected_failed)} unexpected failures, "
          f"{len(v.unexpected_passed)} unexpected passes, {len(v.missing)} expected-failure tests missing"
          + (f", {len(v.not_run)} patch tests not run" if v.not_run else ""))
    for n in v.unexpected_failed:
        print(f"    FAIL  {n}")
    for n in v.not_run:
        print(f"    NOTRUN {n}  (the patch adds this test but the run never reached it: workspace member, required-features, cfg?)")
    for n in v.unexpected_passed:
        print(f"    PASS? {n}  (listed as expected failure for {t.expected_failures[n]} — fixed upstream?)")
    for n in v.intermittent_passed:
        print(f"    pass  {n}  (intermittent expected failure for {t.expected_failures[n]}; passed this run)")
    for n in v.upstream_failed:
        print(f"    UPSTREAM {n}  (upstream's own test failed; not judged)")
    for n in v.missing:
        print(f"    MISSING {n}  (expected failure not found in results)")
    if not v.ok:
        log(f"{t.id}: full log at {logfile}")
    return v


def test(t: Target, test_cases: int | None, no_apply: bool) -> bool:
    v = run_tests(t, test_cases, no_apply)
    return v is not None and v.ok


# --------------------------------------------------------------------------- drift / bump

def upstream_head(t: Target) -> tuple[str, str]:
    """(sha, branch) of upstream's default branch, by ls-remote: no clone needed."""
    r = run(["git", "ls-remote", "--symref", t.meta["upstream"], "HEAD"], check=False, capture=True)
    if r.returncode != 0:
        die(f"{t.id}: ls-remote {t.meta['upstream']} failed:\n{r.stdout.strip()}")
    branch, sha = "", ""
    for line in r.stdout.splitlines():
        if line.startswith("ref: "):
            branch = line.split()[1].removeprefix("refs/heads/")
        elif line.endswith("\tHEAD"):
            sha = line.split()[0]
    if not sha:
        die(f"{t.id}: could not read upstream HEAD from ls-remote output:\n{r.stdout}")
    return sha, branch


def drift(targets: list[Target]) -> int:
    """Print, per target, whether upstream's default branch has moved past base.commit."""
    from concurrent.futures import ThreadPoolExecutor

    def one(t: Target) -> tuple[Target, str, str]:
        try:
            sha, branch = upstream_head(t)
            return t, sha, branch
        except SystemExit as e:
            return t, "", str(e)

    behind = 0
    with ThreadPoolExecutor(max_workers=8) as ex:
        for t, sha, branch in ex.map(one, targets):
            base = t.meta["base"]["commit"]
            if not sha:
                print(f"?       {t.id}: {branch}")
            elif sha == base:
                print(f"current {t.id} {base[:12]} ({t.meta['base'].get('version', '')}, {t.meta['base'].get('date', '')})")
            else:
                behind += 1
                print(f"behind  {t.id} {base[:12]} ({t.meta['base'].get('date', '')}) -> {sha[:12]} on {branch}")
    print(f"zoo drift: {behind}/{len(targets)} targets behind upstream")
    return behind


def _fetch_commit(t: Target, ref: str) -> str:
    """Fetch <ref> (sha, branch or tag) into the target's checkout; return its full sha."""
    r = git(t, "fetch", "-q", "--depth", "1", "origin", ref, check=False, capture=True)
    if r.returncode != 0:
        log(f"{t.id}: shallow fetch of {ref} refused ({r.stdout.strip()[-200:]}); fetching full history")
        git(t, "fetch", "-q", "origin")
        return git(t, "rev-parse", "--verify", f"{ref}^{{commit}}", capture=True).stdout.strip()
    return git(t, "rev-parse", "FETCH_HEAD", capture=True).stdout.strip()


def _set_base(t: Target, commit: str, date: str, version: str) -> None:
    tt = t.dir / "target.toml"
    s = tt.read_text()
    head, _, rest = s.partition("[base]\n")
    block, _, tail = rest.partition("\n[")
    if not _:
        block, tail = rest, ""
    block = re.sub(r'(?m)^commit = "[^"]*"', f"commit = {toml_str(commit)}", block)
    block = re.sub(r'(?m)^date = "[^"]*"', f"date = {toml_str(date)}", block)
    if version:
        block = re.sub(r'(?m)^version = "[^"]*"', f"version = {toml_str(version)}", block)
    tt.write_text(head + "[base]\n" + block + ("\n[" + tail if _ else ""))


def _drop_expected_failures(t: Target, tests: set[str]) -> None:
    tt = t.dir / "target.toml"
    out, in_section = [], False
    for line in tt.read_text().split("\n"):
        if line.startswith("["):
            in_section = line.strip() == "[expected_failures]"
        m = re.match(r'^"?([^"=]+?)"?\s*=', line)
        if in_section and m and m.group(1).strip() in tests:
            continue
        out.append(line)
    tt.write_text("\n".join(out))


def _bug_chunks(text: str) -> list[str]:
    """Split bugs.toml into its leading text and one chunk per [[bug]] (each chunk carries its
    [[bug.observed]] rows), preserving formatting."""
    return re.split(r"(?m)^(?=\[\[bug\]\]\n)", text)


def _record_observations(t: Target, commit: str, version: str, hegel: str, today: str,
                         results: dict[str, str], fixed: set[str]) -> None:
    """Append one [[bug.observed]] row per bug in `results`; mark bugs in `fixed` as fixed."""
    bf = t.dir / "bugs.toml"
    if not bf.is_file():
        return
    chunks = _bug_chunks(bf.read_text())
    for i, ch in enumerate(chunks):
        m = re.search(r'(?m)^id = "([^"]+)"', ch)
        if not m or m.group(1) not in results:
            continue
        bid = m.group(1)
        if bid in fixed:
            ch = re.sub(r'(?m)^status = "[^"]*"', 'status = "fixed"', ch, count=1)
            if re.search(r'(?m)^fixed_in = ""', ch):
                ch = re.sub(r'(?m)^fixed_in = ""', f"fixed_in = {toml_str(f'{version} ({commit[:12]})')}", ch, count=1)
            else:
                ch = re.sub(r'(?m)^(status = "fixed"\n)', rf"\g<1>fixed_in = {toml_str(f'{version} ({commit[:12]})')}\n", ch, count=1)
        row = (f"[[bug.observed]]\nversion = {toml_str(version)}\ncommit = {toml_str(commit[:12])}\n"
               f"hegel = {toml_str(hegel)}\ndate = {toml_str(today)}\nresult = {toml_str(results[bid])}\n")
        chunks[i] = ch.rstrip("\n") + "\n\n" + row
    bf.write_text("".join(chunks).rstrip("\n") + "\n")
    tomllib.loads(bf.read_text())  # never leave an unparsable bugs.toml behind


_DIFF3 = re.compile(r"^<<<<<<< [^\n]*\n(?P<ours>.*?)^\|\|\|\|\|\|\| [^\n]*\n(?P<base>.*?)^=======\n(?P<theirs>.*?)^>>>>>>> [^\n]*\n",
                    re.M | re.S)


def _resolve_additions(t: Target, files: list[str]) -> list[str]:
    """Resolve add/add conflicts (upstream appended to the same spot the patch appends to —
    typically the end of a test module) by keeping upstream's lines then the patch's. A block
    whose base side is not empty is a real conflict and is left alone. Returns the files still
    conflicted."""
    unresolved = []
    for f in files:
        p = t.work / f
        if git(t, "checkout", "--conflict=diff3", "--", f, check=False, capture=True).returncode != 0:
            unresolved.append(f)
            continue
        text = p.read_text(errors="replace")
        blocks = list(_DIFF3.finditer(text))

        def merge(m: re.Match) -> str | None:
            ours, base, theirs = m.group("ours"), m.group("base"), m.group("theirs")
            if not base.strip():                 # both sides added at the same spot
                return ours + theirs
            if theirs.startswith(base):          # patch appended after lines upstream then edited
                return ours + theirs[len(base):]
            if theirs.endswith(base):            # patch inserted before lines upstream then edited
                return theirs[:-len(base)] + ours
            return None                          # both sides changed the same lines: a real conflict

        if not blocks or any(merge(m) is None for m in blocks):
            git(t, "checkout", "--conflict=merge", "--", f, check=False, capture=True)
            unresolved.append(f)
            continue
        text = _DIFF3.sub(lambda m: merge(m), text)
        p.write_text(text)
        git(t, "add", "--", f)
    return unresolved


def bump(t: Target, to: str | None, accept_fixed: bool, finish: bool, keep: bool, union: bool = True) -> str:
    """Try the patch and the suite at a newer upstream commit; land it in targets/ when clean.

    Returns one of: current (nothing to do), conflict (patch does not apply; checkout left for a
    hand rebase, then `zoo test --no-apply` and `zoo bump --finish`), failed (unexpected failures /
    unrun tests: investigate in the checkout), decide (an expected failure passed: rerun with
    --accept-fixed to record the bugs as fixed), bumped."""
    base = t.meta["base"]["commit"]
    resolved: list[str] = []  # files whose add/add conflicts were resolved by keeping both sides
    if finish:
        if not (t.work / ".git").is_dir():
            die(f"{t.id}: --finish needs the checkout from an earlier `zoo bump` in {t.work}")
        new = git(t, "rev-parse", "HEAD", capture=True).stdout.strip()
        if new == base:
            die(f"{t.id}: checkout is still at the base commit; nothing to finish")
    else:
        fetch(t)
        if to:
            new = _fetch_commit(t, to)
        else:
            new, branch = upstream_head(t)
            if new == base:
                print(f"current {t.id}: upstream {branch} is still {base[:12]}")
                return "current"
            _fetch_commit(t, new)
        if new == base:
            print(f"current {t.id}: already at {base[:12]}")
            return "current"
        git(t, "checkout", "-q", "--detach", new)
        git(t, "reset", "-q", "--hard")
        git(t, "clean", "-fdq")
        r = git(t, "apply", "--3way", str(t.patch), check=False, capture=True)
        if r.returncode != 0:
            conflicted = git(t, "diff", "--name-only", "--diff-filter=U", capture=True).stdout.split()
            unresolved = _resolve_additions(t, conflicted) if union else conflicted
            if unresolved or not conflicted:
                print(f"CONFLICT {t.id}: hegel.patch does not apply at {new[:12]}"
                      + (f"; conflicts in {', '.join(unresolved)}" if unresolved else ""))
                print("    " + r.stdout.strip().replace("\n", "\n    ")[-1500:])
                log(f"{t.id}: resolve in {t.work.relative_to(ROOT)}, then `zoo test --no-apply {t.id}` and `zoo bump --finish {t.id}`")
                return "conflict"
            resolved = conflicted
            log(f"{t.id}: add/add conflicts in {', '.join(resolved)} resolved by keeping both sides")
    subject = git(t, "log", "-1", "--format=%s", new, capture=True).stdout.strip()
    date = git(t, "log", "-1", "--format=%cs", new, capture=True).stdout.strip()
    log(f"{t.id}: {base[:12]} -> {new[:12]} ({date}: {subject})")
    v = run_tests(t, None, no_apply=True)
    if v is None:
        print(f"FAILED  {t.id}: no test results at {new[:12]} (build broken?); checkout kept in {t.work.relative_to(ROOT)}")
        return "failed"
    if v.unexpected_failed or v.not_run or v.missing:
        print(f"FAILED  {t.id} at {new[:12]}: {len(v.unexpected_failed)} unexpected failures, "
              f"{len(v.not_run)} patch tests not run, {len(v.missing)} expected-failure tests missing; "
              f"checkout kept in {t.work.relative_to(ROOT)} (new bug? changed API? fix, `zoo test --no-apply`, `zoo bump --finish`)")
        return "failed"
    if v.unexpected_passed and not accept_fixed:
        print(f"DECIDE  {t.id} at {new[:12]}: {len(v.unexpected_passed)} expected failure(s) passed — "
              f"{', '.join(v.unexpected_passed)}. Fixed upstream? Rerun with --accept-fixed to record that "
              f"(or map the test elsewhere first); checkout kept in {t.work.relative_to(ROOT)}")
        return "decide"
    # observations per bug: reproduces if any of its tests still fails; fixed if its deterministic
    # pins all passed (only reachable with --accept-fixed; an intermittent property of the same bug
    # that also passed does not veto that); not-reproduced when only intermittent tests passed
    exp = t.expected_failures
    inter = t.intermittent
    per_bug: dict[str, set[str]] = {}
    for name in v.expected_failed:
        per_bug.setdefault(exp[name], set()).add("reproduces")
    for name in v.unexpected_passed:
        per_bug.setdefault(exp[name], set()).add("passed")
    for name in v.intermittent_passed:
        per_bug.setdefault(exp[name], set()).add("not-reproduced")
    results: dict[str, str] = {}
    fixed: set[str] = set()
    for bid, seen in per_bug.items():
        if "reproduces" in seen:
            results[bid] = "reproduces"
        elif "passed" in seen:
            results[bid] = "fixed"
            fixed.add(bid)
        else:
            results[bid] = "not-reproduced"
    b = backend(t)
    version = b.package_version(t) or t.meta["base"].get("version", "")
    hegel = t.meta["hegel"]["version"]
    today = dt.date.today().isoformat()
    save(t)
    _set_base(t, new, date, version)
    if v.unexpected_passed:
        # a fixed bug's intermittent properties stop being expected failures too
        _drop_expected_failures(t, set(v.unexpected_passed)
                                | {n for n in v.intermittent_passed if exp[n] in fixed})
    _record_observations(t, new, version, hegel, today, results, fixed)
    rd = t.dir / "README.md"
    parts = [f"{sum(1 for r in results.values() if r == 'reproduces')} bug(s) still reproduce"]
    if fixed:
        parts.append("fixed upstream: " + ", ".join(sorted(fixed)))
    nr = sorted(bid for bid, r in results.items() if r == "not-reproduced")
    if nr:
        parts.append("intermittent, not seen this run: " + ", ".join(nr))
    unchecked = [bg["id"] for bg in t.bugs if bg.get("status") in OPEN_STATUSES and not bg.get("test")]
    if unchecked:
        parts.append(f"{len(unchecked)} ignored reproducer(s) not run")
    if resolved:
        parts.append("add/add conflicts in " + ", ".join(resolved) + " resolved by keeping both sides")
    line = (f"- {today}: base bumped {base[:12]} → {new[:12]} ({date}, \"{subject}\"; {version}); "
            + "; ".join(parts) + f". {len(v.passed)} tests pass.\n")
    rd.write_text(rd.read_text().rstrip("\n") + "\n" + line)
    t2 = load_target(t.lang, t.name)
    errs = check(t2, load_pins(), False)
    if errs:
        print(f"BUMPED? {t.id}: recorded, but zoo check complains: {errs}")
        return "failed"
    if not keep:
        shutil.rmtree(t.work, ignore_errors=True)
    print(f"BUMPED  {t.id}: {base[:12]} -> {new[:12]} ({version}); " + "; ".join(parts))
    return "bumped"


# --------------------------------------------------------------------------- check

def check(t: Target, pins: dict, do_apply: bool) -> list[str]:
    errs: list[str] = []
    m = t.meta
    for k in ("name", "language", "upstream", "base", "hegel"):
        if k not in m:
            errs.append(f"target.toml missing [{k}]")
    if errs:
        return errs
    if m["name"] != t.name or m["language"] != t.lang:
        errs.append("target.toml name/language disagree with directory")
    if not re.fullmatch(r"[0-9a-f]{40}", m["base"].get("commit", "")):
        errs.append("base.commit must be a full 40-hex sha")
    if not (t.dir / "README.md").is_file():
        errs.append("README.md missing")
    if not t.patch.is_file() or t.patch.stat().st_size == 0:
        errs.append("hegel.patch missing or empty")
        return errs
    text = t.patch.read_text()
    if re.search(r"^diff --git a/\S*HEGEL_REPORT\.md ", text, re.M):
        errs.append("hegel.patch adds HEGEL_REPORT.md (strip it)")
    b = BACKENDS.get(t.lang)
    pin = pins.get(t.lang, {}).get("version", "")
    if b:
        vers = b.patch_versions(text)
        if not vers:
            errs.append("hegel.patch does not add the Hegel dependency (or in a form zoo does not recognise)")
        elif vers != {pin}:
            errs.append(f"hegel.patch pins {sorted(vers)} but zoo.toml pins {pin!r}")
    if m["hegel"].get("version") != pin:
        errs.append(f"target.toml hegel.version {m['hegel'].get('version')!r} != zoo.toml {pin!r}")
    ids = {}
    for bug in t.bugs:
        bid = bug.get("id", "")
        if not bid.startswith(f"{t.name}/"):
            errs.append(f"bug id {bid!r} should start with {t.name}/")
        if bid in ids:
            errs.append(f"duplicate bug id {bid}")
        ids[bid] = bug
        if bug.get("status") not in ALL_STATUSES:
            errs.append(f"bug {bid}: bad status {bug.get('status')!r}")
        for k in ("title", "kind", "found"):
            if k not in bug:
                errs.append(f"bug {bid}: missing {k}")
    for test_name, bid in t.expected_failures.items():
        if bid not in ids:
            errs.append(f"expected_failures: {test_name} -> unknown bug {bid}")
        elif ids[bid].get("status") not in OPEN_STATUSES:
            errs.append(f"expected_failures: {test_name} -> bug {bid} has status {ids[bid]['status']}; drop it")
    listed = set(t.expected_failures.values())
    for bid, bug in ids.items():
        if bug.get("status") in OPEN_STATUSES and bug.get("test") and bid not in listed:
            errs.append(f"bug {bid} is {bug['status']} with a test but not in expected_failures")
    if do_apply and not errs:
        try:
            apply(t)
        except SystemExit as e:
            errs.append(str(e))
    return errs


# --------------------------------------------------------------------------- bump-hegel

def bump_hegel(lang: str, version: str) -> None:
    if lang not in BACKENDS:
        die(f"no backend for {lang}")
    b = BACKENDS[lang]
    zt = ROOT / "zoo.toml"
    text = zt.read_text()
    new, n = re.subn(rf'(\[{lang}\]\n(?:.*\n)*?version = )"[^"]*"', rf'\g<1>"{version}"', text)
    if n != 1:
        die(f"could not find [{lang}] version in zoo.toml")
    zt.write_text(new)
    for t in all_targets(lang):
        pt = t.patch.read_text()
        t.patch.write_text(b.rewrite_version(pt, version))
        tt = t.dir / "target.toml"
        tt.write_text(re.sub(r'(\[hegel\]\n(?:.*\n)*?version = )"[^"]*"', rf'\g<1>"{version}"', tt.read_text()))
    log(f"{lang}: pinned {version} in zoo.toml and {len(all_targets(lang))} targets; now run `zoo test {lang}`")


# --------------------------------------------------------------------------- report

def report() -> None:
    rows = []
    for t in all_targets():
        for bug in t.bugs:
            rows.append((t, bug))
    by_status: dict[str, int] = {}
    for _, bug in rows:
        by_status[bug["status"]] = by_status.get(bug["status"], 0) + 1
    out = ["# Trophies", "",
           "Every bug found by a test in the zoo, generated by `tools/zoo report` from the",
           "`bugs.toml` files under `targets/`. Do not edit by hand.", "",
           f"{len(rows)} bugs across {len({t.id for t, _ in rows})} targets: "
           + ", ".join(f"{k} {v}" for k, v in sorted(by_status.items())) + ".", ""]
    for lang in LANGUAGES:
        lrows = [(t, b) for t, b in rows if t.lang == lang]
        if not lrows:
            continue
        out += [f"## {lang}", "", "| id | title | kind | severity | found at | status | upstream |", "|---|---|---|---|---|---|---|"]
        for t, b in lrows:
            f = b.get("found", {})
            found = f"{f.get('version', '')} ({f.get('commit', '')[:9]})".strip()
            up = b.get("upstream_issue", "")
            up = f"[issue]({up})" if up else ""
            fixed = f" (fixed in {b['fixed_in']})" if b.get("fixed_in") else ""
            out.append(f"| [{b['id']}](targets/{t.lang}/{t.name}/bugs.toml) | {b['title']} | {b.get('kind', '')} | "
                       f"{b.get('severity', '')} | {found} | {b['status']}{fixed} | {up} |")
        out.append("")
    (ROOT / "TROPHIES.md").write_text("\n".join(out))
    log(f"wrote TROPHIES.md ({len(rows)} bugs)")


# --------------------------------------------------------------------------- new

def new(lang: str, name: str, upstream: str) -> None:
    if lang not in LANGUAGES:
        die(f"unknown language {lang}")
    d = TARGETS / lang / name
    if d.exists():
        die(f"{d} exists")
    d.mkdir(parents=True)
    pin = load_pins()[lang]["version"]
    today = dt.date.today().isoformat()
    (d / "target.toml").write_text(f'''name = {toml_str(name)}
language = {toml_str(lang)}
upstream = {toml_str(upstream)}
subdir = ""
license = ""
ai_policy_checked = {toml_str(today)}

[base]
commit = ""
date = ""
version = ""

[hegel]
version = {toml_str(pin)}

[run]
setup = []

[expected_failures]
''')
    (d / "README.md").write_text(f"# {name}\n\n## What is tested\n\n## Oracles\n\n## Not tested\n\n## History\n\n- {today}: created.\n")
    (d / "hegel.patch").touch()
    log(f"scaffolded {d.relative_to(ROOT)}; fill in base.commit, then `zoo fetch {lang}/{name}`, write tests in work/, `zoo save`")


# --------------------------------------------------------------------------- main

def main(argv: list[str]) -> int:
    sys.stdout.reconfigure(line_buffering=True)  # keep verdicts in step with the log() lines when piped
    ap = argparse.ArgumentParser(prog="zoo", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    for c in ("fetch", "apply"):
        sub.add_parser(c).add_argument("targets", nargs="+")
    p = sub.add_parser("test")
    p.add_argument("targets", nargs="+")
    p.add_argument("--test-cases", type=int, help="override HEGEL_TEST_CASES")
    p.add_argument("--no-apply", action="store_true", help="run against work/ as it is (while porting)")
    p.add_argument("--clean", action="store_true", help="delete the checkout under work/ after the run (disk)")
    sub.add_parser("save").add_argument("target")
    p = sub.add_parser("check")
    p.add_argument("targets", nargs="*")
    p.add_argument("--apply", action="store_true", help="also fetch upstream and verify the patch applies")
    sub.add_parser("drift").add_argument("targets", nargs="*")
    p = sub.add_parser("bump")
    p.add_argument("targets", nargs="+")
    p.add_argument("--to", help="upstream commit/tag/branch to move to (default: upstream HEAD); one target only")
    p.add_argument("--accept-fixed", action="store_true", help="an expected failure that passes marks its bug fixed")
    p.add_argument("--finish", action="store_true", help="record from the checkout as it is (after a hand rebase)")
    p.add_argument("--keep", action="store_true", help="keep the checkout under work/ after a successful bump")
    p.add_argument("--no-union", action="store_true", help="do not auto-resolve add/add conflicts by keeping both sides")
    p = sub.add_parser("bump-hegel")
    p.add_argument("lang")
    p.add_argument("version")
    sub.add_parser("report")
    p = sub.add_parser("new")
    p.add_argument("lang")
    p.add_argument("name")
    p.add_argument("upstream")
    sub.add_parser("list").add_argument("lang", nargs="?")
    a = ap.parse_args(argv)

    if a.cmd == "fetch":
        for t in resolve(a.targets):
            fetch(t)
    elif a.cmd == "apply":
        for t in resolve(a.targets):
            apply(t)
            log(f"{t.id}: applied at {t.work.relative_to(ROOT)}")
    elif a.cmd == "test":
        ok = True
        for t in resolve(a.targets):
            ok &= test(t, a.test_cases, a.no_apply)
            if a.clean:
                shutil.rmtree(t.work, ignore_errors=True)
        return 0 if ok else 1
    elif a.cmd == "save":
        save(resolve([a.target])[0])
    elif a.cmd == "check":
        pins = load_pins()
        bad = 0
        ts = resolve(a.targets)
        for t in ts:
            errs = check(t, pins, a.apply)
            if errs:
                bad += 1
                print(f"BAD {t.id}")
                for e in errs:
                    print(f"    {e}")
        print(f"zoo check: {len(ts) - bad}/{len(ts)} targets OK")
        return 1 if bad else 0
    elif a.cmd == "drift":
        return 1 if drift(resolve(a.targets)) else 0
    elif a.cmd == "bump":
        ts = resolve(a.targets)
        if a.to and len(ts) != 1:
            die("--to takes exactly one target")
        outcomes = {}
        for t in ts:
            outcomes[t.id] = bump(t, a.to, a.accept_fixed, a.finish, a.keep, union=not a.no_union)
        if len(ts) > 1:
            print("zoo bump: " + ", ".join(f"{k} {v}" for k, v in outcomes.items()))
        return 0 if all(o in ("current", "bumped") for o in outcomes.values()) else 1
    elif a.cmd == "bump-hegel":
        bump_hegel(a.lang, a.version)
    elif a.cmd == "report":
        report()
    elif a.cmd == "new":
        new(a.lang, a.name, a.upstream)
    elif a.cmd == "list":
        for t in all_targets(a.lang):
            print(t.id)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
