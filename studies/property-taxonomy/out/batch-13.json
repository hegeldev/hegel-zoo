    {"bug": "dep3/1", "property": null, "basis": "none", "note": "pin is a hand-written git-style header; the generated model has no blank-line body before a pseudo-header, so no property covers it"},
    {"bug": "dep3/2", "property": null, "basis": "none", "note": "pin parses DEP-3's own git format-patch sample; the mbox From line is not generated"},
    {"bug": "dep3/3", "property": "rust/dep3::built_headers_are_read_back", "basis": "explicit", "note": "the property's comment and body gate around it ('setters on fields that already exist are pinned separately', one bug per key)"},
    {"bug": "dep3/4", "property": null, "basis": "none", "note": "no property calls set_description on a parsed header lacking a long description; the pin is a deterministic example"},
    {"bug": "dep3/5", "property": "rust/dep3::built_headers_are_read_back", "basis": "explicit", "note": "the property filters blank lines out of the long description ('Blank lines in the long description are pinned (set_description marker)')"},
    {"bug": "dep3/6", "property": "rust/dep3::lossless_headers_are_read_like_the_model_and_dpkg", "basis": "inferred", "note": "README says the lossless long_description getter is checked only 'when present', i.e. the property was gated around Some(\"\") for one-line descriptions"},
