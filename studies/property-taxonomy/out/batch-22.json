    {"bug": "piccolo/1", "property": "rust/piccolo::load_deeply_nested_source_never_aborts", "basis": "inferred", "note": "The bug is a register-allocator overflow at ~128 nested tables/index chains; this property sweeps exactly those constructs by depth and its comment says the unguarded kinds fail at ~150 and were moved to an #[ignore]d pin not in this batch."},
    {"bug": "piccolo/2", "property": "rust/piccolo::integer_arithmetic_matches_puc_lua", "basis": "explicit", "note": "The property's body cites known_bug_integer_modulo_overflow and excludes the overflowing operands."},
